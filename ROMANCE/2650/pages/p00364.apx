    region lançamentos-de-rateios (
        name: Lançamentos de Rateios
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.idrateionotafiscal
                     , pck_romance.fnc_nomefilial(r.idfilialdestino) destino
                     , r.idfilialdestino
                     , r.idfornecedor
                     , r.valor
                     , r.documento
                     , md.centrodecusto centrodecusto
                     , md.contafinanceira conta
                     , md.subcontafinanceira subconta
                     , md.desctiporegra regra
                     , decode(md.ativo,'S','Ativa','N','Inativa') situacao
                     , r.data datacriacao
                     , r.observacao
                     , r.idmatrizdespesa
                from rateiosnotasfiscais r
                   , vw_matrizregrasdespesas md
                   , notasfiscais nf
                where r.idmatrizdespesa = md.idmatrizregra(+)
                  and nf.idnotafiscal  = r.idnotafiscal
                  and nf.situacao = 'A'
                  and ( :P364_TIPOPESQUISA = 'A'
                     or ( :P364_TIPOPESQUISA = 'C' and r.idmatrizdespesa is not null )
                     or ( :P364_TIPOPESQUISA = 'S' and r.idmatrizdespesa is null )
                     or ( :P364_TIPOPESQUISA = 'I' and exists ( select 1
                                                                from matrizregrasdespesas md
                                                                where md.idmatrizregra = r.idmatrizdespesa
                                                                  and md.ativo         = 'N' ) ) )
                  and ( :P364_TIPO_DATA = 'T' 
                     or ( :P364_TIPO_DATA = 'L' and trunc(r.data) between to_date(:P364_DATAINICIO) and to_date(:P364_DATAFIM) )
                     or ( :P364_TIPO_DATA = 'V' and trunc(r.datavencimento) between to_date(:P364_DATAINICIO) and to_date(:P364_DATAFIM) ) )
                  and ( :P364_TIPONOTA = 'A' and nf.tiponota in ('D','C', 'R') or nf.tiponota = :P364_TIPONOTA )
                  and ( :P364_IDFORNECEDOR is null or nf.idfornemitente = :P364_IDFORNECEDOR )
                  and ( :P364_DATAINICIO is not null
                     or :P364_DATAFIM is not null )
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P364_TIPO
            value: R
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 119895387557546711
        }

