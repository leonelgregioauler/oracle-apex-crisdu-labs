    region lançamentosde-negociações (
        name: Lançamentosde Negociações
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select n.idnegociacao
                     , n.data
                     , ( select t.descricao
                         from tiposnegociacoes t
                         where t.idtiponegociacao = n.idtiponegociacao ) tiponegociacao
                     , pck_romance.fnc_nomefilial(n.idfilial) franquia
                     , pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , pck_romance.fnc_nomepessoa(n.idpessoa) pessoa
                     , n.valortotal
                     , n.valorpago
                     , n.saldo
                     , n.idunidadedenegocio
                     , n.idmatrizclassificacaoentrada
                from negociacoes n
                where :P364_TIPO = 'N'
                  and ( :P364_TIPO_DATA is null
                     or ( :P364_TIPO_DATA = 'V' and exists ( select 1
                                                           from pagamentosnegociacoes pn
                                                           where pn.idnegociacao = n.idnegociacao
                                                             and trunc(pn.datapagamento) between to_date(:P364_DATAINICIO,'DD/MM/RRRR') and to_date(:P364_DATAFIM,'DD/MM/RRRR') ) )
                    or ( :P364_TIPO_DATA = 'L' and n.data between to_date(:P364_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P364_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') ) )
                  and ( :P364_TIPOPESQUISA = 'A'
                     or ( :P364_TIPOPESQUISA = 'C' and n.idmatrizclassificacaoentrada is not null )
                     or ( :P364_TIPOPESQUISA = 'S' and n.idmatrizclassificacaoentrada is null )
                     or ( :P364_TIPOPESQUISA = 'I' and exists ( select 1
                                                                from matrizclassificacoesentradas me
                                                                where me.idmatrizentrada = n.idmatrizclassificacaoentrada
                                                                  and me.ativo           = 'N' ) ) )
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: item=value
            item: P364_TIPO
            value: N
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
