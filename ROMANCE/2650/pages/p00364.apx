            type: selectList
            heading {
                heading: Matriz de Despesa
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select 'Centro de custo: '||( select c.nome
                                                  from centrodecustos c
                                                  where c.idcentrodecusto = m.idcentrodecusto )||' - Conta: '||pck_romance.fnc_nomecontafinan(m.idcontafinan)||' - Sub Conta: '||pck_romance.fnc_nomesubcontafinan(m.idsubcontafinan) display_value
                         , m.idmatrizregra return_value
                    from matrizregrasdespesas m
                    where m.idfornecedor = :IDFORNECEDOR
                      and m.idfilial     = :IDFILIALDESTINO
                      and m.ativo        = 'S'
                    order by 1
                    ```
            }
            cascadingLov {
                parentColumns: [
                    IDFORNECEDOR
                    IDFILIALDESTINO
                ]
                parentRequired: false
