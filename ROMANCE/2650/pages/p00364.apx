                                                                                                                                                                              where s.idsubcontafinan = m.idsubcontafinan ) display_value                                                                                                                                                  
                         , m.idmatrizregra
                    from matrizregrasdespesas m
                    where m.idfornecedor = :IDFORNECEDOR
                      and m.idfilial     = :IDFILIALDESTINO
                      and m.ativo        = 'S'
                    order by 1
                    ```
                displayNullValue: false
