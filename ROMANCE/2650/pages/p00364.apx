    region lançamentos-de-vendas-realizados (
        name: Lançamentos de Vendas Realizados
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.idvencimento
                     , ( select nf.documento
                         from notasfiscais nf
                         where nf.idnotafiscal = v.idnotafiscal ) documento
                     , ( select nf.datainclusao
                         from notasfiscais nf
                         where nf.idnotafiscal = v.idnotafiscal ) datainclusao
                     , ( select nf.idfornemitente
                         from notasfiscais nf
                         where nf.idnotafiscal = v.idnotafiscal ) idfornemitente
                     , ( select pck_romance.fnc_nomefornecedor(nf.idfornemitente) 
                         from notasfiscais nf
                         where nf.idnotafiscal = v.idnotafiscal ) fornecedor
                     , ( select pck_romance.fnc_nomefornecedor(nf.idfornecedordestino) 
                         from notasfiscais nf
                         where nf.idnotafiscal = v.idnotafiscal ) destino
                     , v.datavencimento
                     , v.valor
                     , v.idcontafinan
                     , ( select nomeconta
                         from contasfinanceiras c
                         where c.idcontafinan = v.idcontafinan ) conta
                     , v.idsubcontafinan
                     , ( select nomeconta
                         from subcontasfinanceiras s
                         where s.idsubcontafinan = v.idsubcontafinan ) subconta
                     , ( select idfornecedordestino
                         from notasfiscais nf
                         where nf.idnotafiscal = v.idnotafiscal ) idfornecedordestino
                     , v.idmatrizregrareceita
                     , v.idnotafiscal idnota
                from vencimentosreceber v
                where exists ( select 1
                               from notasfiscais nf
                               where nf.idnotafiscal = v.idnotafiscal
                                 and ( :P364_IDFORNECEDOR is null or nf.idfornemitente = :P364_IDFORNECEDOR )
                                 and nf.tiponota ='V' 
                                 and ( :P364_USUARIO is null or nf.usuario = :P364_USUARIO )
                                 and ( :P364_TIPO_DATA = 'T' 
                                    or ( :P364_TIPO_DATA = 'L' and trunc(nf.datainclusao) between to_date(:P364_DATAINICIO) and to_date(:P364_DATAFIM) )
                                    or ( :P364_TIPO_DATA = 'V' and trunc(v.datavencimento) between to_date(:P364_DATAINICIO) and to_date(:P364_DATAFIM) ) ) )
                  and ( :P364_TIPOPESQUISA = 'A'
                     or ( :P364_TIPOPESQUISA = 'C' and v.idmatrizregrareceita is not null )
                     or ( :P364_TIPOPESQUISA = 'S' and v.idmatrizregrareceita is null ) )
                  and ( :P364_DATAINICIO is not null
                     or :P364_DATAFIM is not null )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P364_TIPO = 'M' and :P364_TIPONOTA = 'V'
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
            csvSeparator: ;
        }
        advanced {
            savedReportMappingIdentifier: 4873437365089839818
        }

