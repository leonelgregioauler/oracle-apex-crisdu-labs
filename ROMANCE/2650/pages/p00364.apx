        column IDMATRIZCLASSIFICACAOENTRADA (
            type: selectList
            heading {
                heading: Matriz de Entrada
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select ' - Sem Matriz -' d
                         , null r
                    from dual
                    union
                    select m.classificacaoentrada||' - Conta: '||( select nomeconta
                                                                   from contasfinanceiras cf
                                                                   where cf.idcontafinan = m.idcontafinan )||' / SubConta: '||( select nomeconta
                                                                                                                                from subcontasfinanceiras s
                                                                                                                                where s.idsubcontafinan = m.idsubcontafinan ) display_value                                                                                                                                                  
                         , m.idmatrizentrada
                    from matrizclassificacoesentradas m
                    where exists ( select f.idfilial
                                         from filiais f
                                         where f.idunidadedenegocio = :IDUNIDADEDENEGOCIO
                                           and f.idfilial           = m.idfilial
                                           and f.ativo              = 'S' )
                      and m.ativo    = 'S'
                    order by 1
                    ```
            }
            cascadingLov {
                parentColumns: IDUNIDADEDENEGOCIO
            }
            layout {
                sequence: 90
            }
            source {
                databaseColumn: IDMATRIZCLASSIFICACAOENTRADA
                dataType: number
            }
        )

