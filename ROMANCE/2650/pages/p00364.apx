        column IDMATRIZDESPESA (
            type: selectList
            heading {
                heading: Matriz de Despesa
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select m.centrodecusto||' - '||m.contafinanceira||' / '||m.subcontafinanceira||' | '||m.desctiporegra display_value
                         , m.idmatrizregra return_value
                    from vw_matrizregrasdespesas m
                    where m.idfornecedor = :IDFORNECEDOR
                      and m.idfilial     = :IDFILIALDESTINO
                      and m.ativo        = 'S'
                    ```
                nullDisplayValue: - Selecione a Matriz -
            }
            cascadingLov {
                parentColumns: [
                    IDFILIALDESTINO
                    IDFORNECEDOR
                ]
            }
            layout {
