        column IDFILIALDESTINO (
            type: selectList
            heading {
                heading: Empresa Destino
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nome
                         , idfilial
                    from vw_filiais f
                    where f.ativo = 'S'
                      and exists (select 1
                                  from roman.matrizregrasdespesas m
                                  where m.idfilial = f.idfilial
                                    and m.idfornecedor = :IDFORNECEDOR
                                    and m.ativo    = 'S')
                    ```
            }
            cascadingLov {
                parentColumns: IDFORNECEDOR
