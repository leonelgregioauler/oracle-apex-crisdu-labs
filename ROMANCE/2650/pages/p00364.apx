    process mudar-destinos-de-lançamentos-atualizar-matriz-conta-subconta (
        name: Mudar Destinos de Lançamentos - Atualizar Matriz/Conta/SubConta
        type: executeCode
        editableRegion: @mudar-destinos-de-lançamentos
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  rmat matrizregrasdespesas%rowtype;
                  --
                begin
                  --
                  case :APEX$ROW_STATUS
                    when 'U' then
                      --
                      if :IDMATRIZREGRADESPESA is not null then
                        --
                        select m.*
                          into rmat
                          from matrizregrasdespesas m
                         where m.idmatrizregra = :IDMATRIZREGRADESPESA;
                        --
                        if nvl(:QTD_COMBINACOES,1) > 1 then
                          --
                          raise_application_error(-20001, 'A nota '||:DOCUMENTO||' possui parcelas com Matriz de Despesa/Conta/SubConta diferentes entre si. Ajuste pela tela de Lançamentos de Rateios.');
                          --
                        else
                          --
                          update vencimentos
                             set idmatrizregradespesa = rmat.idmatrizregra
                               , idcontafinanceira    = rmat.idcontafinan
                               , idsubcontafinanceira = rmat.idsubcontafinan
                               , idcentrodecusto      = rmat.idcentrodecusto
                               , tipo                 = rmat.tiporegra
                               , fixavariavel         = rmat.tipo
                           where idnotafiscal = :IDNOTAFISCAL;
                          --
                        end if;
                        --
                      end if;
                      --
                  end case;
                  --
                end;
                ```
        }
        execution {
            sequence: 35
        }
        advanced {
            executionMappingIdentifier: 9105043764676656310
        }
        serverSideCondition {
            whenButtonPressed: @aplicar-destino
        }
    )

