    region lançamentosde-parcelas-de-negociações (
        name: Lançamentosde Parcelas de Negociações
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpagamentonegociacao
                     , ( select data from negociacoes n where n.idnegociacao = p.idnegociacao ) data_negociacao
                     , p.datainclusao 
                     , p.datapagamento 
                     , decode(p.situacao,'A','Aberto','V','Vencido','Q','Quitado','C','Cancelado') situacao
                     , ( select t.descricao
                         from tiposnegociacoes t
                            , negociacoes n
                         where t.idtiponegociacao = n.idtiponegociacao
                           and n.idnegociacao = p.idnegociacao ) tiponegociacao
                     , ( select pck_romance.fnc_nomefilial(n.idfilial) from negociacoes n where n.idnegociacao = p.idnegociacao ) franquia
                     , ( select pck_romance.fnc_nomerepresentante(n.idrepresentante) from negociacoes n where n.idnegociacao = p.idnegociacao ) distribuidor
                     , ( select pck_romance.fnc_nomepessoa(n.idpessoa) from negociacoes n where n.idnegociacao = p.idnegociacao ) pessoa
                     , p.valorpago 
                     , ( select u.nome 
                         from negociacoes n 
                            , unidadesdenegocios u
                         where n.idnegociacao = p.idnegociacao
                           and u.idunidadedenegocio = n.idunidadedenegocio ) unidadedenegocio
                     , ( select idunidadedenegocio
                         from negociacoes n 
                         where n.idnegociacao = p.idnegociacao ) idunidadedenegocio
                     , p.idmatrizclassificacaoentrada
                from pagamentosnegociacoes p
                where :P364_TIPO = 'P'
                  and ( :P364_TIPO_DATA is null
                    or ( :P364_TIPO_DATA = 'V' and trunc(p.datapagamento) between to_date(:P364_DATAINICIO,'DD/MM/RRRR') and to_date(:P364_DATAFIM,'DD/MM/RRRR') )
                    or ( :P364_TIPO_DATA = 'L' and exists ( select 1
                                                            from negociacoes n
                                                            where n.idnegociacao = p.idnegociacao
                                                              and n.data between to_date(:P364_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P364_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') ) ) )
                  and ( :P364_TIPOPESQUISA = 'A'
                     or ( :P364_TIPOPESQUISA = 'C' and p.idmatrizclassificacaoentrada is not null )
                     or ( :P364_TIPOPESQUISA = 'S' and p.idmatrizclassificacaoentrada is null )
                     or ( :P364_TIPOPESQUISA = 'I' and exists ( select 1
                                                                from matrizclassificacoesentradas me
                                                                where me.idmatrizentrada = p.idmatrizclassificacaoentrada
                                                                  and me.ativo           = 'N' ) ) )
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: item=value
            item: P364_TIPO
            value: P
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
