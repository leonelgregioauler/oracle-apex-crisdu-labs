page 251 (
    name: Detalhado
    title: Detalhado
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region lucratividade (
        name: Lucratividade
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idlucratividade
                     , representante
                     , idrepresentante
                     , semana
                     , acumuladoanterior
                     , '|' separador
                     , vlrcarga
                     , vlrcargaadicional
                     , vlrdevolucao
                     , vlrtotalliquido
                     , '|' separador2
                     , vlrcobranca
                     , despcomissoes
                     , '|' separador3
                     , vlrtotal
                     , vlracumulado 
                     , idfechamentorepres
                     , idfechamento
                from vw_lucratividade
                where idrepresentante = :P251_IDREPRESENTANTE
                order by idfechamentorepres desc
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: -
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 195522610105517912
        }

