    pageItem P251_IDFILIAL (
        type: radioGroup
        label {
            label: Empresa
            alignment: right
        }
        settings {
            noOfCols: 20
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(idfilial) display_value
                     , idfilial
                from filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @lucratividade
            slot: regionBody
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P251_IDREPRESENTANTE (
        type: selectList
        label {
            label: Empreendedor
            alignment: right
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) display_value
                     , idrepresentante
                from representantes r
                where r.ativo = 'S'
                  and pck_romance.fnc_filialrepresentante(idrepresentante) = :P251_IDFILIAL
                order by 1 
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione o Empreendedor -
        }
        cascadingLov {
            parentItems: P251_IDFILIAL
        }
        layout {
            sequence: 20
            region: @lucratividade
            slot: regionBody
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    process atualiza (
        name: atualiza
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                /*  update lucratividade  l
                  set vlrcarga = 0
                    , vlrcargaadicional = 0
                    , vlrdevolucao = 0
                  where idrepresentante = :P251_IDREPRESENTANTE;*/
                  -- 
                  for i in ( select ( select l.idlucratividade from lucratividade l where l.idfechamentorepres = f.idfechamentorepres ) luc
                                   , f.idfechamentorepres
                              from fechamentorepresentantes f
                                 , representantes r
                              where f.idrepresentante = :P251_IDREPRESENTANTE
                                and f.idrepresentante = r.idrepresentante
                                and ano >= 2013
                            /*    and ( r.usanetbook = 'N'
                                     or exists ( select 1
                                             from cargasrepresentantes c
                                             where c.idrepresentante = f.idrepresentante
                                               and c.semana =  pck_romance.fnc_semanaciclo(f.semana) ) )*/
                              order by 2 )
                   loop
                     
                      pck_romance.prc_atualiza_lucratividade( pidlucratividade    => i.luc 
                                                            , pidfechamentorepres => i.idfechamentorepres);
                      --
                   end loop;
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 369356615124085949
        }
    )

)

