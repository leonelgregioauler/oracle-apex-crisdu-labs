            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction confirm (
        name: Confirm
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @delete
        }

        action native-confirm (
            action: confirm
            settings {
                message: Confirma exclusão da programação?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: DELETE
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction libera-nome (
        name: libera nome
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P153_CADASTRADO
        }
        clientSideCondition {
            type: item=value
            item: P153_CADASTRADO
            value: X
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P153_NOMEFORNECEDOR
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P153_IDFORNECEDOR
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P153_NOMEFORNECEDOR
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P153_IDFORNECEDOR
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    process delete (
        name: Delete
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                   --
                  pidprevisaopagamento  number := :P153_IDPREVISAOPAGAMENTO ;
                  pdatainclusao         date   ; 
                  pidsemanainclusao     number := :P153_IDSEMANAINCLUSAO ; 
                  pidusuario            number := :P153_IDUSUARIO ;
                  pidfilial             number := :P153_IDFILIAL ;
                  pdataprevisao         date   := to_date(:P153_DATAPREVISAO,'DD/MM/RRRR') ;
                  pidsemanaprevisao     number := :P153_IDSEMANAPREVISAO;
                  pvalorprevisao        number := to_number(:P153_VALORPREVISAO,'999G999G999G990D00');
                  pidfornecedor         number         := :P153_IDFORNECEDOR;
                  pnomefornecedor       varchar2(1000) := :P153_NOMEFORNECEDOR;
                  pdescricao            varchar2(1000) := :P153_DESCRICAO; 
                  precebido             varchar2(1000) := :P153_RECEBIDO;
                  pdatarecebido         date           := to_date(:P153_DATARECEBIDO ,'DD/MM/RRRR') ;
                  pcrisdu               varchar2(1000) := :P153_CRISDU           ;
                  pidformapagamento     varchar2(1000) := :P153_IDFORMAPAGAMENTO ;
                  pidmoeda              number         := :P153_IDMOEDA          ;
                   --
                begin
                  --
                  :P153_OPERACAO_DML := 'D';
                  --
                  --vvalorprevisao := to_number(:P153_VALORPREVISAO,'999G999G999G990D00');
                  --
                  PCK_FINANCEIRO_RMC.PRC_PREVISOESPAGAMENTOS( PIDPREVISAOPAGAMENTO  => pidprevisaopagamento
                                                            , PDATAINCLUSAO         => pdatainclusao      
                                                            , PIDSEMANAINCLUSAO     => pidsemanainclusao  
                                                            , PIDUSUARIO            => pidusuario         
                                                            , PIDFILIAL             => pidfilial          
                                                            , PDATAPREVISAO         => pdataprevisao      
                                                            , PIDSEMANAPREVISAO     => pidsemanaprevisao  
                                                            , PVALORPREVISAO        => pvalorprevisao     
                                                            , PIDFORNECEDOR         => pidfornecedor      
                                                            , PNOMEFORNECEDOR       => pnomefornecedor    
                                                            , PDESCRICAO            => pdescricao          -- :P153_DESCRICAO
                                                            , PRECEBIDO             => precebido           -- :P153_RECEBIDO
                                                            , PDATARECEBIDO         => pdatarecebido       -- :P153_DATARECEBIDO
                                                            , PCRISDU               => pcrisdu             -- :P153_CRISDU             
                                                            , PIDFORMAPAGAMENTO     => pidformapagamento   -- :P153_IDFORMAPAGAMENTO  --:P153_IDFORMAPAGAMENTO   
                                                            , PIDMOEDA              => pidmoeda            -- :P153_IDMOEDA            
                                                            , PMD5                  => :P153_MD5
                                                            , POPERACAO_DML         => :P153_OPERACAO_DML) ;
                  --
                end;
                
                
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 1424320072980218608
        }
        serverSideCondition {
            type: request=Value
            value: DELETE
        }
    )

    process get-row (
        name: Get Row
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                   --
                   vdatainclusao      date;
                   vdataprevisao      date;
                   vdatarecebido      date;
                   vvalorprevisao     number;
                   --
                begin
                  --
                  if :P153_IDPREVISAOPAGAMENTO is not null then
                    --
                    :P153_OPERACAO_DML := 'S';
                      --
                      PCK_FINANCEIRO_RMC.PRC_PREVISOESPAGAMENTOS( PIDPREVISAOPAGAMENTO  => :P153_IDPREVISAOPAGAMENTO
                                                                , PDATAINCLUSAO         => vdatainclusao    
                                                                , PIDSEMANAINCLUSAO     => :P153_IDSEMANAINCLUSAO
                                                                , PIDUSUARIO            => :P153_IDUSUARIO
                                                                , PIDFILIAL             => :P153_IDFILIAL
                                                                , PDATAPREVISAO         => vdataprevisao
                                                                , PIDSEMANAPREVISAO     => :P153_IDSEMANAPREVISAO
                                                                , PVALORPREVISAO        => vvalorprevisao
                                                                , PIDFORNECEDOR         => :P153_IDFORNECEDOR
                                                                , PNOMEFORNECEDOR       => :P153_NOMEFORNECEDOR
                                                                , PDESCRICAO            => :P153_DESCRICAO
                                                                , PRECEBIDO             => :P153_RECEBIDO
                                                                , PDATARECEBIDO         => vdatarecebido
                                                                , PCRISDU               => :P153_CRISDU             
                                                                , PIDFORMAPAGAMENTO     => :P153_IDFORMAPAGAMENTO   
                                                                , PIDMOEDA              => :P153_IDMOEDA            
                                                                , PMD5                  => :P153_MD5
                                                                , POPERACAO_DML         => :P153_OPERACAO_DML) ;
                      --
                      :P153_VALORPREVISAO  := to_char(vvalorprevisao,'999G999G999G990D00');
                      :P153_DATAINCLUSAO   := to_char(vdatainclusao,'DD/MM/RRRR HH24:MI:SS');
                      :P153_DATAPREVISAO   := to_char(vdataprevisao,'DD/MM/RRRR');
                      :P153_DATARECEBIDO   := to_char(vdatarecebido,'DD/MM/RRRR HH24:MI:SS');
                      --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 1502878419726357018
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process save (
        name: Save
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                   --
                  pidprevisaopagamento  number := :P153_IDPREVISAOPAGAMENTO ;
                  pdatainclusao         date   ; 
                  pidsemanainclusao     number := :P153_IDSEMANAINCLUSAO ; 
                  pidusuario            number := :P153_IDUSUARIO ;
                  pidfilial             number := :P153_IDFILIAL ;
                  pdataprevisao         date   := to_date(:P153_DATAPREVISAO,'DD/MM/RRRR') ;
                  pidsemanaprevisao     number := :P153_IDSEMANAPREVISAO;
                  pvalorprevisao        number := to_number(:P153_VALORPREVISAO,'999G999G999G990D00');
                  pidfornecedor         number         := :P153_IDFORNECEDOR;
                  pnomefornecedor       varchar2(1000) := :P153_NOMEFORNECEDOR;
                  pdescricao            varchar2(1000) := :P153_DESCRICAO; 
                  precebido             varchar2(1000) := :P153_RECEBIDO;
                  pdatarecebido         date           := to_date(:P153_DATARECEBIDO ,'DD/MM/RRRR') ;
                  pcrisdu               varchar2(1000) := :P153_CRISDU           ;
                  pidformapagamento     varchar2(1000) := :P153_IDFORMAPAGAMENTO ;
                  pidmoeda              number         := :P153_IDMOEDA          ;
                   --
                begin
                  --
                  if :P153_IDPREVISAOPAGAMENTO is null then
                    --
                    :P153_OPERACAO_DML := 'I';
                    --
                  else
                    --
                    :P153_OPERACAO_DML := 'U';
                    --
                  end if;
                  --
                  --vvalorprevisao := to_number(:P153_VALORPREVISAO,'999G999G999G990D00');
                  --
                  PCK_FINANCEIRO_RMC.PRC_PREVISOESPAGAMENTOS( PIDPREVISAOPAGAMENTO  => pidprevisaopagamento
                                                            , PDATAINCLUSAO         => pdatainclusao      
                                                            , PIDSEMANAINCLUSAO     => pidsemanainclusao  
                                                            , PIDUSUARIO            => pidusuario         
                                                            , PIDFILIAL             => pidfilial          
                                                            , PDATAPREVISAO         => pdataprevisao      
                                                            , PIDSEMANAPREVISAO     => pidsemanaprevisao  
                                                            , PVALORPREVISAO        => pvalorprevisao     
                                                            , PIDFORNECEDOR         => pidfornecedor      
                                                            , PNOMEFORNECEDOR       => pnomefornecedor    
                                                            , PDESCRICAO            => pdescricao          -- :P153_DESCRICAO
                                                            , PRECEBIDO             => precebido           -- :P153_RECEBIDO
                                                            , PDATARECEBIDO         => pdatarecebido       -- :P153_DATARECEBIDO
                                                            , PCRISDU               => pcrisdu             -- :P153_CRISDU             
                                                            , PIDFORMAPAGAMENTO     => pidformapagamento   -- :P153_IDFORMAPAGAMENTO  --:P153_IDFORMAPAGAMENTO   
                                                            , PIDMOEDA              => pidmoeda            -- :P153_IDMOEDA            
                                                            , PMD5                  => :P153_MD5
                                                            , POPERACAO_DML         => :P153_OPERACAO_DML) ;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1578260037101766705
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        name: Go To Page 145
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 145
                clearCache: 153
                action: resetPagination
            }
        }
    )

)

