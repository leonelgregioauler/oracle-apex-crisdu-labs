page 703 (
    name: Pix Santander - DDA Boletos
    title: Pix Santander - DDA Boletos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            // Enter na caixa de busca vale como clique no botao Buscar.
            $(function () {
              $("#P703_BUSCA").on("keydown", function (e) {
                if (e.which === 13) { e.preventDefault(); apex.submit("BUSCAR"); }
              });
            });
            ```
    }
    security {
        authorizationScheme: @autoriza-pix-operador
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region a-vencer-próximos-dias (
        name: A vencer (próximos dias)
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select case when d.idpgtoforn is not null
                             and not exists ( select 1 from pix_pagamentos px
                                               where px.idpgtoforn = d.idpgtoforn
                                                 and px.status not in ('REJECTED','ERRO','CANCELADO') )
                        then apex_item.checkbox2(1, d.iddda) end sel
                     , d.iddda
                     , substr(d.code,1,25) || '...' linha_digitavel
                     , d.dt_vencimento
                     , d.dt_limite_pgto
                     , to_char(d.valor_nominal,'FM999G999G999G990D00') valor
                     , d.benef_nome beneficiario
                     , d.benef_documento cnpj_cpf
                     , d.especie
                     , case d.match_tipo
                         when 'AUTO_EXATO'   then 'Fatura ' || d.idpgtoforn || ' (exato)'
                         when 'AUTO_PARCIAL' then 'Fatura ' || d.idpgtoforn || ' (conferir venc.)'
                         when 'MANUAL'       then 'Fatura ' || d.idpgtoforn || ' (manual)'
                         else '(!) Sem fatura vinculada'
                       end vinculo
                     , (select pck_romance.fnc_nomefornecedor(pf.idfornecedor)
                          from pagamentosfornecedores pf
                         where pf.idpgtoforn = d.idpgtoforn) fornecedor_fatura
                     , case when exists ( select 1 from pix_pagamentos px
                                           where px.idpgtoforn = d.idpgtoforn
                                             and px.status not in ('REJECTED','ERRO','CANCELADO') )
                            then 'Em pagamento'
                            when d.situacao_titulo = 'SCHEDULED' then 'Agendado no banco'
                            when d.situacao_titulo = 'PAID'      then 'Pago no banco' end em_pagamento
                     , (select substr(sc.beneficiario,1,25) from santander_contas sc
                         where sc.idcontabanc = d.idcontabanc) conta
                     , d.nosso_numero
                     , d.seu_numero
                  from dda_titulos d
                 where d.dt_vencimento > trunc(sysdate)
                   and (:P703_SO_PENDENTES = 'N'
                        or not exists ( select 1 from pix_pagamentos px
                                         where px.idpgtoforn = d.idpgtoforn
                                           and px.status not in ('REJECTED','ERRO','CANCELADO') ))
                   and ( :P703_CONTA is null or d.idcontabanc = :P703_CONTA )
                   and ( :P703_DTINI is null or d.dt_vencimento >= to_date(:P703_DTINI,'DD/MM/RRRR') )
                   and ( :P703_DTFIM is null or d.dt_vencimento <= to_date(:P703_DTFIM,'DD/MM/RRRR') )
                       -- situacao do vinculo com a fatura / do titulo no banco
                   and ( :P703_STATUS is null
                         or ( :P703_STATUS = 'SEM'   and nvl(d.match_tipo,'-') not in ('AUTO_EXATO','AUTO_PARCIAL','MANUAL') )
                         or ( :P703_STATUS = 'VINC'  and d.match_tipo in ('AUTO_EXATO','MANUAL') )
                         or ( :P703_STATUS = 'PARC'  and d.match_tipo = 'AUTO_PARCIAL' )
                         or ( :P703_STATUS = 'BANCO' and d.situacao_titulo in ('SCHEDULED','PAID') ) )
                       -- uma caixa so: nome do cedente, CNPJ, fornecedor da fatura ou valor
                   and ( :P703_BUSCA is null
                         or upper(d.benef_nome) like '%' || upper(:P703_BUSCA) || '%'
                         or upper(d.seu_numero) like '%' || upper(:P703_BUSCA) || '%'
                         or upper(d.nosso_numero) like '%' || upper(:P703_BUSCA) || '%'
                         or upper( (select pck_romance.fnc_nomefornecedor(pf.idfornecedor)
                                      from pagamentosfornecedores pf
                                     where pf.idpgtoforn = d.idpgtoforn) )
                            like '%' || upper(:P703_BUSCA) || '%'
                            -- so vale como CNPJ/CPF com 8+ digitos: trechos curtos como
                            -- '19000' aparecem dentro de quase todo CNPJ de matriz
                         or ( length(regexp_replace(:P703_BUSCA,'[^0-9]')) >= 8
                              and d.benef_documento like '%' || regexp_replace(:P703_BUSCA,'[^0-9]') || '%' )
                            -- valor: aceita 19000, 19.000 e 19.000,00; texto vira nulo
                         or nvl(d.valor_nominal, -1) = to_number( replace(replace(:P703_BUSCA,'.'),',','.')
                                                                  default null on conversion error )
                         or trunc(nvl(d.valor_nominal, -1)) = to_number( replace(replace(:P703_BUSCA,'.'),',','.')
                                                                         default null on conversion error ) )
                 order by d.dt_vencimento, d.iddda
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        download {
            csvExportEnabled: true
        }

