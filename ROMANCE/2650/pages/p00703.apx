    process consulta-dda-no-santander (
        name: Consulta DDA no Santander
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Em segundo plano: a busca por cedente pode passar de 1 minuto e o
                  -- proxy web corta a requisicao em 60 s (504).
                  roman.pck_santander_pix.prc_consultar_dda_async(:APP_USER);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Busca do DDA iniciada em segundo plano. Recarregue a página em 1 a 2 minutos; o andamento aparece em "Última busca".
        }
        advanced {
            executionMappingIdentifier: 971000000000703080
        }
        serverSideCondition {
            whenButtonPressed: @consultar-dda
        }
    )

    process envia-boletos-selecionados (
        name: Envia boletos selecionados
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vok    number := 0;
                  verros number := 0;
                  vmsg   varchar2(32767);
                begin
                  if apex_application.g_f01.count = 0 then
                    apex_error.add_error(
                      p_message          => 'Selecione ao menos um boleto vinculado a fatura.',
                      p_display_location => apex_error.c_inline_in_notification);
                    return;
                  end if;
                
                  for i in 1 .. apex_application.g_f01.count loop
                    begin
                      roman.pck_santander_pix.prc_enviar_boleto(
                        piddda   => to_number(apex_application.g_f01(i)),
                        pusuario => :APP_USER );
                      vok := vok + 1;
                    exception
                      when others then
                        verros := verros + 1;
                        vmsg := substr(vmsg || 'Titulo ' || apex_application.g_f01(i) || ': ' ||
                                       sqlerrm || ' | ', 1, 30000);
                    end;
                  end loop;
                
                  if verros > 0 then
                    apex_error.add_error(
                      p_message          => vok || ' enviado(s), ' || verros || ' com erro. ' || vmsg,
                      p_display_location => apex_error.c_inline_in_notification);
                  end if;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Boletos enviados. Aguardando autorização da gestora na página 701.
        }
        advanced {
            executionMappingIdentifier: 971000000000703081
        }
        serverSideCondition {
            whenButtonPressed: @enviar-boletos
        }
    )

    process vincula-titulo-a-fatura-manualmente (
        name: Vincula titulo a fatura manualmente
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vsaldo number;
                begin
                  if :P703_IDDDA is null or :P703_IDPGTOFORN is null then
                    apex_error.add_error(
                      p_message          => 'Informe o Id do titulo DDA e o Id da fatura.',
                      p_display_location => apex_error.c_inline_in_notification);
                    return;
                  end if;
                
                  select pf.valorpagar - nvl(pf.desconto,0) + nvl(pf.acrescimo,0)
                       - nvl(pf.valorpago,0) into vsaldo
                    from roman.pagamentosfornecedores pf
                   where pf.idpgtoforn = :P703_IDPGTOFORN;
                
                  if vsaldo <= 0 then
                    apex_error.add_error(
                      p_message          => 'Fatura ' || :P703_IDPGTOFORN || ' sem saldo a pagar.',
                      p_display_location => apex_error.c_inline_in_notification);
                    return;
                  end if;
                
                  update roman.dda_titulos
                     set idpgtoforn = :P703_IDPGTOFORN
                       , match_tipo = 'MANUAL'
                   where iddda = :P703_IDDDA;
                
                  if sql%rowcount = 0 then
                    apex_error.add_error(
                      p_message          => 'Titulo DDA ' || :P703_IDDDA || ' nao encontrado.',
                      p_display_location => apex_error.c_inline_in_notification);
                    return;
                  end if;
                
                  commit;
                exception
                  when no_data_found then
                    apex_error.add_error(
                      p_message          => 'Fatura ' || :P703_IDPGTOFORN || ' nao encontrada.',
                      p_display_location => apex_error.c_inline_in_notification);
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Título vinculado à fatura.
        }
        advanced {
            executionMappingIdentifier: 971000000000703082
        }
        serverSideCondition {
            whenButtonPressed: @vincular
        }
    )

