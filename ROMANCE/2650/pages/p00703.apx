    region última-busca-no-santander (
        name: Última busca no Santander
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                  vstatus  varchar2(20) := roman.pck_santander_pix.fnc_dda_status;
                  vultima  varchar2(400);
                  vquando  varchar2(20);
                  vavisos  number;
                begin
                  begin
                    select to_char(l.momento,'DD/MM HH24:MI'), substr(l.payload_resp,1,300)
                      into vquando, vultima
                      from roman.pix_log l
                     where l.operacao = 'DDA' and l.payload_resp like 'Consulta DDA:%'
                     order by l.momento desc
                     fetch first 1 rows only;
                  exception when no_data_found then vquando := null; end;
                
                  select count(*) into vavisos
                    from roman.pix_log l
                   where l.operacao = 'DDA' and l.payload_resp like 'ATENCAO%'
                     and l.momento > (select nvl(max(m.momento), sysdate - 1) from roman.pix_log m
                                       where m.operacao = 'DDA' and m.payload_resp like 'Busca DDA iniciada%');
                
                  htp.p('<div style="padding:8px 12px">');
                  if vstatus = 'EM_ANDAMENTO' then
                    htp.p('<span class="fa fa-spinner fa-anim-spin"></span> <b>Busca em andamento</b> - recarregue a página em alguns instantes. ');
                  end if;
                  if vquando is not null then
                    htp.p('Última busca concluída em <b>' || vquando || '</b>: ' || apex_escape.html(vultima));
                    if vavisos > 0 then
                      htp.p(' <span class="u-warning-text">(' || vavisos || ' aviso(s) de dia com lista incompleta - ver página 702, log)</span>');
                    end if;
                  else
                    htp.p('Nenhuma busca concluída ainda.');
                  end if;
                  htp.p('</div>');
                end;
                ```
        }
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

