        savedReport 3564933 (
            visibility: primaryDefault
            view {
                chart: true
                default: chart
                rowsPerPage: 15
            }

            displayColumn DATA (
                sequence: 7
            )

            displayColumn DATALIGACAO (
                sequence: 4
            )

            displayColumn DATAT (
                sequence: 11
            )

            displayColumn OBSERVACAO (
                sequence: 8
            )

            displayColumn REPRESENTANTE (
                sequence: 2
            )

            displayColumn TELEFONE (
                sequence: 1
            )

            displayColumn TEMPODECORRIDO (
                sequence: 9
            )

            displayColumn TEMPODECORRIDON (
                sequence: 10
            )

            displayColumn TEMPOTOTAL (
                sequence: 6
            )

            displayColumn TIPOLIGACAO (
                sequence: 5
            )

            displayColumn USUARIOATENDEU (
                sequence: 3
            )

            sort (
                column: DATA
                sort {
                    sequence: 1
                }
            )

            sort (
                column: IDCONTROLE
                sort {
                    direction: desc
                    sequence: 2
                }
            )

            controlBreak (
                column: TELEFONE
                layout {
                    sequence: 1
                }
            )

            controlBreak (
                column: TEMPOTOTAL
                layout {
                    sequence: 2
                }
            )

            chart {
                label: TIPOLIGACAO
                value: TEMPODECORRIDON
                valueAggregation: sum
            }
            axisTitle {
                label: Tipo
                value: Horas
            }
            sort {
                by: valueDesc
            }
        )

    )

    pageItem P280_DIA (
        type: selectList
        label {
            label: Dia
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select data display_value
                     , data return_value
                from dias
                where data <= trunc(sysdate)
                  and to_char(data,'RRRR') = TO_CHAR(SYSDATE,'RRRR')
                order by 1 desc
                ```
            nullDisplayValue: - Selecione o dia -
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

)

