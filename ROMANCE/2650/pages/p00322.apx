page 322 (
    name: Contas e Subcontas do Ano
    title: Contas e Subcontas do Ano
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 70%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region contas-e-subcontas-do-ano (
        name: Contas e Subcontas do Ano
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select g.IDGESTAOORCAMENTARIA,
                       g.IDCENTRODECUSTO,
                       g.IDCONTAFINANCEIRA,
                       g.IDSUBCONTAFINANCEIRA,
                --       DATAORCAMENTO,
                       REFERENTE,
                --       USUARIO,
                       g.VALORDESPESAS,
                --       VALORPROPOSTA,
                --       VALORCONTRAPROPOSTA,
                --       DATARESPOSTA,
                --       VALORFINAL,
                --       DATAAPROVACAO,
                       VIGENCIA,
                --       JUSTIFICATIVA,
                       g.MESINICIAL,
                       g.MESFINAL
                  from GESTAOORCAMENTARIA G
                  where g.idcentrodecusto = :P322_IDCENTRODECUSTO
                    and g.referente       = (select referente 
                                               from gestaoorcamentaria
                                              where idgestaoorcamentaria = :P322_IDGESTAOORCAMENTARIA)
                    and g.mesinicial      = (select mesinicial
                                               from gestaoorcamentaria
                                              where idgestaoorcamentaria = :P322_IDGESTAOORCAMENTARIA)
                    and g.mesfinal        = (select mesfinal
                                               from gestaoorcamentaria
                                              where idgestaoorcamentaria = :P322_IDGESTAOORCAMENTARIA)
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 563137989090488162
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
                rowsPerPage: 100
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDGESTAOORCAMENTARIA
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDCENTRODECUSTO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @IDCONTAFINANCEIRA
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @IDSUBCONTAFINANCEIRA
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @VALORDESPESAS
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @MESINICIAL
                layout {
                    sequence: 17
                }
            )

            displayColumn (
                column: @MESFINAL
                layout {
                    sequence: 18
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @REFERENTE
                layout {
                    sequence: 19
                }
            )

            displayColumn (
                column: @VIGENCIA
                layout {
                    sequence: 20
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column IDCENTRODECUSTO (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IDCENTRODECUSTO
                dataType: number
            }
            default {
                type: item
                item: P322_IDCENTRODECUSTO
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDCONTAFINANCEIRA (
            type: selectList
            heading {
                heading: Conta Financeira
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nomeconta d
                         , idcontafinan r
                      from contasfinanceiras c
                    order by 1
                    ```
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: IDCONTAFINANCEIRA
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDGESTAOORCAMENTARIA (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDGESTAOORCAMENTARIA
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: SEQ_IDGESTAOORCAMENTARIA
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDSUBCONTAFINANCEIRA (
            type: selectList
            heading {
                heading: Sub-Conta Financeira
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nomeconta d
                         , idsubcontafinan r
                      from subcontasfinanceiras
                      where idcontafinan = :IDCONTAFINANCEIRA
                    order by 1
                    ```
            }
            cascadingLov {
                parentColumns: IDCONTAFINANCEIRA
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: IDSUBCONTAFINANCEIRA
                dataType: number
            }
        )

        column MESFINAL (
            type: numberField
            heading {
                heading: Mesfinal
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            source {
                databaseColumn: MESFINAL
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column MESINICIAL (
            type: numberField
            heading {
                heading: Mesinicial
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                databaseColumn: MESINICIAL
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column REFERENTE (
            type: hidden
            layout {
                sequence: 110
            }
            source {
                databaseColumn: REFERENTE
                dataType: number
            }
            default {
                type: sqlQuerySingleValue
                sqlQuerySingleValue:
                    ```sql
                    select referente 
                      from gestaoorcamentaria
                     where idgestaoorcamentaria = :P322_IDGESTAOORCAMENTARIA
                    ```
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column VALORDESPESAS (
            type: numberField
            heading {
                heading: Valordespesas
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                databaseColumn: VALORDESPESAS
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column VIGENCIA (
            type: hidden
            layout {
                sequence: 120
            }
            source {
                databaseColumn: VIGENCIA
                dataType: number
            }
            default {
                type: sqlQuerySingleValue
                sqlQuerySingleValue:
                    ```sql
                    select VIGENCIA 
                      from gestaoorcamentaria
                     where idgestaoorcamentaria = :P322_IDGESTAOORCAMENTARIA
                    ```
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

    )

    pageItem P322_IDCENTRODECUSTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @contas-e-subcontas-do-ano
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P322_IDGESTAOORCAMENTARIA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @contas-e-subcontas-do-ano
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar e Atualizar
        layout {
            sequence: 30
            region: @contas-e-subcontas-do-ano
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 443
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: custom
            customEvent: interactivegridsave
            selectionType: region
            region: @contas-e-subcontas-do-ano
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @contas-e-subcontas-do-ano
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process contas-e-subcontas-do-ano-save-interactive-grid-data (
        name: Contas e Subcontas do Ano - Save Interactive Grid Data
        type: executeCode
        editableRegion: @contas-e-subcontas-do-ano
        source {
            plsqlCode:
                ```plsql
                declare
                 vidgestao number;
                begin
                  --raise_application_error(-20001,'xxxxxxx' || :APEX$ROW_STATUS);
                  if :APEX$ROW_STATUS = 'C' then
                    --
                    select seq_idgestaoorcamentaria.nextval
                      into vidgestao
                      from dual;
                    INSERT INTO gestaoorcamentaria (idgestaoorcamentaria,
                                                    idcentrodecusto,
                                                    idcontafinanceira,
                                                    idsubcontafinanceira,
                                                    dataorcamento,
                                                    referente,
                                                    usuario,
                                                    valordespesas,
                                                    valorproposta,
                                                    valorcontraproposta,
                                                    vigencia,
                                                    mesinicial,
                                                    mesfinal)
                    VALUES (vidgestao,
                            :P322_IDCENTRODECUSTO,
                            :IDCONTAFINANCEIRA,
                            :IDSUBCONTAFINANCEIRA,
                            sysdate,
                            (SELECT referente
                               FROM gestaoorcamentaria
                              WHERE idgestaoorcamentaria = :P322_IDGESTAOORCAMENTARIA),
                            V('APP_USER'),
                            :VALORDESPESAS,
                            0,
                            0,
                            (SELECT vigencia
                               FROM gestaoorcamentaria
                              WHERE idgestaoorcamentaria = :P322_IDGESTAOORCAMENTARIA),
                            :MESINICIAL,
                            :MESFINAL );
                   --
                   INSERT INTO propostasorcamentosmes (idpropostaorcamentomes,
                                                       idgestaoorcamentaria)
                          VALUES (seq_idpropostaorcamentomes.nextval, vidgestao);
                   --
                   INSERT INTO contrapropostasorcamentosmes (idcontrapropostaorcamentomes,
                                                             idgestaoorcamentaria)
                          VALUES (seq_idcontrapropostaorcamentomes.nextval, vidgestao);
                   --
                   INSERT INTO orcamentosmes (idorcamentomes,
                                              idgestaoorcamentaria)
                          VALUES (seq_idorcamentomes.nextval, vidgestao);
                   --
                  end if;
                  -------
                  if :APEX$ROW_STATUS = 'D' then
                    delete from orcamentosmes
                     where idgestaoorcamentaria = :IDGESTAOORCAMENTARIA;
                    --
                    delete from contrapropostasorcamentosmes
                     where idgestaoorcamentaria = :IDGESTAOORCAMENTARIA;
                    --
                    delete from propostasorcamentosmes
                     where idgestaoorcamentaria = :IDGESTAOORCAMENTARIA;
                    --
                    delete from gestaoorcamentaria
                     where idgestaoorcamentaria = :IDGESTAOORCAMENTARIA;
                  end if;
                
                commit;
                
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Contas e Subcontas atualizadas!
        }
        advanced {
            executionMappingIdentifier: 562682535089049219
        }
    )

    branch (
        name: Volta
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 443
                items: {
                    P443_IDCENTRODECUSTO: &P322_IDCENTRODECUSTO.
                    P443_PERIODO_ORCAMENTO: &P322_IDGESTAOORCAMENTARIA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @fechar
        }
    )

)

