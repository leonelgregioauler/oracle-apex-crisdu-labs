page 526 (
    name: SubContas CFOPs
    alias: SUBCONTAS-CFOPS
    title: SubContas CFOPs
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 50%
        resizable: false
    }
    css {
        inline:
            ```css
            .t-Dialog-bodyWrapperIn {
                background: rgb(239, 232, 232);
            }
            ```
    }

    region new (
        name: New
        type: form
        source {
            location: localDatabase
            tableName: SUBCONTASCLASSIFICACOES
            whereClause: idsubcontaclassificacao = :P526_IDSUBCONTACLASSIFICACAO
        }
        layout {
            sequence: 30
            slot: contentBody
            columnCssClasses: background="aliceblue"
        }
        readOnly {
            type: item=value
            item: P526_TIPOCONTA
            value: S
        }
    )

    pageItem P526_CLASSIFICACAO (
        type: displayOnly
        label {
            label: Classificação
            alignment: left
        }
        layout {
            sequence: 50
            region: @new
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @new
            column: IDCLASSIFICACAO
            dataType: number
        }
    )

    pageItem P526_IDCFOP (
        type: shuttle
        label {
            label: CFOPs Classificações
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT idcfop d
                     , idcfop    r
                  FROM crisdu.cfop
                 ORDER BY 1
                ```
        }
        layout {
            sequence: 70
            region: @new
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 5
        }
        source {
            type: databaseColumn
            databaseColumn: IDCFOP
            used: always
        }
        default {
            type: sqlQueryMultipleValues
            sqlQueryMultipleValues:
                ```sql
                SELECT idcfop --LISTAGG(idsubcontafinan, ':') WITHIN GROUP (ORDER BY idsubcontafinan)
                  FROM cfopssubclassificacoes
                 WHERE idclassificacao = :P526_IDCLASSIFICACAO
                ```
        }
    )

    pageItem P526_IDCLASSIFICACAO (
        type: hidden
        layout {
            sequence: 20
            region: @new
            slot: regionBody
        }
        source {
            formRegion: @new
            column: IDCLASSIFICACAO
            dataType: number
        }
    )

    pageItem P526_IDSUBCONTACLASSIFICACAO (
        type: hidden
        layout {
            sequence: 10
            region: @new
            slot: regionBody
        }
        source {
            formRegion: @new
            column: IDSUBCONTACLASSIFICACAO
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P526_TIPOCLASSIFICACAO (
        type: radioGroup
        label {
            label: Tipo Class.:
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC:Provisão;P,Contábil;C
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @new
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @new
            column: TIPOCLASSIFICACAO
            dataType: varchar2
        }
    )

    pageItem P526_TIPOCONTA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @new
            slot: regionBody
        }
    )

    pageItem P526_TIPOLANCTO (
        type: hidden
        layout {
            sequence: 30
            region: @new
            slot: regionBody
        }
    )

    button salvar (
        buttonName: SALVAR
        label: Salvar
        layout {
            sequence: 80
            region: @new
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Fechar
        layout {
            sequence: 90
            region: @new
            slot: regionBody
            startNewRow: false
            column: 2
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction fechar (
        name: Fechar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @voltar
        }

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-form-subcontas-cfop (
        name: Initialize form SubContas Cfop
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  --
                  l_valores    varchar2(4000);
                  l_tipoclass  varchar2(1);
                  --
                BEGIN
                  --
                  select classificacao ||' - '|| descricaoconta 
                     into :P526_CLASSIFICACAO
                    from planocontasgeral
                   where idclassificacao = :P526_IDCLASSIFICACAO;
                  --
                  begin
                    --
                    SELECT LISTAGG(idcfop, ':') WITHIN GROUP (ORDER BY idcfop)
                         , tipoclassificacao
                      INTO l_valores
                         , l_tipoclass
                      FROM cfopssubclassificacoes
                     WHERE idclassificacao = :P526_IDCLASSIFICACAO
                     group by tipoclassificacao;
                    --
                    :P526_IDCFOP   := l_valores;
                    :P526_TIPOCLASSIFICACAO := l_tipoclass;
                    --
                    --
                  exception
                    when no_data_found then null;
                  end;
                
                  --  RAISE_APPLICATION_ERROR(-20001,'IDs '||l_valores);
                  --
                END;
                
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 1075903829689123579
        }
    )

    process salvardados (
        name: SalvarDados
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  v_id number;
                  v_idclassificacao   number := :P526_IDCLASSIFICACAO;
                  v_idsubclassif      number;
                  v_idcfop            number;
                  v_tipoclassif       varchar2(1) := :P526_TIPOCLASSIFICACAO;
                  v_numnull           number;
                  v_md5               varchar2(1000);
                  --
                begin
                  --
                  -- Exclui toda a configuração da classificacao e depois inclui os selecionados
                  begin
                    delete from cfopssubclassificacoes
                     where idclassificacao = :P526_IDCLASSIFICACAO;
                  exception
                    when others then null;
                  end;
                  --
                  FOR r IN ( SELECT column_value AS idcfop
                               FROM TABLE(apex_string.split(:P526_IDCFOP, ':')) )
                  LOOP
                    --
                    select seq_idcfopssubclassif.nextval
                      into v_id
                      from dual;
                    --
                    v_idcfop := r.idcfop;
                    --
                    pck_contabilidade_rmc.prc_cfopssubclassificacoes(pidcfopssubclassif  => v_id,
                                                                     pidclassificacao    => v_idclassificacao,
                                                                     pidsubclassificacao => v_idsubclassif,
                                                                     pidcfop             => v_idcfop,
                                                                     ptipoclassificacao  => v_tipoclassif,
                                                                     pmd5                => v_md5,
                                                                     poperacao_dml       => 'I');
                    --
                  END LOOP;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Dados salvos com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1075904252893123580
        }
        serverSideCondition {
            whenButtonPressed: @salvar
        }
    )

    branch (
        name: Volta_526
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 526
                items: {
                    P526_IDCLASSIFICACAO: &P526_IDCLASSIFICACAO.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @salvar
        }
    )

)

