    region processadas-com-erro (
        name: Processadas Com Erro
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idcontasarecebervirutalage
                     , c.cliente
                     , nvl( ( select pck_romance.fnc_nomefornecedor(r.idfornecedor)
                              from razoessociaisfornec r
                              where r.codigovirtualage = trim(to_number(c.cliente)) ),'Fornecedor não Localizado') fornecedor
                     , c.cpf_cnpj
                     , c.empresa
                     , c.fatura
                     , c.parcela
                     , c.documento
                     , c.portador
                     , c.emissao
                     , c.venc_orig
                     , c.vencimento
                     , c.liquidacao
                     , c.valor_fatura
                from contasarecebervirtualage c
                where c.processado = 'E'
                  and trunc(c.dataimportacao) = trunc(sysdate)
                  and c.cliente is not null
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
