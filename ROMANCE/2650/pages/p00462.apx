    button finish (
        buttonName: FINISH
        label: Finalizar
        layout {
            sequence: 30
            region: @resultado
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 459
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

