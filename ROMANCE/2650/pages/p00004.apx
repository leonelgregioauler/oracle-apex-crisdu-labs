page 4 (
    name: Lista de Eventos
    title: Lista de Eventos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region lista-de-eventos (
        name: Lista de Eventos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDCHAMADO "Nro Evento"
                  , DATAABERTURA "Abertura"
                  , USUARIO "Usuário"
                  , (select s.descricao
                     from situacoes s
                     where s.idsituacao = c.idsituacao) "Situação"
                  , DESCRICAO "Descrição"
                  , TITULO "Título"
                  , (select t.tipochamado
                     from tiposchamados t
                     where t.idtipochamado = c.idtipochamado) "O que"
                  , (select t.tipochamado
                     from tiposchamados t
                     where t.iditemchamado = c.iditemchamado ) "Onde"
                  , (select ss.servicochamado
                     from servicoschamados ss
                     where ss.idservicochamado = c.idservicochamado) "Registro"
                  , c.prioridade "Prioridade"
                  , c.responsavel "Responsável"
                  , c.dataencerrado "Dt Encerrado"
                  , c.percconcluido "% Conclúido"
                  , c.prazoatendimento "Prazo"
                  , c.complexidade "Complexidade"
                  , (select i.descricao
                     from impactostrabalho i
                     where i.idimpactotrabalho = c.idimpactotrabalho) "Impacto"
                  , c.avaliacaotempo "Av. Tempo"
                  , c.avaliacaoatendimento "Av. Atendimento"
                  , c.avalcordialidade "Av. Cordialidade"
                  , c.observacaoatendimento "Observação"
                  , c.dataatendido "Data Atendido"
                  , c.datainicioatendimento "Dt Inicio"
                  , c.dataprogramado "Dt Programado"
                  , c.idacessoremoto "Acesso Remoto"
                from CHAMADOS C
                where USUARIO = v('APP_USER')
                order by 1 desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 68713203986333934
        }

