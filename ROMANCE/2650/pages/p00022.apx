    pageItem P22_IDFECHAMENTO (
        type: selectList
        label {
            label: Fechamento
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select semana display_value
                     , idfechamento return_value
                from fechamentossemanais
                where idfilial = :P0_IDFILIALCAIXA
                  and concluido = 'N'
                  and :P204_IDEMPRESTIMO IS NULL
                ```
