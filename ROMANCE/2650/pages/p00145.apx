    button incluirnovo (
        buttonName: IncluirNovo
        label: Incluir Novo
        layout {
            sequence: 10
            region: @botões
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 153
                items: {
                    P153_IDPREVISAOPAGAMENTO:
                }
                clearCache: 153
