page 145 (
    name: Previsões de Gasto
    title: Previsões de Gasto
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region botões (
        name: Botões
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region previsões-de-gasto (
        name: Previsões de Gasto
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idprevisaopagamento
                     , datainclusao  
                     , idsemanainclusao
                     , semanainclusao
                     , idusuario
                     , nomeusuario 
                     , idfilial
                     , nomefilial
                     , dataprevisao  
                     , idsemanaprevisao
                     , semanaprevisao
                     , valorprevisao
                     , idfornecedor
                     , nomefornecedorcad
                     , nomefornecedor
                     , nomefornecedorcad2
                     , descricao   
                     , recebido
                     , datarecebido
                     , moeda
                     , crisdu
                     , formapagamento
                from vw_previsoespagamentos q
                where idfilial = :P0_IDFILIALCAIXA
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 153
                items: {
                    P153_IDPREVISAOPAGAMENTO: #IDPREVISAOPAGAMENTO#
                }
                clearCache: 153
                action: resetPagination
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 1578102548321667541
        }

        column CRISDU (
            type: plainText
            heading {
                heading: Crisdu
                alignment: center
            }
            layout {
                sequence: 103
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: V
            }
        )

