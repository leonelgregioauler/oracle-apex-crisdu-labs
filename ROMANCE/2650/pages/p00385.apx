page 385 (
    name: Rastrear Matriz de Classificações
    title: Rastrear Matriz de Classificações
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region despesas-classificadas (
        name: Despesas Classificadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.classificacaodespesa
                     , pck_romance.fnc_nomefilial(d.idfilial) empresa
                     , d.semana semanadespesa
                     , ( select f.semana
                         from fechamentossemanais f
                         where f.idfechamento = d.idfechamento ) semanafechamento
                     , w.centrodecusto
                     , w.conta
                     , w.subconta
                     , d.valor
                     , d.observacao
                     , d.datalancamento
                from despesas d
                   , vw_matrizclassificacoesdesp w
                where d.idmatrizclassificacao = w.idmatrizclassificacao
                  and ( :P385_IDMATRIZCLASSIFICACAO is null or d.idmatrizclassificacao = :P385_IDMATRIZCLASSIFICACAO )
                  and ( :P385_CLASSIFICACAO is null or w.classificacaodespesa like '%'||:P385_CLASSIFICACAO||'%' )
                  and ( :P385_IDCENTRODECUSTO is null or w.idcentrodecusto = :P385_IDCENTRODECUSTO )
                  and ( :P385_IDFILIAL is null or d.idfilial = :P385_IDFILIAL )
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 73675221897481620
        }

        column CENTRODECUSTO (
            type: plainText
            heading {
                heading: Centro de Custo
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column CLASSIFICACAODESPESA (
            type: plainText
            heading {
                heading: Classificação
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column CONTA (
            type: plainText
            heading {
                heading: Conta
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column DATALANCAMENTO (
            type: plainText
            heading {
                heading: Data Lançamento
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: J
            }
        )

        column EMPRESA (
            type: plainText
            heading {
                heading: Empresa
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column OBSERVACAO (
            type: plainText
            heading {
                heading: Observação Despesa
                alignment: center
            }
            layout {
                sequence: 90
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        column SEMANADESPESA (
            type: plainText
            heading {
                heading: Semana Despesa
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column SEMANAFECHAMENTO (
            type: plainText
            heading {
                heading: Semana do Fechamento
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column SUBCONTA (
            type: plainText
            heading {
                heading: Sub Conta
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column VALOR (
            type: plainText
            heading {
                heading: Valor
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 791292 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CENTRODECUSTO (
                sequence: 5
            )

            displayColumn CLASSIFICACAODESPESA (
                sequence: 1
            )

            displayColumn CONTA (
                sequence: 6
            )

            displayColumn DATALANCAMENTO (
                sequence: 10
            )

            displayColumn EMPRESA (
                sequence: 2
            )

            displayColumn OBSERVACAO (
                sequence: 9
            )

            displayColumn SEMANADESPESA (
                sequence: 3
            )

            displayColumn SEMANAFECHAMENTO (
                sequence: 4
            )

            displayColumn SUBCONTA (
                sequence: 7
            )

            displayColumn VALOR (
                sequence: 8
            )

        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P385_CLASSIFICACAO (
        type: textField
        label {
            label: Classificação
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P385_IDCENTRODECUSTO (
        type: selectList
        label {
            label: Centro de Custo
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nome
                     , c.idcentrodecusto
                from centrodecustos c
                order by 1
                ```
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P385_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idfilial
                from vw_filiais f
                where f.ativo = 'S'
                ```
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P385_IDMATRIZCLASSIFICACAO (
        type: popupLov
        label {
            label: Matriz Completa
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.classificacaodespesa||' Centro: '||w.centrodecusto||' C: '||w.conta||' S: '||w.subconta||' Empresa: '||w.empresa
                     , w.idmatrizclassificacao
                from vw_matrizclassificacoesdesp w
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button buscar (
        buttonName: BUSCAR
        label: Buscar
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 385
                items: {
                    P385_IDMATRIZCLASSIFICACAO: &P385_IDMATRIZCLASSIFICACAO.
                    P385_CLASSIFICACAO: &P385_CLASSIFICACAO.
                    P385_IDCENTRODECUSTO: &P385_IDCENTRODECUSTO.
                    P385_IDFILIAL: &P385_IDFILIAL.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

)

