page 484 (
    name: Anexos Participantes Convenção
    title: Anexos Participantes Convenção
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function fnc_verimg(pid)
            {
              window.open('http://anexos.romancemoda.com.br/'+pid);
              void(0);
            }
            
            function fnc_removeanexo(pidanexo,pnomeanexo)
            {
                apex.confirm("Deseja realmente remover o anexo "+pnomeanexo+"?", {
              request:"DELETAR",
              set:{"P484_IDANEXODELETAR":pidanexo}
              });
            }
            ```
    }

    region anexos-doc-pessoas (
        name: "Anexos Doc. Pessoas "
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            footerText: <font color="green"> Você pode anexar mais de um arquivo.</font>
        }
        settings {
            outputAs: text
        }
    )

    region arquivos-anexados (
        name: Arquivos Anexados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomearquivo
                     --, '<a href="javascript: fnc_verimg('''||iddespesa||idanexodespesa||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10)||''');">Ver arquivo</a>' 
                     , T.IDPESSOACONVENCAO||T.IDANEXOPESSOASCONVENCAO||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10) link
                     , dataanexo
                     , ( select pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario ) usuario 
                     , '<a href="javascript: fnc_removeanexo('||T.IDANEXOPESSOASCONVENCAO||','''||t.nomearquivo||''');">Remover</a>' remover
                from ANEXOSPESSOASCONVENCAO t
                where T.IDPESSOACONVENCAO = :P484_IDPESSOACONVENCAO
                order by t.dataanexo
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column DATAANEXO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Data Anexo
                alignment: center
            }
            layout {
                sequence: 3
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
            sorting {
                sortable: false
            }
        )

        column LINK (
            reportColumnQueryId: 2
            derivedColumn: N
            type: link
            heading {
                heading: Link
                alignment: center
            }
            layout {
                sequence: 2
            }
            link {
                target: {
                    page: 162
                    items: {
                        P162_ARQUIVO: #LINK#
                    }
                    action: resetPagination
                }
                linkText: Ver Anexo
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NOMEARQUIVO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column REMOVER (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Remover
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column USUARIO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Usuario
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P484_ARQUIVOTEMP (
        type: fileUpload
        label {
            label: Arquivo
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
        }
        storage {
            filenameColumn: NOMEARQUIVO
            fileTypes: image/png,image/jpeg,application/pdf
        }
        layout {
            sequence: 40
            region: @anexos-doc-pessoas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: ARQUIVOTEMP
            used: always
        }
    )

    pageItem P484_DATAANEXO (
        type: hidden
        layout {
            sequence: 60
            region: @anexos-doc-pessoas
            slot: regionBody
        }
        appearance {
            formatMask: DD/MM/RRRR HH24:MI:SS
        }
        source {
            type: databaseColumn
            databaseColumn: DATAANEXO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  return sysdate;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P484_IDANEXODELETAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @anexos-doc-pessoas
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P484_IDANEXOPESSOASCONVENCAO (
        type: hidden
        layout {
            sequence: 10
            region: @anexos-doc-pessoas
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDANEXOPESSOASCONVENCAO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P484_IDPESSOACONVENCAO (
        type: textField
        label {
            label: ID Pessoa
            alignment: left
        }
        layout {
            sequence: 20
            region: @anexos-doc-pessoas
            slot: regionBody
            alignment: left
            columnAttributes: readonly
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            customAttributes: readonly
        }
        source {
            type: databaseColumn
            databaseColumn: IDPESSOACONVENCAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P484_IDUSUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @anexos-doc-pessoas
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDUSUARIO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidusuario number;
                begin
                  select idusuario
                  into vidusuario
                  from usuarios
                  where usuario = v('APP_USER');
                  --
                  return vidusuario;
                  --
                end;
                  
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P484_NOMEARQUIVO (
        type: hidden
        layout {
            sequence: 30
            region: @anexos-doc-pessoas
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: NOMEARQUIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Anexar este arquivo!
        layout {
            sequence: 50
            region: @anexos-doc-pessoas
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P484_IDANEXOPESSOASCONVENCAO is null
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 20
            region: @anexos-doc-pessoas
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P484_IDANEXOPESSOASCONVENCAO
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @anexos-doc-pessoas
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 482
                items: {
                    P482_IDPESSOACONVENCAO: &P484_IDPESSOACONVENCAO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation informar-arquivo (
        name: Informar arquivo
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P484_ARQUIVOTEMP
        }
        error {
            errorMessage: Selecione o arquivo!
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process anexar (
        name: Anexar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  commit;
                  -- Call the procedure
                  pck_anexos.blob_to_file_convencao(pidconvencao => :P484_IDPESSOACONVENCAO
                                                      ,pidanexo => :P484_IDANEXOPESSOASCONVENCAO);
                  commit;
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 3409333820960462456
        }
    )

    process deletar (
        name: Deletar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  :P484_IDANEXOPESSOASCONVENCAO:= null;
                  pck_anexos.prc_apagaanexo_convencao(:P484_IDANEXODELETAR);
                end;
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 3409335473828462455
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    process fetch-row-from-anexospessoasconvencao (
        name: Fetch Row from ANEXOSPESSOASCONVENCAO
        type: autoRowFetch
        source {
            tableName: ANEXOSPESSOASCONVENCAO
            pkColumn: IDANEXOPESSOASCONVENCAO
            pkItem: P484_IDANEXOPESSOASCONVENCAO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 3409334236193462455
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P484_IDANEXOPESSOASCONVENCAO is null then
                        select seq_idanexopessoasconvencao.nextval
                          into :P484_IDANEXOPESSOASCONVENCAO
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 3409334605707462455
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-anexospessoasconvencao (
        name: Process Row of ANEXOSPESSOASCONVENCAO
        type: autoRowProcessing
        target {
            tableName: ANEXOSPESSOASCONVENCAO
            pkColumn: IDANEXOPESSOASCONVENCAO
            pkItem: P484_IDANEXOPESSOASCONVENCAO
            supportedOperations: [
                insert
                update
            ]
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Arquivo Processado
        }
        advanced {
            executionMappingIdentifier: 3409335064842462455
        }
    )

    branch (
        name: 484
        execution {
            sequence: 40
        }
        behavior {
            target: {
                page: 484
                items: {
                    P484_IDANEXOPESSOASCONVENCAO:
                    P484_IDPESSOACONVENCAO: &P484_IDPESSOACONVENCAO.
                }
                action: resetPagination
                successMessage: false
            }
        }
    )

)

