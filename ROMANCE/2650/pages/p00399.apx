    pageItem P399_IDCONTABANCARIA (
        type: popupLov
        label {
            label: Conta Bancária
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct(b.nomebanco||' - Agencia: '||c.agencia||' / Conta: '||c.conta||' Beneficiario: '||c.beneficiario) display_value
                     , c.idcontabanc return_value
                from contasbancarias c
                   , bancos b
                where c.idpessoa = 16625
                  and b.idbanco = c.idbanco
                  and c.ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 30
            region: @fechamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
