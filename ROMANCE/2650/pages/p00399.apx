    process consulta-dml-em-fechamentos (
        name: Consulta DML Em Fechamentos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vmd5 varchar2(1000);
                begin
                  --
                  PCK_CADASTROS_RMC.PRC_FECHAMENTOMOVIMENTACOES( PIDFECHAMENTOMOVIMENTACAO => :P399_IDFECHAMENTOMOVIMENTACAO,
                                                                 PUSUARIO => :P399_USUARIO,
                                                                 PIDCONTABANCARIA => :P399_IDCONTABANCARIA,
                                                                 PDATAFECHAMENTO => :P399_DATAFECHAMENTO,
                                                                 PMD5 => vmd5,
                                                                 POPERACAO_DML => 'S');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 88110606860094549
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P399_IDFECHAMENTOMOVIMENTACAO
        }
    )

    process processo-dml-em-fechamentos-de-movimentações (
        name: Processo DML em Fechamentos de Movimentações
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                  vusuario varchar2(100) := v('APP_USER');
                  vmd5 varchar2(1000);
                begin
                  --
                  if v('REQUEST') = 'CRIAR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'SALVAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'DELETAR' then
                    voperacao_dml := 'D'; 
                  end if;
                  --
                  if voperacao_dml = 'I' then
                    --
                    PCK_FINANCEIRO_RMC.prc_fechamentoconciliacao( pidcontabancaria => :P399_IDCONTABANCARIA_C,
                                                                  pusuario         => vusuario,
                                                                  ptipofechamento  => :P399_TIPO_FECHAMENTO_C,
                                                                  pdatainicio      => nvl(:P399_DATAINICIO,:P399_DATAFECH),
                                                                  pdatafim         => :P399_DATAFIM );
                    --
                  else
                    --
                    PCK_CADASTROS_RMC.PRC_FECHAMENTOMOVIMENTACOES( PIDFECHAMENTOMOVIMENTACAO => :P399_IDFECHAMENTOMOVIMENTACAO,
                                                                   PUSUARIO => vusuario ,
                                                                   PIDCONTABANCARIA => :P399_IDCONTABANCARIA,
                                                                   PDATAFECHAMENTO => :P399_DATAFECHAMENTO,
                                                                   PMD5 => vmd5,
                                                                   POPERACAO_DML => voperacao_dml );
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo Executado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 97069340942246368
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('SALVAR','CRIAR','DELETAR')
        }
    )

    branch (
        name: Criar e Deletar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 399
                items: {
                    P399_IDFECHAMENTOMOVIMENTACAO:
                    P399_USUARIO:
                    P399_DATAFECHAMENTO:
                    P399_IDCONTABANCARIA_C:
                    P399_TIPO_FECHAMENTO_C:
                    P399_IDCONTABANCARIA:
                    P399_DATAINICIO:
                    P399_DATAFIM:
                    P399_DATAFECH:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('DELETAR','CRIAR')
        }
    )

    branch (
        name: Salvar
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 399
                items: {
                    P399_IDFECHAMENTOMOVIMENTACAO: &P399_IDFECHAMENTOMOVIMENTACAO.
                    P399_USUARIO: &P399_USUARIO.
                    P399_DATAFECHAMENTO: &P399_DATAFECHAMENTO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @salvar
        }
    )

)

