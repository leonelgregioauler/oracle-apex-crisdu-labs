    region fechamentos-realizados (
        name: Fechamentos Realizados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.idfechamentomovimentacao id
                     , f.usuario 
                     , ( select distinct(b.nomebanco||' - Agencia: '||c.agencia||' / Conta: '||c.conta||' Beneficiario: '||c.beneficiario)
                         from contasbancarias c
                            , bancos b
                         where c.idcontabanc = f.idcontabancaria
                           and b.idbanco = c.idbanco ) contabancaria
                     , f.data
                     , f.datafechamento
                from fechamentomovimentacoes f
                order by datafechamento desc
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 97079385121469501
        }

