    pageItem P511_DATAFINAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
    )

    pageItem P511_DATAINICIAL (
        type: hidden
        settings {
            valueProtected: false
        }
