            sequence: 60
            region: @filtros
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
    )

    pageItem P511_IDFILIAL (
        type: selectList
        label {
            label: Filial
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(f.idfilial) display_value 
                     , f.idfilial return_value 
                from filiais f
                where f.ativo       = 'S'
                ORDER BY 1
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P511_IDRAZAOSOCIALFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select cnpj||' - '||razaosocial display_value
                     , idrazaosocialfilial return_value
                from razoessociaisfiliais
                where idfilial = :P511_IDFILIAL
                  and ativo = 'S'
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P511_IDFILIAL
            itemsToSubmit: P511_IDFILIAL
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P511_MESANO (
        type: selectList
        label {
            label: Mes/Ano
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(add_months(trunc(sysdate, 'MM'), - (level - 1)), 'MM/YYYY') d
                     , to_char(add_months(trunc(sysdate, 'MM'), - (level - 1)), 'MM/YYYY') r
                  from dual
                connect by level <= 6
                order by 1 desc;
                
                ```
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            column: 2
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--hoverIconSpin
            ]
            icon: fa-ai-sparkle-generate-text
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P511_MESANO
        }

        action setadatas (
            name: SetaDatas
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select to_char(to_date('01/'||:P511_MESANO),'dd/mm/rrrr') dtini
                         , to_char((add_months(to_date('01/'||:P511_MESANO),1) -1),'dd/mm/rrrr') dtfim
                      from dual
                    ```
                itemsToSubmit: P511_MESANO
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: [
                    P511_DATAINICIAL
                    P511_DATAFINAL
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new-2 (
        name: New_1
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action processa (
            name: Processa
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action setafiltrar (
            name: SetaFiltrar
            action: setValue
            settings {
                value: S
            }
            affectedElements {
                selectionType: items
                items: P511_FILTRAR
            }
            execution {
                sequence: 10
            }
        )

    )

)

