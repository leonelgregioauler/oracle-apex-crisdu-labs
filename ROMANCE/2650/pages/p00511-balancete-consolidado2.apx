page 511 (
    name: Balancete Consolidado
    alias: BALANCETE-CONSOLIDADO2
    title: Balancete Consolidado
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    css {
        inline:
            ```css
            /*cor de fundo cabeçalho da grid*/
            #INTREP .a-IRR-table tr th {
                background: #f2ea87 !important;
            }
            
            ```
    }

    region balancete-consolidado (
        name: Balancete Consolidado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                     
                 select pg.IDCLASSIFICACAO codigo
                      , pg.nivel
                      , sl.idplanocontasempresa
                      , decode(pg.TIPOLANCAMENTO,'D','Débito','Crédito') "Tp.Lançamento"
                      , pg.classificacao
                      , decode(TIPOCONTA,'A','Analítica','Sintética') "Tipo Conta"
                      , DESCRICAOCONTA "Descrição da Conta"
                      , case when pg.nivel = 1 then 
                                  sum(nvl(sl.saldoini,0)) over (partition by SUBSTR(pg.classificacao, 1, 1))  --inicial_n1
                             when pg.nivel = 2 then
                                  sum(nvl(sl.saldoini,0)) over (partition by SUBSTR(pg.classificacao, 1, 3))  --inicial_n2
                             when pg.nivel = 3 then 
                                  sum(nvl(sl.saldoini,0)) over (partition by SUBSTR(pg.classificacao, 1, 5))  --inicial_n3
                             when pg.nivel = 4 then 
                                  sum(nvl(sl.saldoini,0)) over (partition by SUBSTR(pg.classificacao, 1, 8))  --inicial_n4
                             when pg.nivel = 5 then 
                                  sum(nvl(sl.saldoini,0)) over (partition by SUBSTR(pg.classificacao, 1, 12))  --inicial_n5
                         end "Saldo Anterior"
                        --
                      , case when pg.nivel = 1 then 
                                  sum(nvl(sl.saldofim,0)) over (partition by SUBSTR(pg.classificacao, 1, 1))  --final_n1
                             when pg.nivel = 2 then
                                  sum(nvl(sl.saldofim,0)) over (partition by SUBSTR(pg.classificacao, 1, 3))  --final_n2
                             when pg.nivel = 3 then 
                                  sum(nvl(sl.saldofim,0)) over (partition by SUBSTR(pg.classificacao, 1, 5))  --final_n3
                             when pg.nivel = 4 then 
                                  sum(nvl(sl.saldofim,0)) over (partition by SUBSTR(pg.classificacao, 1, 8))  --final_n4
                             when pg.nivel = 5 then 
                                  sum(nvl(sl.saldofim,0)) over (partition by SUBSTR(pg.classificacao, 1, 12))  --final_n5
                         end "Saldo Atual"
                        --
                      , case when pg.nivel = 1 then 
                                  sum(nvl(sl.valordebito,0)) over (partition by SUBSTR(pg.classificacao, 1, 1))  --final_n1
                             when pg.nivel = 2 then
                                  sum(nvl(sl.valordebito,0)) over (partition by SUBSTR(pg.classificacao, 1, 3))  --final_n2
                             when pg.nivel = 3 then 
                                  sum(nvl(sl.valordebito,0)) over (partition by SUBSTR(pg.classificacao, 1, 5))  --final_n3
                             when pg.nivel = 4 then 
                                  sum(nvl(sl.valordebito,0)) over (partition by SUBSTR(pg.classificacao, 1, 8))  --final_n4
                             when pg.nivel = 5 then 
                                  sum(nvl(sl.valordebito,0)) over (partition by SUBSTR(pg.classificacao, 1, 12))  --final_n5
                         end "Débito"
                        --
                      , case when pg.nivel = 1 then 
                                  sum(nvl(sl.valorcredito,0)) over (partition by SUBSTR(pg.classificacao, 1, 1))  --final_n1
                             when pg.nivel = 2 then
                                  sum(nvl(sl.valorcredito,0)) over (partition by SUBSTR(pg.classificacao, 1, 3))  --final_n2
                             when pg.nivel = 3 then 
                                  sum(nvl(sl.valorcredito,0)) over (partition by SUBSTR(pg.classificacao, 1, 5))  --final_n3
                             when pg.nivel = 4 then 
                                  sum(nvl(sl.valorcredito,0)) over (partition by SUBSTR(pg.classificacao, 1, 8))  --final_n4
                             when pg.nivel = 5 then 
                                  sum(nvl(sl.valorcredito,0)) over (partition by SUBSTR(pg.classificacao, 1, 12))  --final_n5
                         end "Crédito"
                        --
                      , case when pg.tipoconta = 'A' and ( 
                                  sum(nvl(sl.saldoini,0)) over (partition by SUBSTR(pg.classificacao, 1, 12))  > 0 or 
                                  sum(nvl(sl.saldofim,0)) over (partition by SUBSTR(pg.classificacao, 1, 12)) > 0 )
                             then 'Ver'
                             else null
                        end saldos
                      , case when pg.tipoconta = 'A' and ( 
                                  sum(nvl(sl.valordebito,0)) over (partition by SUBSTR(pg.classificacao, 1, 12)) > 0 or 
                                  sum(nvl(sl.valorcredito,0)) over (partition by SUBSTR(pg.classificacao, 1, 12)) > 0 )
                             then 'Ver'
                             else null
                        end lanctos
                        --
                   from PLANOCONTASGERAL pg
                      , (select pc.idclassificacao
                              , pc.idplanocontasempresa
                              , pg.classificacao
                              , SUBSTR(pg.classificacao,  1, 1)  AS nivel_1
                              , SUBSTR(pg.classificacao,  1, 3)  AS nivel_2
                              , SUBSTR(pg.classificacao,  1, 5)  AS nivel_3
                              , SUBSTR(pg.classificacao,  1, 8)  AS nivel_4
                              , SUBSTR(pg.classificacao,  1, 12) AS nivel_5
                              , nvl(sl.saldoini,0) saldoini
                              , nvl(sl.saldofim,0) saldofim
                              , nvl(ld.valor,0)   valordebito
                              , nvl(lc.valor,0)   valorcredito
                           from planocontasempresa pe
                              , planocontasclassificacoes pc
                              , planocontasgeral pg
                              , (select idplanocontasempresa,
                                        idclassificacao,
                                        min(datasaldo) datasaldo,
                                        max(saldoinicial) saldoini,
                                        max(saldofinal)   saldofim
                                   from saldoscontabeis --testesaldos 
                                  where idplanocontasempresa = (select idplanocontasempresa  -- so pode haver 1 plano de contas por razao social filial
                                                                    from planocontasempresa
                                                                   where idrazaosocialfilial = :P511_IDRAZAOSOCIALFILIAL)
                                    and datasaldo between :P511_DATAINICIAL and :P511_DATAFINAL
                                    group by idplanocontasempresa, idclassificacao ) sl
                                --
                              , (select l.idplanocontasempresa
                                      , s.idclassificacao
                                      , sum(l.valorlancamento) valor
                                   from lancamentoscontabeis    l
                                      , subcontasclassificacoes s
                                   where s.idsubcontaclassificacao = l.idsubcontaclassificacao
                                     and l.idplanocontasempresa = (select idplanocontasempresa  -- so pode haver 1 plano de contas por razao social filial
                                                                     from planocontasempresa
                                                                    where idrazaosocialfilial = :P511_IDRAZAOSOCIALFILIAL)
                                     and l.datalancamento between :P511_DATAINICIAL and :P511_DATAFINAL
                                     --and s.tipolancamento = 'D' -- Debito
                                   group by l.idplanocontasempresa
                                          , s.idclassificacao) ld
                                --
                              , (select l.idplanocontasempresa
                                      , s.idclassificacao
                                      , sum(l.valorlancamento) valor
                                   from lancamentoscontabeis    l
                                      , subcontasclassificacoes s
                                   where s.idsubcontaclassificacao = l.idsubcontaclassificacao
                                     and l.idplanocontasempresa = (select idplanocontasempresa  -- so pode haver 1 plano de contas por razao social filial
                                                                     from planocontasempresa
                                                                    where idrazaosocialfilial = :P511_IDRAZAOSOCIALFILIAL)
                                     and l.datalancamento between :P511_DATAINICIAL and :P511_DATAFINAL
                                     --and s.tipolancamento = 'C' -- Debito
                                   group by l.idplanocontasempresa
                                          , s.idclassificacao) lc
                                --
                          where pc.idplanocontasempresa = pe.idplanocontasempresa
                            and pc.idclassificacao = pg.idclassificacao
                            and pe.idrazaosocialfilial = :P511_IDRAZAOSOCIALFILIAL
                            and pc.idclassificacao = sl.idclassificacao
                            and pc.idplanocontasempresa = sl.idplanocontasempresa 
                            and pc.idplanocontasempresa = ld.idplanocontasempresa(+)
                            and pc.idclassificacao      = ld.idclassificacao(+)  
                            and pc.idplanocontasempresa = lc.idplanocontasempresa(+)
                            and pc.idclassificacao      = lc.idclassificacao(+) ) sl
                  --
                  where pg.idclassificacao = sl.idclassificacao(+)
                    and :P511_FILTRAR = 'S'
                  order by pg.classificacao
                ```
            pageItemsToSubmit: [
                P511_IDRAZAOSOCIALFILIAL
                P511_DATAINICIAL
                P511_DATAFINAL
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: INTREP
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 419150612310700966
        }

