page 273 (
    name: Histórico de Ligações
    title: Histórico de Ligações
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region histórico-de-ligações (
        name: Histórico de Ligações
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idcontrole
                     , '('||substr(c.telefone,1,2)||')'||substr(c.telefone,3,4)||'.'||substr(c.telefone,7,10)
                                 ||' ('||( select o.nome from operadorastelefonia o where c.idoperadoratel = o.idoperadoratel )||')' TELEFONE
                     ,  pck_ticketscentral.fnc_representantetelefone(c.telefone) "Representante"
                     , c.dataligacao
                     , c.idticketdeposito 
                from controleligacoes c
                where c.situacao = 'P'
                  and c.idcontroleorig = :P273_IDCONTROLE
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: singleRowView
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt="" />
        }
        singleRowView {
            excludeNullValues: true
            onlyDisplayedColumns: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: -
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 355226420477998286
        }

        column DATALIGACAO (
            type: plainText
            heading {
                heading: Data da Ligação
                alignment: center
            }
            layout {
                sequence: 5
            }
            appearance {
                formatMask: DD/MM/YYYY HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                htmlDomId: DATALIGACAO
                endUserAlias: E
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDCONTROLE (
            type: hidden
            heading {
                heading: Idcontrole
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDCONTROLE
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDTICKETDEPOSITO (
            type: hidden
            heading {
                heading: Idticketdeposito
            }
            layout {
                sequence: 6
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDTICKETDEPOSITO
                endUserAlias: F
            }
            security {
                escapeSpecialChars: false
            }
        )

        column Representante (
            type: plainText
            heading {
                heading: Representante
                alignment: center
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Representante
                endUserAlias: D
            }
            enableUsersTo {
                pivot: false
            }
        )

        column TELEFONE (
            type: plainText
            heading {
                heading: Telefone
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: TELEFONE
                endUserAlias: B
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 3552512 (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn DATALIGACAO (
                sequence: 4
            )

            displayColumn IDCONTROLE (
                sequence: 1
            )

            displayColumn IDTICKETDEPOSITO (
                sequence: 5
            )

            displayColumn "Representante" (
                sequence: 3
            )

            displayColumn TELEFONE (
                sequence: 2
            )

        )

    )

    pageItem P273_IDCONTROLE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @histórico-de-ligações
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

