page 29 (
    name: Imprimir Romaneio por Semana
    title: Imprimir Romaneio por Semana
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region imprimir-romaneio-por-semana (
        name: Imprimir Romaneio por Semana
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
    )

    pageItem P29_ANO (
        type: selectList
        label {
            label: Ano
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select distinct ano display_value
                , ano return_value
                from semana_dias
                order by 1 desc
                ```
        }
        layout {
            sequence: 50
            region: @imprimir-romaneio-por-semana
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: ANO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P29_IDFILIAL (
        type: selectList
        label {
            label: Filial
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(pe.APELIDO, pe.nomepessoa)) display_value
                     , fe.idfilial return_value
                from filiais         fe
                   , pessoas         pe
                where fe.idpessoa = pe.idpessoa
                  and fe.ativo = 'S'
                ORDER BY 1
                ```
            nullDisplayValue: " - Selecione a Filial -"
        }
        layout {
            sequence: 10
            region: @imprimir-romaneio-por-semana
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P29_IDFORNECEDOR (
        type: selectList
        label {
            label: Fornecedor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa||' ('||c.nomecidade)||'-'||e.sigla||')' display_value
                     , f.idfornecedor return_value 
                from fornecedores f
                   , pessoas p
                   , cidades c
                   , estados e
                where f.idpessoa = p.idpessoa
                  and p.idcidade = c.idcidade
                  and c.idestado = e.idestado
                order by 1
                ```
            nullDisplayValue: - Selecione o Fornecedor -
        }
        layout {
            sequence: 70
            region: @imprimir-romaneio-por-semana
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFORNECEDOR
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P29_IDSEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct to_char(s.semana,'00')||'/'||s.ano ||' ( '||to_char(s.dt_ini,'dd/mm/yyyy')||' - '||to_char(s.dt_fim,'dd/mm/yyyy')||' )' display_value
                     , idsemana return_value
                from semana_dias  s
                   , notasfiscais nf
                where s.idsemana = nf.idsemananota 
                order by idsemana desc
                ```
            nullDisplayValue: " - Selecione a Semana - "
        }
        layout {
            sequence: 40
            region: @imprimir-romaneio-por-semana
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDSEMANA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P29_TIPO (
        type: radioGroup
        label {
            label: Filtrar
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Semana;S,Ano;A
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @imprimir-romaneio-por-semana
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: staticValue
            staticValue: S
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P29_USUARIO (
        type: hidden
        layout {
            sequence: 1
            region: @imprimir-romaneio-por-semana
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: USUARIO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button romaneiocompleto (
        buttonName: ROMANEIOCOMPLETO
        label: Romaneio Completo
        layout {
            sequence: 30
            region: @imprimir-romaneio-por-semana
            slot: bottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-sort-alpha-asc
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
    )

    button romaneiofilial (
        buttonName: ROMANEIOFILIAL
        label: Romaneio Para Filial
        layout {
            sequence: 40
            region: @imprimir-romaneio-por-semana
            slot: bottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
            icon: fa-cube
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
    )

    button romaneiofilialobrig (
        buttonName: ROMANEIOFILIALOBRIG
        label: Romaneios Recebidos ( Agrupado por Filial )
        layout {
            sequence: 10
            region: @imprimir-romaneio-por-semana
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
            icon: fa-building-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
    )

    button romaneiorecfilial (
        buttonName: ROMANEIORECFILIAL
        label: Romaneios Recebidos ( Agrupado por Fornecedor )
        layout {
            sequence: 20
            region: @imprimir-romaneio-por-semana
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-bank
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
    )

    dynamicAction filtro (
        name: Filtro
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P29_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P29_TIPO
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P29_IDSEMANA
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P29_ANO
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P29_IDSEMANA
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P29_ANO
            }
            execution {
                sequence: 30
                fireWhenEventResultIs: false
            }
        )

    )

    validation p29-idfilial (
        name: P29_IDFILIAL
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P29_IDFILIAL
        }
        error {
            errorMessage: #LABEL# deve ser selecionada!
            associatedItem: @P29_IDFILIAL
        }
        serverSideCondition {
            whenButtonPressed: @romaneiofilialobrig
        }
    )

    validation p29-idfornecedor (
        name: P29_IDFORNECEDOR
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P29_IDFORNECEDOR
        }
        error {
            errorMessage: #LABEL# deve ser informado!
            associatedItem: @P29_IDFORNECEDOR
        }
        serverSideCondition {
            whenButtonPressed: @romaneiorecfilial
        }
    )

    process fetch-row-from-impressao-romaneio (
        name: Fetch Row from IMPRESSAO_ROMANEIO
        type: autoRowFetch
        source {
            tableName: IMPRESSAO_ROMANEIO
            pkColumn: USUARIO
            pkItem: P29_USUARIO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Unable to fetch row.
        }
        advanced {
            executionMappingIdentifier: 181165162619828533
        }
        serverSideCondition {
            type: never
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  var1 varchar2(10);
                  function get_pk return varchar2 
                  is 
                  begin 
                     return dbms_standard.login_user;
                  end; 
                begin 
                  :P29_USUARIO := get_pk; 
                   var1        := :P29_SEMANA;
                  :P29_ANO     := NVL(:P29_ANO,SUBSTR(var1,4,4) );
                  :P29_SEMANA  := SUBSTR(:P29_SEMANA,1,2);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Unable to get primary key item value.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 181165354956828533
        }
    )

    process process-row-of-impressao-romaneio (
        name: Process Row of IMPRESSAO_ROMANEIO
        type: autoRowProcessing
        target {
            tableName: IMPRESSAO_ROMANEIO
            pkColumn: USUARIO
            pkItem: P29_USUARIO
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        error {
            errorMessage: Unable to process row of table IMPRESSAO_ROMANEIO.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 181165549097828534
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 181165754261828534
        }
    )

    branch (
        execution {
            sequence: 5
        }
        behavior {
            target: {
                page: 30
                successMessage: false
            }
        }
        serverSideCondition {
            whenButtonPressed: @romaneiofilial
        }
    )

    branch (
        execution {
            sequence: 11
        }
        behavior {
            target: {
                page: 117
                successMessage: false
            }
            saveStateBeforeBranching: true
        }
        serverSideCondition {
            whenButtonPressed: @romaneiocompleto
        }
        comments {
            comments: Created 06-SET-2011 16:48 by ROMAN
        }
    )

    branch (
        execution {
            sequence: 29
        }
        behavior {
            target: {
                page: 178
                successMessage: false
            }
            saveStateBeforeBranching: true
        }
        serverSideCondition {
            whenButtonPressed: @romaneiorecfilial
        }
        comments {
            comments: Created 06-SET-2011 16:48 by ROMAN
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 179
                successMessage: false
            }
            saveStateBeforeBranching: true
        }
        serverSideCondition {
            whenButtonPressed: @romaneiofilialobrig
        }
        comments {
            comments: Created 06-SET-2011 16:48 by ROMAN
        }
    )

)

