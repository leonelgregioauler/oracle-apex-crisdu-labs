page 329 (
    name: Vendas de Produtos
    title: Vendas de Produtos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            .img_produto {
                position: relative;
                max-width: 152px;
                width: 60%;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region produtos-mais-vendidos (
        name: Produtos mais Vendidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.posicao
                     , t.produto
                     , t.vendido
                     , t.fotosprodutos
                from ( 
                       select rownum posicao
                            , t.*
                       from ( 
                              select pck_romance.fnc_nomeproduto(p.idproduto) produto
                                   , sum(NVL(i.quantidade,0) - NVL(i.qtddevolvida,0)) Vendido
                                   , nvl(( select listagg('<a href="'||ft.url||'" target="_blank"> <img src="'||ft.urlreduzida||'" class="img_produto"><a>',' ') within group (order by 1)
                                           from fotosprodutos ft 
                                           where ft.idproduto = p.idproduto
                                             and ft.ativo     = 'S' ),'<a href="https://fotosprodutos.romancemoda.com.br/acessar?INDISPONIVEL.JPG" target="_blank"> <img src="https://fotosprodutos.romancemoda.com.br/acessar?INDISPONIVEL.JPG/true" class="img_produto"><a>') fotosprodutos 
                              from notasvendas n
                                 , itensnotavenda i
                                 , estoquefilial e
                                 , produtos p
                              where n.idnotavenda         = i.idnotavenda
                                and e.idestoquefilial     = i.idestoquefil
                                and p.idproduto           = e.idproduto
                                and e.idfilial            = n.idfilial
                                and n.idsituacaonotavenda = 4
                                and ( :P329_IDFILIAL is null or n.idfilial = :P329_IDFILIAL )
                                and n.idsemanacobranca between :P329_SEMANAINICIO and :P329_SEMANAFIM
                              group by p.idproduto
                              order by 2 desc ) t
                        where rownum <= 30 ) t
                order by 1
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 2834242936237780223
        }

        column FOTOSPRODUTOS (
            type: plainText
            heading {
                heading: Fotosprodutos
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column POSICAO (
            type: plainText
            heading {
                heading: Posição
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column PRODUTO (
            type: plainText
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column VENDIDO (
            type: plainText
            heading {
                heading: Quantidade Vendido
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 28790802 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn POSICAO (
                sequence: 1
            )

            displayColumn PRODUTO (
                sequence: 2
            )

            displayColumn VENDIDO (
                sequence: 3
            )

        )

    )

    pageItem P329_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P329_SEMANAFIM (
        type: selectList
        label {
            label: Até
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(semana,'00')||'/'||ano) display_value
                     , idsemana RETURN_VALUE
                from semana_dias
                where idsemana >=534
                order by idsemana 
                ```
            nullDisplayValue: - Selecione a Semana -
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P329_SEMANAINICIO (
        type: selectList
        label {
            label: De
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(semana,'00')||'/'||ano) display_value
                     , idsemana RETURN_VALUE
                from semana_dias
                where idsemana >=534
                order by idsemana 
                ```
            nullDisplayValue: - Selecione a Semana -
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P329_TIPORELATORIO (
        type: radioGroup
        label {
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2: Resumido;R,Detalhado;D
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 329
                items: {
                    P329_IDFILIAL: &P329_IDFILIAL.
                    P329_SEMANAINICIO: &P329_SEMANAINICIO.
                    P329_SEMANAFIM: &P329_SEMANAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

