page 224 (
    name: Inadimplência por Empresa
    title: Inadimplência por Empresa
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region gráfico (
        name: Gráfico
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial( n.idfilial )  empresa
                     ,to_char( ( sum( n.valortotalvendalqd )
                       - sum( n.valorpago          ) ) ,'999G999G999G999G990D00') saldo
                     , count(1) qtddebito
                from notasvendas n
                   , filiais     f
                where f.idfilial            = n.idfilial
                  and n.valorpago           < n.valortotalvendalqd
                  and n.idsituacaonotavenda = 4
                  and ( v('APP_USER') in ( 'EVERTON','EDUARDO','TATIANA') or exists ( select 1
                                                                                      from usuariosfiliais u
                                                                                      where u.idfilial = n.idfilial
                                                                                        and u.usuario  = v('APP_USER') ) )
                group by n.idfilial--, f.fatorconversao;
                order by 2 desc
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: EMPRESA
            valueColumn: SALDO
            colorScheme: modern2
            maximumRows: 30
        }
    )

    region inadimplência-por-empresa (
        name: Inadimplência por empresa
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select n.idfilial
                     , pck_romance.fnc_nomefilial( n.idfilial )  empresa
                   --  , f.fatorconversao
                     , sum( n.valortotalnota*n.fatorconversao   )      valortotalnota
                     , sum( n.valortotalvendalqd*n.fatorconversao )      valorapagar
                     , sum( n.valorpago*n.fatorconversao          )      valorpago
                     , ( sum( n.valortotalvendalqd*n.fatorconversao )
                       - sum( n.valorpago*n.fatorconversao          ) ) saldo
                     , count(1) qtddebito
                from notasvendas n
                   , filiais     f
                where f.idfilial            = n.idfilial
                  and n.valorpago           < n.valortotalvendalqd
                  and n.idsituacaonotavenda = 4
                  and ( v('APP_USER') in ( 'EVERTON','EDUARDO','TATIANA') or exists ( select 1
                                                                                      from usuariosfiliais u
                                                                                      where u.idfilial = n.idfilial
                                                                                        and u.usuario  = v('APP_USER') ) )
                group by n.idfilial--, f.fatorconversao;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: Valores expressos na moeda local
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 5192759631966808462
        }

