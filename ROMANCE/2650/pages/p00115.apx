page 115 (
    name: Copiar Pedido de Compra
    title: Copiar Pedido de Compra
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region copiar-pedido-de-compra (
        name: Copiar Pedido de Compra
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P115_IDPEDIDOCOMPRA (
        type: hidden
        layout {
            sequence: 10
            region: @copiar-pedido-de-compra
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P115_QTDPEDIDO (
        type: textField
        label {
            label: Quantidade de Cópias
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @copiar-pedido-de-compra
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 5
        }
        validation {
            maxLength: 2000
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Fechar
        layout {
            sequence: 10
            region: @copiar-pedido-de-compra
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 112
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Copiar
        layout {
            sequence: 20
            region: @copiar-pedido-de-compra
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
    )

    process run-stored-procedure (
        name: Run Stored Procedure
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                #OWNER#.PCK_ROMANCE.PRC_GERAPEDIDOSCOMPRA(
                PIDPEDORIG => TO_NUMBER(:P115_IDPEDIDOCOMPRA),
                PQTDPEDIDO => TO_NUMBER(:P115_QTDPEDIDO));
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Pedido copiado com sucesso!
        }
        error {
            errorMessage: #SQLERRM#
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 181184634510877081
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 115
            }
            saveStateBeforeBranching: true
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

)

