page 700 (
    name: Pix Santander - Faturas do Dia
    title: Pix Santander - Faturas do Dia
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            // Totalizador: lista inteira (vem da query) e faturas marcadas na pagina.
            function tot700() {
              var brl = function (c) { return (c / 100).toLocaleString("pt-BR", { style: "currency", currency: "BRL" }); };
              var cbs = $("input[name=f01]");
              var tq = 0, tc = 0, sq = 0, sc = 0;
              if (cbs.length) { tq = +cbs.first().data("tqtd") || 0; tc = +cbs.first().data("tcent") || 0; }
              cbs.filter(":checked").each(function () { sq++; sc += +$(this).data("cent") || 0; });
              $("#tot700").html("Na lista: <b>" + tq + "</b> fatura(s) - <b>" + brl(tc) + "</b>" +
                                " \u00a0 | \u00a0 Selecionadas: <b>" + sq + "</b> - <b>" + brl(sc) + "</b>");
            }
            $(function () {
              tot700();
              $(document).on("change", "input[name=f01]", tot700);
              $(document).on("apexafterrefresh", tot700);
            });
            ```
    }
    security {
        authorizationScheme: @autoriza-pix-operador
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region faturas-para-envio-ao-santander (
        name: Faturas para envio ao Santander
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select apex_item.checkbox2( p_idx        => 1
                                          , p_value      => pf.idpgtoforn
                                            -- valor da linha e totais da lista, em centavos, para o totalizador
                                          , p_attributes => 'data-cent="' || round((pf.valorpagar - nvl(pf.desconto,0) + nvl(pf.acrescimo,0) - nvl(pf.valorpago,0)) * 100) || '"'
                                                         || ' data-tqtd="' || count(*) over () || '"'
                                                         || ' data-tcent="' || round(sum(pf.valorpagar - nvl(pf.desconto,0) + nvl(pf.acrescimo,0) - nvl(pf.valorpago,0)) over () * 100) || '"'
                                                         || decode(:P700_MARCARTODOS,'S',' CHECKED',null) ) sel
                     , pf.idpgtoforn
                     , pf.dtvencimento
                     , pck_romance.fnc_nomefornecedor(pf.idfornecedor) fornecedor
                     , (select nf.documento from notasfiscais nf
                         where nf.idnotafiscal = pf.idnotafiscal) nrnf
                     , pf.valorpagar - nvl(pf.desconto,0) + nvl(pf.acrescimo,0)
                       - nvl(pf.valorpago,0) valorpagar
                     , decode(pf.pagamentoliberado,'S','Sim','Não') despesa_conferida
                       -- Forma oficial do ERP (formaspagamentos), origem no vencimento
                     , nvl(fp.descricao, '(' || pf.codforma || ')') tipo
                       -- Validacao da via de pagamento contra o cadastro
                     , case
                         when pf.codforma in ('B','E') then
                           case when dd.iddda is not null and dd.situacao_titulo in ('SCHEDULED','PAID') then
                                  '(!) Boleto já ' || decode(dd.situacao_titulo,'SCHEDULED','AGENDADO','PAGO') ||
                                  ' no banco por outro canal - não enviar; baixar pela página 306'
                                when dd.iddda is not null then
                                  'Boleto no DDA: R$ ' || to_char(dd.valor_nominal,'FM999G999G990D00') ||
                                  ' venc. ' || to_char(dd.dt_vencimento,'DD/MM/RRRR') || ' - ' || dd.benef_nome ||
                                  -- identifica o boleto que a API vai pagar, para nao agendar o
                                  -- mesmo no Internet Banking (Pollibox 05/10/2026: mesmo valor e data)
                                  case when dd.nosso_numero is not null then ' - nosso nº ' || dd.nosso_numero end ||
                                  case when dd.seu_numero is not null then ' - doc ' || dd.seu_numero end
                                else '(!) Boleto ainda não localizado no DDA - atualize na página 703' end
                         when pf.codforma in ('H','T','I') then
                           case
                             when cx.chave is not null then
                               'Chave Pix: ' || decode(cx.tipochave,1,'CPF/CNPJ',2,'Aleatória',3,'Telefone',4,'E-mail') || ' - ' || cx.chave
                             when cb.idcontabanc is null then '(!) Sem conta bancária do favorecido'
                             when bc.codigo is null then '(!) Banco ' || bc.nomebanco || ' sem código Febraban'
                             when cb.agencia is null or cb.conta is null or cb.documento is null then '(!) Conta incompleta (agência/conta/CNPJ)'
                             else 'Transferência Pix: ' || bc.nomebanco || ' ' || cb.agencia || '/' || cb.conta
                           end
                         -- Guia: linha digitavel da requisicao (so entram na lista as que tem)
                         when pf.codforma = 'G' then
                           case
                             when length(pf.linha_guia) <> 48 or substr(pf.linha_guia,1,1) <> '8' then
                               '(!) Linha digitável não é de guia (48 dígitos começando com 8) - corrija na requisição'
                             when pck_santander_pix.fnc_guia_valor(pf.linha_guia)
                                  <> pf.valorpagar - nvl(pf.desconto,0) + nvl(pf.acrescimo,0) - nvl(pf.valorpago,0) then
                               '(!) Valor na guia R$ ' || to_char(pck_santander_pix.fnc_guia_valor(pf.linha_guia),'FM999G999G990D00') ||
                               ' diferente do saldo da fatura'
                             else 'Guia: linha ' || substr(pf.linha_guia,1,12) || '...' ||
                                  case when pck_santander_pix.fnc_guia_valor(pf.linha_guia) is not null then
                                    ' - R$ ' || to_char(pck_santander_pix.fnc_guia_valor(pf.linha_guia),'FM999G999G990D00') end
                           end
                         else '(!) Forma não paga pelo hub - segue no fluxo manual'
                       end forma_pagamento
                       -- Conta pagadora (multi-conta): de qual conta integrada sai o pagamento
                     , (select 'Ag ' || trim(cbp.agencia) || '  C/C ' || trim(cbp.conta) ||
                               '  -  ' || substr(cbp.beneficiario,1,30)
                          from contasbancarias cbp
                         where cbp.idcontabanc = pf.idcontapagamento) conta_pagadora
                       -- Empresa da fatura (filial de destino da nota) x conta pagadora escolhida
                       -- x pagador do boleto. O envio barra empresas diferentes (so gestor envia).
                       -- Subconsulta no select: left join com subconsulta no ON + outro join da
                       -- ORA-01799 (701, 22/10/2026).
                     , ( select case
                                  when substr(regexp_replace(rz.cnpj,'[^0-9]'),1,8)
                                       <> ( select substr(regexp_replace(sc.cnpj,'[^0-9]'),1,8)
                                              from santander_contas sc
                                             where sc.idcontabanc = nvl(:P700_IDCONTABANC, pf.idcontapagamento) )
                                  then '<span class="fa fa-exclamation-triangle u-danger-text"></span> <b>'
                                       || apex_escape.html(substr(rz.razaosocial,1,35)) || '</b><br>'
                                       || '<span class="u-danger-text" style="font-size:11px">Conta pagadora de outra empresa - só gestor pode enviar</span>'
                                  when dd.pagador is not null
                                   and substr(dd.pagador,1,8) <> substr(regexp_replace(rz.cnpj,'[^0-9]'),1,8)
                                  then '<span class="fa fa-exclamation-triangle u-danger-text"></span> '
                                       || apex_escape.html(substr(rz.razaosocial,1,35)) || '<br>'
                                       || '<span class="u-danger-text" style="font-size:11px">Boleto em nome de outra empresa (CNPJ '
                                       || dd.pagador || ') - confira o vínculo na 703</span>'
                                  else apex_escape.html(substr(rz.razaosocial,1,35))
                                end
                           from notasfiscais nf
                           join razoessociaisfiliais rz on rz.idrazaosocialfilial = nf.idrazaosocialfildestino
                          where nf.idnotafiscal = pf.idnotafiscal ) empresa
                  from ( select pfx.*
                              , nvl(pfx.tipopagamento,
                                    (select v.tipopagamento from vencimentos v
                                      where v.idvencimento = pfx.idvencimento)) codforma
                              , pck_santander_pix.fnc_guia_linha(pfx.idpgtoforn) linha_guia
                           from pagamentosfornecedores pfx
                          where pfx.idcheque is null
                            and pfx.tipopagamento is not null
                            and pfx.databaixa is null
                            and pfx.valorpagar - nvl(pfx.desconto,0) + nvl(pfx.acrescimo,0)
                                > nvl(pfx.valorpago,0)
                              -- A conta pagadora vem do filtro, nao da fatura: a escolha da
                              -- tela e gravada no lancamento no momento do envio.
                            and pfx.pagamentoliberado = 'S'
                              -- periodo obrigatorio: sem data inicial a lista fica vazia
                            and trunc(pfx.dtvencimento) >= to_date(:P700_DATAINICIO,'DD/MM/RRRR')
                            and trunc(pfx.dtvencimento) <= trunc(nvl(to_date(:P700_DATA,'DD/MM/RRRR'),sysdate))
                            and (:P700_IDFORNECEDOR is null or pfx.idfornecedor = :P700_IDFORNECEDOR)
                            and ( :P700_IDGRUPOFINANCEIRO is null
                                  or exists ( select 1
                                                from notasfiscais nf
                                                   , razoessociaisfiliais rz
                                               where nf.idnotafiscal = pfx.idnotafiscal
                                                 and nf.idrazaosocialfildestino = rz.idrazaosocialfilial
                                                 and rz.idgrupofinanceiro = :P700_IDGRUPOFINANCEIRO ) )
                            and not exists ( select 1 from pix_pagamentos px
                                              where px.idpgtoforn = pfx.idpgtoforn
                                                and px.status not in ('REJECTED','ERRO','CANCELADO') ) ) pf
                       left join formaspagamentos fp on fp.idformapagamento = pf.codforma
                       left join contasbancarias cb
                              on cb.idcontabanc = nvl( pf.idcontabanc
                                                     , (select v.idcontabanc from vencimentos v
                                                         where v.idvencimento = pf.idvencimento) )
                       left join bancos bc on bc.idbanco = cb.idbanco
                       left join ( select p.idcontabancaria, min(p.tipochave) tipochave, min(p.chave) chave
                                     from chavespix p
                                    group by p.idcontabancaria ) cx
                              on cx.idcontabancaria = cb.idcontabanc
                       left join ( select d.idpgtoforn, min(d.iddda) iddda
                                        , min(d.situacao_titulo) situacao_titulo
                                        , min(d.valor_nominal) valor_nominal
                                        , min(d.dt_vencimento) dt_vencimento
                                        , min(d.benef_nome) benef_nome
                                        , min(d.nosso_numero) nosso_numero
                                        , min(d.seu_numero) seu_numero
                                        , min(d.pagador_documento) pagador
                                     from dda_titulos d
                                    where d.idpgtoforn is not null
                                    group by d.idpgtoforn ) dd
                              on dd.idpgtoforn = pf.idpgtoforn
                   -- Somente as formas cobertas pelo hub; filtro multi-selecao (H:B:E)
                 where pf.codforma in ('H','B','E','T','I','G')
                   -- guia so com linha digitavel na requisicao (sem ela segue no fluxo manual)
                   and ( pf.codforma <> 'G' or pf.linha_guia is not null )
                   and ( :P700_FORMAS is null
                         or instr(':' || :P700_FORMAS || ':', ':' || pf.codforma || ':') > 0 )
                   -- do maior valor para o menor
                 order by pf.valorpagar - nvl(pf.desconto,0) + nvl(pf.acrescimo,0)
                          - nvl(pf.valorpago,0) desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        messages {
            whenNoDataFound: Informe o período de vencimentos e clique em Buscar.
        }

