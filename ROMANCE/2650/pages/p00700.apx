        label {
            label: Fornecedor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefornecedor(idfornecedor) ||'  
                  ID:'||idfornecedor display_value
                     , fe.idfornecedor return_value
                from fornecedores fe
                where fe.ativo = 'S'
                order by 1
