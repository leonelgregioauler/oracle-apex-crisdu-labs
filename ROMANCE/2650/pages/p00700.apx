        }
    )

    process casa-dda-com-faturas-lancadas (
        name: Casa DDA com faturas lancadas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Casa os titulos DDA ja gravados com faturas lancadas depois da ultima
                -- busca de DDA, somente no periodo da tela. Nao chama o banco.
                begin
                  if :P700_DATAINICIO is null then
                    apex_error.add_error(
                      p_message          => 'Informe a data inicial do período de vencimentos.',
                      p_display_location => apex_error.c_inline_in_notification);
                    return;
                  end if;
                  roman.pck_santander_pix.prc_casar_dda(
                    pdesde => to_date(:P700_DATAINICIO,'DD/MM/RRRR')
                  , pate   => nvl(to_date(:P700_DATA,'DD/MM/RRRR'), trunc(sysdate)) );
                end;
                ```
        }
        execution {
            sequence: 5
        }
        advanced {
            executionMappingIdentifier: 971000000000700061
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

    process envia-pix-ao-santander (
        name: Envia Pix ao Santander
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vok    number := 0;
                  verros number := 0;
                  vmsg   varchar2(32767);
                begin
                  if :P700_IDCONTABANC is null then
                    apex_error.add_error(
                      p_message          => 'Selecione a conta pagadora antes de enviar.',
                      p_display_location => apex_error.c_inline_in_notification);
                    return;
                  end if;
                
                  if apex_application.g_f01.count = 0 then
                    apex_error.add_error(
                      p_message          => 'Selecione ao menos uma fatura.',
                      p_display_location => apex_error.c_inline_in_notification);
                    return;
                  end if;
                
                  for i in 1 .. apex_application.g_f01.count loop
                    declare
                      viddda    number;
                      vcodforma varchar2(1);
                      vdescr    varchar2(50);
                    begin
                      -- Forma oficial do ERP (fatura, com origem no vencimento)
                      select nvl(pf.tipopagamento,
                                 (select v.tipopagamento from roman.vencimentos v
                                   where v.idvencimento = pf.idvencimento))
                        into vcodforma
                        from roman.pagamentosfornecedores pf
                       where pf.idpgtoforn = apex_application.g_f01(i);
                
                      select min(d.iddda) into viddda
                        from roman.dda_titulos d
                       where d.idpgtoforn = apex_application.g_f01(i);
                
                      update roman.pagamentosfornecedores pf
                         set pf.pgtoagendado = 'S'
                       where pf.idpgtoforn = apex_application.g_f01(i)
                         and nvl(pf.pgtoagendado,'N') = 'N';
                
                      -- Roteamento pela forma cadastrada no ERP
                      if vcodforma in ('B','E') then
                        if viddda is null then
                          raise_application_error(-20060, 'Fatura ' || apex_application.g_f01(i) ||
                            ': forma Boleto/DDA mas o boleto nao foi localizado no DDA. ' ||
                            'Atualize o DDA na pagina 703 ou vincule manualmente.');
                        end if;
                        roman.pck_santander_pix.prc_enviar_boleto(
                          piddda            => viddda
                        , pusuario          => :APP_USER
                        , pidcontapagamento => :P700_IDCONTABANC );
                
                      elsif vcodforma in ('H','T','I') then
                        if viddda is not null then
                          raise_application_error(-20061, 'Fatura ' || apex_application.g_f01(i) ||
                            ': cadastrada como Pix/Transferencia/Intermediarios porem existe boleto no DDA ' ||
                            'para ela. ' ||
                            'Revise a forma de pagamento antes de enviar.');
                        end if;
                        roman.pck_santander_pix.prc_enviar_pagamento(
                          pidpgtoforn       => apex_application.g_f01(i)
                        , pusuario          => :APP_USER
                        , pidcontapagamento => :P700_IDCONTABANC );
                
                      elsif vcodforma = 'G' then
                        roman.pck_santander_pix.prc_enviar_guia(
                          pidpgtoforn       => apex_application.g_f01(i)
                        , pusuario          => :APP_USER
                        , pidcontapagamento => :P700_IDCONTABANC );
                
                      else
                        begin
                          select f.descricao into vdescr
                            from roman.formaspagamentos f where f.idformapagamento = vcodforma;
                        exception when no_data_found then vdescr := vcodforma;
                        end;
                        raise_application_error(-20062, 'Fatura ' || apex_application.g_f01(i) ||
                          ': forma "' || vdescr || '" nao e paga pelo hub. Segue no fluxo manual.');
                      end if;
                
                      vok := vok + 1;
                    exception
                      when others then
                        verros := verros + 1;
                        vmsg := substr(vmsg || 'Fatura ' || apex_application.g_f01(i) || ': ' ||
                                       sqlerrm || ' @ ' ||
                                       regexp_substr(dbms_utility.format_error_backtrace, '"[^"]+", line [0-9]+') ||
                                       ' | ', 1, 30000);
                    end;
                  end loop;
                
                  if verros > 0 then
                    apex_error.add_error(
                      p_message          => vok || ' enviada(s), ' || verros || ' com erro. ' || vmsg,
                      p_display_location => apex_error.c_inline_in_notification);
                  end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Faturas enviadas ao Santander. Aguardando autorização da gestora.
        }
        advanced {
            executionMappingIdentifier: 971000000000700060
        }
        serverSideCondition {
            whenButtonPressed: @enviar-banco
        }
    )

    branch (
        name: Go To Page 700
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 700
                items: {
                    P700_DATA: &P700_DATA.
                    P700_IDFORNECEDOR: &P700_IDFORNECEDOR.
                    P700_SO_CONFERIDAS: &P700_SO_CONFERIDAS.
                    P700_IDGRUPOFINANCEIRO: &P700_IDGRUPOFINANCEIRO.
                    P700_DATAINICIO: &P700_DATAINICIO.
                }
                action: resetPagination
            }
        }
    )

)

