    pageItem P700_IDCONTABANC (
        type: selectList
        label {
            label: Conta pagadora (*)
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Ag ' || trim(cb.agencia) || '  C/C ' || trim(cb.conta) ||
                       '  -  ' || substr(sc.beneficiario,1,40) d
                     , sc.idcontabanc r
                  from santander_contas sc
                     , contasbancarias cb
                 where cb.idcontabanc = sc.idcontabanc
                   and sc.ativo = 'S'
                 order by substr(sc.beneficiario,1,40)
                ```
            displayExtraValues: false
            nullDisplayValue: " - Selecione a conta -"
        }
        layout {
            sequence: 15
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
    )

    pageItem P700_IDFORNECEDOR (
