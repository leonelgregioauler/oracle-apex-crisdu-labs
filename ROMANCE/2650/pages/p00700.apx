        }
    )

    button enviar-banco (
        buttonName: ENVIAR_BANCO
        label: Enviar ao Banco
        layout {
            sequence: 10
            region: @faturas-para-envio-ao-santander
            slot: regionBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
