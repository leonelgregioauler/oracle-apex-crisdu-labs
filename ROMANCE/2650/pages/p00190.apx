page 190 (
    name: Cadastro de Itens
    title: Cadastro de Itens
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        executeWhenPageLoads: window.opener.location.reload();
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region cadastro-de-itens (
        name: Cadastro de Itens
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P190_CUSTOUND (
        type: selectList
        label {
            label: Custo Und.
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefornecedor(pidforn =>  fp.idfornecedor) ||' - '||trim(to_char(fp.precocusto,'999G990D00') ) display_value
                     , fp.precocusto return_value
                from fornecedoresprodutos fp
                where fp.idproduto    = :P190_IDPRODUTO
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P190_IDPRODUTO
        }
        layout {
            sequence: 50
            region: @cadastro-de-itens
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: CUSTOUND
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P190_IDITNF (
        type: hidden
        layout {
            sequence: 10
            region: @cadastro-de-itens
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDITNF
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P190_IDNOTAFISCAL (
        type: hidden
        layout {
            sequence: 20
            region: @cadastro-de-itens
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDNOTAFISCAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P190_IDPRODUTO (
        type: popupLov
        label {
            label: Produto
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomeproduto) display_value
                     , p.idproduto return_value
                from produtos p
                where exists ( select 1 from notasfiscais where idnotafiscal = :P190_IDNOTAFISCAL  and tiponota = 'T')
                  and p.ativo = 'S'
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione o Produto -
        }
        layout {
            sequence: 30
            region: @cadastro-de-itens
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: IDPRODUTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P190_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 260
            region: @cadastro-de-itens
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 300
        }
        source {
            type: databaseColumn
