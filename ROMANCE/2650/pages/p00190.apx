    pageItem P190_VALORTOTAL (
        type: hidden
        layout {
            sequence: 60
            region: @cadastro-de-itens
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: VALORTOTAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 20
            region: @cadastro-de-itens
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P190_IDITNF
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 10
            region: @cadastro-de-itens
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 27
                items: {
                    P27_IDNOTAFISCAL: &P190_IDNOTAFISCAL.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation valida-produto (
        name: Valida Produto
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P190_IDPRODUTO
        }
        error {
            errorMessage: Por favor, informe o produto!
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process fetch-row-from-itemnf (
        name: Fetch Row from ITEMNF
        type: autoRowFetch
        source {
            tableName: ITEMNF
            pkColumn: IDITNF
            pkItem: P190_IDITNF
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 507093900981080983
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P190_IDITNF is null then
                        select "SEQ_IDTEMNF".nextval
                          into :P190_IDITNF
                          from dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 507094110584080986
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-itemnf (
        name: Process Row of ITEMNF
        type: autoRowProcessing
        target {
            tableName: ITEMNF
            pkColumn: IDITNF
            pkItem: P190_IDITNF
            supportedOperations: insert
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        advanced {
            executionMappingIdentifier: 507094319422080986
        }
    )

    branch (
        execution {
            sequence: 11
        }
        behavior {
            target: {
                page: 396
                items: {
                    P396_IDNOTAFISCAL: &P190_IDNOTAFISCAL.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'FECHAR' and :P190_PAGINA = 396
        }
    )

    branch (
        execution {
            sequence: 21
        }
        behavior {
            target: {
                page: 27
                items: {
                    P27_IDNOTAFISCAL: &P190_IDNOTAFISCAL.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'FECHAR' and :P190_PAGINA = 27
        }
    )

    branch (
        name: Go To Page 190
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 190
                items: {
                    P190_IDNOTAFISCAL: &P190_IDNOTAFISCAL.
                    P190_IDITNF:
                    P190_PAGINA: &P190_PAGINA.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

)

