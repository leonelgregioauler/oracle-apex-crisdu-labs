page 134 (
    name: Cadastro de Gerente
    title: Cadastro de Gerente
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 70%
        height: 70%
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
        browserCache: false
    }
    advanced {
        enableDuplicatePageSubmissions: false
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region cadastro-de-gerente (
        name: Cadastro de Gerente
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            renderComponents: belowContent
        }
        settings {
            expandShortcuts: true
        }
    )

    pageItem P134_ATIVO (
        type: selectList
        label {
            label: Ativo
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @cadastro-de-gerente
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: ATIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P134_IDFILIAL (
        type: selectList
        label {
            label: Filial
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' - '||e.sigla display_value
                     , f.idfilial 
                from filiais f
                   , pessoas p
                   , cidades c
                   , estados e
                where f.idpessoa = p.idpessoa
                  and p.idcidade = c.idcidade
                  and c.idestado = e.idestado
                  and f.ativo    = 'S'
                order by 1
                ```
            nullDisplayValue: - Selecione a Filial -
        }
        layout {
            sequence: 1
            region: @cadastro-de-gerente
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P134_IDGERENTE (
        type: hidden
        layout {
            sequence: 1
            region: @cadastro-de-gerente
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDGERENTE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P134_IDPESSOA (
        type: hidden
        layout {
            sequence: 20
            region: @cadastro-de-gerente
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDPESSOA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P134_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @cadastro-de-gerente
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
            height: 3
        }
        validation {
            maxLength: 150
        }
        source {
            type: databaseColumn
            databaseColumn: OBSERVACAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P134_PERCCOMISSAO (
        type: numberField
        label {
            label: % Comissão
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 35
            region: @cadastro-de-gerente
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 5
        }
        validation {
            maxLength: 4000
        }
        source {
            type: databaseColumn
            databaseColumn: PERCCOMISSAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 30
            region: @cadastro-de-gerente
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P134_IDGERENTE
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 10
            region: @cadastro-de-gerente
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P134_IDGERENTE
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Alterações
        layout {
            sequence: 20
            region: @cadastro-de-gerente
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P134_IDGERENTE
        }
    )

    validation p134-idfilial (
        name: P134_IDFILIAL
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P134_IDFILIAL
        }
        error {
            errorMessage: Filial deve ser informada!
            associatedItem: @P134_IDFILIAL
        }
    )

    process fetch-row-from-gerentes (
        name: Fetch Row from GERENTES
        type: autoRowFetch
        source {
            tableOwner: CATAL
            tableName: GERENTES
            pkColumn: IDGERENTE
            pkItem: P134_IDGERENTE
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Não é possível extrair a linha.
        }
        advanced {
            executionMappingIdentifier: 184646620836888792
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDGERENTE.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P134_IDGERENTE := get_pk; 
                end;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Não é possível obter valor de item de chave primária.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 184646817776888795
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-gerentes (
        name: Process Row of GERENTES
        type: autoRowProcessing
        target {
            tableOwner: CATAL
            tableName: GERENTES
            pkColumn: IDGERENTE
            pkItem: P134_IDGERENTE
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        error {
            errorMessage: Não é possível processar a linha da tabela GERENTES.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 184647033884888795
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 184647219041888795
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 134
            }
            saveStateBeforeBranching: true
        }
    )

)

