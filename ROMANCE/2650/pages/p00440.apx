page 440 (
    name: Pagamento Negociação
    title: Pagamento Negociação
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 70%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region pagamento-negociação (
        name: Pagamento Negociação
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P440_BOMPARA (
        type: datePickerJquery
        label {
            label: Bom Para
            alignment: left
        }
        layout {
            sequence: 80
            region: @pagamento-negociação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P440_CONFERIDO (
        type: plugin/simpleCheckbox
        label {
            label: Conferido?
            alignment: left
        }
        settings {
            checkedValue: S
        }
        layout {
            sequence: 70
            region: @pagamento-negociação
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: null
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P440_DATA (
        type: datePickerJquery
        label {
            label: Data
            alignment: left
        }
        layout {
            sequence: 30
            region: @pagamento-negociação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR HH24:MI:SS
            width: 18
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P440_IDPAGAMENTONEGOCIACAO
        }
        readOnly {
            type: itemIsNotNull
            item: P440_IDPAGAMENTONEGOCIACAO
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P440_IDENTIFICACAO (
        type: radioGroup
        label {
            label: Identificacao
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC:Deposito;D,Cheque;C,Transferencia;T,Boleto;B
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @pagamento-negociação
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P440_IDNEGOCIACAO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @pagamento-negociação
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P440_IDPAGAMENTONEGOCIACAO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @pagamento-negociação
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P440_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 110
            region: @pagamento-negociação
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P440_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        layout {
            sequence: 90
            region: @pagamento-negociação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 70
            height: 5
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P440_SITUACAO (
        type: hidden
        layout {
            sequence: 120
            region: @pagamento-negociação
            slot: regionBody
        }
        default {
            type: static
            staticValue: A
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P440_TIPO (
        type: radioGroup
        label {
            label: Tipo
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC:Pagamento;P,Desconto;D
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @pagamento-negociação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
            escapeSpecialChars: false
        }
    )

    pageItem P440_USUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 100
            region: @pagamento-negociação
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: USUARIO
            used: always
        }
        default {
            type: expression
            plsqlExpression: v('APP_USER')
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P440_VALORPAGO (
        type: numberField
        label {
            label: Valor
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 60
            region: @pagamento-negociação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    button anexar-arquivo (
        buttonName: ANEXAR_ARQUIVO
        label: Anexar Arquivo
        layout {
            sequence: 130
            region: @pagamento-negociação
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 419
                items: {
                    P419_IDNEGOCIACAO: &P440_IDNEGOCIACAO.
                    P419_IDANEXONEGOCIACAOFINAN:
                    P419_IDPAGAMENTONEGOCIACAO: &P440_IDPAGAMENTONEGOCIACAO.
                    P419_TELA_ORIGEM: 440
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P440_IDPAGAMENTONEGOCIACAO
        }
    )

    button criar (
        buttonName: CRIAR
        label: Criar
        layout {
            sequence: 120
            region: @pagamento-negociação
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                :P440_IDNEGOCIACAO is not null 
                and :P440_IDPAGAMENTONEGOCIACAO is null
                ```
        }
    )

    button salvar (
        buttonName: SALVAR
        label: Salvar
        layout {
            sequence: 110
            region: @pagamento-negociação
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from ROMAN.PAGAMENTOSNEGOCIACOES P
                 where p.idnegociacao = :P440_IDNEGOCIACAO
                   and :P440_IDPAGAMENTONEGOCIACAO is not null
                   and p.situacao not in ('Q','C')
                ```
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 90
            region: @pagamento-negociação
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 405
                items: {
                    P405_IDNEGOCIACAO: &P440_IDNEGOCIACAO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation valida-data-pagamento (
        name: Valida Data Pagamento
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P440_BOMPARA
        }
        error {
            errorMessage: Por favor informar data de vencimento!
        }
        serverSideCondition {
            whenButtonPressed: @criar
        }
    )

    process consulta-negociaçoes (
        name: Consulta Negociaçoes
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vdata       date;
                  vvalor     number(15,2) := replace(:P440_VALORPAGO,'.','');
                 -- vvalor number;
                  vbompara    date;
                  voperacao_dml varchar2(1);
                  --
                begin
                  --
                 roman.pck_cadastros_rmc.prc_pagamentosnegociacoes (  pidpagamentonegociacao => :P440_IDPAGAMENTONEGOCIACAO,
                                                                      pidnegociacao          => :P440_IDNEGOCIACAO,
                                                                      pdata                  => vdata,
                                                                      pvalorpago             => vvalor,
                                                                      pobservacao            => :P440_OBSERVACAO,
                                                                      ptipo                  => :P440_TIPO,
                                                                      pconferido             => :P440_CONFERIDO,
                                                                      pidentificacao         => :P440_IDENTIFICACAO,
                                                                      pbompara               => vbompara, 
                                                                      psituacao              => :P440_SITUACAO,
                                                                      pusuario               => :P440_USUARIO,
                                                                      poperacao_dml          => 'S') ;
                  --
                  :P440_DATA := to_char(vdata,'DD/MM/RRRR HH24:MI:SS');
                  --
                  :P440_BOMPARA := to_char(vbompara,'DD/MM/RRRR');
                  --
                 :P440_VALORPAGO := to_char(vvalor,'999G999G999G999G999G990D00');   
                  --
                
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 100225824110865407
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P440_IDPAGAMENTONEGOCIACAO
        }
    )

    process processo-dml-em-pagamentos-de-neg (
        name: Processo DML em Pagamentos de Neg
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  voperacao_dml varchar2(1);
                  vdata         date;
                  vbompara      date;
                  vvalor number;
                  --
                begin
                  --
                  if v('REQUEST') = 'CRIAR' then
                    voperacao_dml := 'I';
                    vdata := to_date(:P440_DATA,'DD/MM/RRRR HH24:MI:SS');
                    vbompara := to_date(:P440_BOMPARA,'DD/MM/RRRR');
                    vvalor := replace(:P440_VALORPAGO,'.','');
                  
                  elsif v('REQUEST') = 'SALVAR' then
                    voperacao_dml := 'U';
                    vdata := to_date(:P440_DATA,'DD/MM/RRRR HH24:MI:SS');
                    vbompara := to_date(:P440_BOMPARA,'DD/MM/RRRR');
                    vvalor := replace(:P440_VALORPAGO,'.','');
                    
                  elsif v('REQUEST') = 'DELETAR' then
                    voperacao_dml := 'D';
                  end if;
                  -- vdata := to_date(:P440_DATA,'DD/MM/RRRR HH24:MI:SS');
                  -- vbompara := to_date(:P440_BOMPARA,'DD/MM/RRRR');
                  -- vvalor := to_char(:P440_VALORPAGO,'999G999G999G990D00');     
                  --vvalor := :P440_VALORPAGO ;
                  -- raise_application_error(-20001,'xxxxx');
                 roman.pck_cadastros_rmc.prc_pagamentosnegociacoes (  pidpagamentonegociacao => :P440_IDPAGAMENTONEGOCIACAO,
                                                                      pidnegociacao          => :P440_IDNEGOCIACAO,
                                                                      pdata                  => vdata,
                                                                      pvalorpago             => vvalor,
                                                                      pobservacao            => :P440_OBSERVACAO,
                                                                      ptipo                  => :P440_TIPO,
                                                                      pconferido             => :P440_CONFERIDO,
                                                                      pidentificacao         => :P440_IDENTIFICACAO,
                                                                      pbompara               => vbompara, 
                                                                      psituacao              => :P440_SITUACAO,
                                                                      pusuario               => :P440_USUARIO,
                                                                      poperacao_dml          => voperacao_dml) ;
                                                                      
                  --vvalor := to_char(:P440_VALORPAGO,'999G999G999G990D00');   
                                                                      
                 if voperacao_dml = 'I' then
                      --
                      apex_application.g_print_success_message := '<span style="color : white "Parcelas geradas com sucesso! </span>';  
                      
                    elsif  voperacao_dml = 'U' then
                      --
                      apex_application.g_print_success_message := '<span style="color : white ">Alteração em parcelas realizado com sucesso! </span>';
                    
                    elsif  voperacao_dml = 'D' then
                      --
                      apex_application.g_print_success_message := '<span style="color : white ">Exclusão realizada com sucesso! </span>';
                    end if;
                
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Parcelas inseridas com sucesso.
        }
        advanced {
            executionMappingIdentifier: 100225303666865402
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('SALVAR','DELETAR','CRIAR')
                ```
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 440
                items: {
                    P440_IDPAGAMENTONEGOCIACAO:
                    P440_IDNEGOCIACAO: &P440_IDNEGOCIACAO.
                    P440_VALORPAGO:
                    P440_DATA:
                    P440_TIPO:
                    P440_OBSERVACAO:
                    P440_USUARIO:
                    P440_BOMPARA:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    branch (
        name: Go To Page 405
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 405
                items: {
                    P405_IDNEGOCIACAO: &P440_IDNEGOCIACAO.
                }
                clearCache: 440
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: CRIAR
        }
    )

    branch (
        name: Go To Page 440
        execution {
            sequence: 30
        }
        behavior {
            target: {
                page: 440
                items: {
                    P440_IDPAGAMENTONEGOCIACAO: &P440_IDPAGAMENTONEGOCIACAO.
                    P440_IDNEGOCIACAO: &P440_IDNEGOCIACAO.
                }
                clearCache: 440
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: SALVAR
        }
    )

)

