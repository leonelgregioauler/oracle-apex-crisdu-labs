page 414 (
    name: Log Pagamentos Fornecedores
    title: Log Pagamentos Fornecedores
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--accent5
                t-Region--scrollBody
            ]
            renderComponents: belowContent
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region log-pagamento-fornecedores (
        name: Log Pagamento Fornecedores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select lp.usuarioalteracao
                     , decode(lp.tipoalteracao,'INSERT','Inclusão','UPDATE','Alteração','DELETE','Exclusão') "Tipo Alt."
                     , lp.dataalteracao
                     , lp.idpgtoforn
                     , lp.dtlancamento
                     , lp.idnotafiscal
                     , ( select documento
                         from roman.notasfiscais nf
                         where nf.idnotafiscal = lp.idnotafiscal ) "Documento"
                     , roman.pck_romance.fnc_nomefornecedor(lp.idfornecedor) "Fornecedor"
                     , lp.valorpagar
                     , lp.valorpago
                     , lp.datapagto
                     , lp.observacao
                     , lp.idcheque
                     , lp.dtvencimento
                     , lp.idvencimento
                     , lp.tipo
                     , roman.pck_romance.fnc_nomefilial(lp.idfilial) "Filial"
                     , ( select descricao
                         from roman.formaspagamentos fp
                         where fp.idformapagamento = lp.tipopagamento ) "Tipo Pagamento"
                     , lp.semanavencimento
                     , decode(lp.identificado,'S','Sim','N','Não') "Identificado"
                     , lp.idmoeda
                     , lp.prioridade
                     , lp.automatizar
                     , lp.databaixa
                     , lp.usuario
                     , lp.desconto
                     , lp.acrescimo
                     , lp.transferencia
                from logroman.log_pagamentosfornecedores lp
                where exists (select 1
                              from roman.notasfiscais nf
                              where lp.idnotafiscal = nf.idnotafiscal
                                and ( :P414_IDFORNECEDOR is null or nf.idfornemitente = :P414_IDFORNECEDOR )
                                and ( :P414_DOCUMENTO is null or nf.documento = :P414_DOCUMENTO )
                                and ( :P414_IDFORNECEDOR is not null or :P414_DOCUMENTO is not null ))
                order by 3 desc
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: - Nenhum registro encontrado -
        }
        advanced {
            savedReportMappingIdentifier: 5711765086515808622
        }

