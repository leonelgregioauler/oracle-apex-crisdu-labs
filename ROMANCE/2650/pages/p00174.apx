page 174 (
    name: Pedidos despachados
    title: Pedidos despachados
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region page_plug (
        name: " "
        type: staticContent
        layout {
            sequence: 1
            slot: body-3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region pedidos-pagos (
        name: Pedidos Pagos
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpedido
                     , nvl(p.pedidotag,pp.nrpedido) "Nr Pedido"
                     , pck_romance.fnc_nomevendedora(pidvendedora => p.idvendedora) "Vendedora"
                     , pp.dtemissao  "Data Emissão"
                     , pp.dataentrega "Data Entrega"
                     , p.datavencimento "Data Vencimento"
                     , p.valorcobrado "Valor Total"
                     , ( select decode(b.databaixa,null,'Não','Sim') from boletos b where b.idpedido = p.idpedido ) Pago
                from boletos        p
                   , pedidos        pp
                where p.idpedido        = pp.idpedido(+)
                  and nvl(p.pedidorepresentante,'N') = 'N'
                  and p.databaixa       is not null
                  and p.idrepresentante = :P174_IDREPRESENTANTE
                ```
        }
        layout {
            sequence: 30
            parentRegion: @page_plug
            slot: subRegions
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        reportLayout {
            numberOfRows: 500
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Não há pedidos pagos.
        }
        componentAdvanced {
            stripHtml: true
        }

        column "Data Emissão" (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Data Emissão
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

        column "Data Entrega" (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Data Entrega
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
        )

        column "Data Vencimento" (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Data Vencimento
                alignment: center
            }
            layout {
                sequence: 6
            }
            sorting {
                defaultSequence: 1
            }
        )

        column IDPEDIDO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column "Nr Pedido" (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Nr Pedido
                alignment: center
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

        column PAGO (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Quitado
                alignment: center
            }
            layout {
                sequence: 8
            }
            sorting {
                sortable: false
            }
        )

        column "Valor Total" (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Valor Total
                alignment: end
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990d00
            }
            sorting {
                sortable: false
            }
            advanced {
                computeSum: true
            }
        )

        column Vendedora (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Vendedora
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

    )

    region pedidos-vencidos (
        name: Pedidos Vencidos
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpedido
                     , nvl(p.pedidotag,pp.nrpedido) "Nr Pedido"
                     , pck_romance.fnc_nomevendedora(pidvendedora => p.idvendedora) "Vendedora"
                     , pp.dtemissao  "Data Emissão"
                     , pp.dataentrega "Data Entrega"
                     , p.datavencimento "Data Vencimento"
                     , p.valorcobrado "Valor Total"
                     , ( select decode(b.databaixa,null,'Não','Sim') from boletos b where b.idpedido = p.idpedido ) Pago
                from boletos        p
                   , pedidos        pp
                where p.idpedido        = pp.idpedido(+)
                  and nvl(p.pedidorepresentante,'N') = 'N'
                  and p.situacao        in ('V', 'G')
                  and trunc(p.datavencimento)  < trunc(sysdate)
                  and p.negociacao      = 'N'
                  and p.idrepresentante = :P174_IDREPRESENTANTE
                ```
        }
        layout {
            sequence: 20
            parentRegion: @page_plug
            slot: subRegions
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        reportLayout {
            numberOfRows: 500
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Não há pedidos vencidos.
        }
        componentAdvanced {
            stripHtml: true
        }

        column "Data Emissão" (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Data Emissão
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

        column "Data Entrega" (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Data Entrega
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
        )

        column "Data Vencimento" (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Data Vencimento
                alignment: center
            }
            layout {
                sequence: 6
            }
            sorting {
                sortable: false
            }
        )

        column IDPEDIDO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column "Nr Pedido" (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Nr Pedido
                alignment: center
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

        column PAGO (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Quitado
                alignment: center
            }
            layout {
                sequence: 8
            }
            sorting {
                sortable: false
            }
        )

        column "Valor Total" (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Valor Pedido
                alignment: end
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990d00
            }
            sorting {
