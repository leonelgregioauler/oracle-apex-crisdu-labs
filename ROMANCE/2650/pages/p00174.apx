    pageItem P174_IDREPRESENTANTE (
        type: selectList
        label {
            label: Representante:
            alignment: left
            tableCellAttributes: nowrap="nowrap"
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) Nome
                     , r.idrepresentante
                from pessoas p
                   , representantes r
                where r.idpessoa  = p.idpessoa  
                  and r.idrepresentante = :P174_IDREPRESENTANTE
                ```
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @page_plug
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            height: 1
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button imprimir (
        buttonName: IMPRIMIR
        label: Imprimir
        layout {
            sequence: 10
            region: @page_plug
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:window.print();
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

