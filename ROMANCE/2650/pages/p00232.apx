    region lista-de-empréstimos (
        name: Lista de Empréstimos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nf.IDNOTAFISCAL
                     , to_char(nf.dtnf,'IW')||'/'||to_char(nf.dtnf,'RRRR') Semana
                     , to_char(nf.dtnf,'RRRR') ANO
                     , decode( nf.tiponota, 'T', 'Transferência'
                                          , 'C', 'Compra' 
                                          , 'E', 'Empréstimo') "Tipo"
                     , decode( nf.tiponota, 'T', pck_romance.fnc_nomefilial(pidfilial => nf.idfilialemitente  )
                                          , 'C', pck_romance.fnc_nomefornecedor(pidforn =>  nf.idfornemitente  ) 
                                          , 'E', pck_romance.fnc_nomefornecedor(pidforn =>  nf.idfornecedordestino  ) ) Cliente
                     , nf.dtnf 
                     , ( select sum(valor) from vencimentos v where v.idnotafiscal = nf.idnotafiscal ) totalvencimentos
                     , decode(NF.SITUACAO,'A','Ativa','C','Cancelada','Ativa') Situacao
                     , nf.documento 
                     , initcap(nf.USUARIO) "Usuário"
                     , nf.observacao "Observação"
                from notasfiscais nf
                where tiponota in ( 'E') -- Empréstimo
                order by 2, nf.dtnf desc
                ```
        }
