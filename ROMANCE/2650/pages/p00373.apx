            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P373_IDFILIAL (
        type: selectList
        label {
            label: "  "
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct pck_romance.fnc_nomefilial(d.idfilial)  display_value
                     , d.idfilial return_value
                from depositosnegociacoesparc d
                where exists ( select 1
                               from vw_filiais f
                               where f.idfilial = d.idfilial
                                 and f.idgrupo = 5 )
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Clique para filtrar por empresa -
        }
        layout {
            sequence: 20
            region: @new
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

