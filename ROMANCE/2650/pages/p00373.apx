    region detalhe (
        name: Detalhe
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vnroidentificacaodigitado  varchar2(1000);
                  vvalorinformado            number(15,2);
                  vqtddeposito               number;
                  --
                  cursor cdep is
                    select ( select initcap(cb.beneficiario)||'('||b.nomebanco||' - '||cb.agencia ||', '||cb.conta||')'
                             from contasbancarias cb
                                , bancos b
                             where cb.idbanco         = b.idbanco
                               and cb.idcontabanc = d.idcontabancaria ) detalhes
                         , to_char(d.datalimitedeposito,'DD/MM/RRRR HH24:MI:SS' ) data
                         , trim(TO_CHAR(valornegociacao ,'999G999G999G990D00')) valor
                         , idrepresentante
                         , d.idnegociacaoparceiro
                    from negociacoesparceiros d
                    where d.idnegociacaoparceiro = :P373_IDNEGOCIACAOPARCEIRO
                    order by 1;
                  --
                  rdep  cdep%rowtype;
                  --
                begin
                  --
                  select sum(valor_digitado)
                  into vvalorinformado                                                                  
                  from depositosnegociacoesparc d
                  where idrepresentante = :P373_IDREPRESENTANTE
                    and d.datarevisao is null;
                  --            
                  for a in (  select d.nroidentificacao_digitado
                                   , count(1) qtd
                              from depositosnegociacoesparc d
                              where idrepresentante = :P373_IDREPRESENTANTE
                                and d.datarevisao is null
                              group by nroidentificacao_digitado
                              order by 1 )
                  loop
                    --
                    if a.qtd > 1 then
                      vnroidentificacaodigitado := vnroidentificacaodigitado|| '<font color="red">'||a.nroidentificacao_digitado||' - '||a.qtd||'</font><br>';         
                    else
                      vnroidentificacaodigitado := vnroidentificacaodigitado|| a.nroidentificacao_digitado||' - '||a.qtd||'<br>';         
                    end if;
                    --
                  end loop;               
                  --
                  open cdep;
                  fetch cdep into rdep;
                  close cdep;
                  --
                  if :P373_IDNEGOCIOACAOPARCEIRO is not null then
                      --
                      htp.p('<table border=0 width="100%">');
                      htp.p('  <tr>');
                      htp.p('    <td width="50%" align="center">');
                      htp.p('       <font size="6">Depósito selecionado</font>');
                      htp.p('    </td>');
                      htp.p('    <td align="center">');
                      htp.p('       <font size="6">Depósito informado</font>');
                      htp.p('    </td>');
                      htp.p('  </tr>');
                      htp.p('  <tr>');
                      htp.p('    <td colspan=2><hr> </td>');
                      htp.p('  </tr>');
                      htp.p('  <tr>');
                      htp.p('    <td align="center">');
                      htp.p('       <font size="6">R$ '||rdep.valor);--trim(to_char(vvalorinformado,'999G999G999G990D00'))||'</font>');
                      htp.br;
                      htp.p('       <font size="4"> '||rdep.detalhes);--trim(to_char(vvalorinformado,'999G999G999G990D00'))||'</font>');
                      htp.br;
                      htp.p('       <font size="4"> '||rdep.DATA);--trim(to_char(vvalorinformado,'999G999G999G990D00'))||'</font>');
                      htp.br;
                      htp.p('    </td>');
                      htp.p('    <td align="center">');                                                                                
                      htp.p('       <font size="6">R$ '||trim(to_char(nvl(vvalorinformado,0),'999G999G999G990D00'))||'</font>');     
                      htp.br;
                      htp.p('       <font size="4"> '||vnroidentificacaodigitado);
                      htp.p('    </td>');
                      htp.p('  </tr>');
                      htp.p('</table>');
                      htp.br;
                      --
                   else
                     --
                     select count(1)
                     into vqtddeposito
                     from negociacoesparceiros d
                     where d.formapagamento = 'D'
                       and idrepresentante = :P373_IDREPRESENTANTE ;
                     --
                     if vqtddeposito = 0 and :P373_IDREPRESENTANTE is not null then   
                       --
                       htp.p('<table border=0 width="100%">');
                       htp.p('  <tr>');
                       htp.p('    <td width="50%" align="center">');
                       htp.p('       <font size="4">Não há negociações pendentes de revisão.</font>');
                       htp.p('    </td>');
                       htp.p('  </tr>');
                       htp.p('</table>');
                       htp.br;
                       --
                     end if;  
                     --
                   end if;
                end;
                
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region distribuidor-selecionado (
        name: Distribuidor Selecionado
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vusuario varchar2(1000);
                  --
                begin
                  --
                  begin
                      select listagg(usuario) within group (order by 1)
                      into vusuario
                      from ( select distinct initcap(d.usuariorevisao) usuario
                              from depositosnegociacoesparc d
                              where idrepresentante = :P373_IDREPRESENTANTE
                                and d.usuariorevisao is not null);
                  exception
                    when others then
                      vusuario := null;
                  end;
                  --
                  htp.p('<table border=0 width="100%">');
                  htp.p('  <tr>');
                  htp.p('    <td width="100%" align="center">');
                  htp.p('       <font size="6">'||pck_romance.fnc_nomerepresentante(:P373_IDREPRESENTANTE)||'</font>');
                  htp.p('    </td>');
                  htp.p('  </tr>');
                  --
                  if vusuario is not null then
                    --
                      htp.p('  <tr>');
                      htp.p('    <td width="100%" align="center">');
                      htp.p('       <font size="4" color="red"><b>Em revisão por '||vusuario||'</b></font>');
                      htp.p('    </td>');
                      htp.p('  </tr>');
                    --
                  end if;
                  --
                  htp.p('</table>');
                  htp.br;
                  --
                end;
                
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P373_IDREPRESENTANTE
        }
    )

    region envio-pendente-de-fotos (
        name: Envio Pendente de Fotos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(np.idrepresentante ) ) empresa
                     , pck_romance.fnc_nomerepresentante(np.idrepresentante ) distribuidor
                     , listagg( replace(trim(to_char(np.valornegociacao,'999G999G999G99G990D00')),',','.')||' - '||TO_CHAR(nvl(np.datalimitedeposito,np.datanegociacao),'DD/MM/RRRR')||'<br>')within group (order by 1) detalhe 
                     , np.idrepresentante                      
                from negociacoesparceiros np
                where np.formapagamento = 'D'
                  and np.idpais != 1
                  and ( :P373_IDFILIAL is null or np.idfilial = :P373_IDFILIAL )
                  and not exists ( select 1
                                   from depositosnegociacoesparc dp
                                   where dp.idnegociacaoparceiro = np.idnegociacaoparceiro 
                                     and dp.datarevisao          is null )
                group by np.idrepresentante;
                ```
