                customAttributes: " style=\"text-align: right;\""
                cellWidth: 10
            }
        )

    )

    region fotos-recebidas (
        name: Fotos Recebidas
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(d.idrepresentante)||' - '||pck_romance.fnc_nomefilial(d.idfilial)  distribuidor
                     , count(1) qtdfotos                                  
                     , d.idrepresentante
                from depositosnegociacoesparc d
                where d.datarevisao is null
                  and d.idfilial = 1041
                  and ( :P373_IDFILIAL is null or d.idfilial = :P373_IDFILIAL )
                group by idrepresentante, d.idfilial
                union all
                select pck_romance.fnc_nomerepresentante(d.idrepresentante)||' - '||pck_romance.fnc_nomefilial(d.idfilial)  distribuidor
                     , count(1) qtdfotos                                  
                     , d.idrepresentante
                from depositosnegociacoesparc d
                where d.datarevisao is null
                  and d.idfilial in ( 1095,1111,1081 )
                  and ( :P373_IDFILIAL is null or d.idfilial = :P373_IDFILIAL )
                group by idrepresentante, d.idfilial;
                
                
                
                ```
            pageItemsToSubmit: P373_IDFILIAL
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: DISTRIBUIDOR
            valueColumn: QTDFOTOS
            linkTarget: {
                page: 373
                items: {
                    P373_IDREPRESENTANTE: &IDREPRESENTANTE.
                }
                action: resetPagination
            }
            color: yes
        }
    )

    region new (
        name: New
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--xlarge
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P373_AVISO_DEPOSITO_DUPLICADO (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 20
            region: @fotos-enviadas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<font color="RED"><h1> O Comprovante de nro '||dr.nroidentificacao||' já foi utilizado em outro Depósito!</h1></font>' d
                from depositosdiarios_leituraocr dr
                where dr.idrepresentante = :P373_IDREPRESENTANTE
                  and dr.iddepositodiario is null
                  and exists ( select 1
                               from depositosdiarios_leituraocr dl
                               where dl.idrepresentante = dr.idrepresentante
                                 and dl.idfilial        = dr.idfilial
                                 and dl.iddepositodiario is not null
                                 and dl.nroidentificacao = dr.nroidentificacao
                                 and dl.valor            = dr.valor
                                 and dl.datadeposito     = dr.datadeposito )
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from depositosdiarios_leituraocr dr
                where dr.idrepresentante = :P373_IDREPRESENTANTE
                  and dr.iddepositodiario is null
                  and exists ( select 1
                               from depositosdiarios_leituraocr dl
                               where dl.idrepresentante = dr.idrepresentante
                                 and dl.idfilial        = dr.idfilial
                                 and dl.iddepositodiario is not null
                                 and dl.nroidentificacao = dr.nroidentificacao
                                 and dl.valor            = dr.valor
                                 and dl.datadeposito     = dr.datadeposito )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P373_IDDEPOSITO_EXCLUIR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
