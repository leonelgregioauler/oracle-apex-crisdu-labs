    region fotos-enviadas (
        name: Fotos enviadas
        type: tabform
        source {
            sqlQuery:
                ```sql
                select d.iddepositonegociacao
                     , d.idnegociacaoparceiro
                     , usuario
                     , dataleitura
                     , datadeposito
                     , trim(to_char(valor,'999G999G999G990D00'))||'<br>'||nroidentificacao contavalor
                     , d.nomearquivo
                     , idfilial
                     , idrepresentante 
                     , '<a href="https://cobraki.com.br/fotos/'||nomearquivo||'" target="_blank"> <img src="https://cobraki.com.uy/fotos/'||nomearquivo||'" class="img_produto"><a>' foto
                     --, '<iframe  width=500px; height=655px; src="/apex/f?p=2650:261:&APP_SESSION.::NO:RP:P261_ARQUIVO:'||nomearquivo||'"></iframe>' foto
                     , nroidentificacao_digitado
                     , valor_digitado
                     , '<button onclick="apex.submit({request:''SUBMIT'',validate:true});" class="t-Button t-Button--success lto238774214550442118_0" type="button" ><span class="t-Button-label">Salvar</span></button>' SALVAR    
                     , '<button onclick="apex.submit({request:''REJEITAR'',validate:true});" class="t-Button t-Button--warning lto238774214550442118_0" type="button" ><span class="t-Button-label">Rejeitar</span></button>' REJEITAR
                     , observacao    
                     , '<button onclick="javascript: fnc_excluirfoto ('||d.iddepositonegociacao||');" class="t-Button t-Button--danger lto238774214550442118_0" type="button" ><span class="t-Button-label">Deletar</span></button>' DELETAR       
                from depositosnegociacoesparc d
                where idrepresentante = :P373_IDREPRESENTANTE
                  and d.idnegociacaoparceiro = :P373_IDNEGOCIACAOPARCEIRO
                ```
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent14
                t-Region--scrollBody
            ]
        }
