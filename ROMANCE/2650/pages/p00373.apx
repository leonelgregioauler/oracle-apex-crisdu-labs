    button atualizartela (
        buttonName: ATUALIZARTELA
        label: Atualizar Tela
        layout {
            sequence: 10
            region: @new
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--primary
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 373
                items: {
                    P373_IDFILIAL:
                    P373_IDNEGOCIACAOPARCEIRO:
                    P373_IDREPRESENTANTE:
                    P373_IDDEPOSITO_EXCLUIR:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction filtrar (
        name: Filtrar
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P373_IDFILIAL
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction verifica-idioma-usuario (
        name: Verifica Idioma Usuario
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                      vidpais number;
                    begin
                      --
                      begin
                        select ididioma
                        into vidpais
                        from usuarios u
                        where usuario = v('APP_USER');
                      exception
                        when others then 
                          vidpais := 1;
                      end;
                      --
                      :P373_IDPAIS := vidpais;
                      --
                    end;
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    validation valida-rejeição (
        name: Valida Rejeição
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @fotos-enviadas
            type: columnIsNotNull
            column: OBSERVACAO
        }
        error {
            errorMessage: #COLUMN_HEADER# É necessário informar o motivo da reijeção!
            associatedColumn: OBSERVACAO
        }
        serverSideCondition {
            executionScope: allSubmittedRows
            type: request=Value
            value: REJEITAR
        }
    )

    process confirma-depósito (
        name: Confirma Depósito
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_negociacoes_rmc.prc_confirmadeposito(pidnegociacaoparceiro => :P373_IDNEGOCIACAOPARCEIRO,
                                                           pusuario => v('APP_USER'));
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Confirmado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 4507314660922180123
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'SUBMIT' and :P373_IDNEGOCIACAOPARCEIRO is not null
        }
    )

    process excluir-deopósito (
        name: Excluir Deopósito
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_negociacoes_rmc.prc_excluideposito(piddeposito => :P373_IDDEPOSITO_EXCLUIR);
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Depósito excluido com sucesso!
        }
        advanced {
            executionMappingIdentifier: 52041086422404101
        }
        serverSideCondition {
            type: request=Value
            value: EXCLUIR
        }
    )

    process processes-fotos-depósitos (
        name: Processes Fotos Depósitos
        type: tabformUpdate
        editableRegion: @fotos-enviadas
        target {
            tableName: DEPOSITOSNEGOCIACOESPARC
            pkColumn: IDDEPOSITONEGOCIACAO
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 36010895432758288
        }
        serverSideCondition {
            type: request!=Value
            value: EXCLUIR
        }
    )

    process rejeita-depósito (
        name: Rejeita Depósito
        type: executeCode
        editableRegion: @fotos-enviadas
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_negociacoes_rmc.prc_rejeitardepositonegociacao(pidnegociacaoparceiro => :P373_IDNEGOCIACAOPARCEIRO,
                                                                     pmotivo => :OBSERVACAO,
                                                                     pusuario => v('APP_USER'));
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Depósito Rejeitado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 40697773740134633
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'REJEITAR' and :P373_IDNEGOCIACAOPARCEIRO is not null
        }
    )

    branch (
        name: Go To Page 373
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 373
                items: {
                    P373_IDFILIAL: &P373_IDFILIAL.
                }
                action: resetPagination
            }
        }
    )

    branch (
        name: Go To Page 373
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 373
                items: {
                    P373_IDREPRESENTANTE:
                    P373_IDNEGOCIACAOPARCEIRO:
                    P373_IDFILIAL:
                }
                clearCache: 373
                action: resetPagination
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('SUBMIT','REJETIAR')
        }
    )

)

