page 373 (
    name: Fotos Depósitos Cobraki
    title: Fotos Depósitos Cobraki
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_abrejanela(psessao, pid)
              {
              window.open("/apex/f?p=2650:32:"+psessao+"::NO:32:P32_IDPGTOFORN:"+pid,"_blank");
              }
            
            function fnc_excluirfoto (pid)
            {
              apex.confirm("Deseja realmente excluir esta foto?"
                         , {  request:"EXCLUIR"
                            , set:{"P373_IDDEPOSITO_EXCLUIR":pid}}
                           );
            }    
            ```
    }
    css {
        inline:
            ```css
            .img_produto {
                position: relative;
                max-width:700px;
                max-height:500px;
                width: auto;
                height: auto;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region depósitos-informados (
        name: Depósitos Informados
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select ( select initcap(cb.beneficiario)||'('||b.nomebanco||' - '||cb.agencia ||', '||cb.conta||')'
                         from contasbancarias cb
                            , bancos b
                         where cb.idbanco         = b.idbanco
                           and cb.idcontabanc = d.idcontabancaria )||' ['|| to_char(datalimitedeposito,'DD/MM/RRRR' ) ||'] 'display_value
                     , trim(TO_CHAR(d.valornegociacao ,'999G999G999G990D00')) /* ||' - '  || nrocomprovante*/     return_value
                     , idrepresentante
                     , d.idnegociacaoparceiro
                from negociacoesparceiros d
                where d.formapagamento = 'D'
                  and idrepresentante = :P373_IDREPRESENTANTE
                  and exists ( select 1    
                               from depositosnegociacoesparc dp
                               where dp.idnegociacaoparceiro = d.idnegociacaoparceiro
                                 and dp.usuariorevisao is null
                                 and dp.datarevisao is null )
                order by 1;
                
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: DISPLAY_VALUE
            valueColumn: RETURN_VALUE
            linkTarget: {
                page: 373
                items: {
                    P373_IDREPRESENTANTE: &P373_IDREPRESENTANTE.
                    P373_IDNEGOCIACAOPARCEIRO: &IDNEGOCIACAOPARCEIRO.
                }
                action: resetPagination
            }
            layout: 3Columns
            chartType: circular
            chartSize: extraLarge
            color: yes
        }
    )

    region depósitos-rejeitados (
        name: Depósitos Rejeitados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(np.idrepresentante ) ) empresa
                     , pck_romance.fnc_nomerepresentante(np.idrepresentante ) distribuidor
                     , listagg( replace(trim(to_char(np.valornegociacao,'999G999G999G99G990D00')),',','.')||' - '||TO_CHAR(nvl(np.datalimitedeposito,np.datanegociacao),'DD/MM/RRRR')||'<br>') within group (order by 1) detalhe 
                     , np.idrepresentante                      
                from negociacoesparceiros np
                where np.formapagamento = 'D'
                  and np.idpais != 1
                  and ( :P373_IDFILIAL is null or np.idfilial = :P373_IDFILIAL )
                  and exists ( select 1
                               from depositosnegociacoesparc dp
                               where dp.idnegociacaoparceiro = np.idnegociacaoparceiro 
                                 and dp.datarevisao          is not null
                                 and dp.situacao             = 'R' )
                group by np.idrepresentante;
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                is-collapsed
                t-Region--accent2
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 40698946880134645
        }

