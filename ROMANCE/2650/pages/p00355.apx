page 355 (
    name: Matriz de Regras de Receitas
    title: Matriz de Regras de Receitas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region matriz-de-regras-de-receitas (
        name: Matriz de Regras de Receitas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDMATRIZREGRARECEITA,
                       IDFORNECEDOREMITENTE,
                       IDFORNECEDORCLIENTE,
                       IDCONTAFINAN,
                       IDSUBCONTAFINAN,
                       DATAINCLUSAO,
                       USUARIO,
                       OBSERVACAO,
                       TIPO,
                       ATIVO
                  from MATRIZREGRASRECEITAS
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 24999524287977226
        }

        savedReport 8225272 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDMATRIZREGRARECEITA
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @IDFORNECEDORCLIENTE
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDFORNECEDOREMITENTE
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDCONTAFINAN
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @IDSUBCONTAFINAN
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @ATIVO
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @DATAINCLUSAO
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @USUARIO
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @OBSERVACAO
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @TIPO
                layout {
                    width: 229
                    sequence: 5
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column ATIVO (
            type: selectList
            heading {
                heading: Ativo
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC2:Sim;S,Não;N
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 140
                columnAlignment: center
            }
            source {
                databaseColumn: ATIVO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column DATAINCLUSAO (
            type: datePickerJquery
            heading {
                heading: Data Inclusão
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR hh24:mi:ss
            }
            source {
                databaseColumn: DATAINCLUSAO
                dataType: date
                queryOnly: true
            }
        )

        column IDCONTAFINAN (
            type: selectList
            heading {
                heading: Conta
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select c.nomeconta
                         , c.idcontafinan
                    from contasfinanceiras c
                    where ativo = 'S'
                      and centrodecusto = 'S'
                      and debitocredito = 'C'
                    order by 1;
                    
                    ```
                displayExtraValues: false
            }
            layout {
                sequence: 80
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDCONTAFINAN
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDFORNECEDORCLIENTE (
            type: selectList
            heading {
                heading: Destino
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(p.nomepessoa) display_value
                         , f.idfornecedor return_value 
                    from fornecedores f
                       , pessoas p
                    where f.idpessoa = p.idpessoa
                      and f.ativo = 'S'
                    order by 1
                    ```
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDFORNECEDORCLIENTE
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDFORNECEDOREMITENTE (
            type: selectList
            heading {
                heading: Emitente
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(p.nomepessoa) display_value
                         , f.idfornecedor return_value 
                    from fornecedores f
                       , pessoas p
                    where f.idpessoa = p.idpessoa
                      and f.ativo = 'S'
                    order by 1
                    ```
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDFORNECEDOREMITENTE
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDMATRIZREGRARECEITA (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDMATRIZREGRARECEITA
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: SEQ_IDMATRIZREGRARECEITA
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDSUBCONTAFINAN (
            type: selectList
            heading {
                heading: Sub Conta
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select s.nomeconta
                         , s.idsubcontafinan
                    from subcontasfinanceiras s
                    where s.idcontafinan = :IDCONTAFINAN
                      and s.ativo = 'S'
                    order by 1
                    ```
            }
            cascadingLov {
                parentColumns: IDCONTAFINAN
            }
            layout {
                sequence: 90
            }
            source {
                databaseColumn: IDSUBCONTAFINAN
                dataType: number
            }
        )

        column OBSERVACAO (
            type: textarea
            heading {
                heading: Observação
            }
            layout {
                sequence: 120
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: OBSERVACAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column TIPO (
            type: selectList
            heading {
                heading: Tipo
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC2:Operacional;O,Não Operacional;N
            }
            layout {
                sequence: 130
            }
            source {
                databaseColumn: TIPO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column USUARIO (
            type: textField
            heading {
                heading: Incluído Por
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: center
            }
            validation {
                maxLength: 50
            }
            source {
                databaseColumn: USUARIO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

    )

    process save-interactive-grid-data (
        name: " - Save Interactive Grid Data"
        type: interactiveGridAutoRowProcessing
        editableRegion: @matriz-de-regras-de-receitas
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 12511281203170178
        }
    )

)

