page 545 (
    name: Lista de Históricos Contábeis
    title: Lista de Históricos Contábeis
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region lista-de-históricos-contábeis (
        name: Lista de Históricos Contábeis
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDHISTORICOCONTABIL, 
                NOMEHISTORICOCONTABIL
                from HISTORICOSCONTABEIS
                order by NOMEHISTORICOCONTABIL
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 544
                items: {
                    P544_IDHISTORICOCONTABIL: #IDHISTORICOCONTABIL#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: This query returns more than 10,000 rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column IDHISTORICOCONTABIL (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDHISTORICOCONTABIL
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NOMEHISTORICOCONTABIL (
            type: plainText
            heading {
                heading: Histórico Contábil
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: NOMEHISTORICOCONTABIL
                endUserAlias: B
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 54501 (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn IDHISTORICOCONTABIL (
                sequence: 1
            )

            displayColumn NOMEHISTORICOCONTABIL (
                sequence: 2
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Novo Histórico Contábil
        layout {
            sequence: 30
            region: @lista-de-históricos-contábeis
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 544
                clearCache: 544
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction create-button-dialog-closed (
        name: Create Button - Dialog Closed
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: location.reload();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @lista-de-históricos-contábeis
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: location.reload();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

