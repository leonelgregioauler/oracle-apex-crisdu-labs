page 467 (
    name: Contas a Receber Forn.
    title: Contas a Receber Forn.
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region contas-a-receber (
        name: Contas a Receber
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idcontasarecebervirutalage
                     , c.cliente
                     , nvl( ( select pck_romance.fnc_nomefornecedor(r.idfornecedor)
                              from razoessociaisfornec r
                              where r.codigovirtualage = trim(to_number(c.cliente)) ),'Fornecedor não Localizado') fornecedor
                     , c.cpf_cnpj
                     , c.empresa
                     , c.fatura
                     , c.parcela
                     , c.documento
                     , c.portador
                     , c.emissao
                     , c.venc_orig
                     , c.vencimento
                     , c.liquidacao
                     , c.valor_fatura
                     , c.dataimportacao
                     , c.dataprocessado
                     , decode(c.processado,'E','Erro','S','Sucesso','Não processado') situacao
                from contasarecebervirtualage c
                where ( :P467_IDFORNECEDOR is null or c.idfornecedor = :P467_IDFORNECEDOR )
                  and ( :P467_TIPODATA is null
                     or ( :P467_TIPODATA = 'I' and trunc(c.dataimportacao) between to_date(:P467_DATAINICIO,'DD/MM/RRRR') and to_date(:P467_DATAFIM,'DD/MM/RRRR') )
                     or ( :P467_TIPODATA = 'P' and trunc(c.dataprocessado) between to_date(:P467_DATAINICIO,'DD/MM/RRRR') and to_date(:P467_DATAFIM,'DD/MM/RRRR') ) )
                  and c.cliente is not null
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: "Nenhum registro localizado! "
        }
        advanced {
            savedReportMappingIdentifier: 1506733572494521915
        }

