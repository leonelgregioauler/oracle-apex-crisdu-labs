    )

    button create (
        buttonName: CREATE
        label: Novo Registro
        layout {
            sequence: 30
            region: @grade-interativa
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 474
                clearCache: 474
            }
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            customAttributes: style="background-color:#ff92a6;color:black";
        }
