    region fotos-recebidas (
        name: Fotos Recebidas
        type: themeTemplateComponent/mediaList
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(d.idrepresentante)||' - '||pck_romance.fnc_nomefilial(d.idfilial)  distribuidor
                     , count(1) qtdfotos                                  
                     , d.idrepresentante
                from depositosdiarios_leituraocr d
                where iddepositodiario is null
                  and (:P319_IDFILIAL is null or d.idfilial = :P319_IDFILIAL)
                  and ( nvl(:P319_FILTRO,'T') = 'T' or ( :P319_FILTRO = 'A' and d.usuariorevisao is null )
                                           or ( :P319_FILTRO = 'R' and d.usuariorevisao is not null ) )
                group by idrepresentante, d.idfilial
                union
                select distinct pck_romance.fnc_nomerepresentante(d.idrepresentante)||' - '||pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(idrepresentante))  distribuidor
                     , ( select count(1)                                         
                         from depositosdiarios_leituraocr dd  
                         where dd.idrepresentante = d.idrepresentante
                           and dd.iddepositodiario is null  ) qtdfotos                                  
                     , d.idrepresentante    
                from depositosdiarios_orig d
                where d.valordeposito != nvl(( select sum(dd.valor_digitado)
                                             from depositosdiarios_leituraocr dd  
                                             where dd.idrepresentante = d.idrepresentante
                                               and dd.iddepositodiario is null  ) ,0)
                  and exists ( select 1
                               from depositosdiarios_leituraocr dd  
                               where dd.idrepresentante = d.idrepresentante
                                 and dd.iddepositodiario is null  ) 
                  and not exists ( select 1 from depositosdiarios ddd where ddd.iddepositodiarios = d.iddepositodiarios )                 
                  and d.comprovado != 'M'                            
                  and not exists ( select 1
                               from depositosdiarios_leituraocr dd  
                               where dd.iddepositodiario = d.iddepositodiarios ) 
                  and :P319_FILTRO = 'V'
                  
                ```
            pageItemsToSubmit: P319_IDFILIAL
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        accessibility {
            landmarkType: region
        }
        componentAppearance {
            display: report
        }
        settings {
            title: QTDFOTOS
            description: DISTRIBUIDOR
            displayBadge: true
            layout: horizontalSpan
            size: large
            applyThemeColors: false
