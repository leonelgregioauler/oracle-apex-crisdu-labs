    pageItem P319_AVISO_DEPOSITO_DUPLICADO (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 20
            region: @fotos-enviadas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<font color="RED"><h1> O Comprovante de nro '||dr.nroidentificacao||' já foi utilizado em outro Depósito!</h1></font>' d
                from roman.depositosdiarios_leituraocr dr
                where dr.idrepresentante = :P319_IDREPRESENTANTE
                  and dr.iddepositodiario is null
                  and exists ( select 1
                               from roman.depositosdiarios_leituraocr dl
                               where dl.idrepresentante = dr.idrepresentante
                                 and dl.idfilial        = dr.idfilial
                                 and dl.iddepositodiario is not null
                                 and dl.nroidentificacao = dr.nroidentificacao
                                 and dl.valor            = dr.valor
                                 and ( dl.datadeposito   = dr.datadeposito
                                    or dl.datadeposito is null )
                                 and dl.idleituraocr_deposito != dr.idleituraocr_deposito )
                				 
                union 
                -- Maicon Aimi - 8524534 - 31/01/2024 adicionado esse union para pegar comprovante duplicado quando é o mesmo é enviado por representantes diferentes
                select '<font color="RED"><h1> O Comprovante de nro '||dr.nroidentificacao||' já foi utilizado em outro Depósito! para o(s) representante(s): ' || 
                       ( select listagg( distinct roman.pck_romance.fnc_nomerepresentante(dl.idrepresentante), ' - ') within group (order by idrepresentante) repres
                               from roman.depositosdiarios_leituraocr dl
                               where dl.idrepresentante <> dr.idrepresentante
                                 and  dl.idfilial        = dr.idfilial
                                 and dl.iddepositodiario is not null
                                 and dl.nroidentificacao = dr.nroidentificacao
                                 and dl.valor            = dr.valor
                                 and ( dl.datadeposito   = dr.datadeposito
                                    or dl.datadeposito is null )
                                 and dl.idleituraocr_deposito != dr.idleituraocr_deposito ) || '</h1></font>' d
                from roman.depositosdiarios_leituraocr dr
                where dr.idrepresentante = :P319_IDREPRESENTANTE
                  and dr.iddepositodiario is null
                  and exists ( select 1
                               from roman.depositosdiarios_leituraocr dl
                               where dl.idrepresentante <> dr.idrepresentante
                                 and  dl.idfilial        = dr.idfilial
                                 and dl.iddepositodiario is not null
                                 and dl.nroidentificacao = dr.nroidentificacao
                                 and dl.valor            = dr.valor
                                 and ( dl.datadeposito   = dr.datadeposito
                                    or dl.datadeposito is null )
                                 and dl.idleituraocr_deposito != dr.idleituraocr_deposito )
                
                union 
                
                -- maicon - 8524534 - 31/01/2024 
                select distinct '<font color="RED"><h1> O Comprovante de nro '||nvl(dr.nroidentificacao, nvl(dr.nroidentificacao_digitado,dr.nroidentificacao_limpo))||' já foi utilizado em outro Depósito! para o(s) representante(s): ' || 
                       ( select listagg( distinct roman.pck_romance.fnc_nomerepresentante(dl.idrepresentante), ' - ') within group (order by idrepresentante) repres
                               from roman.depositosdiarios_leituraocr dl
                               where dl.idleituraocr_deposito != dr.idleituraocr_deposito
                                 and dl.nroidentificacao_limpo = dr.nroidentificacao_limpo ) || '</h1></font>' d
                from roman.depositosdiarios_leituraocr dr
                where dr.idrepresentante = :P319_IDREPRESENTANTE
                  and dr.iddepositodiario is null
                  and exists (select 1
                                from roman.depositosdiarios_leituraocr tt
                               where tt.idleituraocr_deposito != dr.idleituraocr_deposito
                                 and tt.nroidentificacao_limpo = dr.nroidentificacao_limpo
                                 and tt.agenca = dr.agenca
                                 and tt.conta = dr.conta)
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
