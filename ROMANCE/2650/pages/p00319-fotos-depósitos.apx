    dynamicAction valores-diferente-exige-confirmação (
        name: Valores Diferente Exige Confirmação
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @corrigir
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                    vValorDepositoSelecionado number;
                    vValorDepósitoInformado   number;
                begin
                
                    
                    /*Valor Selecionado*/
                    begin
                        select valordeposito
                          into vValorDepositoSelecionado
                          from depositosdiarios_orig d
                         where d.iddepositodiarios = :P319_IDDEPOSITODIARIO;
                    exception
                        when others then
                            vValorDepositoSelecionado := 0;
                    end;
                
                    
                    /*Valor Informado*/
                    begin
                        select sum(valor_digitado)
                          into vValorDepósitoInformado
                          from depositosdiarios_leituraocr d
                         where iddepositodiario is null
                           and idrepresentante = :P319_IDREPRESENTANTE;
                    exception
                        when others then
                            vValorDepósitoInformado := 0;
                    end;
                         
                    
                    /*Retorno da Function*/
                    if vValorDepósitoInformado != vValorDepositoSelecionado then
                        return true;
                    else
                        return false;
                    end if;
                end;
                ```
        }

        action native-confirm (
            action: confirm
            settings {
                message:
                    ```html
                    Atenção!
                    Depósito selecionado diferente do Depósito informado!
                    Deseja Confirmar a revisão?
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: CORRIGIR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

