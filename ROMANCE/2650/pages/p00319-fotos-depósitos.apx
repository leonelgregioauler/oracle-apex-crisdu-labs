    region fotos-enviadas (
        name: Fotos enviadas
        type: tabform
        source {
            sqlQuery:
                ```sql
                select idleituraocr_deposito
                     , iddepositodiario
                     , usuario
                     , dataleitura
                     , datadeposito
                     , idbanco
                     , banco ||' <br> '||agenca||'/'||conta ||'<br>'|| beneficiario ||' <br><br><br>'||
                          trim(to_char(valor,'999G999G999G990D00'))||'<br>'|| nroidentificacao contavalor
                     , nomearquivo
                     , idfilial
                     , idrepresentante 
                     , '<iframe class="img" width=500px; height=655px; src="/apex/f?p=2650:261:&APP_SESSION.::NO:RP:P261_ARQUIVO:'||nomearquivo||'"></iframe>' foto
                  --   , ':::::P261_ARQUIVO:'||nomearquivo TESTE
                     , nroidentificacao_digitado
                     , valor_digitado
                     , '<button onclick="apex.submit({request:''SUBMIT'',validate:true});" class="t-Button t-Button--warning lto238774214550442118_0" type="button" ><span class="t-Button-label">Salvar</span></button>' SALVAR    
                     , '<button onclick="javascript: fnc_excluirfoto ('||IDLEITURAOCR_DEPOSITO||');" class="t-Button t-Button--danger lto238774214550442118_0" type="button" ><span class="t-Button-label">Deletar</span></button>' deletar     
                     , transferencia
                     , pix
                from depositosdiarios_leituraocr c
                where idrepresentante = :P319_IDREPRESENTANTE
                  and ( :P319_IDDEPOSITODIARIO is not null 
                         or ( :P319_IDDEPOSITODIARIO is null and not exists ( select 1 
                                                                              from DEPOSITOSDIARIOS_orig d
                                                                              where comprovado = 'S'
                                                                                and d.idrepresentante = c.idrepresentante
                                                                                and idrepresentante = :P319_IDREPRESENTANTE ) ) )
                  and iddepositodiario is null
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent14
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                 select 1
                from depositosdiarios_leituraocr c
                where idrepresentante = :P319_IDREPRESENTANTE
                  and ( :P319_IDDEPOSITODIARIO is not null 
                         or ( :P319_IDDEPOSITODIARIO is null and not exists ( select 1 
                                                                              from DEPOSITOSDIARIOS_orig d
                                                                              where comprovado = 'S'
                                                                                and d.idrepresentante = c.idrepresentante
                                                                                and idrepresentante = :P319_IDREPRESENTANTE ) ) )
                  and iddepositodiario is null
                ```
        }
