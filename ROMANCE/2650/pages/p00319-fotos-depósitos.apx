    process corrigir (
        name: Corrigir
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vvalorinformado  number(15,2);
                  valordepositoori number(15,2);
                  verro            varchar2(4000);
                  --
                begin
                  -- 
                  update depositosdiarios_leituraocr   s
                  set iddepositodiario = :P319_IDDEPOSITODIARIO      
                    , s.datarevisao    = sysdate
                    , s.usuariorevisao = v('APP_USER')
                  where iddepositodiario is null
                    and s.valor_digitado is not null       
                    and idrepresentante = :P319_IDREPRESENTANTE
                  returning sum(valor_digitado)
                  into vvalorinformado ;
                  --
                  select d.valordeposito
                  into valordepositoori
                  from depositosdiarios_orig d
                  where d.iddepositodiarios = :P319_IDDEPOSITODIARIO;
                  --
                  if valordepositoori != vvalorinformado then
                    --
                    execute immediate 'alter table DEPOSITOSDIARIOS_LEITURAOCR disable constraint DK_DEPDIA_OCR_DEPDIA';
                    --
                    pck_financeiro_rmc.prc_alteravalordeposito(piddepositodiario => :P319_IDDEPOSITODIARIO,
                                                               pvalordeposito    => vvalorinformado,
                                                               ppagina           => 230);
                    --
                    execute immediate 'alter table DEPOSITOSDIARIOS_LEITURAOCR enable constraint DK_DEPDIA_OCR_DEPDIA';
                    --
                  end if;
                  --
                  update depositosdiarios
                  set comprovado = 'M'
                  where iddepositodiarios = :P319_IDDEPOSITODIARIO;
                  --
                  update depositosdiarios_orig
                  set comprovado = 'M'
                  where iddepositodiarios = :P319_IDDEPOSITODIARIO;
                  --
                  commit;
                  --
                exception
                  when others then
                    --
                    begin
                      --
                      update depositosdiarios_leituraocr   s
                      set iddepositodiario = :P319_IDDEPOSITODIARIO      
                        , s.datarevisao    = sysdate
                        , s.usuariorevisao = v('APP_USER')
                      where iddepositodiario is null
                        and s.valor_digitado is not null       
                        and idrepresentante = :P319_IDREPRESENTANTE
                      returning sum(valor_digitado)
                      into vvalorinformado ;
                      --
                      select d.valordeposito
                      into valordepositoori
                      from depositosdiarios_orig d
                      where d.iddepositodiarios = :P319_IDDEPOSITODIARIO;
                      --
                      if valordepositoori != vvalorinformado then
                        --
                        execute immediate 'alter table DEPOSITOSDIARIOS_LEITURAOCR disable constraint DK_DEPDIA_OCR_DEPDIA';
                        --
                        pck_financeiro_rmc.prc_alteravalordeposito(piddepositodiario => :P319_IDDEPOSITODIARIO,
                                                                   pvalordeposito    => vvalorinformado,
                                                                   ppagina           => 230);
                        --
                        execute immediate 'alter table DEPOSITOSDIARIOS_LEITURAOCR enable constraint DK_DEPDIA_OCR_DEPDIA';
                        --
                      end if;
                      --
                      update depositosdiarios
                      set comprovado = 'M'
                      where iddepositodiarios = :P319_IDDEPOSITODIARIO;
                      --
                      update depositosdiarios_orig
                      set comprovado = 'M'
                      where iddepositodiarios = :P319_IDDEPOSITODIARIO;
                      --
                      commit;
                      --
                    exception
                      when others then
                        --
                        verro := sqlerrm;
                        --
                        insert into chamados ( idchamado
                                             , dataabertura
                                             , usuario
                                             , titulo
                                             , descricao 
                                             , idgrupoatendimento )
                        values ( seq_idchamado.nextval
                               , sysdate
                               , v('APP_USER')
                               , 'Erro na revisao de fotos de depositos'
                               , 'Deposito de nr: '||:P319_IDDEPOSITODIARIO||' apresentou o erro: '||verro
                               , 0 );
                        --
                        commit;                     
                        --
                    end;
                    --
                end;
                
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 39326224352304307
        }
        serverSideCondition {
            type: request=Value
            value: CORRIGIR
        }
    )

