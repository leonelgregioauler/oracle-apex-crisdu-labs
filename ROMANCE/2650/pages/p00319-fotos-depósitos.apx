page 319 (
    name: Fotos Depósitos
    alias: FOTOS-DEPÓSITOS
    title: Fotos Depósitos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_abrejanela(psessao, pid)
              {
              window.open("/apex/f?p=2650:32:"+psessao+"::NO:32:P32_IDPGTOFORN:"+pid,"_blank");
              }
            
            function fnc_excluirfoto (pid)
            {
              apex.confirm("Deseja realmente excluir esta foto?"
                         , {  request:"DELETAR"
                            , set:{"P230_IDLEITURAOCR_EXCLUIR":pid}}
                           );
            }    
            ```
    }
    css {
        inline:
            ```css
            .img html body img{
                max-width: 500px;
            }
            .img {
                border: 1px solid black;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region depósitos-informados (
        name: Depósitos Informados
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select ( select initcap(cb.beneficiario)||'('||b.nomebanco||' - '||cb.agencia ||', '||cb.conta||')'
                         from contasbancarias cb
                            , bancos b
                         where cb.idbanco         = b.idbanco
                           and cb.idcontabanc = d.idcontabanc )||' ['
                    || to_char(data,'DD/MM/RRRR HH24:MI:SS' ) ||'] 'display_value
                    , trim(TO_CHAR(valordeposito ,'999G999G999G990D00')) /* ||' - '  || nrocomprovante*/       return_value
                     , idrepresentante
                     , d.iddepositodiarios
                from DEPOSITOSDIARIOS_orig d
                where comprovado = 'S'
                  and idrepresentante = :P319_IDREPRESENTANTE
                  and extract ( year from data ) >= 2021
                  and extract ( month from data ) >= to_number(to_char(sysdate,'MM'))-1
                order by d.data desc;
                
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: DISPLAY_VALUE
            valueColumn: RETURN_VALUE
            linkTarget: {
                page: 230
                items: {
                    P319_IDDEPOSITODIARIO: &IDDEPOSITODIARIOS.
                    P319_IDREPRESENTANTE: &P319_IDREPRESENTANTE.
                }
                action: resetPagination
            }
            layout: 3Columns
            chartType: circular
            chartSize: extraLarge
            color: yes
        }
    )

    region detalhe (
        name: Detalhe
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vnroidentificacaodigitado  varchar2(4000);
                  vvalorinformado            number(15,2);
                  vqtddeposito               number;
                  --
                  cursor cdep is
                    select ( select initcap(cb.beneficiario)||'('||b.nomebanco||' - '||cb.agencia ||', '||cb.conta||')'
                             from contasbancarias cb
                                , bancos b
                             where cb.idbanco         = b.idbanco
                               and cb.idcontabanc = d.idcontabanc ) detalhes
                         ,  to_char(data,'DD/MM/RRRR HH24:MI:SS' ) DATA
                         , trim(TO_CHAR(valordeposito ,'999G999G999G990D00')) valor
                         , idrepresentante
                         , d.iddepositodiarios
                         , D.IDPGTOFORN        
                         , d.nrocomprovante
                    from DEPOSITOSDIARIOS_orig d
                    where d.iddepositodiarios = :P319_IDDEPOSITODIARIO
                    order by 1;
                  --
                  rdep  cdep%rowtype;
                  --
                begin
                  --
                  select sum(valor_digitado)
                  into vvalorinformado                                                                  
                  from depositosdiarios_leituraocr d
                  where idrepresentante = :P319_IDREPRESENTANTE
                   and iddepositodiario is null;
                  --            
                  for a in (  select d.nroidentificacao_digitado
                                   , count(1) qtd
                              from depositosdiarios_leituraocr d
                              where idrepresentante = :P319_IDREPRESENTANTE
                                and iddepositodiario is null
                              group by nroidentificacao_digitado
                              order by 1 )
                  loop
                    --
                    if a.qtd > 1 then
                      vnroidentificacaodigitado := vnroidentificacaodigitado|| '<font color="red">'||a.nroidentificacao_digitado||' - '||a.qtd||'</font><br>';         
                    else
                      vnroidentificacaodigitado := vnroidentificacaodigitado|| a.nroidentificacao_digitado||' - '||a.qtd||'<br>';         
                    end if;
                    --
                  end loop;   
                  --
                  open cdep;
                  fetch cdep into rdep;
                  close cdep;
                  --
                  if :P319_IDDEPOSITODIARIO is not null then
                      --
                      htp.p('<table border=0 width="100%">');
                      htp.p('  <tr>');
                      htp.p('    <td width="50%" align="center">');
                      htp.p('       <font size="6">Depósito selecionado</font>');
                      htp.p('    </td>');
                      htp.p('    <td align="center">');
                      htp.p('       <font size="6">Depósito informado</font>');
                      htp.p('    </td>');
                      htp.p('  </tr>');
                      htp.p('  <tr>');
                      htp.p('    <td colspan=2><hr> </td>');
                      htp.p('  </tr>');
                      htp.p('  <tr>');
                      htp.p('    <td align="center">');
                      htp.p('       <font size="6">R$ '||rdep.valor);--trim(to_char(vvalorinformado,'999G999G999G990D00'))||'</font>');
                      htp.br;
                      htp.p('       <font size="4"> '||rdep.detalhes);--trim(to_char(vvalorinformado,'999G999G999G990D00'))||'</font>');
                      htp.br;
                      htp.p('       <font size="4"> '||rdep.nrocomprovante);--trim(to_char(vvalorinformado,'999G999G999G990D00'))||'</font>');
                      htp.br;
                      htp.p(      rdep.DATA);
                      htp.br;
                      htp.p('       <font size="4"> <a href="javascript: fnc_abrejanela('''||v('APP_SESSION')||''','''||rdep.idpgtoforn||''')">Ver Fatura</a></font>');
                      htp.p('    </td>');
                      htp.p('    <td align="center">');                                                                                
                      htp.p('       <font size="6">R$ '||trim(to_char(nvl(vvalorinformado,0),'999G999G999G990D00'))||'</font>');     
                      htp.br;
                      htp.p('       <font size="4"> '||vnroidentificacaodigitado);
                      htp.p('    </td>');
                      htp.p('  </tr>');
                      htp.p('</table>');
                      htp.br;
                      --
                   else
                     --
                     select count(1)
                     into vqtddeposito
                      from DEPOSITOSDIARIOS_orig d
                      where comprovado = 'S'
                        and idrepresentante = :P319_IDREPRESENTANTE ;
                     --
                     if vqtddeposito = 0 and :P319_IDREPRESENTANTE is not null then   
                       --
                       htp.p('<table border=0 width="100%">');
                       htp.p('  <tr>');
                       htp.p('    <td width="50%" align="center">');
                       htp.p('       <font size="4">Não há depósitos pendentes de revisão.</font>');
                       htp.p('    </td>');
                       htp.p('  </tr>');
                       htp.p('</table>');
                       htp.br;
                       --
                     end if;  
                     --
                   end if;
                end;
                
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region distribuidor-selecionado (
        name: Distribuidor Selecionado
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vusuario varchar2(1000);
                  --
                begin
                  --
                  begin
                      select listagg(usuario) within group (order by 1)
                      into vusuario
                      from ( select distinct initcap(d.usuariorevisao) usuario
                              from depositosdiarios_leituraocr d
                              where idrepresentante = :P319_IDREPRESENTANTE
                                and d.usuariorevisao is not null
                                and d.iddepositodiario is null );
                  exception
                    when others then
                      vusuario := null;
                  end;
                  --
                  htp.p('<table border=0 width="100%">');
                  htp.p('  <tr>');
                  htp.p('    <td width="100%" align="center">');
                  htp.p('       <font size="6">'||pck_romance.fnc_nomerepresentante(:P319_IDREPRESENTANTE)||' - '||pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(:P319_IDREPRESENTANTE))||'</font>');
                  htp.p('    </td>');
                  htp.p('  </tr>');
                  --
                  if vusuario is not null then
                    --
                      htp.p('  <tr>');
                      htp.p('    <td width="100%" align="center">');
                      htp.p('       <font size="4" color="red"><b>Em revisão por '||vusuario||'</b></font>');
                      htp.p('    </td>');
                      htp.p('  </tr>');
                    --
                  end if;
                  --
                  htp.p('</table>');
                  htp.br;
                  --
                end;
                
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P319_IDREPRESENTANTE
        }
    )

    region envio-pendente-de-fotos (
        name: Envio Pendente de Fotos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(d.idrepresentante ) ) empresa
                     , pck_romance.fnc_nomerepresentante(d.idrepresentante ) distribuidor
                     , count(1) - ( select count(1)
                                    from depositosdiarios_leituraocr
                                    where idrepresentante = d.idrepresentante
                                      and iddepositodiario is null ) quantidade  
                     , listagg(trim(to_char(d.valordeposito))||' - '||TO_CHAR(d.data,'DD/MM/RRRR')||'<br>')within group (order by 1) detalhe 
                     , d.idrepresentante                      
                from depositosdiarios_orig d
                where exists ( select *
                               from parametrosrepresentantes p
                               where parametro = 'HABILITAFOTODEPOSITO'
                                 and p.idrepresentante = d.idrepresentante
                                 and p.valor = 'S')
                  and comprovado = 'S'   
                having  count(1) - ( select count(1)
                                    from depositosdiarios_leituraocr
                                    where idrepresentante = d.idrepresentante
                                      and iddepositodiario is null ) > 0
                group by d.idrepresentante
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
