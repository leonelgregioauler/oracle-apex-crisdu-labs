page 491 (
    name: Cadastros Excluídos Convenção
    alias: CADASTROS-EXCLUÍDOS-CONVENÇÃO
    title: Cadastros Excluídos Convenção
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region lista-de-pessoas-excluídas (
        name: Lista de Pessoas Excluídas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDPESSOACONVENCAO 
                     , PP.USUARIOALTERACAO 
                     , PP.DATAALTERACAO 
                     , pck_romance.FNC_NOMEFILIAL(IDFILIAL) empresa
                     , pck_romance.FNC_NOMEREPRESENTANTE(IDREPRESENTANTE)  distribuidor
                     , NOMECOMPLETO
                     , SEXO
                     , DATANASCIMENTO   
                     , NACIONALIDADE  
                     , ''''||DOCUMENTO||'''' DOCUMENTO
                     , ''''||CPF||'''' CPF
                     , DATAEMISSAODOCUMENTO    
                     , ( SELECT   p.nome
                         FROM paises  p
                         WHERE p.idpais =  pp.IDPAISEMISSAODOCUMENTO ) paisemissaodocuennto
                     , DATAVENCIMENTODOCUMENTO 
                     , ( SELECT c.NOMECIDADE
                         FROM cidades c
                         WHERE c.idcidade  = pp.IDCIDADENASCIMENTO ) cidade_nascimento
                     ,  TELEFONE 
                     , EMAIL 
                     , RUA
                     , NUMERO  
                     , CEP 
                     , ( SELECT c.NOMECIDADE
                         FROM cidades c
                         WHERE c.idcidade  = pp.IDCIDADEENDERECO ) cidade_endereco 
                     , PARENTESCO
                     , ( SELECT count(1)
                         FROM anexospessoasconvencao a
                         WHERE a.IDPESSOACONVENCAO = pp.IDPESSOACONVENCAO ) anexos
                     , CABINE
                     , decode(PP.REVISADO,'N','Não','S','Sim') REVISADO
                     , PP.DATAREVISAO
                     , ''''||PP.RG||'''' RG
                     , ''''||PP.CNH||'''' CNH
                     , PP.DATAVENCIMENTOCNH
                     , PP.DOCUMENTOAPRESENTACAO
                     , ( SELECT G.SIGLA
                         FROM GRADES G
                         WHERE G.IDGRADE = PP.Idgradecamiseta ) TAMANHO_CAMISETA
                     , ( SELECT INITCAP(NOMEPESSOA)
                         FROM PESSOAS P
                         WHERE P.IDPESSOA = PP.ACOMPANHANTE_DE ) ACOMPANHANTE_DE
                     , ( SELECT c.NOMECIDADE ||' - '||e.SIGLA || ' - '||p.SIGLA 
                          FROM cidades c
                             , estados e
                             , paises p
                          WHERE c.idestado = e.IDESTADO 
                            AND e.IDPAIS   = p.IDPAIS 
                            AND c.idcidade  = pp.origem )  origem_partida
                     , ( select initcap(p.nomepessoa) 
                         from fornecedores f
                            , pessoas p
                         where p.idpessoa = f.idpessoa
                           and f.idfornecedor = pp.idfornecedor ) fornecedor
                     , ( select s.setor
                         from setoreschamados s
                         where s.idsetorchamado = pp.idsetor ) setor
                     , UPPER(SUBSTR( NOMECOMPLETO, 1, INSTR( NOMECOMPLETO,' ')-1)) NOME
                     , UPPER(substr( NOMECOMPLETO, INSTR( NOMECOMPLETO, ' ', -1))) SOBRENOME
                     , OBSERVACAO
                     , case
                         WHEN DOCUMENTOAPRESENTACAO = 'RG' THEN
                           ''''||RG||''''
                         WHEN DOCUMENTOAPRESENTACAO = 'CNH' THEN
                           ''''||CNH||''''
                         WHEN DOCUMENTOAPRESENTACAO = 'PASSAPORTE' THEN
                           ''''||DOCUMENTO||''''
                         WHEN DOCUMENTOAPRESENTACAO = 'CERTIDAO' THEN
                           ''''||RG||''''
                         ELSE
                           ''''||PP.DOCUMENTO||''''
                       end DOCUMENTO_CRUZEIRO
                     , case
                         WHEN DOCUMENTOAPRESENTACAO = 'RG' THEN
                           add_months(dataemissaodocumento,120) 
                         WHEN DOCUMENTOAPRESENTACAO = 'CNH' THEN
                           PP.DATAVENCIMENTOCNH
                         WHEN DOCUMENTOAPRESENTACAO = 'PASSAPORTE' THEN
                           PP.DATAVENCIMENTODOCUMENTO
                         WHEN DOCUMENTOAPRESENTACAO = 'CERTIDAO' THEN
                           add_months(dataemissaodocumento,120) 
                       end VENCIMENTO_DOCUMENTO
                     , case
                         WHEN DOCUMENTOAPRESENTACAO = 'RG' THEN
                           PP.DATAEMISSAODOCUMENTO
                         WHEN DOCUMENTOAPRESENTACAO = 'CNH' THEN
                           CASE
                             WHEN EXTRACT(YEAR FROM PP.DATAVENCIMENTOCNH) - EXTRACT(YEAR FROM SYSDATE) < 5 THEN
                               add_months(DATAVENCIMENTOCNH,-60)
                             WHEN EXTRACT(YEAR FROM PP.DATAVENCIMENTOCNH) - EXTRACT(YEAR FROM SYSDATE) >= 5 THEN
                               add_months(DATAVENCIMENTOCNH,-120)
                           END
                         WHEN DOCUMENTOAPRESENTACAO = 'PASSAPORTE' THEN
                           CASE
                             when trunc((months_between(sysdate, datanascimento))/12) = 1 THEN
                               add_months(DATAVENCIMENTODOCUMENTO,-12)
                             WHEN trunc((months_between(sysdate, datanascimento))/12) BETWEEN 1 AND 2 THEN
                               add_months(DATAVENCIMENTODOCUMENTO,-24)
                             WHEN trunc((months_between(sysdate, datanascimento))/12) BETWEEN 2 AND 3 THEN
                               add_months(DATAVENCIMENTODOCUMENTO,-36)
                             WHEN trunc((months_between(sysdate, datanascimento))/12) BETWEEN 3 AND 4 THEN
                               add_months(DATAVENCIMENTODOCUMENTO,-48)
                             WHEN trunc((months_between(sysdate, datanascimento))/12) BETWEEN 4 AND 18 THEN
                               add_months(DATAVENCIMENTODOCUMENTO,-60)
                             WHEN trunc((months_between(sysdate, datanascimento))/12) > 18 THEN
                               add_months(DATAVENCIMENTODOCUMENTO,-120)
                           END
                         WHEN DOCUMENTOAPRESENTACAO = 'CERTIDAO' THEN
                           PP.DATAEMISSAODOCUMENTO 
                       end EMISSAO_DOCUMENTO
                from LOGROMAN.LOG_PESSOASCONVENCAO pp
                WHERE PP.TIPOALTERACAO = 'DELETE'
                  AND PP.DATAALTERACAO >= TO_DATE('01/07/2024 00:00:01','DD/MM/RRRR HH24:MI:SS')
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 109805767013996445
        }

