    button nova-lucratividade (
        buttonName: NOVA_LUCRATIVIDADE
        label: Nova Lucratividade
        layout {
            sequence: 15
            region: @lista-de-fechamentos-efetuados
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 147
                items: {
                    P147_IDLUCRATIVIDADE:
                    P147_IDFECHAMENTO: &P146_IDFECHAMENTO.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: VOLTAR
