page 146 (
    name: Lista de Acertos Efetuados
    title: Lista de Acertos Efetuados
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region lista-de-fechamentos-efetuados (
        name: Lista de Fechamentos Efetuados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select l.idlucratividade
                     , l.idfechamentorepres
                     , l.vlrcarga
                     , l.vlrcargaadicional
                     , l.vlrdevolucao
                     , l.vlrtotalliquido
                     , l.vlrcobranca
                     , l.vlrtotal
                     , l.vlracumulado
                     , l.vlrpepinosabertos
                     , l.vlrpepinospagos
                     , l.acumuladopepinosabertos
                     , l.acumuladopepinospagos
                     , ( select initcap(nomepessoa) from pessoas p , representantes r where p.idpessoa = r.idpessoa and r.idrepresentante = l.idrepresentante) "Representante"
                     , l.idfechamento
                     , f.semana
                     , ( select rr.descricao from regioesvenda rr where rr.idregiaovenda = l.idregiaovenda ) "Região"
                from lucratividade l
                   , fechamentossemanais f
                where f.idfechamento = l.idfechamento
                  and l.idfechamento = :P146_IDFECHAMENTO
                  and exists (select 1
                              from dual 
                              where   (pck_romance.fnc_verificaacesso('PERM_ALTERAFECHA', v('APP_USER')) = 'S')
                                       or( f.idfilial = pck_romance.fnc_filialusuario(v('APP_USER'))))
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        link {
            linkColumn: customTarget
            target: {
                page: 147
                items: {
                    P147_IDFECHAMENTOREPRES: #IDFECHAMENTOREPRES#
                    P147_IDLUCRATIVIDADE: #IDLUCRATIVIDADE#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhum acerto efetuado.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

