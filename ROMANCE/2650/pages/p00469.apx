page 469 (
    name: Contas a Receber
    title: Contas a Receber
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region contas-a-receber (
        name: Contas a Receber
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.nome||' - '||e.cnpj empresa
                     , w.fornecedor
                     , sum(w.a_receber) a_receber
                from favorita.empresasvirtualage e
                   , vw_contasreceber_forn_2 w
                where w.empresa = e.idempresavirtualage
                  and w.vencimento <= to_date(:P469_DATAFIM,'DD/MM/RRRR')
                group by nome
                       , fornecedor
                       , cnpj
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 1804020729098407428
        }

        column A_RECEBER (
            type: plainText
            heading {
                heading: A Receber
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        column EMPRESA (
            type: plainText
            heading {
                heading: Empresa
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column FORNECEDOR (
            type: plainText
            heading {
                heading: Fornecedor
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 29071776 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn A_RECEBER (
                sequence: 3
            )

            displayColumn EMPRESA (
                sequence: 1
            )

            displayColumn FORNECEDOR (
                sequence: 2
            )

            aggregate (
                column: A_RECEBER
            )

            controlBreak (
                column: EMPRESA
                layout {
                    sequence: 1
                }
            )

        )

    )

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P469_DATAFIM (
        type: datePickerJquery
        label {
            label: Data Vencimento Até
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 15
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P469_ULTIMAIMPORTACAO (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<font color="blue"><h3>Última importação realizada: '||to_char(c.dataprocessado,'DD/MM/RRRR HH24:MI:SS')||'</h3></font>' texto
                from contasarecebervirtualage c
                where c.idcontasarecebervirutalage = ( select max(cr.idcontasarecebervirutalage)
                                                       from contasarecebervirtualage cr
                                                       where cr.processado = 'S'
                                                         and cr.dataprocessado is not null )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P469_DATAINICIO
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-data-fim (
        name: Refresh Data Fim
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P469_DATAFIM
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process popula-datas (
        name: Popula Datas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  select trunc(sysdate)
                  into :P469_DATAFIM
                  from dual;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 2907110276768632693
        }
        serverSideCondition {
            type: itemIsNull
            item: P469_DATAFIM
        }
    )

    branch (
        name: Go To Page 450
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 469
                items: {
                    P469_DATAFIM: &P469_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: FILTRAR
        }
    )

)

