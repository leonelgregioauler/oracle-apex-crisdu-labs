page 397 (
    name: Cadastro de Chaves PIX
    title: Cadastro de Chaves PIX
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        height: 800
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region chave-pix (
        name: Chave Pix
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    region chaves-cadastradas-na-conta (
        name: Chaves Cadastradas na Conta
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idchavepix
                     , c.datacadastro
                     , c.usuario
                     , c.beneficiario
                     , decode(c.tipochave,1,'Cpf/CNPJ'
                                         ,2,'Chave Aleatória'
                                         ,3,'Telefone'
                                         ,4,'Email') tipochave
                     , c.chave
                     , c.observacao
                     , c.idcontabancaria
                     , c.idpessoa
                     , ( select initcap(cb.beneficiario)||'('||b.nomebanco||' - '||cb.agencia ||', '||cb.conta||')' conta
                         from contasbancarias cb
                            , bancos b
                         where cb.idbanco     = b.idbanco
                           and cb.idpessoa    = c.idpessoa
                           and cb.idcontabanc = c.idcontabancaria ) conta
                from chavespix c
                where c.idpessoa = :P397_IDPESSOA
                  and c.idcontabancaria = nvl(:P397_IDCONTABANCARIA, c.idcontabancaria)
                order by 1
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma chave localizada!
        }
        advanced {
            savedReportMappingIdentifier: 4996189048861106628
        }

