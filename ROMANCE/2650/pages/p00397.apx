    process consulta-dml (
        name: Consulta DML
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --  
                  PCK_CADASTROS_RMC.PRC_CHAVESPIX( PIDCHAVEPIX => :P397_IDCHAVEPIX,
                                                   PDATACADASTRO => :P397_DATACADASTRO,
                                                   PUSUARIO => :P397_USUARIO,
                                                   PCHAVE => :P397_CHAVE,
                                                   POBSERVACAO => :P397_OBSERVACAO,
                                                   PIDPESSOA => :P397_IDPESSOA,
                                                   PIDCONTABANCARIA => :P397_IDCONTABANCARIA,
                                                   PTIPOCHAVE => :P397_TIPOCHAVE,
                                                   PBENEFICIARIO => :P397_BENEFICIARIO,
                                                   PMD5 => :P397_MD5,
                                                   POPERACAO_DML => 'S');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 4996188849839106626
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P397_IDCHAVEPIX
        }
    )

    process processo-dml (
        name: "Processo DML "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                  vusuario varchar2(100) := v('APP_USER');
                begin
                  --
                  if v('REQUEST') = 'CRIAR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'SALVAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'DELETAR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  PCK_CADASTROS_RMC.PRC_CHAVESPIX( PIDCHAVEPIX => :P397_IDCHAVEPIX,
                                                   PDATACADASTRO => :P397_DATACADASTRO,
                                                   PUSUARIO => vusuario ,
                                                   PCHAVE => :P397_CHAVE,
                                                   POBSERVACAO => :P397_OBSERVACAO,
                                                   PIDPESSOA => :P397_IDPESSOA,
                                                   PIDCONTABANCARIA => :P397_IDCONTABANCARIA,
                                                   PTIPOCHAVE => :P397_TIPOCHAVE,
                                                   PBENEFICIARIO => :P397_BENEFICIARIO,
                                                   PMD5 => :P397_MD5,
                                                   POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: "Processo executado com sucesso! "
        }
        advanced {
            executionMappingIdentifier: 5068810687642964961
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('DELETAR','SALVAR','CRIAR')
        }
    )

    branch (
        name: Go To Page 397
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 397
                items: {
                    P397_IDCHAVEPIX: &P397_IDCHAVEPIX.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @salvar
        }
    )

    branch (
        name: Go To Page 397
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 397
                items: {
                    P397_IDCHAVEPIX:
                    P397_DATACADASTRO:
                    P397_USUARIO:
                    P397_CHAVE:
                    P397_IDCONTABANCARIA:
                    P397_OBSERVACAO:
                    P397_IDPESSOA: &P397_IDPESSOA.
                    P397_MD5:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('CRIAR','DELETAR')
        }
    )

)

