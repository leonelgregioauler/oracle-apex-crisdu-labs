page 291 (
    name: Abatimentos
    title: Abatimentos
    appearance {
        pageMode: nonModalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region abatimentos (
        name: Abatimentos
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select vr.idvencimento
                     , pck_romance.fnc_nomefornecedor(nv.idfornecedordestino) "Cliente"
                     , nv.documento nrnf
                     , vr.datavencimento dtvencimento
                     , vr.valor
                from notasfiscais nv 
                   , vencimentosreceber vr
                   , depositosdiarios_orig dd
                where nv.tiponota         = 'V'
                  and nv.idnotafiscal     = vr.idnotafiscal
                  and vr.idvencimento     = dd.idvencimentoabatimento
                  and to_char(dd.data,'MMRRRR') =  :P291_MESANO
                  and nv.idnotafiscalcompra in ( select idnotafiscal
                                                 from notasfiscais nc
                                                 where nc.idfornemitente = :P291_IDFORNECEDOR)
                union
                select v.idvencimento
                     , pck_romance.fnc_nomefilial(nf.idfilialdestino) cliente
                     , nf.documento nrnf
                     , v.datavencimento dtvencimento
                     , v.valor
                from notasfiscais nf
                   , vencimentos v
                where nf.idfornemitente = 2099
                  and nf.idfilialdestino = 1075
                  and v.idnotafiscal = nf.idnotafiscal
                  and to_char(v.datavencimento,'MMRRRR') = :P291_MESANO
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 300
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: setPaginationSelectList
        }
        performance {
            maxRowsToProcess: 5000
        }
        messages {
            whenNoDataFound: No data found.
        }
        breakFormatting {
            breakColumns: col1
        }
        componentAdvanced {
            stripHtml: true
        }
        download {
            csvExportEnabled: true
        }

        column Cliente (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Cliente
                alignment: center
            }
            layout {
                sequence: 2
            }
        )

        column DTVENCIMENTO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Vencimento
                alignment: center
            }
            layout {
                sequence: 1
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
            sorting {
                defaultSequence: 1
            }
        )

        column IDVENCIMENTO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 5
            }
        )

        column NRNF (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Nr Doc
                alignment: center
            }
            layout {
                sequence: 3
            }
        )

        column VALOR (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Valor
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            advanced {
                computeSum: true
            }
        )

    )

    pageItem P291_IDFORNECEDOR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @abatimentos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P291_MESANO (
        type: textField
        label {
            label: Semana
            alignment: left
        }
        layout {
            sequence: 10
            region: @abatimentos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            customAttributes: readonly
        }
        security {
            encryptSessionState: false
        }
    )

)

