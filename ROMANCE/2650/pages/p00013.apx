page 13 (
    name: Contas / Sub Contas
    title: Contas / Sub Contas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region contas (
        name: Contas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select "IDCONTAFINAN", 
                "NOMECONTA",
                "OBSERVACAO",
                decode(DEBITOCREDITO,'C','Credito','D','Debito') DEBITOCREDITO,
                decode(tipo,'V','Variável','F','Fixa') TIPO,
                decode(tipooperacional,'O','Operacional','N','Não Operacional') tipooperacional,
                decode(internaexterna,'E','Externa,','I','Interna') classificacao,
                null acessoscontas,
                decode(centrodecusto,'S','Sim','Não') centrodecusto,
                usuario,
                datacriacao,
                case when basezero = 'S' then 'Sim'
                     when basezero = 'N' then 'Não'
                     else 'Indefinido' 
                end basezero
                from "#OWNER#"."CONTASFINANCEIRAS" 
                
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 14
                items: {
                    P14_IDCONTAFINAN: #IDCONTAFINAN#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: This query returns more than 10,000 rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column ACESSOSCONTAS (
            type: link
            heading {
                heading: Acessos a Conta
                alignment: center
            }
            layout {
                sequence: 44
                columnAlignment: center
            }
            link {
                target: {
                    page: 356
                    items: {
                        P356_IDCONTAFINAN: #IDCONTAFINAN#
                    }
                    action: resetPagination
                }
                linkText: <b>Ver/Liberar Acessos</b>
                linkAttributes: class="t-Button t-Button--sucess"
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column BASEZERO (
            type: plainText
            heading {
                heading: Basezero
            }
            layout {
                sequence: 84
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: L
            }
        )

        column CENTRODECUSTO (
            type: plainText
            heading {
                heading: Centro de Custo?
                alignment: center
            }
            layout {
                sequence: 54
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        column CLASSIFICACAO (
            type: plainText
            heading {
                heading: Classificação
                alignment: center
            }
            layout {
                sequence: 34
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column DATACRIACAO (
            type: plainText
            heading {
                heading: Criado Em
                alignment: center
            }
            layout {
                sequence: 74
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: K
            }
        )

        column DEBITOCREDITO (
            type: plainText
            heading {
                heading: Debito/Credito
                alignment: center
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: DEBITOCREDITO
                endUserAlias: D
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDCONTAFINAN (
            type: hidden
            heading {
                heading: Idcontafinan
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDCONTAFINAN
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NOMECONTA (
            type: plainText
            heading {
                heading: Conta Financeira
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: NOMECONTA
                endUserAlias: B
            }
            enableUsersTo {
                pivot: false
            }
        )

        column OBSERVACAO (
            type: plainText
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: OBSERVACAO
                endUserAlias: C
            }
            enableUsersTo {
                pivot: false
            }
        )

        column TIPO (
            type: plainText
            heading {
                heading: Tipo
                alignment: center
            }
            layout {
                sequence: 14
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column TIPOOPERACIONAL (
            type: plainText
            heading {
                heading: Tipo Operacional
                alignment: center
            }
            layout {
                sequence: 24
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column USUARIO (
            type: plainText
            heading {
                heading: Criado Por
                alignment: center
            }
            layout {
                sequence: 64
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: J
            }
        )

        savedReport 14172 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100000
            }

            displayColumn ACESSOSCONTAS (
                sequence: 8
            )

            displayColumn CENTRODECUSTO (
                sequence: 9
            )

            displayColumn CLASSIFICACAO (
                sequence: 7
            )

            displayColumn DATACRIACAO (
                sequence: 11
            )

            displayColumn DEBITOCREDITO (
                sequence: 4
            )

            displayColumn IDCONTAFINAN (
                sequence: 1
            )

            displayColumn NOMECONTA (
                sequence: 2
            )

            displayColumn OBSERVACAO (
                sequence: 3
            )

            displayColumn TIPO (
                sequence: 5
            )

            displayColumn TIPOOPERACIONAL (
                sequence: 6
            )

            displayColumn USUARIO (
                sequence: 10
            )

            sort (
                column: CENTRODECUSTO
                sort {
                    direction: desc
                    sequence: 1
                }
            )

            controlBreak (
                column: CENTRODECUSTO
                layout {
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Nova Conta
        layout {
            sequence: 20
            region: @contas
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 14
                clearCache: 14
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button relatorio (
        buttonName: RELATORIO
        label: Ver Relatório
        layout {
            sequence: 10
            region: @contas
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 359
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

