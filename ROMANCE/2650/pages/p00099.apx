page 99 (
    name: Nova Entrada
    title: Nova Entrada
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='Confirma a exclusão da Entrada?';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region nova-entrada (
        name: Nova Entrada
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P99_DATA (
        type: datePickerJquery
        label {
            label: Data
            alignment: right
        }
        layout {
            sequence: 60
            region: @nova-entrada
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 10
        }
        validation {
            maxLength: 255
        }
        advanced {
            customAttributes: style="text-align: right;" readonly
        }
        source {
            type: databaseColumn
            databaseColumn: DATA
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                return to_char(sysdate,'DD/MM/RRRR');
                end;
                ```
        }
        readOnly {
            type: itemIsNotNull
            item: P99_FECHAMENTOORIG
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P99_DESCRICAO (
        type: textarea
        label {
            label: Descrição
            alignment: right
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 100
            region: @nova-entrada
            slot: regionBody
            alignment: left
            columnSpan: 4
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
            height: 4
        }
        validation {
            maxLength: 200
        }
        source {
            type: databaseColumn
            databaseColumn: DESCRICAO
            used: always
        }
        readOnly {
            type: itemIsNotNull
            item: P99_FECHAMENTOORIG
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P99_FECHAMENTOORIG (
        type: hidden
        layout {
            sequence: 20
            region: @nova-entrada
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: FECHAMENTOORIG
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P99_IDCONTACONTABIL (
        type: selectList
        label {
            label: Conta
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nomeconta display_value
                 , c.idcontafinan return_value
                from contasfinanceiras c
                where c.debitocredito = 'C'
                order by c.nomeconta
                ```
            nullDisplayValue: - Selecione a Conta -
        }
        layout {
            sequence: 80
            region: @nova-entrada
            slot: regionBody
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDCONTACONTABIL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P99_IDENTRADA (
        type: hidden
        layout {
            sequence: 10
            region: @nova-entrada
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDENTRADA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P99_IDFECHAMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 110
            region: @nova-entrada
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFECHAMENTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P99_IDFILIAL (
        type: selectList
        label {
            label: Filial
            alignment: right
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(p.apelido,p.nomepessoa)) display_value
                     , f.idfilial return_value
                from filiais    f
                   , pessoas    p
                   , usuarios   u
                   , gerentes   g
                where f.idpessoa  = p.idpessoa
                  and g.idfilial  = f.idfilial
                  and u.idgerente = g.idgerente
                  and u.usuario   = v('APP_USER')
                ```
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @nova-entrada
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIAL
            used: always
        }
        readOnly {
            type: itemIsNotNull
            item: P99_FECHAMENTOORIG
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P99_IDFILIALORIG (
        type: hidden
        layout {
            sequence: 30
            region: @nova-entrada
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIALORIG
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P99_IDSUBCONTACONTABIL (
        type: selectList
        label {
            label: Sub Conta
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nomeconta display_value
                 , c.idsubcontafinan return_value
                from subcontasfinanceiras c
                where c.idcontafinan = :P99_IDCONTACONTABIL
                order by c.nomeconta
                ```
            nullDisplayValue: - Selecione a Subconta -
        }
        cascadingLov {
            parentItems: P99_IDCONTACONTABIL
        }
        layout {
            sequence: 90
            region: @nova-entrada
            slot: regionBody
            startNewRow: false
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDSUBCONTACONTABIL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P99_SEMANA (
        type: hidden
        layout {
            sequence: 40
            region: @nova-entrada
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: SEMANA
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                return to_char(sysdate,'IW/RRRR');
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P99_TIPO (
        type: selectList
        label {
            label: Tipo
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Outros;O,Investimento;I,Fatura;F
            displayNullValue: false
        }
        layout {
            sequence: 120
            region: @nova-entrada
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: TIPO
            used: always
        }
        default {
            type: static
            staticValue: O
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P99_VALORTOTAL (
        type: numberField
        label {
            label: Valor Total
            alignment: right
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 70
            region: @nova-entrada
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 12
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: VALORTOTAL
            used: always
        }
        readOnly {
            type: itemIsNotNull
            item: P99_IDFILIALORIG
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @nova-entrada
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 95
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 40
            region: @nova-entrada
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P99_IDENTRADA
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @nova-entrada
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 from dual
                where :P99_IDENTRADA IS NOT NULL
                AND :P99_IDFILIALORIG IS NULL
                ```
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @nova-entrada
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 from dual
                where :P99_IDENTRADA is not null
                ```
        }
    )

    validation p99-idcontacontabil (
        name: P99_IDCONTACONTABIL
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P99_IDCONTACONTABIL
        }
        error {
            errorMessage: #LABEL# deve ser informada!
            associatedItem: @P99_IDCONTACONTABIL
        }
    )

    validation p99-valortotal (
        name: P99_VALORTOTAL
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P99_VALORTOTAL
        }
        error {
            errorMessage: #LABEL# deve ser informado!
            associatedItem: @P99_VALORTOTAL
        }
    )

    process fetch-row-from-entradasdiversas (
        name: Fetch Row from ENTRADASDIVERSAS
        type: autoRowFetch
        source {
            tableName: ENTRADASDIVERSAS
            pkColumn: IDENTRADA
            pkItem: P99_IDENTRADA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Unable to fetch row.
        }
        advanced {
            executionMappingIdentifier: 181890333386943702
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDENTRADASDIVERSAS.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P99_IDENTRADA := get_pk; 
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Unable to get primary key item value.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 181890510315943708
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-entradasdiversas (
        name: Process Row of ENTRADASDIVERSAS
        type: autoRowProcessing
        target {
            tableName: ENTRADASDIVERSAS
            pkColumn: IDENTRADA
            pkItem: P99_IDENTRADA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        error {
            errorMessage: Unable to process row of table ENTRADASDIVERSAS.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 181890733100943708
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        clear {
            type: pages
            pages: 64
        }
        execution {
            sequence: 40
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 181890917144943708
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 95
            }
            saveStateBeforeBranching: true
        }
    )

)

