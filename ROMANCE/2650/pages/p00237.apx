page 237 (
    name: Metas da Campanha
    title: Metas da Campanha
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region metas-da-campanha (
        name: Metas da Campanha
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDMETASCAMPANHA",
                "IDMETASCAMPANHA" IDMETASCAMPANHA_DISPLAY,
                "IDCAMPANHA",
                "IDREPRESENTANTE",
                "VALORMETAROMAN",
                "VALORMETAFAVORITA",
                "VALORMETAGERAL"
                from "#OWNER#"."METASCAMPANHA"
                WHERE pck_romance.fnc_filialrepresentante(pidrepresentante => idrepresentante) = :p237_idfilial
                and idcampanha = :P237_IDCAMPANHA
                and 1 =2
                ```
        }
        layout {
            sequence: 15
            slot: body-3
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Selecione a empresa.
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 1
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column IDCAMPANHA (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 4
            }
            default {
                type: item
                item: P237_IDCAMPANHA
            }
        )

        column IDMETASCAMPANHA (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDMETASCAMPANHA
            }
        )

        column IDMETASCAMPANHA_DISPLAY (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

        column IDREPRESENTANTE (
            reportColumnQueryId: 5
            derivedColumn: N
            type: selectList
            heading {
                heading: Representante
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_romance.fnc_nomerepresentante(pidrepresentante => r.idrepresentante) display_value
                         , r.idrepresentante return_value
                    from representantes r
                    where r.ativo = 'S'
                      and pck_romance.fnc_filialrepresentante(pidrepresentante => r.idrepresentante) = :P237_IDFILIAL
                      and not exists ( select 1
                                       from METASCAMPANHA c
                                       WHERE c.idrepresentante = r.idrepresentante
                                         and c.idcampanha = :P237_IDCAMPANHA)
                    order by 1
                    ```
                displayNullValue: false
            }
            layout {
                sequence: 5
                columnAlignment: end
            }
        )

        column VALORMETAFAVORITA (
            reportColumnQueryId: 7
            derivedColumn: N
            type: textField
            heading {
                heading: Meta Favorita
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990d00
                width: 12
            }
            advanced {
                customAttributes: style="text-align:right"
            }
        )

        column VALORMETAGERAL (
            reportColumnQueryId: 8
            derivedColumn: N
            type: textField
            heading {
                heading: Meta Geral
            }
            layout {
                sequence: 8
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990d00
                width: 12
            }
            advanced {
                customAttributes: style="text-align:right"
            }
        )

        column VALORMETAROMAN (
            reportColumnQueryId: 6
            derivedColumn: N
            type: textField
            heading {
                heading: Meta Romance
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990d00
                width: 12
            }
        )

    )

    pageItem P237_IDCAMPANHA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @metas-da-campanha
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P237_IDFILIAL (
        type: selectList
        label {
            label: Filial
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(idfilial) display_value
                     , idfilial return_value
                from filiais f
                where f.tipofilial = 'D'
                  and f.ativo = 'S'
                order by 1
                ```
            nullDisplayValue: - Selecione a empresa -
        }
        layout {
            sequence: 20
            region: @metas-da-campanha
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button add (
        buttonName: ADD
        label: Adicionar Linha
        layout {
            sequence: 40
            region: @metas-da-campanha
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.widget.tabular.addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button fechar (
        buttonName: Fechar
        label: Fechar
        layout {
            sequence: 10
            region: @metas-da-campanha
            slot: bottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 186
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button multi-row-delete (
        buttonName: MULTI_ROW_DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @metas-da-campanha
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'MULTI_ROW_DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Salvar
        layout {
            sequence: 30
            region: @metas-da-campanha
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction recarrega (
        name: recarrega
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P237_IDFILIAL
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: REDIRECIONA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation idcampanha-must-be-numeric (
        name: IDCAMPANHA must be numeric
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @metas-da-campanha
            type: columnIsNumeric
            column: IDCAMPANHA
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: IDCAMPANHA
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation idcampanha-not-null (
        name: IDCAMPANHA not null
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @metas-da-campanha
            type: columnIsNotNull
            column: IDCAMPANHA
        }
        error {
            errorMessage: #COLUMN_HEADER# must have a value.
            associatedColumn: IDCAMPANHA
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation idrepresentante-must-be-numeric (
        name: IDREPRESENTANTE must be numeric
        execution {
            sequence: 40
        }
        validation {
            editableRegion: @metas-da-campanha
            type: columnIsNumeric
            column: IDREPRESENTANTE
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: IDREPRESENTANTE
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation idrepresentante-not-null (
        name: IDREPRESENTANTE not null
        execution {
            sequence: 40
        }
        validation {
            editableRegion: @metas-da-campanha
            type: columnIsNotNull
            column: IDREPRESENTANTE
        }
        error {
            errorMessage: #COLUMN_HEADER# must have a value.
            associatedColumn: IDREPRESENTANTE
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation valormetafavorita-must-be-numeric (
        name: VALORMETAFAVORITA must be numeric
        execution {
            sequence: 60
        }
        validation {
            editableRegion: @metas-da-campanha
            type: columnIsNumeric
            column: VALORMETAFAVORITA
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: VALORMETAFAVORITA
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation valormetageral-must-be-numeric (
        name: VALORMETAGERAL must be numeric
        execution {
            sequence: 70
        }
        validation {
            editableRegion: @metas-da-campanha
            type: columnIsNumeric
            column: VALORMETAGERAL
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: VALORMETAGERAL
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation valormetaroman-must-be-numeric (
        name: VALORMETAROMAN must be numeric
        execution {
            sequence: 50
        }
        validation {
            editableRegion: @metas-da-campanha
            type: columnIsNumeric
            column: VALORMETAROMAN
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: VALORMETAROMAN
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @metas-da-campanha
        target {
            tableName: METASCAMPANHA
            pkColumn: IDMETASCAMPANHA
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: #MRD_COUNT# metas deletadas.
        }
        advanced {
            executionMappingIdentifier: 334592123731185235
        }
        serverSideCondition {
            type: request=Value
            value: MULTI_ROW_DELETE
            executeCondition: once
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @metas-da-campanha
        target {
            tableName: METASCAMPANHA
            pkColumn: IDMETASCAMPANHA
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# metas atualizadas, #MRI_COUNT# metas incluídas.
        }
        advanced {
            executionMappingIdentifier: 334591927768185234
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 237
                items: {
                    P237_IDFILIAL: &P237_IDFILIAL.
                    P237_IDCAMPANHA: &P237_IDCAMPANHA.
                }
            }
        }
    )

)

