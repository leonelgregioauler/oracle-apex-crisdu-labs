page 33 (
    name: Imprimir Depositos por NF
    title: Imprimir Depositos por NF
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region imprimir-depositos-por-nf (
        name: Imprimir Depositos por NF
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
    )

    pageItem P33_DATAFINAL (
        type: datePickerJquery
        label {
            label: até
            alignment: left
        }
        layout {
            sequence: 50
            region: @imprimir-depositos-por-nf
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/YYYY
            width: 10
        }
        validation {
            maxLength: 10
        }
        source {
            type: databaseColumn
            databaseColumn: DATAFINAL
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                return to_date('31/12/'||to_char(sysdate,'rrrr'),'DD/MM/RRRR');
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P33_DATAINICIAL (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 40
            region: @imprimir-depositos-por-nf
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/YYYY
            width: 10
        }
        validation {
            maxLength: 10
        }
        source {
            type: databaseColumn
            databaseColumn: DATAINICIAL
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                return to_date('01/01/'||to_char(sysdate,'rrrr'),'DD/MM/RRRR');
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P33_IDFORNECEDOR (
        type: selectList
        label {
            label: Fornecedor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(pe.apelido) display_value
                     , fe.idfornecedor return_value
                from fornecedores fe
                    , pessoas     pe
                where fe.idpessoa = pe.idpessoa
                order by 1
                ```
            nullDisplayValue: " "
        }
        layout {
            sequence: 5
            region: @imprimir-depositos-por-nf
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFORNECEDOR
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P33_IDNOTAFISCAL (
        type: selectList
        label {
            label: Nota Fiscal
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select documento display_value
                     , idnotafiscal return_value
                from notasfiscais n
                where idfornemitente = :P33_IDFORNECEDOR
                ```
        }
        cascadingLov {
            parentItems: P33_IDFORNECEDOR
        }
        layout {
            sequence: 8
            region: @imprimir-depositos-por-nf
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDNOTAFISCAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P33_SEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct to_char(s.semana,'00')||' ( '||to_char(s.dt_ini,'dd/mm/yyyy')||' - '||to_char(s.dt_fim,'dd/mm/yyyy')||' )' display_value
                     , to_number(to_char(nf.dtnf,'IW')) return_value
                from semana_dias  s
                   , notasfiscais nf
                where s.semana = to_number(to_char(nf.dtnf,'IW'))
                  and s.ano = TO_NUMBER(to_char(SYSDATE,'YYYY')) 
                order by 1
                ```
            nullDisplayValue: " "
        }
        layout {
            sequence: 10
            region: @imprimir-depositos-por-nf
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: SEMANA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P33_SITUACAO (
        type: hidden
        layout {
            sequence: 60
            region: @imprimir-depositos-por-nf
