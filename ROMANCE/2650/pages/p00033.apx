    process fetch-row-from-impressao-saldo-notas (
        name: Fetch Row from IMPRESSAO_SALDO_NOTAS
        type: autoRowFetch
        source {
            tableName: IMPRESSAO_SALDO_NOTAS
            pkColumn: USUARIO
            pkItem: P33_USUARIO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Unable to fetch row.
        }
        advanced {
            executionMappingIdentifier: 181193547919861719
        }
        serverSideCondition {
            type: never
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                     return dbms_standard.login_user;
                  end; 
                begin 
                  :P33_USUARIO := get_pk; 
                end;
                ```
        }
        execution {
            sequence: 50
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 181195651547928592
        }
    )

