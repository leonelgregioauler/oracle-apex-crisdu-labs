    region últimos-depósitos (
        name: Últimos Depósitos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante)||' [ '||pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(idrepresentante))||' ]' 
                     ||'<br>'|| ( select initcap(cb.beneficiario)||'<br>( '||b.nomebanco||' - '||cb.agencia ||', '||cb.conta||' )' detalhe
                         from contasbancarias cb
                            , bancos b
                         where cb.idbanco         = b.idbanco
                           and cb.idcontabanc = d.idcontabanc ) "Conta Bancária"
                     , trim(to_char(valordeposito,'999G999G999G999G990D00'))
                                     ||'<BR>' ||d.nrocomprovante
                                     ||'<BR>'|| decode(comprovado,'S','Sem Comprovante'
                                                                 ,'C','Cópia'
                                                                 ,'M','Em Mãos'
                                                                 ,'G', 'Com Gerente')   DETALHE2
                     , ( select t.descricao
                         from tipospagamentos t
                         where t.codigo = d.tipo) Tipo
                     , usuario
                     , datacriacao
                from DEPOSITOSDIARIOS_ORIG d
                where d.datacriacao >= sysdate -0.05
                  and d.idcontabanc = :P197_IDCONTABANCARIA
                order by d.datacriacao desc
                ```
        }
        layout {
            sequence: 50
            slot: contentBody
        }
