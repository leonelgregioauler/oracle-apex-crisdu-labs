            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_financeiro_rmc.prc_enviasms_deposito( pusuario         => v('APP_USER')
                                                          , pidpgtoforn      => null
                                                          , pidcontabancaria => :P197_IDCONTABANCARIA);
                end;
                
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: SMS enviado com sucesso!
        }
        error {
            errorMessage: Erro ao enviar SMS!
        }
        advanced {
            executionMappingIdentifier: 2634457780303189546
        }
        serverSideCondition {
            type: request=Value
            value: ENVIARSMS
        }
    )

    process processa-saldos-das-faturas (
        name: Processa saldos das Faturas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vv number := 0;
                begin
                  --
                  for v in ( select p.idpgtoforn
                             from pagamentosfornecedores p
                             where p.tipopagamento = 'D'
                               and p.idcontabanc  = :P197_IDCONTABANCARIA
                               and p.idfornecedor = :P197_IDFORNECEDOR
                               and extract( year from p.dtvencimento ) >= 2019
                               and exists ( select 1
                                            from depositosdiarios d
                                            where d.idpgtoforn = p.idpgtoforn 
                                              and d.contabilizou is null )
                             order by 1 desc )
                  loop
                    --
                    vv := vv+1;
                    --
                    pck_financeiro_rmc.prc_atualiza_parcelas( v.idpgtoforn , null );
                    --
                    pck_financeiro_rmc.prc_atualiza_pagtoforn ( v.idpgtoforn );
                    --
                    pck_financeiro_rmc.prc_deleta_saldo_sem_pai;
                    --
                  end loop;
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 1507508110974266514
        }
    )

