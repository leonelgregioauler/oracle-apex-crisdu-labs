    region contas-para-depositar (
        name: Contas para Depositar
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefornecedor(e.idfornecedor)||' ['||e.idfornecedor||']' fornecedor
                    , e.idcontabanc || ' - <b>'||b.nomebanco||'<br> </b>' || c.agencia ||'/'||c.conta ||' <br> '||c.beneficiario    conta
                    , min(e.dtvencimento) primeirovencimento
                    , sum(e.valorpago  - e.valorpagar) saldo
                    , e.idcontabanc
                    , e.idfornecedor
                    , round( ( sum(nvl(c.prioridade ,0)
                              +  case 
                                       when e.dtvencimento < sysdate then
                                          round(trunc(sysdate) - trunc(e.dtvencimento)) 
                                       else
                                         0 
                                       end )) /2
                              +    case 
                                  when sum(nvl(e.prioridade,0)) > 0 then
                                    100
                                  else
                                    0
                                    end  )  prioridade
                    , 'N' identificado
                    , 'Não' descidentificado
                    , count( ( select 1
                                from razoessociaisfornec r
                                   , notasfiscais        n
                                where r.idrazaosocialforn = n.idrazaosocialfornemit
                                  and n.idnotafiscal      = e.idnotafiscal ) ) q
                    , listagg(e.idnotafiscal) within group (order by 1) notas
                    --
                from pagamentosfornecedores  e
                   , contasbancarias         c
                   , bancos                  b
                where c.idbanco         = b.idbanco 
                  and c.idcontabanc     = e.idcontabanc
                  and e.valorpagar     > e.valorpago
                  and e.dtvencimento   <= :P188_DATABASEDEPOSITOS
                  and extract(year from e.dtvencimento ) >= 2019
                  and e.idcontabanc     = :P197_IDCONTABANCARIA
                  and e.idfornecedor    = :P197_IDFORNECEDOR
                  and e.identificado    = :P197_IDENTIFICADO 
                  and :P197_IDENTIFICADO  = 'N'
                  and exists ( select 1
                               from usuariosformaspagamentos a
                               where a.idformapagamento = e.tipopagamento 
                                 and a.idusuario        = :P0_IDUSUARIO)
                having sum(e.valorpago  - e.valorpagar) != 0
                group by e.idfornecedor
                       , e.idcontabanc
                       , b.nomebanco
                       , c.agencia
                       , c.conta
                       , c.beneficiario
                union
                select pck_romance.fnc_nomefornecedor(e.idfornecedor)||' ['||e.idfornecedor||']' fornecedor
                    , e.idcontabanc || ' - <b>'||b.nomebanco||'<br> </b>' || c.agencia ||'/'||c.conta ||' <br> '||c.beneficiario   conta
                    , min(e.dtvencimento) primeirovencimento
                    , sum(e.valorpago  - e.valorpagar) saldo
                    , e.idcontabanc
                    , e.idfornecedor
                    , round( ( sum(nvl(c.prioridade ,0)
                              +  case 
                                       when e.dtvencimento < sysdate then
                                          round(trunc(sysdate) - trunc(e.dtvencimento)) 
                                       else
                                         0 
                                       end ) /2)
                              +    case 
                                  when sum(nvl(e.prioridade,0)) > 0 then
                                    100
                                  else
                                    0
                                    end  )  prioridade
                    , e.identificado
                    , decode(e.identificado,'S','Sim', 'N', 'Não') descidentificado
                    , count( ( select 1
                                from razoessociaisfornec r
                                   , notasfiscais        n
                                where r.idrazaosocialforn = n.idrazaosocialfornemit
                                  and n.idnotafiscal      = e.idnotafiscal ) ) q
                    , listagg(e.idnotafiscal) within group (order by 1) notas
                    --
                from pagamentosfornecedores  e
                   , contasbancarias         c
                   , bancos                  b
                where c.idbanco         = b.idbanco 
                  and c.idcontabanc     = e.idcontabanc
                  and e.valorpagar     > e.valorpago
                  and e.dtvencimento   <= :P188_DATABASEDEPOSITOS
                  and extract(year from e.dtvencimento ) >= 2019
                  and e.idcontabanc     = :P197_IDCONTABANCARIA
                  and e.idfornecedor    = :P197_IDFORNECEDOR
                  and e.identificado    = :P197_IDENTIFICADO
                  and exists ( select 1
                               from usuariosformaspagamentos a
                               where a.idformapagamento = e.tipopagamento 
                                 and a.idusuario        = :P0_IDUSUARIO)
                  and e.identificado   = 'S'
                  -- teste para ser CRISDU
                  and case
                                  when ( select r.cnpj
                                         from razoessociaisfornec r
                                            , notasfiscais        n
                                         where r.idrazaosocialforn = n.idrazaosocialfornemit
                                           and n.idnotafiscal      = e.idnotafiscal ) like '07318638%' then
                                         'Sim'
                                  when ( select r.cnpj
                                         from razoessociaisfornec r
                                            , notasfiscais        n
                                         where r.idrazaosocialforn = n.idrazaosocialforndest 
                                           and n.idnotafiscal      = e.idnotafiscal ) like '07318638%' then
                                         'Sim'
                                  when ( select cnpj
                                         from razoessociaisfiliais re
                                            , notasfiscais        n
                                         where re.idrazaosocialfilial = n.idrazaosocialfilemit 
                                           and n.idnotafiscal      = e.idnotafiscal ) like '07318638%' then
                                         'Sim'
                                  when ( select  cnpj
                                         from razoessociaisfiliais re
                                            , notasfiscais        n
                                         where re.idrazaosocialfilial = n.idrazaosocialfildestino 
                                           and n.idnotafiscal      = e.idnotafiscal ) like '07318638%' then
                                         'Sim'
                                  else 
                                    'Não'
                                 end = 'Sim'
                having sum(e.valorpago  - e.valorpagar) != 0
                group by e.idfornecedor
                       , e.idcontabanc
                       , b.nomebanco
                       , c.agencia
                       , c.conta
                       , c.beneficiario
                       , e.identificado 
                
                ```
        }
