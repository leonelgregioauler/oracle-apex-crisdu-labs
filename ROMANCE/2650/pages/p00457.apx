page 457 (
    name: Obs Aprovação CPF CREDRMC
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 32%
        height: 35%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function Titulo(){
            var type; 
            type = apex.item( "P457_TITULO" ).getValue();
            
            if (type == 'REPROVAR'){
            apex.util.getTopApex().jQuery(".ui-dialog-content").dialog("option", "title", "Reprovar Cadastro")
            }else if  (type == 'APROVAR' ){
            apex.util.getTopApex().jQuery(".ui-dialog-content").dialog("option", "title", "Aprovar Cadastro")
            } 
            }
            ```
        executeWhenPageLoads: Titulo()
    }
    security {
        pageAccessProtection: unrestricted
    }

    region observação (
        name: Observação
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent3
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P457_APROVA_REPROVA (
        type: hidden
        layout {
            sequence: 40
            region: @observação
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P457_CPF (
        type: hidden
        layout {
            sequence: 30
            region: @observação
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P457_IDPESSOA (
        type: hidden
        layout {
            sequence: 20
            region: @observação
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P457_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        layout {
            sequence: 10
            region: @observação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            height: 5
        }
        validation {
            maxLength: 100
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P457_TITULO (
        type: hidden
        layout {
            sequence: 50
            region: @observação
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button cancelar (
        buttonName: CANCELAR
        label: Cancelar
        layout {
            sequence: 10
            region: @observação
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button confirmar (
        buttonName: CONFIRMAR
        label: Confirmar
        layout {
            sequence: 20
            region: @observação
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction voltar (
        name: voltar
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @cancelar
        }

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process inserir-historico (
        name: Inserir Historico
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidhistoricosaprovacoes historicosaprovacoes.idhistoricosaprovacoes%type;
                  vidpessoa               historicosaprovacoes.idpessoa%type;
                  vdocumento              historicosaprovacoes.documento%type;
                  vdatahistorico          historicosaprovacoes.datahistorico%type;
                  vsituacao               historicosaprovacoes.situacao%type;
                  vobservacao             historicosaprovacoes.observacao%type;
                  vcpf                    historicosaprovacoes.cpf%type;
                  vmd5                    varchar2(1000);
                  voperacao_dml           varchar2(1) := 'I';
                  --
                begin
                  --
                  if :P457_OBSERVACAO is null then
                    --
                    raise_application_error(-20000,'Informe uma observação');
                    --
                  end if;
                  --
                  vsituacao      := :P457_APROVA_REPROVA;
                  vidpessoa      := :P457_idpessoa;
                  vdocumento     := null;
                  vdatahistorico := sysdate;
                  vobservacao    := :P457_OBSERVACAO;
                  vcpf           := :P457_CPF;
                  --
                  pck_cadastros_rmc.prc_historicosaprovacoes ( pidhistoricosaprovacoes => vidhistoricosaprovacoes
                                                             , pidpessoa               => vidpessoa
                                                             , pdocumento              => vdocumento
                                                             , pdatahistorico          => vdatahistorico
                                                             , psituacao               => vsituacao
                                                             , pobservacao             => vobservacao
                                                             , pcpf                    => vcpf
                                                             , pmd5                    => vmd5
                                                             , poperacao_dml           => 'I' );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1506442613808586101
        }
        serverSideCondition {
            whenButtonPressed: @confirmar
        }
    )

    branch (
        name: Go To Page 453
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 453
                items: {
                    P453_CPF: &P457_CPF.
                }
                clearCache: 457
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @confirmar
        }
    )

)

