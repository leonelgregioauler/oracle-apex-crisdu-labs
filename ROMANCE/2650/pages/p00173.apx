page 173 (
    name: Pagamento Clientes
    title: Pagamento Clientes
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='Deseja realmente excluir este lançamento?';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region lista-de-pagamentos-feitos (
        name: Lista de Pagamentos Feitos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select razaosocial 
                        ||', '|| endereco
                        ||', '|| bairro
                        ||' - '||cep
                        ||' - '||( select nomecidade||' - '||sigla from cidades c, estados e where c.idestado = e.idestado and c.idcidade = m.idcidade) 
                        ||' ['|| m.cnpj||'] '
                        from mei m
                        where m.idmei = p.idmei ) "MEI"
                     , datapagamento "Data Pagamento"
                     , valorpago     "Valor Pago"
                     , idpagamentomei
                     , NUMERONOTA
                from pagamentosmei p
                where usuario = v('APP_USER')
                and idmei = :P173_IDMEI
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 173
                items: {
                    P173_IDPAGAMENTOMEI: #IDPAGAMENTOMEI#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt="" />
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Dados não encontrados.
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column "Data Pagamento" (
            type: plainText
            heading {
                heading: Data Pagamento
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
            appearance {
                formatMask: dd/mm/rrrr hh24:mi:ss
            }
            source {
                dataType: date
            }
            advanced {
                htmlDomId: Data_Pagamento
                endUserAlias: B
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDPAGAMENTOMEI (
            type: plainText
            heading {
                heading: Idpagamentomei
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDPAGAMENTOMEI
                endUserAlias: D
            }
            enableUsersTo {
                pivot: false
            }
        )

        column MEI (
            type: plainText
            heading {
                heading: Mei
                alignment: center
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: MEI
                endUserAlias: A
            }
            enableUsersTo {
                pivot: false
            }
        )

        column NUMERONOTA (
            type: plainText
            heading {
                heading: Nr Nota
                alignment: center
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: NUMERONOTA
                endUserAlias: E
            }
            enableUsersTo {
                pivot: false
            }
        )

        column "Valor Pago" (
            type: plainText
            heading {
                heading: Valor Pago
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: Valor_Pago
                endUserAlias: C
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 1304174 (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn "Data Pagamento" (
                sequence: 2
            )

            displayColumn MEI (
                sequence: 1
            )

            displayColumn NUMERONOTA (
                sequence: 4
            )

            displayColumn "Valor Pago" (
                sequence: 3
            )

        )

    )

    region pagamento-clientes (
        name: Pagamento Clientes
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P173_DATAPAGAMENTO (
        type: hidden
        layout {
            sequence: 40
            region: @pagamento-clientes
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: DATAPAGAMENTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P173_IDMEI (
        type: selectList
        label {
            label: Cliente
            alignment: right
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select razaosocial 
                ||', '|| endereco
                ||', '|| bairro
                ||' - '||cep
                ||' - '||( select nomecidade||' - '||sigla from cidades c, estados e where c.idestado = e.idestado and c.idcidade = m.idcidade) 
                ||' ['|| m.cnpj||'] ' display_value
                , m.idmei return_value
                from mei m
                where m.idmei = :P173_IDMEI
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @pagamento-clientes
            slot: regionBody
            alignment: left
            columnSpan: 6
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDMEI
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P173_IDPAGAMENTOMEI (
        type: hidden
        layout {
            sequence: 10
            region: @pagamento-clientes
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDPAGAMENTOMEI
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P173_NUMERONOTA (
        type: textField
        label {
            label: Nr Nota
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 60
            region: @pagamento-clientes
            slot: regionBody
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 20
        }
        validation {
            maxLength: 4000
        }
        source {
            type: databaseColumn
            databaseColumn: NUMERONOTA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P173_USUARIO (
        type: hidden
        layout {
            sequence: 50
            region: @pagamento-clientes
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: USUARIO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  return v('APP_USER');
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P173_VALORPAGO (
        type: numberField
        label {
            label: Valor Pago
            alignment: right
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 30
            region: @pagamento-clientes
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G990D00
            width: 15
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: VALORPAGO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @pagamento-clientes
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 172
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Efetuar Pagamento
        layout {
            sequence: 40
            region: @pagamento-clientes
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P173_IDPAGAMENTOMEI
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @pagamento-clientes
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P173_IDPAGAMENTOMEI
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Alterações
        layout {
            sequence: 30
            region: @pagamento-clientes
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: never
        }
    )

    validation p173-valorpago (
        name: P173_VALORPAGO
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P173_VALORPAGO
        }
        error {
            errorMessage: Informe o valor que será lançado!
            associatedItem: @P173_VALORPAGO
        }
    )

    validation p173-valorpago-saldo (
        name: P173_VALORPAGO saldo
        execution {
            sequence: 20
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where 50000 - nvl(( select sum(pp.valorpago) 
                                    from pagamentosmei pp 
                                    where pp.idmei = :P173_IDMEI
                                      and to_char(pp.datapagamento,'RRRR') = to_char(sysdate,'RRRR') ),0) >= to_number(:P173_VALORPAGO)
                ```
        }
        error {
            errorMessage: Saldo não disponível para este pagamento!
            associatedItem: @P173_VALORPAGO
        }
    )

    process fetch-row-from-pagamentosmei (
        name: Fetch Row from PAGAMENTOSMEI
        type: autoRowFetch
        source {
            tableName: PAGAMENTOSMEI
            pkColumn: IDPAGAMENTOMEI
            pkItem: P173_IDPAGAMENTOMEI
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 304249415070401873
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P173_IDPAGAMENTOMEI is null then
                        select "SEQ_IDPAGAMENTOMEI".nextval
                          into :P173_IDPAGAMENTOMEI
                          from dual;
                    end if;
                  :P173_DATAPAGAMENTO := sysdate;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 304249614866401876
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-pagamentosmei (
        name: Process Row of PAGAMENTOSMEI
        type: autoRowProcessing
        target {
            tableName: PAGAMENTOSMEI
            pkColumn: IDPAGAMENTOMEI
            pkItem: P173_IDPAGAMENTOMEI
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        advanced {
            executionMappingIdentifier: 304249810156401876
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 173
                items: {
                    P173_IDMEI: &P173_IDMEI.
                    P173_IDPAGAMENTOMEI:
                }
            }
        }
    )

)

