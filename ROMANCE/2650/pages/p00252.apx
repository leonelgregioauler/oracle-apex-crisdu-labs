    pageItem P252_IDFILIALEMITENTE (
        type: selectList
        label {
            label: Filial Emitente
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome display_value
                     , idfilial return_value
                from vw_filiais w 
                where w.ativo = 'S'
                order by nome
                ```
        }
        layout {
            sequence: 50
            region: @filtro-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
