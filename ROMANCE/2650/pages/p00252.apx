            displayColumn IDENTIFICACAODESTINO (
                sequence: 27
            )

            displayColumn IDNOTAFISCAL (
                sequence: 1
            )

            displayColumn IDSEMANANOTA (
                sequence: 20
            )

            displayColumn MES (
                sequence: 24
            )

            displayColumn NRNF (
                sequence: 4
            )

            displayColumn "Observação" (
                sequence: 16
            )

            displayColumn "Possui divergência" (
                sequence: 22
            )

            displayColumn "Qtd Anexos" (
                sequence: 21
            )

            displayColumn SEMANA (
                sequence: 2
            )

            displayColumn SITUACAO (
                sequence: 11
            )

            displayColumn "Situação Recebimento" (
                sequence: 12
            )

            displayColumn TOTALITENS (
                sequence: 18
            )

            displayColumn TOTALVENCIMENTOS (
                sequence: 17
            )

            displayColumn "Tipo NF" (
                sequence: 5
            )

            displayColumn "Transportadora" (
                sequence: 8
            )

            displayColumn "Usuário" (
                sequence: 14
            )

            displayColumn VALORTOTALFILIAL (
                sequence: 10
            )

            displayColumn VOLUMES (
                sequence: 23
            )

            aggregate (
                column: VALORTOTALFILIAL
            )

            aggregate (
                column: VALORTOTAL
            )

            filter ir-condition (
                column: ANO
                value: 2012
            )

            filter ir-condition-2 (
                column: SITUACAO
                value: Ativa
            )

            controlBreak (
                column: "Filial Destino"
                layout {
                    sequence: 6
                }
            )

        )

    )

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 20
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--accent5
                t-Region--scrollBody
                t-Form--slimPadding
            ]
            renderComponents: belowContent
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region filtro-2 (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--accent5
                t-Region--scrollBody
                t-Form--slimPadding
            ]
            renderComponents: belowContent
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P252_ANO (
        type: selectList
        label {
            label: Ano
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct to_char(dtvencimento, 'RRRR') display_value
                     , to_char(f.dtvencimento, 'RRRR')  return_value
                from pagamentosfornecedores f
                --where  to_number(to_char(dtvencimento, 'RRRR')) >=2014
                order by 1 desc
                ```
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @filtro-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  return to_char(sysdate, 'RRRR');
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P252_DATAFIM (
        type: datePickerJquery
