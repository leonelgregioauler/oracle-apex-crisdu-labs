    }
    help {
        helpText: No help is available for this page.
    }

    region compras (
        name: Compras
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select *
                from VWFA_APP2650_P252_REL001
                /*where IDFILIALDESTINO in ( select idfilial
                                              from filiais f
                                              where f.tipofilial in ( select idtipofilial
                                                                      from acessostiposfiliais
                                                                      where usuario = v('APP_USER')) )*/
                ```
            pageItemsToSubmit: [
                P252_TIPOFILIALDESTINO
                P252_IDFORNECEDOR
                P252_TIPOPRODUTO
                P252_DOCUMENTO
                P252_ANO
                P252_SEMANA
