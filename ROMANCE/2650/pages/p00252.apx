    pageItem P252_SEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(semana,'00')||'/'||ano display_value
                     , idsemana return_value
                from semana_dias s
                where s.dt_fim < trunc(sysdate)
                  and ( :P252_ANO is null or ano = :P252_ANO)
                order by idsemana desc
                ```
            nullDisplayValue: - Todos -
        }
        cascadingLov {
            parentItems: P252_ANO
        }
        layout {
            sequence: 80
            region: @filtro-2
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

