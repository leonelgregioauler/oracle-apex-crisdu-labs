    button create (
        buttonName: CREATE
        label: Nova Compra
        layout {
            sequence: 30
            region: @compras
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 27
                clearCache: 27
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button entradas-virtualage (
        buttonName: ENTRADAS_VIRTUALAGE
        label: Entradas Virtual Age
        layout {
            sequence: 50
            region: @compras
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 427
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: pck_util.fnc_verificaacesso(2744,v('APP_USER')) = 'S'
        }
    )

    button filtrar (
        buttonName: Filtrar
        label: Filtrar
        layout {
            sequence: 30
            region: @filtro-2
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button lancamento-diverso (
        buttonName: LANCAMENTO_DIVERSO
        label: Lançamentos Diversos
        layout {
            sequence: 40
            region: @compras
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 374
                items: {
                    P374_DOCUMENTO:
                    P374_FORMAPAGAMENTO:
                    P374_IDFORNECEDOR:
                    P374_INICIAR: N
                    P374_VENCIMENTO:
                    P374_IDNOTAFISCAL:
                    P374_IDFILIALDESTINO:
                    P374_IDRAZAOSOCIALDESTINO:
                    P374_IDRAZAOSOCIALFORN:
                    P374_IDLANCAMENTODIVERSO:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: pck_util.fnc_verificaacesso(2743,v('APP_USER')) = 'S'
        }
    )

    button lucratividadegeral (
        buttonName: LUCRATIVIDADEGERAL
        label: Ir p/ Lucrat. Geral
        layout {
            sequence: 20
            region: @filtro-2
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 193
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util.fnc_verificaacesso(2665,v('APP_USER')) = 'S'
                ```
        }
    )

    dynamicAction mostra-datas (
        name: Mostra Datas
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P252_FILTRAR_DATA
        }
        clientSideCondition {
            type: item=value
            item: P252_FILTRAR_DATA
            value: I
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P252_DATAINICIO
                    P252_DATAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P252_DATAINICIO
                    P252_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @compras
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

