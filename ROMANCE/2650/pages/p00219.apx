    region categorias-mais-vendidos (
        name: Categorias mais Vendidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- Maicon Aimi - 8271602 - 23/01/2023(OLD)
                /*
                select t.categoria "Categoria"
                     , t.distribuido "Distribuido"
                     , t.vendido "Vendido"
                     , round( (t.vendido / t.distribuido) * 100, 2 ) "Perc Venda"
                     , t.empresa "Empresa"
                     , t.na_rua "Na Rua"
                     , t.valor 
                from ( 
                      select ( select pck_romance.fnc_nomecategoria(p.idcategoria)
                               from produtos p
                               where p.idproduto       =  mv.idproduto ) categoria
                           , sum(mv.distribuido) distribuido
                           , sum(NVL(mv.vendido,0)) vendido
                           , ( select listagg(pck_romance.fnc_nomefornecedor(fp.idfornecedor)) within group (order by 1)
                               from fornecedoresprodutos fp
                                  , estoquefilial e
                               where fp.idproduto       = e.idproduto 
                                 and e.idestoquefilial  = mv.idestoquefil 
                               group by fp.idproduto ) fornecedores
                           , pck_romance.fnc_nomefilial(mv.idfilial) empresa
                           , ( select sum(it.quantidade)
                               from itensnotavenda it
                               where it.idestoquefil = mv.idestoquefil
                                 and exists ( select 1
                                              from notasvendas nv
                                              where nv.idsituacaonotavenda = 3
                                                and nv.idnotavenda = it.idnotavenda
                                                and nv.idfilial    = mv.idfilial ) ) na_rua
                           , sum(mv.valor) valor
                      from vw_percentualvenda_mv mv
                      where ( :P219_IDFILIAL is null or mv.idfilial = :P219_IDFILIAL)
                        and exists ( select 1
                                     from usuariosfiliais u
                                     where u.idfilial = mv.idfilial
                                       and u.usuario  = v('APP_USER') ) 
                        and ( :P219_IDGRUPO is null or exists ( select 1
                                                                from filiais f
                                                                where f.idfilial = mv.idfilial
                                                                  and f.idgrupo  = :P219_IDGRUPO ))
                        and ( ( :P219_FILTRAR = 'S' and mv.idsemanacobranca = :P219_SEMANA )
                           or ( :P219_FILTRAR = 'P' and  mv.idsemanacobranca between :P219_SEMANAINI and :P219_SEMANAFIM  ))  
                        and (:P219_IDPRODUTO is null or ( exists ( select 1 
                                                                   from estoquefilial i
                                                                   where i.idestoquefilial = mv.idestoquefil 
                                                                     and i.idproduto = :P219_IDPRODUTO)))
                        and ( :P219_IDFORNECEDOR is null or exists ( select 1
                                                                     from fornecedoresprodutos f
                                                                        , estoquefilial        e
                                                                     where f.idfornecedor = :P219_IDFORNECEDOR 
                                                                       and f.idproduto    = e.idproduto
                                                                       and e.idestoquefilial = mv.idestoquefil ) )
                        and :P219_TIPO = 'C'
                        and ( :P219_IDCATEGORIA = -1 or exists ( select 1
                                                                 from produtos p
                                                                 where p.idproduto =  mv.idproduto
                                                                   and p.idcategoria = :P219_IDCATEGORIA ) )
                        and ( :P219_IDFILIAL is not null 
                            or :P219_SEMANA is not null 
                            or :P219_SEMANAINI is not null 
                            or :P219_IDFORNECEDOR is not null )
                      group by mv.idestoquefil , mv.idfilial, mv.idproduto ) t
                */
                
                
                -- Maicon Aimi - 8271602 - 23/01/2023 Melhoria na query(NEW)
                select pck_romance.fnc_nomecategoria(p.idcategoria)  "Categoria",
                       sum(i.quantidade) "Distribuido",
                       sum(NVL(i.quantidade,0) - NVL(i.qtddevolvida,0)) "Vendido",
                       round(((sum(NVL(i.quantidade,0) - NVL(i.qtddevolvida,0)) * 100 ) /  sum(i.quantidade) ),2) "Perc Venda",
                       pck_romance.fnc_nomefilial(n.idfilial) "Empresa",
                       sum(nvl(( select sum(it.quantidade) "na_rua"
                                from itensnotavenda it
                               where it.iditemnotavenda = i.iditemnotavenda
                                 and exists ( select 1
                                                from notasvendas nv
                                               where nv.idsituacaonotavenda = 3
                                                 and nv.idnotavenda = it.idnotavenda)),0)) "na_rua",
                       sum((NVL(i.quantidade,0) - NVL(i.qtddevolvida,0))*i.valorvenda) "valor"
                     , roman.pck_romance.fnc_nomecaracteristica(p.idcaracteristicacateg) Caracteristica
                     , (select INITCAP(c.nome) from caracteristicascategorias c where c.idcaracteristicacateg = p.idcaracteristicadetalhe) Modelo
                     , (select INITCAP(c.nome) from caracteristicascategorias c where c.idcaracteristicacateg = p.idcaracteristicacategmat) Material
                     , (select INITCAP(c.nome) from caracteristicascategorias c where c.idcaracteristicacateg = p.idcaracteristicasubcat) Genero
                  from roman.notasvendas n,
                       roman.itensnotavenda i,
                       roman.produtos p
                 where i.idnotavenda = n.idnotavenda
                   and p.idproduto = i.idproduto
                   and (:P219_IDFILIAL is null or n.idfilial = :P219_IDFILIAL)
                   and exists ( select 1
                                  from usuariosfiliais u
                                 where u.idfilial = n.idfilial
                                   and u.usuario  = v('APP_USER') )
                   and ( :P219_IDGRUPO is null or exists ( select 1
                                                             from filiais f
                                                            where f.idfilial = n.idfilial
                                                              and f.idgrupo  = :P219_IDGRUPO ))
                   and ( ( :P219_FILTRAR = 'S' and n.idsemanacobranca = :P219_SEMANA )
                       or ( :P219_FILTRAR = 'P' and  n.idsemanacobranca between :P219_SEMANAINI and :P219_SEMANAFIM  ))
                   and (:P219_IDPRODUTO is null or ( exists ( select 1 
                                                                from estoquefilial i
                                                               where i.idestoquefilial = i.idestoquefil 
                                                                 and i.idproduto = :P219_IDPRODUTO)))
                   and ( :P219_IDFORNECEDOR is null or exists ( select 1
                                                                  from fornecedoresprodutos f
                                                                     , estoquefilial        e
                                                                 where f.idfornecedor = :P219_IDFORNECEDOR 
                                                                   and f.idproduto    = e.idproduto
                                                                   and e.idestoquefilial = i.idestoquefil ) )
                   and :P219_TIPO = 'C'
                   /*and ( :P219_IDCATEGORIA is null or exists ( select 1
                                                              from produtos p
                                                             where p.idproduto =  i.idproduto
                                                               and p.idcategoria = :P219_IDCATEGORIA ) )*/
                   and ( :P219_IDFILIAL is not null 
                        or :P219_SEMANA is not null 
                        or :P219_SEMANAINI is not null 
                        or :P219_IDFORNECEDOR is not null )
                     --
                   and (:P219_IDCATEGORIA is null or p.idcategoria = :P219_IDCATEGORIA)
                   and (:P219_MODELO is null or p.idcaracteristicadetalhe = :P219_MODELO)
                   and (:P219_CARACTERISTICA is null or p.idcaracteristicacateg = :P219_CARACTERISTICA)
                   and (:P219_MATERIAL is null or p.idcaracteristicacategmat = :P219_MATERIAL)
                   and (:P219_GENERO is null or p.idcaracteristicasubcat = :P219_GENERO)
                 group by p.idcategoria,
                          n.idfilial,
                          p.idcaracteristicasubcat,
                          p.idcaracteristicacategmat,
                          p.idcaracteristicadetalhe,
                          idcaracteristicacateg;
                          
                
                
                
                ```
        }
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: item=value
            item: P219_TIPO
            value: C
        }
        componentAppearance {
