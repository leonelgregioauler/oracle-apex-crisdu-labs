    pageItem P219_SEMANA (
        type: selectOne
        label {
            label: Semana
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select semana display_value
                     , idsemana RETURN_VALUE
                from ( select distinct semana, idsemana
                       from fechamentossemanais
                       order by idsemana desc )
                where rownum < 30
                ```
        }
        layout {
            sequence: 130
            region: @filtro
            slot: regionBody
