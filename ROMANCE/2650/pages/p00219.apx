    pageItem P219_IDPRODUTO (
        type: popupLov
        label {
            label: Produto
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct initcap(p.nomeproduto) display_value
                    , p.idproduto 
                from produtos p
                   , fornecedoresprodutos f
                where p.idproduto = f.idproduto
                  and (:P219_IDFORNECEDOR  is null or f.idfornecedor = :P219_IDFORNECEDOR )
                order by 1
                ```
            nullDisplayValue: - Todos -
        }
        cascadingLov {
            parentItems: P219_IDFORNECEDOR
        }
        layout {
            sequence: 60
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
