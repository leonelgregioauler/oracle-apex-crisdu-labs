    pageItem P219_IDCATEGORIA (
        type: selectOne
        label {
            label: Categoria
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nome
                     , c.idcategoria
                from categorias c
                where c.idcategoria not in (140,141)
                  and c.ativo = 'S'
                order by 1
                ```
        }
        layout {
