    dynamicAction empresa-ou-grupo (
        name: Empresa ou Grupo
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P219_FILIALGRUPO
        }
        clientSideCondition {
            type: item=value
            item: P219_FILIALGRUPO
            value: E
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P219_IDFILIAL
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P219_IDGRUPO
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P219_IDFILIAL
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P219_IDGRUPO
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

