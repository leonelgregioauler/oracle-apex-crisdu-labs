    pageItem P219_SEMANAFIM (
        type: selectOne
        label {
            label: Até
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(semana,'00')||'/'||ano) display_value
                     , idsemana RETURN_VALUE
                from semana_dias
                where idsemana >=534
                  and idsemana > :P219_SEMANAINI
                order by idsemana 
                ```
