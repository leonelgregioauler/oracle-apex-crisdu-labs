        savedReport 224956 (
            visibility: primaryDefault
            view {
                pivot: true
                default: pivot
                rowsPerPage: 50
            }

            displayColumn "Distribuido" (
                sequence: 3
            )

            displayColumn "Empresa" (
                sequence: 1
            )

            displayColumn "Na Rua" (
                sequence: 6
            )

            displayColumn "Perc Venda" (
                sequence: 5
            )

            displayColumn "Produto" (
                sequence: 2
            )

            displayColumn "Vendido" (
                sequence: 4
            )

            sort (
                column: "Vendido"
                sort {
                    direction: desc
                    sequence: 1
                }
            )

            pivotColumn (
                column: "Empresa"
                layout {
                    sequence: 1
                }
            )

            pivotRowColumn (
                column: "Produto"
                layout {
                    sequence: 1
                }
            )

            pivotAggregate ir-pivot-agg (
                heading: Distribuido
                aggregate {
                    function: sum
                    column: "Distribuido"
                    displaySum: true
                }
                appearance {
                    formatMask: 999G999G999G999G990
                }
                layout {
                    sequence: 1
                }
            )

            pivotAggregate ir-pivot-agg-2 (
                heading: Vendido
                aggregate {
                    function: sum
                    column: "Vendido"
                    displaySum: true
                }
                appearance {
                    formatMask: 999G999G999G999G990
                }
                layout {
                    sequence: 2
                }
            )

            pivotAggregate ir-pivot-agg-3 (
                heading: %
                aggregate {
                    function: average
                    column: "Perc Venda"
                }
                appearance {
                    formatMask: 999G999G999G999G990
                }
                layout {
                    sequence: 3
                }
            )

            pivotSort (
                column: "Produto"
                sort {
                    sequence: 1
                }
            )

        )

    )

    pageItem P219_CARACTERISTICA (
        type: selectOne
        label {
            label: Característica
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select INITCAP(nome) nome
                     , c.idcaracteristicacateg
                from caracteristicascategorias c
                where idcategoria = :P219_IDCATEGORIA
                  and tipo = 'C'
                ORDER BY NOME;
                ```
        }
        cascadingLov {
            parentItems: [
                P219_MODELO
                P219_IDCATEGORIA
            ]
        }
        layout {
            sequence: 90
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

