    branch (
        name: FILTRO
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 219
                items: {
                    P219_IDFILIAL: &P219_IDFILIAL.
                    P219_SEMANA: &P219_SEMANA.
                    P219_SEMANAINI: &P219_SEMANAINI.
                    P219_SEMANAFIM: &P219_SEMANAFIM.
                    P219_IDFORNECEDOR: &P219_IDFORNECEDOR.
                    P219_FILIALGRUPO: &P219_FILIALGRUPO.
                    P219_FILTRAR: &P219_FILTRAR.
                    P219_IDGRUPO: &P219_IDGRUPO.
                    P219_IDPRODUTO: &P219_IDPRODUTO.
                    P219_TIPO: &P219_TIPO.
                    P219_IDCATEGORIA: &P219_IDCATEGORIA.
                }
                successMessage: false
            }
        }
        serverSideCondition {
            whenButtonPressed: @p219-filtrar
        }
    )

)

