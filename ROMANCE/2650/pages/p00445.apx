page 445 (
    name: Altera Orcamento
    title: Altera Orcamento
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }

    region altera-orcamento (
        name: Altera Orcamento
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P445_ABRIL (
        type: numberField
        label {
            label: Abril
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 60
            region: @altera-orcamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 9G999G999G999G990D00
            width: 20
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: ABRIL
            used: always
        }
        serverSideCondition {
            type: item=value
            item: P445_MES
            value: 04
        }
        readOnly {
            type: noRowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                  FROM USUARIOS
                 WHERE IDUSUARIO = :P0_IDUSUARIO
                  AND IDGERENTE IN (180,143) 
                ```
        }
        security {
            encryptSessionState: false
        }
    )

