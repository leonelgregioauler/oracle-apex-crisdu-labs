    button chavespix (
        buttonName: CHAVESPIX
        label: Chaves PIX
        layout {
            sequence: 190
            region: @cadastro-de-contas-bancárias
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 397
                items: {
                    P397_IDPESSOA: &P19_IDPESSOA.
                    P397_IDCONTABANCARIA: &P19_IDCONTABANC.
                    P397_PAGINAORIGEM: 19
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P19_IDCONTABANC
        }
    )

