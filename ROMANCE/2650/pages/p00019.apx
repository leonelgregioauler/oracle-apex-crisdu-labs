    pageItem P19_IDCONTABANCRAIZ (
        type: selectList
        label {
            label: Conta Raíz Vinculada
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(cb.beneficiario,p.apelido)||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||')' display_value
                     , cb.idcontabanc    return_value
                from contasbancarias cb
                   , bancos b
                   , pessoas p
                where cb.idbanco      = b.idbanco
                  and cb.idpessoa     = p.idpessoa
                  and cb.ativo        = 'S'
                  and cb.contaraiz    = 'S'   
                  and ( exists ( select 1
                                 from fornecedores f
                                 where f.idpessoa = p.idpessoa )
                     or exists ( select 1
                                 from filiais f
                                 where f.idpessoa = p.idpessoa ) )
                order by 1
                
                ```
        }
        layout {
            sequence: 160
            region: @cadastro-de-contas-bancárias
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDCONTABANCRAIZ
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

