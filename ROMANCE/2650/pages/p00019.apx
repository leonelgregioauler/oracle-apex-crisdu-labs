    dynamicAction conta-raíz (
        name: Conta Raíz
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P19_CONTARAIZ
        }
        clientSideCondition {
            type: item=value
            item: P19_CONTARAIZ
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P19_IDCONTABANCRAIZ
            }
            execution {
                sequence: 10
            }
        )

        action native-set-value (
            action: setValue
            affectedElements {
                selectionType: items
                items: P19_IDCONTABANCRAIZ
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P19_IDCONTABANCRAIZ
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

    )

    dynamicAction valida-duplicada-antes-insert (
        name: Valida Duplicada Antes Insert
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @create
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.server.process("CHECK_DUPLICADA", {
                      pageItems: "#P19_IDPESSOA,#P19_IDBANCO,#P19_AGENCIA,#P19_CONTA,#P19_IDCONTABANC"
                    }, {
                      success: function(data) {
                        if (parseInt(data, 10) > 0) {
                          apex.message.clearErrors();
                          apex.message.showErrors([{
                            type: "error",
                            location: "inline",
                            pageItem: "P19_CONTA",
                            message: "Esta conta já está cadastrada para este fornecedor. Cadastro duplicado não é permitido.",
                            unsafe: false
                          }]);
                        } else {
                          apex.page.submit({ request: "CREATE", showWait: true });
                        }
                      }
                    });
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction valida-duplicada-antes-submit (
        name: Valida Duplicada Antes submit
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @save
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.server.process("CHECK_DUPLICADA", {
                      pageItems: "#P19_IDPESSOA,#P19_IDBANCO,#P19_AGENCIA,#P19_CONTA,#P19_IDCONTABANC"
                    }, {
                      success: function(data) {
                        if (parseInt(data, 10) > 0) {
                          apex.message.clearErrors();
                          apex.message.showErrors([{
                            type: "error",
                            location: "inline",
                            pageItem: "P19_CONTA",
                            message: "Esta conta já está cadastrada para este fornecedor. Cadastro duplicado não é permitido.",
                            unsafe: false
                          }]);
                        } else {
                          apex.page.submit({ request: "SAVE", showWait: true });
                        }
                      }
                    });
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation validacontaduplicada (
        name: VALIDACONTADUPLICADA
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  v_qtd number;
                begin
                  select count(*)
                    into v_qtd
                    from contasbancarias
                   where idpessoa = :P19_IDPESSOA
                     and idbanco  = :P19_IDBANCO
                     and regexp_replace(agencia, '[^0-9]', '') = regexp_replace(:P19_AGENCIA, '[^0-9]', '')
                     and regexp_replace(conta,   '[^0-9]', '') = regexp_replace(:P19_CONTA,   '[^0-9]', '')
                     and nvl(idcontabanc, -1) <> nvl(:P19_IDCONTABANC, -1);
                
                  if v_qtd > 0 then
                    return 'Esta conta já está cadastrada para este fornecedor (mesmo banco, agência e conta). Não é permitido cadastro duplicado.';
                  end if;
                
                  return null;
                end;
                ```
        }
        error {
            associatedItem: @P19_CONTARAIZ
        }
        serverSideCondition {
            type: request=Value
            value: CREATE
        }
    )

    process check-duplicada (
        name: CHECK_DUPLICADA
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  v_qtd number;
                begin
                  select count(*)
                    into v_qtd
                    from contasbancarias
                   where idpessoa = :P19_IDPESSOA
                     and idbanco  = :P19_IDBANCO
                     and regexp_replace(agencia, '[^0-9]', '') = regexp_replace(:P19_AGENCIA, '[^0-9]', '')
                     and regexp_replace(conta,   '[^0-9]', '') = regexp_replace(:P19_CONTA,   '[^0-9]', '')
                     and nvl(idcontabanc, -1) <> nvl(:P19_IDCONTABANC, -1);
                
                  htp.p(v_qtd);
                end;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        error {
            errorMessage: Unable to check for duplicate account.
        }
        advanced {
            executionMappingIdentifier: 8001122334455667793
        }
    )

    process fetch-row-from-contasbancarias (
        name: Fetch Row from CONTASBANCARIAS
        type: autoRowFetch
        source {
            tableName: CONTASBANCARIAS
            pkColumn: IDCONTABANC
            pkItem: P19_IDCONTABANC
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Unable to fetch row.
        }
        advanced {
            executionMappingIdentifier: 181108046752287353
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDCONTABANC.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P19_IDCONTABANC := get_pk; 
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Unable to get primary key item value.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 181108256751287355
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

