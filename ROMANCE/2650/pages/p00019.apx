    pageItem P19_IDPESSOA (
        type: popupLov
        label {
            label: Forn/Filial (Dono)
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa||' - ('|| c.nomecidade)||'-'||e.sigla||')' display_value
                     , p.idpessoa     return_value
                from pessoas p
                   , cidades c
                   , estados e
                where p.idcidade = c.idcidade
                  and c.idestado = e.idestado
                  and ( exists ( select 1
                                 from fornecedores f
                                 where f.idpessoa = p.idpessoa )
                     or exists ( select 1
                                 from filiais f
                                 where f.idpessoa = p.idpessoa ) )
                order by 1
                ```
            nullDisplayValue: " "
        }
        layout {
            sequence: 20
            region: @cadastro-de-contas-bancárias
            slot: regionBody
            alignment: left
        }
        appearance {
