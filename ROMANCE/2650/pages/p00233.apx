    pageItem P233_IDFILIALEMITENTE (
        type: selectList
        label {
            label: Emitente
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa||' ('||c.nomecidade)||'-'||e.sigla||')' display_value
                     , f.idfilial return_value 
                from filiais f
                   , pessoas p
                   , cidades c
                   , estados e
                where f.idpessoa = p.idpessoa
                  and p.idcidade = c.idcidade
                  and c.idestado = e.idestado
                  and f.idfilial = 1068
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @novo-empréstimo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIALEMITENTE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

