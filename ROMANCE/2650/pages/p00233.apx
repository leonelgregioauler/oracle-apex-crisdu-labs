    process calcular-parcela (
        name: calcular parcela
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  -- Local variables here
                  i integer;
                  --
                  cursor cemp is
                    select idnotafiscal
                         , idfornecedorDESTINO
                         , N.DTNF data
                         , VALORTOTAL valor
                         , percjuros
                         , valorreceber
                         , observacao
                         , percjuros/30 jurosdia
                    from notasfiscais N
                    where idnotafiscal = :P233_IDNOTAFISCAL;
                  --
                  remp cemp%rowtype;
                  --
                  vqtdparcelas  number;
                  --
                  vvalorparcelaant number(15,2);
                  vvalorparcela number(15,2);
                  vdatavenctoant   date;
                  --
                  vvalorparcelanovo number(15,2);
                  --
                  vdias number;
                  --
                begin
                  -- 
                  open cemp;
                  fetch cemp into remp;
                  close cemp;
                  --
                  select count(1)
                  into vqtdparcelas
                  from parcelasemprestroman p
                  where p.idnotafiscal = remp.idnotafiscal;
                  --
                  vdatavenctoant   := remp.data;
                  vvalorparcela    := round(remp.valor / vqtdparcelas,2); --vvalorparcelaant  
                  vvalorparcelaant := vvalorparcela;
                  --
                  for i in ( select *
                             from parcelasemprestroman
                             where idnotafiscal = remp.idnotafiscal 
                             order by datavencimento)
                  loop
                    --
                    vdias := i.datavencimento - vdatavenctoant;-- emp.data;
                    --
                    vvalorparcela := vvalorparcelaant + ( vvalorparcelaant * ( remp.jurosdia*vdias ) / 100 );
                    --
                    update parcelasemprestroman  a
                    set valorparcela = vvalorparcela
                    where a.idparcelaemprestimo = i.idparcelaemprestimo;
                    --
                    vvalorparcelaant := vvalorparcela; 
                    vdatavenctoant   := i.datavencimento;
                    --
                  end loop;
                  --
                  update notasfiscais e
                  set valorreceber = ( select sum(valorparcela) from parcelasemprestroman p where idnotafiscal = e.idnotafiscal  )
                  where idnotafiscal =  remp.idnotafiscal;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 269702318851889305
        }
        serverSideCondition {
            whenButtonPressed: @calcular-parcelas
        }
    )

