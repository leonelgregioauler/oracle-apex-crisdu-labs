page 233 (
    name: Empréstimo
    title: Empréstimo
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function abrevencto() 
              {
                vnota = document.getElementById('P233_IDNOTAFISCAL').value;
                window.open('f?p=&APP_ID.:39:&SESSION.::NO::P39_IDNOTAFISCALP,P39_IDVENCIMENTO:'+vnota+',' ,'vencto','toolbar=no,location=no,status=no,menubar=no,scrollbars=no,resizable=no,width=1000,height=300,left=200,top=300','_blank'); void(0);
              }
            
            
            function fnc_popup()
            {vid = document.getElementById("P233_IDNOTAFISCAL").value;
            window.open('f?p=&APP_ID.:190:&SESSION.::NO::P190_IDNOTAFISCAL,P190_IDITNF:'+vid+',','insprod', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=600,height=300,left=250,top=100','_blank'); void(0);
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region novo-empréstimo (
        name: Novo Empréstimo
        type: staticContent
        layout {
            sequence: 0
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
    )

    region parcelas-de-recebimento (
        name: Parcelas de Recebimento
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                IDPARCELAEMPRESTIMO,
                IDPARCELAEMPRESTIMO IDPARCELAEMPRESTIMO_DISPLAY,
                DATAVENCIMENTO,
                VALORPARCELA,
                ( select nvl(n.documento,n.nrnf) 
                  from notasfiscais n 
                  where n.idnotafiscal = ( select pagforn.idnotafiscal 
                                           from pagamentosfornecedores pagforn 
                                           where pagforn.idpgtoforn = ( select idpgtoforn
                                                                        from depositosdiarios
                                                                        where iddepositodiarios = p.iddepositodiario ) )) "Nota Abatida"
                ,IDNOTAFISCAL
                from PARCELASEMPRESTROMAN p
                where idnotaFISCAL = :P233_IDNOTAFISCAL
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P233_IDNOTAFISCAL
        }
        reportLayout {
            numberOfRows: 30
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhuma parcela lançada.
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 1
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
        )

        column DATAVENCIMENTO (
            reportColumnQueryId: 4
            derivedColumn: N
            type: datePicker
            heading {
                heading: Vencimento
            }
            layout {
                sequence: 4
            }
            appearance {
                formatMask: dd/mm/rrrr
                width: 10
            }
        )

        column IDNOTAFISCAL (
            reportColumnQueryId: 7
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 6
            }
            default {
                type: item
                item: P233_IDNOTAFISCAL
            }
            sorting {
                sortable: false
            }
        )

        column IDPARCELAEMPRESTIMO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDPARCELAEMPRESTROMAN
            }
        )

        column IDPARCELAEMPRESTIMO_DISPLAY (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

        column "Nota Abatida" (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Nota Abatida
                alignment: center
            }
            layout {
                sequence: 7
            }
        )

        column VALORPARCELA (
            reportColumnQueryId: 5
            derivedColumn: N
            type: textField
            heading {
                heading: Valor
            }
            layout {
                sequence: 5
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990d00
                width: 16
            }
            advanced {
                cssClasses: style="text-align:right"
                customAttributes: style="text-align:right"
                computeSum: true
            }
        )

    )

