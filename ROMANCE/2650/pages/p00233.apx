    dynamicAction tiponf (
        name: tiponf
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P233_TIPONOTA
        }
        clientSideCondition {
            type: item=value
            item: P233_TIPONOTA
            value: C
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P233_IDFORNEMITENTE
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
