                selectionType: items
                items: P233_IDFILIALEMITENTE
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P233_IDFORNEMITENTE
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P233_IDFILIALEMITENTE
            }
            execution {
                sequence: 30
                fireWhenEventResultIs: false
            }
        )

    )

    validation datavencimento-must-be-a-valid-date (
        name: DATAVENCIMENTO must be a valid date
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @parcelas-de-recebimento
            type: columnIsAValidDate
            column: DATAVENCIMENTO
        }
        error {
            errorMessage: #COLUMN_HEADER# must be a valid date.
            associatedColumn: DATAVENCIMENTO
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation iddepositodiario-must-be-numeric (
        name: IDDEPOSITODIARIO must be numeric
        execution {
            sequence: 50
        }
        validation {
            editableRegion: @parcelas-de-recebimento
            type: columnIsNumeric
            column: IDDEPOSITODIARIO
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: IDDEPOSITODIARIO
        }
        serverSideCondition {
