page 286 (
    name: Relatório de Pagamentos
    title: Relatório de Pagamentos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region relatório-de-pagamentos (
        name: Relatório de Pagamentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct pagforn.dtvencimento
                     , ( select pck_romance.fnc_nomefilial( nf.idfilialdestino ) 
                         from notasfiscais    nf
                         where nf.idnotafiscal  = pagforn.idnotafiscal ) "Filial Destino"
                     , to_char(pagforn.dtlancamento,'RRRR') ano
                     , ( select TRIM(to_char(s.semana,'00')||'/'||s.ano ||'(' )|| to_char(s.dt_ini,'DD/MM/YYYY') ||' a '|| to_char(s.dt_fim,'DD/MM/YYYY')||')'  
                         from semana_dias s
                         where pagforn.dtvencimento between s.dt_ini and s.dt_fim ) Semana
                     , pck_romance.fnc_nomefornecedor(pidforn => pagforn.idfornecedor) Fornecedor
                     ,  nf.documento
                     , pagforn.valorpagar ValorPagar
                     , pagforn.valorpago ValorPago
                     , pagforn.valorpago - pagforn.valorpagar Saldo
                     , ( select cb.beneficiario||' - '||b.nomebanco
                              ||' - '|| cb.agencia ||' - '||
                              cb.conta
                         from contasbancarias cb
                            , bancos b
                         where cb.idbanco         = b.idbanco 
                           and cb.idcontabanc = pagforn.idcontabanc)  conta
                     , decode(pagforn.tipopagamento,'D','Depósito'
                                                   ,'B','Boleto'
                                                   ,'E','Empréstimo'
                                                   ,'M','Em Mãos'
                                                   ,'Não Informado')  "Tipo Pagamento"
                     , ( select sum(d.Valororiginal)
                         from depositosdiarios d
                         where d.idpgtoforn = pagforn.idpgtoforn ) totaldepositado
                from pagamentosfornecedores pagforn
                   , notasfiscais    nf
                where nf.idnotafiscal  = pagforn.idnotafiscal 
                  and pagforn.idcheque is null
                  and nf.situacao = 'A'
                  and pck_romance.fnc_filialusuario(nf.usuario) = pck_romance.fnc_filialusuario(v('APP_USER'))
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
