page 65 (
    name: Lista de Saídas Diversas
    title: Lista de Saídas Diversas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region aviso (
        name: Aviso
        type: staticContent
        layout {
            sequence: 5
            slot: body-3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from SAIDASDIVERSAS
                where idfechamento is null
                and idfilial     = (select f.idfilial 
                from filiais    f
                   , pessoas    p
                   , usuarios   u
                   , gerentes   g
                where f.idpessoa  = p.idpessoa
                  and g.idfilial  = f.idfilial
                  and u.idgerente = g.idgerente
                  and u.usuario   = V('APP_USER'))
                ```
        }
    )

    region lista-de-saídas-diversas (
        name: Lista de Saídas Diversas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.idsaida
                     , e.idfilial
                     , initcap(nvl(p.apelido,p.nomepessoa)) "Filial Destino"
                     , e.semana
                     , e.data
                     , e.fechamentoorig
                     , e.valortotal
                     , e.descricao
                from saidasdiversas e
                   , filiais          f
                   , pessoas          p
                where e.idfilialdest = f.idfilial(+)
                  and f.idpessoa     =p.idpessoa
                  and e.idfechamento = :P65_IDFECHAMENTO
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        serverSideCondition {
            type: never
        }
        link {
            linkColumn: customTarget
            target: {
                page: 66
                items: {
                    P66_IDSAIDA: #IDSAIDA#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
            conditionType: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentossemanais f
                where nvl(f.concluido,'N') = 'N'
                  and f.idfechamento = :P60_IDFECHAMENTO
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhuma saída incluída.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column DATA (
            type: plainText
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 5
            }
            source {
                dataType: date
            }
            advanced {
                htmlDomId: DATA
                endUserAlias: E
            }
            enableUsersTo {
                pivot: false
            }
        )

        column DESCRICAO (
            type: plainText
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 8
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: DESCRICAO
                endUserAlias: H
            }
            enableUsersTo {
                pivot: false
            }
        )

        column FECHAMENTOORIG (
            type: plainText
            heading {
                heading: Fechamento Orig
                alignment: center
            }
            layout {
                sequence: 6
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: FECHAMENTOORIG
                endUserAlias: F
            }
            enableUsersTo {
                pivot: false
            }
        )

        column "Filial Destino" (
            type: plainText
            heading {
                heading: Filial Destino
                alignment: center
            }
            layout {
                sequence: 9
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Filial_Destino
                endUserAlias: I
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDFILIAL (
            type: hidden
            heading {
                heading: Idfilial
            }
            layout {
                sequence: 2
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDFILIAL
                endUserAlias: B
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDSAIDA (
            type: link
            heading {
                heading: Editar
                alignment: center
            }
            layout {
                sequence: 1
            }
            link {
                target: {
                    page: 66
                    items: {
                        P66_IDSAIDA: #IDSAIDA#
                    }
                }
                linkText: <img src="#IMAGE_PREFIX#menu/pencil2_16x16.gif" alt="">
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDSAIDA
                endUserAlias: A
            }
            enableUsersTo {
                pivot: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column SEMANA (
            type: plainText
            heading {
                heading: Semana
                alignment: center
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: SEMANA
                endUserAlias: D
            }
            enableUsersTo {
                pivot: false
            }
        )

        column VALORTOTAL (
            type: plainText
            heading {
                heading: Valor Total
                alignment: center
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: VALORTOTAL
                endUserAlias: G
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 17613 (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn DATA (
                sequence: 3
            )

            displayColumn DESCRICAO (
                sequence: 4
            )

            displayColumn FECHAMENTOORIG (
                sequence: 1
            )

            displayColumn "Filial Destino" (
                sequence: 2
            )

            displayColumn VALORTOTAL (
                sequence: 5
            )

        )

    )

    region saídas-diversas (
        name: Saídas Diversas
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDSAIDA",
                "IDSAIDA" IDSAIDA_DISPLAY,
                "IDFILIAL",
                "IDFILIALDEST",
                "SEMANA",
                "DATA",
                "FECHAMENTOORIG",
                "VALORTOTAL",
                "DESCRICAO",
                "IDFECHAMENTO",
                "EMMAOS",
                Decode(TIPO,'D','Dinheiro','O','Pagamento de Conta') TIPO
                from "#OWNER#"."SAIDASDIVERSAS"
                where idfechamento = :P65_IDFECHAMENTO
                
                ```
        }
        layout {
            sequence: 15
            slot: body-3
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        reportLayout {
            numberOfRows: 499
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: " "
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhuma saída incluída.
        }
        componentAdvanced {
            stripHtml: true
        }

        column DATA (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: center
            }
        )

        column DESCRICAO (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Descrição
            }
            layout {
                sequence: 11
            }
        )

        column EMMAOS (
            reportColumnQueryId: 11
            derivedColumn: N
            type: simpleCheckbox
            heading {
                heading: Em Mãos
            }
            lov {
                checkboxValues: S
            }
            layout {
                sequence: 12
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1
                    from dual
                    where pck_romance.fnc_verificaacesso('PERM_ALTERAFECHA', v('APP_USER')) = 'S'
                    ```
            }
        )

        column FECHAMENTOORIG (
            reportColumnQueryId: 7
            derivedColumn: N
            type: hidden
            layout {
                sequence: 5
            }
        )

        column IDFECHAMENTO (
            reportColumnQueryId: 10
            derivedColumn: N
            type: hidden
            layout {
                sequence: 4
            }
        )

        column IDFILIAL (
            reportColumnQueryId: 3
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Filial
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(nvl(p.apelido,p.nomepessoa)) display_value
                    , f.idfilial return_value
                    from filiais f
                    , pessoas p
                    where f.idpessoa = p.idpessoa
                    ```
            }
            layout {
                sequence: 7
            }
        )

        column IDFILIALDEST (
            reportColumnQueryId: 4
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Filial Destino
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(nvl(p.apelido,p.nomepessoa)) display_value
                    , f.idfilial return_value
                    from filiais f
                    , pessoas p
                    where f.idpessoa = p.idpessoa
                    ```
            }
            layout {
                sequence: 8
            }
        )

        column IDSAIDA (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingTrigger
            }
        )

        column IDSAIDA_DISPLAY (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: ID Controle
                alignment: center
            }
            layout {
                sequence: 3
            }
        )

        column LINK$01 (
            reportColumnQueryId: 13
            derivedColumn: Y
            type: link
            heading {
                heading: Editar
                alignment: center
            }
            layout {
                sequence: 1
            }
            link {
                target: {
                    page: 66
                    items: {
                        P66_IDSAIDA: #IDSAIDA#
                    }
                }
                linkText: <img src="#IMAGE_PREFIX#menu/pencil2_16x16.gif" alt="">
            }
            sorting {
                sortable: false
            }
        )

        column SEMANA (
            reportColumnQueryId: 5
            derivedColumn: N
            type: hidden
            layout {
                sequence: 9
            }
        )

        column TIPO (
            reportColumnQueryId: 12
            derivedColumn: N
            heading {
                heading: Tipo
                alignment: center
            }
            layout {
                sequence: 13
            }
        )

        column VALORTOTAL (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Valor Total
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            advanced {
                computeSum: true
            }
        )

    )

    pageItem P65_AVISO (
        type: displayOnly
        label {
            label: <b><font color="RED">Aviso:</font></b>
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 30
            region: @aviso
            slot: regionBody
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select 'Você tem saídas pendentes de confirmação!'
                from SAIDASDIVERSAS
                where idfechamento is null
                and idfilial     = (select f.idfilial 
                from filiais    f
                   , pessoas    p
                   , usuarios   u
                   , gerentes   g
                where f.idpessoa  = p.idpessoa
                  and g.idfilial  = f.idfilial
                  and u.idgerente = g.idgerente
                  and u.usuario   = V('APP_USER'))
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P65_IDFECHAMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @lista-de-saídas-diversas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P65_SEMANA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @lista-de-saídas-diversas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @saídas-diversas
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 76
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button confirmasaida (
        buttonName: confirmasaida
        label: Confirmar Saídas
        layout {
            sequence: 50
            region: @saídas-diversas
            slot: aboveBox
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 103
                items: {
                    P103_IDFECHAMENTO: &P65_IDFECHAMENTO.
                }
                clearCache: 103
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button nova-saida (
        buttonName: NOVA_SAIDA
        label: Nova Saída
        layout {
            sequence: 40
            region: @saídas-diversas
            slot: aboveBox
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 66
                items: {
                    P66_IDFECHAMENTO: &P65_IDFECHAMENTO.
                }
                clearCache: 66
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Salvar
        layout {
            sequence: 30
            region: @saídas-diversas
            slot: CHANGE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @saídas-diversas
        target {
            tableName: SAIDASDIVERSAS
            pkColumn: IDSAIDA
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Linha(s) #MRU_COUNT# atualizada(s); linha(s) #MRI_COUNT# inserida(s).
        }
        error {
            errorMessage: Não foi possível processar a atualização.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 180452523139560578
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process atualiza-fechamento (
        name: atualiza fechamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_romance.prc_atualiza_gavetas ( :P65_IDFECHAMENTO, v('APP_USER'));
                  --
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 249113599055237291
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 65
            }
            saveStateBeforeBranching: true
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 65
            }
            saveStateBeforeBranching: true
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 65
            }
            saveStateBeforeBranching: true
        }
    )

)

