    process confirma-transferencia-romance (
        name: Confirma Transferencia Romance
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_estoque_v2.prc_geravencimentostransf(pidnotafiscal => :P317_IDNOTA);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Gerado vencimento com sucesso!
        }
        advanced {
            executionMappingIdentifier: 867985873591934533
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMAR
        }
    )

