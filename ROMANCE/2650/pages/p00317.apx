    region transferências-romance (
        name: Transferências Romance
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nf.idnotafiscal
                     , nf.documento
                     , nf.dtnf
                     , nf.datarecebimento
                     , nf.valortotal
                     , pck_romance.fnc_nomefilial(nf.idfilialemitente) emitente
                     , pck_romance.fnc_nomefilial(nf.idfilialdestino) destino
                     , '<a href="javascript:document.getElementById(''P317_IDNOTA'').value = '||idnotafiscal||';confirmatransf();">Confirmar</a>' confirmar
                from notasfiscais nf
                where nf.tipoemitente = 'FIL' 
                  and nf.tiponota = 'T'
                  and nf.situacaofilial = 'R'
                  and nf.observacao not like '%Transferencia realizada a partir da carga do distribuidor%'
                  and extract ( year from nf.datainclusao ) >= 2022
                  and exists ( select 1
                               from vw_filiais f
                               where f.tipofilial = 'D'
                                 and f.idfilial = nf.idfilialdestino )
                  and exists ( select 1
                               from itemnf i
                               where i.idnotafiscal = nf.idnotafiscal )
                  and not exists ( select 1
                                   from notasfiscais nn
                                   where nn.tipoemitente = 'FOR'
                                     and nn.idnotafiscalcompra = nf.idnotafiscal )
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P317_TIPO
            value: R
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
