page 317 (
    name: Apoio de Transferências RMC E FAV
    title: Apoio de Transferências RMC E FAV
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function confirmatransf() {
            	var answer = confirm("Deseja realmente confirmar a Transferencia?")
            	if (answer){
            		apex.submit('CONFIRMAR');
            	}
                    else
                    {
                    document.getElementById('P317_IDNOTA').value = '';
                    }
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region transferências-favorita (
        name: Transferências Favorita
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idcompratransferencia
                     , favorita.pck_util_fav.fnc_nomefilialfavorita(c.idfilialfavoritaorigem) emitente
                     , favorita.pck_util_fav.fnc_nomefilialfavorita(c.idfilialfavoritadestino) destino
                     , c.dataemissao
                     , c.datarecebimento
                     , c.valortotalcompra
                     , c.valortotalrecebido
                from favorita.comprastransferencias c
                where c.idtipocomptransrem = 1
                  and extract ( year from c.dataemissao ) >= 2022
                  and c.idsituacao = 40
                  and not exists ( select 1
                                   from notasfiscais nf
                                   where nf.idcompratransferencia = c.idcompratransferencia )
                  and not exists ( select 1
                                   from favorita.filiaisfavorita ff
                                   where ff.idfilialfavorita = c.idfilialfavoritaorigem
                                     and ff.tipofilial in ('V','P') )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P317_TIPO
            value: F
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: "Nenhuma transferência localizada. "
        }
        advanced {
            savedReportMappingIdentifier: 867984511592934520
        }

