page 813 (
    name: Detalhamento Notas Após Sacola
    alias: DETALHAMENTO-NOTAS-APOS-SACOLA
    title: Notas após sacola
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
            t-Dialog--noPadding
            t-PageBody--noContentPadding
        ]
    }
    dialog {
        width: 1000
        resizable: false
    }

    region notas-após-uso-da-sacola (
        name: Notas após uso da sacola
        title: Notas após uso da sacola
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    nv.idnotavenda,
                    pck_romance.fnc_nomefilial(nv.idfilial) franquia,
                    pck_romance.fnc_nomerepresentante(nv.idrepresentante) distribuidor,
                    pck_romance.fnc_nomevendedora(nv.idvendedora) consultora,
                    pck_romance.fnc_cpfvendedora(nv.idvendedora) cpf,
                    nv.datanota,
                    nv.semanadistribuicao,
                    nv.numeronota,
                    nv.valortotalnota,
                    nv.valortotalvenda
                from notasvendas nv
                where nv.idvendedora = :P813_CONSULTORA
                  and nv.idsituacaonotavenda = 4
                  and nv.idnotavenda >= :P813_NOTABASE
                  and exists ( select 1
                               from sugestoessacolas ss
                                  , itenssugestoessacolas ii
                                  , itensnotavenda it
                               where ss.idnotavenda      = nv.idnotavenda
                                 and ii.idsugestaosacola = ss.idsugestaosacola
                                 and it.idnotavenda      = nv.idnotavenda
                                 and it.idestoquefil     = ii.idestoquefil)
                ```
        }
        layout {
            sequence: 10
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }

        column CONSULTORA (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 40
            }
        )

        column CPF (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: CPF
                alignment: center
            }
            layout {
                sequence: 50
            }
        )

        column DATANOTA (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Data Nota
                alignment: center
            }
            layout {
                sequence: 60
            }
        )

        column DISTRIBUIDOR (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 30
            }
        )

        column FRANQUIA (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Franquia
                alignment: center
            }
            layout {
                sequence: 20
            }
        )

        column IDNOTAVENDA (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Id Nota Venda
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
        )

        column NUMERONOTA (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Nr Nota
            }
            layout {
                sequence: 80
            }
        )

        column SEMANADISTRIBUICAO (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Semana Dist.
                alignment: center
            }
            layout {
                sequence: 70
            }
        )

        column VALORTOTALNOTA (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Valor Total Nota
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
        )

        column VALORTOTALVENDA (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Valor Total Venda
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
        )

    )

    pageItem P813_CONSULTORA (
        type: hidden
        layout {
            sequence: 20
            slot: regionBody
        }
    )

    pageItem P813_NOTABASE (
        type: hidden
        layout {
            sequence: 30
            slot: regionBody
        }
    )

)

