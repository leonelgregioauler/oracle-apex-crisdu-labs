page 422 (
    name: Pagamentos Realizados
    title: Pagamentos Realizados
    appearance {
        pageMode: nonModalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region pagamentos-realizados (
        name: Pagamentos Realizados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select identrada
                     , to_char(data,'IW/RRRR') semana
                     , data
                     , valortotal valor
                     , descricao
                     , descricaoorigem
                     , e.data datavencimento
                     , to_char(e.data,'MONTH') mesvencimento
                     , 'Entrada Caixa '||decode(e.tipoentrada,'D','Dinheiro','Pagamento de Conta') tipo
                from entradasdiversas e
                where to_char( e.data,'MMRRRR') = :P422_MESANO
                  and e.idfilial = 1061
                  and 1 = 2
                union
                select dm.id
                     , to_char(dm.data,'IW/RRRR') semana
                     , dm.data
                     , dm.valor
                     , dm.conta
                     , dm.origem||'(NF: '||( select nf.documento
                                             from notasfiscais nf
                                             where nf.idnotafiscal = dm.idnotafiscal )||')' origem
                     , dm.data
                     , to_char(dm.data,'MONTH') mesvencimento
                     , dm.subconta
                from vw_despesascentroscustos_m dm
                where dm.idunidadedenegocio = 56
                  and dm.mes = :P422_MES
                  and dm.ano = :P422_ANO
                  and not exists ( select 1
                                   from rateioscentroscustos rr
                                   where rr.idcentrodecusto = dm.idcentrodecusto
                                     and rr.percentual is not null )
                union
                select dm.id
                     , to_char(dm.data,'IW/RRRR') semana
                     , dm.data
                     , round(r.percentual * dm.valor / 100,2) valor
                     , dm.conta
                     , dm.origem
                     , dm.data
                     , to_char(dm.data,'MONTH') mesvencimento
                     , dm.subconta
                from vw_despesascentroscustos_m dm
                   , vw_rateioscentroscustos r
                where r.idcentrodecusto = dm.idcentrodecusto
                  and r.idunidadedenegocio = 56
                  and r.percentual > 0
                  and dm.mes between r.mesinicial and r.mesfinal
                  and r.vigencia = dm.ano
                  and r.tipo = 'M'
                  and r.contabilizadespesa = 'S'
                  and dm.mes = :P422_MES
                  and dm.ano = :P422_ANO
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P422_TIPO
            value: P
        }
        reportLayout {
            numberOfRows: 600
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        performance {
            maxRowsToProcess: 5000
        }
        messages {
            whenNoDataFound: No data found.
        }
        breakFormatting {
            breakColumns: col1
        }
        componentAdvanced {
            stripHtml: true
        }
        download {
            csvExportEnabled: true
        }

        column DATA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 2
            }
            sorting {
                defaultSequence: 1
            }
        )

        column DATAVENCIMENTO (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Vencimento
                alignment: center
            }
            layout {
                sequence: 7
            }
        )

        column DESCRICAO (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 3
            }
        )

        column DESCRICAOORIGEM (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Descrição Origem
                alignment: center
            }
            layout {
                sequence: 5
            }
        )

        column IDENTRADA (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 4
            }
        )

        column MESVENCIMENTO (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Mês Vencto
                alignment: center
            }
            layout {
                sequence: 8
            }
        )

        column SEMANA (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Semana
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column TIPO (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Tipo
                alignment: center
            }
            layout {
                sequence: 9
            }
        )

        column VALOR (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Valor
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            advanced {
                computeSum: true
            }
        )

    )

    region rateios-do-grupo (
        name: Rateios do Grupo
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*
                select ( select c.nome
                         from centrodecustos c
                         where c.idcentrodecusto = r.idcentrodecusto ) centrodecusto
                     , r.percentual
                     , rateio.valor
                     , round(( r.percentual * rateio.valor / 100 ),2) rateio
                from vw_rateioscentroscustos r
                   , ( select d.idcentrodecusto
                            , sum(d.valor) valor 
                       from vw_despesascentroscustos_m d
                       where d.mes = :P422_MES and ano = :P422_ANO 
                       group by d.idcentrodecusto ) rateio 
                where r.idunidadedenegocio = 56
                  and r.vigencia = :P422_ANO 
                  and r.percentual > 0
                  and r.contabilizarateio = 'S'
                  and r.tipo = 'M'
                  and :P422_MES between r.mesinicial and r.mesfinal
                  and r.idcentrodecusto = rateio.idcentrodecusto(+)*/
                select to_char(dm.data,'IW/RRRR') semana
                     , dm.data
                     , sum(round(r.percentual * dm.valor / 100,2)) valor
                     , dm.conta
                     , dm.origem
                     , to_char(dm.data,'MONTH') mesvencimento
                     , dm.subconta
                     , ( select nf.documento
                         from notasfiscais nf
                         where nf.idnotafiscal = dm.idnotafiscal ) documento
                     , dm.centrodecusto
                from vw_despesascentroscustos_m dm
                   , vw_rateioscentroscustos r
                where r.idcentrodecusto = dm.idcentrodecusto
                  and r.idunidadedenegocio = 56
                  and r.percentual > 0
                  and dm.mes between r.mesinicial and r.mesfinal
                  and r.vigencia = dm.ano
                  and r.tipo = 'M'
                  and r.contabilizarateio = 'S'
                  and dm.mes = :P422_MES
                  and dm.ano = :P422_ANO
                group by dm.idnotafiscal
                     , to_char(dm.data,'IW/RRRR')
                     , dm.data
                     , dm.conta
                     , dm.origem
                     , to_char(dm.data,'MONTH') 
                     , dm.subconta
                     , dm.centrodecusto
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P422_TIPO
            value: R
        }
        reportLayout {
            numberOfRows: 5000
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }

        column CENTRODECUSTO (
