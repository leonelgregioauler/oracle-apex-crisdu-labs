            }
        )

        column MESVENCIMENTO (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Mês Vencimento
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column ORIGEM (
            reportColumnQueryId: 5
            derivedColumn: N
