page 474 (
    name: Cad. Plano Contas Empresa
    title: Cad. Plano Contas Empresa
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }

    region cadastro-plano-contas-empresa (
        name: Cadastro Plano Contas Empresa
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: CADPLANOS
        }
        settings {
            outputAs: text
        }
    )

    region classificações (
        name: Classificações
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select (select classificacao
                          from planocontasgeral
                         where idclassificacao = c.idclassificacao) classificacao
                     , (select descricaoconta
                          from planocontasgeral
                         where idclassificacao = c.idclassificacao) descricaoconta
                     --
                     , c.idclassificacao
                     , c.idplanocontasempresa
                  from planocontasclassificacoes c
                 where c.idplanocontasempresa in (select idplanocontasempresa
                                                    from planocontasempresa
                                                   where idrazaosocialfilial = :P474_IDRAZAOSOCIALFILIAL)
                ```
            pageItemsToSubmit: P474_IDRAZAOSOCIALFILIAL
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: delete
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 3074200335269453649
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @DESCRICAOCONTA
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @CLASSIFICACAO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDCLASSIFICACAO
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @IDPLANOCONTASEMPRESA
                layout {
                    sequence: 5
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column CLASSIFICACAO (
            type: textarea
            heading {
                heading: Classificação
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: CLASSIFICACAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column DESCRICAOCONTA (
            type: textField
            heading {
                heading: Descrição Conta
            }
            layout {
                sequence: 30
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: DESCRICAOCONTA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column IDCLASSIFICACAO (
            type: hidden
            layout {
                sequence: 50
            }
            source {
                databaseColumn: IDCLASSIFICACAO
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDPLANOCONTASEMPRESA (
            type: hidden
            layout {
                sequence: 60
            }
            source {
                databaseColumn: IDPLANOCONTASEMPRESA
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

    )

    pageItem P474_ATIVA (
        type: selectList
        label {
            label: Ativa
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Sim;S,Não;N
        }
        layout {
            sequence: 40
            region: @cadastro-plano-contas-empresa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P474_IDPLANOCONTASEMPRESA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @cadastro-plano-contas-empresa
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P474_IDRAZAOSOCIALFILIAL (
        type: popupLov
        label {
            label: Razão Social
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomefilialromance(r.idfilial) || ' - '|| razaosocial || ' - ' || cnpj d
                     , idrazaosocialfilial r
                  from razoessociaisfiliais r
                --  where r.idrazaosocialfilial not in (select idrazaosocialfilial
                --                                        from planocontasempresa)
                  order by 1
                ```
        }
        layout {
            sequence: 20
            region: @cadastro-plano-contas-empresa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P474_MODELO (
        type: selectList
        label {
            label: Modelo
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select valordominio d
                     , idvalordominio r
                  from valoresdominioscrisdu v
                 where v.iddominioscrisdu = (select iddominioscrisdu
                                               from dominioscrisdu
                                              where nomedominio = 'MODELO-PLANO-DE-CONTA')
                ```
        }
        cascadingLov {
            parentItems: P474_IDRAZAOSOCIALFILIAL
        }
        layout {
            sequence: 30
            region: @cadastro-plano-contas-empresa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar / Voltar
        layout {
            sequence: 10
            region: @cadastro-plano-contas-empresa
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 473
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button classificacoes (
        buttonName: CLASSIFICACOES
        label: Inserir Contas
        layout {
            sequence: 50
            region: @cadastro-plano-contas-empresa
            slot: help
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 475
                items: {
                    P475_IDRAZAOSOCIALFILIAL: &P474_IDRAZAOSOCIALFILIAL.
                    P475_IDPLANOCONTASEMPRESA: &P474_IDPLANOCONTASEMPRESA.
                    P475_MODELO: &P474_MODELO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P474_IDPLANOCONTASEMPRESA
        }
    )

    button create (
        buttonName: CREATE
        label: Incluir
        layout {
            sequence: 40
            region: @cadastro-plano-contas-empresa
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P474_IDPLANOCONTASEMPRESA
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @cadastro-plano-contas-empresa
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: definedByDynamicAction
            executeValidations: false
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P474_IDPLANOCONTASEMPRESA
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar Alterações
        layout {
            sequence: 30
            region: @cadastro-plano-contas-empresa
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P474_IDPLANOCONTASEMPRESA
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @delete
        }

        action native-confirm (
            action: confirm
            settings {
                message: Confirma Exclusão?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: DELETE
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction new-2 (
        name: New_2
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P474_IDRAZAOSOCIALFILIAL
        }
        serverSideCondition {
            type: never
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select idplanocontasempresa
                         , modelo
                         , ativa
                      from planocontasempresa
                     where idrazaosocialfilial = :P474_IDRAZAOSOCIALFILIAL
                    ```
                itemsToSubmit: P474_IDRAZAOSOCIALFILIAL
            }
            affectedElements {
                selectionType: items
                items: [
                    P474_IDPLANOCONTASEMPRESA
                    P474_MODELO
                    P474_ATIVA
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    process api-planocontasemp (
        name: API_PlanoContasEmp
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vmd5 varchar2(4000);
                  vidplanoemp number;
                  vdml varchar2(1);
                begin
                  --
                  --
                  if v('REQUEST')    = 'CREATE' then
                    vdml := 'I';
                  elsif v('REQUEST') = 'SAVE' then
                    vdml := 'U';
                  elsif v('REQUEST') = 'DELETE' then
                    vdml := 'D';
                  else
                    vdml := 'S';
                  end if;
                  --
                    
                  pck_contabilidade_rmc.prc_planocontasempresa(pidplanocontasempresa => :P474_IDPLANOCONTASEMPRESA,
                                                               pidrazaosocialfilial  => :P474_IDRAZAOSOCIALFILIAL,
                                                               pmodelo               => :P474_MODELO,
                                                               pativa                => :P474_ATIVA,
                                                               pmd5                  => vmd5,
                                                               poperacao_dml         => vdml ) ;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Ação Processada!
        }
        advanced {
            executionMappingIdentifier: 3074430730520119355
        }
    )

    process buscadados (
        name: BuscaDados
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vmd5 varchar2(4000);
                  vidplanoemp number;
                  vdml varchar2(1);
                begin
                  --
                  /*select max(idplanocontasempresa)
                    into :P474_IDPLANOCONTASEMPRESA
                    from planocontasempresa
                   where idrazaosocialfilial = :P474_IDRAZAOSOCIALFILIAL;*/
                 
                  --
                  if :P474_IDPLANOCONTASEMPRESA is not null then
                  pck_contabilidade_rmc.prc_planocontasempresa(pidplanocontasempresa => :P474_IDPLANOCONTASEMPRESA,
                                                               pidrazaosocialfilial  => :P474_IDRAZAOSOCIALFILIAL,
                                                               pmodelo               => :P474_MODELO,
                                                               pativa                => :P474_ATIVA,
                                                               pmd5                  => vmd5,
                                                               poperacao_dml         => 'S' ) ;
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 3242985160976490612
        }
        serverSideCondition {
            type: request=Value
            value: BUSCADADOS
        }
    )

    process classificações-save-interactive-grid-data (
        name: Classificações - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @classificações
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 3074450248683696905
        }
    )

    process fetch-row-from-planocontasempresa (
        name: Fetch Row from PLANOCONTASEMPRESA
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vmd5 varchar2(4000);
                  vidplanoemp number;
                  vdml varchar2(1);
                begin
                  --
                  vidplanoemp := :P474_IDPLANOCONTASEMPRESA;
                  --
                  --RAISE_APPLICATION_ERROR(-20001,'Plano '||vidplanoemp);
                 -- if vidplanoemp is not null then
                  pck_contabilidade_rmc.prc_planocontasempresa(pidplanocontasempresa => vidplanoemp,
                                                               pidrazaosocialfilial  => :P474_IDRAZAOSOCIALFILIAL,
                                                               pmodelo               => :P474_MODELO,
                                                               pativa                => :P474_ATIVA,
                                                               pmd5                  => vmd5,
                                                               poperacao_dml         => 'S' ) ;
                -- end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 3074429922103119356
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 3074431192751119355
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        name: Go To Page 473
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 473
            }
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CANCEL,DELETE
        }
    )

    branch (
        name: AtualizaPagina
        execution {
            sequence: 11
        }
        behavior {
            target: {
                page: 474
                items: {
                    P474_IDPLANOCONTASEMPRESA: &P474_IDPLANOCONTASEMPRESA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,CREATE
        }
    )

)

