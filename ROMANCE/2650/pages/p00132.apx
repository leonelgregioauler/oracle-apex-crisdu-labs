    region controle-de-ligações-resumido (
        name: Controle de Ligações Resumido
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomeusuario(c.usuarioatendeu) usuario
                     , trunc(( sum(c.dataconclusao - c.datainicio) * 86400 / 3600)) ||':' || 
                                        trunc(mod( sum(c.dataconclusao - c.datainicio) * 86400 , 3600 ) / 60 ) || ':'|| 
                                        trunc(mod ( mod ( sum(c.dataconclusao - c.datainicio) * 86400, 3600 ), 60 )) tempo
                     --, round(trunc(( sum(c.dataconclusao - c.datainicio) * 86400 )) *100/21600 * (decode((to_date(:P132_DATAFIM,'dd/mm/rrrr') - to_date(:P132_DATAINICIO,'dd/mm/rrrr')),0,1,(to_date(:P132_DATAFIM,'dd/mm/rrrr') - to_date(:P132_DATAINICIO,'dd/mm/rrrr')))),2) perctempo
                     , count(distinct(c.idcontrole)) qtd
                from controleligacoes c
                where ( :P132_USUARIO is null or c.usuarioatendeu = :P132_USUARIO )
                  and ( :P132_SITUACAO is null or c.situacao = :P132_SITUACAO )
                  and trunc(c.datainicio) between to_date(:P132_DATAINICIO,'DD/MM/RRRR') and to_date(:P132_DATAFIM,'DD/MM/RRRR')
                group by c.usuarioatendeu
                order by 1
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent14
                t-Region--scrollBody
