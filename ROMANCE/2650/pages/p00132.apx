page 132 (
    name: Controle de Ligações
    title: Controle de Ligações
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region controle-de-ligações-detalhado (
        name: Controle de Ligações Detalhado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select o.nome||' - '||o.ddd operadora
                     , c.telefone
                     , t.nome tipoligacao
                     , c.dataligacao
                     , decode(c.situacao,'P','Pendente','C','Concluido','Z','Rejeitada') situacao
                     , c.usuarioatendeu
                     , pck_romance.fnc_nomerepresentante(c.idrepresentante) distribuidor
                     , pck_romance.fnc_filialrepresentante(c.idrepresentante) filialdistribuidor
                     , pck_util.fnc_tempodecorrido(ptempo => (c.dataconclusao - c.datainicio), ptiporetorno => 'H') tempodecorrido 
                from controleligacoes c
                   , tipoligacoes t
                   , operadorastelefonia o
                where c.idtipoligacao      = t.idtipoligacao(+)
                  and c.idoperadoratel(+)  = o.idoperadoratel
                  and ( :P132_USUARIO is null or c.usuarioatendeu = :P132_USUARIO )
                  and ( trunc(dataligacao) between to_date(:P132_DATAINICIO,'DD/MM/RRRR') and to_date(:P132_DATAFIM,'DD/MM/RRRR') )
                  and ( :P132_SITUACAO is null or c.situacao = :P132_SITUACAO )
                  and ( :P132_TELEFONE is null or c.telefone like '%'||replace(replace(replace(replace(:P132_TELEFONE,'(',''),')',''),'.',''),'-','')||'%')
                order by 4
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P132_TIPORELATORIO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma ligação encontrada! Verifique os filtros.
        }
        advanced {
            savedReportMappingIdentifier: 766972935312739046
        }

