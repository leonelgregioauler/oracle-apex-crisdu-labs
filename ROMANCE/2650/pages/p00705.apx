            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(i.dt_inicio, 'DD/MM/YYYY HH24:MI') inicio
                     , ( select substr(cb.beneficiario, 1, 25) from contasbancarias cb
                          where cb.idcontabanc = i.idcontabanc ) conta
                     , to_char(i.dt_ini, 'DD/MM') || ' a ' || to_char(i.dt_fim, 'DD/MM') periodo
                     , i.status
                     , i.chamadas
                     , i.lidos
                     , i.novos
                     , round((nvl(i.dt_termino, sysdate) - i.dt_inicio) * 86400) segundos
                     , i.mensagem
                     , i.usuario
                  from extratos_bancarios_import i
                 where :P705_CONTA is null or i.idcontabanc = :P705_CONTA
                 order by i.idimport desc
                 fetch first 30 rows only
                ```
