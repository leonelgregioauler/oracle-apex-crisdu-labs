page 705 (
    name: Conciliação Bancária
    title: Conciliacao Bancaria
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            // Soma o que esta marcado nos dois lados e mostra a diferenca.
            function c705soma(nome) {
              var t = 0, q = 0, pend = 0;
              $("input[name=" + nome + "]:checked").each(function () {
                q++;
                t += parseFloat($(this).attr("data-v")) || 0;
                if ($(this).attr("data-s") === "PENDENTE") { pend++; }
              });
              return { q: q, t: Math.round(t * 100) / 100, pend: pend };
            }
            function c705brl(v) {
              return v.toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
            }
            function c705tot() {
              var e = c705soma("f01"), s = c705soma("f02");
              var d = Math.round((e.t - s.t) * 100) / 100;
              var cls = (e.q && s.q) ? (d === 0 ? "c705-dif-ok" : "c705-dif-ko") : "";
              $("#sel705").html(
                "<span>Extrato: <b>" + e.q + "</b> - <b>" + c705brl(e.t) + "</b></span>" +
                "<span>Sistema: <b>" + s.q + "</b> - <b>" + c705brl(s.t) + "</b></span>" +
                "<span class=\"" + cls + "\">Diferença: <b>" + c705brl(d) + "</b></span>");
            }
            function c705Conciliar() {
              var e = c705soma("f01"), s = c705soma("f02");
              if (!e.q || !s.q) {
                apex.message.alert("Marque os lançamentos do extrato (esquerda) e do sistema (direita).");
                return;
              }
              if (e.q > 1 && s.q > 1) {
                apex.message.alert("Concilie 1 lançamento do extrato com vários do sistema, ou vários do extrato com 1 do sistema.");
                return;
              }
              if (e.pend < e.q) {
                apex.message.alert("Há lançamento do extrato já conciliado ou ignorado na seleção. Desfaça antes.");
                return;
              }
              var d = Math.round((e.t - s.t) * 100) / 100;
              if (d !== 0 && !$v("P705_OBS")) {
                apex.message.alert("Diferença de " + c705brl(d) + ". Escreva a justificativa para conciliar mesmo assim.");
                return;
              }
              apex.message.confirm("Conciliar " + e.q + " lançamento(s) do extrato com " + s.q + " do sistema?",
                function (ok) { if (ok) { apex.submit("CONCILIAR"); } });
            }
            function c705Ignorar() {
              var e = c705soma("f01");
              if (!e.q) { apex.message.alert("Marque os lançamentos do extrato que serão ignorados."); return; }
              if (!$v("P705_OBS")) { apex.message.alert("Escreva o motivo no campo Justificativa / motivo."); return; }
              apex.message.confirm("Ignorar " + e.q + " lançamento(s) do extrato?",
                function (ok) { if (ok) { apex.submit("IGNORAR"); } });
            }
            function c705Desfazer() {
              var e = c705soma("f01");
              if (!e.q || e.pend === e.q) { apex.message.alert("Marque lançamentos conciliados ou ignorados para desfazer."); return; }
              apex.message.confirm("Desfazer a conciliação de " + (e.q - e.pend) + " lançamento(s)? Eles voltam para pendente.",
                function (ok) { if (ok) { apex.submit("DESFAZER"); } });
            }
            $(function () {
              c705tot();
              $(document).on("change", "input[name=f01], input[name=f02]", c705tot);
              $(document).on("apexafterrefresh", c705tot);
            });
            ```
    }
    css {
        inline:
            ```css
            .c705-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;padding:12px}
            .c705-card{background:#f7f7f7;border-radius:8px;padding:14px 16px;border-left:4px solid #c8c8c8}
            .c705-card .t{font-size:13px;color:#707070}
            .c705-card .v{font-size:24px;font-weight:500;margin-top:2px}
            .c705-card .s{font-size:11px;color:#909090;margin-top:2px}
            .c705-graf{display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:16px;padding:0 12px 12px}
            .c705-tit{font-size:13px;font-weight:600;margin-bottom:8px}
            .c705-leg{font-size:11px;color:#707070;margin-top:6px}
            .c705-leg i{display:inline-block;width:10px;height:10px;border-radius:2px;margin:0 4px 0 10px;vertical-align:middle}
            .c705-b{display:inline-block;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:600;white-space:nowrap}
            .c705-ok{background:#e3f4e6;color:#2e7d32}
            .c705-pend{background:#fff1dc;color:#b26a00}
            .c705-ign{background:#ececec;color:#606060}
            .c705-D{color:#c62828;white-space:nowrap}
            .c705-C{color:#2e7d32;white-space:nowrap}
            #sel705{display:flex;flex-wrap:wrap;gap:24px;font-size:14px;padding:6px 0}
            .c705-dif-ok{color:#2e7d32}
            .c705-dif-ko{color:#c62828}
            ```
