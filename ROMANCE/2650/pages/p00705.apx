    region extrato-do-banco (
        name: Extrato do banco
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select apex_item.checkbox2( p_idx        => 1
                                          , p_value      => q.idextratobancario
                                          , p_attributes => 'data-v="' || to_char(q.valor, 'FM999999999990D00', 'NLS_NUMERIC_CHARACTERS=''.,''')
                                                            || '" data-s="' || q.situacao || '"' ) sel
                     , q.datamov data
                     , ( select substr(cb.beneficiario, 1, 22) from contasbancarias cb
                          where cb.idcontabanc = q.idcontabanc ) conta
                     , q.movimentacao descricao
                     , q.detalhe complemento
                     , '<span class="c705-' || q.tipo || '">' || to_char(q.valor, 'FML999G999G999G990D00') || '</span>' valor
                     , initcap(replace(q.categoria, '_', ' ')) categoria
                     , case q.situacao
                         when 'CONCILIADO' then '<span class="c705-b c705-ok">Conciliado</span>'
                         when 'IGNORADO'   then '<span class="c705-b c705-ign">Ignorado</span>'
                         else                   '<span class="c705-b c705-pend">Pendente</span>'
                       end situacao
                     , case q.situacao
                         when 'PENDENTE' then
                           nvl2(q.sugestao, '<span style="color:#1e88e5">Sugestão: ' || apex_escape.html(q.sugestao) || '</span>', null)
                         when 'CONCILIADO' then
                           ( select listagg( case when cc.idpagamentofornecedor is not null
                                                  then 'Fatura ' || cc.idpagamentofornecedor || ' '
                                                       || substr(pck_romance.fnc_nomefornecedor(pf.idfornecedor), 1, 28)
                                                  else 'Depósito ' || cc.idregistrocontabancaria end, '; ')
                                       within group (order by cc.idconciliacao)
                               from conciliacoesbancarias cc
                               left join pagamentosfornecedores pf on pf.idpgtoforn = cc.idpagamentofornecedor
                              where cc.idextratobancario = q.idextratobancario )
                       end || case when q.observacao is not null
                                   then '<div style="font-size:11px;color:#909090">' || apex_escape.html(q.observacao) || '</div>' end vinculo
                     , case q.regra when 'AUTO_API'      then 'Automático (API)'
                                    when 'AUTO_FATURA'   then 'Automático (fatura)'
                                    when 'AUTO_DEPOSITO' then 'Automático (depósito)'
                                    when 'REGRA'         then 'Regra'
                                    when 'MANUAL'        then 'Manual'
                       end || case when q.usuario is not null and q.usuario <> 'SISTEMA' then ' - ' || q.usuario end
                           || case when q.dt_situacao is not null then ' ' || to_char(q.dt_situacao, 'DD/MM HH24:MI') end quem
                  from ( select inf.idextratobancario, inf.idcontabanc, inf.datamov, inf.categoria, inf.situacao
                              , inf.regra, inf.usuario, inf.dt_situacao, inf.observacao
                              , e.movimentacao, e.detalhe, e.valor, e.tipo
                                -- sugestao so para pendente (uma consulta por linha)
                              , case when inf.situacao = 'PENDENTE'
                                     then roman.pck_extrato_bancario.fnc_sugestao(e.idextratobancario) end sugestao
                           from extratos_bancarios_info inf
                           join extratosbancarios e on e.idextratobancario = inf.idextratobancario
                          where inf.datamov between nvl(to_date(:P705_DE,  'DD/MM/RRRR'), trunc(sysdate) - 7)
                                                and nvl(to_date(:P705_ATE, 'DD/MM/RRRR'), trunc(sysdate))
                            and ( :P705_CONTA is null or inf.idcontabanc = :P705_CONTA )
                            and ( nvl(:P705_SITUACAO, 'TODOS') = 'TODOS' or inf.situacao = :P705_SITUACAO )
                            and ( :P705_TIPO is null or e.tipo = :P705_TIPO )
                            and ( :P705_BUSCA is null
                                  or upper(e.movimentacao || ' ' || e.detalhe || ' ' || to_char(abs(e.valor), 'FM999999999990D00'))
                                     like '%' || upper(:P705_BUSCA) || '%' ) ) q
                 order by q.datamov desc, abs(q.valor) desc
                ```
        }
