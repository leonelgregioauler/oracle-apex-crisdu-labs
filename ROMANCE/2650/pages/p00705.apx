    process ler-extrato-do-banco (
        name: Ler extrato do banco
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  roman.pck_extrato_bancario.prc_importar_async(
                    pidcontabanc => :P705_CONTA,
                    pdtini       => nvl(to_date(:P705_DE,  'DD/MM/RRRR'), trunc(sysdate) - 2),
                    pdtfim       => nvl(to_date(:P705_ATE, 'DD/MM/RRRR'), trunc(sysdate)),
                    pusuario     => :APP_USER );
                exception
                  when others then
                    apex_error.add_error(
                      p_message          => regexp_replace(sqlerrm, '^ORA-[0-9]+: ', ''),
                      p_display_location => apex_error.c_inline_in_notification);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Leitura do extrato iniciada em segundo plano. Em 1 a 3 minutos clique em Filtrar para ver os lançamentos (a conciliação automática roda em seguida).
        }
        advanced {
            executionMappingIdentifier: 971000000000705070
        }
        serverSideCondition {
            whenButtonPressed: @importar
        }
    )

    branch (
        name: Go To Page 705
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 705
            }
        }
    )

)

