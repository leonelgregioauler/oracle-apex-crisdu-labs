            type: sqlQuery
            sqlQuery:
                ```sql
                select substr(cb.beneficiario, 1, 30) || ' - ' || b.nomebanco || ' ' || cb.agencia || '/' || cb.conta d
                     , cb.idcontabanc r
                  from contasbancarias cb
                  join bancos b on b.idbanco = cb.idbanco
                 where cb.idcontabanc in ( select sc.idcontabanc from santander_contas sc where sc.ativo = 'S'
                                           union
                                           select i.idcontabanc from extratos_bancarios_info i )
                 order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: " - Todas -"
