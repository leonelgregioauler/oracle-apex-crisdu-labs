    region painel (
        name: Painel
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                  vde   date := nvl(to_date(:P705_DE,  'DD/MM/RRRR'), trunc(sysdate) - 7);
                  vate  date := nvl(to_date(:P705_ATE, 'DD/MM/RRRR'), trunc(sysdate));
                  vqc   number; vqp number; vqi number; vqpd number; vqpc number;
                  vvc   number; vvp number; vvpd number; vvpc number;
                  vsq   number; vsv number;
                  vsaldo number; vsaldo_dt date; vapl number; vnsaldo number;
                  vmax  number;
                  vtot  number;
                  vimp  varchar2(400);
                
                  function brl ( p in number ) return varchar2 is
                  begin
                    return 'R$ ' || to_char(nvl(p, 0), 'FM999G999G999G990D00');
                  end brl;
                
                  procedure cartao ( ptit in varchar2, pval in varchar2, psub in varchar2, pcor in varchar2 ) is
                  begin
                    htp.p('<div class="c705-card" style="border-left-color:' || pcor || '">'
                       || '<div class="t">' || ptit || '</div><div class="v">' || pval || '</div>'
                       || '<div class="s">' || psub || '</div></div>');
                  end cartao;
                
                  procedure barra_h ( prot in varchar2, ptotal in number, pconc in number, pmax in number, pdir in varchar2 ) is
                  begin
                    htp.p('<div style="margin-bottom:9px">'
                       || '<div style="display:flex;justify-content:space-between;font-size:12px;color:#505050">'
                       || '<span>' || apex_escape.html(prot) || '</span><span>' || pdir || '</span></div>'
                       || '<div style="background:#eee;border-radius:3px;height:12px;margin-top:3px">'
                       || '<div style="background:#f0b25a;border-radius:3px;height:12px;width:'
                       || case when nvl(pmax, 0) = 0 then 0 else greatest(round(100 * ptotal / pmax), 1) end || '%">'
                       || '<div style="background:#43a047;border-radius:3px;height:12px;width:'
                       || case when nvl(ptotal, 0) = 0 then 0 else round(100 * pconc / ptotal) end || '%"></div>'
                       || '</div></div></div>');
                  end barra_h;
                begin
                  select count(case when inf.situacao = 'CONCILIADO' then 1 end)
                       , count(case when inf.situacao = 'PENDENTE'   then 1 end)
                       , count(case when inf.situacao = 'IGNORADO'   then 1 end)
                       , count(case when inf.situacao = 'PENDENTE' and e.tipo = 'D' then 1 end)
                       , count(case when inf.situacao = 'PENDENTE' and e.tipo = 'C' then 1 end)
                       , nvl(sum(case when inf.situacao = 'CONCILIADO' then abs(e.valor) end), 0)
                       , nvl(sum(case when inf.situacao = 'PENDENTE'   then abs(e.valor) end), 0)
                       , nvl(sum(case when inf.situacao = 'PENDENTE' and e.tipo = 'D' then abs(e.valor) end), 0)
                       , nvl(sum(case when inf.situacao = 'PENDENTE' and e.tipo = 'C' then abs(e.valor) end), 0)
                    into vqc, vqp, vqi, vqpd, vqpc, vvc, vvp, vvpd, vvpc
                    from extratos_bancarios_info inf
                    join extratosbancarios e on e.idextratobancario = inf.idextratobancario
                   where inf.datamov between vde and vate
                     and ( :P705_CONTA is null or inf.idcontabanc = :P705_CONTA );
                
                  select count(*), nvl(sum(abs(s.valor)), 0)
                    into vsq, vsv
                    from vw_conciliacao_sistema s
                   where s.conciliado = 'N'
                     and s.data between vde and vate
                     and s.data_ref between vde - 10 and vate + 10
                     and ( :P705_CONTA is null or s.idcontabanc = :P705_CONTA );
                
                  select sum(x.disponivel), min(x.dt_consulta), sum(x.aplicado), count(*)
                    into vsaldo, vsaldo_dt, vapl, vnsaldo
                    from ( select s.*, row_number() over (partition by s.idcontabanc order by s.data desc) rn
                             from extratos_bancarios_saldos s
                            where :P705_CONTA is null or s.idcontabanc = :P705_CONTA ) x
                   where x.rn = 1;
                
                  select max(to_char(i.dt_inicio, 'DD/MM HH24:MI') || ' - ' || lower(i.status) || ' (' || i.novos || ' novos)')
                           keep (dense_rank last order by i.idimport)
                    into vimp
                    from extratos_bancarios_import i
                   where :P705_CONTA is null or i.idcontabanc = :P705_CONTA;
                
                  vtot := vvc + vvp;
                
                  htp.p('<div style="padding:8px 12px 0;font-size:12px;color:#707070">Período ' || to_char(vde, 'DD/MM/YYYY')
                     || ' a ' || to_char(vate, 'DD/MM/YYYY') || ' • Última leitura do banco: ' || nvl(vimp, 'nenhuma')
                     || case when roman.pck_extrato_bancario.fnc_importacao_rodando() = 'S'
                             then ' • <b style="color:#b26a00">leitura em andamento...</b>' end || '</div>');
                
                  htp.p('<div class="c705-cards">');
                  cartao('Conciliado', case when vtot > 0 then round(100 * vvc / vtot) || '%' else '-' end,
                         vqc || ' de ' || (vqc + vqp) || ' lançamento(s) • ' || brl(vvc), '#43a047');
                  cartao('Pendente no extrato', brl(vvp),
                         vqpd || ' débito(s) ' || brl(vvpd) || ' • ' || vqpc || ' crédito(s) ' || brl(vvpc), '#f0b25a');
                  cartao('No sistema sem extrato', brl(vsv),
                         vsq || ' lançamento(s) baixado(s) sem par no banco', '#e53935');
                  cartao('Saldo no banco', case when vnsaldo > 0 then brl(vsaldo) else '-' end,
                         case when vnsaldo > 0 then 'consulta ' || to_char(vsaldo_dt, 'DD/MM HH24:MI')
                              || case when vapl > 0 then ' • aplicado ' || brl(vapl) end
                              else 'sem leitura' end, '#1e88e5');
                  cartao('Ignorados', to_char(vqi), 'aplicação/resgate automático e outros sem par no sistema', '#9e9e9e');
                  htp.p('</div>');
                
                  htp.p('<div class="c705-graf">');
                
                  -- 1) Por dia: barra empilhada (conciliado embaixo, pendente em cima)
                  htp.p('<div><div class="c705-tit">Movimento por dia (valor)</div>');
                  select nvl(max(t), 0) into vmax
                    from ( select sum(abs(e.valor)) t
                             from extratos_bancarios_info inf
                             join extratosbancarios e on e.idextratobancario = inf.idextratobancario
                            where inf.datamov between vde and vate
                              and ( :P705_CONTA is null or inf.idcontabanc = :P705_CONTA )
                            group by inf.datamov );
                  if vmax = 0 then
                    htp.p('<div style="color:#909090;font-size:13px">Nenhum lançamento do banco no período. Use "Ler extrato do banco".</div>');
                  else
                    htp.p('<div style="display:flex;align-items:flex-end;gap:6px;height:170px">');
                    for r in ( select inf.datamov d
                                    , sum(case when inf.situacao = 'CONCILIADO' then abs(e.valor) else 0 end) c
                                    , sum(case when inf.situacao = 'PENDENTE'   then abs(e.valor) else 0 end) p
                                    , sum(case when inf.situacao = 'IGNORADO'   then abs(e.valor) else 0 end) i
                                 from extratos_bancarios_info inf
                                 join extratosbancarios e on e.idextratobancario = inf.idextratobancario
                                where inf.datamov between vde and vate
                                  and ( :P705_CONTA is null or inf.idcontabanc = :P705_CONTA )
                                group by inf.datamov
                                order by inf.datamov )
                    loop
                      htp.p('<div style="flex:1;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;gap:3px"'
                         || ' title="' || to_char(r.d, 'DD/MM') || ': conciliado ' || brl(r.c) || ', pendente ' || brl(r.p)
                         || ', ignorado ' || brl(r.i) || '">'
                         || '<span style="font-size:10px;color:#707070">'
                         || case when r.c + r.p > 0 then round(100 * r.c / (r.c + r.p)) || '%' else '-' end || '</span>'
                         || '<div style="width:100%;display:flex;flex-direction:column">'
                         || '<div style="background:#bdbdbd;height:' || round(140 * r.i / vmax) || 'px"></div>'
                         || '<div style="background:#f0b25a;height:' || round(140 * r.p / vmax) || 'px"></div>'
                         || '<div style="background:#43a047;height:' || greatest(round(140 * r.c / vmax), case when r.c > 0 then 1 else 0 end) || 'px"></div>'
                         || '</div><span style="font-size:11px;color:#606060">' || to_char(r.d, 'DD/MM') || '</span></div>');
                    end loop;
                    htp.p('</div><div class="c705-leg"><i style="background:#43a047"></i>Conciliado<i style="background:#f0b25a"></i>Pendente'
                       || '<i style="background:#bdbdbd"></i>Ignorado • o % é do valor conciliado no dia</div>');
                  end if;
                  htp.p('</div>');
                
                  -- 2) Por categoria (o que o banco movimentou e quanto ja bateu)
                  htp.p('<div><div class="c705-tit">Por tipo de lançamento</div>');
                  select nvl(max(t), 0) into vmax
                    from ( select sum(abs(e.valor)) t
                             from extratos_bancarios_info inf
                             join extratosbancarios e on e.idextratobancario = inf.idextratobancario
                            where inf.datamov between vde and vate and inf.situacao <> 'IGNORADO'
                              and ( :P705_CONTA is null or inf.idcontabanc = :P705_CONTA )
                            group by inf.categoria );
                  for r in ( select initcap(replace(nvl(inf.categoria, 'OUTROS'), '_', ' ')) cat
                                  , count(*) q
                                  , sum(abs(e.valor)) t
                                  , sum(case when inf.situacao = 'CONCILIADO' then abs(e.valor) else 0 end) c
                               from extratos_bancarios_info inf
                               join extratosbancarios e on e.idextratobancario = inf.idextratobancario
                              where inf.datamov between vde and vate and inf.situacao <> 'IGNORADO'
                                and ( :P705_CONTA is null or inf.idcontabanc = :P705_CONTA )
                              group by inf.categoria
                              order by 3 desc )
                  loop
                    barra_h(r.cat || ' (' || r.q || ')', r.t, r.c, vmax,
                            brl(r.t) || ' • ' || case when r.t > 0 then round(100 * r.c / r.t) end || '% conciliado');
                  end loop;
                  htp.p('<div class="c705-leg"><i style="background:#43a047"></i>Conciliado<i style="background:#f0b25a"></i>Pendente</div></div>');
                
                  -- 3) Por conta (so quando o filtro e todas)
                  if :P705_CONTA is null then
                    htp.p('<div><div class="c705-tit">Por conta</div>');
                    select nvl(max(t), 0) into vmax
                      from ( select sum(abs(e.valor)) t
                               from extratos_bancarios_info inf
                               join extratosbancarios e on e.idextratobancario = inf.idextratobancario
                              where inf.datamov between vde and vate and inf.situacao <> 'IGNORADO'
                              group by inf.idcontabanc );
                    for r in ( select ( select substr(cb.beneficiario, 1, 30) || ' ' || cb.agencia || '/' || cb.conta
                                          from contasbancarias cb where cb.idcontabanc = inf.idcontabanc ) conta
                                    , count(case when inf.situacao = 'PENDENTE' then 1 end) qp
                                    , sum(abs(e.valor)) t
                                    , sum(case when inf.situacao = 'CONCILIADO' then abs(e.valor) else 0 end) c
                                 from extratos_bancarios_info inf
                                 join extratosbancarios e on e.idextratobancario = inf.idextratobancario
                                where inf.datamov between vde and vate and inf.situacao <> 'IGNORADO'
                                group by inf.idcontabanc
                                order by 3 desc )
                    loop
                      barra_h(r.conta, r.t, r.c, vmax,
                              case when r.t > 0 then round(100 * r.c / r.t) end || '% • ' || r.qp || ' pendente(s)');
                    end loop;
                    htp.p('</div>');
                  end if;
                
                  htp.p('</div>');
                end;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region sistema-sem-conciliação (
        name: Sistema sem conciliação
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select apex_item.checkbox2( p_idx        => 2
                                          , p_value      => s.chave
                                          , p_attributes => 'data-v="' || to_char(s.valor, 'FM999999999990D00', 'NLS_NUMERIC_CHARACTERS=''.,''') || '"' ) sel
                     , s.data
                     , ( select substr(cb.beneficiario, 1, 22) from contasbancarias cb
                          where cb.idcontabanc = s.idcontabanc ) conta
                     , s.nome
                     , s.documento
                     , '<span class="c705-' || case when s.valor < 0 then 'D' else 'C' end || '">'
                       || to_char(s.valor, 'FML999G999G999G990D00') || '</span>' valor
                     , s.origem
                     , s.chave
                  from vw_conciliacao_sistema s
                 where s.conciliado = 'N'
                   and s.data between nvl(to_date(:P705_DE,  'DD/MM/RRRR'), trunc(sysdate) - 7) - 3
                                  and nvl(to_date(:P705_ATE, 'DD/MM/RRRR'), trunc(sysdate)) + 3
                   and s.data_ref between nvl(to_date(:P705_DE,  'DD/MM/RRRR'), trunc(sysdate) - 7) - 10
                                      and nvl(to_date(:P705_ATE, 'DD/MM/RRRR'), trunc(sysdate)) + 10
                   and ( :P705_CONTA is null or s.idcontabanc = :P705_CONTA )
                   and ( :P705_TIPO is null or ( :P705_TIPO = 'D' and s.valor < 0 ) or ( :P705_TIPO = 'C' and s.valor > 0 ) )
                   and ( :P705_BUSCA is null
                         or upper(s.nome || ' ' || s.documento || ' ' || to_char(abs(s.valor), 'FM999999999990D00'))
                            like '%' || upper(:P705_BUSCA) || '%' )
                 order by s.data desc, abs(s.valor) desc
                ```
        }
        layout {
            sequence: 50
            slot: body
            startNewRow: false
            columnSpan: 5
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 500
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " "
        }
        pagination {
            type: setPaginationSelectList
        }
        messages {
            whenNoDataFound: Nada do sistema pendente nesse período.
        }
        download {
            csvExportEnabled: true
        }

