    process conciliar-automaticamente (
        name: Conciliar automaticamente
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  roman.pck_extrato_bancario.prc_conciliar_auto(
                    pidcontabanc => :P705_CONTA,
                    pdtini       => nvl(to_date(:P705_DE, 'DD/MM/RRRR'), trunc(sysdate) - 30) );
                exception
                  when others then
                    apex_error.add_error(
                      p_message          => regexp_replace(sqlerrm, '^ORA-[0-9]+: ', ''),
                      p_display_location => apex_error.c_inline_in_notification);
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Conciliação automática concluída. O que tinha um único par no sistema foi conciliado.
        }
        advanced {
            executionMappingIdentifier: 971000000000705071
        }
        serverSideCondition {
            whenButtonPressed: @auto
        }
    )

    process conciliar-selecionados (
        name: Conciliar selecionados
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  roman.pck_extrato_bancario.prc_conciliar_manual(
                    pextratos => apex_util.table_to_string(apex_application.g_f01, ':'),
                    psistema  => apex_util.table_to_string(apex_application.g_f02, ':'),
                    pusuario  => :APP_USER,
                    pobs      => :P705_OBS );
                  :P705_OBS := null;
                exception
                  when others then
                    apex_error.add_error(
                      p_message          => regexp_replace(sqlerrm, '^ORA-[0-9]+: ', ''),
                      p_display_location => apex_error.c_inline_in_notification);
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Conciliado.
        }
        advanced {
            executionMappingIdentifier: 971000000000705072
        }
        serverSideCondition {
            type: request=Value
            value: CONCILIAR
        }
    )

