    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function abrenotadecompra (IDNOTAFISCAL)
            {
              pjanela = window.open('f?p=&APP_ID.:27:&SESSION.::NO:27:P27_IDNOTAFISCAL:'+IDNOTAFISCAL,'popup','toolbar=yes,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1020,height=800,screenX=50,screenY =100');
              pjanela.focus();
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
