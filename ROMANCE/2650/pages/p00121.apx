    pageItem P121_FILIALDESTINO (
        type: popupLov
        label {
            label: Destino
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select (select initcap(nvl(apelido,nomepessoa))
                        from pessoas 
                        where idpessoa = f.idpessoa )|| CASE when v('APP_USER') in ('EVERTON','GUILHERME','LUIZV') then
                                                                    ' - '||f.idfilial
                                                                    end display_value
                     , f.idfilial
                from filiais f
                where f.tipofilial = 'D'
                  and f.ativo = 'S'
                ```
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P121_IDFORNECEDOR (
        type: popupLov
        label {
            label: Fornecedor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.idfornecedor||' - '||p.nomepessoa display_value
                 , f.idfornecedor return_value
                from fornecedores f
                , pessoas p
                where f.idpessoa = p.idpessoa
                ```
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
