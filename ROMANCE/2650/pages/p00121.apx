    region relatório-de-recebimento-de-compras (
        name: Relatório de Recebimento de Compras
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nf.idnotafiscal
                     , nf.dtnf
                     , nf.datainclusao
                     , nf.dataconfirmacao
                     , nf.datarecebimento
                     , nf.documento
                     , nvl(pck_romance.fnc_nomefornecedor(nf.idfornemitente),pck_romance.fnc_nomefilial(nf.idfilialemitente))"Emitente"
                     , nvl(pck_romance.fnc_nomefornecedor(nf.idfornecedordestino),pck_romance.fnc_nomefilial(nf.idfilialdestino))"Destino"
                     , pck_romance.fnc_nomeproduto(i.idproduto) "Produto"
                     , i.qtd_total "Total Enviada"
                     , i.qtd_total_chegou "Total Recebida"
                     , i.qtd_total_chegou - i.qtd_total "Diferença"
                     , i.iditnf 
                from notasfiscais nf
                   , itemnf i
                where nf.idnotafiscal = i.idnotafiscal
                  and nf.situacaofilial = 'R'
                  and nf.emailrecebimento = 'S'
                  and ( :P121_IDFORNECEDOR is null or nf.idfornemitente = :P121_IDFORNECEDOR )
                  and ( :P121_FILIALDESTINO is null or nf.idfilialdestino = :P121_FILIALDESTINO )
                  and ( :P121_DATAINI is null  or ( :P121_TIPODATA = 'E' and trunc(nf.datainclusao) between to_date(:P121_DATAINI,'dd/mm/rrrr') and to_date(:P121_DATAFIM,'dd/mm/rrrr') )
                                               or ( :P121_TIPODATA = 'R' and trunc(nf.datarecebimento) between to_date(:P121_DATAINI,'dd/mm/rrrr') and to_date(:P121_DATAFIM,'dd/mm/rrrr') ) )
                group by nf.idnotafiscal
                 , nf.dtnf
                 , nf.datainclusao
                 , nf.dataconfirmacao
                 , nf.documento
                 , nf.idfornemitente
                 , nf.idfornecedordestino
                 , nf.datarecebimento
                 , nf.idfilialemitente
                 , nf.idfilialdestino
                 , i.idproduto
                 , i.qtd_total
                 , i.qtd_total_chegou
                 , iditnf
                order by idnotafiscal desc
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
