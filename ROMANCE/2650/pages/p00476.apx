    pageItem P476_IDCONCILIACAO (
        type: hidden
        layout {
            sequence: 10
            region: @conciliações-em-lote
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P476_IDEXTRATO (
        type: hidden
        layout {
            sequence: 20
            region: @conciliações-em-lote
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button deletar (
        buttonName: DELETAR
        label: Excluir Conciliações
        layout {
            sequence: 30
            region: @conciliações-em-lote
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--danger
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process deleta-conciliação (
        name: Deleta Conciliação
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  
                  delete conciliacoesbancariaslote c
                  where c.idextratobancario = :P476_IDEXTRATO;
                  
                  delete conciliacoesbancarias cc
                  where cc.idextratobancario = :P476_IDEXTRATO;
                  
                  update extratosbancarios ex
                  set ex.conciliado = 'P'
                  where ex.idextratobancario = :P476_IDEXTRATO;
                  
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 3075540237984412801
        }
        serverSideCondition {
            whenButtonPressed: @deletar
        }
    )

)

