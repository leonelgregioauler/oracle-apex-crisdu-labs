page 476 (
    name: Conciliações em Lote
    title: Conciliações em Lote
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region conciliações-em-lote (
        name: Conciliações em Lote
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select vv.valor valordoc
                     , x.*
                     , case 
                         when x.doc is not null then
                           '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=2650:26:'||v('APP_SESSION')||'::NO::P26_DOCUMENTO,P26_ANO,P26_IDFORNECEDOR:'||x.doc||','||x.ano||','||x.forne,'SESSION')||''',''_blank''); void(0);"><img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt=""/></a>'
                         else
                         '-'
                       end ir_pnota
                from ( select ex.agencia
                            , (select distinct(c.conta||' Beneficiario: '||c.beneficiario)
                               from contasbancarias c
                                  , bancos b
                               where c.idpessoa = 16625
                                 --and c.agencialimpa = ex.agencia
                                 --and c.contalimpa   = ex.conta
                                 and SUBSTR(c.agencia, 1, INSTR(c.agencia, '-') - 1) = ex.agencia
                                 and SUBSTR(c.conta, 1, INSTR(c.conta, '-') - 1) = ex.conta 
                                 and b.idbanco = c.idbanco
                                 and b.idbanco = ex.idbanco
                                 and c.ativo = 'S') conta
                            , ex.datamovimentacao
                            , ex.idextratobancario
                            , ex.movimentacao
                            , ex.valor
                            , decode(ex.tipo,'C','Crédito','D','Débito') tipo
                            , ex.detalhe
                            , ex.numerodocumento
                            , case 
                                when cl.iddepositodiario is not null then 
                                  cl.iddepositodiario
                                when cl.idpagamentofornecedor is not null then 
                                  cl.idpagamentofornecedor
                                when cl.idnotavenda is not null then
                                  cl.idnotavenda 
                                when cl.idpedido is not null then 
                                  cl.idpedido
                                when cl.idboleto is not null then 
                                  cl.idboleto
                                when cl.idnegociacaoparceiro is not null then 
                                  cl.idnegociacaoparceiro
                                when cl.idregistrocontabancaria is not null then
                                  cl.idregistrocontabancaria 
                              end id
                           , ( select nf.documento
                                 from pagamentosfornecedores pf
                                    , notasfiscais nf
                                where pf.idpgtoforn = nvl(cl.idpagamentofornecedor,cb.idpagamentofornecedor)
                                  and nf.idnotafiscal = pf.idnotafiscal ) doc
                            , ( select to_char(nf.dtnf,'RRRR') ANO
                                 from pagamentosfornecedores pf
                                    , notasfiscais nf
                                where pf.idpgtoforn = nvl(cl.idpagamentofornecedor,cb.idpagamentofornecedor)
                                  and nf.idnotafiscal = pf.idnotafiscal ) ano
                            , ( select pf.idfornecedor idforne
                                 from pagamentosfornecedores pf
                                    , notasfiscais nf
                                where pf.idpgtoforn = nvl(cl.idpagamentofornecedor,cb.idpagamentofornecedor)
                                  and nf.idnotafiscal = pf.idnotafiscal) forne
                            , case
                                when nvl(cl.idpagamentofornecedor,cb.idpagamentofornecedor) is not null then
                                   ( select rr.cnpj
                                     from pagamentosfornecedores pf
                                        , notasfiscais nf
                                        , razoessociaisfiliais rr
                                     where pf.idpgtoforn = nvl(cl.idpagamentofornecedor,cb.idpagamentofornecedor)
                                       and nf.idnotafiscal = pf.idnotafiscal
                                       and rr.idrazaosocialfilial = nf.idrazaosocialfildestino )
                              end cnpj
                       from conciliacoesbancariaslote cl
                          , conciliacoesbancarias cb 
                          , extratosbancarios ex
                       where cl.idconciliacao = cb.idconciliacao
                         and cl.idextratobancario = ex.idextratobancario ) x
                    , vw_movimentosvalores vv
                where /*vv.id = x.id
                  and*/ vv.idextratobancario = x.idextratobancario
                  and vv.documento = x.numerodocumento
                  --and vv.idextratobancario = :P476_IDEXTRATO
                  and x.idextratobancario = :P476_IDEXTRATO
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
