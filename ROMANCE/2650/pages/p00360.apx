    region apoio-de-regras-para-saídas-lançadas (
        name: Apoio de Regras para Saídas Lançadas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.idsaida
                     , s.idfilial
                     , s.data
                     , (select nomeconta
                        from contasfinanceiras c
                        where c.idcontafinan = s.idcontacontabil) conta
                     , (select nomeconta
                        from subcontasfinanceiras sc
                        where sc.idsubcontafinan = s.idsubcontacontabil) subconta
                     , s.valortotal
                     , s.descricao
                     , s.idmatrizclassificacao
                     , ( select cc.nome
                         from centrodecustos cc
                            , matrizclassificacoesdespesas mc
                         where mc.idmatrizclassificacao = s.idmatrizclassificacao
                           and mc.idcentrodecusto       = cc.idcentrodecusto ) centrodecusto
                from saidasdiversas s
                where ( :P360_TIPOPESQUISA = 'T'
                      or ( :P360_TIPOPESQUISA = 'S' and exists ( select 1
                                                                 from fechamentossemanais f
                                                                 where f.idfechamento = s.idfechamento
                                                                   and f.idfilial     = s.idfilial
                                                                   and f.idsemana     = :P360_IDSEMANA ) )
                      or ( :P360_TIPOPESQUISA = 'P' and trunc(s.data) between to_date(:P360_DATAINICIO) and to_date(:P360_DATAFIM) ) )
                  and ( :P360_IDFILIAL is null or s.idfilial = :P360_IDFILIAL )
                  and ( :P360_COM_MATRIZ = 'A'
                    or ( :P360_COM_MATRIZ = 'S' and s.idmatrizclassificacao is null )
                    or ( :P360_COM_MATRIZ = 'C' and s.idmatrizclassificacao is not null ) )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
