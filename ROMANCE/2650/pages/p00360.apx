page 360 (
    name: Apoio de Regras para Despesas Lançadas
    title: Apoio de Regras para Despesas Lançadas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region apoio-de-regras-para-despesas-lançadas (
        name: Apoio de Regras para Despesas Lançadas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.iddespesa
                     , d.idfilial
                     , d.datavencimento
                     , d.datalancamento
                     , (select nomeconta
                        from contasfinanceiras c
                        where c.idcontafinan = d.idcontacontabil) conta
                     , (select nomeconta
                        from subcontasfinanceiras s
                        where s.idsubcontafinan = d.idsubcontacontabil) subconta
                     , d.valor
                     , d.observacao
                     , d.descricaoorigem
                     , d.idmatrizclassificacao
                     , d.iddespesa ID
                     , ( select cc.nome
                         from centrodecustos cc
                            , matrizclassificacoesdespesas mc
                         where mc.idmatrizclassificacao = d.idmatrizclassificacao
                           and mc.idcentrodecusto       = cc.idcentrodecusto ) centrodecusto
                from DESPESAS d
                where ( :P360_TIPOPESQUISA = 'T'
                      or ( :P360_TIPOPESQUISA = 'S' and exists ( select 1
                                                                 from fechamentossemanais f
                                                                 where f.idfechamento = d.idfechamento
                                                                   and f.idsemana     = :P360_IDSEMANA ) )
                      or ( :P360_TIPOPESQUISA = 'P' and trunc(d.datavencimento) between to_date(:P360_DATAINICIO) and to_date(:P360_DATAFIM) ) )
                   and ( :P360_IDFILIAL is null or d.idfilial = :P360_IDFILIAL )
                  and ( :P360_COM_MATRIZ = 'A'
                    or ( :P360_COM_MATRIZ = 'S' and d.idmatrizclassificacao is null )
                    or ( :P360_COM_MATRIZ = 'C' and d.idmatrizclassificacao is not null ) )
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        performance {
            lazyLoading: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 4099753257511424306
        }

