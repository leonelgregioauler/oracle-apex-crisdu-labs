    pageItem P360_IDSEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(s.semana,'00')||'/'||s.ano d
                     , s.idsemana r
                from semana_dias s
                where s.ano between extract(year from sysdate)-1 and extract(year from sysdate)
                order by 2 
                ```
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P360_TIPOPESQUISA (
        type: radioGroup
        label {
            label: Pesquisar Por
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Semana;S,Período Lançamento;P
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    button aplicar (
        buttonName: APLICAR
        label: Aplicar Alterações
        layout {
            sequence: 10
            region: @apoio-de-regras-para-saídas-lançadas
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
    )

    button buscar (
        buttonName: BUSCAR
        label: Buscar Despesas
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button ir-para-redirecionamento (
        buttonName: IR_PARA_REDIRECIONAMENTO
        label: Direcionar Despesas
        layout {
            sequence: 10
            region: @ações-especiais
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 370
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Aplicar Alterações
        layout {
            sequence: 10
            region: @apoio-de-regras-para-despesas-lançadas
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
    )

    dynamicAction tipo (
        name: Tipo
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P360_TIPOPESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P360_TIPOPESQUISA
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P360_IDSEMANA
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P360_DATAINICIO
                    P360_DATAFIM
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P360_IDSEMANA
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P360_DATAINICIO
                    P360_DATAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    process apoio-de-regras-para-despesas-lançadas-save-interactive-grid-data (
        name: Apoio de Regras para Despesas Lançadas - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @apoio-de-regras-para-despesas-lançadas
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 4099754477033424318
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process apoio-de-regras-para-saídas-lançadas-save-interactive-grid-data (
        name: Apoio de Regras para Saídas Lançadas - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @apoio-de-regras-para-saídas-lançadas
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 4099757599778424349
        }
        serverSideCondition {
            whenButtonPressed: @aplicar
        }
    )

    branch (
        name: Go To Page 360
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 360
                items: {
                    P360_TIPOPESQUISA: &P360_TIPOPESQUISA.
                    P360_IDSEMANA: &P360_IDSEMANA.
                    P360_IDFILIAL: &P360_IDFILIAL.
                    P360_DATAINICIO: &P360_DATAINICIO.
                    P360_DATAFIM: &P360_DATAFIM.
                    P360_COM_MATRIZ: &P360_COM_MATRIZ.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

)

