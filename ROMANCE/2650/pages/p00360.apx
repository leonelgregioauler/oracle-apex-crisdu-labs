        column IDMATRIZCLASSIFICACAO (
            type: selectList
            heading {
                heading: Matriz de Despesa
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select ' - Sem Matriz -' d
                         , null r
                    from dual
                    union
                    select m.classificacaodespesa||' / Centro de Custo: '||( select cc.nome
                                                                             from centrodecustos cc
                                                                             where cc.idcentrodecusto = m.idcentrodecusto )
                                                 ||' - Conta: '||( select nomeconta
                                                                   from contasfinanceiras c
                                                                   where c.idcontafinan = m.idcontafinan)
                                                 ||' / SubConta: '||( select nomeconta
                                                                      from subcontasfinanceiras s
                                                                      where s.idsubcontafinan = m.idsubcontafinan ) d
                         , m.idmatrizclassificacao r
                    from matrizclassificacoesdespesas m
                    where m.idfilial = :IDFILIAL
                      and m.ativo = 'S'
                    order by 1
                    ```
            }
            cascadingLov {
                parentColumns: IDFILIAL
            }
            layout {
                sequence: 120
            }
            source {
                databaseColumn: IDMATRIZCLASSIFICACAO
                dataType: number
            }
        )

