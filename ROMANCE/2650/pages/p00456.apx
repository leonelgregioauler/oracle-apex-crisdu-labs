    pageItem P456_CARACTERISTICA (
        type: selectList
        label {
            label: Classificação
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Todos' descricao
                     , -1 idcaracteristicanegociacao
                  from caracteristicasnegociacoes t
                union
                select t.descricao
                     , t.idcaracteristicanegociacao
                  from caracteristicasnegociacoes t
                order by 2
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: static
            staticValue: -1
        }
        security {
            encryptSessionState: false
        }
    )

