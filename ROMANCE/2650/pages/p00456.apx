page 456 (
    name: Negociações Classificadas
    title: Negociações Classificadas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region negociações (
        name: Negociações
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ne.idnegociacao
                     , pck_romance.fnc_nomerepresentante(ne.idrepresentante) distribuidor
                     , ca.descricao
                     , ne.data
                     , ne.valor
                     , nvl(ne.entrada,0) entrada
                     , nvl(ne.valorjuros,0) valorjuros
                     , ne.valortotal
                     , nvl(ne.valorpago,0) valorpago
                     , nvl(ne.saldo,0) saldo
                  from vw_negociacoes_rmc ne
                     , classificacoesnegociacoes cn
                     , caracteristicasnegociacoes ca
                 where ne.idnegociacao = cn.idnegociacao
                   and cn.idcaracteristicanegociacao = ca.idcaracteristicanegociacao
                   and (:P456_DATA_INICIO is null or trunc(ne.data) between :P456_DATA_INICIO and :P456_DATA_FIM)
                   and (:P456_CARACTERISTICA = -1 or cn.idcaracteristicanegociacao = :P456_CARACTERISTICA)
                order by ne.data
                ```
        }
        layout {
            sequence: 10
            parentRegion: @negociações-classificadas
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Registros não encontrados
        }
        advanced {
            savedReportMappingIdentifier: 1506033859559891131
        }

