page 91 (
    name: Saídas Diversas
    title: Saídas Diversas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region saídas (
        name: Saídas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.idfechamento
                     , pck_romance.fnc_nomefilial(s.idfilial) filial
                     , to_number(substr(f.semana,4,4)) "Ano"
                     , to_number(substr(f.semana,1,2)) "Semana"
                     , f.semana
                     , s.idsaida
                     , s.idfilialdest
                     , pck_romance.fnc_nomefilial(s.idfilialdest) filialdestino
                     , s.descricao
                     , s.valortotal
                     , decode(s.tipo,'D','Dinheiro','Pagamento de Conta') tipo
                     , pck_romance.fnc_nomecontafinan(s.idcontacontabil) "Conta Contabil" 
                     , pck_romance.fnc_nomesubcontafinan(s.idsubcontacontabil) "Sub Conta Contabil"
                     , S.DATA
                     , s.idsaida ID
                     , nvl(( select count(1)
                             from anexossaidas a
                             where a.idsaida = s.idsaida ),0) qtdanexos
                     , observacaocontrole
                     , s.fatorconversao
                     , case 
                         when ( select ff.idgrupo
                                from vw_filiais ff
                                where ff.idfilial = s.idfilial ) = 5 and nvl(( select ff.idgrupo
                                                                               from vw_filiais ff
                                                                               where ff.idfilial = s.idfilialdest ),1) != 5  then
                           s.valortotal * nvl(f.fatorconversao,1)
                         when nvl(( select ff.idgrupo
                                    from vw_filiais ff
                                    where ff.idfilial = s.idfilial ),1) != 5 and nvl(( select ff.idgrupo
                                                                                from vw_filiais ff
                                                                                where ff.idfilial = s.idfilialdest ),1) = 5 then
                           s.valortotal / nvl(s.fatorconversao,f.fatorconversao)
                         else
                           s.valortotal
                       end valorconversao
                     , ( select m.classificacaodespesa
                         from matrizclassificacoesdespesas m
                         where m.idmatrizclassificacao = s.idmatrizclassificacao ) matrizclassificacao
                     , s.datalancamento
                     , (select distinct c.nome
                        from roman.matrizclassificacoesdespesas mc
                           , roman.centrodecustos c
                        where mc.idcentrodecusto       = c.idcentrodecusto
                          and s.idmatrizclassificacao  = mc.idmatrizclassificacao) "Centro de Custo"
                from fechamentossemanais f
                   , saidasdiversas      s
                where f.idfechamento = s.idfechamento
                  and ((:P0_IDFECHAMENTO = 999999999999 and  f.idfilial = :P0_IDFILIALCAIXA)
                        or f.idfechamento = :P0_IDFECHAMENTO )
                order by 1, 2 desc, 3 desc
                ```
        }
        layout {
            sequence: 10
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhuma saída incluída.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

