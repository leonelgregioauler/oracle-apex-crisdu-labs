    button novasaida (
        buttonName: NOVASAIDA
        label: Nova Saída
        layout {
            sequence: 50
            region: @saídas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 93
                items: {
                    P93_IDFILIAL: &P0_IDFILIALCAIXA.
                    P93_IDSAIDA:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentossemanais s
                where idfechamento = :P0_IDFECHAMENTO
                  and concluido = 'N'
                ```
        }
    )

    button novo-questionamento (
        buttonName: NOVO_QUESTIONAMENTO
        label: Novo Questionamento
        layout {
            sequence: 40
            region: @saídas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 433
                items: {
                    P433_QUESTIONAMENTO:
                    P433_IDFECHAMENTO: &P0_IDFECHAMENTO.
                    P433_IDQUESTIONAMENTO:
                    P433_IDFILIAL: &P0_IDFILIALCAIXA.
                    P433_PAGINA: 91
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuariosgruposatendimento ug
                where ug.idgrupoatendimento in ( 2 , 0 )
                  and ug.usuario = v('APP_USER')
                  and :P0_IDFECHAMENTO is not null
                ```
        }
    )

    button revisarsaidas (
        buttonName: revisarsaidas
        label: Revisar Saídas
        layout {
            sequence: 60
            region: @saídas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 70
                items: {
                    P70_ORIGEM: S
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util.fnc_verificaacesso(2309,v('APP_USER') ) = 'S'
                ```
        }
    )

)

