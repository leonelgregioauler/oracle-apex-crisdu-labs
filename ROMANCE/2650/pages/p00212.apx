page 212 (
    name: Cadastro
    title: Cadastro
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='Deseja realmente deletar?';
        executeWhenPageLoads:
            ```javascript-browser
            window.opener.location.reload(); 
            
            if ( document.getElementById("P212_IDCATEGORIA").value == '')
            {
            window.close();
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region cadastro (
        name: Cadastro
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P212_IDCARACTERISTICACATEG (
        type: hidden
        layout {
            sequence: 10
            region: @cadastro
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDCARACTERISTICACATEG
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P212_IDCATEGORIA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @cadastro
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDCATEGORIA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P212_NOME (
        type: textField
        label {
            label: Nome
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @cadastro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 100
        }
        source {
            type: databaseColumn
            databaseColumn: NOME
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P212_TIPO (
        type: selectList
        label {
            label: Tipo
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Modelo;D,Característica;C,Gênero;S,Material;M
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @cadastro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: TIPO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 50
            region: @cadastro
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P212_IDCARACTERISTICACATEG
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @cadastro
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P212_IDCARACTERISTICACATEG
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo+
        layout {
            sequence: 40
            region: @cadastro
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P212_IDCARACTERISTICACATEG
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Alterações
        layout {
            sequence: 30
            region: @cadastro
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P212_IDCARACTERISTICACATEG
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @cadastro
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 9
                items: {
                    P9_IDCATEGORIA: &P212_IDCATEGORIA.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process fetch-row-from-caracteristicascategorias (
        name: Fetch Row from CARACTERISTICASCATEGORIAS
        type: autoRowFetch
        source {
            tableName: CARACTERISTICASCATEGORIAS
            pkColumn: IDCARACTERISTICACATEG
            pkItem: P212_IDCARACTERISTICACATEG
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1009483502389953265
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P212_IDCARACTERISTICACATEG is null then
                        select "SEQ_IDCARACTERISTICACATEG".nextval
                          into :P212_IDCARACTERISTICACATEG
                          from dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1009483723539953268
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-caracteristicascategorias (
        name: Process Row of CARACTERISTICASCATEGORIAS
        type: autoRowProcessing
        target {
            tableName: CARACTERISTICASCATEGORIAS
            pkColumn: IDCARACTERISTICACATEG
            pkItem: P212_IDCARACTERISTICACATEG
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        advanced {
            executionMappingIdentifier: 1009483926343953268
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 1009484103292953268
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 11
        }
        behavior {
            target: {
                page: 212
                items: {
                    P212_IDCATEGORIA: &P212_IDCATEGORIA.
                    P212_IDCARACTERISTICACATEG:
                    P212_TIPO:
                    P212_NOME:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    branch (
        name: Go To Page 212
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 212
            }
        }
        serverSideCondition {
            type: request!=Value
            value: NOVO
        }
    )

)

