page 532 (
    name: Novo Orçamento
    alias: NOVO-ORÇAMENTO
    title: Novo Orçamento
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 40%
        height: 60%
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            $(document).on("click", ".ui-dialog-titlebar-close", function (e) {
                e.preventDefault();
                e.stopImmediatePropagation();
            
                $("#BTN_FECHAR").trigger("click");
            });
            
            ```
    }
    css {
        inline:
            ```css
            
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region novo-orçamento (
        name: Novo Orçamento
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P532_ANO (
        type: selectList
        label {
            label: Ano Base das Despesas
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ANO D, ANO R
                FROM (
                        SELECT EXTRACT(YEAR FROM SYSDATE) -2 "ANO" FROM DUAL
                        UNION
                        SELECT EXTRACT(YEAR FROM SYSDATE) -1 "ANO" FROM DUAL
                        UNION
                        SELECT EXTRACT(YEAR FROM SYSDATE)  "ANO" FROM DUAL
                )
                WHERE ANO < :P532_ANO_ORCAMENTO
                ```
        }
        cascadingLov {
            parentItems: P532_ANO_ORCAMENTO
        }
        layout {
            sequence: 50
            region: @novo-orçamento
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P532_ANO_ORCAMENTO (
        type: selectList
        label {
            label: Ano do Novo Orçamento
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ANO D, ANO R
                FROM (
                SELECT EXTRACT(YEAR FROM SYSDATE)  "ANO" FROM DUAL 
                UNION
                SELECT EXTRACT(YEAR FROM SYSDATE) + 1 "ANO" FROM DUAL
                UNION
                SELECT EXTRACT(YEAR FROM SYSDATE) + 2 "ANO" FROM DUAL
                )
                
                ```
        }
        layout {
            sequence: 40
            region: @novo-orçamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P532_IDGRUPONEGOCIO (
        type: hidden
        layout {
            sequence: 80
            region: @novo-orçamento
            slot: regionBody
        }
    )

    pageItem P532_IDUNIDADEDENEGOCIO (
        type: hidden
        layout {
            sequence: 70
            region: @novo-orçamento
            slot: regionBody
        }
    )

    pageItem P532_MESFINAL (
        type: selectList
        label {
            label: Até Mês
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.mes
                     , to_number(m.numero) numero
                from meses m
                order by m.numero
                ```
        }
        layout {
            sequence: 30
            region: @novo-orçamento
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P532_MESINICIAL (
        type: selectList
        label {
            label: Mês de
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.mes
                     , to_number(m.numero) numero
                from meses m
                order by m.numero
                ```
        }
        layout {
            sequence: 20
            region: @novo-orçamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P532_ORCAMENTO_ZERADO (
        type: radioGroup
        label {
            label: Ano ou Base Zero
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC:Ano COM Valor;A,Padrão Base Zero;B,Ano Base Zero;C
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @novo-orçamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        source {
            type: staticValue
            staticValue: N
        }
    )

    pageItem P532_TIPOORCAMENTO (
        type: hidden
        layout {
            sequence: 90
            region: @novo-orçamento
            slot: regionBody
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar/Voltar
        layout {
            sequence: 10
            region: @novo-orçamento
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 531
                items: {
                    P531_PERIODO_ORCAMENTO: &P532_ANO_ORCAMENTO.
                    P531_IDGRUPONEGOCIO: &P532_IDGRUPONEGOCIO.
                    P531_IDUNIDADEDENEGOCIO: &P532_IDUNIDADEDENEGOCIO.
                    P531_TIPOORCAMENTO: &P532_TIPOORCAMENTO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: BTN_FECHAR
        }
    )

    button gerar (
        buttonName: GERAR
        label: Gerar
        layout {
            sequence: 10
            region: @novo-orçamento
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction popula (
        name: Popula1
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P532_MESINICIAL
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: null;
                itemsToSubmit: [
                    P532_MESINICIAL
                    P532_MESFINAL
                    P532_ANO
                    P532_ORCAMENTO_ZERADO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction popula-2 (
        name: Popula2
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P532_MESFINAL
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: null;
                itemsToSubmit: [
                    P532_MESINICIAL
                    P532_MESFINAL
                    P532_ANO
                    P532_ORCAMENTO_ZERADO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction popula-3 (
        name: Popula3
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P532_ANO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: null;
                itemsToSubmit: [
                    P532_MESINICIAL
                    P532_MESFINAL
                    P532_ANO
                    P532_ORCAMENTO_ZERADO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction valida (
        name: Valida
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @gerar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: GERAR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    process gera-orçamento (
        name: Gera Orçamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vexiste   number;
                  v_id      number;
                  v_usuario varchar2(50) := v('APP_USER');
                  v_md5     varchar2(1000);
                  --
                begin
                  --
                  begin
                    select 1 
                      into vexiste
                      from gestaoorcamentariaun w
                     where idunidadedenegocio = :P532_IDUNIDADEDENEGOCIO
                       and idgruponegocio     = :P532_IDGRUPONEGOCIO
                       and anoorcamento       = :P532_ANO_ORCAMENTO
                       and tipoorcamento      = :P532_TIPOORCAMENTO
                       and (:P532_MESINICIAL between mesinicial and mesfinal or 
                            :P532_MESFINAL   between mesinicial and mesfinal)
                       and rownum = 1;
                  exception
                    when others then null;
                  end;
                  --
                  if nvl(vexiste,0) > 0 then
                    raise_application_error(-20001,'Já existe orçamento para este GRUPO, UNIDADE e TIPO ORÇAMENTO informados!');
                  end if;
                  --
                  /*begin
                    select 1 
                      into vexiste
                      from vw_matrizclassificacoesdesp m
                         , filiais f
                         , unidadesdenegocios u
                     where  m.idfilial = f.idfilial
                       and m.charregra in ('C', 'D', 'X', 'I')
                       and f.idunidadedenegocio = u.idunidadedenegocio
                       and u.idunidadedenegocio = :P532_IDUNIDADEDENEGOCIO
                       and rownum = 1;
                  exception
                    when others then vexiste := 0;
                  end;
                  --
                  if nvl(vexiste,0) = 0 then
                    raise_application_error(-20001,'Não há matriz de classificacao para esta unidade de negocio!');
                  end if;  */
                  --
                  pck_gestaoorcamentaria_un.prc_gestaoorcamentariaun(pidunidadedenegocio     => :P532_IDUNIDADEDENEGOCIO,
                                                                     pidgruponegocio         => :P532_IDGRUPONEGOCIO,
                                                                     panoorcamento           => :P532_ANO_ORCAMENTO,
                                                                     panoreferencia          => :P532_ANO,
                                                                     ptipoclassificacao      => :P532_ORCAMENTO_ZERADO,
                                                                     ptipoorcamento          => :P532_TIPOORCAMENTO,
                                                                     pusuario                => v_usuario,
                                                                     pmesinicio              => :P532_MESINICIAL,
                                                                     pmesfim                 => :P532_MESFINAL,
                --                                                     pmd5                    => v_md5,
                                                                     poperacao_dml           => 'I');  
                
                  
                  COMMIT;
                       
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Orçamento gerado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1800205064205288264
        }
        serverSideCondition {
            type: request=Value
            value: GERAR
        }
    )

    process populacampos (
        name: PopulaCampos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P532_IDGRUPONEGOCIO     := :P531_IDGRUPONEGOCIO;
                :P532_IDUNIDADEDENEGOCIO := :P531_IDUNIDADEDENEGOCIO;
                :P532_TIPOORCAMENTO      := :P531_TIPOORCAMENTO;
                
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1799653123760571812
        }
    )

)

