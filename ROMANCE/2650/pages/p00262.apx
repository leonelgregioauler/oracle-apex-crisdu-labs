page 262 (
    name: Desfazer Saldo Depositado
    title: Desfazer Saldo Depositado
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region desfazer-saldo-depositado (
        name: Desfazer Saldo Depositado
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: Informe o ID do depósito de saldo.
        }
    )

    pageItem P262_DDEPOSITO (
        type: textField
        label {
            label: Cod Depósito
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 10
            region: @desfazer-saldo-depositado
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Processar
        layout {
            sequence: 10
            region: @desfazer-saldo-depositado
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
    )

    process run-stored-procedure (
        name: Run Stored Procedure
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                PCK_ROMANCE.PRC_DESFAZSALDODEPOSITO(
                PIDDEPOSITO => :P262_DDEPOSITO);
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo efetuado.
        }
        error {
            errorMessage: Ocorreu um erro ao processar, registre um evento.
        }
        advanced {
            executionMappingIdentifier: 505960004666620304
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 262
            }
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

)

