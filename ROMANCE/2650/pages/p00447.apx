    button ir-requisicao (
        buttonName: IR_REQUISICAO
        label: Let's Go!
        layout {
            sequence: 20
            region: @para-uso-t-i
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--stretch
                t-Button--gapBottom
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 448
                items: {
                    P448_IDREQUISICAO: &P447_IDREQUISICAOPGTO.
                    P448_ATENDIMENTOO: &P447_ATENDIMENTOO.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button nova-requisicao (
        buttonName: Nova_Requisicao
        label: Nova Requisição
        layout {
            sequence: 10
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 448
                items: {
                    P448_IDREQUISICAO:
                    P448_IDMOEDA: 1
                }
                clearCache: 448
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from dual
                  where favorita.pck_util_fav.fnc_verificaacesso(441, pidusuario => favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S' -- t9993579
                  --where  v('APP_USER') in ('LETICIAMEDEIROS', 'FRANCIELEPETRY') -- T9553617 > ESTE CONTROLE FOI AJUSTADO PARA OBEDECER PARAMETROS NO t9993579
                ```
        }
    )

    branch (
        name: Go To Page 675
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 447
                items: {
                    P447_DATAINICIO: &P447_DATAINICIO.
                    P447_DATAFIM: &P447_DATAFIM.
                    P447_SITUACAO: &P447_SITUACAO.
                    P447_FILTRAR: S
                }
                action: resetPagination
            }
        }
    )

)

