            )

            filter ir-condition-2 (
                column: CNPJDEST
                operator: in
                value: 23267786000103,51655441000162,51828627000176,55072620000128,51828627000257,15332237000147,31770527000129,14698061000189,19941894000142,23284088000116,13505669000187,09480114000150,46732027000170,19707412000194,19707412000194,47900332000196,22995206000131,28769704000142,32404720000109,20095036000103,42835674000156,18685277000160,30340985000165,09198297000116,47890014000191,48083236000165,48649384000102,46732027000250,49740464000123,46847578000189,45288998000100,48429844000189 ,50487006000103,32404720000109,32404720000109,47890014000191,47900332000196,21641313000107,49740464000123,14610551000181
                advanced {
