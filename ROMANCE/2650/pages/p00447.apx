page 447 (
    name: Requisicao de Pagamento
    title: Requisicao de Pagamento
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ações (
        name: "Ações "
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 30
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region para-uso-t-i (
        name: Para Uso T.I
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from roman.usuariosgruposatendimento u
                 where u.idgrupoatendimento = 0
                   and u.usuario = v('APP_USER')--'MAICONAIMI'
                ```
        }
    )

    region requisições-realizadas (
        name: Requisições Realizadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idrequisicaopgto
                     , t.Filial_origem
                     , t.Documento
                     , t.Tip_Documento
                     , t.datainclusao 
                     , t.usuarioinclusao
                     , t.situacao
                     , t.Fornecedor
                     , t.contafinanceira
                     , t.subcontafinanceira
                     , t.valor
                     , t.desconto 
                     , t.acrescimo
                     , t.valortotal
                     , t.vencimento
                     , t.parcelas
                     , t.qtd_anexos "Qtd Anexos"
                     , t.comprovante_pgto "comprovante pgto"
                     , t.usuarioaprovacao
                     , t.cnpjdest
                     , t.idsituacao
                     , decode(t.fiscal,'S','Sim','Não') fiscal
                     , t.observacao
                     , t.liberado_fiscal
                     , t.centro_custo
                     , t.nome_destino
                     , (select g.grupo from gruposfinanceiros g, razoessociaisfiliais rf where g.idgrupofinanceiro = rf.idgrupofinanceiro and rf.cnpj = t.cnpjdest and rownum=1) grupo_financeiro
                  from(       
                       select r.idrequisicaopgto
                            , roman.pck_romance.fnc_nomefilial(r.idfilial) Filial_origem
                            , r.documento Documento
                            , ( select descricao 
                                from roman.formaspagamentos fp
                                where fp.idformapagamento = r.idformapagamento)Tip_Documento
                            , r.datainclusao 
                            , r.usuarioinclusao
                            , decode(r.idsituacao,1,'Pendente',2,'Atendimento Financeiro',3,'Atendimento Fiscal',4,'Ajuste Lançamento',5,'Concluído Fiscal',6,'Programado',7,'Quitado',8,'Cancelado',10,'Programado - Fiscal Pendente',11,'Programado - Ajuste Fiscal Pendente',12,'Quitado - Fiscal Pendente',13,'Quitado - Ajuste Fiscal Pendente') situacao
                            , roman.pck_romance.fnc_nomefornecedor(r.idfornecedor)Fornecedor
                            , md.contafinanceira
                            , md.subcontafinanceira
                            , r.valor
                            , r.desconto 
                            , r.acrescimo
                            , r.valortotal
                            , r.vencimento
                            , ( select count(*) || '/' || r.parcelas
                                  from roman.pagamentosfornecedores pgf
                                 where pgf.idnotafiscal = r.idnotafiscal ) parcelas
                            , ( select count(1) from roman.anexosrequisicoes a where a.idrequisicaopgto = r.idrequisicaopgto) Qtd_Anexos
                            , ( select count(1) from roman.anexosrequisicoes a 
                                where a.idrequisicaopgto = r.idrequisicaopgto 
                                  and a.comprovantepgto = 'S') comprovante_pgto
                            , r.usuarioaprovacao
                            , case 
                                 when r.idgrupo is null then
                                   ( select rs.cnpj--||'-'||rs.razaosocial 
                                     from roman.razoessociaisfiliais rs
                                        , roman.requisicoespagamentos rq
                                     where rs.idfilial = rq.idfilialdestino
                                      and rs.idrazaosocialfilial = rq.idrazaosocialdest 
                                      and rq.idrequisicaopgto = r.idrequisicaopgto )
                               else 
                                   ( select rs.cnpj--||'-'||rs.razaosocial 
                                     from roman.razoessociaisfiliais rs
                                        , roman.requisicoespagamentos rq
                                     where rs.idfilial  = rq.idgrupo
                                       and rs.idrazaosocialfilial = rq.idfilialdestgr 
                                       and rq.idrequisicaopgto = r.idrequisicaopgto )
                               end cnpjdest
                           , r.idsituacao
                           , r.fiscal
                           , r.observacao
                           , (r.usuariofinalizadofiscal||' - '||to_char(r.datafinalizadofiscal,'dd/mm/yyyy hh24:mi:ss')) liberado_fiscal
                           , r.idfilialdestino destino
                           , pck_romance.fnc_nomefilial(r.idfilialdestino) nome_destino
                           , ( select c.nome from centrodecustos c, matrizregrasdespesas m where m.idmatrizregra = r.idmatrizdespesa and c.idcentrodecusto = m.idcentrodecusto and rownum=1) centro_custo
                       from roman.requisicoespagamentos r
                         , roman.vw_matrizregrasdespesas md
                       where r.idmatrizdespesa = md.idmatrizregra(+)
                         and ( :P447_TIPODATA = 'I' and  trunc(r.datainclusao) between to_date(:P447_DATAINICIO) and to_date(:P447_DATAFIM) or :P447_DATAINICIO is null and :P447_DATAFIM is null 
                            or :P447_TIPODATA = 'V' and  trunc(r.vencimento) between to_date(:P447_DATAINICIO) and to_date(:P447_DATAFIM) or :P447_DATAINICIO is null and :P447_DATAFIM is null )
                         and (   :P447_SITUACAO is null
                              or ( :P447_SITUACAO = 2
                                   and r.idsituacao in (2, 3, 5) )
                              or ( :P447_SITUACAO = 3
                                   and ( r.idsituacao in (3, 10, 11, 12, 13)
                                         or ( r.idsituacao = 2 and nvl(r.fiscal,'N') = 'S' and r.datafinalizadofiscal is null ) ) )
                              or ( :P447_SITUACAO not in (2, 3) and r.idsituacao = :P447_SITUACAO ) )
                       --and r.idsituacao  != 8 
                         and (:P447_ANTECIPACAO is null or r.antecipacao = :P447_ANTECIPACAO )
                         and (:P447_IDFILIAL is null or r.idfilial = :P447_IDFILIAL )
                         and (:P447_COMPROVANTEPGTO is null or r.comprovantepgto = :P447_COMPROVANTEPGTO )
                         and :P447_FILTRAR = 'S'
                         and (:P447_ENVIAR_SETOR_FISCAL is null or r.fiscal = :P447_ENVIAR_SETOR_FISCAL)
                 ) t
                 where ( :P447_ATENDIMENTOO in ('FIN','TODOS') or
                         (:P447_ATENDIMENTOO = 'COM' and substr(replace(cnpjdest,'.',''),1,8) in ('48320045','45397622','45300144','58279786','58011726','58762135') 
                           or t.usuarioinclusao = 'MICHELEZIMPEL') or  --Equipe fiscal comercio, CNPJ RAIZ: 48.320.045, 45.397.622, 45.300.144. / (T10172827 - ADAPTO - CNPJ 58279786000108 / CAPTALEADS - CNPJ 58011726000100)
                          :P447_ATENDIMENTOO = 'IND' and substr(replace(cnpjdest,'.',''),1,8) in ('07318638','59370062') ) -- Equipe fiscal indústria, CNPJ RAIZ: 07.318.638 (59.370.062/0001-38 add t10032867)
                 order by 1 desc
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1126504150225190373
        }

