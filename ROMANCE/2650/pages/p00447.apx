    pageItem P447_SITUACAO (
        type: selectList
        label {
            label: Situação
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select '-- Todas --' display_value
                     , null return_value
                  from dual
                 where :P447_ATENDIMENTOO = 'FIN'
                
                union
                
                select s.situacao display_value
                     , s.idsituacao return_value
                  from roman.situacoesrequisicoes s
                 where :P447_ATENDIMENTOO = 'FIN'
                
                union
                
                select s.situacao display_value
                     , s.idsituacao return_value
                  from roman.situacoesrequisicoes s
                 where s.idsituacao in (2, 3, 5, 10, 11, 12, 13)
                   and  :P447_ATENDIMENTOO in ('COM', 'IND')
                
                union
                
                select s.situacao display_value
                     , s.idsituacao return_value
                  from roman.situacoesrequisicoes s
                 where :P447_ATENDIMENTOO in ('COM', 'IND')
                   and v('APP_USER') in  (  'MAICONAIMI', 
                                            'EDUARDAZOTTI',
                                            'DIEGOPIECHO',
                                            'GABRIELLYMACHADO',
                                            'FLAVIANALIMA',
                                            'MARCIAD',
                                            'SIMONES',
                                            'GENISONF',
                                            'LUANAMS',
                                            'MARIANEMACIEL',
                                            'SHEILAVANONI',
                                            'MICHELEZIMPEL',
                                            'CHARLIENEA',
                                            'GABRIELLYMACHADO',
                                            'RAIANAS',
                                            'SABRINAVIANNA',
                                            'THIAGOALMEIDA',
                                            'FLAVIANALIMA',
                                            'THIAGOALMEIDA',
                                            'MARIANEV',
                                            'GENISONF',
                                            'LUANASOUZA',
                                            'CLADYCAVALCANTE',
                                            'POLIANESHIRMER',
                                            'RAMILEDENTE',
                                            'CLAUDIR',
                                            'SABRINAFV', -- T9542368
                                            'CLARARICK',  -- T9542368
                                            'RENATAK', -- 9963562
                                            'LAIZACOSTA', -- 10372046
                                            'KARENOLEQUES', -- 11253491
                                            'VYTORIABLAUTH', -- 12643725
                                            'MIRELAMULLER', -- 12728821
                                            'TATIANECM',
                                            'CRISTIANAROLDO', -- 14781511
                                            'EMELIW') ---16225649
                union
                
                select '-- Todas --' display_value
                     , null return_value
                  from dual
                 where :P447_ATENDIMENTOO in ('COM', 'IND')
                   and v('APP_USER') in  ( 'DIEGOPIECHO'
                                         , 'EDUARDAZOTTI'
                                         , 'MAICONAIMI'
                                         , 'MARCIAD'
                                         , 'SIMONES'
                                         , 'GENISONF'
                                         , 'LUANAMS'
                                         , 'MARIANEMACIEL'
                                         , 'SHEILAVANONI'
                                         , 'MICHELEZIMPEL'
                                         , 'CHARLIENEA'
                                         , 'GABRIELLYMACHADO'
                                         , 'TATIANECM'
                                         , 'RAIANAS'
                                         , 'SABRINAVIANNA'
                                         , 'THIAGOALMEIDA'
                                         , 'FLAVIANALIMA'
                                         , 'THIAGOALMEIDA'
                                         , 'MARIANEV'
                                         , 'GENISONF'
                                         , 'LUANASOUZA'
                                         , 'CLADYCAVALCANTE'
                                         , 'POLIANESHIRMER'
                                         , 'HAYANES'
                                         , 'CLAUDIR' -- T9488264
                                         , 'SABRINAFV' --T9542368
                                         , 'WILLIAMSANTOS' --T9937660
                                         , 'RENATAK' --9963562
                                         , 'KARENOLEQUES'-- 11253491
                                         , 'MIRELAMULLER'-- 14736631
                                         , 'LISIANEOLIVEIRA'--13993104
                                         , 'CRISTIANAROLDO' --14812338
                                         , 'EMELIW') -- 16225649
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P447_ATENDIMENTOO
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

