            alignment: left
        }
        settings {
            checkedValue: S
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P447_ATENDIMENTOO (
        type: selectList
        label {
            label: Atendimento
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Fiscal Indústria', 'IND'-- Opção disponível para todos os usuários
                  from dual
                
                union
                
                -- Opção disponível para todos os usuários
                select 'Fiscal Comércio', 'COM'
                  from dual
                
                union
                
                -- Opção disponível apenas para os usuários listados abaixo e para o time de T.I.
                select 'Financeiro', 'FIN'
                  from dual
                 where ( favorita.pck_util_fav.fnc_verificaacesso(442, pidusuario => favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S' -- T10840041
                        /* or ( exists (select 1
                                        from roman.usuariosgruposatendimento ug
                                       where ug.idgrupoatendimento = 0
                                         and ug.usuario = v('APP_USER')))*/)
                
                union
                
                -- Esta opção deve seguir a mesma validação da opção "Financeiro"
                select 'Todos', 'TODOS'
                  from dual
                 where ( favorita.pck_util_fav.fnc_verificaacesso(442, pidusuario => favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S' -- T10840041
                         or ( exists (select 1
                                        from roman.usuariosgruposatendimento ug
                                       where ug.idgrupoatendimento = 0
                                         and ug.usuario = v('APP_USER'))))
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
