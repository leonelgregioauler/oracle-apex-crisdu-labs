        layout {
            sequence: 20
            region: @inclui-ligação
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 268
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Incluir
        layout {
            sequence: 10
            region: @inclui-ligação
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P274_IDCONTROLE
        }
    )

    validation p274-telefone (
        name: P274_TELEFONE
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P274_TELEFONE
        }
        error {
            errorMessage: Informe o telefone!
            associatedItem: @P274_TELEFONE
        }
    )

    process fetch-row-from-controleligacoes (
        name: Fetch Row from CONTROLELIGACOES
        type: autoRowFetch
        source {
            tableName: CONTROLELIGACOES
            pkColumn: IDCONTROLE
            pkItem: P274_IDCONTROLE
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 529976420157710859
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                  if :P274_IDCONTROLE is null then
                    select "SEQ_IDCONTROLELIGACOES".nextval
                    into :P274_IDCONTROLE
                    from sys.dual;
                  end if;
                  --
                  begin
                    select t.idoperadoratel
                    into :P274_IDOPERADORAtel
                    from telefonespessoas t
                    where t.telefone like '%'||:P274_TELEFONE
                      and rownum = 1;
                  exception
                    when others then
                      null;
                  end;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 529976610285710859
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process inclui-inicio (
        name: inclui inicio
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidcontrole   number := :P274_IDCONTROLE;
                begin
                  --
                  update controleligacoes
                  set situacao = 'E'
                  where idcontrole = vidcontrole;
                  --
                  insert into historicoligacoes (idhistoricoligacoes, idcontroleligacoes, data, usuario, observacao, controletempo)
                  values (seq_idhistoricolig.nextval,  vidcontrole, sysdate, :APP_USER, 'Iniciando tentativa de contato.', 'I');
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 530310214414248348
        }
    )

    process process-row-of-controleligacoes (
        name: Process Row of CONTROLELIGACOES
        type: autoRowProcessing
        target {
            tableName: CONTROLELIGACOES
            pkColumn: IDCONTROLE
            pkItem: P274_IDCONTROLE
            supportedOperations: insert
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Número incluído.
        }
        advanced {
            executionMappingIdentifier: 529976798967710860
        }
    )

    branch (
        name: Go To Page 268
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 268
            }
        }
    )

)

