page 229 (
    name: Logs de Alterações
    title: Logs de Alterações
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region logs-de-alterações (
        name: Logs de Alterações
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.idlogdespesa
                     , e.iddespesa
                     , e.dt_alteracao
                     , decode(e.tipo_alteracao,'I', 'Incluiu', 'U', 'Alterou','D','Deletou') tipoalteracao
                     , e.username
                     , e.datavencimento
                     , e.valor
                     , e.observacao
                     , ( select semana from fechamentossemanais where idfechamento = e.idfechamento ) caixa
                from log_despesas e
                where idfilial = pck_romance.fnc_filialusuario(v('APP_USER'))
                order by 1 desc
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Verifique seu filtro
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 87633411011130882
        }

        column CAIXA (
            type: plainText
            heading {
                heading: Caixa
                alignment: center
            }
            layout {
                sequence: 14
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: CAIXA
                endUserAlias: H
            }
            enableUsersTo {
                pivot: false
            }
        )

        column DATAVENCIMENTO (
            type: plainText
            heading {
                heading: Data Vencto.
                alignment: center
            }
            layout {
                sequence: 12
            }
            source {
                dataType: date
            }
            advanced {
                htmlDomId: DATAVENCIMENTO
                endUserAlias: M
            }
            enableUsersTo {
                pivot: false
            }
        )

        column DT_ALTERACAO (
            type: plainText
            heading {
                heading: Dt Alteração
                alignment: center
            }
            layout {
                sequence: 10
            }
            appearance {
                formatMask: dd/mm/rrrr hh24:mi:ss
            }
            source {
                dataType: date
            }
            advanced {
                htmlDomId: DT_ALTERACAO
                endUserAlias: K
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDDESPESA (
            type: plainText
            heading {
                heading: Iddespesa
                alignment: center
            }
            layout {
                sequence: 8
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDDESPESA
                endUserAlias: J
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDLOGDESPESA (
            type: plainText
            heading {
                heading: Idlogdespesa
                alignment: center
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDLOGDESPESA
                endUserAlias: I
            }
            enableUsersTo {
                pivot: false
            }
        )

        column OBSERVACAO (
            type: plainText
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 15
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: OBSERVACAO
                endUserAlias: O
            }
            enableUsersTo {
                pivot: false
            }
        )

        column TIPOALTERACAO (
            type: plainText
