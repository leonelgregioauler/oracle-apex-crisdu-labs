                heading: Tipo Alteração
                alignment: center
            }
            layout {
                sequence: 9
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: TIPOALTERACAO
                endUserAlias: C
            }
            enableUsersTo {
                pivot: false
            }
        )

        column USERNAME (
            type: plainText
            heading {
                heading: Usuário
                alignment: center
            }
            layout {
                sequence: 11
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: USERNAME
                endUserAlias: L
            }
            enableUsersTo {
                pivot: false
            }
        )

        column VALOR (
            type: plainText
            heading {
                heading: Valor
                alignment: center
            }
            layout {
                sequence: 13
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990d00
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: VALOR
                endUserAlias: N
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 876346 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100
            }

            displayColumn CAIXA (
                sequence: 9
            )

            displayColumn DATAVENCIMENTO (
                sequence: 6
            )

            displayColumn DT_ALTERACAO (
                sequence: 3
            )

            displayColumn IDDESPESA (
                sequence: 2
            )

            displayColumn IDLOGDESPESA (
                sequence: 1
            )

            displayColumn OBSERVACAO (
                sequence: 8
            )

            displayColumn TIPOALTERACAO (
                sequence: 5
            )

            displayColumn USERNAME (
                sequence: 4
            )

            displayColumn VALOR (
                sequence: 7
            )

            sort (
                column: DT_ALTERACAO
                sort {
                    direction: desc
                    sequence: 1
                }
            )

        )

    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @logs-de-alterações
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 81
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

