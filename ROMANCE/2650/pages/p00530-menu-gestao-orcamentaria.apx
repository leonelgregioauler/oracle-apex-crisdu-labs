page 530 (
    name: Menu Gestao Orcamentaria
    alias: MENU-GESTAO-ORCAMENTARIA
    title: Menu Gestao Orcamentaria
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region menu-gestão-orçamentária (
        name: Menu Gestão Orçamentária
        type: list
        source {
            list: @gestaoorcam
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            listTemplate: @/cards
            templateOptions: [
                #DEFAULT#
                t-Cards--featured force-fa-lg
                t-Cards--displayIcons
                t-Cards--cols
                t-Cards--animRaiseCard
            ]
        }
    )

)

