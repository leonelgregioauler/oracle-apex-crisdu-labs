page 522 (
    name: Relatório de Comprovantes
    alias: RELATÓRIO-DE-COMPROVANTES
    title: Relatório de Comprovantes
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1800
        height: 800
    }

    region comprovantes-reprovados (
        name: Comprovantes Reprovados
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    region comprovantes-reprovados-2 (
        name: Comprovantes Reprovados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idcomprovante
                     , c.urlcomprovante
                     , null imagemcomprovante
                     , c.idrepresentante
                     , c.iddepositosdiarios
                     , c.tipopagamento
                     , case
                        when c.tipopagamento = 'D' then 'Débito'
                        when c.tipopagamento = 'P' then 'PIX'
                       end tipopagamentodescricao
                     , c.statuscomprovante
                     , case
                        when c.statuscomprovante = 'P' then 'Pendente de Envio'
                        when c.statuscomprovante = 'A' then 'Aguardando Análise'
                        when c.statuscomprovante = 'C' then 'Confirmado'
                        when c.statuscomprovante = 'R' then 'Reprovado'
                       end statuscomprovantedescricao
                     , c.dataenvio
                     , c.valor
                     , c.observacao
                     , ( select dd.observacao
                         from depositosdiarios_orig dd
                         where dd.iddepositodiarios = c.iddepositosdiarios ) observacaosolicitacao
                from comprovantes c
                where c.iddepositosdiarios = :P522_IDDEPOSITOSDIARIOS
                ```
        }
        layout {
            sequence: 10
            parentRegion: @comprovantes-reprovados
            slot: regionBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 129581793468735647
        }

        column DATAENVIO (
            type: plainText
            heading {
                heading: Data Envio
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: G
            }
        )

        column IDCOMPROVANTE (
            type: plainText
            heading {
                heading: ID Comprovante
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column IDDEPOSITOSDIARIOS (
            type: plainText
            heading {
                heading: ID Depósitos Diários
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column IDREPRESENTANTE (
            type: plainText
            heading {
                heading: ID Representante
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        column IMAGEMCOMPROVANTE (
            type: plainText
            heading {
                heading: Imagem Comprovante
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression: <img src="#URLCOMPROVANTE#" style="max-width:200px;">
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: M
            }
        )

        column OBSERVACAO (
            type: plainText
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 120
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        column OBSERVACAOSOLICITACAO (
            type: plainText
            heading {
                heading: Observação da Solicitação
                alignment: center
            }
            layout {
                sequence: 130
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: L
            }
        )

        column STATUSCOMPROVANTE (
            type: plainText
            heading {
                heading: Status Comprovante
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column STATUSCOMPROVANTEDESCRICAO (
            type: plainText
            heading {
                heading: Status Comprovante
                alignment: center
            }
            layout {
                sequence: 90
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: K
            }
        )

        column TIPOPAGAMENTO (
            type: plainText
            heading {
                heading: Tipo de Pagamento
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column TIPOPAGAMENTODESCRICAO (
            type: plainText
            heading {
                heading: Tipo de Pagamento
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: J
            }
        )

        column URLCOMPROVANTE (
            type: plainText
            heading {
                heading: URL Comprovante
                alignment: center
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression: <a href="#URLCOMPROVANTE#">#URLCOMPROVANTE#</a>
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column VALOR (
            type: plainText
            heading {
                heading: Valor
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G99G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 448894 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAENVIO (
                sequence: 6
            )

            displayColumn IMAGEMCOMPROVANTE (
                sequence: 1
            )

            displayColumn OBSERVACAO (
                sequence: 5
            )

            displayColumn OBSERVACAOSOLICITACAO (
                sequence: 8
            )

            displayColumn STATUSCOMPROVANTEDESCRICAO (
                sequence: 4
            )

            displayColumn TIPOPAGAMENTODESCRICAO (
                sequence: 3
            )

            displayColumn URLCOMPROVANTE (
                sequence: 2
            )

            displayColumn VALOR (
                sequence: 7
            )

        )

    )

    pageItem P522_IDDEPOSITOSDIARIOS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @comprovantes-reprovados-2
            slot: regionBody
        }
    )

)

