    region histórico-de-envios (
        name: Histórico de Envios
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    id,
                    nome_fornecedor,
                    email,
                    status,
                    tentativas,
                    to_char(dt_solicitacao,'DD/MM/RRRR HH24:MI') as dt_solicitacao,
                    to_char(dt_processado, 'DD/MM/RRRR HH24:MI') as dt_processado,
                    usuario_apex,
                    obs
                from fila_envio_saldo
                order by dt_solicitacao desc
                fetch first 50 rows only
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
