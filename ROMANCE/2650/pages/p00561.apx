page 561 (
    name: Envio de Saldo por Fornecedor
    title: Envio de Saldo por Fornecedor
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }
    help {
        helpText: Selecione os fornecedores cujo saldo deseja enviar por e-mail. Marque os desejados e clique em "Agendar Envio".
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region fornecedores-saldo-do-mês (
        name: Fornecedores — Saldo do Mês
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    apex_item.checkbox2(1, p.idpessoa,
                        'class="sel-fornecedor"' ||
                        case when fila.status = 'PENDENTE' then ' disabled' end
                    ) as selecionar,
                    initcap(p.nomepessoa)  as nome,
                    p.email                as email,
                    tf.descricao           as tipo_fornecedor,
                    ( select sum(sf2.considerar)
                      from vw_saldo_fornecedores sf2
                      inner join contasbancarias cb2 on cb2.idcontabanc = sf2.idcontabancaria
                                                    and cb2.idpessoa    = p.idpessoa
                      where to_char(sf2.datamovimento,'MM/RRRR') = to_char(sysdate,'MM/RRRR')
                        and sf2.datamovimento <= trunc(sysdate)
                    ) as saldo_mes_atual,
                    ( select sum(sf3.considerar)
                      from vw_saldo_fornecedores sf3
                      inner join contasbancarias cb3 on cb3.idcontabanc = sf3.idcontabancaria
                                                    and cb3.idpessoa    = p.idpessoa
                      where to_char(sf3.datamovimento,'MM/RRRR') <= to_char(sysdate,'MM/RRRR')
                        and sf3.datamovimento <= trunc(sysdate)
                        and extract(year from sf3.datamovimento) = extract(year from sysdate)
                    ) as saldo_acumulado_ano,
                    case fila.status
                        when 'PENDENTE'    then '<span class="t-Badge t-Badge--warning">Aguardando Envio</span>'
                        when 'PROCESSANDO' then '<span class="t-Badge t-Badge--info">Processando</span>'
                        when 'ENVIADO'     then '<span class="t-Badge t-Badge--success">Enviado</span>'
                        when 'ERRO'        then '<span class="t-Badge t-Badge--danger">Erro no Envio</span>'
                        else null
                    end as situacao_fila,
                    (
                      select max(v.datavencimento)
                      from notasfiscais nf
                         , vencimentos   v
                         , extratoscontasbancarias ex
                      where nf.idnotafiscal   = v.idnotafiscal
                        and nf.idfornemitente = f.idfornecedor
                        and ex.idvencimento   = v.idvencimento
                        and v.datavencimento >= trunc(add_months(sysdate,-1),'MM')   -- 1º dia do mês anterior
                        and v.datavencimento <  add_months(trunc(sysdate,'MM'),1)    -- 1º dia do mês seguinte
                    ) data_ultima_fatura,
                    ( select max(fe.dt_processado)
                      from fila_envio_saldo fe
                      where fe.idpessoa = p.idpessoa
                        and fe.status   = 'ENVIADO'
                    ) dt_ultimo_envio
                from pessoas p
                inner join fornecedores f on f.idpessoa = p.idpessoa
                inner join valorsiglasistema tf on tf.sigla = f.tipo_fornecedor
                inner join siglasistema      ss on ss.idsiglasistema = tf.idsiglasistema
                                                     and ss.nomesigla = 'TIPO_FORNECEDOR'
                left join (
                    select idpessoa, status
                    from fila_envio_saldo
                    where status in ('PENDENTE','PROCESSANDO')
                    and rowid in (
                        select min(rowid)
                        from fila_envio_saldo
                        where status in ('PENDENTE','PROCESSANDO')
                        group by idpessoa
                    )
                ) fila on fila.idpessoa = p.idpessoa
                where exists (
                    select 1 from contasbancarias cb where cb.idpessoa = p.idpessoa
                )
                  and ( f.tipo_fornecedor = :P561_TIPO_FORNECEDOR )
                  and f.ativo = 'S'
                  and :P561_TIPO_FORNECEDOR is not null
                order by tipo_fornecedor, nome
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <div style="margin-bottom:10px;display:flex;align-items:center;gap:16px;">
                  <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-weight:600;">
                    <input type="checkbox" id="toggle-all-forn"> Selecionar todos
                  </label>
                  <span style="font-size:12px;color:#555;">
                    Fornecedores com badge <strong>Aguardando Envio</strong> j&aacute; est&atilde;o na fila.
                  </span>
                </div>
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        download {
            formats: [
                csv
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 5610000000000000031
        }

