    pageItem P561_TIPO_FORNECEDOR (
        type: selectList
        label {
            label: Tipo de Fornecedor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.descricao display_value
                     , v.sigla     return_value
                from siglasistema s
                   , valorsiglasistema v
                where s.idsiglasistema = v.idsiglasistema
                  and s.nomesigla      = 'TIPO_FORNECEDOR'
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button agendar-envio (
        buttonName: AGENDAR_ENVIO
        label: Agendar Envio
        layout {
            sequence: 10
            region: @fornecedores-saldo-do-mês
            slot: belowBox
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-paper-plane
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button buscar (
        buttonName: BUSCAR
        label: Buscar
        layout {
            sequence: 10
            region: @filtros
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction colorir-saldo (
        name: Colorir Saldo
        execution {
            sequence: 20
        }
        when {
            event: apexafterrefresh
            selectionType: region
            region: @fornecedores-saldo-do-mês
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    // Injeta CSS uma unica vez
                    if (!document.getElementById('p561-css')) {
                        var s = document.createElement('style');
                        s.id = 'p561-css';
                        s.textContent = '.saldo-negativo{color:#c53030!important;font-weight:700}'
                            + '.saldo-positivo{color:#276749!important;font-weight:700}'
                            + '.t-Badge{display:inline-block;padding:2px 10px;border-radius:12px;font-size:11px;font-weight:600}'
                            + '.t-Badge--warning{background:#ffc107;color:#333}'
                            + '.t-Badge--info{background:#17a2b8;color:#fff}'
                            + '.t-Badge--success{background:#28a745;color:#fff}'
                            + '.t-Badge--danger{background:#dc3545;color:#fff}';
                        document.head.appendChild(s);
                    }
                    // Colorir celulas de saldo
                    $('.a-IRR-table td[headers*="SALDO_MES_ATUAL"]').each(function(){
                        var txt = $(this).text().replace(/\./g,'').replace(',','.').trim();
                        var val = parseFloat(txt);
                        if (!isNaN(val)) {
                            $(this).toggleClass('saldo-negativo', val < 0);
                            $(this).toggleClass('saldo-positivo', val >= 0);
                        }
                    });
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction toggle-selecionar-todos (
        name: Toggle Selecionar Todos
        execution {
            sequence: 10
            eventScope: dynamic
        }
        when {
            selectionType: jQuerySelector
            jquerySelector: #toggle-all-forn
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var chk = $(this.triggeringElement).prop('checked');
                    $('.sel-fornecedor:not([disabled])').prop('checked', chk);
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process inserir-na-fila-de-envio (
        name: Inserir na Fila de Envio
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_ids   apex_application_global.vc_arr2;
                    l_cnt   NUMBER := 0;
                BEGIN
                    l_ids := apex_application.g_f01;
                
                    IF l_ids.COUNT = 0 THEN
                        apex_error.add_error(
                            p_message          => 'Nenhum fornecedor selecionado.',
                            p_display_location => apex_error.c_on_error_page
                        );
                        RETURN;
                    END IF;
                
                    FOR i IN 1..l_ids.COUNT LOOP
                        MERGE INTO fila_envio_saldo tgt
                        USING (
                            SELECT TO_NUMBER(l_ids(i))  AS idpessoa,
                                   initcap(p.nomepessoa) AS nome,
                                   p.email               AS email
                            FROM   pessoas p
                            WHERE  p.idpessoa = TO_NUMBER(l_ids(i))
                        ) src
                        ON ( tgt.idpessoa = src.idpessoa
                             AND tgt.status IN ('PENDENTE','PROCESSANDO') )
                        WHEN NOT MATCHED THEN
                            INSERT (idpessoa, nome_fornecedor, email, status, usuario_apex)
                            VALUES (src.idpessoa, src.nome, src.email, 'PENDENTE', :APP_USER);
                
                        l_cnt := l_cnt + SQL%ROWCOUNT;
                    END LOOP;
                
                    COMMIT;
                
                    IF l_cnt > 0 THEN
                        DECLARE
                            l_resp CLOB;
                        BEGIN
                            l_resp := apex_web_service.make_rest_request(
                                p_url         => 'https://n8n.romancemoda.com.br/webhook/relatorio-saldo-bancario',
                                p_http_method => 'POST'
                            );
                        EXCEPTION
                            WHEN OTHERS THEN NULL;
                        END;
                    END IF;
                
                    apex_application.g_print_success_message :=
                        l_cnt || CASE l_cnt WHEN 1 THEN ' fornecedor adicionado'
                                            ELSE ' fornecedores adicionados' END ||
                        ' à fila de envio.' ||
                        CASE WHEN l_cnt < l_ids.COUNT
                             THEN ' ' || (l_ids.COUNT - l_cnt) || ' já estavam na fila e foram ignorados.'
                             ELSE '' END;
                
                EXCEPTION
                    WHEN OTHERS THEN
                        ROLLBACK;
                        apex_error.add_error(
                            p_message          => 'Erro ao agendar envio: ' || SQLERRM,
                            p_display_location => apex_error.c_on_error_page
                        );
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 5610000000000000070
        }
        serverSideCondition {
            whenButtonPressed: @agendar-envio
        }
    )

    branch (
        name: Recarregar Filtro
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 561
                items: {
                    P561_TIPO_FORNECEDOR: &P561_TIPO_FORNECEDOR.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

    branch (
        name: Recarregar Apos Agendar
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 561
                items: {
                    P561_TIPO_FORNECEDOR: &P561_TIPO_FORNECEDOR.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @agendar-envio
        }
    )

)

