    region atualizar-comprov-de-depositos (
        name: Atualizar Comprov. de Depositos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select depdia.iddepositodiarios
                     , initcap(pfil.apelido) Filial
                     , initcap(prepres.apelido) Representante
                --contas pagas com depositos
                     , depdia.data  Data_deposito
                     , pgf.dtvencimento Data_vencimento
                     , contbanc.apelidofornecedor Depositado_para
                     , contbanc.nomebanco Banco
                     , contbanc.agencia_conta
                     , contbanc.beneficiario
                     , depdia.valordeposito Valor_depositado
                     , decode (depdia.tipo, 'DD','Depósito Dinheiro'
                                          , 'CR','Cheque Resgate'
                                          , 'CD','Cheque Cobrir'
                                          , 'CC','Depósito Cheque'
                                          , 'AS','Abate Saldo Fornecedor') tipo
                     , decode(depdia.comprovado,'S','Sem Comprovante'
                                               ,'C','Cópia'
                                               ,'M','Em Mãos') Comprovado
                     , depdia.nrocomprovante
                     , depdia.observacao
                     , 'Nota Fiscal nº '||nvl(notafiscal.documento,notafiscal.nrnf) referente_a_doc
                     , notafiscal.dtnf data_doc
                     , notafiscal.valortotal valor_doc
                from depositosdiarios depdia
                   , representantes   repres
                   , pessoas          prepres
                   , filiais          fil
                   , pessoas          pfil
                   , pagamentosfornecedores pgf
                   , ( select cb.idcontabanc
                            , initcap(pf.apelido) ApelidoFornecedor
                            , initcap(pf.nomepessoa) Fornecedor
                            , initcap(bb.nomebanco) nomebanco
                            , cb.agencia ||', '||cb.conta Agencia_Conta
                            , initcap(cb.beneficiario) beneficiario
                       from contasbancarias cb
                          , fornecedores    ff
                          , pessoas         pf
                          , bancos          bb
                       where cb.idfornecedor = ff.idfornecedor
                         and ff.idpessoa     = pf.idpessoa
                         and cb.idbanco      = bb.idbanco ) contbanc
                  , ( select pagforn.idpgtoforn
                           , nf.nrnf
                           , nf.dtnf
                           , sum(v.valor) valortotal
                           , pagforn.dtvencimento
                           , nf.documento
                      from pagamentosfornecedores pagforn
                         , notasfiscais           nf
                         , vencimentos            v
                      where pagforn.idnotafiscal = nf.idnotafiscal
                        and nf.idnotafiscal      = v.idnotafiscal
                        group by pagforn.idpgtoforn
                               , nf.nrnf
                               , nf.dtnf
                               , pagforn.dtvencimento 
                               , nf.documento ) notafiscal          
                where depdia.idrepresentante = repres.idrepresentante(+)
                  and repres.idpessoa        = prepres.idpessoa(+)
                  and repres.idfilial        = fil.idfilial(+)
                  and fil.idpessoa           = pfil.idpessoa(+)
                  and contbanc.idcontabanc   = depdia.idcontabanc
                  and depdia.idpgtoforn      = notafiscal.idpgtoforn
                  and depdia.idpgtoforn      = pgf.idpgtoforn
                  and depdia.idpgtoforn_orig is null
                union -- contas pagas com cheques
                select depdia.iddepositodiarios
                     , contbanc.ApelidoFilial
                     , '' Representante
                     , depdia.data  Data_deposito
                     , pgf.dtvencimento Data_vencimento
                     , contbanc.ApelidoFilial
                     , contbanc.nomebanco
                     , contbanc.agencia_conta
                     , contbanc.beneficiario
                     , depdia.valordeposito Valor_depositado
                     , decode (depdia.tipo, 'DD','Depósito Dinheiro'
                                          , 'CR','Cheque Resgate'
                                          , 'CD','Cheque Cobrir'
                                          , 'CC','Depósito Cheque'
                                          , 'AS','Abate Saldo Fornecedor') tipo
                     , decode(depdia.comprovado,'S','Sim','N','Não') Comprovado
                     , depdia.nrocomprovante
                     , depdia.observacao
                     , 'Nota Fiscal nº '||nvl(notafiscal.documento,notafiscal.nrnf) 
                     , notafiscal.dtnf
                     , notafiscal.valortotal
                from depositosdiarios depdia
                   , pagamentosfornecedores pgf
                   , ( select cbl.idcontabanc
                            , initcap(pf.apelido) ApelidoFilial
                            , initcap(pf.nomepessoa) Filial
                            , initcap(bb.nomebanco) nomebanco
                            , cbl.agencia ||', '||cbl.conta Agencia_Conta
                            , initcap(cbl.beneficiario) beneficiario
                       from contasbancariasfiliais cbl
                          , filiais                ff
                          , pessoas                pf
                          , bancos                 bb
                       where cbl.idfilial = ff.idfilial
                         and ff.idpessoa  = pf.idpessoa
                         and cbl.idbanco  = bb.idbanco ) contbanc
                  , ( select pagforn.idpgtoforn
                           , nf.nrnf
                           , nf.dtnf
                           , sum(v.valor) valortotal
                           , pagforn.dtvencimento
                           , nf.documento 
                      from pagamentosfornecedores pagforn
                         , notasfiscais           nf
                         , vencimentos            v
                      where pagforn.idnotafiscal = nf.idnotafiscal
                        and nf.idnotafiscal      = v.idnotafiscal
                        group by pagforn.idpgtoforn
                               , nf.nrnf
                               , nf.dtnf
                               , pagforn.dtvencimento 
                               , nf.documento ) notafiscal    
                where depdia.idpgtoforn      = notafiscal.idpgtoforn
                  and contbanc.idcontabanc   = depdia.idcontabanc(+)
                  and depdia.idpgtoforn      = pgf.idpgtoforn
                  and depdia.idpgtoforn_orig is null
                union -- cheques cobertos
                select depdia.iddepositodiarios
                     , initcap(pfil.apelido) Filial
                     , initcap(prepres.apelido) Representante
                     , depdia.data  Data_deposito
                     , pgf.dtvencimento Data_vencimento
                     , contbanc.ApelidoFilial
                     , contbanc.nomebanco
                     , contbanc.agencia_conta
                     , contbanc.beneficiario
                     , depdia.valordeposito Valor_depositado
                     , decode (depdia.tipo, 'DD','Depósito Dinheiro'
                                          , 'CR','Cheque Resgate'
                                          , 'CD','Cheque Cobrir'
                                          , 'CC','Depósito Cheque'
                                          , 'AS','Abate Saldo Fornecedor') tipo
                     , decode(depdia.comprovado,'S','Sim','N','Não') Comprovado
                     , depdia.nrocomprovante
                     , depdia.observacao
                     , 'Cheque nº '||cheque.numero
                     , cheque.datacheque
                     , cheque.valor
                from depositosdiarios depdia
                   , representantes   repres
                   , pessoas          prepres
                   , filiais          fil
                   , pessoas          pfil
                   , pagamentosfornecedores pgf
                   , ( select cbl.idcontabanc
                            , initcap(pf.apelido) ApelidoFilial
                            , initcap(pf.nomepessoa) Filial
                            , initcap(bb.nomebanco) nomebanco
                            , cbl.agencia ||', '||cbl.conta Agencia_Conta
                            , initcap(cbl.beneficiario) beneficiario
                       from contasbancariasfiliais cbl
                          , filiais                ff
                          , pessoas                pf
                          , bancos                 bb
                       where cbl.idfilial = ff.idfilial
                         and ff.idpessoa  = pf.idpessoa
                         and cbl.idbanco  = bb.idbanco ) contbanc
                  , ( select pg.idpgtoforn
                           , chq.numero
                           , chq.datacheque
                           , chq.dataenvio
                           , chq.valor
                      from pagto_forn_cheque pg
                         , cheques           chq  
                      where pg.idcheque    = chq.idcheque ) cheque         
                where depdia.idrepresentante = repres.idrepresentante(+)
                  and repres.idpessoa        = prepres.idpessoa(+)
                  and repres.idfilial        = fil.idfilial
                  and fil.idpessoa           = pfil.idpessoa(+)
                  and depdia.idpgtoforn      = cheque.idpgtoforn
                  and contbanc.idcontabanc   = depdia.idcontabanc(+)
                  and depdia.idpgtoforn      = pgf.idpgtoforn
                  and depdia.idpgtoforn_orig is null
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        link {
            linkColumn: customTarget
            target: {
                type: url
                url: javascript:window.open('f?p=&APP_ID.:36:&SESSION.::NO:36:P36_IDDEPOSITODIARIOS:#IDDEPOSITODIARIOS#','popup','toolbar=no,location=no,status=no,menubar=no,scrollbars=no,resizable=no,width=375,height=155,screenX=100,screenY =200'); void(0);
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt="" />
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: This query returns more than 10,000 rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

