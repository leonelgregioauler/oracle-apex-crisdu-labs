page 257 (
    name: "Fotos Depósitos "
    title: "Fotos Depósitos "
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 90%
        height: 80%
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region fotos-depósitos (
        name: "Fotos Depósitos "
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "ROWID",
                "IDLEITURAOCR_DEPOSITO",
                "IDDEPOSITODIARIO",
                '<iframe  width=500px; height=655px; src="/apex/f?p=2650:261:&APP_SESSION.::NO:RP:P261_ARQUIVO:'||nomearquivo||'"></iframe>' foto,
                ( select urlcomprovante
                  from comprovantes comp
                  where comp.idcomprovante = d.idcomprovante) urlcomprovante,
                "IDREPRESENTANTE",
                nvl( nroidentificacao_digitado, ( select dd.nrocomprovante
                                                         from depositosdiarios_orig dd
                                                         where dd.iddepositodiarios = d.iddepositodiario )  ) nroidentificacao_digitado,
                "VALOR_DIGITADO",
                "DATAREVISAO",
                "USUARIOREVISAO",
                "TRANSFERENCIA",
                "PIX",
                "DATADEPOSITO"
                from "#OWNER#"."DEPOSITOSDIARIOS_LEITURAOCR" D
                where d.iddepositodiario = :P257_IDDEPOSITODIARIO
                ```
        }
        layout {
            sequence: 15
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
        }

        column CHECK$01 (
            reportColumnQueryId: 12
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column DATADEPOSITO (
            reportColumnQueryId: 13
            derivedColumn: N
            type: datePicker
            heading {
                heading: Data Movimento
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
                width: 20
            }
        )

        column DATAREVISAO (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Data Revisão
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
        )

        column FOTO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Foto
                alignment: center
            }
            layout {
                sequence: 5
            }
            serverSideCondition {
                type: noRowsReturned
                sqlQuery:
                    ```sql
                    select 1
                    from comprovantes
                    where iddepositosdiarios = :P257_IDDEPOSITODIARIO
                    ```
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDDEPOSITODIARIO (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 4
            }
        )

        column IDLEITURAOCR_DEPOSITO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 3
            }
        )

        column IDREPRESENTANTE (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 5
            }
        )

        column NROIDENTIFICACAO_DIGITADO (
            reportColumnQueryId: 7
            derivedColumn: N
            type: textField
            heading {
                heading: Identificação
                alignment: center
            }
            layout {
                sequence: 7
                columnAlignment: center
            }
            appearance {
                width: 20
            }
        )

        column PIX (
            reportColumnQueryId: 12
            derivedColumn: N
            type: simpleCheckbox
            heading {
                heading: Pix
                alignment: center
            }
            lov {
                checkboxValues: S
            }
            layout {
                sequence: 12
                columnAlignment: center
            }
        )

        column ROWID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
            security {
                escapeSpecialChars: false
            }
        )

        column TRANSFERENCIA (
            reportColumnQueryId: 11
            derivedColumn: N
            type: simpleCheckbox
            heading {
                heading: Transferência
                alignment: center
            }
            lov {
                checkboxValues: S
            }
            layout {
                sequence: 11
                columnAlignment: center
            }
        )

        column URLCOMPROVANTE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Foto (Versão 2)
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression: <img src="#URLCOMPROVANTE#" style="height: 655px; width: 500px;"/>
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1
                    from comprovantes
                    where iddepositosdiarios = :P257_IDDEPOSITODIARIO
                    ```
            }
            security {
                escapeSpecialChars: false
            }
        )

        column USUARIOREVISAO (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Revisado por
                alignment: center
            }
            layout {
                sequence: 9
            }
        )

        column VALOR_DIGITADO (
            reportColumnQueryId: 8
            derivedColumn: N
            type: textField
            heading {
                heading: Valor Digitado
                alignment: center
            }
            layout {
                sequence: 8
            }
            appearance {
                formatMask: 999G999G999G999G990D00
                width: 10
            }
        )

    )

    pageItem P257_IDDEPOSITODIARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @fotos-depósitos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P257_PAGINAORIGEM (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @fotos-depósitos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button submit (
        buttonName: SUBMIT
        label: SALVAR
        layout {
            sequence: 30
            region: @fotos-depósitos
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
            databaseAction: update
        }
    )

    dynamicAction submit (
        name: Submit
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @submit
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: SUBMIT
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @fotos-depósitos
        target {
            tableName: DEPOSITOSDIARIOS_LEITURAOCR
            pkColumn: ROWID
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo executado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1544338548215452551
        }
        serverSideCondition {
            type: request=Value
            value: SUBMIT
        }
    )

    process atualiza-depósito (
        name: Atualiza Depósito
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vvalor number;
                  --
                begin
                  --
                  select sum(dr.valor_digitado)
                  into vvalor
                  from depositosdiarios_leituraocr dr
                  where dr.iddepositodiario = :P257_IDDEPOSITODIARIO;
                  --
                  execute immediate 'alter table DEPOSITOSDIARIOS_LEITURAOCR disable constraint DK_DEPDIA_OCR_DEPDIA';
                  --
                  pck_financeiro_rmc.prc_alteravalordeposito(piddepositodiario => :P257_IDDEPOSITODIARIO,
                                                             pvalordeposito => vvalor,
                                                             ppagina => 257);
                  --
                  execute immediate 'alter table DEPOSITOSDIARIOS_LEITURAOCR enable constraint DK_DEPDIA_OCR_DEPDIA';
                  --
                end;
                
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Valor atualizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1544167496740594531
        }
        serverSideCondition {
            type: request=Value
            value: SUBMIT
        }
    )

    process reprocessa-depósitos-do-extrato (
        name: Reprocessa Depósitos do Extrato
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_integracao_rmc.prc_reprocessaextrato_dep(piddeposito => :P257_IDDEPOSITODIARIO);
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 3537223884128058538
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                Select 1
                from dual
                where v('REQUEST') = 'SUBMIT'
                  and :P257_PAGINAORIGEM = 333
                ```
        }
    )

    branch (
        name: Go To Page 257
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 257
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                :P257_PAGINAORIGEM IS NULL
                and v('REQUEST') = 'SUBMIT'
                ```
        }
    )

    branch (
        name: Go To Page Origem
        execution {
            sequence: 11
        }
        behavior {
            type: pageIdentifiedByItem
            item: P257_PAGINAORIGEM
        }
    )

)

