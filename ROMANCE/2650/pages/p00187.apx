    region nota (
        name: Nota
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nf.idnotavenda
                     , to_char(nf.datanota,'IW')||'/'||to_char(nf.datanota,'RRRR') Semana
                     , to_char(nf.datanota,'RRRR') ANO
                     , 'Compra'  "Tipo NF"
                     , pck_romance.fnc_nomefornecedor(pidforn => 781) Emitente
                     , ( select pck_romance.fnc_nomefilial(pidfilial => fe.idfilial)
                         from filiais         fe
                         where fe.idfilial =  ( select idfilialromance 
                                                from fabri.clientes c
                                                where c.idcliente = nf.idcliente ) ) "Filial Destino"
                     , ( select pck_romance.fnc_nometransportadora(pidtransp => t.idtransportadora)
                         from transportadoras t
                         where t.idtransportadora = ( select tt.idtransportadoraroman
                                                      from fabri.transportadoras tt
                                                      where tt.idtransportadora = nf.idtransportadora ) )  "Transportadora"
                     , nf.datanota 
                --     , ( select sum(valor) from vencimentos v where v.idnotafiscal = nf.idnotafiscal ) valortotal
                     , decode(NF.SITUACAO,'A','Ativa','C','Cancelada','Ativa') Situacao
                     , decode(NF.situacaoromance,'A','Aceita','P','Pendente de Aprovação') "Situação Recebimento"
                     , nf.nrodocumento 
                     , initcap(nf.USUARIO) "Usuário"
                from notasvendasfabri nf
                where nf.situacaoromance = 'P'
                  and nf.idnotavenda = :P187_IDNOTAVENDA
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: setPaginationSelectList
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Dados não encontrados.
        }
        componentAdvanced {
            stripHtml: true
        }

