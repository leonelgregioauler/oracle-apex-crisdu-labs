    )

    process aprova (
        name: aprova
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  -- Local variables here
                  i integer;
                  vidnotavenda number := :P187_IDNOTAVENDA;
                begin
                  -- 
                  for i in ( select n.*
                                  , ( select c.idfilialromance
                                      from fabri.clientes c
                                      where c.idcliente = n.idcliente ) idfilialromance
                                  , ( select t.idtransportadoraroman
                                      from fabri.transportadoras t
                                      where t.idtransportadora = n.idtransportadora ) idtransportadoraroman
                             from fabri.notasvendas n
                             where n.idnotavenda = vidnotavenda )
                  loop 
                    --
                    insert into notasfiscais ( idnotafiscal      , idfornemitente        , tipoemitente
                                             , idfilialdestino   , idtransportadora      , dtnf
                                             , usuario           , valortotal            , nrnf
                                             , idfilialemitente  , volumes               , situacao
                                             , documento         , idcontabancaria       , vlrdesconto
                                             , valorliquido      , valorfrete            , tiponota )
                    values ( seq_idnotafiscal.nextval         , 781                     , 'FOR'
                           , i.idfilialromance                , i.idtransportadoraroman , i.datanota
                           , v('APP_USER')                    , null                    , null
                           , null                             , i.volumes               , 'A'
                           , i.nrodocumento                   , null                    , i.valordesconto
                           , null                             , i.valorfrete            , 'C');
                    --
                  end loop;
                  --
                  for v in ( select vv.*
                             from fabri.vencimentosnotavenda vv
                             where vv.idnotavenda = vidnotavenda )
                  loop
                    --
                    insert into vencimentos ( idvencimento   , idnotafiscal     , dias
                                            , datavencimento , valor            , idcontabanc
                                            , tipopagamento  )
                    values ( seq_idvencimentos.nextval , seq_idnotafiscalroman.currval , sysdate - v.datavencimento
                           , v.datavencimento          , v.valor                       , 1360 -- id da conta bancaria da romance
                           , 'D' );
                
                    --
                  end loop;
                  --  
                  for t in ( select ( select p.idprodutoroman
                                               from fabri.produtos p
                                               where p.idproduto = ii.idproduto ) idprodutoroman
                                  , qtd_pp
                                  , qtd_p
                                  , qtd_m
                                  , qtd_g
                                  , qtd_gg
                                  , qtd_egg
                                  , qtd_u
                                  , valorvenda vlrvenda
                                  , nvl(qtd_pp,0) + nvl(qtd_p,0) + nvl(qtd_m,0) + nvl(qtd_g,0) + nvl(qtd_gg,0) + nvl(qtd_egg,0) + nvl(qtd_u,0) QTD_TOTAL
                             from fabri.itensnotavenda ii
                             where ii.idnotavenda = vidnotavenda )
                  loop
                    --
                    insert into itemnf ( iditnf               , idnotafiscal      , idproduto
                                       , qtd_p                , custound          , valortotal
                                       , qtd_gg               , qtd_g             , qtd_m
                                       , qtd_total            , qtd_u             , observacao
                                       , idprodutodetalhado   , qtd_pp            , qtd_egg )
                    values ( seq_iditemnfroman.nextval    , seq_idnotafiscalroman.currval    , t.idprodutoroman
                           , t.qtd_p                      , t.vlrvenda                       , t.qtd_total
                           , t.qtd_gg                     , t.qtd_g                          , t.qtd_m
                           , t.qtd_total                  , t.qtd_u                          , null--t.observacao
                           , null                         , t.qtd_pp                         , t.qtd_egg );
                    --
                  end loop;
                  --
                  update fabri.notasvendas n
                  set n.situacaoromance = 'A'
                  where n.idnotavenda = vidnotavenda;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Nota aprovada com sucesso!
        }
        error {
            errorMessage: Ocorreu um erro ao aprovar a nota, contate o administrador!
        }
        advanced {
            executionMappingIdentifier: 405668129495188789
        }
    )

)

