    region itens (
        name: Itens
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.iditemnotavenda
                     , i.idnotavenda
                     , ( select pck_romance.fnc_nomeproduto(pidproduto => p.idprodutoroman)
                         from fabri.produtos p 
                         where p.idproduto = i.idproduto ) "Produto" 
                     , i.valorvenda
                     , i.qtd_pp
                     , i.qtd_p
                     , i.qtd_m
                     , i.qtd_g
                     , i.qtd_gg
                     , i.qtd_egg
                     , i.qtd_u
                     , i.observacao
                     , i.valorvenda
                     * nvl(i.qtd_pp ,0)
                     + nvl(i.qtd_p  ,0)
                     + nvl(i.qtd_m  ,0)
                     + nvl(i.qtd_g  ,0)
                     + nvl(i.qtd_gg ,0)
                     + nvl(i.qtd_egg,0)
                     + nvl(i.qtd_u  ,0) "Total"
                from itensnotavendafabri i
                where i.idnotavenda = :P187_IDNOTAVENDA
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
