    )

    pageItem P199_ANO (
        type: numberField
        label {
            label: Ano
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 5
        }
        default {
            type: expression
            plsqlExpression: to_number(to_char(sysdate,'RRRR'))
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P199_TIPO (
        type: radioGroup
        label {
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC: Estoque Atual;E,Estoque Congelado;C
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: null
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: FILTRAR
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-search
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction escolhe-produto (
        name: Escolhe Produto
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P199_IDPRODUTO
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P199_IDPRODUTO
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @indicadores-do-estoque-atual
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction tipo-congelado (
        name: Tipo Congelado
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P199_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P199_TIPO
            value: C
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P199_ANO
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P199_ANO
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: Go To Page 199
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 199
                items: {
                    P199_TIPO: &P199_TIPO.
                    P199_ANO: &P199_ANO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

