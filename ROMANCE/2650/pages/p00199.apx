    region indicadores-do-estoque-atual (
        name: Indicadores do Estoque Atual
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(e.idfilial) empresa
                     , sum(nvl(e.qtd_pp,0)
                          +nvl(e.qtd_p,0)
                          +nvl(e.qtd_m,0)
                          +nvl(e.qtd_g,0)
                          +nvl(e.qtd_gg,0)
                          +nvl(e.qtd_egg,0)
                          +nvl(e.qtd_exgg,0)
                          +nvl(e.qtd_u,0)) físico
                from roman.estoquefilial e
                where e.idfilial not in (1063,1079,1109)
                group by e.idfilial
                order by 1
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P199_TIPO
            value: E
        }
        componentAppearance {
            showNullValuesAs: 0
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum dado Encontrado!
            whenMoreDataFound: Nenhum dado Encontrado!
        }
        advanced {
            savedReportMappingIdentifier: 2575157815507387125
        }

        column EMPRESA (
            type: plainText
            heading {
                heading: Empresa
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column FÍSICO (
            type: plainText
            heading {
                heading: Físico
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: I
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 26342615 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn EMPRESA (
                sequence: 1
