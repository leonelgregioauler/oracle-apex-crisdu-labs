page 199 (
    name: Indicadores de Mercadorias
    title: Indicadores de Mercadorias
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region indicadores-congelados (
        name: Indicadores Congelados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.mes
                     , m.numero
                     , pck_romance.fnc_nomefilial(ec.idfilial) empresa
                     , sum(nvl(ec.quantidade,0)) quantidade
                from estoquescongelados ec
                   , meses m
                where ec.idmes = m.numero
                  and ec.ano   = :P199_ANO
                  and ec.idfilial not in (1063,1079,1109)
                group by m.mes
                       , ec.idfilial
                       , m.numero
                order by 2 , 3
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P199_TIPO
            value: C
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 2644275075697851812
        }

        column EMPRESA (
            type: plainText
            heading {
                heading: Empresa
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

