    pageItem P10_IDFORNECEDOR (
        type: popupLov
        label {
            label: Fornecedor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomefornecedor display_value
                     , idfornecedor   return_value
                from vw_fornecedores_rmc
                order by 1
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 70
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P10_TIPO_PESQUISA (
        type: radioGroup
        label {
            label: Com preço?
            alignment: left
        }
        settings {
            noOfCols: 3
            pageActionOnSelection: submitPage
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Com Preço;S,Sem Preço;N,Todos;T
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: T
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Novo Produto
        layout {
            sequence: 10
            region: @filtros
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 11
                clearCache: 11
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util.fnc_verificaacesso(2678,v('APP_USER') ) = 'S'
                ```
        }
    )

    dynamicAction filtra (
        name: Filtra
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P10_IDFORNECEDOR
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process css-responsivo-mobile (
        name: CSS Responsivo Mobile
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                apex_css.add(p_css => '
                @media (max-width: 640px) {
                  /* Mais respiro dentro do bloco de filtros, que usa padding reduzido por padrao */
                  .t-Form--slimPadding {
                    padding: 18px !important;
                    margin-bottom: 16px !important;
                  }
                  /* Espaco entre os rotulos e os campos, e entre os campos entre si */
                  label[for="P10_IDFORNECEDOR"],
                  label[for="P10_TIPO_PESQUISA"] {
                    display: block !important;
                    margin: 0 0 8px 0 !important;
                  }
                  /* O container que agrupa campo + botao de lista vira uma linha flexivel, */
                  /* alinhada verticalmente, em vez de deixar o botao esticar sozinho */
                  *:has(> #P10_IDFORNECEDOR) {
                    display: flex !important;
                    align-items: center !important;
                    width: 100% !important;
                    max-width: 100% !important;
                    gap: 8px !important;
                    margin-bottom: 18px !important;
                  }
                  /* Campo Fornecedor cresce para ocupar o espaco disponivel, botao mantem o tamanho natural */
                  #P10_IDFORNECEDOR {
                    flex: 1 1 auto !important;
                    min-width: 0 !important;
                    width: auto !important;
                    margin-bottom: 0 !important;
                  }
                  /* Botao Novo Produto ocupa a largura toda no celular */
                  .t-Button--warning {
                    display: flex !important;
                    width: 100% !important;
                    justify-content: center !important;
                    margin-top: 14px !important;
                  }
                  /* Empilha as opcoes do "Com preco?" (Com Preco / Sem Preco / Todos) */
                  /* verticalmente, com espaco entre elas, evitando a quebra feia de texto em 3 colunas */
                  #P10_TIPO_PESQUISA td,
                  #P10_TIPO_PESQUISA .apex-item-grid-cell,
                  #P10_TIPO_PESQUISA .apex-item-option {
                    display: block !important;
                    width: 100% !important;
                    padding: 6px 0 !important;
                  }
                  /* Barra de busca/acoes do Interactive Report (nomes de classe confirmados via inspecao): */
                  /* deixa os grupos (busca / views / opcoes) quebrarem linha em vez de espremer/cortar */
                  .a-IRR-toolbar {
                    flex-wrap: wrap !important;
                  }
                  .a-IRR-controls {
                    flex-wrap: wrap !important;
                    width: 100% !important;
                  }
                  /* O grupo de busca ocupa a linha toda, e a caixa de texto cresce dentro dele */
                  .a-IRR-controlGroup--search {
                    flex: 1 1 100% !important;
                    width: 100% !important;
                  }
                  .a-IRR-search,
                  .a-IRR-searchField {
                    width: 100% !important;
                    flex: 1 1 auto !important;
                  }
                  .a-IRR-search-field {
                    width: 100% !important;
                    flex: 1 1 auto !important;
                  }
                  /* "Linhas" e "Acoes" ganham espaco pra nao cortar o texto */
                  .a-IRR-controlGroup--views {
                    flex: 1 1 auto !important;
                    white-space: normal !important;
                    overflow: visible !important;
                  }
                  /* Linhas fica a esquerda, Acoes encostado na borda direita */
                  .a-IRR-controlGroup--options {
                    display: flex !important;
                    flex: 1 1 100% !important;
                    width: 100% !important;
                    justify-content: space-between !important;
                    align-items: center !important;
                    white-space: normal !important;
                    overflow: visible !important;
                  }
                  /* O rotulo "Linhas" nao pode encolher dentro do flex, senao o texto corta */
                  .a-IRR-rowSelector {
                    flex: 0 0 auto !important;
                    display: flex !important;
                    align-items: center !important;
                    gap: 6px !important;
                  }
                  .a-IRR-rowSelector label {
                    flex-shrink: 0 !important;
                    white-space: nowrap !important;
                    width: auto !important;
                  }
                  .a-IRR-actions {
                    flex: 0 0 auto !important;
                    white-space: nowrap !important;
                  }
                }
                ');
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 9010023004050060070
        }
    )

    branch (
        name: Go To Page 10
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 10
                items: {
                    P10_IDFORNECEDOR: &P10_IDFORNECEDOR.
                    P10_TIPO_PESQUISA: &P10_TIPO_PESQUISA.
                }
                action: resetPagination
            }
        }
    )

)

