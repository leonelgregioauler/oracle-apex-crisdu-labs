        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                exists ( select 1
                         from usuariosgruposatendimento ug
                         where ug.usuario = v('APP_USER') )
                ```
        }
    )

    region lista-de-produtos-com-ou-sem-preço (
        name: Lista de Produtos ( com ou sem preço )
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select /*+FIRST_ROWS(30)*/( select initcap(cc.nome) 
                                            from categorias cc
                                            where cc.idcategoria = p.idcategoria) Categoria
                     , p.idproduto
                     , ( select listagg(pck_romance.fnc_nomefornecedor(ff.idfornecedor)||' ('||trim(to_char(ff.precocusto,'999G999G999G990D00'))||')') within group (order by 1)
                         from fornecedoresprodutos ff
                         where ff.idproduto = p.idproduto 
                           and rownum < 10 ) "Fornecedor"
                     , initcap(p.nomeproduto) nomeproduto
                     , initcap(p.descrproduto) descrproduto
                     , p.codigosisdist "Referência"
                     , decode(p.ativo,'S','Sim','Não') "Ativo"
                     , decode(p.venda,'S','Sim','Não') "Venda"
                     , decode(p.comissao,'S','Sim','Não') "Comissão"
                     , decode(p.idprodutovarejo, null,'Não','Sim') "Produto do Varejo"
                     , ( select count(1)
                         from estoquefilial e
                         where e.idproduto = p.idproduto 
                           and ativo = 'S') utilizado
                     , ( select listagg(pck_romance.fnc_nomefilial(idfilial)||' ('||trim(to_char(e.vlrvenda,'999G990D00'))||') ') within group (order by 1)
                         from estoquefilial e
                         where e.idproduto = p.idproduto 
                           --and rownum <= 20
                           and ativo = 'S' ) empresas 
                     , initcap(usuariocadastrou) as "Usuário Cadastrou"
                     , p.dtinclusao datacadastro
                     , ( select listagg('<a href="'||urlreduzida||'" target="_blank"> <img src="'||urlreduzida||'" class="img_produto"><a><br>') within group (order by url, urlreduzida)
                         from fotosprodutos  f
                         where f.idproduto = p.idproduto ) fotos
                     , ( select listagg(trim(to_char(fp.precocusto,'999G990D00'))) within group (order by fp.precocusto)
                         from fornecedoresprodutos fp
                         where fp.idproduto = p.idproduto
                           and fp.precocusto is not null
                           and rownum <= 3 ) precocusto
                     , p.idproduto vernotas
                     , PRECOVENDA
                     , ( select c.nome
                         from caracteristicascategorias c
                         where c.idcaracteristicacateg = p.IDCARACTERISTICADETALHE ) sub_categoria
                     , ( select ct.nome
                         from caracteristicascategorias ct
                         where ct.idcaracteristicacateg = p.IDCARACTERISTICACATEG ) caracteristica
                from produtos p
                where ( :P10_IDFORNECEDOR is null 
                   or exists ( select 1 from fornecedoresprodutos f where f.idproduto = p.idproduto and f.idfornecedor = :P10_IDFORNECEDOR) )
                  and ( :P10_TIPO_PESQUISA is null
                     or ( :P10_TIPO_PESQUISA = 'S' and exists ( select 1
                                                                from estoquefilial e
                                                                where e.idproduto = p.idproduto
                                                                  and nvl(e.vlrvenda,0) > 0 ) )
                     or ( :P10_TIPO_PESQUISA = 'N' and p.precovenda is null
                                                   or  exists ( select 1
                                                                from notasfiscais nf
                                                                   , itemnf it
                                                                where it.idnotafiscal = nf.idnotafiscal
                                                                  and it.idproduto    = p.idproduto
                                                                  and nf.situacaofilial = 'A'
                                                                  and extract ( year from dtnf ) >= 2021
                                                                  and exists ( select 1
                                                                               from vw_filiais f
                                                                               where f.idfilial = nf.idfilialdestino
                                                                                 and f.ativo    = 'S'
                                                                                 and f.tipofilial = 'D' )
                                                                  and not exists ( select 1
                                                                                   from estoquefilial ep
                                                                                   where ep.idfilial = nf.idfilialdestino
                                                                                     and ep.idproduto = it.idproduto ) ) ) )
                order by 1,4
                ```
            pageItemsToSubmit: [
                P10_IDFORNECEDOR
                P10_TIPO_PESQUISA
            ]
        }
        layout {
            sequence: 30
            parentRegion: @geral
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P10_TIPO_PESQUISA in ('S','N')
        }
