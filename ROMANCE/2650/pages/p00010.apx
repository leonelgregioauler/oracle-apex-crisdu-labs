    region lista-de-produtos-geral (
        name: Lista de Produtos ( geral )
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select initcap(cc.nome) 
                         from categorias cc
                         where cc.idcategoria = p.idcategoria) Categoria
                     , p.idproduto
                     , initcap(p.nomeproduto) nomeproduto
                     , initcap(p.descrproduto) descrproduto
                     , p.codigosisdist "Referência"
                     , decode(p.ativo,'S','Sim','Não') "Ativo"
                     , decode(p.venda,'S','Sim','Não') "Venda"
                     , decode(p.comissao,'S','Sim','Não') "Comissão"
                     , nvl(( select listagg('<a href="'||ft.urlreduzida||'" target="_blank"> <img src="'||ft.urlreduzida||'" class="img_produto_2"><a>',' ') within group ( order by 1 )
                             from fotosprodutos ft 
                             where ft.idproduto = p.idproduto ),'<a href="http://fotosprodutos.romancemoda.com.br/acessar?INDISPONIVEL.JPG" target="_blank"> <img src="http://fotosprodutos.romancemoda.com.br/acessar?INDISPONIVEL.JPG/true" class="img_produto"><a>') fotosprodutos 
                     , initcap(usuariocadastrou) as "Usuário Cadastrou"
                     , p.dtinclusao datacadastro
                from produtos p
                where p.idcategoria != 141
                  --and exists ( select 1
                  --             from notasfiscais nf
                  --                , itemnf i
                  --             where nf.idnotafiscal = i.idnotafiscal
                  --               and i.idproduto     = p.idproduto
                  --               and nf.idfilialdestino = pck_romance.fnc_filialusuario(v('APP_USER')) )
                order by 1,3
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                not exists ( select 1
                             from usuariosgruposatendimento ug
                             where ug.usuario = v('APP_USER') )
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: "Nenhum produto localizado! "
        }
        advanced {
            savedReportMappingIdentifier: 6138022149329544046
        }

