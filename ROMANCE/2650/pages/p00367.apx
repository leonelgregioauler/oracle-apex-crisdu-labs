page 367 (
    name: Rastreamento de Depósitos
    title: Rastreamento de Depósitos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region depósitos-encontrados (
        name: Depósitos Encontrados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select dr.iddepositodiario
                     , pck_romance.fnc_nomefilial(dr.idfilial) empresa
                     , pck_romance.fnc_nomerepresentante(dr.idrepresentante) distribuidor
                     , dr.dataleitura
                     , dr.datadeposito
                     , dr.datarevisao
                     , dr.banco
                     , dr.valor
                     , dr.nroidentificacao
                     , dr.valor_digitado
                     , dr.nroidentificacao_digitado
                     , dr.nomearquivo
                     , '<iframe  width=300; height=455px; src="/apex/f?p=2650:261:&APP_SESSION.::NO:RP:P261_ARQUIVO:'||nomearquivo||'"></iframe>' foto
                from depositosdiarios_leituraocr dr
                where ( dr.dataleitura between to_date('10/03/2020 09:00:00','DD/MM/RRRR HH24:MI:SS') and to_date('10/03/2020 12:00:00','DD/MM/RRRR HH24:MI:SS')
                  or dr.datarevisao between to_date('10/03/2020 09:00:00','DD/MM/RRRR HH24:MI:SS') and to_date('10/03/2020 12:00:00','DD/MM/RRRR HH24:MI:SS') )
                  and ( :P367_IDFILIAL is null or dr.idfilial = :P367_IDFILIAL )
                  and ( :P367_IDREPRESENTANTE is null or dr.idrepresentante = :P367_IDREPRESENTANTE )
                  and dr.iddepositodiario is not null
                order by dataleitura
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <font color="blue"><h3>
                    Os depósitos foram recebidos no horário do dia 10/03/2020 das 09:00:00 até 12:00:00.
                    </h3></font>
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 4409422939236913821
        }

        column BANCO (
            type: plainText
            heading {
                heading: Banco
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column DATADEPOSITO (
            type: plainText
            heading {
                heading: Data do Depósito
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column DATALEITURA (
            type: plainText
            heading {
                heading: Data Recebido
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            appearance {
