page 263 (
    name: Detalhe Atendimento Depósitos
    title: Detalhe Atendimento Depósitos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region depósitos (
        name: Depósitos
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct pck_romance.fnc_nomerepresentante(d.idrepresentante) nome
                     , count(1) qtddepositos
                     , sum(d.valordeposito) total
                from depositosdiarios_orig d
                where trunc(data) = trunc(sysdate)
                  and to_number(to_char(data,'HH24')) = :P263_HORA
                  and pck_romance.fnc_filialrepresentante(d.idrepresentante) != 240
                group by d.idrepresentante
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column NOME (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column QTDDEPOSITOS (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Qtddepositos
                alignment: center
            }
            layout {
                sequence: 2
            }
        )

        column TOTAL (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Total
                alignment: center
            }
            layout {
                sequence: 3
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
        )

    )

    region ligações (
        name: Ligações
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nvl(pck_romance.fnc_nomerepresentante(idrepresentante),'- Não identificado -') nome
                     , dataconclusao
                from controleligacoes c
                where trunc(c.dataconclusao) = trunc(sysdate)
                  and idcontroleorig is null
                  and to_number(to_char(dataconclusao,'HH24')) = :P263_HORA
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column DATACONCLUSAO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Data Conclusão
                alignment: center
            }
            layout {
                sequence: 2
            }
            appearance {
                formatMask: HH24:MI:SS
            }
        )

        column NOME (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

    )

    pageItem P263_HORA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @depósitos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

