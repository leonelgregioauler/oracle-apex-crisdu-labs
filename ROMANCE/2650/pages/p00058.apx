    region pepinos-de-representantes (
        name: Pepinos de Representantes
        type: staticContent
        source {
            htmlCode:
                ```html
                <script language="javascript">
                function  confirmapepino(event)
                { 
                var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
                
                if (tecla==13) {
                var answer = confirm("Confirma inclusão do pepino?")
                	if (answer){            
                		apex.submit('CREATE');
                	}
                }
                }
                </script>
                
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region pepinos-pagos-devolvidos-enviados-para-cobrança-na-semana (
        name: Pepinos Pagos/Devolvidos/Enviados para Cobrança na Semana
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.idpepinosrepresentante
                     , r.idfechamentorepres 
                     , r.nrpedido
                     , r.valor
                     , r.semana
                     , decode(r.situacao,'N','Novo','P','Pago','D','Mercadoria Devolvida', 'C', 'Enviado para Cobrança') situacao
                     , r.semanapago
                     , r.observacao
                     , r.nomevendedora
                from pepinosrepresentantes r
                where r.idfechamentoreprespago = :P58_IDFECHAMENTOREPRES
                  or ( r.idfechamentorepres = :P58_IDFECHAMENTOREPRES
                     and r.situacao = 'C' )
                ```
        }
        layout {
            sequence: 15
            parentRegion: @pepinos-de-representantes
            slot: subRegions
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        reportLayout {
            numberOfRows: 30
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhum pepino pago para este promotor.
        }
        componentAdvanced {
            stripHtml: true
        }

        column IDFECHAMENTOREPRES (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

