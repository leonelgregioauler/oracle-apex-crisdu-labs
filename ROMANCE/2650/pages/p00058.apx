    validation p58-nrpedido (
        name: P58_NRPEDIDO
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P58_NRPEDIDO
        }
        error {
            errorMessage: #LABEL# deve ser informado!
            displayLocation: inlineInNotification
