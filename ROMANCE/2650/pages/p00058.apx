    validation p58-valor (
        name: P58_VALOR
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P58_VALOR
        }
        error {
            errorMessage: #LABEL# deve ser informado!
            associatedItem: @P58_VALOR
        }
    )

    validation p58-valor-2 (
        name: P58_VALOR
        execution {
            sequence: 40
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from pepinosrepresentantes r 
                where r.nrpedido = :P58_NRPEDIDO
                  and r.situacao = 'N'
                  and r.idrepresentante = :P58_IDREPRESENTANTE
                  having r.valor < (NVL(( select sum(pg.valor) 
                                          from pepinosrepresentantes pg
                                          where pg.nrpedido = r.nrpedido
                                            and pg.idrepresentante = r.idrepresentante
                                            and pg.situacao = 'P' ),0) + to_number(:P58_VALOR,'999999990D00'))
                group by r.nrpedido
                       , r.valor
                       , r.idrepresentante
                ```
        }
        error {
            errorMessage: O valor a ser pago deve ser menor que o valor em aberto deste pepino.
            displayLocation: inlineInNotification
            associatedItem: @P58_VALOR
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: item=value
            item: P58_SITUACAO
            value: P
        }
    )

    process atualiza-pago (
        name: atualiza pago
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                if :P58_SITUACAO in ('P', 'D') then
                 :P58_IDFECHAMENTOREPRESPAGO := :P58_IDFECHAMENTOREPRES;
                else 
                :P58_IDFECHAMENTOREPRESPAGO := null;
                end if;
                end;
                ```
        }
        execution {
            sequence: 15
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 179717309415285109
        }
    )

