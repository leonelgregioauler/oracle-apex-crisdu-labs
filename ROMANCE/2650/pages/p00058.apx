    pageItem P58_MSG (
        type: displayOnly
        label {
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 140
            region: @pepinos-de-representantes
            slot: regionBody
            columnSpan: 5
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select 'Valor em aberto: R$ '||TRIM(to_char(r.valor - NVL(( select sum(pg.valor) 
                                                           from pepinosrepresentantes pg
                                                           where pg.nrpedido = r.nrpedido
                                                             and pg.situacao = 'P' ),0) ,'999G999G990D00'))
                from pepinosrepresentantes r 
                where r.nrpedido = :P58_NRPEDIDO
                and r.situacao = 'N'
                group by  r.nrpedido
                     , r.valor
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

