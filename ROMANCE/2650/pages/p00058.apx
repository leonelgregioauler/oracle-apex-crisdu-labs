        }
    )

    validation p58-nrpedido-2 (
        name: P58_NRPEDIDO
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from pepinosrepresentantes r 
                where r.nrpedido = :P58_NRPEDIDO
                  and r.idrepresentante = :P58_IDREPRESENTANTE
                  and r.situacao = 'N'
                ```
        }
        error {
            errorMessage: Já existe um pepino incluído com este número!
            displayLocation: inlineInNotification
            associatedItem: @P58_NRPEDIDO
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: item=value
            item: P58_SITUACAO
            value: N
        }
    )

    validation p58-semana (
        name: P58_SEMANA
        execution {
            sequence: 30
        }
