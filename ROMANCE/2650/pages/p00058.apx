    help {
        helpText: No help is available for this page.
    }

    region pepinos-abertos (
        name: Pepinos Abertos
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nrpedido
                     , semana
                     , representante
                     , nomevendedora
                     , valor
                     , valorpago
                     , saldo
                     , filial
                     , ultimopagamento
                     , idpepinosrepresentante
                     , cpf
                     , idnotavenda
                     , idrepresentante 
                     , origem
                from vw_debitosrepresentantes
                where saldo > 0
                  and idrepresentante = :P58_IDREPRESENTANTE
                ```
        }
        layout {
            sequence: 20
            parentRegion: @pepinos-de-representantes
            slot: subRegions
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        reportLayout {
            numberOfRows: 500
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhum pepino aberto para este promotor.
        }
        componentAdvanced {
            stripHtml: true
