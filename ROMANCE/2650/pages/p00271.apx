page 271 (
    name: Histórico de Ligações
    title: Histórico de Ligações
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region histórico-de-ligações (
        name: Histórico de Ligações
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P271_IDCONTROLELIGACOES (
        type: hidden
        layout {
            sequence: 20
            region: @histórico-de-ligações
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDCONTROLELIGACOES
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P271_IDHISTORICOLIGACOES (
        type: hidden
        layout {
            sequence: 10
            region: @histórico-de-ligações
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDHISTORICOLIGACOES
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P271_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @histórico-de-ligações
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 500
        }
        source {
            type: databaseColumn
            databaseColumn: OBSERVACAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P271_USUARIO (
        type: hidden
        layout {
            sequence: 30
            region: @histórico-de-ligações
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: USUARIO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                return v('APP_USER');
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @histórico-de-ligações
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 270
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 20
            region: @histórico-de-ligações
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P271_IDHISTORICOLIGACOES
        }
    )

    validation p271-observacao (
        name: P271_OBSERVACAO
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P271_OBSERVACAO
        }
        error {
            errorMessage: Informe a descrição!
            associatedItem: @P271_OBSERVACAO
        }
    )

    process fetch-row-from-historicoligacoes (
        name: Fetch Row from HISTORICOLIGACOES
        type: autoRowFetch
        source {
            tableName: HISTORICOLIGACOES
            pkColumn: IDHISTORICOLIGACOES
            pkItem: P271_IDHISTORICOLIGACOES
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 529964326721678876
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P271_IDHISTORICOLIGACOES is null then
                        select "SEQ_IDHISTORICOLIG".nextval
                          into :P271_IDHISTORICOLIGACOES
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 529964520953678877
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-historicoligacoes (
        name: Process Row of HISTORICOLIGACOES
        type: autoRowProcessing
        target {
            tableName: HISTORICOLIGACOES
            pkColumn: IDHISTORICOLIGACOES
            pkItem: P271_IDHISTORICOLIGACOES
            supportedOperations: insert
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 529964717805678877
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 270
                items: {
                    P270_IDCONTROLE: &P271_IDCONTROLELIGACOES.
                }
            }
        }
    )

)

