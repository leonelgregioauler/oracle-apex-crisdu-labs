page 418 (
    name: Cadastro de Itens de Transferência
    title: Cadastro de Itens de Transferência
    appearance {
        pageMode: nonModalDialog
        dialogTemplate: @/wizard-modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: wizardButtons
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region cadastro-de-itens-de-transferência (
        name: Cadastro de Itens de Transferência
        type: staticContent
        layout {
            sequence: 10
            slot: wizardBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P418_CUSTOUND (
        type: selectList
        label {
            label: Custo
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefornecedor(pidforn =>  fp.idfornecedor) ||' - '||trim(to_char(fp.precocusto,'999G990D00') ) display_value
                     , fp.precocusto return_value
                from fornecedoresprodutos fp
                where fp.idproduto    = :P418_IDPRODUTO
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P418_IDPRODUTO
        }
        layout {
            sequence: 40
            region: @cadastro-de-itens-de-transferência
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: CUSTOUND
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P418_IDITNF (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @cadastro-de-itens-de-transferência
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDITNF
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P418_IDNOTAFISCAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @cadastro-de-itens-de-transferência
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDNOTAFISCAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P418_IDPRODUTO (
        type: popupLov
        label {
            label: Produto
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.codigosisdist||' - '||initcap(p.nomeproduto) display_value
                     , p.idproduto return_value
                from produtos p
                where exists ( select 1 from notasfiscais where idnotafiscal = :P418_IDNOTAFISCAL  and tiponota = 'T')
                  and p.ativo = 'S'
                order by nomeproduto
                ```
        }
        layout {
            sequence: 30
            region: @cadastro-de-itens-de-transferência
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: databaseColumn
            databaseColumn: IDPRODUTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

