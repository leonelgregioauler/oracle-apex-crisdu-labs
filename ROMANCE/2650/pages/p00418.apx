    button create (
        buttonName: CREATE
        label: Adicionar
        layout {
            sequence: 20
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P418_IDITNF
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction fechar (
        name: Fechar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @fechar
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    window.close();
                    opener.location.href=opener.location.href;
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process fetch-row-from-itemnf (
        name: Fetch Row from ITEMNF
        type: autoRowFetch
        source {
            tableName: ITEMNF
            pkColumn: IDITNF
            pkItem: P418_IDITNF
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 226394120443846275
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P418_IDITNF is null then
                        select "#OWNER#"."SEQ_IDTEMNF".nextval
                          into :P418_IDITNF
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 226394499526846275
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-itemnf (
        name: Process Row of ITEMNF
        type: autoRowProcessing
        target {
            tableName: ITEMNF
            pkColumn: IDITNF
            pkItem: P418_IDITNF
            supportedOperations: insert
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Processo executado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 226394834650846275
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 418
                items: {
                    P418_IDITNF:
                    P418_IDNOTAFISCAL: &P418_IDNOTAFISCAL.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 396
                items: {
                    P396_IDNOTAFISCAL: &P418_IDNOTAFISCAL.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @fechar
        }
    )

)

