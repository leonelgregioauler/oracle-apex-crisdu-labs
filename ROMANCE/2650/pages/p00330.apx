page 330 (
    name: Liberar Distribuidor
    title: Liberar Distribuidor
    appearance {
        pageMode: nonModalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    headerAndFooter {
        footerText:
            ```html
            <script javascript>
             window.resizeTo(screen.width*.46,screen.height*.46);  
                window.moveTo(screen.width*.26, screen.height*.20);  
            </script>
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region iniciar-sync (
        name: Iniciar Sync
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: <b><font color="green">Selecione a Empresa para poder liberar o Distribuidor para iniciar o Sync.</font></b>
        }
        settings {
            outputAs: text
        }
    )

    pageItem P330_DATA (
        type: hidden
        layout {
            sequence: 60
            region: @iniciar-sync
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: DATA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P330_DATATABLETOK (
        type: hidden
        layout {
            sequence: 90
            region: @iniciar-sync
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: DATATABLETOK
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P330_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.tipofilial = 'D'
                  and f.ativo = 'S'
                ```
        }
        layout {
            sequence: 10
            region: @iniciar-sync
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P330_IDIMP (
        type: hidden
        layout {
            sequence: 20
            region: @iniciar-sync
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDIMP
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P330_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select PCK_ROMANCE.fnc_nomepessoa(idpessoa)||' - ID: '||idrepresentante display_value
                    , r.idrepresentante return_value
                from representantes r
                where pck_romance.fnc_filialgerente(idgerente) = :P330_IDFILIAL
                and r.ativo = 'S'
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P330_IDFILIAL
        }
        layout {
            sequence: 40
            region: @iniciar-sync
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDREPRESENTANTE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P330_IDSEMANA (
        type: hidden
        layout {
            sequence: 80
            region: @iniciar-sync
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDSEMANA
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidsemana number;
                begin
                  --
                  select idsemana
                  into vidsemana
                  from (select pck_romance.fnc_nomeregiaovenda(idregiaovenda)||' - '||semana display_value
                             , r.idsemana idsemana
                        from regioesrepresentantes r
                        where idrepresentante = :P330_IDREPRESENTANTE
                        order by pck_util.fnc_idsemana(r.semana))
                  where rownum = 1;
                  --
                  return vidsemana;
                  --
                exception
                  when others then
                    return null;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P330_PROCESSO (
        type: hidden
        layout {
            sequence: 100
            region: @iniciar-sync
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: PROCESSO
            used: always
        }
        default {
            type: static
            staticValue: S
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P330_SEMANA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @iniciar-sync
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: SEMANA
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vsemana varchar2(10);
                begin
                  --
                  select semana
                  into vsemana
                  from (select pck_romance.fnc_nomeregiaovenda(idregiaovenda)||' - '||semana display_value
                             , r.semana semana
                        from regioesrepresentantes r
                        where idrepresentante = :P330_IDREPRESENTANTE
                        order by pck_util.fnc_idsemana(r.semana))
                  where rownum = 1;
                  --
                  return vsemana;
                  --
                exception
                  when others then
                    return null;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Iniciar Sync
        layout {
            sequence: 10
            region: @iniciar-sync
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Confirma o SYNC deste distribuidor?','CREATE');
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P330_IDIMP
        }
    )

    dynamicAction escolhe-distribuidor (
        name: Escolhe Distribuidor
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P330_IDREPRESENTANTE
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P330_IDREPRESENTANTE
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: [
                    P330_SEMANA
                    P330_IDSEMANA
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process fetch-row-from-imptablettoservidor (
        name: Fetch Row from IMPTABLETTOSERVIDOR
        type: autoRowFetch
        source {
            tableName: IMPTABLETTOSERVIDOR
            pkColumn: IDIMP
            pkItem: P330_IDIMP
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1531755948807474594
        }
        serverSideCondition {
            type: never
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P330_IDIMP is null then
                        select "#OWNER#"."SEQ_IDIMPTABLETTOSERV".nextval
                          into :P330_IDIMP
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1531756304654474603
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: never
        }
    )

    process insere-liberação-de-novo-sync (
        name: Insere Liberação de novo Sync
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidsemana number;
                  vsemana   varchar2(10);
                  --
                begin
                  --
                  select semana
                       , idsemana
                  into vsemana
                     , vidsemana
                  from ( select r.semana semana
                              , r.idsemana idsemana
                         from regioesrepresentantes r
                         where idrepresentante = :P330_IDREPRESENTANTE
                         order by pck_util.fnc_idsemana(r.semana) )
                  where rownum = 1;
                  --
                  insert into autorizacaoimptablet ( idautorizacaoimptablet
                                                   , idfilial
                                                   , idrepresentante
                                                   , semana
                                                   , idsemana
                                                   , data
                                                   , usuario )
                  values ( seq_idautorizacaoimptablet.nextval
                         , :P330_IDFILIAL
                         , :P330_IDREPRESENTANTE
                         , vsemana
                         , vidsemana
                         , sysdate
                         , v('APP_USER') );
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Liberação realizada! Comunique o Gestor ou Secretária.
        }
        advanced {
            executionMappingIdentifier: 1531640157549704526
        }
        serverSideCondition {
            type: request=Value
            value: CREATE
        }
    )

    process process-row-of-imptablettoservidor (
        name: Process Row of IMPTABLETTOSERVIDOR
        type: autoRowProcessing
        target {
            tableName: IMPTABLETTOSERVIDOR
            pkColumn: IDIMP
            pkItem: P330_IDIMP
            supportedOperations: insert
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Liberação realizada! Comunique o Gestor ou Secretária.
        }
        advanced {
            executionMappingIdentifier: 1531756799568474603
        }
        serverSideCondition {
            type: never
        }
    )

    branch (
        name: Go To Page 330
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 330
            }
        }
        serverSideCondition {
            type: request=Value
            value: CREATE
        }
    )

)

