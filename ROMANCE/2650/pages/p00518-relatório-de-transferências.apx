    pageItem P518_EMPRESAEMITENTE (
        type: popupLov
        label {
            label: Empresa Emitente
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nomepessoa d
                     , f.idfornecedor r
                  from fornecedores f
                     , pessoas      p
                 where f.idpessoa = p.idpessoa
                   and f.ativo = 'S'
                 order by 1;
                ```
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

