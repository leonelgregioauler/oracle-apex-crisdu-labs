page 518 (
    name: Relatório de Transferências
    alias: RELATÓRIO-DE-TRANSFERÊNCIAS
    title: Relatório de Transferências
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region relatório-de-transferências (
        name: Relatório de Transferências
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT n.idfornemitente
                     , pck_romance.fnc_nomefornecedor(n.idfornemitente) emitente
                     , n.idrazaosocialfilemit
                     , (SELECT r.cnpj || ' - ' || r.razaosocial
                          FROM razoessociaisfiliais r
                         WHERE r.idrazaosocialfilial = n.idrazaosocialfilemit) razaosocialemitente
                     , n.idfilialdestino
                     , pck_romance.fnc_nomefilial(n.idfilialdestino) destinatario
                     , n.idrazaosocialdestino
                     , (SELECT r.cnpj || ' - ' || r.razaosocial
                          FROM razoessociaisfiliais r
                         WHERE r.idrazaosocialfilial = n.idrazaosocialdestino) razaosocialdestino
                     , n.mei
                     , n.nrnf
                     , n.dtnf
                     , n.datainclusao
                     , n.datarecebimento
                     , n.tipotransacao
                     , n.valortotal
                     , n.datavencimentonfe
                     , n.liberarecebimento
                     , pck_romance.fnc_nomeusuario(n.idusuarioliberareceb) usuario
                     , n.dataliberareceb
                     , n.observliberareceb
                     
                  FROM roman.notasfiscais n
                 WHERE n.dtnf BETWEEN :P518_DATAINICIO AND :P518_DATAFIM
                   AND (:P518_EMPRESAEMITENTE IS NULL OR n.idfornemitente = :P518_EMPRESAEMITENTE)
                   AND (:P518_RAZAOSOCIALEMITENTE IS NULL OR n.idrazaosocialfilemit = :P518_RAZAOSOCIALEMITENTE)
                   AND (:P518_MEI = 'T' OR n.mei = :P518_MEI)
                   AND (:P518_LIBERARECEB = 'T' OR n.liberarecebimento = :P518_LIBERARECEB)
                   AND (:P518_TIPOTRANSACAO = 'T' OR n.tipotransacao = :P518_TIPOTRANSACAO)
                   AND (:P518_NRNF IS NULL OR n.nrnf = :P518_NRNF)
                   AND :P518_FILTRAR = 'S'
                
                ```
            pageItemsToSubmit: [
                P518_DATAINICIO
                P518_DATAFIM
                P518_EMPRESAEMITENTE
                P518_RAZAOSOCIALEMITENTE
                P518_MEI
                P518_LIBERARECEB
                P518_TIPOTRANSACAO
            ]
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 1073176455237721807
        }

