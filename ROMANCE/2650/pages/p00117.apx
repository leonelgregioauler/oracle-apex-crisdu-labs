page 117 (
    name: Romaneio Completo
    title: Romaneio Completo
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region romaneio (
        name: Romaneio
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_imprime.prc_imprimeromaneiocompleto;
                  --
                end;
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
    )

    process habilita-excel (
        name: Habilita Excel
        type: executeCode
        source {
            plsqlCode: OWA_UTIL.mime_header (ccontent_type => 'application/vnd.ms-excel');
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 181991140655479427
        }
    )

    branch (
        execution {
            sequence: 11
        }
        behavior {
            target: {
                page: 30
                successMessage: false
            }
        }
    )

)

