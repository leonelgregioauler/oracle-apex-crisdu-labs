page 165 (
    name: Relatório de Acessos
    title: Relatório de Acessos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region relatório-de-acessos (
        name: Relatório de Acessos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idexpediente
                     , usuario
                     , trunc(datalogin) data
                     , datalogin
                     , datalogout
                from expediente e
                order by 2,1
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Dados não encontrados.
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column DATA (
            type: plainText
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 3
            }
            source {
                dataType: date
            }
            advanced {
                htmlDomId: DATA
                endUserAlias: C
            }
            enableUsersTo {
                pivot: false
            }
        )

        column DATALOGIN (
            type: plainText
            heading {
                heading: Data Login
                alignment: center
            }
            layout {
                sequence: 4
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                htmlDomId: DATALOGIN
                endUserAlias: D
            }
            enableUsersTo {
                pivot: false
            }
        )

        column DATALOGOUT (
            type: plainText
            heading {
                heading: Data Logout
                alignment: center
            }
            layout {
                sequence: 5
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                htmlDomId: DATALOGOUT
                endUserAlias: E
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDEXPEDIENTE (
            type: plainText
            heading {
                heading: Idexpediente
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDEXPEDIENTE
                endUserAlias: A
            }
            enableUsersTo {
                pivot: false
            }
        )

        column USUARIO (
            type: plainText
            heading {
                heading: Usuário
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: USUARIO
                endUserAlias: B
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 1038814 (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn DATA (
                sequence: 2
            )

            displayColumn DATALOGIN (
                sequence: 3
            )

            displayColumn DATALOGOUT (
                sequence: 4
            )

            displayColumn USUARIO (
                sequence: 1
            )

        )

    )

)

