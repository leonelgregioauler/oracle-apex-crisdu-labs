page 221 (
    name: Quitados / Semana
    title: Quitados / Semana
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 40%
        height: 80%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region quitados-semana (
        name: Quitados / Semana
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select empresa
                     , ''''||semana semana
                     , sum(total) total
                from (  select pck_romance.fnc_nomefilial(o.idfilial) empresa
                             , semanabaixa semana
                             , sum(b.valorcobrado) total
                        from catal.boletos b
                           , pedidos       o
                        where b.semanabaixa like '%2018'
                          and b.idpedido    = o.idpedido
                          and o.idfilial    != 1041 
                        group by o.idfilial
                               , semanabaixa
                        union
                        select pck_romance.fnc_nomefilial(p.idfilial) empresa
                             , semanaemissao SEMANA
                             , sum(p.vlrtotalsemcomissao)
                        from catal.pedidos p
                        where p.situacao     = 'O'
                         and semanaemissao   like '%2018'
                         and p.idfilial     != 1041
                         and not exists ( select 1
                                          from boletos b
                                          where b.idpedido = p.idpedido)
                        group by p.idfilial 
                               , semanaemissao
                        union
                        select pck_romance.fnc_nomefilial(pff.idfilialromance) empresa
                             , pck_util.fnc_semanaid( pf2.idsemanapago)  semana
                             , sum(pf2.valorpago * nvl(pff.fatorconversao,1))
                        from favorita.pagamentospedidos pf2
                           , favorita.vencimentospedidos v
                           , favorita.pedidos pff
                        where pf2.idsemanapago      in ( select f.idsemana 
                                                        from fechamentossemanais f 
                                                        where f.semana like '%2018' )
                          and v.idpedido           = pff.idpedido
                          and v.idvencimentopedido = pf2.idvencimentopedido
                          and pf2.idsituacao       = 20 --- quitado
                          and v.situacaovencimento = 'V'
                        group by pff.idfilialromance
                               , pf2.idsemanapago )
                group by empresa, semana
                order by 1, Pck_Util.fnc_idsemana( semana)
                
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 5103127458968375442
        }

        column EMPRESA (
            type: plainText
            heading {
                heading: Empresa
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column SEMANA (
            type: plainText
            heading {
                heading: Semana
                alignment: center
            }
            layout {
                sequence: 12
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column TOTAL (
            type: plainText
            heading {
                heading: Total
                alignment: end
            }
            layout {
                sequence: 2
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 25517440 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn EMPRESA (
                sequence: 1
            )

            displayColumn SEMANA (
                sequence: 3
            )

            displayColumn TOTAL (
                sequence: 2
            )

            aggregate (
                column: TOTAL
            )

        )

    )

)

