    region lista-de-funcionários-demitidos (
        name: Lista de Funcionários Demitidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT CASE 
                          WHEN ( SELECT f.idvendedora
                                         FROM pessoas p
                                            , vendedoras f
                                         WHERE p.cpf = f.cpf
                                           AND f.idpessoa = p.idpessoa
                                             and f.ativo = 'N' )  IS NOT NULL THEN
