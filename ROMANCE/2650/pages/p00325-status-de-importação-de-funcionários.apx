                                           ELSE 
                                             case
                                                when exists ( SELECT f.idvendedora
                                                         FROM pessoas p
                                                            , vendedoras f
                                                            , notasvendas n
                                                         WHERE p.cpf = f.cpf
                                                           AND f.idpessoa = p.idpessoa
                                                           and f.idvendedora = n.idvendedora
                                                           and n.idsituacaonotavenda = 3
                                                             and f.ativo = 'S' ) then
                                                    'OK'
