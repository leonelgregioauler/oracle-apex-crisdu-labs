page 325 (
    name: Status de Importação de Funcionários
    alias: STATUS-DE-IMPORTAÇÃO-DE-FUNCIONÁRIOS
    title: Status de Importação de Funcionários
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region dashborad (
        name: Dashborad
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                SELECT  pessoa situacao, count(1) qtd
                FROM ( SELECT CASE 
                                          WHEN ( SELECT f.idvendedora
                                                         FROM pessoas p
                                                            , vendedoras f
                                                         WHERE p.cpf = f.cpf
                                                           AND f.idpessoa = p.idpessoa )  IS NOT NULL THEN
                                                           'OK'
                                                           ELSE 
                                                           'Verificar'
                                                           END Vendedora
                                    , CASE 
                                          WHEN ( SELECT f.idfuncionario
                                                         FROM pessoas p
                                                            , funcionarios f
                                                         WHERE p.cpf = f.cpf
                                                           AND f.idpessoa = p.idpessoa )   IS NOT NULL THEN
                                                           'OK'
                                                           ELSE 
                                                           'Verificar'
                                                           END funcionarios
                                    , CASE 
                                          WHEN ( SELECT p.idpessoa
                                                         FROM pessoas p
                                                         WHERE p.cpf = f.cpf )   IS NOT NULL THEN
                                                           'OK'
                                                           ELSE 
                                                           'Verificar'
                                                           END Pessoa 
                                FROM FUNCIONARIOS_CRISDU f
                                where datademissao is null )
                GROUP BY  pessoa    
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        settings {
            labelColumn: SITUACAO
            valueColumn: QTD
        }
    )

    region dashborad-demitidos (
        name: Dashborad Demitidos
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                SELECT  Vendedora situacao, count(1) qtd
                FROM ( SELECT CASE 
                          WHEN ( SELECT f.idvendedora
                                         FROM pessoas p
                                            , vendedoras f
                                         WHERE p.cpf = f.cpf
                                           AND f.idpessoa = p.idpessoa
                                             and f.ativo = 'N' )  IS NOT NULL THEN
                                           'OK'
                                           ELSE 
                                             case
                                                when exists ( SELECT f.idvendedora
                                                         FROM pessoas p
                                                            , vendedoras f
                                                            , notasvendas n
                                                         WHERE p.cpf = f.cpf
                                                           AND f.idpessoa = p.idpessoa
                                                           and f.idvendedora = n.idvendedora
                                                           and n.idsituacaonotavenda = 3
                                                             and f.ativo = 'S' ) then
                                                    'OK'
                                                else         
                                                   'Verificar'
                                                end
                                           END Vendedora
                                FROM FUNCIONARIOS_CRISDU_DEMITIDOS f
                                where exists ( SELECT p.idpessoa
                                                         FROM pessoas p
                                                         WHERE p.cpf = f.cpf ) )
                GROUP BY  vendedora 
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        settings {
            labelColumn: SITUACAO
            valueColumn: QTD
        }
    )

    region lista-de-funcionários-ativos-afastados (
        name: Lista de Funcionários Ativos/Afastados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT CASE 
                          WHEN ( SELECT f.idvendedora
                                         FROM pessoas p
                                            , vendedoras f
                                         WHERE p.cpf = f.cpf
                                           AND f.idpessoa = p.idpessoa )  IS NOT NULL THEN
                                           'OK'
                                           ELSE 
                                           'Verificar'
                                           END Vendedora
                    , CASE 
                          WHEN ( SELECT f.idfuncionario
                                         FROM pessoas p
                                            , funcionarios f
                                         WHERE p.cpf = f.cpf
                                           AND f.idpessoa = p.idpessoa )   IS NOT NULL THEN
                                           'OK'
                                           ELSE 
                                           'Verificar'
                                           END funcionarios
                    , CASE 
                          WHEN ( SELECT p.idpessoa
                                         FROM pessoas p
                                         WHERE p.cpf = f.cpf )   IS NOT NULL THEN
                                           'OK'
                                           ELSE 
                                           'Verificar'
                                           END Pessoa
                    , CASE 
                          WHEN ( SELECT c.idcidade
                                     from cidades c
                                        , estados e
                                     where upper(c.nomecidade) = upper(f.cidade) 
                                       and e.idestado = c.idestado
                                       and trim(e.sigla) = trim(f.uf) )   IS NOT NULL THEN
                                           'OK'
                                           ELSE 
                                           'Verificar'
                                           END cidade_
                     , f.*
                FROM FUNCIONARIOS_CRISDU f 
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1131724360096910368
        }

