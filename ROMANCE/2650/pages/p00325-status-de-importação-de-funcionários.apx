    pageItem P325_ULTIMAATUALIZACAO (
        type: displayOnly
        label {
            label: Última Atualização
            alignment: left
        }
        layout {
            sequence: 10
            region: @lista-de-funcionários-ativos-afastados
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                SELECT to_char(max(v.updated_time),'dd/mm/rrrr hh24:mi:ss') ultima_atualizacao
                FROM pessoas p
                   , vendedoras v
                   , FUNCIONARIOS_CRISDU f 
                WHERE p.cpf = f.cpf   
                  AND p.idpessoa = v.idpessoa
                ```
            used: always
        }
    )

