page 313 (
    name: Contas sem Movimentações
    title: Contas sem Movimentações
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 50%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region contas-sem-movimentações (
        name: Contas sem Movimentações
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idcontabanc
                     , pck_romance.fnc_nomepessoa(c.idpessoa) destino
                     , pck_cadastros_rmc.fnc_retornacontabancaria(c.idcontabanc) conta
                     , null criarordem
                from contasbancarias c
                   , fornecedores f
                where f.idpessoa = c.idpessoa
                  and f.ativo    = 'S'
                  and not exists ( select 1
                                   from extratoscontasbancarias ex
                                   where ex.idcontabancaria = c.idcontabanc )
                order by 2
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1576761557085910437
        }

        column CONTA (
            type: plainText
            heading {
                heading: Conta
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column CRIARORDEM (
            type: link
            heading {
                heading: Nova Ordem
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            link {
                target: {
                    page: 283
                    items: {
                        P283_IDCONTABANCARIA: #IDCONTABANC#
                        P283_IDENTIFICADO:
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-view.png" class="apex-edit-view" alt="">
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column DESTINO (
            type: plainText
            heading {
                heading: Destino
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column IDCONTABANC (
            type: hidden
            heading {
                heading: Idcontabanc
            }
            layout {
                sequence: 10
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 15797178 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CONTA (
                sequence: 3
            )

            displayColumn CRIARORDEM (
                sequence: 4
            )

            displayColumn DESTINO (
                sequence: 2
            )

            displayColumn IDCONTABANC (
                sequence: 1
            )

        )

    )

)

