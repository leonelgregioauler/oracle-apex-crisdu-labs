    region ligações-e-mensagens-pendentes (
        name: Ligações e Mensagens Pendentes
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idcontrole
                     , '('||substr(c.telefone,1,2)||')'||substr(c.telefone,3,4)||'.'||substr(c.telefone,7,10)
                                 ||' ('||( select o.nome from operadorastelefonia o where c.idoperadoratel = o.idoperadoratel )||')' "Telefone"
                     , pck_romance.fnc_nomerepresentante(c.idrepresentante)||' - '||pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(c.idrepresentante)) "Representante"
                     , c.dataligacao
                     , c.idticketdeposito 
                     , ( select count(1)
                         from controleligacoes cc
                         where cc.idcontroleorig = c.idcontrole )+1 qtdligacoes
                		 , ( select  pck_util.fnc_retornatelefones(idpessoa)
                		     from pessoas
                				 where idpessoa = ( select idpessoa from representantes where idrepresentante = c.idrepresentante ) ) telefones
                 , MENSAGEM
                     , null "DELETAR"
                from controleligacoes c
                where c.situacao = 'P'
                  and c.idcontroleorig is null
                order by dataligacao
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
