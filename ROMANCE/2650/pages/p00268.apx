    process caixapostal (
        name: CAIXAPOSTAL
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidcontrole   number := :P268_IDCONTROLE;
                begin
                  --
                  select c.idcontrole 
                  into vidcontrole
                  from controleligacoes c
                  where c.idcontrole = vidcontrole;
                  --
                  update controleligacoes
                  set situacao = 'A'
                  where idcontrole = vidcontrole;
                  --
                  update controleligacoes c
                  set situacao = 'A'
                  where c.idcontroleorig = vidcontrole;
                  --
                  insert into historicoligacoes (idhistoricoligacoes, idcontroleligacoes, data, usuario, observacao,controletempo)
                  values (seq_idhistoricolig.nextval,  vidcontrole, sysdate, :APP_USER, 'Caiu na Caixa Postal','P');
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ligação Atualizada.
        }
        advanced {
            executionMappingIdentifier: 529759211088356178
        }
        serverSideCondition {
            type: request=Value
            value: CAIXAPOSTAL
        }
    )

    process concluido (
        name: CONCLUIDO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidcontrole   number := :P268_IDCONTROLE;
                begin
                  --
                  select c.idcontrole 
                  into vidcontrole
                  from controleligacoes c
                  where c.idcontrole = vidcontrole;
                  --
                  update controleligacoes
                  set situacao = 'C'
                    , dataconclusao = sysdate
                  where idcontrole = vidcontrole;
                  --
                  update controleligacoes c
                  set situacao = 'C'
                    , dataconclusao = sysdate
                  where c.idcontroleorig = vidcontrole;
                  --
                  insert into historicoligacoes (idhistoricoligacoes, idcontroleligacoes, data, usuario, observacao,controletempo)
                  values (seq_idhistoricolig.nextval,  vidcontrole, sysdate, :APP_USER, 'Ligação Concluída!','P');
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Ligação Atualizada.
        }
        advanced {
            executionMappingIdentifier: 527176329397355720
        }
        serverSideCondition {
            type: request=Value
            value: CONCLUIDO
        }
    )

    process deletar (
        name: DELETAR
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidcontrole   number := :P268_IDCONTROLE;
                begin
