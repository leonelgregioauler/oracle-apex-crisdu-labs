    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function doLoad()
            {
            setTimeout( "refresh()", 120*1000 );
            }
            
            function refresh()
            {
            window.location.href = window.location;
            }
            
            function NAOATENDEU(vidcontrole) 
            {
              document.getElementById('P268_IDCONTROLE').value = vidcontrole;
              apex.submit('NAOATENDEU');
            }
            
            function CAIXAPOSTAL(vidcontrole) 
            {
              document.getElementById('P268_IDCONTROLE').value = vidcontrole;
              apex.submit('CAIXAPOSTAL');
            }
            
            
            function DELETAR(vidcontrole) 
            {
              
              document.getElementById('P268_IDCONTROLE').value = vidcontrole;
              apex.submit('DELETAR');
            }
            
            function RETOMAR(vidcontrole) 
            {
              document.getElementById('P268_IDCONTROLE').value = vidcontrole;
              apex.submit('RETOMAR');
            }
            
            function CONCLUIDO(vidcontrole) 
            {
              document.getElementById('P268_IDCONTROLE').value = vidcontrole;
              apex.submit('CONCLUIDO');
            }
            
            function VERHISTORICO(vidcontrole) 
            {
            javascript:window.open('f?p=&APP_ID.:270:&SESSION.::NO:270:P270_IDCONTROLE:'+vidcontrole
                                    ,'popup'
                                    ,'toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,resizable=no,width=1400,height=800,screenX=50,screenY =100');void(0);
            }
            
            function VERHISTORICOLIGACAO(vidcontrole) 
            {
            javascript:window.open('f?p=&APP_ID.:273:&SESSION.::NO:273:P273_IDCONTROLE:'+vidcontrole
                                    ,'popup'
                                    ,'toolbar=yes,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=800,height=600,screenX=50,screenY =100');void(0);
            }
            
            function INCLUIRHISTORICO(vidcontrole) 
            {
            javascript:window.open('f?p=&APP_ID.:271:&SESSION.::NO:271:P271_IDCONTROLELIGACOES:'+vidcontrole
                                    ,'popup'
                                    ,'toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,resizable=no,width=600,height=400,screenX=50,screenY =100');void(0);
            }
            
            
            ```
