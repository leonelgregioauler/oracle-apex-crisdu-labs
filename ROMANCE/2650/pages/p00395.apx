    pageItem P395_SEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(semana,'00')||'/'||ano display_value
                     , idsemana return_value
                from semana_dias s
                where s.dt_fim < trunc(sysdate)
                  and ( :P395_ANO is null or ano = :P395_ANO)
                order by idsemana desc
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 80
            region: @filtro-2
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
