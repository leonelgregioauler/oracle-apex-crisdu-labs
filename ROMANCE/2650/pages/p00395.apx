    region transferências (
        name: Transferências
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nf.IDNOTAFISCAL
                     , to_char(nf.dtnf,'RRRR') ANO
                     , to_char(nf.dtnf,'MONTH') mes
                     , nf.nrnf 
                     , decode( nf.tiponota, 'T', 'Transferência'
                                          , 'C', 'Compra'
                                          , 'R', 'Reserva/Ordem Pgto'
                                          , 'D', 'Despesa') "Tipo NF"
                     , pck_romance.fnc_nomefilial(pidfilial => nf.idfilialemitente  ) Emitente
                     , pck_romance.fnc_nomefilial(pidfilial => nf.idfilialdestino ) "Filial Destino"
                     , pck_romance.fnc_nometransportadora(pidtransp => nf.idtransportadora )  "Transportadora"
                     , nf.dtnf 
                     , ( select sum(valor) from vencimentos v where v.idnotafiscal = nf.idnotafiscal ) totalvencimentos
                     , ( select sum((nvl(qtd_pp,0) + nvl(qtd_p,0) + nvl(qtd_m,0) + nvl(qtd_g,0) + nvl(qtd_gg,0) + nvl(qtd_egg,0)+ nvl(qtd_exgg,0) + nvl(qtd_u,0)) * inf.custound)
                         from itemnf inf
                         where inf.idnotafiscal = nf.idnotafiscal ) totalitens
                     , ( select sum(valor) + ( sum(valor) *0.1)   from vencimentos v where v.idnotafiscal = nf.idnotafiscal ) valortotalfilial
                     , decode(NF.SITUACAO,'A','Ativa/Aprovado'
                                         ,'C','Cancelada'
                                         ,'P','Aguardando Aprovação'
                                         ,'E','Aguardando Envio para Aprovação'
                                         ,'Ativa') Situacao
                     , decode(NF.SITUACAOFILIAL,'A','Aguardando Recebimento','R','Recebida','P','Parcialmente Recebida') "Situação Recebimento"
                     , nf.documento 
                     , initcap(nf.USUARIO) "Usuário"
                     , nf.conhecimentotransporte "CTE"
                     , nf.observacao "Observação"
                  /*   , ( select sum(valor) 
                         from fabri.vencimentosnotavenda v 
                         where v.idnotavenda = ( select idnotavenda
                                                    from fabri.notasvendas nv
                                                    where nv.nrodocumento = nf.documento ) ) totalvencimentosfabrica
                     , ( select sum((nvl(qtd_pp,0) + nvl(qtd_p,0) + nvl(qtd_m,0) + nvl(qtd_g,0) + nvl(qtd_gg,0) + nvl(qtd_egg,0) + nvl(qtd_u,0)) * inv.valorvenda)
                         from fabri.itensnotavenda inv
                         where inv.idnotavenda = ( select idnotavenda
                                                    from fabri.notasvendas nv
                                                    where nv.nrodocumento = nf.documento ) ) totalitensfabrica*/
                     , ( select pc.idpedidocompra from pedidoscompras pc where pc.idpedidocompra = nf.idpedidocompra ) "Pedido de Compra"
                     , DATARECEBIMENTO "Data Recebimento"
                     , nf.idsemananota 
                     , pck_util.fnc_semanaid(nf.idsemananota ) semana
                     ,(select count(1) from anexosnotasfiscais a where a.idnotafiscal = nf.idnotafiscal) "Qtd Anexos"
                     , pck_estoque.fnc_verifidivergconfnota(nf.idnotafiscal) "Possui divergência"
                     , volumes 
                     , DATAINCLUSAO
                     , decode(nf.antecipacao,'S','Sim','Não') antecipacao
                from notasfiscais nf
                where tiponota = 'T'
                  and situacao != 'E'
                  and (:P395_IDFORNECEDOR      is null or nf.idfornemitente = :P395_IDFORNECEDOR )
                  and (:P395_IDFILIALEMITENTE  is null or nf.idfilialemitente = :P395_IDFILIALEMITENTE   )
                  and (:P395_DOCUMENTO         is null or trim(nf.documento) = trim(:P395_DOCUMENTO) )
                  and (:P395_SEMANA            is null or nf.idsemananota  = :P395_SEMANA)
                  and (:P395_ANO               = 0 or extract(year from nf.dtnf) = :P395_ANO )
                  and (:P395_FILTRAR_DATA      = 'N' or trunc(nf.DATAINCLUSAO) between to_date(:P395_DATAINICIO) and to_date(:P395_DATAFIM) )
                  and (:P395_TIPOFILIALDESTINO = 'X' or pck_romance.fnc_tipofilial(nf.idfilialdestino) = :P395_TIPOFILIALDESTINO )
                  and (:P395_SITUACAORECEBIMENTO = 'T'
                       or nf.situacaofilial = :P395_SITUACAORECEBIMENTO )
                  and (:P395_TIPOPRODUTO       = 'T' 
                       or ( :P395_TIPOPRODUTO       = 'V' and exists ( select 1
                                                                      from itemnf it
                                                                         , produtos p
                                                                      where it.idnotafiscal = nf.idnotafiscal
                                                                        and it.idproduto    = p.idproduto
                                                                        and p.venda         = 'S' ) )
                       or ( :P395_TIPOPRODUTO       = 'I' and exists ( select 1
                                                                      from itemnf it
                                                                         , produtos p
                                                                      where it.idnotafiscal = nf.idnotafiscal
                                                                        and it.idproduto    = p.idproduto
                                                                        and p.venda         = 'N' ) ) )
                
                ```
            pageItemsToSubmit: [
                P395_TIPOFILIALDESTINO
                P395_IDFORNECEDOR
                P395_TIPOPRODUTO
                P395_DOCUMENTO
                P395_ANO
                P395_SEMANA
                P395_IDFILIALEMITENTE
                P395_SITUACAORECEBIMENTO
                P395_FILTRAR_DATA
                P395_DATAINICIO
                P395_DATAFIM
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
