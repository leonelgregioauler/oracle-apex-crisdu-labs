            conditionType: expression
            plsqlExpression: pck_util.fnc_verificaacesso(2653,v('APP_USER')) = 'S' -- VER_EDITAR_NOTA_FISCAL (T9892351)
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
