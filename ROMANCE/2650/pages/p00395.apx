    dynamicAction atualiza-relatório (
        name: atualiza relatório
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P395_IDFORNECEDOR
                P395_TIPOFILIALDESTINO
                P395_TIPOPRODUTO
                P395_DOCUMENTO
                P395_ANO
                P395_SEMANA
                P395_IDFILIALEMITENTE
                P395_SITUACAORECEBIMENTO
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @transferências
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction mostra-datas (
        name: Mostra Datas
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P395_FILTRAR_DATA
        }
        clientSideCondition {
            type: item=value
            item: P395_FILTRAR_DATA
            value: I
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P395_DATAINICIO
                    P395_DATAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P395_DATAINICIO
                    P395_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: Go To Page 26
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 395
                items: {
                    P395_IDFORNECEDOR: &P395_IDFORNECEDOR.
                    P395_TIPOFILIALDESTINO: &P395_TIPOFILIALDESTINO.
                    P395_DOCUMENTO: &P395_DOCUMENTO.
                    P395_ANO: &P395_ANO.
                    P395_SEMANA: &P395_SEMANA.
                    P395_SITUACAORECEBIMENTO: &P395_SITUACAORECEBIMENTO.
                }
                action: resetPagination
            }
        }
    )

