    region ligações-pendentes (
        name: Ligações Pendentes
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idcontrole
                     , '<b>'||c.telefone
                                 ||' </b> ('||( select o.nome from operadorastelefonia o where c.idoperadoratel = o.idoperadoratel )||')' 
                     ||'<br>' ||pck_romance.fnc_nomerepresentante(c.idrepresentante)||' - '||pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(c.idrepresentante)) distribuidor
                     , c.dataligacao
                     , c.idticketdeposito 
                     , ( select count(1)
                         from controleligacoes cc
                         where cc.idcontroleorig = c.idcontrole )+1 qtdligacoes
                		 , ( select  pck_util.fnc_retornatelefones(idpessoa)
                		     from pessoas
                				 where idpessoa = ( select idpessoa from representantes where idrepresentante = c.idrepresentante ) ) telefones
                     , null "DELETAR"
                from controleligacoes c
                where c.situacao = 'P'
                  and c.idcontroleorig is null
                order by dataligacao
                ```
        }
        layout {
            sequence: 60
            slot: body
            startNewRow: false
            newColumn: false
        }
