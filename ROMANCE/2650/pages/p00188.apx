    region minhas-ligações (
        name: Minhas Ligações
        type: tabform
        source {
            sqlQuery:
                ```sql
                select ROWID
                     , IDCONTROLE
                     , pck_romance.fnc_nomerepresentante(c.idrepresentante)||' - '||pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(c.idrepresentante))    "Representante"
                     , c.telefone ||  '<br><br> Qtd de Ligações: '||( select count(1)+1
                                                                   from controleligacoes cc
                                                                   where cc.idcontroleorig = c.idcontrole )  ||'<br><br><i>'||
                       ( select  pck_util.fnc_retornatelefones(idpessoa)
                		 from pessoas
                		 where idpessoa = ( select idpessoa from representantes where idrepresentante = c.idrepresentante ) ) ||'</i>' telefones
                     , idoperadoratel
                     , DATALIGACAO
                     , USUARIOATENDEU
                     , IDTICKETDEPOSITO
                     , IDTIPOLIGACAO
                     , decode(situacao,'A','Aguardando','P','Pendente','C','Concluido','E','Em Atendimento') "Situação"
                     , decode(situacao,'A','Aguardando','P','Pendente','C','Concluido','E','Em Atendimento') 
                     ||'<br>'||          decode(situacao,'A',null,'<a href="javascript: NAOATENDEU('||idcontrole||');"><img src="#APP_IMAGES#telefonevermelho.png" ></a>') 
                     ||'<br>'|| decode(c.situacao,'A',null,'<a href="javascript: CAIXAPOSTAL('||idcontrole||');"><img src="#APP_IMAGES#caixapostal.png" ></a>') 
                     ||'<br>'|| decode(situacao,'A',null,decode(IDTIPOLIGACAO, null, null
                                                                          , '<a href="javascript: CONCLUIDO('||idcontrole||');"><img src="#APP_IMAGES#telefoneverde.png" ></a>')) 
                     ||'<br>'|| decode(c.situacao,'A',decode( ( select count(1)
                                                        from controleligacoes c1
                                                        where c1.usuarioatendeu = :APP_USER
                                                          and c1.situacao = 'E' ),0,'<a href="javascript: RETOMAR('||idcontrole||');"><img src="#APP_IMAGES#telefoneverde.png" ></a>',null)) acoes
                from CONTROLELIGACOES C
                where ( :APP_USER = 'EVERTON' or USUARIOATENDEU = :APP_USER )
                  and situacao in ('A','E')
                  and idcontroleorig is null
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
