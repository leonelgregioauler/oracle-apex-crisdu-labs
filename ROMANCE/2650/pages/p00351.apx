page 351 (
    name: Cadastro de Unidade de Negócio
    title: Cadastro de Unidade de Negócio
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 60%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }

    region cadastro-de-unidade-de-negócio (
        name: Cadastro de Unidade de Negócio
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P351_ATIVO (
        type: radioGroup
        label {
            label: Ativo
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 90
            region: @cadastro-de-unidade-de-negócio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P351_CODIGOVIRTUALAGE (
        type: numberField
        label {
            label: Cód. Virtual Age
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 60
            region: @cadastro-de-unidade-de-negócio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P351_CONTABILIZARBI (
        type: radioGroup
        label {
            label: Contabilizar BI
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @cadastro-de-unidade-de-negócio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P351_DATAABERTURA (
        type: datePicker
        label {
            label: Data De Abertura
            alignment: left
        }
        layout {
            sequence: 100
            region: @cadastro-de-unidade-de-negócio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 15
        }
        readOnly {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                  from acessos a
                 where a.idaplicacao = 3199
                   and a.usuario = v('APP_USER')
                   and :P351_IDUNIDADEDENEGOCIO IS NOT NULL
                ```
        }
    )

    pageItem P351_IDGRUPONEGOCIO (
        type: selectList
        label {
            label: Grupo de Negócio
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select descricao
                     , idgruponegocio
                from gruposnegocios 
                where idsegmentonegocio = :P351_IDSEGMENTONEGOCIO
                order by 1
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P351_IDSEGMENTONEGOCIO
        }
        layout {
            sequence: 50
            region: @cadastro-de-unidade-de-negócio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P351_IDSEGMENTONEGOCIO (
        type: selectList
        label {
            label: Segmento
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idsegmentonegocio
                from segmentosnegocios 
                order by 1
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 40
            region: @cadastro-de-unidade-de-negócio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P351_IDUNIDADEDENEGOCIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @cadastro-de-unidade-de-negócio
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P351_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @cadastro-de-unidade-de-negócio
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P351_NOME (
        type: textField
        label {
            label: Unidade de Negócio
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @cadastro-de-unidade-de-negócio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P351_RESPONSAVEL (
        type: shuttle
        label {
            label: Responsável
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) d
                     , u.usuario    r
                  from usuarios u
                     , pessoas  p
                 where u.ativo = 'S'
                   and u.ididioma = 1
                   and u.idpessoa = p.idpessoa
                   and u.usuario is not null
                   order by 1
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 110
            region: @cadastro-de-unidade-de-negócio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 5
        }
    )

    button criar (
        buttonName: CRIAR
        label: Criar
        layout {
            sequence: 130
            region: @cadastro-de-unidade-de-negócio
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P351_IDUNIDADEDENEGOCIO
        }
    )

    button deletar (
        buttonName: DELETAR
        label: Deletar
        layout {
            sequence: 120
            region: @cadastro-de-unidade-de-negócio
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P351_IDUNIDADEDENEGOCIO
        }
    )

    button salvar (
        buttonName: SALVAR
        label: Salvar
        layout {
            sequence: 140
            region: @cadastro-de-unidade-de-negócio
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P351_IDUNIDADEDENEGOCIO
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 150
            region: @cadastro-de-unidade-de-negócio
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process consulta-dml-em-unidades (
        name: Consulta DML em Unidades
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                   v_lista varchar2(4000);
                begin
                  --
                  PCK_CADASTROS_RMC.PRC_UNIDADESDENEGOCIOS( PIDUNIDADEDENEGOCIO => :P351_IDUNIDADEDENEGOCIO,
                                                            PNOME               => :P351_NOME,
                                                            PIDSEGMENTONEGOCIO  => :P351_IDSEGMENTONEGOCIO,
                                                            PIDGRUPONEGOCIO     => :P351_IDGRUPONEGOCIO,
                                                            PCODIGOVIRTUALAGE   => :P351_CODIGOVIRTUALAGE,
                                                            PCONTABILIZARBI     => :P351_CONTABILIZARBI,
                                                            PATIVO              => :P351_ATIVO,
                                                            PMD5                => :P351_MD5,
                                                            POPERACAO_DML       => 'S',
                                                            PRESPONSAVEL        => v_lista,
                                                            PDATAABERTURA       => :P351_DATAABERTURA);
                
                  :P351_RESPONSAVEL := rtrim(v_lista, ':');
                
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 6175038461480449
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P351_IDUNIDADEDENEGOCIO
        }
    )

    process processo-dml-em-unidades-de-negocios (
        name: Processo DML em Unidades de Negocios
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                  v_dataabertura date;
                begin
                  --
                  if v('REQUEST') = 'CRIAR' then 
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'SALVAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'DELETAR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  v_dataabertura := TO_DATE(:P351_DATAABERTURA,'DD/MM/RRRR');
                  --
                  PCK_CADASTROS_RMC.PRC_UNIDADESDENEGOCIOS( PIDUNIDADEDENEGOCIO => :P351_IDUNIDADEDENEGOCIO,
                                                            PNOME               => :P351_NOME,
                                                            PIDSEGMENTONEGOCIO  => :P351_IDSEGMENTONEGOCIO,
                                                            PIDGRUPONEGOCIO     => :P351_IDGRUPONEGOCIO,
                                                            PCODIGOVIRTUALAGE   => :P351_CODIGOVIRTUALAGE,
                                                            PCONTABILIZARBI     => :P351_CONTABILIZARBI,
                                                            PATIVO              => :P351_ATIVO,
                                                            PMD5                => :P351_MD5,
                                                            POPERACAO_DML       => voperacao_dml,
                                                            PRESPONSAVEL        => :P351_RESPONSAVEL,
                                                            PDATAABERTURA       => v_dataabertura);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo realizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 12387386896260630
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('CRIAR','SALVAR','DELETAR')
                ```
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 351
                items: {
                    P351_IDUNIDADEDENEGOCIO: &P351_IDUNIDADEDENEGOCIO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('CRIAR','SALVAR')
                ```
        }
    )

    branch (
        name: Go To Page 350
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 350
                action: resetPagination
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('VOLTAR','DELETAR')
        }
    )

)

