    )

    dynamicAction tipo-data (
        name: Tipo Data
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P410_TIPO_PESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P410_TIPO_PESQUISA
            value: P
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P410_DATAINICIO
                    P410_DATAFIM
                    P410_TIPODATA
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P410_DATAINICIO
                    P410_DATAFIM
                    P410_TIPODATA
                ]
            }
            execution {
                sequence: 10
            }
        )

