    pageItem P410_IDCONTAFINAN (
        type: popupLov
        label {
            label: Conta
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nomeconta
                     , c.idcontafinan
                from contasfinanceiras c
                where c.ativo = 'S'
                  and c.centrodecusto = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P410_IDFORNECEDOR (
        type: popupLov
        label {
            label: Fornecedor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefornecedor(idfornecedor) ||'  --  '||pck_romance.fnc_nomepessoa(idpessoa) ||'   ID:'||idfornecedor display_value
                     , fe.idfornecedor return_value
                from fornecedores fe
                where fe.ativo = 'S'
                order by 1
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P410_IDSUBCONTAFINAN (
        type: popupLov
        label {
            label: Sub Conta
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select sc.nomeconta
                     , sc.idsubcontafinan
                from subcontasfinanceiras sc
                where sc.ativo = 'S'
                  and exists ( select 1
                               from matrizregrasdespesas m
                               where m.idsubcontafinan = sc.idsubcontafinan )
                  and ( :P410_IDCONTAFINAN is null or sc.idcontafinan = :P410_IDCONTAFINAN )
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P410_IDCONTAFINAN
        }
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

