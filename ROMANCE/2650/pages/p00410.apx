    region posição-depósitos (
        name: Posição Depósitos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.registro
                     , s.idfornecedor
                     , pck_romance.fnc_nomefornecedor(s.idfornecedor) fornecedor
                     , s.datalancamento
                     , s.datamovimento
                     , s.fatura
                     , s.destino
                     , s.identificacao
                     , s.valorapagar
                     , s.valorpago
                     , pck_romance.fnc_nomecontafinan(s.idcontafinan) contafinan
                     , pck_romance.fnc_nomesubcontafinan(s.idsubcontafinan) subcontafinan
                     , s.considerar
                     , ( select sum(considerar)
                         from posicoesdepositos sd
                         where sd.registro <= s.registro
                           and ( :P410_IDFORNECEDOR is null or sd.idfornecedor = :P410_IDFORNECEDOR )
                           and ( :P410_FILTAR = 'S' )
                           and ( :P410_TIPO_PESQUISA   = 'T'
                              or ( :P410_TIPO_PESQUISA = 'P' and ( :P410_TIPODATA = 'L' and s.datalancamento between to_date(:P410_DATAINICIO,'DD/MM/RRRR') and to_date(:P410_DATAFIM,'DD/MM/RRRR') )
                                                              or ( :P410_TIPODATA = 'M' and s.datamovimento between to_date(:P410_DATAINICIO,'DD/MM/RRRR') and to_date(:P410_DATAFIM,'DD/MM/RRRR') ) )
                              or ( :P410_TIPO_PESQUISA = 'M' and ( :P410_MES is null or extract (month from sd.datamovimento) = :P410_MES ) 
                                                             and extract (year from sd.datamovimento) = :P410_ANO ) ) ) saldo_atual
                from ( select sf.registro
                            , sf.idfornecedor
                            , sf.datalancamento
                            , sf.datamovimento
                            , sf.fatura
                            , sf.destino
                            , sf.identificacao
                            , sf.valorapagar
                            , sf.valorpago
                            , sf.considerar
                            , sf.idcontafinan
                            , sf.idsubcontafinan
                       from posicoesdepositos sf 
                       where ( :P410_IDFORNECEDOR is null or sf.idfornecedor = :P410_IDFORNECEDOR )
                         and ( :P410_FILTAR = 'S' )
                         and ( :P410_TIPO_PESQUISA   = 'T'
                            or ( :P410_TIPO_PESQUISA = 'P' and ( :P410_TIPODATA = 'L' and sf.datalancamento between to_date(:P410_DATAINICIO,'DD/MM/RRRR') and to_date(:P410_DATAFIM,'DD/MM/RRRR') )
                                                            or ( :P410_TIPODATA = 'M' and sf.datamovimento between to_date(:P410_DATAINICIO,'DD/MM/RRRR') and to_date(:P410_DATAFIM,'DD/MM/RRRR') ) )
                            or ( :P410_TIPO_PESQUISA = 'M' and ( :P410_MES is null or extract (month from sf.datamovimento) = :P410_MES ) 
                                                           and extract (year from sf.datamovimento) = :P410_ANO ) )
                       order by 1 ) s
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P410_TIPO_RELATORIO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado. Verifique os filtros!
        }
        advanced {
            savedReportMappingIdentifier: 5497370174266153248
        }

