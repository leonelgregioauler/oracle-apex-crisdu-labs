    dynamicAction tipo-mes-ano (
        name: Tipo Mes/Ano
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P410_TIPO_PESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P410_TIPO_PESQUISA
            value: M
        }

        action native-hide (
