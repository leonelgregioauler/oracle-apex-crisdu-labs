                items: [
                    P410_MES
                    P410_ANO
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: Go To Page 410
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 410
                items: {
                    P410_TIPO_PESQUISA: &P410_TIPO_PESQUISA.
                    P410_DATAINICIO: &P410_DATAINICIO.
                    P410_DATAFIM: &P410_DATAFIM.
                    P410_MES: &P410_MES.
                    P410_ANO: &P410_ANO.
                    P410_IDFORNECEDOR: &P410_IDFORNECEDOR.
                    P410_IDCONTAFINAN: &P410_IDCONTAFINAN.
                    P410_IDSUBCONTAFINAN: &P410_IDSUBCONTAFINAN.
                    P410_FILTAR: S
                    P410_TIPODATA: &P410_TIPODATA.
                    P410_TIPO_RELATORIO: &P410_TIPO_RELATORIO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

