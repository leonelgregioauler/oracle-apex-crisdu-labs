    navigation {
        warnOnUnsavedChanges: false
    }
    css {
        inline: ".t-Region-body { background-color: Beige !important;},"
    }
    security {
        pageAccessProtection: unrestricted
    }

    region buscar-lançamentos (
        name: Buscar Lançamentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select l.idlancamentodiverso
                     , l.documento
                     , l.datavencimento
                     , l.fornecedor
                     , l.empresa
                     , l.formapagamento
                     , l.valor
                     , l.valorpago
                     , l.centrodecusto
                     , l.conta
                     , l.subconta
                     , l.tiporegra
                     , l.tipo
                     , l.observacao
                from vw_lancamentosdiversos l
                where l.documento like '%'||:P374_DOCUMENTO||'%'
                order by l.idlancamentodiverso
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P374_INICIAR
            value: B
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 52045334775404144
        }

