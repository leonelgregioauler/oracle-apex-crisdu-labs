    button ver-pendentes (
        buttonName: VER_PENDENTES
        label: Ver Pendentes
        layout {
            sequence: 10
            region: @iniciar-lançamento
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--primary
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 393
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from lancamentosdiversos l 
                where exists ( select 1
                               from rateiosnotasfiscais rn
                               where rn.idlancamentodiverso = l.idlancamentodiverso
                                 and rn.idnotafiscal is null )
                  and :P374_IDLANCAMENTODIVERSO is null
                ```
        }
    )

    dynamicAction confirma-exclusão (
        name: Confirma Exclusão
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @remover
        }

        action native-confirm (
            action: confirm
            settings {
