        column IDCENTRODECUSTO (
            type: selectList
            heading {
                heading: Centro de Custo
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select c.nome
                         , c.idcentrodecusto
                    from centrodecustos c
                    where exists ( select 1
                                   from matrizregrasdespesas m
                                   where m.idcentrodecusto = c.idcentrodecusto
                                     and m.idmatrizregra   = :IDMATRIZDESPESA )
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: IDMATRIZDESPESA
            }
            layout {
                sequence: 130
            }
            source {
                databaseColumn: IDCENTRODECUSTO
                dataType: number
            }
        )

        column IDCONTAFINAN (
            type: selectList
            heading {
                heading: Conta
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select c.nomeconta
                         , c.idcontafinan
                    from contasfinanceiras c
                    where exists ( select 1
                                   from matrizregrasdespesas m
                                   where m.idcontafinan  = c.idcontafinan
                                     and m.idmatrizregra = :IDMATRIZDESPESA )
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: IDMATRIZDESPESA
            }
            layout {
                sequence: 140
            }
            source {
                databaseColumn: IDCONTAFINAN
                dataType: number
            }
        )

        column IDCONTAPAGAMENTO (
            type: selectList
            heading {
                heading: Conta p/ Pagamento
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(cb.beneficiario||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||') - Fornecedor: '||pck_romance.fnc_nomefornecedor(f.idfornecedor) display_value
                         , cb.idcontabanc    return_value
                    from contasbancarias cb
                       , bancos b
                       , fornecedores f
                    where cb.idbanco      = b.idbanco
                      and cb.idpessoa     = f.idpessoa
                      and cb.ativo        = 'S'
                      and f.idfornecedor  = :IDFORNECEDOREMITENTE
                    order by 1
                    ```
            }
            cascadingLov {
                parentColumns: IDFORNECEDOREMITENTE
            }
            layout {
                sequence: 190
            }
            source {
                databaseColumn: IDCONTAPAGAMENTO
                dataType: number
            }
            serverSideCondition {
                type: item=value
                item: P374_FORMAPAGAMENTO
                value: T
            }
        )

        column IDFILIALDESTINO (
            type: selectList
            heading {
                heading: Empresa Destino
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select f.nome
                         , f.idfilial
                    from vw_filiais f
                    where f.ativo = 'S'
                    ```
            }
            layout {
                sequence: 60
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDFILIALDESTINO
                dataType: number
            }
            default {
                duplicateCopiesExistingValue: false
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

