    process busca-dados (
        name: Busca Dados
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidfornecedor         number;
                  vidrazaosocialforn    number;
                  vidfilialdestino      number;
                  vidrazaosocialdestino number;
                  vdocumento            varchar2(20);
                  vdatavencimento       date;
                  vformapagamento       varchar2(1);
                  vidcontapagamento     number;
                  vantecipacao          varchar2(1);
                  vobservacao           varchar2(4000);
                begin
                  --
                  select l.idfornecedoremitente
                       , l.idrazaosocialemitente
                       , l.idfilialdestino
                       , l.idrazaosocialdestino
                       , l.documento
                       , l.datavencimento
                       , l.formapagamento
                       , l.idcontapagamento
                       , l.antecipacao
                       , l.observacao
                  into vidfornecedor         
                     , vidrazaosocialforn    
                     , vidfilialdestino      
                     , vidrazaosocialdestino 
                     , vdocumento            
                     , vdatavencimento       
                     , vformapagamento       
                     , vidcontapagamento     
                     , vantecipacao    
                     , vobservacao      
                  from lancamentosdiversos l 
                  where l.idlancamentodiverso = :P374_IDLANCAMENTODIVERSO;
                  --
                  :P374_IDFORNECEDOR := vidfornecedor;
                  :P374_IDRAZAOSOCIALFORN := vidrazaosocialforn;
                  :P374_IDFILIALDESTINO := vidfilialdestino;
                  :P374_IDRAZAOSOCIALDESTINO := vidrazaosocialdestino;
                  :P374_DOCUMENTO := vdocumento;
                  :P374_VENCIMENTO := vdatavencimento;
                  :P374_FORMAPAGAMENTO := vformapagamento;
                  :P374_IDCONTABANCARIA := vidcontapagamento;
                  :P374_ANTECIPACAO := vantecipacao;
                  :P374_OBSERVACAO := vobservacao;
                  :P374_INICIAR := 'R';
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 88106750132094510
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P374_PAGINA = 393 and :P374_IDLANCAMENTODIVERSO is not null
        }
    )

    process finaliza-rateios (
        name: Finaliza Rateios
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidnotafiscal number;
                  --
                begin
                  --
                  pck_notasfiscais_rmc.prc_finaliza_rateio( pidlancamentodiverso => :P374_IDLANCAMENTODIVERSO
                                                          , pidnotafiscal => vidnotafiscal );
                  --
                  :P374_IDNOTAFISCAL := vidnotafiscal;
                  --
                end;
