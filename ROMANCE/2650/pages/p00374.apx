    region rateios-da-fatura (
        name: Rateios da Fatura
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.idrateionotafiscal
                     , r.documento
                     , r.idfornecedor
                     , r.idrazaosocialfornecedor
                     , r.idfilialdestino
                     , r.idrazaosocialdestino
                     , r.formapagamento
                     , r.idcontapagamento
                     , r.datavencimento
                     , r.valor
                     , r.idmatrizdespesa
                     , r.observacao
                     , r.idlancamentodiverso
                     , r.idnotafiscal
                     , r.usuario
                from rateiosnotasfiscais r
                where r.idnotafiscal is null
                  and r.idlancamentodiverso = :P374_IDLANCAMENTODIVERSO
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P374_INICIAR = 'R' and :P374_IDLANCAMENTODIVERSO is not null
        }
