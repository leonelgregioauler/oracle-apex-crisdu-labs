    pageItem P374_IDCONTABANCARIA (
        type: selectList
        label {
            label: Conta Bancária
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(cb.beneficiario,p.apelido)||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||') - Fornecedor: '||initcap(p.nomepessoa) display_value
                     , cb.idcontabanc    return_value
                from contasbancarias cb
                   , bancos b
                   , pessoas p
                   , fornecedores f
                where cb.idbanco      = b.idbanco
                  and cb.idpessoa     = p.idpessoa
                  and f.idpessoa      = p.idpessoa
                  and f.idfornecedor  = :P374_IDFORNECEDOR
                  and cb.ativo        = 'S'
                order by 1
                ```
            nullDisplayValue: Selecione a Conta
        }
        cascadingLov {
            parentItems: P374_IDFORNECEDOR
        }
        layout {
            sequence: 90
            region: @iniciar-lançamento
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P374_IDFILIALDESTINO (
        type: selectList
        label {
            label: Destino
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(f.idfilial) display_value 
                     , f.idfilial return_value 
                from filiais f
                where f.idfilial in ( 1186, 1065, 1120, 1119 , 1152, 1136, 1235, 1231, 1232, 1233 )
                
                ```
        }
        cascadingLov {
            parentItems: P374_IDFORNECEDOR
        }
        layout {
            sequence: 60
            region: @iniciar-lançamento
            slot: regionBody
            alignment: left
        }
        appearance {
