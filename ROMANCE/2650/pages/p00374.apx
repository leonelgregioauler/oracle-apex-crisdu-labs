            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDLANCAMENTODIVERSO (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IDLANCAMENTODIVERSO
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: seq_idlancamentodiverso
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDMATRIZDESPESA (
            type: selectList
            heading {
                heading: Matriz
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select ( select c.nome
                             from centrodecustos c
                             where c.idcentrodecusto = m.idcentrodecusto )||' - '||pck_romance.fnc_nomecontafinan(m.idcontafinan) a
                         , m.idmatrizregra
                    from matrizregrasdespesas m
                    where m.idfornecedor = :IDFORNECEDOREMITENTE
                      and m.idfilial     = :IDFILIALDESTINO
                      and m.ativo        = 'S'
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: [
                    IDFORNECEDOREMITENTE
                    IDFILIALDESTINO
                ]
            }
            layout {
                sequence: 120
            }
            source {
                databaseColumn: IDMATRIZDESPESA
                dataType: number
            }
        )

        column IDRAZAOSOCIALDESTINO (
            type: selectList
            heading {
                heading: Razão Social
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select r.razaosocial||' - '||r.cnpj a
                         , r.idrazaosocialfilial 
                    from razoessociaisfiliais r
                    where r.idfilial = :IDFILIALDESTINO
                      and r.ativo    = 'S'
                    order by r.idrazaosocialfilial
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: IDFILIALDESTINO
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: IDRAZAOSOCIALDESTINO
                dataType: number
            }
        )

        column IDSUBCONTAFINA (
            type: selectList
            heading {
                heading: Sub Conta
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select c.nomeconta
                         , c.idsubcontafinan
                    from subcontasfinanceiras c
                    where exists ( select 1
                                   from matrizregrasdespesas m
                                   where m.idsubcontafinan = c.idsubcontafinan
                                     and m.idmatrizregra   = :IDMATRIZDESPESA 
                                     and m.idcontafinan = :IDCONTAFINAN )
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: [
                    IDMATRIZDESPESA
                    IDCONTAFINAN
                ]
            }
            layout {
                sequence: 150
            }
            source {
                databaseColumn: IDSUBCONTAFINA
                dataType: number
            }
        )

