        }
    )

    process gera-lançamento-diverso (
        name: Gera Lançamento Diverso
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidlancamentodiverso number;
                  vusuario varchar2(100);
                begin
                  -- 
                  select v('APP_USER')
                  into vusuario
                  from dual;
                  --
                  pck_notasfiscais_rmc.prc_gera_lancamento_rateio(pidlancamentodiverso => vidlancamentodiverso,
                                                                  pidfornecedor => :P374_IDFORNECEDOR,
                                                                  pidrazaosocialemitente => :P374_IDRAZAOSOCIALFORN,
                                                                  pidfilialdestino => :P374_IDFILIALDESTINO,
                                                                  pidrazaosocialdestino => :P374_IDRAZAOSOCIALDESTINO,
                                                                  pdocumento => :P374_DOCUMENTO,
                                                                  pformapagamento => :P374_FORMAPAGAMENTO,
                                                                  pidcontapagamento => :P374_IDCONTABANCARIA,
                                                                  pdatavencimento => :P374_VENCIMENTO,
                                                                  pantecipacao => :P374_ANTECIPACAO,
                                                                  pusuario => vusuario,
                                                                  pobservacao => :P374_OBSERVACAO);
                  --
                  :P374_IDLANCAMENTODIVERSO := vidlancamentodiverso;
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 4899013535797749945
        }
        serverSideCondition {
            whenButtonPressed: @iniciar-rateio
        }
    )

