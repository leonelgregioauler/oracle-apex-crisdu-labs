    region lançamentos-diversos (
        name: Lançamentos Diversos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idlancamentodiverso  
                     , idfornecedoremitente 
                     , idfilialdestino
                     , idrazaosocialdestino
                     , documento            
                     , datavencimento       
                     , formapagamento       
                     , valor                
                     , idmatrizdespesa      
                     , idcentrodecusto      
                     , idcontafinan         
                     , idsubcontafina       
                     , tiporegra            
                     , tipo                 
                     , observacao           
                     , data                 
                     , usuario             
                     , idcontapagamento
                from lancamentosdiversos l
                where l.idnotafiscalgerada is null
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        performance {
            lazyLoading: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 161003985324926852
        }

