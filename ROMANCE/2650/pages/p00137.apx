            used: always
        }
    )

    pageItem P137_TIPO_FORNECEDOR (
        type: selectOne
        label {
            label: Tipo Fornecedor
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select descricao
                     , sigla
                  from table(catal.pck_util.fnc_siglasistema('TIPO_FORNECEDOR',null)) -- 1 = Sigla TIPO_FORNECEDOR
                order by descricao
                ```
        }
        layout {
            sequence: 120
            region: @cadastro-de-fornecedor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: TIPO_FORNECEDOR
            used: always
        }
    )

    button add (
        buttonName: ADD
        label: Adicionar Linha
        layout {
            sequence: 20
            region: @razão-social
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.widget.tabular.addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 40
            region: @cadastro-de-fornecedor
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P137_IDFORNECEDOR
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @cadastro-de-fornecedor
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P137_IDFORNECEDOR
        }
    )

    button gerar-referencia (
        buttonName: GERAR_REFERENCIA
        label: Gerar Referência Favorita
        layout {
            sequence: 10
            region: @cadastro-de-fornecedor
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from fornecedores f
                where f.idfornecedor = :P137_IDFORNECEDOR
                  and f.referencia is null
                ```
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Alterações
        layout {
            sequence: 30
            region: @cadastro-de-fornecedor
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P137_IDFORNECEDOR
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Salvar
        layout {
            sequence: 10
            region: @razão-social
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation idcidade-must-be-numeric (
        name: IDCIDADE must be numeric
        execution {
            sequence: 90
        }
        validation {
            editableRegion: @razão-social
            type: columnIsNumeric
            column: IDCIDADE
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: IDCIDADE
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation idfornecedor-must-be-numeric (
        name: IDFORNECEDOR must be numeric
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @razão-social
            type: columnIsNumeric
            column: IDFORNECEDOR
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: IDFORNECEDOR
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @razão-social
        target {
            tableName: RAZOESSOCIAISFORNEC
            pkColumn: IDRAZAOSOCIALFORN
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# linha(s) atualizada(s), #MRI_COUNT# linha(s) inserida(s).
        }
        advanced {
            executionMappingIdentifier: 761772709257437528
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process fetch-row-from-fornecedores (
        name: Fetch Row from FORNECEDORES
        type: autoRowFetch
        source {
            tableOwner: CATAL
            tableName: FORNECEDORES
            pkColumn: IDFORNECEDOR
            pkItem: P137_IDFORNECEDOR
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Não é possível extrair a linha.
        }
        advanced {
            executionMappingIdentifier: 184672627180087961
        }
    )

    process gera-referencia-da-favorita (
        name: Gera Referencia da Favorita
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vreferencia number;
                begin
                  select max(to_number(referencia))+1
                  into vreferencia
                  from fornecedores;
                  --
                  update fornecedores f
                  set f.referencia = vreferencia
                  where f.idfornecedor = :P137_IDFORNECEDOR;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Referência do Fornecedor atualizada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 4067236261180668505
        }
        serverSideCondition {
            type: request=Value
            value: GERAR_REFERENCIA
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDFORNECEDOR.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P137_IDFORNECEDOR := get_pk; 
                end;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Não é possível obter valor de item de chave primária.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 184672819290087961
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-fornecedores (
        name: Process Row of FORNECEDORES
        type: autoRowProcessing
        target {
            tableOwner: CATAL
            tableName: FORNECEDORES
            pkColumn: IDFORNECEDOR
            pkItem: P137_IDFORNECEDOR
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        error {
            errorMessage: Não é possível processar a linha da tabela FORNECEDORES.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 184673029168087961
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 50
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 184673229644087961
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 137
            }
            saveStateBeforeBranching: true
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 137
            }
        }
    )

)

