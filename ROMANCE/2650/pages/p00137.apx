page 137 (
    name: Cadastro de Fornecedor
    title: Cadastro de Fornecedor
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 70%
        height: 70%
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region cadastro-de-fornecedor (
        name: Cadastro de Fornecedor
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    region razão-social (
        name: Razão Social
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDRAZAOSOCIALFORN",
                "IDRAZAOSOCIALFORN" IDRAZAOSOCIALFORN_DISPLAY,
                "IDFORNECEDOR",
                "CNPJ",
                "RAZAOSOCIAL",
                "ENDERECO",
                "NUMERO",
                "BAIRRO",
                "IDCIDADE",
                "INSCRICAOESTADUAL",
                "ATIVO",
                "CODIGOVIRTUALAGE",
                "CODIGOCONTABIL"
                from "#OWNER#"."RAZOESSOCIAISFORNEC"
                where idfornecedor = :P137_IDFORNECEDOR
                
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P137_IDFORNECEDOR
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhum cadastro efetuado.
        }
        componentAdvanced {
            stripHtml: true
        }

        column ATIVO (
            reportColumnQueryId: 11
            derivedColumn: N
            type: radioGroup
            heading {
                heading: Ativo
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC2:Ativo;S,Inativo;N
            }
            layout {
                sequence: 11
            }
            element {
                numberOfColumns: 1
            }
        )

        column BAIRRO (
            reportColumnQueryId: 8
            derivedColumn: N
            type: textField
            heading {
                heading: Bairro
            }
            layout {
                sequence: 8
            }
            appearance {
                width: 15
            }
        )

        column CNPJ (
            reportColumnQueryId: 4
            derivedColumn: N
            type: textField
            heading {
                heading: CNPJ
            }
            layout {
                sequence: 4
            }
            appearance {
                width: 15
            }
        )

        column CODIGOCONTABIL (
            reportColumnQueryId: 13
            derivedColumn: N
            type: textField
            heading {
                heading: Código Contabil
                alignment: center
            }
            layout {
                sequence: 22
                columnAlignment: center
            }
            appearance {
                width: 10
            }
            advanced {
                cellWidth: 10
            }
        )

        column CODIGOVIRTUALAGE (
            reportColumnQueryId: 12
            derivedColumn: N
            type: textField
            heading {
                heading: Cod. Virtual Age
                alignment: center
            }
            layout {
                sequence: 12
            }
            appearance {
                width: 10
            }
        )

        column ENDERECO (
            reportColumnQueryId: 6
            derivedColumn: N
            type: textField
            heading {
                heading: Endereço
            }
            layout {
                sequence: 6
            }
            appearance {
                width: 20
            }
        )

        column IDCIDADE (
            reportColumnQueryId: 9
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Cidade
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nomecidade||' - '||e.sigla display_value
                         , idcidade return_value
                    from cidades c
                       , estados e
                    where c.idestado = e.idestado
                    order by nomecidade
                    ```
                displayNullValue: false
            }
            layout {
                sequence: 9
            }
            appearance {
                width: 25
            }
        )

        column IDFORNECEDOR (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 3
            }
            default {
                type: item
                item: P137_IDFORNECEDOR
            }
        )

        column IDRAZAOSOCIALFORN (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 1
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDRAZAOSOCIALFORN
            }
        )

        column IDRAZAOSOCIALFORN_DISPLAY (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column INSCRICAOESTADUAL (
            reportColumnQueryId: 10
            derivedColumn: N
            type: textField
            heading {
                heading: I.E.
            }
            layout {
                sequence: 10
            }
            appearance {
                width: 16
            }
        )

        column NUMERO (
            reportColumnQueryId: 7
            derivedColumn: N
            type: textField
            heading {
                heading: Nr
            }
            layout {
                sequence: 7
            }
            appearance {
                width: 5
            }
        )

        column RAZAOSOCIAL (
            reportColumnQueryId: 5
            derivedColumn: N
            type: textField
            heading {
                heading: Razão Social
            }
            layout {
                sequence: 5
            }
            appearance {
                width: 30
            }
        )

    )

    pageItem P137_ATIVO (
        type: selectList
        label {
            label: Ativo
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @cadastro-de-fornecedor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: ATIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P137_ENVIOEMAILAUTOMATICO (
        type: radioGroup
        label {
            label: Envio de Email Automático
            alignment: left
        }
        lov {
            type: staticValues
