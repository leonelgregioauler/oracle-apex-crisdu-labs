            alignment: left
        }
        layout {
            sequence: 90
            region: @cadastro-de-fornecedor
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        source {
            type: databaseColumn
            databaseColumn: MELHORDIAPARAENVIO
            used: always
        }
    )

    pageItem P137_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
