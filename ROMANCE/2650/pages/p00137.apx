            used: always
        }
    )

    pageItem P137_FORNECEVAREJO (
        type: checkboxGroup
        label {
            label: Fornece p/ Varejo
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2: ;S
        }
        layout {
            sequence: 70
            region: @cadastro-de-fornecedor
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: FORNECEVAREJO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P137_IDFORNECEDOR (
        type: hidden
        layout {
            sequence: 10
            region: @cadastro-de-fornecedor
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFORNECEDOR
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidfornecedor number;
                begin
                  --
                  select idfornecedor 
                  into vidfornecedor
                  from fornecedores 
                  where idpessoa = :P137_IDPESSOA;
                  --
                  return vidfornecedor;
                  --
                exception
                  when others then
                    return null;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P137_IDPESSOA (
        type: hidden
        layout {
            sequence: 30
            region: @cadastro-de-fornecedor
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDPESSOA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P137_MELHORDIAPARAENVIO (
        type: numberField
