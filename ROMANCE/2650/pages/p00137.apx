        settings {
            trimSpaces: none
        }
        layout {
            sequence: 110
            region: @cadastro-de-fornecedor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
            height: 3
        }
        validation {
            maxLength: 150
        }
        source {
            type: databaseColumn
            databaseColumn: OBSERVACAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P137_REFERENCIA (
        type: textField
        label {
            label: Referencia
            alignment: left
