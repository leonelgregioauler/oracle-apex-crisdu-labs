page 544 (
    name: Cadastro de Históricos Contábeis
    title: Cadastro de Históricos Contábeis
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region form-on-historicoscontabeis (
        name: Form on HISTORICOSCONTABEIS
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P544_IDHISTORICOCONTABIL (
        type: numberField
        label {
            label: ID Histórico Contábil (OPTIMUS)
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 10
            region: @form-on-historicoscontabeis
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 20
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDHISTORICOCONTABIL
            used: always
        }
        readOnly {
            type: itemIsNotNull
            item: P544_IDHISTORICOCONTABIL
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P544_NOMEHISTORICOCONTABIL (
        type: textField
        label {
            label: Nome do Histórico Contábil
            alignment: left
        }
        layout {
            sequence: 20
            region: @form-on-historicoscontabeis
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            valueRequired: true
            maxLength: 200
        }
        source {
            type: databaseColumn
            databaseColumn: NOMEHISTORICOCONTABIL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P544_IDHISTORICOCONTABIL
        }
    )

    button delete (
        buttonName: DELETE
        label: Excluir
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P544_IDHISTORICOCONTABIL
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P544_IDHISTORICOCONTABIL
        }
    )

    validation idhistoricocontabil-must-be-numeric (
        name: IDHISTORICOCONTABIL must be numeric
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNumeric
            item: P544_IDHISTORICOCONTABIL
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ser numérico.
        }
    )

    validation p544-idhistoricocontabil (
        name: P544_IDHISTORICOCONTABIL
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                  from HISTORICOSCONTABEIS
                 where IDHISTORICOCONTABIL = :P544_IDHISTORICOCONTABIL
                ```
        }
        error {
            errorMessage: Já existe um Histórico Contábil cadastrado com este ID.
            associatedItem: @P544_IDHISTORICOCONTABIL
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process fetch-row-from-historicoscontabeis (
        name: Fetch Row from HISTORICOSCONTABEIS
        type: autoRowFetch
        source {
            tableName: HISTORICOSCONTABEIS
            pkColumn: IDHISTORICOCONTABIL
            pkItem: P544_IDHISTORICOCONTABIL
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 5440000000000000601
        }
    )

    process process-row-of-historicoscontabeis (
        name: Process Row of HISTORICOSCONTABEIS
        type: autoRowProcessing
        target {
            tableName: HISTORICOSCONTABEIS
            pkColumn: IDHISTORICOCONTABIL
            pkItem: P544_IDHISTORICOCONTABIL
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 5440000000000000603
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 5440000000000000604
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 545
            }
            saveStateBeforeBranching: true
        }
    )

)

