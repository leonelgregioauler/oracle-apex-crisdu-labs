    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDCHEQUE.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P44_IDCHEQUE := get_pk; 
                end; 
                ```
        }
        execution {
            sequence: 20
        }
        error {
            errorMessage: Unable to get primary key item value.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 179856838256278984
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process grava-classificacao (
        name: Grava Classificacao
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidclassificacaonegociacao  number;
                  vidcaracteristicanegociacao number;
                  vidnegociacao               number;
                  vdataclassificacao          date;
                  vidusuario                  number;
                  vobservacao                 varchar2(1000);
                  vidcheque                   number;
                  videmprestimo               number;
                  vidnegociacaobalanco        number;
                  vmd5                        varchar2(1000);
                  voperacao_dml               varchar2(1) := 'I';
                  --
                begin
                  --
                  if v('REQUEST') = 'RENEGOCIADA' then
                    vidcaracteristicanegociacao     := 1;
                    elsif v('REQUEST') = 'DEVEDORA' then
                    vidcaracteristicanegociacao      := 2;
                    elsif v('REQUEST') = 'PERDIDA' then
                    vidcaracteristicanegociacao      := 3;
                  end if;
                  --
                  if vidcaracteristicanegociacao in (1,2,3) then
                    --
                    select u.idusuario
                      into vidusuario
                      from usuarios u
                     where u.usuario = v('APP_USER');
                    --
                    vidclassificacaonegociacao  := seq_idclassificacaonegociacao.Nextval;
                    vdataclassificacao          := sysdate;
                    vidcheque                   := :P44_IDCHEQUE;
                    --
                    pck_cadastros_rmc.prc_classificacoesnegociacoes( pidclassificacaonegociacao  => vidclassificacaonegociacao
                                                                   , pidcaracteristicanegociacao => vidcaracteristicanegociacao
                                                                   , pidnegociacao               => vidnegociacao
                                                                   , pdataclassificacao          => vdataclassificacao
                                                                   , pidusuario                  => vidusuario
                                                                   , pobservacao                 => vobservacao
                                                                   , pidcheque                   => vidcheque
                                                                   , pidemprestimo               => videmprestimo
                                                                   , pidnegociacaobalanco        => vidnegociacaobalanco
                                                                   , pmd5                        => vmd5
                                                                   , poperacao_dml               => voperacao_dml );
                    --
                    if vidcaracteristicanegociacao = 3 then
                      --
                      update cheques2 n
                         set n.perda = 'S'
                       where n.idcheque   = vidcheque
                         and nvl(n.perda,'N') = 'N';
                      --
                    end if;
                    --
                    commit;
                    --
                    apex_application.g_print_success_message := '<span style="color : white ">Negociação Classificada com sucesso! </span>';
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 80
        }
        advanced {
            executionMappingIdentifier: 3493747818725281114
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('RENEGOCIADA','DEVEDORA','PERDIDA')
                ```
        }
    )

