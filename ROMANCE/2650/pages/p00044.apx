    pageItem P44_IDCONTBANC (
        type: selectList
        label {
            label: Conta Bancária
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(cb.beneficiario,p.apelido)||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||')' display_value
                     , cb.idcontabanc    return_value
                from contasbancarias cb
                   , bancos b
                   , pessoas p
                   , fornecedores f
                where cb.idbanco      = b.idbanco
                  and cb.idfornecedor = f.idfornecedor
                  and f.idpessoa      = p.idpessoa
                  and f.idfornecedor  = cb.idfornecedor
                  and f.idfornecedor  = :P44_IDFORNECEDOR
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P44_IDFORNECEDOR
        }
        layout {
            sequence: 180
            region: @cadastro-de-cheques
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDCONTBANC
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

