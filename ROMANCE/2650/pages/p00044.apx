            reportColumnQueryId: 4
            derivedColumn: N
            type: selectList
            heading {
                heading: Semana
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select semana ||'/'||ano display_value
                    , semana ||'/'||ano return_value
                    from semana_dias
                    where ano between to_char(sysdate,'YYYY')-1 and to_char(sysdate,'YYYY')
                    order by ano desc, semana desc
                    ```
                nullDisplayValue: - Semana -
