    pageItem P44_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(p.apelido, p.nomepessoa)||' ( '||nvl(pe.apelido, pe.nomepessoa)||' )') display_value
                     , r.idrepresentante return_value
                from representantes r
                   , pessoas p
                   , pessoas pe
                   , gerentes g
                   , filiais f
                where r.idpessoa = p.idpessoa
                  and r.idgerente = g.idgerente
                  and g.idfilial  = f.idfilial
                  and f.idpessoa = pe.idpessoa
                order by 1
                ```
            nullDisplayValue: - Informe o Representante -
