    pageItem P44_IDCIDADE (
        type: popupLov
        label {
            label: Cidade
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nomecidade) ||' - '||e.sigla display_value
                , idcidade return_value
                from cidades c
                   , estados e
                where c.idestado = e.idestado
                order by 1
                ```
            nullDisplayValue: "- Informe a Cidade do Cheque - "
        }
        layout {
            sequence: 120
            region: @cadastro-de-cheques
            slot: regionBody
