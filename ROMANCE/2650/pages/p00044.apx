    process update-pago (
        name: Update pago
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vcheque  number := :P44_IDCHEQUE;
                  vsoma    number(15,2);
                  vvlrchq  number(15,2);
                  vtaxas   number(15,2);
                  vjuros   number(15,2);
                  --
                begin
                  --
                  select sum(c.valor)
                       , sum(c.taxas)
                       , sum(c.juros)
                  into vsoma
                     , vtaxas
                     , vjuros
                  from cheques2pgto c
                  where c.idcheque = vcheque;
                  --
                  select cc.valor
                  into vvlrchq
                  from cheques2 cc
                  where cc.idcheque = vcheque;
                  --
                  if nvl(vsoma,0) >= nvl(vvlrchq,0) then
                    --
                    update cheques2 c1
                    set c1.pago = 'S'
                      , c1.juros = vjuros
                      , c1.taxas = vtaxas
                    where c1.idcheque = vcheque;
                    --
                  else
                    --
                    update cheques2 c1
                    set c1.pago = 'N'
                      , c1.juros = vjuros
                      , c1.taxas = vtaxas
                    where c1.idcheque = vcheque;
                    --
                  end if;
                  --
                  /*if :P44_SEMFUNDO = 'N' then
                    --
                    delete cheques2pgto c
                    where c.idcheque = vcheque;
                    --
                  end if;*/
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 60
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 179876934604734009
        }
        serverSideCondition {
            type: request!=Value
            value: DELETE
        }
    )

