    region classificações-da-negociação (
        name: Classificações da Negociação
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                 select cl.idclassificacaonegociacao
                     , cl.idcaracteristicanegociacao
                     , cl.idnegociacao
                     , cl.dataclassificacao
                     , (select u.usuario
                          from usuarios u
                         where u.idusuario = cl.idusuario) usuario
                     , cl.observacao
                     , ca.descricao
                     , APEX_ITEM.CHECKBOX2(1, cl.idclassificacaonegociacao , NULL )  deletar
                    -- , '<a href=javascript:fnc_remover('||cl.idclassificacaonegociacao||');><span aria-hidden="true" class="fa fa-trash-o"></span></a>' REMOVER
                     --, '<a href=javascript:fnc_remover('||cl.idclassificacaonegociacao||');><img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt=""></a>' remover
                  from classificacoesnegociacoes cl
                     , caracteristicasnegociacoes ca
                 where cl.idcaracteristicanegociacao = ca.idcaracteristicanegociacao
                   and cl.idcheque = :P44_IDCHEQUE
                   and cl.idnegociacao is null
                   and cl.idnegociacaobalanco is null
                   ORDER BY cl.dataclassificacao DESC
                   --<img src="#IMAGE_PREFIX#menu/trash_32.gif" style="max-width:px;" alt="" title="" />
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from classificacoesnegociacoes cl
                 where cl.idcheque = :P44_IDCHEQUE
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
