    region pagamentos (
        name: Pagamentos
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDCHEQUEPGTO",
                "IDCHEQUEPGTO" IDCHEQUEPGTO_DISPLAY,
                "IDCHEQUE",
                "SEMANA",
                "DATAPGTO",
                "VALOR",
                "OBSERVACAO",
                null anexararquivo,
                "JUROS",
                "TAXAS"
                from "#OWNER#"."CHEQUES2PGTO"
                where idcheque = :P44_IDCHEQUE
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
