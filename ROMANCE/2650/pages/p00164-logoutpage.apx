page 164 (
    name: Logout
    alias: LOGOUTPAGE
    title: Logout
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    headerAndFooter {
        footerText:
            ```html
            <script language="Javascript">
            apex.submit('CREATE');
            </script>
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region logout (
        name: logout
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
    )

    pageItem P164_USERNAME (
        type: textField
        label {
            alignment: left
            tableCellAttributes: nowrap="nowrap"
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 10
            region: @logout
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            width: 30
        }
        validation {
            maxLength: 4000
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                return(v('APP_USER'));
                end;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    process atualiza-registro-para-logout (
        name: atualiza registro para logout
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidhist number;
                begin
                  --
                  update expediente e
                  set datalogout = sysdate 
                  where e.idexpediente = :P0_IDSESSAO;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 277380003374442290
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 101
                items: {
                    P0_IDSESSAO:
                }
                successMessage: false
            }
        }
        comments {
            comments: Created 12-JAN-2012 10:48 by ROMAN
        }
    )

)

