            function fnc_acao (event)
            {
              var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
              alert(tecla);
                if (tecla == 40 )
                    {
                        document.wwv_flow.f01[i+1].focus();
                    }
                else
                    {
                        document.wwv_flow.f01[i-1].focus();
                    }
            }
            
