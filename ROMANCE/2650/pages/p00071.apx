    region disponivel (
        name: Disponivel
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idproduto
                     , pck_romance.fnc_nomeproduto(t.idproduto)  produto
                     , t.custound custo
                     , replace(to_char(t.custound),',','.') custov
                     , t.observacao 
                     , p.idfornecedor
                     , nvl(sum(t.qtdpp)   ,0) - nvl(( select sum(qtdpp)
                                                        from distribuicaoempresas d
                                                        where d.idproduto = t.idproduto
                                                          and d.idsemana  = p.idsemana) ,0) qtdpp
                     , nvl(sum(t.qtdp)    ,0) - nvl(( select sum(qtdp)
                                                    from distribuicaoempresas d
                                                    where d.idproduto = t.idproduto
                                                      and d.idsemana  = p.idsemana) ,0)  qtdp
                     , nvl(sum(t.qtdm)    ,0) - nvl(( select sum(qtdm)
                                                    from distribuicaoempresas d
                                                    where d.idproduto = t.idproduto
                                                      and d.idsemana  = p.idsemana) ,0)  qtdm
                     , nvl(sum(t.qtdg)    ,0) - nvl(( select sum(qtdg)
                                                      from distribuicaoempresas d
                                                      where d.idproduto = t.idproduto
                                                        and d.idsemana  = p.idsemana) ,0)  qtdg
                     , nvl(sum(t.qtdgg)   ,0) - nvl(( select sum(qtdgg)
                                                      from distribuicaoempresas d
                                                      where d.idproduto = t.idproduto
                                                        and d.idsemana  = p.idsemana) ,0)  qtdgg
                     , nvl(sum(t.qtdegg)  ,0) - nvl(( select sum(qtdegg)
                                                      from distribuicaoempresas d
                                                      where d.idproduto = t.idproduto
                                                        and d.idsemana  = p.idsemana) ,0)  qtdegg
                     , nvl(sum(t.qtdexgg) ,0) - nvl(( select sum(qtdexgg)
                                                      from distribuicaoempresas d
                                                      where d.idproduto = t.idproduto
                                                        and d.idsemana  = p.idsemana) ,0)  qtdexgg
                     , nvl(sum(t.qtdxxgg) ,0) - nvl(( select sum(qtdxxgg)
                                                      from distribuicaoempresas d
                                                      where d.idproduto = t.idproduto
                                                        and d.idsemana  = p.idsemana) ,0)  qtdxxgg
                     , nvl(sum(t.qtdu)    ,0) - nvl(( select sum(qtdu)
                                                      from distribuicaoempresas d
                                                      where d.idproduto = t.idproduto
                                                        and d.idsemana  = p.idsemana) ,0)  qtdu
                     , nvl(sum(t.qtdtotal),0) - ( select nvl(sum(qtdpp),0)+nvl(sum(qtdp),0)+nvl(sum(qtdm),0)+nvl(sum(qtdg),0)+nvl(sum(qtdgg),0)+nvl(sum(qtdegg),0)+nvl(sum(qtdexgg),0)+nvl(sum(qtdxxgg),0)+nvl(sum(qtdu),0)
                                                      from distribuicaoempresas d
                                                      where d.idproduto = t.idproduto
                                                        and d.idsemana  = p.idsemana)  qtdtotal
                     , nvl(sum(t.qtdpp)   ,0) pp
                     , nvl(sum(t.qtdp)    ,0) p
                     , nvl(sum(t.qtdm)    ,0) m
                     , nvl(sum(t.qtdg)    ,0) g
                     , nvl(sum(t.qtdgg)   ,0) gg
                     , nvl(sum(t.qtdegg)  ,0) egg
                     , nvl(sum(t.qtdexgg) ,0) exgg
                     , nvl(sum(t.qtdxxgg) ,0) xxgg
                     , nvl(sum(t.qtdu)    ,0) u
                from itenspedidocompra t
                   , pedidoscompras  p
                where p.idpedidocompra = t.idpedidocompra
                  and p.idfornecedor = :P71_IDFORNECEDOR
                  and p.idsemana = :P71_IDSEMANA
                  and ( :P71_IDCATEGORIA = -1 or exists ( select 1
                                                             from produtos p
                                                             where p.idproduto    = t.idproduto
                                                               and p.idcategoria = :P71_IDCATEGORIA) )
                  and p.idsemana       = :P71_IDSEMANA 
                group by t.idproduto, p.idsemana, T.custound, t.observacao,p.idfornecedor
                order by 3,2
                ```
        }
