    pageItem P71_IDCATEGORIA (
        type: selectList
        label {
            label: Categoria
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nome        display_value
                     , c.idcategoria return_value
                from categorias c
                   , produtos p
                where c.idcategoria = p.idcategoria
                  and exists ( select 1
                               from itenspedidocompra t
                                where t.idproduto = p.idproduto
                                  and exists ( select 1
                                                 from pedidoscompras p
                                                 where p.idpedidocompra = t.idpedidocompra
                                                     and p.idsemana       = :P71_IDSEMANA ))
                union
                select '- Mostrar todas -' 
                     , -1
                from dual
                order by 1 
                ```
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @disponivel
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: static
            staticValue: -1
        }
        security {
            encryptSessionState: false
        }
    )

