    dynamicAction alterar (
        name: Alterar
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P71_IDSEMANA
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: CATEGORIA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction busca-custo (
        name: busca custo
        execution {
            sequence: 80
        }
        when {
            event: ready
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                      vcusto varchar2(1000);
                      vidforn number;
                    begin
                      --
                      
                    	select trim(to_char(custound,'999G999G990D00'))||' - '||( select descricao
                    														from tiposnegociacao t
                    														where t.idtiponegociacao = i.idtiponegociacao )||' '||i.qtddias
                    	into  vcusto
                    	from itenspedidocompra i
                    	where idproduto = :P71_IDPRODUTO
                    	 and idpedidocompra = ( select idpedidocompra
                    													from pedidoscompras p
                    													where p.idsemana = :P71_IDSEMANA
                    														and p.idfornecedor = nvl(:P71_IDFORNECEDOR,vidforn) ); 
                      --
                      return vcusto;
                      --
                    exception
                      when others then
                         return null;
                    end;
                    ```
            }
            affectedElements {
                selectionType: items
                items: P71_VLRCUSTO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction submit (
        name: Submit
