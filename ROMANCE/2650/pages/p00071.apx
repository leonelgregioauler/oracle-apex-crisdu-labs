    pageItem P71_IDSEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(semana,'00'))||'/'||ano ||' (Para distribur:'||to_char(( select  nvl(sum(t.qtdtotal),0) - ( select nvl(sum(qtdpp),0)+nvl(sum(qtdp),0)+nvl(sum(qtdm),0)+nvl(sum(qtdg),0)+nvl(sum(qtdgg),0)+nvl(sum(qtdegg),0)+nvl(sum(qtdexgg),0)+nvl(sum(qtdxxgg),0)+nvl(sum(qtdu),0)
                																																													from distribuicaoempresas d
                																																													where d.idsemana  = p.idsemana)  adistribuir
                																																							from itenspedidocompra t
                																																								 , pedidoscompras  p
                																																							where p.idpedidocompra = t.idpedidocompra
                																																								and p.idsemana       = S.IDSEMANA
                																																							group by p.idsemana ),'999G999G999G990' )||')' display_value
                     , idsemana return_value
                from semana_dias S
                where idsemana  between  pck_util.fnc_idsemana(to_char(sysdate,'iw/rrrr'))-3  and   pck_util.fnc_idsemana(to_char(sysdate,'iw/rrrr'))+10
                order by idsemana desc
                ```
        }
        layout {
            sequence: 20
            region: @selecionar-semana
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            customAttributes: "onkeyPress=\"javascript:{formatar_mascara(this, '##/###',event); }\" "
        }
        security {
            encryptSessionState: false
        }
    )

