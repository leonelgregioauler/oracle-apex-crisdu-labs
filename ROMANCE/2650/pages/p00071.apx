             //style="text-align: right;" onchange="fnc_soma()"
             
            function formatar_mascara(src,mascara,evt){
            var tecla;  
            if(evt.which){tecla = evt.which}
            else if(evt.keyCode){ tecla = evt.keyCode;}  
             if( tecla != 8 ){
             var campo = src.value.length;
             var saida = mascara.substring(0,1);
             var texto = mascara.substring(campo);
             if(texto.substring(0,1) != saida) {
             src.value+=texto.substring(0,1);}}
            }
            
            function getMoney( str )
            {
                    return parseInt( str.replace(/[\D]+/g,'') );
            }
            
            
            function fnc_soma2()
            {
              vvalor = getMoney(document.getElementById('P71_DISP_PP').value);
              for(i=0;i<document.wwv_flow.length;i++)
              {
                if ( isNaN(parseFloat(document.wwv_flow.f02[i].value) ))
                {
                  document.wwv_flow.f02[i].value = 0;
                }
                else
                { 
                   valor = getMoney( document.wwv_flow.f02[i].value);
                   vvalor = parseFloat(vvalor)-parseFloat(valor);  
            
                   if (parseFloat(vvalor) < 0 && 1 == 2)// pode distribuir negativo
                   {
            	       document.wwv_flow.f02[i].value = '';
                       alert('Quantidade não disponível! Saldo atual: '+document.getElementById('P71_DISP_PP_SALDO').value);
                   }
                   else
                   {
                    document.getElementById('P71_DISP_PP_SALDO').value = vvalor;
                   }
                }
              }
            }
