    process gera-registros-de-distribuicao (
        name: gera registros de distribuicao
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  for f in ( select idfilial
                             from vw_filiais w
                             where w.planilhadistribuicao = 'S'
                               and not exists ( select 1
                                                from distribuicaoempresas d
                                                                where d.idfilial = w.idfilial
                                                                  and d.idsemana = :P71_IDSEMANA
                                                                    and d.idproduto = :P71_IDPRODUTO ) )
                  loop
                    insert into distribuicaoempresas ( iddistribuicaoempresa   , idproduto       , idfilial
                		                                 , idsemana                , idfornecedor    , precocusto
                																		 , observacao              , qtdpp           , qtdp
                																		 , qtdm                    , qtdg            , qtdgg
                																		 , qtdegg                  , qtdexgg         , qtdxxgg
                																		 , qtdu                    )
