            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select listagg(p.observacao,'.') within group (order by 1) observacao 
                from pedidoscompras p
                where idsemana     = :P71_IDSEMANA
                  and idfornecedor = :P71_IDFORNECEDOR
                  and observacao   is not null 
                  and exists ( select 1 
                               from itenspedidocompra i
                	       where i.idpedidocompra = p.idpedidocompra
                		 and i.idproduto      = :P71_IDPRODUTO )
