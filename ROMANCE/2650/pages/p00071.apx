    pageItem P71_DISP_EGG_SALDO (
        type: textField
        label {
            label: EGG
            alignment: left
        }
        layout {
            sequence: 140
            region: @disponivel-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            width: 10
        }
        advanced {
            customAttributes: style="text-align:right" readonly
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select to_number(:P71_DISP_EGG) - sum(d.qtdEGG) total
                from distribuicaoempresas d
                where d.idproduto = :P71_IDPRODUTO
                  and d.idsemana  = :P71_IDSEMANA
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

