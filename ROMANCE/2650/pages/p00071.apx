    region distribuir (
        name: Distribuir
        type: tabform
        source {
            sqlQuery:
                ```sql
                select IDDISTRIBUICAOEMPRESA
                      , IDFILIAL
                      , IDSEMANA
                      ,'|' s
                --     , pck_romance.fnc_nomeproduto(idproduto) produto
                --     , pck_romance.fnc_nomefornecedor(idfornecedor) fornecedor
                     , pck_romance.fnc_nomefilial(IDFILIAL) empresa
                     , QTDPP
                     , QTDP
                     , QTDM
                     , QTDG
                     , QTDGG
                     , QTDEGG
                     , QTDEXGG
                     , QTDXXGG
                     , QTDU
                     , nvl(QTDPP  ,0)
                     + nvl(QTDP   ,0)
                     + nvl(QTDM   ,0)
                     + nvl(QTDG   ,0)
                     + nvl(QTDGG  ,0)
                     + nvl(QTDEGG ,0)
                     + nvl(QTDEXGG,0)
                     + nvl(QTDXXGG,0)
                     + nvl(QTDU   ,0) total
                   --  , precocusto Custo
                     , (nvl(QTDPP  ,0)
                     + nvl(QTDP   ,0)
                     + nvl(QTDM   ,0)
                     + nvl(QTDG   ,0)
                     + nvl(QTDGG  ,0)
                     + nvl(QTDEGG ,0)
                     + nvl(QTDEXGG,0)
                     + nvl(QTDXXGG,0)
                     + nvl(QTDU   ,0)) * precocusto vlrtotal
                 --    , observacao 
                     , ( select  trim( to_char (to_char(sum(quantidade)),'999G999G999G990')) ||' / '||
                                 trim( to_char (to_char(sum(quantidade) - sum(qtddevolvida)),'999G999G999G990')) ||'<br><b>'||
                                to_char(round((sum(quantidade) - sum(qtddevolvida) ) *100/sum(quantidade),2),'990D00')||'</b>' venda
                        from itensnotavenda i
                        where exists ( select 1
                                       from notasvendas n
                                                     where n.idnotavenda = i.idnotavenda 
                                                       and n.idsemanacobranca >= to_number(:P71_IDSEMANA) - 9
                                                         and n.idsituacaonotavenda = 4 )
                          and i.idestoquefil = ( select e.idestoquefilial
                                                 from estoquefilial e
                                                 where e.idproduto = :P71_IDPRODUTO
                                                   and e.idfilial  = d.idfilial )) venda
                     , ( select sum((nvl(QTDPP  ,0)
                             + nvl(QTDP   ,0)
                             + nvl(QTDM   ,0)
                             + nvl(QTDG   ,0)
                             + nvl(QTDGG  ,0)
                             + nvl(QTDEGG ,0)
                             + nvl(QTDEXGG,0)
                             + nvl(QTDXXGG,0)
                             + nvl(QTDU   ,0)) * precocusto )
                         from distribuicaoempresas dd
                         where dd.idfilial = d.idfilial
                           and dd.idsemana = d.idsemana )  totaldistribuido
                     , ( select sum((nvl(QTDPP  ,0)
                             + nvl(QTDP   ,0)
                             + nvl(QTDM   ,0)
                             + nvl(QTDG   ,0)
                             + nvl(QTDGG  ,0)
                             + nvl(QTDEGG ,0)
                             + nvl(QTDEXGG,0)
                             + nvl(QTDXXGG,0)
                             + nvl(QTDU   ,0)) * precocusto )/COUNT(1)
                         from distribuicaoempresas dd
                         where dd.idfilial = d.idfilial 
                           and dd.idproduto = d.idproduto
                           and dd.idsemana between d.idsemana -7 and d.idsemana-1 )  totaldistribuidoanterior
                     , ( select /*trim( to_char (*/sum((nvl(QTD_PP  ,0)
                									 + nvl(QTD_P   ,0)
                									 + nvl(QTD_M   ,0)
                									 + nvl(QTD_G   ,0)
                									 + nvl(QTD_GG  ,0)
                									 + nvl(QTD_EGG ,0)
                									 + nvl(QTD_EXGG,0)
                								--	 + nvl(QTD_XXGG,0)
                									 + nvl(QTD_U   ,0)) )/*,'999G999G999G990'))||' <br> <b>'||trim( to_char (
                									                                sum((nvl(QTD_PP  ,0)
                																										 + nvl(QTD_P   ,0)
                																										 + nvl(QTD_M   ,0)
                																										 + nvl(QTD_G   ,0)
                																										 + nvl(QTD_GG  ,0)
                																										 + nvl(QTD_EGG ,0)
                																										 + nvl(QTD_EXGG,0)
                                                                  --   + nvl(QTD_XXGG,0)
                                                                     + nvl(QTD_U   ,0)) *e.vlrvenda),'999G999G999G990D00'))||'</b>'*/
                         from estoquefilial e
                         where e.idfilial  = d.idfilial
                           and e.idproduto = d.idproduto ) estoqueatual
                     , ( select /*trim( to_char (*/ sum(i.quantidade)/*,'999G999G999G990'))||' <br> <b>'||trim( to_char (
                                                                   sum(i.quantidade)*avg(i.valorvenda),'999G999G999G990D00'))||'</b>'*/
                         from itensnotavenda i
                             , notasvendas n
                          where n.idnotavenda         = i.idnotavenda
                            and n.idsituacaonotavenda = 3
                            and i.idestoquefil        = ( select idestoquefilial
                                                          from estoquefilial e
                                                          where e.idfilial = d.idfilial
                                                            and e.idproduto = d.idproduto )
                            and n.idfilial            = d.idfilial )  narua
                from DISTRIBUICAOEMPRESAS d
                where idsemana = :P71_IDSEMANA
                  and idproduto = :P71_IDPRODUTO
                  and idfornecedor = :P71_IDFORNECEDOR
                  and (:P71_IDGRUPO = -1 or exists( select 1
                                                    from filiais f 
                                                    where f.idfilial = d.idfilial
                                                      and f.idgrupo  = :P71_IDGRUPO ) )
                ORDER BY 1
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                js-showMaximizeButton
                t-Region--accent4
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                <b>Dist/Vend/%</b> - Vendidos nas últimas nove semanas.<br>
                <b>Total da Semana</b> - Tudo que foi distribuído na semana selecionada até o momento.<br>
                <b>Média 6 Sem.</b> - Distribuído nas ultimas 6 semanas.
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P71_IDPRODUTO
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
