page 31 (
    name: Depósitos Faturas
    title: Depositos Faturas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function somavalor() {
                var total = 0;
            
                // percorre todos os checkboxes do IR (gerados pelo APEX_ITEM.CHECKBOX2)
                $("input[name='f01']:checked").each(function() {
                    // encontra a linha (tr) do checkbox
                    var $row = $(this).closest("tr");
            
                    // pega o valor da coluna VALORPAGAR
                    // assumindo que a coluna do IR tem headers='VALORPAGAR'
                    var valor = $row.find("td[headers='VALORPAGAR']").text().trim();
            
                    // converte para número (removendo pontos e trocando vírgula por ponto)
                    valor = valor.replace(/\./g,'').replace(',', '.');
            
                    total += parseFloat(valor) || 0; // garante que NaN não quebre a soma
                });
            
                $s("P31_VALORSELECIONADO", total);
            }
            
            
            function fnc_liquidafatura() {
              apex.confirm("Deseja continuar com a liquidação das faturas selecionadas?", {
                request : 'LIQUIDAR_FATURAS_AGENDADAS'
              })
            }
            
            function somavalorTodos() {
                var total = 0;
                var countedRows = new Set(); // Usado para armazenar linhas já contadas
            
                $("input[name^='f']:checked").each(function() {
                    var $row = $(this).closest("tr");
                    var rowId = $row.index(); // Identificador único para a linha, usando seu índice
            
                    // Verificando se a linha já foi contada
                    if (!countedRows.has(rowId)) {
                        var valor = $row.find("td[headers='VALORPAGAR']").text().trim();
                        valor = valor.replace(/\./g,'').replace(',', '.');
                        total += parseFloat(valor) || 0;
            
                        countedRows.add(rowId); // Marca a linha como contada
                    }
                });
            
                $s("P31_VALORSELECIONADO", total);
            }
            ```
        executeWhenPageLoads:
            ```javascript-browser
            $("ul.apex-item-multi").attr("style", "max-width: 100%;");
            $("#P31_TIPO_FORNECEDOR").attr("style", "flex-grow: 1; max-width: 100%;");
            ```
    }
    css {
        inline:
            ```css
            .item-destaque {
                border: 2px solid red !important;
                background-color: #ffe6e6 !important;
                border-radius: 6px;
            }
            
            
            
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
        browserCache: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region faturas (
        name: Faturas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select x.* 
                  from ( select -- Data de Vencimento
                                distinct pagforn.dtvencimento
                              -- ID pagamentos fornecedores 
                              , pagforn.idpgtoforn
                              , /*(select p.cnpj
                                   from catal.fornecedores f
                                       ,catal.pessoas p
                                  where f.idpessoa = p.idpessoa
                                    and idfornecedor = pagforn.idfornecedor) */ ( select rf.cnpj
                                  from razoessociaisfornec rf
                                     , notasfiscais nf
                                  where nf.idnotafiscal = pagforn.idnotafiscal
                                    and rf.idrazaosocialforn = nf.idrazaosocialfornemit ) cnpj_fornecedor
                              -- Mês
                              , to_char(pagforn.dtvencimento, 'MONTH') "Mês"
                              -- Filial Destino
                              , ( select pck_romance.fnc_nomefilial( nf.idfilialdestino ) 
                                    from notasfiscais    nf
                                   where nf.idnotafiscal  = pagforn.idnotafiscal ) "Filial Destino"
                              -- ID razão social
                              , nvl( ( select rr.idrazaosocialfilial
                                         from razoessociaisfiliais rr
                                        where rr.idrazaosocialfilial = ( select nf.idrazaosocialfildestino
                                                                           from notasfiscais nf
                                                                          where nf.idnotafiscal = pagforn.idnotafiscal )), 
                                     ( select idrazaosocialforn
                                         from razoessociaisfornec e
                                        where e.idrazaosocialforn = ( select nf.idrazaosocialforndest
                                                                        from notasfiscais    nf
                                                                       where nf.idnotafiscal  = pagforn.idnotafiscal ))) idrazaofilial
                              -- ID filial Destino
                              , ( select cnpj
                                    from razoessociaisfiliais e
                                   where e.idrazaosocialfilial = ( select nf.idrazaosocialfildestino
                                                                     from notasfiscais    nf
                                                                    where nf.idnotafiscal  = pagforn.idnotafiscal ) ) "Id. Fil Destino"
                              -- Ano
                              , to_char(pagforn.dtlancamento,'RRRR') ano
                              -- Semana
                              , ( select TRIM(to_char(s.semana,'00')||'/'||s.ano ||'(' )|| to_char(s.dt_ini,'DD/MM/YYYY') ||' a '|| to_char(s.dt_fim,'DD/MM/YYYY')||')'  
                                    from semana_dias s
                                   where pagforn.dtvencimento between s.dt_ini and s.dt_fim ) Semana
                              -- Semana n??
                              , ( select s.semana  
                                    from semana_dias s
                                   where pagforn.dtvencimento between s.dt_ini and s.dt_fim ) Semanan
                              -- Fornecedor
                              , nvl(pck_romance.fnc_nomefornecedor(pidforn => pagforn.idfornecedor),'-')  Fornecedor
                              -- Identificação
                              , decode(pagforn.identificado, null, '-'
                                                           , 'N' , 'Sem Identificação'
                                                           , 'S' , ( select cnpj||' - '||razaosocial 
                                                                       from razoessociaisfornec e
                                                                      where e.idrazaosocialforn = ( select nf.idrazaosocialfornemit
                                                                                                      from notasfiscais    nf
                                                                                                     where nf.idnotafiscal  = pagforn.idnotafiscal ) ) ) identificacao
                              -- ID Fornecedor
                              , pagforn.IDFORNECEDOR
                              -- Tipo Fornecedor
                              , (
                                select f.tipo_fornecedor
                                  from fornecedores f
                                 where f.idfornecedor = pagforn.idfornecedor
                                ) tipo_fornecedor
                              -- ID Cheque
                              , pagforn.idcheque
                              -- Número Nota
                              , ( select nf.documento
                                    from notasfiscais    nf
                                   where nf.idnotafiscal  =pagforn.idnotafiscal ) nrnf
                              -- Valor Pagar
                              , pagforn.valorpagar ValorPagar
                              -- Valor Pago
                              , pagforn.valorpago ValorPago
                              -- Saldo
                              , ( pagforn.valorpago - pagforn.valorpagar + nvl(pagforn.desconto,0) - nvl(pagforn.acrescimo,0) ) Saldo
                              -- Conta
                              , nvl( ( select cb.beneficiario||' <br> '||b.nomebanco||' - '|| cb.agencia ||' - '|| cb.conta||' CNPJ: '||cb.documento
                                         from contasbancarias cb
                                            , bancos b
                                        where cb.idbanco     = b.idbanco 
                                          and cb.idcontabanc = pagforn.idcontabanc ), 
                                     ( select cb.beneficiario||' <br> '||b.nomebanco ||' - '|| cb.agencia ||' - '|| cb.conta||' CNPJ: '||cb.documento
                                         from contasbancarias cb
                                            , bancos b
                                        where cb.idbanco     = b.idbanco 
                                          and cb.idcontabanc = ( select v.idcontabanc
                                                                   from vencimentos v
                                                                  where v.idvencimento = pagforn.idvencimento ) ) )  conta
                              -- Conta Banco
                              , nvl( ( select b.nomebanco
                                         from contasbancarias cb
                                            , bancos b
                                        where cb.idbanco     = b.idbanco 
                                          and cb.idcontabanc = pagforn.idcontabanc ), 
                                     ( select b.nomebanco
                                         from contasbancarias cb
                                            , bancos b
                                        where cb.idbanco     = b.idbanco 
                                          and cb.idcontabanc = ( select v.idcontabanc
                                                                   from vencimentos v
                                                                  where v.idvencimento = pagforn.idvencimento ) ) )  banco_conta
                              -- Tipo de Pagamento
                              , ( select descricao
                                    from formaspagamentos t
                                   where idformapagamento = pagforn.tipopagamento ) "Tipo Pagamento"
                              -- ID Vencimento
                              , pagforn.idvencimento
                              -- ID Filial
                              , pagforn.idfilial
                              -- Depositado
                              , ( select sum(d.valordeposito)
                                    from depositosdiarios_orig d
                                   where d.idpgtoforn = pagforn.idpgtoforn ) depositado
                              -- Total Depositado
                              , ( select sum(d.Valororiginal)
                                    from depositosdiarios d
                                   where d.idpgtoforn = pagforn.idpgtoforn ) totaldepositado
                              -- Cliente
                              , ( select distinct pck_romance.fnc_nomefornecedor(n.idfornecedordestino) 
                                    from notasfiscais n
                                   where n.idnotafiscalcompra = pagforn.idnotafiscal ) Cliente
                              -- Conta Raíz
                              , ( select cb.beneficiario||' <br> '||b.nomebanco||' - '|| cb.agencia ||' - '||cb.conta
                                    from contasbancarias cb
                                       , bancos b
                                   where cb.idbanco         = b.idbanco 
                                     and cb.idcontabanc = ( select idcontabancraiz
                                                              from contasbancarias
                                                             where idcontabanc =  pagforn.idcontabanc))  "Conta Raíz"
                              -- Situação da Nota
                              ,  ( select n.situacao 
                                     from notasfiscais n
                                    where n.idnotafiscal =  pagforn.idnotafiscal  ) situacaonota
                              -- Observação
                              , pagforn.observacao "Observação"
                              -- Identificação
                              , decode(identificado,'S','Sim','Não') "Identificado"
                              -- Moeda
                              , pck_util.fnc_siglamoedaid( pagforn.idmoeda) moeda
                              -- ID Conta Banco 
                              , pagforn.idcontabanc
                              -- Crisdu
                              , case
                                  when ( select r.cnpj
                                           from razoessociaisfornec r
                                              , notasfiscais        n
                                          where r.idrazaosocialforn = n.idrazaosocialfornemit
                                            and n.idnotafiscal      = pagforn.idnotafiscal ) like '07318638%' then
                                    'Sim'
                                  when ( select r.cnpj
                                           from razoessociaisfornec r
                                              , notasfiscais        n
                                          where r.idrazaosocialforn = n.idrazaosocialforndest 
                                            and n.idnotafiscal      = pagforn.idnotafiscal ) like '07318638%' then
                                    'Sim'
                                  when ( select cnpj
                                           from razoessociaisfiliais re
                                              , notasfiscais        n
                                          where re.idrazaosocialfilial = n.idrazaosocialfilemit 
                                            and n.idnotafiscal      = pagforn.idnotafiscal ) like '07318638%' then
                                    'Sim'
                                  when ( select cnpj
                                           from razoessociaisfiliais re
                                              , notasfiscais        n
                                          where re.idrazaosocialfilial = n.idrazaosocialfildestino 
                                            and n.idnotafiscal      = pagforn.idnotafiscal ) like '07318638%' then
                                    'Sim'
                                  else 
                                    'Não'
                                 end crisdu
                              -- Prioridade
                              , decode(PRIORIDADE,null, '-', 'Prioridade') prioridade
                              -- Automatizado
                              , decode(AUTOMATIZAR,'S','Sim','Não') automatizado
                              -- ID Semana
                              , ( select s.idsemana  
                                    from semana_dias s
                                   where pagforn.dtvencimento between s.dt_ini and s.dt_fim ) idsemana
                              -- Novo Deposito
                              , null novodeposito
                              -- Identificação Destino
                              , nvl(( select REGEXP_REPLACE(rr.cnpj,'[[:space:],[:punct:]]') -- REGEXP_REPLACE(rr.cnpj,'[[:alpha:],[:space:],[:punct:]]') 
                                        from razoessociaisfiliais rr
                                       where rr.idrazaosocialfilial = ( select nf.idrazaosocialfildestino
                                                                          from notasfiscais nf
                                                                         where nf.idnotafiscal = pagforn.idnotafiscal )), 
                                    ( select cnpj
                                        from razoessociaisfornec e
                                       where e.idrazaosocialforn = ( select nf.idrazaosocialforndest
                                                                       from notasfiscais    nf
                                                                      where nf.idnotafiscal  =pagforn.idnotafiscal ))) identificacaodestino
                              -- Data Baixa
                              , trunc(databaixa) databaixa
                              -- Centro de Custo
                              , nvl(( select initcap(c.nome)
                                        from vencimentos v
                                           , centrodecustos c
                                       where v.idvencimento = pagforn.idvencimento
                                         and c.idcentrodecusto = v.idcentrodecusto ),'Sem Identificação') centrodecusto
                              -- Usuário
                              , usuario
                              -- Conta Pagamento
                              , nvl( ( select '('|| cb.idcontabanc ||') - '||cb.beneficiario||' <br> '||b.nomebanco||' - '|| cb.agencia ||' - '|| cb.conta
                                         from contasbancarias cb
                                            , bancos b
                                        where cb.idbanco     = b.idbanco 
                                          and cb.idcontabanc = pagforn.idcontapagamento ), 'Sem Conta de Pagamento') contapagamento
                              -- Conta Financeira
                              , nvl(( select pck_romance.fnc_nomecontafinan(v.idcontafinanceira)
                                        from vencimentos v
                                       where v.idvencimento = pagforn.idvencimento ),'Sem Conta') contafinanceira
                              --Sub Conta Financeira
                              , nvl(( select pck_romance.fnc_nomesubcontafinan(v.idsubcontafinanceira)
                                        from vencimentos v
                                       where v.idvencimento = pagforn.idvencimento ),'Sem Sub Conta') subcontafinanceira
                              -- Desconto
                              , pagforn.desconto
                              -- Acrescimo
                              , pagforn.acrescimo
                              -- Banco Pagamento
                              , nvl(( select b.nomebanco
                                        from contasbancarias cb
                                           , bancos b
                                       where cb.idbanco     = b.idbanco 
                                         and cb.idcontabanc = pagforn.idcontapagamento ),'Sem Banco Informado') banco_pagamento
                              -- Data Emissão Nota Fiscal
                              , ( select nf.DATAINCLUSAO
                                    from roman.notasfiscais    nf
                                   where nf.idnotafiscal  = pagforn.idnotafiscal ) data_emissao_ntfiscal
                              -- Link Ir Para Nota
                              , case 
                                  when exists ( select distinct(n.documento)
                                                  from notasfiscais n
                                                 where n.idnotafiscal = pagforn.idnotafiscal )  then
                                    '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=2650:26:'||v('APP_SESSION')||'::NO::P26_DOCUMENTO,P26_ANO,P26_IDFORNECEDOR:'||
                                    ( select distinct(n.documento)
                                        from notasfiscais n
                                       where n.idnotafiscal = pagforn.idnotafiscal )||','||
                                    ( select to_char(n.dtnf,'RRRR')
                                        from notasfiscais n
                                       where n.idnotafiscal = pagforn.idnotafiscal)||','||
                                    pagforn.idfornecedor,'SESSION')||''',''_blank''); void(0);"><img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-view.png" alt=""/></a>'
                                  else
                                    '-'
                                end ir_pnota
                                              -- Log de Lançamentos (abre modal com histórico)
                              , '<a href="'||apex_util.prepare_url('f?p=2650:465:'||v('APP_SESSION')||'::NO::P465_IDPGTOFORN:'||pagforn.idpgtoforn,'SESSION')||'" class="t-Button t-Button--icon t-Button--noLabel t-Button--small" title="Ver histórico do lançamento"><span class="t-Icon fa fa-history" aria-hidden="true"></span></a>' log_lancamento
                              -- Parcela
                              , ( select parcela || '/' || total_parcelas
                                  from ( select pgf.idpgtoforn
                                              , row_number() over (partition by idnotafiscal order by dtvencimento) parcela
                                              , count(*)    over (partition by idnotafiscal)                        total_parcelas
                                           from roman.pagamentosfornecedores pgf
                                          where pgf.idcheque is null
                                            and pgf.tipopagamento is not null
                                            and pgf.idnotafiscal = pagforn.idnotafiscal) 
                                 where idpgtoforn = pagforn.idpgtoforn ) parcela
                              -- Antecipacao
                              , ( select decode(nf.antecipacao,'S','Sim','Não')
                                    from notasfiscais    nf
                                   where nf.idnotafiscal  = pagforn.idnotafiscal ) "Antecipacao"
                              
                              
                              , decode(pagforn.PGTOAGENDADO,'S','Sim','Não') PGTOAGENDADO
                              , APEX_ITEM.CHECKBOX2(1, pagforn.idpgtoforn , decode(:P31_AGENDARTODOS,'S','CHECKED',NULL) ) cx_PGTOAGENDADO
                              
                              
                              , decode(pagforn.BANCOAGENDADO,'S','Sim','Não') BANCOAGENDADO
                              , decode(pagforn.PGTOAGENDADO,'S', APEX_ITEM.CHECKBOX2(2, pagforn.idpgtoforn , decode(:P31_AGENDARBANCOTODOS,'S','CHECKED',NULL) ),null) cx_BANCOAGENDADO
                
                              --, APEX_ITEM.CHECKBOX2(2, pagforn.idpgtoforn , NULL ) cx_BANCOAGENDADO
                              --, decode( pagforn.PGTOAGENDADO,'N', APEX_ITEM.CHECKBOX2(1, pagforn.idpgtoforn , NULL ), APEX_ITEM.CHECKBOX2(1, pagforn.idpgtoforn , 'CHECKED' )) cx_PGTOAGENDADOx
                             
                             , ( select nf.observacao
                                 from roman.notasfiscais nf 
                                 where nf.idnotafiscal = pagforn.idnotafiscal) obsnota
                             , (select listagg(decode(p.tipochave, '1','CPF/CNPJ','2','Chave Aleatória','3','Telefone','4','Email') || ' - '|| p.chave||' ')
                                from roman.chavespix p
                                where p.idcontabancaria = pagforn.idcontabanc ) chavepix
                              -- Ticket 16244255 - Linha digitável da guia informada na requisição de pagamento
                              , ( select max(rp.linhadigitavel)
                                    from roman.requisicoespagamentos rp
                                   where rp.idnotafiscal = pagforn.idnotafiscal ) linhadigitavel
                              -- Data de Pagamaento
                              , pagforn.datapagto data_pagamento
                
                              
                              -- 9466261 - Maicon Aimi - 26/08/2025 Check Liquidar Faturas
                              , decode(pagforn.BANCOAGENDADO,'S', APEX_ITEM.CHECKBOX2(3, pagforn.idpgtoforn, decode(:P31_LIQUIDARTODOS,'S','CHECKED',NULL) ),null) liquidar_fatura
                              , case when (pagforn.valorpago + nvl(pagforn.desconto,0) - pagforn.valorpagar) = 0 then 'Sim' else 'Não' end fatura_liquidada
                
                
                              -- 10557712 - Maicon Aimi - 04/09/2025 Check Liberar Pagamento
                              , apex_item.checkbox2(
                                    p_idx            => 4,
                                    p_value          => pagforn.idpgtoforn,
                                    p_attributes     => decode(:P31_CONFERIRTODOS,'S','CHECKED',NULL)
                                ) conferir_despesa
                              -- 10557712 - Maicon Aimi - 04/09/2025 Liberado Pagamento (Sim) ou (Não)
                              , decode(pagforn.pagamentoliberado, 'S', 'Sim','Não') despesa_conferida
                              , (select gf.grupo
                                   from notasfiscais nf
                                      , razoessociaisfiliais rz 
                                      , gruposfinanceiros gf
                                  where nf.idnotafiscal = pagforn.idnotafiscal
                                    and nf.idrazaosocialfildestino = rz.idrazaosocialfilial 
                                    and rz.idgrupofinanceiro = gf.idgrupofinanceiro) grupo_financeiro
                           from pagamentosfornecedores pagforn
                          where -- Filtro Cheque
                                pagforn.idcheque is null
                            -- Filtro Tipo De pagamento
                            and pagforn.tipopagamento is not null
                            -- Filtro Tipo de Nota e Tipo de Emitente
                            and not exists ( select 1
                                               from notasfiscais nf
                                              where nf.idnotafiscal = pagforn.idnotafiscal
                                                and nf.tiponota     = 'T'
                                                and nf.tipoemitente = 'FIL' )
                            -- Filtro Usuários Formas de Pagamentos
                            and (exists ( select 1
                                            from usuariosformaspagamentos a
                                           where a.idformapagamento = pagforn.tipopagamento 
                                             and a.idusuario        = :P0_IDUSUARIO) or v('APP_USER') in ('LEONELG', 'LUCASSOUZA','DIONYRINKER','CAMILABARTH'))
                            -- Filtro Fornecedor
                            and (   ( :P31_IDFORNECEDOR is null)
                                 or ( pagforn.idfornecedor = :P31_IDFORNECEDOR ))
                            -- Filtro Tipo de Fornecedor
                            and (
                                :P31_TIPO_FORNECEDOR is null
                                or exists (
                                    select 1
                                      from fornecedores f
                                     where f.idfornecedor = pagforn.idfornecedor
                                       and instr(
                                             ':' || :P31_TIPO_FORNECEDOR || ':',
                                             ':' || f.tipo_fornecedor || ':'
                                           ) > 0
                                )
                            )
                            -- Filtro Tipo de Data
                            and (   ( :P31_TIPO_DATA = 'N'  and extract(year from dtvencimento) = :P31_ANO)
                                 or ( :P31_TIPO_DATA = 'V' and trunc(pagforn.dtvencimento) between to_date(:P31_DATAINICIO) and to_date(:P31_DATAFIM) ) 
                                 or ( :P31_TIPO_DATA = 'B' and trunc(pagforn.databaixa) between to_date(:P31_DATAINICIO) and to_date(:P31_DATAFIM) ) )
                            -- Filtro Automatizado
                            and (   ( :P31_AUTOMATIZADO is null) 
                                 or ( pagforn.automatizar = 'S' ))
                            -- Filtro Priorizado
                            and (   ( :P31_PRIORIZADO is null)
                                 or ( pagforn.prioridade is not null ))
                            -- Filtro Valor
                            and (   ( :P31_TIPO = 'T' )
                                 or ( :P31_TIPO = 'A' and ( pagforn.valorpago + nvl(pagforn.desconto,0) ) - pagforn.valorpagar < 0 )  
                                 or ( :P31_TIPO = 'P' and ( pagforn.valorpago + nvl(pagforn.desconto,0) ) - pagforn.valorpagar > 0 ) ) 
                            -- Filtro ADM Varejo Top Bojos
                            and ( :P31_ADMVAREJOTOP = 'S' or ( :P31_ADMVAREJOTOP = 'N' and  nvl(pagforn.idfornecedor,0) not in (2170,2099) ) )
                       ) x
                 where -- Filtro Razão social
                       :P31_RAIZCNPJ is null or x.idrazaofilial in (select idrazaosocialfilial from tmp_raizcnpj) 
                 
                
                ```
            pageItemsToSubmit: [
                P31_TIPO_DATA
                P31_DATAINICIO
                P31_DATAFIM
                P31_IDFORNECEDOR
                P31_ANO
                P31_AUTOMATIZADO
                P31_PRIORIZADO
                P31_ADMVAREJOTOP
                P31_RAIZCNPJ
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            customAttributes: onClick="javascript:somavalorTodos();"
        }
        link {
            linkColumn: customTarget
            target: {
                page: 32
                items: {
                    P32_IDPGTOFORN: #IDPGTOFORN#
                }
                clearCache: 32
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt="" />
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
