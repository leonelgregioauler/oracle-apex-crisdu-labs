                sort {
                    sequence: 2
                }
            )

            sort (
                column: NRNF
                sort {
                    sequence: 3
                }
            )

            aggregate (
                column: VALORPAGAR
            )

            aggregate (
                column: VALORPAGO
            )

            aggregate (
                column: SALDO
            )

            highlight ir-condition (
                name: Faturas Automatizaas
                condition {
                    column: AUTOMATIZADO
                    value: Sim
                }
                colors {
                    background: #3D853D
                }
                execution {
                    sequence: 10
                }
                advanced {
                    enabled: false
                }
            )

            highlight ir-condition-2 (
                name: Faturas com Prioridade
                condition {
                    column: PRIORIDADE
                    value: Prioridade
                }
                highlight {
                    type: cell
                }
                colors {
                    background: #6BB4B8
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-3 (
                name: Saldo Negativo
                condition {
                    column: SALDO
                    operator: <
                    value: 0
                }
                highlight {
                    type: cell
                }
                colors {
                    text: #FF0033
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-4 (
                name: Saldo Positivo
                condition {
                    column: SALDO
                    operator: >=
                    value: 0
                }
                highlight {
                    type: cell
                }
                colors {
                    text: #006600
                }
                execution {
                    sequence: 10
                }
            )

        )

    )

