    dynamicAction alimenta-cnpj-na-temporária (
        name: Alimenta CNPJ na Temporária
        execution {
            sequence: 100
        }
        when {
            selectionType: items
            items: P31_RAIZCNPJ
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    vcount number;
                    vcnpj  varchar2(4000);
                    BEGIN 
                      --
                      delete from tmp_raizcnpj;
                      -- 
                      insert into tmp_raizcnpj 
                         SELECT r.idrazaosocialfilial 
                         FROM roman.razoessociaisfiliais r 
                         WHERE substr(REGEXP_REPLACE(r.cnpj,'[./-]',''), 1, 8) 
                               in ( select regexp_substr(:P31_RAIZCNPJ, '[^:]+', 1, level)
                                      from dual connect by level <= regexp_count(:P31_RAIZCNPJ, ':') + 1 );
                    /*    select count(*)
                           into vcount 
                        from tmp_raizcnpj ;
                        
                      select listagg(idrazaosocialfilial,';')
                        into :P31_CNPJTESTE
                        from tmp_raizcnpj
                        where rownum < 350;*/
                    
                    END;
                    ```
                itemsToSubmit: P31_RAIZCNPJ
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

