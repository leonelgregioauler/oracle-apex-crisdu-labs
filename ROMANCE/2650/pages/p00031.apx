    process agendar-banco (
        name: Agendar Banco
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  v_verifica  varchar2(50);
                  vpgagendado varchar2(1);
                  --
                begin
                  --
                  for i in 1..APEX_APPLICATION.G_F02.COUNT
                  --
                  loop
                    --
                    begin
                      --
                      select pf.pgtoagendado
                        into vpgagendado
                      from roman.pagamentosfornecedores pf
                      where pf.pgtoagendado = 'S'
                        and pf.idpgtoforn = APEX_APPLICATION.G_F02(i);
                        
                    exception
                       when others then  
                       raise_application_error(-20001,'Para agendar banco o pagamento precisa estar agendado.');
                    end;
                    --
                    if vpgagendado = 'S' then 
                      --
                      update roman.pagamentosfornecedores t
                         set t.bancoagendado = 'S'
                      where t.idpgtoforn = APEX_APPLICATION.G_F02(i)
                        and nvl(t.bancoagendado,'N') = 'N';
                      --
                      insert into roman.log_pagamentosfornecedores (idlogpagfor, idpgtoforn, tipoevento, usuario, datahora)
                      values (roman.seq_log_pagamentosfornecedores.nextval, APEX_APPLICATION.G_F02(i), 'AUTORIZACAO_BANCO', v('APP_USER'), sysdate);
                      --
                      v_verifica := APEX_APPLICATION.G_F02(i);
                      --
                    end if;
                    --
                    end loop;
                    --
                    if v_verifica is null then
                      --
                      raise_application_error(-20001,'Selecione um ou mais registros.');
                    else
                      --
                      commit;
                      --
                    end if;
                    --
                end;
                ```
        }
        execution {
            sequence: 110
        }
        advanced {
            executionMappingIdentifier: 376213501291987703
        }
        serverSideCondition {
            whenButtonPressed: @agendar-banco
        }
        comments {
            comments: "Só agenda banco se pagamento estiver agendado. "
        }
    )

    process agendar-pagamento (
        name: Agendar_Pagamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  v_verifica varchar2(50);
                begin
                --
                 FOR i IN 1..APEX_APPLICATION.G_F01.COUNT
                 loop
                   --   
                   update roman.pagamentosfornecedores t
                      set t.pgtoagendado = 'S',
                          t.idcontapagamento = :P31_IDCONTAPARAPAGAMENTO,
                          t.datapagto = :P31_DATA_PAGAMENTO
                    where t.idpgtoforn = APEX_APPLICATION.G_F01(i)
                      and nvl(t.pgtoagendado,'N') = 'N';
                   --
                    insert into roman.log_pagamentosfornecedores (idlogpagfor, idpgtoforn, tipoevento, usuario, datahora)
                    values (roman.seq_log_pagamentosfornecedores.nextval, APEX_APPLICATION.G_F01(i), 'AGENDAMENTO', v('APP_USER'), sysdate);
                   --
                   v_verifica := APEX_APPLICATION.G_F01(i);
                   --
                  END LOOP;
                  --
                  if v_verifica is null then
                  raise_application_error(-20001,'Selecione um ou mais registros.');
                  else
                  commit;
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 90
        }
        advanced {
            executionMappingIdentifier: 3630441858497319408
        }
        serverSideCondition {
            whenButtonPressed: @agendar-pagamento
        }
    )

    process ajusta-filiais-do-pagamentosfornecedores (
        name: Ajusta filiais do pagamentosfornecedores
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  for a in ( select p.idpgtoforn
                             from pagamentosfornecedores p
                             where p.idfilial != ( select  n.idfilialdestino 
                                                   from notasfiscais n
                                                   where n.idnotafiscal = p.idnotafiscal )     )
                  loop
                    --
                    update pagamentosfornecedores p 
                    set p.idfilial = ( select n.idfilialdestino 
                                       from notasfiscais n
                                       where n.idnotafiscal = p.idnotafiscal )
                    where p.idpgtoforn = a.idpgtoforn ;
                    --
                  end loop;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 3714470858375192636
        }
    )

    process cancelar-conferir-despesa (
        name: CANCELAR_CONFERIR_DESPESA
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                  -- Validações:
                  -- Verifica se ao menos uma fatura foi marcada
                  if apex_application.g_f04.count = 0 then
                       apex_error.add_error(
                         p_message => 'Ops! Você precisa marcar pelo menos uma fatura para então realizar o cancelamento das liberações de pagamento.',
                         p_display_location => apex_error.c_inline_in_notification);
                    return;
                  end if;
                
                  -- loop na grade de faturas(região faturas da página) e faz o cancelamento da liberação para pagamento das faturas que estiverem check = sim no campo liberar pagamento.
                  for i in 1 .. apex_application.g_f04.count loop
                
                    -- muda o campo pagamento liberado de 'S' para 'N'
                    update roman.pagamentosfornecedores pf
                       set pf.pagamentoliberado = 'N'
                     where pf.idpgtoforn = apex_application.g_f04(i)
                       and pf.pagamentoliberado != 'N';
                
                    insert into roman.log_pagamentosfornecedores (idlogpagfor, idpgtoforn, tipoevento, usuario, datahora)
                    values (roman.seq_log_pagamentosfornecedores.nextval, apex_application.g_f04(i), 'CANCEL_CONFERENCIA', v('APP_USER'), sysdate);
                  end loop;  
                
                  -- efetiva os ajustes
                  commit;
                
                -- tratamento de erros
                exception
                  when others then
                     apex_error.add_error(
                       p_message => 'Algo deu errado durante o cancelamento de liberação para pagamento das faturas. Detalhe do erro: ' || SQLERRM,
                       p_display_location => apex_error.c_inline_in_notification);
                end;
                ```
        }
        execution {
            sequence: 80
        }
        successMessage {
            successMessage: O cancelamento da liberação de pagamentos das faturas foi realizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 1335184924675548016
        }
        serverSideCondition {
            whenButtonPressed: @cancelar-conferir-despesa
        }
    )

    process conferir-despesa (
        name: CONFERIR_DESPESA
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Validações:
                  -- Verifica se ao menos uma fatura foi marcada
                  if apex_application.g_f04.count = 0 then
                       apex_error.add_error(
                         p_message => 'Ops! Você precisa marcar pelo menos uma fatura para então librar o pagamento.',
                         p_display_location => apex_error.c_inline_in_notification);
                    return;
                  end if;
                
                  -- loop na grade de faturas(região faturas da página) e faz a liberação para pagamento das faturas que estiverem check = sim no campo liberar pagamento.
                  for i in 1 .. apex_application.g_f04.count loop
                
                    -- muda o campo pagamento liberado de 'N' para 'S'
                    update roman.pagamentosfornecedores pf
                       set pf.pagamentoliberado = 'S'
                     where pf.idpgtoforn = apex_application.g_f04(i)
                       and pf.pagamentoliberado != 'S';
                
                    insert into roman.log_pagamentosfornecedores (idlogpagfor, idpgtoforn, tipoevento, usuario, datahora)
                    values (roman.seq_log_pagamentosfornecedores.nextval, apex_application.g_f04(i), 'CONFERENCIA', v('APP_USER'), sysdate);
                
                  end loop;  
                
                  -- efetiva os ajustes
                  commit;
                
                -- tratamento de erros
                exception
                  when others then
                     apex_error.add_error(
                       p_message => 'Algo deu errado durante a liberação para pagamento das faturas. Detalhe do erro: ' || SQLERRM,
                       p_display_location => apex_error.c_inline_in_notification);
                end;
                ```
        }
        execution {
            sequence: 70
        }
        successMessage {
            successMessage: Fatuas Liberadas para pagamento com suceso.
        }
        advanced {
            executionMappingIdentifier: 1335184899220548015
        }
        serverSideCondition {
            whenButtonPressed: @conferir-despesa
        }
    )

