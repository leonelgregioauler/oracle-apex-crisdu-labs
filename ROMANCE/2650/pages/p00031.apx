    button agendar-banco (
        buttonName: Agendar_banco
        label: Autorizar Banco
        layout {
            sequence: 90
            region: @faturas
            slot: regionBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    v_idusuario NUMBER;
                BEGIN
                    SELECT idusuario INTO v_idusuario
                    FROM usuarios
                    WHERE UPPER(usuario) = UPPER(v('APP_USER'));
                
                    RETURN favorita.pck_util_fav.fnc_verificaacesso(4023, v_idusuario) = 'S';
                EXCEPTION
                    WHEN OTHERS THEN
                        RETURN FALSE;
                END;
                ```
        }
    )

