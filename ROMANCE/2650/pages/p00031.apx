    process desfazer-agendar-pagamento (
        name: desfazer_Agendar_Pagamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  v_verifica varchar2(50);
                  vbanco varchar2(1);
                  --
                begin
                  --
                  for i in 1..APEX_APPLICATION.G_F01.COUNT
                  --
                  loop
                    --
                    begin 
                      --
                      select pf.bancoagendado
                        into vbanco
                      from roman.pagamentosfornecedores pf
                      where pf.bancoagendado = 'N'
                        and pf.idpgtoforn = APEX_APPLICATION.G_F01(i);
                        
                    exception
                       when others then  
                       raise_application_error(-20001,'Não é possivel remover agendamento pagamento, existe agendamento banco realizado.');
                    --
                    end;
                    --
                    if vbanco = 'N' then 
                      --  
                      update roman.pagamentosfornecedores t
                         set t.pgtoagendado = 'N'
                      where t.idpgtoforn = APEX_APPLICATION.G_F01(i)
                        and nvl(t.pgtoagendado,'N') = 'S';
                      --
                      insert into roman.log_pagamentosfornecedores (idlogpagfor, idpgtoforn, tipoevento, usuario, datahora)
                      values (roman.seq_log_pagamentosfornecedores.nextval, APEX_APPLICATION.G_F01(i), 'CANCEL_AGENDAMENTO', v('APP_USER'), sysdate);
                      --
                      v_verifica := APEX_APPLICATION.G_F01(i);
                      --
                    end if;
                    --
                  end loop;
                  --
                  if v_verifica is null then
                    --
                    raise_application_error(-20001,'Selecione um ou mais registros.');
                  else
                    --
                    commit;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 100
        }
        advanced {
            executionMappingIdentifier: 3630442095266319410
        }
        serverSideCondition {
            whenButtonPressed: @desfazer-agendar-pagamento
        }
    )

    process liquidar-faturas-agendadas (
        name: LIQUIDAR_FATURAS_AGENDADAS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  -- Veriaveis de controle
                  vvalorapagar number;
                
                begin
                  
                  -- Validações:
                  -- Verifica se ao menos uma fatura foi marcada
                  if apex_application.g_f03.count = 0 then
                       apex_error.add_error(
                         p_message => 'Ops! Você precisa marcar pelo menos uma fatura para liquidar.',
                         p_display_location => apex_error.c_inline_in_notification);
                    return;
                  end if;
                
                  -- Obriga Conta para pagamento (será utilizada a conta bancária que foi utilizada ao agendar)
                  /* if :P31_IDCONTAPARAPAGAMENTO is null then
                       apex_error.add_error(
                         p_message => 'Ops! Antes de liquidar a(s) fatura(s), é preciso selecionar uma conta para pagamento.',
                         p_display_location => apex_error.c_inline_in_notification);
                    return;
                  end if; */
                
                  -- Obriga Data Pagamento
                  if :P31_DATA_PAGAMENTO is null then
                       apex_error.add_error(
                         p_message => 'Ops! Antes de liquidar a(s) fatura(s), é preciso a data de pagamento.',
                         p_display_location => apex_error.c_inline_in_notification);
                    return;
                  end if;
                
                  -- loop na grade de faturas(região faturas da página) e faz a liquidação da faturas que estiverem check = sim no campo liquidar faturas.
                  for i in 1 .. apex_application.g_f03.count loop
                
                    -- usa o for para valida se existe e se ainda não tem valor em aberto na fatura do fornecedor
                    for vPagForn in ( select pf.idpgtoforn, pf.valorpagar, pf.valorpago, idcontapagamento
                                        from roman.pagamentosfornecedores pf
                                       where pf.idpgtoforn = apex_application.g_f03(i)
                                         and pf.valorpagar > pf.valorpago )
                    loop
                      roman.prc_grava_log_debug_desenvolvedores('asdasdasd',vPagForn.idpgtoforn);
                      -- calcula o valor a ser pago
                      vvalorapagar := vPagForn.valorpagar - vPagForn.valorpago;
                
                      -- atuliza a tabela de pagamentos
                      update pagamentosfornecedores pg
                         set pg.idcontabanc   = :P31_IDCONTAFORNECEDOR
                           , pg.databaixa     = sysdate
                           , pg.transferencia = :P31_POR_TRANSFERENCIA
                           , pg.idcontapagamento = nvl(vPagForn.idcontapagamento, :P31_IDCONTAPARAPAGAMENTO)
                           , pg.datapagto = :P31_DATA_PAGAMENTO
                       where pg.idpgtoforn = apex_application.g_f03(i);
                
                      insert into roman.log_pagamentosfornecedores (idlogpagfor, idpgtoforn, tipoevento, usuario, datahora)
                      values (roman.seq_log_pagamentosfornecedores.nextval, vPagForn.idpgtoforn, 'LIQUIDACAO', v('APP_USER'), sysdate);
                      --
                
                      -- gera um registro na tabela de depositos
                      insert into depositosdiarios ( iddepositodiarios  , data          , idrepresentante
                                                   , idpgtoforn         , valordeposito , comprovado
                                                   , tipo               , valororiginal , tipopagamento 
                                                   , idcontapagamento   , idcontabanc  )
                      select seq_iddepositodiarios.nextval         , :P31_DATA_PAGAMENTO , 49565
                           , p.idpgtoforn                          , vvalorapagar         , 'S'        
                           , decode(p.tipopagamento,'M','M','DD' ) , vvalorapagar         , p.tipopagamento
                           , vPagForn.idcontapagamento             , :P31_IDCONTAFORNECEDOR
                        from pagamentosfornecedores p
                       where idpgtoforn = apex_application.g_f03(i);
                
                      -- Atualiza os pagamentos
                      pck_financeiro_rmc.prc_atualiza_pagtoforn ( apex_application.g_f03(i) );
                      commit;
                      
                    end loop;
                
                  end loop;  
                
                end;
                
                ```
        }
        execution {
            sequence: 170
        }
        successMessage {
            successMessage: Faturas liquidadas com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1334051411856217434
        }
        serverSideCondition {
            type: request=Value
            value: LIQUIDAR_FATURAS_AGENDADAS
        }
    )

    branch (
        name: Go To Page 31
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 31
                items: {
                    P31_IDFORNECEDOR: &P31_IDFORNECEDOR.
                    P31_ANO: &P31_ANO.
                    P31_TIPO: &P31_TIPO.
                    P31_ADMVAREJOTOP: &P31_ADMVAREJOTOP.
                    P31_PRIORIZADO: &P31_PRIORIZADO.
                    P31_AUTOMATIZADO: &P31_AUTOMATIZADO.
                    P31_TIPO_DATA: &P31_TIPO_DATA.
                    P31_DATAINICIO: &P31_DATAINICIO.
                    P31_DATAFIM: &P31_DATAFIM.
                }
                action: resetPagination
            }
        }
    )

)

