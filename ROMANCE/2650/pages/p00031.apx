    pageItem P31_INCONSISTENCIA (
        type: displayOnly
        label {
            label: " "
            alignment: left
        }
        settings {
            format: htmlUnsafe
            sendOnPageSubmit: false
        }
        layout {
            sequence: 10
            region: @inconsistências
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vforn varchar2(1000);
                begin
                  --
                  select case 
                           when listagg(nf.documento||' - ' ||pck_romance.fnc_nomefornecedor(idfornecedor)||' <br>') within group (order by 1) is not null then
                               '<font color="red">Inconsistência na fatura '||listagg(nf.documento||' - ' ||pck_romance.fnc_nomefornecedor(idfornecedor)||' <br>') within group (order by 1)||'</font>' 
                           else
                               'Não há inconsistências nas faturas.'
                           end display
                  into vforn
                  from pagamentosfornecedores pf
                     , notasfiscais           nf
                  where pf.idnotafiscal   = nf.idnotafiscal
                    and extract(year from dtvencimento) >= 2018
                    and pf.valorpago != ( select sum(valordeposito)
                                          from depositosdiarios d
                                          where d.idpgtoforn = pf.idpgtoforn );
                  --
                  --vforn := pck_romance.fnc_retornainconsistencia;
                  --
                  return vforn;
                  --
                exception
                  when others then
                      return 'Não há inconsistências nas faturas.';
                end;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P31_INCONSISTENCIA_1 (
        type: displayOnly
        label {
            label: " "
            alignment: left
        }
        settings {
            format: htmlUnsafe
            sendOnPageSubmit: false
        }
        layout {
            sequence: 20
            region: @inconsistências
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vforn varchar2(1000);
                begin
                  --
                  select listagg(idfornecedor||'-'||pck_romance.fnc_nomefornecedor(idfornecedor)
                                                                   ||' - Conta:'|| pck_romance.fnc_nomefornecedor(idfornecedor) ||' <br>') within group (order by 1)
                           display
                  into vforn
                  /*select pck_cadastros_rmc.fnc_retornacontabancaria(idcontabanc) conta 
                       , idfornecedor
                       , idcontabanc  
                       , pck_romance.fnc_nomefornecedor(idfornecedor) fornecedor
                       , pagar
                       , pago
                       , somadeposito
                       , pago - nvl(somadeposito,0) diferenca*/
                  from (
                        select p.idcontabanc
                             , p.idfornecedor
                             , sum(p.valorpagar) pagar
                             , sum(p.valorpago) pago
                             , sum( ( select sum(valordeposito)
                                      from depositosdiarios_orig d
                                      where d.idpgtoforn = p.idpgtoforn ) ) somadepositoorig
                             , sum( ( select sum(valordeposito)
                                      from depositosdiarios d
                                      where d.idpgtoforn = p.idpgtoforn ) ) somadeposito
                        from pagamentosfornecedores p
                        where idfornecedor not in ( 220,1195)
                        group by p.idcontabanc, p.idfornecedor )   
                        where ( pago - nvl(somadepositoorig,0)  != 0            
                              or nvl(somadepositoorig,0) != nvl(somadeposito,0) )
                          and idcontabanc is not null   ;
                  --
                  --vforn := pck_romance.fnc_retornainconsistencia;
                  --
                  if vforn is not null then
                    vforn := '<font color="red">Inconsistência no fornecedor '||vforn||'</font>' ;
                  else
                    vforn :=  'Não há inconsistências nos depósitos.';
                  end if;
                  --
                  return vforn;
                  --
                exception
                  when others then
                      return 'Não há inconsistências nos depósitos';
                end;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

