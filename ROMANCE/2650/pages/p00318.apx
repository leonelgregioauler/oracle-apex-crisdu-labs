    region contas-a-receber (
        name: Contas A Receber
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Abatimento' tipo
                     , vr.datavencimento
                     , nv.dtnf  emissao
                     , ( select pck_romance.fnc_nomefornecedor(nc.idfornemitente)
                         from notasfiscais nc
                         where nc.idnotafiscal = nv.idnotafiscalcompra ) "Fornecedor"
                     , pck_romance.fnc_nomefornecedor(nv.idfornecedordestino) "Cliente"
                     --, nv.idfornecedordestino idfornecedorcliente
                     , nv.documento documento
                     , vr.valor
                     , pck_cadastros_rmc.fnc_retornacontabancaria(dd.idcontabanc) contabancaria
                     , pck_romance.fnc_nomefornecedor(nv.idfornemitente) "Depositar para"
                     --, nv.idnotafiscal
                     --, to_char(dd.data,'IW/RRRR') semana
                     , dd.data
                     , decode(vr.abatimentoconfirmado,'S','Sim','Não') abatimentoconfirmado
                     --, vr.idvencimento
                     --, nv.idfornecedordestino cliente
                     , to_char(dd.data, 'Month') "Mês Pgto"
                     , to_char(vr.datavencimento, 'Month') "Mês Vcto"
                     , to_char(vr.datavencimento, 'RRRR') "Ano Vcto"
                     , nv.observacao
                from notasfiscais nv 
                   , vencimentosreceber vr
                   , depositosdiarios_orig dd
                where nv.tiponota = 'V'
                  and nv.idnotafiscal     = vr.idnotafiscal
                  --and extract(year from dd.data) = 2022
                  and vr.idvencimento     = dd.idvencimentoabatimento(+)    
                  and nv.transferenciaentrefiliaisrom = 'N'
                  and nv.idcompratransferencia is null
                  and ( :P318_FILTRAR_POR = 'X' 
                      or ( :P318_FILTRAR_POR = 'P' and dd.data between to_date(:P318_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P318_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') )
                      or ( :P318_FILTRAR_POR = 'A' and extract(year from dd.data) = :P318_ANO )
                      or ( :P318_FILTRAR_POR = 'M' and extract(year from dd.data) = :P318_ANO
                                                   and extract(month from dd.data) = :P318_MES ) )
                  and not exists ( select 1
                                   from depositosdiarios d
                                   where d.idvencimentoabatimento = vr.idvencimento )
                  and exists ( select 1
                               from notasfiscais nf
                                  , razoessociaisfiliais r
                               where nf.idnotafiscal = nv.idnotafiscalcompra
                                 and r.idrazaosocialfilial = nf.idrazaosocialfildestino
                                 and r.grupocrisdu = 'S' )
                order by 2
                
                ```
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
