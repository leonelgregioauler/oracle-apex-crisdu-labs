    region contas-a-pagar (
        name: Contas A Pagar
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rownum registro
                     , ex.idcontabancaria
                     , ex.datamovimento
                     , ex.fatura
                     , ex.origem
                     , ex.destino
                     , ex.identificacao
                     , ex.valorapagar
                     , ex.valorpago
                     , round(ex.considerar,2) considerar
                from (
                        select ex.idcontabancaria
                             , trunc(ex.datamovimento) datamovimento
                             , 'Fatura '|| documento fatura
                             , pck_romance.fnc_nomefornecedor(nf.idfornemitente) origem
                             , pck_romance.fnc_nomefilial(nf.idfilialdestino) destino
                             , null identificacao
                             , ex.valormovimento valorapagar
                             , null valorpago
                             , ex.valormovimento considerar
                             , ex.idextratocontabancaria id
                        from extratoscontasbancarias ex
                           , notasfiscais nf
                           , razoessociaisfiliais r
                        where ex.idvencimento is not null
                          and ex.idnotafiscal = nf.idnotafiscal
                          and ex.contabilizar = 'S'
                          and r.grupocrisdu = 'S'
                          and ex.identificado = 'S'
                          and r.idrazaosocialfilial = nf.idrazaosocialfildestino
                          and ( :P318_FILTRAR_POR = 'X' 
                              or ( :P318_FILTRAR_POR = 'P' and ex.datamovimento between to_date(:P318_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P318_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') )
                              or ( :P318_FILTRAR_POR = 'A' and extract(year from ex.datamovimento) = :P318_ANO )
                              or ( :P318_FILTRAR_POR = 'M' and extract(year from ex.datamovimento) = :P318_ANO
                                                           and extract(month from ex.datamovimento) = :P318_MES ) )
                          and not exists ( select 1
                                           from fornecedores f
                                              , filiais ff
                                           where f.idfornecedor = nf.idfornemitente
                                             and ff.idpessoa = f.idpessoa )
                        union
                        select ex.idcontabancaria
                             , trunc(ex.datamovimento) datamovimento
                             , null fatura
                             , null origem
                             , null destino
                             , case
                                 when nvl(dr.transferencia,'N') = 'S' then
                                   'Transferencia '||dr.nroidentificacao_digitado
                                 when nvl(dr.pix,'N') = 'S' then
                                   'PIX '||dr.nroidentificacao_digitado
                                 else
                                   'Comprovante '||dr.nroidentificacao_digitado
                               end identificacao
                             , null valorapagar
                             , dr.valor_digitado valorpago
                             , dr.valor_digitado considerar
                             , dr.idleituraocr_deposito
                        from extratoscontasbancarias ex
                           , depositosdiarios_leituraocr dr
                        where dr.iddepositodiario = ex.iddepositodiario_orig
                          and ex.contabilizar = 'S'
                          and ex.idvencimento is null
                          and ex.identificado = 'S'
                          and ( :P318_FILTRAR_POR = 'X' 
                              or ( :P318_FILTRAR_POR = 'P' and ex.datamovimento between to_date(:P318_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P318_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') )
                              or ( :P318_FILTRAR_POR = 'A' and extract(year from ex.datamovimento) = :P318_ANO )
                              or ( :P318_FILTRAR_POR = 'M' and extract(year from ex.datamovimento) = :P318_ANO
                                                           and extract(month from ex.datamovimento) = :P318_MES ) )
                          and exists ( select 1
                                       from vencimentos v
                                          , notasfiscais nf
                                          , razoessociaisfiliais r
                                       where v.idcontabanc = ex.idcontabancaria
                                         and v.idnotafiscal = nf.idnotafiscal
                                         and r.idrazaosocialfilial = nf.idrazaosocialfildestino
                                         and not exists ( select 1
                                                          from fornecedores f
                                                             , filiais ff
                                                          where f.idfornecedor = nf.idfornemitente
                                                            and ff.idpessoa = f.idpessoa ) )
                        order by datamovimento ) ex;
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 314941669613486620
        }

