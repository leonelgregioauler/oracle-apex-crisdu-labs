page 66 (
    name: Nova Saida
    title: Nova Saida
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='Confirma a exclusão da Saída?';
            
            
            
            function  confirmasaida(event)
            { 
            var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
            
            if (tecla==13) 
              {
            var answer = confirm("Confirma inclusão da saida?")
            	if (answer){            
            		apex.submit('CREATE');
            	}
              }
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region nova-saida (
        name: Nova Saida
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P66_DATA (
        type: hidden
        layout {
            sequence: 70
            region: @nova-saida
            slot: regionBody
        }
        appearance {
            formatMask: DD/MM/RRRR
        }
        source {
            type: databaseColumn
            databaseColumn: DATA
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                return sysdate;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

