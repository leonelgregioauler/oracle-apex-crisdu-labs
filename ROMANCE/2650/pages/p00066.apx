    )

    pageItem P66_TIPO (
        type: radioGroup
        label {
            label: Tipo
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Dinheiro/Cheque;D,Pagamento de Conta;O
