    pageItem P66_FECHAMENTOORIG (
        type: selectList
        label {
            label: Fechamento
            alignment: right
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select semana DISPLAY_VALUE
                , semana return_value
                from fechamentossemanais 
                where idfechamento = :P66_IDFECHAMENTO
                ```
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @nova-saida
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            customAttributes: style="text-align: right;" readonly
        }
        source {
            type: databaseColumn
            databaseColumn: FECHAMENTOORIG
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P66_IDFECHAMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 100
            region: @nova-saida
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFECHAMENTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P66_IDFILIAL (
        type: selectList
        label {
            label: Filial
            alignment: right
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(p.apelido,p.nomepessoa)) display_value
                     , f.idfilial return_value
                from filiais    f
                   , pessoas    p
                where f.idpessoa  = p.idpessoa
                  and ( (pck_romance.fnc_verificaacesso('PERM_ALTERAFECHA', v('APP_USER')) = 'S')
                       or f.idfilial = pck_romance.fnc_filialusuario(v('APP_USER')))
                order by 1 
                ```
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @nova-saida
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P66_IDFILIALDEST (
        type: selectList
        label {
            label: Filial Destino
            alignment: right
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct initcap(nvl(p.apelido,p.nomepessoa)) display_value
                     , f.idfilial return_value
                from filiais    f
                   , pessoas    p
                where f.idpessoa  = p.idpessoa
                  and p.ativo = 'S'
                  and f.idfilial not in( 240,260,261,262)
                  and ( pck_romance.fnc_verificaacesso('PERM_ALTERAFECHA', v('APP_USER')) = 'S' or f.idfilial != pck_romance.fnc_filialusuario(v('APP_USER')) )
                  and (:P86_IDFILIALDEST is null or f.idfilial = :P86_IDFILIALDEST)
                order by 1
                ```
            nullDisplayValue: - Selecione a Filial Destino -
        }
        layout {
            sequence: 30
            region: @nova-saida
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIALDEST
            used: always
        }
        readOnly {
            type: itemIsNotNull
            item: P66_IDFILIALDEST
        }
        security {
            encryptSessionState: false
        }
    )

