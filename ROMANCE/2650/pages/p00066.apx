    process fetch-row-from-saidasdiversas (
        name: Fetch Row from SAIDASDIVERSAS
        type: autoRowFetch
        source {
            tableName: SAIDASDIVERSAS
            pkColumn: IDSAIDA
            pkItem: P66_IDSAIDA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Unable to fetch row.
        }
        advanced {
            executionMappingIdentifier: 178977736816675520
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDSAIDASDIVERSAS.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P66_IDSAIDA := get_pk; 
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Unable to get primary key item value.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 178977911358675520
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-saidasdiversas (
        name: Process Row of SAIDASDIVERSAS
        type: autoRowProcessing
        target {
            tableName: SAIDASDIVERSAS
            pkColumn: IDSAIDA
            pkItem: P66_IDSAIDA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação processada!
        }
        error {
            errorMessage: Não foi possível processar a atualização, contate o administrador!
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 178978117956675520
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 178978311076675522
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
