        }
        layout {
            sequence: 60
            region: @nova-saida
            slot: regionBody
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: TIPO
            used: always
        }
        default {
            type: static
            staticValue: O
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P66_TIPO is not null
                and :P66_IDSAIDA is not null
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P66_VALORTOTAL (
        type: numberField
