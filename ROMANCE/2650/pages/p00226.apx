page 226 (
    name: Recebimento de Compras
    title: Recebimento de Compras
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region recebimento-de-compras (
        name: Recebimento de Compras
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nf.documento "NF"
                     , pck_romance.fnc_nomefilial(nf.idfilialdestino) "Destino"
                     , pck_romance.fnc_nomeproduto(it.idproduto) "Produto"
                     , sum( nvl(it.qtd_pp,0)
                          + nvl(it.qtd_p,0)
                          + nvl(it.qtd_m,0)
                          + nvl(it.qtd_g,0)
                          + nvl(it.qtd_gg,0)
                          + nvl(it.qtd_egg,0)
                          + nvl(it.qtd_exgg,0)
                          + nvl(it.qtd_u,0) ) "Quantidade Enviada"
                     , sum( nvl(it.qtd_pp_chegou,0)
                          + nvl(it.qtd_p_chegou,0)
                          + nvl(it.qtd_m_chegou,0)
                          + nvl(it.qtd_g_chegou,0)
                          + nvl(it.qtd_gg_chegou,0)
                          + nvl(it.qtd_egg_chegou,0)
                          + nvl(it.qtd_exgg_chegou,0)
                          + nvl(it.qtd_u_chegou,0) ) "Quantidade Chegou"
                     , sum( nvl(it.qtd_pp_chegou,0)
                          + nvl(it.qtd_p_chegou,0)
                          + nvl(it.qtd_m_chegou,0)
                          + nvl(it.qtd_g_chegou,0)
                          + nvl(it.qtd_gg_chegou,0)
                          + nvl(it.qtd_egg_chegou,0)
                          + nvl(it.qtd_exgg_chegou,0)
                          + nvl(it.qtd_u_chegou,0) ) -
                       sum( nvl(it.qtd_pp,0)
                          + nvl(it.qtd_p,0)
                          + nvl(it.qtd_m,0)
                          + nvl(it.qtd_g,0)
                          + nvl(it.qtd_gg,0)
                          + nvl(it.qtd_egg,0)
                          + nvl(it.qtd_exgg,0)
                          + nvl(it.qtd_u,0) ) "Diferença"
                     , sum(it.valortotal) "Valor Total Enviado"
                     , sum( ( nvl(it.qtd_pp_chegou,0)
                            + nvl(it.qtd_p_chegou,0)
                            + nvl(it.qtd_m_chegou,0)
                            + nvl(it.qtd_g_chegou,0)
                            + nvl(it.qtd_gg_chegou,0)
                            + nvl(it.qtd_egg_chegou,0)
                            + nvl(it.qtd_exgg_chegou,0)
                            + nvl(it.qtd_u_chegou,0) ) * it.custound ) "Valor Total Chegou"
                     , sum( ( nvl(it.qtd_pp_chegou,0)
                           + nvl(it.qtd_p_chegou,0)
                           + nvl(it.qtd_m_chegou,0)
                           + nvl(it.qtd_g_chegou,0)
                           + nvl(it.qtd_gg_chegou,0)
                           + nvl(it.qtd_egg_chegou,0)
                           + nvl(it.qtd_exgg_chegou,0)
                           + nvl(it.qtd_u_chegou,0) ) * it.custound ) - sum(it.valortotal)  "Valor Total Diferença"
                from itemnf it
                   , notasfiscais nf
                   , fornecedores f
                where ( f.idfornecedor = :P226_IDFORNECEDOR )
                  and it.idnotafiscal = nf.idnotafiscal
                  and nf.idfornemitente = f.idfornecedor
                  and nf.situacaofilial = 'R'
                  and ( :P226_IDFILIALDESTINO is null or nf.idfilialdestino = :P226_IDFILIALDESTINO )
                  and ( :P226_DOCUMENTO is null or nf.documento = :P226_DOCUMENTO )
                  and ( :P226_IDPRODUTO is null or it.idproduto = :P226_IDPRODUTO )
                  and ( :P226_TIPODATA is null
                     or ( :P226_TIPODATA = 'I' and trunc(nf.datainclusao) between to_date(:P226_DATAINICIO) and to_date(:P226_DATAFIM) )
                     or ( :P226_TIPODATA = 'E' and trunc(nf.dtnf) between to_date(:P226_DATAINICIO) and to_date(:P226_DATAFIM) )
                     or ( :P226_TIPODATA = 'R' and trunc(nf.datarecebimento) between to_date(:P226_DATAINICIO) and to_date(:P226_DATAFIM) ) )
                group by it.idproduto , nf.documento , nf.idfilialdestino
                order by 1;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent10
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Verifique os filtros.
        }
        advanced {
            savedReportMappingIdentifier: 5457821015576272691
        }

