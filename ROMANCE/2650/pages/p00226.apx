    pageItem P226_IDFILIALDESTINO (
        type: selectList
        label {
            label: Empresa Destino
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                order by 1
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P226_IDFORNECEDOR (
        type: selectList
        label {
            label: Fornecedor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefornecedor(idfornecedor) fornecedor
                     , idfornecedor
                from fornecedores f
                where ativo = 'S'
                  and exists ( select 1
                               from produtos p
                                  , fornecedoresprodutos ff
                               where p.idproduto = ff.idproduto
                                 and ff.idfornecedor = f.idfornecedor
                                 and p.venda = 'S')
                order by 1
                ```
            nullDisplayValue: - Selecione o Fornecedor -
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P226_IDPRODUTO (
        type: popupLov
        label {
            label: Produto
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct initcap(p.nomeproduto) display_value
                    , p.idproduto 
                from produtos p
                   , fornecedoresprodutos f
                where p.idproduto = f.idproduto
                  and (:P219_IDFORNECEDOR  is null or f.idfornecedor = :P226_IDFORNECEDOR )
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P226_IDFORNECEDOR
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P226_TIPODATA (
        type: radioGroup
        label {
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Inclusão;I,Emissão;E,Recebimento;R
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: R
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: FILTRAR
        layout {
            sequence: 100
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 226
                items: {
                    P226_TIPODATA: &P226_TIPODATA.
                    P226_IDFORNECEDOR: &P226_IDFORNECEDOR.
                    P226_IDPRODUTO: &P226_IDPRODUTO.
                    P226_IDFILIALDESTINO: &P226_IDFILIALDESTINO.
                    P226_DOCUMENTO: &P226_DOCUMENTO.
                    P226_DATAINICIO: &P226_DATAINICIO.
                    P226_DATAFIM: &P226_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

