    pageItem P283_ORDEMMAIOR (
        type: displayOnly
        label {
            label: " "
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 10
            region: @ordens-de-depósito
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select 
                   case 
                     when sum(e.valormovimento) > 0 then
                        '<font color="red"> Esta conta está com R$ '||TRIM(to_char(sum(e.valormovimento),'999G999G999G990D00'))
                                         ||' depositado a mais. </font>'  
                     else 
                       case
                         when  nvl( ( select sum(o.valor - nvl( ( select sum(valordeposito)
                                                          from depositosdiarios_orig d
                                                          where d.idordemdeposito = o.idordemdeposito ),0))
                                       from ordensdepositos o
                                       where o.idcontabancaria = e.idcontabancaria
                                         and o.identificado    = e.identificado ) ,0) >  sum(e.valormovimento) *-1 then
                                          --
                                           '<font color="red"> O valor das ordens ( '  ||TRIM(to_char(nvl( ( select sum(o.valor - nvl( ( select sum(valordeposito)
                                                                                                                      from depositosdiarios_orig d
                                                                                                                      where d.idordemdeposito = o.idordemdeposito ),0))
                                                                                                   from ordensdepositos o
                                                                                                   where o.idcontabancaria = e.idcontabancaria
                                                                                                     and o.identificado    = e.identificado ) ,0),'999G999G999G990D00'))
                                           ||' ) está maior que o valor devido ( '
                                           ||TRIM(to_char(sum(e.valormovimento),'999G999G999G990D00'))
                                           ||' ). </font>'  
                                          --
                           else                                              
                             --
                             '<font color="blue">Tudo certo por aqui!</font>'
                             --
                           end 
                         end AVISO
                from extratoscontasbancarias e       
                where e.datamovimento <= to_date(:P265_DATABASEDEPOSITOS||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                  and e.idcontabancaria  = :P283_IDCONTABANCARIA
                  and e.identificado     = :P283_IDENTIFICADO
                group by e.idcontabancaria  
                       , identificado
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

