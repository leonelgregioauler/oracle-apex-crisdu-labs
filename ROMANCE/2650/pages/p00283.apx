    process busca-valor-para-ordem (
        name: Busca valor para ordem
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vvalor number(15,2);
                begin
                    select ( select sum(e.valormovimento) 
                              from extratoscontasbancarias e       
                              where e.datamovimento   <= to_date(:P265_DATABASEDEPOSITOS||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                                and e.idcontabancaria  = :P283_IDCONTABANCARIA
                                and e.identificado     = :P283_IDENTIFICADO
                                and e.tipopagamento    in ('P','D','T') 
                                and e.contabilizar     = 'S' )
                         + ( select sum(valor -  nvl( ( select sum(valordeposito)
                                                          from depositosdiarios_orig d
                                                          where d.idordemdeposito = o.idordemdeposito ),0)) depositado
                              from ordensdepositos o
                              where o.idcontabancaria = :P283_IDCONTABANCARIA
                                and o.identificado = :P283_IDENTIFICADO   )
                    into vvalor
                    from dual ;
                    --
                    if vvalor < 0 then
                      vvalor := vvalor * -1;
                      --
                      :P283_VALOR := to_char(vvalor,'999G999G999G999G999G990D00');
                      --
                    end if;
                    --
                exception
                  when others then
                    null;
                end;
                    
                
                
                ```
        }
        execution {
            sequence: 30
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 3114851219811553939
        }
        serverSideCondition {
            type: itemIsNull
            item: P283_VALOR
        }
    )

    process fetch-row (
        name: Fetch row
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vdata  date;
                  vvalor number(15,2);
                begin
                  --
                  if :P283_IDORDEMDEPOSITO is not null then
                      --
                      :P283_OPERACAO_DML := 'S';
                      --
                      PCK_FINANCEIRO_RMC.PRC_ORDENSDEPOSITOS( PIDORDEMDEPOSITO => :P283_IDORDEMDEPOSITO
                                                            , PIDCONTABANCARIA => :P283_IDCONTABANCARIA
                                                            , PIDFILIAL        => :P283_IDFILIAL
                                                            , PIDREPRESENTANTE => :P283_IDREPRESENTANTE
                                                            , PDATA            => vdata
                                                            , PVALOR           => vvalor
                                                            , PDESCRICAO       => :P283_DESCRICAO
                                                            , PIDENTIFICADO    => :P283_IDENTIFICADO
                                                            , PPRIORIZADO      => :P283_PRIORIZADO
                                                            , plistadistribuidores => :P283_IDREPRESENTANTES
                                                            , PMD5             => :P283_MD5
                                                            , POPERACAO_DML    => :P283_OPERACAO_DML);
                      --
                      :P283_DATA  := TRIM(to_char(vdata , 'DD/MM/RRRR'));
                      :P283_VALOR := TRIM(to_char(vvalor, '999G999G999G990D00'));
                      --
                      select listagg(idfilial,':') within group (order by 1)
                      into :P283_IDFILIAIS
                      from filiaisordensdepositos  
                      where idordemdeposito = :P283_IDORDEMDEPOSITO;
                      --
                  else
                    --
                    :P283_IDORDEMDEPOSITO := null;
                    :P283_IDFILIAL        := null;
                    :P283_IDFILIAIS       := null;
                    :P283_IDREPRESENTANTE := null;
                    :P283_DATA            := null;
                    :P283_VALOR           := null;
                    :P283_DESCRICAO       := null;
                    :P283_PRIORIZADO      := NULL;
                    :P283_MD5             := null;
                    :P283_OPERACAO_DML    := null;
                    :P283_IDREPRESENTANTES := null;
                    --
                  end if;
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 1544604758695500623
        }
    )

    process run-stored-procedure (
        name: Run Stored Procedure
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --                                       
                  vidfilialordemdeposito  NUMBER;
                  vfiliais                APEX_APPLICATION_GLOBAL.VC_ARR2;
                  vusuario                varchar2(100);
                  vdatainclusao           date; 
                  vMD5                    varchar2(1000);
                  --
                  vdata                   date;
                  vvalor                  number(15,2);  
                  voperacaodml            varchar2(1) := 'I';
                  --
                begin
                  -- 
                  if :P283_IDORDEMDEPOSITO is null then 
                   :P283_OPERACAO_DML := 'I';
                  elsif v('REQUEST') = 'SUBMIT' then
                   :P283_OPERACAO_DML := 'U';
                  elsif v('REQUEST') = 'DELETE' then
                   :P283_OPERACAO_DML := 'D';
                  end if;
                  --
                  vdata  := to_date(:P283_DATA , 'DD/MM/RRRR');
                  vvalor := to_number(:P283_VALOR, '999G999G999G990D00');
                  --
                  :P283_PRIORIZADO := nvl(:P283_PRIORIZADO,'N');
                  --
                  PCK_FINANCEIRO_RMC.PRC_ORDENSDEPOSITOS( PIDORDEMDEPOSITO => :P283_IDORDEMDEPOSITO
                                                        , PIDCONTABANCARIA => :P283_IDCONTABANCARIA
                                                        , PIDFILIAL        => :P283_IDFILIAL
                                                        , PIDREPRESENTANTE => :P283_IDREPRESENTANTE
                                                        , PDATA            => vdata
                                                        , PVALOR           => vvalor
                                                        , PDESCRICAO       => :P283_DESCRICAO
                                                        , PIDENTIFICADO    => :P283_IDENTIFICADO
                                                        , PPRIORIZADO      => :P283_PRIORIZADO
                                                        , PLISTADISTRIBUIDORES => :P283_IDREPRESENTANTES
                                                        , PMD5             => :P283_MD5
                                                        , POPERACAO_DML    => :P283_OPERACAO_DML);
                  --     
                  --
                  --transforma o string do shutle em tabela
                  --
                  delete filiaisordensdepositos
                  where idordemdeposito = :P283_IDORDEMDEPOSITO;
                  --
                  vfiliais    := APEX_UTIL.STRING_TO_TABLE(:P283_IDFILIAIS);
                  --
                  if :P283_TIPOFILTRO = 'E' then
                    --
                    for rfil in 1.. vfiliais.count 
                    loop
                      --         
                      pck_financeiro_rmc.prc_filiaisordensdepositos( pidfilialordemdeposito => vidfilialordemdeposito
                                                                   , pidordemdeposito       => :P283_IDORDEMDEPOSITO
                                                                   , pidfilial              => vfiliais(rfil)
                                                                   , pusuario               => vusuario
                                                                   , pdatainclusao          => vdatainclusao
                                                                   , pmd5                   => vMD5
                                                                   , poperacao_dml          => voperacaodml );      
                      --  
                    end loop;
                    --
                  end if;
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1545547700945600529
        }
    )

