    pageItem P283_IDFILIAIS (
        type: shuttle
        label {
            label: Empresas
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(idfilial) display_value
                     , f.idfilial
                from filiais f
                where f.tipofilial in ('D','R','O')
                  and ativo = 'S'
                order by 1
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 130
            region: @ordem-de-depósito
