page 283 (
    name: Ordens de Depósitos
    title: Ordens de Depósitos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 80%
        height: 90%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formataMoeda(valor){
              v = valor.value;
              v=v.replace(/\D/g,"") // permite digitar apenas numero
              v=v.replace(/(\d{1})(\d{14})$/,"$1.$2") // coloca ponto antes dos ultimos digitos
              v=v.replace(/(\d{1})(\d{11})$/,"$1.$2") // coloca ponto antes dos ultimos 11 digitos
              v=v.replace(/(\d{1})(\d{8})$/,"$1.$2") // coloca ponto antes dos ultimos 8 digitos
              v=v.replace(/(\d{1})(\d{5})$/,"$1.$2") // coloca ponto antes dos ultimos 5 digitos
              v=v.replace(/(\d{1})(\d{1,2})$/,"$1,$2") // coloca virgula antes dos ultimos 2 digitos
              valor.value = v;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ordem-de-depósito (
        name: Ordem de Depósito
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        settings {
            outputAs: text
        }
    )

    region ordens-de-depósito (
        name: Ordens de Depósito
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select o.idordemdeposito
                     , pck_cadastros_rmc.fnc_retornacontabancaria(idcontabancaria) conta
                     , nvl(pck_romance.fnc_nomefilial(idfilial) 
                                                                , ( select listagg(pck_romance.fnc_nomefilial(idfilial) ) within group (order by 1)
                                                                     from filiaisordensdepositos  f
                                                                     where f.idordemdeposito = o.idordemdeposito ) )  empresa
                     , pck_romance.fnc_nomerepresentante(idrepresentante) distribuidor
                     , data
                     , valor
                     , nvl( ( select sum(valordeposito)
                              from depositosdiarios_orig d
                              where d.idordemdeposito = o.idordemdeposito ),0) depositado
                     , descricao
                     , decode(identificado, 'S', 'Sim','Não') identificado 
                     , decode(priorizado, 'S','Sim','N','Não') priorizado
                     , ( select listagg( pck_romance.fnc_nomerepresentante(r.column_value),', ') within group (order by 1)
                         from ordensdepositos oo
                            , table(pck_financeiro_rmc.fnc_array_to_table(oo.listadistribuidores)) r
                         where oo.idordemdeposito = o.idordemdeposito ) lista_de_distribuidores
                from ordensdepositos o
                where o.idcontabancaria = :P283_IDCONTABANCARIA
                  and (:P283_IDENTIFICADO is null or o.identificado = :P283_IDENTIFICADO )
                 
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 283
                items: {
                    P283_IDORDEMDEPOSITO: #IDORDEMDEPOSITO#
                }
                clearCache: 283
                action: resetPagination
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1544605217161500628
        }

