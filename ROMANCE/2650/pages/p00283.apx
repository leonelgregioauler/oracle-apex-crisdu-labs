    validation valida-exclusão (
        name: Valida exclusão
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select *
                from depositosdiarios_orig d
                where d.idordemdeposito =  :P283_IDORDEMDEPOSITO
                ```
        }
        error {
            errorMessage: Não é possível excluir esta ordem porque há depósitos vinculados a ela.
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

