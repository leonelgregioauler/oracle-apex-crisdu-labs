            templateOptions: #DEFAULT#
            height: 5
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select listagg(idfilial,':') within group (order by 1) a
                from filiaisordensdepositos  
                where idordemdeposito = :P283_IDORDEMDEPOSITO
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
