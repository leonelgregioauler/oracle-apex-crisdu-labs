    dynamicAction excluir (
        name: Excluir
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @delete
        }

        action native-confirm (
            action: confirm
            settings {
                message: Deseja realmente excluir?
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: DELETE
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction mostra-esconde-campos (
        name: Mostra/Esconde campos
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P283_TIPOFILTRO
        }
        clientSideCondition {
            type: item=value
            item: P283_TIPOFILTRO
            value: E
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P283_IDFILIAL
                    P283_IDREPRESENTANTE
                    P283_IDREPRESENTANTES
                    P283_TIPO_DISTRIBUIDOR
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-hide-2 (
            action: hide
