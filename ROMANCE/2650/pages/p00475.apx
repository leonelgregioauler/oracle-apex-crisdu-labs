    button incluir (
        buttonName: INCLUIR
        label: Incluir Selecionados
        layout {
            sequence: 10
            region: @classificação-contas-empresas
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction incluirclassif (
        name: IncluirClassif
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @incluir
        }

        action native-confirm (
            action: confirm
            settings {
                message: Confirma inclusão das classificações selecionadas?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: INCLUIRCLASS
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction selectunselectall (
        name: selectUnselectAll
        execution {
            sequence: 20
            eventScope: dynamic
            staticContainer: #partnerslRR
        }
        when {
            selectionType: jQuerySelector
            jquerySelector: #selectUnselectAll
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if ( $( '#selectUnselectAll' ).is(':checked')){
                        $('input[type=checkbox][name=f01]').attr('checked',true);
                    }
                    else {
                        $('input[type=checkbox][name=f01]').attr('checked',false);
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidclassif number;
                begin
                  --
                  
                  if APEX_APPLICATION.G_F01.COUNT > 0 then 
                  --
                  --raise_application_error(-20001,'xxxxx '|| APEX_APPLICATION.G_F01.COUNT );
                    FOR i in 1..APEX_APPLICATION.G_F01.COUNT 
                    LOOP
                      --
                      vidclassif := to_number(APEX_APPLICATION.G_F01(i));
                      --
                      insert into planocontasclassificacoes (idplanocontasclassif, idclassificacao, idplanocontasempresa)
                        values (seq_idplanocontasclassif.nextval, vidclassif, :P475_IDPLANOCONTASEMPRESA);
                      --
                    END LOOP;
                  end if;
                  --
                  commit;
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        successMessage {
            successMessage: Classificações inclusas com sucesso!
        }
        advanced {
            executionMappingIdentifier: 3074451597712696918
        }
    )

    branch (
        name: Volta para 474
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 474
                items: {
                    P474_IDPLANOCONTASEMPRESA: &P475_IDPLANOCONTASEMPRESA.
                }
                action: resetPagination
            }
        }
    )

)

