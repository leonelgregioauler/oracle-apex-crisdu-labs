page 475 (
    name: Classificação Contas Empresas
    title: Classificação Contas Empresas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 80%
        height: 60%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region classificação-contas-empresas (
        name: Classificação Contas Empresas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select g.*
                       --
                     , (SELECT classificacao
                          FROM planocontasgeral p
                         WHERE p.idclassificacao = g.classificacaopai)  classif_pai
                       --
                     , apex_item.CHECKBOX2(1,g.idclassificacao, null) CHECK1
                       --
                  from planocontasgeral g
                  where tipoconta = 'A' --Analitica
                    and not exists (select 1
                                      from planocontasclassificacoes c
                                     where idclassificacao = g.idclassificacao
                                       and c.idplanocontasempresa in (select idplanocontasempresa
                                                                     from planocontasempresa
                                                                    where idrazaosocialfilial = :P475_IDRAZAOSOCIALFILIAL))
                    and (:P475_MODELO = 15 and g.crisdu = 'S' or
                         :P475_MODELO = 16 and g.romance = 'S' or
                         :P475_MODELO = 17 and g.favoritasul = 'S' or
                         :P475_MODELO = 18 and g.favoritanorte = 'S' or
                         :P475_MODELO = 19 and g.franquias = 'S' )
                        
                    and :P475_IDRAZAOSOCIALFILIAL is not null
                ```
            pageItemsToSubmit: P475_IDRAZAOSOCIALFILIAL
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: partnerslRR
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 3074474854180557569
        }

