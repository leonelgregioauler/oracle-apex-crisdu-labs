page 307 (
    name: Extrato de Faturas
    title: Extrato de Faturas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region extrato-de-faturas (
        name: Extrato de Faturas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select  idextratocontabancaria
                     , ( select pck_romance.fnc_nomepessoa( c.idpessoa)
                         from contasbancarias c
                         where c.idcontabanc = e.idcontabancaria ) destino
                     , pck_cadastros_rmc.fnc_retornacontabancaria(e.idcontabancaria) conta   
                     , e.datamovimento datamovimento
                     , 'Fatura '||nn.documento motivo  
                     , pck_romance.fnc_nomefilial(nn.idfilialdestino) empresadestino
                     , e.valormovimento valorpagar
                     , nvl(vv.valorpago,0) valorpago  
                     , extract(month from e.datamovimento) mes
                     , e.idcontabancaria
                from extratoscontasbancarias e 
                   , notasfiscais nn
                   , vencimentos  vv      
                where nn.idnotafiscal = vv.idnotafiscal
                  and vv.idvencimento = e.idvencimento
                  and e.valormovimento < 0                                                
                  and exists ( select 1
                               from contasbancarias c
                               where c.idcontabanc = e.idcontabancaria
                                 and ( :P307_IDFORNECEDOR is null or c.idpessoa = :P307_IDFORNECEDOR ) 
                                 and ( :P307_IDCONTABANCARIA is null or c.idcontabanc = :P307_IDCONTABANCARIA) )
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1568219150359374602
        }

        column CONTA (
            type: plainText
            heading {
                heading: Conta
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

