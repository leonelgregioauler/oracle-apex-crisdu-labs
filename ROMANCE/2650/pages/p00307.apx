    pageItem P307_IDCONTABANCARIA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @extrato-de-faturas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P307_IDFORNECEDOR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @extrato-de-faturas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @extrato-de-faturas
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 299
                items: {
                    P299_IDFORNECEDOR: &P307_IDFORNECEDOR.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process atualiza-extratos-vencimentos-pagos (
        name: Atualiza Extratos/Vencimentos pagos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_financeiro_rmc.prc_atualizafaturaspagas( pidpessoa => :P307_IDFORNECEDOR
                                                             , pidcontabancaria => :P307_IDCONTABANCARIA);
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 1568219086419374601
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P307_IDFORNECEDOR
        }
    )

)

