page 161 (
    name: Atualização da movimentação
    title: Atualização da movimentação
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region atualização-da-movimentação (
        name: Atualização da Movimentação
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P161_DATAMOVIMENTO (
        type: datePickerJquery
        label {
            label: Data Movimento
            alignment: right
        }
        layout {
            sequence: 60
            region: @atualização-da-movimentação
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr
            width: 10
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: DATAMOVIMENTO
            used: always
        }
        readOnly {
            type: itemIsNotNull
            item: P161_DATAMOVIMENTO
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P161_IDFECHAMENTOORIG (
        type: hidden
        layout {
            sequence: 90
            region: @atualização-da-movimentação
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFECHAMENTOORIG
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P161_IDFILIALDEST (
        type: selectList
        label {
            label: Filial Destino
            alignment: right
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) display_value
                 , f.idfilial return_value
                         from filiais          f
                             , pessoas          p
                         where f.idpessoa = p.idpessoa
                order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @atualização-da-movimentação
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIALDEST
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P161_IDFILIALORIG (
        type: selectList
        label {
            label: Filial Origem
            alignment: right
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) display_value
                 , f.idfilial return_value
                         from filiais          f
                             , pessoas          p
                         where f.idpessoa = p.idpessoa
                           and f.idfilial  = :P161_IDFILIALORIG 
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @atualização-da-movimentação
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIALORIG
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P161_IDMOVIMENTOGERAL (
        type: hidden
        layout {
            sequence: 10
            region: @atualização-da-movimentação
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDMOVIMENTOGERAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P161_IDSAIDADIVERSA (
        type: hidden
        layout {
            sequence: 20
            region: @atualização-da-movimentação
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDSAIDADIVERSA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P161_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: right
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 80
            region: @atualização-da-movimentação
            slot: regionBody
            alignment: left
            columnSpan: 5
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 500
        }
        source {
            type: databaseColumn
            databaseColumn: OBSERVACAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P161_TIPO (
        type: radioGroup
        label {
            label: Tipo
            alignment: right
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Dinheiro;D,Pagamento de Conta;O
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @atualização-da-movimentação
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: TIPO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P161_VALOR (
        type: numberField
        label {
            label: Valor
            alignment: right
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 50
            region: @atualização-da-movimentação
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 12
        }
        validation {
            maxLength: 15
        }
        source {
            type: databaseColumn
            databaseColumn: VALOR
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @atualização-da-movimentação
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 160
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @atualização-da-movimentação
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P161_IDMOVIMENTOGERAL
        }
    )

    process fetch-row-from-movimentosgeral (
        name: Fetch Row from MOVIMENTOSGERAL
        type: autoRowFetch
        source {
            tableName: MOVIMENTOSGERAL
            pkColumn: IDMOVIMENTOGERAL
            pkItem: P161_IDMOVIMENTOGERAL
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 256179715616262972
        }
    )

    process process-row-of-movimentosgeral (
        name: Process Row of MOVIMENTOSGERAL
        type: autoRowProcessing
        target {
            tableName: MOVIMENTOSGERAL
            pkColumn: IDMOVIMENTOGERAL
            pkItem: P161_IDMOVIMENTOGERAL
            supportedOperations: update
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 256179923122262975
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 256180111969262975
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 160
            }
        }
    )

)

