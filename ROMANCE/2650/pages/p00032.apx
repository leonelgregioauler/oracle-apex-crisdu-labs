page 32 (
    name: Depositos Faturas- Pagamentos
    title: Depositos Faturas - Pagamentos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function getMoney( str )
            {
                    return parseInt( str.replace(/[\D]+/g,'') );
            }
            
            function fnc_somadepositos()
            {
              vvalor = 0;
              for(i=0;i<document.wwv_flow.length;i++)
              {
                if ( isNaN(parseFloat(document.wwv_flow.f08[i].value) ))
                {
                  void(0);
                }
                else
                { 
                   valor = document.wwv_flow.f08[i].value;
                   valor = valor.replace(".","");
                   valor = valor.replace(",",".");
                   valor = parseFloat(valor);
                   valor = getMoney( document.wwv_flow.f08[i].value)
                 vvalor = parseFloat(vvalor)+parseFloat(valor);   
                }
                document.getElementById('P32_TOTAL').value =formatReal(  vvalor);
              }
            } 
            
            function formatReal( int )
            {
                    var tmp = int+'';
                    var neg = false;
                    if(tmp.indexOf("-") == 0)
                    {
                        neg = true;
                        tmp = tmp.replace("-","");
                    }
                    
                    if(tmp.length == 1) tmp = "0"+tmp
                
                    tmp = tmp.replace(/([0-9]{2})$/g, ",$1");
                    if( tmp.length > 6)
                        tmp = tmp.replace(/([0-9]{3}),([0-9]{2}$)/g, ".$1,$2");
                    
                    if( tmp.length > 9)
                        tmp = tmp.replace(/([0-9]{3}).([0-9]{3}),([0-9]{2}$)/g,".$1.$2,$3");
                
                    if( tmp.length > 12)
                        tmp = tmp.replace(/([0-9]{3}).([0-9]{3}).([0-9]{3}),([0-9]{2}$)/g,".$1.$2.$3,$4");
                    
                    if(tmp.indexOf(".") == 0) tmp = tmp.replace(".","");
                    if(tmp.indexOf(",") == 0) tmp = tmp.replace(",","0,");
                
                    return tmp;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region aviso (
        name: Aviso
        type: staticContent
        source {
            htmlCode: <b><font color="Red">Há depósitos duplicados nesta fatura!</font></b>
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from depositosdiarios_orig d
                   , pagamentosfornecedores p
                where p.idpgtoforn = d.idpgtoforn
                  and d.nrocomprovante is not null
                  and p.idpgtoforn = :P32_IDPGTOFORN
                having count(1) > 1
                group by p.idpgtoforn,p.idfornecedor ,p.dtvencimento,valordeposito, trunc(data),idrepresentante, d.nrocomprovante
                ```
        }
    )

    region depositar (
        name: Depositar
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDDEPOSITODIARIOS",
                "IDDEPOSITODIARIOS" IDDEPOSITODIARIOS_DISPLAY,
                "DATA",
                "IDREPRESENTANTE",
                "IDCONTABANC",
                "IDPGTOFORN",
                "VALORDEPOSITO",
                "NROCOMPROVANTE",
                "OBSERVACAO",
                "TIPO",
                "IDCHEQUE",
                "IDPGTOFORN_ORIG",
                "IDDEPOSITODIARIOS_ORIG",
                "VALORORIGINAL",
                "REFERENTEA",
                "DESTINOSALDO",
                "CONTABILIZOU",
                "NROENVELOPE",
                "COMPROVADO",
                "IDFILIALFORNECEDOR",
                "TIPOPAGAMENTO",
                "IDVENCIMENTOABATIMENTO",
                "IDENTIFICACAO",
                "IDCONTROLELIGACAO",
                "IDUNIDADEDESTINO"
                from "#OWNER#"."DEPOSITOSDIARIOS"
                where 1 = 2
                ```
            pageItemsToSubmit: P32_IDFILIAL
        }
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: EFETUARDEPOSITO
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from pagamentosfornecedores
                where idpgtoforn     = :P32_IDPGTOFORN
                 /* and extract(year from dtvencimento) <= 2018*/
                  and tipopagamento not in ('B','M','T', 'R','A')
                ```
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
        }
        componentAdvanced {
            stripHtml: true
        }

