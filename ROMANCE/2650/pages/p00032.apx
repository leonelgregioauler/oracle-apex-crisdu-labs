    process efetuar-pagamento-de-boleto-do-dia (
        name: Efetuar Pagamento de Boleto do dia
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  insert into depositosdiarios ( iddepositodiarios  , data          , idrepresentante
                                               , idpgtoforn         , valordeposito , comprovado
                                               , tipo               , valororiginal , tipopagamento )
                  select seq_iddepositodiarios.nextval        , sysdate        , 49565
                       , p.idpgtoforn                         , p.valorpagar   , 'S'        
                       , decode(p.tipopagamento,'M','M','DD' ) , p.valorpagar   , p.tipopagamento
                  from pagamentosfornecedores p
                  where trunc(p.dtvencimento) = ( select trunc(dtvencimento) 
                                                  from pagamentosfornecedores
                                                  where idpgtoforn = :P32_IDPGTOFORN );
                  --
                  for a in ( select idpgtoforn
                              from pagamentosfornecedores p
                              where trunc(p.dtvencimento) = ( select trunc(dtvencimento) 
                                                              from pagamentosfornecedores
                                                              where idpgtoforn = :P32_IDPGTOFORN ))
                  loop
                    pck_romance.prc_atualiza_pagtoforn(a.idpgtoforn);
                  end loop;
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 196746605648000912
        }
        serverSideCondition {
            whenButtonPressed: @p32-baixarboletosdodia
        }
    )

    process efetuar-pagamento-de-boleto-mãos-transferencia-remessa (
        name: Efetuar Pagamento de Boleto/Mãos/Transferencia/Remessa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  insert into depositosdiarios ( iddepositodiarios  , data          , idrepresentante
                                               , idpgtoforn         , valordeposito , comprovado
                                               , tipo               , valororiginal , tipopagamento )
                  select seq_iddepositodiarios.nextval        , sysdate        , 49565
                       , p.idpgtoforn                         , p.valorpagar   , 'S'        
                       , decode(p.tipopagamento,'M','M','DD' ) , p.valorpagar   , p.tipopagamento
                  from pagamentosfornecedores p
                  where idpgtoforn = :P32_IDPGTOFORN;
                end;
