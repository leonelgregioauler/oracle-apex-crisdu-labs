    region pagamentos-efetuados (
        name: Pagamentos Efetuados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select iddepositodiarios
                     , data
                     , pck_romance.fnc_nomerepresentante(idrepresentante) Representante
                     , ( select initcap(cb.beneficiario)||'('||b.nomebanco||' - '||cb.agencia ||', '||cb.conta||' Cnpj:' ||cb.documento||')' 
                         from contasbancarias cb
                            , bancos b
                         where cb.idbanco         = b.idbanco
                           and cb.idcontabanc = d.idcontabanc ) "Conta Bancária"
                     , idpgtoforn
                     , valordeposito 
                     , decode(comprovado,'S','Sem Comprovante'
                                       ,'C','Cópia'
                                       ,'M','Em Mãos'
                                       ,'G', 'Com Gerente') comprovado
                     , nrocomprovante
                     , observacao
                     , ( select t.descricao
                         from tipospagamentos t
                         where t.codigo = d.tipo) Tipo
                     , referentea
                     , valororiginal
                     , destinosaldo "Destino do saldo"
                     , usuario
                     , datacriacao
                     , ( select identificacao
                         from identificacaodepositos i
                         where i.ididentificacao = d. identificacao ) identificacao
                     , pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(idrepresentante)) empresa
                     , ( select initcap(u.nome) 
                         from unidadesdenegocios u
                         where u.idunidadedenegocio = d.idunidadedestino ) unidadedestino
                from DEPOSITOSDIARIOS d
                where d.IDPGTOFORN =  :P32_IDPGTOFORN
                order by 1 desc
                ```
        }
        layout {
            sequence: 40
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--noBorder
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 31017139019618513
        }

