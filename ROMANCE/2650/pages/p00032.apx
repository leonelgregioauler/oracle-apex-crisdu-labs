        column IDVENCIMENTOABATIMENTO (
            reportColumnQueryId: 22
            derivedColumn: N
            type: selectList
            heading {
                heading: Abatimento
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nv.documento||' - '||vr.datavencimento display_value
                         , vr.idvencimento
                    from notasfiscais nv 
                       , vencimentosreceber vr
                    where nv.tiponota = 'V'
                      and nv.idnotafiscal        = vr.idnotafiscal
                      and nv.idfornecedordestino = ( select idfornecedor from pagamentosfornecedores where idpgtoforn = :P32_IDPGTOFORN)
                      and not exists ( select 1
                                       from depositosdiarios d
                                       where d.idvencimentoabatimento = vr.idvencimento )
                    order by vr.datavencimento
                    ```
                displayNullValue: false
            }
            layout {
                sequence: 24
            }
            serverSideCondition {
                type: never
            }
        )

