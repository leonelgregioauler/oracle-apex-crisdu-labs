        column IDREPRESENTANTE (
            reportColumnQueryId: 4
            derivedColumn: N
            type: selectList
            heading {
                heading: Distribuidor
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_romance.fnc_nomerepresentante(r.idrepresentante)||' '||decode(r.ativo,'S',' ','N',' - Inativo')||' - '||pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(idrepresentante))||'  ['|| r.idrepresentante ||']' display_value     , r.idrepresentante return_value 
                    from representantes r
                    where pck_romance.fnc_filialrepresentante(idrepresentante) = :P32_IDFILIAL 
                      and r.ativo = 'S'
                    order by pck_romance.fnc_nomerepresentante(r.idrepresentante)
                    ```
                displayExtraValues: false
                nullDisplayValue: - Selecione o Distribuidor -
            }
            layout {
                sequence: 5
            }
        )

