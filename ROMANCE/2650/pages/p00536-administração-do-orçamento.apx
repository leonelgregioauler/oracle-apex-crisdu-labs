page 536 (
    name: Administração do Orçamento
    alias: ADMINISTRAÇÃO-DO-ORÇAMENTO
    title: Administração do Orçamento
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region definições (
        name: Definições
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region gestão-orçamentária-detalhada (
        name: Gestão Orçamentária Detalhada
        type: interactiveGrid
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                return q'~
                select rownum seq_id,
                       v.idgestaoorcamentariaun, 
                       v.conta, 
                       v.subconta,
                       v.numero,
                       v.mes,
                       --
                       nvl(v.proposta,0) anterior, 
                       nvl(v.contraproposta,0) proposta, 
                       nvl(v.orcado,0) orcado,
                       --
                       --nvl(v.receitaanterior,0) receitaanterior, 
                       --nvl(v.receitaproposta,0) receitaproposta, 
                       --nvl(v.receitaorcamento,0) receitaorcamento,
                       --
                       v.idcomposicaoun_orc,
                       v.idcomposicaoun_pro,
                       v.nomeindicador,
                       v.status,
                       --
                       nvl((select sum(valor) 
                              from roman.vw_despesascentroscustos_m d
                             where d.ano = v.anoorcamento --v.anoreferencia
                               and d.mes = v.numero
                               and d.idgruponegocio     = v.idgruponegocio
                               and d.idunidadedenegocio = v.idunidadedenegocio
                               and d.idregra            = v.indicador
                               and d.idcontafinan       = v.idcontafinanceira
                               and d.idsubcontafinan    = v.idsubcontafinanceira ),0) as realizado 
                  from vw_gestaoorcamentaria_un v
                 where v.anoorcamento       = :P536_ANOORCAMENTO
                   and v.idgruponegocio     = :P536_IDGRUPONEGOCIO
                   and v.idunidadedenegocio = :P536_IDUNIDADEDENEGOCIO
                   and v.tipoorcamento      = :P536_TIPOORCAMENTO
                   and v.mesinicial         = :P536_MESINICIAL
                   and v.mesfinal           = :P536_MESFINAL
                ~';
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            htmlDomId: GOD
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <div style="font-family: Arial, sans-serif; font-size: 15px; color: #003366; text-align: left; padding: 10px; border: 1px solid #5b9bd5; background-color: #e6f0ff;">
                  <strong>Legenda:</strong> <br>
                  <strong>Saldo</strong> = Orçado - Realizado 
                
                </div>
                <br>
                ```
        }
        serverSideCondition {
            type: item=value
            item: P536_TIPOORCAMENTO
            value: A
        }
        customization {
            customizable: shownByDefault
        }
        edit {
            enabled: true
            allowedOperations: [
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                saveButton
            ]
        }
        enableUsersTo {
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 3131851408027338615
        }

