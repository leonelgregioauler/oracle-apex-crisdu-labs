    region gestão-orçamentária-sintetica (
        name: Gestão Orçamentária Sintetica
        type: interactiveGrid
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                return q'~
                select rownum seq_id,
                       v.idgestaoorcamentariaun, 
                       decode(v.indicador,'X','Imposto'
                                         ,'R','Rateio Indireto'
                                         ,'A','Rateio Direto'
                                         ,'C','Custos'
                                         ,'I','Investimentos'
                                         ,'T', 'Receitas'
                                         ,'D','Despesas') Indicador,
                       v.numero,
                       v.mes,
                       --
                       nvl(v.proposta,0) anterior, 
                       nvl(v.contraproposta,0) proposta, 
                       nvl(v.orcado,0) orcado,
                       --
                       --nvl(v.receitaanterior,0) receitaanterior, 
                       --nvl(v.receitaproposta,0) receitaproposta, 
                       --nvl(v.receitaorcamento,0) receitaorcamento,
                       --
                       v.idcomposicaoun_orc,
                       v.idcomposicaoun_pro,
                       r.valor as realizado,
                       v.status
                  from vw_gestaoorcamentaria_un v
                     , (  select charregra
                               , mes
                               , regra
                               , valor
                            from (
                                  select d.idregra charregra, 
                                         d.regra, 
                                         d.mes, 
                                         sum(d.valor) valor
                                    from vw_despesascentroscustos_m  d
                                       , filiais f
                                   where d.idregra         in ('C','D','X','I')
                                     and d.idunidadedenegocio = f.idunidadedenegocio
                                     and not exists ( select 1
                                                              from rateioscentroscustos rr
                                                             where rr.idcentrodecusto = d.idcentrodecusto
                                                               and rr.percentual is not null )
                                     and d.ano                = :P536_ANOORCAMENTO
                                     and d.idunidadedenegocio = :P536_IDUNIDADEDENEGOCIO
                                    group by d.idregra, 
                                             d.regra, 
                                             f.idunidadedenegocio,
                                             d.mes
                
                                  ---------
                                  UNION ALL
                                  ---------
                
                                  select charregra
                                       , regra
                                       , mes
                                       , rateio rateio_indireto
                                  from (
                                          select 'R' charregra
                                               , 'Rateio Indireto' regra
                                               , u.idunidadedenegocio
                                               , r.mes
                                               , sum(r.rateio) rateio 
                                          from unidadesdenegocios    u                            
                                             , gruposnegocios        g
                                             , resultado_grupo       r
                                          where u.idgruponegocio     = g.idgruponegocio
                                            and r.idunidadedenegocio = u.idunidadedenegocio
                                            and u.ativo              = 'S'
                                            and g.idgruponegocio     = :P536_IDGRUPONEGOCIO
                                            and u.idunidadedenegocio = :P536_IDUNIDADEDENEGOCIO
                                            and r.ano                = :P536_ANOORCAMENTO
                                            and r.rateio <> 0
                                          group by u.idunidadedenegocio
                                                 , u.nome 
                                                 , r.mes )
                
                                  ---------
                                  UNION ALL
                                  ---------
                                  select charregra
                                       , regra
                                       , mes
                                       , rateio_despesas rateio_direto
                                  from (
                                          select 'A' charregra
                                               , 'Rateio Direto' regra
                                               , u.idunidadedenegocio
                                               , r.mes
                                               , sum(r.rateio_despesa) rateio_despesas
                                          from unidadesdenegocios    u
                                             , gruposnegocios        g
                                             , resultado_grupo       r
                                          where u.idgruponegocio     = g.idgruponegocio
                                            and r.idunidadedenegocio = u.idunidadedenegocio
                                            and u.ativo              = 'S'
                                            and g.idgruponegocio     = :P536_IDGRUPONEGOCIO
                                            and u.idunidadedenegocio = :P536_IDUNIDADEDENEGOCIO
                                            and r.ano                = :P536_ANOORCAMENTO
                                            and r.rateio_despesa <> 0
                                          group by u.idunidadedenegocio
                                                 , u.nome 
                                                 , r.mes ) 
                                  ---------
                                  UNION ALL
                                  ---------
                                  select charregra
                                       , regra
                                       , mes
                                       , valor
                                  from (
                                          select 'T' charregra
                                               , 'Receitas' regra
                                               , u.idunidadedenegocio
                                               , r.idmes mes
                                               , sum(r.valor) valor
                                          from unidadesdenegocios    u
                                             , gruposnegocios        g
                                             , vw_receitascentroscustos_m r
                                          where u.idgruponegocio     = g.idgruponegocio
                                            and r.idunidadedenegocio = u.idunidadedenegocio
                                            and u.ativo              = 'S'
                                            and g.idgruponegocio     = :P536_IDGRUPONEGOCIO
                                            and u.idunidadedenegocio = :P536_IDUNIDADEDENEGOCIO
                                            and r.ano                = :P536_ANOORCAMENTO
                                          group by u.idunidadedenegocio
                                                 , u.nome 
                                                 , r.idmes ) ) ) r
                 where v.indicador = r.charregra(+)
                   and v.numero    = r.mes(+)
                   and v.anoorcamento       = :P536_ANOORCAMENTO
                   and v.idgruponegocio     = :P536_IDGRUPONEGOCIO
                   and v.idunidadedenegocio = :P536_IDUNIDADEDENEGOCIO
                   and v.tipoorcamento      = :P536_TIPOORCAMENTO
                   --and v.tipoclassificacao  = :P536_TIPOCLASSIFICACAO
                   and v.mesinicial         = :P536_MESINICIAL
                   and v.mesfinal           = :P536_MESFINAL;
                ~';
                ```
            pageItemsToSubmit: [
                P536_IDGRUPONEGOCIO
                P536_IDUNIDADEDENEGOCIO
                P536_ANOORCAMENTO
                P536_ANOREFERENCIA
                P536_TIPOORCAMENTO
                P536_MESINICIAL
                P536_MESFINAL
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <div style="font-family: Arial, sans-serif; font-size: 15px; color: #003366; text-align: left; padding: 10px; border: 1px solid #5b9bd5; background-color: #e6f0ff;">
                  <strong>Legenda:</strong> <br>
                  <strong>Saldo</strong> = Orçado - Realizado 
                
                </div>
                <br>
                ```
        }
        serverSideCondition {
            type: item=value
            item: P536_TIPOORCAMENTO
            value: S
        }
        customization {
            customizable: shownByDefault
        }
        edit {
            enabled: true
            allowedOperations: [
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                saveButton
            ]
        }
        download {
            formats: excel
            filename: gestaosintetica
        }
