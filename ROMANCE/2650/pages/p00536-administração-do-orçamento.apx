    process incluir-interactive-grid (
        name: Incluir Interactive Grid
        type: executeCode
        editableRegion: @gestão-orçamentária-detalhada
        source {
            plsqlCode:
                ```plsql
                BEGIN
                  --
                  IF :APEX$ROW_STATUS = 'C' THEN -- CREATE
                    --
                    --raise_application_error(-20001,'id ' || :IDGESTAOORCAMENTARIAUN );
                
                    insert into gestaoorcamentariaun (idgestaoorcamentariaun,
                                                              idunidadedenegocio,
                                                              idgruponegocio,
                                                              idcontafinanceira,
                                                              idsubcontafinanceira,
                                                              anoorcamento,
                                                              anoreferencia,
                                                              tipoclassificacao,
                                                              tipoorcamento,
                                                              usuario,
                                                              mesinicial,
                                                              mesfinal,
                                                              valoranoanterior,
                                                              valorproposta,
                                                              valororcamento,
                                                              dataorcamento,
                                                              indicador,
                                                              receitaanterior,
                                                              receitaproposta,
                                                              receitaorcamento)
                                                              
                                values ( seq_idgestaoorcamentariaun.nextval 
                                       , :P536_IDUNIDADEDENEGOCIO
                                       , :P536_IDGRUPONEGOCIO
                                       , :IDCONTAFINAN
                                       , desp.idsubcontafinan
                                       , panoorcamento
                                       , panoreferencia
                                       , ptipoclassificacao
                                       , ptipoorcamento
                                       , pusuario
                                       , pmesinicio
                                       , pmesfim
                                       , desp.valor
                                       , 0 --desp.valor
                                       , 0
                                       , sysdate
                                       , desp.idregra
                                       , 0,0,0 );
                
                
                
                
                    delete from roman.composicaoorcamentariaun o 
                    where o.idgestaoorcamentariaun = :IDGESTAOORCAMENTARIAUN; 
                
                    delete from roman.gestaoorcamentariaun g
                    where g.idgestaoorcamentariaun = :IDGESTAOORCAMENTARIAUN ;
                    --
                  END IF;
                   
                  COMMIT;
                  
                END;
                ```
        }
        execution {
            sequence: 90
        }
        advanced {
            executionMappingIdentifier: 38618620011988545
        }
        serverSideCondition {
            type: never
        }
    )

