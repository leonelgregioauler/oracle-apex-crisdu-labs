    dynamicAction abre-iara (
        name: Abre Iara
        execution {
            sequence: 60
        }
        when {
            event: click
            selectionType: button
            button: @gerenciaroram
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                      --
                      :P536_TOKEN := RAWTOHEX(DBMS_CRYPTO.RANDOMBYTES(32));
                      --
                      insert into sso_tokens (token,
                                              username)
                             values (:P536_TOKEN,
                                     :APP_USER ) ;
                    end;
                    ```
                itemsToReturn: P536_TOKEN
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var v_tipo       = $v('P536_TIPOORCAMENTO');
                    var v_idgrupo    = $v('P536_IDGRUPONEGOCIO');
                    var v_idunidade  = $v('P536_IDUNIDADEDENEGOCIO');
                    var v_periodo    = $v('P536_ANOORCAMENTO');
                    var v_mesinicial = $v('P536_MESINICIAL');
                    var v_mesfinal   = $v('P536_MESFINAL');
                    var v_usufinan   = $v('P536_USUARIOFINAN');
                    var v_token      = $v('P536_TOKEN');
                    var v_gestor     = $v('P536_GESTORFRANQUIA');
                    
                    //alert('valor v_gestor= ' + v_gestor);
                    
                    var baseUrl = 'https://gestaoorcamentaria.crisdulabs.com.br/?';
                    var url = baseUrl + //endpoint +
                        'p_gn='           + v_idgrupo    +
                        '&p_un='          + v_idunidade  +
                        '&p_permissao='   + v_usufinan   +
                        '&p_mes_inicial=' + v_mesinicial +
                        '&p_mes_final='   + v_mesfinal   +
                        '&v_tipo='        + v_tipo       +
                        '&p_ano='         + v_periodo    +
                        '&p_token='       + v_token      +
                        '&p_gestor='      + v_gestor;
                        
                    window.open(url, '_blank');
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

