    process aplica-percentual (
        name: Aplica Percentual
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                
                 MERGE INTO contrapropostasorcamentosmes c
                 USING (select g.idgestaoorcamentaria
                             , p.janeiro
                             , p.fevereiro
                             , p.marco
                             , p.abril
                             , p.maio
                             , p.junho
                             , p.julho
                             , p.agosto
                             , p.setembro
                             , p.outubro
                             , p.novembro
                             , p.dezembro
                          from gestaoorcamentaria     g
                             , propostasorcamentosmes p
                         where g.idcentrodecusto = :P536_IDCENTRODECUSTO
                           and g.idgestaoorcamentaria = p.idgestaoorcamentaria 
                           and g.vigencia   = (select vigencia 
                                                 from gestaoorcamentaria
                                                where idgestaoorcamentaria = :P536_IDGESTAOORCAMENTARIA)
                           and g.mesinicial = (select mesinicial
                                                 from gestaoorcamentaria
                                                where idgestaoorcamentaria = :P536_IDGESTAOORCAMENTARIA)
                           and g.mesfinal   = (select mesfinal
                                                 from gestaoorcamentaria
                                                where idgestaoorcamentaria = :P536_IDGESTAOORCAMENTARIA)            
                       ) pd
                  ON (c.idgestaoorcamentaria = pd.idgestaoorcamentaria)
                 WHEN MATCHED THEN
                 UPDATE SET c.janeiro   = pd.janeiro   + ( pd.janeiro   * :P536_PERCENTUAL_PREVISTO /100)
                          , c.fevereiro = pd.fevereiro + ( pd.fevereiro * :P536_PERCENTUAL_PREVISTO /100)
                          , c.marco     = pd.marco     + ( pd.marco     * :P536_PERCENTUAL_PREVISTO /100)
                          , c.abril     = pd.abril     + ( pd.abril     * :P536_PERCENTUAL_PREVISTO /100)
                          , c.maio      = pd.maio      + ( pd.maio      * :P536_PERCENTUAL_PREVISTO /100)
                          , c.junho     = pd.junho     + ( pd.junho     * :P536_PERCENTUAL_PREVISTO /100)
                          , c.julho     = pd.julho     + ( pd.julho     * :P536_PERCENTUAL_PREVISTO /100)
                          , c.agosto    = pd.agosto    + ( pd.agosto    * :P536_PERCENTUAL_PREVISTO /100)
                          , c.setembro  = pd.setembro  + ( pd.setembro  * :P536_PERCENTUAL_PREVISTO /100)
                          , c.outubro   = pd.outubro   + ( pd.outubro   * :P536_PERCENTUAL_PREVISTO /100)
                          , c.novembro  = pd.novembro  + ( pd.novembro  * :P536_PERCENTUAL_PREVISTO /100)
                          , c.dezembro  = pd.dezembro  + ( pd.dezembro  * :P536_PERCENTUAL_PREVISTO /100); 
                
                END;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Percentual Aplicado
        }
        advanced {
            executionMappingIdentifier: 1801224927702688980
        }
        serverSideCondition {
            type: request=Value
            value: APLICAR_PERCENTUAL
        }
    )

    process copiar-anoanterior (
        name: Copiar_AnoAnterior
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                
                 MERGE INTO composicaoorcamentariaun o
                 USING (select g.idgestaoorcamentariaun
                             , p.janeiro
                             , p.fevereiro
                             , p.marco
                             , p.abril
                             , p.maio
                             , p.junho
                             , p.julho
                             , p.agosto
                             , p.setembro
                             , p.outubro
                             , p.novembro
                             , p.dezembro
                          from gestaoorcamentariaun     g
                             , composicaoorcamentariaun p
                         where g.idgestaoorcamentariaun = p.idgestaoorcamentariaun
                           and g.anoorcamento       = :P536_ANOORCAMENTO
                           and g.idgruponegocio     = :P536_IDGRUPONEGOCIO
                           and g.idunidadedenegocio = :P536_IDUNIDADEDENEGOCIO
                           and g.tipoorcamento      = :P536_TIPOORCAMENTO
                           and p.tipoorcamento      = 'A' -- Anterior
                       ) pd
                
                   ON ( o.idgestaoorcamentariaun = pd.idgestaoorcamentariaun and
                        o.tipoorcamento      = 'P'  )
                
                 WHEN MATCHED THEN
                 UPDATE SET o.janeiro   = (case when o.janeiro   = 0 then pd.janeiro   else o.janeiro   end)
                          , o.fevereiro = (case when o.fevereiro = 0 then pd.fevereiro else o.fevereiro end)
                          , o.marco     = (case when o.marco     = 0 then pd.marco     else o.marco     end)
                          , o.abril     = (case when o.abril     = 0 then pd.abril     else o.abril     end)
                          , o.maio      = (case when o.maio      = 0 then pd.maio      else o.maio      end)
                          , o.junho     = (case when o.junho     = 0 then pd.junho     else o.junho     end)
                          , o.julho     = (case when o.julho     = 0 then pd.julho     else o.julho     end)
                          , o.agosto    = (case when o.agosto    = 0 then pd.agosto    else o.agosto    end)
                          , o.setembro  = (case when o.setembro  = 0 then pd.setembro  else o.setembro  end)
                          , o.outubro   = (case when o.outubro   = 0 then pd.outubro   else o.outubro   end)
                          , o.novembro  = (case when o.novembro  = 0 then pd.novembro  else o.novembro  end)
                          , o.dezembro  = (case when o.dezembro  = 0 then pd.dezembro  else o.dezembro  end) ; 
                  --
                  COMMIT;
                  --
                END;
                ```
