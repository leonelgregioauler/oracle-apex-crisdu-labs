        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function fnc_popup_prod()
            {vid = document.getElementById("P11_IDPRODUTO").value;
            vjanela = window.open('f?p=&APP_ID.:289:&SESSION.::NO::P289_IDPRODUTO:'+vid ,'PRECOS', 'toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,resizable=no,width=600,height=800,left=150,top=100','_blank');
            vjanela.focus();
             void(0);
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region cadastro-de-produtos (
        name: Cadastro de Produtos
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
    )

    region classificação-do-produto (
        name: Classificação do Produto
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idclassificacaoproduto 
                     , descricao
                     , data
                     , observacao
                     , ( select pck_romance.fnc_nomepessoa(idpessoa)
                         from usuarios u
                         where u.idusuario = c.idusuario ) usuario
                from classificacoesprodutos c
                   , caracteristicasprodutos cp
                where c.idproduto = :P11_IDPRODUTO
                  and c.idcaracteristicaproduto = cp.idcaracteristicaproduto
                order by 1
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent11
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('APP_USER') in ('GUILHERME','TATIANA','EVERTON','NEIDI','ELISIANEM','SARAK','OSIELF','JESSICAALTHAUS','DEBORAC','FRANCIELEBRITO','RAMILEDENTE','ANDREPESSOA','BRUNOB')
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma classificação para este produto
        }
        advanced {
            savedReportMappingIdentifier: 1596480090946415950
        }

        column DATA (
            type: plainText
            heading {
                heading: Classificado Em
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column DESCRICAO (
            type: plainText
            heading {
                heading: Classificação
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

