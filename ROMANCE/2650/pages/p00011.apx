    pageItem P11_IDCATEGORIA (
        type: selectList
        label {
            label: Categoria
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select NOME display_value, IDCATEGORIA return_value 
                from CATEGORIAS
                where ativo = 'S'
                and :P11_IDPRODUTO is null
                
                union all
                
                select NOME display_value, IDCATEGORIA return_value 
                from CATEGORIAS
                where ativo = 'S'
                and INSTR(',' || (select valor from parametros where nome = 'LIBERA_EDICAO_CATEGORIA'
                                  and idfilial = pck_romance.fnc_filialusuario(v('APP_USER'))) || ',', ','||v('APP_USER')||',') > 0
                and :P11_IDPRODUTO is not null
                
                union all
                
                select NOME display_value, IDCATEGORIA return_value 
                from CATEGORIAS
                where INSTR(',' || (select valor from parametros where nome = 'LIBERA_EDICAO_CATEGORIA'
                                    and idfilial = pck_romance.fnc_filialusuario(v('APP_USER'))) || ',', ','||v('APP_USER')||',') = 0
                and :P11_IDCATEGORIA = IDCATEGORIA
                order by 1;
                ```
            nullDisplayValue: - Informe a Categoria -
        }
        layout {
            sequence: 60
            region: @cadastro-de-produtos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDCATEGORIA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

