    dynamicAction venda-sim-ou-não (
        name: Venda sim ou não
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P11_VENDA
        }
        clientSideCondition {
            type: item=value
            item: P11_VENDA
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P11_KIT
                    P11_IDCARACTERISTICADETALHE
                    P11_IDCARACTERISTICACATEG
                    P11_ADULTOINFANTIL
                    P11_NOMEPROPRIO
                    P11_IDCARACTERISTICACATEGMAT
                    P11_SUGESTÃO
                    P11_CODIGOSISDIST
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P11_KIT
                    P11_IDCARACTERISTICADETALHE
                    P11_IDCARACTERISTICACATEG
                    P11_ADULTOINFANTIL
                    P11_NOMEPROPRIO
                    P11_IDCARACTERISTICACATEGMAT
                    P11_SUGESTÃO
                    P11_CODIGOSISDIST
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

