    process nome-produto (
        name: nome produto
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vNomeProduto varchar2(300) := null;
                begin 
                  --
                  select favorita.pck_util_fav.fnc_removecaracteresespeciais(
                                              decode(:P11_KIT,'S','Kit ') 
                                           ||  pck_romance.fnc_nomecategoria(:P11_IDCATEGORIA) ||' '
                                           || decode(:P11_IDCARACTERISTICADETALHE, null, null
                                                                                    , pck_romance.fnc_nomecaracteristica(:P11_IDCARACTERISTICADETALHE)||' ')
                                           || decode(:P11_ADULTOINFANTIL,'I','Infantil ') 
                                           || :P11_NOMEPROPRIO||' '
                                           || pck_romance.fnc_nomecaracteristica(:P11_IDCARACTERISTICACATEGMAT))
                  into vNomeProduto
                  from dual;
                  --
                  vNomeProduto := upper(substr(vNomeProduto,1,1)) || lower(substr(vNomeProduto,2));
                  --
                  :P11_NOMEPRODUTO := vNomeProduto;
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 1010843715091551761
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P11_NOMEPRODUTO is null
                  and :P11_VENDA = 'S'
                ```
        }
    )

