    validation p11-nomeproduto (
        name: P11_NOMEPRODUTO
        execution {
            sequence: 70
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                /*select 1
                from produtos
                where NOMEPRODUTO = :P11_NOMEPRODUTO
                */
                
                
                select 1
                  from produtos p
                 where favorita.pck_util_fav.fnc_removecaracteresespeciais(upper(replace(p.nomeproduto,' ',''))) = favorita.pck_util_fav.fnc_removecaracteresespeciais(upper(replace(:P11_NOMEPRODUTO,' ','')));
                ```
        }
        error {
            errorMessage: Este produto já está cadastrado!
            displayLocation: inlineInNotification
            associatedItem: @P11_NOMEPRODUTO
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

