    process referencia (
        name: referencia
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Created on 16/03/2012 by EVERTON 
                declare 
                  -- Local variables here
                  i integer;
                  vcodcategoria  varchar2(10);
                  vcodproduto    varchar2(10);
                  vidcategoria   number := v('P11_IDCATEGORIA');
                begin
                  -- Test statements here
                  select c.referencia
                  into vcodcategoria
                  from categorias c
                  where c.idcategoria  = vidcategoria;
                  --
                  select max(to_number(p.codigosisdist)) + 1
                  into vcodproduto
                  from produtos p
                  where substr(codigosisdist,1,2) = vcodcategoria;-- idcategoria = vidcategoria;
                  --
                  if vcodproduto is null then
                    :P11_CODIGOSISDIST := vcodcategoria || '000';
                  else
                    :P11_CODIGOSISDIST := vcodproduto;
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 358349416773164834
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P11_CODIGOSISDIST IS NULL
                  and :P11_IDCATEGORIA IS NOT NULL
                ```
        }
    )

