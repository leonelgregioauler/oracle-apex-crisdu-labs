            }
            layout {
                sequence: 1
            }
        )

        column IDFORNECEDOR (
            reportColumnQueryId: 3
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Fornecedor
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_romance.fnc_nomepessoa(f.idpessoa) display_value
                         , f.idfornecedor return_value
                    from fornecedores f
                    where f.ativo = 'S'
                    order by 1
                    ```
                displayNullValue: false
            }
            layout {
                sequence: 4
            }
            appearance {
                width: 30
            }
        )

