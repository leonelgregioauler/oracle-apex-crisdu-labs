    region fornecedores (
        name: Fornecedores
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDFORNECEDORPRODUTO",
                "IDFORNECEDORPRODUTO" IDFORNECEDORPRODUTO_DISPLAY,
                "IDFORNECEDOR",
                "IDPRODUTO",
                precocusto
                , observacao
                , ncm
                from "#OWNER#"."FORNECEDORESPRODUTOS"
                where idproduto = :P11_IDPRODUTO
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_IDPRODUTO
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (nulo)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Dados não encontrados.
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 8
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Selecionar Linha
