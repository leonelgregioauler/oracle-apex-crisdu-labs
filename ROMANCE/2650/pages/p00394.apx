    pageItem P394_IDCONTABANCARIA (
        type: selectList
        label {
            label: Conta Bancária
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(cb.beneficiario,p.apelido)||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||') - Fornecedor: '||initcap(p.nomepessoa) display_value
                     , cb.idcontabanc    return_value
                from contasbancarias cb
                   , bancos b
                   , pessoas p
                   , fornecedores f
                where cb.idbanco      = b.idbanco
                  and cb.idpessoa     = p.idpessoa
                  and f.idpessoa      = p.idpessoa
                  and f.idfornecedor  = :P394_IDFORNECEDOR
                  and cb.ativo        = 'S'
                order by 1
                ```
            nullDisplayValue: Selecione a Conta
        }
        cascadingLov {
            parentItems: P394_IDFORNECEDOR
        }
        layout {
            sequence: 90
            region: @iniciar-lançamento
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

