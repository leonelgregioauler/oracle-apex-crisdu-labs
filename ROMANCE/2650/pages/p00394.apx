page 394 (
    name: Adicionar Rateio
    title: Adicionar Rateio
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 70%
        height: 50%
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region iniciar-lançamento (
        name: Iniciar Lançamento
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region rateios-da-fatura (
        name: Rateios da Fatura
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.idrateionotafiscal
                     , r.documento
                     , r.idfornecedor
                     , r.idrazaosocialfornecedor
                     , r.idfilialdestino
                     , r.idrazaosocialdestino
                     , r.formapagamento
                     , r.idcontapagamento
                     , r.datavencimento
                     , r.valor
                     , r.idmatrizdespesa
                     , r.observacao
                     , r.idlancamentodiverso
                     , r.idnotafiscal
                     , r.usuario
                from rateiosnotasfiscais r
                where r.idnotafiscal is null
                ```
        }
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 4987138726175985354
        }

