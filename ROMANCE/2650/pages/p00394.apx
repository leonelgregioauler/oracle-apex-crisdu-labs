    dynamicAction tipo-transferencia (
        name: Tipo Transferencia
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P394_FORMAPAGAMENTO
        }
        clientSideCondition {
            type: item=value
            item: P394_FORMAPAGAMENTO
            value: T
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P394_IDCONTABANCARIA
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P394_IDCONTABANCARIA
            }
            execution {
                sequence: 10
            }
        )

    )

    process busca-dados (
        name: Busca Dados
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidfornecedor         number;
                  vidrazaosocialforn    number;
                  vidfilialdestino      number;
                  vidrazaosocialdestino number;
                  vdocumento            varchar2(40);
                  vdatavencimento       date;
                  vformapagamento       varchar2(1);
                  vidcontapagamento     number;
                  vantecipacao          varchar2(1);
                  vobservacao           varchar2(4000);
                  vidlancamentodiverso  number;
                begin
                  --
                  select l.idfornecedoremitente
                       , l.idrazaosocialemitente
                       , l.idfilialdestino
                       , l.idrazaosocialdestino
                       , l.documento
                       , l.datavencimento
                       , l.formapagamento
                       , l.idcontapagamento
                       , l.antecipacao
                       , l.observacao
                       , l.idlancamentodiverso
                  into vidfornecedor         
                     , vidrazaosocialforn    
                     , vidfilialdestino      
                     , vidrazaosocialdestino 
                     , vdocumento            
                     , vdatavencimento       
                     , vformapagamento       
                     , vidcontapagamento     
                     , vantecipacao    
                     , vobservacao     
                     , vidlancamentodiverso 
                  from lancamentosdiversos l 
                  where l.idnotafiscalgerada = :P394_IDNOTAFISCAL;
                  --
                  :P394_IDFORNECEDOR := vidfornecedor;
                  :P394_IDRAZAOSOCIALFORN := vidrazaosocialforn;
                  :P394_IDFILIALDESTINO := vidfilialdestino;
                  :P394_IDRAZAOSOCIALDESTINO := vidrazaosocialdestino;
                  :P394_DOCUMENTO := vdocumento;
                  :P394_VENCIMENTO := vdatavencimento;
                  :P394_FORMAPAGAMENTO := vformapagamento;
                  :P394_IDCONTABANCARIA := vidcontapagamento;
                  :P394_ANTECIPACAO := vantecipacao;
                  :P394_OBSERVACAO := vobservacao;
                  :P394_IDLANCAMENTODIVERSO := vidlancamentodiverso;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 88158578268235511
        }
    )

    process finaliza-rateios (
