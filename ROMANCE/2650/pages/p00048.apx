page 48 (
    name: Valores Devidos
    title: Valores Devidos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region gráfico-de-valores-devidos (
        name: Gráfico de Valores Devidos
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select null link
                     , initcap(pes.apelido) label
                     , sum(pagforn.valorpagar) - sum(pagforn.valorpago) value
                from pagamentosfornecedores pagforn
                   , pessoas         pes
                   , cidades         cid
                   , fornecedores      forn
                   , notasfiscais    nf
                where forn.idpessoa       = pes.idpessoa
                  and pes.idcidade        = cid.idcidade
                  and forn.idfornecedor   = pagforn.idfornecedor
                  and pagforn.idnotafiscal = nf.idnotafiscal(+)  
                  and to_char(pagforn.dtvencimento,'RRRR') = 2011
                having sum(pagforn.valorpagar) - sum(pagforn.valorpago) > 0
                group by pes.apelido 
                order by 2
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        security {
            escapeSpecialChars: false
        }
        chart {
            type: pie
        }
        title {
            title: Gráfico de Valores Devidos
        }
        chartLayout {
            maxWidth: 700
            height: 500
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        value {
            format: decimal
            formatScaling: none
        }
        animation {
            onDataChange: none
        }
        legend {
            position: start
            hideAndShowBehavior: none
        }
        messages {
            whenNoDataFound: No data found.
        }

        series series (
            name: Series 1
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: "\"2\""
                value: "\"3\""
            }
            label {
                show: true
                position: outsideSlice
            }
            performance {
                maxRowsToProcess: 15
            }
        )

    )

)

