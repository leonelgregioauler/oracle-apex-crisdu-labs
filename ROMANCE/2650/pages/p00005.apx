page 5 (
    name: Crédito
    title: Crédito
    appearance {
        pageMode: nonModalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region crédito (
        name: Crédito
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select pck_romance.fnc_nomefornecedor(nc.idfornemitente)
                         from notasfiscais nc
                         where nc.idnotafiscal = nv.idnotafiscalcompra ) "Fornecedor"
                     , pck_romance.fnc_nomefornecedor(nv.idfornecedordestino) "Cliente"
                     , nv.documento
                     , vr.datavencimento
                     , vr.valor
                from notasfiscais nv 
                   , vencimentosreceber vr
                where nv.tiponota = 'V'
                  and nv.idnotafiscal     = vr.idnotafiscal
                  and to_char(vr.datavencimento,'MMRRRR') = :P5_SEMANANO
                  and not exists ( select 1 
                                   from depositosdiarios_orig d
                                   where d.idvencimentoabatimento = vr.idvencimento )
                  and exists ( select 1
                               from notasfiscais nc
                               where nc.idnotafiscal = nv.idnotafiscalcompra 
                                 and nc.idfornemitente = PCK_ROMANCE.fnc_fornecedorfilial(1061))
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 1000
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: no data found
        }
        breakFormatting {
            breakColumns: cols1-2
        }
        componentAdvanced {
            stripHtml: true
        }

        column Cliente (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Cliente
                alignment: center
            }
            layout {
                sequence: 2
            }
        )

        column DATAVENCIMENTO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Datavencimento
                alignment: center
            }
            layout {
                sequence: 4
            }
        )

        column DOCUMENTO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Documento
                alignment: center
            }
            layout {
                sequence: 3
            }
        )

        column Fornecedor (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Fornecedor
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column VALOR (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Valor
            }
            layout {
                sequence: 5
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            advanced {
                computeSum: true
            }
        )

    )

    pageItem P5_SEMANANO (
        type: textField
        label {
            label: Semana
            alignment: left
        }
        layout {
            sequence: 10
            region: @crédito
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 8
        }
        advanced {
            customAttributes: readonly
        }
        security {
            encryptSessionState: false
        }
    )

)

