page 442 (
    name: Cancelar/Reverter Nota Fiscal
    alias: CANCELAR-NOTA-FISCAL
    title: Cancelar/Reverter Nota Fiscal
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1500
        height: 800
        resizable: false
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            // Apos cancelar/reverter (P442_CONCLUIDO = S): recarrega a janela principal (485) inteira,
            // como um F5 - fecha as modais (490/442) e a 485 volta com os mesmos filtros e valores atualizados.
            if ($v("P442_CONCLUIDO") === "S") {
                window.top.location.reload();
            } else {
                // Cancelar/Reverter: valida, desabilita os botoes e envia uma unica vez (evita duplo clique).
                // A cada abertura/recarga da pagina os botoes voltam habilitados.
                var enviando = false;
                var enviar = function (request) {
                    if (enviando || !apex.page.validate()) {
                        return;
                    }
                    enviando = true;
                    $(".js-nf-cancelar, .js-nf-reverter, .js-nf-voltar").prop("disabled", true).addClass("apex_disabled");
                    apex.page.submit({ request: request, showWait: true, validate: false });
                };
                // Selecao por classe CSS (independe do id gerado para os botoes)
                $(".js-nf-cancelar").on("click", function () { enviar("CANCELAR_NOTAFISCAL"); });
                $(".js-nf-reverter").on("click", function () { enviar("REVERTER_CANCELAMENTO"); });
            }
            ```
    }

    region cancelar-reverter-nota-fiscal (
        name: Cancelar/Reverter Nota Fiscal
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region histórico-de-cancelamentos-e-reversões (
        name: Histórico de Cancelamentos e Reversões
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.datainclusao
                     , case m.tipomovimentacao
                         when 'C' then 'Cancelamento'
                         when 'R' then 'Reversão'
                       end                                   as tipomovimentacao
                     , sa.descricao                          as situacaoanterior
                     , sn.descricao                          as situacaonova
                     , m.valortotalnotaanterior
                     , m.valortotalnotanovo
                     , m.motivo
                     , m.usuarioinclusao
                from roman.movimentacoesnotasfiscais m
                left join crisdu.situacoesnotasfiscais sa on sa.idsituacaonotafiscal = m.idsituacaoanterior
                left join crisdu.situacoesnotasfiscais sn on sn.idsituacaonotafiscal = m.idsituacaonova
                where m.idnotafiscal = :P442_IDNOTAFISCAL
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.movimentacoesnotasfiscais m
                where m.idnotafiscal = :P442_IDNOTAFISCAL
                ```
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma movimentação registrada para esta nota.
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 2650442000000011
        }

        column DATAINCLUSAO (
            type: plainText
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: A
            }
        )

        column MOTIVO (
            type: plainText
            heading {
                heading: Motivo
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column SITUACAOANTERIOR (
            type: plainText
            heading {
                heading: Situação Anterior
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column SITUACAONOVA (
            type: plainText
            heading {
                heading: Situação Nova
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column TIPOMOVIMENTACAO (
            type: plainText
            heading {
                heading: Movimentação
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column USUARIOINCLUSAO (
            type: plainText
            heading {
                heading: Usuário
                alignment: center
            }
            layout {
                sequence: 80
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column VALORTOTALNOTAANTERIOR (
            type: plainText
            heading {
                heading: Valor Anterior
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column VALORTOTALNOTANOVO (
            type: plainText
            heading {
                heading: Valor Novo
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 2650442 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAINCLUSAO (
                sequence: 1
            )

            displayColumn MOTIVO (
                sequence: 7
            )

            displayColumn SITUACAOANTERIOR (
                sequence: 3
            )

            displayColumn SITUACAONOVA (
                sequence: 4
            )

            displayColumn TIPOMOVIMENTACAO (
                sequence: 2
            )

            displayColumn USUARIOINCLUSAO (
                sequence: 8
            )

            displayColumn VALORTOTALNOTAANTERIOR (
                sequence: 5
            )

            displayColumn VALORTOTALNOTANOVO (
                sequence: 6
            )

            sort (
                column: DATAINCLUSAO
                sort {
                    direction: desc
                    sequence: 1
                }
            )

        )

    )

    pageItem P442_CONCLUIDO (
        type: hidden
        layout {
            sequence: 50
            region: @cancelar-reverter-nota-fiscal
            slot: regionBody
        }
    )

    pageItem P442_IDNOTAFISCAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @cancelar-reverter-nota-fiscal
            slot: regionBody
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
    )

    pageItem P442_IDSITUACAO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @cancelar-reverter-nota-fiscal
            slot: regionBody
        }
    )

    pageItem P442_MOTIVOCANCELAMENTO (
        type: textarea
        label {
            label: Motivo do Cancelamento
            alignment: left
        }
        layout {
            sequence: 30
            region: @cancelar-reverter-nota-fiscal
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            width: 800
            height: 8
        }
        validation {
            valueRequired: true
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        readOnly {
            type: item=value
            item: P442_IDSITUACAO
            value: -1
        }
    )

    pageItem P442_MOTIVOREVERSAO (
        type: textarea
        label {
            label: Motivo da Reversão
            alignment: left
        }
        layout {
            sequence: 40
            region: @cancelar-reverter-nota-fiscal
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            width: 800
            height: 8
        }
        validation {
            valueRequired: true
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        serverSideCondition {
            type: item=value
            item: P442_IDSITUACAO
            value: -1
        }
    )

    button cancelar-notafiscal (
        buttonName: CANCELAR_NOTAFISCAL
        label: Cancelar Nota Fiscal
        layout {
            sequence: 10
            region: @cancelar-reverter-nota-fiscal
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            cssClasses: js-nf-cancelar
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: item!=value
            item: P442_IDSITUACAO
            value: -1
        }
    )

    button reverter-cancelamento (
        buttonName: REVERTER_CANCELAMENTO
        label: Reverter Cancelamento
        layout {
            sequence: 20
            region: @cancelar-reverter-nota-fiscal
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            cssClasses: js-nf-reverter
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: item=value
            item: P442_IDSITUACAO
            value: -1
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @cancelar-reverter-nota-fiscal
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            cssClasses: js-nf-voltar
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction voltar-fechar-dialog (
        name: Voltar - Fechar Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @voltar
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process cancelar-nota-fiscal (
        name: Cancelar Nota Fiscal
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    roman.pck_financeiro_rmc.prc_cancelanotafiscal( pidnotafiscal => :P442_IDNOTAFISCAL
                                                                  , pmotivo       => :P442_MOTIVOCANCELAMENTO
                                                                  , pusuario      => :APP_USER );
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Nota fiscal cancelada.
        }
        advanced {
            executionMappingIdentifier: 1807604939125298626
        }
        serverSideCondition {
            whenButtonPressed: @cancelar-notafiscal
        }
    )

    process marca-concluido (
        name: Marca Concluido
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    -- Ao recarregar, o JavaScript da pagina recarrega a 485 (janela principal)
                    :P442_CONCLUIDO := 'S';
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 2650442000000006
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CANCELAR_NOTAFISCAL,REVERTER_CANCELAMENTO
        }
    )

    process reverter-cancelamento-nota-fiscal (
        name: Reverter Cancelamento Nota Fiscal
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    roman.pck_financeiro_rmc.prc_revertecancelamentonota( pidnotafiscal => :P442_IDNOTAFISCAL
                                                                        , pmotivo       => :P442_MOTIVOREVERSAO
                                                                        , pusuario      => :APP_USER );
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Cancelamento da nota fiscal revertido.
        }
        advanced {
            executionMappingIdentifier: 2650442000000003
        }
        serverSideCondition {
            whenButtonPressed: @reverter-cancelamento
        }
    )

    branch (
        name: Recarrega 442 para fechar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 442
                successMessage: false
            }
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CANCELAR_NOTAFISCAL,REVERTER_CANCELAMENTO
        }
    )

)

