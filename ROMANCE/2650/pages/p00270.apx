page 270 (
    name: Histórico de Ligações
    title: Histórico de Ligações
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region histórico-de-ligações (
        name: Histórico de Ligações
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select * from historicoligacoes
                where idcontroleligacoes = :P270_IDCONTROLE 
                ```
        }
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: -
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 352720629856742095
        }

        column DATA (
            type: plainText
            heading {
                heading: "Data "
                alignment: center
            }
            layout {
                sequence: 3
            }
            appearance {
                formatMask: DD/MM/YYYY HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                htmlDomId: DATA
                endUserAlias: C
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDCONTROLELIGACOES (
            type: hidden
            heading {
                heading: Idcontroleligacoes
            }
            layout {
                sequence: 2
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDCONTROLELIGACOES
                endUserAlias: B
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDHISTORICOLIGACOES (
            type: hidden
            heading {
                heading: Idhistoricoligacoes
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDHISTORICOLIGACOES
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column OBSERVACAO (
            type: plainText
            heading {
                heading: Observação
                alignment: center
            }
            singleRowView {
                useColumnHeading: false
                label: Observação
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: OBSERVACAO
                endUserAlias: E
            }
            enableUsersTo {
                pivot: false
            }
        )

        column USUARIO (
            type: plainText
            heading {
                heading: Usuário
                alignment: center
            }
            singleRowView {
                useColumnHeading: false
                label: Usuário
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: USUARIO
                endUserAlias: D
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 3533016 (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn DATA (
                sequence: 3
            )

            displayColumn IDCONTROLELIGACOES (
                sequence: 2
            )

            displayColumn IDHISTORICOLIGACOES (
                sequence: 1
            )

            displayColumn OBSERVACAO (
                sequence: 5
            )

            displayColumn USUARIO (
                sequence: 4
            )

            sort (
                column: DATA
                sort {
                    sequence: 1
                }
            )

        )

    )

    pageItem P270_IDCONTROLE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            slot: legacyOrphanComponents
        }
        security {
            encryptSessionState: false
        }
    )

    button p270-fechar (
        buttonName: P270_FECHAR
        label: Fechar
        layout {
            sequence: 20
            region: @histórico-de-ligações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: window.close();
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: P270_FECHAR
        }
    )

    button p270-incluirhistorico (
        buttonName: P270_INCLUIRHISTORICO
        label: Incluir Histórico
        layout {
            sequence: 30
            region: @histórico-de-ligações
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 271
                items: {
                    P271_IDCONTROLELIGACOES: &P270_IDCONTROLE.
                    P271_IDHISTORICOLIGACOES:
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: P270_INCLUIRHISTORICO
        }
    )

)

