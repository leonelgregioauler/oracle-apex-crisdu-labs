    pageItem P448_CONTADEPOSITO (
        type: selectList
        label {
            label: Conta Para Depósito/Transf.
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(cb.beneficiario,p.apelido)||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||') - Fornecedor: '||initcap(p.nomepessoa) display_value
                     , cb.idcontabanc  return_value
                from contasbancarias cb
                   , bancos b
                   , pessoas p
                   , fornecedores f
                where cb.idbanco      = b.idbanco
                  and cb.idpessoa     = p.idpessoa
                  and f.idpessoa      = p.idpessoa
                  and f.idfornecedor  = :P448_IDFORNECEDOR
                  and cb.ativo        = 'S'
                
                ```
        }
        cascadingLov {
            parentItems: P448_IDFORNECEDOR
        }
        layout {
            sequence: 280
            region: @lançamento-requisição-pagamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

