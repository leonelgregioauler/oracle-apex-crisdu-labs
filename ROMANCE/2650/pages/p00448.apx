    process atualiza-situação (
        name: Atualiza Situação
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 --
                 vvalida number ;
                 vtestep number ;
                 vtester number ;
                 --
                begin
                  --
                  if v('REQUEST') = 'FINALIZAR_FISCAL' then
                    --
                    -- Projeto fluxo paralelo Fiscal x Financeiro: promove a situa¿¿o conforme
                    -- o estado anterior do financeiro. Tabela de transi¿¿es (ver doc ¿5.2):
                    --   2 (Atend.Financ.) -> 5 (Conclu¿do Fiscal)
                    --   3 (Atend.Fiscal legado) -> 5 (Conclu¿do Fiscal)
                    --  10 (Prog-Fiscal Pend) -> 6 (Programado)
                    --  11 (Prog-Ajuste Fiscal) -> 6 (Programado)
                    --  12 (Quit-Fiscal Pend) -> 7 (Quitado)
                    --  13 (Quit-Ajuste Fiscal) -> 7 (Quitado)
                    update roman.requisicoespagamentos rp
                       set rp.datafinalizadofiscal    = sysdate
                         , rp.usuariofinalizadofiscal = v('APP_USER')
                         , rp.idsituacao = case rp.idsituacao
                                             when 2  then 5
                                             when 3  then 5
                                             when 10 then 6
                                             when 11 then 6
                                             when 12 then 7
                                             when 13 then 7
                                             else rp.idsituacao
                                           end
                    where rp.idrequisicaopgto = :P448_IDREQUISICAO;
                    --
                  elsif v('REQUEST') = 'ENVIAR_FINANCEIRO' and :P448_FISCAL = 'S' then
                    --
                    select vreq.vt - vparc.vp resultp , vreq.vt - vrat.vr resultrat
                      into vtestep , vtester
                    from ( select r.valortotal vt
                           from roman.requisicoespagamentos r
                           where r.idrequisicaopgto = :P448_IDREQUISICAO ) vreq
                           --
                       , ( select sum ( v.valor ) vp
                           from roman.vencimentosrequisicoes v
                           where v.idrequisicaopgto = :P448_IDREQUISICAO ) vparc
                           --
                       , ( select sum ( r.valor ) vr
                           from roman.rateiosrequisicoes r
                           where r.idrequisicaopgto = :P448_IDREQUISICAO ) vrat ;
                                                      -- raise_application_error(-20001,'Atenção !! Valor dos Rateios Diferente da Requisição. ' || nvl(vtester,0 )  );
                
                           update roman.requisicoespagamentos rq
                           set rq.dataenvio = sysdate
                             , rq.usuarioenvio = v('APP_USER')
                           where rq.idrequisicaopgto = :P448_IDREQUISICAO
                             and rq.dataenvio is null ; --Registra somente o primeiro envio.  
                           --
                           update roman.requisicoespagamentos rq
                           set rq.edicaobloqueada = 'S'
                           where rq.idrequisicaopgto = :P448_IDREQUISICAO ;                       
                           --
                           if nvl(vtestep,0 ) != 0 then
                             --
                             -- apex_application.g_print_success_message := '<span style="color : Black ">Atenção !! Valor das Parcelas Diferente da Requisição.  </span>';
                             raise_application_error(-20001, 'Atenção !! Valor das Parcelas Diferente da Requisição.');
                             --
                           elsif nvl(vtester,0 ) != 0 then
                             --
                             --apex_application.g_print_success_message := '<span style="color : Black ">Atenção !! Valor dos Rateios Diferente da Requisição.  </span>';   
                             raise_application_error(-20001,'Atenção !! Valor dos Rateios Diferente da Requisição.' );
                             --
                           else
                             --
                             -- Projeto fluxo paralelo (Op¿¿o A): com ou sem fiscal, a requisi¿¿o
                             -- vai para 2 (Atendimento Financeiro). O fiscal v¿ em paralelo pela
                             -- query FISCAL='S' AND DATAFINALIZADOFISCAL IS NULL.
                             update roman.requisicoespagamentos rp
                             set rp.idsituacao = 2
                             where rp.idrequisicaopgto = :P448_IDREQUISICAO;
                             --
                           end if;
                           --
                  elsif v('REQUEST') = 'ENVIAR_FINANCEIRO' then
                    --
                    select vreq.vt - vparc.vp resultp , vreq.vt - vrat.vr resultrat
                      into vtestep , vtester
                    from ( select r.valortotal vt
                           from roman.requisicoespagamentos r
                           where r.idrequisicaopgto = :P448_IDREQUISICAO ) vreq
                           --
                       , ( select sum ( v.valor ) vp
                           from roman.vencimentosrequisicoes v
                           where v.idrequisicaopgto = :P448_IDREQUISICAO ) vparc
                           --
                       , ( select round(sum ( r.valor ),2) vr
                           from roman.rateiosrequisicoes r
                           where r.idrequisicaopgto = :P448_IDREQUISICAO ) vrat ;
                                             -- raise_application_error(-20001,'Atenção !! Valor dos Rateios Diferente da Requisição. ' || nvl(vtester,0 )  );  -- posso usar desta forma quando gera o erro direto sem ter mais de uma opção.
                           --
                           update roman.requisicoespagamentos rq
                           set rq.dataenvio = sysdate
                             , rq.usuarioenvio = v('APP_USER')
                           where rq.idrequisicaopgto = :P448_IDREQUISICAO
                             and rq.dataenvio is null ; --Registra somente o primeiro envio.  
                           --
                           update roman.requisicoespagamentos rq
                           set rq.edicaobloqueada = 'S'
                           where rq.idrequisicaopgto = :P448_IDREQUISICAO ; 
                           --
                           if nvl(vtestep,0 ) != 0 then
                             --
                             --apex_application.g_print_success_message := '<span style="color : Black ">Atenção !! Valor das Parcelas Diferente da Requisição.  </span>';
                             raise_application_error(-20001, 'Atenção !! Valor das Parcelas Diferente da Requisição.');
                             --
                           elsif nvl(vtester,0 ) != 0 then
                             --
                             -- apex_application.g_print_success_message := '<span style="color : Black ">Atenção !! Valor dos Rateios Diferente da Requisição.  </span>';  
                             raise_application_error(-20001,'Atenção !! Valor dos Rateios Diferente da Requisição.' );
                             --
                           else
                             --
                             update roman.requisicoespagamentos rp
                             set rp.idsituacao = 2
                             where rp.idrequisicaopgto = :P448_IDREQUISICAO;
                             --
                           end if;
                           --
                  end if;
                 --
                 commit;
                 --
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Requisição enviada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 564727434189488805
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('FINALIZAR_FISCAL','ENVIAR_FINANCEIRO')
                ```
        }
    )

    process consulta-em-requisições (
        name: Consulta em requisições
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vvalor      number(15,2) := replace(:P448_VALOR ,'.','');
                  vacrecimo   number(15,2) := replace(:PP448_ACRECIMO,'.','');
                  vdesconto   number(15,2) := replace(:P448_DESCONTO ,'.','');
                  vvalortotal number(15,2) := replace(:P448_VALORTOTAL,'.','');
                  vdtinclusao date ;
                  vidsit      number;
                  venvio varchar2(20);
                  --
                begin
                 --
                 ROMAN.PCK_NOTASFISCAIS_RMC.PRC_REQUISICOESPAGAMENTOS(pidrequisicaopgto    => :P448_IDREQUISICAO
                                                                    , pidfilial            => :P448_FILIALORIGEM
                                                                    , pidformapagamento    => :P448_TIPODOC
                                                                    , pdocumento           => :P448_DOCUMENTO
                                                                    , pdatainclusao        => vdtinclusao
                                                                    , pdataemissao         => :P448_DATAEMISSAO
                                                                    , penvio               => :P448_ENVIO
                                                                    , pidsituacao          => :P448_SITUACAO
                                                                    , pusuarioinclusao     => :P448_USUARIOINCLUSAO
                                                                    , pusuarioaprovacao    => :P448_USUARIOAPROVACAO
                                                                    , pidfornecedor        => :P448_IDFORNECEDOR
                                                                    , pidfilialdestino     => :P448_UNIDADENEGOCIO
                                                                    , pidrazaosocialfornec => :P448_IDRAZAOFORNECEDOR
                                                                    , pidrazaosocialdest   => :P448_IDRAZAOSOCIALDESTINO
                                                                    , pidmatrizdespesa     => :P448_MATRIZ
                                                                    , pidgrupo             => :P448_GRUPO
                                                                    , pidrazaodestgrupo    => :P448_IDRAZAODESTGRUPO
                                                                    , pidcontabanc         => :P448_CONTADEPOSITO
                                                                    , pvalortotal          => vvalortotal
                                                                    , pvalor               => vvalor
                                                                    , pdesconto            => vdesconto
                                                                    , pvencimento          => :P448_VENCIMENTO
                                                                    , pacrescimo           => vacrecimo 
                                                                    , pantecipacao         => :P448_ANTECIPACAO
                                                                    , pfiscal              => :P448_FISCAL
                                                                    , pcomprovantepgto     => :P448_COMPROVANTEPGTO
                                                                    , pmotivoatraso        => :P448_MOTIVOATRASO
                                                                    , pparcelas            => :P448_QTDEPARCELAS
                                                                    , pdias                => :P448_DIASPRAZO
                                                                    , pfixadata            => :P448_FIXADATA
                                                                    , pobservacao          => :P448_OBSERVACAO
                                                                    , pajuste              => :P448_AJUSTESAREALIZAR
                                                                    , pedicao              => :P448_EDICAOBLOQUEADA
                                                                    , pidmoeda             => :P448_IDMOEDA
                                                                    , pconversao           => :P448_CONVERSAO
                                                                    , plinhadigitavel      => :P448_LINHADIGITAVEL
                                                                    , pmd5                 => :P448_MD5
                                                                    , poperacao_dml        => 'S' );
                  --
                  :P448_VALOR      := to_char(vvalor     ,'999G999G999G999G999G990D00'); 
                  :P448_ACRECIMO   := to_char(vacrecimo  ,'999G999G999G999G999G990D00'); 
                  :P448_DESCONTO   := to_char(vdesconto,'999G999G999G999G999G990D00'); 
                  :P448_DATAINCLUSAO := to_char(vdtinclusao,'DD/MM/RRRR HH24:MI:SS');
                  --:P448_VALORTOTAL := to_char(vvalortotal,'999G999G999G999G999G990D00'); 
                 -- :P448_VENCIMENTO := to_date(vvencimento,'DD/MM/RRRR HH24:MI:SS');
                  --
                end;
                
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 564726260298488804
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P448_IDREQUISICAO
        }
    )

    process duplica-requisicao (
        name: Duplica requisicao
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vusaurio varchar2(100) := v('APP_USER');
                  vidrequisicaonova number;
                  vidrequisicao number;
                begin
                  --
                  vidrequisicao := :P448_IDREQUISICAO;
                  --
                  pck_notasfiscais_rmc.prc_duplicarequisicao(pidrequisicao => vidrequisicao,
                                                             pusuario => vusaurio ,
                                                             pidrequisicaonew => vidrequisicaonova );
                  --
                  :P448_IDREQUISICAO := vidrequisicaonova ;
                  --
                end;
                ```
        }
        execution {
