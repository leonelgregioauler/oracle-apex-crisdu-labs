    pageItem P448_MATRIZ (
        type: selectList
        label {
            label: Matriz Classificação
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Centro de custo: '||( select c.nome
                                              from centrodecustos c
                                              where c.idcentrodecusto = md.idcentrodecusto )||' - Conta: '||pck_romance.fnc_nomecontafinan(md.idcontafinan)||' - Sub Conta: '||pck_romance.fnc_nomesubcontafinan(md.idsubcontafinan) 
                                              /*||
                       ' - Tipo: '||
                       case when md.tipo = 'F' then 'FIXA'
                            when md.tipo = 'V' then 'VARIAVEL'
                            when md.tipo = 'I' then 'INVESTIMENTO'
                            when md.tipo = 'X' then 'IMPOSTOS'
                       else null end||
                       ' - Regra: '||
                       case when md.tiporegra = 'C' then 'CUSTO'
                            when md.tiporegra = 'D' then 'DESPESA'
                            when md.tiporegra = 'I' then 'INVESTIMENTO'
                            when md.tiporegra = 'X' then 'IMPOSTOS'
                       else null end*/  display_value
                     , md.idmatrizregra return_value
                from matrizregrasdespesas md
                where md.idfornecedor = :P448_IDFORNECEDOR
                  and md.idfilial     = :P448_UNIDADENEGOCIO
                  and md.ativo        = 'S'
                
                
                ```
        }
        cascadingLov {
            parentItems: [
                P448_IDFORNECEDOR
                P448_UNIDADENEGOCIO
            ]
        }
        layout {
            sequence: 250
            region: @lançamento-requisição-pagamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
