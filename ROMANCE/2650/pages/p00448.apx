            column: 7
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select t.usuarioalteracao||' - '||to_char(t.dataalteracao,'dd/mm/yyyy hh24:mi:ss') ultima_alteracao
                  from logroman.log_REQUISICOESPAGAMENTOS t
                 where t.idrequisicaopgto = :P448_IDREQUISICAO
                   and t.tipoalteracao = 'UPDATE'
                   and t.dataalteracao = (select max(tt.dataalteracao)
                                            from logroman.log_REQUISICOESPAGAMENTOS tt
                                           where tt.idrequisicaopgto = t.idrequisicaopgto
                                             and t.tipoalteracao = 'UPDATE')
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P448_UNIDADENEGOCIO (
        type: selectList
        label {
            label: Unidade Negocio
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(f.idfilial)||'  - Unid. Neg.: '||( select un.nome
                                                                                from unidadesdenegocios un
                                                                                where un.idunidadedenegocio = f.idunidadedenegocio ) display_value 
                     , f.idfilial return_value 
                from filiais f
                where f.ativo = 'S'
                  and exists ( select 1
                               from matrizregrasdespesas m
                               where m.idfornecedor = :P448_IDFORNECEDOR
                                 and m.idfilial     = f.idfilial 
                                 and m.ativo = 'S' )
                  -- and f.grupocrisdu =  'S' -- Debora solicitou remover a amarração.
                  --and f.idfilial not in 1186 -- Debora solicitou a Remoção da lista / Debora disse que nao fez a solicitação anterior (remoção) e pediu para liberar T9651853
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P448_IDFORNECEDOR
        }
        layout {
            sequence: 230
            region: @lançamento-requisição-pagamento
