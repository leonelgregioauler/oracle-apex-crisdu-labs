    button duplicar-lancamento (
        buttonName: DUPLICAR_LANCAMENTO
        label: Duplicar Requisição
        layout {
            sequence: 100
            region: @lançamento-requisição-pagamento
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.requisicoespagamentos r
                where r.idrequisicaopgto = :P448_IDREQUISICAO
                 and not exists ( select 1 
                              from roman.situacoesrequisicoes s
                              where s.idsituacao = r.idsituacao
                                and s.idsituacao in (1,4,8) )
                ```
        }
    )

    button enviar-financeiro (
        buttonName: ENVIAR_FINANCEIRO
        label: Enviar Requisição
        layout {
            sequence: 110
            region: @lançamento-requisição-pagamento
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                exists ( select 1
                         from roman.requisicoespagamentos r
                        where r.idrequisicaopgto = :P448_IDREQUISICAO 
                           and r.idsituacao in (1,4) )
                and exists ( select 1
                                 from roman.vencimentosrequisicoes v 
                                 where v.idrequisicaopgto = :P448_IDREQUISICAO  )
                ```
        }
    )

    button finalizar-fiscal (
        buttonName: FINALIZAR_FISCAL
        label: Finalizar Fiscal
        layout {
            sequence: 120
            region: @lançamento-requisição-pagamento
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual           
                where exists ( select 1 
                               from roman.requisicoespagamentos r 
                               where r.fiscal = 'S'
                                 and r.datafinalizadofiscal is null
                                 and r.idsituacao in (2, 3, 10, 11, 12, 13)
                                 and r.idrequisicaopgto = :P448_IDREQUISICAO)
                  and exists ( select 1
                               from catal.usuarios u
                               where u.usuario = v('APP_USER')
                                 and u.idgerente in ( 180,351,350,266,143 ))
                ```
        }
    )

    button gerar-requisicao (
        buttonName: GERAR_REQUISICAO
