        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 449
                items: {
                    P449_IDANEXOREQUISICAOPGTO:
                    P449_IDANEXODELETAR:
                    P449_IDREQUISICAO: &P448_IDREQUISICAO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P448_IDREQUISICAO
        }
    )

