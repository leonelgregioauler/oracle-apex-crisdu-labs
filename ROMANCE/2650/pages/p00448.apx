                                  where vr.idrequisicaopgto = :P448_IDREQUISICAO)
                    ```
            }
        )

    )

    dynamicAction desabilita-fixa-data-e-dias-prazo (
        name: Desabilita fixa data e dias prazo
        execution {
            sequence: 160
        }
        when {
            selectionType: items
            items: P448_QTDEPARCELAS
        }
        clientSideCondition {
            type: item=value
            item: P448_QTDEPARCELAS
            value: 1
