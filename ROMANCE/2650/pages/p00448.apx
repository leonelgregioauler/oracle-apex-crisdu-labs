    validation exige-motivo-acrescimo (
        name: Exige Motivo Acrescimo
        execution {
            sequence: 70
        }
        validation {
            type: itemIsNotNullOrZero
            item: P448_MOTIVOATRASO
        }
        error {
            errorMessage: Por favor, informe o motivo dos acréscimos desta fatura.
            associatedItem: @P448_MOTIVOATRASO
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'GERAR_REQUISICAO' and to_date(:P448_VENCIMENTO) < trunc(sysdate)
        }
    )

    validation exige-valor-de-acrescimo (
        name: Exige Valor de Acrescimo
        execution {
            sequence: 80
        }
        validation {
            type: itemIsNotNull
            item: P448_ACRECIMO
        }
        error {
            errorMessage: Por favor, informe o valor dos acréscimos desta fatura.
            associatedItem: @P448_ACRECIMO
        }
        serverSideCondition {
            type: expression
            plsqlExpression: v('REQUEST') = 'GERAR_REQUISICAO' and to_date(:P448_VENCIMENTO) < trunc(sysdate)
        }
    )

    validation permite-somente-números (
        name: Permite Somente Números
        execution {
            sequence: 230
        }
        validation {
            type: itemIsNumeric
            item: P448_DOCUMENTO
        }
        error {
            errorMessage: Permitido somente valores numéricos 0~9
            associatedItem: @P448_DOCUMENTO
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('SALVAR','GERAR_REQUISICAO','ENVIAR_FINANCEIRO','INTEGRAR_FINANCEIRO')
                ```
        }
    )

    validation valida-anexo (
        name: Valida Anexo
        execution {
            sequence: 60
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.formaspagamentos fp
                where fp.idformapagamento = :P448_TIPODOC
                  and fp.anexoobrigatorio = 'S'
                  and not exists ( select 1 
                                   from roman.anexosrequisicoes a
                                   where a.idrequisicaopgto = :P448_IDREQUISICAO )
                ```
        }
        error {
            errorMessage: Anexar arquivo!
        }
        serverSideCondition {
            whenButtonPressed: @enviar-financeiro
        }
    )

    validation valida-chave-de-acesso-ao-integrar (
        name: Valida Chave de Acesso ao integrar
        execution {
            sequence: 245
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where exists ( select 1 
                               from roman.chavesacessorequisicoes c 
                               where c.idrequisicaopgto = :P448_IDREQUISICAO )
                ```
        }
        error {
            errorMessage: Cadastre ao menos uma Chave de Acesso antes de integrar a requisição!
        }
        serverSideCondition {
            whenButtonPressed: @integrar-financeiro
            type: never
        }
    )

