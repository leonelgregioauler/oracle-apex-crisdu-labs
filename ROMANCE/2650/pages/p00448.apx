    dynamicAction confirma (
        name: Confirma
        execution {
            sequence: 90
        }
        when {
            event: click
            selectionType: button
            button: @deletar
        }

        action native-confirm (
            action: confirm
            settings {
                message: Realmente deseja excluir ?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: DELETAR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction desabilita-dias-prazo (
        name: Desabilita Dias Prazo
        execution {
            sequence: 210
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P448_DIASPRAZO
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: items
                items: P448_DIASPRAZO
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 
                    from roman.requisicoespagamentos r 
                    where r.idrequisicaopgto = :P448_IDREQUISICAO
                      and r.dias is not null
                      and exists( select 1 
                                  from roman.vencimentosrequisicoes vr 
                                  where vr.idrequisicaopgto = :P448_IDREQUISICAO)
                    ```
            }
        )

    )

