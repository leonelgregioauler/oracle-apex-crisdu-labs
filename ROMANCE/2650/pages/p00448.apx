page 448 (
    name: Lançamento Requisição de Pagamento
    title: Lançamento Requisição de Pagamento
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region lançamento-requisição-pagamento (
        name: Lançamento Requisição Pagamento
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region rateios (
        name: Rateios
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ra.idrateiorequisicao
                     , ra.idrequisicaopgto
                     , ra.valor
                     , ra.idfilial
                     --, ra.idrazaosocialfilial
                     , ra.idmatriz
                     , ra.observacao
                from roman.rateiosrequisicoes ra
                where ra.idrequisicaopgto = :P448_IDREQUISICAO
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P448_GRUPO is not null
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 1127881105465351481
        }

        savedReport 486049 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @VALOR
                layout {
                    width: 101.66667175292969
                    sequence: 3
                }
            )

            displayColumn (
                column: @IDMATRIZ
                layout {
                    width: 770.66015625
                    sequence: 4
                }
            )

            displayColumn (
                column: @OBSERVACAO
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDRATEIOREQUISICAO
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @IDREQUISICAOPGTO
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @IDFILIAL
                layout {
                    width: 408
                    sequence: 2
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column IDFILIAL (
            type: selectList
            heading {
                heading: Filial Destino
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_romance.fnc_nomefilial(f.idfilial)||'  - Unid. Neg.: '||( select un.nome
                                                                                    from unidadesdenegocios un
                                                                                    where un.idunidadedenegocio = f.idunidadedenegocio ) display_value 
                         , f.idfilial return_value 
                    from filiais f
                    where f.ativo = 'S'
                      and exists ( select 1
                                   from matrizregrasdespesas m
                                   where m.idfornecedor = :P448_IDFORNECEDOR
                                     and m.idfilial     = f.idfilial 
                                     and m.ativo = 'S' )
                      -- and f.grupocrisdu =  'S' -- Debora solicitou remover a amarração.
                      --and f.idfilial not in 1186 -- Debora solicitou a Remoção da lista 
                    order by 1
                    ```
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                databaseColumn: IDFILIAL
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDMATRIZ (
            type: selectList
            heading {
                heading: Matriz
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select 'Centro de custo: '||( select c.nome
                                                  from centrodecustos c
                                                  where c.idcentrodecusto = m.idcentrodecusto )||' - Conta: '||pck_romance.fnc_nomecontafinan(m.idcontafinan)||' - Sub Conta: '||pck_romance.fnc_nomesubcontafinan(m.idsubcontafinan) a
                         , m.idmatrizregra
                    from matrizregrasdespesas m
                    where m.idfornecedor = :P448_IDFORNECEDOR
                      and m.idfilial     = :IDFILIAL
                      and m.ativo        = 'S'
                    ```
            }
            cascadingLov {
                parentColumns: IDFILIAL
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: IDMATRIZ
                dataType: number
            }
        )

