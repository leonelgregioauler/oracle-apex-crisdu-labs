            sequence: 200
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P448_FIXADATA
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: items
                items: P448_FIXADATA
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: rowsReturned
