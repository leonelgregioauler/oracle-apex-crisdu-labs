            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                not exists ( select 1 
                             from roman.vencimentosrequisicoes v
                             where v.idrequisicaopgto = :P448_IDREQUISICAO )
                and exists ( select 1 
