    process processo-dml-requisicoes (
        name: Processo DML Requisicoes
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  voperacao_dml varchar2(1);
                  vsituacao varchar2(100);
                  vusuarioinclusao varchar2(50);
                  vdatainclusao date := sysdate;
                  vvalor number;
                  vdesconto number;
                  vacrescimo number;
                  vvalortotal number;
                  vmoeda number;
                  vlinhadigitavel varchar2(48) := regexp_replace(:P448_LINHADIGITAVEL,'[^0-9]'); -- Ticket 16244255
                  v_validaMatriz NUMBER;
                  vantecipacao varchar2(1);
                  --
                begin
                  --
                  if v('REQUEST') in ('GERAR_REQUISICAO') then
                    if :P448_GRUPO is null and :P448_UNIDADENEGOCIO is null then
                      raise_application_error(-20001,'Obrigatorio informar Grupo ou Unidade');
                    end if;
                  end if;
                  --
                  if v('REQUEST') = 'GERAR_REQUISICAO' then
                    --
                    voperacao_dml := 'I';
                    vvalortotal :=  replace(nvl(:P448_VALOR,0),'.','')  + replace(nvl(:P448_ACRECIMO,0),'.','') - replace(nvl(:P448_DESCONTO,0),'.','') ; 
                    vvalor  := replace(:P448_VALOR,'.','');
                    vdesconto := replace(:P448_DESCONTO,'.','');
                    vacrescimo := replace(:P448_ACRECIMO,'.','');
                    --
                  elsif v('REQUEST') = 'SALVAR' then
                    --
                    SELECT COUNT(*)
                      INTO v_validaMatriz
                    FROM roman.rateiosrequisicoes R
                    JOIN roman.matrizregrasdespesas M ON R.IDMATRIZ = M.IDMATRIZREGRA
                    WHERE R.IDREQUISICAOPGTO = :P448_IDREQUISICAO 
                      AND M.ATIVO = 'N'
                      AND ROWNUM = 1;
                    --
                    IF (v_validaMatriz >= 1) THEN
                        RAISE_APPLICATION_ERROR(-20001, 'Existem Matrizes Inativas');
                    END IF;
                    --
                    vvalortotal :=  replace(nvl(:P448_VALOR,0),'.','')  + replace(nvl(:P448_ACRECIMO,0),'.','') - replace(nvl(:P448_DESCONTO,0),'.','') ; 
                    voperacao_dml := 'U';
                    vvalor := replace(:P448_VALOR,'.','');
                    vdesconto  := replace(:P448_DESCONTO,'.','');
                    vacrescimo := replace(:P448_ACRECIMO,'.','');
                    --  
                  elsif v('REQUEST') = 'DELETAR' then
                    --
                    voperacao_dml := 'D';
                    --
                  end if;
                  --
                  select u.usuario 
                    into vusuarioinclusao
                  from catal.usuarios u
                  where u.usuario = v('APP_USER');
                  --
                  -- Trata o idmoeda
                  vmoeda := :P448_IDMOEDA;
                  vantecipacao := nvl(:P448_ANTECIPACAO, 'N');
                  --
                  ROMAN.PCK_NOTASFISCAIS_RMC.PRC_REQUISICOESPAGAMENTOS(pidrequisicaopgto    => :P448_IDREQUISICAO
                                                                     , pidfilial            => :P448_FILIALORIGEM
                                                                     , pidformapagamento    => :P448_TIPODOC
                                                                     , pdocumento           => :P448_DOCUMENTO
                                                                     , pdatainclusao        => vdatainclusao
                                                                     , pdataemissao         => :P448_DATAEMISSAO
                                                                     , penvio               => :P448_ENVIO
                                                                     , pidsituacao          => :P448_SITUACAO 
                                                                     , pusuarioinclusao     => vusuarioinclusao
                                                                     , pusuarioaprovacao    => :P448_USUARIOAPROVACAO
                                                                     , pidfornecedor        => :P448_IDFORNECEDOR
                                                                     , pidfilialdestino     => :P448_UNIDADENEGOCIO
                                                                     , pidrazaosocialfornec => :P448_IDRAZAOFORNECEDOR
                                                                     , pidrazaosocialdest   => :P448_IDRAZAOSOCIALDESTINO
                                                                     , pidmatrizdespesa     => :P448_MATRIZ
                                                                     , pidgrupo             => :P448_GRUPO
                                                                     , pidrazaodestgrupo    => :P448_IDRAZAODESTGRUPO
                                                                     , pidcontabanc         => :P448_CONTADEPOSITO
                                                                     , pvalortotal          => vvalortotal
                                                                     , pvalor               => vvalor
                                                                     , pdesconto            => vdesconto 
                                                                     , pvencimento          => :P448_VENCIMENTO
                                                                     , pacrescimo           =>  vacrescimo
                                                                     , pantecipacao         => vantecipacao
                                                                     , pfiscal              => :P448_FISCAL
                                                                     , pcomprovantepgto     => :P448_COMPROVANTEPGTO
                                                                     , pmotivoatraso        => :P448_MOTIVOATRASO
                                                                     , pparcelas            => :P448_QTDEPARCELAS
                                                                     , pdias                => :P448_DIASPRAZO
                                                                     , pfixadata            => :P448_FIXADATA
                                                                  -- , pgeravencimento      => :P448_GERARVENCIMENTO
                                                                     , pobservacao          => :P448_OBSERVACAO
                                                                     , pajuste              => :P448_AJUSTESAREALIZAR
                                                                     , pedicao              => :P448_EDICAOBLOQUEADA
                                                                     , pidmoeda             => vmoeda
                                                                     , pconversao           => :P448_CONVERSAO
                                                                     , plinhadigitavel      => vlinhadigitavel
                                                                     , pmd5                 => :P448_MD5
                                                                     , poperacao_dml        => voperacao_dml );
                    --
                    COMMIT;
                    if voperacao_dml = 'I' then
                      --
                      apex_application.g_print_success_message := '<span style="color : white ">Requisição criada com sucesso! </span>';  
                      
                    elsif  voperacao_dml = 'U' then
                      --
                      apex_application.g_print_success_message := '<span style="color : white ">Alteração realizada com sucesso! </span>';
                    
                    elsif  voperacao_dml = 'D' then
                      --
                      apex_application.g_print_success_message := '<span style="color : white ">Exclusão realizada com sucesso! </span>';
                    end if;
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 564725809708488804
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('SALVAR','DELETAR','GERAR_REQUISICAO')
                ```
        }
    )

    process processo-dml-vencimentos (
        name: Processo DML Vencimentos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  voperacao_dml varchar2(1);
                  vobservacaov varchar2(100) := null;
                  vidvencimentoreq number := null;
                  --vreq number := 1;
                  vvalor number(15,2) := replace(:P448_VALORTOTAL,'.','');
