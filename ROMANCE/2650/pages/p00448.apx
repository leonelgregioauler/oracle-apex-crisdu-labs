                  if v('REQUEST') = 'GERAR_VENCIMENTOS' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'SALVAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'DELETAR' then
                    voperacao_dml := 'D';
                  end if;
                 --
                 ROMAN.PCK_NOTASFISCAIS_RMC.PRC_VENCIMENTOSREQUISICOES( pidvencimentorequisicao  => vidvencimentoreq
                                                                      , pidrequisicaopgto        => :P448_IDREQUISICAO
                                                                      , pparcela                 => :P448_QTDEPARCELAS
                                                                      , pfixadata                => :P448_FIXADATA
                                                                      , pvalor                   => vvalor
                                                                      , pvencimento              => :P448_VENCIMENTO
                                                                      , pobservacao              => vobservacaov
                                                                      , pmd5                     => :P448_MD5
                                                                      , poperacao_dml            => voperacao_dml );
                  --
                 -- commit;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 564726661348488805
        }
        serverSideCondition {
            type: rowsReturned
