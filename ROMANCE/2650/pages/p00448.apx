            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 27
                items: {
                    P27_IDFORNEMITENTE: &P448_IDFORNECEDOR.
                    P27_IDNOTAFISCAL: &P448_IDNOTAFISCAL.
                }
                clearCache: 27
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.requisicoespagamentos r
                where r.idrequisicaopgto = :P448_IDREQUISICAO
                 and r.idsituacao in (6,7)
                 and r.idnotafiscal is not null
                ```
        }
    )

