    process retorna-usuario (
        name: Retorna Usuario
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 --
                 vusuario varchar2(25);
                 vverifica number;
                 vtitulo varchar2(100)    := 'Requisição '||:P448_IDREQUISICAO||' possui divergência para ser resolvida!';
                 vdescricao varchar2(900) := null;
                 --
                begin
                  --
                  --raise_application_error(-20001,'qualquer coisa'||v('REQUEST'));
                  select u.usuario 
                    into vusuario
                  from catal.usuarios u
                  where u.usuario = v('APP_USER');
                  --
                  if v('REQUEST') = 'RETORNAR_USUARIO' then
                    --
                    -- Projeto fluxo paralelo Fiscal x Financeiro: o destino do retorno preserva
                    -- o estado financeiro quando este j¿ atuou (status 6, 7, 10, 12):
                    --   6, 10, 11 -> 11 (Programado - Ajuste Fiscal Pendente)
                    --   7, 12, 13 -> 13 (Quitado - Ajuste Fiscal Pendente)
                    --   demais    -> 4  (Ajuste Lan¿amento - fluxo padr¿o)
                    -- Ao transitar para 11/13, limpa DATAFINALIZADOFISCAL/USUARIOFINALIZADOFISCAL
                    -- para que fnc_fiscal_pendente retorne 'S' e a requisi¿¿o reapare¿a na fila
                    -- do fiscal para re-revis¿o.
                    update roman.requisicoespagamentos rp
                       set rp.idsituacao = case 
                                              when rp.idsituacao in (6, 10, 11) then 11
                                              when rp.idsituacao in (7, 12, 13) then 13
                                              else 4
                                           end
                         , rp.datafinalizadofiscal = case
                                                        when rp.idsituacao in (6, 7, 10, 12) then null
                                                        else rp.datafinalizadofiscal
                                                     end
                         , rp.usuariofinalizadofiscal = case
                                                           when rp.idsituacao in (6, 7, 10, 12) then null
                                                           else rp.usuariofinalizadofiscal
                                                        end
                         , rp.usuarioaprovacao = vusuario
                         , rp.ajustearealizar = vusuario|| ' - '||to_char(sysdate,'DD-MON-YYYY HH:MI:SS')|| ' - '||:P448_AJUSTESAREALIZAR 
                         , rp.edicaobloqueada = 'N'
                     where rp.idrequisicaopgto = :P448_IDREQUISICAO;
                    --
                  else
                    --
                    null;
                
                  end if;
                  --
                  commit;
                  --
                  if v('APP_USER') = 'CINARA' then
                  --
                  select 1
                    into vverifica
                    from roman.requisicoespagamentos rp
                   where rp.idsituacao = 4 -- Ajuste Lançamento - Retornado do fiscal ou financeiro para ajuste pelo usuário que fez o lançamento
                     and rp.usuarioaprovacao = vusuario
                     and rp.edicaobloqueada = 'N'
                     and rp.idrequisicaopgto = :P448_IDREQUISICAO;
                  --
                  if vverifica = 1 then
                    --
                    vdescricao := 'Requisição: '||:P448_IDREQUISICAO||', Documento: '||:P448_documento||'. '||:P448_observacao;
                    --
                    pck_ti.prc_enviaemail ( pusuariodestino => :P448_USUARIOINCLUSAO
                                          , ptitulo         => vtitulo
                                          , pcorpo          => vdescricao );
                    --
                  end if;
                 --
                 end if;
                 --
                end;
                
                ```
        }
        execution {
            sequence: 90
        }
        successMessage {
            successMessage: Requisição retornada ao usuário!
        }
        advanced {
            executionMappingIdentifier: 566909496501601102
        }
        serverSideCondition {
            whenButtonPressed: @retornar-usuario
        }
    )

