    button integrar-financeiro (
        buttonName: INTEGRAR_FINANCEIRO
        label: Integrar Financeiro
        layout {
            sequence: 130
            region: @lançamento-requisição-pagamento
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                exists ( select 1 
