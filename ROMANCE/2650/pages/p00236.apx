            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process processar (
        name: processar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_romance.prc_atualiza_parcelas_anual(pidpgtoforn => null,
                                                          piddeposito => :P236_IDDEPOSITODIARIOS);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Saldo processado com sucesso!
        }
        error {
            errorMessage: Ocorreu um erro ao processar o saldo. Registe um evento.
        }
        advanced {
            executionMappingIdentifier: 326977727107710241
        }
    )

    branch (
        name: processado
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 236
            }
