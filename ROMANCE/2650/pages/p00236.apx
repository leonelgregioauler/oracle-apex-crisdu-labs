        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region saldo-anual (
        name: Saldo Anual
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
    )

    pageItem P236_IDDEPOSITODIARIOS (
        type: textField
        label {
            label: ID
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 10
            region: @saldo-anual
            slot: regionBody
