page 214 (
    name: Abatimento Confirmado
    title: Abatimento Confirmado
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region abatimento-confirmado (
        name: Abatimento Confirmado
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P214_ABATIMENTOCONFIRMADO (
        type: radioGroup
        label {
            label: Confirmar
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @abatimento-confirmado
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: ABATIMENTOCONFIRMADO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P214_IDVENCIMENTO (
        type: hidden
        layout {
            sequence: 10
            region: @abatimento-confirmado
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDVENCIMENTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Fechar
        layout {
            sequence: 10
            region: @abatimento-confirmado
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 210
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: SAVE
        label: Confirmar
        layout {
            sequence: 30
            region: @abatimento-confirmado
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P214_IDVENCIMENTO
        }
    )

    process fetch-row-from-vencimentosreceber (
        name: Fetch Row from VENCIMENTOSRECEBER
        type: autoRowFetch
        source {
            tableName: VENCIMENTOSRECEBER
            pkColumn: IDVENCIMENTO
            pkItem: P214_IDVENCIMENTO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1061660024256677694
        }
    )

    process process-row-of-vencimentosreceber (
        name: Process Row of VENCIMENTOSRECEBER
        type: autoRowProcessing
        target {
            tableName: VENCIMENTOSRECEBER
            pkColumn: IDVENCIMENTO
            pkItem: P214_IDVENCIMENTO
            supportedOperations: update
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        advanced {
            executionMappingIdentifier: 1061660226420677696
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 1061660411936677696
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 214
            }
        }
    )

)

