page 386 (
    name: Apoio para Entradas Diversas
    title: Apoio para Entradas Diversas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region entradas-diversas (
        name: Entradas Diversas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.identrada
                     , e.idfilial
                     , e.semana
                     , e.data
                     , e.idcontacontabil
                     , e.idsubcontacontabil
                     , e.descricao
                     , e.valortotal
                     , ( select le.usuarioalteracao
                         from logroman.log_entradasdiversas le
                         where le.identrada = e.identrada
                           and le.tipoalteracao = 'INSERT' ) lancadapor
                     , e.idmatrizentrada
                from entradasdiversas e
                where e.idsaidadiversa is null
                  and trunc(e.data) between to_date(:P386_DATAINICIO) and to_date(:P386_DATAFIM)
                  and ( :P386_IDFILIAL is null or e.idfilial = :P386_IDFILIAL )
                  and ( :P386_MATRIZ = 'A'
                     or ( :P386_MATRIZ = 'S' and e.idmatrizentrada is not null )
                     or ( :P386_MATRIZ = 'N' and e.idmatrizentrada is null ) )
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        performance {
            lazyLoading: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 4890601880481209142
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDENTRADA
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDFILIAL
                layout {
                    width: 187
                    sequence: 3
                }
            )

            displayColumn (
                column: @SEMANA
                layout {
                    width: 127
                    sequence: 4
                }
            )

            displayColumn (
                column: @DATA
                layout {
                    width: 122
                    sequence: 5
                }
            )

            displayColumn (
                column: @IDCONTACONTABIL
                layout {
                    width: 215
                    sequence: 6
                }
            )

            displayColumn (
                column: @IDSUBCONTACONTABIL
                layout {
                    width: 278
                    sequence: 7
                }
            )

            displayColumn (
                column: @DESCRICAO
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @VALORTOTAL
                layout {
                    width: 198
                    sequence: 9
                }
            )

            displayColumn (
                column: @IDMATRIZENTRADA
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @ROWID
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @LANCADAPOR
                layout {
                    sequence: 11
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column DATA (
            type: datePickerJquery
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                databaseColumn: DATA
                dataType: date
            }
        )

        column DESCRICAO (
            type: textarea
            heading {
                heading: Descrição
            }
            layout {
                sequence: 100
            }
            validation {
                maxLength: 1000
            }
            source {
                databaseColumn: DESCRICAO
                dataType: varchar2
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column IDCONTACONTABIL (
            type: selectList
            heading {
                heading: "Conta "
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nomeconta d
                         , cf.idcontafinan r
                    from contasfinanceiras cf
                    where cf.ativo = 'S'
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: IDCONTACONTABIL
                dataType: number
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDENTRADA (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IDENTRADA
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDFILIAL (
            type: selectList
            heading {
                heading: Empresa
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nome
                         , idfilial
                    from vw_filiais f
                    where f.ativo = 'S'
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: IDFILIAL
                dataType: number
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDMATRIZENTRADA (
            type: selectList
            heading {
                heading: Classificação
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select ' - Sem Matriz -' d
                         , null r
                    from dual
                    union
                    select m.classificacaoentrada||' - Conta: '||( select nomeconta
                                                                   from contasfinanceiras cf
                                                                   where cf.idcontafinan = m.idcontafinan )||' / SubConta: '||( select nomeconta
                                                                                                                                from subcontasfinanceiras s
                                                                                                                                where s.idsubcontafinan = m.idsubcontafinan ) display_value                                                                                                                                                  
                         , m.idmatrizentrada
                    from matrizclassificacoesentradas m
                    where m.idfilial = :IDFILIAL
                    order by 1
                    ```
            }
            cascadingLov {
                parentColumns: IDFILIAL
            }
            layout {
                sequence: 120
                columnAlignment: end
            }
            source {
                databaseColumn: IDMATRIZENTRADA
                dataType: number
            }
        )

        column IDSUBCONTACONTABIL (
            type: selectList
            heading {
                heading: Sub Conta
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nomeconta d
                         , cf.idsubcontafinan r
                    from subcontasfinanceiras cf
                    where cf.ativo = 'S'
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 90
            }
            source {
                databaseColumn: IDSUBCONTACONTABIL
                dataType: number
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column LANCADAPOR (
            type: textField
            heading {
                heading: Lançado Por
            }
            layout {
                sequence: 130
            }
            source {
                databaseColumn: LANCADAPOR
                dataType: varchar2
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ROWID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ROWID
                dataType: rowid
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column SEMANA (
            type: textField
            heading {
                heading: Semana
                alignment: center
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 10
            }
            source {
                databaseColumn: SEMANA
                dataType: varchar2
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column VALORTOTAL (
            type: numberField
            heading {
                heading: Valor
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                databaseColumn: VALORTOTAL
                dataType: number
                queryOnly: true
            }
            columnFilter {
                lovType: none
            }
        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P386_DATAFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: DD/MM/RRRR
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P386_DATAINICIO (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: DD/MM/RRRR
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P386_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idfilial
                from vw_filiais f
                where f.ativo = 'S'
                ```
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P386_MATRIZ (
        type: radioGroup
        label {
            label: Buscar
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Com Matriz;S,Sem Matriz;N,Ambos;A
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    button aplicar (
        buttonName: APLICAR
        label: Aplicar
        layout {
            sequence: 10
            region: @entradas-diversas
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process entradas-diversas-save-interactive-grid-data (
        name: Entradas Diversas - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @entradas-diversas
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo executado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 4899009542416749905
        }
        serverSideCondition {
            whenButtonPressed: @aplicar
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 386
                items: {
                    P386_IDFILIAL: &P386_IDFILIAL.
                    P386_MATRIZ: &P386_MATRIZ.
                    P386_DATAINICIO: &P386_DATAINICIO.
                    P386_DATAFIM: &P386_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

