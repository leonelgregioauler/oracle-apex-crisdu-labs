page 159 (
    name: Vínculo de Conta para DRE
    title: Vínculo de Conta para DRE
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region vínculo-de-conta-para-dre (
        name: Vínculo de Conta para DRE
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
    )

    pageItem P159_IDCONTAFINANCEIRA (
        type: selectList
        label {
            label: Conta Financeira
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nomeconta    display_value
                     , c.idcontafinan return_value
                from contasfinanceiras c
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione a Conta -
        }
        layout {
            sequence: 20
            region: @vínculo-de-conta-para-dre
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDCONTAFINANCEIRA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P159_IDPGTOFORN (
        type: hidden
        layout {
            sequence: 10
            region: @vínculo-de-conta-para-dre
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDPGTOFORN
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P159_IDSUBCONTAFINANCEIRA (
        type: selectList
        label {
            label: Sub Conta Financeira
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nomeconta    display_value
                     , c.idsubcontafinan return_value
                from subcontasfinanceiras c
                where idcontafinan = :P159_IDCONTAFINANCEIRA
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione a Sub Conta -
        }
        cascadingLov {
            parentItems: P159_IDCONTAFINANCEIRA
        }
        layout {
            sequence: 30
            region: @vínculo-de-conta-para-dre
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDSUBCONTAFINANCEIRA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Fechar
        layout {
            sequence: 10
            region: @vínculo-de-conta-para-dre
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 81
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @vínculo-de-conta-para-dre
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P159_IDPGTOFORN
        }
    )

    process fetch-row-from-pagamentosfornecedores (
        name: Fetch Row from PAGAMENTOSFORNECEDORES
        type: autoRowFetch
        source {
            tableName: PAGAMENTOSFORNECEDORES
            pkColumn: IDPGTOFORN
            pkItem: P159_IDPGTOFORN
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 275405123546500514
        }
    )

    process process-row-of-pagamentosfornecedores (
        name: Process Row of PAGAMENTOSFORNECEDORES
        type: autoRowProcessing
        target {
            tableName: PAGAMENTOSFORNECEDORES
            pkColumn: IDPGTOFORN
            pkItem: P159_IDPGTOFORN
            supportedOperations: update
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        advanced {
            executionMappingIdentifier: 275405320448500516
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 159
                items: {
                    P159_IDPGTOFORN: &P159_IDPGTOFORN.
                }
            }
        }
    )

)

