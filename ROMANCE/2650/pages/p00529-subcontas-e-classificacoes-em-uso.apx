    region classificações-x-subcontas-finan (
        name: Classificações X Subcontas Finan
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select scc.idclassificacao
                     , pcg.descricaoconta
                     , pcg.classificacao
                     , scc.tipoclassificacao
                     , scc.idsubcontafinan
                     , scf.nomeconta SubContaFInanceira
                     , cf.idcontafinan
                     , cf.nomeconta ContaFinanceira
                from roman.subcontasclassificacoes scc
                    ,roman.subcontasfinanceiras scf
                    ,roman.contasfinanceiras cf
                    ,roman.planocontasgeral pcg
                where scf.idsubcontafinan = scc.idsubcontafinan
                  and scf.idcontafinan    = cf.idcontafinan
                  and scc.idclassificacao = pcg.idclassificacao
                order by pcg.classificacao
                ```
        }
        layout {
            sequence: 20
            parentRegion: @classificações-x-subcontas-financeiras
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1321342046315438339
        }

