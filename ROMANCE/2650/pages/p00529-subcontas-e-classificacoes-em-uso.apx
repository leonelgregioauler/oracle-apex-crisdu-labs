    region subclassificações-x-subcontas-finan (
        name: Subclassificações X Subcontas Finan
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select (select rsf.razaosocial
                        from roman.razoessociaisfiliais rsf
                        where rsf.idrazaosocialfilial = pce.idrazaosocialfilial) Empresa
                     , (select rsf.cnpj
                        from roman.razoessociaisfiliais rsf
                        where rsf.idrazaosocialfilial = pce.idrazaosocialfilial) CNPJ
                     , scsc.idsubclassificacao
                     , sc.sequencia
                     , sc.subclassificacao
                     , sc.descricao
                     , scsc.tipoclassificacao
                     , scsc.idsubcontafinan
                     , scf.nomeconta SubContaFInanceira
                     , cf.idcontafinan
                     , cf.nomeconta ContaFinanceira
                from roman.subcontassubclassif scsc
                    ,roman.subcontasfinanceiras scf
                    ,roman.contasfinanceiras cf
                    ,roman.subclassificacoes sc
                    ,roman.planocontasclassificacoes pcc
                    ,roman.planocontasempresa pce
                where scf.idsubcontafinan = scsc.idsubcontafinan
                  and scf.idcontafinan    = cf.idcontafinan
                  and scsc.idsubclassificacao = sc.idsubclassificacao
                  and sc.idplanocontasclassif = pcc.idplanocontasclassif
                  and pcc.idplanocontasempresa = pce.idplanocontasempresa
                order by cnpj, sc.sequencia
                   
                
                ```
        }
        layout {
            sequence: 30
            parentRegion: @subclassificações-x-subcontas-financeiras
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1321343021385438349
        }

