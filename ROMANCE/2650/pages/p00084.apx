page 84 (
    name: Venda Direta
    title: Venda Direta
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region venda-direta (
        name: Venda Direta
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idvendadireta
                     , semana
                     , data
                     , idfuncionario
                     , valortotal
                     , descricao
                     , usuario
                from vendasdiretas  v
                where v.idfechamento = :P84_IDFECHAMENTO
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        link {
            linkColumn: customTarget
            target: {
                page: 85
                items: {
                    P85_IDVENDADIRETA: #IDVENDADIRETA#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
            conditionType: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentossemanais f
                where nvl(f.concluido,'N') = 'N'
                  and f.idfechamento = :P84_IDFECHAMENTO
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhuma venda incluida.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column DATA (
            type: plainText
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 4
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
            source {
                dataType: date
            }
            advanced {
                htmlDomId: DATA
                endUserAlias: C
            }
            enableUsersTo {
                pivot: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column DESCRICAO (
            type: plainText
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: DESCRICAO
                endUserAlias: F
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDFUNCIONARIO (
            type: hidden
            heading {
                heading: Idfuncionario
            }
            layout {
                sequence: 2
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDFUNCIONARIO
                endUserAlias: D
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDVENDADIRETA (
            type: hidden
            heading {
                heading: Idvendadireta
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDVENDADIRETA
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column SEMANA (
            type: plainText
            heading {
                heading: Semana
                alignment: center
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: SEMANA
                endUserAlias: B
            }
            enableUsersTo {
                pivot: false
            }
        )

        column USUARIO (
            type: plainText
            heading {
                heading: Usuario
            }
            layout {
                sequence: 16
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column VALORTOTAL (
            type: plainText
            heading {
                heading: Valor Total
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: VALORTOTAL
                endUserAlias: E
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 33365 (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn DATA (
                sequence: 4
            )

            displayColumn DESCRICAO (
                sequence: 5
            )

            displayColumn IDFUNCIONARIO (
                sequence: 2
            )

            displayColumn IDVENDADIRETA (
                sequence: 1
            )

            displayColumn SEMANA (
                sequence: 3
            )

            displayColumn USUARIO (
                sequence: 7
            )

            displayColumn VALORTOTAL (
                sequence: 6
            )

        )

    )

    pageItem P84_IDFECHAMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @venda-direta
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P84_SEMANA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @venda-direta
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Nova Venda
        layout {
            sequence: 30
            region: @venda-direta
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 85
                items: {
                    P85_IDFECHAMENTO: &P84_IDFECHAMENTO.
                }
                clearCache: 85
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentossemanais f
                where nvl(f.concluido,'N') = 'N'
                  and f.idfechamento = :P84_IDFECHAMENTO
                ```
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @venda-direta
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 83
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

