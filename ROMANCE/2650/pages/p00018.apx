    pageItem P18_IDFILIAL (
        type: selectList
        label {
            label: Empresa Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                ```
            nullDisplayValue: - Todas -
            nullReturnValue: -1
        }
        layout {
            sequence: 30
            region: @lista-de-contas-bancarias
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P18_IDFORNECEDOR (
        type: selectList
        label {
            label: Fornecedor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefornecedor(idfornecedor) nome
                     , idfornecedor
                from fornecedores f
                where f.ativo = 'S'
                order by 1
                ```
            nullDisplayValue: - Todos -
            nullReturnValue: -1
        }
        layout {
            sequence: 20
            region: @lista-de-contas-bancarias
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P18_TIPO (
        type: radioGroup
        label {
            label: Busca Por
            alignment: left
