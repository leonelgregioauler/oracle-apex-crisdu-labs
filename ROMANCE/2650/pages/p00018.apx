            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refresh (
        name: Refresh 1
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P18_TIPO
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @lista-de-contas-bancarias
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

