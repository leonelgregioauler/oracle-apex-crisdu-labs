page 18 (
    name: Lista de Contas Bancarias
    title: Lista de Contas Bancarias
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region lista-de-contas-bancarias (
        name: Lista de Contas Bancarias
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idcontabanc 
                     , initcap(pf.nomepessoa) Fornecedor
                     , initcap(b.nomebanco) Banco
                     , c.agencia
                     , c.conta
                     , initcap(c.beneficiario) beneficiario
                     , documento
                     , to_char(c.datacriacao, 'DD/MM/YYYY HH24:MI') "Data Criação"
                     , decode(c.liberaabatimento,'S','Sim','Não') "Libera Abatimento"
                     , ( select initcap(nvl(cb.beneficiario,p.apelido)||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||')' display_value
                         from contasbancarias cb
                            , bancos b
                            , pessoas p
                         where cb.idbanco      = b.idbanco
                           and cb.idpessoa     = p.idpessoa
                           and cb.ativo        = 'S'
                           and cb.contaraiz    = 'S'
                           and cb.idcontabanc  =  c.idcontabancraiz ) "Conta Raíz Vinculada"
                     , decode(c.contaraiz, 'S', 'Sim', 'Não') "Conta Raíz"
                     , decode(c.poupanca,'S','Sim','N','Não') "Poupança"
                     , decode(c.usosetorcobranca,'S','Sim','Não') "Uso na Cobrança"
                     , decode(c.contaprincipal,'S','Sim','Não') "Conta Principal"
                     , decode(c.ativo,'S','Sim','Não') "Conta Ativa"
                     , (select listagg(decode(p.tipochave, '1','CPF/CNPJ','2','Chave Aleatória','3','Telefone','4','Email') || ' - '|| p.chave||' ')
                          from roman.chavespix p
                         where p.idcontabancaria = c.idcontabanc ) chavepix
                     , c.contacontabil 
                       --
                     , case when c.tipoconta = 'F' then 'Financeiro'
                            when c.tipoconta = 'C' then 'Caixa'
                            else ''
                        end "Tipo Conta"
                       --
                     , (select gf.grupo
                        from roman.gruposfinanceiros gf
                        where gf.idgrupofinanceiro = c.idgrupofinanceiro) as "Grupo Financeiro"
                       --
                from contasbancarias c
                   , pessoas         pf
                   , bancos          b
                where c.idpessoa     = pf.idpessoa
                  and c.idbanco      = b.idbanco
                  and (    ( :P18_TIPO is null)
                        or ( :P18_TIPO = 'F' and :P18_IDFORNECEDOR = -1 ) 
                        or ( :P18_TIPO = 'F' and   exists ( select 1
                                                              from catal.fornecedores f
                                                             where f.idfornecedor = c.idfornecedor
                                                               and f.idfornecedor = :P18_IDFORNECEDOR ))
                        or ( :P18_TIPO = 'E' and :P18_IDFILIAL = -1 )
                        or ( :P18_TIPO = 'E' and exists ( select 1
                                                            from catal.filiais f
                                                           where f.idpessoa = c.idpessoa
                                                             and f.idfilial = :P18_IDFILIAL )))
                 order by 2;
                ```
            pageItemsToSubmit: [
                P18_TIPO
                P18_IDFORNECEDOR
                P18_IDFILIAL
            ]
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 19
                items: {
                    P19_IDCONTABANC: #IDCONTABANC#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: This query returns more than 10,000 rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

