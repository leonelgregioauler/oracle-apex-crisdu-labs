    dynamicAction tipo-pesquisa-forn (
        name: Tipo Pesquisa Forn
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P18_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P18_TIPO
            value: F
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P18_IDFORNECEDOR
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P18_IDFORNECEDOR
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo-pesquisa-rom (
        name: Tipo Pesquisa Rom
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P18_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P18_TIPO
            value: E
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P18_IDFILIAL
            }
            execution {
