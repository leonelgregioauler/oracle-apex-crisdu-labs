page 563 (
    name: Analítico de Vencimentos e Pagamentos
    alias: ANALITICO-VENCIMENTOS-PAGAMENTOS
    title: Analítico de Vencimentos e Pagamentos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region vencimentos-e-pagamentos-das-notas-filtros-da-lista-de-notas-fiscais (
        name: Vencimentos e Pagamentos das Notas (filtros da Lista de Notas Fiscais)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select x.*
                     , to_char(x.datapagamento,'MM/RRRR') mesanopagamento
                from (
                select nf.idnotafiscal
                     , nf.documento
                     , decode( nf.tiponota, 'T', 'Transferência'
                                          , 'C', 'Compra'
                                          , 'A', 'Abastecimento'
                                          , 'R', 'Requisição Pgto'
                                          , 'D', 'Despesa') tiponf
                     , decode( nf.tiponota, 'T', pck_romance.fnc_nomefilial(pidfilial => nf.idfilialemitente )
                                               , nvl( pck_romance.fnc_nomefornecedor(pidforn => nf.idfornemitente ) , pck_romance.fnc_nomefilial(pidfilial => nf.idfilialemitente ) ) ) emitente
                     , ( select r.cnpj
                         from roman.razoessociaisfornec r
                         where r.idrazaosocialforn = nf.idrazaosocialfornemit ) cnpjemitente
                     , pck_romance.fnc_nomefilial(pidfilial => nf.idfilialdestino ) filialdestino
                     , ( select rf.razaosocial
                         from roman.razoessociaisfiliais rf
                         where rf.idrazaosocialfilial = nf.idrazaosocialfildestino ) razaosocialdestino
                     , ( select rf.cnpj
                         from roman.razoessociaisfiliais rf
                         where rf.idrazaosocialfilial = nf.idrazaosocialfildestino ) cnpjrazaodestino
                     , nf.dtnf
                     , nf.datainclusao
                     , decode(nf.situacao,'A','Ativa/Aprovado'
                                         ,'C','Cancelada'
                                         ,'P','Aguardando Aprovação'
                                         ,'E','Aguardando Envio para Aprovação'
                                         ,'U','Ajuste'
                                         ,'Ativa') situacaonota
                     , case when ex.idextratocontabancaria is not null then 'V2' else 'V1' end origem
                     , v.idvencimento
                     , v.datavencimento
                     , v.valor                                              valororiginal
                     , v.desconto
                     , v.acrescimo
                     , v.valor - nvl(v.desconto,0) + nvl(v.acrescimo,0)     valorvencimento
                     , case
                         when ex.idextratocontabancaria is not null then
                           case when ex.datamovimento < trunc(sysdate) + 1 then 'Pago' else 'Em aberto' end
                         when pg.databaixa is not null then 'Pago'
                         else 'Em aberto'
                       end situacaopagamento
                     , case
                         when ex.idextratocontabancaria is not null then
                           case when ex.datamovimento < trunc(sysdate) + 1 then ex.datamovimento end
                         else pg.databaixa
                       end datapagamento
                     , case
                         when ex.idextratocontabancaria is not null then
                           case when ex.datamovimento < trunc(sysdate) + 1 then v.valor - nvl(v.desconto,0) + nvl(v.acrescimo,0) end
                         when pg.databaixa is not null then pg.valorpago
                       end valorpago
                     , ( select c.nomeconta
                         from roman.contasfinanceiras c
                         where c.idcontafinan = v.idcontafinanceira ) conta
                     , ( select s.nomeconta
                         from roman.subcontasfinanceiras s
                         where s.idsubcontafinan = v.idsubcontafinanceira
                           and s.idcontafinan    = v.idcontafinanceira ) subconta
                     , decode(v.identificado,'S','Sim','N','Não') identificado
                from roman.notasfiscais nf
                join roman.vencimentos v                 on v.idnotafiscal  = nf.idnotafiscal
                left join roman.pagamentosfornecedores pg on pg.idvencimento = v.idvencimento
                -- V2: uma unica linha do extrato por vencimento (a primeira)
                left join roman.extratoscontasbancarias ex on ex.idvencimento = v.idvencimento
                                                         and not exists ( select 1
                                                                          from roman.extratoscontasbancarias e2
                                                                          where e2.idvencimento           = ex.idvencimento
                                                                            and e2.idextratocontabancaria < ex.idextratocontabancaria )
                -- Mesmos filtros da pagina 26 (Lista de Notas Fiscais)
                where nf.tiponota in ( 'C', 'R', 'D', 'A')
                  and nf.situacao != 'E'
                  and (:P26_IDFORNECEDOR      is null or nf.idfornemitente = :P26_IDFORNECEDOR )
                  and (:P26_TIPOFORNECEDOR is null
                        or exists ( select 1
                                      from fornecedores f
                                     where f.idfornecedor = nf.idfornemitente
                                       and f.tipo_fornecedor in ( select regexp_substr(:P26_TIPOFORNECEDOR, '[^/]+', 1, level)
                                                                    from dual
                                                                 connect by level <= regexp_count(:P26_TIPOFORNECEDOR, '/') + 1 ) ) )
                  and (:P26_IDFILIALEMITENTE  is null or nf.idfilialemitente = :P26_IDFILIALEMITENTE   )
                  and (:P26_DOCUMENTO         is null or trim(nf.documento) = trim(:P26_DOCUMENTO) )
                  and (:P26_SEMANA            is null or nf.idsemananota  = :P26_SEMANA)
                  and (:P26_ANO               = 0 or extract(year from nf.dtnf) = :P26_ANO )
                  and (:P26_ORIGEM_VENCIMENTO = 9
                    or (:P26_ORIGEM_VENCIMENTO = 1 and exists ( select 1
                                                                from vencimentos v1
                                                                where v1.idnotafiscal = nf.idnotafiscal )
                                                   and not exists ( select 1
                                                                    from extratoscontasbancarias ex1
                                                                    where ex1.idnotafiscal = nf.idnotafiscal ) )
                    or (:P26_ORIGEM_VENCIMENTO = 2 and exists ( select 1
                                                                from extratoscontasbancarias ex2
                                                                where ex2.idnotafiscal = nf.idnotafiscal ) ) )
                  and (:P26_FILTRAR_DATA      = 'N' or trunc(nf.DATAINCLUSAO) between to_date(:P26_DATAINICIO) and to_date(:P26_DATAFIM) )
                  and (:P26_TIPOFILIALDESTINO = 'X' or pck_romance.fnc_tipofilial(nf.idfilialdestino) = :P26_TIPOFILIALDESTINO )
                  and (:P26_SITUACAORECEBIMENTO = 'T'
                       or nf.situacaofilial = :P26_SITUACAORECEBIMENTO )
                  and (:P26_TIPOPRODUTO       = 'T' 
                       or ( :P26_TIPOPRODUTO       = 'V' and exists ( select 1
                                                                      from itemnf it
                                                                         , produtos p
                                                                      where it.idnotafiscal = nf.idnotafiscal
                                                                        and it.idproduto    = p.idproduto
                                                                        and p.venda         = 'S' ) )
                       or ( :P26_TIPOPRODUTO       = 'I' and exists ( select 1
                                                                      from itemnf it
                                                                         , produtos p
                                                                      where it.idnotafiscal = nf.idnotafiscal
                                                                        and it.idproduto    = p.idproduto
                                                                        and p.venda         = 'N' ) ) )
                ) x
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum vencimento encontrado para os filtros da Lista de Notas Fiscais.
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 2650563000000002
        }

