page 276 (
    name: Classificações de Produto
    title: Classificações de Produto
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region classificação-de-produto (
        name: Classificação de Produto
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P276_DATA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @classificação-de-produto
            slot: regionBody
        }
        default {
            type: expression
            plsqlExpression: sysdate
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P276_IDCARACTERISTICAPRODUTO (
        type: selectList
        label {
            label: Caracteristica
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select descricao
                     , idcaracteristicaproduto
                from caracteristicasprodutos 
                order by 2 
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 20
            region: @classificação-de-produto
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P276_IDCLASSIFICACAOPRODUTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @classificação-de-produto
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P276_IDPRODUTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @classificação-de-produto
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P276_IDUSUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @classificação-de-produto
            slot: regionBody
        }
        source {
            type: item
            item: P0_IDUSUARIO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidusuario number;
                begin
                  --
                  select idusuario
                  into vidusuario
                  from usuarios u
                  where u.usuario = v('APP_USER');
                  --
                  return vidusuario;
                  --
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P276_MD5 (
        type: hidden
        layout {
            sequence: 70
            region: @classificação-de-produto
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P276_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        layout {
            sequence: 60
            region: @classificação-de-produto
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
            height: 5
        }
        security {
            encryptSessionState: false
        }
    )

    button criar (
        buttonName: CRIAR
        label: Criar
        layout {
            sequence: 30
            region: @classificação-de-produto
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P276_IDCLASSIFICACAOPRODUTO
        }
    )

    button deletar (
        buttonName: DELETAR
        label: Deletar
        layout {
            sequence: 20
            region: @classificação-de-produto
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P276_IDCLASSIFICACAOPRODUTO
        }
    )

    button salvar (
        buttonName: SALVAR
        label: Salvar
        layout {
            sequence: 10
            region: @classificação-de-produto
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P276_IDCLASSIFICACAOPRODUTO
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 40
            region: @classificação-de-produto
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 11
                items: {
                    P11_IDPRODUTO: &P276_IDPRODUTO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process consulta-dml (
        name: "Consulta DML "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  PCK_CADASTROS_RMC.PRC_CLASSIFICACOESPRODUTOS( PIDCLASSIFICACAOPRODUTO => :P276_IDCLASSIFICACAOPRODUTO,
                                                                PIDCARACTERISTICAPRODUTO => :P276_IDCARACTERISTICAPRODUTO,
                                                                PIDPRODUTO => :P276_IDPRODUTO,
                                                                PIDUSUARIO => :P276_IDUSUARIO,
                                                                PDATA => :P276_DATA,
                                                                POBSERVACAO => :P276_OBSERVACAO,
                                                                PMD5 => :P276_MD5,
                                                                POPERACAO_DML => 'S');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1596479857187415948
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P276_IDCLASSIFICACAOPRODUTO
        }
    )

    process processo-dml-em-classificacoes-de-produtos (
        name: Processo DML em Classificacoes de Produtos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  --
                  if v('REQUEST') = 'CRIAR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'SALVAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'DELETAR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  PCK_CADASTROS_RMC.PRC_CLASSIFICACOESPRODUTOS( PIDCLASSIFICACAOPRODUTO => :P276_IDCLASSIFICACAOPRODUTO,
                                                                PIDCARACTERISTICAPRODUTO => :P276_IDCARACTERISTICAPRODUTO,
                                                                PIDPRODUTO => :P276_IDPRODUTO,
                                                                PIDUSUARIO => :P276_IDUSUARIO,
                                                                PDATA => :P276_DATA,
                                                                POBSERVACAO => :P276_OBSERVACAO,
                                                                PMD5 => :P276_MD5,
                                                                POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo executado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1600153534166745239
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('DELETAR','SALVAR','CRIAR')
                ```
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 276
                items: {
                    P276_IDPRODUTO: &P276_IDPRODUTO.
                    P276_IDCARACTERISTICAPRODUTO:
                    P276_IDUSUARIO: &P0_IDUSUARIO.
                    P276_DATA:
                    P276_OBSERVACAO:
                    P276_MD5:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

)

