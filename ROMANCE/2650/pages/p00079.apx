page 79 (
    name: Inclusão de cheques
    title: Inclusão de cheques
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
    )

    region inclusão-de-cheques (
        name: Inclusão de Cheques
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDCHEQUE",
                "IDCHEQUE" IDCHEQUE_DISPLAY,
                "LEITURA",
                "CODBANCO",
                "AGENCIA",
                "CONTA",
                "NRCHEQUE",
                "IDBANCO",
                "DATAINCLUSAO",
                "IDREPRESENTANTE",
                "IDCIDADE",
                "VALOR",
                "PREDATADO",
                "IDFORNECEDOR",
                "OBSERVACAO",
                "DESTINO",
                "CODCOMPENSACAO",
                "SEMFUNDO",
                "PAGO",
                "ENVIADOCOBRANCA",
                "DATACOBRANCA",
                "IDCONTBANC",
                "IDPESSOA"
                from "#OWNER#"."CHEQUES2"
                where 1 = 2
                ```
        }
        layout {
            sequence: 15
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P79_INCLUI
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Clique em Inserir Linhas!
        }
        componentAdvanced {
            stripHtml: true
        }

        column AGENCIA (
            reportColumnQueryId: 5
            derivedColumn: N
            type: hidden
            layout {
                sequence: 5
            }
        )

        column CODBANCO (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hidden
            layout {
                sequence: 4
            }
        )

        column CODCOMPENSACAO (
            reportColumnQueryId: 17
            derivedColumn: N
            type: hidden
            layout {
                sequence: 18
            }
        )

        column CONTA (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 6
            }
        )

        column DATACOBRANCA (
            reportColumnQueryId: 21
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 22
            }
        )

        column DATAINCLUSAO (
            reportColumnQueryId: 9
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 9
            }
            default {
                type: plsqlExpression
                plsqlExpression: SYSDATE
            }
        )

        column DESTINO (
            reportColumnQueryId: 16
            derivedColumn: N
            type: textField
            heading {
                heading: Destino
                alignment: center
            }
            layout {
                sequence: 17
            }
            appearance {
                width: 16
            }
        )

        column ENVIADOCOBRANCA (
            reportColumnQueryId: 20
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 21
            }
        )

        column IDBANCO (
            reportColumnQueryId: 8
            derivedColumn: N
            type: selectList
            heading {
                heading: Banco
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(nomebanco) display_value
                         , idbanco return_value
                    from bancos
                    order by 1
                    ```
                displayNullValue: false
            }
            layout {
                sequence: 8
            }
            default {
                type: item
                item: P79_IDBANCO
            }
        )

        column IDCHEQUE (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 1
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDCHEQUE
            }
        )

        column IDCHEQUE_DISPLAY (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column IDCIDADE (
            reportColumnQueryId: 11
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Cidade
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(nomecidade) ||' - '||e.sigla display_value
                    , idcidade return_value
                    from cidades c
                       , estados e
                    where c.idestado = e.idestado
                    order by 1
                    ```
                nullDisplayValue: - Seleciona a Cidade do Cheque -
            }
            layout {
                sequence: 12
            }
            appearance {
                width: 16
            }
        )

        column IDCONTBANC (
            reportColumnQueryId: 22
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Conta Bancária
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(nvl(cb.beneficiario,p.apelido)||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||')' display_value
                         , cb.idcontabanc    return_value
                    from contasbancarias cb
                       , bancos b
                       , pessoas p
                       , fornecedores f
                    where cb.idbanco      = b.idbanco
                      and cb.idfornecedor = f.idfornecedor
                      and f.idpessoa      = p.idpessoa
                      and f.idfornecedor  = cb.idfornecedor
                      and cb.idcontabanc   = :P79_IDCONTBANC
                    ```
                displayNullValue: false
            }
            layout {
                sequence: 23
            }
        )

        column IDFORNECEDOR (
            reportColumnQueryId: 14
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Fornecedor
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(nvl(p.apelido, p.nomepessoa)) display_value
                         , r.idfornecedor return_value
                    from fornecedores r
                       , pessoas p
                    where r.idpessoa = p.idpessoa
                    order by 1
                    ```
                nullDisplayValue: - Selecione o fornecedor destino -
            }
            layout {
                sequence: 15
            }
            default {
                type: item
                item: P79_IDFORNECEDOR
            }
        )

        column IDPESSOA (
            reportColumnQueryId: 23
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Pessoa
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(p.nomepessoa) display_value
                         , P.IDPESSOA return_value
                    from pessoas p
                    where p.ativo = 'S'
                    order by 1
                    ```
                nullDisplayValue: - Selecione a Pessoa -
            }
            layout {
                sequence: 10
            }
        )

        column IDREPRESENTANTE (
            reportColumnQueryId: 10
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Distribuidor
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_romance.fnc_nomepessoa(r.idpessoa)||' ( '||pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(r.idrepresentante))||' )' display_value
                         , r.idrepresentante return_value
                    from representantes r
                    order by 1
                    ```
                nullDisplayValue: - Selecione o Distribuidor -
            }
            layout {
                sequence: 11
            }
            appearance {
                width: 16
            }
            default {
                type: item
                item: P79_IDREPRESENTANTE
            }
        )

        column LEITURA (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 3
            }
        )

        column NRCHEQUE (
            reportColumnQueryId: 7
            derivedColumn: N
            type: textField
            heading {
                heading: Nr Cheque
                alignment: center
            }
            layout {
                sequence: 7
            }
            appearance {
                width: 16
            }
        )

        column OBSERVACAO (
            reportColumnQueryId: 15
            derivedColumn: N
            type: textField
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 16
            }
            appearance {
                width: 16
            }
        )

        column PAGO (
            reportColumnQueryId: 19
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 20
            }
        )

        column PREDATADO (
            reportColumnQueryId: 13
            derivedColumn: N
            type: datePicker
            heading {
                heading: Pré Datado
                alignment: center
            }
            layout {
                sequence: 14
            }
            appearance {
                width: 12
            }
        )

        column SEMFUNDO (
            reportColumnQueryId: 18
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 19
            }
            default {
                type: item
                item: P79_SEMFUNDO
            }
        )

        column VALOR (
            reportColumnQueryId: 12
            derivedColumn: N
            type: textField
            heading {
                heading: Valor
            }
            layout {
                sequence: 13
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990d00
                width: 16
            }
            advanced {
                customAttributes: style="text-align: right;"
            }
        )

    )

    pageItem P79_ENVIADOCOBRANCA (
        type: checkboxGroup
        label {
            label: Env. Cobrança
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2: ;S
            displayExtraValues: false
        }
        layout {
            sequence: 50
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P79_IDBANCO (
        type: selectList
        label {
            label: Banco
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nomebanco) display_value
                     , idbanco return_value
                from bancos
                order by 1
                ```
        }
        layout {
            sequence: 80
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P79_IDCONTBANC (
        type: selectList
        label {
            label: Conta Bancária
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(cb.beneficiario,p.apelido)||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||')' display_value
                     , cb.idcontabanc    return_value
                from contasbancarias cb
                   , bancos b
                   , pessoas p
                   , fornecedores f
                where cb.idbanco      = b.idbanco
                  and cb.idfornecedor = f.idfornecedor
                  and f.idpessoa      = p.idpessoa
                  and f.idfornecedor  = cb.idfornecedor
                  and f.idfornecedor  = :P79_IDFORNECEDOR
                union
                select initcap(nvl(cb.beneficiario,p.apelido)||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||')' display_value
                     , cb.idcontabanc    return_value
                from contasbancarias cb
                   , bancos b
                   , pessoas p
                where cb.idbanco  = b.idbanco
                  and cb.idpessoa = :P79_IDPESSOA
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P79_IDFORNECEDOR
        }
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P79_IDFORNECEDOR (
        type: popupLov
        label {
            label: Fornecedor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(p.apelido, p.nomepessoa)) display_value
                     , r.idfornecedor return_value
                from fornecedores r
                   , pessoas p
                where r.idpessoa = p.idpessoa
                order by 1
                ```
            nullDisplayValue: - Selecione o Fornecedor -
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P79_IDPESSOA (
        type: popupLov
        label {
            label: Pessoa
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) display_value
                     , P.IDPESSOA return_value
                from pessoas p
                where p.ativo = 'S'
                order by 1
                ```
            nullDisplayValue: - Selecione a Pessoa -
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P79_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(p.apelido, p.nomepessoa)||' ( '||nvl(pe.apelido, pe.nomepessoa)||' )') display_value
                     , r.idrepresentante return_value
                from representantes r
                   , pessoas p
                   , pessoas pe
                   , gerentes g
                   , filiais f
                where r.idpessoa = p.idpessoa
                  and r.idgerente = g.idgerente
                  and g.idfilial  = f.idfilial
                  and f.idpessoa = pe.idpessoa
                order by 1
                ```
        }
        layout {
            sequence: 70
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P79_INCLUI (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @filtro
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P79_SEMFUNDO (
        type: checkboxGroup
        label {
            label: Sem Fundo
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2: ;S
            displayExtraValues: false
        }
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button add (
        buttonName: ADD
        label: Adicionar Linha
        layout {
            sequence: 10
            region: @inclusão-de-cheques
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button incluir-cheques (
        buttonName: INCLUIR_CHEQUES
        label: Incluir Cheques
        layout {
            sequence: 50
            region: @filtro
            slot: bottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Salvar
        layout {
            sequence: 30
            region: @inclusão-de-cheques
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 60
            region: @filtro
            slot: aboveBox
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 43
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation idcidade-deve-ser-informado (
        name: IDCIDADE deve ser informado
        execution {
            sequence: 110
        }
        validation {
            editableRegion: @inclusão-de-cheques
            type: columnIsNotNull
            column: IDCIDADE
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ser informado!
            associatedColumn: IDCIDADE
        }
        serverSideCondition {
            whenButtonPressed: @submit
            type: never
        }
    )

    validation idrepresentante-deve-ser-informado (
        name: IDREPRESENTANTE deve ser informado
        execution {
            sequence: 100
        }
        validation {
            editableRegion: @inclusão-de-cheques
            type: columnIsNotNull
            column: IDREPRESENTANTE
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ser informado!
            associatedColumn: IDREPRESENTANTE
        }
        serverSideCondition {
            type: never
        }
    )

    validation predatado-deve-ser-informada (
        name: PREDATADO deve ser informada!
        execution {
            sequence: 130
        }
        validation {
            editableRegion: @inclusão-de-cheques
            type: columnIsNotNull
            column: PREDATADO
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ser informada!
            associatedColumn: PREDATADO
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation valor-deve-ser-informado (
        name: VALOR deve ser informado
        execution {
            sequence: 120
        }
        validation {
            editableRegion: @inclusão-de-cheques
            type: columnIsNotNull
            column: VALOR
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ser informado!
            associatedColumn: VALOR
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @inclusão-de-cheques
        target {
            tableName: CHEQUES2
            pkColumn: IDCHEQUE
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRI_COUNT# cheque(s) inserido(s).
        }
        error {
            errorMessage: Não foi possivel incluir o(s) cheque(s)!
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 180195835264330342
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        name: Go To Page 79
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 79
                items: {
                    P79_IDFORNECEDOR: &P79_IDFORNECEDOR.
                    P79_IDCONTBANC: &P79_IDCONTBANC.
                    P79_SEMFUNDO: &P79_SEMFUNDO.
                    P79_ENVIADOCOBRANCA: &P79_ENVIADOCOBRANCA.
                    P79_IDREPRESENTANTE: &P79_IDREPRESENTANTE.
                    P79_IDBANCO: &P79_IDBANCO.
                    P79_INCLUI: S
                }
            }
        }
    )

)

