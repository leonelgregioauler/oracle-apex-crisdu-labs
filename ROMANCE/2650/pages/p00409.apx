        }
    )

    dynamicAction submit-data-fim (
        name: Submit Data Fim
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P409_DATAFIM
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction submit-dataini (
        name: Submit DataIni
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P409_DATAINICIO
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process alimenta-datas (
        name: Alimenta Datas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  select p.datainicio
                       , p.datafim
                  into :P409_DATAINICIO
                     , :P409_DATAFIM
                  from provisoespagamentos p
                  where p.idprovisaopagamento = ( select max(pp.idprovisaopagamento)
                                                  from provisoespagamentos pp );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 5497369933458153246
        }
        serverSideCondition {
            type: itemIsNull
            item: P409_DATAINICIO
        }
    )

    branch (
        name: Filtrar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 409
                items: {
                    P409_DATAINICIO: &P409_DATAINICIO.
                    P409_DATAFIM: &P409_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: FILTRAR
        }
    )

)

