    pageItem P306_TIPOPAGAMENTO (
        type: radioGroup
        label {
            label: Tipo de Pagamento
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ' - Todos -'
                     , 'Y'
                from dual
                union
                select f.descricao
                     , u.idformapagamento
                from usuariosformaspagamentos u
                   , formaspagamentos f
                where u.idformapagamento = f.idformapagamento
                  and u.idusuario        = :P0_IDUSUARIO
                  and u.idformapagamento != 'P'
                order by 1 -- T12514877
                
                /*select ' - Todos -'
                     , 'Y'
                from dual
                union
                select f.descricao
                     , u.idformapagamento
                from usuariosformaspagamentos u
                   , formaspagamentos f
                where u.idformapagamento = f.idformapagamento
                  and u.idusuario        = :P0_IDUSUARIO
                order by 1*/
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
