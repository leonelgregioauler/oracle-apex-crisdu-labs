    pageItem P306_NOMECONTA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 220
            region: @filtros
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select distinct(b.nomebanco||' - Agencia: '||c.agencia||' / Conta: '||c.conta||' do benef. '||c.beneficiario) conta
                from contasbancarias c
                   , bancos b
                where c.idpessoa = 16625
                  and b.idbanco = c.idbanco
                  and c.ativo = 'S'
                  and c.idcontabanc = :P306_IDCONTAPAGAMENTO
                order by 1
                ```
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vconta varchar2(100);
                begin
                  --
                  select distinct(b.nomebanco||' - Agencia: '||c.agencia||' / Conta: '||c.conta||' do benef. '||c.beneficiario) conta
                  into vconta
                  from contasbancarias c
                     , bancos b
                  where c.idpessoa = 16625
                    and b.idbanco = c.idbanco
                    and c.ativo = 'S'
                    and c.idcontabanc = :P306_IDCONTAPAGAMENTO;
                  --
                  return vconta;
                  --
                exception
                  when others then
                    return ' CONTA NÃO SELECIONADA';
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

