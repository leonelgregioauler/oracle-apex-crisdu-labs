    dynamicAction valida (
        name: Valida
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P306_DATA_PAGAMENTO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                        select 1
                          into :P306_VALIDADATA
                          from dual 
                          where :P306_DATA_PAGAMENTO <= trunc (sysdate);
                      exception
                        when no_data_found then
                          :P306_VALIDADATA := 0;  
                    end;
                    ```
                itemsToSubmit: P306_DATA_PAGAMENTO
                itemsToReturn: P306_VALIDADATA
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation valida-conta-para-pagamento (
        name: Valida Conta para Pagamento
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P306_IDCONTAPAGAMENTO
        }
        error {
            errorMessage: Por favor, identifique a conta que será realizado o pagamento.
        }
        serverSideCondition {
            type: request=Value
            value: LIQUIDAR
        }
    )

    validation valida-data-para-pagamento (
        name: Valida Data para Pagamento
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentomovimentacoes m
                where m.datafechamento = to_date(:P306_DATA_PAGAMENTO)
                  and m.idcontabancaria = :P306_IDCONTAPAGAMENTO
                ```
        }
        error {
            errorMessage: Fechamento já encerrado para este dia! Entre em contato com o responsável pelo fechamento.
            associatedItem: @P306_DATA_PAGAMENTO
        }
        serverSideCondition {
            whenButtonPressed: @liquidar
        }
    )

    validation valida-dt-pagamento (
        name: Valida Dt Pagamento
        execution {
            sequence: 30
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where :P306_DATA_PAGAMENTO > trunc (sysdate)
                ```
        }
        error {
            errorMessage: "Não é Permitido Lançamento Com Data Futura "
            associatedItem: @P306_DATA_PAGAMENTO
        }
    )

    process liquida-faturas-selecionadas (
        name: Liquida Faturas Selecionadas
        type: executeCode
        editableRegion: @liquidar-faturas
        source {
            plsqlCode:
                ```plsql
                declare
                  vidcontapagamento number := :P306_IDCONTAPAGAMENTO;
                  vdesconto         number := to_number(replace(:DESCONTO,'.',''));
                  vacrescimo        number := to_number(replace(:ACRESCIMO,'.',''));
                  vvalorapagar      VARCHAR2(20) := replace(:VALORPAGAR,'.','');
                begin
                  --
                  update pagamentosfornecedores pg
                  set pg.desconto      = vdesconto
                    , pg.acrescimo     = vacrescimo
                    , pg.idcontabanc   = :P306_IDCONTA_FORNECEDOR
                    , pg.databaixa     = :P306_DATA_PAGAMENTO
                    , pg.transferencia = :P306_POR_TRANSFERENCIA
                    , pg.idcontapagamento = :P306_IDCONTAPAGAMENTO
                    , pg.datapagto = sysdate
                  where pg.idpgtoforn = :IDPGTOFORN;
                  --
                  commit;
                  --
                  insert into depositosdiarios ( iddepositodiarios  , data          , idrepresentante
                                               , idpgtoforn         , valordeposito , comprovado
                                               , tipo               , valororiginal , tipopagamento 
                                               , idcontapagamento   , idcontabanc  )
                  select seq_iddepositodiarios.nextval         , :P306_DATA_PAGAMENTO , 49565
                       , p.idpgtoforn                          , vvalorapagar         , 'S'        
                       , decode(p.tipopagamento,'M','M','DD' ) , vvalorapagar         , p.tipopagamento
                       , vidcontapagamento                     , :P306_IDCONTA_FORNECEDOR
                  from pagamentosfornecedores p
                  where idpgtoforn = :IDPGTOFORN;
                  --
                  pck_financeiro_rmc.prc_atualiza_pagtoforn ( :IDPGTOFORN );
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Faturas liquidadas.
        }
        advanced {
            executionMappingIdentifier: 56928868222555821
        }
        serverSideCondition {
            type: request=Value
            value: LIQUIDAR
        }
    )

    branch (
        name: Go To Page 306
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 306
                items: {
                    P306_IDFORNECEDOR: &P306_IDFORNECEDOR.
                    P306_IDFILIAL: &P306_IDFILIAL.
                    P306_ANO: &P306_ANO.
                    P306_TIPO: &P306_TIPO.
                    P306_TIPOPAGAMENTO: &P306_TIPOPAGAMENTO.
                    P306_DATAINICIO: &P306_DATAINICIO.
                    P306_DATAFIM: &P306_DATAFIM.
                    P306_IDCONTAPAGAMENTO: &P306_IDCONTAPAGAMENTO.
                    P306_FILTRAR: S
                    P306_RAZAO_SOCIAL: &P306_RAZAO_SOCIAL.
                    P306_PAGAMENTO_ANTECIPADO: &P306_PAGAMENTO_ANTECIPADO.
                    P306_PERC_DESCONTO: &P306_PERC_DESCONTO.
                    P306_VALOR_DESCONTO: &P306_VALOR_DESCONTO.
                    P306_PAGAMENTO_ATRASADO: &P306_PAGAMENTO_ATRASADO.
                    P306_PERC_ATRASO: &P306_PERC_ATRASO.
                    P306_VALOR_ATRASO: &P306_VALOR_ATRASO.
                    P306_IDCONTA_FORNECEDOR: &P306_IDCONTA_FORNECEDOR.
                    P306_POR_TRANSFERENCIA: &P306_POR_TRANSFERENCIA.
                    P306_DATA_PAGAMENTO: &P306_DATA_PAGAMENTO.
                    P306_NRFATURA: &P306_NRFATURA.
                    P306_TIPO_RAZAO_SOCIAL: &P306_TIPO_RAZAO_SOCIAL.
                    P306_IDBANCO: &P306_IDBANCO.
                    P306_IDGRUPOFINANCEIRO: &P306_IDGRUPOFINANCEIRO.
                }
            }
        }
        serverSideCondition {
            type: request=Value
            value: FILTRAR
        }
    )

    branch (
        name: Go To Page 306 Liquidar
        execution {
            sequence: 11
        }
        behavior {
            target: {
                page: 306
                items: {
                    P306_IDFORNECEDOR: &P306_IDFORNECEDOR.
                    P306_IDFILIAL: &P306_IDFILIAL.
                    P306_ANO: &P306_ANO.
                    P306_TIPO: &P306_TIPO.
                    P306_TIPOPAGAMENTO: &P306_TIPOPAGAMENTO.
                    P306_DATAINICIO: &P306_DATAINICIO.
                    P306_DATAFIM: &P306_DATAFIM.
                    P306_IDCONTAPAGAMENTO: &P306_IDCONTAPAGAMENTO.
                    P306_FILTRAR: N
                    P306_RAZAO_SOCIAL:
                    P306_PAGAMENTO_ANTECIPADO:
                    P306_PERC_DESCONTO:
                    P306_VALOR_DESCONTO:
                    P306_PAGAMENTO_ATRASADO:
                    P306_PERC_ATRASO:
                    P306_VALOR_ATRASO:
                    P306_IDCONTA_FORNECEDOR:
                    P306_POR_TRANSFERENCIA:
                    P306_DATA_PAGAMENTO:
                    P306_NRFATURA:
                    P306_TIPO_RAZAO_SOCIAL:
                    P306_IDBANCO:
                    P306_IDGRUPOFINANCEIRO: &P306_IDGRUPOFINANCEIRO.
                }
            }
        }
        serverSideCondition {
            type: request=Value
            value: LIQUIDAR
        }
    )

)

