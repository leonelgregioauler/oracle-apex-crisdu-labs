    pageItem P306_IDCONTAPAGAMENTO (
        type: popupLov
        label {
            label: Conta para Pagamento
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct(b.nomebanco||' - Agencia: '||c.agencia||' / Conta: '||c.conta||' Beneficiario: '||c.beneficiario) display_value
                     , c.idcontabanc return_value
                from contasbancarias c
                   , bancos b
                where c.idpessoa = 16625
                  and b.idbanco = c.idbanco
                  and c.ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 210
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 100
        }
        security {
