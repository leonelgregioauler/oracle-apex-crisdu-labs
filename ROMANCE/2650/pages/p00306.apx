page 306 (
    name: Liquidar Faturas
    title: Liquidar Faturas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function somavalor() {
               var theForm = document.wwv_flow;
               var vTemp = 0;
               var vNum = 0;
                
               document.getElementById('P306_VALORSELECIONADO').value = vTemp.formatMoney(2, ",", ".");
               
               for(i=0;i<theForm.f01.length;i++){
                    if(theForm.f01[i].checked){
                        vNum = $(theForm.f05[i]).val();
                        vNum = vNum.replace('.', '').replace(',','.');
                        vTemp = parseFloat(vTemp) + parseFloat(vNum);
                    }
               }
              
              document.getElementById('P306_VALORSELECIONADO').value = vTemp.formatMoney(2, ",", ".");
            }
            
            
            function fnc_liquidafatura(vvalor,vconta,vdata) {
              var answer = confirm("Confirma o pagamento das faturas no total de R$ "+ vvalor +" na conta "+vconta+" para o dia "+vdata+"?")
              if (answer)
                {
                  apex.submit('LIQUIDAR');
                }
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region faturas-pagas (
        name: Faturas Pagas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct pagforn.dtvencimento
                     , pagforn.idpgtoforn
                     , to_char(pagforn.dtvencimento, 'MONTH') "Mês"
                     , ( select pck_romance.fnc_nomefilial( nf.idfilialdestino ) 
                         from notasfiscais    nf
                         where nf.idnotafiscal  = pagforn.idnotafiscal ) "Filial Destino"
                     , ( select cnpj||' - '||razaosocial 
                          from razoessociaisfiliais e
                          where e.idrazaosocialfilial = ( select nf.idrazaosocialfildestino
                                                         from notasfiscais    nf
                                                         where nf.idnotafiscal  =pagforn.idnotafiscal ) ) "Id. Fil Destino"
                     , to_char(pagforn.dtlancamento,'RRRR') ano
                     , ( select TRIM(to_char(s.semana,'00')||'/'||s.ano ||'(' )|| to_char(s.dt_ini,'DD/MM/YYYY') ||' a '|| to_char(s.dt_fim,'DD/MM/YYYY')||')'  
                         from semana_dias s
                         where pagforn.dtvencimento between s.dt_ini and s.dt_fim ) Semana
                     , ( select s.semana  
                         from semana_dias s
                         where pagforn.dtvencimento between s.dt_ini and s.dt_fim ) Semanan
                     , nvl(pck_romance.fnc_nomefornecedor(pidforn => pagforn.idfornecedor),'-')  Fornecedor
                     , decode(pagforn.identificado, null, '-'
                                                   , 'N' , 'Sem Identificação'
                                                   , 'S' , ( select cnpj||' - '||razaosocial 
                                                              from razoessociaisfornec e
                                                              where e.idrazaosocialforn = ( select nf.idrazaosocialfornemit
                                                                                             from notasfiscais    nf
                                                                                             where nf.idnotafiscal  =pagforn.idnotafiscal ) ) ) identificacao
                     , pagforn.IDFORNECEDOR
                     , pagforn.idcheque
                     , ( select nf.documento
                         from notasfiscais    nf
                         where nf.idnotafiscal  =pagforn.idnotafiscal ) nrnf
                     , case 
                         when :P306_PAGAMENTO_ANTECIPADO = 'S' and :P306_PERC_DESCONTO is not null then
                           round(pagforn.valorpagar * ((100-(( (dtvencimento - to_date(:P306_DATA_PAGAMENTO)) * to_number(replace(:P306_PERC_DESCONTO,'.',',')) ) / 30 ))/100),2)
                         when :P306_PAGAMENTO_ANTECIPADO = 'S' and :P306_VALOR_DESCONTO is not null then
                           pagforn.valorpagar - to_number(replace(:P306_VALOR_DESCONTO,'.',','))
                         when :P306_PAGAMENTO_ATRASADO = 'S' and :P306_PERC_ATRASO is not null then
                           round(pagforn.valorpagar * ((100+round(( (to_date(:P306_DATA_PAGAMENTO)-dtvencimento) * to_number(replace(:P306_PERC_ATRASO,'.',',')) ) / 30 ,2 ))/100),2)
                         when :P306_PAGAMENTO_ATRASADO = 'S' and :P306_VALOR_ATRASO is not null then
                           pagforn.valorpagar + to_number(replace(:P306_VALOR_ATRASO,'.',','))
                         when pagforn.valorpago != 0 then
                           pagforn.valorpago + nvl(desconto,0) - nvl(acrescimo,0)
                         else 
                           pagforn.valorpagar
                       end ValorPagar
                     , pagforn.valorpago ValorPago
                     , case 
                         when :P306_PAGAMENTO_ANTECIPADO = 'S' and :P306_PERC_DESCONTO is not null then
                           pagforn.valorpago - round(pagforn.valorpagar * ((100-(( (dtvencimento - to_date(:P306_DATA_PAGAMENTO)) * to_number(replace(:P306_PERC_DESCONTO,'.',',')) ) / 30 ))/100),2)
                         when :P306_PAGAMENTO_ANTECIPADO = 'S' and :P306_VALOR_DESCONTO is not null then
                           pagforn.valorpago - ( pagforn.valorpagar - to_number(replace(:P306_VALOR_DESCONTO,'.',',')) )
                         when :P306_PAGAMENTO_ATRASADO = 'S' and :P306_PERC_ATRASO is not null then
                           pagforn.valorpago - round(pagforn.valorpagar * ((100+round(( (to_date(:P306_DATA_PAGAMENTO)-dtvencimento) * to_number(replace(:P306_PERC_ATRASO,'.',',')) ) / 30 ,2 ))/100),2)
                         when :P306_PAGAMENTO_ATRASADO = 'S' and :P306_VALOR_ATRASO is not null then
                           pagforn.valorpago - ( pagforn.valorpagar + to_number(replace(:P306_VALOR_ATRASO,'.',',')) )
                         else 
                           pagforn.valorpago - pagforn.valorpagar + nvl(desconto,0) - nvl(acrescimo,0)
                       end Saldo
                     , ( select cb.beneficiario||' <br> '||b.nomebanco
                              ||' - '|| cb.agencia ||' - '|| cb.conta--||' - '||cb.idcontabanc
                         from contasbancarias cb
                            , bancos b
                         where cb.idbanco         = b.idbanco 
                           and cb.idcontabanc = pagforn.idcontabanc)  conta
                     , ( select descricao
                         from formaspagamentos t
                         where idformapagamento = pagforn.tipopagamento ) "Tipo Pagamento"
                     , pagforn.idvencimento
                     , pagforn.idfilial
                     , ( select sum(d.valordeposito)
                         from depositosdiarios_orig d
                         where d.idpgtoforn = pagforn.idpgtoforn ) depositado
                     , ( select sum(d.Valororiginal)
                         from depositosdiarios d
                         where d.idpgtoforn = pagforn.idpgtoforn ) totaldepositado
                     , ( select pck_romance.fnc_nomefornecedor(n.idfornecedordestino) 
                         from notasfiscais n
                         where n.idnotafiscalcompra = pagforn.idnotafiscal ) Cliente
                     , ( select cb.beneficiario||' <br> '||b.nomebanco
                              ||' - '|| cb.agencia ||' - '||
                              cb.conta--||' - '||cb.idcontabanc
                         from contasbancarias cb
                            , bancos b
                         where cb.idbanco         = b.idbanco 
                           and cb.idcontabanc = ( select idcontabancraiz
                                                  from contasbancarias
                                                  where idcontabanc =  pagforn.idcontabanc))  "Conta Raíz"
                     ,  ( select n.situacao 
                               from notasfiscais n
                               where n.idnotafiscal =  pagforn.idnotafiscal  ) situacaonota
                     , pagforn.observacao "Observação"
                     , decode(identificado,'S','Sim','Não') "Identificado"
                    , pck_util.fnc_siglamoedaid( pagforn.idmoeda) moeda
                    , pagforn.idcontabanc
                    ,  case
                                  when ( select r.cnpj
                                         from razoessociaisfornec r
                                            , notasfiscais        n
                                         where r.idrazaosocialforn = n.idrazaosocialfornemit
                                           and n.idnotafiscal      = pagforn.idnotafiscal ) like '07318638%' then
                                         'Sim'
                                  when ( select r.cnpj
                                         from razoessociaisfornec r
                                            , notasfiscais        n
                                         where r.idrazaosocialforn = n.idrazaosocialforndest 
                                           and n.idnotafiscal      = pagforn.idnotafiscal ) like '07318638%' then
                                         'Sim'
                                  when ( select cnpj
                                         from razoessociaisfiliais re
                                            , notasfiscais        n
                                         where re.idrazaosocialfilial = n.idrazaosocialfilemit 
                                           and n.idnotafiscal      = pagforn.idnotafiscal ) like '07318638%' then
                                         'Sim'
                                  when ( select  cnpj
                                         from razoessociaisfiliais re
                                            , notasfiscais        n
                                         where re.idrazaosocialfilial = n.idrazaosocialfildestino 
                                           and n.idnotafiscal      = pagforn.idnotafiscal ) like '07318638%' then
                                         'Sim'
                                  else 
                                    'Não'
                                 end crisdu
                     , decode(PRIORIDADE,null, '-', 'Prioridade') prioridade
                     , decode(AUTOMATIZAR,'S','Sim','Não') automatizado
                     , ( select s.idsemana  
                         from semana_dias s
                         where pagforn.dtvencimento between s.dt_ini and s.dt_fim ) idsemana
                     , null novodeposito
                     , trunc(dtlancamento) lancamento
                     , null verpgto
                     , case
                         when :P306_PAGAMENTO_ANTECIPADO = 'S' and :P306_PERC_DESCONTO is not null then
                           pagforn.valorpagar - round(pagforn.valorpagar * ((100-(( (dtvencimento - to_date(:P306_DATA_PAGAMENTO)) * to_number(replace(:P306_PERC_DESCONTO,'.',',')) ) / 30 ))/100),2)
                         when :P306_PAGAMENTO_ANTECIPADO = 'S' and :P306_VALOR_DESCONTO is not null then
                           to_number(replace(:P306_VALOR_DESCONTO,'.',','))
                         else 
                           nvl(desconto,0)
                       end desconto
                     , case
                         when :P306_PAGAMENTO_ATRASADO = 'S' and :P306_PERC_ATRASO is not null then
                           round(pagforn.valorpagar * ((100+round(( (to_date(:P306_DATA_PAGAMENTO) - dtvencimento) * to_number(replace(:P306_PERC_ATRASO,'.',',')) ) / 30 ,2 ))/100),2) - pagforn.valorpagar
                         when :P306_PAGAMENTO_ATRASADO = 'S' and :P306_VALOR_ATRASO is not null then
                           to_number(replace(:P306_VALOR_ATRASO,'.',','))
                         else
                           nvl(acrescimo,0)
                       end acrescimo
                     , dtvencimento - to_date(:P306_DATA_PAGAMENTO) dias
                     , pagforn.valorpagar valororiginal
                     , pagforn.databaixa
                     , decode(pagforn.BANCOAGENDADO,'S','Sim','Não') BANCOAGENDADO
                from pagamentosfornecedores pagforn
                where pagforn.idcheque is null
                  and pagforn.tipopagamento is not null
                  and pagforn.tipopagamento != 'D'
                  and ( :P306_DATAINICIO is null
                       or ( :P306_TIPO = 'T' and trunc(pagforn.dtvencimento) between to_date(:P306_DATAINICIO) and to_date(:P306_DATAFIM) )
                       or ( :P306_TIPO != 'T' and trunc(pagforn.dtvencimento) between to_date(:P306_DATAINICIO) and to_date(:P306_DATAFIM) ) )
                  and ( :P306_TIPOPAGAMENTO = 'Y' or pagforn.tipopagamento = :P306_TIPOPAGAMENTO )
                  and ( :P306_IDFORNECEDOR is null or pagforn.idfornecedor = :P306_IDFORNECEDOR )
                  and ( :P306_IDBANCO is null or exists ( select 1
                                                          from contasbancarias cb
                                                          where cb.idcontabanc = pagforn.idcontabanc
                                                            and cb.idbanco     = :P306_IDBANCO ) )
                  and ( :P306_NRFATURA is null or exists ( select 1
                                                           from notasfiscais nf
                                                           where nf.idnotafiscal = pagforn.idnotafiscal
                                                             and ( nf.documento = :P306_NRFATURA
                                                                or exists ( select 1
                                                                            from lancamentosdiversos lc
                                                                            where lc.documento = :P306_NRFATURA
                                                                              and lc.idnotafiscalgerada = nf.idnotafiscal ) ) ) )
                  and ( :P306_IDGRUPOFINANCEIRO is null or exists ( select 1
                                                                    from notasfiscais nf
                                                                       , razoessociaisfiliais rz 
                                                                    where nf.idnotafiscal    = pagforn.idnotafiscal
                                                                      and nf.IDRAZAOSOCIALFILDESTINO = rz.idrazaosocialfilial 
                                                                      and rz.idgrupofinanceiro = :P306_IDGRUPOFINANCEIRO ) )
                  and ( :P306_TIPO_RAZAO_SOCIAL is null
                     or ( :P306_TIPO_RAZAO_SOCIAL = 'G' and exists ( select 1
                                                                     from notasfiscais nf
                                                                        , razoessociaisfiliais rz
                                                                        , filtrosrazoessociais fr
                                                                     where nf.idnotafiscal    = pagforn.idnotafiscal
                                                                       and nf.IDRAZAOSOCIALFILDESTINO = rz.idrazaosocialfilial
                                                                       and trim(rz.cnpj) = trim(fr.cnpj)                    
                                                                       and fr.usuario = v('APP_USER') ) )
                     or ( :P306_TIPO_RAZAO_SOCIAL = 'S' and ( :P306_RAZAO_SOCIAL is null or exists ( select 1
                                                                                                     from notasfiscais nf
                                                                                                     where nf.idnotafiscal    = pagforn.idnotafiscal
                                                                                                       and nf.IDRAZAOSOCIALFILDESTINO = :P306_RAZAO_SOCIAL ) ) ) )
                  and ( :P306_IDFILIAL is null or exists ( select 1
                                                           from notasfiscais nf
                                                           where nf.idnotafiscal    = pagforn.idnotafiscal
                                                             and nf.idfilialdestino = :P306_IDFILIAL
                                                             and ( :P306_RAZAO_SOCIAL is null or nf.IDRAZAOSOCIALFILDESTINO = :P306_RAZAO_SOCIAL ) ) )
                  and ( :P306_ANO = 1 or extract(year from dtvencimento) = :P306_ANO ) 
                  and ( pagforn.valorpago + nvl(pagforn.desconto,0) - pagforn.valorpagar ) = 0 
                  and :P306_TIPO = 'Z'
                  and (:P306_IDENTIFICACAO is null or (exists (select 1
                                                                 from notasfiscais nf
                                                                where nf.idnotafiscal = pagforn.idnotafiscal
                                                                  and nf.idrazaosocialfornemit = :P306_IDENTIFICACAO)))
                  -- Maicon Aimi - 12/03/2025 - 9937321 - Adicionado filtro por PAGAMENTO AGENDADO
                  and (    (:P306_PAGAMENTO_AGENDADO = 'A') 
                        or (:P306_PAGAMENTO_AGENDADO = 'S' and pagforn.pgtoagendado = 'S')
                        or (:P306_PAGAMENTO_AGENDADO = 'N' and pagforn.pgtoagendado = 'N'))
                  and (:P306_AGENDADOBANCO = 'A' or nvl(pagforn.BANCOAGENDADO,'N') = :P306_AGENDADOBANCO) -- 10054576
                order by pagforn.valorpagar desc
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P306_TIPO
            value: Z
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 4984647298540827946
        }

