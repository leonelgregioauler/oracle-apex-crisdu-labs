    button liquidar (
        buttonName: LIQUIDAR
        label: Liquidar Faturas
        layout {
            sequence: 10
            region: @liquidar-faturas
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: fnc_liquidafatura(document.getElementById('P306_VALORSELECIONADO').value,document.getElementById('P306_NOMECONTA').value,document.getElementById('P306_DATA_PAGAMENTO').value);
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction mensagem (
        name: mensagem
        execution {
            sequence: 70
        }
        when {
            selectionType: items
            items: P306_VALIDADATA
        }
        clientSideCondition {
            type: item=value
            item: P306_VALIDADATA
            value: 0
        }

        action native-alert (
            action: alert
            settings {
                message: Não é Permitido Lançamento Com Data Futura
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

