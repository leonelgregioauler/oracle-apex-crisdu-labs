        }
    )

    pageItem P306_IDCONTA_FORNECEDOR (
        type: selectList
        label {
            label: Conta do Fornecedor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(cb.beneficiario||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||') - Fornecedor: '||pck_romance.fnc_nomefornecedor(f.idfornecedor) display_value
                     , cb.idcontabanc    return_value
                from contasbancarias cb
                   , bancos b
                   , fornecedores f
                where cb.idbanco      = b.idbanco
                  and cb.idpessoa     = f.idpessoa
                  and cb.ativo        = 'S'
                  and f.idfornecedor = :P306_IDFORNECEDOR
                order by 1
                ```
            nullDisplayValue: - Selecione a Conta -
        }
        cascadingLov {
            parentItems: P306_IDFORNECEDOR
        }
        layout {
            sequence: 270
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P306_IDENTIFICACAO (
        type: selectOne
        label {
            label: Identificação Emitente
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select (initcap(e.razaosocial)||' - CNPJ: '||e.cnpj) razaosocial
                     , e.idrazaosocialforn
                  from roman.razoessociaisfornec e
                 where e.idrazaosocialforn in ( select distinct nf.idrazaosocialfornemit
                                                 from roman.notasfiscais nf
                                                where nf.idrazaosocialfornemit is not null)
                order by e.razaosocial
                ```
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 500
        }
    )

