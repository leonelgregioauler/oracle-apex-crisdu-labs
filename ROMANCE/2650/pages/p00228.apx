page 228 (
    name: Grupos de Usuários ( Portal )
    title: Grupos de Usuários ( Portal )
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region grupos-de-usuários-portal (
        name: Grupos de Usuários ( Portal )
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region usuários (
        name: Usuários
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDGRUPOUSUARIO",
                "IDGRUPOUSUARIO" IDGRUPOUSUARIO_DISPLAY,
                "IDGRUPOUSU",
                "USUARIO"
                from "#OWNER#"."GRUPOSUSUARIOS"
                where idgrupousu = :P228_IDGRUPO
                ```
        }
        layout {
            sequence: 15
            parentRegion: @grupos-de-usuários-portal
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P228_IDGRUPO
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhum usuário incluído.
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 1
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column IDGRUPOUSU (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 4
            }
            default {
                type: item
                item: P228_IDGRUPO
            }
        )

        column IDGRUPOUSUARIO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDGRUPOSUSUARIOS
            }
        )

        column IDGRUPOUSUARIO_DISPLAY (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

        column USUARIO (
            reportColumnQueryId: 5
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Usuário
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(p.nomepessoa) ||' - '||pck_romance.fnc_nomefilial(pck_romance.fnc_filialusuario(u.usuario) ) display_value
                         , u.usuario return_value
                    from usuarios u
                       , pessoas p
                    where u.idpessoa = p.idpessoa
                      and u.ativo = 'S'
                      and cpf is not null
                    order by 1 
                    ```
                displayNullValue: false
            }
            layout {
                sequence: 5
            }
            appearance {
                width: 50
            }
        )

    )

    pageItem P228_IDGRUPO (
        type: hidden
        layout {
            sequence: 10
            region: @grupos-de-usuários-portal
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDGRUPO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P228_NOME (
        type: textField
        label {
            label: Nome
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @grupos-de-usuários-portal
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 100
        }
        source {
            type: databaseColumn
            databaseColumn: NOME
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button add (
        buttonName: ADD
        label: Adicionar Linha
        layout {
            sequence: 40
            region: @usuários
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.widget.tabular.addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 40
            region: @grupos-de-usuários-portal
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P228_IDGRUPO
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @grupos-de-usuários-portal
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P228_IDGRUPO
        }
    )

    button multi-row-delete (
        buttonName: MULTI_ROW_DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @usuários
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'MULTI_ROW_DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @grupos-de-usuários-portal
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P228_IDGRUPO
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Salvar
        layout {
            sequence: 30
            region: @usuários
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation idgrupousu-must-be-numeric (
        name: IDGRUPOUSU must be numeric
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @usuários
            type: columnIsNumeric
            column: IDGRUPOUSU
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: IDGRUPOUSU
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @usuários
        target {
            tableName: GRUPOSUSUARIOS
            pkColumn: IDGRUPOUSUARIO
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: #MRD_COUNT# row(s) deleted.
        }
        advanced {
            executionMappingIdentifier: 279101529138995165
        }
        serverSideCondition {
            type: request=Value
            value: MULTI_ROW_DELETE
            executeCondition: once
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @usuários
        target {
            tableName: GRUPOSUSUARIOS
            pkColumn: IDGRUPOUSUARIO
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# linha(s) atualizada(s), #MRI_COUNT# linha(s) inserida(s).
        }
        advanced {
            executionMappingIdentifier: 279101314148995160
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process fetch-row-from-gruposusu (
        name: Fetch Row from GRUPOSUSU
        type: autoRowFetch
        source {
            tableName: GRUPOSUSU
            pkColumn: IDGRUPO
            pkItem: P228_IDGRUPO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 279081801646919894
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P228_IDGRUPO is null then
                        select "SEQ_IDGRUPOSUSU".nextval
                          into :P228_IDGRUPO
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 279082002269919944
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-gruposusu (
        name: Process Row of GRUPOSUSU
        type: autoRowProcessing
        target {
            tableName: GRUPOSUSU
            pkColumn: IDGRUPO
            pkItem: P228_IDGRUPO
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 279082218696919944
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 279082404812919944
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 11
        }
        behavior {
            target: {
                page: 227
            }
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 228
            }
        }
    )

)

