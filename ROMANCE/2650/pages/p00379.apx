page 379 (
    name: Anexos Lançamentos
    title: Anexos Lançamentos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 40%
        height: 65%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function fnc_verimg(pid)
            {
              window.open('http://anexos.romancemoda.com.br/'+pid);
              void(0);
            }
            
            
            function fnc_removeanexo(pidanexo,pnomeanexo)
            {
                apex.confirm("Deseja realmente remover o anexo "+pnomeanexo+"?", {
              request:"DELETAR",
              set:{"P328_IDANEXODELETAR":pidanexo}
              });
            }
            ```
    }

    region anexos-lançamentos (
        name: Anexos Lançamentos
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            footerText: <font color="green"> Você pode anexar mais de um arquivo.</font>
        }
        settings {
            outputAs: text
        }
    )

    region arquivos-anexados (
        name: Arquivos Anexados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomearquivo
                     , idlancamentodiverso||idanexolancamento||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10) ID
                     --, '<a href="javascript: fnc_verimg('''||iddespesa||idanexodespesa||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10)||''');">Ver arquivo</a>' link
                     , dataanexo data
                     , ( select pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario ) usuario
                     , '<a href="javascript: fnc_removeanexo('||idanexolancamento||','''||t.nomearquivo||''');">Remover</a>' remover
                from anexoslancamentos t
                where idlancamentodiverso = :P379_IDLANCAMENTO
                order by t.dataanexo
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column DATA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 2
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
            sorting {
                sortable: false
            }
        )

        column ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: link
            heading {
                heading: Ver arquivo
                alignment: center
            }
            layout {
                sequence: 3
            }
            link {
                target: {
                    page: 162
                    items: {
                        P162_ARQUIVO: #ID#
                    }
                    action: resetPagination
                }
                linkText: Ver arquivo
            }
            sorting {
                sortable: false
            }
        )

        column NOMEARQUIVO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column REMOVER (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Remover
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column USUARIO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Usuário
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P379_ARQUIVOTEMP (
        type: fileUpload
        label {
            label: Arquivo
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
        }
        storage {
            filenameColumn: NOMEARQUIVO
        }
        layout {
            sequence: 50
            region: @anexos-lançamentos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: ARQUIVOTEMP
            used: always
        }
    )

    pageItem P379_DATAANEXO (
        type: hidden
        layout {
            sequence: 80
            region: @anexos-lançamentos
            slot: regionBody
        }
        appearance {
            formatMask: DD/MM/RRRR HH24:MI:SS
        }
        source {
            type: databaseColumn
            databaseColumn: DATAANEXO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  return sysdate;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P379_IDANEXODELETAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @anexos-lançamentos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P379_IDANEXOLANCAMENTO (
        type: hidden
        layout {
            sequence: 20
            region: @anexos-lançamentos
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDANEXOLANCAMENTO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P379_IDLANCAMENTO (
        type: textField
        label {
            label: Lançamento
            alignment: left
        }
        layout {
            sequence: 30
            region: @anexos-lançamentos
            slot: regionBody
            alignment: left
            columnAttributes: readonly
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            customAttributes: readonly
        }
        source {
            type: databaseColumn
            databaseColumn: IDLANCAMENTODIVERSO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P379_IDUSUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @anexos-lançamentos
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDUSUARIO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidusuario number;
                BEGIN
                  select idusuario
                  into vidusuario
                  from usuarios 
                  where usuario = v('APP_USER');
                  return vidusuario;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P379_NOMEARQUIVO (
        type: hidden
        layout {
            sequence: 40
            region: @anexos-lançamentos
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: NOMEARQUIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Anexar este arquivo!
        layout {
            sequence: 60
            region: @anexos-lançamentos
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P379_IDANEXOLANCAMENTO
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 10
            region: @anexos-lançamentos
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P379_IDANEXOLANCAMENTO
        }
    )

    validation selecione-o-arquivo (
        name: Selecione o Arquivo
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P379_ARQUIVOTEMP
        }
        error {
            errorMessage: Selecione o arquivo para anexar!
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process anexar (
        name: Anexar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  commit;
                  -- Call the procedure
                  pck_anexos.blob_to_file_lancamentos(pidlancamento => :P379_IDLANCAMENTO);
                  commit;
                end;
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 69046815782548415
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P379_ARQUIVOTEMP
        }
    )

    process deletar (
        name: Deletar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_anexos.prc_apagaanexo_lancamentos(pidanexolancamento => :P379_IDANEXODELETAR);
                end;
                
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 69048443686548418
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    process fetch-row-from-anexoslancamentos (
        name: Fetch Row from ANEXOSLANCAMENTOS
        type: autoRowFetch
        source {
            tableName: ANEXOSLANCAMENTOS
            pkColumn: IDANEXOLANCAMENTO
            pkItem: P379_IDANEXOLANCAMENTO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 69047272840548417
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P379_IDANEXOLANCAMENTO is null then
                        select "#OWNER#"."SEQ_IDANEXOLANCAMENTO".nextval
                          into :P379_IDANEXOLANCAMENTO
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 69047625486548417
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: itemIsNotNull
            item: P379_ARQUIVOTEMP
        }
    )

    process process-row-of-anexoslancamentos (
        name: Process Row of ANEXOSLANCAMENTOS
        type: autoRowProcessing
        target {
            tableName: ANEXOSLANCAMENTOS
            pkColumn: IDANEXOLANCAMENTO
            pkItem: P379_IDANEXOLANCAMENTO
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada!
        }
        advanced {
            executionMappingIdentifier: 69048045756548417
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P379_ARQUIVOTEMP
        }
    )

    process vincula-anexo-nos-demais-lançamentos (
        name: Vincula Anexo nos demais Lançamentos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_anexos.prc_reutiliza_lancamentos(pidlancamento => :P379_IDLANCAMENTO);
                end;
                
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 67018139671041845
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P379_ARQUIVOTEMP
        }
    )

    branch (
        name: Anexar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 379
                items: {
                    P379_IDANEXOLANCAMENTO:
                    P379_IDLANCAMENTO: &P379_IDLANCAMENTO.
                }
                action: resetPagination
                successMessage: false
            }
        }
    )

)

