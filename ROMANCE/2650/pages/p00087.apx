    pageItem P87_CONCLUIDO (
        type: selectList
        label {
            label: Concluído
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayNullValue: false
        }
        layout {
            sequence: 620
            region: @fechamento-semanal
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: CONCLUIDO
            used: always
        }
        default {
            type: static
            staticValue: N
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 -- nova logica aplica para atender o ticket 9810741 - Maicon Aimi - 29/01/2025
                  from dual
                 where -- permite concluir e reabrir o caixa
                       pck_util.fnc_verificaacesso(pidaplicacao => 2897, pusuario => v('APP_USER')) = 'N' 
                       -- permite somente concluir o caixa
                   and (    ( pck_util.fnc_verificaacesso(pidaplicacao => 2941, pusuario => v('APP_USER')) = 'N')
                         or ( pck_util.fnc_verificaacesso(pidaplicacao => 2941, pusuario => v('APP_USER')) = 'S' and :P87_CONCLUIDO = 'S') ) 
                   
                   
                /*
                select 1
                  from dual
                 where pck_util.fnc_verificaacesso(pidaplicacao => 2897,pusuario => v('APP_USER'))  = 'N' 
                */
                 
                ```
        }
        security {
            encryptSessionState: false
        }
    )

