    pageItem P87_IDFILIAL (
        type: selectList
        label {
            label: Filial
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(p.apelido,p.nomepessoa)) display_value
                     , f.idfilial return_value
                from filiais    f
                   , pessoas    p
                where f.idpessoa  = p.idpessoa
                  and f.idfilial = :P87_IDFILIAL
                ```
            displayNullValue: false
        }
        layout {
            sequence: 590
            region: @fechamento-semanal
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIAL
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                vfilial number;
                begin
                return PCK_ROMANCE.FNC_FILIALUSUARIO(V('APP_USER'));
                EXCEPTION
                WHEN OTHERS THEN 
                NULL;
                end;
                ```
        }
        sessionState {
            storage: request
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

