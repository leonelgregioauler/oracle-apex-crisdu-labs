    process processa-faturas (
        name: processa faturas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P87_IDFILIAL in (220,1075) then --fabrica
                    --
                    pck_investimentos.prc_investimento_fabri(pidfechamento =>  :P87_IDFECHAMENTO );
                    --
                  end if;
                  --
                  if :P87_IDFILIAL = 421 then -- sim esteio
                    --
                    pck_investimentos.prc_investimento_fabri_esteio(pidfechamento =>  :P87_IDFECHAMENTO );
                    --
                  end if;
                  --
                  if :P87_IDFILIAL = 162 then --varejo
                    --
                    pck_investimentos.prc_investimento_times(pidfechamento =>  :P87_IDFECHAMENTO );
                    --
                  end if;
                  --
                end;
                ```
