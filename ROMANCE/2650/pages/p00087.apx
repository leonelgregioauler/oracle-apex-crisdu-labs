    process update-favorita (
        name: update favorita
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vtotalpagar number(15,2);
                  vtotalpago  number(15,2);
                  vsaldo      number(15,2);
                  vsemana     varchar2(10) := trim(:P87_SEMANA);
                begin
                  --
                  select pg.pago
                       , apg.apagar
                       , pg.pago - apg.apagar
                  into vtotalpago
                     , vtotalpagar
                     , vsaldo
                  from ( select sum(b.valorcobrado) apagar
                         from boletos B
                         where to_char(b.DATAVENCIMENTO,'IW/RRRR') = vsemana
                           and b.databaixa is null ) apg
                     , ( select sum(b.valorcobrado) pago
                         from boletos B
                         where to_char(b.DATAVENCIMENTO,'IW/RRRR') = vsemana
                           and b.databaixa is not null ) pg;
                  --
                  update fechamentossemanais f
                  set f.totalboletosapagar = vtotalpagar
                    , f.totalboletospago   = vtotalpago
                    , f.saldoboletos       = vsaldo
                  where f.idfechamento = :P87_IDFECHAMENTO
                  --  and f.idfilial = 200 --favorita
                    and (( nvl(f.concluido,'N') = 'N')
                   or (pck_romance.fnc_verificaacesso('PERM_ALTERAFECHA', v('APP_USER')) = 'S'));
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 4
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 180581028762112366
        }
        serverSideCondition {
            type: item=value
            item: P87_IDFILIAL
            value: 200
        }
    )

