            type: itemIsNotNull
            item: 69_ASSINATURA
        }
    )

    process confirma-fechamento (
        name: confirma fechamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidgerente  number;
                  vencerrarcaixa varchar2(1) := 'N';
                begin
                  --
                  begin
                    select u.encerrarcaixa
                    into vencerrarcaixa
                    from usuarios u
                    where u.usuario = v('APP_USER');
                  exception
                    when others then
                      vencerrarcaixa := 'N';
                  end;
                  --
                  select idgerente
                  into vidgerente
                  from gerentes
                  where idpessoa = ( select idpessoa
                                     from usuarios
                                     where usuario = upper(v('APP_USER')));
                  --
                  if upper(TRIM(:P87_ASSINATURA)) = v('APP_USER') and pck_romance.fnc_filialusuario(v('APP_USER')) = :P0_IDFILIALCAIXA then
                    --
                    :P87_CONCLUIDO := 'S';
                    --
                    pck_acertosfechamento.prc_enviaemailfechamento(pidfechamento => :P87_IDFECHAMENTO,
                                                                   pusuario => v('APP_USER'));
                    --
                  elsif upper(TRIM(:P87_ASSINATURA)) = v('APP_USER') and vencerrarcaixa = 'S' then
                    --
                    :P87_CONCLUIDO := 'S';
                    pck_acertosfechamento.prc_enviaemailfechamento(pidfechamento => :P87_IDFECHAMENTO,
                                                                   pusuario => v('APP_USER'));
                    --           
                  else
                    :P87_CONCLUIDO := 'N';
                  end if;
                  --
                exception
                  when others then
                    null;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Fechamento concluído!
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 180579633744112341
        }
        serverSideCondition {
            whenButtonPressed: @confirmar
        }
    )

