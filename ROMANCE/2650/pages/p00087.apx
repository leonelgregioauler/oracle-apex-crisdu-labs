    pageItem P87_SUBTOTAL01 (
        type: hidden
        layout {
            sequence: 770
            region: @fechamento-semanal
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select replace(TO_CHAR(
                 nvl(to_number(:P87_TOTALCOBRANCA,'999G999G999G990D00'),0)
                + nvl(to_number(:P87_TOTALVENDASDIRETAS,'999G999G999G990D00'),0)
                + nvl(to_number(:P87_TOTALCHQSEMFUNDORECEBIDOS,'999G999G999G990D00'),0)
                + nvl(to_number(:P87_TOTALBOLETOSFAVORITA,'999G999G999G990D00'),0)
                + nvl(to_number(:P87_ENTRADASDIV,'999G999G999G999G999G990D00'),0)
                + nvl(to_number(:P87_TOTALRESGATE,'999G999G999G990D00'),0)
                ,'999G999G999G990D00'),' ','') SUBTOTAL1
                FROM DUAL
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

