page 87 (
    name: Fechamento Semanal
    title: Fechamento Semanal
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
        browserCache: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region concluir (
        name: Concluir
        type: staticContent
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
            renderComponents: belowContent
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from dual
                 where :P87_IDFECHAMENTO IS NOT NULL
                   and nvl(:P87_CONCLUIDO,'N') = 'N'
                   and exists ( select 1 
                                  from gerentes
                                 where idpessoa = ( select idpessoa 
                                                      from usuarios 
                                                     where usuario = v('APP_USER')) )
                union
                
                select 1
                  from dual 
                 where :P87_IDFECHAMENTO IS NOT NULL
                   and nvl(:P87_CONCLUIDO,'N') = 'N'
                   and exists ( select 1
                                  from vw_filiais f
                                 where f.idfilial = :P0_IDFILIALCAIXA 
                                   and f.tipofilial = 'F'
                                   and f.ativo      = 'S' )
                
                union 
                
                -- Maicon Aimi - 27/01/2024 - 9635989: Incluído para permitir fechamento por usuários que não são gerentes
                select 1
                  from dual
                 where roman.pck_util.fnc_verificaacesso(pidaplicacao => 3565, pusuario => v('APP_USER')) = 'S'
                ```
        }
    )

    region fechamento-concluído (
        name: Fechamento Concluído
        type: staticContent
        source {
            htmlCode: <font color="red">Fechamento já Concluído!</font>
        }
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/alert
            templateOptions: [
                #DEFAULT#
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--info
                t-Alert--removeHeading js-removeLandmark
                t-Form--slimPadding
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from fechamentossemanais f where f.concluido = 'S' and f.idfechamento = :P87_IDFECHAMENTO
        }
    )

    region fechamento-semanal (
        name: Fechamento Semanal
        type: form
