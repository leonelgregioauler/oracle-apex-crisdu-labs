    region negociações-balanço-antigo (
        name: Negociações Balanço (Antigo)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- Balanço
                select data_negociacao
                     , vl_negociado
                     , vl_pago
                     , greatest((vl_negociado - nvl(vl_pago,0)),0) vl_saldo
                  from(
                select trunc(ne.data) data_negociacao
                     , sum(ne.valor) vl_negociado
                     , sum(nvl((select nvl(sum(nvl(pn.valorpago,0)),0)
                          from pagamentosnegociacoesbalanco pn
                         where pn.idnegociacaobalanco = ne.idnegociacaobalanco),0)) vl_pago
                  from negociacoesbalanco ne
                 where nvl(ne.cancelado,'N') = 'N'
                   and trunc(ne.data) between :P454_DATAINICIO and :P454_DATAFIM
                   and (:P454_IDFILIAL = -1 --/*todos*/
                    or (:P454_IDFILIAL = -2 and ne.idfilial is null)
                    or (:P454_IDFILIAL = 1 and exists(select 1 --/*brasil*/
                                                        from vw_filiais f
                                                       where f.idfilial = ne.idfilial
                                                         and f.idgrupo is not null
                                                         and f.ididioma = 1))
                    or (:P454_IDFILIAL = 2 and exists(select 1 --/*america latina*/
                                                        from vw_filiais f
                                                       where f.idfilial = ne.idfilial
                                                         and f.idgrupo is not null
                                                         and f.ididioma not in (1,5,9,10,11)))
                    or (:P454_IDFILIAL > 2 and ne.idfilial = :P454_IDFILIAL))
                   and (:P454_IDDISTRIBUIDOR = -1 or ne.idrepresentante = :P454_IDDISTRIBUIDOR)
                   and :P454_TIPO_RELATORIO = 'R'
                 group by trunc(ne.data))
                order by data_negociacao
                ```
        }
        layout {
            sequence: 60
            parentRegion: @negociações
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P454_TIPO_RELATORIO
            value: R
        }
        readOnly {
            type: item=value
            item: P454_TIPO_RELATORIO
            value: R
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 3494658053391678532
        }

