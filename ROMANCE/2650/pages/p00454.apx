page 454 (
    name: Extrato de Movimentações
    title: Extrato de Movimentações
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region detalhado (
        name: Detalhado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select * from (
                select t.tp_negociacao
                     , t.data_negociacao
                     , t.vl_negociado
                     , t.vl_pago
                     , t.vl_atrasado
                     , t.vl_vencido
                from(
                select tn.descricao tp_negociacao
                     , trunc(ne.data) data_negociacao
                     , sum(ne.valor) vl_negociado
                     , sum(nvl((select nvl(sum(nvl(pn.valorpago,0)),0)
                          from pagamentosnegociacoes pn
                         where pn.idnegociacao = ne.idnegociacao
                           and pn.situacao = 'Q'),0)) vl_pago
                     , sum(nvl((select nvl(sum(nvl(pn.valorpago,0)),0)
                          from pagamentosnegociacoes pn
                         where pn.idnegociacao = ne.idnegociacao
                           and (trunc(sysdate) - trunc(pn.datapagamento)) <= 15
                           and pn.situacao = 'A'),0)) vl_atrasado
                     , sum(nvl((select nvl(sum(nvl(pn.valorpago,0)),0)
                          from pagamentosnegociacoes pn
                         where pn.idnegociacao = ne.idnegociacao
                           --and (trunc(sysdate) - trunc(pn.datapagamento)) > 15
                           and pn.situacao = 'V'),0)) vl_vencido
                  from negociacoes ne
                     , tiposnegociacoes tn
                 where ne.idtiponegociacao = tn.idtiponegociacao
                   and trunc(ne.data) between :P454_DATAINICIO and :P454_DATAFIM
                   and (:P454_IDFILIAL = -1 /*todos*/
                    or (:P454_IDFILIAL = -2 and ne.idfilial is null) /*Negociacoes sem filial, diretas*/
                    or (:P454_IDFILIAL = 1 and exists(select 1 /*brasil*/
                                                        from vw_filiais f
                                                       where f.idfilial = ne.idfilial
                                                         and f.idgrupo is not null
                                                         and f.ididioma = 1
                                                      union
                                                      select 1 /*Para casos de negociação sem idfilial*/
                                                        from catal.pessoas pe
                                                           , catal.paises pa
                                                       where pe.idpais = pa.idpais
                                                         and pe.idpessoa = ne.idpessoa
                                                         and pa.idpais   = 1))
                    or (:P454_IDFILIAL = 2 and exists(select 1 /*america latina*/
                                                        from vw_filiais f
                                                       where f.idfilial = ne.idfilial
                                                         and f.idgrupo is not null
                                                         and f.ididioma not in (1,5,9,10,11)
                                                      union
                                                      select 1 /*Para casos de negociação sem idfilial*/
                                                        from catal.pessoas pe
                                                           , catal.paises pa
                                                       where pe.idpais = pa.idpais
                                                         and pe.idpessoa = ne.idpessoa
                                                         and pa.idpais   not in (1,5,9,10,11)))
                    or (:P454_IDFILIAL > 2 and ne.idfilial = :P454_IDFILIAL))
                   and (:P454_IDDISTRIBUIDOR = -1 or ne.idrepresentante = :P454_IDDISTRIBUIDOR)
                   and :P454_TIPO_RELATORIO = 'D'
                 group by tn.descricao
                        , trunc(ne.data)) 
                t)
                            PIVOT
                            (
                           sum(vl_negociado) as vl_negociado,
                           sum(vl_pago) as vl_pago,
                           sum(vl_atrasado) as vl_atrasado,
                           sum(vl_vencido) as vl_vencido
                          for tp_negociacao in ('Carro', 'Balanço', 'Empréstimo')
                            )
                order by data_negociacao
                
                ```
        }
        layout {
            sequence: 30
            parentRegion: @negociações
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: item=value
            item: P454_TIPO_RELATORIO
            value: D
        }
        readOnly {
            type: item=value
            item: P454_TIPO_RELATORIO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 3494655078818678502
        }

