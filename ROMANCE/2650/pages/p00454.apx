    pageItem P454_IDDISTRIBUIDOR (
        type: selectOne
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ' Todos' d, -1 r
                from dual
                union
                select pck_romance.fnc_nomerepresentante(r.idrepresentante) d
                     , r.idrepresentante r
                from representantes r
                where r.idgerente in ( select idgerente 
                                      from gerentes g
                                         , filiais fil
                                      where g.idfilial = fil.idfilial
                                        and ( :P454_IDFILIAL = -1  -- Todos
                                          or ( :P454_IDFILIAL = 1 and fil.idgrupo != 5  ) -- Brasil
                                          or ( :P454_IDFILIAL = 2 and fil.idgrupo  = 5  ) -- America Latina
                                          or ( :P454_IDFILIAL > 2 and g.idfilial = :P454_IDFILIAL )))
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P454_IDFILIAL
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        default {
            type: static
            staticValue: -1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P454_IDFILIAL (
        type: selectOne
        label {
            label: Empresa
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select '   Todos', -1
                from dual
                union
                select '  Sem Filial', -2
                from dual
                union
                select ' Brasil', 1
                from dual
                union
                select ' America Latina', 2
                from dual
                union
                select nome
                     , idfilial
                from vw_filiais f
                where f.ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
