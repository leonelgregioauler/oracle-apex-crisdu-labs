    region lançamentos-futuros (
        name: Lançamentos Futuros
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select lan_fut.data
                     , sum(lan_fut.valor) valor
                  from( select pnb.data_vencimento data
                             , pnb.valor
                          from parcelanegociacaobalanco pnb
                         where pnb.data_vencimento between trunc(sysdate) and trunc(sysdate)+30
                           and pnb.situacao        = 'ABE'
                        union
                        select trunc(pe.datavencimento) data
                             , pe.valorapagar valor 
                          from parcelamentosemprestimos pe
                         where pe.situacao = 'A'
                           and trunc(pe.datavencimento) between trunc(sysdate) and trunc(sysdate)+30) lan_fut
                group by lan_fut.data
                order by lan_fut.data
                ```
        }
