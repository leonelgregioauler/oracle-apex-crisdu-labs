    region extrato-detalhado-antigo (
        name: Extrato Detalhado (Antigo)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.data
                     , sum(nvl(veiculos.valor,0)) veiculos
                     , sum(nvl(emprestimos.valor,0)) emprestimos
                     , sum(nvl(balanco.valor,0)) balanco
                     , sum(nvl(cheque.valor,0)) cheque
                     , sum(nvl(emprestimos_saida.valor,0)) emprestimos_saida
                     , sum(nvl(veiculos_saida.valor,0)) veiculos_saida
                     , sum((nvl(veiculos.valor,0) + nvl(emprestimos.valor,0) + nvl(balanco.valor,0) + nvl(cheque.valor,0)) - (nvl(emprestimos_saida.valor,0) + nvl(veiculos_saida.valor,0))) saldo
                  from datasperiodos d
                   , (select pn.datapagamento data
                           , pn.valorpago valor
                           , pn.observacao
                        from pagamentosnegociacoes pn
                           , negociacoes ne
                       where pn.idnegociacao = ne.idnegociacao
                         and pn.valorpago > 0 
                         and (:P454_IDFILIAL = -1 /*todos*/
                         or (:P454_IDFILIAL = 1 and exists(select 1  /*brasil*/
                                                               from vw_filiais f
                                                              where f.idfilial = ne.idfilial
                                                                and f.idgrupo is not null
                                                                and f.ididioma = 1 ))
                         or (:P454_IDFILIAL = 2 and exists(select 1 /*america latina*/
                                                               from vw_filiais f
                                                              where f.idfilial = ne.idfilial
                                                                and f.idgrupo is not null
                                                                and f.ididioma != 1 )))
                         or (:P454_IDFILIAL > 2 and ne.idfilial = :P454_IDFILIAL)) veiculos
                   , (select pe.data
                           , pe.valorpago valor
                           , pe.observacao
                        from pagamentosemprestimos pe
                           , emprestimos em
                       where pe.idemprestimo = em.idemprestimo
                         and pe.valorpago > 0 
                         and (:P454_IDFILIAL = -1 /*todos*/
                         or (:P454_IDFILIAL = 1 and exists(select 1  /*brasil*/
                                                               from vw_filiais f
                                                              where f.idfilial = em.idfilial
                                                                and f.idgrupo is not null
                                                                and f.ididioma = 1 ))
                         or (:P454_FILIAL = 2 and exists(select 1 /*america latina*/
                                                               from vw_filiais f
                                                              where f.idfilial = em.idfilial
                                                                and f.idgrupo is not null
                                                                and f.ididioma != 1 )))
                         or (:P454_IDFILIAL > 2 and em.idfilial = :P454_IDFILIAL)) emprestimos
                   , (select pb.data
                           , pb.valorpago valor
                           , pb.observacao
                        from pagamentosnegociacoesbalanco pb
                           , negociacoesbalanco nb
                       where pb.idnegociacaobalanco = nb.idnegociacaobalanco
                         and pb.valorpago > 0 
                         and (:P454_IDFILIAL = -1 /*todos*/
                         or (:P454_IDFILIAL = 1 and exists(select 1  /*brasil*/
                                                               from vw_filiais f
                                                              where f.idfilial = nb.idfilial
                                                                and f.idgrupo is not null
                                                                and f.ididioma = 1 ))
                         or (:P454_IDFILIAL = 2 and exists(select 1 /*america latina*/
                                                               from vw_filiais f
                                                              where f.idfilial = nb.idfilial
                                                                and f.idgrupo is not null
                                                                and f.ididioma != 1 )))
                         or (:P454_IDFILIAL > 2 and nb.idfilial = :P454_IDFILIAL)) balanco
                   , (select chp.datapagamento data
                           , chp.valor valor
                           , chp.observacao
                        from cheques2 ch
                           , cheques2pgto chp
                       where ch.idcheque = chp.idcheque
                         and ch.semfundo = 'S'
                         and chp.valor > 0 
                         and (:P454_IDFILIAL = -1 /*todos*/
                         or (:P454_IDFILIAL = 1 and exists(select 1  /*brasil*/
                                                               from vw_filiais f
                                                              where f.idfilial = ch.idfilial
                                                                and f.idgrupo is not null
                                                                and f.ididioma = 1 ))
                         or (:P454_IDFILIAL = 2 and exists(select 1 /*america latina*/
                                                               from vw_filiais f
                                                              where f.idfilial = ch.idfilial
                                                                and f.idgrupo is not null
                                                                and f.ididioma != 1 )))
                         or (:P454_IDFILIAL > 2 and ch.idfilial = :P454_IDFILIAL))cheque
                   , (select em.data
                           , em.valor
                           , em.observacao
                        from emprestimos em
                       where em.valor > 0
                         and not exists (select 1
                                           from pagamentosemprestimos pe
                                          where pe.idemprestimo = em.idemprestimo)
                         and (:P454_IDFILIAL = -1 /*todos*/
                         or (:P454_IDFILIAL = 1 and exists(select 1  /*brasil*/
                                                               from vw_filiais f
                                                              where f.idfilial = em.idfilial
                                                                and f.idgrupo is not null
                                                                and f.ididioma = 1 ))
                         or (:P454_IDFILIAL = 2 and exists(select 1 /*america latina*/
                                                               from vw_filiais f
                                                              where f.idfilial = em.idfilial
                                                                and f.idgrupo is not null
                                                                and f.ididioma != 1 )))
                         or (:P454_IDFILIAL > 2 and em.idfilial = :P454_IDFILIAL)) emprestimos_saida
                   , (select ne.data
                           , ne.valorpago valor
                           , ne.observacao
                        from negociacoes ne
                       where ne.valorpago > 0
                         and not exists ( select 1
                                            from pagamentosnegociacoes pn
                                           where pn.idnegociacao = ne.idnegociacao)
                         and (:P454_IDFILIAL = -1 /*todos*/
                         or (:P454_IDFILIAL = 1 and exists(select 1  /*brasil*/
                                                               from vw_filiais f
                                                              where f.idfilial = ne.idfilial
                                                                and f.idgrupo is not null
                                                                and f.ididioma = 1 ))
                         or (:P454_IDFILIAL = 2 and exists(select 1 /*america latina*/
                                                               from vw_filiais f
                                                              where f.idfilial = ne.idfilial
                                                                and f.idgrupo is not null
                                                                and f.ididioma != 1 )))
                         or (:P454_IDFILIAL > 2 and ne.idfilial = :P454_IDFILIAL)) veiculos_saida
                  where d.data = veiculos.data(+)
                    and d.data = emprestimos.data(+)
                    and d.data = balanco.data(+)
                    and d.data = cheque.data(+)
                    and d.data = emprestimos_saida.data(+)
                    and d.data = veiculos_saida.data(+)
                    and (veiculos.valor > 0 or emprestimos.valor > 0 or balanco.valor > 0 or cheque.valor > 0 or emprestimos_saida.valor > 0 or veiculos_saida.valor > 0 )
                    and d.data between :P454_DATAINICIO and :P454_DATAFIM
                    and :P454_TIPO_RELATORIO = 'D'
                group by d.data
                order by d.data asc
                /*select data
                     , veiculos
                     , emprestimos
                     , balanco
                     , cheque
                     , emprestimos_saida
                     , veiculos_saida
                     , saldo
                  from vw_extrato_movimentacoes_credrmc t
                 where t.data between :P454_DATAINICIO and :P454_DATAFIM
                   and :P454_TIPO_RELATORIO = 'D'
                order by data asc*/
                   
                
                ```
        }
