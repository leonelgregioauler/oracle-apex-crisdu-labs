page 256 (
    name: Depósitos
    title: Depósitos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region aviso (
        name: Aviso
        type: staticContent
        layout {
            sequence: 5
            slot: body-3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from ENTRADASDIVERSAS
                  WHERE IDFECHAMENTO is null
                    and idfilial = ( select  f.idfilial 
                                        from filiais    f
                                           , usuarios   u
                                           , gerentes   g
                                        where g.idfilial  = f.idfilial
                                          and u.idgerente = g.idgerente
                                          and u.usuario   = v('APP_USER'));
                ```
        }
    )

    region semanas (
        name: Semanas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(TRUNC(depdia.data),'IW/RRRR') semana
                     , null idfechamento
                     ,  '<img src="#IMAGE_PREFIX#e2.gif" alt="">' identrada
                     , pgf.idfilial
                     , to_number(TO_CHAR(TRUNC(depdia.data),'RRRR')) "Ano"
                     , to_number(TO_CHAR(TRUNC(depdia.data),'IW')) "Semana"
                     , pck_romance.fnc_nomefilial( pgf.idfilial )  Filial
                     , null Filialorig
                     , null Filialdestino
                     , to_char(trunc(depdia.data),'MONTH')  "Mês"
                     , null fechamentoorig
                     , null conta
                     , null subconta
                     , SUM(depdia.valordeposito) valortotal
                     , 'Pagamento de Fornecedor: '||pck_romance.fnc_nomefornecedor(pgf.idfornecedor)   descricao
                     , 'Investimento' Tipo
                     , 'Pagamento feito pela Romance' "Descrição da Origem"
                     , TRUNC(depdia.data) "Data"
                     , ( select n.documento from notasfiscais n where n.idnotafiscal = pgf.idnotafiscal) "Nota"
                     , '-' 
                from pagamentosfornecedores pgf
                   , depositosdiarios depdia
                   , notasfiscais n
                where depdia.idpgtoforn = pgf.idpgtoforn
                  and pgf.idnotafiscal = n.idnotafiscal
                  and depdia.valordeposito > 0
                  and pgf.idfilial = :P80_IDFILIAL
                group by trunc(depdia.data)
                       , Pgf.IDFILIAL
                       , n.idfilialdestino
                       , depdia.observacao
                       , pgf.idfornecedor
                       , Depdia.tipo
                       , pgf.idnotafiscal
                ```
        }
        layout {
            sequence: 10
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhuma entrada confirmada.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
