    pageItem P256_AVISO (
        type: displayOnly
        label {
            label: <b><font color="red">Aviso:</font><b>
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 10
            region: @aviso
            slot: regionBody
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select 'Você tem entradas pendentes de confirmação!'
                  from ENTRADASDIVERSAS
                  WHERE IDFECHAMENTO is null
                    and idfilial = ( select  f.idfilial 
                                        from filiais    f
                                           , usuarios   u
                                           , gerentes   g
                                        where g.idfilial  = f.idfilial
                                          and u.idgerente = g.idgerente
                                          and u.usuario   = v('APP_USER'));
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button voltar (
        buttonName: Voltar
        label: Voltar para Entradas
        layout {
            sequence: 10
            region: @semanas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 80
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

