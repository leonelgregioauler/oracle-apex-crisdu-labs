page 277 (
    name: Cadastro e Acessos
    title: Cadastro e Acessos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region cadastro-e-acessos (
        name: Cadastro e Acessos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select "IDTIPOFILIAL", 
                "DESCRICAO"
                from "#OWNER#"."TIPOSFILIAIS" 
                  
                
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 278
                items: {
                    P278_IDTIPOFILIAL: #IDTIPOFILIAL#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 416628124330931777
        }

        column DESCRICAO (
            type: plainText
            heading {
                heading: Descricao
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: DESCRICAO
                endUserAlias: B
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDTIPOFILIAL (
            type: plainText
            heading {
                heading: ID
                alignment: center
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: IDTIPOFILIAL
                endUserAlias: A
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 4166304 (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn DESCRICAO (
                sequence: 2
            )

            displayColumn IDTIPOFILIAL (
                sequence: 1
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Novo
        layout {
            sequence: 30
            region: @cadastro-e-acessos
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 278
                clearCache: 278
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

