    region pendente-de-aprovação (
        name: Pendente de aprovação
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nf.IDNOTAFISCAL
                     , to_char(nf.dtnf,'IW')||'/'||to_char(nf.dtnf,'RRRR') Semana
                     , to_char(nf.dtnf,'RRRR') ANO
                     , nf.nrnf 
                     , decode( nf.tiponota, 'T', 'Transferência'
                                          , 'C', 'Compra' 
                                          , 'R', 'Reserva') "Tipo NF"
                     , decode( nf.tiponota, 'T', pck_romance.fnc_nomefilial(pidfilial => nf.idfilialemitente  )
                                          , 'C', pck_romance.fnc_nomefornecedor(pidforn =>  nf.idfornemitente  ) ) Emitente
                     , pck_romance.fnc_nomefilial(pidfilial => nf.idfilialdestino ) "Filial Destino"
                     , pck_romance.fnc_nometransportadora(pidtransp => nf.idtransportadora )  "Transportadora"
                     , nf.dtnf 
                     , ( select sum(valor) from vencimentos v where v.idnotafiscal = nf.idnotafiscal ) totalvencimentos
                     , ( select sum((nvl(qtd_pp,0) + nvl(qtd_p,0) + nvl(qtd_m,0) + nvl(qtd_g,0) + nvl(qtd_gg,0) + nvl(qtd_egg,0) + nvl(qtd_u,0)) * inf.custound)
                         from itemnf inf
                         where inf.idnotafiscal = nf.idnotafiscal ) totalitens
                     , ( select sum(valor) + ( sum(valor) *0.1)   from vencimentos v where v.idnotafiscal = nf.idnotafiscal ) valortotalfilial
                     , decode(NF.SITUACAO,'A','Ativa'
                                         ,'C','Cancelada'
                                         ,'P','Aguardando Aprovação'
                                         ,'E','Aguardando Envio para Aprovação'
                                         ,'Ativa') Situacao
                     , decode(NF.SITUACAOFILIAL,'A','Aguardando Recebimento','R','Recebida') "Situação Recebimento"
                     , nf.documento 
                     , initcap(nf.USUARIO) "Usuário"
                     , nf.conhecimentotransporte "CTE"
                     , nf.observacao "Observação"
                     , ( select pc.idpedidocompra from pedidoscompras pc where pc.idpedidocompra = nf.idpedidocompra ) "Pedido de Compra"
                     , DATARECEBIMENTO "Data Recebimento"
                from notasfiscais nf
                where tiponota in ( 'C','T','R')
                  and situacao in ( 'P','E') --PENDENTE DE APROVAÇÃO, aguarndando envio para aprovação
                  and pck_romance.fnc_filialusuario(nf.usuario) =:P0_IDFILIALCAIXA
                order by 2, nf.dtnf desc
                ```
        }
        layout {
            sequence: 11
            slot: body-3
        }
