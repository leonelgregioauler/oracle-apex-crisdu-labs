    region lista-de-solicitações (
        name: Lista de Solicitações
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct pagforn.dtvencimento
                     , ( select pck_romance.fnc_nomefilial( nf.idfilialdestino ) 
                         from notasfiscais    nf
                         where nf.idnotafiscal  = pagforn.idnotafiscal ) "Filial Destino"
                     , to_char(pagforn.dtlancamento,'RRRR') ano
                     , ( select TRIM(to_char(s.semana,'00')||'/'||s.ano ||'(' )|| to_char(s.dt_ini,'DD/MM/YYYY') ||' a '|| to_char(s.dt_fim,'DD/MM/YYYY')||')'  
                         from semana_dias s
                         where pagforn.dtvencimento between s.dt_ini and s.dt_fim ) Semana
                     , pck_romance.fnc_nomefornecedor(pidforn => pagforn.idfornecedor) Fornecedor
                     , decode( nf.tiponota, 'T', 'Transferência'
                                          , 'C', 'Compra' 
                                          , 'R', 'Reserva/Ordem de Pgto') "Tipo NF"
                     , nf.documento
                     , pagforn.valorpagar ValorPagar
                     , pagforn.valorpago ValorPago
                     , pagforn.valorpago - pagforn.valorpagar Saldo
                     , ( select cb.beneficiario||' - '||b.nomebanco
                              ||' - '|| cb.agencia ||' - '||
                              cb.conta
                         from contasbancarias cb
                            , bancos b
                         where cb.idbanco         = b.idbanco 
                           and cb.idcontabanc = pagforn.idcontabanc)  conta
                     , decode(pagforn.tipopagamento,'D','Depósito'
                                                   ,'B','Boleto'
                                                   ,'E','Empréstimo'
                                                   ,'M','Em Mãos'
                                                   ,'Não Informado')  "Tipo Pagamento"
                     , ( select sum(d.Valororiginal)
                         from depositosdiarios d
                         where d.idpgtoforn = pagforn.idpgtoforn ) totaldepositado
                     , NF.IDNOTAFISCAL
                     , pagforn.idvencimento "ID Vencto"
                     , nf.observacao
                		 , nf.dtnf
                from pagamentosfornecedores pagforn
                   , notasfiscais    nf
                where nf.idnotafiscal  = pagforn.idnotafiscal 
                  and pagforn.idcheque is null
                  and nf.situacao = 'A'
                  and idfilialdestino =  :P0_IDFILIALCAIXA
                ```
        }
