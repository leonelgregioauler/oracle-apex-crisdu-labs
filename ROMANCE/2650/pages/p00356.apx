page 356 (
    name: Acessos de Contas Financeiras
    title: Acessos de Contas Financeiras
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region acessos-de-contas-financeiras (
        name: Acessos de Contas Financeiras
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDACESSOCONTAFINAN",
                "IDACESSOCONTAFINAN" IDACESSOCONTAFINAN_DISPLAY,
                "IDCONTAFINAN",
                "IDFILIAL"
                from "#OWNER#"."ACESSOSCONTASFINANCEIRAS"
                where IDCONTAFINAN = :P356_IDCONTAFINAN
                ```
        }
        layout {
            sequence: 15
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhum acesso localizado!
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 5
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column IDACESSOCONTAFINAN (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDACESSOCONTAFINAN
            }
        )

        column IDACESSOCONTAFINAN_DISPLAY (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 3
            }
        )

        column IDCONTAFINAN (
            reportColumnQueryId: 3
            derivedColumn: N
            type: selectList
            heading {
                heading: Conta Financeira
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select c.nomeconta
                         , c.idcontafinan
                    from contasfinanceiras c
                    where c.idcontafinan = :P356_IDCONTAFINAN
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
        )

        column IDFILIAL (
            reportColumnQueryId: 4
            derivedColumn: N
            type: selectList
            heading {
                heading: Empresa
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nome
                         , idfilial
                    from vw_filiais f
                    where f.ativo = 'S'
                    ```
                displayExtraValues: false
            }
            layout {
                sequence: 5
            }
        )

    )

    pageItem P356_IDCONTAFINAN (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @acessos-de-contas-financeiras
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button add (
        buttonName: ADD
        label: Adicionar +
        layout {
            sequence: 40
            region: @acessos-de-contas-financeiras
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.widget.tabular.addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button multi-row-delete (
        buttonName: MULTI_ROW_DELETE
        label: Delete
        layout {
            sequence: 20
            region: @acessos-de-contas-financeiras
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Deseja remover os acessos selecionados?','MULTI_ROW_DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Liberar Acesso
        layout {
            sequence: 30
            region: @acessos-de-contas-financeiras
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @acessos-de-contas-financeiras
        target {
            tableName: ACESSOSCONTASFINANCEIRAS
            pkColumn: IDACESSOCONTAFINAN
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: #MRD_COUNT# row(s) deleted.
        }
        advanced {
            executionMappingIdentifier: 12534216254485017
        }
        serverSideCondition {
            type: request=Value
            value: MULTI_ROW_DELETE
            executeCondition: once
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @acessos-de-contas-financeiras
        target {
            tableName: ACESSOSCONTASFINANCEIRAS
            pkColumn: IDACESSOCONTAFINAN
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# row(s) updated, #MRI_COUNT# row(s) inserted.
        }
        advanced {
            executionMappingIdentifier: 12533851375485017
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        name: Go To Page 356
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 356
                items: {
                    P356_IDCONTAFINAN: &P356_IDCONTAFINAN.
                }
            }
        }
    )

)

