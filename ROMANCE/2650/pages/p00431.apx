    region entradas-realizadas (
        name: Entradas Realizadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct
                     --e.identradavirtualage
                      e.codigoempresa
                     , ( select ee.nome||' - '||ee.cnpj
                         from empresasvirtualage ee
                         where ee.codigoempresa = e.codigoempresa 
                         fetch first 1 rows only ) empresa
                     , e.codigofornecedor
                     , ( select pck_romance.fnc_nomefornecedor(r.idfornecedor)
                         from  razoessociaisfornec r
                         where r.codigovirtualage = e.codigofornecedor 
                         fetch first 1 rows only) fornecedor
                     , e.duplicata
                     , e.parcela
                     , e.dataentrada 
                     , e.dataemissao
                     , e.datainclusao
                     , e.datavencimento
                     , e.codigodespesa
                     , ( select s.nomeconta
                         from subcontasfinanceiras s
                         where s.codigovirtualage = e.codigodespesa 
                         fetch first 1 rows only) conta
                     , e.codigocentrodecusto
                     , ( select c.nome
                         from centrodecustos c
                         where c.codigovirtualage = e.codigocentrodecusto 
                         fetch first 1 rows only) centrodecusto
                     , e.idmatrizdespesa
                     , e.valorduplicata
                     , e.valorpagar
                     , e.observacao
                     , e.idnotafiscal
                from entradasvirtualage e
                where e.processado = 'S'
                  and trunc(dataprocessado) between to_date(:P431_DATAINICIO,'DD/MM/RRRR') and to_date(:P431_DATAFIM,'DD/MM/RRRR')
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P431_SITUACAO
            value: S
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma entrada localizada!
        }
        advanced {
            savedReportMappingIdentifier: 18100633545232906
        }

