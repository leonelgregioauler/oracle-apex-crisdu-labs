    dynamicAction busca-id-da-linha (
        name: Busca ID da Linha
        execution {
            sequence: 20
        }
        when {
            event: region/interactiveGrid/interactivegridselectionchange
            selectionType: region
            region: @entradas-não-integradas
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var i, get_valueids = ":",  I_SELECTED_VAL,
                    
                    model = this.data.model;
                    
                    for ( i = 0; i < this.data.selectedRecords.length; i++ ) {
                    
                          I_SELECTED_VAL = model.getValue( this.data.selectedRecords[i], "IDENTRADAVIRTUALAGE");
                    	     
                    		 get_valueids += model.getValue (this.data.selectedRecords[i],"IDENTRADAVIRTUALAGE") + ":";
                    }
                    
                    apex.item( "P431_IDENTRADA" ).setValue ( get_valueids);
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process entradas-não-integradas-grid-save-interactive-grid-data (
        name: Entradas não Integradas Grid - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @entradas-não-integradas
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 2118323448155643329
        }
    )

    process processa-entrada-virtual (
        name: Processa Entrada Virtual
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 --
                 vidnota number;
                 vidmatriz number;
                 vmatrizdespesa number;
                 vcodigoempresa number;
                 vcodigofornecedor number;
                 vcodigocentrodecusto number;
                 vcodigodespesa number;
                 vduplicata number;
                 --
                begin
                  --
                  for i in (SELECT t.Column_Value AS identradavirtualage
                            FROM TABLE (Apex_String.Split(RTRIM(LTRIM(:P431_IDENTRADA, ':'), ':'),':')) t
                            --FROM TABLE (Apex_String.Split(RTRIM(LTRIM(29696, ':'), ':'),':')) t
                            where t.Column_Value is not null)               
                  loop 
                    --
                    begin 
                      --  Encontra informações para buscar a matriz.
                      select ev.codigoempresa
                           , ev.codigofornecedor
                           , ev.codigocentrodecusto
                           , ev.codigodespesa
                           , ev.duplicata
                        into vcodigoempresa
                           , vcodigofornecedor
                           , vcodigocentrodecusto
                           , vcodigodespesa
                           , vduplicata
                     from roman.entradasvirtualage ev
                    where ev.identradavirtualage = i.identradavirtualage;
                    
                 /*   raise_application_error(-20001, ' emp ' || vcodigoempresa ||
                                                    ' for ' ||vcodigofornecedor ||
                                                    ' cc '  || vcodigocentrodecusto ||
                                                    ' desp ' ||vcodigodespesa ||
                                                    ' dup ' ||vduplicata);*/
                    
                    --
                    -- Pega a matriz de despesa por filial fornecedor. 
                    select md.idmatrizregra 
                      into vidmatriz
                    from roman.matrizregrasdespesas md
                       , roman.subcontasfinanceiras s
                       , roman.centrodecustos c
                       , roman.razoessociaisfornec r
                       , roman.empresasvirtualage e
                    where c.idcentrodecusto = md.idcentrodecusto
                      and s.idsubcontafinan = md.idsubcontafinan
                      and r.idfornecedor    = md.idfornecedor
                      and md.idfilial       = e.idfilial
                      and s.codigovirtualage = vcodigodespesa
                      and c.codigovirtualage = vcodigocentrodecusto
                      and r.codigovirtualage = vcodigofornecedor
                      and e.codigoempresa    = vcodigoempresa ;
                      
                     -- raise_application_error(-20001, ' idmatriz ' || vidmatriz ||' - '||  vduplicata || ' - '|| vcodigofornecedor);
                
                      
                      
                      -- faz update se houver alguma entra com matriz nula. 
                      update roman.entradasvirtualage ev
                      set ev.idmatrizdespesa = vidmatriz
                      where ev.duplicata = vduplicata
                       and ev.codigofornecedor = vcodigofornecedor
                       and ev.idmatrizdespesa is null ;
                      --
                      commit; 
                    end; 
                   
                  --raise_application_error(-20001,i.identradavirtualage );  --Testa se esta pegando os dados do check selecionado. 
                  --
                   roman.pck_notasfiscais_rmc.prc_reprocessa_entradava(pidentrada => i.identradavirtualage,
                                                                       pusuario => v('APP_USER'));
                
                  --
                  begin
                    -- 
                    select nf.idnotafiscal
                      into vidnota
                    from roman.notasfiscais nf 
                    where nf.documento = vduplicata
                      and nf.idfornemitente = vcodigofornecedor;
                    
                    --  
                     exception
                        when others then
                         raise_application_error(-20001,'Verificar dados, nota não integrada !' );
                        -- null;
                    --
                    if vidnota is not null then
                     --
                     apex_application.g_print_success_message := '<span style="color : white ">Integrado com sucesso! </span>';
                     --
                   end if;
                 end;
                  
                 end loop;     
                end;
                
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 867985942155934534
        }
        serverSideCondition {
            whenButtonPressed: @integrar
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 431
                items: {
                    P431_SITUACAO: &P431_SITUACAO.
                    P431_DATAINICIO: &P431_DATAINICIO.
                    P431_DATAFIM: &P431_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

