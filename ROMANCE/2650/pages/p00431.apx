    region entradas-não-integradas-x (
        name: Entradas não Integradas x
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.identradavirtualage
                     , e.codigoempresa
                     , ( select ee.nome||' - '||ee.cnpj
                         from empresasvirtualage ee
                         where ee.codigoempresa = e.codigoempresa ) empresa
                     , e.codigofornecedor
                     , ( select listagg(pck_romance.fnc_nomefornecedor(r.idfornecedor),', ') within group (order by 1)
                         from  razoessociaisfornec r
                         where r.codigovirtualage = e.codigofornecedor ) fornecedor
                     , e.duplicata
                     , e.parcela
                     , e.dataentrada 
                     , e.dataemissao
                     , e.datainclusao
                     , e.datavencimento
                     , e.codigodespesa
                     , ( select s.nomeconta
                         from subcontasfinanceiras s
                         where s.codigovirtualage = e.codigodespesa ) conta
                     , e.codigocentrodecusto
                     , ( select c.nome
                         from centrodecustos c
                         where c.codigovirtualage = e.codigocentrodecusto ) centrodecusto
                     , e.idmatrizdespesa
                     , e.valorduplicata
                     , e.valorpagar
                     , e.observacao
                     , e.unidadedenegocio
                     , e.cnpj
                     , e.formapagamento
                     , case when exists( select 1
                                         from roman.notasfiscais nf 
                                         where nf.documento = e.duplicata
                                           and nf.idfornemitente = ( select rf.idfornecedor
                                                                     from roman.razoessociaisfornec rf
                                                                     where rf.codigovirtualage = e.codigofornecedor ) ) then 'Entrada Já Integrada'
                            when exists ( select 1
                                          from roman.empresasvirtualage ev
                                          where ev.codigoempresa = e.codigoempresa
                                            and ev.idfilial is null ) then 'Empresa Virtual Age Não Vinculada a Filial'
                            when not exists ( select 1
                                          from roman.razoessociaisfornec rz
                                          where rz.codigovirtualage = e.codigofornecedor ) then 'Fornecedor Não Possui Amarração'
                            when not exists ( select 1
                                              from roman.centrodecustos c 
                                              where c.codigovirtualage = e.codigocentrodecusto ) then 'Centro de Custo Não Possui Amarração'
                            when not exists ( select 1
                                              from roman.subcontasfinanceiras s
                                              where s.codigovirtualage = e.codigodespesa ) then 'Subconta financeira  Não Possui Amarração'
                            when not exists ( select 1
                                              from roman.matrizregrasdespesas m 
                                              where m.idfornecedor = ( select rf.idfornecedor
                                                                       from roman.razoessociaisfornec rf
                                                                       where rf.codigovirtualage = e.codigofornecedor )
                                                and m.idfilial     = ( select ev.idfilial
                                                                       from roman.empresasvirtualage ev
                                                                       where ev.codigoempresa = e.codigoempresa )  ) then 'Matriz de Despesa Inexistente'
                       else '-'
                       end erro
                     , '<a href="javascript:document.getElementById(''P431_IDENTRADA'').value = '||identradavirtualage||';confirmaentrada();">Integrar</a>' Integrar
                from entradasvirtualage e
                where nvl(e.processado,'N') = 'N'
                  and e.idnotafiscal is null
                  and trunc(e.dataentrada) between to_date(:P431_DATAINICIO,'DD/MM/RRRR') and to_date(:P431_DATAFIM,'DD/MM/RRRR')
                ```
