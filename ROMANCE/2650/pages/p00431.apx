page 431 (
    name: Entradas do Virtual Age
    title: Entradas do Virtual Age
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function confirmaentrada() {
            	var answer = confirm("Deseja realmente Integrar esta Entrada?")
            	if (answer){
            		apex.submit('INTEGRAR');
            	}
                    else
                    {
                    document.getElementById('P431_IDENTRADA').value = '';
                    }
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region entradas-não-integradas (
        name: Entradas não Integradas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.identradavirtualage
                     , e.codigoempresa
                     , ( select ee.nome||' - '||ee.cnpj
                         from empresasvirtualage ee
                         where ee.codigoempresa = e.codigoempresa 
                         fetch first 1 rows only) empresa
                     , e.codigofornecedor
                     , ( select listagg(pck_romance.fnc_nomefornecedor(r.idfornecedor),', ') within group (order by 1)
                         from  razoessociaisfornec r
                         where r.codigovirtualage = e.codigofornecedor 
                         fetch first 1 rows only) fornecedor
                     , ( select listagg(r.idfornecedor ||' - '|| roman.pck_romance.fnc_nomefornecedor(r.idfornecedor) || ' - ', chr(10)) within group (order by 1)
                         from  razoessociaisfornec r
                         where r.codigovirtualage = e.codigofornecedor 
                         fetch first 1 rows only) idfornecedor
                     , e.duplicata
                     , e.parcela
                     , e.dataentrada 
                     , e.dataemissao
                     , e.datainclusao
                     , e.datavencimento
                     , e.codigodespesa
                     , ( select s.nomeconta
                         from subcontasfinanceiras s
                         where s.codigovirtualage = e.codigodespesa 
                         fetch first 1 rows only) conta
                     , e.codigocentrodecusto
                     , ( select c.nome
                         from centrodecustos c
                         where c.codigovirtualage = e.codigocentrodecusto 
                         fetch first 1 rows only) centrodecusto
                     , e.idmatrizdespesa
                     /*, nvl( e.idmatrizdespesa, ( select md.idmatrizregra 
                                                 from roman.matrizregrasdespesas md
                                                    , roman.subcontasfinanceiras s
                                                    , roman.centrodecustos c
                                                    , roman.razoessociaisfornec r
                                                    , roman.empresasvirtualage e
                                                 where c.idcentrodecusto = md.idcentrodecusto
                                                   and s.idsubcontafinan = md.idsubcontafinan
                                                   and r.idfornecedor    = md.idfornecedor
                                                   and md.idfilial       = e.idfilial
                                                   and s.codigovirtualage = e.codigodespesa
                                                   and c.codigovirtualage = e.codigocentrodecusto
                                                   and r.codigovirtualage = e.codigofornecedor
                                                   and e.codigoempresa    = e.codigoempresa ) )idmatrizdespesa*/
                     , e.valorduplicata
                     , e.valorpagar
                     , e.observacao
                     , e.unidadedenegocio
                     , e.cnpj
                     , e.formapagamento
                     , case when exists ( select 1 
                                          from ( select rf.codigovirtualage, count(*) 
                                                 from roman.razoessociaisfornec rf
                                                 where rf.codigovirtualage = e.codigofornecedor
                                                 having count(*) > 1
                                                 group by rf.codigovirtualage)) then 'Fornecedores com o mesmo Código Virtual Age'
                            when exists( select 1
                                         from roman.notasfiscais nf 
                                         where nf.documento = e.duplicata
                                           and nf.idfornemitente = ( select rf.idfornecedor
                                                                     from roman.razoessociaisfornec rf
                                                                     where rf.codigovirtualage = e.codigofornecedor ) ) then 'Entrada Já Integrada'
                            
                            when not exists ( select 1
                                          from roman.razoessociaisfornec rz
                                          where rz.codigovirtualage = e.codigofornecedor ) then 'Fornecedor Não Possui Amarração'
                            when not exists ( select 1
                                              from roman.centrodecustos c 
                                              where c.codigovirtualage = e.codigocentrodecusto ) then 'Centro de Custo Não Possui Amarração'
                            when not exists ( select 1
                                              from roman.subcontasfinanceiras s
                                              where s.codigovirtualage = e.codigodespesa ) then 'Subconta financeira  Não Possui Amarração'
                            when not exists ( select 1
                                              from roman.matrizregrasdespesas m 
                                              where m.idfornecedor    = ( select rf.idfornecedor
                                                                          from roman.razoessociaisfornec rf
                                                                          where rf.codigovirtualage = e.codigofornecedor )
                                                and m.idfilial        = ( select ev.idfilial
                                                                          from roman.empresasvirtualage ev
                                                                          where ev.codigoempresa = e.codigoempresa ) 
                                                and m.idcentrodecusto = ( select c.idcentrodecusto
                                                                          from roman.centrodecustos c 
                                                                          where c.codigovirtualage = e.codigocentrodecusto )) then 'Matriz de Despesa Inexistente'
                            when not exists ( select 1
                                          from roman.empresasvirtualage ev
                                          where ev.codigoempresa = e.codigoempresa
                                            and ev.idfilial is null ) then 'Empresa Virtual Age Não Vinculada a Filial'
                       else '-'
                       end erro
                     
                from entradasvirtualage e
                where nvl(e.processado,'N') = 'N'
                  and e.idnotafiscal is null
                  and trunc(e.dataentrada) between to_date(:P431_DATAINICIO,'DD/MM/RRRR') and to_date(:P431_DATAFIM,'DD/MM/RRRR')
                
                ```
            pageItemsToSubmit: P431_IDENTRADA
        }
