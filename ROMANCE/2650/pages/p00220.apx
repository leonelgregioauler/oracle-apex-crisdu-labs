page 220 (
    name: Despesas
    title: Despesas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 80%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region despesas (
        name: Despesas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.observacao
                     , d.descricaoorigem
                     , d.datavencimento
                     , d.valor
                from fechamentossemanais f
                   , despesas            d
                where f.idfechamento = d.idfechamento
                  and f.idfechamento = :P220_IDFECHAMENTO
                order by 1
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 2551592051873213211
        }

        column DATAVENCIMENTO (
            type: plainText
            heading {
                heading: Data
            }
            layout {
                sequence: 2
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: B
            }
        )

        column DESCRICAOORIGEM (
            type: plainText
            heading {
                heading: Origem
                alignment: center
            }
            layout {
                sequence: 13
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column OBSERVACAO (
            type: plainText
            heading {
                heading: Observação
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column VALOR (
            type: plainText
            heading {
                heading: Valor
                alignment: end
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 25515990 (
            visibility: primaryDefault
            view {
                rowsPerPage: 1000
            }

            displayColumn DATAVENCIMENTO (
                sequence: 2
            )

            displayColumn DESCRICAOORIGEM (
                sequence: 4
            )

            displayColumn OBSERVACAO (
                sequence: 1
            )

            displayColumn VALOR (
                sequence: 3
            )

            aggregate (
                column: VALOR
            )

        )

    )

    pageItem P220_IDFECHAMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @despesas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

