            region: @cadastro-de-itens-da-nf
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDNOTAFISCAL
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                return :P27_IDNOTAFISCAL;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P23_IDPRODUTO (
        type: selectList
        label {
            label: Produto
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomeproduto) display_value
                , p.idproduto return_value
                from produtos p
                where idproduto = :P23_IDPRODUTO
                ```
        }
        layout {
            sequence: 40
            region: @cadastro-de-itens-da-nf
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            customAttributes: onChange="getcusto();"
        }
        source {
            type: databaseColumn
            databaseColumn: IDPRODUTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

