    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 40
            region: @cadastro-de-itens-da-nf
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P23_IDITNF
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @cadastro-de-itens-da-nf
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from notasfiscais
                where idnotafiscal = :P23_IDNOTAFISCAL
                  and situacaofilial != 'R'
                  and :P23_IDITNF is not null
                ```
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @cadastro-de-itens-da-nf
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P23_IDITNF
        }
    )

    validation p23-idproduto (
        name: P23_IDPRODUTO
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P23_IDPRODUTO
            alwaysExecute: true
        }
        error {
            errorMessage: #LABEL# deve ser informado!
            displayLocation: inlineInNotification
            associatedItem: @P23_IDPRODUTO
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process fetch-row-from-itemnf (
        name: Fetch Row from ITEMNF
        type: autoRowFetch
        source {
            tableName: ITEMNF
            pkColumn: IDITNF
            pkItem: P23_IDITNF
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Não é possível extrair a linha.
        }
        advanced {
            executionMappingIdentifier: 179665733308035591
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDTEMNF.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P23_IDITNF := get_pk; 
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Não é possível obter valor de item de chave primária.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 179665921455035591
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-itemnf (
        name: Process Row of ITEMNF
        type: autoRowProcessing
        target {
            tableName: ITEMNF
            pkColumn: IDITNF
            pkItem: P23_IDITNF
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        error {
            errorMessage: Não é possível processar a linha da tabela ITEMNF.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 179666136170035593
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 179666335895035593
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        name: Go To Page 27
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 27
                items: {
                    P27_IDNOTAFISCAL: &P23_IDNOTAFISCAL.
                }
                clearCache: 23
                successMessage: false
            }
        }
        serverSideCondition {
            type: item=value
            item: P23_PAGINA
            value: 27
        }
    )

    branch (
        name: Go To Page 207
        execution {
            sequence: 11
        }
        behavior {
            target: {
                page: 207
                items: {
                    P207_IDNOTAFISCAL: &P23_IDNOTAFISCAL.
                }
                clearCache: 23
                successMessage: false
            }
        }
        serverSideCondition {
            type: item=value
            item: P23_PAGINA
            value: 207
        }
    )

)

