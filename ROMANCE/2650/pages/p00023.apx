    pageItem P23_PRODUTODNAOCADASTRADO (
        type: displayOnly
        label {
            label: " "
            alignment: left
        }
        layout {
            sequence: 10
            region: @cadastro-de-itens-da-nf
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vnome varchar2(4000);
                begin
                  --
                  select i.nomeprodutosemcad
                  into vnome
                  from itemnf i
                  where i.iditnf = :P23_IDITNF;
                  --
                  return vnome;
                  --
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

