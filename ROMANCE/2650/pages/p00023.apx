page 23 (
    name: Itens da NF
    title: Itens da NF
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            opener.location.reload();
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region cadastro-de-itens-da-nf (
        name: Cadastro de Itens da NF
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                <script language="javascript">
                function calculatotal()
                {
                  vsoma = 0;
                  if (eval(html_GetElement('P23_QTD_P').value) > 0) 
                    {vsoma = eval(vsoma) + eval(html_GetElement('P23_QTD_P').value);}
                  if (eval(html_GetElement('P23_QTD_M').value) > 0) 
                    {vsoma = eval(vsoma) + eval(html_GetElement('P23_QTD_M').value);}
                  if (eval(html_GetElement('P23_QTD_G').value) > 0) 
                    {vsoma = eval(vsoma) + eval(html_GetElement('P23_QTD_G').value);}
                  if (eval(html_GetElement('P23_QTD_GG').value) > 0) 
                    {vsoma = eval(vsoma) + eval(html_GetElement('P23_QTD_GG').value);}
                  if (eval(html_GetElement('P23_QTD_EGG').value) > 0) 
                    {vsoma = eval(vsoma) + eval(html_GetElement('P23_QTD_EGG').value);}
                  if (eval(html_GetElement('P23_QTD_EXGG').value) > 0) 
                    {vsoma = eval(vsoma) + eval(html_GetElement('P23_QTD_EXGG').value);}
                  if (eval(html_GetElement('P23_QTD_U').value) > 0) 
                    {vsoma = eval(vsoma) + eval(html_GetElement('P23_QTD_U').value);}
                html_GetElement('P23_QTD_TOTAL').value = vsoma;
                }
                function getcusto()
                {
                var ajaxRequest = new htmldb_Get(null,&APP_ID.,'APPLICATION_PROCESS=buscapreco',0);
                pVProd    = html_GetElement('P23_IDPRODUTO').value;
                void(0);  
                void(0);
                ajaxRequest.add('F60023IDPRODUTO',pVProd);
                void(0);
                
                ajaxResult = ajaxRequest.get();
                
                if(ajaxResult)
                {
                html_GetElement('P23_CUSTOUND').value = ajaxResult;
                }
                else
                {
                html_GetElement('P23_CUSTOUND').value = '';
                }
                
                ajaxRequest = null;
                }
                </script>
                ```
        }
    )

    pageItem P23_CUSTOUND (
        type: numberField
        label {
            label: Custo
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 50
            region: @cadastro-de-itens-da-nf
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G990D00
            width: 6
        }
        validation {
            maxLength: 10
        }
        source {
            type: databaseColumn
            databaseColumn: CUSTOUND
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

