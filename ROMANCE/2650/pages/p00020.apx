page 20 (
    name: Lista de Contas Bancarias Filiais
    title: Lista de Contas Bancarias Filiais
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region lista-de-contas-bancarias-filiais (
        name: Lista de Contas Bancarias Filiais
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idcontabanc 
                     , initcap(pf.nomepessoa) Filial
                     , initcap(b.nomebanco) Banco
                     , c.agencia
                     , c.conta
                     , initcap(c.beneficiario) beneficiario
                from contasbancariasfiliais c
                   , filiais         f
                   , pessoas         pf
                   , bancos          b
                where f.idpessoa  = pf.idpessoa
                  and c.idfilial  = f.idfilial
                  and c.idbanco   = b.idbanco
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 21
                items: {
                    P21_IDCONTABANC: #IDCONTABANC#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: This query returns more than 10,000 rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column AGENCIA (
            type: plainText
            heading {
                heading: Agencia
                alignment: center
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: AGENCIA
                endUserAlias: D
            }
            enableUsersTo {
                pivot: false
            }
        )

        column BANCO (
            type: plainText
            heading {
                heading: Banco
                alignment: center
            }
            layout {
                sequence: 8
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: BANCO
                endUserAlias: H
            }
            enableUsersTo {
                pivot: false
            }
        )

        column BENEFICIARIO (
            type: plainText
            heading {
                heading: Beneficiario
                alignment: center
            }
            layout {
                sequence: 6
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: BENEFICIARIO
                endUserAlias: F
            }
            enableUsersTo {
                pivot: false
            }
        )

        column CONTA (
            type: plainText
            heading {
                heading: Conta
                alignment: center
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: CONTA
                endUserAlias: E
            }
            enableUsersTo {
                pivot: false
            }
        )

        column FILIAL (
            type: plainText
            heading {
                heading: Filial
                alignment: center
            }
            layout {
                sequence: 7
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: FILIAL
                endUserAlias: G
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDCONTABANC (
            type: hidden
            heading {
                heading: Idcontabanc
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDCONTABANC
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        savedReport 14488 (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn AGENCIA (
                sequence: 3
            )

            displayColumn BANCO (
                sequence: 2
            )

            displayColumn BENEFICIARIO (
                sequence: 5
            )

            displayColumn CONTA (
                sequence: 4
            )

            displayColumn FILIAL (
                sequence: 1
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Nova Conta
        layout {
            sequence: 30
            region: @lista-de-contas-bancarias-filiais
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 21
                clearCache: 21
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

