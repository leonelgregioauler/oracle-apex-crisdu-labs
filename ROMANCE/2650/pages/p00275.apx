page 275 (
    name: Redefinir Senha
    title: Redefinir Senha
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        authentication: public
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region redefinir-senha (
        name: Redefinir senha
        type: staticContent
        source {
            htmlCode:
                ```html
                <font color="red">Informe o seu usuário!<br>
                Será enviado um email com o link para a troca de senha.</font> 
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P275_USUARIO (
        type: textField
        label {
            label: Usuário
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 10
            region: @redefinir-senha
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 4000
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button p275-envia-email (
        buttonName: P275_ENVIA_EMAIL
        label: Enviar Email
        layout {
            sequence: 20
            region: @redefinir-senha
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        advanced {
            htmlDomId: P275_ENVIA_EMAIL
        }
    )

    dynamicAction envia-email-para-trocar-senha (
        name: Envia email para trocar senha
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @p275-envia-email
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: P275_ENVIA_EMAIL
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process envia-email-para-trocar-senha (
        name: Envia email para trocar senha
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                pck_auditoriaromance.prc_redefinesenha(pusuario => :P275_USUARIO);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 542574529584033849
        }
        serverSideCondition {
            type: request=Value
            value: P275_ENVIA_EMAIL
        }
    )

)

