        }
    )

    pageItem P158_IDUSUARIO (
        type: hidden
        layout {
            sequence: 70
            region: @anexo-de-pagamentos-de-cheques
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDUSUARIO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidusuario number;
                begin
                  --
                  select idusuario
                  into vidusuario
                  from usuarios
                  where usuario = v('APP_USER');
                  --
                  return vidusuario;
                  --
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P158_NOMEARQUIVO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @anexo-de-pagamentos-de-cheques
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: NOMEARQUIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Anexar este arquivo!
        layout {
            sequence: 50
            region: @anexo-de-pagamentos-de-cheques
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 10
            region: @anexo-de-pagamentos-de-cheques
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P158_IDANEXOCHEQUEPGTO
        }
    )

    validation selecione-o-arquivo (
        name: Selecione o Arquivo
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P158_ARQUIVOTEMP
        }
        error {
            errorMessage: Selecione o arquivo para anexar!
            associatedItem: @P158_ARQUIVOTEMP
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process anexar (
        name: Anexar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_anexos.blob_to_file_cheques2pgto(pidchequepgto => :P158_IDCHEQUEPGTO);
                  commit;
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Arquivo Anexado!
        }
        advanced {
            executionMappingIdentifier: 2003900779551473505
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P158_ARQUIVOTEMP
        }
    )

    process deletar (
        name: Deletar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  :P158_IDANEXOCHEQUEPGTO := null;
                  --
                  pck_anexos.prc_apagaanexo_cheques2pgto(pidanexochequepgto => :P158_IDANEXODELETAR);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1408095181293863632
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    process fetch-row-from-anexoschequespgto (
        name: Fetch Row from ANEXOSCHEQUESPGTO
        type: autoRowFetch
        source {
            tableName: ANEXOSCHEQUESPGTO
            pkColumn: IDANEXOCHEQUEPGTO
            pkItem: P158_IDANEXOCHEQUEPGTO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1408187277560488407
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P158_IDANEXOCHEQUEPGTO is null then
                        select "#OWNER#"."SEQ_IDANEXOCHEQUEPGTO".nextval
                          into :P158_IDANEXOCHEQUEPGTO
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 1408187689603488409
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: itemIsNotNull
            item: P158_ARQUIVOTEMP
        }
    )

    process process-row-of-anexoschequespgto (
        name: Process Row of ANEXOSCHEQUESPGTO
        type: autoRowProcessing
        target {
            tableName: ANEXOSCHEQUESPGTO
            pkColumn: IDANEXOCHEQUEPGTO
            pkItem: P158_IDANEXOCHEQUEPGTO
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação processada.
        }
        advanced {
            executionMappingIdentifier: 1408188092672488409
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P158_ARQUIVOTEMP
        }
    )

    branch (
        name: Go To Page 158
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 158
                items: {
                    P158_IDCHEQUEPGTO: &P158_IDCHEQUEPGTO.
                    P158_IDANEXOCHEQUEPGTO:
                    P158_IDANEXODELETAR:
                }
                action: resetPagination
            }
        }
    )

)

