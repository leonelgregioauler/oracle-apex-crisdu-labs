page 327 (
    name: Passagens Convenção
    alias: PASSAGENS-CONVENÇÃO
    title: Passagens Convenção
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }

    region button-bar (
        name: Button Bar
        type: staticContent
        source {
            htmlCode: <div id="active_facets"></div>
        }
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region lista-de-passagens (
        name: Lista de Passagens
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpassagemconvencao
                     , decode(p.tipo_passagem,-1,'Completa',1,'Ida',2,'Volta') tipo_passagem
                     , p.companhia
                     , p.numero_voo
                     , p.localizador
                     , p.data
                     , p.hora_partida
                     , p.hora_chegada
                     , p.status_voo
                     , decode(p.comprar_hotel,'S','Sim','N','Não') comprar_hotel
                     , ( select listagg(ps.nomecompleto,', ') within group (order by nomecompleto)
                         from pessoaspassagensconvencao pp
                            , pessoasconvencao ps
                         where ps.idpessoaconvencao = pp.idpessoaconvencao
                           and pp.idpassagemconvencao = p.idpassagemconvencao ) passageiros
                     , valor
                     , ( select pck_romance.fnc_nomefilial(ps.idfilial)
                         from pessoaspassagensconvencao pp
                            , pessoasconvencao ps
                         where ps.idpessoaconvencao = pp.idpessoaconvencao
                           and pp.idpassagemconvencao = p.idpassagemconvencao 
                           and rownum = 1 ) franquia
                from passagensconvencao p
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
            icon: fa-plane
        }
        link {
            linkColumn: customTarget
            target: {
                page: 486
                items: {
                    P486_IDPASSAGEMCONVENCAO: #IDPASSAGEMCONVENCAO#
                }
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma passagem localizada.
        }
        advanced {
            savedReportMappingIdentifier: 94569163096952110
        }

        column COMPANHIA (
            type: plainText
            heading {
                heading: Companhia
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column COMPRAR_HOTEL (
            type: plainText
            heading {
                heading: Comprar Hotel
            }
            layout {
                sequence: 100
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: J
            }
        )

        column DATA (
            type: plainText
            heading {
                heading: Data
            }
            layout {
                sequence: 60
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: F
            }
        )

        column FRANQUIA (
            type: plainText
            heading {
                heading: Franquia
            }
            layout {
                sequence: 130
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: O
            }
        )

        column HORA_CHEGADA (
            type: plainText
            heading {
                heading: Hora Chegada
            }
            layout {
                sequence: 80
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column HORA_PARTIDA (
            type: plainText
            heading {
                heading: Hora Partida
            }
            layout {
                sequence: 70
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column IDPASSAGEMCONVENCAO (
            type: hidden
            heading {
                heading: Idpassagemconvencao
            }
            layout {
                sequence: 10
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column LOCALIZADOR (
            type: plainText
            heading {
                heading: Localizador
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column NUMERO_VOO (
            type: plainText
            heading {
                heading: Numero Voo
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column PASSAGEIROS (
            type: plainText
            heading {
                heading: Passageiros
            }
            layout {
                sequence: 110
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: K
            }
        )

        column STATUS_VOO (
            type: plainText
            heading {
                heading: Status Voo
            }
            layout {
                sequence: 90
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        column TIPO_PASSAGEM (
            type: plainText
            heading {
                heading: Tipo Passagem
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column VALOR (
            type: plainText
            heading {
                heading: Valor
                alignment: end
            }
            layout {
                sequence: 120
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: L
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 946829 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COMPANHIA (
                sequence: 3
            )

            displayColumn COMPRAR_HOTEL (
                sequence: 10
            )

            displayColumn DATA (
                sequence: 5
            )

            displayColumn FRANQUIA (
                sequence: 12
            )

            displayColumn HORA_CHEGADA (
                sequence: 7
            )

            displayColumn HORA_PARTIDA (
                sequence: 6
            )

            displayColumn LOCALIZADOR (
                sequence: 1
            )

            displayColumn NUMERO_VOO (
                sequence: 4
            )

            displayColumn PASSAGEIROS (
                sequence: 11
            )

            displayColumn STATUS_VOO (
                sequence: 9
            )

            displayColumn TIPO_PASSAGEM (
                sequence: 2
            )

            displayColumn VALOR (
                sequence: 8
            )

            controlBreak (
                column: LOCALIZADOR
                layout {
                    sequence: 1
                }
            )

            highlight ir-condition (
                name: Comprar Hotel
                condition {
                    column: COMPRAR_HOTEL
                    value: Sim
                }
                colors {
                    background: #1ec20c
                }
                execution {
                    sequence: 10
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Nova Passagem por Trecho
        layout {
            sequence: 20
            region: @button-bar
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 487
                items: {
                    P487_IDPASSAGEMCONVENCAO:
                }
                clearCache: 487
                action: clearRegions
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create-complete (
        buttonName: CREATE_COMPLETE
        label: Nova Passagem Completa
        layout {
            sequence: 10
            region: @button-bar
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--primary
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 489
                items: {
                    P489_IDPASSAGEMCONVENCAO:
                    P489_IDPASSAGEMCONVENCAO_1:
                    P489_TIPO_PASSAGEM: 1
                    P489_TIPO_PASSAGEM_V: 2
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

