    pageItem P258_IDCONTABANC (
        type: selectList
        label {
            label: Conta para Depósito
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ' '||initcap(nvl(cb.beneficiario,p.apelido)||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||') - Fornecedor: '||initcap(p.nomepessoa) display_value
                     , cb.idcontabanc    return_value
                from contasbancarias cb
                   , bancos b
                   , pessoas p
                   , fornecedores f
                   , notasfiscais nf
                where cb.idbanco      = b.idbanco
                  and cb.idpessoa     = p.idpessoa
                  and f.idpessoa      = p.idpessoa
                  and f.idfornecedor  = nf.idfornemitente
                  and cb.ativo        = 'S'
                  and nf.idnotafiscal = :P258_IDNOTAFISCAL
                union
                select initcap(nvl(cb.beneficiario,p.apelido)||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||') - Fornecedor Destino: '||pck_romance.fnc_nomefornecedor(f.idfornecedor) display_value
                     , cb.idcontabanc    return_value
                from contasbancarias cb
                   , bancos b
                   , pessoas p
                   , fornecedores f
                   , notasfiscais nf
                where cb.idbanco      = b.idbanco
                  and cb.idpessoa     = p.idpessoa
                  and f.idpessoa      = p.idpessoa
                  and f.idfornecedor  = nf.idfornecedordestino
                  and cb.ativo        = 'S'
                  and nf.idnotafiscal = :P258_IDNOTAFISCAL
                order by 1
                ```
        }
        layout {
            sequence: 140
            region: @vencimentos-da-nf-v
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P258_IDCONTABANCARIA_DESTINO (
        type: selectList
        label {
            label: Conta Destino
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(cb.beneficiario,p.apelido)||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||') - Empresa Destino: '||pck_romance.fnc_nomefilial(f.idfilial) display_value
                     , cb.idcontabanc    return_value
                from contasbancarias cb
                   , bancos b
                   , pessoas p
                   , notasfiscais nf
                   , filiais         f
                where cb.idbanco      = b.idbanco
                  and cb.idpessoa     = p.idpessoa
                  and f.idpessoa      = p.idpessoa
                  and f.idfilial      = nf.idfilialdestino
                  and cb.ativo        = 'S'
                  and nf.idnotafiscal = :P258_IDNOTAFISCAL
                order by 1
                ```
        }
        layout {
            sequence: 210
            region: @vencimentos-da-nf-v
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

