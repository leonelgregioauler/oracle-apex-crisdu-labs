    validation valida-alteração-de-informações (
        name: Valida Alteração de informações
        execution {
            sequence: 90
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentomovimentacoes fm
                   , pagamentosfornecedores  pf
                where fm.datafechamento  = pf.databaixa
                  and fm.idcontabancaria = pf.idcontapagamento
                  and pf.idvencimento    = :P258_IDVENCIMENTO
                union
                select 1
                  from roman.fechamentomovimentacoes f
                  where f.datafechamento  = :P258_DATAVENCIMENTO
                    and f.idcontabancaria = :P258_IDCONTABANC
                ```
        }
        error {
            errorMessage: Fechamento já encerrado para este dia! Entre em contato com o responsável pelo fechamento.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    validation valida-centro-de-custo (
