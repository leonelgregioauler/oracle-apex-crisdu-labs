        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                v('REQUEST') in ('SAVE','CREATE') and exists ( select 1
                                                               from matrizregrasdespesas md
                                                               where md.idfornecedor = :P258_IDFORNECEDOR
                                                                 and md.idfilial     = :P258_IDFILIALDESTINO )
                                                  and not exists ( select 1
                                                                   from rateiosnotasfiscais rn
                                                                   where rn.idnotafiscal = :P258_IDNOTAFISCAL )
                                                  and :P258_TIPONOTA in ('D','C')
