                plsqlCode:
                    ```plsql
                    begin
                      --
                      select md.idcentrodecusto
                           , md.idcontafinan
                           , md.idsubcontafinan
                           , md.tipo
                           , md.tiporegra
                      into :P258_IDCENTRODECUSTO
                         , :P258_IDCONTAFINANCEIRA
                         , :P258_IDSUBCONTAFINANCEIRA
                         , :P258_FIXAVARIAVEL
                         , :P258_TIPO
                      from matrizregrasdespesas md
                      where md.idmatrizregra = :P258_IDMATRIZREGRA
                        and md.ativo         = 'S';
                      --
                      exception when no_data_found then
                        null;
                    end;
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
