    process atualiza (
        name: "Atualiza "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  update vencimentos
                  set tipopagamento = :P258_TIPOPAGAMENTO
                    , idcontafinanceira     = :P258_IDCONTAFINANCEIRA
                    , idsubcontafinanceira  = :P258_IDSUBCONTAFINANCEIRA
                    , idcontabanc           = :P258_IDCONTABANC
                    , idmoeda               = :P258_IDMOEDA
                  where idnotafiscal  = :P258_IDNOTAFISCAL
                    and tipopagamento is null
                    and idcontabanc is null;
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 1544590481377908313
        }
    )

    process atualiza-prioridade (
        name: Atualiza prioridade
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vprioridade varchar2(1) := nvl(:P258_PRIORIDADE,'0');
                begin
                  --
                  if vprioridade != '1' then
                    vprioridade := null;
                  end if;
                  --
                  update pagamentosfornecedores
                  set prioridade = vprioridade 
                  where idvencimento = :P258_IDVENCIMENTO ;
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 1544590858719908313
        }
    )

    process busca-valor-restante (
        name: Busca valor restante
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vvalor number;
                begin
                  select VALORLIQUIDO - nvl(( select sum(valor)
                                        from vencimentos v
                                        where v.idnotafiscal = n.idnotafiscal ),0) valor
                  into vvalor
                  from notasfiscais n
                  where idnotafiscal = :P258_IDNOTAFISCAL;
                  :P258_VALOR := to_char(vvalor,'999G999G999G990D00');
                end;
                ```
        }
        execution {
            sequence: 30
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 4067240167772668544
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P258_IDVENCIMENTO is null
        }
    )

    process fetch-row-of-vencimentos (
        name: Fetch Row of Vencimentos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidvencimento number := :P258_IDVENCIMENTO;
                  vvalor        number(15,2);
                  --
                begin
                  -- Call the procedure
                  pck_notasfiscais_rmc.prc_vencimentos( pidvencimento         => vidvencimento
                                                      , pidnotafiscal         => :P258_IDNOTAFISCAL
                                                      , pdias                 => :P258_DIAS
                                                      , pdatavencimento       => :P258_DATAVENCIMENTO
                                                      , pvalor                => vvalor
                                                      , pidcontabanc          => :P258_IDCONTABANC
                                                      , ptipopagamento        => :P258_TIPOPAGAMENTO
                                                      , pobservacao           => :P258_OBSERVACAO
                                                      , pidentificado         => :P258_IDENTIFICADO
                                                      , pidsemanavencimento   => :P258_IDSEMANAVENCIMENTO
                                                      , pidmoeda              => :P258_IDMOEDA
                                                      , pidduplicata          => :P258_IDDUPLICATA
                                                      , pidcontafinanceira    => :P258_IDCONTAFINANCEIRA
                                                      , pidsubcontafinanceira => :P258_IDSUBCONTAFINANCEIRA
                                                      , pgera_transferencia   => :P258_GERA_TRANSFERENCIA
                                                      , pidconta_destino      => :P258_IDCONTABANCARIA_DESTINO
                                                      , pidcentrodecusto      => :P258_IDCENTRODECUSTO
                                                      , ptipo                 => :P258_TIPO
                                                      , pfixavariavel         => :P258_FIXAVARIAVEL
                                                      , pidmatrizregra        => :P258_IDMATRIZREGRA
                                                      , pmd5                  => :P258_MD5
                                                      , poperacao_dml         => 'S');
                  --
                  :P258_VALOR := trim(to_char(vVALOR,'999G999G999G990D00'));
                  --
                end;
                ```
        }
        execution {
            sequence: 20
            point: afterHeader
        }
        error {
            errorMessage: Não é possível obter valor de item de chave primária.
        }
        advanced {
            executionMappingIdentifier: 1544603003249500606
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P258_IDVENCIMENTO
        }
    )

    process processo-delete-em-vencimentos-grid (
        name: Processo DELETE em Vencimentos - Grid
        type: executeCode
        editableRegion: @lista-de-vencimentos-2
        source {
            plsqlCode:
                ```plsql
                declare
                    vnumbernull     number;
                    vvarcharnull    varchar2(10);
                    vdatenull       date;
                    voperacao_dml   varchar2(1)    := 'D';
                begin
                
                    case :APEX$ROW_STATUS
                
                        when 'D' then
                
                            pck_notasfiscais_rmc.prc_vencimentos( pidvencimento         => :IDVENCIMENTO
                                                                , pidnotafiscal         => vnumbernull
                                                                , pdias                 => vnumbernull
                                                                , pdatavencimento       => vdatenull
                                                                , pvalor                => vnumbernull
                                                                , pidcontabanc          => vnumbernull
                                                                , ptipopagamento        => vvarcharnull
                                                                , pobservacao           => vvarcharnull
                                                                , pidentificado         => vvarcharnull
                                                                , pidsemanavencimento   => vnumbernull
                                                                , pidmoeda              => vnumbernull
                                                                , pidduplicata          => vnumbernull
                                                                , pidcontafinanceira    => vnumbernull
                                                                , pidsubcontafinanceira => vnumbernull
                                                                , pgera_transferencia   => vvarcharnull
                                                                , pidconta_destino      => vnumbernull
                                                                , pidcentrodecusto      => vnumbernull
                                                                , ptipo                 => vvarcharnull
                                                                , pfixavariavel         => vvarcharnull
                                                                , pidmatrizregra        => vnumbernull
                                                                , pmd5                  => vvarcharnull
                                                                , poperacao_dml         => voperacao_dml );
                
                    end case;
                end;
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 1323785920425661505
        }
    )

    process processo-dml-em-vencimentos (
        name: Processo DML em Vencimentos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vdatavencimento date;
                  vvalor          number;
                begin
                  --
                  vdatavencimento := to_date(:P258_DATAVENCIMENTO,'DD/MM/RRRR');
                 -- vvalor          := to_number(:P258_VALOR,'999G999G999G999G990D00');
                  --
                  if v('REQUEST') = 'CREATE' then
                    :P258_OPERACAO_DML := 'I';
                  elsif v('REQUEST') = 'SAVE' then  
                    :P258_OPERACAO_DML := 'U';
                  elsif v('REQUEST') = 'DELETE' then  
                    :P258_OPERACAO_DML := 'D';
                  END IF;
                  
                  -- Call the procedure
                  pck_notasfiscais_rmc.prc_vencimentos( pidvencimento         => :P258_IDVENCIMENTO
                                                      , pidnotafiscal         => :P258_IDNOTAFISCAL
                                                      , pdias                 => :P258_DIAS
                                                      , pdatavencimento       => vDATAVENCIMENTO
                                                      , pvalor                => :P258_VALOR
                                                      , pidcontabanc          => :P258_IDCONTABANC
                                                      , ptipopagamento        => :P258_TIPOPAGAMENTO
                                                      , pobservacao           => :P258_OBSERVACAO
                                                      , pidentificado         => :P258_IDENTIFICADO
                                                      , pidsemanavencimento   => :P258_IDSEMANAVENCIMENTO
                                                      , pidmoeda              => :P258_IDMOEDA
                                                      , pidduplicata          => :P258_IDDUPLICATA
                                                      , pidcontafinanceira    => :P258_IDCONTAFINANCEIRA
                                                      , pidsubcontafinanceira => :P258_IDSUBCONTAFINANCEIRA
                                                      , pgera_transferencia   => :P258_GERA_TRANSFERENCIA
                                                      , pidconta_destino      => :P258_IDCONTABANCARIA_DESTINO
                                                      , pidcentrodecusto      => :P258_IDCENTRODECUSTO
                                                      , ptipo                 => :P258_TIPO
                                                      , pfixavariavel         => :P258_FIXAVARIAVEL
                                                      , pidmatrizregra        => :P258_IDMATRIZREGRA
                                                      , pmd5                  => :P258_MD5
                                                      , poperacao_dml         => :P258_OPERACAO_DML);
                end;
                
                ```
        }
        execution {
            sequence: 20
        }
        error {
            errorMessage: Erro ao salvar informações!
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 1544589676613908312
        }
    )

