page 258 (
    name: Vencimentos para Extrato
    title: Vencimentos para Extrato
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 70%
        height: 80%
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function abreconta ( pid )
             {
               window.open('f?p=&APP_ID.:159:&SESSION.::&DEBUG.::P159_IDPGTOFORN:'+pid, 'telaconta', 'status = 1, height = 400, width = 1000, resizable = 0');
               void(0);
             }
            
            function formataMoeda(valor){
              v = valor.value;
              v=v.replace(/\D/g,"") // permite digitar apenas numero
              v=v.replace(/(\d{1})(\d{14})$/,"$1.$2") // coloca ponto antes dos ultimos digitos
              v=v.replace(/(\d{1})(\d{11})$/,"$1.$2") // coloca ponto antes dos ultimos 11 digitos
              v=v.replace(/(\d{1})(\d{8})$/,"$1.$2") // coloca ponto antes dos ultimos 8 digitos
              v=v.replace(/(\d{1})(\d{5})$/,"$1.$2") // coloca ponto antes dos ultimos 5 digitos
              v=v.replace(/(\d{1})(\d{1,2})$/,"$1,$2") // coloca virgula antes dos ultimos 2 digitos
              valor.value = v;
            }
            ```
    }
    htmlHeader {
        htmlHeader:
            ```html
            <script language="JavaScript" type="text/javascript">
            <!--
            
             htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            //-->
            </script>
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region lista-de-vencimentos (
        name: Lista de Vencimentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.dias
                     , v.datavencimento
                     , v.valor 
                     , ( select initcap(cb.beneficiario||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||')' 
                         from bancos b
                            , contasbancarias cb
                         where cb.idbanco      = b.idbanco
                           and cb.idcontabanc = v.idcontabanc ) conta
                     , v.idvencimento
                     , ( select descricao
                         from formaspagamentos t
                         where idformapagamento = v.tipopagamento ) "Tipo Pagamento"
                     , v.observacao "Observação"
                     , null link
                     , ( select c.nomeconta  
                         from contasfinanceiras c
                         where c.idcontafinan = v.idcontafinanceira ) contafinan
                    , ( select c.nomeconta
                        from subcontasfinanceiras c 
                        where c.idsubcontafinan = v.idsubcontafinanceira ) subconta
                    , pck_util.fnc_siglamoedaid( v.idmoeda) moeda
                    , decode(v.identificado,'S','Sim','N','Não') identificado
                    , v.idnotafiscal
                    , ( select cd.nome
                        from centrodecustos cd
                        where cd.idcentrodecusto = v.idcentrodecusto ) centrodecusto
                from notasfiscais nf
                   , vencimentos  v
                where v.idnotafiscal  = nf.idnotafiscal
                  and nf.idnotafiscal = :P258_IDNOTAFISCAL  
                  and exists ( select 1
                               from extratoscontasbancarias e
                               where e.idvencimento = v.idvencimento )
                union
                select v.dias
                     , v.datavencimento
                     , v.valor 
                     , null conta
                     , v.idvencimento
                     , ( select descricao
                         from formaspagamentos t
                         where idformapagamento = v.tipopagamento ) "Tipo Pagamento"
                     , v.observacao "Observação"
                     , null link
                     , ( select c.nomeconta  
                         from contasfinanceiras c
                         where c.idcontafinan = v.idcontafinanceira ) contafinan
                    , ( select c.nomeconta
                        from subcontasfinanceiras c 
                        where c.idsubcontafinan = v.idsubcontafinanceira ) subconta
                    , pck_util.fnc_siglamoedaid( v.idmoeda) moeda
                    , decode(v.identificado,'S','Sim','N','Não') identificado
                    , v.idnotafiscal
                    , ( select cd.nome
                        from centrodecustos cd
                        where cd.idcentrodecusto = v.idcentrodecusto ) centrodecusto
                from notasfiscais nf
                   , vencimentos  v
                where v.idnotafiscal  = nf.idnotafiscal
                  and v.idcontabanc  is null
                  and nf.idnotafiscal = :P258_IDNOTAFISCAL
                  and exists ( select 1
                               from extratoscontasbancarias e
                               where e.idvencimento = v.idvencimento )
                order by 1
                ```
        }
