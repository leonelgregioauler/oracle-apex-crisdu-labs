    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 30
            region: @vencimentos-da-nf-v
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: INSERT
        }
        serverSideCondition {
            type: itemIsNull
            item: P258_IDVENCIMENTO
        }
    )

    button delete (
        buttonName: DELETE
        label: Excluir
        layout {
            sequence: 60
            region: @vencimentos-da-nf-v
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P258_IDVENCIMENTO
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 40
            region: @vencimentos-da-nf-v
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 27
                items: {
                    P27_IDNOTAFISCAL: &P258_IDNOTAFISCAL.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 50
            region: @vencimentos-da-nf-v
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P258_IDVENCIMENTO
        }
    )

    dynamicAction confirma (
        name: Confirma
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @delete
        }

        action native-confirm (
            action: confirm
            settings {
                message: Deseja realmente excluir?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: DELETE
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction feriado (
        name: Feriado
        execution {
            sequence: 80
        }
        when {
            selectionType: items
            items: P258_DATAVENCIMENTO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                        select 'S'
                          into :P258_FERIADO
                          from favorita.feriados
                         where dataferiado = :P258_DATAVENCIMENTO;
                      exception
                        when no_data_found then
                          :P258_FERIADO:='N';
                         
                    end;
                    ```
                itemsToSubmit: P258_DATAVENCIMENTO
                itemsToReturn: P258_FERIADO
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction habilita-conta-destino (
        name: Habilita Conta Destino
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P258_GERA_TRANSFERENCIA
        }
        clientSideCondition {
            type: item=value
            item: P258_GERA_TRANSFERENCIA
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P258_IDCONTABANCARIA_DESTINO
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
