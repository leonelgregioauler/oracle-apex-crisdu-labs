    process atualiza-nota-de-venda (
        name: Atualiza Nota de Venda
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 --
                  vvalortotal   number;
                  vidmatriz     number;
                  vidpessoa     number;
                  vidsubconta   number;
                  vidcontafinan number;
                  vidcontabanc  number;
                  vidnotacompra number;
                  vnotavenda    number := :P207_IDNOTAFISCAL;
                  --
                begin
                  --
                  select nf.idnotafiscalcompra
                  into vidnotacompra
                  from roman.notasfiscais nf 
                  where nf.idnotafiscal = vnotavenda;
                  --
                  select sum(i.valortotal)
                  into vvalortotal
                  from itemnf i
                  where i.idnotafiscal = :vnotavenda;
                  --
                  select idpessoa
                  into vidpessoa
                  from fornecedores f
                  where f.idpessoa = ( select idpessoa
                                       from filiais ff
                                          , notasfiscais n
                                       where ff.idfilial = n.idfilialdestino
                                         and n.idnotafiscal = vidnotacompra );
                  --
                  select min(c.idcontabanc)
                  into vidcontabanc
                  from contasbancarias c
                  where c.idpessoa = vidpessoa
                    and c.ativo    = 'S';
                  --
                  insert into itemnf ( iditnf , idnotafiscal , idproduto , custound , qtd_u )
                  values ( seq_iditemnfroman.nextval , vnotavenda, 3981, 1.00, vvalortotal );
                  --
                  begin
                    --
                    select mr.idmatrizregrareceita
                         , mr.idcontafinan
                         , mr.idsubcontafinan
                    into vidmatriz
                       , vidcontafinan
                       , vidsubconta
                    from matrizregrasreceitas mr
                    where mr.idfornecedoremitente = :P207_IDFORNEMITENTE
                      and mr.idfornecedorcliente = :P207_IDFORNECEDORDESTINO
                      and rownum = 1;
                    --
                  exception
                    when others then
                      null;
                  end;
                  --
                  if vidmatriz is not null then
                    --
                    insert into roman.vencimentosreceber ( idvencimento   , idnotafiscal         , dias
                                                         , datavencimento , valor                , idcontabanc
                                                         , tipopagamento  , abatimentoconfirmado ,idcentrodecusto
                                                         , idcontafinan   , idsubcontafinan      ,tipo
                                                         , fixavariavel   , idmatrizregrareceita )
                    select idvencimento     , vnotavenda   , dias
                         , datavencimento   , valor        , vidcontabanc
                         , 'A'              , null         , null
                         , vidcontafinan    , vidsubconta  , null
                         , null             , vidmatriz
                        from roman.vencimentos 
                        where idnotafiscal = vidnotacompra;
                  
                  end if;
                  --
                  commit;
                  --
                  if vidmatriz is null then
                    --
                     apex_error.add_error(
                        p_message          => 'Matriz de Receita deve estar preenchido! Solicite o cadastro da matriz para finalizar.',
                        p_display_location => apex_error.c_inline_in_notification );
                     return;
                     --
                  else 
                    --
                    apex_application.g_print_success_message := '<span style="color : white ">Venda atualizada com sucesso! </span>';
                    -- 
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 4413693383263095313
        }
        serverSideCondition {
            type: request=Value
            value: ATUALIZAR_VALOR
        }
    )

