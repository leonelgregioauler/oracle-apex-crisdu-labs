        column IDPRODUTO (
            reportColumnQueryId: 4
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Produto
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(p.nomeproduto)||' ( R$  '||TRIM(to_char(f.precocusto,'999G999G990D00'))||')' display_value
                    , p.idproduto return_value
                    from produtos p
                       , fornecedoresprodutos f
                    where p.idproduto = f.idproduto 
                      and f.idfornecedor = ( select idfornemitente from notasfiscais where idnotafiscal = :P207_IDNOTAFISCAL)
                      and p.ativo = 'S'
                    ```
            }
            layout {
                sequence: 5
            }
            appearance {
                width: 50
            }
        )

