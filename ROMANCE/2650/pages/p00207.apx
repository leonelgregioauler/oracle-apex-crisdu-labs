    region produtos-da-nf (
        name: Produtos da NF
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select '<a href="javascript:window.open(''f?p=&APP_ID.:23:&SESSION.::NO:23:P23_IDITNF:'||i.iditnf||''',''itens'',''toolbar=no,location=no,status=no,menubar=no,scrollbars=no,resizable=no,width=550,height=200,left=100,top=200'',''_blank'');void(0);"><img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0"></a>' link
                , i.iditnf
                , initcap(p.nomeproduto) "Produto"
                     , trim(to_char(i.custound, '999G990D00')) custo
                     , i.qtd_pp "Qtd PP"
                     , i.qtd_p "Qtd P"
                     , i.qtd_m "Qtd M"
                     , i.qtd_g "Qtd G"
                     , i.qtd_gg "Qtd GG"
                     , i.qtd_egg "Qtd EGG"
                     , i.qtd_exgg "Qtd EXGG"
                     , i.qtd_u "Qtd U"
                     , i.qtd_total "Qtd TOTAL"
                     , (i.qtd_total * i.custound) "TOTAL ITEM"
                     , i.observacao
                from itemnf i
                   , produtos p
                where i.idproduto = P.idproduto
                  and i.idnotafiscal = :P207_IDNOTAFISCAL
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from itemnf i
                where i.idnotafiscal = :P207_IDNOTAFISCAL
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
