page 207 (
    name: Venda
    title: Venda
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function abrevencto() 
              {
                vnota = document.getElementById('P207_IDNOTAFISCAL').value;
                window.open('f?p=&APP_ID.:208:&SESSION.::NO::P208_IDNOTAFISCAL,P208_IDVENCIMENTO:'+vnota+',' ,'vencto','toolbar=no,location=no,status=no,menubar=no,scrollbars=no,resizable=no,width=1000,height=300,left=200,top=300','_blank'); void(0);
              }
            
            
            function fnc_popup()
            {vid = document.getElementById("P207_IDNOTAFISCAL").value;
            window.open('f?p=&APP_ID.:190:&SESSION.::NO::P190_IDNOTAFISCAL,P190_IDITNF:'+vid+',','insprod', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=600,height=300,left=250,top=100','_blank'); void(0);
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region incluir-itens-na-nf (
        name: Incluir Itens na NF
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDITNF",
                "IDITNF" IDITNF_DISPLAY,
                "IDNOTAFISCAL",
                "IDPRODUTO",
                "CUSTOUND",
                "VALORTOTAL",
                "QTD_PP",
                "QTD_P",
                "QTD_M",
                "QTD_G",
                "QTD_GG",
                "QTD_EGG",
                "QTD_EXGG",
                "QTD_TOTAL",
                "QTD_U",
                "OBSERVACAO"
                from "#OWNER#"."ITEMNF"
                where 1 = 2
                ```
        }
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P207_IDNOTAFISCAL is not null
                  and :P207_TIPONOTA = 'V'
                ```
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
        }
        componentAdvanced {
            stripHtml: true
        }

