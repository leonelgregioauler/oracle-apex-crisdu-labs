    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    update notasfiscais nfs
                    set nfs.valortotal = ( select sum(i.valortotal) from itemnf i where i.idnotafiscal = nfs.idnotafiscal and idproduto is not null)
                    where nfs.idnotafiscal = :P207_IDNOTAFISCAL;   
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 4131577498714490002
