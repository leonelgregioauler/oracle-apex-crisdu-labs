page 116 (
    name: Movimentação
    alias: INÍCIO
    title: Movimentação
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region movimentação (
        name: Movimentação
        type: list
        source {
            list: @movimentação
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        componentAppearance {
            listTemplate: @/cards
            templateOptions: [
                #DEFAULT#
                t-Cards--featured force-fa-lg
                t-Cards--displayIcons
                t-Cards--cols
                u-colors
                t-Cards--animColorFill
            ]
        }
    )

    region notas-por-destino-romance (
        name: Notas por Destino Romance
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select null link
                     , decode(n.idfilialdestino, null, 'Total: ',pck_romance.fnc_nomefilial(n.idfilialdestino)) label
                     , trunc(sum(n.valortotal)/9000) value
                from notasfiscais n
                where n.situacao != 'C'
                  and to_char(n.dtnf,'RRRR') = to_char(sysdate,'RRRR' )
                  and exists ( select 1 from filiais where tipofilial = 'D' and idfilial = n.idfilialdestino )
                  and valortotal is not null
                  and exists ( select 1
                               from itemnf i
                               where i.idnotafiscal = n.idnotafiscal
                                 and exists (  select 1 
                                                from produtos p 
                                                where p.idproduto = i.idproduto 
                                                  and p.venda = 'S') )
                group by n.idfilialdestino
                order by 3 desc
                
                ```
        }
        layout {
            sequence: 70
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: LABEL
            valueColumn: VALUE
            valueDisplay: percentage
            barWidthCalculation: relative
            maximumRows: 21
        }
    )

    region notas-por-fornecedor-v (
        name: Notas por Fornecedor V1
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select null link
                     , pck_romance.fnc_nomefornecedor(n.idfornemitente) label
                     , trunc(sum(n.valortotal)) value
                from notasfiscais n
                where n.situacao != 'C'
                  and n.idfornemitente is not null
                  and to_char(n.dtnf,'RRRR') = to_char(sysdate,'RRRR' )
                  and exists ( select 1
                               from pagamentosfornecedores pf
                               where pf.idnotafiscal = n.idnotafiscal )
                  and valortotal is not null
                group by n.idfornemitente
                order by 3 desc
                
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: LABEL
            valueColumn: VALUE
            valueDisplay: percentage
            barWidthCalculation: relative
            maximumRows: 30
        }
    )

    region notas-por-fornecedor-v-2 (
        name: Notas por Fornecedor V2
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select null link
                     , pck_romance.fnc_nomefornecedor(n.idfornemitente) label
                     , trunc(sum(n.valortotal)/9000) value
                from notasfiscais n
                where n.situacao != 'C'
                  and n.idfornemitente is not null
                  and to_char(n.dtnf,'RRRR') = to_char(sysdate,'RRRR' )
                  and exists ( select 1 from filiais where tipofilial = 'D' and idfilial = n.idfilialdestino )
                  and valortotal is not null
                  and exists ( select 1
                               from itemnf i
                               where i.idnotafiscal = n.idnotafiscal
                                 and exists (  select 1 
                                                from produtos p 
                                                where p.idproduto = i.idproduto 
                                                  and p.venda = 'S') )
                group by n.idfornemitente
                order by 3 desc
                
                ```
        }
        layout {
            sequence: 60
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: LABEL
            valueColumn: VALUE
            valueDisplay: percentage
            barWidthCalculation: relative
            maximumRows: 30
        }
    )

)

