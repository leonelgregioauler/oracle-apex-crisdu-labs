    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 30
            region: @nova-entrada
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentossemanais f
                where nvl(f.concluido,'N') = 'N'
                  and f.idfechamento = :P0_IDFECHAMENTO
                  and :P64_IDENTRADA is not null 
                  and pck_util.fnc_verificaacesso(2732,v('APP_USER')) = 'S'
                ```
        }
    )

