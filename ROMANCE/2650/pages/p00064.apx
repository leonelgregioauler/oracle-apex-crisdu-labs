    region anexos (
        name: Anexos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomearquivo
                     , dataanexo data
                     , ( select pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario) usuario
                     , roman.pck_bucket.sp_abre_anexo(url_bucket) preview
                from anexossaidas t
                where idsaida = ( select s.idsaida
                                  from saidasdiversas s
                                     , movimentosgeral m
                                     , entradasdiversas e
                                  where e.identrada        = :P64_IDENTRADA
                                    and m.idmovimentogeral = e.idmovimentogeral 
                                    and s.idsaida          = m.idsaidadiversa )
                union
                select nomearquivo
                     , dataanexo data
                     , ( select pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = tt.idusuario) usuario
                     , roman.pck_bucket.sp_abre_anexo(url_bucket) preview
                from anexosentradas tt
                where tt.identrada = :P64_IDENTRADA
                order by 3
                
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from anexossaidas t
                where idsaida = ( select s.idsaida
                                  from saidasdiversas s
                                     , movimentosgeral m
                                     , entradasdiversas e
                                  where e.identrada        = :P64_IDENTRADA
                                    and m.idmovimentogeral = e.idmovimentogeral 
                                    and s.idsaida          = m.idsaidadiversa )
                union
                select 1
                from anexosentradas a
                where a.identrada = :P64_IDENTRADA
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 5714086283968746907
        }

