    process fetch-row-from-entradasdiversas (
        name: Fetch Row from ENTRADASDIVERSAS
        type: autoRowFetch
        source {
            tableName: ENTRADASDIVERSAS
            pkColumn: IDENTRADA
            pkItem: P64_IDENTRADA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Unable to fetch row.
        }
        advanced {
            executionMappingIdentifier: 178968627230520664
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDENTRADASDIVERSAS.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P64_IDENTRADA := get_pk; 
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Unable to get primary key item value.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 178968820442520666
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-entradasdiversas (
        name: Process Row of ENTRADASDIVERSAS
        type: autoRowProcessing
        target {
            tableName: ENTRADASDIVERSAS
            pkColumn: IDENTRADA
            pkItem: P64_IDENTRADA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        error {
