    region extrato-de-fornecedor (
        name: Extrato de Fornecedor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.registro
                     , s.idcontabancaria
                     , pck_cadastros_rmc.fnc_retornacontabancaria(s.idcontabancaria) contabancaria
                     , s.datamovimento
                     , s.fatura
                     , s.destino
                     , s.identificacao
                     , s.valorapagar
                     , s.valorpago
                     , s.considerar
                     , ( select sum(considerar)
                         from vw_saldo_fornecedores sd
                         where sd.registro <= s.registro
                           and exists ( select 1
                                        from contasbancarias c
                                        where c.idcontabanc = sd.idcontabancaria
                                          and c.idpessoa = :P398_IDFORNECEDOR ) 
                           and ( :P398_TIPO_PESQUISA   = 'T'
                              or ( :P398_TIPO_PESQUISA = 'P' and trunc(sd.datamovimento) between to_date(:P398_DATAINICIO,'DD/MM/RRRR') and to_date(:P398_DATAFIM,'DD/MM/RRRR') )
                              or ( :P398_TIPO_PESQUISA = 'M' and ( :P398_MES is null or extract (month from sd.datamovimento) = :P398_MES ) 
                                                             and extract (year from sd.datamovimento) = :P398_ANO ) )
                           and ( :P398_IDCONTABANCARIA is null or sd.idcontabancaria = :P398_IDCONTABANCARIA ) ) saldo_atual
                from ( select sf.registro
                            , sf.idcontabancaria
                            , sf.datamovimento
                            , sf.fatura
                            , sf.destino
                            , sf.identificacao
                            , sf.valorapagar
                            , sf.valorpago
                            , sf.considerar
                       from vw_saldo_fornecedores sf
                       where exists ( select 1
                                      from contasbancarias c
                                      where c.idcontabanc = sf.idcontabancaria
                                        and c.idpessoa = :P398_IDFORNECEDOR ) 
                         and ( :P398_TIPO_PESQUISA   = 'T'
                            or ( :P398_TIPO_PESQUISA = 'P' and trunc(sf.datamovimento) between to_date(:P398_DATAINICIO,'DD/MM/RRRR') and to_date(:P398_DATAFIM,'DD/MM/RRRR') )
                            or ( :P398_TIPO_PESQUISA = 'M' and ( :P398_MES is null or extract (month from sf.datamovimento) = :P398_MES ) 
                                                           and extract (year from sf.datamovimento) = :P398_ANO ) )
                         and ( :P398_IDCONTABANCARIA is null or sf.idcontabancaria = :P398_IDCONTABANCARIA )
                       order by 1 ) s
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P398_TIPO_RELATORIO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 5118915678510463422
        }

