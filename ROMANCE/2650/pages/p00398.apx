    pageItem P398_IDCONTABANCARIA (
        type: selectList
        label {
            label: Conta Bancária
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(cb.beneficiario||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||') - Fornecedor: '||pck_romance.fnc_nomefornecedor(f.idfornecedor) display_value
                     , cb.idcontabanc    return_value
                from contasbancarias cb
                   , bancos b
                   , fornecedores f
                where cb.idbanco      = b.idbanco
                  and cb.idpessoa     = f.idpessoa
                  and cb.ativo        = 'S'
                  and f.idpessoa = :P398_IDFORNECEDOR
                order by 1
                ```
            nullDisplayValue: - Todas -
        }
        cascadingLov {
            parentItems: P398_IDFORNECEDOR
        }
        layout {
            sequence: 110
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P398_IDFORNECEDOR (
        type: popupLov
        label {
            label: Fornecedor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefornecedor(idfornecedor) ||'  --  '||pck_romance.fnc_nomepessoa(idpessoa) ||'   ID:'||idfornecedor display_value
                     , fe.idpessoa return_value
                from fornecedores fe
                --where fe.ativo = 'S'
                where pck_util.fnc_verificaacesso(2748,v('APP_USER')) = 'S'
                union
                select pck_romance.fnc_nomefornecedor(fe.idfornecedor) ||'  --  '||pck_romance.fnc_nomepessoa(fe.idpessoa) ||'   ID:'||fe.idfornecedor display_value
                     , fe.idpessoa return_value
                from fornecedores fe
                inner join usuarios u on u.idpessoa = fe.idpessoa
                                      and u.usuario = v('APP_USER') 
                --where fe.ativo = 'S'
                where pck_util.fnc_verificaacesso(2748,u.usuario) = 'N'
                order by 1
                ```
            nullDisplayValue: - Todos -
            nullReturnValue: -1
        }
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 80
        }
        security {
            encryptSessionState: false
        }
    )

