    region extrato-por-movimentação (
        name: Extrato Por Movimentação
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d1.data
                     , case
                         when d1.data = '01/01/2020' then
                           0 
                         else
                           d1.saldo_atual - ( d1.deposito + d1.abatimento + d1.boleto + d1.depositos_v1 + d1.transferencia + d1.cheques ) + ( d1.saida + d1.faturas_v1 ) 
                       end saldo_anterior
                     , d1.saldo saldo_ano_anterior
                     , d1.saida + d1.faturas_v1 as fatura
                     --, d1.entrada
                     , d1.deposito
                     , d1.depositos_v1
                     , d1.abatimento
                     , d1.transferencia
                     , d1.cheques
                     , d1.boleto
                     , d1.saldo_atual
                from ( 
                      select d.data 
                           , nvl(saldo.valor,0) saldo
                           , nvl(saida.valor,0) saida
                           , nvl(faturas_v1.valor,0) faturas_v1
                           --, nvl(entrada.valor,0) entrada
                           , nvl(deposito.valor,0) deposito
                           , nvl(depositos_v1.valor,0) depositos_v1
                           , nvl(abatimento.valor,0) abatimento
                           , nvl(transferencia.valor,0) transferencia
                           , nvl(cheques.valor,0) cheques
                           , nvl(boleto.valor,0) boleto
                           , sum((nvl(total.valor,0) - nvl(faturas_v1.valor,0) + nvl(boleto.valor,0) + nvl(transferencia.valor,0) + nvl(depositos_v1.valor,0) + nvl(cheques.valor,0) + nvl(saldo.valor,0))) over (order by d.data) as saldo_atual
                      from datasperiodos d
                         , ( select trunc(ex.datamovimento) data
                                  , sum(ex.valormovimento) valor
                             from extratoscontasbancarias ex
                             where ex.contabilizar = 'N'
                               and exists ( select 1
                                             from contasbancarias c
                                             where c.idcontabanc = ex.idcontabancaria
                                               and c.idpessoa = :P398_IDFORNECEDOR )
                               and ( :P398_TIPO_PESQUISA   = 'T'
                                   or ( :P398_TIPO_PESQUISA = 'P' and trunc(ex.datamovimento) between to_date(:P398_DATAINICIO,'DD/MM/RRRR') and to_date(:P398_DATAFIM,'DD/MM/RRRR') )
                                   or ( :P398_TIPO_PESQUISA = 'M' and ( :P398_MES is null or extract (month from ex.datamovimento) = :P398_MES ) 
                                                                  and extract (year from ex.datamovimento) = :P398_ANO ) )
                               and ( :P398_IDCONTABANCARIA is null or ex.idcontabancaria = :P398_IDCONTABANCARIA )
                             group by trunc(ex.datamovimento) ) saldo
                         , ( select trunc(ex.datamovimento) data
                                  , sum(ex.valormovimento*-1) valor
                             from extratoscontasbancarias ex
                             where ex.valormovimento < 0 
                               and ex.contabilizar = 'S'
                               and exists ( select 1
                                             from contasbancarias c
                                             where c.idcontabanc = ex.idcontabancaria
                                               and c.idpessoa = :P398_IDFORNECEDOR )
                               and ( :P398_TIPO_PESQUISA   = 'T'
                                   or ( :P398_TIPO_PESQUISA = 'P' and trunc(ex.datamovimento) between to_date(:P398_DATAINICIO,'DD/MM/RRRR') and to_date(:P398_DATAFIM,'DD/MM/RRRR') )
                                   or ( :P398_TIPO_PESQUISA = 'M' and ( :P398_MES is null or extract (month from ex.datamovimento) = :P398_MES ) 
                                                                  and extract (year from ex.datamovimento) = :P398_ANO ) )
                               and ( :P398_IDCONTABANCARIA is null or ex.idcontabancaria = :P398_IDCONTABANCARIA )
                             group by trunc(ex.datamovimento) ) saida
                         , ( select trunc(v.datavencimento) data
                                  , sum(v.valor) valor
                             from vencimentos v
                             where not exists ( select 1
                                                from extratoscontasbancarias eb
                                                where eb.idvencimento = v.idvencimento )
                               and exists ( select 1
                                             from fornecedores f
                                                , notasfiscais nf
                                             where f.idfornecedor = nf.idfornemitente
                                               and nf.idnotafiscal = v.idnotafiscal
                                               and f.idpessoa = :P398_IDFORNECEDOR ) 
                               and ( :P398_TIPO_PESQUISA   = 'T'
                                   or ( :P398_TIPO_PESQUISA = 'P' and trunc(v.datavencimento) between to_date(:P398_DATAINICIO,'DD/MM/RRRR') and to_date(:P398_DATAFIM,'DD/MM/RRRR') )
                                   or ( :P398_TIPO_PESQUISA = 'M' and ( :P398_MES is null or extract (month from v.datavencimento) = :P398_MES ) 
                                                                  and extract (year from v.datavencimento) = :P398_ANO ) )
                               and ( :P398_IDCONTABANCARIA is null or v.idcontabanc = :P398_IDCONTABANCARIA )
                             group by trunc(v.datavencimento) ) faturas_v1
                         , ( select trunc(pf.databaixa) data
                                  , sum(pf.valorpago) valor
                             from pagamentosfornecedores pf
                             where pf.valorpago > 0 
                               and pf.tipopagamento = 'T'
                               and exists ( select 1
                                             from fornecedores f
                                             where f.idfornecedor = pf.idfornecedor
                                               and f.idpessoa = :P398_IDFORNECEDOR )
                                and ( :P398_TIPO_PESQUISA   = 'T'
                                   or ( :P398_TIPO_PESQUISA = 'P' and trunc(pf.databaixa) between to_date(:P398_DATAINICIO,'DD/MM/RRRR') and to_date(:P398_DATAFIM,'DD/MM/RRRR') )
                                   or ( :P398_TIPO_PESQUISA = 'M' and ( :P398_MES is null or extract (month from pf.databaixa) = :P398_MES ) 
                                                                  and extract (year from pf.databaixa) = :P398_ANO ) )
                                and ( :P398_IDCONTABANCARIA is null or pf.idcontabanc = :P398_IDCONTABANCARIA )
                             group by trunc(pf.databaixa) ) transferencia
                         , ( select trunc(pf.databaixa) data
                                  , sum(pf.valorpago) valor
                             from pagamentosfornecedores pf
                             where pf.valorpago > 0 
                               and pf.tipopagamento = 'D'
                               and exists ( select 1
                                             from fornecedores f
                                             where f.idfornecedor = pf.idfornecedor
                                               and f.idpessoa = :P398_IDFORNECEDOR )
                                and ( :P398_TIPO_PESQUISA   = 'T'
                                   or ( :P398_TIPO_PESQUISA = 'P' and trunc(pf.databaixa) between to_date(:P398_DATAINICIO,'DD/MM/RRRR') and to_date(:P398_DATAFIM,'DD/MM/RRRR') )
                                   or ( :P398_TIPO_PESQUISA = 'M' and ( :P398_MES is null or extract (month from pf.databaixa) = :P398_MES ) 
                                                                  and extract (year from pf.databaixa) = :P398_ANO ) )
                                and ( :P398_IDCONTABANCARIA is null or pf.idcontabanc = :P398_IDCONTABANCARIA )
                             group by trunc(pf.databaixa) ) depositos_v1
                         , ( select trunc(pf.databaixa) data
                                  , sum(pf.valorpago) valor
                             from pagamentosfornecedores pf
                             where pf.valorpago > 0 
                               and pf.tipopagamento = 'C'
                               and exists ( select 1
                                             from fornecedores f
                                             where f.idfornecedor = pf.idfornecedor
                                               and f.idpessoa = :P398_IDFORNECEDOR )
                                and ( :P398_TIPO_PESQUISA   = 'T'
                                   or ( :P398_TIPO_PESQUISA = 'P' and trunc(pf.databaixa) between to_date(:P398_DATAINICIO,'DD/MM/RRRR') and to_date(:P398_DATAFIM,'DD/MM/RRRR') )
                                   or ( :P398_TIPO_PESQUISA = 'M' and ( :P398_MES is null or extract (month from pf.databaixa) = :P398_MES ) 
                                                                  and extract (year from pf.databaixa) = :P398_ANO ) )
                                and ( :P398_IDCONTABANCARIA is null or pf.idcontabanc = :P398_IDCONTABANCARIA )
                             group by trunc(pf.databaixa) ) cheques
                         , ( select trunc(ex.datamovimento) data
                                  , sum(ex.valormovimento) valor
                             from extratoscontasbancarias ex
                             where ex.valormovimento > 0 
                               and ex.contabilizar = 'S'
                               and ex.descricao not like '%Abatimento%'
                               and exists ( select 1
                                             from contasbancarias c
                                             where c.idcontabanc = ex.idcontabancaria
                                               and c.idpessoa = :P398_IDFORNECEDOR )
                               and ( :P398_TIPO_PESQUISA   = 'T'
                                   or ( :P398_TIPO_PESQUISA = 'P' and trunc(ex.datamovimento) between to_date(:P398_DATAINICIO,'DD/MM/RRRR') and to_date(:P398_DATAFIM,'DD/MM/RRRR') )
                                   or ( :P398_TIPO_PESQUISA = 'M' and ( :P398_MES is null or extract (month from ex.datamovimento) = :P398_MES ) 
                                                                  and extract (year from ex.datamovimento) = :P398_ANO ) )
                               and ( :P398_IDCONTABANCARIA is null or ex.idcontabancaria = :P398_IDCONTABANCARIA )
                             group by trunc(ex.datamovimento) ) deposito
                         , ( select trunc(ex.datamovimento) data
                                  , sum(ex.valormovimento) valor
                             from extratoscontasbancarias ex
                             where ex.valormovimento > 0 
                               and ex.descricao like '%Abatimento%'
                               and exists ( select 1
                                             from contasbancarias c
                                             where c.idcontabanc = ex.idcontabancaria
                                               and c.idpessoa = :P398_IDFORNECEDOR )
                               and ( :P398_TIPO_PESQUISA   = 'T'
                                   or ( :P398_TIPO_PESQUISA = 'P' and trunc(ex.datamovimento) between to_date(:P398_DATAINICIO,'DD/MM/RRRR') and to_date(:P398_DATAFIM,'DD/MM/RRRR') )
                                   or ( :P398_TIPO_PESQUISA = 'M' and ( :P398_MES is null or extract (month from ex.datamovimento) = :P398_MES ) 
                                                                  and extract (year from ex.datamovimento) = :P398_ANO ) )
                               and ( :P398_IDCONTABANCARIA is null or ex.idcontabancaria = :P398_IDCONTABANCARIA )
                             group by trunc(ex.datamovimento) ) abatimento
                         , ( select trunc(pf.databaixa) data
                                  , sum(pf.valorpago) valor
                             from pagamentosfornecedores pf
                             where pf.valorpago > 0 
                               and pf.tipopagamento = 'B'
                               and exists ( select 1
                                             from fornecedores f
                                             where f.idfornecedor = pf.idfornecedor
                                               and f.idpessoa = :P398_IDFORNECEDOR )
                               and ( :P398_TIPO_PESQUISA   = 'T'
                                   or ( :P398_TIPO_PESQUISA = 'P' and trunc(pf.databaixa) between to_date(:P398_DATAINICIO,'DD/MM/RRRR') and to_date(:P398_DATAFIM,'DD/MM/RRRR') )
                                   or ( :P398_TIPO_PESQUISA = 'M' and ( :P398_MES is null or extract (month from pf.databaixa) = :P398_MES ) 
                                                                  and extract (year from pf.databaixa) = :P398_ANO ) )
                               and ( :P398_IDCONTABANCARIA is null or pf.idcontabanc = :P398_IDCONTABANCARIA )
                             group by trunc(pf.databaixa) ) boleto
                         , (  select trunc(ex.datamovimento) data
                                  , sum(ex.valormovimento) valor
                             from extratoscontasbancarias ex
                             where ex.contabilizar = 'S'
                               and exists ( select 1
                                             from contasbancarias c
                                             where c.idcontabanc = ex.idcontabancaria
                                               and c.idpessoa = :P398_IDFORNECEDOR  )
                               and ( :P398_TIPO_PESQUISA   = 'T'
                                   or ( :P398_TIPO_PESQUISA = 'P' and trunc(ex.datamovimento) between to_date(:P398_DATAINICIO,'DD/MM/RRRR') and to_date(:P398_DATAFIM,'DD/MM/RRRR') )
                                   or ( :P398_TIPO_PESQUISA = 'M' and ( :P398_MES is null or extract (month from ex.datamovimento) = :P398_MES ) 
                                                                  and extract (year from ex.datamovimento) = :P398_ANO ) )
                               and ( :P398_IDCONTABANCARIA is null or ex.idcontabancaria = :P398_IDCONTABANCARIA )
                             group by trunc(ex.datamovimento) ) total
                      where ( :P398_TIPO_PESQUISA   = 'T'
                           or ( :P398_TIPO_PESQUISA = 'P' and trunc(d.data) between to_date(:P398_DATAINICIO,'DD/MM/RRRR') and to_date(:P398_DATAFIM,'DD/MM/RRRR') )
                           or ( :P398_TIPO_PESQUISA = 'M' and ( :P398_MES is null or extract (month from d.data) = :P398_MES ) 
                                                          and extract (year from d.data) = :P398_ANO ) )
                        and :P398_IDFORNECEDOR is not null
                        and d.data = saldo.data(+)
                        and d.data = saida.data(+)
                        and d.data = faturas_v1.data(+)
                        and d.data = deposito.data(+)
                        and d.data = depositos_v1.data(+)
                        and d.data = transferencia.data(+)
                        and d.data = cheques.data(+)
                        and d.data = abatimento.data(+)
                        and d.data = boleto.data(+)
                        and d.data = total.data(+)
                      order by data ) d1
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
