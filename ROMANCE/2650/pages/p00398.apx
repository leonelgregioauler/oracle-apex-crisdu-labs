    region extrato-resumido (
        name: Extrato Resumido
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d1.data
                     , d1.saldo_atual - d1.entrada + d1.saida saldo_anterior
                     , d1.saida
                     , d1.entrada
                     , d1.saldo_atual
                from ( 
                      select d.data 
                           , nvl(saida.valor,0) saida
                           , nvl(entrada.valor,0) entrada
                           , sum(total.valor) over (order by d.data) as saldo_atual
                      from datasperiodos d
                         , ( select trunc(ex.datamovimento) data
                                  , sum(ex.valormovimento*-1) valor
                             from extratoscontasbancarias ex
                             where ex.valormovimento < 0 
                               and exists ( select 1
                                             from contasbancarias c
                                             where c.idcontabanc = ex.idcontabancaria
                                               and c.idpessoa = :P398_IDFORNECEDOR )
                                and ( :P398_TIPO_PESQUISA   = 'T'
                                   or ( :P398_TIPO_PESQUISA = 'P' and trunc(ex.datamovimento) between to_date(:P398_DATAINICIO,'DD/MM/RRRR') and to_date(:P398_DATAFIM,'DD/MM/RRRR') )
                                   or ( :P398_TIPO_PESQUISA = 'M' and ( :P398_MES is null or extract (month from ex.datamovimento) = :P398_MES ) 
                                                                  and extract (year from ex.datamovimento) = :P398_ANO ) )
                                and ( :P398_IDCONTABANCARIA is null or ex.idcontabancaria = :P398_IDCONTABANCARIA )
                             group by trunc(ex.datamovimento) ) saida
                         , ( select trunc(ex.datamovimento) data
                                  , sum(ex.valormovimento) valor
                             from extratoscontasbancarias ex
                             where ex.valormovimento > 0 
                               and exists ( select 1
                                             from contasbancarias c
                                             where c.idcontabanc = ex.idcontabancaria
                                               and c.idpessoa = :P398_IDFORNECEDOR )
                                and ( :P398_TIPO_PESQUISA   = 'T'
                                   or ( :P398_TIPO_PESQUISA = 'P' and trunc(ex.datamovimento) between to_date(:P398_DATAINICIO,'DD/MM/RRRR') and to_date(:P398_DATAFIM,'DD/MM/RRRR') )
                                   or ( :P398_TIPO_PESQUISA = 'M' and ( :P398_MES is null or extract (month from ex.datamovimento) = :P398_MES ) 
                                                                  and extract (year from ex.datamovimento) = :P398_ANO ) )
                                and ( :P398_IDCONTABANCARIA is null or ex.idcontabancaria = :P398_IDCONTABANCARIA )
                             group by trunc(ex.datamovimento) ) entrada
                         , (  select trunc(ex.datamovimento) data
                                   , sum(ex.valormovimento) valor
                              from extratoscontasbancarias ex
                              where exists ( select 1
                                             from contasbancarias c
                                             where c.idcontabanc = ex.idcontabancaria
                                               and c.idpessoa = :P398_IDFORNECEDOR )
                                and ( :P398_TIPO_PESQUISA   = 'T'
                                  or ( :P398_TIPO_PESQUISA = 'P' and trunc(ex.datamovimento) between to_date(:P398_DATAINICIO,'DD/MM/RRRR') and to_date(:P398_DATAFIM,'DD/MM/RRRR') )
                                  or ( :P398_TIPO_PESQUISA = 'M' and ( :P398_MES is null or extract (month from ex.datamovimento) = :P398_MES ) 
                                                                 and extract (year from ex.datamovimento) = :P398_ANO ) )
                               and ( :P398_IDCONTABANCARIA is null or ex.idcontabancaria = :P398_IDCONTABANCARIA )
                             group by trunc(ex.datamovimento) ) total
                      where ( :P398_TIPO_PESQUISA   = 'T'
                           or ( :P398_TIPO_PESQUISA = 'P' and d.data between to_date(:P398_DATAINICIO,'DD/MM/RRRR') and to_date(:P398_DATAFIM,'DD/MM/RRRR') )
                           or ( :P398_TIPO_PESQUISA = 'M' and ( :P398_MES is null or d.mes = :P398_MES ) 
                                                          and d.ano = :P398_ANO ) ) 
                        and :P398_IDFORNECEDOR is not null
                        and d.data = saida.data(+)
                        and d.data = entrada.data(+)
                        and d.data = total.data(+)
                      order by data ) d1
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P398_TIPO_RELATORIO
            value: R
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 5118916961264463435
        }

