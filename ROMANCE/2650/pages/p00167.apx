page 167 (
    name: Empréstimos
    title: Empréstimos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region empréstimos (
        name: Empréstimos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.idemprestimo
                     , pck_romance.fnc_nomefilial(f.idfilial) "Empresa"
                     , to_number(substr(f.semana,4,4)) "Ano"
                     , to_number(substr(f.semana,1,2)) "Semana"
                     , e.nome
                     , e.data
                     , e.observacao
                     , e.valor
                     , f.semana "Fechamento"
                from emprestimos e
                   , fechamentossemanais f
                where e.idfechamento = f.idfechamento
                  and ( ( :P0_IDFILIALCAIXA is null and :P0_PERM_ALTERAFECHA = 'S')
                      or ( f.idfilial = :P0_IDFILIALCAIXA ))
                order by 2, 3 desc, 4 desc
                ```
        }
        layout {
            sequence: 10
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 204
                items: {
                    P204_IDEMPRESTIMO: #IDEMPRESTIMO#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Nenhum empréstimo efetuado.
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 39457945760756974
        }

        column Ano (
            type: plainText
            heading {
                heading: Ano
                alignment: center
            }
            layout {
                sequence: 17
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

