page 430 (
    name: Dados Carregados
    title: Dados Carregados
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            /* apply u-Report--dataLoad CSS class to Data Load Report and hide empty columns */
            apex.jQuery("table.standardLook").addClass("u-Report u-Report--standardLook");
            apex.jQuery("table.u-Report--standardLook tr:nth-child(1) td:empty").css("display", "none");
            apex.jQuery("table.u-Report--standardLook tr th:empty").css("display", "none");
            apex.jQuery("table.u-Report--standardLook tr th:empty").each( function (idx, elem) { apex.jQuery("table.u-Report--standardLook tr td[headers=\""+apex.jQuery(elem).attr('id')+"\"]").css("display", "none");});
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region entradas-geradas (
        name: Entradas Geradas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.identradavirtualage
                     , e.codigoempresa
                     , ( select ee.nome||' - '||ee.cnpj
                         from empresasvirtualage ee
                         where ee.codigoempresa = e.codigoempresa 
                         fetch first 1 row only) empresa
                     , e.codigofornecedor
                     , ( select distinct pck_romance.fnc_nomefornecedor(r.idfornecedor)
                         from  razoessociaisfornec r
                         where r.codigovirtualage = e.codigofornecedor
                           and r.ativo = 'S'
                           fetch first 1 row only) fornecedor
                     , e.duplicata
                     , e.parcela
                     , e.dataentrada 
                     , e.dataemissao
                     , e.datainclusao
                     , e.datavencimento
                     , e.codigodespesa
                     , ( select s.nomeconta
                         from subcontasfinanceiras s
                         where s.codigovirtualage = e.codigodespesa 
                         fetch first 1 row only) conta
                     , e.codigocentrodecusto
                     , ( select c.nome
                         from centrodecustos c
                         where c.codigovirtualage = e.codigocentrodecusto 
                         fetch first 1 row only) centrodecusto
                     , e.idmatrizdespesa
                     , e.valorduplicata
                     , e.valorpagar
                     , e.observacao
                     , case
                         when e.datavencimento < e.datainclusao then 
                          1
                         else
                          0
                       end validavencimento
                from entradasvirtualage e
                where e.processado = 'N'
                  and exists ( select 1
                               from  razoessociaisfornec r
                               where r.codigovirtualage = e.codigofornecedor )
                
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <font color="red"><h2> Para uma integração ser realizada com sucesso, precisa respeitar as seguintes regras:</h2> </font><br>
                <font color="blue"> - A empresa precisa estar parametrizada no sistema. </font><br>
                <font color="green"> - O fornecedor precisa ter uma razão social parametrizada no sistema. </font><br>
                <font color="blue"> - O Centro de custo precisa estar parametrizado no sistema. </font><br>
                <font color="green"> - A Sub Conta precisa estar parametrizada no sistema. </font><br>
                <h3>Respeitando todas as regras, a matriz irá aparecer automaticamente.</h3>
                ```
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
