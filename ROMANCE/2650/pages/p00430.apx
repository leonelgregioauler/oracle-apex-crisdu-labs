        column IDMATRIZDESPESA (
            type: selectList
            heading {
                heading: Matriz de Despesa
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select c.nome||' - '||pck_romance.fnc_nomecontafinan(md.idcontafinan)||' / '||s.nomeconta display_value
                         , md.idmatrizregra return_value
                    from matrizregrasdespesas md
                       , subcontasfinanceiras s
                       , centrodecustos c
                       , razoessociaisfornec r
                       , empresasvirtualage e
                    where c.idcentrodecusto = md.idcentrodecusto
                      and s.idsubcontafinan = md.idsubcontafinan
                      and s.codigovirtualage = :CODIGODESPESA
                      and c.codigovirtualage = :CODIGOCENTRODECUSTO
                      and r.idfornecedor     = md.idfornecedor
                      and r.codigovirtualage = :CODIGOFORNECEDOR
                      and md.idfilial        = e.idfilial
                      and e.codigoempresa    = :CODIGOEMPRESA
                    ```
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: [
                    CODIGOFORNECEDOR
                    CODIGODESPESA
                    CODIGOCENTRODECUSTO
                    CODIGOEMPRESA
                ]
            }
            layout {
                sequence: 180
            }
            source {
                databaseColumn: IDMATRIZDESPESA
                dataType: number
            }
        )

