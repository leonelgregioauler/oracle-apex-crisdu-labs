    region resultado (
        name: Resultado
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            customAttributes: style="width:100%;max-width:none;"
        }
        settings {
            outputAs: text
        }
    )

    pageItem P430_ERROR_COUNT (
        type: displayOnly
        label {
            label: Linhas com erro(s):
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 30
            region: @resultado
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery: select count(*) c from apex_collections where collection_name = 'LOAD_CONTENT' and c047 = 'FAILED'
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P430_INSERT_COUNT (
        type: displayOnly
        label {
            label: Linhas Incluídas(s):
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 10
            region: @resultado
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P430_REVIEW_COUNT (
        type: displayOnly
        label {
            label: Para revisar(s):
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 40
            region: @resultado
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P430_UPDATE_COUNT (
        type: displayOnly
        label {
            label: Linhas Atualizadas(s):
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 20
            region: @resultado
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    button finish (
        buttonName: FINISH
        label: Gerar Entradas
        layout {
            sequence: 30
            region: @resultado
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process entradas-geradas-save-interactive-grid-data (
        name: Entradas Geradas - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @entradas-geradas
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 17953150663008824
        }
    )

    process gerar-entradas (
        name: Gerar Entradas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_notasfiscais_rmc.prc_geraentradas_virtualage(pusuario => v('APP_USER'));
                end;
                
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 17953213921008825
        }
        serverSideCondition {
            whenButtonPressed: @finish
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 431
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @finish
        }
    )

)

