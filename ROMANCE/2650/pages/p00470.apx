page 470 (
    name: Apoio a Resultados das Unidades
    title: Apoio a Resultados das Unidades
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region análise-de-resultados (
        name: "Análise de Resultados "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select u.idunidadedenegocio
                     , u.nome unidade
                     , r.ano
                     , r.receitas_congelada receita_anterior
                     , r.receitas_atual receita_gerada
                     , nvl(r.diferenca_receitas,0) diferenca_receitas
                     , '|' s1
                     , r.despesas_congelada despesa_anterior
                     , r.despesas_atual despesa_gerada
                     , nvl(r.diferenca_despesas,0) diferenca_despesas
                     , r.problema
                from resultado_unidades_congelado r
                   , unidadesdenegocios u
                where r.idunidadedenegocio = u.idunidadedenegocio
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1804021393219407434
        }

        column ANO (
            type: plainText
            heading {
                heading: Ano
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        column DESPESA_ANTERIOR (
            type: plainText
            heading {
                heading: Despesa Anterior
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
