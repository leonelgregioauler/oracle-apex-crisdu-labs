    pageItem P335_IDPRODUTO (
        type: popupLov
        label {
            label: Produto
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct initcap(p.nomeproduto) display_value
                    , p.idproduto 
                from produtos p
                   , fornecedoresprodutos f
                where p.idproduto = f.idproduto
                  and (:P335_IDFORNECEDOR  is null or f.idfornecedor = :P335_IDFORNECEDOR )
                order by 1
                ```
            nullDisplayValue: - Todos -
        }
        cascadingLov {
            parentItems: P335_IDFORNECEDOR
        }
        layout {
            sequence: 50
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P335_SEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select semana display_value
                     , idsemana RETURN_VALUE
                from ( select distinct semana, idsemana
                       from fechamentossemanais
                       order by idsemana desc )
                where rownum < 30
                ```
            displayExtraValues: false
            nullDisplayValue: - Semana Cobrança -
        }
        layout {
            sequence: 80
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P335_SEMANAFIM (
        type: selectList
        label {
            label: Até
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(s.semana,'00')||'/'||s.ano) display_value
                     , s.idsemana RETURN_VALUE
                from roman.semana_dias s
                where s.idsemana >= :P335_SEMANAINI    
                  and s.idsemana >= 534
                order by idsemana 
                ```
        }
        cascadingLov {
            parentItems: P335_SEMANAINI
        }
        layout {
            sequence: 100
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

