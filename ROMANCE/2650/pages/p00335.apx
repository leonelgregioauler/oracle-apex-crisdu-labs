    region acompanhamento-de-produtos (
        name: Acompanhamento de Produtos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select pck_romance.fnc_nomeproduto(e.idproduto)
                         from estoquefilial e
                         where e.idestoquefilial = mv.idestoquefil ) "Produto"
                     , sum(mv.distribuido) "Distribuido"
                     , sum(NVL(mv.vendido,0)) "Vendido"
                     , round(( (  sum(mv.vendido) * 100 ) /  sum(mv.distribuido) ),2) "Perc Venda"
                     , ( select listagg(pck_romance.fnc_nomefornecedor(fp.idfornecedor)) within group (order by 1)
                         from fornecedoresprodutos fp
                            , estoquefilial e
                         where fp.idproduto       = e.idproduto 
                           and e.idestoquefilial  = mv.idestoquefil 
                         group by fp.idproduto ) fornecedores
                     , pck_romance.fnc_nomefilial(mv.idfilial) "Empresa"
                     , nvl(( select sum(nvl(inf.qtd_pp_chegou,0)
                                       +nvl(inf.qtd_p_chegou,0)
                                       +nvl(inf.qtd_m_chegou,0)
                                       +nvl(inf.qtd_g_chegou,0)
                                       +nvl(inf.qtd_gg_chegou,0)
                                       +nvl(inf.qtd_egg_chegou,0)
                                       +nvl(inf.qtd_exgg_chegou,0)
                                       +nvl(inf.qtd_u_chegou,0))
                             from itemnf inf
                             where inf.idproduto = mv.idproduto 
                               and exists ( select 1
                                            from notasfiscais nf
                                            where nf.idnotafiscal = inf.idnotafiscal
                                              and nf.idfilialdestino = mv.idfilial 
                                              and nf.situacaofilial  = 'R'
                                              and ( ( :P335_FILTRAR = 'S' and nf.idsemananota = :P335_SEMANA )
                                                  or ( :P335_FILTRAR = 'P' and  nf.idsemananota between :P335_SEMANAINI and :P335_SEMANAFIM ) ) ) ),0) recebidonf
                     , pck_estoque.fnc_estoquetotalfilial(mv.idestoquefil) fisico
                     , nvl(( select sum(nvl(inf.qtd_pp,0)
                                       +nvl(inf.qtd_p,0)
                                       +nvl(inf.qtd_m,0)
                                       +nvl(inf.qtd_g,0)
                                       +nvl(inf.qtd_gg,0)
                                       +nvl(inf.qtd_egg,0)
                                       +nvl(inf.qtd_exgg,0)
                                       +nvl(inf.qtd_u,0))
                             from itemnf inf
                             where inf.idproduto = mv.idproduto 
                               and exists ( select 1
                                            from notasfiscais nf
                                            where nf.idnotafiscal = inf.idnotafiscal
                                              and nf.idfilialdestino = mv.idfilial 
                                              and nf.situacaofilial  = 'A'
                                              and nf.situacao = 'A') ),0) parareceber
                     , nvl(( select sum(nvl(ic.qtd_dist_pp,0)
                                   +nvl(ic.qtd_dist_p,0)
                                   +nvl(ic.qtd_dist_m,0)
                                   +nvl(ic.qtd_dist_g,0)
                                   +nvl(ic.qtd_dist_gg,0)
                                   +nvl(ic.qtd_dist_egg,0)
                                   +nvl(ic.qtd_dist_exgg,0)
                                   +nvl(ic.qtd_dist_u,0))
                         from itenscargarepresentante ic
                         where ic.idestoquefil = mv.idestoquefil
                           and exists ( select 1 
                                        from cargasrepresentantes c
                                        where c.idcargarepresentante = ic.idcargarepresentante
                                          and c.situacao             = 3
                                          and c.idfilial             = mv.idfilial
                                          and ( ( :P335_FILTRAR = 'S' and c.idsemana = :P335_SEMANA )
                                              or ( :P335_FILTRAR = 'P' and  c.idsemana between :P335_SEMANAINI and :P335_SEMANAFIM ) ) ) ),0) carga
                from roman.vw_percentualvenda_mv mv
                   , roman.produtos pr
                where pr.idproduto = mv.idproduto
                  and ( :P335_FILIALGRUPO is null 
                        or ( :P335_FILIALGRUPO = 'E' and :P335_IDFILIAL is null or mv.idfilial = :P335_IDFILIAL )
                        or ( :P335_FILIALGRUPO = 'G' and exists ( select 1
                                                                  from filiais f
                                                                  where f.idfilial = mv.idfilial
                                                                    and f.idgrupo  = :P335_IDGRUPO ) ) )
                  and ( ( :P335_FILTRAR = 'S' and mv.idsemanacobranca = :P335_SEMANA )
                     or ( :P335_FILTRAR = 'P' and  mv.idsemanacobranca between :P335_SEMANAINI and :P335_SEMANAFIM  ))  
                  and (:P335_IDPRODUTO is null or ( exists ( select 1 
                                                             from estoquefilial i
                                                             where i.idestoquefilial = mv.idestoquefil 
                                                               and i.idproduto = :P335_IDPRODUTO)))
                  and ( :P335_IDFORNECEDOR is null or exists ( select 1
                                                               from fornecedoresprodutos f
                                                                  , estoquefilial        e
                                                               where f.idfornecedor = :P335_IDFORNECEDOR 
                                                                 and f.idproduto    = e.idproduto
                                                                 and e.idestoquefilial = mv.idestoquefil ) )
                  and ( :P335_IDFILIAL is not null 
                      or :P335_SEMANA is not null 
                      or :P335_SEMANAINI is not null 
                      or :P335_IDFORNECEDOR is not null )
                  and ( :P335_CATEGORIA is null or pr.idcategoria = :P335_CATEGORIA ) 
                group by mv.idestoquefil , mv.idfilial , mv.idproduto
                
                
                ```
        }
        layout {
            sequence: 30
            slot: body-3
        }
