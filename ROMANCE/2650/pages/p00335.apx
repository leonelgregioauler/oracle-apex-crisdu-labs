    region produtos-mais-vendidos (
        name: Produtos mais Vendidos
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  if :P335_IDFILIAL is not null 
                      or :P335_SEMANA is not null 
                      or :P335_SEMANAINI is not null 
                      or :P335_IDFORNECEDOR is not null then
                    --
                    pck_imprime.prc_imprimepercentualvenda( pfiliagrupo => :P335_FILIALGRUPO
                                                          , pidfilial => :P335_IDFILIAL
                                                          , pidgrupo => :P335_IDGRUPO
                                                          , pidfornecedor => :P335_IDFORNECEDOR
                                                          , pidproduto => :P335_IDPRODUTO
                                                          , ptipopesquisa => :P335_FILTRAR
                                                          , psemana => :P335_SEMANA
                                                          , psemanaini => :P335_SEMANAINI
                                                          , psemanafim => :P335_SEMANAFIM );
                    --
                  end if;
                  --
                end;
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: never
        }
    )

