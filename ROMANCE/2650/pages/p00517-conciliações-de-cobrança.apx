    region pagamento-de-pedidos-negociações-cancelados (
        name: Pagamento de Pedidos/Negociações Cancelados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select mv.dataliquidacaoboleto
                     , pn.numeroboleto
                     , case 
                          when mv.numerocontacorrente = '17667' and mv.codigoprefixoagencia = '3414' then 'Favorita Norte'
                          when mv.numerocontacorrente = '17668' and mv.codigoprefixoagencia = '3414' then 'Favorita Sul'
                          when mv.numerocontacorrente = '17666' and mv.codigoprefixoagencia = '3414' then 'Comercial Romance'
                       end Carteira
                     , pn.valorparcela
                     , mv.valorrecebido
                     , mv.valortarifa
                     , ( select cn.descrcanalpagamentobb
                         from codigocanalpagamentobb cn
                         where cn.codcanalpagamentobb = mv.codigocanalpagamento
                           and cn.codcomandobb = mv.codigocomandoacao ) forma_pagamento
                     , ( select roman.pck_romance.fnc_nomevendedora(np.idvendedora)
                         from negociacoesparceiros np
                         where np.idnegociacaoparceiro = pn.idnegociacaoparceiro) empreendedora
                     , ( select roman.pck_romance.fnc_cpfvendedora(np.idvendedora)
                         from negociacoesparceiros np
                         where np.idnegociacaoparceiro = pn.idnegociacaoparceiro) cpf
                     , pn.idnegociacaoparceiro
                     , null pedido
                from movimentoslotesdiabb mv
                   , pagamentosnegociacoesparceiros pn
                where TO_CHAR(TO_NUMBER(mv.numerotitulocobranca)) = pn.numeroboleto 
                  and pn.situacao = 'C' -- Cancelado
                  and mv.valorrecebido > 0 -- Retorno de valor do banco
                  and exists ( select 1
                               from conciliacaocobranca cb
                               where cb.idmovimentolotediabb = mv.idmovimentolotediabb
                                 and cb.idpagamentonegociacaoparceiro = pn.idpagamentonegociacaoparceiro )
                  and exists ( select 1
                               from negociacoesparceiros np
                               where np.idnegociacaoparceiro = pn.idnegociacaoparceiro
                                 --and (:P517_EMPREENDEDORA = -1 or :P517_EMPREENDEDORA is null or np.idvendedora = :P517_EMPREENDEDORA) )
                                 and (NVL(:P517_EMPREENDEDORA, -1) = -1 OR np.idvendedora = :P517_EMPREENDEDORA))
                  and mv.dataliquidacaoboleto between :P517_DE and :P517_ATE
                  and ( :P517_CARTEIRA = 'N' and mv.numerocontacorrente = '17667' and mv.codigoprefixoagencia = '3414' 
                     or :P517_CARTEIRA = 'S' and mv.numerocontacorrente = '17668' and mv.codigoprefixoagencia = '3414'
                     or :P517_CARTEIRA = 'C' and mv.numerocontacorrente = '17666' and mv.codigoprefixoagencia = '3414')
                  --and :P517_FILTRAR = 'S'
                union
                select mv.dataliquidacaoboleto
                     , pn.numeroboleto
                     , case 
                          when mv.numerocontacorrente = '17667' and mv.codigoprefixoagencia = '3414' then 'Favorita Norte'
                          when mv.numerocontacorrente = '17668' and mv.codigoprefixoagencia = '3414' then 'Favorita Sul'
                          when mv.numerocontacorrente = '17666' and mv.codigoprefixoagencia = '3414' then 'Comercial Romance'
                       end Carteira
                     , pn.valorpago --pn.valorliquido
                     , mv.valorrecebido
                     , mv.valortarifa
                     , ( select cn.descrcanalpagamentobb
                         from codigocanalpagamentobb cn
                         where cn.codcanalpagamentobb = mv.codigocanalpagamento
                           and cn.codcomandobb = mv.codigocomandoacao ) forma_pagamento
                     , ( select roman.pck_romance.fnc_nomevendedora(p.idvendedora)
                         from favorita.vencimentospedidos vc
                            , favorita.pedidos p
                         where vc.idpedido = p.idpedido
                           and vc.idvencimentopedido = pn.idvencimentopedido
                           and rownum = 1 ) empreendedora
                     , ( select roman.pck_romance.fnc_cpfvendedora(p.idvendedora)
                         from favorita.vencimentospedidos vc
                            , favorita.pedidos p
                         where vc.idpedido = p.idpedido
                           and vc.idvencimentopedido = pn.idvencimentopedido
                           and rownum = 1 ) cpf
                     , null
                     , ( select vc.idpedido
                         from favorita.vencimentospedidos vc
                            , favorita.pedidos p
                         where vc.idpedido = p.idpedido
                           and vc.idvencimentopedido = pn.idvencimentopedido
                           and rownum = 1 ) pedido
                from movimentoslotesdiabb mv
                   , favorita.pagamentospedidos pn
                where TO_CHAR(TO_NUMBER(mv.numerotitulocobranca)) = pn.numeroboleto 
                  and pn.idsituacao = -1 -- Cancelado
                  and mv.valorrecebido > 0 -- Retorno de valor do banco
                  and exists ( select 1
                               from conciliacaocobranca cb
                               where cb.idmovimentolotediabb = mv.idmovimentolotediabb
                                 and cb.idpagamentopedido = pn.idpagamentopedido )
                  and exists ( select 1
                               from favorita.vencimentospedidos vc
                                  , favorita.pedidos p
                               where vc.idpedido = p.idpedido
                                 and vc.idvencimentopedido = pn.idvencimentopedido
                                 --and (:P517_EMPREENDEDORA = -1 or p.idvendedora = :P517_EMPREENDEDORA) )
                                 and (NVL(:P517_EMPREENDEDORA, -1) = -1 OR p.idvendedora = :P517_EMPREENDEDORA))
                  and mv.dataliquidacaoboleto between :P517_DE and :P517_ATE
                  and ( :P517_CARTEIRA = 'N' and mv.numerocontacorrente = '17667' and mv.codigoprefixoagencia = '3414' 
                     or :P517_CARTEIRA = 'S' and mv.numerocontacorrente = '17668' and mv.codigoprefixoagencia = '3414'
                     or :P517_CARTEIRA = 'C' and mv.numerocontacorrente = '17666' and mv.codigoprefixoagencia = '3414')
                  --and :P517_FILTRAR = 'S'
                                
