            initialFetch: onUserRequest
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' (CPF: '||p.cpf||')'
                     , v.idvendedora
                from catal.vendedoras v
                   , catal.pessoas p
                where p.idpessoa = v.idpessoa
                
                
                ```
            nullDisplayValue: - Todas -
            nullReturnValue: -1
        }
        layout {
