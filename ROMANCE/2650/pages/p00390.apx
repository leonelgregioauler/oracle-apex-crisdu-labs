page 390 (
    name: Cadastro de Grades
    title: Cadastro de Grades
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-de-grades (
        name: Cadastro de Grades
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P390_DESCRICAO (
        type: textField
        label {
            label: Descrição
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 50
            region: @cadastro-de-grades
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P390_IDGRADE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @cadastro-de-grades
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P390_ORDEM (
        type: numberField
        label {
            label: Ordem
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 10
            region: @cadastro-de-grades
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P390_SIGLA (
        type: textField
        label {
            label: Sigla
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @cadastro-de-grades
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P390_TAMANHOREAL (
        type: textField
        label {
            label: Tamanho a Considerar
            alignment: left
        }
        layout {
            sequence: 40
            region: @cadastro-de-grades
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    button deletar (
        buttonName: DELETAR
        label: Deletar
        layout {
            sequence: 10
            region: @cadastro-de-grades
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    button salvar (
        buttonName: SALVAR
        label: Salvar
        layout {
            sequence: 20
            region: @cadastro-de-grades
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P390_IDGRADE
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Criar
        layout {
            sequence: 40
            region: @cadastro-de-grades
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNull
            item: P390_IDGRADE
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 30
            region: @cadastro-de-grades
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process consulta-dml-em-grardes (
        name: Consulta DML em Grardes
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vmd5 varchar2(1000);
                begin
                  --
                  PCK_CADASTROS_RMC.PRC_GRADES( PIDGRADE => :P390_IDGRADE,
                                                PDESCRICAO => :P390_DESCRICAO,
                                                PSIGLA => :P390_SIGLA,
                                                PORDEM => :P390_ORDEM,
                                                PTAMANHOREAL => :P390_TAMANHOREAL,
                                                PMD5 => vmd5,
                                                POPERACAO_DML => 'S'); 
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 4988125738395204248
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P390_IDGRADE
        }
    )

    process processo-dml-em-grades (
        name: Processo DML em Grades
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  voperacao_dml varchar2(1);
                  vmd5          varchar2(1000);
                  --
                begin
                  --
                  if v('REQUEST') = 'SUBMIT' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'SALVAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'DELETAR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  PCK_CADASTROS_RMC.PRC_GRADES( PIDGRADE => :P390_IDGRADE,
                                                PDESCRICAO => :P390_DESCRICAO,
                                                PSIGLA => :P390_SIGLA,
                                                PORDEM => :P390_ORDEM,
                                                PTAMANHOREAL => :P390_TAMANHOREAL,
                                                PMD5 => vmd5,
                                                POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo realizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 4995877819806822664
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('SALVAR','SUBMIT')
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 389
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @voltar
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 390
                items: {
                    P390_IDGRADE: &P390_IDGRADE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('SUBMIT','SALVAR')
        }
    )

    branch (
        execution {
            sequence: 30
        }
        behavior {
            target: {
                page: 390
                items: {
                    P390_IDGRADE:
                    P390_SIGLA:
                    P390_ORDEM:
                    P390_DESCRICAO:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @deletar
        }
    )

)

