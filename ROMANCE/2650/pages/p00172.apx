    region lista-de-despesas-2 (
        name: Lista de Despesas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.idfilial
                     , pck_romance.fnc_nomefilial(d.idfilial) empresa
                     , d.observacao
                     , d.valor* nvl(nvl( ( select fs.fatorconversao
                                       from fechamentossemanais fs
                                       where fs.idfechamento = d.idfechamentoorigem) ,f.fatorconversao) ,1) valor
                     , f.semana
                     , f.idsemana                          
                     , nvl( ( select fs.fatorconversao
                             from fechamentossemanais fs
                             where fs.idfechamento = d.idfechamentoorigem ) ,f.fatorconversao) fatorconversao
                     , d.datavencimento        
                     , d.descricaoorigem
                     , d.iddespesa
                from fechamentossemanais f
                   , despesas   d
                where d.idfechamento = f.idfechamento
                  and f.idsemana = :P172_IDSEMANA 
                  and not exists ( select 1 from IGNORARDESPESASLUCARTIVIDADE i where i.iddespesa = d.iddespesa)--tabela gambiarra para não levar em conta valores duplciados de pagamento de forncedores
                    AND pck_romance.fnc_tipofilial(f.idfilial) != 'D'  
                /*  and exists ( select 1
                               from filiais fff
                               where fff.idfilial = d.idfilial
                                 and fff.tipofilial not in ('C', 'D','F' )) */ 
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
