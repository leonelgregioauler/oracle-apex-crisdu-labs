page 172 (
    name: Lista de Despesas
    title: Lista de Despesas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 80%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region lista-de-despesas (
        name: Lista de Despesas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.idfilial
                     , pck_romance.fnc_nomefilial(d.idfilial) empresa
                     , d.observacao
                     , d.VALOR_PARA_LUCRATIVIDADE valor
                     , d.semana
                     , d.datavencimento        
                     , d.descricaoorigem
                     , d.iddespesa
                from vw_despesas_distribuidoras d
                where d.idfechamento in  ( select idfechamento
                                           from fechamentossemanais f
                                           where f.idsemana = :P172_IDSEMANA 
                                             and pck_romance.fnc_tipofilial(f.idfilial) != 'D'  )    
                 
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 116696163005606304
        }

