    dynamicAction confirmar-exclusão (
        name: Confirmar Exclusão
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @deletar
        }

        action native-confirm (
            action: confirm
            settings {
                message: Deseja realmente Excluir?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: DELETAR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    validation valida-matriz-de-entrada (
        name: Valida Matriz de Entrada
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P372_IDMATRIZENTRADA
        }
        error {
            errorMessage: Por favor, informe a classificação deste lançamento!
            associatedItem: @P372_IDMATRIZENTRADA
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('CRIAR','SALVAR')
        }
    )

    process consulta-dml-em-registros-bancarios (
        name: Consulta DML em Registros Bancarios
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vdata  date;
                  vvalor number;
                begin
                  --
                  PCK_CADASTROS_RMC.PRC_REGISTROSCONTASBANCARIAS( PIDREGISTROCONTABANCARIA => :P372_IDREGISTROCONTABANCARIA,
                                                                  PIDUNIDADEDENEGOCIO => :P372_IDUNIDADEDENEGOCIO,
                                                                  PIDBANCO => :P372_IDBANCO,
                                                                  PIDCONTABANCARIA => :P372_IDCONTABANCARIA,
                                                                  PDATA => :P372_DATA,
                                                                  PUSUARIO => :P372_USUARIO,
                                                                  PDATAREGISTRO     => :P372_DATAREGISTRO,
                                                                  --PIDMES => :P372_IDMES,
                                                                  --PANO => :P372_ANO,
                                                                  PVALOR => VVALOR,
                                                                  PTIPOMOVIMENTACAO => :P372_TIPOMOVIMENTACAO,
                                                                  POBSERVACAO => :P372_OBSERVACAO,
                                                                  PIDMATRIZENTRADA => :P372_IDMATRIZENTRADA,
                                                                  PMD5 => :P372_MD5,
                                                                  POPERACAO_DML => 'S');
                  --
                  :P372_VALOR := to_char(vvalor,'999G999G999G999G990D00');
                  --
                  :P372_DT_VENCIMENTO_PRIMEIRA_PARCELA := null;
                  :P372_QTD_PARCELAS := null;
                  --:P372_IDREGISTROCONTABANCARIA_PARAMETRO := :P372_IDREGISTROCONTABANCARIA;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 33619888271259603
        }
    )

    process novo (
        name: Novo
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 33621505795259620
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    process parcelamento (
        name: Parcelamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  -- T9661487
                  --
                  voperacao_dml varchar2(1) := 'I';
                  v_contador number := 1;
                  v_verifica number := 0;
                  --
                  v_IDREGISTROCONTABANCARIA number := null;   
                  v_IDUNIDADEDENEGOCIO      number := :P372_idunidadedenegocio;         
                  v_IDBANCO                 number := :P372_idbanco;       
                  v_IDCONTABANCARIA         number := :P372_idcontabancaria;        
                  v_data                    date := sysdate;        
                  v_USUARIO                 varchar2(50) := v('APP_USER');
                  v_DATAREGISTRO            date := :P372_DT_VENCIMENTO_PRIMEIRA_PARCELA;       
                  v_valor                   number := to_number(:P372_valor);        
                  v_TIPOMOVIMENTACAO        varchar2(10) := :P372_tipomovimentacao;
                  v_OBSERVACAO              varchar2(2000);         
                  v_IDMATRIZENTRADA         number := :P372_idmatrizentrada;
                  V_PARCELAS                number := :P372_QTD_PARCELAS;
                  --
                begin
                  --
                  if v('REQUEST') = 'PARCELAR' then 
                    --
                    if :P372_QTD_PARCELAS is null or :P372_QTD_PARCELAS <= 1 then
                    --
                    raise_application_error(-20001,'Informe a quantidade de parcelas maior que 1');
                    --
                  end if;
                  --
                  if :P372_DT_VENCIMENTO_PRIMEIRA_PARCELA is null then
                    --
                    raise_application_error(-20001,'Informe a data do primeiro vencimento.');
                    --
                    else
                    --
                    if :P372_DT_VENCIMENTO_PRIMEIRA_PARCELA <= trunc(sysdate) then
                      --
                      raise_application_error(-20001,'Informe a data de vencimento maior que a data de hoje.');
                      --
                     end if;
                    --
                  end if;
                    -- Para caso de parcelamento de registro bancario que já existia antes
                    select count(*)
                      into v_verifica
                      from registroscontasbancarias r
                     where r.idregistrocontabancaria = :P372_IDREGISTROCONTABANCARIA;
                    --
                    for i in 1..V_PARCELAS
                      loop
                          --
                          --v_IDREGISTROCONTABANCARIA := null;          
                          v_OBSERVACAO  := 'Parcela '||v_contador||'/'||:P372_QTD_PARCELAS||' '||:P372_observacao;         
                          --
                          --
                          -- Caso o registro bancario já exista antes do parcelamento, então ele se torna a primeira parcela
                          if v_verifica > 0 and v_contador = 1 then
                            --
                            update registroscontasbancarias r
                               set r.dataregistro = v_DATAREGISTRO
                                 , r.observacao = v_OBSERVACAO
                                 , r.valor      = to_number(:P372_valor) 
                             where r.idregistrocontabancaria = :P372_IDREGISTROCONTABANCARIA;
                            --
                          else
                          --
                          PCK_CADASTROS_RMC.PRC_REGISTROSCONTASBANCARIAS( PIDREGISTROCONTABANCARIA => v_IDREGISTROCONTABANCARIA,
                                                                          PIDUNIDADEDENEGOCIO => v_IDUNIDADEDENEGOCIO,
                                                                          PIDBANCO => v_IDBANCO,
                                                                          PIDCONTABANCARIA => v_IDCONTABANCARIA,
                                                                          PDATA => v_data,
                                                                          PUSUARIO =>  v_USUARIO,
                                                                          PDATAREGISTRO => v_DATAREGISTRO,
                                                                        --  PIDMES => :P372_IDMES,
                                                                         -- PANO => :P372_ANO,
                                                                          PVALOR => v_valor,
                                                                          PTIPOMOVIMENTACAO => v_TIPOMOVIMENTACAO,
                                                                          POBSERVACAO => v_OBSERVACAO,
                                                                          PIDMATRIZENTRADA => v_IDMATRIZENTRADA,
                                                                          PMD5 => :P372_MD5,
                                                                          POPERACAO_DML => voperacao_dml);
                          --
                        end if;
                        --
                        v_DATAREGISTRO := ADD_MONTHS(:P372_DT_VENCIMENTO_PRIMEIRA_PARCELA, v_contador);
                        v_contador := v_contador + 1;
                        --
                      end loop;
                      commit;
                      --
                  end if;
                  --
                  --apex_application.g_print_success_message := 'V_PARCELAS '||V_PARCELAS||' / v_contador'||v_contador;
                  --
                  if V_PARCELAS = (v_contador - 1) then
                    --
                    apex_application.g_print_success_message := '<span style="color : white ">Parcelas geradas com Sucesso! </span>';
                    --
                  end if;
