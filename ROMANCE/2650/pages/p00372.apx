    process processo-dml-em-registro-de-conta-bancaria (
        name: Processo DML em Registro de Conta Bancaria
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                  vdata         date := nvl(:P372_DATA,sysdate);
                  vvalor        number;
                begin
                  --
                  
                  if v('REQUEST') = 'CRIAR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'SALVAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'DELETAR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  vvalor := :P372_VALOR;
                  --
                  PCK_CADASTROS_RMC.PRC_REGISTROSCONTASBANCARIAS( PIDREGISTROCONTABANCARIA => :P372_IDREGISTROCONTABANCARIA,
                                                                  PIDUNIDADEDENEGOCIO => :P372_IDUNIDADEDENEGOCIO,
                                                                  PIDBANCO => :P372_IDBANCO,
                                                                  PIDCONTABANCARIA => :P372_IDCONTABANCARIA,
                                                                  PDATA => vdata,
                                                                  PUSUARIO => :P372_USUARIO,
                                                                  PDATAREGISTRO => :P372_DATAREGISTRO,
                                                                --  PIDMES => :P372_IDMES,
                                                                 -- PANO => :P372_ANO,
                                                                  PVALOR => vvalor,
                                                                  PTIPOMOVIMENTACAO => :P372_TIPOMOVIMENTACAO,
                                                                  POBSERVACAO => :P372_OBSERVACAO,
                                                                  PIDMATRIZENTRADA => :P372_IDMATRIZENTRADA,
                                                                  PMD5 => :P372_MD5,
                                                                  POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo executado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 33611494695107750
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('DELETAR','SALVAR','CRIAR')
        }
    )

    process processo-duplicar-registro (
        name: Processo Duplicar Registro
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  cursor c1 (p_id number)is 
                    select *  
                     from registroscontasbancarias
                    where idregistrocontabancaria =  p_id;
                    --
                    r1 c1%rowtype;
                  --
                  vdata  date;
                  vvalor number;
                  vid number := 4313;
                  voperacao_dml varchar2(1) := 'I';
                  --
                  v_IDREGISTROCONTABANCARIA number;     
                  v_IDUNIDADEDENEGOCIO      number;           
                  v_IDBANCO                 number;           
                  v_IDCONTABANCARIA         number;           
                  v_data                    date;          
                  v_USUARIO                 varchar2(50);
                  v_DATAREGISTRO            date;         
                  v_valor                   number;          
                  v_TIPOMOVIMENTACAO        varchar2(10); 
                  v_OBSERVACAO              varchar2(2000);         
                  v_IDMATRIZENTRADA         number; 
                  --
                begin
                  --
                  null;
                  --
                  if v('REQUEST') = 'DUPLICAR' then 
                    --
                    open c1(:P372_IDREGISTROCONTABANCARIA);
                      fetch c1 into r1;
                        --
                        if c1%found then
                          --
                          v_IDREGISTROCONTABANCARIA := null;          
                          v_IDUNIDADEDENEGOCIO      := r1.idunidadedenegocio;          
                          v_IDBANCO                 := r1.idbanco;          
                          v_IDCONTABANCARIA         := r1.idcontabancaria;          
                          v_data                    := sysdate;          
                          v_USUARIO                 := v('APP_USER');
                          v_DATAREGISTRO            := trunc(sysdate);         
                          v_valor                   := r1.valor;          
                          v_TIPOMOVIMENTACAO        := r1.tipomovimentacao; 
                          v_OBSERVACAO              := r1.observacao;         
                          v_IDMATRIZENTRADA         := r1.idmatrizentrada;
                          --
                          PCK_CADASTROS_RMC.PRC_REGISTROSCONTASBANCARIAS( PIDREGISTROCONTABANCARIA => v_IDREGISTROCONTABANCARIA,
                                                                          PIDUNIDADEDENEGOCIO => v_IDUNIDADEDENEGOCIO,
                                                                          PIDBANCO => v_IDBANCO,
                                                                          PIDCONTABANCARIA => v_IDCONTABANCARIA,
                                                                          PDATA => v_data,
                                                                          PUSUARIO =>  v_USUARIO,
                                                                          PDATAREGISTRO => v_DATAREGISTRO,
                                                                        --  PIDMES => :P372_IDMES,
                                                                         -- PANO => :P372_ANO,
                                                                          PVALOR => v_valor,
                                                                          PTIPOMOVIMENTACAO => v_TIPOMOVIMENTACAO,
                                                                          POBSERVACAO => v_OBSERVACAO,
                                                                          PIDMATRIZENTRADA => v_IDMATRIZENTRADA,
                                                                          PMD5 => :P372_MD5,
                                                                          POPERACAO_DML => voperacao_dml);
                          --
                          commit;
                          --
                        end if;
                      --
                      select roman.seq_idregistrocontabancaria.currval
                      into :P372_IDREGISTROCONTABANCARIA_PARAMETRO
                      from dual;
                      --
                    close c1;
                    --
                    open c1(:P372_IDREGISTROCONTABANCARIA_PARAMETRO);
                      fetch c1 into r1;
                        --
                        if c1%found then
                          --
                          apex_application.g_print_success_message := '<span style="color : white ">Registro Duplicado com Sucesso! </span>';
                          --
                        end if;
                    close c1;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 3074110717932379841
        }
    )

