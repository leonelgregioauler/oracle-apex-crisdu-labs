                select u.nome
                     , u.idunidadedenegocio
                from unidadesdenegocios u
                where exists ( select 1
                               from acessosunidadesdenegocio au
                               where au.idunidadedenegocio = u.idunidadedenegocio
                                 and au.usuario = v('APP_USER') )
