    pageItem P372_IDCONTABANCARIA (
        type: selectOne
        label {
            label: Conta Bancária
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Ag: '||cb.agencia||' cc: '||cb.conta||' - '||cb.beneficiario display_value
                     , cb.idcontabanc return_value
                from contasbancarias cb
                where cb.idbanco = :P372_IDBANCO
                  and exists ( select 1
                               from unidadesdenegocios u
                                  , filiais f
                               where f.idunidadedenegocio = u.idunidadedenegocio
                                 and u.idunidadedenegocio = :P372_IDUNIDADEDENEGOCIO
                                 and f.idpessoa           = cb.idpessoa )
                order by 1
                ```
        }
        cascadingLov {
            parentItems: [
                P372_IDUNIDADEDENEGOCIO
                P372_IDBANCO
            ]
        }
        layout {
            sequence: 50
            region: @novo-registro-de-conta
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P372_IDMATRIZENTRADA (
        type: selectList
        label {
            label: Classificação
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.classificacaoentrada||' - '||pck_romance.fnc_nomefilial(m.idfilial) display_value
                     , m.idmatrizentrada
                from matrizclassificacoesentradas m
                where EXISTS ( select f.idfilial
                               from vw_filiais f
                               where f.idunidadedenegocio = :P372_IDUNIDADEDENEGOCIO 
                                 AND F.idfilial = M.idfilial )
                  and m.ativo = 'S'
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P372_IDUNIDADEDENEGOCIO
        }
        layout {
            sequence: 30
            region: @novo-registro-de-conta
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

