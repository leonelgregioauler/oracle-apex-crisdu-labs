page 88 (
    name: Programar Despesas
    title: Programar Despesas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region programar-despesas (
        name: Programar Despesas
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDDESPESA",
                "IDCONTACONTABIL",
                "OBSERVACAO",
                "VALOR",
                "IDSUBCONTACONTABIL",
                "DATAVENCIMENTO",
                "IDFILIAL",
                "USUARIO"
                from "#OWNER#"."DESPESAS"
                where 1= 2
                ```
        }
        layout {
            sequence: 15
            parentRegion: @programar-despesas-2
            slot: subRegions
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P88_CONTACONTABIL
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (nulo)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Dados não encontrados.
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 9
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: &nbsp;
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column DATAVENCIMENTO (
            reportColumnQueryId: 6
            derivedColumn: N
            type: datePicker
            heading {
                heading: Data Vencimento
            }
            layout {
                sequence: 5
            }
            appearance {
                width: 10
            }
        )

        column IDCONTACONTABIL (
            reportColumnQueryId: 2
            derivedColumn: N
            type: selectList
            heading {
                heading: Conta
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(c.nomeconta) display_value
                         , c.idcontafinan
                    from contasfinanceiras c
                    WHERE IDcontafinan = :P88_CONTACONTABIL
                    order by 1
                    ```
                displayNullValue: false
            }
            layout {
                sequence: 3
            }
            default {
                type: item
                item: P88_CONTACONTABIL
            }
        )

        column IDDESPESA (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDDESPESAS
            }
        )

        column IDFILIAL (
            reportColumnQueryId: 7
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 8
            }
            default {
                type: item
                item: P88_IDFILIAL
            }
            sorting {
                sortable: false
            }
        )

        column IDSUBCONTACONTABIL (
            reportColumnQueryId: 5
            derivedColumn: N
            type: selectList
            heading {
                heading: Sub Conta
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(c.nomeconta) display_value
                         , c.idsubcontafinan
                    from subcontasfinanceiras c
                    where c.idcontafinan = :P88_CONTACONTABIL
                    order by 1
                    ```
                nullDisplayValue: - Selecione a Subconta
            }
            layout {
                sequence: 4
            }
        )

        column OBSERVACAO (
            reportColumnQueryId: 3
            derivedColumn: N
            type: textField
            heading {
                heading: Observação
            }
            layout {
                sequence: 7
            }
            appearance {
                width: 50
            }
        )

        column USUARIO (
            reportColumnQueryId: 8
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 9
            }
            default {
                type: plsqlExpression
                plsqlExpression: v('APP_USER')
            }
        )

        column VALOR (
            reportColumnQueryId: 4
            derivedColumn: N
            type: textField
            heading {
                heading: Valor
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
                width: 12
            }
            advanced {
                customAttributes: style="text-align: right;"
            }
        )

    )

    region programar-despesas-2 (
        name: Programar Despesas
        type: staticContent
        layout {
            sequence: 5
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P88_CONTACONTABIL (
        type: selectList
        label {
            label: Conta
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(c.nomeconta) display_value
                     , c.idcontafinan
                from contasfinanceiras c
                order by 1
                ```
            nullDisplayValue: - Selecione a Conta -
        }
        layout {
            sequence: 20
            region: @programar-despesas-2
            slot: regionBody
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P88_IDFILIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @programar-despesas-2
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select  f.idfilial 
                from filiais    f
                   , usuarios   u
                   , gerentes   g
                where g.idfilial  = f.idfilial
                  and u.idgerente = g.idgerente
                  and u.usuario   = v('APP_USER')
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button add (
        buttonName: ADD
        label: Adicionar Linha
        layout {
            sequence: 40
            region: @programar-despesas
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @programar-despesas
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 88
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button multi-row-delete (
        buttonName: MULTI_ROW_DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @programar-despesas
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'MULTI_ROW_DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Salvar
        layout {
            sequence: 30
            region: @programar-despesas
            slot: CHANGE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation datavencimento-must-be-a-valid-date (
        name: DATAVENCIMENTO must be a valid date
        execution {
            sequence: 60
        }
        validation {
            editableRegion: @programar-despesas
            type: columnIsAValidDate
            column: DATAVENCIMENTO
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ser uma data válida.
            associatedColumn: DATAVENCIMENTO
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation idcontacontabil-must-be-numeric (
        name: IDCONTACONTABIL must be numeric
        execution {
            sequence: 20
        }
        validation {
            editableRegion: @programar-despesas
            type: columnIsNumeric
            column: IDCONTACONTABIL
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ser numérico.
            associatedColumn: IDCONTACONTABIL
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation idsubcontacontabil-must-be-numeric (
        name: IDSUBCONTACONTABIL must be numeric
        execution {
            sequence: 50
        }
        validation {
            editableRegion: @programar-despesas
            type: columnIsNumeric
            column: IDSUBCONTACONTABIL
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ser numérico.
            associatedColumn: IDSUBCONTACONTABIL
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation valor-must-be-numeric (
        name: VALOR must be numeric
        execution {
            sequence: 40
        }
        validation {
            editableRegion: @programar-despesas
            type: columnIsNumeric
            column: VALOR
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ser numérico.
            associatedColumn: VALOR
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @programar-despesas
        target {
            tableName: DESPESAS
            pkColumn: IDDESPESA
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Linha(s) #MRD_COUNT# deletadas.
        }
        error {
            errorMessage: Não é possível processar a deleção.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 180594024246820651
        }
        serverSideCondition {
            type: request=Value
            value: MULTI_ROW_DELETE
            executeCondition: once
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @programar-despesas
        target {
            tableName: DESPESAS
            pkColumn: IDDESPESA
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Linha(s) #MRU_COUNT# atualizada(s); linha(s) #MRI_COUNT# inserida(s).
        }
        error {
            errorMessage: Não foi possível processar a atualização.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 180593832472820649
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 81
            }
            saveStateBeforeBranching: true
        }
    )

)

