        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button confirmar-manual (
        buttonName: CONFIRMAR_MANUAL
        label: Confirmar manual
        layout {
            sequence: 10
            region: @identificação-manual
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @confirmar-edicao
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    
                    
                    
                    function compararValores() {
                        // Obter os valores dos itens
                        var valorItem1 = $v("P382_TOTAL");
                        var valorItem2 = $v("P382_VALORCONCILIACAO");
                    
                        // Remover espaços em branco e separadores de milhares
                        valorItem1 = valorItem1.replace(/\s/g, '').replace(/\./g, '').replace(/,/g, '.');
                        valorItem2 = valorItem2.replace(/\s/g, '').replace(/\./g, '').replace(/,/g, '.');
                    
                        // Converter os valores para números
                        var numeroItem1 = parseFloat(valorItem1);
                        var numeroItem2 = parseFloat(valorItem2);
                    
                        // Verificar se os valores são válidos
                        if (!isNaN(numeroItem1) && !isNaN(numeroItem2)) {
                            // Comparar os valores
                            if (numeroItem1 !== numeroItem2) {
                                // Exibir mensagem de erro
                                alert("Os valores dos itens são diferentes!");
                            } else {
                                // Caso os valores sejam iguais, não é necessário fazer nada
                            }
                        } else {
                            // Exibir mensagem de erro se os valores não puderem ser convertidos para números
                            alert("Os valores dos itens não são numéricos!");
                        }
                    }
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction rowselection (
        name: RowSelection
        execution {
            sequence: 10
        }
        when {
            selectionType: jQuerySelector
            jquerySelector: "input[name=\"f02\"]"
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    function formatarNumero(numero) {
                        // Arredonda o número para duas casas decimais
                        var numeroArredondado = numero.toFixed(2);
                        // Converte o número arredondado para string e separa a parte inteira da parte decimal
                        var partes = numeroArredondado.split('.');
                        var parteInteira = partes[0];
                        var parteDecimal = partes[1] || '00'; // Se não houver parte decimal, preenche com dois zeros
                    
                        // Adiciona o separador de milhares à parte inteira
                        parteInteira = parteInteira.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
                    
                        // Retorna o número formatado com a máscara correta
                        return parteInteira + ',' + parteDecimal;
                    }
                    
                    function calcularValorTotal() {
                        var total = 0;
                        // Seleciona todas as caixas de seleção no relatório interativo
                        var checkboxes = $('input[name="f02"]');
                        
                        // Itera sobre as caixas de seleção
                        checkboxes.each(function() {
                            // Verifica se a caixa de seleção está marcada
                            if ($(this).prop('checked')) {
                                // Obtém o valor associado à caixa de seleção
                                var valorTexto = $(this).closest('tr').find('td:eq(5)').text().trim(); // 5 é o índice da coluna valor_col
                                
                                // Remove os pontos de milhares e substitui a vírgula decimal por ponto
                                var valorNumerico = parseFloat(valorTexto.replace(/\./g, '').replace(',', '.'));
                                
                                // Verifica se o valor é numérico
                                if (!isNaN(valorNumerico)) {
                                    // Adiciona o valor ao total
                                    total += valorNumerico;
                                }
                            }
                        });
                    
                        // Formata o valor total com a máscara correta
                        var valorFormatado = formatarNumero(total);
                        
                        // Atualiza o valor do item de página 'P382_TOTAL' com o total calculado e formatado
                        $('#P382_TOTAL').val(valorFormatado);
                    }
                    
                    // Chama a função calcularValorTotal() quando uma caixa de seleção for alterada
                    $('input[name="f02"]').change(function() {
                        calcularValorTotal();
                    });
                    
                    // Chama a função calcularValorTotal() quando a página for carregada
                    $(document).ready(function() {
                        calcularValorTotal();
                    });
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process confirma (
        name: Confirma
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                /*declare
                  vtipo varchar2(1);
                  vid number;
                begin
                  -- 
                  if v('REQUEST') = 'CONFIRMAR_MANUAL' then
                    vtipo := 'Z'; 
                  else
                    vtipo := :P382_TIPO;
                  end if;
                  --
                  if APEX_APPLICATION.G_F02.COUNT > 0 then 
                  --
                    FOR i in 1..APEX_APPLICATION.G_F02.COUNT 
                    LOOP
                      --
                      vid := to_number(APEX_APPLICATION.G_F02(i));
                    
                  --if v('REQUEST') != 'CONFIRMAR_EDICAO' then
                    --
                    --vtipo := :P382_TIPO;
                    
                    select  m.tipo
                    into vtipo
                    from vw_movimentosidentificar m
                    where m.idextratobancario = :P382_IDEXTRATOBANCARIO
                      and m.id = vid;
                    
                    pck_bancos_rmc.prc_conciliacao_lote(pidextratobancario => :P382_IDEXTRATOBANCARIO,
                                                        ptipo => vtipo ,
                                                        pid => vid );
                    --
                    insert into conciliacoesbancarias (idconciliacao,
                                                       data,
                                                       idextratobancario,
                                                       conciliacaolote)
                    values ( seq_idconciliacao.nextval
                           , sysdate
                           , :P382_IDEXTRATOBANCARIO
                           , 'S');
                    --
                    commit;
                    --
                   end loop;
                  end if;
                  --
                end;*/
                
                DECLARE
                  vtipo VARCHAR2(1);
                  vid NUMBER;
                  vidconciliacao NUMBER;
                  verro VARCHAR2(1);
                  v1 NUMBER;
                  v2 NUMBER;
                  v_error_message VARCHAR2(200);
                  vqtddoc number;
                
                  -- Função para formatar a string para número
                  FUNCTION format_to_number(p_value VARCHAR2) RETURN NUMBER IS
                    v_num NUMBER;
                  BEGIN
                    -- Mostrar valor original para depuração
                    DBMS_OUTPUT.PUT_LINE('Valor original: ' || p_value);
                
                    -- Configurar NLS para interpretar a string corretamente
                    EXECUTE IMMEDIATE 'ALTER SESSION SET NLS_NUMERIC_CHARACTERS = '',.''';
                
                    -- Converter para número usando a máscara de formato
                    v_num := TO_NUMBER(p_value, '999G999G999G999G990D00');
                    
                    -- Mostrar valor convertido para depuração
                    DBMS_OUTPUT.PUT_LINE('Valor convertido: ' || v_num);
                    
                    RETURN v_num;
                  EXCEPTION
                    WHEN OTHERS THEN
                      RAISE_APPLICATION_ERROR(-20004, 'Erro na conversão do valor: ' || p_value);
                  END;
                  
                BEGIN
                  -- Habilitar saída DBMS_OUTPUT para depuração
                  DBMS_OUTPUT.ENABLE;
                
                  -- Verificação detalhada dos valores de :P382_TOTAL e :P382_VALORCONCILIACAO
                  BEGIN
                    -- Depuração dos valores originais
                    DBMS_OUTPUT.PUT_LINE('Valor original de :P382_TOTAL: ' || :P382_TOTAL);
                    DBMS_OUTPUT.PUT_LINE('Valor original de :P382_VALORCONCILIACAO: ' || :P382_VALORCONCILIACAO);
                    
                    v1 := format_to_number(:P382_TOTAL);
                    v_error_message := 'Valor de :P382_TOTAL após formatação: ' || v1;
                    DBMS_OUTPUT.PUT_LINE(v_error_message);
                    
                    v2 := format_to_number(:P382_VALORCONCILIACAO);
                    v_error_message := 'Valor de :P382_VALORCONCILIACAO após formatação: ' || v2;
                    DBMS_OUTPUT.PUT_LINE(v_error_message);
                  EXCEPTION
                    WHEN VALUE_ERROR THEN
                      RAISE_APPLICATION_ERROR(-20003, 'Erro na conversão de :P382_TOTAL ou :P382_VALORCONCILIACAO para número. ' || v_error_message);
                  END;
                  
                  -- Verifica se os valores são iguais
                  IF v2 != v1 THEN 
                    apex_error.add_error( p_message => 'A soma dos valores deve ser igual!'
                                        , p_display_location => apex_error.c_inline_in_notification );
                    ROLLBACK;
                    RETURN;
                  END IF;
                  
                  -- Obter o próximo valor da sequência
                  SELECT seq_idconciliacao.nextval
                  INTO vidconciliacao
                  FROM dual;
                  
                  -- Inserir registro na tabela de conciliações bancárias
                  INSERT INTO conciliacoesbancarias ( idconciliacao
                                                    , data
                                                    , idextratobancario
                                                    , conciliacaolote ) 
                  VALUES ( vidconciliacao
                         , sysdate
                         , :P382_IDEXTRATOBANCARIO
                         , 'S' );
                  
                  -- Verificar se há itens no array APEX_APPLICATION.G_F02
                  IF APEX_APPLICATION.G_F02.COUNT > 0 THEN 
                    -- Loop através de cada item no array
                    FOR i IN 1..APEX_APPLICATION.G_F02.COUNT 
                    LOOP
                      BEGIN
                        -- Converte o item atual do array para número
                        vid := TO_NUMBER(APEX_APPLICATION.G_F02(i));
                      EXCEPTION
                        WHEN VALUE_ERROR THEN
                          RAISE_APPLICATION_ERROR(-20001, 'Erro na conversão de APEX_APPLICATION.G_F02(' || i || ') para número.');
                      END;
                      
                         
                         -- Conta a quantidade de registros na view para o id
                        SELECT count(m.id)
                        INTO vqtddoc
                        FROM vw_movimentosidentificar m
                        WHERE m.idextratobancario = :P382_IDEXTRATOBANCARIO
                          AND m.id = vid;
                        
                        if vqtddoc = 1 then
                        
                        BEGIN
                        -- Obtém o tipo do movimento relacionado ao ID do extrato bancário e ao ID atual
                        SELECT m.tipo
                        INTO vtipo
                        FROM vw_movimentosidentificar m
                        WHERE m.idextratobancario = :P382_IDEXTRATOBANCARIO
                          --AND m.documento = :P382_DOCUMENTO
                          AND m.id = vid;
                        EXCEPTION
                         WHEN NO_DATA_FOUND THEN
                          RAISE_APPLICATION_ERROR(-20002, '1 - Nenhum movimento encontrado para o ID ' || vid || '.');
                          when others then
                          RAISE_APPLICATION_ERROR(-20002, '1 - Mais de um movimento encontrado para o ID ' || vid || '.');
                        END;
                
                        elsif vqtddoc > 1 then
                
                        BEGIN
                        -- Obtém o tipo do movimento relacionado ao ID do extrato bancário e ao ID atual
                        SELECT DISTINCT m.tipo -- T11643004 Adicionado o distinct
                        INTO vtipo
                        FROM vw_movimentosidentificar m
                        WHERE m.idextratobancario = :P382_IDEXTRATOBANCARIO
                          AND trunc(m.valor) = :P382_VALOR
                          AND m.id = vid;
                        EXCEPTION
                         WHEN NO_DATA_FOUND THEN
                          if v('APP_USER') = 'DIEGOPIECHO' then
                            --
                            RAISE_APPLICATION_ERROR(-20002, '2 - Nenhum movimento encontrado para o ID ' || vid || ' / :P382_IDEXTRATOBANCARIO: '||:P382_IDEXTRATOBANCARIO||' / :P382_VALOR: '||TO_CHAR(:P382_VALOR, 'FM9999990.00'));
                            --
                            else
                            --
                            RAISE_APPLICATION_ERROR(-20002, '2 - Nenhum movimento encontrado para o ID ' || vid || '.');
                            --
                          end if;
                          when others then
                          RAISE_APPLICATION_ERROR(-20002, '2 - Mais de um movimento encontrado para o ID ' || vid || '.');
                        END;
                
                        end if;
                
                              /*BEGIN
                        SELECT DISTINCT m.tipo
                        INTO vtipo
                        FROM vw_movimentosidentificar m
                        WHERE m.idextratobancario = :P382_IDEXTRATOBANCARIO
                          AND m.id = vid;
                      EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                          RAISE_APPLICATION_ERROR(-20002, 'Nenhum movimento encontrado para o ID ' || vid || '.');
                        WHEN TOO_MANY_ROWS THEN
                          RAISE_APPLICATION_ERROR(-20002, 'Tipos divergentes para o ID ' || vid || '.');
                      END;*/
                
                      /*if v('APP_USER') = 'DIEGOPIECHO' then
                        --
                        RAISE_APPLICATION_ERROR(-20002, 'aNTES DA prc_conciliacao_lote');
                        --
                      end if;*/
                      -- Chama o procedimento para conciliação de lote
                      pck_bancos_rmc.prc_conciliacao_lote( pidextratobancario => :P382_IDEXTRATOBANCARIO,
                                                           ptipo => vtipo,
                                                           pid => vid,
                                                           pidconciliacao => vidconciliacao );
                    END LOOP;
                  END IF;
                END;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Confirmado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 4790609724679088130
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMAR_EDICAO
        }
    )

    process popula-conciliacao (
        name: popula conciliacao
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 vvalorconciliacao number;
                begin
                
                  select abs(ex.valor)
                  into vvalorconciliacao
                  from extratosbancarios ex
                  where ex.idextratobancario = :P382_IDEXTRATOBANCARIO;
                  
                  :P382_VALORCONCILIACAO := to_char(vvalorconciliacao,'999G999G999G999G990D00');
                   
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 3075238903888918127
        }
    )

    branch (
        name: Go To Page 382
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 382
                items: {
                    P382_IDEXTRATOBANCARIO: &P382_IDEXTRATOBANCARIO.
                    P382_TIPO:
                    P382_ID:
                    P382_OBSERVACAO:
                }
                clearCache: 382
                action: resetPagination
            }
        }
    )

