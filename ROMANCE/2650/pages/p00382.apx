page 382 (
    name: Conciliar Movimento
    title: Conciliar Movimento
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region identificação-manual (
        name: Identificação Manual
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
    )

    region movimentos-para-identificar (
        name: Movimentos para Identificar
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*select 'Fatura' tipo
                     , pf.databaixa data
                     , nf.documento
                     , pck_romance.fnc_nomefornecedor(nf.idfornemitente) origem
                     , pf.valorpago
                     , '<a href="javascript:apex.confirm(''Confirmar localização do Valor?'', { request:''CONFIRMAR'', set:{''P382_ID'':'||pf.idpgtoforn||',''P382_TIPO'':'||'''X'' }} )";><img src="#APP_IMAGES#ok.png"  border="0"></a>' confirmar
                     , pf.idpgtoforn
                from pagamentosfornecedores pf
                   , notasfiscais nf
                   , contasbancarias cb
                   , extratosbancarios e
                where nf.idnotafiscal = pf.idnotafiscal
                  and cb.idcontabanc  = pf.idcontapagamento
                  and e.idextratobancario = :P382_IDEXTRATOBANCARIO
                 -- and pf.valorpago    = (e.valor*-1)
                  and trunc(pf.databaixa) between e.datamovimentacao-5 and e.datamovimentacao+5
                  and cb.agencialimpa = e.agencia
                  and cb.contalimpa = e.conta
                  and not exists ( select 1
                                   from conciliacoesbancarias c
                                   where c.idpagamentofornecedor = pf.idpgtoforn )
                union
                select 'Deposito' tipo
                     , dl.dataleitura 
                     , dl.nroidentificacao_digitado
                     , pck_romance.fnc_nomerepresentante(d.idrepresentante) origem
                     , dl.valor_digitado 
                     , '<a href="javascript:apex.confirm(''Confirmar localização do Valor?'', { request:''CONFIRMAR'', set:{''P382_ID'':'||d.iddepositodiarios||',''P382_TIPO'':'||'''D'' }} )";><img src="#APP_IMAGES#ok.png"  border="0"></a>' confirmar
                     , d.iddepositodiarios
                from depositosdiarios_leituraocr dl
                   , depositosdiarios_orig d
                   , contasbancarias cb
                   , extratosbancarios e
                where dl.iddepositodiario = d.iddepositodiarios
                  and cb.idcontabanc = d.idcontabanc
                  --and dl.valor_digitado = e.valor
                  and e.idextratobancario = :P382_IDEXTRATOBANCARIO
                  and trunc(dl.dataleitura) between e.datamovimentacao-5 and e.datamovimentacao+5
                  and cb.agencialimpa = e.agencia
                  and cb.contalimpa = e.conta
                  and not exists ( select 1
                                   from conciliacoesbancarias c
                                   where c.iddepositodiario = d.iddepositodiarios )
                union
                select 'Favorita' 
                     , pp.databaixa
                     , to_char(p.idpedido)
                     , pck_romance.fnc_nomefilial(p.idfilialromance)
                     , pp.valorapagar
                     , '<a href="javascript:apex.confirm(''Confirmar localização do Valor?'', { request:''CONFIRMAR'', set:{''P382_ID'':'||p.idpedido||',''P382_TIPO'':'||'''F'' }} )";><img src="#APP_IMAGES#ok.png"  border="0"></a>' confirmar
                     , p.idpedido
                from favorita.parcelamentospedidos pp
                   , favorita.pedidos p
                   , contasbancarias cc
                   , extratosbancarios e
                where pp.idpedido = p.idpedido
                  and pp.idcontabancariafilial = cc.idcontabanc
                  and pp.idnegociacaoparceiro is null
                  --and pp.valorapagar = e.valor
                  and e.idextratobancario = :P382_IDEXTRATOBANCARIO
                  and trunc(pp.databaixa) between e.datamovimentacao-5 and e.datamovimentacao+5
                  and cc.agencialimpa = e.agencia
                  and cc.contalimpa = e.conta
                  and not exists ( select 1
                                   from conciliacoesbancarias c
                                   where c.idpedido = pp.idpedido )
                union
                select 'Romance'
                     , pn.databaixa
                     , nv.numeronota
                     , pck_romance.fnc_nomefilial(nv.idfilial) 
                     , pn.valorapagar
                     , '<a href="javascript:apex.confirm(''Confirmar localização do Valor?'', { request:''CONFIRMAR'', set:{''P382_ID'':'||nv.idnotavenda||',''P382_TIPO'':'||'''R'' }} )";><img src="#APP_IMAGES#ok.png"  border="0"></a>' confirmar
                     , nv.idnotavenda
                from parcelamentosnotasvendas pn
                   , notasvendas nv
                   , contasbancarias cc
                   , extratosbancarios e
                where pn.idnotavenda = nv.idnotavenda
                  and pn.idcontabancariafilial = cc.idcontabanc
                  and pn.idnegociacaoparceiro is null
                  --and pn.valorapagar = e.valor
                  and e.idextratobancario = :P382_IDEXTRATOBANCARIO
                  and trunc(pn.databaixa) between e.datamovimentacao-5 and e.datamovimentacao+5
                  and cc.agencialimpa = e.agencia
                  and cc.contalimpa = e.conta
                  and not exists ( select 1
                                   from conciliacoesbancarias c
                                   where c.idnotavenda = pn.idnotavenda )
                union
                --Esta é a forma antiga , agora utilizamos a consulta de Fatura.
                select 'Boleto'  
                     , pb.databaixa
                     , b.numero
                     , pck_romance.fnc_nomefilial(b.idfilial)
                     , pb.valorapagar
                     , '<a href="javascript:apex.confirm(''Confirmar localização do Valor?'', { request:''CONFIRMAR'', set:{''P382_ID'':'||b.idboleto||',''P382_TIPO'':'||'''B'' }} )";><img src="#APP_IMAGES#ok.png"  border="0"></a>' confirmar
                     , b.idboleto
                from catal.parcelamentosboletos pb
                   , boletos b
                   , contasbancarias cc
                   , extratosbancarios e
                where pb.idboleto  = b.idboleto
                  and pb.idcontabancariafilial = cc.idcontabanc
                  and pb.idnegociacaoparceiro is null
                  --and pb.valorapagar = e.valor
                  and e.idextratobancario = :P382_IDEXTRATOBANCARIO
                  and trunc(pb.databaixa) between e.datamovimentacao-5 and e.datamovimentacao+5
                  and cc.agencialimpa = e.agencia
                  and cc.contalimpa = e.conta
                  and not exists ( select 1
                                   from conciliacoesbancarias c
                                   where c.idboleto = pb.idboleto )
                union
                select 'Cobraki'
                     , dp.dataleitura
                     , dp.nroidentificacao_digitado
                     , pck_romance.fnc_nomefilial(np.idfilial)
                     , dp.valor_digitado
                     , '<a href="javascript:apex.confirm(''Confirmar localização do Valor?'', { request:''CONFIRMAR'', set:{''P382_ID'':'||np.idnegociacaoparceiro||',''P382_TIPO'':'||'''N'' }} )";><img src="#APP_IMAGES#ok.png"  border="0"></a>' confirmar
                     , np.idnegociacaoparceiro
                from negociacoesparceiros np
                   , depositosnegociacoesparc dp
                   , contasbancarias cb
                   , extratosbancarios e
                where dp.idnegociacaoparceiro = np.idnegociacaoparceiro
                  and np.origem = 'C'
                  and cb.idcontabanc = np.idcontabancaria
                  --and np.valornegociacao = e.valor
                  and e.idextratobancario = :P382_IDEXTRATOBANCARIO
                  and trunc(dp.dataleitura) between e.datamovimentacao-5 and e.datamovimentacao+5
                  and cb.agencialimpa = e.agencia
                  and cb.contalimpa = e.conta
                  and not exists ( select 1
                                   from conciliacoesbancarias c
                                   where c.idnegociacaoparceiro = np.idnegociacaoparceiro )
                union
                select 'Acordo Interno'
                     , pp.datapagamento
                     , pp.comprovante
                     , pck_romance.fnc_nomefilial(np.idfilial)
                     , pp.valorparcela
                     , '<a href="javascript:apex.confirm(''Confirmar localização do Valor?'', { request:''CONFIRMAR'', set:{''P382_ID'':'||np.idnegociacaoparceiro||',''P382_TIPO'':'||'''A'' }} )";><img src="#APP_IMAGES#ok.png"  border="0"></a>' confirmar
                     , np.idnegociacaoparceiro
                from negociacoesparceiros np
                   , pagamentosnegociacoesparceiros pp
                   , contasbancarias cb
                   , extratosbancarios e
                where np.formapagamento = 'D'
                  and np.origem         = 'B'
                  and pp.idnegociacaoparceiro = np.idnegociacaoparceiro
                  and cb.idcontabanc = np.idcontabancaria
                  --and np.valornegociacao = e.valor
                  and e.idextratobancario = :P382_IDEXTRATOBANCARIO
                  and trunc(pp.datapagamento) between e.datamovimentacao-5 and e.datamovimentacao+5
                  and cb.agencialimpa = e.agencia
                  and cb.contalimpa = e.conta
                  and not exists ( select 1
                                   from conciliacoesbancarias c
                                   where c.idnegociacaoparceiro = np.idnegociacaoparceiro );*/
                /*select m.tipo
                     , m.data
                     , m.documento
                     , m.origem
                     , m.valor
                     , m.id
                     , m.idextratobancario
                     , apex_item.CHECKBOX2(2,m.documento, null)CHECK1
                from vw_movimentosidentificar m
                where m.idextratobancario = :P382_IDEXTRATOBANCARIO*/
                
                select apex_item.CHECKBOX2(2, m.id, null) as check1
                     , m.tiponome
                     , m.tipo
                     , m.data
                     , m.documento
                     , m.origem
                     --, m.valor as valor_col
                     , to_number(to_char(m.valor,'9999999990D00')) valor_col
                     , m.id
                     , m.idextratobancario
                     , case 
                         when m.documento is not null and m.tipo != 'T' then
                           '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=2650:26:'||v('APP_SESSION')||'::NO::P26_DOCUMENTO,P26_ANO,P26_IDFORNECEDOR:'||m.documento||','||m.ano||','||m.forne,'SESSION')||''',''_blank''); void(0);"><img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt=""/></a>'
                         else
                         '-'
                       end ir_pnota
                     --, '<td headers="valor">' || m.valor || '</td>' as valor_col
                from vw_movimentosidentificar m
                where m.idextratobancario = :P382_IDEXTRATOBANCARIO
                    and ( :P382_TIPOTRANSFERENCIA = 'S' and m.deb_cred is null or 
                          :P382_TIPOTRANSFERENCIA = 'S' and m.deb_cred = 'C' or
                          :P382_TIPOTRANSFERENCIA = 'N' and m.deb_cred = :P382_DEB_CRED)
                
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
