page 90 (
    name: Distribuido
    title: Distribuido
    appearance {
        pageMode: nonModalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region distribuir (
        name: Distribuir
        type: tabform
        source {
            sqlQuery:
                ```sql
                select IDDISTRIBUICAOEMPRESA
                      , IDFILIAL
                      ,pck_romance.fnc_nomefornecedor(idfornecedor) fornecedor
                     , pck_romance.fnc_nomeproduto(idproduto) produto
                     , precocusto
                     , QTDPP
                     , QTDP
                     , QTDM
                     , QTDG
                     , QTDGG
                     , QTDEGG
                     , QTDEXGG
                     , QTDXXGG
                     , QTDU
                     , nvl(QTDPP  ,0)
                     + nvl(QTDP   ,0)
                     + nvl(QTDM   ,0)
                     + nvl(QTDG   ,0)
                     + nvl(QTDGG  ,0)
                     + nvl(QTDEGG ,0)
                     + nvl(QTDEXGG,0)
                     + nvl(QTDXXGG,0)
                     + nvl(QTDU   ,0) total
                   --  , precocusto Custo
                     , (nvl(QTDPP  ,0)
                     + nvl(QTDP   ,0)
                     + nvl(QTDM   ,0)
                     + nvl(QTDG   ,0)
                     + nvl(QTDGG  ,0)
                     + nvl(QTDEGG ,0)
                     + nvl(QTDEXGG,0)
                     + nvl(QTDXXGG,0)
                     + nvl(QTDU   ,0)) * precocusto vlrtotal
                from DISTRIBUICAOEMPRESAS d
                where idsemana = :P90_IDSEMANA
                  and idfilial = :P90_IDFILIAL
                	and (nvl(QTDPP  ,0) > 0
                     or nvl(QTDP   ,0) > 0
                     or nvl(QTDM   ,0) > 0
                     or nvl(QTDG   ,0) > 0
                     or nvl(QTDGG  ,0) > 0
                     or nvl(QTDEGG ,0) > 0
                     or nvl(QTDEXGG,0) > 0
                     or nvl(QTDXXGG,0) > 0
                     or nvl(QTDU   ,0) > 0 )
                ORDER BY 1
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P90_IDSEMANA
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
        }
        pagination {
            type: showAll
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: -
        }
        breakFormatting {
            breakColumns: cols1-2
        }
        componentAdvanced {
            stripHtml: true
        }

        column FORNECEDOR (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Fornecedor
                alignment: center
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

        column IDDISTRIBUICAOEMPRESA (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
