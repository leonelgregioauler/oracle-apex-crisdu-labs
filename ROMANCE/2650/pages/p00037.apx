    button apply (
        buttonName: APPLY
        label: Corrigir Valor
        layout {
            sequence: 10
            region: @informar-comprovante
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar e Atualizar Lista
        layout {
            sequence: 20
            region: @informar-comprovante
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 25
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P37_IDDEPOSITODIARIOS
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @informar-comprovante
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P37_IDDEPOSITODIARIOS
        }
    )

    dynamicAction confirma (
        name: Confirma
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @apply
        }

        action native-confirm (
            action: confirm
            settings {
                message: Deseja realmente mudar o valor do depósito?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: APPLY
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    validation valor-deposito (
        name: Valor deposito
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P37_VALORLOCALIZADO
        }
        error {
            errorMessage: Valor deve ser informado!
        }
        serverSideCondition {
            whenButtonPressed: @apply
        }
    )

    process corrigir-valor (
        name: Corrigir valor
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  execute immediate 'alter table DEPOSITOSDIARIOS_LEITURAOCR disable constraint DK_DEPDIA_OCR_DEPDIA';
                  --
                  pck_financeiro_rmc.prc_alteravalordeposito(piddepositodiario => :P37_IDDEPOSITODIARIOS,
                                                             pvalordeposito => TRIM(TO_NUMBER(:P37_VALORLOCALIZADO,'999G999G999G990D00')),
                                                             ppagina => 37);
                  execute immediate 'alter table DEPOSITOSDIARIOS_LEITURAOCR enable constraint DK_DEPDIA_OCR_DEPDIA';
                  --
                end;
                
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 258618324878161105
        }
        serverSideCondition {
            whenButtonPressed: @apply
        }
    )

    process fetch-row-from-depositosdiarios (
        name: Fetch Row from DEPOSITOSDIARIOS
        type: autoRowFetch
        source {
            tableName: DEPOSITOSDIARIOS_ORIG
            pkColumn: IDDEPOSITODIARIOS
            pkItem: P37_IDDEPOSITODIARIOS
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Unable to fetch row.
        }
        advanced {
            executionMappingIdentifier: 181378869427571662
        }
    )

    process process-row-of-depositosdiarios (
        name: Process Row of DEPOSITOSDIARIOS
        type: autoRowProcessing
        target {
            tableName: DEPOSITOSDIARIOS_ORIG
            pkColumn: IDDEPOSITODIARIOS
            pkItem: P37_IDDEPOSITODIARIOS
            supportedOperations: update
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        error {
            errorMessage: Unable to process row of table DEPOSITOSDIARIOS.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 181379060728571687
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        clear {
            type: pages
            pages: 59
        }
        execution {
            sequence: 70
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 181379248247571711
        }
        serverSideCondition {
            type: never
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 37
                items: {
                    P37_IDDEPOSITODIARIOS: &P37_IDDEPOSITODIARIOS.
                }
                successMessage: false
            }
        }
    )

)

