page 37 (
    name: Informar Comprovante
    title: Informar Comprovante
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 80%
        height: 90%
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region informar-comprovante (
        name: Informar Comprovante
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
    )

    pageItem P37_COMPROVADO (
        type: selectList
        label {
            label: Comprovado
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sem Comprovante;S,Com Gerente;G,Cópia;C,Em Mãos;M
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @informar-comprovante
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: COMPROVADO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P37_DATARESOLVIDO (
        type: displayOnly
        label {
            label: Data Resolvido
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 190
            region: @informar-comprovante
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: DATARESOLVIDO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P37_FECHAMENTO (
        type: displayOnly
        label {
            label: Fechamento Do Distribuidor
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 160
            region: @informar-comprovante
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select f.semana
                from depositosdiarios_orig d
                   , fechamentorepresentantes f
                   , fechamentossemanais ff
                where d.iddepositodiarios  = :P37_IDDEPOSITODIARIOS
                  and d.idfechamentorepres = f.idfechamentorepres
                  and f.idfechamento       = ff.idfechamento
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P37_FECHAMENTO_EMPRESA (
        type: displayOnly
        label {
            label: Fechamento Da Empresa
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 180
            region: @informar-comprovante
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select ff.semana
                from depositosdiarios_orig d
                   , fechamentorepresentantes f
                   , fechamentossemanais ff
                where d.iddepositodiarios  = :P37_IDDEPOSITODIARIOS
                  and d.idfechamentorepres = f.idfechamentorepres
                  and f.idfechamento       = ff.idfechamento
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

