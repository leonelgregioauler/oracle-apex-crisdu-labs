page 139 (
    name: Cadastro de Transportadora
    title: Cadastro de Transportadora
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 70%
        height: 70%
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region cadastro-de-transportadora (
        name: Cadastro de Transportadora
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P139_ATIVO (
        type: selectList
        label {
            label: Ativo
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @cadastro-de-transportadora
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: ATIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P139_IDPESSOA (
        type: hidden
        layout {
            sequence: 20
            region: @cadastro-de-transportadora
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDPESSOA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P139_IDTRANSPORTADORA (
        type: hidden
        layout {
            sequence: 1
            region: @cadastro-de-transportadora
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDTRANSPORTADORA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P139_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @cadastro-de-transportadora
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
            height: 3
        }
        validation {
            maxLength: 150
        }
        source {
            type: databaseColumn
            databaseColumn: OBSERVACAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 30
            region: @cadastro-de-transportadora
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P139_IDTRANSPORTADORA
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 10
            region: @cadastro-de-transportadora
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P139_IDTRANSPORTADORA
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Alterações
        layout {
            sequence: 20
            region: @cadastro-de-transportadora
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P139_IDTRANSPORTADORA
        }
    )

    process fetch-row-from-transportadoras (
        name: Fetch Row from TRANSPORTADORAS
        type: autoRowFetch
        source {
            tableOwner: CATAL
            tableName: TRANSPORTADORAS
            pkColumn: IDTRANSPORTADORA
            pkItem: P139_IDTRANSPORTADORA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Não é possível extrair a linha.
        }
        advanced {
            executionMappingIdentifier: 184691710785360484
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDTRANSPORTADORA.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P139_IDTRANSPORTADORA := get_pk; 
                end;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Não é possível obter valor de item de chave primária.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 184691936169360487
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-transportadoras (
        name: Process Row of TRANSPORTADORAS
        type: autoRowProcessing
        target {
            tableOwner: CATAL
            tableName: TRANSPORTADORAS
            pkColumn: IDTRANSPORTADORA
            pkItem: P139_IDTRANSPORTADORA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        error {
            errorMessage: Não é possível processar a linha da tabela TRANSPORTADORAS.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 184692131902360487
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 184692330169360487
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 139
            }
            saveStateBeforeBranching: true
        }
    )

)

