page 348 (
    name: Grupos de Negócios
    title: Grupos de Negócios
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region grupos-de-negócios (
        name: Grupos de Negócios
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDGRUPONEGOCIO
                     , DESCRICAO
                     , IDSEGMENTONEGOCIO
                     , ( select nome
                         from segmentosnegocios s
                         where s.idsegmentonegocio = g.idsegmentonegocio ) segmento
                     , ( select decode(s.tipo,'C','Crisdu','A','Serviço','N','Não Operacional','I','Serviços Internos')
                         from segmentosnegocios s
                         where s.idsegmentonegocio = g.idsegmentonegocio ) apoiocrisdu
                     , CODIGO
                     , decode(g.contabilizarbi,'S','Sim','N','Não') contabilizarbi
                from GRUPOSNEGOCIOS g
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 12325054774565057
        }

        column APOIOCRISDU (
            type: plainText
            heading {
                heading: Tipo
                alignment: center
            }
            layout {
                sequence: 25
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column CODIGO (
            type: plainText
            heading {
                heading: Código
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column CONTABILIZARBI (
            type: plainText
            heading {
                heading: Contabiliza no BI?
                alignment: center
            }
            layout {
                sequence: 35
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column DESCRICAO (
            type: plainText
            heading {
                heading: Grupo de Negócio
                alignment: center
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column IDGRUPONEGOCIO (
            type: link
            heading {
                heading: Ver Grupo
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
            link {
                target: {
                    page: 349
                    items: {
                        P349_IDGRUPONEGOCIO: #IDGRUPONEGOCIO#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column IDSEGMENTONEGOCIO (
            type: hidden
            heading {
                heading: ID Segmento
            }
            layout {
                sequence: 4
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
            security {
                escapeSpecialChars: false
            }
        )

        column SEGMENTO (
            type: plainText
            heading {
                heading: Segmento
                alignment: center
            }
            layout {
                sequence: 15
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 40433002 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn APOIOCRISDU (
                sequence: 2
            )

            displayColumn CODIGO (
                sequence: 4
            )

            displayColumn CONTABILIZARBI (
                sequence: 6
            )

            displayColumn DESCRICAO (
                sequence: 5
            )

            displayColumn IDGRUPONEGOCIO (
                sequence: 1
            )

            displayColumn SEGMENTO (
                sequence: 3
            )

            sort (
                column: SEGMENTO
                sort {
                    sequence: 1
                }
            )

        )

    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 349
                items: {
                    P349_IDGRUPONEGOCIO:
                    P349_DESCRICAO:
                    P349_CODIGO:
                    P349_MD5:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

