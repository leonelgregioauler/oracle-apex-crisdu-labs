        }
        behavior {
            target: {
                page: 560
                items: {
                    P560_DATAINICIO: &P560_DATAINICIO.
                    P560_DATAFIM: &P560_DATAFIM.
                    P560_IDFILIAL: &P560_IDFILIAL.
                    P560_FILTRAR: S
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

