            encryptSessionState: false
        }
    )

    pageItem P560_IDFILIAL (
        type: selectList
        label {
            label: Franquia
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from roman.vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                  and f.idgrupo is not null
                  and (/*:P560_IDFILIAL != -1 and */exists (select 1
                                                        from roman.usuariosfiliais u
                                                        where u.idfilial = f.idfilial
                                                          and u.usuario = v('APP_USER')) --v('APP_USER'))
                   or (/*:P560_IDFILIAL = -1 and */exists (select 1
                                                       from usuariosgruposatendimento ug
                                                       where ug.idgrupoatendimento in (0,69)
                                                         and ug.usuario = v('APP_USER'))))
                ```
            nullDisplayValue: -Todas as Filiais-
            nullReturnValue: -1
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
