page 560 (
    name: Faturamento Liquido x Impostos
    alias: FATURAMENTO-LIQUIDO-X-IMPOSTOS
    title: Faturamento Liquido x Impostos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region comparativo (
        name: Comparativo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.empresa
                     , t.idrazao
                     , t.cnpj
                     , t.idfilial
                     , t.franquia
                     , t.mes_ano
                     , t.compra
                     , t.venda
                     , t.devolucao
                     , t.despesas
                     , t.faturamentoIdeal
                     , t.impostos
                     , venda - devolucao faturamento_liquido
                from ( select rf.razaosocial empresa
                             , rf.idrazaosocialfilial idrazao
                             , rf.cnpj
                             , f.idfilial 
                             , f.nome franquia
                             , to_char(dt.data,'MM/RRRR') mes_ano
                             , pck_financeiro_rmc.fnc_retornavaloresrazoesfiliais(pidrazaosocialfilial => rf.idrazaosocialfilial,
                                                                                  pidfilial            => f.idfilial,
                                                                                  pperiodo             => to_char(dt.data,'MM/RRRR'),
                                                                                  ptipo                => 'C')  compra
                             , pck_financeiro_rmc.fnc_retornavaloresrazoesfiliais(pidrazaosocialfilial => rf.idrazaosocialfilial,
                                                                                  pidfilial            => f.idfilial,
                                                                                  pperiodo             => to_char(dt.data,'MM/RRRR'),
                                                                                  ptipo                => 'V')  venda
                             , pck_financeiro_rmc.fnc_retornavaloresrazoesfiliais(pidrazaosocialfilial => rf.idrazaosocialfilial,
                                                                                  pidfilial            => f.idfilial,
                                                                                  pperiodo             => to_char(dt.data,'MM/RRRR'),
                                                                                  ptipo                => 'D')  devolucao
                             , pck_financeiro_rmc.fnc_retornavaloresrazoesfiliais(pidrazaosocialfilial => rf.idrazaosocialfilial,
                                                                                  pidfilial            => f.idfilial,
                                                                                  pperiodo             => to_char(dt.data,'MM/RRRR'),
                                                                                  ptipo                => 'DP')  despesas
                             , pck_financeiro_rmc.fnc_retornavaloresrazoesfiliais(pidrazaosocialfilial => rf.idrazaosocialfilial,
                                                                                  pidfilial            => f.idfilial,
                                                                                  pperiodo             => to_char(dt.data,'MM/RRRR'),
                                                                                  ptipo                => 'I')  impostos
                             , pck_financeiro_rmc.fnc_retornavaloresrazoesfiliais(pidrazaosocialfilial => rf.idrazaosocialfilial,
                                                                                  pidfilial            => f.idfilial,
                                                                                  pperiodo             => to_char(dt.data,'MM/RRRR'),
                                                                                  ptipo                => 'C')
                              + pck_financeiro_rmc.fnc_retornavaloresrazoesfiliais(pidrazaosocialfilial => rf.idrazaosocialfilial,
                                                                                  pidfilial            => f.idfilial,
                                                                                  pperiodo             => to_char(dt.data,'MM/RRRR'),
                                                                                  ptipo                => 'DP') faturamentoIdeal
                
                        from vw_filiais f
                           , razoessociaisfiliais rf
                           , datasperiodos dt
                        where rf.idfilial = f.idfilial
                          and f.ativo = 'S'
                          and f.tipofilial = 'D'
                          and ( :P560_IDFILIAL = -1 or f.idfilial = :P560_IDFILIAL )
                          and rf.ativo = 'S'
                          and rf.principal = 'S'
                          and dt.ano >= 2023
                          and rf.cnpj is not null
                          and rf.razaosocial is not null
                          and dt.ano <= extract(year from sysdate)
                          and dt.data between to_date(:P560_DATAINICIO,'DD/MM/RRRR') and to_date(:P560_DATAFIM,'DD/MM/RRRR')
                          and :P560_FILTRAR = 'S'
                          and (:P560_IDFILIAL != -1 and exists (select 1
                                                                from roman.usuariosfiliais u
                                                                where u.idfilial = f.idfilial
                                                                  and u.usuario = v('APP_USER')) --v('APP_USER'))
                           or (:P560_IDFILIAL = -1 and exists (select 1
                                                               from usuariosgruposatendimento ug
                                                               where ug.idgrupoatendimento in (0,69)
                                                                 and ug.usuario = v('APP_USER'))))
                        group by rf.razaosocial
                               , rf.idrazaosocialfilial
                               , f.idfilial
                               , f.nome 
                               , to_char(dt.data,'MM/RRRR')
                               , rf.cnpj ) t
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado, verifique os filtros e tente novamente!
        }
        advanced {
            savedReportMappingIdentifier: 2956382557265729665
        }

