                endUserAlias: Q
            }
        )

        savedReport 1819925 (
            visibility: primaryDefault
            view {
                pivot: true
                default: pivot
                rowsPerPage: 50
            }

            displayColumn NOMEFILIAL (
                sequence: 2
            )

            displayColumn NOMEFORNECEDORRODUTO (
                sequence: 1
            )

            displayColumn P (
