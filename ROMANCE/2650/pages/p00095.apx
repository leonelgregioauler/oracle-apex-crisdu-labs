page 95 (
    name: Resumo Distribuição
    title: Resumo Distribuição
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region resumo-distribuição (
        name: Resumo Distribuição
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct pck_romance.fnc_nomefilial(d.idfilial) nomefilial
                      , d.idfornecedor 
                      , pck_romance.fnc_nomefornecedor(idfornecedor) nomefornecedor
                      , d.idfilial
                      , pck_romance.fnc_nomeproduto(idproduto) produto
                      , sum(d.qtdpp)  + sum(d.qtdp) + sum(d.qtdm)   
                			+ sum(d.qtdg)   + sum(d.qtdgg)  +  sum(d.qtdegg) 
                			+ sum(d.qtdexgg)+ sum(d.qtdxxgg)+  sum(d.qtdu) total  
                      , sum(d.qtdpp)  + sum(d.qtdp) + sum(d.qtdm)   
                			+ sum(d.qtdg)   + sum(d.qtdgg)  +  sum(d.qtdegg) 
                			+ sum(d.qtdexgg)+ sum(d.qtdxxgg)+  sum(d.qtdu) * d.precocusto vlttotal
                from distribuicaoempresas d
                where d.idsemana  = 607--vidsemana  
                having sum(d.qtdpp)  + sum(d.qtdp) +  sum(d.qtdm)   
                    + sum(d.qtdg)   + sum(d.qtdgg)  +  sum(d.qtdegg) 
                    + sum(d.qtdexgg)+ sum(d.qtdxxgg)+  sum(d.qtdu)   > 0
                group by idfornecedor, idfilial, idproduto,d.precocusto
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        download {
            formats: csv
            sendAsEmail: false
        }
        advanced {
            savedReportMappingIdentifier: 181989641534332150
        }

