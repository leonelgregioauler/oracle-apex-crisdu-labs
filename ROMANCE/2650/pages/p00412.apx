page 412 (
    name: Log Notas Fiscais
    title: Log Notas Fiscais
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--accent5
                t-Region--scrollBody
            ]
            renderComponents: belowContent
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region log-notas-fiscais (
        name: Log Notas Fiscais
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ln.usuarioalteracao
                     , decode(ln.tipoalteracao,'INSERT','Inclusão','UPDATE','Alteração','DELETE','Exclusão') "Tipo Alt."
                     , ln.dataalteracao
                     , ln.idnotafiscal
                     , ln.documento
                     , roman.pck_romance.fnc_nomefornecedor(ln.idfornemitente) "Fornecedor"
                     , ln.tipoemitente
                     , ln.dtnf
                     , ln.usuario
                     , ln.valortotal
                     , ln.nrnf
                     , ln.volumes
                     , decode(ln.situacao,'A','Ativa/Aprovado','C','Cancelada','P','Aguardando Aprovação','E','Aguardando Envio para Aprovação','Ativa') Situacao
                     , ln.vlrdesconto
                     , ln.valorliquido
                     , ln.valorfrete
                     , decode(ln.tiponota, 'T', 'Transferência', 'C', 'Compra', 'R', 'Reserva/Ordem Pgto', 'D', 'Despesa') "Tipo NF"
                     , decode(ln.situacaofilial,'A','Aguardando Recebimento','R','Recebida','P','Parcialmente Recebida') "Situação Recebimento"
                     , ln.dataliberado
                     , ln.datarecebimento
                     , ln.emailrecebimento
                     , ln.conhecimentotransporte
                     , ln.observacao
                     , ln.datainclusao
                     , ln.nfe
                     , ln.valorcontabil
                     , ln.semananota
                     , ln.dataconclusao
                     , ln.volumesrecebidos
                     , ln.valoracrescimo
                     , ln.volumesviolados
                from logroman.log_notasfiscais ln
                where ( :P412_IDFORNECEDOR is null or ln.idfornemitente = : P412_IDFORNECEDOR )
                  and ( :P412_DOCUMENTO is null or ln.documento = : P412_DOCUMENTO )
                  and ( :P412_IDFORNECEDOR is not null or :P412_DOCUMENTO is not null )
                order by 3 desc
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: - Nenhum registro encontrado -
        }
        advanced {
            savedReportMappingIdentifier: 5710046011665762007
        }

