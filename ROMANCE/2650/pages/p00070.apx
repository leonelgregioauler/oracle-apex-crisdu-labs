page 70 (
    name: Revisar Saídas Diversas
    title: Revisar Saídas Diversas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region ajustar-matriz-classificação (
        name: Ajustar Matriz Classificação
        type: staticContent
        layout {
            sequence: 25
            slot: body
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-size600x400
            ]
        }
        advanced {
            htmlDomId: ajuste_popup
        }
    )

    region revisar-saídas (
        name: Revisar Saídas
        type: tabform
        source {
            sqlQuery:
                ```sql
                select IDSAIDA
                     , IDSAIDA IDSAIDA_DISPLAY
                     , DATA
                     , VALORTOTAL
                     , DESCRICAO
                     , IDFECHAMENTO
                     , EMMAOS
                     , TIPO
                     , IDCONTACONTABIL
                     , IDSUBCONTACONTABIL
                     , IDFILIALDEST
                     , OBSERVACAOCONTROLE
                     , NULL VERSAIDAS
                     , null questionamento
                     , ( select m.classificacaodespesa
                         from matrizclassificacoesdespesas m
                         where m.idmatrizclassificacao = s.idmatrizclassificacao ) matrizclassificacao
                     , (select distinct c.nome
                        from roman.matrizclassificacoesdespesas mc
                           , roman.centrodecustos c
                        where s.idmatrizclassificacao  = mc.idmatrizclassificacao
                          and mc.idcentrodecusto       = c.idcentrodecusto) "Centro de Custo"
                     , replace(substr(DESCRICAO,1,40),'.',' ') questionar
                     , idmatrizclassificacao -- Maicon Aimi - 10007007 - 23/06/2025
                     , IDFILIALDEST IDDESTINO
                from SAIDASDIVERSAS s
                where idfechamento = :P0_IDFECHAMENTO
                order by 1
                ```
        }
        layout {
            sequence: 15
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: showAll
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
        }
        componentAdvanced {
            stripHtml: true
        }

        column "Centro de Custo" (
            reportColumnQueryId: 16
            derivedColumn: N
            heading {
                heading: Centro De Custo
                alignment: center
            }
            layout {
                sequence: 8
            }
            sorting {
                sortable: false
            }
        )

        column DATA (
            reportColumnQueryId: 3
            derivedColumn: N
            type: datePicker
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 6
            }
            appearance {
                formatMask: dd/mm/rrrr
                width: 10
            }
            sorting {
                sortable: false
            }
        )

        column DESCRICAO (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
        )

        column EMMAOS (
            reportColumnQueryId: 7
            derivedColumn: N
            type: simpleCheckbox
            heading {
                heading: Em Mãos
                alignment: center
            }
            lov {
                checkboxValues: S
            }
            layout {
                sequence: 11
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column IDCONTACONTABIL (
            reportColumnQueryId: 9
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Conta
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select c.nomeconta    display_value
                         , c.idcontafinan retrun_value
                    from contasfinanceiras c
                    order by 1 
                    ```
            }
            layout {
                sequence: 9
            }
            appearance {
                width: 16
            }
            sorting {
                sortable: false
            }
        )

        column IDDESTINO (
            reportColumnQueryId: 19
            derivedColumn: N
            type: hidden
            layout {
                sequence: 30
            }
        )

        column IDFECHAMENTO (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 4
            }
        )

        column IDFILIALDEST (
            reportColumnQueryId: 11
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Destino
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_romance.fnc_nomefilial(idfilial)
                        , idfilial
                    from filiais
                    order by 1
                    ```
            }
            layout {
                sequence: 7
            }
            sorting {
                sortable: false
            }
        )

        column IDMATRIZCLASSIFICACAO (
            reportColumnQueryId: 18
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column IDSAIDA (
            reportColumnQueryId: 1
            derivedColumn: N
            type: textField
            heading {
                heading: ID Saída
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            primaryKeySource {
                type: existingTrigger
            }
            sorting {
                sortable: false
            }
            advanced {
                customAttributes: readonly
            }
        )

        column IDSAIDA_DISPLAY (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

        column IDSUBCONTACONTABIL (
            reportColumnQueryId: 10
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Sub Conta
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select '['||cc.nomeconta||'] '||c.nomeconta   display_value
                         , c.idsubcontafinan retrun_value
                    from subcontasfinanceiras c
                       , contasfinanceiras cc
                    where c.idcontafinan  = cc.idcontafinan
                    order by cc.nomeconta, c.nomeconta
                    ```
            }
            layout {
                sequence: 9
            }
            appearance {
                width: 16
            }
            sorting {
                sortable: false
            }
        )

        column MATRIZCLASSIFICACAO (
            reportColumnQueryId: 15
            derivedColumn: N
            type: link
            heading {
                heading: Matriz Classificação
                alignment: center
            }
            layout {
                sequence: 7
            }
            link {
                target: {
                    type: url
                    url: javascript:apex.item('P70_ID_SAIDA_AJUSTE_MATRIZ').setValue('#IDSAIDA#');apex.theme.openRegion('ajuste_popup');
                }
                linkText: #MATRIZCLASSIFICACAO#
            }
            sorting {
                sortable: false
            }
        )

        column OBSERVACAOCONTROLE (
            reportColumnQueryId: 12
            derivedColumn: N
            type: textField
            heading {
                heading: Obs Revisão
                alignment: center
            }
            layout {
                sequence: 12
            }
            appearance {
                width: 40
            }
            sorting {
                sortable: false
            }
        )

        column QUESTIONAMENTO (
            reportColumnQueryId: 14
            derivedColumn: N
            type: link
            heading {
                heading: Questionar
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            link {
                target: {
                    page: 433
                    items: {
                        P433_IDFECHAMENTO: &P0_IDFECHAMENTO.
                        P433_IDFILIAL: &P0_IDFILIALCAIXA.
                        P433_IDQUESTIONAMENTO:
                        P433_PAGINA: 70
                        P433_ORIGEM: &P70_ORIGEM.
                        P433_IDSAIDA: #IDSAIDA#
                    }
                    action: resetPagination
                }
                linkText: <img src="#APP_IMAGES#quest1.png" alt="">
            }
            sorting {
                sortable: false
            }
        )

        column QUESTIONAR (
            reportColumnQueryId: 17
            derivedColumn: N
            heading {
                heading: Questionar
                alignment: center
            }
            layout {
                sequence: 18
            }
            sorting {
                sortable: false
            }
        )

        column TIPO (
            reportColumnQueryId: 8
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC:Dinheiro;D,Pagamento de Conta;O
            }
            layout {
                sequence: 7
            }
            sorting {
                sortable: false
            }
        )

        column VALORTOTAL (
            reportColumnQueryId: 4
            derivedColumn: N
            type: textField
            heading {
                heading: Valor
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
                width: 16
            }
            sorting {
                sortable: false
            }
            advanced {
                customAttributes: style="text-align:right"
                computeSum: true
            }
        )

        column VERSAIDAS (
            reportColumnQueryId: 13
            derivedColumn: N
            type: link
            heading {
                heading: Ver Saidas
                alignment: center
            }
            layout {
                sequence: 16
                columnAlignment: center
            }
            link {
                target: {
                    page: 154
                    items: {
                        P154_IDSAIDA: #IDSAIDA#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-view.png" class="apex-edit-view" alt="">
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P70_IDFILIAL_MATRIZ_CLASSIFICACAO (
        type: selectList
        label {
            label: Filial
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomefilialromance(f.idfilial) as display_value
                     , f.idfilial as return_value
                  from catal.filiais f
                order by 1
                ```
        }
        layout {
            sequence: 20
            region: @ajustar-matriz-classificação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P70_ID_MATRIZ_CLASSIFICACAO (
        type: selectList
        label {
            label: Matriz Classificação
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.classificacaodespesa as display_value
                     , m.idmatrizclassificacao as return_value
                  from roman.matrizclassificacoesdespesas m
                 where m.idfilial = :P70_IDFILIAL_MATRIZ_CLASSIFICACAO
                   and m.ativo = 'S' --15011894
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P70_IDFILIAL_MATRIZ_CLASSIFICACAO
        }
        layout {
            sequence: 30
            region: @ajustar-matriz-classificação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P70_ID_SAIDA_AJUSTE_MATRIZ (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @ajustar-matriz-classificação
            slot: regionBody
        }
        security {
            sessionStateProtection: restricted
        }
    )

    pageItem P70_ORIGEM (
        type: hidden
        layout {
            sequence: 10
            region: @revisar-saídas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button ajustar-matriz-classificacao (
        buttonName: AJUSTAR_MATRIZ_CLASSIFICACAO
        label: Ajustar Matriz Classificação
        layout {
            sequence: 40
            region: @ajustar-matriz-classificação
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--padTop
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @revisar-saídas
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 91
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button novo-questionamento (
        buttonName: NOVO_QUESTIONAMENTO
        label: Novo Questionamento
        layout {
            sequence: 40
            region: @revisar-saídas
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 433
                items: {
                    P433_PAGINA: 70
                    P433_IDQUESTIONAMENTO:
                    P433_IDFECHAMENTO: &P0_IDFECHAMENTO.
                    P433_IDFILIAL: &P0_IDFILIALCAIXA.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select *
                from usuariosgruposatendimento ug
                where ug.idgrupoatendimento in (0,2)
                  and ug.usuario = v('APP_USER')
                ```
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Salvar
        layout {
            sequence: 30
            region: @revisar-saídas
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation data-must-be-a-valid-date (
        name: DATA must be a valid date
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @revisar-saídas
            type: columnIsAValidDate
            column: DATA
        }
        error {
            errorMessage: #COLUMN_HEADER# must be a valid date.
            associatedColumn: DATA
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation idcontacontabil-must-be-numeric (
        name: IDCONTACONTABIL must be numeric
        execution {
            sequence: 90
        }
        validation {
            editableRegion: @revisar-saídas
            type: columnIsNumeric
            column: IDCONTACONTABIL
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: IDCONTACONTABIL
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation idfechamento-must-be-numeric (
        name: IDFECHAMENTO must be numeric
        execution {
            sequence: 60
        }
        validation {
            editableRegion: @revisar-saídas
            type: columnIsNumeric
            column: IDFECHAMENTO
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: IDFECHAMENTO
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation idfilialdest-must-be-numeric (
        name: IDFILIALDEST must be numeric
        execution {
            sequence: 110
        }
        validation {
            editableRegion: @revisar-saídas
            type: columnIsNumeric
            column: IDFILIALDEST
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: IDFILIALDEST
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation idsubcontacontabil-must-be-numeric (
        name: IDSUBCONTACONTABIL must be numeric
        execution {
            sequence: 100
        }
        validation {
            editableRegion: @revisar-saídas
            type: columnIsNumeric
            column: IDSUBCONTACONTABIL
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: IDSUBCONTACONTABIL
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation valortotal-must-be-numeric (
        name: VALORTOTAL must be numeric
        execution {
            sequence: 40
        }
        validation {
            editableRegion: @revisar-saídas
            type: columnIsNumeric
            column: VALORTOTAL
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: VALORTOTAL
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process ajustar-matriz-classificacao (
        name: AJUSTAR_MATRIZ_CLASSIFICACAO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                    -- valida campo matriz classificação não informada
                    if :P70_ID_MATRIZ_CLASSIFICACAO is null then
                        apex_error.add_error(
                            p_message          => 'Ops! Verifique o campo <span style="color:red;font-weight:bold;">Matriz Classificação</span>, o mesmo precisa ser informado!',
                            p_display_location => apex_error.c_inline_in_notification
                            --p_escape           => false  -- permite interpretar HTML
                        );
                        return;
                    end if;
                
                    -- ajusta a matriz de classificação da saída
                    update roman.saidasdiversas s
                       set s.idmatrizclassificacao = :P70_ID_MATRIZ_CLASSIFICACAO
                     where s.idsaida = :P70_ID_SAIDA_AJUSTE_MATRIZ;
                
                    -- limpa campos
                    :P70_ID_MATRIZ_CLASSIFICACAO := null;
                    :P70_IDFILIAL_MATRIZ_CLASSIFICACAO := null;
                
                    -- Mensagem de Sucesso 
                    apex_application.g_print_success_message := '<span style="color : white ">Matriz Classificação foi ajustada com sucesso!</span>';
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 1335185568486548022
        }
        serverSideCondition {
            whenButtonPressed: @ajustar-matriz-classificacao
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @revisar-saídas
        target {
            tableName: SAIDASDIVERSAS
            pkColumn: IDSAIDA
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# row(s) updated, #MRI_COUNT# row(s) inserted.
        }
        advanced {
            executionMappingIdentifier: 209452711706798085
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        name: Go To Page 70
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 70
            }
        }
    )

)

