page 222 (
    name: Logs de Alterações
    title: Logs de Alterações
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region logs-de-alterações (
        name: Logs de Alterações
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.idlogentradadiversa
                     , e.identrada
                     , e.dataalteracao
                     , decode(e.tipoalteracao,'I', 'Incluiu', 'U', 'Alterou','D','Deletou') tipoalteracao
                     , e.usuario
                     , data
                     , e.valortotal
                     , descricao
                     , ( select semana from fechamentossemanais where idfechamento = e.idfechamento ) caixa
                     , decode(tipoentrada, 'D' ,'Dinheiro'
                                         , 'Pagamento de Conta' ) tipo
                from log_entradasdiversas e
                where idfilial = pck_romance.fnc_filialusuario(v('APP_USER'))
                order by 1 desc
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Verifique seu filtro
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 76126126969533010
        }

        column CAIXA (
            type: plainText
            heading {
                heading: Caixa
                alignment: center
            }
            layout {
                sequence: 8
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: CAIXA
                endUserAlias: H
            }
            enableUsersTo {
                pivot: false
            }
        )

        column DATA (
