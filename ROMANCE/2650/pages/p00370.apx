page 370 (
    name: Redirecionamento de Despesas
    title: Redirecionamento de Despesas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region despesas (
        name: Despesas
        type: tabform
        source {
            sqlQuery:
                ```sql
                SELECT D.IDDESPESA
                     , D.DATALANCAMENTO
                     , D.IDFECHAMENTO
                     , IDCONTACONTABIL
                     , ( SELECT C.NOMECONTA
                         FROM CONTASFINANCEIRAS C
                         WHERE C.IDCONTAFINAN = D.IDCONTACONTABIL ) CONTA
                     , IDSUBCONTACONTABIL
                     , ( SELECT S.NOMECONTA
                         FROM SUBCONTASFINANCEIRAS S
                         WHERE S.IDSUBCONTAFINAN = D.IDSUBCONTACONTABIL ) SUBCONTA
                     , D.VALOR
                     , D.OBSERVACAO
                     , ( SELECT F.SEMANA
                         FROM FECHAMENTOSSEMANAIS F
                         WHERE F.IDFECHAMENTO = D.IDFECHAMENTO ) SEMANA
                     , NULL n1
                     , null n2
                FROM DESPESAS D
                WHERE D.IDFILIAL = :P370_IDFILIAL
                  AND D.IDMOVIMENTOTOGERAL IS NULL
                  AND ( :P370_TIPOPESQUISA = 'T'
                      or ( :P370_TIPOPESQUISA = 'S' and exists ( select 1
                                                                 from fechamentossemanais f
                                                                 where f.idfechamento = d.idfechamento
                                                                   and f.idfilial     = d.idfilial
                                                                   and f.idsemana     = :P370_IDSEMANA ) )
                      or ( :P370_TIPOPESQUISA = 'P' and trunc(d.datalancamento) between to_date(:P370_DATAINICIO) and to_date(:P370_DATAFIM) ) )
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 30
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column CHECK$01 (
            reportColumnQueryId: 13
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: &nbsp;
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
        )

        column CONTA (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Conta
                alignment: center
            }
            layout {
                sequence: 4
            }
        )

        column DATALANCAMENTO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Data de Lançamento
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR hh24:MI:SS
            }
        )

        column IDCONTACONTABIL (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 11
            }
        )

        column IDDESPESA (
            reportColumnQueryId: 1
            derivedColumn: N
            type: plainTextSavesState
            heading {
                heading: ID
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
        )

        column IDFECHAMENTO (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 13
            }
        )

        column IDSUBCONTACONTABIL (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 12
            }
        )

        column N1 (
            reportColumnQueryId: 11
            derivedColumn: N
            type: selectList
            heading {
                heading: Enviar Para
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nome
                         , idfilial
                    from vw_filiais f
                    where f.ativo = 'S'
                    ```
            }
            layout {
                sequence: 9
            }
        )

        column N2 (
            reportColumnQueryId: 12
            derivedColumn: N
            type: textField
            heading {
                heading: Observação Controladoria
                alignment: center
            }
            layout {
                sequence: 10
            }
            appearance {
                width: 100
            }
            advanced {
                cellWidth: 150
            }
        )

        column OBSERVACAO (
            reportColumnQueryId: 9
            derivedColumn: N
            type: plainTextSavesState
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 7
            }
        )

        column SEMANA (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Semana do Fechamento
                alignment: center
            }
            layout {
                sequence: 8
                columnAlignment: center
            }
        )

        column SUBCONTA (
            reportColumnQueryId: 7
