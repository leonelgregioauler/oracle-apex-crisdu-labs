    pageItem P370_IDSEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(s.semana,'00')||'/'||s.ano d
                     , s.idsemana r
                from semana_dias s
                where s.ano between 2020 and 2024
                order by 2 
                ```
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P370_TIPOPESQUISA (
        type: radioGroup
        label {
            label: Pesquisar Por
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Semana;S,Período Lançamento;P
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        default {
            type: static
            staticValue: S
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button replicar (
        buttonName: REPLICAR
        label: Redirecionar Despesa
        layout {
            sequence: 20
            region: @despesas
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @despesas
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 360
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction tipo-pesquisa (
        name: tipo pesquisa
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P370_TIPOPESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P370_TIPOPESQUISA
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P370_IDSEMANA
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P370_DATAINICIO
                    P370_DATAFIM
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P370_IDSEMANA
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P370_DATAINICIO
                    P370_DATAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    process redirecionamento-de-despesa (
        name: Redirecionamento de Despesa
        type: executeCode
        editableRegion: @despesas
        source {
            plsqlCode:
                ```plsql
                declare 
                  vidsaida number;
                begin
                  --
                  if :N1 is not null then
                    --
                    select seq_idsaidasdiversas.nextval
                    into vidsaida
                    from dual;
                    --
                    insert into saidasdiversas ( idsaida 
                                               , idfilial
                                               , idfilialdest
                                               , semana
                                               , data
                                               , valortotal
                                               , descricao
                                               , idfechamento
                                               , idcontacontabil
                                               , idsubcontacontabil
                                               , observacaocontrole
                                               , tipo )
                    values ( vidsaida
                           , :P370_IDFILIAL
                           , :N1
                           , :SEMANA
                           , sysdate
                           , replace(:VALOR,'.','')
                           , :OBSERVACAO
                           , :IDFECHAMENTO
                           , :IDCONTACONTABIL
                           , :IDSUBCONTACONTABIL
                           , :N2
                           , 'O');
                    --
                    pck_anexos.prc_reutiliza_anexo( piddespesa => :IDDESPESA
                                                  , pidsaida => vidsaida );
                    --
                    delete despesas d
                    where d.iddespesa = :IDDESPESA;
                    --
                    commit;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Despesa(s) redirecionada(s) com sucesso!
        }
        advanced {
            executionMappingIdentifier: 29217188498076548
        }
        serverSideCondition {
            type: request=Value
            value: REPLICAR
        }
    )

    branch (
        name: Go To Page 370
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 370
                items: {
                    P370_IDSEMANA: &P370_IDSEMANA.
                    P370_IDFILIAL: &P370_IDFILIAL.
                    P370_TIPOPESQUISA: &P370_TIPOPESQUISA.
                    P370_DATAINICIO: &P370_DATAINICIO.
                    P370_DATAFIM: &P370_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

