page 446 (
    name: Novo Orçamento
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region novo-orçamento (
        name: Novo Orçamento
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P446_ANO (
        type: selectList
        label {
            label: Ano Base das Despesas
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ANO D, ANO R
                FROM (
                SELECT EXTRACT(YEAR FROM SYSDATE) -2 "ANO" FROM DUAL
                UNION
                SELECT EXTRACT(YEAR FROM SYSDATE) -1 "ANO" FROM DUAL
                UNION
                SELECT EXTRACT(YEAR FROM SYSDATE)  "ANO" FROM DUAL
                UNION
                SELECT EXTRACT(YEAR FROM SYSDATE) +1 "ANO" FROM DUAL
                )
                ```
        }
        layout {
            sequence: 30
            region: @novo-orçamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P446_ANO_VIGENCIA (
        type: selectList
        label {
            label: Ano Vigência das Despesas
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ANO D, ANO R
                FROM (
                SELECT EXTRACT(YEAR FROM SYSDATE) -2 "ANO" FROM DUAL
                UNION
                SELECT EXTRACT(YEAR FROM SYSDATE) -1 "ANO" FROM DUAL
                UNION
                SELECT EXTRACT(YEAR FROM SYSDATE)  "ANO" FROM DUAL
                UNION
                SELECT EXTRACT(YEAR FROM SYSDATE) +1 "ANO" FROM DUAL
                )
                ```
        }
        layout {
            sequence: 40
            region: @novo-orçamento
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P446_IDGESTAOORCAMENTARIA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @novo-orçamento
            slot: regionBody
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P446_MESFINAL (
        type: selectList
        label {
            label: Até Mês
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.mes
                     , to_number(m.numero) numero
                from meses m
                order by m.numero
                ```
        }
        layout {
            sequence: 20
            region: @novo-orçamento
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P446_MESINICIAL (
        type: selectList
        label {
            label: Mês de
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.mes
                     , to_number(m.numero) numero
                from meses m
                order by m.numero
                ```
        }
        layout {
            sequence: 10
            region: @novo-orçamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P446_ORCAMENTO_ZERADO (
        type: checkbox
        label {
            label: Gerar Orçamento Zerado
            alignment: left
        }
        settings {
            useDefaults: false
            checkedValue: S
            uncheckedValue: N
        }
        layout {
            sequence: 60
            region: @novo-orçamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        source {
            type: staticValue
            staticValue: N
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar/Voltar
        layout {
            sequence: 10
            region: @novo-orçamento
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 443
                items: {
                    P443_PERIODO_ORCAMENTO: &P446_IDGESTAOORCAMENTARIA.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button gerar (
        buttonName: GERAR
        label: Gerar
        layout {
            sequence: 10
            region: @novo-orçamento
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction popula (
        name: Popula3
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P446_ANO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: null;
                itemsToSubmit: [
                    P446_MESINICIAL
                    P446_MESFINAL
                    P446_ANO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction popula-2 (
        name: Popula1
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P446_MESINICIAL
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: null;
                itemsToSubmit: [
                    P446_MESINICIAL
                    P446_MESFINAL
                    P446_ANO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction popula-3 (
        name: Popula2
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P446_MESFINAL
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: null;
                itemsToSubmit: [
                    P446_MESINICIAL
                    P446_MESFINAL
                    P446_ANO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction valida (
        name: Valida
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @gerar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: GERAR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    process gera-orçamento (
        name: Gera Orçamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 vexiste number;
                 vidcentrocusto number := :P443_IDCENTRODECUSTO; -- usado da pagina 443 propositalmente
                begin
                  --
                  if vidcentrocusto is null then
                    --
                    raise_application_error(-20001,'Centro de Custo não informado. Verifique');
                    --
                  end if;
                  --
                  if :P446_ANO is null then
                    --
                    raise_application_error(-20001,'Ano Base não informado. Verifique');
                    --
                  end if;
                  --
                  if :P446_ANO_VIGENCIA is null then
                    --
                    raise_application_error(-20001,'Ano Vigência não informado. Verifique');
                    --
                  end if;
                  --
                  begin
                  select 1 
                    into vexiste
                    from gestaoorcamentaria w
                   where idcentrodecusto = vidcentrocusto 
                     and referente       = :P446_ANO
                     and (:P446_MESINICIAL between w.mesinicial and w.mesfinal or
                          :P446_MESFINAL   between w.mesinicial and w.mesfinal);
                  exception
                   when others then null;
                  end;
                  if nvl(vexiste,0) > 0 then
                    raise_application_error(-20002,'Já existe orçamento para os parâmetros informados!');
                  end if;
                  --
                  pck_centrodecustos_rmc.prc_geraorcamento_v2(pidcentrodecusto => vidcentrocusto,
                                                              pano             => :P446_ANO,
                                                              pidmes_inicio    => :P446_MESINICIAL,
                                                              pidmes_fim       => :P446_MESFINAL,
                                                              pusuario         => v('APP_USER'),
                                                              porcamentozerado => :P446_ORCAMENTO_ZERADO,
                                                              pano_vigencia    => :P446_ANO_VIGENCIA);
                  --
                  select max(idgestaoorcamentaria) 
                    into :P446_IDGESTAOORCAMENTARIA
                    from gestaoorcamentaria
                   where idcentrodecusto = vidcentrocusto
                     and referente       = :P446_ANO
                     and (:P446_MESINICIAL between mesinicial and mesfinal or
                          :P446_MESFINAL   between mesinicial and mesfinal);
                       
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Orçamento gerado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 563576545423582897
        }
        serverSideCondition {
            type: request=Value
            value: GERAR
        }
    )

)

