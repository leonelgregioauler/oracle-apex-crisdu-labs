page 192 (
    name: Cobrança Acumulada por Semana
    title: Cobrança Acumulada por Semana
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region imprimir-romaneio-por-semana (
        name: Imprimir Romaneio por Semana
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
    )

    pageItem P192_IDFILIAL (
        type: selectList
        label {
            label: Filial
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(pe.APELIDO, pe.nomepessoa)) display_value
                     , fe.idfilial return_value
                from filiais         fe
                   , pessoas         pe
                where fe.idpessoa = pe.idpessoa
                  and pe.ativo = 'S'
                  and fe.ativo = 'S'
                ORDER BY 1
                ```
            nullDisplayValue: " - Selecione a Filial -"
        }
        layout {
            sequence: 10
            region: @imprimir-romaneio-por-semana
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

