    button imprimir (
        buttonName: IMPRIMIR
        label: Gerar Arquivo
        layout {
            sequence: 80
            region: @imprimir-romaneio-por-semana
            slot: bottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
    )

    process fetch-row-from-impressao-romaneio (
        name: Fetch Row from IMPRESSAO_ROMANEIO
        type: autoRowFetch
        source {
            tableName: IMPRESSAO_ROMANEIO
            pkColumn: USUARIO
            pkItem: P192_USUARIO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Unable to fetch row.
        }
        advanced {
            executionMappingIdentifier: 530323728347513266
        }
        serverSideCondition {
            type: never
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                     return dbms_standard.login_user;
                  end; 
                begin 
                  :P192_USUARIO := get_pk; 
                end;
                ```
        }
        execution {
            sequence: 20
        }
        error {
            errorMessage: Unable to get primary key item value.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 530697409550574059
        }
    )

    process process-row-of-impressao-romaneio (
        name: Process Row of IMPRESSAO_ROMANEIO
        type: autoRowProcessing
        target {
            tableName: IMPRESSAO_COBRANCAACUMULADA
            pkColumn: USUARIO
            pkItem: P192_USUARIO
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        error {
            errorMessage: Unable to process row of table IMPRESSAO_COBRANCAACUMULADA
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 530716613706575273
        }
    )

