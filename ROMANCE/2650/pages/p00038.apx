page 38 (
    name: Atualizar Depósitos
    title: Atualizar Depósitos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region atualizar-valor-comprovante-depósito (
        name: Atualizar Valor/Comprovante Depósito
        type: tabform
        source {
            sqlQuery:
                ```sql
                select '<a href="javascript:document.getElementById(''P38_EXCLUIR'').value = '||IDDEPOSITODIARIOS||';confirmaexclusao();">Excluir</a>' Excluir,
                "IDDEPOSITODIARIOS",
                "IDDEPOSITODIARIOS" IDDEPOSITODIARIOS_DISPLAY,
                "DATA",
                "IDREPRESENTANTE",
                "IDCONTABANC",
                "IDPGTOFORN",
                "VALORDEPOSITO",
                "COMPROVADO",
                "NROCOMPROVANTE",
                "OBSERVACAO",
                "TIPO",
                (select distinct documento from notasfiscais nf, pagamentosfornecedores pf where pf.idnotafiscal = nf.idnotafiscal and pf.idpgtoforn = depdia.idpgtoforn ) notafiscal
                from "#OWNER#"."DEPOSITOSDIARIOS_ORIG"  depdia
                where depdia.idpgtoforn_orig is null
                  and depdia.idrepresentante  != 0
                  and nvl(depdia.comprovado,'-') != 'M'
                  and ( nvl(:P38_representante,'#') = '#' or depdia.idrepresentante = :P38_representante)
                  and exists ( select 1 
                               from pagamentosfornecedores pgf 
                               where pgf.idfornecedor = :P38_fornecedor 
                                  and pgf.idpgtoforn = depdia.idpgtoforn
                                  and ( nvl(:p38_notafiscal,'#') = '#' or pgf.idnotafiscal = :p38_notafiscal) ) 
                  
                ```
        }
        layout {
            sequence: 15
            slot: body-3
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        reportLayout {
            numberOfRows: 5000
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 5000
        }
        messages {
            whenNoDataFound: Nenhum registro encontrado.
        }
        componentAdvanced {
            stripHtml: true
        }

        column COMPROVADO (
            reportColumnQueryId: 9
            derivedColumn: N
            type: selectList
            heading {
                heading: Comprovado
            }
            lov {
                type: staticValues
                staticValues: STATIC2:Sem Comprovante;S,Cópia;C,Em Mãos;M
                displayNullValue: false
            }
            layout {
                sequence: 11
            }
        )

        column DATA (
            reportColumnQueryId: 4
            derivedColumn: N
            type: datePicker
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
            appearance {
                width: 12
            }
            sorting {
                defaultSequence: 1
            }
        )

        column EXCLUIR (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Excluir
                alignment: center
            }
            layout {
                sequence: 3
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDCONTABANC (
            reportColumnQueryId: 6
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Dados Beneficiário
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select  initcap(bb.nomebanco) || ' - <b>' || cb.agencia ||'/'||cb.conta||'</b> - <i>'||initcap(cb.beneficiario)||'</i>' display_value
                    , cb.idcontabanc return_value
                    from contasbancarias cb
                       , fornecedores    ff
                       , pessoas         pf
                       , bancos          bb
                    where cb.idfornecedor = ff.idfornecedor
                      and ff.idpessoa     = pf.idpessoa
                      and cb.idbanco      = bb.idbanco
                    ```
            }
            layout {
                sequence: 6
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDDEPOSITODIARIOS (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 1
            }
            primaryKeySource {
                type: existingTrigger
            }
            sorting {
                sortable: false
            }
        )

        column IDDEPOSITODIARIOS_DISPLAY (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column IDPGTOFORN (
            reportColumnQueryId: 7
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Fornecedor
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(p.apelido) dislpay_value
                         , pgf.idpgtoforn
                    from pagamentosfornecedores pgf
                       , fornecedores  f
                       , pessoas       p
                    where pgf.idfornecedor = f.idfornecedor
                      and f.idpessoa       = p.idpessoa
                    ```
            }
            layout {
                sequence: 7
            }
        )

        column IDREPRESENTANTE (
            reportColumnQueryId: 5
            derivedColumn: N
            type: selectList
            heading {
                heading: Representante
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(p.apelido || '( '|| c.nomecidade) ||' - '||e.sigla||' )'  display_value
                         , r.idrepresentante return_value
                    from pessoas p
                       , representantes r
                       , cidades  c
                       , estados  e
                    where p.idpessoa = r.idpessoa
                      and p.idcidade = c.idcidade
                      and c.idestado = e.idestado
                    order by 1
                    ```
                displayNullValue: false
            }
            layout {
                sequence: 5
            }
        )

        column NOTAFISCAL (
            reportColumnQueryId: 13
            derivedColumn: N
            heading {
                heading: Referente a NF
                alignment: end
            }
            layout {
                sequence: 9
            }
        )

        column NROCOMPROVANTE (
            reportColumnQueryId: 10
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 12
            }
        )

        column OBSERVACAO (
            reportColumnQueryId: 11
            derivedColumn: N
            type: textField
            heading {
                heading: Comprovante
            }
            layout {
                sequence: 13
            }
            appearance {
                width: 20
            }
        )

        column TIPO (
            reportColumnQueryId: 12
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Tipo
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select descricao display_value
                    , codigo return_value
                    from tipospagamentos
                    ```
            }
            layout {
                sequence: 8
            }
        )

        column VALORDEPOSITO (
            reportColumnQueryId: 8
            derivedColumn: N
            type: textField
            heading {
                heading: Valor Depósito
            }
            layout {
                sequence: 10
            }
            appearance {
                formatMask: 999G999G999G999G990D00
                width: 16
            }
            advanced {
                customAttributes: style="text-align:right;"
            }
        )

    )

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 25
            slot: body-1
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
            renderComponents: belowContent
        }
        headerAndFooter {
            headerText:
                ```html
                <script language="Javascript">
                function confirmaexclusao() {
                	var answer = confirm("Deseja realmente excluir o depósito?")
                	if (answer){
                		apex.submit('EXCLUIRDEP');
                	}
                        else
                        {
                        document.getElementById('P38_EXCLUIR').value = '';
                        }
                }
                </script>
                ```
        }
    )

    pageItem P38_EXCLUIR (
        type: textField
        label {
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 50
            region: @atualizar-valor-comprovante-depósito
            slot: regionBody
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 3
        }
        validation {
            maxLength: 4000
        }
        advanced {
            customAttributes: readonly="readonly"
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P38_FORNECEDOR (
        type: selectList
        label {
            label: Fornecedor
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(pe.apelido) display_value
                     , fe.idfornecedor return_value
                from fornecedores fe
                    , pessoas     pe
                where fe.idpessoa = pe.idpessoa 
                  and exists ( select 1
                               from pagamentosfornecedores pp
                                  , depositosdiarios       dd
                               where pp.idpgtoforn = dd.idpgtoforn   
                                 and pp.idfornecedor = fe.idfornecedor
                                 and dd.comprovado != 'M' )
                order by 1
                ```
            nullDisplayValue: " Selecione um fornecedor.."
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P38_NOTAFISCAL (
        type: selectList
        label {
            label: Nr Nota
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct nf.documento  display_value
                    , nf.idnotafiscal return_value 
                from depositosdiarios dd 
                  , pagamentosfornecedores pgf
                  , notasfiscais   nf
                where dd.idpgtoforn      = pgf.idpgtoforn
                 and pgf.idfornecedor   = :P38_FORNECEDOR 
                 and ( nvl(:P38_REPRESENTANTE,'#') = '#' or dd.idrepresentante = :P38_REPRESENTANTE)
                 and pgf.idnotafiscal   = nf.idnotafiscal
                ```
            nullDisplayValue: " "
        }
        cascadingLov {
            parentItems: P38_FORNECEDOR
        }
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            customAttributes: "onchange=\"window.location='f?p=&APP_ID.:38:&SESSION.::YES::P38_FORNECEDOR,P38_REPRESENTANTE,P38_NOTAFISCAL:'+P38_FORNECEDOR.options[P38_FORNECEDOR.selectedIndex].value+','+P38_REPRESENTANTE.options[P38_REPRESENTANTE.selectedIndex].value+','+this.options[this.selectedIndex].value;void(0);\""
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P38_REPRESENTANTE (
        type: selectList
        label {
            label: Representante
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(p.apelido, p.nomepessoa))||' ( '||initcap(pf.apelido)||' )' display_value
                , idrepresentante return_value
                from representantes r
                , pessoas p
                , filiais f
                , pessoas pf
                where r.idpessoa = p.idpessoa
                  and r.idfilial = f.idfilial
                  and f.idpessoa = pf.idpessoa
                  and exists ( select 1 
                               from DEPOSITOSDIARIOS_ORIG dd 
                                  , pagamentosfornecedores pgf
                               where dd.idrepresentante = r.idrepresentante
                                 and dd.idpgtoforn      = pgf.idpgtoforn
                                 and pgf.idfornecedor   = :P38_FORNECEDOR
                                 and nvl(dd.comprovado,'-') != 'M'
                                 and (nvl(trim(:p38_notafiscal),'#') = '#' or pgf.idnotafiscal = :p38_notafiscal))
                ORDER BY 1
                ```
            nullDisplayValue: Selecione um Representante
        }
        cascadingLov {
            parentItems: P38_FORNECEDOR
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            customAttributes: "onchange=\"location.href='f?p=&APP_ID.:38:&SESSION.::YES::P38_FORNECEDOR,P38_REPRESENTANTE,P38_NOTAFISCAL:'+P38_FORNECEDOR.options[P38_FORNECEDOR.selectedIndex].value+','+this.options[this.selectedIndex].value+','+P38_NOTAFISCAL.options[P38_NOTAFISCAL.selectedIndex].value;\""
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @atualizar-valor-comprovante-depósito
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 38
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Salvar
        layout {
            sequence: 30
            region: @atualizar-valor-comprovante-depósito
            slot: CHANGE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process apagaitem (
        name: APAGAITEM
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  delete from depositosdiarios
                  where iddepositodiarios = :P38_EXCLUIR;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Depósito excluido com sucesso!
        }
        error {
            errorMessage: Problemas ao excluir o depósito!
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 178521834889289165
        }
        serverSideCondition {
            type: request=Value
            value: EXCLUIRDEP
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @atualizar-valor-comprovante-depósito
        target {
            tableName: DEPOSITOSDIARIOS_ORIG
            pkColumn: IDDEPOSITODIARIOS
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# depósitos(s) atualizado(s).
        }
        error {
            errorMessage: Unable to process update.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 181488859611869115
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 38
                items: {
                    P38_FORNECEDOR: "P38_FORNECEDOR.options[P38_FORNECEDOR.selectedIndex].value"
                    P38_REPRESENTANTE: "P38_REPRESENTANTE.options[P38_REPRESENTANTE.selectedIndex].value"
                    P38_NOTAFISCAL: "P38_NOTAFISCAL.options[P38_NOTAFISCAL.selectedIndex].value"
                }
                successMessage: false
            }
            saveStateBeforeBranching: true
        }
        serverSideCondition {
            type: request=Value
            value: FILTRAR
        }
    )

)

