    region indicativo-trimestral (
        name: Indicativo Trimestral
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomeprodutoestoque(e.idestoquefilial) produto
                     , pck_romance.fnc_nomefilial(e.idfilial) empresa
                     , to_char(n.dataacerto,'Q') trimestre
                     , nvl(sum(it.quantidade-it.qtddevolvida),0) qtdvendido
                     , nvl(sum((it.quantidade-it.qtddevolvida)*e.vlrvenda)*f.fatorconversao,0) valorvendido
                from estoquefilial e
                   , notasvendas n
                   , itensnotavenda it
                   , vw_filiais f
                where n.idfilial            = e.idfilial
                  and f.idfilial            = e.idfilial
                  and it.idestoquefil       = e.idestoquefilial
                  and it.idnotavenda    	  = n.idnotavenda
                  and n.idsituacaonotavenda = 4
                  and f.tipofilial          = 'D'
                  and f.ativo               = 'S'
                  and f.idgrupo             = 5
                  and ( :P225_IDFILIAL is null or e.idfilial = :P225_IDFILIAL )
                  and extract ( year from n.dataacerto ) = :P225_ANO
                  and ( :P225_TRIMESTRE = 5 or to_char(n.dataacerto,'Q') = :P225_TRIMESTRE )
                group by e.idestoquefilial , e.idfilial , to_char(n.dataacerto,'Q') , f.fatorconversao
                order by 4
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
