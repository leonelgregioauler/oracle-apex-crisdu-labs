page 225 (
    name: Indicativo de Produtos
    title: Indicativo de Produtos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region indicativo-anual (
        name: Indicativo Anual
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomeprodutoestoque(e.idestoquefilial) produto
                     , pck_romance.fnc_nomefilial(e.idfilial) empresa
                     , nvl(sum(it.quantidade-it.qtddevolvida),0) qtdvendido
                     , nvl(sum((it.quantidade-it.qtddevolvida)*e.vlrvenda)*f.fatorconversao,0) valorvendido
                from estoquefilial e
                   , notasvendas n
                   , itensnotavenda it
                   , vw_filiais f
                where n.idfilial            = e.idfilial
                  and f.idfilial            = e.idfilial
                  and it.idestoquefil       = e.idestoquefilial
                  and it.idnotavenda    	= n.idnotavenda
                  and n.idsituacaonotavenda = 4
                  and f.tipofilial          = 'D'
                  and f.ativo               = 'S'
                  and f.idgrupo             = 5
                  and extract ( year from n.dataacerto ) = :P225_ANO
                  and ( :P225_IDFILIAL is null or f.idfilial = :P225_IDFILIAL )
                group by e.idestoquefilial , e.idfilial , f.fatorconversao
                order by 3 desc
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P225_TIPOPESQUISA
            value: A
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 4163101436442002543
        }

        column EMPRESA (
            type: plainText
            heading {
                heading: Empresa
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

