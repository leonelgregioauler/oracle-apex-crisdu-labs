    pageItem P225_ANO (
        type: textField
        label {
            label: Ano
            alignment: left
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 5
        }
        default {
            type: expression
            plsqlExpression: to_char(sysdate,'RRRR')
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P225_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idfilial
                from vw_filiais f
                where f.idgrupo = 5
                  and f.ativo = 'S'
                  and f.tipofilial = 'D'
                order by 1
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P225_MES (
        type: selectList
        label {
            label: Mês
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.mes
                     , m.numero
                from meses m
                order by 2 
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P225_TIPOPESQUISA (
        type: radioGroup
        label {
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC:Mensal;M,Trimestral;T,Anual;A
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P225_TRIMESTRE (
        type: radioGroup
        label {
            label: Trimestre
            alignment: left
        }
        settings {
            noOfCols: 5
        }
        lov {
            type: staticValues
            staticValues: STATIC2:1;1,2;2,3;3,4;4,Todos;5
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: 5
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction anual (
        name: Anual
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P225_TIPOPESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P225_TIPOPESQUISA
            value: A
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P225_ANO
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P225_ANO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction mensal (
        name: Mensal
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P225_TIPOPESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P225_TIPOPESQUISA
            value: M
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P225_MES
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P225_MES
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction trimestral (
        name: Trimestral
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P225_TIPOPESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P225_TIPOPESQUISA
            value: T
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P225_TRIMESTRE
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P225_TRIMESTRE
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 225
                items: {
                    P225_TIPOPESQUISA: &P225_TIPOPESQUISA.
                    P225_TRIMESTRE: &P225_TRIMESTRE.
                    P225_MES: &P225_MES.
                    P225_ANO: &P225_ANO.
                    P225_IDFILIAL: &P225_IDFILIAL.
                }
                action: resetPagination
            }
        }
    )

)

