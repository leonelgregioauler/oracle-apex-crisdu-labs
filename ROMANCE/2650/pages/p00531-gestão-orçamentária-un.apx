page 531 (
    name: Gestão Orçamentária UN
    alias: GESTÃO-ORÇAMENTÁRIA-UN
    title: Gestão Orçamentária UN
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: <font color="red"><b>Para criar novo orçamento, todos os campos abaixo devem ser preenchidos e clicar em "Criar Orçamento". Para editar, basca clicar no link da listagem.</b></font>
        }
    )

    region gestão-orçamentária-det (
        name: Gestão Orçamentária Det
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                return q'~
                select *
                 from (
                        select --gruponegocio,
                               --unidadenegocio,
                               v.idgestaoorcamentariaun, 
                               v.conta, 
                               v.subconta, 
                               nvl(v.proposta,0) proposta, 
                               nvl(v.contraproposta,0) contraproposta, 
                               nvl(v.orcado,0) orcado,
                               v.mes,
                               v.idcomposicaoun_orc,
                               v.indicador
                          from vw_gestaoorcamentaria_un v
                         where v.anoorcamento       = :P531_PERIODO_ORCAMENTO
                           and v.idgruponegocio     = :P531_IDGRUPONEGOCIO
                           and v.idunidadedenegocio = :P531_IDUNIDADEDENEGOCIO
                           and v.tipoorcamento      = :P531_TIPOORCAMENTO
                         order by v.numero  ) w
                  PIVOT ( SUM(PROPOSTA) ANT,
                          SUM(CONTRAPROPOSTA) PROP,
                          SUM(ORCADO) ORC
                         FOR mes 
                           IN ('JANEIRO','FEVEREIRO','MARCO','ABRIL','MAIO','JUNHO','JULHO','AGOSTO','SETEMBRO','OUTUBRO','NOVEMBRO','DEZEMBRO')
                         )
                ~';
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            showNullValuesAs: 0
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado.
        }
        advanced {
            savedReportMappingIdentifier: 2924656614175556701
        }

