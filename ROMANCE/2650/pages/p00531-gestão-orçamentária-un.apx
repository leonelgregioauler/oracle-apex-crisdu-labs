    dynamicAction mostradet (
        name: MostraDet
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @gestão-orçamentária-det
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P531_ANO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    
                    :P531_MESINI := :P531_MESINICIAL;
                    :P531_MESFIM := :P531_MESFINAL;
                    
                    end;
                    ```
                itemsToSubmit: [
                    P531_ANO
                    P531_MESINICIAL
                    P531_MESFINAL
                ]
                itemsToReturn: [
                    P531_MESINI
                    P531_MESFIM
                    P531_ANOXX
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new-2 (
        name: New_2
        execution {
            sequence: 70
        }
        when {
            selectionType: items
            items: P531_TIPOORCAMENTO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: null;
                itemsToSubmit: [
                    P531_IDGRUPONEGOCIO
                    P531_IDUNIDADEDENEGOCIO
                    P531_TIPOORCAMENTO
                ]
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-hide (
            action: hide
            affectedElements {
                selectionType: button
                button: @criar-orcamento
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNotNull
                item: P531_PERIODO_ORCAMENTO
            }
        )

    )

    dynamicAction new-3 (
        name: New_1
        execution {
            sequence: 80
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action native-set-value (
            action: setValue
            settings {
                value: S
            }
            affectedElements {
                selectionType: items
                items: P531_FILTRAR
            }
            execution {
                sequence: 10
            }
        )

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    validation valida-filtro (
        name: Valida Filtro
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 
                  from dual 
                 where :P531_PERIODO_ORCAMENTO  is null and 
                       :P531_IDGRUPONEGOCIO     is null and 
                       :P531_IDUNIDADEDENEGOCIO is null and 
                       :P531_TIPOORCAMENTO      is null
                ```
        }
        error {
            errorMessage: Informa ao menos um filtro.
        }
    )

)

