    region listaorcamentos (
        name: ListaOrcamentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct g.idgruponegocio
                           , n.descricao grupo
                           , g.idunidadedenegocio
                           , u.nome unidade
                           , g.anoorcamento
                           , g.anoreferencia
                           , g.tipoclassificacao
                           , g.tipoorcamento
                           , decode(g.tipoorcamento,'A','Analitico','Sintetico') orcamento
                           --, decode(g.tipoclassificacao,'A','Ano','Base Zero') classif
                           , case when g.tipoclassificacao = 'A' then 'Ano Com Valor'
                                  when g.tipoclassificacao = 'B' then 'Padrao Base Zero'
                                  when g.tipoclassificacao = 'C' then 'Ano Base Zero'
                                  else 'Invalido'
                             end classif
                           , g.usuario
                           , g.mesinicial
                           , g.mesfinal
                           , trunc(g.dataorcamento) datacriacao
                           , null editar
                        from gestaoorcamentariaun g
                           , gruposnegocios       n
                           , unidadesdenegocios   u
                       where g.idgruponegocio = n.idgruponegocio
                         and g.idunidadedenegocio = u.idunidadedenegocio
                         and g.idgruponegocio = :P531_IDGRUPONEGOCIO
                         and (:P531_IDUNIDADEDENEGOCIO = -1    or g.idunidadedenegocio = :P531_IDUNIDADEDENEGOCIO)
                         and (:P531_TIPOORCAMENTO      is null or g.tipoorcamento = :P531_TIPOORCAMENTO)
                         and (:P531_PERIODO_ORCAMENTO  is null or g.anoorcamento = :P531_PERIODO_ORCAMENTO)
                
                ```
            pageItemsToSubmit: [
                P531_IDGRUPONEGOCIO
                P531_IDUNIDADEDENEGOCIO
                P531_TIPOORCAMENTO
                P531_PERIODO_ORCAMENTO
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
