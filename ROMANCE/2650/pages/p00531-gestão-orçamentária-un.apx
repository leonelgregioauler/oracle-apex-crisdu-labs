                ```sql
                select nome d
                     , idunidadedenegocio r
                  from unidadesdenegocios
                 where idgruponegocio = :P531_IDGRUPONEGOCIO
                   and ativo = 'S'
                 order by 1
                ```
            nullDisplayValue: - Todos -
            nullReturnValue: -1
