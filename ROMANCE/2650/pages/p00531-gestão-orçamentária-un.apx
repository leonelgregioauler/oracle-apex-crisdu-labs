        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select descricao d
                     , idgruponegocio r
                  from gruposnegocios
                 order by 1
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
