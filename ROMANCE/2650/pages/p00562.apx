    region títulos-provisão-cobrança-dda (
        name: Títulos — Provisão / Cobrança DDA
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pagforn.idpgtoforn,
                    ( select fpg.descricao from formaspagamentos fpg
                       where fpg.idformapagamento = pagforn.tipopagamento ) as tipo_pagamento,
                    to_char(pagforn.dtvencimento,'DD/MM/RRRR') as dtvencimento,
                    ( select pck_romance.fnc_nomefilial(nf.idfilialdestino) from notasfiscais nf
                       where nf.idnotafiscal = pagforn.idnotafiscal ) as destino,
                    nvl(pck_romance.fnc_nomefornecedor(pagforn.idfornecedor),'-') as fornecedor,
                    ( select rf.cnpj from razoessociaisfornec rf, notasfiscais nf
                       where nf.idnotafiscal = pagforn.idnotafiscal
                         and rf.idrazaosocialforn = nf.idrazaosocialfornemit ) as cnpj_fornecedor,
                    pagforn.valorpagar as valorpagar,
                    ( select nf.documento from notasfiscais nf
                       where nf.idnotafiscal = pagforn.idnotafiscal ) as nrnf,
                    nvl( ( select rr.cnpj from razoessociaisfiliais rr
                            where rr.idrazaosocialfilial = ( select nf.idrazaosocialfildestino from notasfiscais nf
                                                               where nf.idnotafiscal = pagforn.idnotafiscal ) ),
                         ( select e.cnpj from razoessociaisfornec e
                            where e.idrazaosocialforn = ( select nf.idrazaosocialforndest from notasfiscais nf
                                                            where nf.idnotafiscal = pagforn.idnotafiscal ) ) ) as cnpj_destino,
                    nvl( ( select pck_romance.fnc_nomecontafinan(v.idcontafinanceira) from vencimentos v
                            where v.idvencimento = pagforn.idvencimento ), 'Sem Conta') as conta,
                    nvl( ( select pck_romance.fnc_nomesubcontafinan(v.idsubcontafinanceira) from vencimentos v
                            where v.idvencimento = pagforn.idvencimento ), 'Sem Sub Conta') as sub_conta,
                    pagforn.observacao as observacao,
                    cast(null as number) as idcentrodecusto,
                    cast(null as number) as idunidadedenegocio,
                    ( select fp.status from fila_envio_provisao fp
                       where fp.idpgtoforn = pagforn.idpgtoforn
                         and fp.dt_solicitacao = ( select max(fp2.dt_solicitacao) from fila_envio_provisao fp2
                                                    where fp2.idpgtoforn = pagforn.idpgtoforn )
                         and rownum = 1 ) as situacao,
                    ( select to_char(max(fp.dt_processado),'DD/MM/RRRR HH24:MI') from fila_envio_provisao fp
                       where fp.idpgtoforn = pagforn.idpgtoforn and fp.status = 'ENVIADO' ) as dt_ultimo_envio
                from pagamentosfornecedores pagforn
                where pagforn.idcheque is null
                  and pagforn.tipopagamento is not null
                  and exists ( select 1 from formaspagamentos fpg
                                where fpg.idformapagamento = pagforn.tipopagamento
                                  and fpg.descricao in ('Provisao','Cobrança DDA') )
                  and ( :P562_TIPO_PAGAMENTO is null
                        or exists ( select 1 from formaspagamentos fpg
                                     where fpg.idformapagamento = pagforn.tipopagamento
                                       and fpg.descricao = :P562_TIPO_PAGAMENTO ) )
                  and trunc(pagforn.dtvencimento) between
                        nvl(to_date(:P562_DT_INI,'DD/MM/RRRR'), trunc(sysdate,'MM'))
                    and nvl(to_date(:P562_DT_FIM,'DD/MM/RRRR'), last_day(sysdate))
                order by tipo_pagamento, pagforn.dtvencimento
                ```
            pageItemsToSubmit: [
                P562_TIPO_PAGAMENTO
                P562_DT_INI
                P562_DT_FIM
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        componentAppearance {
            showNullValuesAs: -
            selectFirstRow: false
        }
        messages {
            whenNoDataFound: - Nenhum registro encontrado -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        enableUsersTo {
            savePublicReport: true
            flashback: false
            defineChartView: false
        }
        download {
            formats: [
                csv
                excel
            ]
            sendAsEmail: false
        }
        advanced {
            savedReportMappingIdentifier: 5620000000000000200
        }

