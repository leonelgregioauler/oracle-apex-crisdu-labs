page 562 (
    name: Envio de Provisão / Cobrança DDA
    title: Envio de Provisão / Cobrança DDA
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }
    help {
        helpText: Selecione as linhas (coluna da esquerda), escolha o Centro de Custo e/ou a Unidade de Negócio de cada uma (de onde os e-mails serão buscados) e clique em "Agendar Envio". O disparo é feito pelo fluxo do N8N.
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region histórico-de-envios (
        name: Histórico de Envios
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id, lote, idpgtoforn, tipo_pagamento, email, status, tentativas
                     , to_char(dt_solicitacao,'DD/MM/RRRR HH24:MI') dt_solicitacao
                     , to_char(dt_processado, 'DD/MM/RRRR HH24:MI') dt_processado
                     , usuario_apex, obs
                from fila_envio_provisao
                order by dt_solicitacao desc
                fetch first 200 rows only
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
