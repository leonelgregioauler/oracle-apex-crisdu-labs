    dynamicAction coletar-selecao-e-agendar (
        name: Coletar Selecao e Agendar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @agendar-envio
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var $root = apex.jQuery(".a-IG").first().closest(".js-apex-region");
                    if (!$root.length) { $root = apex.jQuery(".a-IG").first().closest("[id]"); }
                    var region = apex.region($root.attr("id"));
                    if (!region) { apex.message.alert("Grade nao encontrada."); return; }
                    var recs = region.call("getSelectedRecords") || [];
                    if (recs.length === 0) {
                        apex.message.alert("Selecione ao menos uma linha.");
                        return;
                    }
                    var model = region.call("getViews","grid").model;
                    var sc = function (v) {
                        if (v === null || v === undefined) { return null; }
                        if (typeof v === "object") { v = (v.v !== undefined ? v.v : v.value); }
                        return (v === null || v === undefined || v === "") ? null : String(v);
                    };
                    var out = [];
                    recs.forEach(function(rec){
                        out.push({
                            id: sc(model.getValue(rec, "IDPGTOFORN")),
                            cc: sc(model.getValue(rec, "IDCENTRODECUSTO")),
                            un: sc(model.getValue(rec, "IDUNIDADEDENEGOCIO"))
                        });
                    });
                    apex.item("P562_SELECAO").setValue(JSON.stringify({ linhas: out }));
                    apex.page.submit({ request: "AGENDAR_ENVIO", showWait: true });
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process inserir-na-fila-de-envio (
        name: Inserir na Fila de Envio
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_count number;
                    l_lote  number;
                    l_total number := 0;
                    l_skip  number := 0;
                    l_idpg  number;
                    l_ccv   number;
                    l_unv   number;
                    l_tipo  varchar2(60);
                begin
                    apex_json.parse(:P562_SELECAO);
                    l_count := apex_json.get_count(p_path => 'linhas');
                    if l_count is null or l_count = 0 then
                        apex_error.add_error(
                            p_message          => 'Nenhuma linha selecionada.',
                            p_display_location => apex_error.c_inline_in_notification );
                        return;
                    end if;
                    l_lote := seq_lote_envio_provisao.nextval;
                    for i in 1..l_count loop
                        l_idpg := to_number(apex_json.get_varchar2(p_path => 'linhas[%d].id', p0 => i));
                        l_ccv  := to_number(apex_json.get_varchar2(p_path => 'linhas[%d].cc', p0 => i));
                        l_unv  := to_number(apex_json.get_varchar2(p_path => 'linhas[%d].un', p0 => i));
                        if l_ccv is null and l_unv is null then
                            l_skip := l_skip + 1;
                            continue;
                        end if;
                        begin
                            select fpg.descricao into l_tipo
                            from pagamentosfornecedores p, formaspagamentos fpg
                            where p.idpgtoforn = l_idpg
                              and fpg.idformapagamento = p.tipopagamento;
                        exception when no_data_found then l_tipo := null; end;
                        for e in ( select email from emailscentroscustos
                                    where idcentrodecusto = l_ccv and ativo = 'S'
                                   union
                                   select email from emailsunidadesnegocios
                                    where idunidadedenegocio = l_unv and ativo = 'S' ) loop
                            insert into fila_envio_provisao
                                ( lote, idpgtoforn, tipo_pagamento, idcentrodecusto,
                                  idunidadedenegocio, email, status, usuario_apex )
                            values
                                ( l_lote, l_idpg, l_tipo, l_ccv,
                                  l_unv, e.email, 'PENDENTE', :APP_USER );
                            l_total := l_total + 1;
                        end loop;
                    end loop;
                    commit;
                    apex_application.g_print_success_message :=
                        l_total || ' destinatario(s) adicionados a fila (lote ' || l_lote || ').';
                    if l_skip > 0 then
                        apex_application.g_print_success_message :=
                            apex_application.g_print_success_message ||
                            ' ' || l_skip || ' linha(s) ignorada(s) por nao ter CC/UN selecionado.';
                    end if;
                exception
                    when others then
                        rollback;
                        apex_error.add_error(
                            p_message          => 'Erro ao agendar envio: ' || sqlerrm,
                            p_display_location => apex_error.c_inline_in_notification );
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 5620000000000000070
        }
        serverSideCondition {
            type: request=Value
            value: AGENDAR_ENVIO
        }
    )

    branch (
        name: Recarregar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 562
                items: {
                    P562_TIPO_PAGAMENTO: &P562_TIPO_PAGAMENTO.
                    P562_DT_INI: &P562_DT_INI.
                    P562_DT_FIM: &P562_DT_FIM.
                }
                action: resetPagination
            }
        }
    )

