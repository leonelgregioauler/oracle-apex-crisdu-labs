page 349 (
    name: Cadastro de Grupo de Negócio
    title: Cadastro de Grupo de Negócio
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }

    region cadastro-de-grupo-de-negócio (
        name: Cadastro de Grupo de Negócio
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P349_CODIGO (
        type: textField
        label {
            label: Código
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @cadastro-de-grupo-de-negócio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 5
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P349_CONTABILIZARBI (
        type: selectList
        label {
            label: Contabilizar BI ?
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @cadastro-de-grupo-de-negócio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P349_DESCRICAO (
        type: textField
        label {
            label: Grupo de Negócio
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @cadastro-de-grupo-de-negócio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P349_IDGRUPONEGOCIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @cadastro-de-grupo-de-negócio
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P349_IDSEGMENTONEGOCIO (
        type: selectList
        label {
            label: Segmento
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idsegmentonegocio
                from segmentosnegocios
                order by 1
                ```
        }
        layout {
            sequence: 30
            region: @cadastro-de-grupo-de-negócio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P349_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @cadastro-de-grupo-de-negócio
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button criar (
        buttonName: CRIAR
        label: Criar
        layout {
            sequence: 10
            region: @cadastro-de-grupo-de-negócio
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P349_IDGRUPONEGOCIO
        }
    )

    button salvar (
        buttonName: SALVAR
        label: Salvar
        layout {
            sequence: 20
            region: @cadastro-de-grupo-de-negócio
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P349_IDGRUPONEGOCIO
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 30
            region: @cadastro-de-grupo-de-negócio
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process consulta-dml-em-grupos-de-negocios (
        name: Consulta DML em Grupos de Negocios
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  PCK_CADASTROS_RMC.PRC_GRUPOSNEGOCIOS( PIDGRUPONEGOCIO => :P349_IDGRUPONEGOCIO,
                                                        PDESCRICAO => :P349_DESCRICAO,
                                                        PIDSEGMENTONEGOCIO => :P349_IDSEGMENTONEGOCIO,
                                                        PCODIGO => :P349_CODIGO,
                                                        PCONTABILIZARBI => :P349_CONTABILIZARBI,
                                                        PMD5 => :P349_MD5,
                                                        POPERACAO_DML => 'S');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 6174051452480439
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P349_IDGRUPONEGOCIO
        }
    )

    process processo-dml-em-grupos-de-negocios (
        name: Processo DML em Grupos de Negocios
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  --
                  if v('REQUEST') = 'SALVAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'CRIAR' then
                    voperacao_dml := 'I';
                  end if;
                  --
                  PCK_CADASTROS_RMC.PRC_GRUPOSNEGOCIOS( PIDGRUPONEGOCIO => :P349_IDGRUPONEGOCIO,
                                                        PDESCRICAO => :P349_DESCRICAO,
                                                        PIDSEGMENTONEGOCIO => :P349_IDSEGMENTONEGOCIO,
                                                        PCODIGO => :P349_CODIGO,
                                                        PCONTABILIZARBI => :P349_CONTABILIZARBI,
                                                        PMD5 => :P349_MD5,
                                                        POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Operação realizada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 12339911864571338
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('CRIAR','SALVAR')
                ```
        }
    )

    branch (
        name: Go To Page 348
        execution {
            sequence: 30
        }
        behavior {
            target: {
                page: 348
                action: resetPagination
            }
        }
    )

    branch (
        name: Go To Page 349
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 349
                items: {
                    P349_IDGRUPONEGOCIO: &P349_IDGRUPONEGOCIO.
                }
                clearCache: 349
                action: resetPagination
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('CRIAR','SALVAR')
        }
    )

)

