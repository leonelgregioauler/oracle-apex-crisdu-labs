            type: plainText
            heading {
                heading: Bairro
                alignment: center
            }
            layout {
                sequence: 8
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: BAIRRO
                endUserAlias: H
            }
            enableUsersTo {
                pivot: false
            }
        )

