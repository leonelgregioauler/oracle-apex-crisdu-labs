    button create (
        buttonName: CREATE
        label: Novo Cadastro
        layout {
            sequence: 30
            region: @lista-de-contatos-do-site
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 119
                clearCache: 119
            }
            warnOnUnsavedChanges: doNotCheck
