page 118 (
    name: Lista de Contatos do Site
    title: Lista de Contatos do Site
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region lista-de-contatos-do-site (
        name: Lista de Contatos do Site
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idcontrolecontatossite
                     , nomecompleto
                     , cpf
                     , datanascimento
                     , rua
                     , nr
                     , complemento
                     , bairro
                     , pck_romance.fnc_nomecidade(idcidade) "Cidade"
                     , cep
                     , fone
                     , fone2
                     , email
                     , msn
                     , mensagem
                     , observacao
                     , decode(situacao, 'P','Pendente','E','Encaminhado','R','Respondido','Z','Enc/Resp','S','Restrições') "Situação"
                     , datacadastro
                     , pck_romance.fnc_nomefilial(idfilial) "Filial"
                     , pck_romance.fnc_nomerepresentante(idrepresentante) "Representante"
                     , dataliberadofilial "Dt Liberado Filial"
                     , datapassadorepres  "Dt Liberado Repres"
                from controlecontatossite ec
                order by 1 desc
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 119
                items: {
                    P119_IDCONTROLECONTATOSSITE: #IDCONTROLECONTATOSSITE#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Dados não encontrados.
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

