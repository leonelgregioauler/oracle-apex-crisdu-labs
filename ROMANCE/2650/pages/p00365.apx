page 365 (
    name: Pagamento de Faturas V3
    title: Pagamento de Faturas V3
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 60%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_pagar(pid)
            {
              document.getElementById("P365_IDEXTRATO").value = pid;
                
              var answer = confirm("Confirma o Pagamento desta Fatura?")
              if (answer)
              {
                apex.submit('PAGAR');
              }  
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region faturas-a-pagar (
        name: Faturas a Pagar
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomepessoa(c.idpessoa) destino
                     , pck_cadastros_rmc.fnc_retornacontabancaria(c.idcontabanc) conta
                     , initcap(c.beneficiario) beneficiario  
                     , e.datamovimento vencimento
                     , e.valormovimento saldo
                     , c.idcontabanc
                     , '<a href="javascript:fnc_pagar('||e.idextratocontabancaria||')" ><img src="#APP_IMAGES#ok.png"  border="0"></a>' efetuarpagamento
                from extratoscontasbancarias e
                   , contasbancarias c
                where e.idcontabancaria = c.idcontabanc
                  and e.valormovimento < 0
                  and not exists ( select 1
                                   from ordensdepositos o
                                   where o.idcontabancaria = e.idcontabancaria
                                     and o.identificado    = e.identificado
                                     and o.valor           = ( e.valormovimento * -1 ) )
                  and exists ( select 1
                               from extratoscontasbancarias ex
                               where ex.idextratocontabancaria = e.idextratocontabancaria_orig
                                 and ex.idvencimento           = e.idvencimento 
                                 and ex.idcontabancaria        = :P365_IDCONTA )
                order by 4 
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma fatura para pagar localizada.
        }
        advanced {
            savedReportMappingIdentifier: 18128268928050425
        }

        column BENEFICIARIO (
            type: plainText
            heading {
                heading: Beneficiário
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column CONTA (
            type: plainText
            heading {
                heading: Conta
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column DESTINO (
            type: plainText
            heading {
                heading: Destino
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column EFETUARPAGAMENTO (
            type: plainText
            heading {
                heading: Efetuar Pagamento
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDCONTABANC (
            type: hidden
            heading {
                heading: Idcontabanc
            }
            layout {
                sequence: 60
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
            security {
                escapeSpecialChars: false
            }
        )

        column SALDO (
            type: plainText
            heading {
                heading: Saldo
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column VENCIMENTO (
            type: plainText
            heading {
                heading: Vencimento
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 203088 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn BENEFICIARIO (
                sequence: 3
            )

            displayColumn CONTA (
                sequence: 2
            )

            displayColumn DESTINO (
                sequence: 1
            )

            displayColumn EFETUARPAGAMENTO (
                sequence: 7
            )

            displayColumn IDCONTABANC (
                sequence: 6
            )

            displayColumn SALDO (
                sequence: 5
            )

            displayColumn VENCIMENTO (
                sequence: 4
            )

        )

    )

    pageItem P365_IDCONTA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @faturas-a-pagar
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P365_IDEXTRATO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @faturas-a-pagar
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    process realiza-pagamento-de-fatura (
        name: Realiza pagamento de Fatura
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_financeiro_rmc.prc_pagafaturav3(pidextratocontabancaria => :P365_IDEXTRATO);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Pagamento realizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 18129271740050435
        }
        serverSideCondition {
            type: request=Value
            value: PAGAR
        }
    )

)

