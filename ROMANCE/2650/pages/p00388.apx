    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar Fatura
        layout {
            sequence: 20
            region: @rateio-de-fatura
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button criar (
        buttonName: CRIAR
        label: Criar
        layout {
            sequence: 50
            region: @rateio-de-fatura
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P388_IDRATEIONOTAFISCAL
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 30
            region: @rateio-de-fatura
            slot: help
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: definedByDynamicAction
            executeValidations: false
            databaseAction: delete
        }
        serverSideCondition {
            type: never
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 10
            region: @rateio-de-fatura
            slot: help
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: definedByDynamicAction
            databaseAction: delete
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.notasfiscais nf 
                   , roman.rateiosnotasfiscais rt
                where nf.idnotafiscal = rt.idnotafiscal
                 and nf.situacao = 'U'
                 and nf.tiponota = 'R'
                 and nf.idnotafiscal  = :P388_IDNOTAFISCAL
                 and rt.datavencimento = :P388_DATAVENCIMENTO
                 and not exists ( select 1
                                  from roman.pagamentosfornecedores pf
                                     , roman.vencimentos v 
                                  where v.idvencimento = pf.idvencimento
                                    and pf.idnotafiscal = nf.idnotafiscal
                                    and v.datavencimento = rt.datavencimento
                                    and pf.databaixa is not null )
                union
                select 1
                from roman.notasfiscais n 
                where n.tiponota != 'R'
                 and n.idnotafiscal = :P388_IDNOTAFISCAL;
                ```
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 60
            region: @rateio-de-fatura
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.notasfiscais nf 
                   , roman.rateiosnotasfiscais rt
                where nf.idnotafiscal = rt.idnotafiscal
                 and nf.situacao = 'U'
                 and nf.tiponota = 'R'
                 and nf.idnotafiscal  = :P388_IDNOTAFISCAL
                 and rt.datavencimento = :P388_DATAVENCIMENTO
                 and not exists ( select 1
                                  from roman.pagamentosfornecedores pf
                                     , roman.vencimentos v 
                                  where v.idvencimento = pf.idvencimento
                                    and pf.idnotafiscal = nf.idnotafiscal
                                    and v.datavencimento = rt.datavencimento
                                    and pf.databaixa is not null )
                union
                select 1
                from roman.notasfiscais n 
                where n.tiponota != 'R'
                 and n.idnotafiscal = :P388_IDNOTAFISCAL;
                ```
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 40
            region: @rateio-de-fatura
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 27
                items: {
                    P27_IDNOTAFISCAL: &P388_IDNOTAFISCAL.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction confirma (
        name: Confirma
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @delete
        }

        action native-confirm (
            action: confirm
            settings {
                message: Confirma exclusão deste item do rateio?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: DELETE
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @excluir
        }

        action native-confirm (
            action: confirm
            settings {
                message: Confirma exclusão deste item do rateio?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: EXCLUIR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    validation valida-alteração-de-informações (
        name: Valida Alteração de informações
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.fechamentomovimentacoes fm
                   , roman.pagamentosfornecedores  pf
                   , roman.vencimentos v 
                where fm.datafechamento  = pf.databaixa
                  and fm.idcontabancaria = pf.idcontapagamento
                  and pf.idvencimento    = v.idvencimento
                  and v.datavencimento   = :P388_DATAVENCIMENTO
                  and pf.idnotafiscal    = :P388_IDNOTAFISCAL
                ```
        }
        error {
            errorMessage: Fechamento já encerrado para este dia! Entre em contato com o responsável pelo fechamento.
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') IN ('CREATE','SAVE','EXCLUIR','DELETE')
        }
    )

    process atualiza-rateios (
        name: Atualiza Rateios
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_notasfiscais_rmc.prc_atualiza_rateios(pidnotafiscal => :P388_IDNOTAFISCAL);
                  --
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Fatura atualizada
        }
        advanced {
            executionMappingIdentifier: 4984646330386827937
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'ATUALIZAR'
        }
    )

    process fetch-row-from-rateiosnotasfiscais (
        name: Fetch Row from RATEIOSNOTASFISCAIS
        type: autoRowFetch
        source {
            tableName: RATEIOSNOTASFISCAIS
            pkColumn: IDRATEIONOTAFISCAL
            pkItem: P388_IDRATEIONOTAFISCAL
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 4986521315593178611
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P388_IDRATEIONOTAFISCAL is null then
                        select "#OWNER#"."SEQ_IDRATEIONOTAFISCAL".nextval
                          into :P388_IDRATEIONOTAFISCAL
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 4986521731235178611
        }
    )

    process process-row-of-rateiosnotasfiscais (
        name: Process Row of RATEIOSNOTASFISCAIS
        type: autoRowProcessing
        target {
            tableName: RATEIOSNOTASFISCAIS
            pkColumn: IDRATEIONOTAFISCAL
            pkItem: P388_IDRATEIONOTAFISCAL
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada
        }
        advanced {
            executionMappingIdentifier: 4986522190835178612
        }
    )

    branch (
        name: Go to Page 388
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 388
                items: {
                    P388_IDRATEIONOTAFISCAL: &P388_IDRATEIONOTAFISCAL.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('SAVE','CRIAR')
        }
    )

    branch (
        name: Go to Page 388
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 388
                items: {
                    P388_IDRATEIONOTAFISCAL:
                    P388_IDLANCAMENTODIVERSO:
                    P388_IDNOTAFISCAL: &P388_IDNOTAFISCAL.
                    P388_IDFORNECEDOR: &P388_IDFORNECEDOR.
                    P388_IDRAZAOSOCIALFORNECEDOR: &P388_IDRAZAOSOCIALFORNECEDOR.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @excluir
        }
    )

)

