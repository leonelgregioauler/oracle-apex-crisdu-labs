    pageItem P388_IDMATRIZDESPESA (
        type: selectList
        label {
            label: Matriz
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.centrodecusto||' - '||m.contafinanceira||' / '||m.subcontafinanceira||' - Tipo: '||m.desctiporegra a
                     , m.idmatrizregra
                from vw_matrizregrasdespesas m
                where m.idfornecedor = :P388_IDFORNECEDOR
                  and m.idfilial     = :P388_IDFILIALDESTINO
                  and m.ativo        = 'S'
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: [
                P388_IDFORNECEDOR
                P388_IDFILIALDESTINO
            ]
        }
        layout {
            sequence: 110
            region: @rateio-de-fatura
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDMATRIZDESPESA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

