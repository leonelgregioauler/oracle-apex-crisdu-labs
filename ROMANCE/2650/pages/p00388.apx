page 388 (
    name: Rateio de Fatura
    title: Rateio de Fatura
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }

    region rateio-de-fatura (
        name: Rateio de Fatura
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P388_DATA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 180
            region: @rateio-de-fatura
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: DATA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P388_DATAVENCIMENTO (
        type: selectList
        label {
            label: Data de Vencimento
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.datavencimento display_value 
                     , v.datavencimento  return_value
                from roman.vencimentos v 
                where v.idnotafiscal = :P388_IDNOTAFISCAL
                  and not exists ( select 1
                                   from roman.fechamentomovimentacoes fm
                                      , roman.pagamentosfornecedores  pf
                                   where fm.datafechamento  = pf.databaixa
                                     and fm.idcontabancaria = pf.idcontapagamento
                                     and pf.idvencimento = v.idvencimento
                                     and pf.idnotafiscal = v.idnotafiscal)
                  and not exists ( select 1
                                   from roman.pagamentosfornecedores pf
                                   where pf.idnotafiscal = v.idnotafiscal
                                     and pf.idvencimento = v.idvencimento
                                     and pf.valorpago > 0 )
                ```
        }
        layout {
            sequence: 90
            region: @rateio-de-fatura
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: DATAVENCIMENTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

