    pageItem P388_IDFILIALDESTINO (
        type: selectList
        label {
            label: Destino
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(f.idfilial)||'  - Unid. Neg.: '||( select un.nome
                                                                                from unidadesdenegocios un
                                                                                where un.idunidadedenegocio = f.idunidadedenegocio ) display_value 
                     , f.idfilial return_value 
                from filiais f
                where exists ( select 1
                               from matrizregrasdespesas m
                               where m.idfornecedor = :P388_IDFORNECEDOR
                                 and m.idfilial     = f.idfilial )
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P388_IDFORNECEDOR
        }
        layout {
            sequence: 50
            region: @rateio-de-fatura
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIALDESTINO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

