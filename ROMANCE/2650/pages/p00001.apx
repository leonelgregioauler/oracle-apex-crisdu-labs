page 1 (
    name: Inicial
    title: Inicial
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region aviso (
        name: Aviso
        type: staticContent
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                Devido a situação atual, a partir de <b>segunda-feira (23/03/2020)</b> a T.I trabalhará em formato Home Office.<br>
                Caso necessite suporte, nos chame no <b>WhatsApp</b> que ajudamos você.<br>
                Contatos:<br><br>
                
                - 51 9 82810011 (Suporte Romance)<br>
                - 51 9 80423097 (Suporte Minha Sacola)<br>
                - 51 9 81018384 (Suporte Infra/Equipamentos)<br><br>
                
                Aqui vão algumas dicas: <br><br>
                
                <b>- Lave com frequência as mãos.</b><br>
                <b>- Evite aglomerações.</b><br>
                <b>- Fique atento aos sintomas.</b>
                ```
        }
        serverSideCondition {
            type: never
        }
    )

    region início (
        name: Início
        type: list
        source {
            list: @menu-de-navegação
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            listTemplate: @/cards
            templateOptions: [
                #DEFAULT#
                t-Cards--featured force-fa-lg
                t-Cards--displayIcons
                t-Cards--3cols
                u-colors
                t-Cards--animColorFill
            ]
        }
    )

    pageItem P1_IDIOMA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @início
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P1_SEMANAATUAL (
        type: hidden
        layout {
            sequence: 20
            region: @início
            slot: regionBody
        }
    )

    dynamicAction busca-semana-atual (
        name: Busca Semana Atual
        execution {
            sequence: 20
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: itemIsNull
            item: P1_SEMANAATUAL
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                      select trim(to_char(semana,'00')||'/'||to_char(ano))
                      into :P1_SEMANAATUAL
                      from semana_dias
                      where sysdate between dt_ini and dt_fim+1;
                    exception
                      when others then
                        null;
                    end;
                    ```
            }
            execution {
                sequence: 10
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: window.location.reload();
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction notifca-a-troca-de-senha (
        name: "Notifca a troca de senha "
        execution {
            sequence: 10
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from roman.controletrocasenha c
                where c.ativo = 'S'
                and 1 =2
                and dataalteracao is null
                and idusuario = (select idusuario
                                from usuarios
                                where upper (usuario) = v('APP_USER'))
                ```
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    <html>
                    <head>       
                       <!--IMPORTAÇÕES NECESSÁRIAS-->
                        <link rel="stylesheet" href="http://code.jquery.com/ui/1.9.2/themes/redmond/jquery-ui.css" />
                        <script src="http://code.jquery.com/jquery-1.8.3.js"></script>
                        <script src="http://code.jquery.com/ui/1.9.2/jquery-ui.js"></script>         
                    </head>
                    <body>
                    <div id="dialog" title="Controle de autenticação">
                        <p>Você precisa redefinir a sua senha! Verifique seu email.<br> Seu acesso será bloqueado meia hora após o login.</p>
                    </div>
                    <script>
                    $( "#dialog" ).dialog();
                    </script>
                    </body>
                    </html>
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction popup-optimus-cara-nova (
        name: Popup Optimus Cara Nova
        execution {
            sequence: 30
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: false
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (function(){
                    var ver='v4';
                    if(localStorage.getItem('optimus_popup')===ver)return;
                    var s='<style>'+
                    '.opt-dlg .ui-dialog-titlebar{display:none}'+
                    '.opt-dlg{position:fixed!important;top:50%!important;left:50%!important;transform:translate(-50%,-50%)!important;margin:0!important;border:none!important;border-radius:12px!important;overflow:hidden;padding:0!important;box-shadow:0 24px 64px rgba(0,0,0,.9)!important}'+
                    '.opt-dlg .ui-dialog-content{padding:0!important;overflow:hidden!important}'+
                    '.opt-dlg .ui-dialog-buttonpane{display:none!important}'+
                    '.opt-dlg-x{position:absolute;top:10px;right:10px;background:rgba(0,0,0,.5);color:#fff;border:none;border-radius:50%;width:34px;height:34px;font-size:20px;cursor:pointer;line-height:34px;text-align:center;z-index:10}'+
                    '.opt-dlg-x:hover{background:rgba(0,0,0,.85)}'+
                    '.ui-widget-overlay{position:fixed!important;top:0!important;left:0!important;width:100%!important;height:100%!important}'+
                    '</style>';
                    $(document.body).append(s);
                    var src='#APP_FILES#card_nova_ui.jpeg';
                    var img=new Image();
                    img.onload=function(){
                    var h='<img src="'+src+'" style="width:100%;display:block" alt="Optimus">';
                    var d=$('<div>').html(h).appendTo(document.body);
                    d.dialog({
                      modal:true,
                      width:680,
                      dialogClass:'opt-dlg',
                      title:'',
                      resizable:false,
                      close:function(){$(this).dialog('destroy').remove();}
                    });
                    $('<button class="opt-dlg-x">&#10005;</button>')
                      .on('click',function(){localStorage.setItem('optimus_popup',ver);d.dialog('close');})
                      .appendTo(d.closest('.ui-dialog'));
                    };
                    img.src=src;
                    })();
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    process abatimento (
        name: abatimento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                pck_abatimentos.prc_executa;
                commit;
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 425184806933871876
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('APP_USER') in ('ADRIANA','MARAB','CINARA','KEURIN')
                 AND 1 = 2
                ```
        }
    )

    process troca-idioma (
        name: troca idioma
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                APEX_UTIL.SET_SESSION_LANG(nvl(:P1_IDIOMA,'pt-br'));
                end;
                ```
        }
        execution {
            sequence: 20
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 270570812918084512
        }
    )

)

