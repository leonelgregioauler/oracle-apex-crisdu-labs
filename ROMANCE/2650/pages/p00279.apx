page 279 (
    name: Depositar v2
    title: Depositar v2
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function getMoney( str )
            {
                    return parseInt( str.replace(/[\D]+/g,'') );
            }
            
            function fnc_somadepositos()
            {
              vvalor = 0;
              for(i=0;i<document.wwv_flow.length;i++)
              {
                if ( isNaN(parseFloat(document.wwv_flow.f06[i].value) ))
                {
                  void(0);
                }
                else
                { 
                   valor = document.wwv_flow.f06[i].value;
                   valor = valor.replace(".","");
                   valor = valor.replace(",",".");
                   valor = parseFloat(valor);
                   valor = getMoney( document.wwv_flow.f06[i].value)
                 vvalor = parseFloat(vvalor)+parseFloat(valor);   
                }
                document.getElementById('P279_TOTAL').value =formatReal(  vvalor);
              }
            } 
            
            function formatReal( int )
            {
                    var tmp = int+'';
                    var neg = false;
                    if(tmp.indexOf("-") == 0)
                    {
                        neg = true;
                        tmp = tmp.replace("-","");
                    }
                    
                    if(tmp.length == 1) tmp = "0"+tmp
                
                    tmp = tmp.replace(/([0-9]{2})$/g, ",$1");
                    if( tmp.length > 6)
                        tmp = tmp.replace(/([0-9]{3}),([0-9]{2}$)/g, ".$1,$2");
                    
                    if( tmp.length > 9)
                        tmp = tmp.replace(/([0-9]{3}).([0-9]{3}),([0-9]{2}$)/g,".$1.$2,$3");
                
                    if( tmp.length > 12)
                        tmp = tmp.replace(/([0-9]{3}).([0-9]{3}).([0-9]{3}),([0-9]{2}$)/g,".$1.$2.$3,$4");
                    
                    if(tmp.indexOf(".") == 0) tmp = tmp.replace(".","");
                    if(tmp.indexOf(",") == 0) tmp = tmp.replace(",","0,");
                
                    return tmp;
            }
            
            function formataMoeda(valor){
              v = valor.value;
              v=v.replace(/\D/g,"") // permite digitar apenas numero
              v=v.replace(/(\d{1})(\d{14})$/,"$1.$2") // coloca ponto antes dos ultimos digitos
              v=v.replace(/(\d{1})(\d{11})$/,"$1.$2") // coloca ponto antes dos ultimos 11 digitos
              v=v.replace(/(\d{1})(\d{8})$/,"$1.$2") // coloca ponto antes dos ultimos 8 digitos
              v=v.replace(/(\d{1})(\d{5})$/,"$1.$2") // coloca ponto antes dos ultimos 5 digitos
              v=v.replace(/(\d{1})(\d{1,2})$/,"$1,$2") // coloca virgula antes dos ultimos 2 digitos
              valor.value = v;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

