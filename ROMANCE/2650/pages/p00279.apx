    dynamicAction limpa-depósitos-sem-valores (
        name: "Limpa Depósitos Sem Valores "
        execution {
            sequence: 30
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select *
                from depositosdiarios d
                where d.idrepresentante is null
                  and d.valordeposito is null
                  and d.idcontabanc = :P279_IDCONTABANCARIA
                  and d.idfornecedor = :P279_IDFORNECEDOR;
                ```
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                      --
                      delete depositosdiarios d
                      where d.idrepresentante is null
                        and d.valordeposito is null
                        and d.idcontabanc = :P279_IDCONTABANCARIA
                        and d.idfornecedor = :P279_IDFORNECEDOR;
                      --
                      commit;
                      --
                    end;
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

