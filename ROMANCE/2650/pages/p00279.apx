    region ordens-de-depósito (
        name: Ordens de Depósito
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select o.idordemdeposito
                     , ( select pck_romance.fnc_nomepessoa(c.idpessoa)
                         from contasbancarias c
                         where c.idcontabanc = o.idcontabancaria ) destino
                     , pck_cadastros_rmc.fnc_retornacontabancaria(idcontabancaria) conta
                     , nvl(pck_romance.fnc_nomefilial(idfilial) 
                                                                , ( select listagg(pck_romance.fnc_nomefilial(idfilial)) within group (order by 1)
                                                                     from filiaisordensdepositos  f
                                                                     where f.idordemdeposito = o.idordemdeposito ) )  empresa
                     
                     , pck_romance.fnc_nomerepresentante(idrepresentante) distribuidor
                     , data
                     , valor ordem
                     , nvl( ( select sum(d.valordeposito)
                                      from depositosdiarios_orig d
                                      where d.idordemdeposito = o.idordemdeposito ),0) depositado
                     , valor - nvl( ( select sum(d.valordeposito)
                                      from depositosdiarios_orig d
                                      where d.idordemdeposito = o.idordemdeposito ),0) saldo
                     , descricao
                     , decode(priorizado, 'S', 'Sim','Não') priorizado
                     , case  
                          when valor - nvl( ( select sum(d.valordeposito)
                                              from depositosdiarios_orig d
                                              where d.idordemdeposito = o.idordemdeposito ),0) < 0 then
                               'Depositado a mais'
                               end observacao
                from ordensdepositos o
                where o.idcontabancaria = :P279_IDCONTABANCARIA
                  and o.identificado    = :P279_IDENTIFICADO 
                  and (:P279_IDORDEMDEPOSITO is null or o.idordemdeposito = :P279_IDORDEMDEPOSITO)
                 -- DIONYRINKER - 14/07/26 - TICKET 13128011
                 -- and valor - nvl( ( select sum(d.valordeposito)
                                            --  from depositosdiarios_orig d
                                            --  where d.idordemdeposito = o.idordemdeposito ),0) > 0
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
