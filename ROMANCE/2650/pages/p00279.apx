        column IDREPRESENTANTE (
            reportColumnQueryId: 3
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Distribuidor
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_romance.fnc_nomerepresentante(r.idrepresentante)||' '||decode(r.ativo,'S',' ','N',' - Inativo')||'  ['|| r.idrepresentante ||']' display_value    
                         , r.idrepresentante return_value 
                    from representantes r
                    where pck_romance.fnc_filialrepresentante(idrepresentante) = :P279_IDFILIAL 
                      and r.ativo = 'S'
                    order by 1
                    ```
