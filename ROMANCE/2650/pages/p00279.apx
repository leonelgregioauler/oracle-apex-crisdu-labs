    process processa-saldos-das-faturas (
        name: Processa saldos das Faturas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vv number := 0;
                begin
                  --
                  for v in ( select p.idpgtoforn
                             from pagamentosfornecedores p
                             where p.tipopagamento = 'D'
                               and p.idcontabanc  = :P279_IDCONTABANCARIA
                               and p.idfornecedor = :P279_IDFORNECEDOR
                               and extract( year from p.dtvencimento ) >= 2019
                               and exists ( select 1
                                            from depositosdiarios d
                                            where d.idpgtoforn = p.idpgtoforn 
                                              and d.contabilizou is null )
                             order by 1 desc )
                  loop
                    --
                    vv := vv+1;
                    --
                    pck_financeiro_rmc.prc_atualiza_parcelas( v.idpgtoforn , null );
                    --
                    pck_financeiro_rmc.prc_atualiza_pagtoforn ( v.idpgtoforn );
                    --
                    pck_financeiro_rmc.prc_deleta_saldo_sem_pai;
                    --
                  end loop;
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 1545365281794387282
        }
    )

    process seleciona-ordem (
        name: Seleciona Ordem
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    select o.idordemdeposito
                    into :P279_IDORDEMDEPOSITO
                    from ordensdepositos o
                    where o.idcontabancaria = :P279_IDCONTABANCARIA
                      and o.identificado    = :P279_IDENTIFICADO 
                      and o.valor >= nvl( ( select sum(valordeposito)
                                           from depositosdiarios_orig d
                                           where d.idordemdeposito = o.idordemdeposito ),0);
                exception
                  when others then
                    null;
                end;                           
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 1545623066692670806
        }
    )

