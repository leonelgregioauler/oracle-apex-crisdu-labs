            }
            appearance {
                width: 80
            }
        )

        column IDVENCIMENTOABATIMENTO (
            reportColumnQueryId: 13
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Abatimento
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nv.documento||' - '||vr.datavencimento display_value
                         , vr.idvencimento
                    from notasfiscais nv 
                       , vencimentosreceber vr
                    where nv.tiponota = 'V'
                      and nv.idnotafiscal        = vr.idnotafiscal
                      and nv.idfornecedordestino = ( select f.idfornecedor 
                                                     from contasbancarias c
                                                        , fornecedores    f
                                                     where c.idpessoa    = f.idpessoa
                                                       and c.idcontabanc = :P279_IDCONTABANCARIA )
                      and not exists ( select 1
                                       from depositosdiarios_orig d
                                       where d.idvencimentoabatimento = vr.idvencimento )
                    order by vr.datavencimento
                    ```
            }
            layout {
                sequence: 13
            }
        )

