    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region atualizar-comprovante (
        name: Atualizar comprovante
        type: staticContent
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            renderComponents: belowContent
        }
    )

    pageItem P36_COMPROVADO (
        type: selectList
        label {
            label: Comprovado
            alignment: right
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sem Comprovante;S,Cópia;C,Em Mãos;M
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @atualizar-comprovante
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: COMPROVADO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P36_IDDEPOSITODIARIOS (
        type: hidden
        layout {
            sequence: 1
            region: @atualizar-comprovante
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDDEPOSITODIARIOS
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P36_OBSERVACAO (
        type: textField
        label {
            label: Nro Comprovante
            alignment: right
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 90
            region: @atualizar-comprovante
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 40
        }
        validation {
            maxLength: 200
        }
        source {
            type: databaseColumn
            databaseColumn: OBSERVACAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button close (
        buttonName: close
        label: Fechar
        layout {
            sequence: 10
            region: @atualizar-comprovante
            slot: bottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:window.close();
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @atualizar-comprovante
            slot: bottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P36_IDDEPOSITODIARIOS
        }
    )

    process fetch-row-from-depositosdiarios (
        name: Fetch Row from DEPOSITOSDIARIOS
        type: autoRowFetch
        source {
            tableName: DEPOSITOSDIARIOS
            pkColumn: IDDEPOSITODIARIOS
            pkItem: P36_IDDEPOSITODIARIOS
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Unable to fetch row.
        }
        advanced {
            executionMappingIdentifier: 181233566517590417
        }
    )

    process process-row-of-depositosdiarios (
        name: Process Row of DEPOSITOSDIARIOS
        type: autoRowProcessing
        target {
            tableName: DEPOSITOSDIARIOS
            pkColumn: IDDEPOSITODIARIOS
            pkItem: P36_IDDEPOSITODIARIOS
            supportedOperations: update
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        error {
            errorMessage: Unable to process row of table DEPOSITOSDIARIOS.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 181233744416590422
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 36
            }
            saveStateBeforeBranching: true
        }
    )

)

