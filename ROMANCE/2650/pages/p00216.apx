page 216 (
    name: Retirada de Pontos
    title: Retirada de Pontos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 80%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region retirada-de-pontos (
        name: Retirada de Pontos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(idfilial) empresa
                     , sum(total) total
                from (
                        select p.idfilial
                             , sum(p.valortotal) total
                        from catal.pedidos p
                        where SEMANAEMISSAO = ( select f.semana 
                                                from fechamentossemanais f 
                                                where f.idfechamento = :P216_IDFECHAMENTO )
                          and p.situacao   != 'Z'
                          and idfilial     != 1041
                          and p.tipo        = 'R'
                        group by p.idfilial
                        union
                        select p.idfilial
                             , sum(p.pontosutilizados)
                        from catal.pedidos p
                        where SEMANAEMISSAO = ( select f.semana 
                                                from fechamentossemanais f 
                                                where f.idfechamento = :P216_IDFECHAMENTO )
                          and idfilial     != 1041
                          and p.situacao   != 'Z'
                        group by  p.idfilial
                        union
                        select pff.idfilialromance
                             , sum(idvalorcaracteristica * nvl(pff.fatorconversao,1))
                        from favorita.classificacoespedidos c
                           , favorita.pedidos               pff
                        where idcaracteristicapedido = 5
                          and to_char(c.dataclassificado,'IW/RRRR') = ( select f.semana 
                                                                        from fechamentossemanais f 
                                                                        where f.idfechamento = :P216_IDFECHAMENTO )
                          and pff.idpedido                          = c.idpedido  
                        group by pff.idfilialromance )
                group by idfilial
                order by 1
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 2551434249122023056
        }

        column EMPRESA (
            type: plainText
            heading {
                heading: Empresa
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column TOTAL (
            type: plainText
            heading {
                heading: Total
                alignment: end
            }
            layout {
                sequence: 2
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 25514432 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn EMPRESA (
                sequence: 1
            )

            displayColumn TOTAL (
                sequence: 2
            )

            aggregate (
                column: TOTAL
            )

        )

    )

    pageItem P216_IDFECHAMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @retirada-de-pontos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

