page 416 (
    name: Gestão Orçamentária
    title: Gestão Orçamentária
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region acompanhamento-das-despesas (
        name: Acompanhamento das Despesas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select g.idgestaoorcamentaria
                     , g.idcentrodecusto
                     , c.nome centrodecusto
                     , g.referente
                     , g.idcontafinanceira
                     , pck_romance.fnc_nomecontafinan(g.idcontafinanceira) conta
                     , g.idsubcontafinanceira
                     , pck_romance.fnc_nomesubcontafinan(g.idsubcontafinanceira) subconta
                     , nvl(o.janeiro,0) janeiro
                     , nvl(o.fevereiro,0) fevereiro
                     , nvl(o.marco,0) marco
                     , nvl(o.abril,0) abril
                     , nvl(o.maio,0) maio
                     , nvl(o.junho,0) junho
                     , nvl(o.julho,0) julho
                     , nvl(o.agosto,0) agosto
                     , nvl(o.setembro,0) setembro
                     , nvl(o.outubro,0) outubro
                     , nvl(o.novembro,0) novembro
                     , nvl(o.dezembro,0) dezembro
                     , g.valordespesas
                     , round(g.valordespesas/12) media_mes
                     , g.valorproposta
                     , g.valorcontraproposta
                     , g.valorfinal
                     , g.vigencia
                from gestaoorcamentaria g
                   , orcamentosmes o
                   , centrodecustos c
                where o.idgestaoorcamentaria = g.idgestaoorcamentaria
                  and c.idcentrodecusto      = g.idcentrodecusto
                  and g.idcentrodecusto      = :P416_IDCENTRODECUSTO
                  and g.referente            = :P416_ANO
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 5995063259396231223
        }

