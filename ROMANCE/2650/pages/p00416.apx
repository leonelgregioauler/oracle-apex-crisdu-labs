                  pck_centrodecustos_rmc.prc_removeorcamento(pidcentrodecusto => :P416_IDCENTRODECUSTO_R,
                                                             preferente => :P416_REFERENTE,
                                                             pvigencia => :P416_VIGENCIA);
                end;
                
