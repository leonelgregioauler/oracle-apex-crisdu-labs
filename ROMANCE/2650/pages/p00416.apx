            virtualKeyboard: text
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        default {
            type: expression
            plsqlExpression: to_char(sysdate,'RRRR')-1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P416_IDCENTRODECUSTO (
        type: selectList
        label {
            label: Centro de Custo
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nome
                     , c.idcentrodecusto
                from centrodecustos c
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

