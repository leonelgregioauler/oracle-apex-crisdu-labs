    process atualiza-valor-da-contraproposta (
        name: Atualiza valor da Contraproposta
        type: executeCode
        editableRegion: @acompanhamento-das-despesas
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  case :APEX$ROW_STATUS  
                    when 'U' then
                      --
                      if :VALORPROPOSTA is not null and :VALORFINAL is null then
                        --
                        pck_centrodecustos_rmc.prc_gerapropostainicial(pidgestaoorcamentaria => :IDGESTAOORCAMENTARIA,
                                                                       pvalor => :VALORPROPOSTA);
                        --
                      end if;
                      --    
                  end case;
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 6138017817375544003
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuarios u
                   , centrodecustos c
                where c.idpessoaresponsavel = u.idpessoa
                  and u.usuario = v('APP_USER')
                  and c.idcentrodecusto = :IDCENTRODECUSTO
                ```
        }
    )

    process atualiza-valor-de-proposta (
        name: Atualiza valor de Proposta
        type: executeCode
        editableRegion: @acompanhamento-das-despesas
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  case :APEX$ROW_STATUS  
                    when 'U' then
                      --
                      if :VALORPROPOSTA is not null and :VALORFINAL is null then
                        --
                        pck_centrodecustos_rmc.prc_gerapropostainicial(pidgestaoorcamentaria => :IDGESTAOORCAMENTARIA,
                                                                       pvalor => :VALORPROPOSTA);
                        --
                      elsif :VALORPROPOSTA is not null and :VALORFINAL is not null then
                        --
                        pck_centrodecustos_rmc.prc_gerapropostafinal(pidgestaoorcamentaria => :IDGESTAOORCAMENTARIA,
                                                                     pvalor => :VALORFINAL);
                        --
                      end if;
                      --    
                  end case;
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 6138017768384544002
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuarios u
                   , centrodecustos c
                where c.idpessoaresponsavel = u.idpessoa
                  and u.usuario = v('APP_USER')
                  and c.idcentrodecusto = :IDCENTRODECUSTO
                ```
        }
    )

