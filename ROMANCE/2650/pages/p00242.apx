page 242 (
    name: Chamados em Aberto/Andamento
    title: Chamados em Aberto/Andamento
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    headerAndFooter {
        headerText:
            ```html
            <FRAMESET ROWS="100%" FRAMEBORDER="1" FRAMESPACING="1">
            <FRAME SRC="http://192.168.254.254" NAME="superior" NORESIZE SCROLLING="NO">
            </FRAMESET>
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region brasil (
        name: Brasil
        type: staticContent
        source {
            htmlCode:
                ```html
                select l link
                     , nome label
                     , valor value
                from( select distinct null l
                           , pck_romance.TiraAcento(e.nome) nome
                           , pck_chamados.fnc_filiaisgrafico( e.idestado) valor
                      from estados e
                      where e.siglaapex is not null
                      minus 
                      select distinct null l
                           , pck_romance.TiraAcento(e.nome) label
                           , null value
                      from estados e
                      where e.siglaapex is not null);
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: never
        }
    )

    region chamados-abertos-no-dia (
        name: Chamados abertos no dia
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select DISTINCT null link
                     , trunc(dataabertura) label
                     , ( select count(1) 
                         from chamados cc
                         where trunc(cc.dataabertura) = trunc(c.dataabertura) 
                           and cc.responsavel = 'EVERTON') "Everton"
                     , ( select count(1) 
                         from chamados cc
                         where trunc(cc.dataabertura) = trunc(c.dataabertura) 
                           and cc.responsavel = 'MATEUS') "Mateus"
                     , ( select count(1) 
                         from chamados cc
                         where trunc(cc.dataabertura) = trunc(c.dataabertura) 
                           and cc.responsavel = 'MAX') "Max"
                     , ( select count(1) 
                         from chamados cc
                         where trunc(cc.dataabertura) = trunc(c.dataabertura) 
                           and cc.responsavel = 'GUILHERME') "Guilherme"
                     , ( select count(1) 
                         from chamados cc
                         where trunc(cc.dataabertura) = trunc(c.dataabertura) 
                           and cc.responsavel is null ) "Definir"
                from chamados  c
                where c.responsavel is not null
                  and trunc(dataabertura) >= trunc(sysdate) - 3
                order by 2
                ```
        }
        layout {
            sequence: 40
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        security {
            escapeSpecialChars: false
        }
        chart {
            type: line
        }
        title {
            title: Chamados Abertos por Dia
        }
        chartLayout {
            maxWidth: 800
            height: 500
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        tooltip {
            showSeriesName: false
        }
        legend {
            show: false
        }
        autoRefresh {
            interval: 60
        }
        messages {
            whenNoDataFound: No data found.
        }

        series chamados-abertos (
            name: Chamados Abertos
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: "\"2\""
                value: "\"3\""
            }
            marker {
                shape: circle
            }
            label {
                show: true
                position: aboveMarker
            }
            performance {
                maxRowsToProcess: 50
            }
        )

        axis x (
            name: x
            value {
                formatScaling: none
            }
            majorTicks {
                show: false
            }
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            majorTicks {
                show: false
            }
            minorTicks {
                show: false
            }
        )

    )

    region chamados-em-aberto-andamento (
        name: Chamados em Aberto/Andamento
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select responsavel link
                     , responsavel||' ( '|| round(count(1) / ( select count(1)
                                                       from chamados  c
                                                       where c.idsituacao in ( 0,1,20 ) ) *100)||'% )' label
                     , count(1) value
                from chamados  c
                where c.idsituacao in ( 0,1 ,20)
                group by responsavel
                order by 1  
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        security {
            escapeSpecialChars: false
        }
        chart {
            type: pie
        }
        title {
            title: Chamados em Aberto/Andamento
        }
        chartLayout {
            maxWidth: 800
            height: 500
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        value {
            format: decimal
            formatScaling: none
        }
        legend {
            show: false
        }
        autoRefresh {
            interval: 60
        }
        messages {
            whenNoDataFound: -
        }

        series chamados-em-aberto-andamento (
            name: Chamados em Aberto/Andamento
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: "\"2\""
                value: "\"3\""
            }
            label {
                show: true
            }
            performance {
                maxRowsToProcess: 500
            }
        )

    )

    region chamados-encerrados-no-dia (
        name: Chamados encerrados no dia
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select DISTINCT null link
                     , trunc(dataencerrado) label
                     , ( select count(1) 
                         from chamados cc
                         where trunc(cc.dataencerrado) = trunc(c.dataencerrado) 
                           and cc.idsituacao in ( 2,40)
                           and cc.responsavel = 'EVERTON') "Everton"
                     , ( select count(1) 
                         from chamados cc
                         where trunc(cc.dataencerrado) = trunc(c.dataencerrado) 
                           and cc.idsituacao in ( 2,40)
                           and cc.responsavel = 'MATEUS') "Mateus"
                     , ( select count(1) 
                         from chamados cc
                         where trunc(cc.dataencerrado) = trunc(c.dataencerrado) 
                           and cc.idsituacao in ( 2,40)
                           and cc.responsavel = 'MAX') "Max"
                     , ( select count(1) 
                         from chamados cc
                         where trunc(cc.dataencerrado) = trunc(c.dataencerrado) 
                           and cc.idsituacao in ( 2,40)
                           and cc.responsavel = 'GUILHERME') "Guilherme"
                from chamados  c
                where c.responsavel is not null
                  and c.idsituacao in ( 2,40)
                  and trunc(dataencerrado) >= trunc(sysdate) - 3
                order by 2
                
                ```
        }
        layout {
            sequence: 50
            slot: body-3
        }
