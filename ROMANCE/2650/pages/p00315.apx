    process ajusta-filiais-do-pagamentosfornecedores (
        name: Ajusta filiais do pagamentosfornecedores
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  for a in ( select p.idpgtoforn
                             from pagamentosfornecedores p
                             where p.idfilial != ( select  n.idfilialdestino 
                                                   from notasfiscais n
                                                   where n.idnotafiscal = p.idnotafiscal )     )
                  loop
                    --
                    update pagamentosfornecedores p 
                    set p.idfilial = ( select n.idfilialdestino 
                                       from notasfiscais n
                                       where n.idnotafiscal = p.idnotafiscal )
                    where p.idpgtoforn = a.idpgtoforn ;
                    --
                  end loop;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 817799702712589694
        }
    )

    branch (
