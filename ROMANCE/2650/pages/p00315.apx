    pageItem P315_AVISO (
        type: displayOnly
        label {
            label: Aniversariante(s) do dia
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 100
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  vpessoas varchar2(1000);
                  --
                begin
                  --
                  for i in ( select initcap(p.nomepessoa) nome
                             from pessoas p
                             where to_char(p.datanascimento,'DD/MM') = to_char(sysdate,'DD/MM')
                               and exists ( select 1
                                            from representantes r
                                            where r.idpessoa = p.idpessoa
                                              and r.ativo = 'S' )
                             order by 1 )
                  loop
                    --
                    if vpessoas is null then
                      --
                      vpessoas := i.nome;
                      --
                    else
                      --
                      vpessoas := vpessoas ||', '||i.nome;
                      --
                    end if;    
                    --
                  end loop;
                  --
                  vpessoas := vpessoas||'.';
                  --
                  return vpessoas;
                  --
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

