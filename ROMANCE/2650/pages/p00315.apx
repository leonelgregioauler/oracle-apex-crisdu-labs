            controlBreak (
                column: SEMANA
                layout {
                    sequence: 2
                }
            )

            highlight ir-condition-2 (
                name: Faturas Automatizaas
                condition {
                    column: AUTOMATIZADO
                    value: Sim
                }
                colors {
                    background: #3D853D
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-3 (
                name: Faturas com Prioridade
                condition {
                    column: PRIORIDADE
                    value: Prioridade
                }
                highlight {
                    type: cell
                }
                colors {
                    background: #6BB4B8
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-4 (
                name: Saldo Negativo
                condition {
                    column: SALDO
                    operator: <
                    value: 0
                }
                highlight {
                    type: cell
                }
                colors {
                    text: #FF0033
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-5 (
                name: Saldo Positivo
                condition {
                    column: SALDO
                    operator: >=
                    value: 0
                }
                highlight {
                    type: cell
                }
                colors {
                    text: #006600
                }
                execution {
                    sequence: 10
                }
            )

        )

    )

