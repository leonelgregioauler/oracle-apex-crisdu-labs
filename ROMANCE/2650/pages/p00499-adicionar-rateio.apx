                    sequence: 14
                }
            )

            displayColumn (
                column: @USUARIO
                layout {
                    sequence: 16
                }
            )

            displayColumn (
                column: @DATAVENCIMENTO
                layout {
                    sequence: 10
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column DATAVENCIMENTO (
            type: selectList
            heading {
                heading: Data Vencimento
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select v.datavencimento display_value 
                         , v.datavencimento  return_value
                    from roman.vencimentos v 
                    where v.idnotafiscal = :P499_IDNOTAFISCAL 
                      and not exists ( select 1
                                       from roman.fechamentomovimentacoes fm
                                          , roman.pagamentosfornecedores  pf
                                       where fm.datafechamento  = pf.databaixa
                                         and fm.idcontabancaria = pf.idcontapagamento
                                         and pf.idvencimento = v.idvencimento
                                         and pf.idnotafiscal = v.idnotafiscal)
                      and not exists ( select 1
                                       from roman.pagamentosfornecedores pf
                                       where pf.idnotafiscal = v.idnotafiscal
                                         and pf.idvencimento = v.idvencimento
                                         and pf.valorpago > 0 )
                    order by v.datavencimento
                    ```
            }
            layout {
                sequence: 180
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: DATAVENCIMENTO
                dataType: date
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column DOCUMENTO (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: DOCUMENTO
                dataType: varchar2
            }
            default {
                type: item
                item: P499_DOCUMENTO
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column FORMAPAGAMENTO (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 100
            }
            source {
                databaseColumn: FORMAPAGAMENTO
                dataType: varchar2
            }
            default {
                type: item
                item: P499_FORMAPAGAMENTO
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDCONTAPAGAMENTO (
            type: hidden
            settings {
                valueProtected: false
            }
