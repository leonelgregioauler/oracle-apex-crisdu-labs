page 499 (
    name: Adicionar Rateio
    alias: ADICIONAR-RATEIO
    title: Adicionar Rateio
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 900
        height: 700
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region iniciar-lançamento (
        name: Iniciar Lançamento
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
    )

    region rateios-da-fatura (
        name: Rateios da Fatura
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.idrateionotafiscal
                     , r.documento
                     , r.idfornecedor
                     , r.idrazaosocialfornecedor
                     , r.idfilialdestino
                     , r.idrazaosocialdestino
                     , r.formapagamento
                     , r.idcontapagamento
                     , r.datavencimento
                     , r.valor
                     , r.idmatrizdespesa
                     , r.observacao
                     , r.idnotafiscal
                     , r.usuario
                from roman.rateiosnotasfiscais r
                where r.idnotafiscal is null 
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 97176777784989422
        }

        savedReport 484480 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDRATEIONOTAFISCAL
                layout {
                    sequence: 2
                }
            )

