    button finalizar-rateio (
        buttonName: FINALIZAR_RATEIO
        label: Finalizar Rateio
        layout {
            sequence: 10
            region: @rateios-da-fatura
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation valida-fechamento (
        name: Valida fechamento
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentomovimentacoes fm
                   , pagamentosfornecedores  pf
                where fm.datafechamento  = pf.databaixa
                  and fm.idcontabancaria = pf.idcontapagamento
                  and pf.idnotafiscal    = :P388_IDNOTAFISCAL
                ```
        }
        error {
            errorMessage: "Fechamento existente "
        }
        serverSideCondition {
            type: never
        }
    )

    process ajusta-valor-capa-da-nota (
        name: Ajusta Valor Capa Da Nota
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  -- 
                begin
                  -- 
                  roman.pck_notasfiscais_rmc.prc_atualiza_rateios(pidnotafiscal => :P499_IDNOTAFISCAL );
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 48749202445638881
        }
        serverSideCondition {
            whenButtonPressed: @finalizar-rateio
        }
        comments {
            comments: "Esse processo ajusta o valor da capa da nota conforme o total dos rateios. "
        }
    )

    process busca-dados (
        name: Busca Dados
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  -- 
                  vidrequisicao         number;
                  vdocumento            varchar2(40);
                  vidfornecedor         number;
                  vidrazaosocialforn    number;
                  vidfilialdestino      number;
                  vidrazaosocialdestino number;
                  vformapagamento       varchar2(1);
                  vantecipacao          varchar2(1);
                  vobservacao           varchar2(4000);
                  vdatavencimento       date;
                  vidcontapagamento     number;
                  vseqidrateioreq       number;
                  --
                begin
                  -- 
                  select r.idrequisicaopgto
                       , r.documento
                       , r.idfornecedor
                       , r.idrazaosocialfornec
                       , r.idfilial
                       , r.idrazaosocialdest
                       , r.idformapagamento
                       , r.idcontabanc
                       , r.vencimento
                       , r.antecipacao
                       , r.observacao
                  into vidrequisicao
                     , vdocumento
                     , vidfornecedor         
                     , vidrazaosocialforn    
                     , vidfilialdestino      
                     , vidrazaosocialdestino 
                     , vformapagamento
                     , vidcontapagamento
                     , vdatavencimento
