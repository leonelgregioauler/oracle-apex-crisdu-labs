            templateOptions: #DEFAULT#
        }
        advanced {
            preText: <font color=red><h3>Obs.:Vencimentos com pagamentos realizados não serão listados!</h3></font>
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.vencimentos v 
                where v.idnotafiscal = :P499_IDNOTAFISCAL 
                  and exists ( select 1
                                   from roman.fechamentomovimentacoes fm
                                      , roman.pagamentosfornecedores  pf
                                   where fm.datafechamento  = pf.databaixa
                                     and fm.idcontabancaria = pf.idcontapagamento
                                     and pf.idvencimento = v.idvencimento
                                     and pf.idnotafiscal = v.idnotafiscal)
                  and exists ( select 1
                                   from roman.pagamentosfornecedores pf
                                   where pf.idnotafiscal = v.idnotafiscal
                                     and pf.idvencimento = v.idvencimento
                                     and pf.valorpago > 0 )
                ```
