                sequence: 150
            }
            source {
                type: none
            }
            default {
                type: item
                item: P499_IDCONTABANCARIA
            }
        )

        column IDFILIALDESTINO (
            type: selectList
            heading {
                heading: Destino
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_romance.fnc_nomefilial(f.idfilial)||'  - Unid. Neg.: '||( select un.nome
                                                                                    from unidadesdenegocios un
                                                                                    where un.idunidadedenegocio = f.idunidadedenegocio ) display_value 
                         , f.idfilial return_value 
                    from filiais f
                    where exists ( select 1
                                   from matrizregrasdespesas m
                                   where m.idfornecedor = :P499_IDFORNECEDOR
                                     and m.idfilial     = f.idfilial )
                    order by 1
                    ```
            }
            layout {
                sequence: 80
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDFILIALDESTINO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDFORNECEDOR (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: IDFORNECEDOR
                dataType: number
            }
            default {
                type: item
                item: P499_IDFORNECEDOR
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDMATRIZDESPESA (
            type: selectList
            heading {
                heading: Matriz
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select ( select c.nome
                             from centrodecustos c
                             where c.idcentrodecusto = m.idcentrodecusto )||' - '||pck_romance.fnc_nomecontafinan(m.idcontafinan)||' / '||pck_romance.fnc_nomesubcontafinan(m.idsubcontafinan) a
                         , m.idmatrizregra
                    from matrizregrasdespesas m
                    where m.idfornecedor = :P499_IDFORNECEDOR
                      and m.idfilial     = :IDFILIALDESTINO
                      and m.ativo        = 'S'
                      and not exists ( select 1 
                                       from roman.rateiosnotasfiscais rt 
                                       where rt.idmatrizdespesa = m.idmatrizregra
                                         and rt.idnotafiscal = :P499_IDNOTAFISCAL
                                         and rt.datavencimento = :DATAVENCIMENTO )
                    ```
            }
            cascadingLov {
                parentColumns: [
                    IDFORNECEDOR
                    IDFILIALDESTINO
                    DATAVENCIMENTO
                ]
            }
            layout {
                sequence: 120
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDMATRIZDESPESA
                dataType: number
            }
        )

