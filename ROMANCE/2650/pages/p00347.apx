page 347 (
    name: Cadastro de Segmentos
    title: Cadastro de Segmentos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }

    region cadastro-de-segmentos (
        name: Cadastro de Segmentos
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P347_CODIGO (
        type: textField
        label {
            label: Código
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @cadastro-de-segmentos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 5
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P347_IDSEGMENTONEGOCIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @cadastro-de-segmentos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P347_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @cadastro-de-segmentos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P347_NOME (
        type: textField
        label {
            label: Segmento
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @cadastro-de-segmentos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P347_OPERACIONAL (
        type: radioGroup
        label {
            label: Operacional
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @cadastro-de-segmentos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P347_TIPO (
        type: radioGroup
        label {
            label: Tipo
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Crisdu;C,Serviço;A,Não Operacional;N,Serviços Internos;I
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @cadastro-de-segmentos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    button criar (
        buttonName: CRIAR
        label: Criar
        layout {
            sequence: 20
            region: @cadastro-de-segmentos
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P347_IDSEGMENTONEGOCIO
        }
    )

    button salvar (
        buttonName: SALVAR
        label: Salvar
        layout {
            sequence: 10
            region: @cadastro-de-segmentos
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P347_IDSEGMENTONEGOCIO
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 30
            region: @cadastro-de-segmentos
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process consulta-em-segmentos (
        name: Consulta em Segmentos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  PCK_CADASTROS_RMC.PRC_SEGMENTOSNEGOCIOS( PIDSEGMENTONEGOCIO => :P347_IDSEGMENTONEGOCIO,
                                                           PNOME => :P347_NOME,
                                                           PTIPO => :P347_TIPO,
                                                           PCODIGO => :P347_CODIGO,
                                                           POPERACIONAL => :P347_OPERACIONAL,
                                                           PMD5 => :P347_MD5,
                                                           POPERACAO_DML => 'S' );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 6173679332480435
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P347_IDSEGMENTONEGOCIO
        }
    )

    process processo-dml-em-segmentos (
        name: "Processo DML em Segmentos "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  --
                  if v('REQUEST') = 'SALVAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'CRIAR' then
                    voperacao_dml := 'I';
                  end if;
                  --
                  PCK_CADASTROS_RMC.PRC_SEGMENTOSNEGOCIOS( PIDSEGMENTONEGOCIO => :P347_IDSEGMENTONEGOCIO,
                                                           PNOME => :P347_NOME,
                                                           PTIPO => :P347_TIPO,
                                                           PCODIGO => :P347_CODIGO,
                                                           POPERACIONAL => :P347_OPERACIONAL,
                                                           PMD5 => :P347_MD5,
                                                           POPERACAO_DML => voperacao_dml );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo realizada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 12298045472489169
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('CRIAR','SALVAR')
                ```
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 347
                items: {
                    P347_IDSEGMENTONEGOCIO: &P347_IDSEGMENTONEGOCIO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('CRIAR','SALVAR')
                ```
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 346
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: VOLTAR
        }
    )

)

