page 28 (
    name: Historico de Compras
    title: Historico de Compras
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region histórico-de-preço-de-custo (
        name: Histórico de Preço de Custo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select h.idhistocompras
                     , pck_romance.fnc_nomefornecedor(h.idfornecedor) Fornecedor
                     , initcap(pr.nomeproduto) Produto
                     , h.precocusto
                     , to_char(h.dtcompra,'DD/MM/YYYY') dtcompra
                from historicocompras h
                   , produtos         pr
                where h.idproduto    = pr.idproduto 
                order by 3 
                       , h.dtcompra desc
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: singleRowView
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt="" />
        }
        singleRowView {
            excludeNullValues: true
            onlyDisplayedColumns: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: This query returns more than 10,000 rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column DTCOMPRA (
            type: plainText
            heading {
                heading: Data Compra
                alignment: center
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: DTCOMPRA
                endUserAlias: E
            }
            enableUsersTo {
                pivot: false
            }
        )

        column FORNECEDOR (
            type: plainText
            heading {
                heading: Fornecedor
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: FORNECEDOR
                endUserAlias: B
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDHISTOCOMPRAS (
            type: hidden
            heading {
                heading: Idhistocompras
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDHISTOCOMPRAS
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column PRECOCUSTO (
            type: plainText
            heading {
                heading: Preco Custo
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: PRECOCUSTO
                endUserAlias: D
            }
            enableUsersTo {
                pivot: false
            }
        )

        column PRODUTO (
            type: plainText
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: PRODUTO
                endUserAlias: C
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 14894 (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn DTCOMPRA (
                sequence: 5
            )

            displayColumn FORNECEDOR (
                sequence: 2
            )

            displayColumn IDHISTOCOMPRAS (
                sequence: 1
            )

            displayColumn PRECOCUSTO (
                sequence: 4
            )

            displayColumn PRODUTO (
                sequence: 3
            )

            controlBreak (
                column: FORNECEDOR
                layout {
                    sequence: 1
                }
            )

        )

    )

)

