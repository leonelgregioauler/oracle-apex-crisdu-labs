page 269 (
    name: Telefones
    title: Telefones
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region telefones (
        name: Telefones
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDTELEFONEPESSOA",
                "IDTELEFONEPESSOA" IDTELEFONEPESSOA_DISPLAY,
                "IDPESSOA",
                "IDOPERADORATEL",
                "TELEFONE"
                from "CATAL"."TELEFONESPESSOAS"
                where idpessoa = :P269_IDPESSOA
                ```
        }
        layout {
            sequence: 15
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: Informe somente os números! (Ex.: 5198765432)
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: -
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 1
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column IDOPERADORATEL (
            reportColumnQueryId: 5
            derivedColumn: N
            type: radioGroup
            heading {
                heading: Operadora
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nome||' - '||ddd display_value
                        , idoperadoratel return_value
                    from operadorastelefonia
                    order by 1
                    ```
                displayNullValue: false
            }
            layout {
                sequence: 5
            }
            element {
                numberOfColumns: 3
            }
        )

        column IDPESSOA (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 4
            }
            default {
                type: item
                item: P269_IDPESSOA
            }
        )

        column IDTELEFONEPESSOA (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDTELEFONESPESSOA
            }
        )

        column IDTELEFONEPESSOA_DISPLAY (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

        column TELEFONE (
            reportColumnQueryId: 6
            derivedColumn: N
            type: textField
            heading {
                heading: Telefone
                alignment: center
            }
            layout {
                sequence: 6
            }
            appearance {
                width: 16
            }
        )

    )

    pageItem P269_IDPESSOA (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) 
                         ||' ('||pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(r.idrepresentante))||')'  display_value
                     , idpessoa
                from representantes r
                --where r.ativo = 'S'
                order by 1
                ```
            nullDisplayValue: - Selecione o Representante -
        }
        layout {
            sequence: 10
            region: @telefones
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 4000
        }
        security {
            encryptSessionState: false
        }
    )

    button add (
        buttonName: ADD
        label: Adicionar Linha
        layout {
            sequence: 40
            region: @telefones
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.widget.tabular.addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P269_IDPESSOA
        }
    )

    button multi-row-delete (
        buttonName: MULTI_ROW_DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @telefones
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'MULTI_ROW_DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P269_IDPESSOA
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Salvar
        layout {
            sequence: 30
            region: @telefones
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P269_IDPESSOA
        }
    )

    dynamicAction filtra-representante (
        name: filtra representante
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P269_IDPESSOA
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation idoperadoratel-must-be-numeric (
        name: IDOPERADORATEL must be numeric
        execution {
            sequence: 40
        }
        validation {
            editableRegion: @telefones
            type: columnIsNumeric
            column: IDOPERADORATEL
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: IDOPERADORATEL
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation idpessoa-must-be-numeric (
        name: IDPESSOA must be numeric
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @telefones
            type: columnIsNumeric
            column: IDPESSOA
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: IDPESSOA
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @telefones
        target {
            tableOwner: CATAL
            tableName: TELEFONESPESSOAS
            pkColumn: IDTELEFONEPESSOA
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: #MRD_COUNT# row(s) deleted.
        }
        advanced {
            executionMappingIdentifier: 520915403508530467
        }
        serverSideCondition {
            type: request=Value
            value: MULTI_ROW_DELETE
            executeCondition: once
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @telefones
        target {
            tableOwner: CATAL
            tableName: TELEFONESPESSOAS
            pkColumn: IDTELEFONEPESSOA
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# row(s) updated, #MRI_COUNT# row(s) inserted.
        }
        advanced {
            executionMappingIdentifier: 520915214301530465
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 269
                items: {
                    P269_IDPESSOA: &P269_IDPESSOA.
                }
            }
        }
    )

)

