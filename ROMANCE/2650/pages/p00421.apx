    region top-bojos-2 (
        name: Top Bojos - 2018
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                 select pck_romance.fnc_nomefilial(1061) filial
                               , '-' mes 
                               , '0' numero
                               , 2018 ano
                               , null mesano
                               , ( nvl(( select sum(valordeposito)
                                      from depositosdiarios d
                                         , pagamentosfornecedores pf
                                      where d.tipo = 'AB'
                                        and d.idfilialfornecedor = 1061
                                        and d.idpgtoforn = pf.idpgtoforn
                                        and to_number(to_char(d.data,'RRRR')) <= 2018 ),0)
                                +  nvl( ( select sum(vr.valor)
                                      from notasfiscais nv 
                                         , vencimentosreceber vr
                                         , depositosdiarios dd
                                         , pagamentosfornecedores pf
                                      where nv.tiponota = 'V'
                                        and nv.idnotafiscal     = vr.idnotafiscal
                                        and vr.idvencimento     = dd.idvencimentoabatimento
                                        and dd.idpgtoforn       = pf.idpgtoforn
                                        and to_number(to_char(dd.data,'RRRR')) <= 2018
                                          and exists ( select 1
                                                       from notasfiscais nc
                                                       where nc.idnotafiscal = nv.idnotafiscalcompra 
                                                         and nc.idfornemitente = pck_romance.fnc_fornecedorfilial( 1061 ))),0) )   "Abatimentos"
                               , nvl( ( select sum(vr.valor) valor
                                    from notasfiscais nv 
                                       , vencimentosreceber vr
                                       , depositosdiarios dd
                                       , pagamentosfornecedores pf
                                    where nv.tiponota = 'V'
                                      and nv.idnotafiscal     = vr.idnotafiscal
                                      and vr.idvencimento     = dd.idvencimentoabatimento(+) 
                                      and dd.idpgtoforn       = pf.idpgtoforn(+)
                                      and to_number(to_char(vr.datavencimento,'RRRR')) <= 2018
                                      and not exists ( select 1
                                                       from notasfiscais nc2 
                                                       where nc2.idnotafiscal = pf.idnotafiscal )
                                       and exists ( select 1
                                                     from notasfiscais nc
                                                     where nc.idnotafiscal = nv.idnotafiscalcompra 
                                                       and nc.idfornemitente = pck_romance.fnc_fornecedorfilial( 1061 ) )  ),0) "Crédito"
                               , (nvl(( select sum(nvl(e.valortotal,0))
                                       from entradasdiversas e
                                       where to_number(to_char( e.data,'RRRR')) <= 2018
                                         and e.idfilial = 1061),0)
                                 + nvl( ( select sum(dd.valordeposito)
                                        from depositosdiarios dd
                                        where dd.valordeposito > 0
                                          and exists ( select 1--sum(nvl(pgf.valorpagar,0))
                                                       from pagamentosfornecedores pgf
                                                       where pgf.idfilial        = 1061
                                                         and pgf.idpgtoforn = dd.idpgtoforn )
                                          and to_number(to_char( dd.data,'RRRR')) <= 2018 ),0) 
                                  + 18691635.19 -- por causa da limpeza 29/2016
                                  )*-1 "Dinheiro recebido"
                               , nvl(( select sum(nvl(s.valortotal,0))
                                       from saidasdiversas s
                                       where to_number(to_char( s.data,'RRRR')) <= 2018
                                         and s.idfilial = 1061),0) 
                                  + 977878.53
                                     "Saídas Diversas"
                               , nvl(( select sum(f.valornobanco)
                                   from fechamentossemanais f
                                   where f.idfilial = 1061
                                     and to_number(substr(trim(f.mesvalornobanco),4,4)) <= 2018 ),0)
                                  + 7901529.93-- por causa da limpeza 29/2016  
                                  "Entradas Banco"
                               , ( nvl(( select sum(valordeposito)
                                      from depositosdiarios d
                                         , pagamentosfornecedores pf
                                      where d.tipo = 'AB'
                                        and d.idfilialfornecedor = 1061
                                        and d.idpgtoforn = pf.idpgtoforn
                                        and to_number(to_char(d.data,'RRRR')) <= 2018 ),0)
                                +  nvl( ( select sum(vr.valor)
                                      from notasfiscais nv 
                                         , vencimentosreceber vr
                                         , depositosdiarios dd
                                         , pagamentosfornecedores pf
                                      where nv.tiponota = 'V'
                                        and nv.idnotafiscal     = vr.idnotafiscal
                                        and vr.idvencimento     = dd.idvencimentoabatimento
                                        and dd.idpgtoforn       = pf.idpgtoforn
                                        and to_number(to_char(dd.data,'RRRR')) <=2018
                                          and exists ( select 1
                                                       from notasfiscais nc
                                                       where nc.idnotafiscal = nv.idnotafiscalcompra 
                                                         and nc.idfornemitente = pck_romance.fnc_fornecedorfilial( 1061 ))),0) )  ---"Abatimentos"
                               - (nvl(( select sum(nvl(e.valortotal,0))
                                       from entradasdiversas e
                                       where to_number(to_char( e.data,'RRRR')) <= 2018
                                         and e.idfilial = 1061),0)
                                 + nvl( ( select sum(dd.valordeposito)
                                        from depositosdiarios dd
                                        where dd.valordeposito > 0
                                          and exists ( select 1--sum(nvl(pgf.valorpagar,0))
                                                       from pagamentosfornecedores pgf
                                                       where pgf.idfilial        = 1061
                                                         and pgf.idpgtoforn = dd.idpgtoforn )
                                          and to_number(to_char( dd.data,'RRRR')) <= 2018 ) ,0) 
                                  + 18691635.19 -- por causa da limpeza 29/2016
                                  )--*-1 "Dinheiro recebido"
                               + nvl(( select sum(nvl(s.valortotal,0))
                                       from saidasdiversas s
                                       where to_number(to_char( s.data,'RRRR')) <= 2018 
                                         and s.idfilial = 1061),0) 
                                  + 977878.53 -- por causa da limpeza 29/2016  "Saidas Diversas"
                               + nvl(( select sum(f.valornobanco)
                                   from fechamentossemanais f
                                   where f.idfilial = 1061
                                     and to_number(substr(trim(f.mesvalornobanco),4,4)) <= 2018 ) ,0)
                                     + 7901529.93-- por causa da limpeza 29/2016    "Entradas Banco"
                               +nvl( ( select sum(vr.valor) valor
                                        from notasfiscais nv 
                                           , vencimentosreceber vr
                                           , depositosdiarios dd
                                           , pagamentosfornecedores pf
                                        where nv.tiponota = 'V'
                                          and nv.idnotafiscal     = vr.idnotafiscal
                                          and vr.idvencimento     = dd.idvencimentoabatimento(+) 
                                          and dd.idpgtoforn       = pf.idpgtoforn(+)
                                          and to_number(to_char(vr.datavencimento,'RRRR')) <= 2018
                                          and not exists ( select 1
                                                           from notasfiscais nc2 
                                                           where nc2.idnotafiscal = pf.idnotafiscal )
                                           and exists ( select 1
                                                         from notasfiscais nc
                                                         where nc.idnotafiscal = nv.idnotafiscalcompra 
                                                           and nc.idfornemitente = pck_romance.fnc_fornecedorfilial( 1061 ) )  ),0) Resultado
                from dual 
                where 1 = 2
                ```
        }
