    region acompanhamento-anual-da-top-bojos (
        name: Acompanhamento Anual da Top Bojos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.filial
                     , t.ano
                     , t.abatimentos          "Abatimentos"
                     , t.credito              "Crédito"
                     , t.pagamentos           "Pagamentos"
                     , t.saidasdiversas       "Saídas Diversas"
                     , t.entradasbancos       "Entradas Banco"
                     , t.rateiogrupos         "Rateio Grupo"
                     , t.resultado            Resultado
                     , t.resultado_com_rateio Resultado_com_rateio
                from resultado_topbojos t
                union
                select filial
                     , ano
                     , sum(abatimentos)     abatimentos
                     , sum(credito)         credito
                     , sum(dhrecebido)      pagamentos
                     , sum(saidasdiversas)  saidasdiversas
                     , sum(entradasbanco)   entradasbancos
                     , sum(rateios)         rateiogrupos
                     ,  sum(abatimentos
                      + credito
                      + dhrecebido --está com *-1
                      + entradasbanco)     Resultado
                     ,  sum(abatimentos
                      + credito
                      + dhrecebido --está com *-1
                      + entradasbanco 
                      + rateios)    Resultado_com_rateio
                from (  select pck_romance.fnc_nomefilial(1061) filial
                             , a.ano
                             -- pega todos abatimentos recebidos
                             ,  nvl( ( select sum(vr.valor)
                                       from notasfiscais nv 
                                          , vencimentosreceber vr
                                          , depositosdiarios_orig dd
                                       where nv.tiponota         = 'V'
                                         and nv.idnotafiscal     = vr.idnotafiscal
                                         and vr.idvencimento     = dd.idvencimentoabatimento
                                         and to_char(dd.data,'MM/RRRR') = trim(m.numero||'/'||a.ano)
                                         and exists ( select 1
                                                      from notasfiscais nc
                                                      where nc.idnotafiscal = nv.idnotafiscalcompra 
                                                        and nc.idfornemitente = pck_romance.fnc_fornecedorfilial( 1061 ))),0) 
                             + nvl( ( select sum(v.valor)
                                      from notasfiscais nf
                                         , vencimentos v
                                      where nf.idfornemitente = 2099
                                        and nf.idfilialdestino = 1075
                                        and v.idnotafiscal = nf.idnotafiscal
                                        and to_char(v.datavencimento,'MM/RRRR') = trim(m.numero||'/'||:P421_ANO) ),0) abatimentos
                             -- abatimentos que faltam ser feitos
                             , nvl( ( select sum(vr.valor) valor
                                      from notasfiscais nv 
                                         , vencimentosreceber vr
                                      where nv.tiponota = 'V'
                                        and nv.idnotafiscal     = vr.idnotafiscal
                                        and not exists ( select 1
                                                         from depositosdiarios_orig  d
                                                         where d.idvencimentoabatimento = vr.idvencimento )
                                        and to_char(vr.datavencimento,'MM/RRRR') = trim(m.numero||'/'||a.ano)
                                        and not exists ( select 1
                                                         from notasfiscais nc2 
                                                         where nc2.idnotafiscalcompra = nv.idnotafiscal )
                                         and exists ( select 1
                                                       from notasfiscais nc
                                                       where nc.idnotafiscal = nv.idnotafiscalcompra 
                                                         and nc.idfornemitente = pck_romance.fnc_fornecedorfilial( 1061 ) )  ),0) credito
                             --entradas diversas
                             , ( nvl( ( select sum(d.valor)
                                        from vw_despesascentroscustos_m d
                                        where d.idunidadedenegocio = 56
                                          and d.ano = a.ano
                                          and d.mes = m.numero
                                          and not exists ( select 1
                                                           from rateioscentroscustos rr
                                                           where rr.idcentrodecusto = d.idcentrodecusto
                                                             and rr.percentual is not null ) ),0) )*-1  dhrecebido
                             -- saidas diversas
                             , nvl(( select sum(nvl(s.valortotal,0))
                                     from saidasdiversas s
                                     where to_char( s.data,'MM/RRRR') = trim(m.numero||'/'||a.ano) 
                                       and s.idfilial = 1061),0) saidasdiversas
                             -- valor no banco          
                             , nvl(( select sum(f.valornobanco)
                                     from fechamentossemanais f
                                     where f.idfilial = 1061
                                       and trim(f.mesvalornobanco) = trim(m.numero||'/'||a.ano)),0) 
                                 + nvl(( select sum(valor) valor
                                        from registroscontasbancarias r
                                           , filiais                  f
                                        where r.idunidadedenegocio   = f.idunidadedenegocio  
                                          and f.idfilial             = 1061 
                                          and r.ano                  = a.ano
                                          and r.idmes                = m.numero ),0)      entradasbanco
                             -- rateios
                             , nvl( pck_centrodecustos_rmc.fnc_valoresrateios( pidunidadedenegocio => 56,
                                                                               pmesinicial => m.numero,
                                                                               pmesfinal => m.numero,
                                                                               pano => a.ano),0 )*-1  rateios
                        from meses m
                           , anos a
                        where a.ano = 2022 )
                group by ano
                        , filial
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
