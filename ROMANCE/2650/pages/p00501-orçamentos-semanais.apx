    region orçamentos-semanais (
        name: Orçamentos Semanais
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT f.idorcamentocomprafinanceiro
                     , f.idsemana
                     , f.valordisponivelsemana orcamento_semana
                     , nvl(( SELECT SUM(op.valororcamento)
                             FROM roman.orcamentospedidoscompras op
                             WHERE op.idsemana = f.idsemana ),0) orcamento_fornec
                     , nvl(( SELECT SUM(it.valortotal)
                             FROM roman.pedidoscomprasroman pd
                                , roman.itenspedidocompraroman it
                             WHERE pd.idpedidocompraroman = it.idpedidocompraroman
                               AND pd.idsemanaentrega = f.idsemana ),0) orcamento_realizado
                FROM roman.orcamentoscomprasfinanceiro f
                WHERE ( :P501_SEMANAINICIAL is null or f.idsemana BETWEEN ( SELECT s.idsemana
                                                                            FROM roman.semana_dias s
                                                                            WHERE s.semanacompleta = :P501_SEMANAINICIAL ) AND ( SELECT s.idsemana
                                                                                                                                 FROM roman.semana_dias s
                                                                                                                                 WHERE s.semanacompleta = :P501_SEMANAFINAL ))
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
