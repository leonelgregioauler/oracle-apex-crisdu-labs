    process orçamentos-semanais-save-interactive-grid-data (
        name: Orçamentos Semanais - Save Interactive Grid Data
        type: executeCode
        editableRegion: @orçamentos-semanais
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  v_md5            VARCHAR2(4000);
                  v_operacao       VARCHAR2(1);
                  v_id             NUMBER;
                  v_valor          NUMBER;
                  v_semana_atual   NUMBER;
                  v_semanaexist    VARCHAR2(1);
                BEGIN
                  -- Descobre a operação primeiro
                  IF :APEX$ROW_STATUS = 'C' THEN
                    v_operacao := 'I';
                  ELSIF :APEX$ROW_STATUS = 'D' THEN
                    v_operacao := 'D';
                  ELSE
                    v_operacao := 'U';
                  END IF;
                   
                  --Verifica se existe orçamento para a semana
                  BEGIN
                    --
                    SELECT 'S'
                    INTO v_semanaexist
                    FROM roman.orcamentoscomprasfinanceiro oc
                    WHERE oc.idsemana = :IDSEMANA;
                    --
                  EXCEPTION
                    WHEN OTHERS THEN 
                    v_semanaexist := 'N';
                    --
                  END;
                  -- Buscar semana atual com base na data do sistema
                  SELECT idsemana
                    INTO v_semana_atual
                    FROM semana_dias
                   WHERE TRUNC(SYSDATE) BETWEEN dt_ini AND dt_fim;
                
                  -- Validar se a semana informada é menor que a atual
                  IF v_semanaexist = 'S' and v_operacao in ('I') THEN
                    -- Alternativa ao raise_application_error explicada abaixo
                    APEX_ERROR.ADD_ERROR (
                      p_message => 'Já existe orçamento para a semana',
                      p_display_location => APEX_ERROR.c_inline_in_notification
                    );
                    RETURN;
                  /*ELSIF :IDSEMANA < v_semana_atual AND v_operacao in ('I','U') THEN
                    -- Alternativa ao raise_application_error explicada abaixo
                    APEX_ERROR.ADD_ERROR (
                      p_message => 'A semana deve ser igual ou maior que a atual.',
                      p_display_location => APEX_ERROR.c_inline_in_notification
                    );
                    RETURN;*/
                  END IF;
                
                  -- Carregar valores das variáveis
                  v_id    := :IDORCAMENTOCOMPRAFINANCEIRO;
                  v_valor := NVL(TO_NUMBER(:ORCAMENTO_SEMANA, '999G999G999G999G990D00'), 0);
                
                  -- Executar procedure
                  pck_compras_romance.prc_orcamentoscomprasfinanceiro (
                    pidorcamentocomprafin => v_id,
                    pidsemana             => :IDSEMANA,
                    pvalordisponivelsem   => v_valor,
                    pmd5                  => v_md5,
                    poperacao_dml         => v_operacao
                  );
                
                
                  -- Atualizar item da página
                  :IDORCAMENTOCOMPRAFINANCEIRO := v_id;
                
                
                END;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 49947774652554508
        }
    )

