        column IDSEMANA (
            type: selectList
            heading {
                heading: Semana
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT s.semanacompleta || ' - ' || s.dt_ini || ' a ' || s.dt_fim AS display_value
                         , s.idsemana         AS return_value
                    FROM   semana_dias s
                    WHERE  s.ano BETWEEN EXTRACT(YEAR FROM SYSDATE) - 2
                                     AND EXTRACT(YEAR FROM SYSDATE) + 1
                    ORDER  BY s.dt_ini desc;
                    
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
