page 312 (
    name: Cadastro de Fornecedores do Grupo
    title: Cadastro de Fornecedores do Grupo
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region cadastro-de-fornecedores-do-grupo (
        name: Cadastro de Fornecedores do Grupo
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDFORNECEDORGRUPO",
                "IDGRUPOFORNECEDOR",
                "IDFORNECEDOR"
                from "#OWNER#"."FORNECEDORESGRUPOSFORN"
                where "IDGRUPOFORNECEDOR" = :P312_IDGRUPOFORNECEDOR
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P312_IDGRUPOFORNECEDOR
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado.
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 4
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column IDFORNECEDOR (
            reportColumnQueryId: 3
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Fornecedor
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_romance.fnc_nomefornecedor(f.idfornecedor) display_value
                         , idfornecedor
                    from fornecedores f
                    where f.ativo = 'S'
                    order by 1
                    ```
            }
            layout {
                sequence: 4
            }
            appearance {
                width: 16
            }
        )

        column IDFORNECEDORGRUPO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDFORNECEDORGRUPO
            }
        )

        column IDGRUPOFORNECEDOR (
            reportColumnQueryId: 2
            derivedColumn: N
            type: textField
            heading {
                heading: IDGRUPO
                alignment: center
            }
            layout {
                sequence: 3
            }
            appearance {
                width: 10
            }
            default {
                type: item
                item: P312_IDGRUPOFORNECEDOR
            }
            advanced {
                customAttributes: readonly
            }
        )

    )

    region cadastro-de-grupos-de-fornecedores (
        name: Cadastro de Grupos de Fornecedores
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P312_DESCRICAO (
        type: textField
        label {
            label: Descrição
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @cadastro-de-grupos-de-fornecedores
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P312_IDGRUPOFORNECEDOR (
        type: displayOnly
        label {
            label: ID Grupo
            alignment: left
        }
        layout {
            sequence: 10
            region: @cadastro-de-grupos-de-fornecedores
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P312_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @cadastro-de-grupos-de-fornecedores
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button add (
        buttonName: ADD
        label: Adicionar +
        layout {
            sequence: 50
            region: @cadastro-de-fornecedores-do-grupo
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.widget.tabular.addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button criar (
        buttonName: CRIAR
        label: Criar
        layout {
            sequence: 30
            region: @cadastro-de-grupos-de-fornecedores
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P312_IDGRUPOFORNECEDOR
        }
    )

    button deletar (
        buttonName: DELETAR
        label: Deletar
        layout {
            sequence: 20
            region: @cadastro-de-fornecedores-do-grupo
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Deseja realmente excluir?','DELETAR');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button salvar (
        buttonName: SALVAR
        label: Salvar
        layout {
            sequence: 10
            region: @cadastro-de-grupos-de-fornecedores
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P312_IDGRUPOFORNECEDOR
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Cadastrar
        layout {
            sequence: 40
            region: @cadastro-de-fornecedores-do-grupo
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 20
            region: @cadastro-de-grupos-de-fornecedores
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 311
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @voltar
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @cadastro-de-fornecedores-do-grupo
        target {
            tableName: FORNECEDORESGRUPOSFORN
            pkColumn: IDFORNECEDORGRUPO
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: #MRD_COUNT# linha(s) deletada(s).
        }
        advanced {
            executionMappingIdentifier: 1575601762670653417
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
            executeCondition: once
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @cadastro-de-fornecedores-do-grupo
        target {
            tableName: FORNECEDORESGRUPOSFORN
            pkColumn: IDFORNECEDORGRUPO
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# linha(s) atualizada(s), #MRI_COUNT# linha(s) inserida(s).
        }
        advanced {
            executionMappingIdentifier: 1575601353873653414
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process consulta-em-grupos-de-fornecedores (
        name: Consulta em Grupos de Fornecedores
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                  --
                  pCK_CADASTROS_RMC.PRC_GRUPOSFORNECEDORES( PIDGRUPOFORNECEDOR => :P312_IDGRUPOFORNECEDOR,
                                                            PDESCRICAO => :P312_DESCRICAO,
                                                            PMD5 => :P312_MD5,
                                                            POPERACAO_DML => 'S');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1575615967782948702
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P312_IDGRUPOFORNECEDOR
        }
    )

    process processo-dml-em-grupos-de-fornecedores (
        name: Processo DML em Grupos de Fornecedores
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  --
                  if v('REQUEST') = 'CRIAR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'SALVAR' then
                    voperacao_dml := 'U';
                  end if;
                  --
                  PCK_CADASTROS_RMC.PRC_GRUPOSFORNECEDORES( PIDGRUPOFORNECEDOR => :P312_IDGRUPOFORNECEDOR,
                                                            PDESCRICAO => :P312_DESCRICAO,
                                                            PMD5 => :P312_MD5,
                                                            POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Processo executado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1575609804125843546
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('CRIAR','SALVAR')
                ```
        }
    )

    branch (
        name: Go To Page 312
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 312
                items: {
                    P312_IDGRUPOFORNECEDOR: &P312_IDGRUPOFORNECEDOR.
                }
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where v('REQUEST') in ('CRIAR','SALVAR','SUBMIT','DELETAR')
                ```
        }
    )

)

