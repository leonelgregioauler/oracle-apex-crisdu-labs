    region ranking-da-campanha (
        name: Ranking da Campanha
        type: plugin/d3BarChart
        source {
            sqlQuery:
                ```sql
                select w.filial
                     , sum(nvl(w.pontos,0)) pontos
                from vw_pontuacaocampanha w
                where w.idsemana between :P411_IDSEMANAINI and :P411_IDSEMANAFIM
                  and w.idfilial in (1089,1090,1106,1132,124,320,122)
                group by w.filial
                order by 2 desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            xValuesColumn: FILIAL
            yValuesColumn: PONTOS
            display: horizontalSideBySide
            seriesName: Ranking
            tooltips: [
                showXValue
                showYValue
            ]
            showGridLines: [
                xAxis
                yAxis
            ]
            colorScheme: modern2
        }
    )

    pageItem P411_IDSEMANAFIM (
        type: selectList
        label {
            label: Até Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.semanacompleta 
                     , s.idsemana
                from semana_dias s
                   , campanhas c
                where c.tipocampanha = 'M'
                  and s.idsemana between pck_util.fnc_idsemana(c.semanaini) and pck_util.fnc_idsemana(c.semanafim) 
                order by 2
                ```
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P411_IDSEMANAINI (
        type: selectList
        label {
            label: Semana De
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.semanacompleta 
                     , s.idsemana
                from semana_dias s
                   , campanhas c
                where c.tipocampanha = 'M'
                  and s.idsemana between pck_util.fnc_idsemana(c.semanaini) and pck_util.fnc_idsemana(c.semanafim) 
                order by 2
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction recarrega-pagina (
        name: Recarrega Pagina
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P411_IDSEMANAFIM
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction recarregar-pagina (
        name: Recarregar Pagina _ 1
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P411_IDSEMANAINI
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction tipo-semana (
        name: Tipo Semana
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P411_TIPO_PESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P411_TIPO_PESQUISA
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P411_IDSEMANA
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P411_IDSEMANA_INI
                    P411_IDSEMANA_FIM
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P411_IDSEMANA
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P411_IDSEMANA_INI
                    P411_IDSEMANA_FIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 411
                items: {
                    P411_IDSEMANAINI: &P411_IDSEMANAINI.
                    P411_IDSEMANAFIM: &P411_IDSEMANAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: FILTRAR
        }
    )

)

