    region quadro-de-medalhas (
        name: Quadro de Medalhas
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select *
                from (
                      select w.filial
                           , w.nivel
                      from vw_pontuacaocampanha w
                      where w.idsemana between :P411_IDSEMANAINI and :P411_IDSEMANAFIM
                        and w.idfilial in (1089,1090,1106,1132,124,320,122) 
                     )
                pivot
                     (
                     count(nivel)
                     for nivel in ('Bronze' as Bronze ,'Diamante' as Diamante,'Prata' as Prata,'Ouro' as Ouro,'Nenhum' as Nenhum)
                     )
                ```
        }
        layout {
            sequence: 50
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent10
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 30
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

