    region pontuação (
        name: Pontuação
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.filial
                     , w.metrica
                     , sum(w.media) media
                     , sum(nvl(w.pontos,0)) pontos
                from vw_pontuacaocampanha w
                where w.idsemana between :P411_IDSEMANAINI and :P411_IDSEMANAFIM
                  and w.idfilial in (1089,1090,1106,1132,124,320,122)
                group by  w.filial
                       , w.metrica
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 11246517988830592907
        }

