    region pontuação-geral (
        name: Pontuação Geral
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.filial
                     , f.grupo
                     , sum(w.media) media
                     , sum(nvl(w.pontos,0)) pontos
                from vw_pontuacaocampanha w
                   , vw_filiais f
                where f.idfilial = w.idfilial
                  and w.idsemana between :P411_IDSEMANAINI and :P411_IDSEMANAFIM
                  and  w.idfilial in (1089,1090,1106,1132,124,320,122)
                group by w.filial
                       , f.grupo
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
