    region upload-a-file (
        name: Upload a File
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @importar-funcionários-demitidos
            slot: regionBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNull
            item: P323_FILE
        }
        settings {
            outputAs: text
        }
    )

    pageItem P323_ERROR_ROW_COUNT (
        type: hidden
        layout {
            sequence: 20
            region: @upload-a-file
            slot: regionBody
        }
    )

    pageItem P323_FILE (
        type: fileUpload
        label {
            label: Upload a File
            alignment: left
        }
        display {
            displayAs: blockDropzone
            dropzoneDesc: Supported formats CSV, TXT
        }
        storage {
            type: appTempFiles
            maxFileSize: 5000
        }
        layout {
            sequence: 10
            region: @upload-a-file
            slot: regionBody
            alignment: left
            labelColumnSpan: 0
        }
        appearance {
            template: @/hidden
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
    )

    pageItem P323_FILE_NAME (
        type: displayOnly
        label {
            label: Loaded File
            alignment: left
        }
        layout {
            sequence: 20
            region: @loaded-file
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: Pasted Data
        }
    )

    button clear (
        buttonName: CLEAR
        label: Clear
        layout {
            sequence: 10
            region: @button-bar
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button load (
        buttonName: LOAD
        label: Processar
        layout {
            sequence: 20
            region: @button-bar
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction upload-a-file (
        name: Upload a File
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P323_FILE
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P323_FILE
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation is-valid-file-type (
        name: Is valid file type
        execution {
            sequence: 10
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                if apex_data_parser.assert_file_type(
                       p_file_name => :P323_FILE_NAME,
                       p_file_type => apex_data_parser.c_file_type_csv )
                then
                    return true;
                else
                    :P323_FILE := null;
                    return false;
                end if;
                ```
        }
        error {
            errorMessage: Invalid file type. Supported file types CSV, TXT.
            associatedItem: @P323_FILE
        }
    )

    computation p323-file-name (
        itemName: P323_FILE_NAME
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            sqlQuery:
                ```sql
                select filename
                  from apex_application_temp_files 
                 where name = :P323_FILE
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P323_FILE
        }
    )

    process clear-cache (
        name: Clear Cache
        type: clearSessionState
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 702390063422137563
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'CLEAR' or :P323_ERROR_ROW_COUNT = 0
        }
    )

    process load-data (
        name: Load Data
        type: dataLoading
        dataLoading {
            dataLoadDefinition: @funcion_rios_crisdu_csv_demitidos
        }
        sourceData {
            fileBrowseItem: P323_FILE
        }
        processingResult {
            errorRowCountItem: P323_ERROR_ROW_COUNT
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 702389605800137563
        }
        serverSideCondition {
            whenButtonPressed: @load
        }
    )

    process processa-integração (
        name: Processa integração
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  -- Local variables here
                  vidpessoa      number; 
                  vativo         varchar2(1) := 'N';
                  vafastamento   varchar2(1) := 'S';
                  vsqlerrm       varchar2(4000);
                  --
                begin
                  -- Test statements here
                  --
                  UPDATE FUNCIONARIOS_CRISDU_DEMITIDOS f  
                  SET cpf = replace(replace(replace(trim(cpf),'.',''),',',''),'-','') 
                  WHERE  instr(cpf,'.') > 1
                     or  instr(cpf,',') > 1
                     or  instr(cpf,'-') > 1
                     or  instr(cpf,' ') > 1 ;
                  --
                  UPDATE FUNCIONARIOS_CRISDU_DEMITIDOS f  
                  SET cpf = lpad(replace(replace(replace(trim(cpf),'.',''),',',''),'-','') ,11,'0') 
                  WHERE  LENGTH(cpf) < 11;
                  --
                  --delete  FUNCIONARIOS_CRISDU_DEMITIDOS f;
                  --where datademissao < sysdate - 20 ;
                  --  
                  for i in ( SELECT ( SELECT f.idvendedora
                                         FROM pessoas p
                                            , vendedoras f
                                         WHERE p.cpf = f.cpf
                                           AND f.idpessoa = p.idpessoa )  idvendedora
                                 , ( SELECT f.idfuncionario
                                         FROM pessoas p
                                            , funcionarios f
                                         WHERE p.cpf = f.cpf
                                           AND f.idpessoa = p.idpessoa )  idfuncionario
                                 , ( SELECT p.idpessoa
                                         FROM pessoas p
                                         WHERE p.cpf = f.cpf )  idpessoa
                                 , ( select idcidade
                                     from cidades c
                                        , estados e
                                     where upper(c.nomecidade) = upper(f.cidade) 
                                       and e.idestado = c.idestado
                                       and trim(e.sigla) = trim(f.uf) ) idcidade
                                 , f.*
                              FROM FUNCIONARIOS_CRISDU_DEMITIDOS f
                              where datademissao is not null 
                                --and datademissao > sysdate - 20
                                 )
                  loop
                    --
                           --
                           UPDATE funcionarios  
                           SET ativo = vativo
                             , afastamento  = vafastamento
                           WHERE idfuncionario = i.idfuncionario;
                           --
                           UPDATE vendedoras
                           SET ativo = vativo
                             , created_time = sysdate
                             , updated_time = SYSDATE 
                           WHERE idvendedora = i.idvendedora;
                           --
                       -- 
                  end loop;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 697379239134545128
        }
    )

    branch (
        name: Go To Page 325
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 325
            }
        }
        serverSideCondition {
            whenButtonPressed: @load
        }
    )

)

