page 324 (
    name: Importar Funcionários
    alias: IMPORTAR-FUNCIONARIOS
    title: Importar Funcionários
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }

    region arquivo-importado (
        name: Arquivo Importado
        type: staticContent
        layout {
            sequence: 40
            parentRegion: @importar-funcionários-ativos-afastados
            slot: regionBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P324_FILE
        }
        settings {
            outputAs: text
        }
    )

    region button-bar (
        name: Button Bar
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noUI
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P324_FILE
        }
        settings {
            outputAs: text
        }
    )

    region importar-funcionários-ativos-afastados (
        name: Importar Funcionários Ativos/Afastados
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--accent4
                t-Region--noUI
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    region preview (
        name: Preview
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.line_number,
                       p.col001, p.col002, p.col003, p.col004, p.col005, p.col006, p.col007, p.col008, p.col009, p.col010
                       -- add more columns (col011 to col300) here.
                  from apex_application_temp_files f, 
                       table( apex_data_parser.parse(
                                  p_content           => f.blob_content,
                                  p_file_name         => f.filename,
                                  p_file_profile      => apex_data_loading.get_file_profile( p_static_id => 'funcion_rios_crisdu_csv' ),
                                  p_max_rows          => 100 ) ) p
                 where f.name = :P324_FILE
                ```
        }
        layout {
            sequence: 80
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P324_FILE
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--horizontalBorders
                t-Report--hideNoPagination
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: no data found
        }
        heading {
            type: none
        }

        column COL001 (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Col001
            }
            layout {
                sequence: 2
            }
            sorting {
                defaultSequence: 1
                sortable: false
            }
        )

        column COL002 (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Col002
            }
            layout {
                sequence: 3
            }
            sorting {
                defaultSequence: 1
                sortable: false
            }
        )

        column COL003 (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Col003
            }
            layout {
                sequence: 4
            }
            sorting {
                defaultSequence: 1
                sortable: false
            }
        )

        column COL004 (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Col004
            }
            layout {
                sequence: 5
            }
            sorting {
                defaultSequence: 1
                sortable: false
            }
        )

        column COL005 (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Col005
            }
            layout {
                sequence: 6
            }
            sorting {
                defaultSequence: 1
                sortable: false
            }
        )

        column COL006 (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Col006
            }
            layout {
                sequence: 7
            }
            sorting {
                defaultSequence: 1
                sortable: false
            }
        )

        column COL007 (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Col007
            }
            layout {
                sequence: 8
            }
            sorting {
                defaultSequence: 1
                sortable: false
            }
        )

        column COL008 (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Col008
            }
            layout {
                sequence: 9
            }
            sorting {
                defaultSequence: 1
                sortable: false
            }
        )

        column COL009 (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Col009
            }
            layout {
                sequence: 10
            }
            sorting {
                defaultSequence: 1
                sortable: false
            }
        )

        column COL010 (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: Col010
            }
            layout {
                sequence: 11
            }
            sorting {
                defaultSequence: 1
                sortable: false
            }
        )

        column LINE_NUMBER (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Line Number
                alignment: end
            }
            layout {
                sequence: 1
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

    )

    region selecionar-arquivo (
        name: Selecionar arquivo
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @importar-funcionários-ativos-afastados
            slot: regionBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNull
            item: P324_FILE
        }
        settings {
            outputAs: text
        }
    )

    pageItem P324_ERROR_ROW_COUNT (
        type: hidden
        layout {
            sequence: 20
            region: @selecionar-arquivo
            slot: regionBody
        }
    )

    pageItem P324_FILE (
        type: fileUpload
        label {
            label: Arquivo Selecionado
            alignment: left
        }
        display {
            displayAs: blockDropzone
            dropzoneDesc: Supported formats CSV, TXT
        }
        storage {
            type: appTempFiles
            maxFileSize: 5000
        }
        layout {
            sequence: 10
            region: @selecionar-arquivo
            slot: regionBody
            alignment: left
            labelColumnSpan: 0
        }
        appearance {
            template: @/hidden
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
    )

    pageItem P324_FILE_NAME (
        type: displayOnly
        label {
            label: Loaded File
            alignment: left
        }
        layout {
            sequence: 20
            region: @arquivo-importado
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: Pasted Data
        }
    )

    button clear (
        buttonName: CLEAR
        label: Limpar
        layout {
            sequence: 10
            region: @button-bar
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button load (
        buttonName: LOAD
        label: Importar
        layout {
            sequence: 20
            region: @button-bar
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction upload-a-file (
        name: Upload a File
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P324_FILE
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P324_FILE
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation is-valid-file-type (
        name: Is valid file type
        execution {
            sequence: 10
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                if apex_data_parser.assert_file_type(
                       p_file_name => :P324_FILE_NAME,
                       p_file_type => apex_data_parser.c_file_type_csv )
                then
                    return true;
                else
                    :P324_FILE := null;
                    return false;
                end if;
                ```
        }
        error {
            errorMessage: Invalid file type. Supported file types CSV, TXT.
            associatedItem: @P324_FILE
        }
    )

    computation p324-file-name (
        itemName: P324_FILE_NAME
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            sqlQuery:
                ```sql
                select filename
                  from apex_application_temp_files 
                 where name = :P324_FILE
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P324_FILE
        }
    )

    process clear-cache (
        name: Clear Cache
        type: clearSessionState
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 697339244306523937
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'CLEAR' or :P324_ERROR_ROW_COUNT = 0
        }
    )

    process load-data (
        name: Load Data
        type: dataLoading
        dataLoading {
            dataLoadDefinition: @funcion_rios_crisdu_csv
        }
        sourceData {
            fileBrowseItem: P324_FILE
        }
        processingResult {
            errorRowCountItem: P324_ERROR_ROW_COUNT
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 697338894965523936
        }
        serverSideCondition {
            whenButtonPressed: @load
        }
    )

    process processa-integração (
        name: Processa Integração
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  -- Local variables here
                  vidpessoa      number; 
                  vativo         varchar2(1);
                  vafastamento   varchar2(1);
                  vsqlerrm       varchar2(4000);
                  --
                begin
                  -- Test statements here
                  --
                  UPDATE FUNCIONARIOS_CRISDU f  
                  SET cpf = lpad( cpf ,11,'0') 
                  WHERE  LENGTH(cpf) < 11;
                  --
                  UPDATE FUNCIONARIOS_CRISDU f  
                  SET situacao = nvl(situacao,'Ativo')
                  WHERE  situacao is null;
                  --
                  for i in ( SELECT ( SELECT f.idvendedora
                                         FROM pessoas p
                                            , vendedoras f
                                         WHERE p.cpf = f.cpf
                                           AND f.idpessoa = p.idpessoa )  idvendedora
                                 , ( SELECT f.idfuncionario
                                         FROM pessoas p
                                            , funcionarios f
                                         WHERE p.cpf = f.cpf
                                           AND f.idpessoa = p.idpessoa )  idfuncionario
                                 , ( SELECT p.idpessoa
                                         FROM pessoas p
                                         WHERE p.cpf = f.cpf )  idpessoa
                                 , ( select min(c.idcidade)
                                      from cidades c
                                         , estados e
                                     where nlssort(upper(c.nomecidade), 'nls_sort=binary_ai') = nlssort(upper(trim(f.cidade)), 'nls_sort=binary_ai')
                                       and e.idestado = c.idestado
                                       and trim(e.sigla) = trim(f.uf) ) idcidade
                                 , f.*
                              FROM FUNCIONARIOS_CRISDU f  )
                  loop
                    --
                    begin
                        IF i.situacao = 'Ativo' THEN
                          --
                          vativo        := 'S';
                          vafastamento  := 'N';
                          --
                        ELSE
                          --
                          vativo        := 'N';
                          vafastamento  := 'S';
                          --
                        END IF;
                        --
                        --
                        IF i.idpessoa IS NULL THEN 
                            -- 
                            begin
                                insert into pessoas ( idpessoa         , nomepessoa         , cpf
                                                    , datanascimento   , enderecoprincipal  , bairro
                                                    , cep              , idcidade           , sexo 
                                                    , idpais           , observacao         , matricula 
                                                    , tipopessoa       )
                                values ( seq_idpessoa.nextval                    , i.nome                                       , i.cpf
                                       , to_date(i.datanascimento,'DD/MM/RRRR')  , i.endereco                                   , i.bairro
                                       , i.cep                                   , i.idcidade                                   , i.sexo
                                       , 1                                       , 'Funcionario cadastrado no CNPJ '||i.cnpj    , i.contrato
                                       , 'F'        )
                                returning idpessoa
                                INTO vidpessoa;
                            EXCEPTION
                              WHEN OTHERS THEN
                                vsqlerrm  := sqlerrm;
                                dbms_output.put_line(i.cpf|| ',F: '||i.idfuncionario|| ',V: '||i.idvendedora||', P:'||vidpessoa ||' - '||vsqlerrm);
                                vidpessoa := NULL;
                            END;
                            --
                         ELSE
                            --
                            vidpessoa := i.idpessoa;
                            --
                         END IF;
                         --
                         IF i.idfuncionario IS NULL AND vidpessoa IS NOT NULL THEN
                           -- 
                           insert into funcionarios ( idfuncionario  , idpessoa     ,   idcargo
                                                     , ativo          , afastamento )
                            values ( seq_idfuncionarios.nextval     , vidpessoa     , null
                                   , vativo                         , vafastamento );
                                --
                         END IF;
                         --
                         IF i.idvendedora IS NULL AND vidpessoa IS NOT NULL THEN
                           -- 
                            insert into vendedoras ( idvendedora       , idpessoa        , ativo
                                                   , idrepresentante   , idregiaovenda   , created_time
                                                   , updated_time )
                            values ( seq_idvendedora.nextval      , vidpessoa    , vativo
                                   , 2262                         , null         , sysdate
                                   , sysdate );
                           --
                          END IF;
                            --
                           --
                           UPDATE funcionarios  
                           SET ativo = vativo
                             , afastamento  = vafastamento
                           WHERE idfuncionario = i.idfuncionario;
                           --
                           UPDATE vendedoras
                           SET ativo = vativo
                             , created_time = sysdate
                             , updated_time = SYSDATE 
                           WHERE idvendedora = i.idvendedora;
                           --
                       -- 
                        EXCEPTION
                          WHEN OTHERS THEN
                              vsqlerrm  := sqlerrm;
                            dbms_output.put_line(i.cpf|| ',F: '||i.idfuncionario|| ',V: '||i.idvendedora||', P:'||vidpessoa ||' - '||vsqlerrm);
                        END;
                  end loop;
                  --
                  --
                 /* FOR f IN( SELECT * FROM FUNCIONARIOS_CRISDU f )--WHERE f.cpf = '01826320083' )
                  loop
                    UPDATE pessoas p
                    SET nomepessoa = f.nome || ( SELECT  ' ['||substr(ltrim(REPLACE(REPLACE(pp.nomepessoa,'Crisdu',''),'Favorita','')),1,15)||']'
                                          FROM pessoas pp 
                                          WHERE  pp.cnpj =   REPLACE(REPLACE(f.CNPJ,'/',''), '-','') )                      
                    WHERE p.cpf = f.cpf;
                    --
                  END LOOP;*/
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 697378668483545122
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 325
            }
        }
        serverSideCondition {
            whenButtonPressed: @load
        }
    )

)

