    region top-bojos (
        name: Top Bojos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select filial
                     , mes
                     , numero
                     , ano
                     , mesano
                     , abatimentos     "Abatimentos"
                     , credito         "Crédito"
                     , dhrecebido      "Dinheiro recebido"
                     , saidasdiversas  "Saídas Diversas"
                     , entradasbanco   "Entradas Banco"
                     ,  abatimentos
                      + credito
                      + dhrecebido --está com *-1
                      + saidasdiversas
                      + entradasbanco     Resultado
                from (  select pck_romance.fnc_nomefilial(1061) filial
                             , m.mes
                             , m.numero
                             , to_number(:P203_ANO) ano
                             , m.numero||:P203_ANO mesano
                             -- pega todos abatimentos recebidos
                             ,  nvl( ( select sum(vr.valor)
                                        from notasfiscais nv 
                                           , vencimentosreceber vr
                                           , depositosdiarios_orig dd
                                        where nv.tiponota         = 'V'
                                          and nv.idnotafiscal     = vr.idnotafiscal
                                          and vr.idvencimento     = dd.idvencimentoabatimento
                                          and to_char(dd.data,'MM/RRRR') = trim(m.numero||'/'||:P203_ANO)
                                          and exists ( select 1
                                                         from notasfiscais nc
                                                         where nc.idnotafiscal = nv.idnotafiscalcompra 
                                                           and nc.idfornemitente = pck_romance.fnc_fornecedorfilial( 1061 ))),0)  abatimentos
                             -- abatimentos que faltam ser feitos
                             , nvl( ( select sum(vr.valor) valor
                                      from notasfiscais nv 
                                         , vencimentosreceber vr
                                      where nv.tiponota = 'V'
                                        and nv.idnotafiscal     = vr.idnotafiscal
                                        and not exists ( select 1
                                                         from depositosdiarios_orig  d
                                                         where d.idvencimentoabatimento = vr.idvencimento )
                                        and to_char(vr.datavencimento,'MM/RRRR') = trim(m.numero||'/'||:P203_ANO)
                                        and not exists ( select 1
                                                         from notasfiscais nc2 
                                                         where nc2.idnotafiscalcompra = nv.idnotafiscal )
                                         and exists ( select 1
                                                       from notasfiscais nc
                                                       where nc.idnotafiscal = nv.idnotafiscalcompra 
                                                         and nc.idfornemitente = pck_romance.fnc_fornecedorfilial( 1061 ) )  ),0) credito
                             --entradas diversas
                             , (nvl(( select sum(nvl(e.valortotal,0))
                                       from entradasdiversas e
                                       where to_char( e.data,'MM/RRRR') = trim(m.numero||'/'||:P203_ANO)
                                         and e.idfilial = 1061),0)
                             -- dinheiro recebido
                               + nvl( ( select sum(v.valor)
                                        from vencimentos   v
                                           , notasfiscais  nn
                                        where to_char( v.datavencimento,'MM/RRRR') = trim(m.numero||'/'||:P203_ANO)
                                          and v.idnotafiscal = nn.idnotafiscal
                                          and nn.idfilialdestino = 1061 ) ,0) )*-1  dhrecebido
                             -- saidas diversas
                             , nvl(( select sum(nvl(s.valortotal,0))
                                     from saidasdiversas s
                                     where to_char( s.data,'MM/RRRR') = trim(m.numero||'/'||:P203_ANO) 
                                       and s.idfilial = 1061),0) saidasdiversas
                             -- valor no banco          
                             , nvl(( select sum(f.valornobanco)
                                     from fechamentossemanais f
                                     where f.idfilial = 1061
                                       and trim(f.mesvalornobanco) = trim(m.numero||'/'||:P203_ANO)),0) 
                                 + nvl(( select sum(valor) valor
                                        from registroscontasbancarias r
                                           , filiais                  f
                                        where r.idunidadedenegocio   = f.idunidadedenegocio  
                                          and f.idfilial             = 1061 
                                          and r.ano                  = :P203_ANO
                                          and r.idmes                = m.numero ),0)      entradasbanco
                        from meses m )
                
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
