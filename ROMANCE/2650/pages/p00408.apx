page 408 (
    name: Notas Fiscais para Recebimento
    title: Notas Fiscais para Recebimento
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region relação-de-notas-para-recebimento (
        name: Relação de Notas para Recebimento
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nf.idnotafiscal
                     , nf.documento
                     , nf.dtnf 
                     , case
                         when nf.tipoemitente = 'FOR' then
                           pck_romance.fnc_nomefornecedor(nf.idfornemitente)
                         else
                           pck_romance.fnc_nomefilial(nf.idfilialemitente) 
                       end emitente
                     , pck_romance.fnc_nomefilial(nf.idfilialdestino) destino
                     , nf.valortotal
                from notasfiscais nf
                where nf.situacao = 'A'
                  and nf.situacaofilial = 'A'
                  and extract ( year from dtnf ) >= 2021
                  and exists ( select 1
                               from itemnf i
                               where i.idproduto = :P408_IDPRODUTO
                                 and i.idnotafiscal = nf.idnotafiscal )
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 5394531051849030024
        }

        column DESTINO (
            type: plainText
            heading {
                heading: Destino
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column DOCUMENTO (
            type: plainText
            heading {
                heading: Documento
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column DTNF (
            type: plainText
            heading {
                heading: Data da Nota
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column EMITENTE (
            type: plainText
            heading {
                heading: Emitente
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column IDNOTAFISCAL (
            type: link
            heading {
                heading: Ir p/ Nota
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 27
                    items: {
                        P27_IDNOTAFISCAL: #IDNOTAFISCAL#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
                linkAttributes: target="_blank"
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column VALORTOTAL (
            type: plainText
            heading {
                heading: Valor Total
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 54227244 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DESTINO (
                sequence: 5
            )

            displayColumn DOCUMENTO (
                sequence: 2
            )

            displayColumn DTNF (
                sequence: 3
            )

            displayColumn EMITENTE (
                sequence: 4
            )

            displayColumn IDNOTAFISCAL (
                sequence: 1
            )

            displayColumn VALORTOTAL (
                sequence: 6
            )

        )

    )

    pageItem P408_IDPRODUTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @relação-de-notas-para-recebimento
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

