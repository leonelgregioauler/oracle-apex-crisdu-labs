    region extrato (
        name: Extrato
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select 'Saldo 2019' descricao
                     , nvl(trim(to_char(sum(saldo),'999G999G999G999G990D00')),0) valor
                     , 1 ordem
                from saldoscontasbancarias s
                where exists ( select 1
                               from contasbancarias cb
                               where cb.idcontabanc = s.idcontabancaria
                                 and cb.idbanco     = 60 )
                union
                select 'Saldo Anterior ' descricao
                     , nvl(trim(to_char(sum(valor),'999G999G999G999G990D00')),0) valor
                     , 2 ordem
                from extratosbancarios ex
                where ex.tipo in ('C','D')
                  and ex.idbanco = 60
                  and ex.datamovimentacao < to_date(:P380_DATA_INICIO)
                union
                select 'Crédito' descricao
                     , nvl(trim(to_char(sum(valor),'999G999G999G999G990D00')),0) valor
                     , 3 ordem
                from extratosbancarios ex
                where ex.tipo = 'C'
                  and ex.idbanco = 60
                  and ex.datamovimentacao between to_date(:P380_DATA_INICIO) and to_date(:P380_DATA_FIM)
                union
                select 'Débito' descricao
                     , nvl(trim(to_char(sum(valor),'999G999G999G999G990D00')),0) valor
                     , 4 ordem
                from extratosbancarios ex
                where ex.tipo = 'D'
                  and ex.idbanco = 60
                  and ex.datamovimentacao between to_date(:P380_DATA_INICIO) and to_date(:P380_DATA_FIM)
                union
                select 'Saldo' descricao
                     , nvl(trim(to_char(sum(valor),'999G999G999G999G990D00')),0) valor
                     , 5 ordem
                from extratosbancarios ex
                where ex.tipo in ('C','D')
                  and ex.idbanco = 60
                  and ex.datamovimentacao between to_date(:P380_DATA_INICIO) and to_date(:P380_DATA_FIM)
                order by 3
                ```
        }
        layout {
            sequence: 10
            parentRegion: @itaú
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                js-useLocalStorage
                is-expanded
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        settings {
            labelColumn: DESCRICAO
            valueColumn: VALOR
            layout: 5Columns
        }
    )

