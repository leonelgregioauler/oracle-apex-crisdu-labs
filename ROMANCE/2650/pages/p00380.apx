    region movimentações-sistema-não-contidas-em-extrato (
        name: Movimentações Sistema não contidas em Extrato
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select *
                from (
                select 'Faturas Pagas' tipo
                     , pf.databaixa data
                     , nf.documento
                     , pck_romance.fnc_nomefornecedor(nf.idfornemitente) origem
                     , cb.agencia
                     , cb.conta
                     , pf.valorpago
                     , 'D' tipoforma
                     , (select t.datadeposito
                          from depositosdiarios_leituraocr t
                             , depositosdiarios dd
                         where t.iddepositodiario = dd.iddepositodiarios
                           and dd.idpgtoforn = pf.idpgtoforn) datamovimento
                from pagamentosfornecedores pf
                   , notasfiscais nf
                   , contasbancarias cb
                where trunc(pf.databaixa) between to_date(:P380_DATA_INICIO) and (:P380_DATA_FIM)
                  and nf.idnotafiscal = pf.idnotafiscal
                  and cb.idcontabanc = pf.idcontapagamento
                  and exists ( select 1
                               from contasbancarias cc
                               where cc.idcontabanc = :P380_IDCONTA
                                 and cc.agencialimpa = cb.agencialimpa
                                 and cc.contalimpa = cb.contalimpa )
                  /*and not exists ( select 1
                                   from conciliacoesbancarias c
                                   where c.idpagamentofornecedor = pf.idpgtoforn )*/
                  and ( not exists ( select 1
                                   from conciliacoesbancarias c
                                   where c.idpagamentofornecedor = pf.idpgtoforn )
                  and not exists ( select 1
                                   from conciliacoesbancariaslote c
                                   where c.idpagamentofornecedor = pf.idpgtoforn ))
                union
                select 'Depósito Bancário' tipo
                     , d.data
                     , dl.nroidentificacao_digitado identificacao
                     , pck_romance.fnc_nomerepresentante(d.idrepresentante) origem
                     , cb.agencia
                     , cb.conta
                     , COALESCE(dl.valor_digitado, dl.valor, d.valordeposito) valordeposito
                     , 'C' tipoforma
                     , dl.datadeposito datamovimento
                from depositosdiarios_orig d
                   , depositosdiarios_leituraocr dl
                   , contasbancarias cb
                where trunc(d.data) between to_date(:P380_DATA_INICIO) and (:P380_DATA_FIM)
                  and dl.iddepositodiario = d.iddepositodiarios
                  and cb.idcontabanc = d.idcontabanc
                  and exists ( select 1
                               from contasbancarias cc
                               where cc.idcontabanc = :P380_IDCONTA
                                 and cc.agencialimpa = cb.agencialimpa
                                 and cc.contalimpa = cb.contalimpa )
                  /*and not exists ( select 1
                                   from conciliacoesbancarias c
                                   where c.iddepositodiario = dl.iddepositodiario )*/ 
                  and ( not exists ( select 1
                                     from conciliacoesbancariaslote c
                                     where c.iddepositodiario = d.iddepositodiarios )
                  and  not exists ( select 1
                                    from roman.conciliacoesbancarias c
                                    where c.iddepositodiario = d.iddepositodiarios
                                      and c.idleituraocr_deposito = dl.idleituraocr_deposito))) x
                where (:P380_DEB_CRED = 'T' or x.tipoforma = :P380_DEB_CRED )                 
                
                                  
                ```
        }
        layout {
            sequence: 140
            slot: body
        }
        appearance {
            template: @/standard
