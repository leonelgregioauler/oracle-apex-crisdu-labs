        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct('Agencia: '||c.agencia||' / Conta: '||c.conta||' Beneficiario: '||c.beneficiario) display_value
                     , c.idcontabanc return_value
                from contasbancarias c
                   , bancos b
                where c.idpessoa = 16625
                  and b.idbanco = c.idbanco
                  and b.idbanco = :P380_IDBANCO
                  and c.ativo = 'S'
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P380_IDBANCO
        }
        layout {
