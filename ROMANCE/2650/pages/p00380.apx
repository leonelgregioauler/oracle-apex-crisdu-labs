        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Todos', 'T' from dual
                union all
                select 'Débito', 'D'
                  from dual
                 where pck_util.fnc_verificaacesso(26035,v('APP_USER')) = 'S'
                    or exists ( select 1
                                  from roman.usuariosgruposatendimento uu
                                 where uu.usuario = v('APP_USER')
                                   and uu.idgrupoatendimento = 0)
                union all
                select 'Crédito', 'C'
                  from dual
                 where pck_util.fnc_verificaacesso(26034,v('APP_USER')) = 'S'
                    or exists ( select 1
                                  from roman.usuariosgruposatendimento uu
                                 where uu.usuario = v('APP_USER')
                                   and uu.idgrupoatendimento = 0)
                ```
