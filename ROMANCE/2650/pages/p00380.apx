    region placar-crédito (
        name: Placar - Crédito
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                --12238512 - Gabriel Andriola - 15/01/2026
                WITH 
                parametros AS (
                                SELECT
                                    TRUNC(TO_DATE(:P380_DATA_INICIO, 'DD/MM/YYYY')) AS dt_ini,
                                    TRUNC(TO_DATE(:P380_DATA_FIM,   'DD/MM/YYYY'))  AS dt_fim,
                                    :P380_IDCONTA                                   AS idconta,
                                    :P380_IDBANCO                                   AS idbanco,
                                    v('APP_USER')                                   AS usuario
                                FROM dual
                ),
                dadosExtratos AS (
                                    SELECT 
                                        ex.valor
                                      , CASE WHEN EXISTS (SELECT 1 FROM conciliacoesbancarias c 
                                                             WHERE c.idextratobancario = ex.idextratobancario) 
                                                THEN 1 
                                                ELSE 0 
                                        END AS conciliado
                                    FROM extratosbancarios ex
                                    CROSS JOIN parametros p
                                    JOIN contasbancarias cb ON cb.idcontabanc  = p.idconta
                                                           AND cb.agencialimpa = ex.agencia
                                                           AND cb.contalimpa   = ex.conta
                                    WHERE ex.tipo = 'C'
                                      AND ex.datamovimentacao BETWEEN p.dt_ini AND p.dt_fim
                                      AND (p.idbanco IS NULL OR ex.idbanco = p.idbanco)
                                      AND ex.numerodocumento != '1'
                                      and ( :P380_IDCONTA is null or exists ( select 1
                                                                  from contasbancarias cb
                                                                  where cb.idcontabanc = :P380_IDCONTA
                                                                    and cb.agencialimpa = ex.agencia
                                                                    and cb.contalimpa   = ex.conta ) or exists ( select 1 --Condição para buscar informações via API, pois vem sem digito
                                                                                                                 from contasbancarias cb
                                                                                                                 where cb.idcontabanc = :P380_IDCONTA
                                                                                                                --and upper(trim(ltrim(replace(replace(cb.agencia,'-',''),'	',''),0))) = ex.agencia
                                                                                                                --and upper(trim(ltrim(replace(replace(cb.conta,'-',''),'	',''),0)))   = ex.conta
                                                                                                                   AND SUBSTR(cb.agencia, 1, INSTR(cb.agencia, '-') - 1) = ex.agencia
                                                                                                                   AND SUBSTR(cb.conta, 1, INSTR(cb.conta, '-') - 1) = ex.conta  ) )
                ),
                
                totaisExtratos AS (
                                    SELECT 
                                         SUM(valor)                                          AS valor_extratos
                                       , COUNT(*)                                            AS qtde_extratos
                                       , SUM(CASE WHEN conciliado = 1 THEN valor ELSE 0 END) AS valor_conciliado_extratos
                                       , SUM(CASE WHEN conciliado = 1 THEN 1     ELSE 0 END) AS quantidade_conciliado_extratos
                                       , SUM(CASE WHEN conciliado = 0 THEN valor ELSE 0 END) AS valor_pendente_extratos
                                       , SUM(CASE WHEN conciliado = 0 THEN 1     ELSE 0 END) AS quantidade_pendente_extratos
                                    FROM dadosExtratos
                ),
                
                dadosComprovantes AS (
                                        SELECT 
                                            COALESCE(dl.valor_digitado, dl.valor, dd.valordeposito) valor
                                          , CASE WHEN EXISTS (SELECT 1 FROM conciliacoesbancarias c WHERE c.iddepositodiario = dl.iddepositodiario AND c.idleituraocr_deposito = dl.idleituraocr_deposito)
                                                   OR EXISTS (SELECT 1 FROM conciliacoesbancariaslote c WHERE c.iddepositodiario = dd.iddepositodiarios)
                                                   THEN 1 
                                                   ELSE 0 
                                           END AS conciliado
                                          FROM roman.depositosdiarios_leituraocr dl
                                          JOIN roman.depositosdiarios_orig dd ON dl.iddepositodiario = dd.iddepositodiarios
                                          JOIN roman.contasbancarias cb       ON cb.idcontabanc = dd.idcontabanc 
                                          CROSS JOIN parametros p
                                         WHERE trunc(dd.data) BETWEEN p.dt_ini AND p.dt_fim
                                           AND EXISTS ( SELECT 
                                                            1
                                                          FROM contasbancarias cc
                                                         WHERE cc.idcontabanc  = p.idconta
                                                           AND cc.agencialimpa = cb.agencialimpa
                                                           AND cc.contalimpa   = cb.contalimpa )
                ),
                
                totaisComprovantes AS (
                                        SELECT 
                                             SUM(valor)                                          AS valor_comprovantes
                                           , COUNT(*)                                            AS qtde_comprovantes
                                           , SUM(CASE WHEN conciliado = 1 THEN valor ELSE 0 END) AS valor_conciliado_comprovantes
                                           , SUM(CASE WHEN conciliado = 1 THEN 1     ELSE 0 END) AS quantidade_conciliado_comprovantes
                                           , SUM(CASE WHEN conciliado = 0 THEN valor ELSE 0 END) AS valor_pendente_comprovantes
                                           , SUM(CASE WHEN conciliado = 0 THEN 1     ELSE 0 END) AS quantidade_pendente_comprovantes
                                         FROM dadosComprovantes
                )
                SELECT 
                     ext.valor_extratos
                   , comp.valor_comprovantes
                   , comp.valor_conciliado_comprovantes
                   , comp.quantidade_conciliado_comprovantes
                   , comp.valor_pendente_comprovantes
                   , comp.quantidade_pendente_comprovantes
                 FROM totaisExtratos ext
                CROSS JOIN totaisComprovantes comp
                ```
        }
        layout {
            sequence: 100
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
