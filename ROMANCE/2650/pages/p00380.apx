    region extrato-bancário (
        name: Extrato Bancário
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select x.agencia
                     , x.conta
                     , x.datamovimentacao
                     , x.numerodocumento 
                     , x.movimentacao
                     , x.valor
                     , x.tipo
                     , x.detalhe
                     , LISTAGG(x.identificacao, ', ') WITHIN GROUP (ORDER BY x.identificacao) AS identificacao
                     , x.editar
                     , x.duplicar
                     , x.excluir
                     , x.cnpj
                     , x.ir_pnota
                     , x.ir_pconciliacaolote
                     , x.idextratobancario
                from (select ex.agencia
                             --, ex.conta
                             , (select distinct(c.conta||' Beneficiario: '||c.beneficiario)
                                from contasbancarias c
                                   , bancos b
                                where c.idpessoa = 16625
                                  and c.agencialimpa = ex.agencia
                                  and c.contalimpa   = ex.conta
                                  and b.idbanco = c.idbanco
                                  and b.idbanco = ex.idbanco
                                  and c.ativo = 'S'
                                 -- and c.versao = 1
                                union
                                select distinct(c.conta) --Union para buscar informações via API, pois vem sem digito
                                from contasbancarias c
                                   , bancos b
                                where b.idbanco = c.idbanco
                                  and b.idbanco = ex.idbanco
                                  and SUBSTR(c.conta, 1, INSTR(c.conta, '-') - 1) = ex.conta
                                  and SUBSTR(c.agencia, 1, INSTR(c.agencia, '-') - 1) = ex.agencia 
                                  and c.ativo = 'S'
                                  and c.versao = 2  
                                  and rownum = 1 ) conta --Rownum provisório
                             , ex.datamovimentacao
                             , ex.numerodocumento 
                             , ex.movimentacao
                             , ex.valor
                             , decode(ex.tipo,'C','Crédito','D','Débito') tipo
                             , ex.detalhe
                             --, nvl(c.identificacao, '<a href="javascript: fnc_confirmar('||ex.idextratobancario||');"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' ) identificacao
                             --, nvl(c.identificacao, '<a href="javascript: fnc_confirmar(' || ex.idextratobancario || ', ''' || :P380_DEB_CRED || ''');"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>') identificacao
                             /*, NVL( c.identificacao, '<a href="javascript: fnc_confirmar(' || ex.idextratobancario || ', ''' || :P380_DEB_CRED || ''', ''' ||
                                  CASE 
                                    WHEN ex.movimentacao = 'TRANSFERENCIA RECEBIDA   ' THEN 'S'
                                    ELSE 'N'
                                END || ''');"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>') identificacao*/
                             , NVL( c.identificacao, '<a href="javascript: fnc_confirmar(' || ex.idextratobancario || ', ''' || :P380_DEB_CRED || ''', ''' ||
                                  CASE 
                                    WHEN ex.movimentacao in ('TRANSFERENCIA RECEBIDA   ', 'TRANSFERÊNCIA RECEBIDA') THEN 'S'
                                    ELSE 'N'
                                END || ''', ''' || ex.valor || ''');">
                                <img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>') identificacao
                
                             , case
                                 when pck_util.fnc_verificaacesso(2729,v('APP_USER')) = 'S' and c.conciliacaomanual is not null then
                                   '<a href="javascript: fnc_editar('||ex.idextratobancario||');"><img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt=""/></a>'
                                 else
                                   '-'
                               end editar
                             , case
                                 when pck_util.fnc_verificaacesso(2729,v('APP_USER')) = 'S' and v('APP_USER') in ('DEBORAC','BRUNASAUERESSING','SABRINAFV','DIEGOPIECHO','EDUARDAZOTTI') and c.identificacao is not null then  --Liberação dos usuários que podem ter acesso deve ser solicitado a Débora ou Bruna Saueressing
                                   '<a href="javascript: fnc_duplicar('||ex.idextratobancario||');"><img src="#APP_IMAGES#seta.png" alt=""/></a>'
                                 else
                                   '-'
                               end duplicar
                             , case
                                 when pck_util.fnc_verificaacesso(2729,v('APP_USER')) = 'S' and v('APP_USER') in ('DEBORAC','BRUNASAUERESSING','SABRINAFV') and c.identificacao is not null then  --Liberação dos usuários que podem ter acesso deve ser solicitado a Débora ou Bruna Saueressing
                                   '<a href="javascript: fnc_excluir('||ex.idextratobancario||');"><img src="#APP_IMAGES#excluir.png" alt=""/></a>'
                                 when pck_util.fnc_verificaacesso(2729,v('APP_USER')) = 'S' and v('APP_USER') in ('DEBORAC','BRUNASAUERESSING','SABRINAFV') and c.identificacao is null then      --Liberação dos usuários que podem ter acesso deve ser solicitado a Débora ou Bruna Saueressing
                                   '<a href="javascript: fnc_excluir_tudo('||ex.idextratobancario||');"><img src="#APP_IMAGES#excluir.png" alt=""/></a>'
                                 else 
                                   '-'
                               end excluir
                             , cnpj
                             , case 
                                 when c.doc is not null then
                                   '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=2650:26:'||v('APP_SESSION')||'::NO::P26_DOCUMENTO,P26_ANO,P26_IDFORNECEDOR:'||c.doc||','||c.ano||','||c.forne,'SESSION')||''',''_blank''); void(0);"><img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt=""/></a>'
                                 else
                                 '-'
                               end ir_pnota
                             , case 
                                 when c.conciliacaolote = 'S' then
                                  '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=2650:476:'||v('APP_SESSION')||'::NO::P476_IDEXTRATO:'||ex.idextratobancario,'SESSION')||''',''_blank''); void(0);"><img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt=""/></a>'
                                 else
                                 '-'
                               end ir_pconciliacaolote
                             , ex.idextratobancario
                        from extratosbancarios ex
                           , ( select cc.idextratobancario 
                                    , case
                                        when nvl(cl.iddepositodiario,cc.iddepositodiario) is not null then
                                          'Depósito de '||( select pck_romance.fnc_nomerepresentante(d.idrepresentante)
                                                            from depositosdiarios_orig d
                                                            where d.iddepositodiarios = nvl(cl.iddepositodiario,cc.iddepositodiario) )
                                        when nvl(cl.idpagamentofornecedor,cc.idpagamentofornecedor) is not null then
                                          'Pagamento de Fatura '||( select nf.documento||' - '||pck_romance.fnc_nomefornecedor(nf.idfornemitente)
                                                                    from pagamentosfornecedores pf
                                                                       , notasfiscais nf
                                                                    where pf.idpgtoforn = nvl(cl.idpagamentofornecedor,cc.idpagamentofornecedor)
                                                                      and nf.idnotafiscal = pf.idnotafiscal )
                                        when nvl(cl.idnotavenda,cc.idnotavenda) is not null then
                                          'Nota Romance '||( select nv.numeronota||' - '||pck_romance.fnc_nomefilial(nv.idfilial)
                                                             from notasvendas nv
                                                             where nv.idnotavenda = nvl(cl.idnotavenda,cc.idnotavenda) )
                                        when nvl(cl.idpedido,cc.idpedido) is not null then
                                          'Pedido Favorita '||( select p.idpedido||' - '||pck_romance.fnc_nomefilial(p.idfilialromance)
                                                                from favorita.pedidos p
                                                                where p.idpedido = nvl(cl.idpedido,cc.idpedido) )
                                        when nvl(cl.idboleto,cc.idboleto) is not null then
                                          'Boleto Favorita '||( select b.numero||' - '||pck_romance.fnc_nomefilial(b.idfilial)
                                                                from boletos b 
                                                                where b.idboleto = nvl(cl.idboleto,cc.idboleto) )
                                        when nvl(cl.idnegociacaoparceiro,cc.idnegociacaoparceiro) is not null then
                                          'Negociação Cobraki '||( select pck_romance.fnc_nomefilial(np.idfilial)
                                                                   from negociacoesparceiros np
                                                                   where np.idnegociacaoparceiro = nvl(cl.idnegociacaoparceiro,cc.idnegociacaoparceiro) )
                                        when cc.conciliacaomanual is not null then
                                          'Confirmação Manual: '||cc.conciliacaomanual
                                        when nvl(cl.idregistrocontabancaria,cc.idregistrocontabancaria) is not null then
                                          'Transferência Bancária: '|| ( select rg.observacao
                                                                       from registroscontasbancarias rg
                                                                       where rg.idregistrocontabancaria = nvl(cl.idregistrocontabancaria,cc.idregistrocontabancaria))
                                      end identificacao
                                    , case
                                        when cc.idpagamentofornecedor is not null then
                                           ( select rr.cnpj
                                             from pagamentosfornecedores pf
                                                , notasfiscais nf
                                                , razoessociaisfiliais rr
                                             where pf.idpgtoforn = cc.idpagamentofornecedor
                                               and nf.idnotafiscal = pf.idnotafiscal
                                               and rr.idrazaosocialfilial = nf.idrazaosocialfildestino )
                                      end cnpj
                                    , conciliacaomanual
                                    , ( select nf.documento
                                         from pagamentosfornecedores pf
                                            , notasfiscais nf
                                        where pf.idpgtoforn = cc.idpagamentofornecedor
                                          and nf.idnotafiscal = pf.idnotafiscal ) doc
                                    , ( select to_char(nf.dtnf,'RRRR') ANO
                                         from pagamentosfornecedores pf
                                            , notasfiscais nf
                                        where pf.idpgtoforn = cc.idpagamentofornecedor
                                          and nf.idnotafiscal = pf.idnotafiscal ) ano
                                    , ( select pf.idfornecedor idforne
                                         from pagamentosfornecedores pf
                                            , notasfiscais nf
                                        where pf.idpgtoforn = cc.idpagamentofornecedor
                                          and nf.idnotafiscal = pf.idnotafiscal) forne
                                    , cc.conciliacaolote
                               from conciliacoesbancarias cc
                                  , conciliacoesbancariaslote cl
                               where cc.idconciliacao = cl.idconciliacao (+)
                                 and exists ( select 1
                                              from extratosbancarios e
                                              where e.idextratobancario = cc.idextratobancario
                                                and e.datamovimentacao between to_date(:P380_DATA_INICIO) and to_date(:P380_DATA_FIM)
                                                and e.idbanco = :P380_IDBANCO ) ) c
                        where ex.datamovimentacao between to_date(:P380_DATA_INICIO) and to_date(:P380_DATA_FIM)
                          and ex.idbanco = :P380_IDBANCO
                          and ex.numerodocumento != '1'
                          --and ex.movimentacao != 'COBRANÇA'
                          and ex.idextratobancario = c.idextratobancario(+)
                          and ( :P380_IDCONTA is null or exists ( select 1
                                                                  from contasbancarias cb
                                                                  where cb.idcontabanc = :P380_IDCONTA
                                                                    and cb.agencialimpa = ex.agencia
                                                                    and cb.contalimpa   = ex.conta ) or exists ( select 1 --Condição para buscar informações via API, pois vem sem digito
                                                                                                                 from contasbancarias cb
                                                                                                                 where cb.idcontabanc = :P380_IDCONTA
                                                                                                                --and upper(trim(ltrim(replace(replace(cb.agencia,'-',''),'	',''),0))) = ex.agencia
                                                                                                                --and upper(trim(ltrim(replace(replace(cb.conta,'-',''),'	',''),0)))   = ex.conta
                                                                                                                   AND SUBSTR(cb.agencia, 1, INSTR(cb.agencia, '-') - 1) = ex.agencia
                                                                                                                   AND SUBSTR(cb.conta, 1, INSTR(cb.conta, '-') - 1) = ex.conta  ) )
                          and ( :P380_CONCILIADO = 'T'
                             or ( :P380_CONCILIADO = 'S' and ex.conciliado = 'S' )
                             or ( :P380_CONCILIADO = 'N' and nvl(ex.conciliado,'P') = 'P' ))
                          and /*(:P380_DEB_CRED is null and v('APP_USER') in ('SARAK', 'GRAZIELEF', 'RAMILEDENTE', 'NEIDI', 'JESSICAALTHAUS') and ex.tipo = 'C'
                          or(:P380_DEB_CRED is null and v('APP_USER') not in ('SARAK', 'GRAZIELEF', 'RAMILEDENTE', 'NEIDI', 'JESSICAALTHAUS', 'CAROLINISEVERO', 'SABRINAFV', 'CLARARICK', 'GESSICANAUMANN') and ex.tipo in ('C','D'))
                          or*/(:P380_DEB_CRED = 'T' or ex.tipo = :P380_DEB_CRED )) x
                group by x.agencia
                        , x.conta
                        , x.datamovimentacao
                        , x.numerodocumento 
                        , x.movimentacao
                        , x.valor
                        , x.tipo
                        , x.detalhe
                        , x.editar
                        , x.duplicar
                        , x.excluir
                        , x.cnpj
                        , x.ir_pnota
                        , x.ir_pconciliacaolote
                        , x.idextratobancario          
                order by x.datamovimentacao
                ```
            pageItemsToSubmit: P380_CONCILIADO
        }
        layout {
            sequence: 120
            slot: body
        }
