                select 'Saldo' descricao
                     , nvl(trim(to_char(sum(valor),'999G999G999G999G990D00')),0) valor
                     , 5 ordem
                from extratosbancarios ex
                where ex.tipo in ('C','D')
                  and ex.idbanco = 41
