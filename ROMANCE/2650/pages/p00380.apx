    process processos-em-extratos (
        name: Processos em Extratos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vprocesso varchar2(1);
                  vidusuario number;
                  vidextrato number := :P380_ID;
                begin
                  --
                  select idusuario
                  into vidusuario
                  from usuarios 
                  where usuario = v('APP_USER');
                  --
                  if v('REQUEST') = 'DUPLICAR' then
                    vprocesso := 'D';
                  elsif v('REQUEST') = 'EXCLUIR_TUDO' then
                    vprocesso := 'T';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    vprocesso := 'X';
                  end if;
                  --
                  pck_financeiro_rmc.prc_processos_extratos(pidextratobancario => vidextrato ,
                                                            ptipoprocesso => vprocesso ,
                                                            pidusuario => vidusuario);
                  --
                  :P380_ID := null;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Processo realizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1030213531273347405
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('DUPLICAR','EXCLUIR','EXCLUIR_TUDO')
        }
    )

