page 380 (
    name: Conciliação Bancária
    title: Conciliação Bancária
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_confirmar(vidextrato, vdebcred, vtipotrans,vvlr) {
                var width = 1200;  // Largura da janela do modal
                var height = 800; // Altura da janela do modal
                // Calcula a posição para centralizar a janela
                var left = (window.screen.width / 2) - (width / 2);
                var top = (window.screen.height / 2) - (height / 2);
                window.open(
                    'f?p=&APP_ID.:382:&SESSION.::NO:382:P382_IDEXTRATOBANCARIO,P382_DEB_CRED,P382_TIPOTRANSFERENCIA,P382_VALOR:' + vidextrato + ',' + vdebcred + ',' + vtipotrans + ',' + vvlr,
                    'popup',
                    'toolbar=yes,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=' + width + ',height=' + height + ',screenX=' + left + ',screenY=' + top + ',left=' + left + ',top=' + top
                );
            }
            
            
            function fnc_duplicar(vidextrato)
            {
              apex.confirm("Deseja realmente duplicar este Registro?"
                          , {  request:"DUPLICAR"
                            , set:{"P380_ID":vidextrato}}
                           );
            }
            
            function fnc_excluir(vidextrato)
            {
              apex.confirm("Deseja realmente excluir esta Conciliação?"
                         , {  request:"EXCLUIR"
                            , set:{"P380_ID":vidextrato}}
                           );
            }
            
            function fnc_editar(vidextrato)
            {
            javascript:window.open('f?p=&APP_ID.:382:&SESSION.::NO:382:P382_IDEXTRATOBANCARIO,P382_VISUALIZAR:'+vidextrato+',E'
                                    ,'popup'
                                    ,'toolbar=yes,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=800,height=600,screenX=50,screenY =100');void(0);
            }
            
            function fnc_excluir_tudo(vidextrato)
            {
              
              apex.confirm("Deseja realmente excluir este registro?"
                         , {  request:"EXCLUIR_TUDO"
                            , set:{"P380_ID":vidextrato}}
                           );
            }
            /*
            function ir_doc(pdocumento,pano) 
            {
            javascript:window.open('f?p=&APP_ID.:26:&SESSION.::NO:26:P26_DOCUMENTO:'+pdocumento+','
                                                                                      +pano'
            ,'popup','toolbar=yes,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1000,height=1300,screenX=50,screenY =100');void(0);
            }*/
            
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region aviso-comercial-romance (
        name: Aviso Comercial Romance
        type: staticContent
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/alert
            templateOptions: [
                #DEFAULT#
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--success
                t-Alert--removeHeading js-removeLandmark
            ]
        }
        headerAndFooter {
            headerText: Processado com Sucesso para o Comercial Romance!
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where exists ( select 1
                               from extratosbancarios ex
                               where trunc(ex.datainclusao) = trunc(sysdate)
                                 and trunc(ex.datamovimentacao) = trunc(sysdate) -1
                                 and ex.agencia = '3414'
                                 and ex.conta = '17666'
                                 and rownum = 1 )
                ```
        }
    )

