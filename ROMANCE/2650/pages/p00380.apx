    region sistema (
        name: Sistema
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select 'Saldo 2019' descricao
                     , '0' valor
                     , 1 ordem
                from dual
                union
                select 'Saldo Anterior ' descricao
                     , '0' valor
                     , 2 ordem
                from dual
                union
                select 'Crédito' descricao
                     , nvl(trim(to_char(( nvl(dep.valor,0) + nvl(ped.valor,0) + nvl(nota.valor,0) + nvl(cat.valor,0) + nvl(cob.valor,0) ),'999G999G999G999G990D00')),0) valor
                     , 3 ordem
                from ( select sum(d.valordeposito) valor
                       from depositosdiarios_orig d
                          , contasbancarias cb
                       where trunc(d.data) between to_date(:P380_DATA_INICIO) and (:P380_DATA_FIM)
                         and cb.idcontabanc = d.idcontabanc
                         and cb.idbanco     = 60
                         and exists ( select 1
                                      from saldoscontasbancarias sb
                                      where sb.idcontabancaria = d.idcontabanc ) ) dep
                   , ( select sum(pp.valorapagar) valor
                       from favorita.parcelamentospedidos pp
                          , favorita.pedidos p
                          , contasbancarias cc
                       where pp.idpedido = p.idpedido
                         and pp.idcontabancariafilial = cc.idcontabanc
                         and cc.idbanco  = 60
                         and pp.idnegociacaoparceiro is null
                         and trunc(pp.databaixa) between to_date(:P380_DATA_INICIO) and (:P380_DATA_FIM)
                         and exists ( select 1
                                      from contasbancarias cb
                                         , saldoscontasbancarias sb
                                      where sb.idcontabancaria = cb.idcontabanc
                                        and cb.conta           = cc.conta
                                        and cb.agencia         = cc.agencia ) ) ped
                   , ( select sum(pn.valorapagar) valor
                       from parcelamentosnotasvendas pn
                          , notasvendas nv
                          , contasbancarias cc
                       where pn.idnotavenda = nv.idnotavenda
                         and pn.idcontabancariafilial = cc.idcontabanc
                         and pn.idnegociacaoparceiro is null
                         and trunc(pn.databaixa) between to_date(:P380_DATA_INICIO) and (:P380_DATA_FIM) 
                         and cc.idbanco  = 60
                         and exists ( select 1
                                      from contasbancarias cb
                                         , saldoscontasbancarias sb
                                      where sb.idcontabancaria = cb.idcontabanc
                                        and cb.conta           = cc.conta
                                        and cb.agencia         = cc.agencia ) ) nota    
                   , ( select sum(pb.valorapagar) valor
                       from catal.parcelamentosboletos pb
                          , boletos b
                          , contasbancarias cc
                       where pb.idboleto  = b.idboleto
                         and pb.idcontabancariafilial = cc.idcontabanc
                         and pb.idnegociacaoparceiro is null
                         and trunc(pb.databaixa) between to_date(:P380_DATA_INICIO) and (:P380_DATA_FIM) 
                         and cc.idbanco  = 60
                         and exists ( select 1
                                      from contasbancarias cb
                                         , saldoscontasbancarias sb
                                      where sb.idcontabancaria = cb.idcontabanc
                                        and cb.conta           = cc.conta
                                        and cb.agencia         = cc.agencia ) ) cat
                   , ( select sum(np.valornegociacao) valor
                       from negociacoesparceiros np
                          , depositosnegociacoesparc dp
                          , contasbancarias cb
                       where dp.idnegociacaoparceiro = np.idnegociacaoparceiro
                         and cb.idcontabanc = np.idcontabancaria
                         and cb.idbanco     = 60
                         and trunc(dp.dataleitura) between to_date(:P380_DATA_INICIO) and (:P380_DATA_FIM)
                         and exists ( select 1
                                      from saldoscontasbancarias sb
                                      where sb.idcontabancaria = np.idcontabancaria ) ) cob
                union
                select 'Débito' descricao
                     , nvl(trim(to_char(sum(pf.valorpago),'999G999G999G999G990D00')),0) valor
                     , 4 ordem
                from pagamentosfornecedores pf
                   , notasfiscais nf
                   , contasbancarias cb
                where trunc(pf.databaixa) between to_date(:P380_DATA_INICIO) and (:P380_DATA_FIM)
                  and nf.idnotafiscal = pf.idnotafiscal
                  and cb.idcontabanc = pf.idcontapagamento
                  and cb.idbanco     = 60
                  and exists ( select 1
                               from saldoscontasbancarias sb
                               where sb.idcontabancaria = pf.idcontapagamento )
                union
                select 'Saldo' descricao
                     , nvl(trim(to_char(sum(valor),'999G999G999G999G990D00')),0) valor
                     , 5 ordem
                from extratosbancarios ex
                where ex.tipo in ('C','D')
                  and ex.idbanco = 60
                  and ex.datamovimentacao between to_date(:P380_DATA_INICIO) and to_date(:P380_DATA_FIM)
                order by 3
                ```
        }
        layout {
            sequence: 20
            parentRegion: @itaú
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                js-useLocalStorage
                is-expanded
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        settings {
            labelColumn: DESCRICAO
            valueColumn: VALOR
            layout: 5Columns
        }
    )

