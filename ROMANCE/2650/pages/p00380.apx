    region placar (
        name: Placar
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ext.valor valorext
                     , ext.qtd qtdext
                     , nvl(con.valor,0) valorcon
                     , con.qtd qtdcon
                     , '<font color=red>'||trim(to_char(pend.valor,'999G999G999G999G999G990D00'))||'</font>' valorpend
                     , pend.qtd qtdpend
                from ( select sum(ex.valor) valor 
                            , count(ex.idextratobancario) qtd
                       from extratosbancarios ex
                       where ex.datamovimentacao between to_date(:P380_DATA_INICIO) and to_date(:P380_DATA_FIM) 
                         and ( :P380_IDBANCO is null or ex.idbanco = :P380_IDBANCO ) ) ext
                   , ( select sum(ex.valor) valor
                            , count(ex.idextratobancario) qtd
                       from extratosbancarios ex
                       where ex.datamovimentacao between to_date(:P380_DATA_INICIO) and to_date(:P380_DATA_FIM) 
                         and ( :P380_IDBANCO is null or ex.idbanco = :P380_IDBANCO ) 
                         and exists ( select 1
                                      from conciliacoesbancarias c
                                      where c.idextratobancario = ex.idextratobancario ) ) con
                   , ( select sum(ex.valor) valor 
                            , count(ex.idextratobancario) qtd
                       from extratosbancarios ex
                       where ex.datamovimentacao between to_date(:P380_DATA_INICIO) and to_date(:P380_DATA_FIM) 
                         and not exists ( select 1
                                          from conciliacoesbancarias c
                                          where c.idextratobancario = ex.idextratobancario )
                         and ( :P380_IDBANCO is null or ex.idbanco = :P380_IDBANCO ) ) pend
                ```
        }
