    region movimentações-sistema (
        name: Movimentações Sistema
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select *
                from (
                select 'Faturas Pagas' tipo
                     , pf.databaixa data
                     , nf.documento
                     , pck_romance.fnc_nomefornecedor(nf.idfornemitente) origem
                     , cb.agencia
                     , (cb.conta||' Beneficiario: '||cb.beneficiario) conta
                     , pf.valorpago
                     , pf.idpgtoforn
                     , 'D' tipoforma
                      , case 
                         when nf.documento is not null then
                           '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=2650:26:'||v('APP_SESSION')||'::NO::P26_DOCUMENTO,P26_ANO,P26_IDFORNECEDOR:'||nf.documento||','||to_char(nf.dtnf,'RRRR')||','||pf.idfornecedor,'SESSION')||''',''_blank''); void(0);"><img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt=""/></a>'
                           else
                           '-'
                       end ir_pnota
                from pagamentosfornecedores pf
                   , notasfiscais nf
                   , contasbancarias cb
                where trunc(pf.databaixa) between to_date(:P380_DATA_INICIO) and (:P380_DATA_FIM)
                  and nf.idnotafiscal = pf.idnotafiscal
                  and cb.idcontabanc = pf.idcontapagamento
                  and cb.idbanco     = :P380_IDBANCO
                  and cb.idcontabanc = :P380_IDCONTA
                  --and exists ( select 1
                  --             from saldoscontasbancarias sb
                  --             where sb.idcontabancaria = pf.idcontapagamento )
                union
                select 'Depósito Bancário' tipo
                     , d.data
                     , 'D'||d.nrocomprovante
                     , pck_romance.fnc_nomerepresentante(d.idrepresentante) origem
                     , cb.agencia
                     , (cb.conta||' Beneficiario: '||cb.beneficiario) conta
                     , d.valordeposito
                     , null
                     , 'C' tipoforma
                     , '-' ir_pnota
                from depositosdiarios_orig d
                   , contasbancarias cb
                where trunc(d.data) between to_date(:P380_DATA_INICIO) and (:P380_DATA_FIM)
                  and cb.idcontabanc = d.idcontabanc
                  and cb.idbanco     = :P380_IDBANCO
                  and cb.idcontabanc = :P380_IDCONTA ) x
                where (:P380_DEB_CRED = 'T' or x.tipoforma = :P380_DEB_CRED )
                  --and exists ( select 1
                  --             from saldoscontasbancarias sb
                  --             where sb.idcontabancaria = d.idcontabanc )
                /*union
                select 'Negociação Favorita' 
                     , pp.databaixa
                     , 'P'||p.idpedido
                     , pck_romance.fnc_nomefilial(p.idfilialromance)
                     , cc.agencia
                     , cc.conta
                     , pp.valorapagar
                from favorita.parcelamentospedidos pp
                   , favorita.pedidos p
                   , contasbancariasfiliais cc
                where pp.idpedido = p.idpedido
                  and pp.idcontabancariafilial = cc.idcontabanc
                  and cc.idbanco  = :P380_IDBANCO
                  and pp.idnegociacaoparceiro is null
                  and trunc(pp.databaixa) between to_date(:P380_DATA_INICIO) and (:P380_DATA_FIM)
                  and exists ( select 1
                               from contasbancarias cb
                                  , saldoscontasbancarias sb
                               where sb.idcontabancaria = cb.idcontabanc
                                 and cb.conta           = cc.conta
                                 and cb.agencia         = cc.agencia )
                union
                select 'Negociação Romance'
                     , pn.databaixa
                     , nv.numeronota
                     , pck_romance.fnc_nomefilial(nv.idfilial) 
                     , cc.agencia
                     , cc.conta
                     , pn.valorapagar
                from parcelamentosnotasvendas pn
                   , notasvendas nv
                   , contasbancariasfiliais cc
                where pn.idnotavenda = nv.idnotavenda
                  and pn.idcontabancariafilial = cc.idcontabanc
                  and pn.idnegociacaoparceiro is null
                  and trunc(pn.databaixa) between to_date(:P380_DATA_INICIO) and (:P380_DATA_FIM) 
                  and cc.idbanco  = :P380_IDBANCO
                  and exists ( select 1
                               from contasbancarias cb
                                  , saldoscontasbancarias sb
                               where sb.idcontabancaria = cb.idcontabanc
                                 and cb.conta           = cc.conta
                                 and cb.agencia         = cc.agencia )
                union
                select 'Negociação Boleto'
                     , pb.databaixa
                     , b.numero
                     , pck_romance.fnc_nomefilial(b.idfilial)
                     , cc.agencia
                     , cc.conta
                     , pb.valorapagar
                from catal.parcelamentosboletos pb
                   , boletos b
                   , contasbancariasfiliais cc
                where pb.idboleto  = b.idboleto
                  and pb.idcontabancariafilial = cc.idcontabanc
                  and pb.idnegociacaoparceiro is null
                  and trunc(pb.databaixa) between to_date(:P380_DATA_INICIO) and (:P380_DATA_FIM) 
                  and cc.idbanco  = :P380_IDBANCO
                  and exists ( select 1
                               from contasbancarias cb
                                  , saldoscontasbancarias sb
                               where sb.idcontabancaria = cb.idcontabanc
                                 and cb.conta           = cc.conta
                                 and cb.agencia         = cc.agencia ) 
                union
                select 'Negociação Cobraki'
                     , dp.dataleitura
                     , dp.nroidentificacao_digitado
                     , pck_romance.fnc_nomefilial(np.idfilial)
                     , cb.agencia
                     , cb.conta
                     , dp.valor_digitado
                from negociacoesparceiros np
                   , depositosnegociacoesparc dp
                   , contasbancarias cb
                where dp.idnegociacaoparceiro = np.idnegociacaoparceiro
                  and cb.idcontabanc = np.idcontabancaria
                  and cb.idbanco     = :P380_IDBANCO
                  and trunc(dp.dataleitura) between to_date(:P380_DATA_INICIO) and (:P380_DATA_FIM)
                  and exists ( select 1
                               from saldoscontasbancarias sb
                               where sb.idcontabancaria = np.idcontabancaria )*/
                ```
        }
        layout {
            sequence: 130
            slot: body
        }
