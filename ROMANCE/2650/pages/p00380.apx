    )

    pageItem P380_MENSAGEM (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: html
        }
        layout {
            sequence: 10
            region: @avisos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vmensagem varchar2(1000);
                  vdatainicio varchar2(100);
                  vdatafim varchar2(100);
                begin
                  --
                  begin
                    select to_char(cr.datainicio,'DD/MM/RRRR HH24:MI:SS')
                    into vdatainicio
                    from conciliacoesrealizadas cr
                    where cr.datafim is null;
                  exception
                    when others then
                      null;
                  end;
                  --
                  select to_char(cr.datafim,'DD/MM/RRRR HH24:MI:SS')
                  into vdatafim
                  from conciliacoesrealizadas cr
                  where cr.idconciliacaorealizada = ( select max(cc.idconciliacaorealizada)
                                                      from conciliacoesrealizadas cc
                                                      where cc.datafim is not null );
                  --
                  select case
                           when exists ( select 1
                                         from conciliacoesrealizadas c
                                         where c.datafim is null ) then
                             '<font color=''red''><h3>Conciliação em andamento, iniciada em '||vdatainicio||', aguarde....</h3></font>'
                           else
                             '<font color=''blue''><h3>Ultima conciliação realizada em '||vdatafim||'</h3></font>'
                         end mensagem
                  into vmensagem
                  from dual;
                  --
                  return vmensagem;
                  --
                end;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

