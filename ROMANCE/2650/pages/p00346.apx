page 346 (
    name: Segmentos de Negócios
    title: Segmentos de Negócios
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region segmentos (
        name: Segmentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDSEGMENTONEGOCIO  
                     , s.nome
                     , decode(s.TIPO,'C','Crisdu','A','Serviço','N','Não Operacional','I','Serviços Internos') tipo
                     , decode(s.operacional,'S','Operacional','N','Não Operacional') operacional
                     , s.CODIGO
                from SEGMENTOSNEGOCIOS s
                  
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 12282438796474626
        }

        column CODIGO (
            type: plainText
            heading {
                heading: Código
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column IDSEGMENTONEGOCIO (
            type: link
            heading {
                heading: Ver Segmento
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            link {
                target: {
                    page: 347
                    items: {
                        P347_IDSEGMENTONEGOCIO: #IDSEGMENTONEGOCIO#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column NOME (
            type: plainText
            heading {
                heading: Segmento
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column OPERACIONAL (
            type: plainText
            heading {
                heading: Operacional
                alignment: center
            }
            layout {
                sequence: 14
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column TIPO (
            type: plainText
            heading {
                heading: Tipo
                alignment: center
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 40432895 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CODIGO (
                sequence: 3
            )

            displayColumn IDSEGMENTONEGOCIO (
                sequence: 1
            )

            displayColumn NOME (
                sequence: 4
            )

            displayColumn OPERACIONAL (
                sequence: 5
            )

            displayColumn TIPO (
                sequence: 2
            )

        )

    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 347
                items: {
                    P347_CODIGO:
                    P347_IDSEGMENTONEGOCIO:
                    P347_NOME:
                    P347_TIPO:
                }
                clearCache: 347
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction create-button-dialog-closed (
        name: Create Button - Dialog Closed
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @novo
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @segmentos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

