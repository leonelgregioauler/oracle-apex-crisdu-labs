page 108 (
    name: Lista de Tipos de Negociação
    title: Lista de Tipos de Negociação
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region lista-de-tipos-de-negociação (
        name: Lista de Tipos de Negociação
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select "IDTIPONEGOCIACAO", 
                "DESCRICAO"
                from "#OWNER#"."TIPOSNEGOCIACAO" 
                  
                
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 109
                items: {
                    P109_IDTIPONEGOCIACAO: #IDTIPONEGOCIACAO#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Dados não encontrados.
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column DESCRICAO (
            type: plainText
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: DESCRICAO
                endUserAlias: B
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDTIPONEGOCIACAO (
            type: plainText
            heading {
                heading: Idtiponegociacao
                alignment: center
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDTIPONEGOCIACAO
                endUserAlias: A
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 36396 (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn DESCRICAO (
                sequence: 1
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 30
            region: @lista-de-tipos-de-negociação
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 109
                clearCache: 109
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

