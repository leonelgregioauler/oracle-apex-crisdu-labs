page 487 (
    name: Cadastro de Passagem
    alias: CADASTRO-DE-PASSAGEM
    title: Cadastro de Passagem
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
        ]
    }
    dialog {
        width: 60%
        height: 60%
        resizable: false
    }

    region cadastro-de-passagem (
        name: "Cadastro de Passagem "
        type: form
        source {
            location: localDatabase
            tableName: PASSAGENSCONVENCAO
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P487_AEROPORTO_DESTINO (
        type: textField
        label {
            label: Aeroporto Destino
            alignment: left
        }
        layout {
            sequence: 50
            region: @cadastro-de-passagem
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P487_AEROPORTO_ORIGEM (
        type: textField
        label {
            label: Aeroporto Origem
            alignment: left
        }
        layout {
            sequence: 40
            region: @cadastro-de-passagem
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P487_COMPANHIA (
        type: selectList
        label {
            label: Companhia
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:AZUL;AZUL,GOL;GOL,LATAM;LATAM,COPA;COPA,DELTA;DELTA,TAP;TAP,SKY;SKY
            nullDisplayValue: - Selecione a Companhia -
        }
        layout {
            sequence: 30
            region: @cadastro-de-passagem
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @cadastro-de-passagem
            column: COMPANHIA
            dataType: varchar2
        }
    )

    pageItem P487_COMPRAR_HOTEL (
        type: selectList
        label {
            label: Comprar Hotel?
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            nullDisplayValue: - Selecione a Opção -
        }
        layout {
            sequence: 130
            region: @cadastro-de-passagem
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @cadastro-de-passagem
            column: COMPRAR_HOTEL
            dataType: varchar2
        }
    )

    pageItem P487_DATA (
        type: datePicker
        label {
            label: Data da Passagem
            alignment: left
        }
        layout {
            sequence: 80
            region: @cadastro-de-passagem
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 30
        }
        source {
            formRegion: @cadastro-de-passagem
            column: DATA
            dataType: date
        }
    )

    pageItem P487_HORA_CHEGADA (
        type: textField
        label {
            label: Hora Chegada
            alignment: left
        }
        layout {
            sequence: 100
            region: @cadastro-de-passagem
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            formatMask: HH24:MI:SS
            width: 30
        }
        validation {
            maxLength: 20
        }
        source {
            formRegion: @cadastro-de-passagem
            column: HORA_CHEGADA
            dataType: varchar2
        }
    )

    pageItem P487_HORA_PARTIDA (
        type: textField
        label {
            label: Hora Partida
            alignment: left
        }
        layout {
            sequence: 90
            region: @cadastro-de-passagem
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            formatMask: HH24:MI:SS
            width: 30
        }
        validation {
            maxLength: 20
        }
        source {
            formRegion: @cadastro-de-passagem
            column: HORA_PARTIDA
            dataType: varchar2
        }
    )

    pageItem P487_IDPASSAGEMCONVENCAO (
        type: hidden
        layout {
            sequence: 10
            region: @cadastro-de-passagem
            slot: regionBody
        }
        source {
            formRegion: @cadastro-de-passagem
            column: IDPASSAGEMCONVENCAO
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P487_LOCALIZADOR (
        type: textField
        label {
            label: Localizador
            alignment: left
        }
        layout {
            sequence: 70
            region: @cadastro-de-passagem
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 20
        }
        source {
            formRegion: @cadastro-de-passagem
            column: LOCALIZADOR
            dataType: varchar2
        }
    )

    pageItem P487_NUMERO_VOO (
        type: textField
        label {
            label: Numero Voo
            alignment: left
        }
        layout {
            sequence: 60
            region: @cadastro-de-passagem
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 20
        }
        source {
            formRegion: @cadastro-de-passagem
            column: NUMERO_VOO
            dataType: varchar2
        }
    )

    pageItem P487_STATUS_VOO (
        type: selectOne
        label {
            label: Status Voo
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Confirmado;CONFIRMADO,Cancelado;CANCELADO,Remarcado;REMARCADO
        }
        layout {
            sequence: 120
            region: @cadastro-de-passagem
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @cadastro-de-passagem
            column: STATUS_VOO
            dataType: varchar2
        }
    )

    pageItem P487_TIPO_PASSAGEM (
        type: radioGroup
        label {
            label: Tipo Passagem
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Ida;1,Volta;2
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @cadastro-de-passagem
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @cadastro-de-passagem
            column: TIPO_PASSAGEM
            dataType: number
        }
    )

    pageItem P487_VALOR (
        type: numberField
        label {
            label: Valor
            alignment: left
        }
        layout {
            sequence: 110
            region: @cadastro-de-passagem
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button cancelar (
        buttonName: CANCELAR
        label: Cancelar
        layout {
            sequence: 110
            region: @cadastro-de-passagem
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 327
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Identificar Passageiros
        layout {
            sequence: 110
            region: @cadastro-de-passagem
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process initialize-form-cadastro-de-passagem (
        name: Initialize form Cadastro de Passagem
        type: formInitialization
        formRegion: @cadastro-de-passagem
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 82248160352305205
        }
    )

    process processo-dml-em-passagens (
        name: Processo DML em Passagens
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vmd5 varchar2(1000);
                  voperacao_dml varchar2(1);
                begin
                  --
                  if v('REQUEST') = 'CREATE' then
                    --
                    voperacao_dml := 'I';
                    --
                  elsif v('REQUEST') = 'UPDATE' then
                    --
                    voperacao_dml := 'U';
                    --
                  end if;
                  --
                  pck_cadastros_rmc.prc_passagensconvencao(pidpassagemconvencao => :P487_IDPASSAGEMCONVENCAO,
                                                           ptipo_passagem => :P487_TIPO_PASSAGEM,
                                                           pcompanhia => :P487_COMPANHIA,
                                                           pnumero_voo => :P487_NUMERO_VOO,
                                                           plocalizador => :P487_LOCALIZADOR,
                                                           pdata => :P487_DATA,
                                                           phora_partida => :P487_HORA_PARTIDA,
                                                           phora_chegada => :P487_HORA_CHEGADA,
                                                           pstatus_voo => :P487_STATUS_VOO,
                                                           pcomprar_hotel => :P487_COMPRAR_HOTEL,
                                                           pvalor => :P487_VALOR,
                                                           paeroporto_origem => :P487_AEROPORTO_ORIGEM,
                                                           paeroporto_destino => :P487_AEROPORTO_DESTINO,
                                                           pmd5 => VMD5,
                                                           poperacao_dml => voperacao_dml);
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 82251261969305236
        }
        serverSideCondition {
            type: expression
            plsqlExpression: v('REQUEST') in ('CREATE','UPDATE')
        }
    )

    branch (
        name: Go To Page 488
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 488
                items: {
                    P488_IDPASSAGEMCONVENCAO: &P487_IDPASSAGEMCONVENCAO.
                    P488_PAGINA: 487
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

)

