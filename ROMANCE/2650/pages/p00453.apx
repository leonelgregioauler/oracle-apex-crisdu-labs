    process carrega-informações-da-pagina (
        name: Carrega Informações da Pagina
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  cursor c_pessoa is
                    select p.idpessoa
                         , p.nomepessoa
                         , p.datanascimento
                         , (select listagg(translate(t.telefone,'0123456789AaBbCcDdEeFfGgHhIiJjKkLlMmNnOoPpQqRrSsTtUuVvXxYyWwZz_-,.  !@#$%?&*()/??','0123456789'),' ') within group (order by 1)
                              from telefonespessoas t
                             where t.idpessoa = p.idpessoa) telefones
                         , p.cpf
                         , (SELECT md5(p.cpf) FROM dual)md5_cpf
                      from pessoas p
                    where (p.cpf = :P453_CPF);
                  r_pessoa c_pessoa%rowtype;
                  --
                  v_franquia varchar2(200);
                  --
                begin
                  --
                  :P453_idpessoa        := null;
                  :P453_nomepessoa      := null;
                  :P453_datanascimento  := null;
                  :P453_telefones       := null;
                  :P453_cpfpessoa       := null;
                  :P453_cpf_md5         := null;
                  :P453_FRANQUIA        := null;
                  :P453_IDREPRESENTANTE := null;
                  --
                  open c_pessoa;
                  fetch c_pessoa into r_pessoa;
                  --
                  :P453_idpessoa       := r_pessoa.idpessoa;
                  :P453_nomepessoa     := nvl(r_pessoa.nomepessoa,'Não Encontrado');
                  :P453_datanascimento := r_pessoa.datanascimento;
                  :P453_telefones      := r_pessoa.telefones;
                  :P453_cpfpessoa      := r_pessoa.cpf;
                  :P453_cpf_md5        := r_pessoa.md5_cpf;
                  :P453_FRANQUIA       := v_franquia;
                  --
                  close c_pessoa;
                  --
                  if :P453_idpessoa is not null then
                    --
                    -- ##### BUSCA VENDEDORA  #####
                    begin
                      --
                      select ve.idrepresentante
                        into :P453_IDREPRESENTANTE
                        from vendedoras ve
                       where ve.idpessoa = :P453_idpessoa;
                      --
                    end;
                    --
                    if :P453_IDREPRESENTANTE is not null then
                        --
                        v_franquia := null;
                        --
                          select p.nomepessoa
                               , g.idfilial
                            into v_franquia
                               , :P453_IDFILIAL
                            from representantes r
                               , gerentes g
                               , filiais f
                               , pessoas p
                           where r.idgerente = g.idgerente
                             and g.idfilial  = f.idfilial
                             and f.idpessoa  = p.idpessoa
                             and r.idrepresentante = :P453_IDREPRESENTANTE;
                        --
                    end if;
                    --
                    -- ##### BUSCA FUNCIONARIO #####
                    if v_franquia is null then
                      --
                        begin
                        --
                        select f.idfuncionario
                            into :P453_idfuncionario
                            from funcionarios f
                        where f.idpessoa = :P453_idpessoa
                            and f.ativo    = 'S';
                        --
                        exception when no_data_found then
                        --
                        :P453_idfuncionario := null;
                        --
                        end;
                        --
                        begin
                        --
                        if :P453_idfuncionario is not null then
                            --
                            v_franquia := null;
                            --
                            select p.nomepessoa
                                , g.idfilial
                            into v_franquia
                                , :P453_IDFILIAL
                            from funcionarios ff
                                , gerentes g
                                , filiais f
                                , pessoas p
                            where ff.idgerente = g.idgerente
                            and g.idfilial  = f.idfilial
                            and f.idpessoa  = p.idpessoa
                            and ff.idfuncionario = :P453_idfuncionario;
                            --
                        end if;
                        --
                        exception when no_data_found then
                        --
                        :P453_FRANQUIA := null;
                        end;
                      --
                    end if;
                    -- ##### BUSCA REPRESENTANTE #####
                    if v_franquia is null then
                      --
                        begin
                        --
                        select r.idrepresentante
                            into :P453_IDREPRESENTANTE
                            from representantes r
                        where r.idpessoa = :P453_idpessoa
                            and r.ativo    = 'S';
                        --
                        exception when no_data_found then
                        --
                        :P453_IDREPRESENTANTE := null;
                        --
                        end;
                        --
                        begin
                        --
                        if :P453_IDREPRESENTANTE is not null then
                            --
                            v_franquia := null;
                            --
                            select p.nomepessoa
                                , g.idfilial
                                into v_franquia
                                , :P453_IDFILIAL
                                from representantes r
                                , gerentes g
                                , filiais f
                                , pessoas p
                            where r.idgerente = g.idgerente
                                and g.idfilial  = f.idfilial
                                and f.idpessoa  = p.idpessoa
                                and r.idrepresentante = :P453_IDREPRESENTANTE;
                            --
                        end if;
                        --
                        exception when no_data_found then
                        --
                        :P453_FRANQUIA := null;
                        :P453_IDREPRESENTANTE := null;
                        end;
                      --
                    end if;
                    --
                    :P453_FRANQUIA := v_franquia;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1505223979675061618
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

    process insere-histórico-aprovações (
        name: Insere Histórico Aprovações
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidhistoricosaprovacoes historicosaprovacoes.idhistoricosaprovacoes%type;
                  vidpessoa               historicosaprovacoes.idpessoa%type;
                  vdocumento              historicosaprovacoes.documento%type;
                  vdatahistorico          historicosaprovacoes.datahistorico%type;
                  vsituacao               historicosaprovacoes.situacao%type;
                  vobservacao             historicosaprovacoes.observacao%type;
                  vmd5                    varchar2(1000);
                  voperacao_dml           varchar2(1) := 'I';
                  --
                begin
                  --
                  if v('REQUEST') = 'APROVAR' then
                    vsituacao     := 'A';
                    elsif v('REQUEST') = 'REPROVAR' then
                    vsituacao      := 'R';
                  end if;
                  --
                  if :P453_OBSERVACAO_CPF is null then
                    --
                    raise_application_error(-20000,'Informe uma observação');
                    --
                  end if;
                  --
                  vidpessoa      := :P453_idpessoa;
                  vdocumento     := :P453_CPF;
                  vdatahistorico := sysdate;
                  vobservacao    := :P453_OBSERVACAO_CPF;
                  --
                  if voperacao_dml = 'I' then
                    --
                    pck_cadastros_rmc.prc_historicosaprovacoes ( pidhistoricosaprovacoes => vidhistoricosaprovacoes
                                                               , pidpessoa               => vidpessoa
                                                               , pdocumento              => vdocumento
                                                               , pdatahistorico          => vdatahistorico
                                                               , psituacao               => vsituacao
                                                               , pobservacao             => vobservacao
                                                               , pmd5                    => vmd5
                                                               , poperacao_dml           => voperacao_dml );
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1505669871182836501
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('APROVAR','REPROVAR')
                ```
        }
    )

)

