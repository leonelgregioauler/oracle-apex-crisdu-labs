    region histórico-aprovações (
        name: Histórico Aprovações
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ha.idhistoricosaprovacoes
                     , ha.idpessoa
                     , ha.documento
                     , ha.datahistorico
                     , decode(ha.situacao,'A','Aprovado','Reprovado') situacao
                     , ha.observacao
                     , cpf
                  from historicosaprovacoes ha
                 where ha.cpf = replace(replace(:P453_CPF,'.',''),'-','')
                 order by 1 desc
                ```
        }
        layout {
            sequence: 40
            parentRegion: @consulta-spc
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent2
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from historicosaprovacoes ha
                 where ha.cpf = replace(replace(:P453_CPF,'.',''),'-','')
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
