    region informações-da-consulta-ao-spc (
        name: Informações da Consulta ao SPC
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.dataconsulta
                     , c.protocolo
                     , c.regiaocpf
                     , c.situacaocpf
                     , c.nome
                     , c.nomemae
                     , case
                         when spc_quantidade > 0 then
                           '<font color="red"><b>'||spc_quantidade||'</b></font>'
                         else
                           '<font color="blue"><b>'||spc_quantidade||'</b></font>'
                       end spc_quantidade
                     , case
                         when spc_quantidade > 0 then
                           '<font color="red"><b>'||spc_quantidade||'</b></font>'
                         else
                           '<font color="blue"><b>'||spc_quantidade||'</b></font>'
                       end spc_quantidade_franquias
                     , c.spc_valortotal
                     , decode(c.restricao,'S','Possui Restrição','Sem Restrição') restricao
                     , idconsultaspc
                     , datanascimento
                     , case
                         when ccf > 0 then
                           '<font color="red"><b>'||ccf||'</b></font>'
                         else
                           '<font color="blue"><b>'||ccf||'</b></font>'
                       end ccf
                from consultaspc c
                where c.cpf = replace(replace(:P453_CPF,'.',''),'-','')
                order by 1 desc
                ```
            pageItemsToSubmit: P453_CPF
        }
        layout {
            sequence: 20
            parentRegion: @consulta-spc
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent2
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from consultaspc c
                where c.cpf = replace(replace(:P453_CPF,'.',''),'-','')
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        messages {
            whenNoDataFound: Nenhuma consulta encontrada.
        }

