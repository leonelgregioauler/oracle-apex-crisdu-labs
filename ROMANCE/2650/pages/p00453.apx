    region dívida-ativa (
        name: Dívida Ativa
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) distribuidor
                     , r.totalcheques
                     , r.totalchequespago
                     , r.totalcheques - r.totalchequespago saldocheques
                     , r.cheques
                     , r.pgtoscheques
                     , r.cheques - pgtoscheques saldochequesdev
                     , r.totalemprestimos
                     , r.totalemprestimospago
                     , r.totalemprestimos - r.totalemprestimospago saldoemprestimos
                     , r.debitosromance
                     , r.debitosfavorita
                     , r.saldoacerto
                     , r.saldodefeitos
                     , case
                         when r.saldoacerto >= 0 then
                           ((r.totalcheques - r.totalchequespago)
                           +(r.totalemprestimos - r.totalemprestimospago)
                           +(r.cheques - pgtoscheques)
                           + r.debitosromance
                           + r.debitosfavorita
                           + r.saldoacerto
                           + r.saldodefeitos)
                         when r.saldoacerto < 0 then
                           ( (r.totalcheques - r.totalchequespago)
                           + (r.totalemprestimos - r.totalemprestimospago)
                           + (r.cheques - pgtoscheques)
                           + r.debitosromance
                           + r.debitosfavorita
                           + r.saldodefeitos) 
                       end dividatotal
                     , case
                         when r.saldoacerto < 0 then
                           0
                         else
                           r.saldoacerto
                       end saldoacertopositivo
                     , r.saldobalanco
                from ( 
                       select idrepresentante
                            , nvl(( select sum(c.VALOR) saldo
                                    from CHEQUES2 c --------------------------------------------------------------------------------------------############################################
                                    where c.semfundo = 'S'
                                      and nvl(c.emprestimo,'N') = 'N'
                                      and c.idrepresentante = r.idrepresentante ),0) totalcheques
                            , nvl(( select sum(cp.valor)
                                    from cheques2pgto cp --------------------------------------------------------------------------------------------############################################
                                    where exists ( select 1
                                                   from cheques2 c
                                                   where c.idrepresentante = r.idrepresentante
                                                     and c.semfundo        = 'S'
                                                     and nvl(c.emprestimo,'N') = 'N'
                                                     and c.idcheque        = cp.idcheque )),0) totalchequespago
                            , nvl(( select sum(cc.valor)
                                    from cheques2 cc --------------------------------------------------------------------------------------------############################################
                                    where nvl(cc.semfundo,'N') = 'S'
                                      and cc.emprestimo = 'S'
                                      and cc.idrepresentante = r.idrepresentante),0) cheques
                            , nvl(( select sum(pgc.valor)
                                    from cheques2pgto pgc --------------------------------------------------------------------------------------------############################################
                                    where exists ( select 1
                                                   from cheques2 cc
                                                   where nvl(cc.semfundo,'N') = 'S'
                                                     and cc.emprestimo = 'S'
                                                     and cc.idrepresentante = r.idrepresentante
                                                     and cc.idcheque = pgc.idcheque )),0) pgtoscheques
                            , nvl(( select sum(nvl(valor,0)+nvl(valorjuros,0))
                                    from emprestimos e --------------------------------------------------------------------------------------------############################################
                                    where e.idrepresentante = r.idrepresentante),0) totalemprestimos
                            , nvl(( select sum(pe.valorpago)
                                    from pagamentosemprestimos pe --------------------------------------------------------------------------------------------############################################
                                    where exists ( select 1
                                                   from emprestimos e
                                                   where e.idrepresentante = r.idrepresentante
                                                     and e.idemprestimo    = pe.idemprestimo )
                                      and pe.data <= trunc(sysdate)),0) totalemprestimospago
                            , nvl(( select sum(nv.saldo)
                                    from notasvendas nv --------------------------------------------------------------------------------------------############################################
                                    where nv.saldo > 0
                                      --and nv.idsituacaocobranca = 70 -- Distribuidor Recebeu/Responsabilizou
                                      and nv.idsituacaonotavenda in (4,5) -- 4 acerto efetuado / 5 cancelado
                                      and nv.idvendedora = (select idvendedora 
                                                              from vendedoras 
                                                             where idpessoa = :P453_IDPESSOA )),0) debitosromance
                            , nvl(( select f.saldo
                                    from fechamentorepresentantes f --------------------------------------------------------------------------------------------############################################
                                    where f.idfechamentorepres = ( select max(idfechamentorepres)
                                                                   from fechamentorepresentantes ff
                                                                   where ff.idrepresentante = r.idrepresentante
                                                                     and exists ( select 1
                                                                                  from fechamentossemanais fs
                                                                                  where fs.idfechamento = ff.idfechamento
                                                                                    and fs.concluido    = 'S' ))),0) saldoacerto
                            , nvl(( select sum( ((( nvl(ii.qtd_pp,0)
                                                  + nvl(ii.qtd_p,0)
                                                  + nvl(ii.qtd_m,0)
                                                  + nvl(ii.qtd_g,0)
                                                  + nvl(ii.qtd_gg,0)
                                                  + nvl(ii.qtd_egg,0)
                                                  + nvl(ii.qtd_exgg,0)
                                                  + nvl(ii.qtd_u,0) ) * ii.valorproduto )*decode(ii.comissao,'S',0.6,1))
                                               - 
                                               ((( nvl(ii.qtd_pp,0) 
                                                  + nvl(ii.qtd_p,0)
                                                  + nvl(ii.qtd_m,0)
                                                  + nvl(ii.qtd_g,0)
                                                  + nvl(ii.qtd_gg,0)
                                                  + nvl(ii.qtd_egg,0)
                                                  + nvl(ii.qtd_exgg,0)
                                                  + nvl(ii.qtd_u,0) ) * ii.valorproduto )*decode(ii.comissao,'S',0.6,1))*nvl((select c.percpromotor
                                                                                                                             from comissoesfiliais c
                                                                                                                                , fechamentorepresentantes fe
                                                                                                                             where fe.idrepresentante = d.idrepresentante
                                                                                                                               and fe.semana          = d.semana
                                                                                                                               and c.idcomissaofilial = fe.idcomissao
                                                                                                                               and rownum = 1)/100,0.2))
                                    from itensdevolucaorepres ii
                                       , devolucoesrepresentantes d
                                    where ii.origemdefeito = 'R'
                                      and ii.iddefeito         is not null
                                      and ii.idfechamentoreprespago is null
                                      and ii.situacaodefeito is null
                                      and d.iddevolucaorepres = ii.iddevolucaorepres
                                      and d.idrepresentante   = r.idrepresentante 
                                      and d.idsemana         >= 668 ),0) saldodefeitos
                            , nvl((select b.valororiginal valor
                                     from catal.boletos b
                                    where b.situacao in ('V','G','S','M','K','E')
                                      and b.idvendedora = (select idvendedora 
                                                             from vendedoras 
                                                            where idpessoa        = :P453_IDPESSOA 
                                                              and idrepresentante = r.idrepresentante)),0)
                             + nvl((select sum(p.valorapagar - p.valorpago)
                                      from favorita.vw_pedidos_fav p
                                     where p.idvendedora = (select idvendedora 
                                                              from vendedoras 
                                                             where idpessoa        = :p453_idpessoa
                                                               and idrepresentante = r.idrepresentante)
                                       and exists ( select 1
                                                      from favorita.vencimentospedidos v
                                                     where v.idpedido           = p.idpedido
                                                       and v.datavencimento     < sysdate
                                                       and v.valorpago          < v.valorpagar
                                                       and v.situacaovencimento = 'V')
                                       and p.datacancelamento is null
                                       and not exists ( select 1 
                                                          from favorita.classificacoespedidos c
                                                         where c.idpedido = p.idpedido
                                                           and c.idcaracteristicapedido = 46 ) -- Incobrável
                                       and p.ididioma = 1),0) debitosfavorita
                            , nvl((select sum(n.saldo)
                                   from vw_negociacoes_rmc n
                                   where n.idtiponegociacao = 3 -- Balanço 
                                   and n.idrepresentante = r.idrepresentante),0) saldobalanco 
                       from representantes r
                       where r.idrepresentante = :P453_IDREPRESENTANTE
                         and r.idgerente = ( select idgerente
                                             from gerentes g
                                             where g.idfilial = :P453_IDFILIAL ) )  r;
                ```
        }
        layout {
            sequence: 40
            parentRegion: @dados-da-consulta
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        messages {
            whenNoDataFound: Nenhum débito encontrado.
        }

