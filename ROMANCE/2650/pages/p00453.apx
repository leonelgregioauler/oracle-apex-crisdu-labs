    button aprovar (
        buttonName: APROVAR
        label: Aprovar
        layout {
            sequence: 30
            region: @consulta-spc
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 457
                items: {
                    P457_CPF: &P453_CPF.
                    P457_IDPESSOA: &P453_IDPESSOA.
                    P457_APROVA_REPROVA: A
                    P457_TITULO: APROVAR
                }
                clearCache: 457
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from consultaspc c
                where c.cpf = replace(replace(:P453_CPF,'.',''),'-','')
                ```
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Pesquisar
        layout {
            sequence: 60
            region: @consulta-documento
            slot: regionBody
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reprovar (
        buttonName: REPROVAR
        label: Reprovar
        layout {
            sequence: 20
            region: @consulta-spc
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 457
                items: {
                    P457_IDPESSOA: &P453_IDPESSOA.
                    P457_CPF: &P453_CPF.
                    P457_APROVA_REPROVA: R
                    P457_TITULO: REPROVAR
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from consultaspc c
                where c.cpf = replace(replace(:P453_CPF,'.',''),'-','')
                ```
        }
    )

    button spc (
        buttonName: SPC
        label: Consultar ao SPC
        layout {
            sequence: 10
            region: @cliente
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P453_CPF
        }
    )

    dynamicAction botão-spc (
        name: Botão SPC
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P453_IDPESSOA
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P453_IDPESSOA
        }
    )

    dynamicAction consulta-spc (
        name: Consulta SPC
        execution {
            sequence: 50
        }
        when {
            event: click
            selectionType: button
            button: @spc
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    vretorno varchar2(2000);
                    begin
                    select sys.utl_http.request('http://192.168.201.59:15084/'||:P453_CPF||'/'||:P453_CPF_MD5||'/'||:P0_IDFILIAL||'/'||v('APP_USER')||'/?prod=true')
                      into vretorno
                      from dual
                     where :P453_CPF is not null;
                    end;
                    -- Nao tem suporte para homolog
                    -- Para banco desenv usar:   sys.utl_http.request('http://192.168.201.59:15084/'||:P453_CPF||'/'||:P453_CPF_MD5||'/'||:P0_IDFILIAL||'/'||v('APP_USER')||'/?prod=true')
                    -- Para banco Produção usar: sys.utl_http.request('http://192.168.201.59:15084/'||:P453_CPF||'/'||:P453_CPF_MD5||'/'||:P0_IDFILIAL||'/'||v('APP_USER')||'/?dev=true')
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction seleciona-cpf (
        name: Seleciona CPF
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P453_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P453_TIPO
            value: C
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P453_CPF
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P453_CPF
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction seleciona-doc-estrangeiro (
        name: Seleciona Doc Estrangeiro
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P453_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P453_TIPO
            value: D
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P453_DOCUMENTOESTRANGEIRO
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P453_DOCUMENTOESTRANGEIRO
            }
            execution {
                sequence: 10
            }
        )

    )

    validation aprova-cpf (
        name: Aprova CPF
        execution {
            sequence: 20
        }
        validation {
            plsqlExpression: :P453_OBSERVACAO_CPF is not null
        }
        error {
            errorMessage: Observação é obrigatória!
            associatedItem: @P453_OBSERVACAO_CPF
        }
        serverSideCondition {
            whenButtonPressed: @aprovar
        }
    )

    validation falta-numeros-cpf (
