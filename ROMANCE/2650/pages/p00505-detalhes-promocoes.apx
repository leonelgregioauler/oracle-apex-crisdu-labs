page 505 (
    name: Detalhes Promocoes
    alias: DETALHES-PROMOCOES
    title: Detalhes Promocoes
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region promoções (
        name: Promoções
        type: form
        source {
            location: localDatabase
            tableName: PROMOCOESCOMPRAS
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P505_IDPROMOCAOCOMPRA (
        type: hidden
        layout {
            sequence: 10
            region: @promoções
            slot: regionBody
        }
        source {
            formRegion: @promoções
            column: IDPROMOCAOCOMPRA
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P505_NOMEPROMOCAO (
        type: textarea
        label {
            label: <strong>Descrição da Promoção:</strong>
            alignment: left
        }
        layout {
            sequence: 40
            region: @promoções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--xlarge
            ]
            width: 60
            height: 4
        }
        validation {
            valueRequired: true
            maxLength: 500
        }
        source {
            formRegion: @promoções
            column: NOMEPROMOCAO
            dataType: varchar2
        }
    )

    pageItem P505_VALIDADEFINAL (
        type: datePicker
        label {
            label: <strong>Validade Final:</strong>
            alignment: left
        }
        layout {
            sequence: 30
            region: @promoções
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--xlarge
            ]
            formatMask: dd/mm/rrrr
            width: 15
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @promoções
            column: VALIDADEFINAL
            dataType: date
        }
    )

    pageItem P505_VALIDADEINICIAL (
        type: datePicker
        label {
            label: <strong>Validade Inicial:</strong>
            alignment: left
        }
        layout {
            sequence: 20
            region: @promoções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--xlarge
            ]
            formatMask: dd/mm/rrrr
            width: 15
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @promoções
            column: VALIDADEINICIAL
            dataType: date
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @promoções
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 504
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Incluir
        layout {
            sequence: 40
            region: @promoções
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P505_IDPROMOCAOCOMPRA
        }
    )

    button delete (
        buttonName: DELETE
        label: Excluir
        layout {
            sequence: 20
            region: @promoções
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P505_IDPROMOCAOCOMPRA
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar Alterações
        layout {
            sequence: 30
            region: @promoções
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P505_IDPROMOCAOCOMPRA
        }
    )

    validation new (
        name: New
        execution {
            sequence: 10
        }
        validation {
            plsqlExpression: :P505_VALIDADEINICIAL >= TRUNC(SYSDATE)
        }
        error {
            errorMessage: Validade Inicial deve ser maior ou igual a data atual
            associatedItem: @P505_VALIDADEINICIAL
        }
    )

    validation new-2 (
        name: New_1
        execution {
            sequence: 20
        }
        validation {
            plsqlExpression: to_date(:P505_VALIDADEFINAL) > to_date(:P505_VALIDADEINICIAL)
        }
        error {
            errorMessage: Data Final deve ser maior que data inicial
            associatedItem: @P505_VALIDADEFINAL
        }
    )

    process initialize-form-detalhes-promocoes (
        name: Initialize form Detalhes Promocoes
        type: formInitialization
        formRegion: @promoções
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 49148250578850273
        }
    )

    process process-form-detalhes-promocoes (
        name: Process form Detalhes Promocoes
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vmd5 varchar2(4000);
                  voperacao varchar2(1);
                  vid number;
                  vvalor number;
                begin
                  --
                  vid := :P505_IDPROMOCAOCOMPRA;
                  --
                  --raise_application_error(-20001,'teste '||v('REQUEST') );
                  if v('REQUEST')  = 'CREATE' then
                      voperacao := 'I';
                  elsif v('REQUEST')  = 'SAVE' then
                      voperacao := 'U';
                  elsif v('REQUEST')  = 'DELETE' then
                      voperacao := 'D';
                  else
                      voperacao := 'S';
                  end if;
                  --
                  /*if voperacao in ('U','I') and 
                     ( to_date(:P505_VALIDADEINICIAL) < trunc(sysdate) or 
                       to_date(:P505_VALIDADEINICIAL) >= to_date(:P505_VALIDADEFINAL) ) then 
                     raise_application_error(-20001,'Período de Validade inválido. Verifique!' );
                  end if;*/
                  --
                  pck_compras_romance.prc_promocoescompras(pidpromocaocompra => vid,
                                                           pvalidadeinicial  => :P505_VALIDADEINICIAL,
                                                           pvalidadefinal    => :P505_VALIDADEFINAL,
                                                           pnomepromocao     => :P505_NOMEPROMOCAO,
                                                           pmd5              => vmd5,
                                                           poperacao_dml     => voperacao);  
                  commit;
                  --
                  :P505_IDPROMOCAOCOMPRA := vid;
                
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 49148688781850274
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 504
            }
        }
    )

)

