page 171 (
    name: Pagamentos Efetuados
    title: Pagamentos Efetuados
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function deletapgto(pid)
            {
            
              var answer = confirm("Confirma exlusão do pagamento da comissão?")
              if (answer)
                {
                  document.getElementById('P171_DELETAR').value = pid;
                  apex.submit('DELETAR');
                }
            }
            ```
        executeWhenPageLoads: window.opener.location.reload();
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region pagamentos-efetuados (
        name: Pagamentos Efetuados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select '<a href="javascript: deletapgto('||idpgtocomissao||')"> Excluir Pgto</a>' idpgtocomissao
                     , datapagamento "Data Pgto"
                     , valorpago "Valor Pago"
                     , p.fechamento "Fechamento"
                from pagamentocomissoes p
                where ( ( :P171_IDREPRESENTANTE is not null and p.idrepresentante = :P171_IDREPRESENTANTE )
                      or (:P171_IDGERENTE is not null and p.idgerente = :P171_IDGERENTE ) )
                  and exists ( select 1
                               from fechamentossemanais f
                               where f.semana = :P171_FECHAMENTO
                                 AND F.Semana = p.fechamento
                                 and  ( (pck_romance.fnc_verificaacesso('PERM_ALTERAFECHA', v('APP_USER')) = 'S')
                                      or (nvl(f.concluido,'N') = 'N'
                                       and f.idfilial = (select f.idfilial 
                                                         from filiais    f
                                                            , usuarios   u
                                                            , gerentes   g
                                                         where g.idfilial  = f.idfilial
                                                           and u.idgerente = g.idgerente
                                                           and u.usuario   = V('APP_USER') ))))
                union
                select null idpgtocomissao
                     , datapagamento "Data Pgto"
                     , valorpago "Valor Pago"
                     , p.fechamento "Fechamento"
                from pagamentocomissoes p
                where ( ( :P171_IDREPRESENTANTE is not null and p.idrepresentante = :P171_IDREPRESENTANTE )
                      or (:P171_IDGERENTE is not null and p.idgerente = :P171_IDGERENTE ) )
                  and exists ( select 1
                               from fechamentossemanais f
                               where f.semana != :P171_FECHAMENTO
                                 AND F.Semana = p.fechamento
                                 and  ( (pck_romance.fnc_verificaacesso('PERM_ALTERAFECHA', v('APP_USER')) = 'S')
                                      or (nvl(f.concluido,'N') = 'S'
                                       and f.idfilial = (select f.idfilial 
                                                         from filiais    f
                                                            , usuarios   u
                                                            , gerentes   g
                                                         where g.idfilial  = f.idfilial
                                                           and u.idgerente = g.idgerente
                                                           and u.usuario   = V('APP_USER') ))))
                ```
        }
        layout {
            sequence: 20
            parentRegion: @page_plug
            slot: subRegions
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        pagination {
            type: setPaginationSearchEngine
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Não há pedidos vencidos.
        }
        componentAdvanced {
            stripHtml: true
        }

        column "Data Pgto" (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Data Pgto
                alignment: center
            }
            layout {
                sequence: 2
            }
            sorting {
                defaultSequence: 1
                direction: desc
            }
        )

        column Fechamento (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Fechamento
                alignment: center
            }
            layout {
                sequence: 4
            }
        )

        column IDPGTOCOMISSAO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Excluir
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column "Valor Pago" (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Valor Pago
                alignment: end
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            advanced {
                computeSum: true
            }
        )

    )

    region page_plug (
        name: " "
        type: staticContent
        layout {
            sequence: 1
            slot: body-3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P171_DELETAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @page_plug
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P171_FECHAMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @pagamentos-efetuados
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P171_IDGERENTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @page_plug
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P171_IDREPRESENTANTE (
        type: selectList
        label {
            label: Representante:
            alignment: left
            tableCellAttributes: nowrap="nowrap"
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) Nome
                     , r.idrepresentante
                from pessoas p
                   , representantes r
                where r.idpessoa  = p.idpessoa  
                  and r.idrepresentante = :P171_IDREPRESENTANTE
                ```
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @page_plug
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            height: 1
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button imprimir (
        buttonName: IMPRIMIR
        label: Imprimir
        layout {
            sequence: 10
            region: @page_plug
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:window.print();
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process excluir (
        name: excluir
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  delete pagamentocomissoes
                  where idpgtocomissao = :P171_DELETAR;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 298334330171608740
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 171
                items: {
                    P171_IDREPRESENTANTE: &P171_IDREPRESENTANTE.
                    P171_FECHAMENTO: &P171_FECHAMENTO.
                }
                successMessage: false
            }
        }
        comments {
            comments: Created 06-FEV-2012 10:19 by ROMAN
        }
    )

)

