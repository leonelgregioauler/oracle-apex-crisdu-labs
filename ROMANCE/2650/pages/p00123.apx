    region recebimento-detalhado (
        name: Recebimento Detalhado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomeproduto(i.idproduto) "Produto"
                  , nvl(i.qtd_pp,0)
                  , nvl(i.qtd_p,0)
                  , nvl(i.qtd_m,0)
                  , nvl(i.qtd_g,0)
                  , nvl(i.qtd_gg,0)
                  , nvl(i.qtd_egg,0)
                  , nvl(i.qtd_exgg,0)
                  , nvl(i.qtd_u,0)
                  , nvl(i.qtd_total,0)
                  , null "/"
                  , nvl(i.qtd_pp_chegou,0)
                  , nvl(i.qtd_p_chegou,0)
                  , nvl(i.qtd_m_chegou,0)
                  , nvl(i.qtd_g_chegou,0)
                  , nvl(i.qtd_gg_chegou,0)
                  , nvl(i.qtd_egg_chegou,0)
                  , nvl(i.qtd_exgg_chegou,0)
                  , nvl(i.qtd_u_chegou,0)
                  , nvl(i.qtd_total_chegou,0)
                  , null "/1"
                  , (nvl(i.qtd_pp_chegou,0) - nvl(i.qtd_pp,0)) difpp
                  , (nvl(i.qtd_p_chegou,0) - nvl(i.qtd_p,0)) difp
                  , (nvl(i.qtd_m_chegou,0) - nvl(i.qtd_m,0)) difm
                  , (nvl(i.qtd_g_chegou,0) - nvl(i.qtd_g,0)) difg
                  , (nvl(i.qtd_gg_chegou,0) - nvl(i.qtd_gg,0)) difgg
                  , (nvl(i.qtd_egg_chegou,0) - nvl(i.qtd_egg,0)) difegg
                  , (nvl(i.qtd_exgg_chegou,0) - nvl(i.qtd_exgg,0)) difexgg
                  , (nvl(i.qtd_u_chegou,0) - nvl(i.qtd_u,0)) difu
                  , ((nvl(i.qtd_pp_chegou,0) - nvl(i.qtd_pp,0))
                  + (nvl(i.qtd_p_chegou,0) - nvl(i.qtd_p,0))
                  + (nvl(i.qtd_m_chegou,0) - nvl(i.qtd_m,0))
                  + (nvl(i.qtd_g_chegou,0) - nvl(i.qtd_g,0))
                  + (nvl(i.qtd_gg_chegou,0) - nvl(i.qtd_gg,0))
                  + (nvl(i.qtd_egg_chegou,0) - nvl(i.qtd_egg,0)) 
                  + (nvl(i.qtd_exgg_chegou,0) - nvl(i.qtd_exgg,0))
                  + (nvl(i.qtd_u_chegou,0) - nvl(i.qtd_u,0)) ) totaldif
                  , null "/2"
                  , i.custound
                  , sum( ((nvl(i.qtd_pp_chegou,0) - nvl(i.qtd_pp,0))*i.custound)
                       + ((nvl(i.qtd_p_chegou,0) - nvl(i.qtd_p,0))*i.custound)
                       + ((nvl(i.qtd_m_chegou,0) - nvl(i.qtd_m,0))*i.custound)
                       + ((nvl(i.qtd_g_chegou,0) - nvl(i.qtd_g,0))*i.custound)
                       + ((nvl(i.qtd_gg_chegou,0) - nvl(i.qtd_gg,0))*i.custound)
                       + ((nvl(i.qtd_egg_chegou,0) - nvl(i.qtd_egg,0))*i.custound)
                       + ((nvl(i.qtd_exgg_chegou,0) - nvl(i.qtd_exgg,0))*i.custound)
                       + ((nvl(i.qtd_u_chegou,0) - nvl(i.qtd_u,0))*i.custound) ) vlrtotal
                from notasfiscais nf
                   , itemnf i
                where nf.idnotafiscal = i.idnotafiscal
                  and i.idnotafiscal = :P123_IDNOTAFISCAL
                  and (:P123_IDITEMNOTA is null or i.iditnf = :P123_IDITEMNOTA)
                group by idproduto
                , i.qtd_pp
                , i.qtd_p
                , i.qtd_m
                , i.qtd_g
                , i.qtd_gg
                , i.qtd_egg
                , i.qtd_exgg
                , i.qtd_u
                , i.qtd_total
                , i.qtd_pp_chegou
                , i.qtd_p_chegou
                , i.qtd_m_chegou
                , i.qtd_g_chegou
                , i.qtd_gg_chegou
                , i.qtd_egg_chegou
                , i.qtd_exgg_chegou
                , i.qtd_u_chegou
                , i.qtd_total_chegou
                , i.custound
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 207040374265710753
        }

