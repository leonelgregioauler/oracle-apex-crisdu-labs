    region negociações-realizadas (
        name: Negociações Realizadas
        title: Negociações Realizadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.idnegociacao
                     , w.idnegociacao as detalhar_idnegociacao
                     , w.idnegociacao as "ID Neg"
                     , w.tiponegociacao
                     , w.filial
                     , w.distribuidor
                     , w.pessoa
                     , w.data 
                     , w.usuario
                     , nvl(w.valor,0) valor
                     , nvl(w.valorjuros,0) valorjuros
                     , nvl(w.valortotal,0) valortotal
                     , nvl(w.entrada,0) entrada
                     , nvl(w.valorpago,0) valorpago
                     , nvl(w.saldo,0) saldo
                     , nvl(w.valordescontonegociacao,0) valordescontonegociacao
                     , decode(w.perda,'Sim','Sim','N o','Não','Não') perda
                     , w.idfechamento
                     , decode(w.cancelado,'S','Sim','Não') Cancelado
                     , w.observacao
                     --, ( select cr.descricao
                        -- from roman.caracteristicasnegociacoes cr 
                        -- where cr.idcaracteristicanegociacao = c.idcaracteristicanegociacao ) classificacao  --osiel - Ticket 10684649
                  from roman.vw_negociacoes_rmc w
                    -- , roman.classificacoesnegociacoes c
                 where-- c.idnegociacao = w.idnegociacao
                 -- Data Inicial e final 
                       w.data between to_date(:P404_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') 
                                  and to_date(:P404_DATAFIM||' 23:23:59','DD/MM/RRRR HH24:MI:SS') 
                       -- Tipo de Negaciação
                   and ( :P404_TIPO_NEGOCIACAO is null or w.idtiponegociacao = :P404_TIPO_NEGOCIACAO )
                       -- Situação da Negociação
                   and (  ( :P404_SITUACAO is null )
                       or ( :P404_SITUACAO = 'A' and w.saldo > 0  )
                       or ( :P404_SITUACAO = 'P' and w.saldo = 0 ) 
                       or ( :P404_SITUACAO = 'C' and w.cancelado = 'S' )
                       or ( :P404_SITUACAO = 'V' and exists ( select 1
                                                                from roman.pagamentosnegociacoes pag
                                                               where pag.idnegociacao = w.idnegociacao
                                                                 and pag.situacao = 'V' )))
                       -- Região (Brail ou América Latina)
                   and (  ( :P404_REGIAO is null )
                       or ( :P404_REGIAO = 1 and exists ( select 1 --brasil
                                                            from roman.vw_filiais f
                                                           where f.idfilial = w.idfilial
                                                             and f.idgrupo is not null
                                                             and f.ididioma = 1 ))
                       or ( :P404_REGIAO = 2 and exists ( select 1 --america latina
                                                            from roman.vw_filiais f
                                                           where f.idfilial = w.idfilial
                                                             and f.idgrupo is not null
                                                             and f.ididioma != 1 )))
                   -- Filial
                   and ( :P404_IDFILIAL is null or w.idfilial = :P404_IDFILIAL)
                   -- Distribuidor
                   and ( :P404_DISTRIBUIDOR is null or w.idrepresentante = :P404_DISTRIBUIDOR)
                   -- Classificação (multi-seleção)
                   and (  :P404_CLASSIFICACAO is null
                       or exists ( select 1
                                     from roman.classificacoesnegociacoes c
                                    where c.idnegociacao = w.idnegociacao
                                      and c.idcaracteristicanegociacao in ( select column_value
                                                                              from table(apex_string.split_numbers(:P404_CLASSIFICACAO, ':')) ) ) )
                 order by w.data
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P404_RELATORIO
            value: 1
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 761605104600140618
        }

