            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction trava-botão-nova-negociação (
        name: Trava botão nova negociação
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P404_TIPO_NEGOCIACAO
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @nova-negociação
            }
            execution {
                sequence: 10
            }
        )

    )

)

