page 404 (
    name: Negociações
    alias: NEGOCIAÇÕES
    title: Negociações
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }

    region cheques (
        name: Cheques
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idcheque
                     , c.idcheque as "detalhar_idcheque"
                     , c.idcheque as "ID Cheque"
                     , initcap(bb.nomebanco) Banco
                     , AGENCIA
                     , CONTA
                     , NRCHEQUE
                     , DATAINCLUSAO
                     , pck_romance.fnc_nomefilial(c.idfilial) "Filial"
                     , pck_romance.fnc_nomerepresentante(c.idrepresentante) Representante
                     , pck_romance.fnc_nomePessoa(c.idpessoa) Pessoa
                     , pck_romance.fnc_nomecidade(c.idcidade) cidade
                     , VALOR
                     , PREDATADO
                     , pck_romance.fnc_nomefornecedor(c.idfornecedor) Fornecedor
                     , c.OBSERVACAO
                     , c.DESTINO
                     , decode(c.semfundo, 'S','Sim', 'Não') Semfundo
                     , decode(c.pago, 'S','Sim', 'Não') Pago
                     , decode(c.emprestimo, 'S','Sim', 'Não') Emprestimo
                     , decode(c.perda, 'S','Sim', 'Não') Perda
                     , nvl(( select sum(cp.valor) from cheques2pgto cp where cp.idcheque = c.idcheque),0) "Valor Pago"
                     , VALOR - nvl(( select sum(cp.valor) from cheques2pgto cp where cp.idcheque = c.idcheque),0) "Saldo"
                     , ( select decode(ativo ,'S','Sim','Não')
                         from representantes r
                         where r.idrepresentante = c.idrepresentante ) Ativo
                     , NUMEROCONSULTA "Nro Consulta"
                     , null veranexos
                     , decode(c.chequepredatado,'S','Sim','Não') chequepredatado
                     , ( select i.descricao
                         from identificacaocheques i
                         where i.ididentificacaocheque = c.identificacao ) identificacao
                     , juros
                     , taxas
                  from roman.cheques2 c
                     , roman.bancos   bb
                 where c.idbanco = bb.idbanco(+)
                       -- Data Inicial e final 
                   and c.datainclusao between to_date(:P404_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') 
                                          and to_date(:P404_DATAFIM||' 23:23:59','DD/MM/RRRR HH24:MI:SS') 
                       -- Situação
                   and (   ( :P404_SITUACAO is null)
                        or ( :P404_SITUACAO = 'A' and c.pago = 'N') -- Aberto
                        or ( :P404_SITUACAO = 'P' and c.pago = 'S') -- Quitados
                        --or ( :P404_SITUACAO = 'C' and nb.cancelado = 'Sim') -- Cancelados
                        or ( :P404_SITUACAO = 'V' and (c.pago = 'N' and c.predatado < trunc(sysdate)))) -- Vencidos
                       -- Região (Brail ou América Latina)
                   and (  ( :P404_REGIAO is null )
                       or ( :P404_REGIAO = 1 and exists ( select 1 --brasil
                                                            from roman.vw_filiais f
                                                           where f.idfilial = c.idfilial
                                                             and f.idgrupo is not null
                                                             and f.ididioma = 1 ))
                       or ( :P404_REGIAO = 2 and exists ( select 1 --america latina
                                                            from roman.vw_filiais f
                                                           where f.idfilial = c.idfilial
                                                             and f.idgrupo is not null
                                                             and f.ididioma != 1 )))
                   -- Filial
                   and ( :P404_IDFILIAL is null or c.idfilial = :P404_IDFILIAL)
                   -- Distribuidor
                   and ( :P404_DISTRIBUIDOR is null or c.idrepresentante = :P404_DISTRIBUIDOR)
                 order by c.datainclusao
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P404_RELATORIO
            value: 5
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 762846994037282707
        }

