    region empréstimos-antigo (
        name: Empréstimos (Antigo)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.idemprestimo
                     , e.idemprestimo as detalhar_idemprestimo
                     , e.idemprestimo as "ID Emprestimo"
                     , initcap(nome) as "Nome"
                     , roman.pck_romance.fnc_nomefilial(e.idfilial) empresa
                     , e.data
                     , nvl(valor,0) as "Valor"
                     , nvl(valor,0)+nvl(valorjuros,0) as "A Pagar"
                     , nvl(( select sum(p.valorpago)
                               from pagamentosemprestimos p
                              where p.idemprestimo = e.idemprestimo
                                and trunc(p.data) <= trunc(sysdate) ),0) as "Valor Pago"
                     , nvl(valor,0)+nvl(valorjuros,0)- NVL(( select sum(VALORPAGO) 
                                                               from pagamentosemprestimos t
                                                              where idemprestimo = e.idemprestimo
                                                                and trunc(t.data) <= trunc(sysdate) ) ,0) "Saldo"
                     , ( select f.semana
                           from roman.fechamentossemanais f
                          where f.idfechamento = e.idfechamento) as "Fechamento"
                     , decode(e.distrato,'S','Sim','Não') distrato
                     , observacao
                  from roman.emprestimos e
                 where -- Data Inicial e final 
                       e.data between to_date(:P404_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') 
                                  and to_date(:P404_DATAFIM||' 23:23:59','DD/MM/RRRR HH24:MI:SS') 
                       -- Região (Brail ou América Latina)
                   and (  ( :P404_REGIAO is null )
                       or ( :P404_REGIAO = 1 and exists ( select 1 --brasil
                                                            from roman.vw_filiais f
                                                           where f.idfilial = e.idfilial
                                                             and f.idgrupo is not null
                                                             and f.ididioma = 1 ))
                       or ( :P404_REGIAO = 2 and exists ( select 1 --america latina
                                                            from roman.vw_filiais f
                                                           where f.idfilial = e.idfilial
                                                             and f.idgrupo is not null
                                                             and f.ididioma != 1 )))
                   -- Filial
                   and ( :P404_IDFILIAL is null or e.idfilial = :P404_IDFILIAL)
                 order by e.data
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
