    region negociações-balanço-antigo (
        name: Negociações Balanço (Antigo)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nb.idnegociacaobalanco--'<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2001 || ':497:'||v('APP_SESSION')||'::NO::P497_IDNEGOCIACAOBALANCO:'||nb.idnegociacaobalanco,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#menu/pencil16x16.gif" alt=""></a>' Link
                     , nb.idnegociacaobalanco as detalhar_idnegociacaobalanco
                     , nb.idnegociacaobalanco as "ID Neg Balanço"
                     , nb.idfilial
                     , nb.empresa
                     , nb.idrepresentante
                     , nb.distribuidor
                     , nb.idsemana
                     , nb.semana
                     , nb.data
                     , nb.observacao
                     , nb.valor
                     , nb.valorpago
                     , nb.valordesconto
                     , ( nb.valor - nb.valorpago - nb.valordesconto ) saldo
                     , nb.qtdparcelas
                     , cancelado
                     , vencido
                  from roman.vw_negociacoesbalanco nb
                     , catal.filiais fil
                 where nb.idfilial = fil.idfilial
                      -- Data Inicial e final
                  and nb.data between to_date(:P404_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') 
                                  and to_date(:P404_DATAFIM||' 23:23:59','DD/MM/RRRR HH24:MI:SS') 
                      -- Situação
                  and (   ( :P404_SITUACAO is null)
                       or ( :P404_SITUACAO = 'A' and (nb.valor - nb.valorpago - nb.valordesconto) > 0 and nb.vencido = 'Não') -- Aberto
                       or ( :P404_SITUACAO = 'P' and (nb.valor - nb.valorpago - nb.valordesconto) = 0 and nb.vencido = 'Não') -- Quitados
                       or ( :P404_SITUACAO = 'C' and nb.cancelado = 'Sim') -- Cancelados
                       or ( :P404_SITUACAO = 'V' and nb.vencido = 'Sim')) -- Vencidos
                      -- Região (Brail ou América Latina)
                  and (  ( :P404_REGIAO is null) --todos
                      or ( :P404_REGIAO = 1 and exists ( select 1 --brasil
                                                           from roman.vw_filiais f
                                                          where f.idfilial = nb.idfilial
                                                            and f.idgrupo is not null
                                                            and f.ididioma = 1 ) )
                      or ( :P404_REGIAO = 2 and exists ( select 1 --america latina
                                                           from roman.vw_filiais f
                                                          where f.idfilial = nb.idfilial
                                                            and f.idgrupo is not null
                                                            and f.ididioma != 1 )))
                      -- Filial
                  and ( :P404_IDFILIAL is null or nb.idfilial = :P404_IDFILIAL )
                      -- Distribidor
                  and ( :P404_DISTRIBUIDOR is null or nb.idrepresentante = :P404_DISTRIBUIDOR )
                 order by nb.data
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P404_RELATORIO
            value: 2
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 762610426694436501
        }

