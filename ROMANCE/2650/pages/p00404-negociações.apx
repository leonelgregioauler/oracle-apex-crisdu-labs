    button nova-negociação (
        buttonName: NOVA_NEGOCIAÇÃO
        label: Nova Negociação
        layout {
            sequence: 110
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus-circle-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 405
                items: {
                    P405_IDNEGOCIACAO:
                    P405_IDTIPONEGOCIACAO: &P404_TIPO_NEGOCIACAO.
                    P405_IDFECHAMENTO:
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from dual
                 where :P404_RELATORIO = 1
                   and :P404_TIPO_NEGOCIACAO is not null;
                ```
        }
    )

    button teste (
        buttonName: teste
        label: Teste
        layout {
            sequence: 120
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectOtherApp
            target: {
                app: 2001
                page: 173
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction cheques-detalhado (
        name: Cheques Detalhado
        execution {
            sequence: 50
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .Cheques_Detalhado
        }

        action plugin-pretius-apex-nested-reports (
            action: plugin/pretiusApexNestedReports
            settings {
                defaultCallbackOptions: [
                    cacheResults
                    collapseExpanded
                    addAnimation
                    loadingIndicator
                ]
                defaultTemplateOptions: [
                    strechReport
                    sortingData
                ]
                detailsQuery:
                    ```sql
                    select '<div style="width:100%;text-align:center;">' || case
                             when length(cp.datapgto) = 8 then
                               to_char(to_date(cp.datapgto,'DD/MM/YY'),'DD/MM/YYYY')
                             else
                               cp.datapgto
                           end || '</div>' as "Data Pagamento"
                         , '<div style="width:100%;text-align:center;">' ||  cp.semana || '</div>' as "Semana"
                         , '<div style="width:100%;text-align:center;">' || to_char(nvl(cp.valor,0),'999G999G999G990D00') || '</div>' as "Valores"
                         , '<div style="width:100%;text-align:center;">' || to_char(nvl(cp.juros,0),'999G999G999G990D00') || '</div>' as "Juros"
                         , '<div style="width:100%;text-align:center;">' || to_char(nvl(cp.taxas,0),'999G999G999G990D00') || '</div>' as "Taxas"
                         , '<div style="width:100%;text-align:center;">' || cp.observacao || '</div>' as "Observação"
                      from roman.cheques2pgto cp
                     where cp.idcheque = '#detalhar_idcheque#'
                     order by cp.datapgto
                    ```
                whenNoDataFound: Nenhum registro localizado
            }
            affectedElements {
                selectionType: region
                region: @cheques
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction empresatimos-antigo-detalhado (
        name: Empresatimos Antigo Detalhado
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .Emprestimos_Antigo_Detalhado
        }

        action plugin-pretius-apex-nested-reports (
            action: plugin/pretiusApexNestedReports
            settings {
                defaultCallbackOptions: [
                    cacheResults
                    collapseExpanded
                    addAnimation
                    loadingIndicator
                ]
                defaultTemplateOptions: [
                    strechReport
                    sortingData
                ]
                detailsQuery:
                    ```sql
                    select '<div style="width:100%;text-align:center;">' || to_char(pe.datavencimento,'DD/MM/YYYY') || '</div>' as "Data Vencimento"
                         , '<div style="width:100%;text-align:center;">' || to_char(pe.valorapagar,'999G999G999G990D00') || '</div>' as "Valor"
                         , '<div style="width:100%;text-align:center;">' || decode(pe.situacao,'A','Aberto','Q','Quitado','V','Vencido') || '</div>' as "Situação"
                         , '<div style="width:100%;text-align:center;">' || to_char(pe.databaixa,'DD/MM/YYYY') || '</div>' as "Data Baixa"
                      from parcelamentosemprestimos pe
                     where pe.idemprestimo = '#DETALHAR_IDEMPRESTIMO#'
                     order by pe.datavencimento
                    ```
                whenNoDataFound: Nenhum registro localizado
            }
            affectedElements {
                selectionType: region
                region: @empréstimos-antigo
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction libera-botão-nova-negociação (
        name: Libera botão nova negociação
        execution {
            sequence: 70
        }
        when {
            event: ready
        }

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @nova-negociação
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction negociações-balanço-antigo-detalhado (
        name: Negociações Balanço Antigo Detalhado
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .Negociacoes_Balanco_Antigo_detalhado
        }

        action plugin-pretius-apex-nested-reports (
            action: plugin/pretiusApexNestedReports
            settings {
                defaultCallbackOptions: [
                    cacheResults
                    collapseExpanded
                    addAnimation
                    loadingIndicator
                ]
                defaultTemplateOptions: [
                    strechReport
                    sortingData
                ]
                detailsQuery:
                    ```sql
                    select '<div style="width:100%;text-align:center;">' || to_char(nvl(pp.valor,0),'999G999G999G990D00') || '</div>' as "Valor"
                         , '<div style="width:100%;text-align:center;">' || to_char(nvl(pp.valor,0) - (select nvl(sum(p.valorpago),0) 
                                                 from roman.pagamentosnegociacoesbalanco p 
                                                where nvl(p.conferido,'N') = 'S' 
                                                  and p.idparcelanegociacaobalanco = pp.idparcelanegociacaobalanco),'999G999G999G990D00') || '</div>' as "Saldo"
                         , '<div style="width:100%;text-align:center;">' || to_char(pp.data_vencimento,'DD//MM/YYYY') || '</div>' as "Data Vencimento"
                         , '<div style="width:100%;text-align:center;">' || decode(pp.cheque,'N','Não','Sim') || '</div>' as "Pag Em Cheque"
                         , '<div style="width:100%;text-align:center;">' || decode(pp.cheque,'S','Cheque','Dinheiro') || '</div>' as "Forma Pagamento"
                         , '<div style="width:100%;text-align:center;">' || case 
                             when pp.situacao = 'ABE' then
                               'Aberto'
                             when pp.situacao = 'QUI' then
                               'Quitado'
                             when pp.situacao = 'VEN' then
                               'Vencido'
                             when pp.situacao = 'CAN' then
                               'Cancelado'
                           end || '</div>' as "Situação"
                         , pp.observacao as "Observação"
                      from roman.parcelanegociacaobalanco pp
                     where pp.idnegociacaobalanco = '#DETALHAR_IDNEGOCIACAOBALANCO#'
                    
                    
                    ```
                whenNoDataFound: Nenhum registro localizado
            }
            affectedElements {
                selectionType: region
                region: @negociações-balanço-antigo
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction negociações-realizadas-detalhado (
        name: Negociações Realizadas Detalhado
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .Negociacoes_Realizadas_Detalhado
        }

        action plugin-pretius-apex-nested-reports (
            action: plugin/pretiusApexNestedReports
            settings {
                defaultCallbackOptions: [
                    cacheResults
                    collapseExpanded
                    addAnimation
                    loadingIndicator
                ]
                defaultTemplateOptions: [
                    strechReport
                    sortingData
                ]
                detailsQuery:
                    ```sql
                    select '<div style="width:100%;text-align:center;">' || to_char(pg.datainclusao,'DD/MM/YYYY') || '</div>' as "Data Inclusão"
                         , '<div style="width:100%;text-align:center;">' || to_char(pg.datapagamento,'DD/MM/YYYY') || '</div>' as "Vencimento"
                         , '<div style="width:100%;text-align:center;">' || decode(pg.tipo,'P','Pagamento','Desconto') || '</div>' as "Tipo Pagamento"
                         , '<div style="width:100%;text-align:center;">' || decode(pg.idformapagamento,'C','Cheque'
                                                     ,'D','Deposicto'
                                                     ,'T','Transferência'
                                                     ,'Y','Carro'
                                                     ,'B','Boleto') || '</div>' as "Forma Pagamento"
                         , '<div style="width:100%;text-align:center;">' || to_char(pg.valorpago,'999G999G999G999G990D00') || '</div>' as "Valor Pago"
                         , '<div style="width:100%;text-align:center;">' || decode(pg.situacao,'A','Aberto','V','Vencido','Q','Quitado','Cancelado') || '</div>' as "Situação"
                         , '<div style="width:100%;text-align:center;">' || pg.observacao || '</div>' as "Observação"
                    from roman.pagamentosnegociacoes pg
                    where pg.idnegociacao = '#DETALHAR_IDNEGOCIACAO#'
                    ```
                whenNoDataFound: Nenhum registro localizado
            }
            affectedElements {
                selectionType: region
                region: @negociações-realizadas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction negocições-parceiros-antigo-detalhado (
