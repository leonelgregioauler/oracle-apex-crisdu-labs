    pageItem P404_DISTRIBUIDOR (
        type: selectList
        label {
            label: <b>Distribuidor:</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante) d
                     , r.idrepresentante r
                  from catal.representantes r
                 where r.idgerente in ( select idgerente 
                                          from catal.gerentes g
                                             , catal.filiais fil
                                         where g.idfilial = fil.idfilial
                                           and (  ( :P404_IDFILIAL is null)  -- Todos
                                               or ( :P404_IDFILIAL = -2 and fil.idgrupo != 5  ) -- Brasil
                                               or ( :P404_IDFILIAL = -3 and fil.idgrupo  = 5  ) -- America Latina
                                               or ( :P404_IDFILIAL >  0 and g.idfilial = :P404_IDFILIAL )))
                 order by 1
                ```
            nullDisplayValue: - Todos -
        }
        cascadingLov {
            parentItems: P404_IDFILIAL
            parentRequired: false
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select *
                  from dual 
                 where :P404_RELATORIO in (1,2,3,5)
                ```
        }
    )

    pageItem P404_IDFILIAL (
        type: selectList
        label {
            label: <b>Empresa:</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select nome
                     , idfilial
                  from roman.vw_filiais f
                 where f.ativo = 'S'
                   and (  (:P404_REGIAO is null )
                       or (:P404_REGIAO = 1 and f.ididioma = 1) 
                       or (:P404_REGIAO = 2 and f.ididioma not in (1,5,9,10,11)))
                 order by 1
                ```
            nullDisplayValue: - Todas -
        }
        cascadingLov {
            parentItems: P404_REGIAO
            parentRequired: false
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select *
                  from dual 
                 where :P404_RELATORIO in (1,2,3,4,5)
                ```
        }
    )

    pageItem P404_IDVENDEDORA (
        type: popupLov
        label {
            label: <b>Consultora:</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) as display_value
                     , v.idvendedora         as return_value
                  from pessoas p
                     , vendedoras v
                 where v.idpessoa = p.idpessoa 
                   and ( :P404_IDFILIAL is null or v.idfilial = :P404_IDFILIAL )
                   and ( :P404_DISTRIBUIDOR is null or v.idrepresentante = :P404_DISTRIBUIDOR )
                order by 1 
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from dual
                 where :P404_RELATORIO in (3)
                ```
        }
    )

