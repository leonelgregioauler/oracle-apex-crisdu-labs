    region negociações-parceiros-antigo (
        name: Negociações Parceiros (Antigo)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select n.idnegociacaoparceiro
                     , n.idnegociacaoparceiro as DETALHAR_IDNEGOCIACAOPARCEIRO
                     , n.idnegociacaoparceiro as "ID Neg Parceiro"
                     , n.idfilial
                     , n.filial 
                     , n.idrepresentante
                     , n.representante
                     , n.idvendedora
                     , n.vendedora
                     , n.cpf
                     , n.datanegociacao
                     , n.datalimitedeposito
                     , n.valornegociacao
                     , n.formapagamento
                     , n.contabancaria
                     , n.parcelas
                     , n.valorconfirmado
                     , case
                         when n.charformapgto = 'D' then
                           case
                             when exists ( select 1
                                           from depositosnegociacoesparc dn
                                           where dn.idnegociacaoparceiro = n.idnegociacaoparceiro
                                             and dn.datarevisao is not null
                                             and dn.situacao    = 'R') then
                               'Depósito Rejeitado pelo motivo: '||( select observacao 
                                                                     from depositosnegociacoesparc dn
                                                                     where dn.idnegociacaoparceiro = n.idnegociacaoparceiro
                                                                       and dn.situacao             = 'R'
                                                                       and rownum = 1 )
                             when exists ( select 1
                                           from depositosnegociacoesparc dn
                                           where dn.idnegociacaoparceiro = n.idnegociacaoparceiro
                                             and dn.datarevisao is not null
                                             and dn.situacao    = 'C' ) then
                               ( select 'Data da baixa: '||to_char(dn.datarevisao,'DD/MM/RRRR HH24:MI:SS')||' - Nr Iden.: '||dn.nroidentificacao_digitado info
                                 from depositosnegociacoesparc dn
                                 where dn.idnegociacaoparceiro = n.idnegociacaoparceiro
                                   and dn.situacao             = 'C'
                                   and dn.datarevisao is not null
                                   and rownum = 1 )
                             when exists ( select 1
                                           from depositosnegociacoesparc dn
                                           where dn.idnegociacaoparceiro = n.idnegociacaoparceiro
                                             and dn.situacao             = 'A'
                                             and dn.datarevisao is null ) then
                               'Pendente de confirmação'
                             else
                               'Depósito não encontrado'
                           end
                         else
                           '-'
                       end deposito
                     , nvl(( select sum(dn.valor_digitado) 
                             from depositosnegociacoesparc dn
                             where dn.idnegociacaoparceiro = n.idnegociacaoparceiro ),0) valor_revisado 
                  from roman.vw_negociacoes_realizadas n
                 where -- Data Inicial e final
                       n.datanegociacao between to_date(:P404_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') 
                                            and to_date(:P404_DATAFIM||' 23:23:59','DD/MM/RRRR HH24:MI:SS') 
                      -- Situação
                  and (   ( :P404_SITUACAO is null)
                       or ( :P404_SITUACAO = 'A' and n.situacaodeposito = 'A') -- Aberto
                       or ( :P404_SITUACAO = 'P' and n.situacaodeposito = 'C') -- Concluido
                       or ( :P404_SITUACAO = 'C' and n.situacaodeposito = 'R') -- Rejeitado
                       or ( :P404_SITUACAO = 'V' and n.situacaodeposito = 'V')) -- Vencidos
                      -- Região (Brail ou América Latina)
                  and (  ( :P404_REGIAO is null) --todos
                      or ( :P404_REGIAO = 1 and exists ( select 1 --brasil
                                                           from roman.vw_filiais f
                                                          where f.idfilial = n.idfilial
                                                            and f.idgrupo is not null
                                                            and f.ididioma = 1 ) )
                      or ( :P404_REGIAO = 2 and exists ( select 1 --america latina
                                                           from roman.vw_filiais f
                                                          where f.idfilial = n.idfilial
                                                            and f.idgrupo is not null
                                                            and f.ididioma != 1 )))
                      -- Filial
                  and ( :P404_IDFILIAL is null or n.idfilial = :P404_IDFILIAL )
                      -- Distribidor
                  and ( :P404_DISTRIBUIDOR is null or n.idrepresentante = :P404_DISTRIBUIDOR )
                      -- Vendedoras
                  and ( :P404_IDVENDEDORA is null or n.idvendedora = :P404_IDVENDEDORA)
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P404_RELATORIO
            value: 3
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 762613168364436528
        }

