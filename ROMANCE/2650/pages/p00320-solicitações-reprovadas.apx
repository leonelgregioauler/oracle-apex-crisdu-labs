    region solicitações-reprovadas-p320-tipo-relatorio-2 (
        name: Solicitações Reprovadas &P320_TIPO_RELATORIO.
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT r.idrepresentante
                     , pck_romance.fnc_nomerepresentante(r.idrepresentante)         AS distribuidor
                     , pck_romance.fnc_nomefilial(r.idfilial)                       AS franquia
                     , do.iddepositodiarios                                         AS id_solicitacao
                     , do.idrequisicao
                     , ds.descricao                                                 AS status
                     , dr.idreprovacao
                     , mr.descricao                                                 AS motivo_reprovacao
                     , do.valordeposito
                     , to_char(dr.dataregistro, 'DD/MM/YYYY HH24:MI:SS')            AS data_reprovacao
                     , trunc(sysdate) - trunc(dr.dataregistro)                      AS diferenca_dias
                     , dr.usuariooptimus                                            AS usuario_reprovacao
                     -- Correção/reenvio pelo distribuidor
                     , to_char(dr.data_correcao, 'DD/MM/YYYY HH24:MI:SS')           AS data_correcao
                     , case
                          when dr.data_correcao is null then 'Aguardando correção'
                          else 'Corrigido'
                       end                                                              AS situacao_reprovacao
                     -- Tempo de resposta do distribuidor (dias)
                     , case
                          when dr.data_correcao is not null then 
                            round(trunc(dr.data_correcao) - trunc(dr.dataregistro), 1)
                          else
                            round(trunc(sysdate) - trunc(dr.dataregistro), 1)
                       end                                                              AS dias_em_aberto
                
                     , ( SELECT listagg(c.urlcomprovante, ' | ') within group (order by c.dataenvio)
                         FROM  roman.comprovantes c
                         WHERE  c.iddepositosdiarios = do.iddepositodiarios ) AS comprovantes_originais  --- TODO : LINK PARA MODAL MOSTRANDO OS COMPROVANTES E LOCAL PARA INSERIR O COMPROVANTE (POR ENDPOINT ???)
                FROM roman.depositosdiarios_motivos_reprovacao  mr
                JOIN roman.depositosdiarios_reprovacao  dr ON dr.idmotivo = mr.idmotivo
                JOIN roman.depositosdiarios_orig        do ON do.iddepositodiarios = dr.iddepositodiario
                JOIN roman.depositos_status             ds ON ds.idstatus           = do.idstatus
                JOIN catal.representantes               r  ON r.idrepresentante     = do.idrepresentante
                WHERE (:P320_IDFILIAL is null or r.idfilial = :P320_IDFILIAL)
                ORDER BY dr.dataregistro DESC;
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P320_TIPO_DADOS
            value: COMPLETO
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 44771547558681506
        }

