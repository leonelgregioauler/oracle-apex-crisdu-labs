page 163 (
    name: Enviar Pepinos para Cobrança
    title: Enviar Pepinos para Cobrança
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region pepinos-de-representantes (
        name: Pepinos de Representantes
        type: staticContent
        source {
            htmlCode:
                ```html
                <script language="javascript">
                function  confirmapepino(event)
                { 
                var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
                
                if (tecla==13) {
                var answer = confirm("Confirma envio do pepino para cobrança?")
                	if (answer){            
                		apex.submit('SAVE');
                	}
                }
                }
                </script>
                
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P163_IDREPRESENTANTE (
        type: selectList
        label {
            label: Representante
            alignment: above
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) display_value
                     , r.idrepresentante return_value
                from representantes   r
                   , pessoas          p
                   , usuarios         u
                   , gerentes         g
                where r.idpessoa  = p.idpessoa
                  and u.idgerente = g.idgerente
                  and r.idgerente = g.idgerente
                  and p.ativo     = 'S'
                  and u.usuario   = v('APP_USER')
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione o Representante -
        }
        layout {
            sequence: 65
            region: @pepinos-de-representantes
            slot: regionBody
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDREPRESENTANTE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P163_NRPEDIDO (
        type: textField
        label {
            label: Nr Pedido
            alignment: above
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 70
            region: @pepinos-de-representantes
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        validation {
            maxLength: 50
        }
        source {
            type: databaseColumn
            databaseColumn: NRPEDIDO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P163_OBSERVACAO (
        type: textField
        label {
            label: Observação
            alignment: above
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 90
            region: @pepinos-de-representantes
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
        }
        validation {
            maxLength: 200
        }
        advanced {
            customAttributes: javascript: onKeyUp="confirmapepino(event)";
        }
        source {
            type: databaseColumn
            databaseColumn: OBSERVACAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @pepinos-de-representantes
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 162
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @pepinos-de-representantes
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
    )

    validation p163-nrpedido (
        name: P163_NRPEDIDO
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P163_NRPEDIDO
        }
        error {
            errorMessage: #LABEL# deve ser informado!
            displayLocation: inlineInNotification
            associatedItem: @P163_NRPEDIDO
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update pepinosrepresentantes
                  set situacao  = 'C'
                    , observacao = :P163_OBSERVACAO
                    , dataenviocobranca = sysdate
                  where idrepresentante = :P163_IDREPRESENTANTE
                    and nrpedido        = :P163_NRPEDIDO;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Unable to get primary key item value.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 276460505757301524
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    branch (
        execution {
            sequence: 15
        }
        behavior {
            target: {
                page: 163
                items: {
                    P163_IDREPRESENTANTE: &P163_IDREPRESENTANTE.
                }
                action: resetPagination
            }
        }
    )

)

