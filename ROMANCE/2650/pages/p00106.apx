page 106 (
    name: Alterar Senha
    title: Alterar Senha
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 500px
        height: 650px
        cssClasses: [
            modal
            modal_redefinir_senha
        ]
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        authentication: public
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region trocar-senha (
        name: Trocar Senha
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/login
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
            ]
            cssClasses: redefinir_senha
            icon: fa-info-circle
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P106_IDUSUARIO (
        type: textField
        label {
            label: ID Usuário
            alignment: left
        }
        layout {
            sequence: 20
            region: @trocar-senha
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            cssClasses: [
                input
                input100P
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P106_NOVASENHA (
        type: password
        label {
            label: Nova Senha
            alignment: left
        }
        layout {
            sequence: 30
            region: @trocar-senha
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            cssClasses: [
                input
                input100P
            ]
            width: 30
        }
        sessionState {
            storage: request
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P106_USUARIO (
        type: textField
        label {
            label: Usuário
            alignment: left
        }
        layout {
            sequence: 10
            region: @trocar-senha
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            cssClasses: [
                input
                input100P
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button trocarsenha (
        buttonName: TROCARSENHA
        label: Trocar Senha
        layout {
            sequence: 40
            region: @trocar-senha
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
            cssClasses: btn_black
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation valida-usuario (
        name: Valida Usuario
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuarios
                where usuario = upper(:P106_USUARIO)
                  and idusuario = :P106_IDUSUARIO
                ```
        }
        error {
            errorMessage: Usuário/ID incorreto!
            associatedItem: @P106_USUARIO
        }
    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vexiste  varchar2(1);
                Begin
                  --
                  select 'S'
                  into vexiste
                  from all_users a
                  where a.username = upper(:P106_USUARIO);
                  --
                  execute immediate 'alter user '||upper(:P106_USUARIO)||' identified by "'||:P106_NOVASENHA||'"';
                  --
                exception
                  when no_data_found then
                     execute immediate 'create user '||upper(:P106_USUARIO)||' identified by "'||:P106_NOVASENHA||'"';
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Senha trocada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 307251844686061739
        }
    )

)

