        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(c.nomeconta) display_value
                     , c.idSUBcontafinan  return_value
                from SUBcontasfinanceiras c
                where c.debitocredito = 'D'
                AND IDCONTAFINAN = :P59_IDCONTACONTABIL
                order by 1
                ```
            nullDisplayValue: - Selecione a Conta Contábil -
        }
        cascadingLov {
            parentItems: P59_IDCONTACONTABIL
        }
        layout {
