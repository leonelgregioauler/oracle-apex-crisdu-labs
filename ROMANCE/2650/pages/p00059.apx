    process fetch-row-from-despesas (
        name: Fetch Row from DESPESAS
        type: autoRowFetch
        source {
            tableName: DESPESAS
            pkColumn: IDDESPESA
            pkItem: P59_IDDESPESA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Unable to fetch row.
        }
        advanced {
            executionMappingIdentifier: 178842523903929459
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDDESPESAS.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P59_IDDESPESA := get_pk; 
                end;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Unable to get primary key item value.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 178842710580929461
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-despesas (
        name: Process Row of DESPESAS
        type: autoRowProcessing
        target {
            tableName: DESPESAS
            pkColumn: IDDESPESA
            pkItem: P59_IDDESPESA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Despesa incluída/atualizada!
        }
        error {
            errorMessage: Unable to process row of table DESPESAS.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 178842921906929461
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 59
                items: {
                    P59_IDFECHAMENTOREPRES: &P59_IDFECHAMENTOREPRES.
                    P59_IDDESPESA:
                    P59_IDREPRESENTANTE: &P59_IDREPRESENTANTE.
                    P59_IDFECHAMENTO: &P59_IDFECHAMENTO.
