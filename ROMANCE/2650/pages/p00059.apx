        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                vfilial number;
                begin
                  select idfilial 
                  into vfilial 
                  from fechamentorepresentantes
                  where idfechamentorepres = :P59_IDFECHAMENTOREPRES;
                return vfilial;
                
                end;
