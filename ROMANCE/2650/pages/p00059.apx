page 59 (
    name: Despesas Representantes
    title: Despesas Representantes
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region despesas-incluídas-na-semana (
        name: Despesas Incluídas na Semana
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.iddespesa
                     , d.idfechamentorepres
                     , initcap(c.nomeconta) Conta
                     , initcap(sc.nomeconta) SubConta
                     , d.observacao
                     , d.semana
                     , d.valor
                from despesas d
                   , contasfinanceiras      c
                   , subcontasfinanceiras   sc
                where d.idfechamentorepres = :P59_IDFECHAMENTOREPRES
                  and d.idcontacontabil = c.idcontafinan
                  and d.idsubcontacontabil = sc.idsubcontafinan(+)
                ```
        }
        layout {
            sequence: 20
            parentRegion: @despesas-representantes
            slot: subRegions
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from despesas d
                where d.idfechamentorepres = :P59_IDFECHAMENTOREPRES
                ```
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: no data found
        }
        componentAdvanced {
            stripHtml: true
        }

        column CONTA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Conta
            }
            layout {
                sequence: 2
            }
        )

        column IDDESPESA (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: Editar
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            link {
                target: {
                    page: 59
                    items: {
                        P59_IDDESPESA: #IDDESPESA#
                        P59_IDFECHAMENTOREPRES: #IDFECHAMENTOREPRES#
                    }
                }
                linkText: <img src="#IMAGE_PREFIX#menu/pencil2_16x16.gif" alt="">
            }
        )

        column IDFECHAMENTOREPRES (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 7
            }
        )

        column OBSERVACAO (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Descrição
            }
            layout {
                sequence: 4
            }
        )

        column SEMANA (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 5
            }
        )

        column SUBCONTA (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Sub Conta
                alignment: center
            }
            layout {
                sequence: 3
            }
        )

        column VALOR (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Valor
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            advanced {
                computeSum: true
            }
        )

    )

    region despesas-representantes (
        name: Despesas Representantes
        type: staticContent
        source {
            htmlCode:
                ```html
                <script language="javascript">
                function  confirmadespesa(event)
                { 
                var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
                
                if (tecla==13) {
                var answer = confirm("Confirma inclusão da despesa?")
                	if (answer){            
                		apex.submit('CREATE');
                	}
                }
                }
                </script>
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P59_ANO (
        type: hidden
        layout {
            sequence: 40
            region: @despesas-representantes
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ANO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                return to_char(sysdate,'RRRR');
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P59_IDCONTACONTABIL (
        type: selectList
        label {
            label: Conta
            alignment: above
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(c.nomeconta) display_value
                     , c.idcontafinan return_value
                from contasfinanceiras c
                where c.debitocredito = 'D'
                  and c.idcontafinan = 60
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @despesas-representantes
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDCONTACONTABIL
            used: always
        }
        default {
            type: static
            staticValue: 60
        }
        security {
            encryptSessionState: false
        }
    )

