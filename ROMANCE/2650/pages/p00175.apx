page 175 (
    name: Valor Pago
    title: Valor Pago
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function  confirmapgto(event)
            { 
            var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
            
            if (tecla==13) 
              {
            var answer = confirm("Confirma pagamento da comissão?")
            	if (answer){            
            		apex.submit('CREATE');
            	}
              }
            }
            ```
        executeWhenPageLoads: window.opener.location.reload();
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region valor-pago (
        name: Valor Pago
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P175_DATAPAGAMENTO (
        type: textField
        label {
            label: Data Pgto
            alignment: right
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 60
            region: @valor-pago
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr hh24:mi:ss
            width: 10
        }
        validation {
            maxLength: 10
        }
        advanced {
            customAttributes: readonly="READONLY"
        }
        source {
            type: databaseColumn
            databaseColumn: DATAPAGAMENTO
            used: always
        }
        default {
            type: expression
            plsqlExpression: sysdate
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P175_FECHAMENTO (
        type: hidden
        layout {
            sequence: 50
            region: @valor-pago
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: FECHAMENTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P175_IDFECHAMENTOREPRES (
        type: hidden
        layout {
            sequence: 70
            region: @valor-pago
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFECHAMENTOREPRES
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P175_IDGERENTE (
        type: selectList
        label {
            label: Gerente
            alignment: right
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(apelido,p.nomepessoa)) Nome
                     , g.idgerente
                from pessoas p
                   , gerentes g 
                where g.idpessoa  = p.idpessoa  
                  and nvl(g.ativo,'N') = 'S'
                  and nvl(p.ativo,'N') = 'S'
                  and g.idgerente = :P175_IDGERENTE
                ```
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @valor-pago
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDGERENTE
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P175_IDGERENTE
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P175_IDPGTOCOMISSAO (
        type: hidden
        layout {
            sequence: 10
            region: @valor-pago
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDPGTOCOMISSAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P175_IDREPRESENTANTE (
        type: selectList
        label {
            label: Representante
            alignment: right
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) Nome
                     , r.idrepresentante
                from pessoas p
                   , representantes r
                   , gerentes g 
                where r.idgerente = g.idgerente
                  and r.idpessoa  = p.idpessoa  
                  and nvl(r.ativo,'N') = 'S'
                  and nvl(p.ativo,'N') = 'S'
                  and r.idrepresentante     = :P175_IDREPRESENTANTE
                ```
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @valor-pago
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDREPRESENTANTE
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P175_IDREPRESENTANTE
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P175_VALORPAGO (
        type: numberField
        label {
            label: Valor Pago
            alignment: right
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 80
            region: @valor-pago
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 15
        }
        validation {
            maxLength: 15
        }
        advanced {
            customAttributes: onKeyUp="javascript: confirmapgto(event)"; style="text-align: right;"
        }
        source {
            type: databaseColumn
            databaseColumn: VALORPAGO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Fechar
        layout {
            sequence: 10
            region: @valor-pago
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:window.opener.location.reload();window.close();
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Efetuar Pagamento
        layout {
            sequence: 40
            region: @valor-pago
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P175_IDPGTOCOMISSAO
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @valor-pago
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: never
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Alterações
        layout {
            sequence: 30
            region: @valor-pago
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: never
        }
    )

    validation p175-fechamento (
        name: P175_FECHAMENTO
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P175_FECHAMENTO
        }
        error {
            errorMessage: #LABEL# deve ser informado!
            associatedItem: @P175_FECHAMENTO
        }
    )

    validation p175-idfechamentorepres (
        name: P175_IDFECHAMENTOREPRES
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P175_IDFECHAMENTOREPRES
        }
        error {
            errorMessage: Informe em qual acerto entrará a comissão.
            associatedItem: @P175_IDFECHAMENTOREPRES
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentossemanais f
                where f.semana   = :P175_FECHAMENTO
                  and f.idfilial = ( select g.idfilial  
                                     from gerentes       g
                                        , representantes r
                                     where g.idgerente       = r.idgerente
                                       and r.idrepresentante = :P175_IDREPRESENTANTE )
                ```
        }
    )

    validation p175-valorpago (
        name: P175_VALORPAGO
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P175_VALORPAGO
        }
        error {
            errorMessage: #LABEL# deve ser informado!
            associatedItem: @P175_VALORPAGO
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process fetch-row-from-pagamentocomissoes (
        name: Fetch Row from PAGAMENTOCOMISSOES
        type: autoRowFetch
        source {
            tableOwner: CATAL
            tableName: PAGAMENTOCOMISSOES
            pkColumn: IDPGTOCOMISSAO
            pkItem: P175_IDPGTOCOMISSAO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Não é possível extrair a linha.
        }
        advanced {
            executionMappingIdentifier: 297781710879306619
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDPGTOCOMISSAO.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P175_IDPGTOCOMISSAO := get_pk; 
                end;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Não é possível obter valor de item de chave primária.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 297781908614306622
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-pagamentocomissoes (
        name: Process Row of PAGAMENTOCOMISSOES
        type: autoRowProcessing
        target {
            tableOwner: CATAL
            tableName: PAGAMENTOCOMISSOES
            pkColumn: IDPGTOCOMISSAO
            pkItem: P175_IDPGTOCOMISSAO
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        error {
            errorMessage: Não é possível processar a linha da tabela PAGAMENTOCOMISSOES.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 297782123765306622
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        clear {
            type: pages
            pages: 102
        }
        execution {
            sequence: 40
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 297782323365306624
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 175
                items: {
                    P175_FECHAMENTO: &P175_FECHAMENTO.
                    P175_IDFECHAMENTOREPRES: &P175_IDFECHAMENTOREPRES.
                    P175_IDREPRESENTANTE: &P175_IDREPRESENTANTE.
                }
                successMessage: false
            }
        }
    )

)

