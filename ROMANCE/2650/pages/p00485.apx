page 485 (
    name: Comparativo Compra x Faturamento
    title: Comparativo Compra x Faturamento
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region comparativo (
        name: Comparativo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.empresa
                     , t.idrazao
                     , t.cnpj
                     , t.idfilial
                     , t.franquia
                     , t.mes_ano
                     , t.compra
                     , t.venda
                     , t.devolucao
                     , t.venda - t.devolucao as faturamento_liquido
                     , t.despesas
                from ( 
                select rf.razaosocial empresa
                     , rf.idrazaosocialfilial idrazao
                     , rf.cnpj
                     , f.idfilial 
                     , f.nome franquia
                     , to_char(dt.data,'MM/RRRR') mes_ano
                     , pck_financeiro_rmc.fnc_retornavaloresrazoesfiliais(pidrazaosocialfilial => rf.idrazaosocialfilial,
                                                                          pidfilial            => f.idfilial,
                                                                          pperiodo             => to_char(dt.data,'MM/RRRR'),
                                                                          ptipo                => 'C')  compra
                     /*, pck_financeiro_rmc.fnc_retornavaloresrazoesfiliais(pidrazaosocialfilial => rf.idrazaosocialfilial,
                                                                          pidfilial            => f.idfilial,
                                                                          pperiodo             => to_char(dt.data,'MM/RRRR'),
                                                                          ptipo                => 'V')  venda*/
                     , (select sum(i.valortotalbruto-(nvl(i.valordesconto,0)+nvl(i.valordespesasacessorias,0)))
                        from crisdu.notasfiscais n
                           , crisdu.itensnotasfiscais i
                        where i.idnotafiscal = n.idnotafiscal
                          and i.cfop in (5101,5102,5122, 5124,5405,6101,6102,6107,6108,6109,6110, 6122, 6124,7101,7102,7127)
                          and to_char(n.dataemissao,'MM/RRRR') = to_char(dt.data,'MM/RRRR')
                          and n.idpedidofavorita is null
                          and n.idsituacao != -1 --CANCELADA
                          and exists ( select 1
                                       from crisdu.razoessociais r
                                          , roman.razoessociaisfiliais z
                                       where regexp_replace(r.cnpj, '[^0-9]', '') = regexp_replace(z.cnpj, '[^0-9]', '')
                                         and z.idrazaosocialfilial = rf.idrazaosocialfilial 
                                         and z.idfilial = f.idfilial
                                         and r.idrazaosocial = n.idrazaosocialemitente )) Venda    
                     , pck_financeiro_rmc.fnc_retornavaloresrazoesfiliais(pidrazaosocialfilial => rf.idrazaosocialfilial,
                                                                          pidfilial            => f.idfilial,
                                                                          pperiodo             => to_char(dt.data,'MM/RRRR'),
                                                                          ptipo                => 'D')  devolucao
                     , pck_financeiro_rmc.fnc_retornavaloresrazoesfiliais(pidrazaosocialfilial => rf.idrazaosocialfilial,
                                                                          pidfilial            => f.idfilial,
                                                                          pperiodo             => to_char(dt.data,'MM/RRRR'),
                                                                          ptipo                => 'DP')  despesas
                from vw_filiais f
                   , razoessociaisfiliais rf
                   , datasperiodos dt
                where rf.idfilial = f.idfilial
                  and f.ativo = 'S'
                  and f.tipofilial = 'D'
                  and ( :P485_IDFILIAL = -1 or f.idfilial = :P485_IDFILIAL )
                  and rf.ativo = 'S'
                  and rf.principal = 'S'
                  and dt.ano >= 2023
                  and rf.cnpj is not null
                  and rf.razaosocial is not null
                  and dt.ano <= extract(year from sysdate)
                  and dt.data between to_date(:P485_DATAINICIO,'DD/MM/RRRR') and to_date(:P485_DATAFIM,'DD/MM/RRRR')
                  and :P485_FILTRAR = 'S'
                  and (:P485_IDFILIAL != -1 and exists (select 1
                                                        from roman.usuariosfiliais u
                                                        where u.idfilial = f.idfilial
                                                          and u.usuario = v('APP_USER')) --v('APP_USER'))
                   or (:P485_IDFILIAL = -1 and exists (select 1
                                                       from usuariosgruposatendimento ug
                                                       where ug.idgrupoatendimento in (0,69)
                                                         and ug.usuario = v('APP_USER')))
                   or v('APP_USER') = 'CESARH'      )
                group by rf.razaosocial
                       , rf.idrazaosocialfilial
                       , f.idfilial
                       , f.nome
                       , to_char(dt.data,'MM/RRRR')
                       , rf.cnpj ) t
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
