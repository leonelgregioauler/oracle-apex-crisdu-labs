page 378 (
    name: Matriz de Classificação de Entradas
    title: Matriz de Classificação de Entradas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region matriz-de-classificação-de-entradas (
        name: Matriz de Classificação de Entradas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDMATRIZENTRADA,
                       CLASSIFICACAOENTRADA,
                       IDFILIAL,
                       IDCONTAFINAN,
                       IDSUBCONTAFINAN,
                       ATIVO,
                       DATAINCLUSAO,
                       USUARIO,
                       CONTABILIZAR
                  from MATRIZCLASSIFICACOESENTRADAS
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        performance {
            lazyLoading: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 67046362717051936
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @ROWID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDMATRIZENTRADA
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @CLASSIFICACAOENTRADA
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @IDFILIAL
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @IDCONTAFINAN
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @IDSUBCONTAFINAN
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @ATIVO
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @DATAINCLUSAO
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @USUARIO
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 0
                }
            )

            displayColumn (
                column: @CONTABILIZAR
                layout {
                    sequence: 8
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column ATIVO (
            type: selectList
            heading {
                heading: Ativo
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC2:Sim;S,Não;N
            }
            layout {
                sequence: 90
            }
            source {
                databaseColumn: ATIVO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column CLASSIFICACAOENTRADA (
            type: textarea
            heading {
                heading: Classificação
                alignment: center
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: CLASSIFICACAOENTRADA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
        )

        column CONTABILIZAR (
            type: selectList
            heading {
                heading: Contabilizar no Resultado?
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC2:Sim;S,Não;N
            }
            layout {
                sequence: 120
            }
            source {
                databaseColumn: CONTABILIZAR
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column DATAINCLUSAO (
            type: datePickerJquery
            heading {
                heading: Data Inclusão
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                databaseColumn: DATAINCLUSAO
                dataType: date
                queryOnly: true
            }
        )

        column IDCONTAFINAN (
            type: selectList
            heading {
                heading: Conta
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nomeconta
                         , idcontafinan
                    from contasfinanceiras c
                    where c.centrodecusto = 'S'
                      and c.debitocredito = 'C'
                    order by 1
                    ```
            }
            layout {
                sequence: 70
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDCONTAFINAN
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDFILIAL (
            type: selectList
            heading {
                heading: Empresa
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nome
                         , idfilial
                    from vw_filiais f
                    where f.ativo = 'S'
                    ```
            }
            layout {
                sequence: 60
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDFILIAL
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDMATRIZENTRADA (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IDMATRIZENTRADA
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: SEQ_IDMATRIZENTRADA
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDSUBCONTAFINAN (
            type: selectList
            heading {
                heading: Sub Conta
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nomeconta
                         , idsubcontafinan
                    from subcontasfinanceiras s
                    where s.idcontafinan = :IDCONTAFINAN
                    order by 1
                    ```
            }
            cascadingLov {
                parentColumns: IDCONTAFINAN
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: IDSUBCONTAFINAN
                dataType: number
            }
        )

        column ROWID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ROWID
                dataType: rowid
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column USUARIO (
            type: textField
            heading {
                heading: Usuario
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: center
            }
            validation {
                maxLength: 50
            }
            source {
                databaseColumn: USUARIO
                dataType: varchar2
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

    )

    process matriz-de-classificação-de-entradas-save-interactive-grid-data (
        name: Matriz de Classificação de Entradas - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @matriz-de-classificação-de-entradas
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 67015383615041817
        }
    )

)

