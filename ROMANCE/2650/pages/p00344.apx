page 344 (
    name: Análise de Faturas V3
    title: Análise de Faturas V3
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region faturas-a-pagar (
        name: "Faturas a Pagar "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.datavencimento
                     , sum(v.valor) - nvl(( select sum(d.valordeposito)
                                            from depositosdiarios_orig d
                                            where d.idvencimento = v.idvencimento ),0) valor
                     , pck_romance.fnc_nomefornecedor(nf.idfornemitente) fornecedoremitente
                     , pck_romance.fnc_nomefilial(nf.idfilialdestino) empresadestino
                from notasfiscais nf
                   , vencimentos v
                where v.idnotafiscal = nf.idnotafiscal
                  and exists ( select 1
                               from extratoscontasbancarias e
                               where e.idvencimento = v.idvencimento
                                 and e.idextratocontabancaria_orig is not null )
                  and ( :P344_IDFORNECEDOR is null or nf.idfornemitente = :P344_IDFORNECEDOR )
                  and ( :P344_IDFILIALROMANCE is null or nf.idfilialdestino = :P344_IDFILIALROMANCE )
                  and ( :P344_TIPO_DATA = 'G'
                     or ( :P344_TIPO_DATA = 'B' and v.datavencimento <= to_date(:P344_DATABASE||' 23:59:59','DD/MM/RRRR HH24:MI:SS') )
                     or ( :P344_TIPO_DATA = 'P' and v.datavencimento between to_date(:P344_DATAINICIO||' 23:59:59','DD/MM/RRRR HH24:MI:SS') and to_date(:P344_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') ) )
                group by datavencimento
                       , idfornemitente
                       , idfilialdestino
                       , idvencimento
                order by 1
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 24429266722645795
        }

        column DATAVENCIMENTO (
            type: plainText
            heading {
                heading: Vencimento
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: A
            }
        )

        column EMPRESADESTINO (
            type: plainText
            heading {
                heading: Destino
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column FORNECEDOREMITENTE (
            type: plainText
            heading {
                heading: Fornecedor
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column VALOR (
            type: plainText
            heading {
                heading: Valor
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 122401 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAVENCIMENTO (
                sequence: 1
            )

            displayColumn EMPRESADESTINO (
                sequence: 4
            )

            displayColumn FORNECEDOREMITENTE (
                sequence: 3
            )

            displayColumn VALOR (
                sequence: 2
            )

            aggregate (
                column: VALOR
            )

        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P344_DATABASE (
        type: datePickerJquery
        label {
            label: Base
            alignment: left
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 12
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P344_DATAFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 12
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P344_DATAINICIO (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 12
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P344_IDCONTABACARIA_DEST (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P344_IDCONTABANCARIA_ORIG (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P344_IDFILIALROMANCE (
        type: selectList
        label {
            label: Destino Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                  and f.idgrupo != 5
                ```
            nullDisplayValue: "- Todas - "
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P344_IDFORNECEDOR (
        type: popupLov
        label {
            label: Fornecedor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefornecedor(idfornecedor) ||'  --  '||pck_romance.fnc_nomepessoa(idpessoa) ||'   ID:'||idfornecedor display_value
                     , fe.idpessoa return_value
                from fornecedores fe
                where fe.ativo = 'S'
                order by 1
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P344_TIPO_DATA (
        type: radioGroup
        label {
            label: Pesquisar Por
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Data Base;B,Periodo;P,Geral;G
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: B
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction data-base (
        name: Data Base
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P344_TIPO_DATA
        }
        clientSideCondition {
            type: item=value
            item: P344_TIPO_DATA
            value: B
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P344_DATABASE
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P344_DATABASE
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction escolhe-periodo (
        name: Escolhe Periodo
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P344_TIPO_DATA
        }
        clientSideCondition {
            type: item=value
            item: P344_TIPO_DATA
            value: P
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P344_DATAINICIO
                    P344_DATAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P344_DATAINICIO
                    P344_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 344
                items: {
                    P344_TIPO_DATA: &P344_TIPO_DATA.
                    P344_IDFORNECEDOR: &P344_IDFORNECEDOR.
                    P344_IDFILIALROMANCE: &P344_IDFILIALROMANCE.
                    P344_DATAINICIO: &P344_DATAINICIO.
                    P344_DATAFIM: &P344_DATAFIM.
                    P344_DATABASE: &P344_DATABASE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

