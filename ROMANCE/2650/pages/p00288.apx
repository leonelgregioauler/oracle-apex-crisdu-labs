page 288 (
    name: Notas Aguardando Cobrança
    title: Notas Aguardando Cobrança
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region notas-aguardando-cobrança (
        name: Notas Aguardando Cobrança
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(n.idfilial) filial
                     , count(1) qtdnotas
                     , sum(n.valortotalnota)*f.fatorconversao valor
                     , round(sum(n.valortotalnota)*f.fatorconversao/count(1),2)  mediapornota
                     , f.fatorconversao
                from notasvendas n
                   , filiais f
                where n.idsituacaonotavenda = 3
                  and n.idfilial = f.idfilial
                  and f.ativo = 'S'
                  and exists ( select 1
                              from usuariosfiliais u
                              where u.idfilial = f.idfilial
                                and u.usuario  = v('APP_USER') ) 
                group by n.idfilial, f.fatorconversao
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                Expresso em valor de Venda<br>
                É a mercadoria que está na rua com as consultoras.
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
