            sqlExpression: v('REQUEST') in ('SAVE','CREATE') and :P93_IDFILIALDEST != 1063
        }
    )

    process fetch-saidasdiversas (
        name: Fetch SAIDASDIVERSAS
        type: autoRowFetch
        source {
            tableName: SAIDASDIVERSAS
            pkColumn: IDSAIDA
            pkItem: P93_IDSAIDA
        }
        execution {
            sequence: 50
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 192686025912327343
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P93_IDSAIDA
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDSAIDASDIVERSAS.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  --
                  :P93_IDSAIDA := get_pk; 
                  --
                  select idfechamento
                  into :P93_IDFECHAMENTO
                  from fechamentossemanais
                  where idfilial = :P93_IDFILIAL
                    and semana   = :P93_FECHAMENTOORIG;
                  --
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Unable to get primary key item value.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 192424321939249786
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-saidasdiversas (
        name: Process Row of SAIDASDIVERSAS
        type: autoRowProcessing
        target {
            tableName: SAIDASDIVERSAS
            pkColumn: IDSAIDA
            pkItem: P93_IDSAIDA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        error {
