    button anexar-arquivo (
        buttonName: ANEXAR_ARQUIVO
        label: Anexar Arquivo
        layout {
            sequence: 10
            region: @nova-saida
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 143
                items: {
                    P143_IDSAIDA: &P93_IDSAIDA.
                    P143_IDANEXOSAIDA:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P93_IDSAIDA is not null
                  and exists ( select 1
                               from fechamentossemanais f
                               where f.idfilial = :P0_IDFILIALCAIXA
                                 and nvl(f.concluido,'N') = 'N'
                                 and f.idfechamento = :P0_IDFECHAMENTO )
                ```
        }
    )

