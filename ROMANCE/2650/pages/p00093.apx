    pageItem P93_CENTRO_CUSTO (
        type: selectList
        label {
            label: Centro de Custo
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select cc.nome display_values
                    , cc.idcentrodecusto return_values
                from roman.matrizclassificacoesdespesas m
                   , roman.centrodecustos cc 
                where cc.idcentrodecusto = m.idcentrodecusto
                  and m.idmatrizclassificacao = :P93_IDMATRIZCLASSIFICACAO 
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P93_IDMATRIZCLASSIFICACAO
        }
        layout {
            sequence: 70
            region: @nova-saida
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
    )

