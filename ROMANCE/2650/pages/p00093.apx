    pageItem P93_FATORCONVERSAO (
        type: numberField
        label {
            label: Fator Conversão
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 140
            region: @nova-saida
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 12
        }
        source {
            type: databaseColumn
            databaseColumn: FATORCONVERSAO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vfatorconversao number := 1;
                begin
                  --
                  select fatorconversao
                  into vfatorconversao
                  from fechamentossemanais f
                  where f.idfechamento = ( select max(idfechamento)
                                           from fechamentossemanais ff
                                           where ff.idfilial = :P93_IDFILIALDEST );
                  --
                  return vfatorconversao;
                  --
                exception
                  when others then
                    return 1;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

