            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P93_IDSAIDA is NOT null
                  and exists ( select 1
                               from fechamentossemanais f
                               where f.idfechamento = :P93_IDFECHAMENTO 
                                 and f.concluido = 'N')
                ```
        }
    )

