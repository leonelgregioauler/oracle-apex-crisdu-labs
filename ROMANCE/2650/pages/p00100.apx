page 100 (
    name: Impressão de Pedido de Compra
    title: Impressão de Pedido de Compra
    appearance {
        pageMode: nonModalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region imprime-distribuição (
        name: Imprime Distribuição
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                --
                  pck_imprime.prc_imprimedistrib_filiais(:P100_IDSEMANA);
                --
                end;
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P100_IDSEMANA (
        type: hidden
        layout {
            sequence: 10
            region: @imprime-distribuição
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

