page 202 (
    name: Fornecedores Pagos
    title: Fornecedores Pagos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 80%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region fornecedores-pagos (
        name: Fornecedores Pagos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefornecedor(nn.idfornemitente) fornecedor
                     , sum(v.valor) valor
                from vencimentos   v
                   , notasfiscais  nn
                where v.idsemanavencimento =  ( select idsemana
                                              from fechamentossemanais f
                                              where f.idfechamento = :P202_IDFECHAMENTO )
                  and v.idnotafiscal = nn.idnotafiscal
                  and nn.idcompratransferencia is null
                  and ( nn.idfilialdestino  in  ( select idfilial
                                                  from filiais
                                                  where tipofilial = 'C' )                  
                      or exists ( select 1
                                from favorita.filiaisfavorita  f
                                where f.idfilialromance = nn.idfilialdestino 
                                  and f.tipofilial      = 'E' )            )
                group by nn.idfornemitente
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 2549326528807487836
        }

        column FORNECEDOR (
            type: plainText
            heading {
                heading: Fornecedor
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column VALOR (
            type: plainText
            heading {
                heading: Valor
                alignment: center
            }
            layout {
                sequence: 11
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 25493352 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100000
            }

            displayColumn FORNECEDOR (
                sequence: 1
            )

            displayColumn VALOR (
                sequence: 2
            )

            sort (
                column: FORNECEDOR
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: VALORDEPOSITO
            )

            aggregate (
                column: VALOR
            )

        )

    )

    pageItem P202_IDFECHAMENTO (
        type: hidden
        layout {
            sequence: 10
            region: @fornecedores-pagos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

