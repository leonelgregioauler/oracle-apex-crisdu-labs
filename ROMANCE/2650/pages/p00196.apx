        }
        serverSideCondition {
            type: never
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P196_IDDEPOSITODIARIOS is null then
                        select "SEQ_IDDEPOSITODIARIOS".nextval
                          into :P196_IDDEPOSITODIARIOS
                          from dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 743845724598738713
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-depositosdiarios (
        name: Process Row of DEPOSITOSDIARIOS
        type: autoRowProcessing
        target {
