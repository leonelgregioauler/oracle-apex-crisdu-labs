    process chama-prc-atualiza-parcela (
        name: Chama prc_atualiza_parcela
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  pck_romance.prc_atualiza_parcelas(:P196_IDPGTOFORN,null);
                end;
                ```
        }
        execution {
            sequence: 60
        }
        error {
            displayLocation: onErrorPage
