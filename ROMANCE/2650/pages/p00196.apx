    pageItem P196_IDFILIALFORNECEDOR (
        type: selectList
        label {
            label: "Filial "
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select PCK_ROMANCE.fnc_nomefilial(idfilial)
                     , idfilial
                from filiais
                where tipofilial = 'F'
                order by 1 
                ```
            nullDisplayValue: - Selecione a Filial Fornecedora -
