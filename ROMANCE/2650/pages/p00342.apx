                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P342_ANO (
        type: numberField
        label {
            label: Ano
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 8
        }
        default {
            type: expression
            plsqlExpression: to_char(sysdate,'RRRR')
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P342_DATAFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
