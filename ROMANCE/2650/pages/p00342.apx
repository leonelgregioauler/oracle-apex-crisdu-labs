page 342 (
    name: Extrato de Fornecedores
    title: Extrato de Fornecedores
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region extrato-de-faturas (
        name: Extrato de Faturas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select  idextratocontabancaria
                     , ( select pck_romance.fnc_nomepessoa( c.idpessoa)
                         from contasbancarias c
                         where c.idcontabanc = e.idcontabancaria ) destino
                     , pck_cadastros_rmc.fnc_retornacontabancaria(e.idcontabancaria) conta   
                     , e.datamovimento datamovimento
                     , 'Fatura '||nn.documento motivo  
                     , case
                         when nn.idfilialdestino is not null then
                           pck_romance.fnc_nomefilial(nn.idfilialdestino) 
                         else
                           pck_romance.fnc_nomefornecedor(nn.idfornecedordestino)
                       end empresadestino
                     , e.valormovimento valorpagar
                     , nvl(vv.valorpago,0) valorpago  
                     , extract(month from e.datamovimento) mes
                     , to_char(e.datamovimento,'month') mestexto
                     , extract(year from e.datamovimento) ano
                     , e.idcontabancaria
                from extratoscontasbancarias e 
                   , notasfiscais nn
                   , vencimentos  vv      
                where nn.idnotafiscal = vv.idnotafiscal
                  and vv.idvencimento = e.idvencimento
                  and e.valormovimento < 0                   
                  and ( :P342_TIPO_PESQUISA   = 'T'
                     or ( :P342_TIPO_PESQUISA = 'P' and e.datamovimento  between  to_date(:P342_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P342_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS'))
                     or ( :P342_TIPO_PESQUISA = 'M' and ( :P342_MES is null or extract (month from e.datamovimento) = :P342_MES ) 
                                                    and extract (year from e.datamovimento) = :P342_ANO ) )    
                  and exists ( select 1
                               from contasbancarias c
                               where c.idcontabanc = e.idcontabancaria
                                 and ( :P342_IDFORNECEDOR is null or c.idpessoa = :P342_IDFORNECEDOR ) 
                                 and ( :P342_IDCONTABANCARIA is null or c.idcontabanc = :P342_IDCONTABANCARIA) )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: "Nenhum resultado encontrado! Verifique os filtros utilizados. "
        }
        advanced {
            savedReportMappingIdentifier: 1577226062929116791
        }

