        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Período;P,Mês/Ano;M,- Tudo -;T
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P342_ULTIMA_ATUALIZACAO (
        type: displayOnly
        label {
            label: Ultima Atualização de Contas realizada
            alignment: left
        }
        layout {
            sequence: 10
            region: @extrato-de-faturas
            slot: regionBody
            alignment: left
            column: 5
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select to_char(max(DATAATUALIZACAO),'DD/MM/RRRR HH24:MI:SS') data
                from ATUALIZACAOCONTASFORN a
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: Filtrar
        label: Filtrar
        layout {
            sequence: 100
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction pesquisa-mes-ano (
        name: Pesquisa Mes/ANo
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P342_TIPO_PESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P342_TIPO_PESQUISA
            value: M
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P342_MES
                    P342_ANO
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P342_MES
                    P342_ANO
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo-pesquisa-período (
        name: Tipo Pesquisa Período
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P342_TIPO_PESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P342_TIPO_PESQUISA
            value: P
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P342_DATAINICIO
                    P342_DATAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P342_DATAINICIO
                    P342_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: Go To Page 342
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 342
                items: {
                    P342_IDCONTABANCARIA: &P342_IDCONTABANCARIA.
                    P342_IDFORNECEDOR: &P342_IDFORNECEDOR.
                    P342_ANO: &P342_ANO.
                    P342_MES: &P342_MES.
                    P342_DATAFIM: &P342_DATAFIM.
                    P342_DATAINICIO: &P342_DATAINICIO.
                    P342_TIPO_PESQUISA: &P342_TIPO_PESQUISA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

