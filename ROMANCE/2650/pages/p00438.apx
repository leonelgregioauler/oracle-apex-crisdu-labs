page 438 (
    name: Revisar Entradas
    title: Revisar Entradas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region revisar-entradas (
        name: Revisar Entradas
        type: tabform
        source {
            sqlQuery:
                ```sql
                select e.identrada
                     , e.idmatrizentrada
                     , e.idcontacontabil
                     , e.idsubcontacontabil
                     , e.descricao 
                     , e.valortotal
                     , e.emmaos
                     , e.observacaocontrole 
                     , null questionamento
                     , null anexos
                     , ( select count(1)
                         from roman.anexosentradas ae
                         where ae.identrada = e.identrada ) qtdanexos
                     , replace(replace(replace(e.descricao||' - '||e.valortotal,',','.') ,'+',''),'-','.')  questionar 
                from roman.entradasdiversas e
                where e.idfilial = :P0_IDFILIALCAIXA
                  and (:P0_IDFECHAMENTO = 999999999999 
                        or e.idfechamento = :P0_IDFECHAMENTO )
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            partialPageRefresh: false
        }
        componentAdvanced {
            stripHtml: true
        }

        column ANEXOS (
            reportColumnQueryId: 10
            derivedColumn: N
            type: link
            heading {
                heading: Anexos
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 439
                    items: {
                        P439_IDENTRADA: #IDENTRADA#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-view.png" class="apex-edit-view" alt="">
            }
            sorting {
                sortable: false
            }
        )

        column DESCRICAO (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column EMMAOS (
            reportColumnQueryId: 7
            derivedColumn: N
            type: simpleCheckbox
            heading {
                heading: Em Mãos
                alignment: center
            }
            lov {
                checkboxValues: S
            }
            layout {
                sequence: 7
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column IDCONTACONTABIL (
            reportColumnQueryId: 3
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Conta
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nomeconta display_value
                         , idcontafinan  return_value
                    from roman.contasfinanceiras c
                    order by 1
                    ```
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

        column IDENTRADA (
            reportColumnQueryId: 1
            derivedColumn: N
            type: textField
            heading {
                heading: ID
                alignment: center
            }
            layout {
                sequence: 1
            }
            primaryKeySource {
                type: existingTrigger
            }
            sorting {
                sortable: false
            }
            advanced {
                customAttributes: readonly
            }
        )

        column IDMATRIZENTRADA (
            reportColumnQueryId: 2
            derivedColumn: N
            type: selectList
            heading {
                heading: Classificação
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select e.classificacaoentrada
                         , e.idmatrizentrada
                    from roman.matrizclassificacoesentradas e
                    where e.idfilial = :P0_IDFILIALCAIXA
                      and e.ativo = 'S'
                    order by 1
                    ```
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

        column IDSUBCONTACONTABIL (
            reportColumnQueryId: 4
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Sub Conta
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select c.nomeconta ||' - '||s.nomeconta display_value
                         , s.idsubcontafinan return_value
                    from roman.subcontasfinanceiras s
                       , roman.contasfinanceiras c
                    where c.idcontafinan = s.idcontafinan
                    order by 1
                    ```
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

        column OBSERVACAOCONTROLE (
            reportColumnQueryId: 8
            derivedColumn: N
            type: textField
            heading {
                heading: Observação Revisão
                alignment: center
            }
            layout {
                sequence: 8
            }
            sorting {
                sortable: false
            }
        )

        column QTDANEXOS (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: Anexos
                alignment: center
            }
            layout {
                sequence: 11
            }
            sorting {
                sortable: false
            }
        )

        column QUESTIONAMENTO (
            reportColumnQueryId: 9
            derivedColumn: N
            type: link
            heading {
                heading: Questionar
                alignment: center
            }
            layout {
                sequence: 9
                columnAlignment: center
            }
            link {
                target: {
                    page: 433
                    items: {
                        P433_IDFECHAMENTO: &P0_IDFECHAMENTO.
                        P433_IDFILIAL: &P0_IDFILIALCAIXA.
                        P433_IDQUESTIONAMENTO:
                        P433_PAGINA: 438
                        P433_QUESTIONAMENTO: #QUESTIONAR#
                    }
                    action: resetPagination
                    anchor: #QUESTIONAR#
                }
                linkText: <img src="#APP_IMAGES#quest1.png" alt="">
            }
            sorting {
                sortable: false
            }
        )

        column QUESTIONAR (
            reportColumnQueryId: 12
            derivedColumn: N
            type: hidden
            layout {
                sequence: 12
            }
        )

        column VALORTOTAL (
            reportColumnQueryId: 6
            derivedColumn: N
            type: textField
            heading {
                heading: Valor
                alignment: center
            }
            layout {
                sequence: 6
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
            sorting {
                sortable: false
            }
            advanced {
                customAttributes: style="text-align:right"
                computeSum: true
            }
        )

    )

    pageItem P438_PAGINA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @revisar-entradas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button novo-questionamento (
        buttonName: NOVO_QUESTIONAMENTO
        label: Novo Questionamento
        layout {
            sequence: 10
            region: @revisar-entradas
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 433
                items: {
                    P433_PAGINA: 438
                    P433_IDFILIAL: &P0_IDFILIALCAIXA.
                    P433_IDFECHAMENTO: &P0_IDFECHAMENTO.
                    P433_IDQUESTIONAMENTO:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button salvar (
        buttonName: SALVAR
        label: Salvar
        layout {
            sequence: 20
            region: @revisar-entradas
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 30
            region: @revisar-entradas
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 438
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @revisar-entradas
        target {
            tableName: ENTRADASDIVERSAS
            pkColumn: IDENTRADA
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# row(s) updated
        }
        advanced {
            executionMappingIdentifier: 31641342674779533
        }
        serverSideCondition {
            whenButtonPressed: @salvar
        }
    )

    branch (
        name: Go To Page 438
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 438
                items: {
                    P438_PAGINA: &P438_PAGINA.
                }
            }
        }
    )

    branch (
        name: Go To Page 80
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 80
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @voltar
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') = 'VOLTAR'
                  and :P438_PAGINA = 80
                ```
        }
    )

)

