    pageItem P21_IDBANCO (
        type: selectList
        label {
            label: Banco
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(NOMEBANCO) display_value
                , IDBANCO return_value 
                from BANCOS
                order by 1
                ```
            nullDisplayValue: " "
        }
        layout {
            sequence: 30
            region: @cadastro-de-contas-bancarias-filiais
            slot: regionBody
            alignment: left
        }
