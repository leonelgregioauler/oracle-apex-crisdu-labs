    pageItem P21_IDFILIAL (
        type: selectList
        label {
            label: Filial
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nomepessoa||' - ('|| c.nomecidade||'-'||e.sigla||')' display_value
                     , f.idfilial return_value
                from pessoas p
                   , cidades c
                   , estados e
                   , filiais f
                where p.idcidade = c.idcidade
                  and c.idestado = e.idestado
                  and F.idpessoa = p.idpessoa 
                  and :P32_IDFILIAL IS NULL
                union
                select p.nomepessoa||' - ('|| c.nomecidade||'-'||e.sigla||')' display_value
                     , f.idfilial return_value
                from pessoas p
                   , cidades c
                   , estados e
                   , filiais f
                where p.idcidade = c.idcidade
                  and c.idestado = e.idestado
                  and F.idpessoa = p.idpessoa 
                  and :P32_IDFILIAL IS NOT NULL
                ```
            nullDisplayValue: " "
        }
        layout {
            sequence: 20
            region: @cadastro-de-contas-bancarias-filiais
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

