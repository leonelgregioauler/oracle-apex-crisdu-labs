    process fetch-row-from-contasbancariasfiliais (
        name: Fetch Row from CONTASBANCARIASFILIAIS
        type: autoRowFetch
        source {
            tableName: CONTASBANCARIASFILIAIS
            pkColumn: IDCONTABANC
            pkItem: P21_IDCONTABANC
        }
