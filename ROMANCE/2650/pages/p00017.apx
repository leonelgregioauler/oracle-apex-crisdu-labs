    process fetch-row-from-contasbancarias (
        name: Fetch Row from CONTASBANCARIAS
        type: autoRowFetch
        source {
            tableName: CONTASBANCARIAS
            pkColumn: IDCONTABANC
            pkItem: P17_IDCONTABANC
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Unable to fetch row.
        }
        advanced {
            executionMappingIdentifier: 181102362285169286
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDCONTABANC.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P17_IDCONTABANC := get_pk; 
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Unable to get primary key item value.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 181102561278169287
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

