    pageItem P468_IDNOTAFISCAL_V (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @transferências-realizadas-sem-notas-de-venda
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    process gera-vencimento (
        name: Gera Vencimento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Created on 16/11/2023 by GUILHERME.DREHMER 
                declare 
                  -- Local variables here
                  i integer;
                  vidfornecedoremitente number;
                    vidfornecedordestino  number;
                    vidmatrizdespesa      number;
                    vidcentrodecusto      number := 22;
                    vidconta              number := 293;
                    vidsubconta           number := 854;
                    vidvencimento         number;
                    vtipo                 varchar2(1);
                    vfixavariavel         varchar2(1);
                    vdias                 number;
                    vdatavencimento       date := sysdate;
                    vtipopagamento        varchar2(1) := 'T';
                    vidcontabanc          number;
                    vobservacao           varchar2(100) := 'FIN2';
                    videntificado         varchar2(1) := 'N';
                    vidsemanavencimento   number;     
                    vidmoeda              number := 1;
                    vidduplicata          number;
                    --
                    vidnotafiscalvenda number;
                    --
                    vidmatrizreceita number;
                  --
                begin
                  -- Test statements here
                  for i in ( select nf.idnotafiscal
                                  , nf.idfilialemitente
                                  , ( select f.idfornecedor
                                      from fornecedores f
                                         , filiais ff
                                      where f.idpessoa = ff.idpessoa
                                        and ff.idfilial = nf.idfilialemitente ) idfornemit
                                  , ( select f.idfornecedor
                                      from fornecedores f
                                         , filiais ff
                                      where f.idpessoa = ff.idpessoa
                                        and ff.idfilial = nf.idfilialdestino ) idforndest
                                  , nf.idfilialdestino
                                  , pck_romance.fnc_nomefilial(nf.idfilialemitente) filemit
                                  , pck_romance.fnc_nomefilial(nf.idfilialdestino) fildest
                                  , ( select idnotafiscal
                                      from notasfiscais n
                                      where n.idnotafiscalcompra = nf.idnotafiscal ) idnotafiscalvenda
                             from notasfiscais nf
                             where nf.idnotafiscal = :P468_IDNOTAFISCAL )
                  loop
                    --
                    -- busca matriz de receita
                    --
                    vidconta := 326;
                    vidsubconta := 855;
                    --
                    select m.idmatrizregrareceita
                    into vidmatrizreceita
                    from matrizregrasreceitas m
                    where m.idfornecedoremitente = i.idfornemit
                      and m.idfornecedorcliente  = i.idforndest
                      and m.idcontafinan         = 326
                      and m.idsubcontafinan      = 855;
                    --
                    -- Insere em vencimentos a receber da destino para emitente 
                    --
                    insert into vencimentosreceber ( idvencimento         , idnotafiscal         , dias
                                                   , datavencimento       , valor                , tipopagamento  
                                                   , idmatrizregrareceita , idcontafinan         , idsubcontafinan )
                    select idvencimento     , i.idnotafiscalvenda   , dias
                         , datavencimento   , valor                , tipopagamento
                         , vidmatrizreceita , vidconta             , vidsubconta 
                    from vencimentos v
                    where v.idnotafiscal = i.idnotafiscal;
                    --
                  end loop;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Vencimento Gerado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 2118949395172156304
        }
        serverSideCondition {
            type: request=Value
            value: GERAR_VENCIMENTO
        }
    )

