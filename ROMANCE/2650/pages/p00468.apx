    region transferências-realizadas-sem-notas-de-venda (
        name: Transferências Realizadas sem Notas de Venda
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select x.idnotafiscal
                     , x.documento
                     , x.filemit
                     , x.fildest
                     , x.dtnf
                     , x.datarecebimento
                     , x.valortotal
                     , x.valorliquido
                     , nvl(( select 'Sim'
                             from matrizregrasdespesas md
                             where md.idcentrodecusto = 22
                               and md.idcontafinan = 293
                               and md.idsubcontafinan = 854
                               and md.idfornecedor = x.idfornemit
                               and md.idfilial = idfilialdestino ),'Não') matriz_despesa
                     , nvl(( select 'Sim'
                             from matrizregrasreceitas mr
                             where mr.idcontafinan = 326
                               and mr.idsubcontafinan = 855
                               and mr.idfornecedoremitente = x.idfornemit
                               and mr.idfornecedorcliente = x.idforndest ),'Não') matriz_receita
                     , '<a href=javascript:apex.submit({request:''GERAR_VENCIMENTO_NOVO'',set:{''P468_IDNOTAFISCAL_V'':'||idnotafiscal||'}});><img src=/i/menu/pencil16x16.gif alt=Gerar Venda border=0 width=16 height=16></a>' gerar
                from ( 
                      select nf.idnotafiscal
                           , nf.documento
                           , nf.idfilialemitente
                           , ( select f.idfornecedor
                               from fornecedores f
                                  , filiais ff
                               where f.idpessoa = ff.idpessoa
                                 and ff.idfilial = nf.idfilialemitente ) idfornemit
                           , ( select f.idfornecedor
                               from fornecedores f
                                  , filiais ff
                               where f.idpessoa = ff.idpessoa
                                 and ff.idfilial = nf.idfilialdestino ) idforndest
                           , nf.idfilialdestino
                           , pck_romance.fnc_nomefilial(nf.idfilialemitente) filemit
                           , pck_romance.fnc_nomefilial(nf.idfilialdestino) fildest
                           , nf.dtnf
                           , nf.datarecebimento
                           , nf.valortotal
                           , nf.valorliquido
                      from notasfiscais nf
                      where nf.tiponota = 'T'
                        and nf.situacaofilial = 'R'
                        and extract ( year from nf.datarecebimento ) >= 2022
                        and not exists ( select 1
                                     from notasfiscais n
                                     where n.idnotafiscalcompra = nf.idnotafiscal  )
                        and exists ( select 1
                                     from vw_filiais f
                                     where f.idfilial = nf.idfilialemitente
                                       and f.tipofilial in ('D','A') )
                        and exists ( select 1
                                     from vw_filiais f
                                     where f.idfilial = nf.idfilialdestino
                                       and f.tipofilial in ('D','F','A') ) ) x
                where valortotal > 0
                ```
        }
