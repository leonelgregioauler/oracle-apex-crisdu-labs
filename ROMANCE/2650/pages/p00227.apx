    region vencimento (
        name: Vencimento
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct   nvl(pck_romance.fnc_nomefornecedor(pidforn => pagforn.idfornecedor),'-') Fornecedor
                     , pagforn.dtvencimento 
                     , ( select nvl(n.documento,n.nrnf) from notasfiscais n where n.idnotafiscal = pagforn.idnotafiscal) numeronota
                     , '<i>'||nvl(pck_romance.fnc_nomefornecedor(pidforn => pagforn.idfornecedor),'-')||' - '||pagforn.IDFORNECEDOR ||'</i><br><b>'
                       || ( select cb.beneficiario||' - '||b.nomebanco
                              ||' - '|| cb.agencia ||' - '||
                              cb.conta||'</b>'
                         from contasbancarias cb
                            , bancos b
                         where cb.idbanco         = b.idbanco 
                           and cb.idcontabanc = pagforn.idcontabanc)  conta
                     , pagforn.valorpagar ValorPagar
                     , nvl(pagforn.valorpago,0)  ValorPago
                     , nvl(pagforn.valorpago,0) - pagforn.valorpagar Saldo
                     , ( select descricao
                         from formaspagamentos t
                         where idformapagamento = pagforn.tipopagamento ) "Tipo Pagamento"
                     , pagforn.observacao "Observação"         
                     , pck_romance.fnc_nomefilial(pagforn.idfilial ) Destino
                     , decode(identificado,'S','Sim','Não')  "Identificado"
                     ,  case
                                  when ( select r.cnpj
                                         from razoessociaisfornec r
                                            , notasfiscais        n
                                         where r.idrazaosocialforn = n.idrazaosocialfornemit
                                           and n.idnotafiscal      = pagforn.idnotafiscal ) like '07318638%' then
                                         'Sim'
                                  when ( select r.cnpj
                                         from razoessociaisfornec r
                                            , notasfiscais        n
                                         where r.idrazaosocialforn = n.idrazaosocialforndest 
                                           and n.idnotafiscal      = pagforn.idnotafiscal ) like '07318638%' then
                                         'Sim'
                                  when ( select cnpj
                                         from razoessociaisfiliais re
                                            , notasfiscais        n
                                         where re.idrazaosocialfilial = n.idrazaosocialfilemit 
                                           and n.idnotafiscal      = pagforn.idnotafiscal ) like '07318638%' then
                                         'Sim'
                                  when ( select  cnpj
                                         from razoessociaisfiliais re
                                            , notasfiscais        n
                                         where re.idrazaosocialfilial = n.idrazaosocialfildestino 
                                           and n.idnotafiscal      = pagforn.idnotafiscal ) like '07318638%' then
                                         'Sim'
                                  else 
                                    'Não'
                                 end crisdu
                     , decode(PRIORIDADE,null, '-', 'Prioridade') prioridade
                from pagamentosfornecedores pagforn
                where pagforn.idpgtoforn  = :P227_IDPGTOFORN
                ```
        }
        layout {
            sequence: 60
            slot: breadcrumbBar
        }
