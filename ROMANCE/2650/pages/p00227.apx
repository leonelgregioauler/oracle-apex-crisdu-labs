    dynamicAction limpa-depósitos-sem-valores (
        name: "Limpa Depósitos Sem Valores "
        execution {
            sequence: 30
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select *
                from depositosdiarios d
                where d.idrepresentante is null
                  and d.valordeposito is null
                  and d.idcontabanc = :P227_IDCONTABANCARIA
                  and d.idfornecedor = :P227_IDFORNECEDOR;
                ```
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                      --
                      delete depositosdiarios d
                      where d.idrepresentante is null
                        and d.valordeposito is null
                        and d.idcontabanc = :P227_IDCONTABANCARIA
                        and d.idfornecedor = :P227_IDFORNECEDOR;
                      --
                      commit;
                      --
                    end;
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction submit (
        name: Submit
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @submit
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: SUBMIT
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

