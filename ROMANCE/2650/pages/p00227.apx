    dynamicAction addrows (
        name: AddRows
        execution {
            sequence: 10
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P227_IDFILIAL
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.widget.tabular.addRow();
                    apex.widget.tabular.addRow();
                    apex.widget.tabular.addRow();
                    apex.widget.tabular.addRow();
                    apex.widget.tabular.addRow();
                    apex.widget.tabular.addRow();
                    apex.widget.tabular.addRow();
                    apex.widget.tabular.addRow();
                    ```
            }
