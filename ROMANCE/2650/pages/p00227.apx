    process enviar-sms (
        name: ENVIAR SMS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_financeiro_rmc.prc_enviasms_deposito( pusuario         => v('APP_USER')
                                                          , pidpgtoforn      => null
                                                          , pidcontabancaria => :P227_IDCONTABANCARIA);
                end;
                
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: SMS enviado com sucesso!
        }
        error {
            errorMessage: Erro ao enviar SMS!
        }
        advanced {
            executionMappingIdentifier: 2807610398530327978
        }
        serverSideCondition {
            type: request=Value
            value: ENVIARSMS
        }
    )

    process processa-saldos-das-faturas (
        name: Processa saldos das Faturas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vv number := 0;
                begin
                  --
                  pck_financeiro_rmc.prc_atualiza_parcelas( :P227_IDPGTOFORN , null );
                  --
                  pck_financeiro_rmc.prc_atualiza_pagtoforn ( :P227_IDPGTOFORN );
                  --
                  pck_financeiro_rmc.prc_deleta_saldo_sem_pai;
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 2807609989746327977
        }
    )

    branch (
        name: Go To Page 227 - Empresa
        execution {
            sequence: 21
        }
        behavior {
            target: {
                page: 227
                items: {
                    P227_IDFILIAL: &P227_IDFILIAL.
                    P227_IDCONTABANCARIA: &P227_IDCONTABANCARIA.
                    P227_IDFORNECEDOR: &P227_IDFORNECEDOR.
                    P227_IDENTIFICADO: &P227_IDENTIFICADO.
                }
            }
