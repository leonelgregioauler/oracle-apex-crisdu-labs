        column DATA (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Ultimas Importações
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P331_DATAFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 40
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            formatMask: DD/MM/RRRR
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P331_DATAINICIO (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 30
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            formatMask: DD/MM/RRRR
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P331_IDCONTA (
        type: popupLov
        label {
            label: Selecione a Conta
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select b.nomebanco||' - Ag: '||cb.agencia||' Cc: '||cb.conta||' - Beneficiario: '||initcap(p.apelido) display_value
                     , cb.idcontabanc return_value
                from bancos b
                   , contasbancarias cb
                   , pessoas p
                where cb.idbanco = b.idbanco
                  and p.idpessoa = cb.idpessoa
                  and cb.idcontabanc in (3822, 2399)
                ```
        }
        layout {
            sequence: 50
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 60
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-filter
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button importar-arquivo (
        buttonName: IMPORTAR_ARQUIVO
        label: Importar Arquivo
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--iconLeft
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 332
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 331
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 331
                items: {
                    P331_DATAINICIO: &P331_DATAINICIO.
                    P331_DATAFIM: &P331_DATAFIM.
                    P331_IDCONTA: &P331_IDCONTA.
                }
                action: resetPagination
            }
        }
    )

)

