    region maior-data-localizada (
        name: Maior Data Localizada
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select max(trunc(e.datamovimento)) data
                from extratosdepositos e 
                where e.datamovimento is not null
                  and e.idcontabancaria = :P331_IDCONTA
                union
                select max(trunc(e.data)) data
                from extratosbradesco e 
                where e.data is not null
                  and e.idcontabancaria = :P331_IDCONTA
                ```
        }
        layout {
            sequence: 10
            parentRegion: @informações
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            customAttributes: align="center"
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: showAll
        }

