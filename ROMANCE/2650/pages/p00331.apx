        )

    )

    region meses-processados (
        name: Meses Processados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(e.datamovimento,'MM/RRRR') mes
                     , pck_util.fnc_idsemana(to_char(e.datamovimento,'MM/RRRR')) idsemana
                from extratosdepositos e
                where e.idcontabancaria = :P331_IDCONTA
                group by to_char(e.datamovimento,'MM/RRRR')
                union
                select to_char(e.data,'MM/RRRR') mes
                     , pck_util.fnc_idsemana(to_char(e.data,'MM/RRRR')) idsemana
                from extratosbradesco e
                where e.idcontabancaria = :P331_IDCONTA
                group by to_char(e.data,'MM/RRRR')
                order by 2 desc
                
                ```
        }
        layout {
            sequence: 30
            parentRegion: @informações
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            customAttributes: align="center"
        }
        componentAppearance {
