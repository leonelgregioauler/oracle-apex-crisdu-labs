    region avisos-do-dia (
        name: Avisos do Dia
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v1.sucesso + v2.sucesso sucesso
                     , v1.erro erro
                     , v1.divergenciavalor + v2.divergenciavalor divergenciavalor
                     , v1.divergencia + v2.divergencia divergencia
                from ( 
                       select nvl(( select count(a.idavisoextratodeposito) 
                                    from avisosextratosdepositos a
                                       , extratosdepositos e
                                    where a.idextratodeposito = e.idextratodeposito
                                      and e.idcontabancaria   = :P331_IDCONTA
                                      and trunc(datamovimento) between to_date(:P331_DATAINICIO,'DD/MM/RRRR') and to_date(:P331_DATAFIM,'DD/MM/RRRR')
                                      and a.processado = 'S' ),0) sucesso
                            , nvl(( select count(1)
                                    from depositosdiarios_orig d
                                    where d.localizado = 'E'
                                      and d.idcontabanc = :P331_IDCONTA
                                      and trunc(d.data) between to_date(:P331_DATAINICIO,'DD/MM/RRRR') and to_date(:P331_DATAFIM,'DD/MM/RRRR') ),0) erro
                            , nvl(( select count(a.idavisoextratodeposito)
                                    from avisosextratosdepositos a
                                       , extratosdepositos e
                                    where a.idextratodeposito = e.idextratodeposito
                                      and e.idcontabancaria   = :P331_IDCONTA
                                      and trunc(datamovimento) between to_date(:P331_DATAINICIO,'DD/MM/RRRR') and to_date(:P331_DATAFIM,'DD/MM/RRRR')
                                      and a.processado = 'D' ),0) divergenciavalor
                            , nvl(( select count(a.idavisoextratodeposito)
                                    from avisosextratosdepositos a
                                       , extratosdepositos e
                                    where a.idextratodeposito = e.idextratodeposito
                                      and e.idcontabancaria = :P331_IDCONTA
                                      and trunc(datamovimento) between to_date(:P331_DATAINICIO,'DD/MM/RRRR') and to_date(:P331_DATAFIM,'DD/MM/RRRR')
                                      and a.processado = 'M' ),0) divergencia
                       from dual ) v1
                   , (
                       select nvl( ( select count(aa.idavisoextratobradesco)
                                     from avisosextratosbradesco aa
                                        , extratosbradesco ee
                                     where aa.idextratobradesco = ee.idextratobradesco
                                       and aa.processado             = 'S'
                                       and ee.idcontabancaria        = :P331_IDCONTA
                                       and trunc(ee.data) between to_date(:P331_DATAINICIO,'DD/MM/RRRR') and to_date(:P331_DATAFIM,'DD/MM/RRRR') ),0) sucesso
                            , 0 erro
                            , nvl( ( select count(aa.idavisoextratobradesco)
                                     from avisosextratosbradesco aa
                                        , extratosbradesco ee
                                     where aa.idextratobradesco = ee.idextratobradesco
                                       and aa.processado             = 'D'
                                       and ee.idcontabancaria        = :P331_IDCONTA
                                       and trunc(ee.data) between to_date(:P331_DATAINICIO,'DD/MM/RRRR') and to_date(:P331_DATAFIM,'DD/MM/RRRR') ),0) divergenciavalor
                            , nvl( ( select count(aa.idavisoextratobradesco)
                                     from avisosextratosbradesco aa
                                        , extratosbradesco ee
                                     where aa.idextratobradesco = ee.idextratobradesco
                                       and aa.processado             = 'M'
                                       and ee.idcontabancaria        = :P331_IDCONTA
                                       and trunc(ee.data) between to_date(:P331_DATAINICIO,'DD/MM/RRRR') and to_date(:P331_DATAFIM,'DD/MM/RRRR') ),0) divergencia
                       from dual
                     ) v2
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/badge-list
            templateOptions: [
                #DEFAULT#
                t-BadgeList--xxlarge
                t-BadgeList--fixed
                t-BadgeList--circular
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

