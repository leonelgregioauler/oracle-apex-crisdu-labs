    region depósitos-encontrados (
        name: Depósitos Encontrados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select dr.iddepositodiario
                     , nvl(dr.datadeposito,( select d.data
                                             from depositosdiarios_orig d
                                             where d.iddepositodiarios = dr.iddepositodiario )) datadeposito
                     , e.datamovimento datamovimento 
                     , dr.nroidentificacao_digitado nrocomprovante
                     , dr.valor_digitado valordeposito
                     , ( select  initcap(bb.nomebanco) || ' - <b>' || cb.agencia ||'/'||cb.conta||'</b> - <i>'||initcap(cb.beneficiario)||'</i>' 
                         from contasbancarias cb
                            , fornecedores    ff
                            , pessoas         pf
                            , bancos          bb
                         where cb.idfornecedor = ff.idfornecedor
                           and ff.idpessoa     = pf.idpessoa
                           and cb.idbanco      = bb.idbanco
                           and cb.idcontabanc  = ( select do.idcontabanc
                                                   from depositosdiarios_orig do
                                                   where do.iddepositodiarios = dr.iddepositodiario ) ) beneficiario
                     , nvl(pck_romance.fnc_nomerepresentante(dr.idrepresentante),'-') distribuidor
                from depositosdiarios_leituraocr dr
                   , extratosdepositos e
                where dr.iddepositodiario = e.iddepositodiario
                  and trunc(e.datamovimento) between to_date(:P331_DATAINICIO,'DD/MM/RRRR') and to_date(:P331_DATAFIM,'DD/MM/RRRR')
                  and e.idcontabancaria = :P331_IDCONTA
                union
                select dr.iddepositodiario
                     , nvl(dr.datadeposito,( select d.data
                                             from depositosdiarios_orig d
                                             where d.iddepositodiarios = dr.iddepositodiario )) datadeposito
                     , e.data datamovimento 
                     , dr.nroidentificacao_digitado nrocomprovante
                     , dr.valor_digitado valordeposito
                     , ( select  initcap(bb.nomebanco) || ' - <b>' || cb.agencia ||'/'||cb.conta||'</b> - <i>'||initcap(cb.beneficiario)||'</i>' 
                         from contasbancarias cb
                            , fornecedores    ff
                            , pessoas         pf
                            , bancos          bb
                         where cb.idfornecedor = ff.idfornecedor
                           and ff.idpessoa     = pf.idpessoa
                           and cb.idbanco      = bb.idbanco
                           and cb.idcontabanc  = ( select do.idcontabanc
                                                   from depositosdiarios_orig do
                                                   where do.iddepositodiarios = dr.iddepositodiario ) ) beneficiario
                     , nvl(pck_romance.fnc_nomerepresentante(dr.idrepresentante),'-') distribuidor
                from depositosdiarios_leituraocr dr
                   , extratosbradesco e
                where dr.iddepositodiario = e.iddepositodiario
                  and trunc(e.data) between to_date(:P331_DATAINICIO,'DD/MM/RRRR') and to_date(:P331_DATAFIM,'DD/MM/RRRR')
                  and e.idcontabancaria   = :P331_IDCONTA
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1555088858121008799
        }

