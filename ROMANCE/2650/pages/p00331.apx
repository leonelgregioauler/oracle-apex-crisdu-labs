    region placar-do-dia (
        name: Placar do Dia
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nvl(v1.processados,0) + nvl(v2.processados,0) processados
                     , nvl(v1.localizados,0) + nvl(v2.localizados,0) localizados
                     , nvl(v1.naolocalizados,0) + nvl(v2.naolocalizados,0) naolocalizados
                     , nvl(v1.divergencia,0) + nvl(v2.divergencia,0) divergencia
                from (
                       select ( select count(1) 
                                from extratosdepositos
                                where trunc(datamovimento) between to_date(:P331_DATAINICIO,'DD/MM/RRRR') and to_date(:P331_DATAFIM,'DD/MM/RRRR')
                                  and idcontabancaria = :P331_IDCONTA ) processados
                            , ( select count(1)
                                from extratosdepositos 
                                where iddepositodiario is not null
                                  and processado = 'S'
                                  and idcontabancaria = :P331_IDCONTA
                                  and trunc(datamovimento) between to_date(:P331_DATAINICIO,'DD/MM/RRRR') and to_date(:P331_DATAFIM,'DD/MM/RRRR') ) localizados
                            , ( select count(1)
                                from depositosdiarios_orig d
                                where d.localizado = 'E'
                                  and idcontabanc = :P331_IDCONTA
                                  and trunc(d.data) between to_date(:P331_DATAINICIO,'DD/MM/RRRR') and to_date(:P331_DATAFIM,'DD/MM/RRRR') ) naolocalizados
                            , ( select count(1)
                                from extratosdepositos 
                                where processado in ('D','M')
                                  and dataprocessado is not null
                                  and idcontabancaria = :P331_IDCONTA
                                  and trunc(datamovimento) between to_date(:P331_DATAINICIO,'DD/MM/RRRR') and to_date(:P331_DATAFIM,'DD/MM/RRRR') ) divergencia
                       from dual ) v1
                   , ( 
                       select ( select count(1)
                                from extratosbradesco e
                                where e.idcontabancaria = :P331_IDCONTA
                                  and trunc(e.data) between to_date(:P331_DATAINICIO,'DD/MM/RRRR') and to_date(:P331_DATAFIM,'DD/MM/RRRR') ) processados
                            , ( select count(1)
                                from extratosbradesco e
                                where e.idcontabancaria = :P331_IDCONTA
                                  and e.iddepositodiario is not null
                                  and processado = 'S'
                                  and trunc(e.data) between to_date(:P331_DATAINICIO,'DD/MM/RRRR') and to_date(:P331_DATAFIM,'DD/MM/RRRR') ) localizados
                            , 0 naolocalizados
                            , ( select count(1)
                                from extratosbradesco e
                                where e.idcontabancaria = :P331_IDCONTA
                                  and e.dataprocessado is not null
                                  and processado in ('D','M')
                                  and trunc(data) between to_date(:P331_DATAINICIO,'DD/MM/RRRR') and to_date(:P331_DATAFIM,'DD/MM/RRRR') ) divergencia
                       from dual ) v2
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/badge-list
            templateOptions: [
                #DEFAULT#
                t-BadgeList--xxlarge
                t-BadgeList--fixed
                t-BadgeList--circular
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

