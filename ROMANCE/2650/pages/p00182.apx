page 182 (
    name: Itens em Notas
    title: Relatório de Todos Itens de Notas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region itens-em-notas (
        name: Itens em Notas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select iditnf,
                       nf.idnotafiscal,
                       nf.documento notafiscal,
                       pck_romance.fnc_nomefornecedor(pidforn => nf.idfornemitente)"Fornecedor",
                       pck_romance.fnc_nomefilial(pidfilial => nf.idfilialdestino ) "Filial Destino",
                       pck_romance.fnc_nomeproduto(i.idproduto) produto,
                       pck_romance.fnc_nometransportadora(nf.idtransportadora) transportadora,
                       i.custound,
                       i.valortotal,
                       qtd_pp,
                       qtd_p,
                       qtd_m,
                       qtd_g,
                       qtd_gg,
                       qtd_egg,
                       qtd_u,
                       qtd_total,
                       i.observacao,
                       idprodutodetalhado,
                       qtd_pp_chegou,
                       qtd_p_chegou,
                       qtd_m_chegou,
                       qtd_g_chegou,
                       qtd_gg_chegou,
                       qtd_egg_chegou,
                       qtd_u_chegou,
                       qtd_total_chegou,
                       observacaofilial,
                       nf.situacao,
                       nf.dtnf "Data Nota"
                from itemnf i
                   , notasfiscais nf
                where i.idnotafiscal = nf.idnotafiscal
                  --and nf.idfornemitente = 781 -- n.idnotafiscal = 9502
                 -- and nf.idfilialdestino = 162
                  and nf.situacao != 'C'
                
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Dados não encontrados.
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            pivot: false
            savePublicReport: true
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

