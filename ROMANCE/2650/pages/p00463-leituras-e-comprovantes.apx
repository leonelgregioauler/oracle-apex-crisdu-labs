page 463 (
    name: Leituras e Comprovantes
    alias: LEITURAS-E-COMPROVANTES
    title: Leituras e Comprovantes
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1500
    }

    region leituras-e-comprovantes (
        name: Leituras e Comprovantes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select dd.data
                     , dd.valordeposito
                     , case dd.comprovado
                        when 'S' then 'Sem Comprovante'
                        when 'C' then 'Cópia'
                        when 'G' then 'Com gerente'
                        when 'M' then 'Em mãos'
                       end comprovado
                     , dd.nrocomprovante
                     , dd.observacao observacaosolicitacao
                     , dd.tipo
                     , dd.valororiginal
                     , dd.referentea
                     , case dd.tipopagamento when 'P' then 'Pix' when 'D' then 'Depósito' end  tipopagamentosolicitacao
                     , dd.usuario usuariosolicitacao
                     , dd.datacriacao
                     , dd.dataconfirmacao 
                     , dl.usuario usuarioleitura
                     , dl.dataleitura
                     , dl.datadeposito
                     , dl.banco
                     , dl.agenca
                     , dl.conta
                     , dl.beneficiario
                     , dl.valor_digitado valorleitura
                     , dl.nroidentificacao
                     , dl.nomearquivo
                     , dl.situacao
                     , dl.observacao observacaoleitura
                     , dl.agencia_origem
                     , dl.conta_origem
                     , dl.documento_origem
                     , dl.data_pagamento
                     , dl.tipo_pagamento
                     , c.idcomprovante
                     , c.urlcomprovante
                     , c.idrepresentante
                     , c.iddepositosdiarios
                     , case c.tipopagamento when 'P' then 'Pix' when 'D' then 'Depósito' end tipopagamentocomprovante
                     , case c.statuscomprovante
                        when 'P' then 'Pendente de Envio'
                        when 'A' then 'Aguardando Análise'
                        when 'C' then 'Confirmado'
                        when 'R' then 'Reprovado'
                       end statuscomprovante
                     , c.dataenvio
                     , c.valor valorcomprovante
                     , c.observacao
                from comprovantes c
                   , depositosdiarios_leituraocr dl
                   , depositosdiarios_orig dd      
                where c.idcomprovante = dl.idcomprovante 
                and dl.idrequisicao = dd.idrequisicao
                and dl.iddepositodiario = :P463_IDDEPOSITODIARIO
                and (dl.iddepositodiario is not null or ( dl.iddepositodiario is null and c.statuscomprovante = 'R'))
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 45253038941675144
        }

