        column CLASSIFICACAOPAI (
            type: selectList
            heading {
                heading: Classif. Pai
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT classificacao || ' - ' || descricaoconta d
                         , idclassificacao r
                       FROM planocontasgeral p
                      WHERE p.tipoconta in ('S','D')
                        and to_number(p.nivel) =  (TO_NUMBER(:NIVEL)-1) 
                        and :NIVEL > 1
                    
                        and ( ( :NIVEL = 2 and substr(classificacao,1,1) = (select substr(classificacao,1,1)
                                                                              from planocontasgeral 
                                                                             where idclassificacao = :IDCLASSIFICACAO ) ) OR
                              ( :NIVEL = 3 and substr(classificacao,1,3) = (select substr(classificacao,1,3)
                                                                              from planocontasgeral 
                                                                             where idclassificacao = :IDCLASSIFICACAO ) ) OR
                              ( :NIVEL = 4 and substr(classificacao,1,5) = (select substr(classificacao,1,5)
                                                                              from planocontasgeral 
                                                                             where idclassificacao = :IDCLASSIFICACAO ) ) OR
                              ( :NIVEL = 5 and substr(classificacao,1,8) = (select substr(classificacao,1,8)
                                                                              from planocontasgeral 
                                                                             where idclassificacao = :IDCLASSIFICACAO ) ) )
                      ORDER BY p.classificacao 
                    
                    ```
            }
            cascadingLov {
                parentColumns: NIVEL
                itemsToSubmit: [
                    NIVEL
                    IDCLASSIFICACAO
                ]
            }
            layout {
                sequence: 110
            }
            source {
                databaseColumn: CLASSIFICACAOPAI
                dataType: number
            }
        )

