                        --ATIVA,
                        CRISDU,
                        ROMANCE,
                        FAVORITASUL,
                        FAVORITANORTE,
                        FRANQUIAS,
                        CONTAREDUTORA,
                        rowid,
                        null subclassif,
                        null cfopclassif
                      /*, case when tipoconta = 'A'
                             then  '<a href="f?p=&APP_ID.:521:&SESSION.::NO::P521_IDCLASSIFICACAO:' || idclassificacao || '">
                                    <img src="#APEX_FILES#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">;" />  </a>' 
                             else null 
                        end AS link_com_icone*/
                   from PLANOCONTASGERAL 
                
                
                ```
