    dynamicAction new (
        name: New
        execution {
            sequence: 80
        }
        when {
            selectionType: columns
            interactiveGrid: @classif
            columns: IDCLASSIFICACAO
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: columns
                columns: CLASSIFICACAOPAI
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new-2 (
        name: New_3
        execution {
            sequence: 60
        }
        when {
            selectionType: columns
            interactiveGrid: @classif
            columns: CLASSIFICACAOPAI
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select trim(nvl( (select classificacao || '.'
                                        from planocontasgeral
                                       where idclassificacao = :CLASSIFICACAOPAI) , '') ) || 
                           trim (
                           case
                             when :FORMA = 'DD'
                               then to_char(:NOTACAOCLASSIFICACAO,'00') 
                             when :FORMA = 'DDD'
                               then to_char(:NOTACAOCLASSIFICACAO,'000') 
                             else
                               :NOTACAOCLASSIFICACAO 
                           end) notacao 
                       from dual
                    ```
                itemsToSubmit: [
                    CLASSIFICACAOPAI
                    NOTACAOCLASSIFICACAO
                    FORMA
                ]
            }
            affectedElements {
                selectionType: columns
                columns: CLASSIFICACAO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction seta-forma (
        name: Seta_Forma
        execution {
            sequence: 50
        }
        when {
            selectionType: columns
            interactiveGrid: @classif
            columns: NIVEL
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT case when to_number(:NIVEL) = 5 then 'A' 
                                when to_number(:NIVEL) < 5 then 'S'
                           else null 
                           end tipoconta,
                           CASE when :NIVEL = 1 THEN 'D'
                                when :NIVEL = 2 THEN 'D' 
                                when :NIVEL = 3 THEN 'D' 
                                when :NIVEL = 4 THEN 'DD' 
                                else 'DDD'
                           END forma
                     from dual
                    ```
                itemsToSubmit: NIVEL
            }
            affectedElements {
                selectionType: columns
                columns: [
                    TIPOCONTA
                    FORMA
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation valida-forma (
        name: Valida_Forma
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @classif
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                  from dual
                 where (:FORMA = 'D'   and :NOTACAOCLASSIFICACAO not between 1 and 9) or
                       (:FORMA = 'DD'  and :NOTACAOCLASSIFICACAO not between 1 and 99) or
                       (:FORMA = 'DDD' and :NOTACAOCLASSIFICACAO not between 1 and 999)
                ```
        }
        error {
            errorMessage: #COLUMN_HEADER# Não está de acordo com a Forma
            associatedColumn: NOTACAOCLASSIFICACAO
        }
    )

