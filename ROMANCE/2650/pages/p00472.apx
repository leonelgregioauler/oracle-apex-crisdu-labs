                sqlQuery:
                    ```sql
                    SELECT case when :NIVEL = 1 THEN 'D'
                                when :NIVEL = 2 THEN 'D' 
                                when :NIVEL = 3 THEN 'D' 
                                when :NIVEL = 4 THEN 'DD' 
                                else 'DDD'
                            end as d,
                            --
                            case when :NIVEL = 1 THEN 'D'
                                 when :NIVEL = 2 THEN 'D' 
                                 when :NIVEL = 3 THEN 'D' 
