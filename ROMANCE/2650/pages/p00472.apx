    process save-interactive-grid-data (
        name: Save Interactive Grid Data
        type: executeCode
        editableRegion: @classif
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  --
                  v_dml varchar2(1);
                  v_md5 varchar2(4000);
                  v_str        VARCHAR2(100) := :CLASSIFICACAO ;
                  v_resultado  VARCHAR2(100);
                  v_pos        NUMBER;
                  v_idpai      NUMBER := :CLASSIFICACAOPAI;
                  --
                BEGIN
                  --
                  v_dml := :APEX$ROW_STATUS;
                  if v_dml = 'C' then -- C=Create e a package usa I para inclusão
                    --
                    v_dml := 'I';
                    -- busca o último ponto (da direita pra esquerda)
                    v_pos := INSTR(v_str, '.', -1); 
                    -- Extrai tudo até antes do último ponto
                    v_resultado := SUBSTR(v_str, 1, v_pos - 1);
                    --
                    select idclassificacao
                      into v_idpai
                      from planocontasgeral
                     where classificacao = v_resultado;
                    --
                  elsif v_idpai is null then
                    -- busca o último ponto (da direita pra esquerda)
                    v_pos := INSTR(v_str, '.', -1); 
                    -- Extrai tudo até antes do último ponto
                    v_resultado := SUBSTR(v_str, 1, v_pos - 1);
                    --
                    begin
                      select idclassificacao
                        into v_idpai
                        from planocontasgeral
                       where classificacao = v_resultado;
                    exception
                      when no_data_found then null;
                    end;
                    --
                  end if;
                  --
                
                  --raise_application_error(-20001,'id '||:IDCLASSIFICACAO);
                
                  pck_contabilidade_rmc.prc_planocontasgeral(pidclassificacao      => :IDCLASSIFICACAO,
                                                             pclassificacaopai     => v_idpai,
                                                             pnotacaoclassificacao => :NOTACAOCLASSIFICACAO,
                                                             pclassificacao        => :CLASSIFICACAO,
                                                             ptipolancamento       => :TIPOLANCAMENTO,
                                                             pnivel                => :NIVEL,
                                                             pforma                => :FORMA,
                                                             ptipoconta            => :TIPOCONTA,
                                                             pdescricaoconta       => :DESCRICAOCONTA,
                                                             pativa                => :ATIVA,
                                                             pcrisdu               => :CRISDU,
                                                             promance              => :ROMANCE,
                                                             pfavoritasul          => :FAVORITASUL,
                                                             pfavoritanorte        => :FAVORITANORTE,
                                                             pfranquias            => :FRANQUIAS,
                                                             pcontaredutora        => :CONTAREDUTORA,
                                                             pmd5                  => v_md5,
                                                             poperacao_dml         => v_dml);
                 
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 3243225856616907913
        }
    )

)

