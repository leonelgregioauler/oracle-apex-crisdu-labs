    region saldo-de-cheques-por-empresa (
        name: Saldo de Cheques Por Empresa
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select null link
                     , nvl(pck_romance.fnc_nomefilial(c.idfilial),'Não Informado') label
                     , sum(VALOR - nvl(( select sum(cp.valor) from cheques2pgto cp where cp.idcheque = c.idcheque),0)) value
                from CHEQUES2 c
                having sum(VALOR - nvl(( select sum(cp.valor) from cheques2pgto cp where cp.idcheque = c.idcheque),0)) > 0
                group by idfilial
                order by 1 desc
                ```
        }
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            escapeSpecialChars: false
        }
        chart {
            type: donut
        }
        title {
            title: Saldo de Cheque por Empresa
        }
        chartLayout {
            maxWidth: 900
            height: 400
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        value {
            format: decimal
            formatScaling: none
        }
        animation {
            onDataChange: none
        }
        legend {
            show: false
        }
        messages {
            whenNoDataFound: No data found.
        }

        series series (
            name: Series 1
            execution {
