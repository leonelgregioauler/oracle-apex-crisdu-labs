page 248 (
    name: Cheques
    title: Cheques
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region cheques-novos-por-ano (
        name: Cheques novos por ano
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select link
                     , label
                     , value "Uruguai"
                from vw_graficocheques
                where idfilial = 1041
                order by 2
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        security {
            escapeSpecialChars: false
        }
        chart {
            type: line
        }
        title {
            title: Cheques novos por ano
        }
        chartLayout {
            maxWidth: 1700
            height: 700
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        animation {
            onDataChange: none
        }
        tooltip {
            showSeriesName: false
        }
        legend {
            position: end
            hideAndShowBehavior: none
        }
        messages {
            whenNoDataFound: No data found.
        }

