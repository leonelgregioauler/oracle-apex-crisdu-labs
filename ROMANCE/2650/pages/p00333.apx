    region depósitos-com-divergência-bradesco (
        name: Depósitos com Divergência Bradesco
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.iddepositodiarios
                     , dl.datadeposito datadeposito
                     , e.data datamovimento 
                     , ( select fr.semana
                         from fechamentorepresentantes fr
                         where fr.idfechamentorepres = d.idfechamentorepres ) semana
                     , dl.nroidentificacao_digitado nrocomprovante
                     , dl.valor_digitado valordeposito
                     , e.credito valorencontrado
                     , ( select  initcap(bb.nomebanco) || ' - <b>' || cb.agencia ||'/'||cb.conta||'</b> - <i>'||initcap(cb.beneficiario)||'</i>' 
                         from contasbancarias cb
                            , fornecedores    ff
                            , pessoas         pf
                            , bancos          bb
                         where cb.idfornecedor = ff.idfornecedor
                           and ff.idpessoa     = pf.idpessoa
                           and cb.idbanco      = bb.idbanco
                           and cb.idcontabanc  = d.idcontabanc) beneficiario
                     , nvl(pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(d.idrepresentante)),'-') empresa
                     , nvl(pck_romance.fnc_nomerepresentante(d.idrepresentante),'-') distribuidor
                     , '<a href="javascript:apex.confirm(''Deseja realmente mudar o valor do depósito??'', { request:''CORRIGIR'', set:{''P333_IDDEPOSITODIARIO'':'||dl.idleituraocr_deposito||',''P333_VALORLOCALIZADO'':'||e.credito||' }} )";><img src="#APP_IMAGES#ok.png"  border="0"></a>' corrigir
                from avisosextratosbradesco a
                   , extratosbradesco e
                   , depositosdiarios_orig d
                   , depositosdiarios_leituraocr dl
                where a.processado        = 'D'
                  and dl.iddepositodiario = d.iddepositodiarios
                  and e.idextratobradesco = a.idextratobradesco
                  and d.iddepositodiarios = e.iddepositodiario
                  and dl.valor_digitado    != e.credito
                  and ( replace(replace(dl.nroidentificacao_digitado,'.',''),' ','') = e.nrdocumento
                     or replace(replace(dl.nroidentificacao_digitado,'.',''),' ','') = e.nrreduzido )
                  and trunc(e.data) between to_date(:P333_DATAINICIO,'DD/MM/RRRR') and to_date(:P333_DATAFIM,'DD/MM/RRRR') 
                ```
        }
        layout {
            sequence: 220
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent12
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P333_TIPO = 'D'
                  and exists ( select 1
                               from contasbancarias c
                               where c.idcontabanc = :P333_IDCONTA
                                 and c.idbanco     = 41 )
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 9184882258213440
        }

