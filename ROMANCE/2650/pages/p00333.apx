    region depósitos-com-mesmo-comprovante-localizado-na-conta-bradesco (
        name: Depósitos com mesmo Comprovante Localizado na Conta Bradesco
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.iddepositodiario iddepositodiarios
                     , d.datadeposito datadeposito
                     , ( select fr.semana
                         from fechamentorepresentantes fr
                         where fr.idfechamentorepres = do.idfechamentorepres ) semana
                     , d.nroidentificacao_digitado nrocomprovante
                     , d.valor_digitado valordeposito
                     , ( select  initcap(bb.nomebanco) || ' - <b>' || cb.agencia ||'/'||cb.conta||'</b> - <i>'||initcap(cb.beneficiario)||'</i>' 
                         from contasbancarias cb
                            , fornecedores    ff
                            , pessoas         pf
                            , bancos          bb
                         where cb.idfornecedor = ff.idfornecedor
                           and ff.idpessoa     = pf.idpessoa
                           and cb.idbanco      = bb.idbanco
                           and cb.idcontabanc  = do.idcontabanc) beneficiario
                     , nvl(pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(do.idrepresentante)),'-') empresa
                     , nvl(pck_romance.fnc_nomerepresentante(do.idrepresentante),'-') distribuidor
                from depositosdiarios_leituraocr d
                   , depositosdiarios_orig do
                where d.dataidentificado is null
                  and do.iddepositodiarios = d.iddepositodiario
                  and do.idcontabanc = 3822
                  and do.data between to_date(:P333_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P333_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                  and exists ( select 1
                               from extratosbradesco ex
                               where ex.data between to_date(:P333_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P333_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') 
                                 and ( trim(d.nroidentificacao_digitado) = ex.nrdocumento
                                    or trim(d.nroidentificacao_digitado) = ex.nrreduzido 
                                    or ex.transacao like '%'||d.nroidentificacao_digitado||'%' ) ) 
                ```
        }
        layout {
            sequence: 200
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P333_TIPO = 'M'
                  and exists ( select 1
                               from contasbancarias c
                               where c.idcontabanc = :P333_IDCONTA
                                 and c.idbanco     = 41 )
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 9183667980213428
        }

