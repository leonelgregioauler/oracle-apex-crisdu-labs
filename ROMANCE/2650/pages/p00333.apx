page 333 (
    name: Avisos dos Extratos
    title: Avisos dos Extratos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region análise-de-extratos-depósitos (
        name: Análise de Extratos / Depósitos
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region depósitos-com-divergência-bb (
        name: Depósitos com Divergência BB
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.iddepositodiarios
                     , dl.datadeposito datadeposito
                     , e.datamovimento datamovimento 
                     , ( select fr.semana
                         from fechamentorepresentantes fr
                         where fr.idfechamentorepres = d.idfechamentorepres ) semana
                     , dl.nroidentificacao_digitado nrocomprovante
                     , dl.valor_digitado valordeposito
                     , e.valor valorencontrado
                     , ( select  initcap(bb.nomebanco) || ' - <b>' || cb.agencia ||'/'||cb.conta||'</b> - <i>'||initcap(cb.beneficiario)||'</i>' 
                         from contasbancarias cb
                            , fornecedores    ff
                            , pessoas         pf
                            , bancos          bb
                         where cb.idfornecedor = ff.idfornecedor
                           and ff.idpessoa     = pf.idpessoa
                           and cb.idbanco      = bb.idbanco
                           and cb.idcontabanc  = d.idcontabanc) beneficiario
                     , nvl(pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(d.idrepresentante)),'-') empresa
                     , nvl(pck_romance.fnc_nomerepresentante(d.idrepresentante),'-') distribuidor
                     , '<a href="javascript:apex.confirm(''Deseja realmente mudar o valor do depósito??'', { request:''CORRIGIR'', set:{''P333_IDDEPOSITODIARIO'':'||dl.idleituraocr_deposito||',''P333_VALORLOCALIZADO'':'||e.valor||' }} )";><img src="#APP_IMAGES#ok.png"  border="0"></a>' corrigir
                from avisosextratosdepositos a
                   , extratosdepositos e
                   , depositosdiarios_orig d
                   , depositosdiarios_leituraocr dl
                where a.processado        = 'D'
                  and dl.iddepositodiario = d.iddepositodiarios
                  and e.idextratodeposito = a.idextratodeposito
                  and d.iddepositodiarios = e.iddepositodiario
                  and dl.valor_digitado    != e.valor
                  and replace(replace(dl.nroidentificacao_digitado,'.',''),' ','') = ltrim(e.comprovante,0)
                  and e.datamovimento between to_date(:P333_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P333_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') 
                ```
        }
        layout {
            sequence: 210
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent12
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P333_TIPO = 'D'
                  and exists ( select 1
                               from contasbancarias c
                               where c.idcontabanc = :P333_IDCONTA
                                 and c.idbanco     = 20 )
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 3075537063940832696
        }

