    region localizados (
        name: Localizados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select dr.iddepositodiarios
                     , pck_romance.fnc_nomerepresentante(idrepresentante) distribuidor
                     , dr.data 
                     , dr.valordeposito
                     , dr.nrocomprovante
                     , dr.observacao
                     , ( select count(1)||' - '||listagg(trim(to_char(dd.valor_digitado,'999G999G999G999G990D00'))||'  '||dd.nroidentificacao_digitado,' - ') within group (order by 1)
                         from depositosdiarios_leituraocr dd
                         where dd.iddepositodiario = dr.IDDEPOSITODIARIOS ) fotos         
                from depositosdiarios_orig dr
                where dr.localizado = 'S'
                  and dr.dataidentificado is not null
                  and ( :P333_IDCONTA = 9999 
                      or ( :P333_IDCONTA = 2399 and dr.idcontabanc in (2399,4338) )
                      or ( :P333_IDCONTA = 3822 and dr.idcontabanc = 3822 ) ) 
                  and exists ( select 1
                               from depositosdiarios_leituraocr dlr
                               where dlr.iddepositodiario = dr.iddepositodiarios
                                 and dlr.dataidentificado is not null )
                  and dr.data  between to_date(:P333_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P333_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') 
                order by 1
                ```
        }
