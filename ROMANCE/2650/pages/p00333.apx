    process confirma-depósito-localizado (
        name: Confirma Depósito Localizado
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  viddepositodiario number;
                  vvalor number;
                  --
                begin
                  --
                  update depositosdiarios_leituraocr dr
                  set dr.dataidentificado = sysdate
                    , dr.valoridentificado = dr.valor_digitado
                  where dr.iddepositodiario = :P333_IDDEPOSITODIARIO;
                  --
                  update depositosdiarios_orig do
                  set do.localizado = 'S'
                    , do.dataidentificado = sysdate
                    , do.valoridentificado = do.valordeposito
                  where do.iddepositodiarios = :P333_IDDEPOSITODIARIO;
                  --
                  commit;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Depósito localizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 11876156805365305
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMAR
        }
    )

    process corrige-valor-de-depósito (
        name: Corrige Valor de Depósito
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  viddepositodiario number;
                  vvalor number;
                  --
                begin
                  --
                  select dr.iddepositodiario
                  into viddepositodiario
                  from depositosdiarios_leituraocr dr
                  where dr.idleituraocr_deposito = :P333_IDDEPOSITODIARIO;
                  --
                  update depositosdiarios_leituraocr dr
                  set dr.valor_digitado = :P333_VALORLOCALIZADO
                    , dr.valoridentificado = :P333_VALORLOCALIZADO
                  where dr.idleituraocr_deposito = :P333_IDDEPOSITODIARIO;
                  --
                  commit;
                  --
                  select sum(dr.valor_digitado)
                  into vvalor
                  from depositosdiarios_leituraocr dr
                  where dr.iddepositodiario = viddepositodiario;
                  --
                  execute immediate 'alter table DEPOSITOSDIARIOS_LEITURAOCR disable constraint DK_DEPDIA_OCR_DEPDIA';
                  --
                  pck_financeiro_rmc.prc_alteravalordeposito(piddepositodiario => viddepositodiario,
                                                             pvalordeposito => vvalor,
                                                             ppagina => 333);
                  execute immediate 'alter table DEPOSITOSDIARIOS_LEITURAOCR enable constraint DK_DEPDIA_OCR_DEPDIA';
                  --
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 11863720078239255
        }
        serverSideCondition {
            type: request=Value
            value: CORRIGIR
        }
    )

