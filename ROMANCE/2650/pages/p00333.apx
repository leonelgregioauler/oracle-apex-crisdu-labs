    region não-localizados (
        name: Não Localizados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select dr.iddepositodiarios
                     , pck_romance.fnc_nomerepresentante(dr.idrepresentante) distribuidor
                     , dd.datadeposito data 
                     , dd.valor_digitado  valordeposito
                     , dd.nroidentificacao_digitado nrocomprovante
                     , dr.observacao     
                     , '<a href="javascript:apex.confirm(''Deseja confirmar este depósito como encontrado?'', { request:''CONFIRMAR'', set:{''P333_IDDEPOSITODIARIO'':'||dr.iddepositodiarios||',''P333_VALORLOCALIZADO'':'||dd.valor_digitado||' }} )";><img src="#APP_IMAGES#ok.png"  border="0"></a>' confirmar
                from depositosdiarios_orig dr
                   , depositosdiarios_leituraocr dd
                where dr.localizado = 'E'
                  and dd.iddepositodiario = dr.IDDEPOSITODIARIOS
                  and dd.dataidentificado is null
                  and ( :P333_IDCONTA is null
                      or ( :P333_IDCONTA = 2399 and dr.idcontabanc in (2399,4338) )
                      or ( :P333_IDCONTA = 3822 and dr.idcontabanc = 3822 ) ) 
