page 186 (
    name: Cadastro de Campanha
    title: Cadastro de Campanha
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='Deseja realmente excluir esta campanha?';
            
            function fnc_popup()
            {vid = document.getElementById("P186_IDCAMPANHA").value;
            window.open('f?p=&APP_ID.:189:&SESSION.::NO::P189_IDCAMPANHA:'+vid,'CADMETA', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=600,height=300,left=250,top=100','_blank'); void(0);
            }
            
            function fnc_popup2()
            {vid = document.getElementById("P186_IDCAMPANHA").value;
            window.open('f?p=&APP_ID.:237:&SESSION.::NO::P237_IDCAMPANHA:'+vid,'CADMETA', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1000,height=600,left=50,top=50','_blank'); void(0);
            }
            
            
            function fnc_popup_edita(pid)
            {window.open('f?p=&APP_ID.:189:&SESSION.::NO::P189_IDMETASCAMPANHA:'+pid,'CADMETA', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=600,height=300,left=250,top=100','_blank'); void(0);
            }
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region cadastro-de-campanha (
        name: Cadastro de Campanha
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region metas-cadastradas (
        name: Metas Cadastradas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.idmetascampanha
                     , pck_romance.fnc_nomefilial(pidfilial =>  pck_romance.fnc_filialrepresentante(pidrepresentante => r.idrepresentante) ) "Filial"
                     , pck_romance.fnc_nomerepresentante(pidrepresentante => r.idrepresentante)  "Representante"
                     , r.valormetaroman
                     , r.valormetafavorita
                     , r.valormetageral
                     , r.idrepresentante
                from metascampanha r
                where r.idcampanha = :P186_IDCAMPANHA
                order by 1
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P186_IDCAMPANHA
        }
        link {
            linkColumn: customTarget
            target: {
                page: 189
                items: {
                    P189_IDMETASCAMPANHA: #IDMETASCAMPANHA#
                }
                action: resetPagination
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil2_16x16.gif" alt="">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Dados não encontrados.
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column Filial (
            type: plainText
            heading {
                heading: Filial
