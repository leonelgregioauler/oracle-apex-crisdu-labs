    process fetch-row-from-campanhas (
        name: Fetch Row from CAMPANHAS
        type: autoRowFetch
        source {
            tableName: CAMPANHAS
            pkColumn: IDCAMPANHA
            pkItem: P186_IDCAMPANHA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 504706324054721660
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P186_IDCAMPANHA is null then
                        select "SEQ_IDCAMPANHA".nextval
                          into :P186_IDCAMPANHA
                          from dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 504706500230721663
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-campanhas (
        name: Process Row of CAMPANHAS
        type: autoRowProcessing
        target {
            tableName: CAMPANHAS
            pkColumn: IDCAMPANHA
            pkItem: P186_IDCAMPANHA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        advanced {
            executionMappingIdentifier: 504706712171721663
        }
    )

