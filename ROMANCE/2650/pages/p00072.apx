    region arquivo-s-anexados-em-lançamentos (
        name: Arquivo(s) Anexados em Lançamentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomearquivo
                     , idlancamentodiverso||idanexolancamento||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10) ID
                     --, '<a href="javascript: fnc_verimg('''||iddespesa||idanexodespesa||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10)||''');">Ver arquivo</a>' link
                     , dataanexo data
                     , ( select pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario ) usuario
                     , '<a href="javascript: fnc_removeanexo('||idanexolancamento||','''||t.nomearquivo||''');">Remover</a>' remover
                     , url_bucket LINK
                from anexoslancamentos t
                where idlancamentodiverso = ( select idlancamentodiverso
                                              from lancamentosdiversos ld
                                              where ld.idnotafiscalgerada = :P72_IDNOTAFISCAL )
                order by t.dataanexo
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                from anexoslancamentos t
                where idlancamentodiverso = ( select idlancamentodiverso
                                              from lancamentosdiversos ld
                                              where ld.idnotafiscalgerada = :P72_IDNOTAFISCAL )
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
