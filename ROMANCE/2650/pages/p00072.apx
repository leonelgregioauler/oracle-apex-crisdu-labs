            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    region arquivo-s-anexados (
        name: Arquivo(s) Anexados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDANEXONOTAFISCAL
                     , IDNOTAFISCAL
                   --, ATTACH_DATA
                   --, ATTACH_MIMETYPE
                     , ATTACH_FILENAME
                     , ATTACH_LAST_UPDATE
                   --, ATTACH_CHARSET
                     , round(sys.dbms_lob.getlength(ATTACH_DATA)/1024,2)||' kb' file_length
                     , sys.dbms_lob.getlength(ATTACH_DATA) download
                     , '<a href="javascript: deletaanexo('||IDANEXONOTAFISCAL||')"> Excluir </a>' remover
                     , IDNOTAFISCAL||IDANEXONOTAFISCAL||substr(t.ATTACH_FILENAME,instr(t.ATTACH_FILENAME,'.',-1),10) ID
                     , URL_BUCKET LINK
                  from ANEXOSNOTASFISCAIS t
                where IDNOTAFISCAL = :P72_IDNOTAFISCAL
                union
                select ar.idanexorequisicaopgto
                     , ar.idrequisicaopgto
                   --, ar.arquivotemp
                   --, ATTACH_MIMETYPE
                     , ar.nomearquivo
                     , ar.dataanexo
                   --, null
                     , round(sys.dbms_lob.getlength(ar.arquivotemp)/1024,2)||' kb' file_length
                     , sys.dbms_lob.getlength(ar.arquivotemp) download
                     , '<a href="javascript: deletaanexo('||ar.idanexorequisicaopgto||')"> Excluir </a>' remover
                     , ar.idrequisicaopgto||ar.idanexorequisicaopgto||substr(ar.nomearquivo,instr(ar.nomearquivo,'.',-1),10) ID
                     , URL_BUCKET LINK
                from roman.ANEXOSREQUISICOES ar
                   , roman.requisicoespagamentos rp
                where rp.idrequisicaopgto = ar.idrequisicaopgto
                  and rp.idnotafiscal = :P72_IDNOTAFISCAL
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 53560738957452569
        }

