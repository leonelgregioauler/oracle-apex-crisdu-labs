page 72 (
    name: Anexar Arquivos Notas Fiscais
    title: Anexar Arquivos Notas Fiscais
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function deletaanexo(pid)
            {
            
              var answer = confirm("Confirma exlusão do Anexo?")
              if (answer)
                {
                  document.getElementById('P72_DELETAR').value = pid;
                  apex.submit('DELETAR');
                }
            }
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region anexar-arquivos-notas-fiscais (
        name: Anexar Arquivos Notas Fiscais
