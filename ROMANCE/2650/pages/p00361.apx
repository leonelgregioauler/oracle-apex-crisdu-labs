page 361 (
    name: Matriz de Classificação de Despesas
    title: Matriz de Classificação de Despesas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region matriz-de-classificação-de-despesas (
        name: Matriz de Classificação de Despesas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDMATRIZCLASSIFICACAO,
                       DATAINCLUSAO,
                       CLASSIFICACAODESPESA,
                       IDFILIAL,
                       IDCENTRODECUSTO,
                       IDCONTAFINAN,
                       IDSUBCONTAFINAN,
                       TIPO,
                       REGRA,
                       OBSERVACAO,
                       ATIVO,
                       USUARIO
                from MATRIZCLASSIFICACOESDESPESAS
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        performance {
            lazyLoading: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 15816332384234897
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDMATRIZCLASSIFICACAO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @CLASSIFICACAODESPESA
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDCENTRODECUSTO
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @IDCONTAFINAN
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @IDSUBCONTAFINAN
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @TIPO
                layout {
                    width: 113
                    sequence: 7
                }
            )

            displayColumn (
                column: @REGRA
                layout {
                    width: 166
                    sequence: 8
                }
            )

            displayColumn (
                column: @IDFILIAL
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @OBSERVACAO
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @ATIVO
                layout {
                    width: 98
                    sequence: 10
                }
            )

            displayColumn (
                column: @DATAINCLUSAO
                layout {
                    sequence: 11
                }
            )

            displayColumn (
                column: @USUARIO
                layout {
                    sequence: 12
                }
            )

            sort (
                column: @IDCONTAFINAN
                sort {
                    nulls: last
                    sequence: 1
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column ATIVO (
            type: selectList
            heading {
                heading: Ativo
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC2:Sim;S,Não;N
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 120
            }
            source {
                databaseColumn: ATIVO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column CLASSIFICACAODESPESA (
            type: textarea
            heading {
                heading: Classificação da Despesa
                alignment: center
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 1000
            }
            source {
                databaseColumn: CLASSIFICACAODESPESA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
        )

        column DATAINCLUSAO (
            type: datePickerJquery
            heading {
                heading: Data Inclusão
                alignment: center
            }
            layout {
                sequence: 130
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                databaseColumn: DATAINCLUSAO
                dataType: date
                queryOnly: true
            }
        )

        column IDCENTRODECUSTO (
            type: selectList
            heading {
                heading: Centro de Custo
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nome
                         , idcentrodecusto
                    from centrodecustos c
                    where ativo = 'S'
                    order by 1
                    ```
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                databaseColumn: IDCENTRODECUSTO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDCONTAFINAN (
            type: selectList
            heading {
                heading: Conta Financeira
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nomeconta
                         , idcontafinan
                    from contasfinanceiras c
                    where c.centrodecusto = 'S'
                      and c.debitocredito = 'D'
                    order by 1
                    ```
                displayExtraValues: false
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: IDCONTAFINAN
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDFILIAL (
            type: selectList
            heading {
                heading: Empresa
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nome
                         , idfilial
                    from vw_filiais f
                    where f.ativo = 'S'
                      and f.idunidadedenegocio is not null
                    union
                    select nome
                         , idfilial
                    from vw_filiais f
                    where f.ativo = 'S'
                      and f.idfilial = 1273
                    order by 1
                    ```
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: IDFILIAL
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDMATRIZCLASSIFICACAO (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDMATRIZCLASSIFICACAO
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: SEQ_IDMATRIZCLASSIFICACAO
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDSUBCONTAFINAN (
            type: selectList
            heading {
                heading: Sub Conta Financeira
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nomeconta
                         , idsubcontafinan
                    from subcontasfinanceiras s
                    where s.idcontafinan = :IDCONTAFINAN
                    order by 1
                    ```
                displayExtraValues: false
            }
            cascadingLov {
                parentColumns: :IDCONTAFINAN
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: IDSUBCONTAFINAN
                dataType: number
            }
        )

        column OBSERVACAO (
            type: textarea
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 110
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: OBSERVACAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column REGRA (
            type: selectList
            heading {
                heading: Regra
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC:Custo;C,Despesa;D,Investimento;I,Impostos;X,Não Operacional;N
            }
            layout {
                sequence: 100
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: REGRA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column TIPO (
            type: selectList
            heading {
                heading: Tipo
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC:Fixa;F,Variável;V,Investimento;I,Impostos;X,Não Operacional;N
            }
            layout {
                sequence: 90
            }
            source {
                databaseColumn: TIPO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column USUARIO (
            type: textField
            heading {
                heading: Usuário
                alignment: center
            }
            layout {
                sequence: 140
                columnAlignment: center
            }
            source {
                databaseColumn: USUARIO
                dataType: varchar2
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

    )

    button rastrear-matrizes (
        buttonName: RASTREAR_MATRIZES
        label: Rastrear Matrizes
        layout {
            sequence: 10
            region: @matriz-de-classificação-de-despesas
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 385
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process save-interactive-grid-data (
        name: " - Save Interactive Grid Data"
        type: interactiveGridAutoRowProcessing
        editableRegion: @matriz-de-classificação-de-despesas
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 15822999780234907
        }
    )

)

