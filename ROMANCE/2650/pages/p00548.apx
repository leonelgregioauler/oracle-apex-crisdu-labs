page 548 (
    name: Cadastro Contas Contábeis Integração
    title: Cadastro Contas Contábeis Integração
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region form-on-contascontabeisintegracao (
        name: Form on CONTASCONTABEISINTEGRACAO
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P548_CONTACONTABIL (
        type: numberField
        label {
            label: Conta Contábil
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 30
            region: @form-on-contascontabeisintegracao
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 20
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: CONTACONTABIL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P548_IDCONTACONTABILINTEGRACAO (
        type: hidden
        layout {
            sequence: 10
            region: @form-on-contascontabeisintegracao
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDCONTACONTABILINTEGRACAO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P548_IDCONTAFINAN (
        type: selectList
        label {
            label: Conta Financeira
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select NOMECONTA display_value
                     , IDCONTAFINAN return_value
                from CONTASFINANCEIRAS
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 55
            region: @form-on-contascontabeisintegracao
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P548_IDHISTORICOCONTABIL (
        type: selectList
        label {
            label: Histórico Padrão
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select NOMEHISTORICOCONTABIL display_value
                     , IDHISTORICOCONTABIL return_value
                from HISTORICOSCONTABEIS
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione -
        }
        layout {
            sequence: 50
            region: @form-on-contascontabeisintegracao
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDHISTORICOCONTABIL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P548_IDPLANOCONTASINTEGRACAO (
        type: hidden
        layout {
            sequence: 20
            region: @form-on-contascontabeisintegracao
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDPLANOCONTASINTEGRACAO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P548_IDSUBCONTAFINAN (
        type: popupLov
        label {
            label: Sub Conta Financeira
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select cf.NOMECONTA||' - '||sf.NOMECONTA d
                     , sf.IDSUBCONTAFINAN r
                from SUBCONTASFINANCEIRAS sf
                   , CONTASFINANCEIRAS cf
                where sf.IDCONTAFINAN = cf.IDCONTAFINAN
                  and (:P548_IDCONTAFINAN is null or sf.IDCONTAFINAN = :P548_IDCONTAFINAN)
                order by 1
                ```
            nullDisplayValue: "   "
        }
        cascadingLov {
            parentItems: P548_IDCONTAFINAN
        }
        layout {
            sequence: 60
            region: @form-on-contascontabeisintegracao
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: IDSUBCONTAFINAN
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P548_NOMECONTA (
        type: textField
        label {
            label: Nome Conta
            alignment: left
        }
        layout {
            sequence: 40
            region: @form-on-contascontabeisintegracao
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            type: databaseColumn
            databaseColumn: NOMECONTA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P548_IDCONTACONTABILINTEGRACAO
        }
    )

    button delete (
        buttonName: DELETE
        label: Excluir
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P548_IDCONTACONTABILINTEGRACAO
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P548_IDCONTACONTABILINTEGRACAO
        }
    )

    validation p548-idsubcontafinan (
        name: P548_IDSUBCONTAFINAN
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                  from CONTASCONTABEISINTEGRACAO
                 where IDPLANOCONTASINTEGRACAO = :P548_IDPLANOCONTASINTEGRACAO
                   and IDSUBCONTAFINAN = :P548_IDSUBCONTAFINAN
                ```
        }
        error {
            errorMessage: Esta Sub Conta Financeira já está vinculada a outra conta contábil neste plano.
            associatedItem: @P548_IDSUBCONTAFINAN
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process derive-conta-financeira-from-sub-conta (
        name: Derive Conta Financeira from Sub Conta
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                  if :P548_IDSUBCONTAFINAN is not null then 
                    begin 
                      select IDCONTAFINAN 
                        into :P548_IDCONTAFINAN 
                        from SUBCONTASFINANCEIRAS 
                       where IDSUBCONTAFINAN = :P548_IDSUBCONTAFINAN; 
                    exception 
                      when no_data_found then 
                        :P548_IDCONTAFINAN := null; 
                    end; 
                  end if; 
                end; 
                ```
        }
        execution {
            sequence: 20
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 5480000000000000605
        }
    )

    process fetch-row-from-contascontabeisintegracao (
        name: Fetch Row from CONTASCONTABEISINTEGRACAO
        type: autoRowFetch
        source {
            tableName: CONTASCONTABEISINTEGRACAO
            pkColumn: IDCONTACONTABILINTEGRACAO
            pkItem: P548_IDCONTACONTABILINTEGRACAO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 5480000000000000601
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDCONTACONTABILINTEGRACAO.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P548_IDCONTACONTABILINTEGRACAO := get_pk; 
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Unable to get primary key item value.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 5480000000000000602
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-contascontabeisintegracao (
        name: Process Row of CONTASCONTABEISINTEGRACAO
        type: autoRowProcessing
        target {
            tableName: CONTASCONTABEISINTEGRACAO
            pkColumn: IDCONTACONTABILINTEGRACAO
            pkItem: P548_IDCONTACONTABILINTEGRACAO
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 5480000000000000603
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 5480000000000000604
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 547
            }
            saveStateBeforeBranching: true
        }
    )

)

