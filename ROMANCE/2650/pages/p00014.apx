    validation idcontafinan-must-be-numeric (
        name: IDCONTAFINAN must be numeric
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @sub-contas
            type: columnIsNumeric
            column: IDCONTAFINAN
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ser numérico.
            associatedColumn: IDCONTAFINAN
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation idcontafinan-not-null (
        name: IDCONTAFINAN not null
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @sub-contas
            type: columnIsNotNull
            column: IDCONTAFINAN
        }
        error {
