page 14 (
    name: Cadastro de Contas / Sub Contas
    title: Cadastro de Contas / Sub Contas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region cadastro-de-contas (
        name: Cadastro de Contas
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
    )

    region sub-contas (
        name: Sub Contas
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDSUBCONTAFINAN",
                "IDSUBCONTAFINAN" IDSUBCONTAFINAN_DISPLAY,
                "IDCONTAFINAN",
                "NOMECONTA",
                "OBSERVACAO",
                "DEBITOCREDITO",
                "ATIVO",
                "TIPO",
                "ENTRADASAIDA",
                null regrasreceitas,
                usuario,
                datacriacao,
                "CODIGOVIRTUALAGE",
                "CONTACONTABIL"
                from "#OWNER#"."SUBCONTASFINANCEIRAS"
                where idcontafinan = :P14_IDCONTAFINAN
                ```
        }
        layout {
            sequence: 20
            slot: footer
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 400
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (nulo)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Dados não encontrados.
        }
        componentAdvanced {
            stripHtml: true
        }
        download {
            csvExportEnabled: true
            linkText: Fazer download em CSV
        }

        column ATIVO (
            reportColumnQueryId: 7
            derivedColumn: N
            type: selectList
            heading {
                heading: Ativo
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC:Sim;S,Não;N
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 8
            }
        )

        column CHECK$01 (
            reportColumnQueryId: 14
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: &nbsp;
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column CODIGOVIRTUALAGE (
            reportColumnQueryId: 13
            derivedColumn: N
            type: textField
            heading {
                heading: Cód. Virtual Age
                alignment: center
            }
            layout {
                sequence: 14
            }
            appearance {
                width: 10
            }
            advanced {
                cellWidth: 10
            }
        )

        column CONTACONTABIL (
            reportColumnQueryId: 14
            derivedColumn: N
            type: textField
            heading {
                heading: Conta Contabil
                alignment: center
            }
            layout {
                sequence: 24
                columnAlignment: end
            }
            appearance {
                width: 10
            }
        )

        column DATACRIACAO (
            reportColumnQueryId: 12
            derivedColumn: N
            heading {
                heading: Criado Em
                alignment: center
            }
            layout {
                sequence: 13
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
        )

        column DEBITOCREDITO (
            reportColumnQueryId: 6
            derivedColumn: N
            type: selectList
            heading {
                heading: Débito/Crédito
            }
            lov {
                type: staticValues
                staticValues: STATIC:Débito;D,Crédito;C
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 6
            }
        )

        column ENTRADASAIDA (
            reportColumnQueryId: 9
            derivedColumn: N
            type: selectList
            heading {
                heading: Entrada/Saída
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC:Entrada;E,Saída;S
                displayExtraValues: false
            }
            layout {
                sequence: 10
            }
        )

        column IDCONTAFINAN (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 4
            }
            default {
                type: item
                item: P14_IDCONTAFINAN
            }
        )

        column IDSUBCONTAFINAN (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDSUBCONTACONTABIL
            }
        )

        column IDSUBCONTAFINAN_DISPLAY (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

        column NOMECONTA (
            reportColumnQueryId: 4
            derivedColumn: N
            type: textField
            heading {
                heading: "Sub Conta "
            }
            layout {
                sequence: 5
            }
            appearance {
                width: 25
            }
        )

        column OBSERVACAO (
            reportColumnQueryId: 5
            derivedColumn: N
            type: textField
            heading {
                heading: Observação
            }
            layout {
                sequence: 7
            }
            appearance {
                width: 16
            }
        )

        column REGRASRECEITAS (
            reportColumnQueryId: 10
            derivedColumn: N
            type: link
            heading {
                heading: Regras Receitas Un. Neg.
                alignment: center
            }
            layout {
                sequence: 11
                columnAlignment: center
            }
            link {
                target: {
                    page: 357
                    items: {
                        P357_IDCONTA: #IDCONTAFINAN#
                        P357_IDSUB: #IDSUBCONTAFINAN_DISPLAY#
                    }
                    clearCache: 357
                    action: resetPagination
                }
                linkText: <b>Ver/Adicionar Regra</b>
                linkAttributes: class="t-Button t-Button--sucess"
            }
        )

        column TIPO (
            reportColumnQueryId: 8
            derivedColumn: N
            type: selectList
            heading {
                heading: Tipo
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC:Fixa;F,Variável;V
                displayExtraValues: false
            }
            layout {
                sequence: 9
            }
        )

        column USUARIO (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: Criado por
                alignment: center
            }
            layout {
                sequence: 12
                columnAlignment: center
            }
        )

    )

