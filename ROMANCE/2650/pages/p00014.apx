    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @sub-contas
        target {
            tableName: SUBCONTASFINANCEIRAS
            pkColumn: IDSUBCONTAFINAN
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Linha(s) #MRD_COUNT# deletadas.
        }
        error {
            errorMessage: Não é possível processar a deleção.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 180466134555353486
        }
        serverSideCondition {
            type: request=Value
            value: MULTI_ROW_DELETE
            executeCondition: once
        }
    )

