    button add (
        buttonName: ADD
        label: Adicionar Linha
        layout {
            sequence: 40
            region: @sub-contas
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
