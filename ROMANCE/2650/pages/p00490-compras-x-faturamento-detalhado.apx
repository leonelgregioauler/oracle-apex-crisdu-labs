    dynamicAction atualiza-devolução-ao-fechar (
        name: Atualiza Devolução ao fechar 442
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @devolução
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @devolução
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction atualiza-vendas-ao-fechar (
        name: Atualiza Vendas ao fechar 442
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @vendas
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @vendas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

