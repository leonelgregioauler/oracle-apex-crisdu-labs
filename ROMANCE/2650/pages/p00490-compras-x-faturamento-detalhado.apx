    region despesas (
        name: Despesas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                --11947287 | Gabriel Andriola | 27/01/2026
                --23/10/2026 | Requisicoes pagas (V1 pela data de baixa, V2 pelo movimento no extrato)
                --             via ROMAN.VW_DESPESASREQUISICOESPAGAS - mesma fonte do total da pagina 485
                select 
                    d.iddespesa              as "IdDespesa"
                  , d.datavencimento         as "DataLancamento" -- Na tabela é data vencimento, mas é relativo a data de pagamento da despesas
                  --, d.datalancamento         as "DataLancamento"
                  , d.valor                  as "ValorDespesa"
                  , d.idcontacontabil        as "IdContaContabil"
                  , cf.nomeconta             as "NomeContaContabil"
                  , d.idsubcontacontabil     as "IdSubContaContabil"
                  , scf.nomeconta            as "NomeSubContaContabil"
                  , d.observacao             as "ObservacaoDespesa"
                  , mcd.classificacaodespesa as "ClassificacaoDespesa"
                  , 'Franquia'               as "Origem"
                  , d.datavencimento         as "DataVencimento"
                from roman.despesas d
                left join roman.contasfinanceiras cf             on cf.idcontafinan           = d.idcontacontabil
                left join roman.subcontasfinanceiras scf         on scf.idsubcontafinan       = d.idsubcontacontabil
                                                                and scf.idcontafinan          = d.idcontacontabil
                left join roman.matrizclassificacoesdespesas mcd on mcd.idmatrizclassificacao = d.idmatrizclassificacao
                where d.TEMCNPJ = 'S'
                  and d.idrazaosocialfilial = :P490_IDRAZAOSOCIAL
                  -- Na tabela é data vencimento, mas é relativo a data de pagamento da despesas (intervalo semiaberto: a data pode conter hora)
                  and d.datavencimento >= trunc(to_date(:P490_MESANO,'MM/RRRR'),'MM')
                  and d.datavencimento <  add_months(trunc(to_date(:P490_MESANO,'MM/RRRR'),'MM'),1)
                
                UNION ALL
                
                select
                    r.idrequisicaopgto                     as "IdDespesa"
                  , r.datapagamento                        as "DataLancamento"
                  , r.valorpago                            as "ValorDespesa"
                  , r.idcontafinanceira                    as "IdContaContabil"
                  , cf2.nomeconta                          as "NomeContaContabil"
                  , r.idsubcontafinanceira                 as "IdSubContaContabil"
                  , scf2.nomeconta                         as "NomeSubContaContabil"
                  , r.observacao                           as "ObservacaoDespesa"
                  , 'Requisição'                         as "ClassificacaoDespesa"
                  , 'Requisição '||r.origem             as "Origem"
                  , r.datavencimento                       as "DataVencimento"
                from roman.vw_despesasrequisicoespagas r
                left join roman.contasfinanceiras cf2      on cf2.idcontafinan     = r.idcontafinanceira
                left join roman.subcontasfinanceiras scf2  on scf2.idsubcontafinan = r.idsubcontafinanceira
                                                           and scf2.idcontafinan    = r.idcontafinanceira
                where r.idrazaosocialfilial = :P490_IDRAZAOSOCIAL
                  and r.datapagamento >= trunc(to_date(:P490_MESANO,'MM/RRRR'),'MM')
                  and r.datapagamento <  add_months(trunc(to_date(:P490_MESANO,'MM/RRRR'),'MM'),1)
                
                order by 2, 3
                
                ```
        }
