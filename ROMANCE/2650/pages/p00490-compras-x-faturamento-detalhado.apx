    region compras (
        name: Compras
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nf.dtnf
                     , nf.documento
                     , pck_romance.fnc_nomefornecedor(nf.idfornemitente) fornecedor
                     , pck_romance.fnc_nomefilial(nf.idfilialdestino) destino
                     , rf.cnpj as "CNPJ"
                     , rf.razaosocial as "Razão Social"
                     , es.nome || ' - ' || es.sigla as Estado
                     , sum(vf.valor) vencimentos
                     , nf.datarecebimento
                from roman.notasfiscais        nf
                   , roman.vencimentos         vf
                   , roman.razoessociaisfornec rf
                   , catal.cidades             cd
                   , roman.estados             es
                where vf.idnotafiscal = nf.idnotafiscal
                  and rf.idrazaosocialforn(+) = nf.idrazaosocialfornemit
                  and cd.idcidade(+) = rf.idcidade
                  and es.idestado(+) = cd.idestado
                  and nf.situacao in ('A','R')
                  and nf.tiponota = 'C'
                  and vf.identificado = 'S'
                  and to_char(nf.datarecebimento,'MM/RRRR') = :P490_MESANO
                  and nf.idrazaosocialfildestino = :P490_IDRAZAOSOCIAL
                  and :P490_TIPO = 'C'
                group by nf.dtnf
                       , nf.documento
                       , nf.idfornemitente
                       , nf.idfilialdestino
                       , rf.cnpj
                       , rf.razaosocial
                       , es.nome || ' - ' || es.sigla
                       , nf.datarecebimento
                
                /*
                    Maicon Aimi - 9584880 - 10/03/2025
                        Adicionado as tabelas: roman.razoessociaisfornec, catal.cidades e roman.estados
                */
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: item=value
            item: P490_TIPO
            value: C
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma compra localizada.
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 109802426251996412
        }

