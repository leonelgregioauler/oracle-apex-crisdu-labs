    region devolução (
        name: Devolução
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select n.dataemissao
                     , n.numero
                     , ( select r.razaosocial
                         from crisdu.razoessociais r
                         where r.idrazaosocial =  n.idrazaosocialemitente ) fornecedor
                     , ( select r.cnpj
                         from crisdu.razoessociais r
                         where r.idrazaosocial =  n.idrazaosocialemitente ) as "CNPJ Fornecedor"
                     , ( select e.nome || ' - ' || e.sigla
                         from crisdu.razoessociais r
                            , catal.cidades c
                            , roman.estados e
                         where r.idrazaosocial =  n.idrazaosocialemitente 
                           and c.idcidade = r.idcidade
                           and e.idestado = c.idestado) as "Estado Fornecedor"
                     , ( select r.razaosocial
                         from crisdu.razoessociais r
                         where r.idrazaosocial = n.idrazaosocialdestinatario ) destino
                     , ( select r.cnpj
                         from crisdu.razoessociais r
                         where r.idrazaosocial = n.idrazaosocialdestinatario ) as "CNPJ Destino"
                     , ( select e.nome || ' - ' || e.sigla
                         from crisdu.razoessociais r
                            , catal.cidades c
                            , roman.estados e
                         where r.idrazaosocial =  n.idrazaosocialdestinatario 
                           and c.idcidade = r.idcidade
                           and e.idestado = c.idestado) as "Estado Destino"
                     , (select sum(ii.valortotalbruto)
                        from crisdu.itensnotasfiscais ii
                        where n.idnotafiscal = ii.idnotafiscal
                          and n.idsituacao != -1) total -- não considera notas canceladas
                     , n.idnotafiscal
                     , (select snf.descricao
                        from crisdu.situacoesnotasfiscais snf
                        where n.idsituacao = snf.idsituacaonotafiscal) situacaonotafiscal
                     , n.datacancelamento
                     , n.motivocancelamento
                     , n.idsituacao
                     , case when n.idsituacao = -1 then 'fa-undo u-warning-text' else 'fa-file-ban' end as icone_acao
                     , case when n.idsituacao = -1 then 'Reverter cancelamento' else 'Cancelar nota' end as titulo_acao
                from crisdu.notasfiscais n
                   , crisdu.itensnotasfiscais i
                where i.idnotafiscal = n.idnotafiscal
                  and i.cfop in (1201, 1202, 1411, 2201, 2202)
                  and to_char(n.dataemissao,'MM/RRRR') = :P490_MESANO
                  and n.idpedidofavorita is null
                  and :P490_TIPO = 'D'
                  and exists ( select 1
                               from crisdu.razoessociais r
                                  , roman.razoessociaisfiliais rf
                               where REGEXP_REPLACE(r.cnpj,'[./-]','') = REGEXP_REPLACE(rf.cnpj,'[./-]','')
                                 and rf.idrazaosocialfilial = :P490_IDRAZAOSOCIAL  
                                 and r.idrazaosocial = n.idrazaosocialemitente )
                group by n.dataemissao
                     , n.numero
                     , n.idnotafiscal
                     , n.idsituacao
                     , n.datacancelamento
                     , n.motivocancelamento
                     , n.idrazaosocialemitente
                     , n.idrazaosocialdestinatario
                
                
                
                /*
                    Maicon Aimi - 9584880 - 10/03/2025
                        Adicionado as colunas: "CNPJ Fornecedor", "Estado Fornecedor", "CNPJ Destino" e "Estado Destino"
                */
                ```
        }
