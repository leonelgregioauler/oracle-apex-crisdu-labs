    region impostos (
        name: Impostos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                    d.iddespesa              as "IdDespesa"
                  , d.datalancamento         as "DataLancamento"
                  , d.valor                  as "ValorDespesa"
                  , d.idcontacontabil        as "IdContaContabil"
                  , cf.nomeconta             as "NomeContaContabil"
                  , d.idsubcontacontabil     as "IdSubContaContabil"
                  , scf.nomeconta            as "NomeSubContaContabil"
                  , d.observacao             as "ObservacaoDespesa"
                  , mcd.classificacaodespesa as "ClassificacaoDespesa"
                from roman.despesas d
                left join roman.contasfinanceiras cf             on cf.idcontafinan           = d.idcontacontabil
                left join roman.subcontasfinanceiras scf         on scf.idsubcontafinan       = d.idsubcontacontabil
                                                                and scf.idcontafinan          = d.idcontacontabil
                left join roman.matrizclassificacoesdespesas mcd on mcd.idmatrizclassificacao = d.idmatrizclassificacao
                                                                 and mcd.tipo = 'X'
                                                                 and mcd.regra = 'X'
                where d.idrazaosocialfilial = :P490_IDRAZAOSOCIAL
                  and to_char(d.datalancamento,'MM/RRRR') = :P490_MESANO
                order by d.datalancamento
                       , d.valor
                ```
        }
        layout {
            sequence: 60
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
