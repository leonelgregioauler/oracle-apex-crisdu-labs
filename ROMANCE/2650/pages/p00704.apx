    region detalhamento (
        name: Detalhamento
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select px.idpix
                     , px.idpgtoforn
                     , to_char(coalesce(px.dt_retorno, px.dt_patch, px.dt_post),'DD/MM/RRRR') data
                     , pck_romance.fnc_nomefornecedor(pf.idfornecedor) fornecedor
                     , (select nf.documento from notasfiscais nf
                         where nf.idnotafiscal = pf.idnotafiscal) nrnf
                     , nvl(fp.descricao, '(' || px.forma || ')') forma
                     , px.valor
                     , case px.status
                         when 'PAYED'                then 'Pago'
                         when 'PENDING_CONFIRMATION' then 'Pendente no banco'
                         when 'READY_TO_PAY'         then 'Aguardando autorização'
                         when 'AUTORIZANDO'          then 'Autorizando'
                         when 'AUTHORIZED'           then 'Autorizado'
                         when 'REJECTED'             then 'Rejeitado'
                         when 'ERRO'                 then 'Erro'
                         else px.status
                       end status
                     , decode(px.baixado,'S','Sim','Não') baixado
                     , substr(sc.beneficiario,1,25) conta_pagadora
                     , px.usuario_post enviou
                     , px.usuario_patch autorizou
                  from pix_pagamentos px
                       join pagamentosfornecedores pf on pf.idpgtoforn = px.idpgtoforn
                       left join formaspagamentos fp
                              on fp.idformapagamento = nvl( pf.tipopagamento
                                                          , (select v.tipopagamento from vencimentos v
                                                              where v.idvencimento = pf.idvencimento) )
                       left join santander_contas sc on sc.idcontabanc = px.idcontapagamento
                 where 1 = 1
                   and ( :P704_DE is null
                         or trunc(coalesce(px.dt_retorno, px.dt_patch, px.dt_post)) >= to_date(:P704_DE,'DD/MM/RRRR') )
                   and ( :P704_ATE is null
                         or trunc(coalesce(px.dt_retorno, px.dt_patch, px.dt_post)) <= to_date(:P704_ATE,'DD/MM/RRRR') )
                   and ( :P704_CONTA  is null or px.idcontapagamento = :P704_CONTA )
                   and ( :P704_FORMA  is null or px.forma = :P704_FORMA )
                   and ( :P704_STATUS is null or :P704_STATUS = 'TODOS' or px.status = :P704_STATUS )
                 order by coalesce(px.dt_retorno, px.dt_patch, px.dt_post) desc, px.idpix desc
                ```
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        download {
            csvExportEnabled: true
        }

