page 704 (
    name: Pix Santander - Relatórios
    title: Pix Santander - Relatorios
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @autoriza-pix-operador
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region conciliação-pendências (
        name: Conciliação — pendências
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select px.idpix
                     , px.idpgtoforn
                     , pck_romance.fnc_nomefornecedor(pf.idfornecedor) fornecedor
                     , px.valor
                     , case px.status
                         when 'PAYED'                then 'Pago no banco, sem baixa no ERP'
                         when 'PENDING_CONFIRMATION' then 'Pendente no banco há mais de 1 dia'
                         when 'AUTHORIZED'           then 'Autorizado, sem retorno do banco'
                         when 'AUTORIZANDO'          then 'Autorizando há mais de 1 dia'
                         when 'JA_PAGO_BANCO'        then 'Banco recusou: título já pago'
                         when 'READY_TO_PAY'         then '(!) Fatura baixada e pagamento vivo no banco - risco de duplicidade'
                         else px.status
                       end situacao
                     , to_char(coalesce(px.dt_retorno, px.dt_patch, px.dt_post),'DD/MM/RRRR HH24:MI') desde
                     , substr(sc.beneficiario,1,25) conta_pagadora
                  from pix_pagamentos px
                       join pagamentosfornecedores pf on pf.idpgtoforn = px.idpgtoforn
                       left join santander_contas sc on sc.idcontabanc = px.idcontapagamento
                 where ( ( px.status = 'PAYED' and nvl(px.baixado,'N') = 'N' )
                         or ( px.status in ('PENDING_CONFIRMATION','AUTHORIZED','AUTORIZANDO')
                              and coalesce(px.dt_retorno, px.dt_patch, px.dt_post) < sysdate - 1 )
                         or px.status = 'JA_PAGO_BANCO'
                           -- fatura liquidada por outro canal com o pagamento ainda vivo no
                           -- Santander: basta alguem autorizar para pagar duas vezes
                         or ( px.status = 'READY_TO_PAY' and px.pix_payment_id is not null
                              and pf.databaixa is not null ) )
                   and ( :P704_DE is null
                         or trunc(coalesce(px.dt_retorno, px.dt_patch, px.dt_post)) >= to_date(:P704_DE,'DD/MM/RRRR') )
                   and ( :P704_ATE is null
                         or trunc(coalesce(px.dt_retorno, px.dt_patch, px.dt_post)) <= to_date(:P704_ATE,'DD/MM/RRRR') )
                   and ( :P704_CONTA  is null or px.idcontapagamento = :P704_CONTA )
                   and ( :P704_FORMA  is null or px.forma = :P704_FORMA )
                   and ( :P704_STATUS is null or :P704_STATUS = 'TODOS' or px.status = :P704_STATUS )
                 order by px.valor desc
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--danger
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column CONTA_PAGADORA (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Conta pagadora
                alignment: center
            }
            layout {
                sequence: 7
            }
            sorting {
