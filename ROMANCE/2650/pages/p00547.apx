page 547 (
    name: Lista Contas Contábeis Integração
    title: Lista Contas Contábeis Integração
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }

    region contas-contábeis-de-integração (
        name: Contas Contábeis de Integração
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select cci.IDCONTACONTABILINTEGRACAO,
                       cci.IDPLANOCONTASINTEGRACAO,
                       cci.CONTACONTABIL,
                       cci.NOMECONTA,
                       h.NOMEHISTORICOCONTABIL HISTORICO_PADRAO,
                       cf.NOMECONTA CONTA_FINANCEIRA,
                       sf.NOMECONTA SUB_CONTA_FINANCEIRA
                from CONTASCONTABEISINTEGRACAO cci,
                     HISTORICOSCONTABEIS h,
                     SUBCONTASFINANCEIRAS sf,
                     CONTASFINANCEIRAS cf
                where cci.IDHISTORICOCONTABIL = h.IDHISTORICOCONTABIL
                  and cci.IDSUBCONTAFINAN = sf.IDSUBCONTAFINAN
                  and sf.IDCONTAFINAN = cf.IDCONTAFINAN
                  and cci.IDPLANOCONTASINTEGRACAO = :P547_IDPLANOCONTASINTEGRACAO
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P547_IDPLANOCONTASINTEGRACAO
        }
        link {
            linkColumn: customTarget
            target: {
                page: 548
                items: {
                    P548_IDCONTACONTABILINTEGRACAO: #IDCONTACONTABILINTEGRACAO#
                    P548_IDPLANOCONTASINTEGRACAO: #IDPLANOCONTASINTEGRACAO#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhuma conta contábil cadastrada para este plano.
            whenMoreDataFound: This query returns more than 10,000 rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column CONTACONTABIL (
            type: plainText
            heading {
                heading: Conta Contábil
                alignment: center
            }
            layout {
                sequence: 3
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: CONTACONTABIL
                endUserAlias: C
            }
            enableUsersTo {
                pivot: false
            }
        )

        column CONTA_FINANCEIRA (
            type: plainText
            heading {
                heading: Conta Financeira
                alignment: center
            }
            layout {
                sequence: 6
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: CONTA_FINANCEIRA
                endUserAlias: F
            }
            enableUsersTo {
                pivot: false
            }
        )

        column HISTORICO_PADRAO (
            type: plainText
            heading {
                heading: Histórico Padrão
                alignment: center
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: HISTORICO_PADRAO
                endUserAlias: E
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDCONTACONTABILINTEGRACAO (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDCONTACONTABILINTEGRACAO
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDPLANOCONTASINTEGRACAO (
            type: hidden
            heading {
                heading: Plano
            }
            layout {
                sequence: 2
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDPLANOCONTASINTEGRACAO
                endUserAlias: B
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NOMECONTA (
            type: plainText
            heading {
                heading: Nome Conta
                alignment: center
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: NOMECONTA
                endUserAlias: D
            }
            enableUsersTo {
                pivot: false
            }
        )

        column SUB_CONTA_FINANCEIRA (
            type: plainText
            heading {
                heading: Sub Conta Financeira
                alignment: center
            }
            layout {
                sequence: 7
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: SUB_CONTA_FINANCEIRA
                endUserAlias: G
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 54701 (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn CONTACONTABIL (
                sequence: 3
            )

            displayColumn CONTA_FINANCEIRA (
                sequence: 6
            )

            displayColumn HISTORICO_PADRAO (
                sequence: 5
            )

            displayColumn IDCONTACONTABILINTEGRACAO (
                sequence: 1
            )

            displayColumn IDPLANOCONTASINTEGRACAO (
                sequence: 2
            )

            displayColumn NOMECONTA (
                sequence: 4
            )

            displayColumn SUB_CONTA_FINANCEIRA (
                sequence: 7
            )

        )

    )

    region plano-de-contas-de-integração (
        name: Plano de Contas de Integração
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P547_IDGRUPOFINANCEIRO (
        type: selectList
        label {
            label: Grupo Financeiro (Empresa)
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select GRUPO display_value
                     , IDGRUPOFINANCEIRO return_value
                from GRUPOSFINANCEIROS
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione -
        }
        layout {
            sequence: 10
            region: @plano-de-contas-de-integração
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P547_IDPLANOCONTASINTEGRACAO (
        type: hidden
        layout {
            sequence: 30
            region: @plano-de-contas-de-integração
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P547_SISTEMA (
        type: selectList
        label {
            label: Sistema
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Domínio;DOMINIO
            nullDisplayValue: - Selecione -
        }
        layout {
            sequence: 20
            region: @plano-de-contas-de-integração
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Nova Conta Contábil
        layout {
            sequence: 30
            region: @contas-contábeis-de-integração
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 548
                items: {
                    P548_IDPLANOCONTASINTEGRACAO: &P547_IDPLANOCONTASINTEGRACAO.
                }
                clearCache: 548
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction grupo-financeiro-alterado (
        name: Grupo Financeiro Alterado
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P547_IDGRUPOFINANCEIRO
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: apex.submit();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction sistema-alterado (
        name: Sistema Alterado
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P547_SISTEMA
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: apex.submit();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process resolve-plano-de-contas-de-integração (
        name: Resolve Plano de Contas de Integração
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  l_id PLANOCONTASINTEGRACAO.IDPLANOCONTASINTEGRACAO%type; 
                begin 
                  if :P547_IDGRUPOFINANCEIRO is not null and :P547_SISTEMA is not null then 
                    begin 
                      select IDPLANOCONTASINTEGRACAO 
                        into l_id 
                        from PLANOCONTASINTEGRACAO 
                       where IDGRUPOFINANCEIRO = :P547_IDGRUPOFINANCEIRO 
                         and SISTEMA = :P547_SISTEMA; 
                    exception 
                      when no_data_found then 
                        select SEQ_IDPLANOCONTASINTEGRACAO.nextval into l_id from dual; 
                        insert into PLANOCONTASINTEGRACAO (IDPLANOCONTASINTEGRACAO, IDGRUPOFINANCEIRO, SISTEMA) 
                        values (l_id, :P547_IDGRUPOFINANCEIRO, :P547_SISTEMA); 
                        commit; 
                    end; 
                    :P547_IDPLANOCONTASINTEGRACAO := l_id; 
                  else 
                    :P547_IDPLANOCONTASINTEGRACAO := null; 
                  end if; 
                end; 
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Não foi possível localizar/criar o Plano de Contas de Integração.
        }
        advanced {
            executionMappingIdentifier: 5470000000000000501
        }
    )

)

