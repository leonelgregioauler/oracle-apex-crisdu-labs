    dynamicAction gerente-e-secretaria (
        name: Gerente e Secretaria
        execution {
            sequence: 70
        }
        when {
            selectionType: items
            items: P8_TIPO
        }
        clientSideCondition {
            type: itemIsInList
            item: P8_TIPO
            list: [
                S
                G
            ]
        }
        serverSideCondition {
            type: never
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P8_IDFILIAL
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-set-value (
            action: setValue
            affectedElements {
                selectionType: items
                items: P8_IDFILIAL
            }
            execution {
                sequence: 30
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P8_IDFILIAL
                    P8_USUARIO
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

