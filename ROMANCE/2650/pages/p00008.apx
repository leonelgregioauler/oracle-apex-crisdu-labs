    pageItem P8_IDCIDADE (
        type: popupLov
        label {
            label: Cidade
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nomecidade
                       ||' / '||coalesce(ce.sigla, re.sigla)
                       ||' - '||p.nome  display_value
                     , c.idcidade return_value
                from catal.cidades c
                     left join catal.estados ce on ce.idestado = c.idestado
                     left join roman.estados re on re.idestado = c.idestado
                     left join catal.paises  p  on p.idpais = coalesce(ce.idpais, re.idpais)
                order by 1;
                
                
                ```
            nullDisplayValue: "   "
        }
        layout {
            sequence: 170
            region: @cadastro-de-pessoas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 20
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: IDCIDADE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

