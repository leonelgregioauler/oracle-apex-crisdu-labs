page 8 (
    name: Cadastro de Pessoas
    title: Cadastro de Pessoas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
        executeWhenPageLoads:
            ```javascript-browser
            formatar_mascara_cpf_load();
            formatar_mascara_cnpj_load();
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region cadastro-de-pessoas (
        name: Cadastro de Pessoas
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                <script language="Javascript">
                
                function formatar_mascara_cpf_load()
                {
                 var campo = document.getElementById("P8_CPF");  
                 var texto = document.getElementById("P8_CPF").value;
                 var letra = "."; 
                 posicao = texto.indexOf(letra);
                 if ( posicao < 0 )
                   {
                     var formatado = texto.substring(0,3)+'.'+texto.substring(3,6)+'.'+texto.substring(6,9)+'-'+texto.substring(9,11);
                     campo.value = formatado;
                   }
                }
                function formatar_mascara_cnpj_load()
                {
                 var campo = document.getElementById("P8_CNPJ");  
                 var texto = document.getElementById("P8_CNPJ").value;
                 var letra = "."; 
                 posicao = texto.indexOf(letra);
                 if ( posicao < 0 )
                   {
                     var formatado = texto.substring(0,2)+'.'+texto.substring(2,5)+'.'+texto.substring(5,8)+'/'+texto.substring(8,12)+'-'+texto.substring(12,14);
                     campo.value = formatado;
                   }
                }
                
                function formatar_mascara(src,mascara,evt){
                var tecla;  
                if(evt.which){tecla = evt.which}
                else if(evt.keyCode){ tecla = evt.keyCode;}  
                 if( tecla != 8 ){
                 var campo = src.value.length;
                 var saida = mascara.substring(0,1);
                 var texto = mascara.substring(campo);
                 if(texto.substring(0,1) != saida) {
                 src.value+=texto.substring(0,1);}}
                }
                
                
                function fnc_popup_usuario()
                {  vidfornecedor = document.getElementById("P8_IDUSUARIOCAD").value;
                  vidpessoafornecedor = document.getElementById("P8_IDPESSOA").value;
                  window.open('f?p=&APP_ID.:140:&SESSION.::NO::P140_IDUSUARIO,P140_IDPESSOA:'+vidfornecedor +','+ vidpessoafornecedor ,'page', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1000,height=200,left=250,top=100','_blank'); void(0);
                }
                
                function fnc_popup_mei()
                { vidpessoa = document.getElementById("P8_IDPESSOA").value;
                  vidmei    =  document.getElementById("P8_IDMEI").value;
                  window.open('f?p=&APP_ID.:195:&SESSION.::NO::P195_IDMEI,P195_IDPESSOA:'+vidmei+','+vidpessoa ,'page', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1000,height=400,left=250,top=100','_blank'); void(0);
                }
                </script>
                ```
            footerText:
                ```html
                <script language="Javascript">
                function fnc_popup_filial()
                {vidfilial = document.getElementById("P8_IDFILIALCAD").value;
                vidpessoafilial = document.getElementById("P8_IDPESSOA").value;
                window.open('f?p=&APP_ID.:133:&SESSION.::NO::P133_IDFILIAL,P133_IDPESSOA:'+vidfilial +','+ vidpessoafilial ,'page', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1200,height=800,left=50,top=50','_blank'); void(0);
                }
                function fnc_popup_gerente()
                {vidgerente = document.getElementById("P8_IDGERENTECAD").value;
                vidpessoagerente = document.getElementById("P8_IDPESSOA").value;
                window.open('f?p=&APP_ID.:134:&SESSION.::NO::P134_IDGERENTE,P134_IDPESSOA:'+vidgerente +','+ vidpessoagerente ,'page', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1000,height=200,left=250,top=100','_blank'); void(0);
                }
                function fnc_popup_representante()
                {  vidrepresentante = document.getElementById("P8_IDREPRESENTANTECAD").value;
                  vidpessoarepresentante = document.getElementById("P8_IDPESSOA").value;
                  window.open('f?p=&APP_ID.:135:&SESSION.::NO::P135_IDREPRESENTANTE,P135_IDPESSOA:'+vidrepresentante +','+ vidpessoarepresentante ,'page', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1000,height=150,left=250,top=100','_blank'); void(0);
                }
                function fnc_popup_vendedora()
                {  vidvendedora = document.getElementById("P8_IDVENDEDORACAD").value;
                  vidpessoavendedora = document.getElementById("P8_IDPESSOA").value;
                  window.open('f?p=&APP_ID.:136:&SESSION.::NO::P136_IDVENDEDORA,P136_IDPESSOA:'+vidvendedora +','+ vidpessoavendedora ,'page', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1000,height=200,left=250,top=100','_blank'); void(0);
                }
                function fnc_popup_fornecedor()
                {  vidfornecedor = document.getElementById("P8_IDFORNECEDORCAD").value;
                  vidpessoafornecedor = document.getElementById("P8_IDPESSOA").value;
                  window.open('f?p=&APP_ID.:137:&SESSION.::NO::P137_IDFORNECEDOR,P137_IDPESSOA:'+vidfornecedor +','+ vidpessoafornecedor ,'page', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1200,height=800,left=250,top=100','_blank'); void(0);
                }
                function fnc_popup_secretaria()
                {  vidfuncionario = document.getElementById("P8_IDSECRETARIACAD").value;
                  vidpessoafuncionario = document.getElementById("P8_IDPESSOA").value;
                  window.open('f?p=&APP_ID.:138:&SESSION.::NO::P138_IDSECRETARIA,P138_IDPESSOA:'+vidfuncionario +','+ vidpessoafuncionario ,'page', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1000,height=200,left=250,top=100','_blank'); void(0);
                }
                function fnc_popup_transportadora()
                {  vidfornecedor = document.getElementById("P8_IDTRANSPORTADORACAD").value;
                  vidpessoafornecedor = document.getElementById("P8_IDPESSOA").value;
                  window.open('f?p=&APP_ID.:139:&SESSION.::NO::P139_IDTRANSPORTADORA,P139_IDPESSOA:'+vidfornecedor +','+ vidpessoafornecedor ,'page', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1000,height=200,left=250,top=100','_blank'); void(0);
                }
                function fnc_formatacep(campo, teclapres)
                {  var tecla = teclapres.keyCode;
                  var vr = new String(campo.value);
                  vr = vr.replace("-", "");
                  tam = vr.length + 1;
                  if (tecla != 8)
                  { if (tam == 6)
                    campo.value = vr.substr(0, 5) + '-' + vr.substr(5, 5);  }
                }
                function fnc_telefone(objeto)
                {  if(objeto.value.length == 0)
                     objeto.value = '(' + objeto.value;
                if(objeto.value.length == 3)
                objeto.value = objeto.value + ')';
                
                if(objeto.value.length == 8)
                objeto.value = objeto.value + '-';}
                </script>
                ```
        }
    )

    region telefones (
        name: Telefones
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDTELEFONEPESSOA",
                "IDTELEFONEPESSOA" IDTELEFONEPESSOA_DISPLAY,
                "IDPESSOA",
                "IDOPERADORATEL",
                "TELEFONE"
                from "CATAL"."TELEFONESPESSOAS"
                where idpessoa = :P8_IDPESSOA
                
                ```
        }
        layout {
            sequence: 30
            slot: body-3
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: Informe somente os números! (Ex.: 5198765432)
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P8_IDPESSOA
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 1
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column IDOPERADORATEL (
            reportColumnQueryId: 5
            derivedColumn: N
            type: selectList
            heading {
                heading: Operadora
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nome||' - ('||DDD||')' display_value
                         , idoperadoratel return_value
                    from operadorastelefonia
                    order by nome
                    ```
                nullDisplayValue: - Operadora -
            }
            layout {
                sequence: 5
            }
        )

        column IDPESSOA (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 4
            }
            default {
                type: item
                item: P8_IDPESSOA
            }
        )

        column IDTELEFONEPESSOA (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDTELEFONESPESSOA
            }
        )

        column IDTELEFONEPESSOA_DISPLAY (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

        column TELEFONE (
            reportColumnQueryId: 6
            derivedColumn: N
            type: textField
            heading {
                heading: Telefone
                alignment: center
            }
            layout {
                sequence: 6
            }
            appearance {
                width: 16
            }
        )

    )

