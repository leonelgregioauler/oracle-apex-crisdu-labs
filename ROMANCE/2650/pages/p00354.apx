page 354 (
    name: Matriz de Regras de Despesas
    title: Matriz de Regras de Despesas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region gerar-matrizes-automaticamente (
        name: Gerar Matrizes Automaticamente
        type: staticContent
        layout {
            sequence: 10
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-size600x400
            ]
        }
        advanced {
            htmlDomId: AUTOMATICO
            regionDisplaySelector: true
        }
    )

    region matriz-de-regras-de-despesas (
        name: Matriz de Regras de Despesas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDMATRIZREGRA,
                       DATAINCLUSAO,
                       IDFORNECEDOR,
                       IDFILIAL,
                       IDCENTRODECUSTO,
                       IDCONTAFINAN,
                       IDSUBCONTAFINAN,
                       TIPO,
                       TIPOREGRA,
                       GERARDESPESA,
                       OBSERVACAO,
                       ATIVO,
                       USUARIO
                from MATRIZREGRASDESPESAS
                where (:P354_IDFORNECEDOR_F is null or IDFORNECEDOR = :P354_IDFORNECEDOR_F)
                  and (:P354_IDFILIAL_F is null or IDFILIAL = :P354_IDFILIAL_F)
                  and (:P354_IDCENTRODECUSTO_F is null or IDCENTRODECUSTO = :P354_IDCENTRODECUSTO_F)
                  and (:P354_IDCONTA_F is null or IDCONTAFINAN = :P354_IDCONTA_F)
                  and (:P354_IDSUBCONTA_F is null or IDSUBCONTAFINAN = :P354_IDSUBCONTA_F)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
            sendAsEmail: false
        }
        componentAdvanced {
            oracleTextIndexColumn: IDCONTAFINAN
        }
        advanced {
            savedReportMappingIdentifier: 12493552479807062
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDMATRIZREGRA
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDFORNECEDOR
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDFILIAL
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @IDCENTRODECUSTO
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @IDCONTAFINAN
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @IDSUBCONTAFINAN
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @TIPO
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @TIPOREGRA
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @OBSERVACAO
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @ATIVO
                layout {
                    width: 119
                    sequence: 11
                }
            )

            displayColumn (
                column: @DATAINCLUSAO
                layout {
                    sequence: 12
                }
            )

            displayColumn (
                column: @USUARIO
                layout {
                    sequence: 13
                }
            )

            displayColumn (
                column: @GERARDESPESA
                layout {
                    sequence: 10
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column ATIVO (
            type: selectList
            heading {
                heading: Ativo
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC2:Sim;S,Não;N
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 110
            }
            source {
                databaseColumn: ATIVO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column DATAINCLUSAO (
            type: datePickerJquery
            heading {
                heading: Data Inclusão
                alignment: center
            }
            layout {
                sequence: 140
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
                width: 15
            }
            source {
                databaseColumn: DATAINCLUSAO
                dataType: date
                queryOnly: true
            }
        )

        column GERARDESPESA (
            type: selectList
            heading {
                heading: Gerar Despesa?
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC2:Sim;S,Não;N
            }
            layout {
                sequence: 120
            }
            source {
                databaseColumn: GERARDESPESA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDCENTRODECUSTO (
            type: selectList
            heading {
                heading: Centro de Custo
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select /*'Tipo : '||c.tipo||' - '||*/c.nome d
                         , c.idcentrodecusto r
                    from centrodecustos c
                    where ativo = 'S'
                    /*where exists ( select 1
                                   from rateioscentroscustos r
                                   where r.idcentrodecusto = c.idcentrodecusto
                                     and r.idunidadedenegocio in ( select f.idunidadedenegocio
                                                                   from filiais f
                                                                   where f.idfilial = :IDFILIAL ) )*/
                    order by 1
                    ```
                displayExtraValues: false
            }
            layout {
                sequence: 60
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDCENTRODECUSTO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column IDCONTAFINAN (
            type: selectList
            heading {
                heading: Conta
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select c.nomeconta
                         , c.idcontafinan
                    from contasfinanceiras c
                    where ativo = 'S'
                      and centrodecusto = 'S'
                      and debitocredito = 'D'
                      /*and ( :IDCENTRODECUSTO is null 
                         or ( exists ( select 1
                                       from centrodecustos cc
                                       where cc.idcentrodecusto = :IDCENTRODECUSTO
                                         and cc.tipo            = 3 ) 
                              and c.tipooperacional = 'N' )
                         or ( exists ( select 1
                                       from centrodecustos cc
                                       where cc.idcentrodecusto = :IDCENTRODECUSTO
                                         and cc.tipo           != 3 ) 
                              and c.tipooperacional = 'O' ) )*/
                    order by 1;
                    ```
                displayExtraValues: false
            }
            layout {
                sequence: 70
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDCONTAFINAN
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column IDFILIAL (
            type: selectList
            heading {
                heading: Empresa
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nome
                         , f.idfilial
                    from vw_filiais f
                    where f.ativo = 'S'
                      and exists ( select 1
                                   from unidadesdenegocios u
                                   where u.idunidadedenegocio = f.idunidadedenegocio
                                     and u.ativo = 'S' )
                    union
                    select nome
                         , f.idfilial
                    from vw_filiais f
                    where f.ativo = 'S'
                      and idfilial in (1233,1231,1186,1232,1235,1250,1294,1308,1344) -- 1308 e 1344 add no t15869321
                    order by 1
                    ```
                displayExtraValues: false
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDFILIAL
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column IDFORNECEDOR (
            type: selectList
            heading {
                heading: Fornecedor
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(p.nomepessoa) display_value
                         , f.idfornecedor return_value 
                    from fornecedores f
                       , pessoas p
                    where f.idpessoa = p.idpessoa
                      and f.ativo = 'S'
                    order by 1
                    ```
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDFORNECEDOR
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDMATRIZREGRA (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDMATRIZREGRA
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: SEQ_IDMATRIZREGRA
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDSUBCONTAFINAN (
            type: selectList
            heading {
                heading: Sub Conta
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select s.nomeconta
                         , s.idsubcontafinan
                    from subcontasfinanceiras s
                    where s.idcontafinan = :IDCONTAFINAN
                      --and s.ativo = 'S'
                    order by 1
                    ```
            }
            cascadingLov {
                parentColumns: IDCONTAFINAN
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: IDSUBCONTAFINAN
                dataType: number
            }
        )

        column OBSERVACAO (
            type: textarea
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 130
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: OBSERVACAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column TIPO (
            type: selectList
            heading {
                heading: Tipo
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC:Fixa;F,Variável;V,Investimento;I,Impostos;X,Não Operacional;N
            }
            layout {
                sequence: 90
            }
            source {
                databaseColumn: TIPO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column TIPOREGRA (
            type: selectList
            heading {
                heading: Regra
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC:Custo;C,Despesa;D,Investimento;I,Impostos;X,Não Operacional;N
                displayExtraValues: false
            }
            layout {
                sequence: 100
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: TIPOREGRA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column USUARIO (
            type: textField
            heading {
                heading: Incluído Por
                alignment: center
            }
            layout {
                sequence: 150
                columnAlignment: center
            }
            validation {
                maxLength: 50
            }
            source {
                databaseColumn: USUARIO
                dataType: varchar2
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

    )

    pageItem P354_GERAR_PARA (
        type: selectList
        label {
            label: Gerar para Grupo
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select descricao
                     , idtipofilial
                from tiposfiliais
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione o Tipo -
        }
        layout {
            sequence: 20
            region: @gerar-matrizes-automaticamente
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P354_IDCENTRODECUSTO_F (
        type: selectList
        label {
            label: Centro de Custo
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select /*'Tipo : '||c.tipo||' - '||*/c.nome d
                     , c.idcentrodecusto r
                from centrodecustos c
                where ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P354_IDCONTA_F (
        type: selectList
        label {
            label: Conta
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nomeconta
                     , c.idcontafinan
                from contasfinanceiras c
                where ativo = 'S'
                  and centrodecusto = 'S'
                  and debitocredito = 'D'
                order by 1;
                ```
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P354_IDFILIAL_F (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.ativo = 'S'
                order by 1
                
                ```
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P354_IDFORNECEDOR (
        type: popupLov
        label {
            label: Fornecedor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefornecedor(f.idfornecedor) fornecedor
                     , f.idfornecedor
                from fornecedores f
                where f.ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @gerar-matrizes-automaticamente
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P354_IDFORNECEDOR_F (
        type: selectList
        label {
            label: Fornecedor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) display_value
                     , f.idfornecedor return_value 
                from fornecedores f
                   , pessoas p
                where f.idpessoa = p.idpessoa
                  and f.ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P354_IDSUBCONTA_F (
        type: selectList
        label {
            label: Sub Conta
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.nomeconta
                     , s.idsubcontafinan
                from subcontasfinanceiras s
                where ( :P354_IDCONTA_F is null or s.idcontafinan = :P354_IDCONTA_F )
                  --and s.ativo = 'S'
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P354_IDCONTA_F
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtar (
        buttonName: FILTAR
        label: Filtar
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button gerar-automatico (
        buttonName: GERAR_AUTOMATICO
        label: Gerar Matriz Auto.
        layout {
            sequence: 10
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: openModal('AUTOMATICO');
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button gerar-matrizes (
        buttonName: GERAR_MATRIZES
        label: Gerar Matrizes
        layout {
            sequence: 10
            region: @gerar-matrizes-automaticamente
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button rastrear-matrizes (
        buttonName: RASTREAR_MATRIZES
        label: Rastrear Matriz
        layout {
            sequence: 20
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 368
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction atualiza-pagina (
        name: Atualiza Pagina
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P354_IDFORNECEDOR_PESQUISA
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @matriz-de-regras-de-despesas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process gera-matrizes-automaticamente (
        name: Gera Matrizes Automaticamente
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_cadastros_rmc.prc_geramatrizdespesaforn(pidfornecedor => :P354_IDFORNECEDOR,
                                                              ptipofilial => :P354_GERAR_PARA );
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Matrizes geradas com sucesso!
        }
        advanced {
            executionMappingIdentifier: 12667918152985913
        }
        serverSideCondition {
            type: request=Value
            value: GERAR_MATRIZES
        }
    )

    process save-interactive-grid-data (
        name: " - Save Interactive Grid Data"
        type: interactiveGridAutoRowProcessing
        editableRegion: @matriz-de-regras-de-despesas
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 12500104777807069
        }
    )

    branch (
        name: Go To Page 354
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 354
                items: {
                    P354_IDFORNECEDOR:
                    P354_GERAR_PARA:
                }
                clearCache: 354
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: GERAR_MATRIZES
        }
    )

    branch (
        name: Go To Page 354
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 354
                items: {
                    P354_IDFORNECEDOR_F: &P354_IDFORNECEDOR_F.
                    P354_IDCENTRODECUSTO_F: &P354_IDCENTRODECUSTO_F.
                    P354_IDCONTA_F: &P354_IDCONTA_F.
                    P354_IDSUBCONTA_F: &P354_IDSUBCONTA_F.
                    P354_IDFILIAL_F: &P354_IDFILIAL_F.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtar
        }
    )

)

