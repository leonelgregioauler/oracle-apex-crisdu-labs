page 521 (
    name: SubContas Classif
    alias: SUBCONTAS_CLASSIF
    title: Sub-Contas Classificação
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 50%
        resizable: false
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            document.getElementById("P521_FILTRO").addEventListener("keydown", function(event) {
                if (event.key === "Enter") {
                    event.preventDefault(); // Evita o submit padrão
                    apex.item("FILTROSUBCONTAS").click(); // Dispara o clique no botão
                }
            });
            ```
    }
    css {
        inline:
            ```css
            .t-Dialog-bodyWrapperIn {
                background: rgb(239, 232, 232);
            }
            ```
    }

    region subcontasclassificacoes (
        name: Subcontasclassificacoes
        type: form
        source {
            location: localDatabase
            tableName: SUBCONTASCLASSIFICACOES
            whereClause: idsubcontaclassificacao = :P521_IDSUBCONTACLASSIFICACAO
        }
        layout {
            sequence: 30
            slot: contentBody
            columnCssClasses: background="aliceblue"
        }
        readOnly {
            type: item=value
            item: P521_TIPOCONTA
            value: S
        }
    )

    pageItem P521_CLASSIFICACAO (
        type: displayOnly
        label {
            label: Classificação
            alignment: left
        }
        layout {
            sequence: 50
            region: @subcontasclassificacoes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @subcontasclassificacoes
            column: IDCLASSIFICACAO
            dataType: number
        }
    )

    pageItem P521_FILTRO (
        type: textField
        label {
            label: Filtro Subcontas
            alignment: left
        }
        layout {
            sequence: 70
            region: @subcontasclassificacoes
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: --Todos--
        }
    )

    pageItem P521_IDCLASSIFICACAO (
        type: hidden
        layout {
            sequence: 20
            region: @subcontasclassificacoes
            slot: regionBody
        }
        source {
            formRegion: @subcontasclassificacoes
            column: IDCLASSIFICACAO
            dataType: number
        }
    )

    pageItem P521_IDSUBCONTACLASSIFICACAO (
        type: hidden
        layout {
            sequence: 10
            region: @subcontasclassificacoes
            slot: regionBody
        }
        source {
            formRegion: @subcontasclassificacoes
            column: IDSUBCONTACLASSIFICACAO
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P521_IDSUBCONTAFINAN (
        type: shuttle
        label {
            label: Subcontas Financeiras
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomeconta || ' - ' || debitocredito
                     , idsubcontafinan
                  from subcontasfinanceiras s
                 where exists (select 1
                                 from subcontasclassificacoes
                                where idclassificacao = :P521_IDCLASSIFICACAO
                                  and idsubcontafinan = s.idsubcontafinan)
                ---------
                UNION ALL
                ---------
                select nomeconta || ' - ' || debitocredito
                     , idsubcontafinan
                  from subcontasfinanceiras s
                 where ativo = 'S'
                   and debitocredito = :P521_TIPOLANCTO
                   and contabiliza = 'S'
                   and s.idsubcontafinan not in (select idsubcontafinan
                                                   from subcontasclassificacoes
                                                  where idclassificacao != :P521_IDCLASSIFICACAO)
                   and (:P521_FILTRO is null or lower(nomeconta) like '%'||lower(:P521_FILTRO)||'%' )
                 order by 1
                 
                ```
        }
        layout {
            sequence: 120
            region: @subcontasclassificacoes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 5
        }
        source {
            type: databaseColumn
            databaseColumn: IDSUBCONTAFINAN
            used: always
        }
        default {
            type: sqlQueryMultipleValues
            sqlQueryMultipleValues:
                ```sql
                SELECT idsubcontafinan --LISTAGG(idsubcontafinan, ':') WITHIN GROUP (ORDER BY idsubcontafinan)
                  FROM subcontasclassificacoes
                 WHERE idclassificacao = :P521_IDCLASSIFICACAO;
                ```
        }
    )

    pageItem P521_TIPOCLASSIFICACAO (
        type: radioGroup
        label {
            label: Tipo Class.:
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC:Provisão;P,Contábil;C
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @subcontasclassificacoes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @subcontasclassificacoes
            column: TIPOCLASSIFICACAO
            dataType: varchar2
        }
    )

    pageItem P521_TIPOCONTA (
        type: hidden
        layout {
            sequence: 40
            region: @subcontasclassificacoes
            slot: regionBody
        }
    )

    pageItem P521_TIPOLANCTO (
        type: hidden
        layout {
            sequence: 30
            region: @subcontasclassificacoes
            slot: regionBody
        }
    )

    button filtrosubcontas (
        buttonName: FILTROSUBCONTAS
        label: Pesquisar
        layout {
            sequence: 90
            region: @subcontasclassificacoes
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        advanced {
            htmlDomId: FILTROSUBCONTAS
        }
    )

    button salvar (
        buttonName: SALVAR
        label: Salvar
        layout {
            sequence: 150
            region: @subcontasclassificacoes
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Fechar
        layout {
            sequence: 160
            region: @subcontasclassificacoes
            slot: regionBody
            startNewRow: false
            column: 2
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction fechar (
        name: Fechar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @voltar
        }

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @filtrosubcontas
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction salva (
        name: Salva
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @salvar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: SALVAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-form-subcontas-classif (
        name: Initialize form SubContas Classif
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  --
                  l_valores    varchar2(4000);
                  l_tipoclass  varchar2(1);
                  --
                  v_nomecol varchar2(50) := 'COL_SUBCONTASFINAN';
                  --
                  v_select varchar2(4000);
                  v_query  varchar2(4000);
                BEGIN
                  --
                  begin
                    select classificacao ||' - '|| descricaoconta 
                       into :P521_CLASSIFICACAO
                      from planocontasgeral
                     where idclassificacao = :P521_IDCLASSIFICACAO;
                  exception
                    when others then null;
                  end;
                  --
                  /*execute immediate ('truncate table tmp_teste');
                  --
                  insert into tmp_teste (idconta, descricao)
                  select idsubcontafinan, nomeconta || ' - ' || debitocredito
                    from subcontasfinanceiras s
                   where ativo = 'S'
                     and contabiliza = 'S'
                     and debitocredito = :P521_TIPOLANCTO
                     and s.idsubcontafinan not in (select idsubcontafinan
                                                     from subcontasclassificacoes
                                                    where idclassificacao != :P521_IDCLASSIFICACAO);*/
                  --
                
                  begin
                    --
                    SELECT LISTAGG(idsubcontafinan, ':') WITHIN GROUP (ORDER BY idsubcontafinan)
                         , tipoclassificacao
                      INTO l_valores
                         , l_tipoclass
                      FROM subcontasclassificacoes
                     WHERE idclassificacao = :P521_IDCLASSIFICACAO
                     group by tipoclassificacao;
                    --
                    :P521_IDSUBCONTAFINAN   := l_valores;
                    :P521_TIPOCLASSIFICACAO := l_tipoclass;
                    --
                    --
                  exception
                    when no_data_found then null;
                  end;
                
                
                /*
                  --
                  if apex_collection.collection_exists ( v_nomecol ) then
                    --
                    apex_collection.delete_collection ( v_nomecol );
                    --
                  end if;
                  --
                    v_query := ' select nomeconta || '''||'-'||''' || debitocredito, idsubcontafinan ' ||
                               ' from subcontasfinanceiras where ativo = ''S'' ' ||
                               ' and debitocredito = '''||:P521_TIPOLANCTO || '''';
                    
                  apex_collection.create_collection_from_query ( p_collection_name => v_nomecol,
                                                                 p_query           => v_query ); */
                  
                
                  /*v_select :=  'select C001 nome, C002 id
                                  from apex_collections c
                                 where collection_name = ' || '''' || v_nomecol || '''' ||
                               ' and exists (select 1
                                               from subcontasclassificacoes
                                              where idclassificacao = :P521_IDCLASSIFICACAO
                                                and idsubcontafinan = c.C002) ' ||
                               ' UNION ALL ' ||
                               'select C001 nome, C002 id
                                  from apex_collections c
                                 where collection_name = '  || '''' || v_nomecol || '''' ||
                               ' and c.C002 not in (select idsubcontafinan
                                                                 from subcontasclassificacoes
                                                                where idclassificacao != :P521_IDCLASSIFICACAO)' ; */
                
                
                  --
                  
                END;
                
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 1074950966673479338
        }
    )

    process salvardados (
        name: SalvarDados
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  v_idsubcontaclassif number;
                  v_idclassificacao   number := :P521_IDCLASSIFICACAO;
                  v_idsubcontafinan   number;
                  v_tipoclassif       varchar2(1) := :P521_TIPOCLASSIFICACAO;
                  v_numnull           number;
                  v_md5               varchar2(1000);
                  --
                begin
                  --
                  -- Exclui toda a configuração da classificacao e depois inclui os selecionados
                  begin
                    delete from subcontasclassificacoes
                     where idclassificacao = :P521_IDCLASSIFICACAO;
                  exception
                    when others then null;
                  end;
                  --
                  FOR r IN ( SELECT column_value AS idsubcontafinan
                               FROM TABLE(apex_string.split(:P521_IDSUBCONTAFINAN, ':')) )
                  LOOP
                    --
                    select seq_idsubcontaclassificacao.nextval
                      into v_idsubcontaclassif 
                      from dual;
                    --
                    v_idsubcontafinan := r.idsubcontafinan;
                
                    pck_contabilidade_rmc.prc_subcontasclassif(pidsubcontaclassificacao => v_idsubcontaclassif,
                                                               pidsubcontafinan         => v_idsubcontafinan,
                                                               pidsubclassificacao      => v_numnull,
                                                               pidclassificacao         => v_idclassificacao,
                                                               ptipoclassificacao       => v_tipoclassif,
                                                               pmd5                     => v_md5,
                                                               poperacao_dml            => 'I');
                    --
                  END LOOP;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Dados salvos com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1074951764346479346
        }
        serverSideCondition {
            whenButtonPressed: @salvar
        }
    )

    branch (
        name: Volta_521_Filtro
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 521
                items: {
                    P521_IDCLASSIFICACAO: &P521_IDCLASSIFICACAO.
                    P521_TIPOCLASSIFICACAO: &P521_TIPOCLASSIFICACAO.
                    P521_FILTRO: &P521_FILTRO.
                }
            }
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: FILTRAR
        }
    )

    branch (
        name: Volta_521
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 521
                items: {
                    P521_IDCLASSIFICACAO: &P521_IDCLASSIFICACAO.
                    P521_TIPOCLASSIFICACAO: &P521_TIPOCLASSIFICACAO.
                    P521_FILTRO: &P521_FILTRO.
                }
            }
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SALVAR
        }
    )

)

