page 41 (
    name: Depósitos Diarios
    title: Depósitos Diarios
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region efetuar-depósito (
        name: Efetuar depósito
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDDEPOSITODIARIOS",
                "IDDEPOSITODIARIOS" IDDEPOSITODIARIOS_DISPLAY,
                "DATA",
                "IDREPRESENTANTE",
                "IDCONTABANC",
                "IDPGTOFORN",
                "VALORDEPOSITO",
                "COMPROVADO",
                "NROCOMPROVANTE",
                "OBSERVACAO",
                "TIPO"
                from "#OWNER#"."DEPOSITOSDIARIOS"
                WHERE idpgtoforn  = :P41_IDPGTOFORN
                ```
        }
        layout {
            sequence: 15
            slot: body-3
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        reportLayout {
            numberOfRows: 40
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (nulo)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Dados não encontrados.
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 1
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: &nbsp;
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column COMPROVADO (
            reportColumnQueryId: 9
            derivedColumn: N
            type: selectList
            heading {
                heading: Comprovado
            }
            lov {
                type: staticValues
                staticValues: STATIC2:Sem Comprovante;S,Cópia;C,Em Mãos;M
                displayNullValue: false
            }
            layout {
                sequence: 9
            }
        )

        column DATA (
            reportColumnQueryId: 4
            derivedColumn: N
            type: datePicker
            heading {
                heading: Data
            }
            layout {
                sequence: 4
            }
            appearance {
                width: 11
            }
            default {
                type: plsqlExpression
                plsqlExpression: SYSDATE
            }
        )

        column IDCONTABANC (
            reportColumnQueryId: 6
            derivedColumn: N
            type: selectList
            heading {
                heading: Conta Banc
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(nvl(cb.beneficiario,p.apelido)||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||')' display_value
                         , cb.idcontabanc    return_value
                    from contasbancarias cb
                       , bancos b
                       , pessoas p
                       , fornecedores f
                    where cb.idbanco      = b.idbanco
                      and cb.idfornecedor = f.idfornecedor
                      and f.idpessoa      = p.idpessoa
                      and cb.idfornecedor = (select idfornecedor from pagamentosfornecedores where idpgtoforn = :P41_IDPGTOFORN)
                    ```
                displayNullValue: false
            }
            layout {
                sequence: 6
            }
        )

        column IDDEPOSITODIARIOS (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDDEPOSITODIARIOS
            }
        )

        column IDDEPOSITODIARIOS_DISPLAY (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

        column IDPGTOFORN (
            reportColumnQueryId: 7
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 7
            }
            default {
                type: item
                item: P41_IDPGTOFORN
            }
        )

        column IDREPRESENTANTE (
            reportColumnQueryId: 5
            derivedColumn: N
            type: selectList
            heading {
                heading: Representante
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(nvl(p.apelido,p.nomepessoa)||' ('|| pf.apelido ||')') display_value
                         , r.idrepresentante return_value 
                      from representantes r
                         , pessoas        p
                         , filiais        ff
                         , pessoas        pf
                      where r.idpessoa = p.idpessoa
                        and r.idfilial = ff.idfilial
                        and ff.idpessoa = pf.idpessoa
                    order by 1
                    ```
                displayNullValue: false
            }
            layout {
                sequence: 5
            }
        )

        column NROCOMPROVANTE (
            reportColumnQueryId: 10
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
