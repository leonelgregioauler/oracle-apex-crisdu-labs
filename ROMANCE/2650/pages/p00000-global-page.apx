    pageItem P0_IDFILIALCAIXA (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select (select initcap(nvl(apelido,nomepessoa))
                        from pessoas 
                        where idpessoa = f.idpessoa )|| CASE when v('APP_USER') in ('EVERTON','GUILHERME','LEONELG','OSIELF','BRUNOB','DIEGOPIECHO') then
                                                                    ' - '||f.idfilial
                                                                    end display_value
                     , f.idfilial
                from filiais f
                where f.tipofilial not in ('D','L')
                  and f.ativo = 'S'
                  and f.idfilial != 1273
                  and exists ( select 1
                               from usuariosfiliais u
                               where u.idfilial  = f.idfilial
                                 and u.usuario   = v('APP_USER') )
                
                
                union -- union #1
                
                -- busca filial do gerente do usuário conectado
                select (select initcap(nvl(apelido,nomepessoa))
                        from pessoas 
                        where idpessoa = f.idpessoa )|| CASE when v('APP_USER') in ('EVERTON','GUILHERME','LEONELG','OSIELF','BRUNOB','DIEGOPIECHO') then
                                                                    ' - '||f.idfilial
                                                                    end display_value
                     , f.idfilial
                from filiais f
                where idfilial = pck_romance.fnc_filialusuario(v('APP_USER'))
                
                
                union -- union #2
                
                
                select (select initcap(nvl(apelido,nomepessoa))
                        from pessoas 
                        where idpessoa = f.idpessoa )|| CASE when v('APP_USER') in ('EVERTON','GUILHERME','LEONELG','OSIELF','BRUNOB','DIEGOPIECHO') then
                                                                    ' - '||f.idfilial
                                                                    end display_value
                     , f.idfilial
                from filiais f
                where f.tipofilial not in ('D','L')
                  and f.ativo = 'S'
                  and f.idfilial = 1273
                  and exists ( select 1
                               from usuariosfiliais u
                               where u.idfilial  = f.idfilial
                                 and u.usuario   = v('APP_USER') )
                --
                UNION
                select (select initcap(nvl(apelido,nomepessoa))
                        from pessoas 
                        where idpessoa = f.idpessoa )|| CASE when v('APP_USER') in ('EVERTON','GUILHERME','LEONELG','OSIELF','BRUNOB','DIEGOPIECHO') then
                                                                    ' - '||f.idfilial
                                                                    end display_value
                     , f.idfilial
                from filiais f
                where f.ativo = 'S'
                  and v('APP_USER') = 'DIEGOPIECHO'
                --
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select f.idfilial
                from filiais f
                where f.tipofilial != 'D'
                  AND F.ATIVO = 'S'
                  and f.idfilial  = pck_romance.fnc_filialusuario(v('APP_USER') )
                ```
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin 
                  return null;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

