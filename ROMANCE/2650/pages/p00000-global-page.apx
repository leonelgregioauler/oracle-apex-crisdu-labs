    dynamicAction notificationlist (
        name: NotificationList
        execution {
            sequence: 40
        }
        when {
            event: ready
        }

        action plugin-apex-notification (
            action: plugin/apexNotificationMenu
            settings {
                sqlSource:
                    ```sql
                    SELECT NOTE_ICON        AS  NOTE_ICON
                         , NOTE_ICON_COLOR  AS  NOTE_ICON_COLOR
                         , NOTE_HEADER      AS  NOTE_HEADER
                         , NOTE_TEXT        AS  NOTE_TEXT
                         , NOTE_LINK        AS  NOTE_LINK
                         , NOTE_COLOR       AS  NOTE_COLOR
                    FROM ( select t.idnotificacaointerna
                                      , case
                                          when t.type = 'SUCCESS' then-- t.tiponotificacao = 'P' then
                                            'fa-commenting'
                                          when t.type = 'WARNING' then --t.tiponotificacao = 'G' then
                                            'fa-exclamation-triangle'
                                          when t.type = 'DANGER' then
                                            'fa-exclamation'
                                          end                    NOTE_ICON
                                      , case
                                          when t.type = 'SUCCESS' then-- t.tiponotificacao = 'P' then
                                            '#26a043'
                                          when t.type = 'WARNING' then --t.tiponotificacao = 'G' then
                                            'rgb(180,180,100)'--'#3e6ebc'
                                          when t.type = 'DANGER' then
                                            'rgb(192,0,15)'
                                          end                    NOTE_ICON_COLOR
                    
                                     , t.titulo                  NOTE_HEADER
                                     , trim(to_char(t.datanotificacao,'hh24:mi:ss'))||'<br>'|| t.descricao               NOTE_TEXT
                                     , t.url                     NOTE_LINK
                                      , case
                                          when t.type = 'SUCCESS' then-- t.tiponotificacao = 'P' then
                                            '#26a043'
                                          when t.type = 'WARNING' then --t.tiponotificacao = 'G' then
                                            'rgb(180,180,100)'--'#3e6ebc'
                                          when t.type = 'DANGER' then
                                            'rgb(192,0,15)'
                                          end     NOTE_COLOR
                                     , t.dataleitura
                                from NOTIFICACOESINTERNAS t
                                where t.dataenviado is null
                                  and t.dataleitura is null
                                  and t.datanotificacao >= trunc(sysdate)
                                        and ( ( t.tiponotificacao = 'P' and iddestino = :P0_IDUSUARIO )
                                             or ( t.tiponotificacao = 'G' and ( exists ( select 1 
                                                                                         from usuariosgruposatendimento u
                                                                                         where u.usuario            = v('APP_USER')
                                                                                           and u.idgrupoatendimento = iddestino ) 
                                                                               or t.iddestino = v('APP_ID')))
                                             or ( t.tiponotificacao = 'Z' ) )    
                            ORDER BY 1 DESC )
                    WHERE ROWNUM <= 10   
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

)

