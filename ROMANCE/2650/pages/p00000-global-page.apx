page 0 (
    name: Pagina base

    region atalhos (
        name: Atalhos
        type: list
        source {
            list: @navigation
        }
        layout {
            sequence: 10
            slot: footer
        }
        appearance {
            renderComponents: belowContent
        }
        componentAppearance {
            listTemplate: @/media-list
            templateOptions: #DEFAULT#
        }
    )

    region default (
        name: DEFAULT
        type: staticContent
        source {
            htmlCode:
                ```html
                <!-- Google tag (gtag.js) -->
                <script async src="https://www.googletagmanager.com/gtag/js?id=G-J4ZW5ZXPMW"></script>
                <script>
                  window.dataLayer = window.dataLayer || [];
                  function gtag(){dataLayer.push(arguments);}
                  gtag('js', new Date());
                
                  gtag('config', 'G-J4ZW5ZXPMW');
                </script> 
                
                <script src="https://code.jquery.com/jquery-1.10.2.js"></script>
                
                <script language="javascript">
                    function irparaceos() 
                      {
                          vurl = document.getElementById("P0_LINKCEOS").value;
                          pjan = window.open(vurl,'CEOS');//,'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1280,height=1024,left=20,top=10','_blank'); void(0);
                          pjan.focus();
                      }
                     
                    function irparabi() 
                      {
                          vurl = document.getElementById("P0_LINKBI").value;
                          pjan = window.open(vurl,'BI');//,'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1280,height=1024,left=20,top=10','_blank'); void(0);
                          pjan.focus();
                      }
                </script>
                
                
                <script>
                    
                //onkeyPress
                function formatar_mascara(src, mascara, evt)
                {
                  var tecla;  
                  if (evt.which)
                    { tecla = evt.which }
                  else if(evt.keyCode)
                    { tecla = evt.keyCode; }
                   if( tecla != 8 )
                    {var campo = src.value.length;
                     var saida = mascara.substring(0,1);
                     var texto = mascara.substring(campo);
                     if(texto.substring(0,1) != saida) 
                      {src.value+=texto.substring(0,1);}
                    }
                }
                    
                function fnc_telefone(objeto)
                {      
                   if(objeto.value.length == 0)
                     objeto.value = '(' + objeto.value;
                
                   if(objeto.value.length == 3)
                      objeto.value = objeto.value + ')';
                
                   if(objeto.value.length == 8)
                     objeto.value = objeto.value + '.';
                }
                    
                //onblur
                function formataCPF(cpf)
                 {
                 	with (cpf)
                    {
                      if (value.search("-") == -1) {      
                   	    value = value.substr(0, 3) + '.' + 
                 	  			            value.substr(3, 3) + '.' + 
                 				              value.substr(6, 3) + '-' +
                 				              value.substr(9, 2);
                      }
                    }
                 }
                
                
                //onblur
                function formataCNPJ(cnpj)
                 {
                 	with (cnpj)
                    {
                      if (value.search("-") == -1) {      
                   	    value = value.substr(0, 2) + '.' + 
                 	  			            value.substr(2, 3) + '.' + 
                 				              value.substr(5, 3) + '/' +
                 				              value.substr(8, 4) + '-' + 
                               value.substr(12,2);
                      }
                    }
                 }
                
                 
                //onblur
                function formataCEP(cep)
                 {
                 	with (cep)
                    {     
                      if (value.search("-") == -1) {      
                   	    value = value.substr(0, 2) + '.' + 
                 	              			value.substr(2, 3) + '-' + 
                 				              value.substr(5, 3);
                      }
                    }
                 }			
                    
                    
                function formataMoeda(valor){
                  v = valor.value;
                  v=v.replace(/\D/g,"") // permite digitar apenas numero
                  v=v.replace(/(\d{1})(\d{14})$/,"$1.$2") // coloca ponto antes dos ultimos digitos
                  v=v.replace(/(\d{1})(\d{11})$/,"$1.$2") // coloca ponto antes dos ultimos 11 digitos
                  v=v.replace(/(\d{1})(\d{8})$/,"$1.$2") // coloca ponto antes dos ultimos 8 digitos
                  v=v.replace(/(\d{1})(\d{5})$/,"$1.$2") // coloca ponto antes dos ultimos 5 digitos
                  v=v.replace(/(\d{1})(\d{1,2})$/,"$1,$2") // coloca virgula antes dos ultimos 2 digitos
                  valor.value = v;
                }
                    
                //onblur
                function formataHora(hora)
                 {
                 	with (hora)
                    {
                        
                      if (value.search(":") == -1) {      
                   	    value = value.substr(0, 2) + ':' + 
                 	      			value.substr(2, 2) + ':' + 
                       			value.substr(4, 2);
                      }
                    }
                 }
                
                </script>
                ```
        }
        layout {
            sequence: 10
            slot: footer
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        headerAndFooter {
            headerText:
                ```html
                <script>
                function formataMoeda(valor){
                  v = valor.value;
                  v=v.replace(/\D/g,"") // permite digitar apenas numero
                  v=v.replace(/(\d{1})(\d{14})$/,"$1.$2") // coloca ponto antes dos ultimos digitos
                  v=v.replace(/(\d{1})(\d{11})$/,"$1.$2") // coloca ponto antes dos ultimos 11 digitos
                  v=v.replace(/(\d{1})(\d{8})$/,"$1.$2") // coloca ponto antes dos ultimos 8 digitos
                  v=v.replace(/(\d{1})(\d{5})$/,"$1.$2") // coloca ponto antes dos ultimos 5 digitos
                  v=v.replace(/(\d{1})(\d{1,2})$/,"$1,$2") // coloca virgula antes dos ultimos 2 digitos
                  valor.value = v;
                }
                    
                    // Formatação de Moeda para Form Tabular
                Number.prototype.formatMoney = function(c, d, t){
                  var n = this, 
                  c = isNaN(c = Math.abs(c)) ? 2 : c, 
                  d = d == undefined ? "." : d, 
                  t = t == undefined ? "," : t, 
                  s = n < 0 ? "-" : "", 
                  i = String(parseInt(n = Math.abs(Number(n) || 0).toFixed(c))), 
                  j = (j = i.length) > 3 ? j % 3 : 0;
                  return s + (j ? i.substr(0, j) + t : "") + i.substr(j).replace(/(\d{3})(?=\d)/g, "$1" + t) + (c ? d + Math.abs(n - i).toFixed(c).slice(2) : "");
                };
                
                </script>
                ```
            footerText:
                ```html
                <script language="javascript">
                (function(ut, $) {
                
                var TREE_NAV_WIDGET_KEY = 'nav';
                
                $(window).on('theme42ready', function() {
                    /* Make sure that the navigation menu is collapsed on page load */
                    if (ut.toggleWidgets.isExpanded(TREE_NAV_WIDGET_KEY)){
                        ut.toggleWidgets.collapseWidget(TREE_NAV_WIDGET_KEY);
                    }
                
                    /* Expand on mouse over, collapse on mouse out */
                    $('.apex-side-nav.js-navCollapsed .t-Body-nav').hover(
                        function(){
                            ut.toggleWidgets.expandWidget(TREE_NAV_WIDGET_KEY);
                        },
                        function() {
                            ut.toggleWidgets.collapseWidget(TREE_NAV_WIDGET_KEY);
                        }
                    );
                });
                    
                
                })(apex.theme42, apex.jQuery);
                </script>
                
                <style>
                .js-navCollapsed .t-TreeNav .a-TreeView-node--topLevel>.a-TreeView-content.is-hover .a-TreeView-label {
                	visibility: visible;
                	left: 48px;
                	padding: 0 16px;
                	width: auto; 
                	background-color: #0459a1; /* This would be your primary color */
                }
                
                .apex-side-nav.js-navCollapsed .t-Body-nav
                , .apex-side-nav.js-navCollapsed .t-Body-nav .t-TreeNav {
                    z-index: 999; /* Make it appear on top of the page content */
                }
                
                </style>
                ```
        }
    )

    region filtro (
