    pageItem P0_IDCONTROLELIGACAO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @default
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select c.idcontrole
                from controleligacoes c
                where usuarioatendeu = v('APP_USER')
                  and situacao       = 'E'
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P0_IDFECHAMENTO (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select '- Ver Tudo -' display_value
                     , 999999999999   return_value
                from dual
                union
                select semana||' - '|| decode(f.concluido ,'S','Concluído','Aberto') display_value
                     , idfechamento return_value
                from fechamentossemanais f
                where idfilial = :P0_IDFILIALCAIXA
                order by 2 desc
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione uma Opção -
        }
        cascadingLov {
            parentItems: P0_IDFILIALCAIXA
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select f.idfilial
                from filiais f
                where f.tipofilial != 'D'
                  AND F.ATIVO = 'S'
                  and f.idfilial  = pck_romance.fnc_filialusuario(v('APP_USER') )
                order by 1
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P0_IDFILIAL (
        type: hidden
