page 264 (
    name: Faturas
    title: Faturas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region faturas (
        name: Faturas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nvl ( (SELECT pck_romance.fnc_nomefornecedor(nb.idfornemitente)
                                                         from notasfiscais_bjp nb
                                                         where nb.idnotafiscal = n.idnotafiscal),pck_romance.fnc_nomefornecedor(n.idfornemitente)) forn
                     , n.dtnf
                     , n.documento
                     , pck_romance.fnc_nomefilial(n.idfilialdestino) destino
                     , pgf.dtvencimento
                     , pgf.valorpagar "Valor Receber"
                     , valorpago
                     , n.idnotafiscal
                     , pgf.semanavencimento
                     , substr(pgf.semanavencimento,4,4) ano
                   from pagamentosfornecedores pgf
                      , notasfiscais  n
                   where n.idnotafiscal = pgf.idnotafiscal
                     and pgf.idfornecedor  in ( pck_romance.fnc_fornecedorfilial( 1075)
                                              , pck_romance.fnc_fornecedorfilial( 1074)
                                              , pck_romance.fnc_fornecedorfilial( 220 )
                                              , pck_romance.fnc_fornecedorfilial( 1069) 
                                              , pck_romance.fnc_fornecedorfilial( 421 ) )
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('APP_USER') in ('SIMADM','EVERTON','TATIANA')
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            subscription: false
        }
        download {
            formats: [
