page 223 (
    name: Compras Lucratividade Geral
    title: Compras Lucratividade Geral
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region relação-de-compras (
        name: Relação de Compras
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nf.idnotafiscal
                     , nf.dtnf
                     , nf.datainclusao
                     , nf.documento
                     , decode(nf.tipoemitente,'FOR','Compra','FIL','Transferencia') tiponota
                     , case
                         when nf.tipoemitente = 'FOR' then
                           pck_romance.fnc_nomefornecedor(nf.idfornemitente)
                         else
                           pck_romance.fnc_nomefilial(nf.idfilialemitente)
                       end origem
                     , pck_romance.fnc_nomefilial(nf.idfilialdestino) destino
                     , pck_util.fnc_semanaid(nf.idsemananota) semana
                     , nf.valorliquido 
                     , round(nf.valorliquido*ff.fatorconversao,2) convertido
                from notasfiscais nf
                   , filiais ff
                where nf.idsemananota = :P223_IDSEMANA
                  and ff.idfilial = nf.idfilialdestino
                  and ff.tipofilial = 'D'
                  and nf.situacao    = 'A'
                  and ff.ativo = 'S' 
                  and exists ( select 1
                               from itemnf   i
                                  , produtos p
                               where i.idnotafiscal = nf.idnotafiscal
                                 and i.idproduto    = p.idproduto
                                 and p.venda        = 'S' )
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 613975036441197611
        }

        column CONVERTIDO (
            type: plainText
            heading {
                heading: Valor total Convertido
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: J
            }
        )

        column DATAINCLUSAO (
