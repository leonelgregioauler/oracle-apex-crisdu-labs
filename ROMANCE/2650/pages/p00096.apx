    pageItem P96_IDFILIAL (
        type: selectList
        label {
            label: Filial
            alignment: right
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(p.apelido,p.nomepessoa)) display_value
                     , f.idfilial return_value
                from filiais    f
                   , pessoas    p
                   , usuarios   u
                   , gerentes   g
                where f.idpessoa  = p.idpessoa
                  and g.idfilial  = f.idfilial
                  and u.idgerente = g.idgerente
                  and u.usuario   = V('APP_USER')
                union
                select initcap(nvl(p.apelido,p.nomepessoa)) display_value
                     , f.idfilial return_value
                from filiais    f
                   , pessoas    p
                where f.idpessoa  = p.idpessoa
                  and f.idfilial  = :P96_IDFILIAL
                  and not exists (select initcap(nvl(p.apelido,p.nomepessoa)) display_value
                                     , f.idfilial return_value
                                from filiais    f
                                   , pessoas    p
                                   , usuarios   u
                                   , gerentes   g
                                where f.idpessoa  = p.idpessoa
                                  and g.idfilial  = f.idfilial
                                  and u.idgerente = g.idgerente
                                  and u.usuario   = V('APP_USER'))
                ```
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @nova-saida
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P96_IDFILIALDEST (
        type: selectList
        label {
            label: Filial Destino
            alignment: right
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(p.apelido,p.nomepessoa)) display_value
                     , f.idfilial return_value
                from filiais    f
                   , pessoas    p
                   , usuarios   u
                   , gerentes   g
                where f.idpessoa  = p.idpessoa
                  and g.idfilial  = f.idfilial
                  and u.idgerente(+) = g.idgerente
                order by 1
                ```
            nullDisplayValue: - Selecione a Filial Destino -
        }
        layout {
            sequence: 30
            region: @nova-saida
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
