    process fetch-row-from-saidasdiversas (
        name: Fetch Row from SAIDASDIVERSAS
        type: autoRowFetch
        source {
            tableName: SAIDASDIVERSAS
            pkColumn: IDSAIDA
            pkItem: P96_IDSAIDA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Unable to fetch row.
        }
        advanced {
            executionMappingIdentifier: 180836814447550063
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDSAIDASDIVERSAS.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P96_IDSAIDA := get_pk; 
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Unable to get primary key item value.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 180837016747550069
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-saidasdiversas (
        name: Process Row of SAIDASDIVERSAS
        type: autoRowProcessing
        target {
            tableName: SAIDASDIVERSAS
            pkColumn: IDSAIDA
            pkItem: P96_IDSAIDA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        error {
            errorMessage: Unable to process row of table SAIDASDIVERSAS.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 180837237275550070
        }
    )

