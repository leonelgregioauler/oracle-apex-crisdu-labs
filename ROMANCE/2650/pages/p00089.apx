page 89 (
    name: Inclusão de Pepinos
    title: Inclusão de Pepinos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region insere-pepinos (
        name: Insere pepinos
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDPEPINOSREPRESENTANTE",
                "IDPEPINOSREPRESENTANTE" IDPEPINOSREPRESENTANTE_DISPLAY,
                "IDFECHAMENTOREPRES",
                "NRPEDIDO",
                "VALOR",
                "ANO",
                "SEMANA",
                "SITUACAO",
                "SEMANAPAGO",
                "ANOPAGO",
                "OBSERVACAO",
                "IDFILIAL",
                "IDFECHAMENTOREPRESPAGO",
                "IDREPRESENTANTE"
                from "#OWNER#"."PEPINOSREPRESENTANTES"
                where 1 = 2
                ```
        }
        layout {
            sequence: 15
            slot: body-3
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Clique em "Adicionar Linhas"
        }
        componentAdvanced {
            stripHtml: true
        }

        column ANO (
            reportColumnQueryId: 7
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 7
            }
        )

        column ANOPAGO (
            reportColumnQueryId: 11
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 11
            }
        )

        column CHECK$01 (
            reportColumnQueryId: 1
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column IDFECHAMENTOREPRES (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 4
            }
            default {
                type: item
                item: P89_IDFECHAMENTOREPRES
            }
        )

        column IDFECHAMENTOREPRESPAGO (
            reportColumnQueryId: 14
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 14
            }
        )

        column IDFILIAL (
            reportColumnQueryId: 13
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 13
            }
        )

        column IDPEPINOSREPRESENTANTE (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDPEPINOSREPRES
            }
        )

        column IDPEPINOSREPRESENTANTE_DISPLAY (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

        column IDREPRESENTANTE (
            reportColumnQueryId: 15
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 15
            }
            default {
                type: item
                item: P89_IDREPRESENTANTE
            }
        )

        column NRPEDIDO (
            reportColumnQueryId: 5
            derivedColumn: N
            type: textField
            heading {
                heading: Nr Pedido
                alignment: center
            }
            layout {
                sequence: 5
            }
            appearance {
                width: 16
            }
        )

        column OBSERVACAO (
            reportColumnQueryId: 12
            derivedColumn: N
            type: textField
            heading {
                heading: Observacao
                alignment: center
            }
            layout {
                sequence: 12
            }
            appearance {
                width: 16
            }
        )

        column SEMANA (
            reportColumnQueryId: 8
            derivedColumn: N
            type: textField
            heading {
                heading: Semana
                alignment: center
            }
            layout {
                sequence: 8
            }
            appearance {
                width: 12
            }
        )

        column SEMANAPAGO (
            reportColumnQueryId: 10
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 10
            }
        )

        column SITUACAO (
            reportColumnQueryId: 9
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 9
            }
            default {
                type: item
                item: P89_SITUACAO
            }
        )

        column VALOR (
            reportColumnQueryId: 6
            derivedColumn: N
            type: textField
            heading {
                heading: Valor
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            appearance {
                width: 16
            }
        )

    )

    pageItem P89_IDFECHAMENTOREPRES (
        type: hidden
        layout {
            sequence: 10
            slot: legacyOrphanComponents
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P89_IDREPRESENTANTE (
        type: hidden
        layout {
            sequence: 20
            slot: legacyOrphanComponents
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P89_SITUACAO (
        type: hidden
        layout {
            sequence: 30
            slot: legacyOrphanComponents
        }
        source {
            used: always
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    button add (
        buttonName: ADD
        label: Adicionar Linha
        layout {
            sequence: 40
            region: @insere-pepinos
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @insere-pepinos
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 58
                items: {
                    P58_IDFECHAMENTOREPRES: &P89_IDFECHAMENTOREPRES.
                    P58_IDREPRESENTANTE: &P89_IDREPRESENTANTE.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button multi-row-delete (
        buttonName: MULTI_ROW_DELETE
        label: Delete
        layout {
            sequence: 20
            region: @insere-pepinos
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'MULTI_ROW_DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Salvar
        layout {
            sequence: 30
            region: @insere-pepinos
            slot: CHANGE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
    )

    validation idfechamentorepres-must-be-numeric (
        name: IDFECHAMENTOREPRES must be numeric
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @insere-pepinos
            type: columnIsNumeric
            column: IDFECHAMENTOREPRES
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: IDFECHAMENTOREPRES
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation idfechamentoreprespago-must-be-numeric (
        name: IDFECHAMENTOREPRESPAGO must be numeric
        execution {
            sequence: 130
        }
        validation {
            editableRegion: @insere-pepinos
            type: columnIsNumeric
            column: IDFECHAMENTOREPRESPAGO
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: IDFECHAMENTOREPRESPAGO
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation idfilial-must-be-numeric (
        name: IDFILIAL must be numeric
        execution {
            sequence: 120
        }
        validation {
            editableRegion: @insere-pepinos
            type: columnIsNumeric
            column: IDFILIAL
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: IDFILIAL
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation idrepresentante-must-be-numeric (
        name: IDREPRESENTANTE must be numeric
        execution {
            sequence: 140
        }
        validation {
            editableRegion: @insere-pepinos
            type: columnIsNumeric
            column: IDREPRESENTANTE
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: IDREPRESENTANTE
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation valor-must-be-numeric (
        name: VALOR must be numeric
        execution {
            sequence: 50
        }
        validation {
            editableRegion: @insere-pepinos
            type: columnIsNumeric
            column: VALOR
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: VALOR
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @insere-pepinos
        target {
            tableName: PEPINOSREPRESENTANTES
            pkColumn: IDPEPINOSREPRESENTANTE
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# row(s) updated, #MRI_COUNT# row(s) inserted.
        }
        advanced {
            executionMappingIdentifier: 186307124333997810
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 58
                items: {
                    P58_IDFECHAMENTOREPRES: &P89_IDFECHAMENTOREPRES.
                    P58_IDREPRESENTANTE: &P89_IDREPRESENTANTE.
                }
                successMessage: false
            }
        }
        comments {
            comments: Created 19-OCT-2011 11:29 by ROMAN
        }
    )

)

