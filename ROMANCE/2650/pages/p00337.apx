    region extrato-que-não-possui-depósito (
        name: Extrato que não possui Depósito
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_number(e.comprovante) comprovante
                     , e.valor
                     , e.datamovimento
                     , to_char(datamovimento,'MM') mes
                from extratosdepositos e
                where e.processado = 'E'
                  and trunc(e.dataprocessado) = to_date(:P337_DATA,'DD/MM/RRRR')
                  and ( :P337_VALOR is null or e.valor = :P337_VALOR )
                  and ( :P337_COMPROVANTE is null or e.comprovante like '%'||:P337_COMPROVANTE||'%' )
                order by 1 desc
                ```
            pageItemsToSubmit: [
                P337_VALOR
                P337_DATA
                P337_COMPROVANTE
            ]
        }
        layout {
            sequence: 30
            slot: contentBody
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma informação localizada.
        }
        advanced {
            savedReportMappingIdentifier: 3040520081133734012
