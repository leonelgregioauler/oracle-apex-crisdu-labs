    dynamicAction busca-por-comprovante (
        name: Busca por Comprovante
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P337_COMPROVANTE
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @depósitos-não-localizados
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @extrato-que-não-possui-depósito
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction busca-valor (
        name: Busca Valor
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P337_VALOR
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @depósitos-não-localizados
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @extrato-que-não-possui-depósito
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    process confirmar-localização (
        name: Confirmar Localização
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update depositosdiarios_orig d
                  set d.dataidentificado  = sysdate
                    , d.valoridentificado = d.valordeposito
                  where d.iddepositodiarios = :P337_IDDEPOSITODIARIO;
                  --
                  commit;
                  --
                  update extratosdepositos e
                  set e.iddepositodiario = :P337_IDDEPOSITODIARIO
                    , e.processado       = 'S'
                  where exists ( select 1
                                 from depositosdiarios_orig d
                                 where d.iddepositodiarios       = :P337_IDDEPOSITODIARIO
                                   and d.nrocomprovante          = e.comprovante
                                   and d.valoridentificado       = e.valor
                                   and trunc(d.dataidentificado) = trunc(sysdate)
                                   and to_char(d.data,'MM/RRRR') = to_char(e.datamovimento,'MM/RRRR') );
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Depósito confirmado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 3052063667754521723
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMAR
        }
    )

)

