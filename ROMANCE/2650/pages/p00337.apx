page 337 (
    name: Comparação de Depósitos/Extrato
    title: Comparação de Depósitos/Extrato
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 70%
        height: 70%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region buscar-informações-pelo-valor-comprovante (
        name: Buscar informações pelo Valor/Comprovante
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region depósitos-não-localizados (
        name: Depósitos não Localizados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.iddepositodiarios
                     , d.data datadeposito
                     , d.nrocomprovante
                     , d.valordeposito
                     , ( select  initcap(bb.nomebanco) || ' - <b>' || cb.agencia ||'/'||cb.conta||'</b> - <i>'||initcap(cb.beneficiario)||'</i>' 
                         from contasbancarias cb
                            , fornecedores    ff
                            , pessoas         pf
                            , bancos          bb
                         where cb.idfornecedor = ff.idfornecedor
                           and ff.idpessoa     = pf.idpessoa
                           and cb.idbanco      = bb.idbanco
                           and cb.idcontabanc  = d.idcontabanc) beneficiario
                     , nvl(pck_romance.fnc_nomerepresentante(d.idrepresentante),'-') distribuidor
                     , '<a href="javascript:apex.confirm(''Confirmar localização do Depósito?'', { request:''CONFIRMAR'', set:{''P337_IDDEPOSITODIARIO'':'||d.iddepositodiarios||' }} )";><img src="#APP_IMAGES#ok.png"  border="0"></a>' confirmar
                from depositosdiarios_orig d
                where d.comprovado = 'S'
                  and d.dataidentificado is null
                  and d.nrocomprovante is not null
                  and ( :P337_VALOR is null or d.valordeposito = :P337_VALOR )
                  and ( :P337_COMPROVANTE is null or d.nrocomprovante like '%'||:P337_COMPROVANTE||'%' )
                  and to_char(d.data,'MM/RRRR') in ( select to_char(e.datamovimento,'MM/RRRR')
                                                     from extratosdepositos e
                                                     where e.processado = 'E'
                                                       and e.iddepositodiario is null 
                                                       and trunc(e.dataprocessado) = to_date(:P337_DATA,'DD/MM/RRRR') )
                ```
            pageItemsToSubmit: [
                P337_VALOR
                P337_DATA
                P337_COMPROVANTE
            ]
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma informação localizada.
        }
        advanced {
            savedReportMappingIdentifier: 3040520601226734018
        }

