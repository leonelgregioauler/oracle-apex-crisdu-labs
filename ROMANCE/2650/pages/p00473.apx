page 473 (
    name: Rel. Plano Contas Empresa
    title: Rel. Plano Contas Empresa
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    css {
        inline:
            ```css
            /*cor de fundo cabeçalho da grid*/
            #INTGRID .a-IRR-table tr th {
                background: #e4d9ed !important;
            }
            /*cor da fonte do cabeçalho da grid*/
            #INTGRID .a-IRR-table tr th a {
                color: black !important;
            }
            /*cor dos dados da grid*/
            /*#INTGRID .a-IRR-table tr td {
                background: pink !important;
                color: green !important;
            } */
            /*cor da fonte da grid*/
            #INTGRID .a-IRR-table tr td a {
                color: #3f0d06 !important;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region grade-interativa (
        name: Grade Interativa
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDPLANOCONTASEMPRESA, 
                       IDRAZAOSOCIALFILIAL,
                       (select favorita.pck_util_fav.fnc_nomefilialromance(r.idfilial) || ' - '|| razaosocial || ' - ' || cnpj 
                          from razoessociaisfiliais r
                         where idrazaosocialfilial = p.idrazaosocialfilial) razaosocial,
                       --
                       (select valordominio 
                          from valoresdominioscrisdu v
                         where v.idvalordominio = p.modelo) desc_modelo,
                       --
                       MODELO,
                       decode(ATIVA,'S','Sim','Não') situacao,
                       Ativa
                from PLANOCONTASEMPRESA P
                  
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: INTGRID
        }
        link {
            linkColumn: customTarget
            target: {
                page: 474
                items: {
                    P474_IDPLANOCONTASEMPRESA: #IDPLANOCONTASEMPRESA#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 3074432114954119347
        }

        column ATIVA (
            type: hidden
            heading {
                heading: Ativa
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
            security {
                escapeSpecialChars: false
            }
        )

        column DESC_MODELO (
            type: plainText
            heading {
                heading: Modelo
            }
            layout {
                sequence: 24
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column IDPLANOCONTASEMPRESA (
            type: hidden
            heading {
                heading: Idplanocontasempresa
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDRAZAOSOCIALFILIAL (
            type: hidden
            heading {
                heading: Idrazaosocialfilial
            }
            layout {
                sequence: 2
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
            security {
                escapeSpecialChars: false
            }
        )

        column MODELO (
            type: hidden
            heading {
                heading: Modelo
            }
            layout {
                sequence: 3
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
            security {
                escapeSpecialChars: false
            }
        )

        column RAZAOSOCIAL (
            type: link
            heading {
                heading: Razao Social
            }
            layout {
                sequence: 14
            }
            link {
                target: {
                    page: 478
                    items: {
                        P478_IDRAZAOSOCIALFILIAL: #IDRAZAOSOCIALFILIAL#
                    }
                    action: resetPagination
                }
                linkText: #RAZAOSOCIAL#
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column SITUACAO (
            type: plainText
            heading {
                heading: Ativa
            }
            layout {
                sequence: 34
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 30744344 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ATIVA (
                sequence: 4
            )

            displayColumn DESC_MODELO (
                sequence: 6
            )

            displayColumn IDPLANOCONTASEMPRESA (
                sequence: 1
            )

            displayColumn IDRAZAOSOCIALFILIAL (
                sequence: 2
            )

            displayColumn MODELO (
                sequence: 3
            )

            displayColumn RAZAOSOCIAL (
                sequence: 5
            )

            displayColumn SITUACAO (
                sequence: 7
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Novo Registro
        layout {
            sequence: 30
            region: @grade-interativa
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 474
                clearCache: 474
            }
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            customAttributes: style="background-color:#887675;color:white";
        }
    )

)

