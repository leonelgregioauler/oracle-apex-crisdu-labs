page 301 (
    name: Sub Categorias
    title: Sub Categorias
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region sub-categorias (
        name: Sub Categorias
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idcaracteristicacateg
                     , initcap(c.nome) nome
                     , c.idcategoria
                     , ( select initcap(cc.nome)
                         from categorias cc
                         where cc.idcategoria = c.idcategoria ) categoria
                     , decode(c.tipo,'M','Material','C','Caracteristica','Outros') tipo
                from caracteristicascategorias c
                order by 2
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 302
                items: {
                    P302_IDCARACTERISTICACATEG: #IDCARACTERISTICACATEG#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 1467004245215614932
        }

        column CATEGORIA (
            type: plainText
            heading {
                heading: Categoria
                alignment: center
            }
            layout {
                sequence: 13
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column IDCARACTERISTICACATEG (
            type: plainText
            heading {
                heading: ID SubCategoria
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column IDCATEGORIA (
            type: hidden
            heading {
                heading: Idcategoria
            }
            layout {
                sequence: 3
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NOME (
            type: plainText
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column TIPO (
            type: plainText
            heading {
                heading: Tipo
                alignment: center
            }
            layout {
                sequence: 23
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 14670093 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CATEGORIA (
                sequence: 4
            )

            displayColumn IDCARACTERISTICACATEG (
                sequence: 1
            )

            displayColumn IDTIPO (
                sequence: 3
            )

            displayColumn NOME (
                sequence: 2
            )

        )

    )

    button nova-sub (
        buttonName: NOVA_SUB
        label: Nova Sub Categoria
        layout {
            sequence: 10
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 302
                clearCache: 302
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction create-button-dialog-closed (
        name: Create Button - Dialog Closed
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @nova-sub
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @sub-categorias
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @sub-categorias
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @sub-categorias
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

