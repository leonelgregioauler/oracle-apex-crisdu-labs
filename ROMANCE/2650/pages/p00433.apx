page 433 (
    name: Questionamento
    title: Questionamento
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 60%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region form-on-questionamentoscontroladoria (
        name: Form on QUESTIONAMENTOSCONTROLADORIA
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P433_CONFIRMACAOLEITURA (
        type: radioGroup
        label {
            label: Leitura Confirmada?
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 90
            region: @form-on-questionamentoscontroladoria
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: CONFIRMACAOLEITURA
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vresultado varchar2(1);
                begin
                  --
                  if :P433_IDQUESTIONAMENTO is not null then 
                    --
                    select confirmacaoleitura
                    into vresultado
                    from questionamentoscontroladoria q
                    where q.idquestionamento = :P433_IDQUESTIONAMENTO;
                    --
                  else
                    --
                    vresultado := 'N';
                    --
                  end if;
                  --
                  return vresultado;
                  --
                end;
                    
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P433_IDQUESTIONAMENTO
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P433_DATALEITURA (
        type: datePickerJquery
        label {
            label: Data da Leitura
            alignment: left
        }
        layout {
            sequence: 100
            region: @form-on-questionamentoscontroladoria
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR HH24:MI:SS
            width: 20
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: DATALEITURA
            used: always
        }
        serverSideCondition {
            type: item=value
            item: P433_CONFIRMACAOLEITURA
            value: S
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P433_IDFECHAMENTO (
        type: hidden
        layout {
            sequence: 30
            region: @form-on-questionamentoscontroladoria
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFECHAMENTO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidfechamento number;
                begin
                  --
                  select :P0_IDFECHAMENTO
                  into vidfechamento
                  from dual;
                  --
                  return vidfechamento;
                  --
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P433_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(f.idfilial) Nome
                     , f.idfilial
                from catal.filiais f
                where f.tipofilial != 'D'
                  and f.ativo = 'S'
                  and f.idfilial = nvl(:P433_IDFILIAL, ( select u.idfilial
                                                         from roman.usuariosfiliais u
                                                         where u.idfilial  = f.idfilial
                                                           and u.usuario   = v('APP_USER')))
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @form-on-questionamentoscontroladoria
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P433_IDQUESTIONAMENTO (
        type: numberField
        label {
            label: "Cód. "
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 20
            region: @form-on-questionamentoscontroladoria
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: databaseColumn
            databaseColumn: IDQUESTIONAMENTO
            used: always
        }
        readOnly {
            type: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P433_IDSAIDA (
        type: hidden
        layout {
            sequence: 120
            region: @form-on-questionamentoscontroladoria
