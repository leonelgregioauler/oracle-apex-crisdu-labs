            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuariosgruposatendimento ug
                where ug.idgrupoatendimento = 2
                  and ug.usuario = v('APP_USER')
                  and :P433_IDQUESTIONAMENTO is not null
                ```
        }
    )

    button reenviar (
        buttonName: REENVIAR
        label: Reenviar Questionamento
        layout {
            sequence: 30
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuariosgruposatendimento ug
                where ug.idgrupoatendimento = 2
                  and ug.usuario = v('APP_USER')
                  and exists ( select 1
                               from questionamentoscontroladoria q
                               where q.idquestionamento = :P433_IDQUESTIONAMENTO 
                                 and nvl(q.conferido,'N')   = 'N' )
                ```
        }
    )

    button responder (
        buttonName: RESPONDER
        label: Responder
        layout {
            sequence: 50
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where(  exists ( select 1
                                from usuariosgruposatendimento ug
                                 where ug.idgrupoatendimento != 2
                                   and ug.usuario = v('APP_USER') )
                     or not exists ( select 1
                                     from usuariosgruposatendimento ug
                                     where ug.usuario = v('APP_USER') ) )
                  and :P433_IDQUESTIONAMENTO is not null
                  and ( nvl(:P433_CONFIRMACAOLEITURA,'N') = 'N'
                      or :P433_RESPOSTA is not null
                      or ( nvl(:P433_CONFIRMACAOLEITURA,'N') = 'S'
                         and :P433_RESPOSTA is null ) )
                  and pck_romance.fnc_filialusuario(v('APP_USER')) = :P433_IDFILIAL
                ```
        }
    )

    button revisado (
        buttonName: REVISADO
        label: Revisado
        layout {
            sequence: 10
            region: @buttons
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: "javascript:apex.confirm('Deseja realmente confirmar a Revisão deste Questionamento?', { request:'REVISADO'})"
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuariosgruposatendimento ug
                where ug.idgrupoatendimento = 2
                  and ug.usuario = v('APP_USER')
                  and exists ( select 1
                               from questionamentoscontroladoria q
                               where q.idquestionamento = :P433_IDQUESTIONAMENTO 
                                 and nvl(q.confirmarenvio,'N')   = 'S' 
                                 and q.resposta is not null
                                 and q.usuarioleitura is not null 
                                 and q.dataconferencia is null
                                 and q.usuarioconferencia is null)
                ```
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 80
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuariosgruposatendimento ug
                where ug.idgrupoatendimento in (0,2)
                  and ug.usuario = v('APP_USER')
                  and :P433_IDQUESTIONAMENTO is not null
                ```
        }
    )

