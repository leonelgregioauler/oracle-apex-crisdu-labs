    pageItem P433_QUESTIONAMENTO (
        type: textarea
        label {
            label: Questionamento
            alignment: left
        }
        layout {
            sequence: 70
            region: @form-on-questionamentoscontroladoria
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 100
            height: 6
        }
        validation {
            maxLength: 4000
        }
        source {
            type: databaseColumn
            databaseColumn: QUESTIONAMENTO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                --
                V_RETURN VARCHAR2(4000);
                --
                BEGIN
                --
                IF :P433_IDSAIDA IS NOT NULL THEN
                select replace(replace(replace(DESCRICAO||' - '||VALORTOTAL,',','.') ,'+',''),'-','.')  questionar 
                INTO V_RETURN
                from SAIDASDIVERSAS s
                where IDSAIDA in (:P433_IDSAIDA) ;
                END IF;
                --
                RETURN(V_RETURN);
                --
                END;
                ```
        }
        readOnly {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                                   from usuariosgruposatendimento ug
                                   where ug.idgrupoatendimento in (0,2)
                                     and ug.usuario = v('APP_USER') )
                
                                     
                                     
                                     
                                     
                                     
                                     
                                     
                
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P433_RESPOSTA (
        type: textarea
        label {
            label: Resposta
            alignment: left
        }
        layout {
            sequence: 80
            region: @form-on-questionamentoscontroladoria
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 100
            height: 6
        }
        validation {
            maxLength: 4000
        }
        source {
            type: databaseColumn
            databaseColumn: RESPOSTA
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P433_IDQUESTIONAMENTO
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuariosgruposatendimento ug
                where ( ug.idgrupoatendimento = 2
                      and ug.usuario = v('APP_USER') )
                UNION
                SELECT 1
                FROM DUAL
                WHERE nvl(:P433_CONFIRMACAOLEITURA,'N') = 'S'
                  and :P433_RESPOSTA is not null
                      
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P433_USUARIO (
        type: hidden
