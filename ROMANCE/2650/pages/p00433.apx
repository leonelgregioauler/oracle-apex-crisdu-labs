    button anexar (
        buttonName: ANEXAR
        label: Anexar Arquivo
        layout {
            sequence: 10
            region: @form-on-questionamentoscontroladoria
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 434
                items: {
                    P434_IDQUESTIONAMENTO: &P433_IDQUESTIONAMENTO.
                    P434_IDANEXODELETAR:
                    P434_IDANEXOQUESTIONAMENTO:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P433_IDQUESTIONAMENTO
        }
    )

    button confirmar-conclusao (
        buttonName: CONFIRMAR_CONCLUSAO
        label: "Concluir "
        layout {
            sequence: 20
            region: @buttons
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: "javascript:apex.confirm('Deseja realmente concluir o Questionamento?', { request:'CONFIRMAR_CONCLUSAO'})"
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where :P433_IDQUESTIONAMENTO is not null
                  and exists ( select 1
                               from usuariosgruposatendimento u
                               where u.idgrupoatendimento = 2
                                 and u.usuario            = v('APP_USER')
                  and  exists ( select 1
                               from roman.questionamentoscontroladoria q
                               where q.dataconferencia is null
                                 and q.usuarioconferencia is null
                                 and q.resposta is not null
                                 and q.idquestionamento = :P433_IDQUESTIONAMENTO ))
                ```
        }
    )

    button confirmar-envio (
        buttonName: CONFIRMAR_ENVIO
        label: Confirmar Envio
        layout {
            sequence: 40
            region: @buttons
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuariosgruposatendimento ug
                where ug.idgrupoatendimento in (0, 2)
                  and ug.usuario = v('APP_USER')
                  and exists ( select 1
                               from questionamentoscontroladoria q
                               where q.idquestionamento = :P433_IDQUESTIONAMENTO 
                                 and nvl(q.confirmarenvio,'N')   = 'N' )
                ```
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 90
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuariosgruposatendimento ug
                where ug.idgrupoatendimento in (0,2)
                  and ug.usuario = v('APP_USER')
                  and :P433_IDQUESTIONAMENTO is null
                ```
        }
    )

