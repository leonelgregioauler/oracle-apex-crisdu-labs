    dynamicAction seta-tipo (
        name: Seta Tipo
        execution {
            sequence: 30
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: itemIsNull
            item: P433_IDQUESTIONAMENTO
        }

        action native-set-value (
            action: setValue
            settings {
                value: E
            }
            affectedElements {
                selectionType: items
                items: P433_DESTINO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo-de-destino (
        name: Tipo de Destino
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P433_DESTINO
        }
        clientSideCondition {
            type: item=value
            item: P433_DESTINO
            value: E
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P433_IDFILIAL
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P433_IDPESSOA
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P433_IDFILIAL
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P433_IDPESSOA
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    validation valida-destino-emprpesa (
        name: Valida Destino Emprpesa
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P433_IDFILIAL
        }
        error {
            errorMessage: Por favor, escolha uma empresa!
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P433_DESTINO = 'E'
                  and v('REQUEST') = 'CREATE'
                ```
        }
    )

    validation valida-destino-pessoa (
        name: Valida Destino Pessoa
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P433_IDPESSOA
        }
        error {
            errorMessage: Por favor, escolha uma Pessoa!
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P433_DESTINO = 'P'
                  and v('REQUEST') = 'CREATE'
                ```
        }
    )

    validation valida-resposta (
        name: Valida Resposta
        execution {
            sequence: 30
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where length(trim(:P433_RESPOSTA)) < 20
                ```
        }
        error {
            errorMessage: "Por favor, insira uma resposta válida. "
        }
        serverSideCondition {
            whenButtonPressed: @responder
        }
    )

    process busca-dados-questionamento (
        name: Busca Dados Questionamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vdatainclusao date;
                  vusuario varchar2(100);
                  vidfilial number;
                  vidpessoa number;
                  vidfechamento number;
                  vquestionamento varchar2(4000);
                  vresposta varchar2(4000);
                  vconfirmacaoleitura varchar2(1);
                  vdataleitura date;
                  vusuarioleitura varchar2(100);
                  vconfirmaenvio varchar2(1);
                  --
                begin
                  --
                  select DATAINCLUSAO
                       , USUARIO
                       , IDFILIAL
                       , IDPESSOA
                       , IDFECHAMENTO
                       , QUESTIONAMENTO
                       , RESPOSTA
                       , CONFIRMACAOLEITURA
                       , DATALEITURA
                       , USUARIOLEITURA
                       , CONFIRMARENVIO
                  into vdatainclusao 
                     , vusuario
                     , vidfilial 
                     , vidpessoa 
                     , vidfechamento
                     , vquestionamento 
                     , vresposta 
                     , vconfirmacaoleitura 
                     , vdataleitura
                     , vusuarioleitura 
                     , vconfirmaenvio
                  from questionamentoscontroladoria q
                  where q.idquestionamento = :P433_IDQUESTIONAMENTO;
                  --
                  :P433_IDFECHAMENTO := VIDFECHAMENTO;
                  :P433_USUARIO := VUSUARIO;
                  :P433_IDFILIAL := VIDFILIAL;
                  :P433_IDPESSOA := VIDPESSOA;
                  :P433_QUESTIONAMENTO := VQUESTIONAMENTO;
                  :P433_RESPOSTA := VRESPOSTA;
                  :P433_CONFIRMACAOLEITURA := VCONFIRMACAOLEITURA;
                  :P433_DATALEITURA := VDATALEITURA;
                  :P433_USUARIOLEITURA := VUSUARIOLEITURA;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 15429026624111978
        }
        serverSideCondition {
            type: never
        }
    )

    process busca-questionamento-ainda-em-aberto (
        name: Busca Questionamento ainda em Aberto
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidquestionamento number;
                  --
                begin
                  --
                  select idquestionamento
                  into vidquestionamento
                  from questionamentoscontroladoria q
                  where q.idfilial = :P0_IDFILIAL
                    and nvl(q.confirmarenvio,'N') = 'N';
                  --
