                               where au.idunidadedenegocio = u.idunidadedenegocio
                                 and au.usuario = v('APP_USER') )
                order by 1
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 40
            region: @filtros-ações
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P371_TIPOMOVIMENTACAO (
        type: selectList
