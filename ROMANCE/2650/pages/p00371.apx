    button fiiltar (
        buttonName: FIILTAR
        label: Fiiltar
        layout {
            sequence: 110
            region: @filtros-ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
                t-Button--gapTop
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo registro
        layout {
            sequence: 10
            region: @filtros-ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--stretch
                t-Button--gapTop
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 372
                items: {
                    P372_OBSERVACAO:
                }
                clearCache: 372
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction create-button-dialog-closed (
        name: Create Button - Dialog Closed
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @novo
        }
    )

    process inicializa-filtros (
        name: INICIALIZA_FILTROS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                    -- Inicializa a data inicio
                    if :P371_DATAINI is null then
                        select trunc(sysdate-30)
                          into :P371_DATAINI
                          from dual;
                    end if;
                
                    -- Inicializa a data Fim
                    if :P371_DATAFIM is null then
                        select trunc(sysdate)
                          into :P371_DATAFIM
                          from dual;
                    end if;
                
                exception
                    when others then
                        null;
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 869397637538147431
        }
    )

    branch (
        name: Go To Page 371
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 371
                items: {
                    P371_IDUNIDADEDENEGOCIO: &P371_IDUNIDADEDENEGOCIO.
                    P371_IDBANCO: &P371_IDBANCO.
                    P371_IDCONTA: &P371_IDCONTA.
                    P371_TIPOMOVIMENTACAO: &P371_TIPOMOVIMENTACAO.
                    P371_DATAINI: &P371_DATAINI.
                    P371_DATAFIM: &P371_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @fiiltar
        }
    )

)

