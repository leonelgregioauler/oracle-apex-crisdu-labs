    pageItem P371_IDBANCO (
        type: selectList
        label {
            label: <b>Banco</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomebanco
                     , idbanco
                from bancos
                order by 1
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 50
            region: @filtros-ações
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P371_IDCONTA (
        type: selectList
        label {
            label: <b>Conta</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Ag: '||cb.agencia||' cc: '||cb.conta||' - '||cb.beneficiario display_value
                     , cb.idcontabanc return_value
                from contasbancarias cb
                where cb.idbanco = :P371_IDBANCO
                  and exists ( select 1
                               from unidadesdenegocios u
                                  , filiais f
                               where f.idunidadedenegocio = u.idunidadedenegocio
                                 and u.idunidadedenegocio = :P371_IDUNIDADEDENEGOCIO
                                 and f.idpessoa           = cb.idpessoa )
                order by 1
                ```
            nullDisplayValue: - Todas -
        }
        cascadingLov {
            parentItems: [
                P371_IDUNIDADEDENEGOCIO
                P371_IDBANCO
            ]
        }
        layout {
            sequence: 60
            region: @filtros-ações
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P371_IDUNIDADEDENEGOCIO (
        type: selectList
