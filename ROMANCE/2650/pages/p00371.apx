        lov {
            type: staticValues
            staticValues: STATIC:Boleto;B,Cartão de Crédito;C,Depósito;D,Transferência;T,Permuta;I,Mercado Pago;M,Dinheiro;R,Abatimento;A,Cheque;X,Gerencial;G,Deb./ Cred. - Automático;E,Aporte Bancário;Z,Provisão;V,Pix;H,Endosso;P,Carteira de Investimento;F
