page 371 (
    name: Registros de Contas Bancarias
    title: Registros de Contas Bancarias
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros-ações (
        name: "Filtros/Ações "
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region registros-de-contas-bancárias (
        name: Registros de Contas Bancárias
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.idregistrocontabancaria
                     , w.idregistrocontabancaria as "ID Registro"
                     , w.unidadenegocio
                     , w.banco
                     , w.conta
                     , w.dataregistro
                     , w.valor
                     --, w.tipomovimentacao
                     , case upper(w.chartipomovimentacao)
                         when 'B' then 'Boleto'
                         when 'C' then 'Cartão de Crédito/Débito'
                         when 'D' then 'Depósito'
                         when 'T' then 'Transferência'
                         when 'I' then 'Permuta'
                         when 'M' then 'Mercado Pago'
                         when 'R' then 'Dinheiro'
                         when 'A' then 'Abatimento'
                         when 'X' then 'Cheque'
                         when 'G' then 'Gerencial'
                         when 'E' then 'Deb./ Cred. - Automático'
                         when 'Z' then 'Aporte Bancário'
                         when 'V' then 'Provisão'
                         when 'H' then 'Pix'
                         when 'P' then 'Endosso'
                         else ' - '
                       end tipomovimentacao
                     , w.data
                     , w.usuario
                     , w.observacao
                     , w.classificacao
                     , ( select count(1)
                         from anexosregistrosbancarios r
                         where r.idregistrobancario = idregistrocontabancaria ) qtd_anexos
                  from vw_registroscontasbanc w
                 where exists ( select 1
                                  from acessosunidadesdenegocio au
                                 where au.idunidadedenegocio = w.idunidadedenegocio
                                   and au.usuario = v('APP_USER') 
                                 union
                                select 1
                                  from roman.usuariosgruposatendimento g
                                 where g.usuario = v('APP_USER')
                                   and g.idgrupoatendimento = 0) 
                   and ( :P371_IDUNIDADEDENEGOCIO is null or w.idunidadedenegocio = :P371_IDUNIDADEDENEGOCIO )
                   and ( :P371_IDBANCO is null or w.idbanco = :P371_IDBANCO )
                   and ( :P371_IDCONTA is null or w.idcontabancaria = :P371_IDCONTA )
                   and ( :P371_DATAINI is null or w.dataregistro between to_date(:P371_DATAINI) and to_date(:P371_DATAFIM))
                   and ( :P371_TIPOMOVIMENTACAO is null or w.chartipomovimentacao = :P371_TIPOMOVIMENTACAO )
                 order by 1 desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum registro encontrado, utilize os filtros ao lado.
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 33620578866259610
        }

