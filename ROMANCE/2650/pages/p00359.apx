page 359 (
    name: Controle de Contas / Sub Contas
    title: Controle de Contas / Sub Contas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 80%
        height: 80%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region contas-sub-contas (
        name: Contas / Sub Contas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nomeconta "Conta"
                     , c.observacao "Observação Conta"
                     , decode(c.tipooperacional,'O','Operacional','N','Não Operacional') "Operacional"
                     , decode(c.internaexterna,'E','Externa','I','Interna') "Classificação"
                     , decode(c.centrodecusto,'S','Sim','Não') "Centro de Custos"
                     , s.nomeconta "Sub Conta"
                     , s.observacao "Observação Sub Conta"
                     , decode(s.tipo,'F','Fixa','V','Variável') "Tipo Sub Conta"
                     , decode(s.entradasaida,'E','Entrada,','S','Saída') "Classificação Sub Conta"
                     , p.classificacao
                from CONTASFINANCEIRAS c
                   , subcontasfinanceiras s
                   , planocontasgeral p
                where s.idcontafinan = c.idcontafinan
                  and s.idclassificacao = p.idclassificacao(+)
                order by c.nomeconta, s.nomeconta;
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P359_TIPO_RELATORIO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
