    region contas-sub-contas-2 (
        name: Contas / Sub Contas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nomeconta "Conta"
                     , decode(c.tipooperacional,'O','Operacional','N','Não Operacional') "Operacional"
                     , decode(c.internaexterna,'I','Interna','E','Externa') "Interna/Externa"
                     , ( select listagg(s.nomeconta,', ') within group (order by 1)
                         from subcontasfinanceiras s
                         where s.idcontafinan = c.idcontafinan ) "Sub Contas"
                from CONTASFINANCEIRAS c
                where centrodecusto = 'S'
                order by c.nomeconta;
                ```
        }
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
