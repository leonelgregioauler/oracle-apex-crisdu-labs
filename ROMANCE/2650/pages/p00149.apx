page 149 (
    name: "Usuários "
    title: "Usuários "
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 40%
        height: 70%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region usuários (
        name: "Usuários "
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDUSUARIOFORMAPAGAMENTO,
                       IDFORMAPAGAMENTO,
                       IDUSUARIO
                  from USUARIOSFORMASPAGAMENTOS
                WHERE IDFORMAPAGAMENTO = :P149_IDFORMAPAGAMENTO 
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 1276504507070408303
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDUSUARIOFORMAPAGAMENTO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDFORMAPAGAMENTO
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDUSUARIO
                layout {
                    sequence: 3
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column IDFORMAPAGAMENTO (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IDFORMAPAGAMENTO
                dataType: varchar2
            }
            default {
                type: item
                item: P149_IDFORMAPAGAMENTO
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDUSUARIO (
            type: selectList
            heading {
                heading: Usuário
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_romance.fnc_nomepessoa(idpessoa) display_value
                         , idusuario return_value
                    from usuariosgruposatendimento u
                       , usuarios uu
                    where idgrupoatendimento in (20,2,0)
                      and u.usuario  = uu.usuario
                    order by 1
                    ```
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: IDUSUARIO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDUSUARIOFORMAPAGAMENTO (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDUSUARIOFORMAPAGAMENTO
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: SEQ_IDUSUARIOFORMAPAGAMENTO
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

    )

    pageItem P149_IDFORMAPAGAMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @usuários
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    process save-interactive-grid-data (
        name: " - Save Interactive Grid Data"
        type: interactiveGridAutoRowProcessing
        editableRegion: @usuários
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1276508151035408304
        }
    )

)

