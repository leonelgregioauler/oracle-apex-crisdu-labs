page 15 (
    name: Lista de Bancos
    title: Lista de Bancos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region lista-de-bancos (
        name: Lista de Bancos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDBANCO, 
                initcap(NOMEBANCO) NOMEBANCO ,
                upper(SIGLA) SIGLA
                from BANCOS
                  
                
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 16
                items: {
                    P16_IDBANCO: #IDBANCO#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: This query returns more than 10,000 rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column IDBANCO (
            type: hidden
            heading {
                heading: Idbanco
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDBANCO
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NOMEBANCO (
            type: plainText
            heading {
                heading: Banco
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: NOMEBANCO
                endUserAlias: B
            }
            enableUsersTo {
                pivot: false
            }
        )

        column SIGLA (
            type: plainText
            heading {
                heading: Sigla
                alignment: center
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: SIGLA
                endUserAlias: C
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 14256 (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn IDBANCO (
                sequence: 1
            )

            displayColumn NOMEBANCO (
                sequence: 2
            )

            displayColumn SIGLA (
                sequence: 3
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Novo Banco
        layout {
            sequence: 30
            region: @lista-de-bancos
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 16
                clearCache: 16
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

