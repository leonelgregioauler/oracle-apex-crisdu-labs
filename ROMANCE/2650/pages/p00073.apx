page 73 (
    name: Impressão de Pedido de Compra
    title: Impressão de Pedido de Compra
    appearance {
        pageTemplate: @impressão-limpa
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region imprime-pedido-de-compra (
        name: Imprime Pedido de Compra
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                --
                  pck_imprime.prc_imprimepedidocompra(:P73_IDPEDIDOCOMPRA);
                --
                end;
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P73_IDPEDIDOCOMPRA (
        type: hidden
        layout {
            sequence: 10
            region: @imprime-pedido-de-compra
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

