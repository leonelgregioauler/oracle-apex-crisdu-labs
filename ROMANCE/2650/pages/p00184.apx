            htmlDomId: FILTRAR
        }
    )

    button voltar (
        buttonName: Voltar_1
        label: Ir para Lucr. Geral
        layout {
            sequence: 10
            region: @filtro
            slot: bottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 193
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('APP_USER') != 'ALEXANDREH'
        }
    )

    dynamicAction tipo (
        name: Tipo
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P184_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P184_TIPO
            value: 1
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P184_SEMANAFIM
            }
            execution {
                sequence: 10
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P184_SEMANAFIM
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    branch (
        name: Go to 184
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 184
                items: {
                    P184_TIPO: &P184_TIPO.
                    P184_SEMANAINI: &P184_SEMANAINI.
                    P184_SEMANAFIM: &P184_SEMANAFIM.
                }
                action: resetPagination
            }
        }
    )

)

