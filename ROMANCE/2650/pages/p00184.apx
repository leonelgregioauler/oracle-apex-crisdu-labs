page 184 (
    name: Relatório de Lucratividade
    title: Relatório de Lucratividade
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_compra(pid,semana)
            {
             var myWindow =  window.open('f?p=&APP_ID.:249:&SESSION.::NO::P249_IDFILIAL,P249_SEMANA:'+pid+','+semana,'compras', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=400,height=500,left=10,top=10','_blank'); void(0);
              myWindow.focus();
            }
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
    )

    region lucratividade (
        name: Lucratividade
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idfechamento
                     , filial "Filial"
                     , distribuicao           "Distribuição"
                     , f.semana               "Cobrança"
                     , semanacobranca         "Semana Cobrança"
                     , anocobranca            "Ano Cobrança"
                     , totalmercadorias *-1   "Total Mercadorias"
                     , totaltransferencias    "Total Transferências"--saídas
                     , f.totalcobranca        "Total Cobrança"
                     , f.totaldespesas *-1    "Total de Despesas"
                     , f.totalcomissoes *-1   "Comissões"
                     , f.comisromanrepres *-1 "Comissões Representantes"
                     , f.comissromanger *-1   "Comissões Gerente"
                     , f.valorliquido         "Valor Liquido"
                     , f.ResultadodaSemana    "Resultado da Semana"
                     , f.percdespesa          "% Despesa"
                     , f.Notasnovas           "Notas novas"
                     , f.NrodeAcertos         "Nro de Acertos"
                     , f.TotalVendaFavorita   "Total Venda Favorita"
                     , f.percvendafavorita    "% Venda Favorita"
                     , nvl(totalboletosfavorita,0)          totalboletosfavorita
                     , nvl(totalchqsemfundorecebidos,0)     totalchqsemfundorecebidos
                     , nvl(totaldepositosespecie,0)         totaldepositosespecie
                     , nvl(totaldepsitoscheques,0)          totaldepsitoscheques
                    -- , nvl(f.comissfavrepres,0) *-1         totalcomissoesfavoritarepres
                    -- , nvl(f.comissfavgerente,0)*-1         totalcomissoesfavoritagerente
                     , '|' pepino
                     , f.debitosnovos *-1 "Pepinos Novos"
                     , f.debitospagos "Pepinos Pagos"
                     , f.saldodebitos "Saldo"
                     , f.saldodebitosacumulado "Saldo Acumulado" 
                     , decode(concluido,'S','Sim','Não') concluido
                     , idfilial
                     , distribuicao   semana
                     , case
                         when f.totalcobranca > 0 then
                            f.ResultadodaSemana /   f.totalcobranca * 100 
                         else
                           0
                         end "% Lucro"
                     , f.fatorconversao "Câmbio"
                     , f.idsemana
                from vw_fechamentosdistribuidoras f
                where idsemana = :P184_SEMANAINI
                  and exists ( select 1
                               from usuariosfiliais u
                               where u.idfilial = f.idfilial
                                 and u.usuario  = v('APP_USER') ) 
                order by 1 desc
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P184_TIPO
            value: 1
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Dados não encontrados.
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

