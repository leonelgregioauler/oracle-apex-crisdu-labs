        )

    )

    region lucratividade-agrupado (
        name: Lucratividade Agrupado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select filial "Filial"
                     , idfilial
                     , SUM(totalmercadorias) *-1   "Total Mercadorias"
                     , SUM(totaltransferencias)    "Total Transferências"--saídas
                     , SUM(f.totalcobranca)        "Total Cobrança"
                     , SUM(f.totaldespesas) *-1    "Total de Despesas"
                     , SUM(f.totalcomissoes) *-1   "Comissões"
                     , SUM(f.comisromanrepres) *-1 "Comissões Representantes"
                     , SUM(f.comissromanger) *-1   "Comissões Gerente"
                     , SUM(f.valorliquido)         "Valor Liquido"
                     , SUM(f.ResultadodaSemana)    "Resultado da Semana"
                     
                     , CASE
                         when sum(totalcobranca) > 0 then
                         decode(sum(nvl(totalcobranca,0)), 0, 0, (  sum(comisromanrepres) + sum(f.totaldespesas) )
                                                                 /  sum(totalcobranca) * 100)  
                         else 
                           0
                           end "% Despesa"
                     , SUM(f.Notasnovas)           "Notas novas"
                     , SUM(f.NrodeAcertos)         "Nro de Acertos"
                     , SUM(f.TotalVendaFavorita)   "Total Venda Favorita"
                     
                     , case 
                          when sum(totalcobranca) > 0  then
                            sum(TotalVendaFavorita)*100/sum(totalcobranca)
                          else  
                            0
                          end         "% Venda Favorita"
                     , SUM(nvl(totalboletosfavorita,0))          totalboletosfavorita
                     , SUM(nvl(totalchqsemfundorecebidos,0))     totalchqsemfundorecebidos
                     , SUM(nvl(totaldepositosespecie,0))         totaldepositosespecie
                     , SUM(nvl(totaldepsitoscheques,0))          totaldepsitoscheques
                     , SUM(nvl(f.comissfavrepres,0)) *-1         totalcomissoesfavoritarepres
                     , SUM(nvl(f.comissfavgerente,0))*-1         totalcomissoesfavoritagerente
                     , '|' pepino
                     , SUM(f.debitosnovos) *-1 "Pepinos Novos"
                     , SUM(f.debitospagos) "Pepinos Pagos"
                     , SUM(f.saldodebitos) "Saldo"
                     , SUM(f.saldodebitosacumulado) "Saldo Acumulado" 
                     
                     , CASE
                         when sum(totalcobranca) > 0 then
                           SUM(f.ResultadodaSemana) /   SUM(f.totalcobranca) * 100
                         else
                           0
                         end          "% Lucro"
                from vw_fechamentosdistribuidoras f
                where idsemana between :P184_SEMANAINI and :P184_SEMANAFIM
                  and exists ( select 1
                               from usuariosfiliais u
                               where u.idfilial = f.idfilial
                                 and u.usuario  = v('APP_USER') ) 
                group by filial, idfilial
                order by 1 desc
                ```
        }
