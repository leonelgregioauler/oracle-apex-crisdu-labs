page 326 (
    name: Consulta Estratégica de Produtos
    alias: CONSULTA-ESTRATÉGICA-DE-PRODUTOS
    title: Consulta Produtos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }

    region consulta-estratégica-de-produtos (
        name: Consulta Estratégica de Produtos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idproduto     as "ID Produto"
                     , c.idcategoria   as "ID Categoria"
                     , c.nome          as "Categoria"
                     , p.codigosisdist as "Referência"
                     , p.nomeproduto   as "Descrição"
                     , 'R$ ' || nvl(to_char((select max(fp.precocusto)
                                               from roman.fornecedoresprodutos fp
                                              where fp.idproduto = p.idproduto),'999G999G999G999G990D00'),'0,00') as "Maior Custo"
                     
                     , ' / Brasil R$ ' || nvl(to_char(p.precovenda,'999G999G999G999G990D00'),'0,00') as "Preço de Venda"
                     
                     , decode(p.comissao, 'S', 'Sim', 'N', 'Não','Não Informado') as "Com Comissão"
                  from roman.produtos p
                     , roman.categorias c
                 where c.idcategoria = p.idcategoria
                   and ( :P326_ID_CATEGORIA       is null or c.idcategoria = :P326_ID_CATEGORIA)
                   and ( trim(:P326_REFERENCIA)   is null or p.codigosisdist = :P326_REFERENCIA)
                   and ( :P326_ID_PRODUTO         is null or p.idproduto = :P326_ID_PRODUTO)
                   and (    ( :P326_COM_COMISSAO = 'A') 
                         or ( :P326_COM_COMISSAO = 'N' and p.comissao = 'N') 
                         or ( :P326_COM_COMISSAO = 'S' and p.comissao = 'S') )
                
                /*
                    Maicon Aimi - 9901217 - 25/03/2025
                    Adicionado Formatação estranha a pedido do Fernando Dalla Palma coluna "Maior Custo" e "Preço de Venda"
                */
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 378228902217442536
        }

        column Categoria (
            type: plainText
            heading {
                heading: Categoria
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column "Com Comissão" (
            type: plainText
            heading {
                heading: Com Comissão
                alignment: center
            }
            layout {
                sequence: 80
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column Descrição (
            type: plainText
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column "ID Categoria" (
            type: plainText
            heading {
                heading: ID Categoria
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column "ID Produto" (
            type: plainText
            heading {
                heading: ID Produto
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column "Maior Custo" (
            type: plainText
            heading {
                heading: Maior Custo
            }
            layout {
                sequence: 90
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        column "Preço de Venda" (
            type: plainText
            heading {
                heading: Preço De Venda
            }
            layout {
                sequence: 100
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: J
            }
        )

        column Referência (
            type: plainText
            heading {
                heading: Referência
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 3784898 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100
            }

            displayColumn "Categoria" (
                sequence: 1
            )

            displayColumn "Com Comissão" (
                sequence: 6
            )

            displayColumn "Descrição" (
                sequence: 3
            )

            displayColumn "Maior Custo" (
                sequence: 4
            )

            displayColumn "Preço de Venda" (
                sequence: 5
            )

            displayColumn "Referência" (
                sequence: 2
            )

        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
    )

    pageItem P326_COM_COMISSAO (
        type: selectList
        label {
            label: <b>Com Comissão?</b>
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Ambos;A,Sim;S,Não;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        default {
            type: static
            staticValue: A
        }
    )

    pageItem P326_ID_CATEGORIA (
        type: selectList
        label {
            label: <b>Categoria</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nome        as display_value
                     , c.idcategoria as return_value
                  from roman.categorias c
                 order by c.nome;
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
    )

    pageItem P326_ID_PRODUTO (
        type: selectList
        label {
            label: <b>Descrição</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(p.nomeproduto) as display_value
                     , p.idproduto   as return_value
                  from roman.produtos p
                 where p.idproduto != 1
                 order by p.nomeproduto;
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
    )

    pageItem P326_REFERENCIA (
        type: textField
        label {
            label: <b>Referência</b>
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

    button filtrar (
        buttonName: Filtrar
        label: Filtrar
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--stretch
                t-Button--gapTop
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            customAttributes: style="background-color:#309fdb;color:white;border: 1px solid #227baa;border-radius: 2px";
        }
    )

)

