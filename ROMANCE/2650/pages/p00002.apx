page 2 (
    name: Lista de Categorias
    title: Lista de Categorias
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region lista-de-categorias (
        name: Lista de Categorias
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select "IDCATEGORIA", 
                "NOME",
                "DESCRICAO",
                "PERCLUCRO",
                "ATIVO",
                "OBSERVACAO",
                referencia "Referência"
                from "#OWNER#"."CATEGORIAS" 
                  
                
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 9
                items: {
                    P9_IDCATEGORIA: #IDCATEGORIA#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: This query returns more than 10,000 rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column ATIVO (
            type: plainText
            heading {
                heading: Ativo
                alignment: center
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: ATIVO
                endUserAlias: E
            }
            enableUsersTo {
                pivot: false
            }
        )

        column DESCRICAO (
            type: plainText
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: DESCRICAO
                endUserAlias: C
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDCATEGORIA (
            type: hidden
            heading {
                heading: Idcategoria
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDCATEGORIA
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NOME (
            type: plainText
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: NOME
                endUserAlias: B
            }
            enableUsersTo {
                pivot: false
            }
        )

        column OBSERVACAO (
            type: plainText
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 6
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: OBSERVACAO
                endUserAlias: F
            }
            enableUsersTo {
                pivot: false
            }
        )

        column PERCLUCRO (
            type: plainText
            heading {
                heading: Perc Lucro
                alignment: center
            }
            layout {
                sequence: 4
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: PERCLUCRO
                endUserAlias: D
            }
            enableUsersTo {
                pivot: false
            }
        )

        column Referência (
            type: plainText
            heading {
                heading: Referência
                alignment: center
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Referência
                endUserAlias: G
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 13981 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100000
            }

            displayColumn ATIVO (
                sequence: 4
            )

            displayColumn DESCRICAO (
                sequence: 3
            )

            displayColumn NOME (
                sequence: 2
            )

            displayColumn "Referência" (
                sequence: 1
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Incluir Nova
        layout {
            sequence: 30
            region: @lista-de-categorias
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 9
                clearCache: 9
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

