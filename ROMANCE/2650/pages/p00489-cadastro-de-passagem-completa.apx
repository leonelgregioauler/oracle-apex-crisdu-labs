    process initialize-form-cadastro-de-passagem (
        name: Initialize form Cadastro de Passagem
        type: formInitialization
        formRegion: @ida
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 97203396223101126
        }
    )

    process processo-dml-em-passagens (
        name: Processo DML em Passagens
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vmd5 varchar2(1000);
                  voperacao_dml varchar2(1);
                begin
                  --
                  if v('REQUEST') = 'CREATE' then
                    --
                    voperacao_dml := 'I';
                    --
                  elsif v('REQUEST') = 'UPDATE' then
                    --
                    voperacao_dml := 'U';
                    --
                  end if;
                  --
                  pck_cadastros_rmc.prc_passagensconvencao(pidpassagemconvencao => :P489_IDPASSAGEMCONVENCAO,
                                                           ptipo_passagem => :P489_TIPO_PASSAGEM,
                                                           pcompanhia => :P489_COMPANHIA,
                                                           pnumero_voo => :P489_NUMERO_VOO,
                                                           plocalizador => :P489_LOCALIZADOR,
                                                           pdata => :P489_DATA,
                                                           phora_partida => :P489_HORA_PARTIDA,
                                                           phora_chegada => :P489_HORA_CHEGADA,
                                                           pstatus_voo => :P489_STATUS_VOO,
                                                           pcomprar_hotel => :P489_COMPRAR_HOTEL,
                                                           pvalor => :P489_VALOR,
                                                           paeroporto_origem => :P489_AEROPORTO_ORIGEM,
                                                           paeroporto_destino => :P489_AEROPORTO_DESTINO,
                                                           pmd5 => VMD5,
                                                           poperacao_dml => voperacao_dml);
                  --
                  pck_cadastros_rmc.prc_passagensconvencao(pidpassagemconvencao => :P489_IDPASSAGEMCONVENCAO_1,
                                                           ptipo_passagem => :P489_TIPO_PASSAGEM_V,
                                                           pcompanhia => :P489_COMPANHIA_V,
                                                           pnumero_voo => :P489_NUMERO_VOO_V,
                                                           plocalizador => :P489_LOCALIZADOR_V,
                                                           pdata => :P489_DATA_V,
                                                           phora_partida => :P489_HORA_PARTIDA_V,
                                                           phora_chegada => :P489_HORA_CHEGADA_V,
                                                           pstatus_voo => :P489_STATUS_VOO_V,
                                                           pcomprar_hotel => :P489_COMPRAR_HOTEL_V,
                                                           pvalor => :P489_VALOR_v,
                                                           paeroporto_origem => :P489_AEROPORTO_ORIGEM_V,
                                                           paeroporto_destino => :P489_AEROPORTO_DESTINO_V,
                                                           pmd5 => VMD5,
                                                           poperacao_dml => voperacao_dml);
                  --
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 97203860213101149
        }
        serverSideCondition {
            type: expression
            plsqlExpression: v('REQUEST') in ('CREATE','UPDATE')
        }
    )

    branch (
        name: Go To Page 488
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 488
                items: {
                    P488_IDPASSAGEMCONVENCAO: &P489_IDPASSAGEMCONVENCAO.
                    P488_PAGINA: 489
                    P488_IDPASSAGEMCONVENCAO_1: &P489_IDPASSAGEMCONVENCAO_1.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

)

