page 489 (
    name: Cadastro de Passagem Completa
    alias: CADASTRO-DE-PASSAGEM-COMPLETA
    title: Cadastro de Passagem Completa
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 70%
        resizable: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region ida (
        name: Ida
        type: form
        source {
            location: localDatabase
            tableName: PASSAGENSCONVENCAO
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
    )

    region volta (
        name: Volta
        type: form
        source {
            location: localDatabase
            tableName: PASSAGENSCONVENCAO
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
    )

