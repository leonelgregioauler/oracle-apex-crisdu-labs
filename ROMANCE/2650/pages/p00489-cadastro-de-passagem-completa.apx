    dynamicAction atualiza-companhia-volta (
        name: Atualiza Companhia Volta
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P489_COMPANHIA
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: v('P489_COMPANHIA')
                itemsToSubmit: [
                    P489_COMPANHIA
                    P489_COMPANHIA_V
                ]
            }
            affectedElements {
                selectionType: items
                items: P489_COMPANHIA_V
            }
            execution {
                sequence: 10
            }
        )

    )

