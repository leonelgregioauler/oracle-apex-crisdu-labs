    button cancelar (
        buttonName: CANCELAR
        label: Cancelar
        layout {
            sequence: 110
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 327
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

