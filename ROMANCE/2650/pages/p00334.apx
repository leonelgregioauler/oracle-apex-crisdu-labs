    pageItem P334_FILTRAR (
        type: radioGroup
        label {
            label: Filtrar
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC:Semana;S,Periodo;P
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
