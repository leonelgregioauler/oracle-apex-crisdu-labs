    dynamicAction filtro-por-semana-periodo (
        name: Filtro por Semana/Periodo
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P334_FILTRAR
        }
        clientSideCondition {
            type: item=value
            item: P334_FILTRAR
            value: S
