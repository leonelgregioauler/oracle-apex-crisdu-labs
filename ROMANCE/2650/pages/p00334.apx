    region fotos-do-produto (
        name: Fotos do Produto
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nvl(( select listagg('<a href="'||ft.url||'" target="_blank"> <img src="'||ft.urlreduzida||'" class="img_produto"><a>',' ') within group (order by 1)
                             from fotosprodutos ft 
                             where ft.idproduto = p.idproduto ),'<a href="http://fotosprodutos.romancemoda.com.br/acessar?INDISPONIVEL.JPG" target="_blank"> <img src="http://fotosprodutos.romancemoda.com.br/acessar?INDISPONIVEL.JPG/true" class="img_produto"><a>') foto
                from produtos p
                where idproduto = :P334_IDPRODUTO
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
            column: 8
            columnSpan: 5
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--noBorders
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P334_IDPRODUTO
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 3059608191129206619
        }

        column FOTO (
            type: plainText
            heading {
                heading: Foto
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        savedReport 15342147 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn FOTO (
                sequence: 1
            )

        )

    )

    region top-10-vendidos (
        name: Top 10 + Vendidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.posicao
                     , pck_romance.fnc_nomeprodutoestoque(t.idestoquefil) produto
                     , pck_romance.fnc_nomefilial(t.idfilial) empresa
                     , t.fisico
                     , t.distribuido
                     , t.vendido
                     , case
                         when t.distribuido > 0 then
                             round(( ( t.vendido * 100 ) /  t.distribuido ),2) 
                         else 
                           0
                         end "Perc Venda"
                     , case
                         when t.fisico > 0 then
                           round(( ( t.vendido * 100 ) /  t.fisico ),2)
                         else
                           0
                         end "Perc Fisico"
                from ( select rownum posicao
                            , t.*
                       from ( select mv.idestoquefil
                                   , mv.idfilial
                                   , pck_estoque.fnc_estoquetotalfilial(mv.idestoquefil) fisico
                                   , sum(mv.distribuido) distribuido
                                   , sum(mv.vendido) vendido
                              from vw_percentualvenda_mv mv
                              where ( :P334_FILIALGRUPO is null 
                                   or ( :P334_FILIALGRUPO = 'E' and ( :P334_IDFILIAL is null or mv.idfilial = :P334_IDFILIAL ) )
                                   or ( :P334_FILIALGRUPO = 'G' and exists ( select 1
                                                                             from filiais f
                                                                             where f.idfilial = mv.idfilial
                                                                               and f.idgrupo  = :P334_IDGRUPO ) ) )
                                and ( :P334_FILTRAR is null
                                   or ( :P334_FILTRAR = 'S' and mv.idsemanacobranca = :P334_SEMANA )
                                   or ( :P334_FILTRAR = 'P' and mv.idsemanacobranca between :P334_SEMANAINI and :P334_SEMANAFIM ) )   
                                and (:P334_IDPRODUTO is null or ( exists ( select 1 
                                                                           from estoquefilial i
                                                                           where i.idestoquefilial = mv.idestoquefil 
                                                                             and i.idproduto = :P334_IDPRODUTO)))
                                and ( :P334_IDFORNECEDOR is null or exists ( select 1
                                                                             from fornecedoresprodutos f
                                                                                , estoquefilial        e
                                                                             where f.idfornecedor    = :P334_IDFORNECEDOR 
                                                                               and f.idproduto       = e.idproduto
                                                                               and e.idestoquefilial = mv.idestoquefil ) )
                                and ( :P334_IDFILIAL is not null 
                                   or :P334_SEMANA is not null 
                                   or :P334_SEMANAINI is not null 
                                   or :P334_IDFORNECEDOR is not null )
                              group by mv.idestoquefil , mv.idfilial
                              order by 5 desc ) t
                       where rownum <= 10 ) t
                order by 1
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 3059606095649206598
        }

