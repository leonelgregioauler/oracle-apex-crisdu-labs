            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: S
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P334_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(idfilial) display_value
                     , idfilial
                from filiais f
                where f.tipofilial = 'D'
                  and f.ativo = 'S'
                  and exists ( select 1
                               from usuariosfiliais u
                               where u.idfilial = f.idfilial
                                 and u.usuario  = v('APP_USER') ) 
                  and exists ( select 1
                               from representantes r
                               where pck_romance.fnc_filialgerente(idgerente) = f.idfilial
                                 and r.usanetbook = 'S' )
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P334_IDFORNECEDOR (
        type: popupLov
        label {
            label: Fornecedor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefornecedor(idfornecedor)
                     , idfornecedor
                from fornecedores f
                where ativo = 'S'
                  and exists ( select 1
                               from produtos p
                                  , fornecedoresprodutos ff
                               where p.idproduto = ff.idproduto
                                 and ff.idfornecedor = f.idfornecedor
                                 and p.venda = 'S')
                order by 1
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P334_IDGRUPO (
        type: radioGroup
        label {
            label: Grupo
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select descricao display_value
                     , idgrupo  return_value
                from gruposromance
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P334_IDPRODUTO (
        type: popupLov
        label {
            label: Produto
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct initcap(p.nomeproduto) display_value
                    , p.idproduto 
                from produtos p
                   , fornecedoresprodutos f
                where p.idproduto = f.idproduto
                  and (:P334_IDFORNECEDOR  is null or f.idfornecedor = :P334_IDFORNECEDOR )
                order by 1
                ```
            nullDisplayValue: - Todos -
        }
        cascadingLov {
            parentItems: P334_IDFORNECEDOR
        }
        layout {
            sequence: 50
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P334_SEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select semana display_value
                     , idsemana RETURN_VALUE
                from ( select distinct semana, idsemana
                       from fechamentossemanais
                       order by idsemana desc )
                where rownum < 30
                ```
            displayExtraValues: false
            nullDisplayValue: - Semana Cobrança -
        }
        layout {
            sequence: 70
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

