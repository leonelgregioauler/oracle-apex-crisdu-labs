page 213 (
    name: Abatimento Confirmado
    title: Abatimento Confirmado
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region abatimento-confirmado (
        name: Abatimento Confirmado
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P213_ABATIMENTOCONFIRMADO (
        type: radioGroup
        label {
            label: Confirmar
            alignment: right
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @abatimento-confirmado
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: ABATIMENTOCONFIRMADO
            used: always
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P213_IDNOTAFISCAL (
        type: hidden
        layout {
            sequence: 10
            region: @abatimento-confirmado
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDNOTAFISCAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Fechar
        layout {
            sequence: 10
            region: @abatimento-confirmado
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: window.opener.location.reload(); window.close();
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: SAVE
        label: Confirmar
        layout {
            sequence: 30
            region: @abatimento-confirmado
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P213_IDNOTAFISCAL
        }
    )

    process fetch-row-from-notasfiscais (
        name: Fetch Row from NOTASFISCAIS
        type: autoRowFetch
        source {
            tableName: NOTASFISCAIS
            pkColumn: IDNOTAFISCAL
            pkItem: P213_IDNOTAFISCAL
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1030119616857080720
        }
    )

    process process-row-of-notasfiscais (
        name: Process Row of NOTASFISCAIS
        type: autoRowProcessing
        target {
            tableName: NOTASFISCAIS
            pkColumn: IDNOTAFISCAL
            pkItem: P213_IDNOTAFISCAL
            supportedOperations: update
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        advanced {
            executionMappingIdentifier: 1030119829182080733
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 1030119999255080733
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 213
            }
        }
    )

)

