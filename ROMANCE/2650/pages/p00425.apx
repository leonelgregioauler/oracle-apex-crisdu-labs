    region acompanhamento-anual-das-indústrias (
        name: Acompanhamento Anual das Indústrias
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , i.ano
                     , i.receita
                     , i.despesas
                     , i.resultado
                     , i.rateios
                     , i.resultadoliquido
                from vw_filiais f
                   , investimentosanuais i
                where f.ativo = 'S'
                  and f.tipofilial = 'F'
                  and i.idunidadedenegocio = f.idunidadedenegocio
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
