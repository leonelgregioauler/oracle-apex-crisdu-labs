    pageItem P425_ANO (
        type: selectList
        label {
            label: Ano
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct ano display_value
                    , ano return_value
                from semana_dias s
                where s.ano between 2020 and 2025
                order by 1 desc
                ```
        }
        layout {
            sequence: 20
            region: @investimentos-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                return to_char(sysdate,'RRRR');
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P425_IDUNIDADEDENEGOCIO (
        type: selectList
        label {
            label: Indústria
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select u.nome
                     , u.idunidadedenegocio
                from unidadesdenegocios u
                where u.idgruponegocio = 5
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @investimentos-2
            slot: regionBody
            alignment: left
        }
        appearance {
