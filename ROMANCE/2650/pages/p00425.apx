    region investimentos-2 (
        name: Investimentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select u.nome
                         from unidadesdenegocios u
                         where u.idunidadedenegocio = :P425_IDUNIDADEDENEGOCIO ) unidade
                     , ano
                     , t.mes
                     , t.numero
                     , t.receitas
                     , ( t.despesas + t.rateio_despesa )*-1 despesas
                     , ( t.receitas
                       - t.despesas
                       - t.rateio_despesa ) resultado
                     , t.rateios*-1 rateios
                     , ( t.receitas
                       - t.despesas
                       - t.rateio_despesa
                       - t.rateios ) resultado_liquido
                from ( 
                      select m.mes
                           , m.numero
                           , :P425_ANO ano
                           , nvl( ( select sum(d.valor)
                                    from vw_despesascentroscustos_m d
                                    where d.idunidadedenegocio = :P425_IDUNIDADEDENEGOCIO
                                      and d.mes = m.numero
                                      and d.ano = :P425_ANO
                                      and not exists ( select 1
                                                       from rateioscentroscustos rr
                                                       where rr.idcentrodecusto = d.idcentrodecusto
                                                         and rr.percentual is not null ) ),0) despesas
                           , nvl( ( select sum(r.valor)
                                    from vw_receitascentroscustos_m r
                                    where r.idunidadedenegocio = :P425_IDUNIDADEDENEGOCIO
                                      and r.idmes = m.numero
                                      and r.ano = :P425_ANO ),0) receitas
                           , nvl( ( pck_centrodecustos_rmc.fnc_valoresrateios_despesas(:P425_IDUNIDADEDENEGOCIO,m.numero,m.numero,:P425_ANO) ),0) rateio_despesa 
                           , nvl( pck_centrodecustos_rmc.fnc_valoresrateios( :P425_IDUNIDADEDENEGOCIO,m.numero, m.numero,:P425_ANO),0 ) rateios
                      from meses m 
                      where :P425_IDUNIDADEDENEGOCIO is not null 
                        and :P425_ANO is not null ) t
                
                
                ```
        }
        layout {
            sequence: 20
            parentRegion: @investimentos
            slot: subRegions
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
