    process atualiza-valor-total (
        name: atualiza valor total
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vvlrtotal number(15,2);
                  --
                  cursor c1 is
                    select *
                    from pedidoscompras p
                    where p.idpedidocompra = :P112_IDPEDIDOCOMPRA;
                  --
                  r1  c1%rowtype;
                  --
                begin
                  --
                  open c1;
                  fetch c1 into r1;
                  close c1;
                  --
                  select sum(valortotal) 
                  into vvlrtotal
                  from itenspedidocompra i
                  where i.idpedidocompra = r1.idpedidocompra;
                  --
                  update pedidoscompras p
                  set p.valortotal = vvlrtotal
                    , p.valorliquido = (vvlrtotal + nvl(r1.valorfrete,0) - nvl(r1.vlrdesconto,0))
                  where p.idpedidocompra = :P112_IDPEDIDOCOMPRA;
                  --
                end;
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 180976317310482756
        }
    )

