            encryptSessionState: false
        }
    )

    pageItem P112_IDFORNECEDOR (
        type: selectList
        label {
            label: Fornecedor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_value
                     , return_value
                from (select initcap(nvl(p.apelido,p.nomepessoa))||' ('||pck_romance.fnc_nomecidade(p.idcidade)||')' display_value
                           , f.idfornecedor return_value 
                      from fornecedores f
                         , pessoas p
                      where f.idpessoa = p.idpessoa
                        and exists ( select 1 
                                     from fornecedoresprodutos p
                                     where p.idfornecedor = f.idfornecedor)
                        and ( :P112_IDFORNECEDOR is null or f.idfornecedor = :P112_IDFORNECEDOR ) 
                      union
                      select '- Selecione o Fornecedor -' display_value
                           , null return_value
                      from dual
                      where :P112_IDFORNECEDOR is null )
                order by display_value
                ```
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @pedido-de-compra
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFORNECEDOR
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

