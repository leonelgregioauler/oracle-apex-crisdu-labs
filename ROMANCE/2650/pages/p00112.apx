    pageItem P112_IDSEMANA (
        type: selectList
        label {
            label: Semana Disp.
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(semana,'00')||'/'||ano||' ('||dt_ini||' a '||dt_fim||')' display_value
                     , idsemana return_value
                from semana_dias
                where idsemana between ( select idsemana
                                         from semana_dias
                                         where semana = to_number(to_char(sysdate,'IW'))
                                           and ano = to_number(to_char(sysdate,'RRRR') ) ) and ( select idsemana+30
                                                                                                 from semana_dias
                                                                                                 where semana = to_number(to_char(sysdate,'IW'))
                
                                                                                                   and ano = to_number(to_char(sysdate,'RRRR') ) )
                union
                select to_char(semana,'00')||'/'||ano||' ('||dt_ini||' a '||dt_fim||')' display_value
                     , idsemana return_value
                from semana_dias
                where idsemana  = :P112_IDSEMANA
                order by 2 
                ```
            nullDisplayValue: - Selecionar a semana de disponibilidade -
        }
        layout {
            sequence: 50
            region: @pedido-de-compra
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDSEMANA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

