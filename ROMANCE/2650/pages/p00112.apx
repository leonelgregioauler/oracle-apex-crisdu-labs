page 112 (
    name: Pedido de Compra
    title: Pedido de Compra
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function fnc_imprimepedidocompra(vidpedidocompra)
            {
              window.open('f?p=&APP_ID.:73:&SESSION.::NO::P73_IDPEDIDOCOMPRA:'+vidpedidocompra, 'Imprime Pedido Compra','toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,resizable=no,width=900,height=600,left=5,top=5'); void(0);
            }
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region itens (
        name: Itens
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select iditpedidocompra
                     , idpedidocompra
                     , ( select p.codigosisdist||' - '||initcap(p.nomeproduto)
                		     from produtos p
                				 where p.idproduto = i.idproduto) produto
                     , custound
                     , valortotal
                     , observacao
                     , qtdpp
                     , qtdp
                     , qtdm
                     , qtdg
                     , qtdgg
                     , qtdegg
                     , qtdexgg
                     , qtdxxgg
                     , qtdu
                     , qtdtotal
                from itenspedidocompra i
                where idpedidocompra = :P112_IDPEDIDOCOMPRA
                ```
        }
        layout {
            sequence: 25
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--horizontalBorders
            ]
            showNullValuesAs: -
        }
        pagination {
            type: showAll
        }
        messages {
            whenNoDataFound: - Não há registros -
        }

