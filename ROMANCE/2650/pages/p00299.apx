        savedReport 9288904 (
            visibility: primaryDefault
            view {
                groupBy: true
                rowsPerPage: 100000
            }

            displayColumn APXWS_CC_001 (
                sequence: 9
            )

            displayColumn BENEFICIARIO (
                sequence: 10
            )

            displayColumn CONTA (
                sequence: 2
            )

            displayColumn DATAMOVIMENTO (
                sequence: 3
            )

            displayColumn DESTINO (
                sequence: 1
            )

            displayColumn EMPRESADESTINO (
                sequence: 6
            )

            displayColumn FATURA (
                sequence: 4
            )

            displayColumn MOTIVO (
                sequence: 5
            )

            displayColumn VALORPAGAR (
                sequence: 7
            )

            displayColumn VALORPAGO (
                sequence: 8
            )

            computation APXWS_CC_001 (
                identifier: C01
                source {
                    expression: nvl(L,0)+ nvl(K,0)
