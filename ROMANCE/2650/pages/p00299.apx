                }
            )

            aggregate (
                column: VALORMOVIMENTO
            )

            aggregate (
                column: VALORPAGAR
            )

            aggregate (
                column: VALORPAGO
            )

            aggregate (
                column: APXWS_CC_001
            )

            controlBreak (
                column: DESTINO
                layout {
                    sequence: 1
                }
