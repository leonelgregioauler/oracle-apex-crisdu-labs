                }
            )

            groupByColumn (
                column: CONTA
                layout {
                    sequence: 1
                }
            )

            groupByColumn (
                column: MES
                layout {
                    sequence: 2
                }
            )

            groupByAggregate (
                heading: a pagar
                aggregate {
                    column: VALORPAGAR
                    displaySum: true
                }
                appearance {
                    formatMask: 999G999G999G999G990D00
                }
                layout {
