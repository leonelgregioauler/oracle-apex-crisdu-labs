    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P299_ANO (
        type: numberField
        label {
            label: Ano
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 5
        }
        default {
            type: expression
            plsqlExpression: to_char(sysdate,'RRRR')
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P299_DATAFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 12
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P299_DATAINICIO (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 12
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P299_GRUPOFORNECEDOR (
        type: selectList
        label {
            label: Grupo de Fornecedores
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select descricao
                     , g.idgrupofornecedor 
                from gruposfornecedores g
                order by 1
                ```
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P299_IDCONTABANCARIA (
        type: selectList
        label {
            label: Conta Bancária
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(cb.beneficiario||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||') - Fornecedor: '||pck_romance.fnc_nomefornecedor(f.idfornecedor) display_value
                     , cb.idcontabanc    return_value
                from contasbancarias cb
                   , bancos b
                   , fornecedores f
                where cb.idbanco      = b.idbanco
                  and cb.idpessoa     = f.idpessoa
                  and cb.ativo        = 'S'
                  and ( :P299_IDFORNECEDOR is null or f.idpessoa = :P299_IDFORNECEDOR )
                order by 1
                ```
            nullDisplayValue: - Todas -
        }
        cascadingLov {
            parentItems: P299_IDFORNECEDOR
        }
        layout {
            sequence: 110
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P299_IDFORNECEDOR (
        type: popupLov
        label {
            label: Fornecedor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefornecedor(idfornecedor) ||'  --  '||pck_romance.fnc_nomepessoa(idpessoa) ||'   ID:'||idfornecedor display_value
                     , fe.idpessoa return_value
                from fornecedores fe
                where fe.ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 80
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P299_MES (
        type: selectList
        label {
            label: Mês
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(mes) display_value
                     , numero return_value
                from meses 
                order by 2
                ```
            displayExtraValues: false
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P299_TIPO_FORNECEDOR (
        type: radioGroup
        label {
            alignment: left
        }
        settings {
            noOfCols: 4
        }
        lov {
            type: staticValues
            staticValues: STATIC:Fornecedor;F,Fornecedores Personalizado;P,Grupo de Fornecedores;G,Todos;T
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: F
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P299_TIPO_MOVIMENTACAO (
        type: radioGroup
        label {
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Faturas;S,Pagamentos;E,Ambos;A
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 130
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: A
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P299_TIPO_PESQUISA (
        type: radioGroup
        label {
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Período;P,Mês/Ano;M,- Tudo -;T
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: P
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P299_TIPO_RELATORIO (
        type: radioGroup
        label {
            label: Relatório
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Detalhado;D,Resumido;R,Geral;G
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 120
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: R
        }
        security {
            encryptSessionState: false
        }
    )

    button buscar (
        buttonName: BUSCAR
        label: Buscar
        layout {
            sequence: 10
            region: @filtros
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button filtrar-fornecedores (
        buttonName: FILTRAR_FORNECEDORES
        label: + Fornecedores
        layout {
            sequence: 100
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 310
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button relatorio-por-fatura (
        buttonName: RELATORIO_POR_FATURA
        label: Ir para Relatório por Faturas
        layout {
            sequence: 20
            region: @filtros
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 307
                items: {
                    P307_IDFORNECEDOR: &P299_IDFORNECEDOR.
                    P307_IDCONTABANCARIA: &P299_IDCONTABANCARIA.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P299_IDFORNECEDOR is not null or :P299_IDCONTABANCARIA is not null
        }
    )

    dynamicAction p (
        name: P
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P299_TIPO_FORNECEDOR
        }
        clientSideCondition {
            type: item=value
            item: P299_TIPO_FORNECEDOR
            value: P
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: button
                button: @filtrar-fornecedores
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: button
                button: @filtrar-fornecedores
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction pesquisa-grupo (
        name: Pesquisa Grupo
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P299_TIPO_FORNECEDOR
        }
        clientSideCondition {
            type: item=value
            item: P299_TIPO_FORNECEDOR
            value: G
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P299_GRUPOFORNECEDOR
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P299_GRUPOFORNECEDOR
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo-mes-ano (
        name: Tipo Mes/Ano
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P299_TIPO_PESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P299_TIPO_PESQUISA
            value: M
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P299_MES
                    P299_ANO
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P299_MES
                    P299_ANO
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo-periodo (
        name: Tipo Periodo
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P299_TIPO_PESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P299_TIPO_PESQUISA
            value: P
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P299_DATAINICIO
                    P299_DATAFIM
                    P299_ANO
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P299_DATAINICIO
                    P299_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo-pesquisa-f (
        name: Tipo Pesquisa F
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P299_TIPO_FORNECEDOR
        }
        clientSideCondition {
            type: item=value
            item: P299_TIPO_FORNECEDOR
            value: F
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P299_IDFORNECEDOR
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P299_IDFORNECEDOR
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tpo-relatório (
        name: Tpo Relatório
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P299_TIPO_RELATORIO
        }
        clientSideCondition {
            type: item=value
            item: P299_TIPO_RELATORIO
            value: D
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P299_TIPO_MOVIMENTACAO
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P299_TIPO_MOVIMENTACAO
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: Go To Page 299
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 299
                items: {
                    P299_TIPO_PESQUISA: &P299_TIPO_PESQUISA.
                    P299_MES: &P299_MES.
                    P299_ANO: &P299_ANO.
                    P299_IDFORNECEDOR: &P299_IDFORNECEDOR.
                    P299_IDCONTABANCARIA: &P299_IDCONTABANCARIA.
                    P299_TIPO_MOVIMENTACAO: &P299_TIPO_MOVIMENTACAO.
                    P299_TIPO_RELATORIO: &P299_TIPO_RELATORIO.
                    P299_DATAINICIO: &P299_DATAINICIO.
                    P299_DATAFIM: &P299_DATAFIM.
                    P299_TIPO_FORNECEDOR: &P299_TIPO_FORNECEDOR.
                    P299_GRUPOFORNECEDOR: &P299_GRUPOFORNECEDOR.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

)

