    region extrato-de-fornecedor-geral (
        name: Extrato de Fornecedor - Geral
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.idextratocontabancaria
                     , ( select pck_romance.fnc_nomepessoa( c.idpessoa)
                         from contasbancarias c
                         where c.idcontabanc = e.idcontabancaria ) destino
                     , pck_cadastros_rmc.fnc_retornacontabancaria(e.idcontabancaria) conta 
                     , ( select initcap(c.beneficiario)
                         from contasbancarias c
                         where c.idcontabanc = e.idcontabancaria ) beneficiario    
                     , e.datamovimento
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2650 || ':27:'||v('APP_SESSION')||'::NO::P27_IDNOTAFISCAL:'||( select v.idnotafiscal
                                                                                                                                                            from vencimentos v
                                                                                                                                                            where v.idvencimento = e.idvencimento ),'SESSION')||''',''_blank''); void(0)">'||'Fatura em Andamento '||( select nn.documento
                                                                                                                                                                                                                                                                       from notasfiscais nn
                                                                                                                                                                                                                                                                          , vencimentos  vv
                                                                                                                                                                                                                                                                       where nn.idnotafiscal = vv.idnotafiscal
                                                                                                                                                                                                                                                                         and vv.idvencimento = e.idvencimento )||'</a>' motivo                        
                     , e.valormovimento
                     , extract(month from e.datamovimento) mes
                from extratoscontasbancarias e       
                where ( :P299_TIPO_PESQUISA   = 'T'
                     or ( :P299_TIPO_PESQUISA = 'P' and trunc(e.datamovimento) between to_date(:P299_DATAINICIO,'DD/MM/RRRR') and to_date(:P299_DATAFIM,'DD/MM/RRRR') )
                     or ( :P299_TIPO_PESQUISA = 'M' and extract (month from e.datamovimento) = :P299_MES ) 
                     or ( :P299_TIPO_PESQUISA = 'A' and extract (year from e.datamovimento) = :P299_ANO ) )
                  and e.valormovimento < 0 
                  and e.contabilizar     = 'S'
                  and ( :P299_IDCONTABANCARIA is null or e.idcontabancaria = :P299_IDCONTABANCARIA )
                  and exists ( select 1
                               from contasbancarias c
                               where c.idcontabanc = e.idcontabancaria
                                 and c.idpessoa = :P299_IDFORNECEDOR ) 
                  and ( :P299_TIPO_MOVIMENTACAO = 'A' 
                     or ( :P299_TIPO_MOVIMENTACAO = 'S' and e.valormovimento < 0 )
                     or ( :P299_TIPO_MOVIMENTACAO = 'E' and e.valormovimento > 0 ) )
                  and :P299_TIPO_RELATORIO = 'G'
                union
                select e.idextratocontabancaria
                     , ( select pck_romance.fnc_nomepessoa( c.idpessoa)
                         from contasbancarias c
                         where c.idcontabanc = e.idcontabancaria ) destino
                     , pck_cadastros_rmc.fnc_retornacontabancaria(e.idcontabancaria) conta   
                     , ( select initcap(c.beneficiario)
                         from contasbancarias c
                         where c.idcontabanc = e.idcontabancaria ) beneficiario  
                     , nvl(e.datamovimento,dr.data)  datamovimento
                     , 'Comprovante ainda não recebido'
                     , dr.valordeposito
                     , extract(month from e.datamovimento) mes
                from extratoscontasbancarias e  
                   , depositosdiarios_orig dr     
                where dr.iddepositodiarios = e.iddepositodiario_orig
                  and ( :P299_TIPO_PESQUISA   = 'T'
                     or ( :P299_TIPO_PESQUISA = 'P' and trunc(e.datamovimento) between to_date(:P299_DATAINICIO,'DD/MM/RRRR') and to_date(:P299_DATAFIM,'DD/MM/RRRR') )
                     or ( :P299_TIPO_PESQUISA = 'M' and extract (month from e.datamovimento) = :P299_MES ) 
                     or ( :P299_TIPO_PESQUISA = 'A' and extract (year from e.datamovimento) = :P299_ANO ) )
                  and e.valormovimento > 0 
                  and e.contabilizar     = 'S'
                  and not exists ( select 1
                                   from depositosdiarios_leituraocr dl
                                   where dl.iddepositodiario = dr.iddepositodiarios )
                  and ( :P299_IDCONTABANCARIA is null or e.idcontabancaria = :P299_IDCONTABANCARIA )
                  and exists ( select 1
                               from contasbancarias c
                               where c.idcontabanc = e.idcontabancaria
                                 and c.idpessoa = :P299_IDFORNECEDOR ) 
                  and ( :P299_TIPO_MOVIMENTACAO = 'A' 
                     or ( :P299_TIPO_MOVIMENTACAO = 'S' and e.valormovimento < 0 )
                     or ( :P299_TIPO_MOVIMENTACAO = 'E' and e.valormovimento > 0 ) )
                  and :P299_TIPO_RELATORIO = 'G'
                  -- Maicon Aimi - 29/05/2024 - Ticket 9069925
                  and ( e.iddepositodiario_orig is null or exists ( select 1
                                                                    from roman.depositosdiarios_orig dl
                                                                    where dl.iddepositodiarios = e.iddepositodiario_orig
                                                                      and dl.idrepresentante   = 387 ) 
                                                        or exists ( select 1
                                                                    from roman.depositosdiarios_leituraocr d
                                                                    where d.iddepositodiario = e.iddepositodiario_orig
                                                                      and d.valor_digitado is not null ) )
                union
                select e.idextratocontabancaria
                     , ( select pck_romance.fnc_nomepessoa( c.idpessoa)
                         from contasbancarias c
                         where c.idcontabanc = e.idcontabancaria ) destino
                     , pck_cadastros_rmc.fnc_retornacontabancaria(e.idcontabancaria) conta   
                     , ( select initcap(c.beneficiario)
                         from contasbancarias c
                         where c.idcontabanc = e.idcontabancaria ) beneficiario  
                     , nvl(e.datamovimento,dr.datadeposito)  datamovimento
                     , 'Comprovante '||dr.nroidentificacao_digitado
                     , dr.valor_digitado
                     , extract(month from e.datamovimento) mes
                from extratoscontasbancarias e  
                   , depositosdiarios_leituraocr dr     
                where dr.iddepositodiario = e.iddepositodiario_orig
                  and ( :P299_TIPO_PESQUISA   = 'T'
                     or ( :P299_TIPO_PESQUISA = 'P' and trunc(e.datamovimento) between to_date(:P299_DATAINICIO,'DD/MM/RRRR') and to_date(:P299_DATAFIM,'DD/MM/RRRR') )
                     or ( :P299_TIPO_PESQUISA = 'M' and extract (month from e.datamovimento) = :P299_MES ) 
                     or ( :P299_TIPO_PESQUISA = 'A' and extract (year from e.datamovimento) = :P299_ANO ) )
                  and e.valormovimento > 0 
                  and e.contabilizar     = 'S'
                  and  ( :P299_IDCONTABANCARIA is null or e.idcontabancaria = :P299_IDCONTABANCARIA )
                  and exists ( select 1
                               from contasbancarias c
                               where c.idcontabanc = e.idcontabancaria
                                 and c.idpessoa = :P299_IDFORNECEDOR )
                  and ( :P299_TIPO_MOVIMENTACAO = 'A' 
                     or ( :P299_TIPO_MOVIMENTACAO = 'S' and e.valormovimento < 0 )
                     or ( :P299_TIPO_MOVIMENTACAO = 'E' and e.valormovimento > 0 ) )
                  and :P299_TIPO_RELATORIO = 'G'
                order by 4
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P299_TIPO_RELATORIO
            value: G
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 3298305379903328143
        }

