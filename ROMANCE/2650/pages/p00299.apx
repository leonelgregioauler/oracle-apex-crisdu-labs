    region extrato-de-fornecedor-resumido (
        name: Extrato de Fornecedor - Resumido
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomepessoa(c.idpessoa) destino
                     , pck_cadastros_rmc.fnc_retornacontabancaria(c.idcontabanc) conta
                     , initcap(c.beneficiario ) beneficiario  
                     , sum( case 
                             when e.valormovimento < 0 then
                                e.valormovimento
                             else
                                0
                              end ) saidas
                     , sum( case 
                             when e.valormovimento < 0 then
                                0
                             else
                                e.valormovimento
                              end ) entradas
                     , sum(e.valormovimento) saldo
                     , ( select sum(valordeposito)
                         from depositosdiarios_orig dl
                         where dl.idrepresentante   != 387        
                           and dl.idcontabanc      = c.idcontabanc
                            and ( :P299_TIPO_PESQUISA   = 'T'
                             or ( :P299_TIPO_PESQUISA = 'P' and trunc(dl.data)  between  to_date(:P299_DATAINICIO,'DD/MM/RRRR') and to_date(:P299_DATAFIM,'DD/MM/RRRR'))
                             or ( :P299_TIPO_PESQUISA = 'M' and ( :P299_MES is null or extract (month from dl.data) = :P299_MES ) 
                                                            and extract (year from dl.data) = :P299_ANO ) )
                           and not exists ( select 1
                                            from depositosdiarios  dd
                                            where dd.iddepositodiarios = dl.iddepositodiarios )
                           and not exists ( select 1
                                            from depositosdiarios_leituraocr d
                                            where d.iddepositodiario = dl.iddepositodiarios
                                              and d.valor_digitado is not null ) )  semfoto
                   ,c.idcontabanc
                from extratoscontasbancarias e  
                   , contasbancarias         c
                where e.idcontabancaria  = c.idcontabanc
                  and e.contabilizar     = 'S'
                  and ( e.iddepositodiario_orig is null or exists ( select 1
                                                                    from depositosdiarios_orig dl
                                                                    where dl.iddepositodiarios = e.iddepositodiario_orig
                                                                      and dl.idrepresentante   = 387 ) 
                                                        or exists ( select 1
                                                                    from depositosdiarios_leituraocr d
                                                                    where d.iddepositodiario = e.iddepositodiario_orig
                                                                      and d.valor_digitado is not null ) )
                  and ( :P299_TIPO_PESQUISA   = 'T'
                     or ( :P299_TIPO_PESQUISA = 'P' and trunc(e.datamovimento)  between  to_date(:P299_DATAINICIO,'DD/MM/RRRR') and to_date(:P299_DATAFIM,'DD/MM/RRRR'))
                     or ( :P299_TIPO_PESQUISA = 'M' and ( :P299_MES is null or extract (month from e.datamovimento) = :P299_MES ) 
                                                    and extract (year from e.datamovimento) = :P299_ANO ) )   
                  and ( :P299_TIPO_FORNECEDOR is null 
                       or ( :P299_TIPO_FORNECEDOR = 'F' and c.idpessoa = :P299_IDFORNECEDOR ) 
                       or ( :P299_TIPO_FORNECEDOR = 'G' and exists ( select 1
                                                                     from gruposfornecedores gf
                                                                        , fornecedores f
                                                                        , fornecedoresgruposforn fg
                                                                     where gf.idgrupofornecedor = :P299_GRUPOFORNECEDOR
                                                                       and fg.idgrupofornecedor = gf.idgrupofornecedor
                                                                       and f.idfornecedor       = fg.idfornecedor
                                                                       and f.idpessoa           = c.idpessoa ) )
                       or ( :P299_TIPO_FORNECEDOR = 'P' and exists ( select 1
                                                                     from fornecedores f
                                                                        , filtrosfornecedores ff
                                                                     where ff.idfornecedor = f.idfornecedor
                                                                       and f.idpessoa      = c.idpessoa
                                                                       and ff.usuario      = v('APP_USER') ) ) ) 
                  and ( :P299_IDCONTABANCARIA is null or c.idcontabanc = :P299_IDCONTABANCARIA ) 
                  and ( :P299_TIPO_MOVIMENTACAO = 'A' 
                     or ( :P299_TIPO_MOVIMENTACAO = 'S' and e.valormovimento < 0 )
                     or ( :P299_TIPO_MOVIMENTACAO = 'E' and e.valormovimento > 0 ) )
                  and :P299_TIPO_RELATORIO = 'R'
                group by c.idpessoa
                       , c.idcontabanc
                       , c.beneficiario 
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
