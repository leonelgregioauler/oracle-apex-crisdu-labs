page 299 (
    name: Extrato de Contas
    title: Extrato de Contas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region extrato-de-fornecedor-detalhado (
        name: Extrato de Fornecedor - Detalhado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select null idextratocontabancaria
                     , ( select pck_romance.fnc_nomepessoa( c.idpessoa)
                         from contasbancarias c
                         where c.idcontabanc = e.idcontabancaria ) destino
                     , pck_cadastros_rmc.fnc_retornacontabancaria(e.idcontabancaria) conta   
                     , ( select initcap(c.beneficiario)
                         from contasbancarias c
                         where c.idcontabanc = e.idcontabancaria ) beneficiario  
                     , e.datamovimento  datamovimento
                     , null fatura
                     , e.descricao motivo  
                     , null empresadestino
                     , case
                         when sum(e.valormovimento) < 0 then
                           sum(e.valormovimento)
                         else 
                           null
                       end valorpagar
                     , case
                         when sum(e.valormovimento) > 0 then
                           sum(e.valormovimento)
                         else 
                           null
                       end valorpago  
                     , extract(month from e.datamovimento) mes     
                     , null id
                     , null cnpj
                from extratoscontasbancarias e    
                where e.contabilizar = 'N'
                  and :P299_TIPO_PESQUISA != 'T'
                  and ( :P299_TIPO_PESQUISA = 'T'
                     or ( :P299_TIPO_PESQUISA = 'P' and trunc(e.datamovimento) between to_date(:P299_DATAINICIO,'DD/MM/RRRR') and to_date(:P299_DATAFIM,'DD/MM/RRRR') )
                     or ( :P299_TIPO_PESQUISA = 'M' and ( :P299_MES is null or extract (month from e.datamovimento) = :P299_MES ) 
                                                    and extract (year from e.datamovimento) = :P299_ANO ) )                                         
                  and ( :P299_IDCONTABANCARIA is null or e.idcontabancaria = :P299_IDCONTABANCARIA )
                  and ( :P299_TIPO_FORNECEDOR = 'T' 
                       or ( :P299_TIPO_FORNECEDOR = 'F' and exists ( select 1
                                                                     from contasbancarias c
                                                                     where c.idcontabanc = e.idcontabancaria
                                                                       and c.idpessoa = :P299_IDFORNECEDOR ) ) 
                       or ( :P299_TIPO_FORNECEDOR = 'G' and exists ( select 1
                                                                     from gruposfornecedores gf
                                                                        , fornecedores f
                                                                        , fornecedoresgruposforn fg
                                                                        , contasbancarias c
                                                                     where gf.idgrupofornecedor = :P299_GRUPOFORNECEDOR
                                                                       and fg.idgrupofornecedor = gf.idgrupofornecedor
                                                                       and f.idfornecedor       = fg.idfornecedor
                                                                       and f.idpessoa           = c.idpessoa
                                                                       and c.idcontabanc        = e.idcontabancaria ) )
                       or ( :P299_TIPO_FORNECEDOR = 'P' and exists ( select 1
                                                                     from fornecedores f
                                                                        , filtrosfornecedores ff
                                                                        , contasbancarias c
                                                                     where ff.idfornecedor = f.idfornecedor
                                                                       and c.idcontabanc = e.idcontabancaria
                                                                       and f.idpessoa      = c.idpessoa
                                                                       and ff.usuario      = v('APP_USER') ) ) ) 
                  and :P299_TIPO_RELATORIO = 'D' 
                group by e.idcontabancaria
                       , e.datamovimento
                       , e.descricao
                union
                select null idextratocontabancaria
                     , ( select pck_romance.fnc_nomepessoa( c.idpessoa)
                         from contasbancarias c
                         where c.idcontabanc = e.idcontabancaria ) destino
                     , pck_cadastros_rmc.fnc_retornacontabancaria(e.idcontabancaria) conta   
                     , ( select initcap(c.beneficiario)
                         from contasbancarias c
                         where c.idcontabanc = e.idcontabancaria ) beneficiario  
                     , e.datamovimento  datamovimento
                     , null fatura
                     , e.descricao motivo  
                     , null empresadestino
                     , case
                         when sum(e.valormovimento) < 0 then
                           sum(e.valormovimento)
                         else 
                           null
                       end valorpagar
                     , case
                         when sum(e.valormovimento) > 0 then
                           sum(e.valormovimento)
                         else 
                           null
                       end valorpago  
                     , extract(month from e.datamovimento) mes     
                     , null id
                     , null cnpj
                from extratoscontasbancarias e    
                where e.contabilizar = 'S'
                  and e.idvencimento is null
                  and e.iddepositodiario_orig is null
                  and ( :P299_TIPO_PESQUISA = 'T'
                     or ( :P299_TIPO_PESQUISA = 'P' and trunc(e.datamovimento) between to_date(:P299_DATAINICIO,'DD/MM/RRRR') and to_date(:P299_DATAFIM,'DD/MM/RRRR') )
                     or ( :P299_TIPO_PESQUISA = 'M' and ( :P299_MES is null or extract (month from e.datamovimento) = :P299_MES ) 
                                                    and extract (year from e.datamovimento) = :P299_ANO ) )                                         
                  and ( :P299_IDCONTABANCARIA is null or e.idcontabancaria = :P299_IDCONTABANCARIA )
                  and ( :P299_TIPO_FORNECEDOR = 'T' 
                       or ( :P299_TIPO_FORNECEDOR = 'F' and exists ( select 1
                                                                     from contasbancarias c
                                                                     where c.idcontabanc = e.idcontabancaria
                                                                       and c.idpessoa = :P299_IDFORNECEDOR ) ) 
                       or ( :P299_TIPO_FORNECEDOR = 'G' and exists ( select 1
                                                                     from gruposfornecedores gf
                                                                        , fornecedores f
                                                                        , fornecedoresgruposforn fg
                                                                        , contasbancarias c
                                                                     where gf.idgrupofornecedor = :P299_GRUPOFORNECEDOR
                                                                       and fg.idgrupofornecedor = gf.idgrupofornecedor
                                                                       and f.idfornecedor       = fg.idfornecedor
                                                                       and f.idpessoa           = c.idpessoa
                                                                       and c.idcontabanc        = e.idcontabancaria ) )
                       or ( :P299_TIPO_FORNECEDOR = 'P' and exists ( select 1
                                                                     from fornecedores f
                                                                        , filtrosfornecedores ff
                                                                        , contasbancarias c
                                                                     where ff.idfornecedor = f.idfornecedor
                                                                       and c.idcontabanc = e.idcontabancaria
                                                                       and f.idpessoa      = c.idpessoa
                                                                       and ff.usuario      = v('APP_USER') ) ) ) 
                  and :P299_TIPO_RELATORIO = 'D' 
                group by e.idcontabancaria
                       , e.datamovimento
                       , e.descricao
                union
                select null idextratocontabancaria
                     , ( select pck_romance.fnc_nomepessoa( c.idpessoa)
                         from contasbancarias c
                         where c.idcontabanc = e.idcontabancaria ) destino
                     , pck_cadastros_rmc.fnc_retornacontabancaria(e.idcontabancaria) conta   
                     , ( select initcap(c.beneficiario)
                         from contasbancarias c
                         where c.idcontabanc = e.idcontabancaria ) beneficiario  
                     , e.datamovimento  datamovimento
                     , 'Fatura '||nn.documento fatura
                     , null motivo  
                     , pck_romance.fnc_nomefilial(nn.idfilialdestino) empresadestino
                     , sum(e.valormovimento) valorpagar
                     , null valorpago  
                     , extract(month from e.datamovimento) mes     
                     , null id
                     , nvl(( select r.cnpj
                             from razoessociaisfiliais r
                             where r.idrazaosocialfilial = nn.idrazaosocialfildestino ), ( select p.cnpj
                                                                                           from filiais fil
                                                                                              , pessoas p
                                                                                           where fil.idfilial = nn.idfilialdestino
                                                                                             and fil.idpessoa = p.idpessoa ) ) cnpj
                from extratoscontasbancarias e 
                   , notasfiscais nn
                   , vencimentos  vv      
                where nn.idnotafiscal = vv.idnotafiscal
                  and vv.idvencimento = e.idvencimento
                  and e.contabilizar  = 'S'
                  and ( :P299_TIPO_PESQUISA = 'T'
                     or ( :P299_TIPO_PESQUISA = 'P' and trunc(e.datamovimento) between to_date(:P299_DATAINICIO,'DD/MM/RRRR') and to_date(:P299_DATAFIM,'DD/MM/RRRR') )
                     or ( :P299_TIPO_PESQUISA = 'M' and ( :P299_MES is null or extract (month from e.datamovimento) = :P299_MES ) 
                                                    and extract (year from e.datamovimento) = :P299_ANO ) )
                  and e.valormovimento < 0                                                
                  and ( :P299_IDCONTABANCARIA is null or e.idcontabancaria = :P299_IDCONTABANCARIA )
                  and ( :P299_TIPO_FORNECEDOR = 'T'  
                       or ( :P299_TIPO_FORNECEDOR = 'F' and exists ( select 1
                                                                     from contasbancarias c
                                                                     where c.idcontabanc = e.idcontabancaria
                                                                       and c.idpessoa = :P299_IDFORNECEDOR ) ) 
                       or ( :P299_TIPO_FORNECEDOR = 'G' and exists ( select 1
                                                                     from gruposfornecedores gf
                                                                        , fornecedores f
                                                                        , fornecedoresgruposforn fg
                                                                        , contasbancarias c
                                                                     where gf.idgrupofornecedor = :P299_GRUPOFORNECEDOR
                                                                       and fg.idgrupofornecedor = gf.idgrupofornecedor
                                                                       and f.idfornecedor       = fg.idfornecedor
                                                                       and f.idpessoa           = c.idpessoa
                                                                       and c.idcontabanc        = e.idcontabancaria ) )
                       or ( :P299_TIPO_FORNECEDOR = 'P' and exists ( select 1
                                                                     from fornecedores f
                                                                        , filtrosfornecedores ff
                                                                        , contasbancarias c
                                                                     where ff.idfornecedor = f.idfornecedor
                                                                       and c.idcontabanc = e.idcontabancaria
                                                                       and f.idpessoa      = c.idpessoa
                                                                       and ff.usuario      = v('APP_USER') ) ) ) 
                  and ( :P299_TIPO_MOVIMENTACAO = 'A' 
                     or ( :P299_TIPO_MOVIMENTACAO = 'S' and e.valormovimento < 0 )
                     or ( :P299_TIPO_MOVIMENTACAO = 'E' and e.valormovimento > 0 ) )
                  and :P299_TIPO_RELATORIO = 'D' 
                group by e.idcontabancaria
                       , e.datamovimento
                       , nn.idfilialdestino
                       , nn.documento
                       , nn.idrazaosocialfildestino
                union
                select e.idextratocontabancaria                              idextratocontabancaria
                     , ( select pck_romance.fnc_nomepessoa( c.idpessoa)
                         from contasbancarias c
                         where c.idcontabanc = e.idcontabancaria )                   destino
                     , pck_cadastros_rmc.fnc_retornacontabancaria(e.idcontabancaria) conta   
                     , ( select initcap(c.beneficiario)
                         from contasbancarias c
                         where c.idcontabanc = e.idcontabancaria ) beneficiario  
                     , e.datamovimento  datamovimento
                     , null fatura
                     , case
                         when nvl(dr.transferencia,'N') = 'S' then
                           ' Transferencia '||dr.nroidentificacao_digitado 
                         when nvl(dr.pix,'N') = 'S' then
                           'Pix '||dr.nroidentificacao_digitado
                         else
                           ' Comprovante '||dr.nroidentificacao_digitado       
                       end motivo
                     , null empresadestino
                     , null valorpagar
                     , valor_digitado
                     , extract(month from e.datamovimento) mes     
                     , dr.idleituraocr_deposito id
                     , null
                from extratoscontasbancarias e  
                   , depositosdiarios_leituraocr dr     
                where dr.iddepositodiario = e.iddepositodiario_orig 
                  and e.contabilizar  = 'S'
                  and ( :P299_TIPO_PESQUISA   = 'T'
                     or ( :P299_TIPO_PESQUISA = 'P' and trunc(e.datamovimento) between to_date(:P299_DATAINICIO,'DD/MM/RRRR') and to_date(:P299_DATAFIM,'DD/MM/RRRR') )
                     or ( :P299_TIPO_PESQUISA = 'M' and ( :P299_MES is null or extract (month from e.datamovimento) = :P299_MES ) 
                                                    and extract (year from e.datamovimento) = :P299_ANO ) )
                  and e.valormovimento > 0           
                  and ( :P299_IDCONTABANCARIA is null or e.idcontabancaria = :P299_IDCONTABANCARIA )
                  and ( :P299_TIPO_FORNECEDOR = 'T'  
                       or ( :P299_TIPO_FORNECEDOR = 'F' and ( :P299_IDFORNECEDOR is null or exists ( select 1
                                                                                                     from contasbancarias c
                                                                                                     where c.idcontabanc = e.idcontabancaria
                                                                                                       and c.idpessoa = :P299_IDFORNECEDOR ) ) )
                       or ( :P299_TIPO_FORNECEDOR = 'G' and exists ( select 1
                                                                     from gruposfornecedores gf
                                                                        , fornecedores f
                                                                        , fornecedoresgruposforn fg
                                                                        , contasbancarias c
                                                                     where gf.idgrupofornecedor = :P299_GRUPOFORNECEDOR
                                                                       and fg.idgrupofornecedor = gf.idgrupofornecedor
                                                                       and f.idfornecedor       = fg.idfornecedor
                                                                       and f.idpessoa           = c.idpessoa
                                                                       and c.idcontabanc        = e.idcontabancaria ) )
                       or ( :P299_TIPO_FORNECEDOR = 'P' and exists ( select 1
                                                                     from fornecedores f
                                                                        , filtrosfornecedores ff
                                                                        , contasbancarias c
                                                                     where ff.idfornecedor = f.idfornecedor
                                                                       and c.idcontabanc = e.idcontabancaria
                                                                       and f.idpessoa      = c.idpessoa
                                                                       and ff.usuario      = v('APP_USER') ) ) ) 
                  and ( :P299_TIPO_MOVIMENTACAO = 'A' 
                     or ( :P299_TIPO_MOVIMENTACAO = 'S' and e.valormovimento < 0 )
                     or ( :P299_TIPO_MOVIMENTACAO = 'E' and e.valormovimento > 0 ) )
                  and :P299_TIPO_RELATORIO = 'D'
                union
                select e.idextratocontabancaria
                     , ( select pck_romance.fnc_nomepessoa( c.idpessoa)
                         from contasbancarias c
                         where c.idcontabanc = e.idcontabancaria ) destino
                     , pck_cadastros_rmc.fnc_retornacontabancaria(e.idcontabancaria) conta   
                     , ( select initcap(c.beneficiario)
                         from contasbancarias c
                         where c.idcontabanc = e.idcontabancaria ) beneficiario  
                     , e.datamovimento datamovimento
                     , null fatura
                     , e.descricao||
                         case
                           when do.observacao is not null and do.observacao != e.descricao then
                            '<br>'||do.observacao
                          end  motivo
                     , null empresadestino
                     , null valorpagar
                     , e.valormovimento
                     , extract(month from e.datamovimento) mes
                     , do.iddepositodiarios id
                     , null
                from extratoscontasbancarias e  
                   , depositosdiarios_orig do     
                where do.iddepositodiarios = e.iddepositodiario_orig
                  and e.contabilizar  = 'S'
                   and not exists ( select 1
                                   from depositosdiarios_leituraocr dl
                                   where dl.iddepositodiario = do.iddepositodiarios 
                                     and dl.valor_digitado is not null )
                  and ( :P299_TIPO_PESQUISA   = 'T'
                     or ( :P299_TIPO_PESQUISA = 'P' and trunc(e.datamovimento) between to_date(:P299_DATAINICIO,'DD/MM/RRRR') and to_date(:P299_DATAFIM,'DD/MM/RRRR') )
                     or ( :P299_TIPO_PESQUISA = 'M' and ( :P299_MES is null or extract (month from e.datamovimento) = :P299_MES ) 
                                                    and extract (year from e.datamovimento) = :P299_ANO ) )
                   
                  and e.valormovimento > 0 
                  and ( :P299_IDCONTABANCARIA is null or e.idcontabancaria = :P299_IDCONTABANCARIA )
                  and ( :P299_TIPO_FORNECEDOR = 'T' 
                       or ( :P299_TIPO_FORNECEDOR = 'F' and ( :P299_IDFORNECEDOR is null or exists ( select 1
                                                                                                     from contasbancarias c
                                                                                                     where c.idcontabanc = e.idcontabancaria
                                                                                                       and c.idpessoa = :P299_IDFORNECEDOR ) ) )
                       or ( :P299_TIPO_FORNECEDOR = 'G' and exists ( select 1
                                                                     from gruposfornecedores gf
                                                                        , fornecedores f
                                                                        , fornecedoresgruposforn fg
                                                                        , contasbancarias c
                                                                     where gf.idgrupofornecedor = :P299_GRUPOFORNECEDOR
                                                                       and fg.idgrupofornecedor = gf.idgrupofornecedor
                                                                       and f.idfornecedor       = fg.idfornecedor
                                                                       and f.idpessoa           = c.idpessoa
                                                                       and c.idcontabanc        = e.idcontabancaria ) )
                       or ( :P299_TIPO_FORNECEDOR = 'P' and exists ( select 1
                                                                     from fornecedores f
                                                                        , filtrosfornecedores ff
                                                                        , contasbancarias c
                                                                     where ff.idfornecedor = f.idfornecedor
                                                                       and c.idcontabanc = e.idcontabancaria
                                                                       and f.idpessoa      = c.idpessoa
                                                                       and ff.usuario      = v('APP_USER') ) ) ) 
                  and ( :P299_TIPO_MOVIMENTACAO = 'A' 
                     or ( :P299_TIPO_MOVIMENTACAO = 'S' and e.valormovimento < 0 )
                     or ( :P299_TIPO_MOVIMENTACAO = 'E' and e.valormovimento > 0 ) )
                  and :P299_TIPO_RELATORIO = 'D'
                  -- Maicon Aimi - 29/05/2024 - Ticket 9069925
                  and ( e.iddepositodiario_orig is null or exists ( select 1
                                                                    from roman.depositosdiarios_orig dl
                                                                    where dl.iddepositodiarios = e.iddepositodiario_orig
                                                                      and dl.idrepresentante   = 387 ) 
                                                        or exists ( select 1
                                                                    from roman.depositosdiarios_leituraocr d
                                                                    where d.iddepositodiario = e.iddepositodiario_orig
                                                                      and d.valor_digitado is not null ) )
                order by 4
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P299_TIPO_RELATORIO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 928848431273202843
        }

