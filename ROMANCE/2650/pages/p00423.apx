    region informações (
        name: Informações
        type: staticContent
        source {
            htmlCode:
                ```html
                <b>Positivo</b><br>
                01 - Recebimentos = Pagamentos recebidos da Favorita<br>
                02 - Retir.Ptos = Retirada de pontos das Consultoras<br>
                03 - Repasses p/Rmc = Transferência de mercadoria da Favorita para a Romance<br>
                <br>
                <br>
                <b>Negativo</b><br>
                05 - Despesas = Todas as despesas lançadas para a Favorita<br>
                06 - Comissões = Comissões pagas para os Distribuidores e Gestores<br>
                07 - Fornecedores = Faturas de despesas ou compras de Fornecedores<br>
                <br>
                <br>
                <b>Rateios: </b> Despesas rateadas entre as unidades da Favorita.
                <br>
                ```
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region investimento-anterior (
        name: Investimento anterior
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select i.valor 
                         from investimentos i
                         where i.idfilial   = 200 )+ nvl(( select sum(resultadodasemana)
                                                           from vw_investimentofavorita_mv2017 vw
                                                           where vw.idfilial  = v.idfilial
                                                             and vw.idsemana < v.idsemana ),0) saldoanterior
                     , idfechamento
                     , filial
                     , idfilial
                     , ano
                     , semana
                     , quitados
                     , fornpago
                     , vendaromance
                     , valornobanco
                     , retpontos
                     , dhreceb
                     , vendadir
                     , comissoes
                     , resultadodasemana
                     , resultadodasemana resultadodasemanat
                     , case when ( nvl( ( select sum(resultadodasemana)
                                        from vw_investimentofavorita_mv2017 vw
                                        where vw.idfilial  = v.idfilial
                                          and vw.idsemana < v.idsemana ),0)  
                                + resultadodasemana
                                +( select i.valor 
                                   from investimentos i
                                   where i.idfilial   = 200 )) > 0 then
                              'Retorno'
                          else
                              'Investimento'
                         end    observacao 
                     , nvl(( select sum(resultadodasemana)
                             from vw_investimentofavorita_mv2017 vw
                             where vw.idfilial  = v.idfilial
                               and vw.idsemana < v.idsemana ),0)
                           + resultadodasemana 
                           + ( select i.valor 
                             from investimentos i
                             where i.idfilial   = 200 ) investretorno 
                     , '|' s1
                     , '|' s2
                     , '-' me
                     , '=' ig
                     , idsemana
                from vw_investimentofavorita_mv2017 v
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
