    pageItem P423_PROXIMAATUALIZACAO (
        type: displayOnly
        label {
            label: " "
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 10
            region: @investimento-favorita
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select  '<font color"green">Atualizado em '|| to_char(LAST_DATE,'dd/mm/rrrr hh24:mi:ss')||', a próxima atualização será '|| to_char(next_date,'dd/mm/rrrr hh24:mi:ss')||'</font>' a
                from all_jobs
                where what like '%VW_INVESTIMENTOS_FAVORITA_NEW%'
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button quitados-do-ano (
        buttonName: Quitados_do_Ano
        label: Quitados do ano
        layout {
            sequence: 10
            region: @investimento-favorita
            slot: copy
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 221
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

