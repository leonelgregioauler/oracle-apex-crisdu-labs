    region investimento-favorita (
        name: Investimento Favorita
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select i.valor 
                         from investimentos i
                         where i.idfilial   = 200 )+ nvl(( select sum(resultadodasemana)
                                                           from vw_investimentofavorita_mv2017 vw
                                                           where vw.idfilial  = v.idfilial
                                                             and vw.idsemana < v.idsemana ),0)
                                                   + nvl(( select sum(resultadodasemana)
                                                           from VW_INVESTIMENTOS_FAVORITA_NEW vw
                                                           where vw.idfilial  = v.idfilial
                                                             and vw.idsemana < v.idsemana ),0) saldoanterior
                     , idfechamento
                     , filial
                     , idfilial
                     , ano
                     , semana
                     , quitados
                     , fornpago
                     , vendanovafavorita vendanovafavrmc
                     , retpontos
                     , (dhreceb + rateio_despesas) dhreceb
                     , comissoes
                     , resultadodasemana                 
                     , case 
                         when resultadodasemana > 0 then
                           'Retorno'
                         else
                           'Investimento'
                         end    observacao 
                     , ( select i.valor 
                         from investimentos i
                         where i.idfilial   = 200 )+ nvl(( select sum(resultadodasemana)
                                                           from vw_investimentofavorita_mv2017 vw
                                                           where vw.idfilial  = v.idfilial
                                                             and vw.idsemana <= v.idsemana ),0)
                                                   + nvl(( select sum(resultadodasemana)
                                                           from VW_INVESTIMENTOS_FAVORITA_NEW vw
                                                           where vw.idfilial  = v.idfilial
                                                             and vw.idsemana <= v.idsemana ),0) investretorno 
                     , '|' s1
                     , '|' s2
                     , '-' me
                     , '=' ig
                     , idsemana
                     , ( select we.quitados
                         from VW_INVESTI_FAVORITA_NEW_EXT we
                         where we.idfechamento = v.idfechamento ) recebimentos_ext
                     , ( select we.comissoes
                         from VW_INVESTI_FAVORITA_NEW_EXT we
                         where we.idfechamento = v.idfechamento ) comissoes_ext
                     , ( select we.fornpago
                         from VW_INVESTI_FAVORITA_NEW_EXT we
                         where we.idfechamento = v.idfechamento ) fornecedores_ext
                     , rateio
                     , resultadodasemanaliquido
                from VW_INVESTIMENTOS_FAVORITA_NEW v
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                Observações:<br>
                1 - Não é considerada Favorita Paris neste relatório.<br>
                2 - Está somando todas as empresas Favorita. (Antigamente não estava junto o exterior)
                ```
        }
