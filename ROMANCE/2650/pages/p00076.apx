    pageItem P76_IDPRODUTO (
        type: selectList
        label {
            label: Produto
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nomeproduto)||' - '||codigosisdist display_value
                     , idproduto  return_value
                from produtos p
                where idproduto in ( select idproduto
                                     from fornecedoresprodutos
                                     where idfornecedor = :P76_IDFORNECEDOR)
                  and not exists ( select 1
                                   from itenspedidocompra i
                                   where i.idpedidocompra = :P76_IDPEDIDOCOMPRA
                                     and i.idproduto = p.idproduto)
                  and :P76_IDITPEDIDOCOMPRA is null
                union
                select '- Selecione o Produto -' display_value
                     , null  return_value
                from dual
                where :P76_IDPRODUTO is null
                union
                select initcap(nomeproduto)||' - '||codigosisdist display_value
                     , idproduto  return_value
                from produtos p
                where idproduto = :P76_IDPRODUTO
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 100
            region: @itens-do-pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDPRODUTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

