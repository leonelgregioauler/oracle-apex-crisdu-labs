    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @itens-do-pedido
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 112
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 40
            region: @itens-do-pedido
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P76_IDITPEDIDOCOMPRA
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @itens-do-pedido
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P76_IDITPEDIDOCOMPRA
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @itens-do-pedido
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P76_IDITPEDIDOCOMPRA
        }
    )

    dynamicAction onchange (
        name: onChange
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P76_IDPRODUTO
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: PRODUTO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction set-focus (
        name: Set focus
        execution {
            sequence: 20
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: itemIsNull
            item: P76_IDPRODUTO
        }

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P76_IDPRODUTO
            }
            execution {
                sequence: 10
            }
        )

