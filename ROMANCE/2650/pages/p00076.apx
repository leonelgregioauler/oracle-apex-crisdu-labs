page 76 (
    name: Itens do Pedido
    title: Itens do Pedido
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function formatReal( int )
            {
                    var tmp = int+'';
                    tmp = tmp.replace(/([0-9]{2})$/g, ",$1");
                    if( tmp.length > 6 )
                            tmp = tmp.replace(/([0-9]{3}),([0-9]{2}$)/g, ".$1,$2");
            
                    return tmp;
            }
            
            function fnc_soma()
            {
                vvlr = document.getElementById('P76_CUSTOUND').value;
                vvlr = vvlr.replace('.','');
                vvlr = vvlr.replace(',','.');
                document.getElementById('P76_QTDTOTAL').value = Number(document.getElementById('P76_QTDPP').value)+
                                                              Number(document.getElementById('P76_QTDP').value)+
                                                              Number(document.getElementById('P76_QTDM').value)+
                                                              Number(document.getElementById('P76_QTDG').value)+
                                                              Number(document.getElementById('P76_QTDGG').value)+
                                                              Number(document.getElementById('P76_QTDEGG').value)+
                                                              Number(document.getElementById('P76_QTDEXGG').value)+
                                                              Number(document.getElementById('P76_QTDXXGG').value)+
                                                              Number(document.getElementById('P76_QTDU').value);
                
               vtotal = Number(document.getElementById('P76_QTDTOTAL').value) * Number(vvlr);
               vtotal = vtotal.toFixed(2);
               vtotal = String(vtotal).replace('.','');
               document.getElementById('P76_VALORTOTAL').value = formatReal(vtotal );
            	 
            }
            
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
