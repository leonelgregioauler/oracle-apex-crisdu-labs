    region itens (
        name: Itens
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select iditpedidocompra
                     , idpedidocompra
                     , pck_romance.fnc_nomeproduto( idproduto) produto
                     , custound
                     , valortotal
                     , observacao
                     , qtdpp
                     , qtdp
                     , qtdm
                     , qtdg
                     , qtdgg
                     , qtdegg
                     , qtdexgg
                     , qtdxxgg
                     , qtdu
                     , qtdtotal
                from itenspedidocompra i
                where idpedidocompra = :P76_IDPEDIDOCOMPRA
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
