        column IDCIDADE (
            reportColumnQueryId: 11
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Cidade
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(nomecidade) ||' - '||e.sigla display_value
                    , idcidade return_value
                    from cidades c
                       , estados e
                    where c.idestado = e.idestado
                    order by 1
                    ```
                nullDisplayValue: - Seleciona a Cidade do Cheque -
            }
            layout {
                sequence: 12
            }
            appearance {
                width: 16
            }
        )

        column IDCONTBANC (
            reportColumnQueryId: 22
            derivedColumn: N
            type: selectList
            heading {
                heading: Conta Bancária
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(cb.beneficiario||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||')' display_value
                         , cb.idcontabanc    return_value
                    from contasbancarias cb
                       , bancos b
                    where cb.idbanco      = b.idbanco
                      and cb.idfornecedor = :P49_IDFORNECEDOR
                      AND cb.idcontabanc    = :P49_IDCONTBANC
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 23
            }
            serverSideCondition {
                type: never
            }
        )

        column IDENTIFICACAO (
            reportColumnQueryId: 25
            derivedColumn: N
            type: selectList
            heading {
                heading: Identificação
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select descricao
                         , ididentificacaocheque
                    from identificacaocheques c
                    order by 1
                    ```
            }
            layout {
                sequence: 26
            }
        )

        column IDFILIALDESTINO (
            reportColumnQueryId: 26
            derivedColumn: N
            type: selectList
            heading {
                heading: Empresa Destino
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nome
                        , idfilial
                    from vw_filiais f
                    where f.ativo = 'S'
                      and f.tipofilial != 'D'
                    ```
            }
            layout {
                sequence: 27
            }
        )

        column IDFORNECEDOR (
            reportColumnQueryId: 14
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Fornecedor
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_romance.fnc_nomepessoa(idpessoa) display_value
                         , idfornecedor return_value
                    from fornecedores 
                    order by 1
                    ```
                nullDisplayValue: - Selecione o fornecedor destino -
            }
            layout {
                sequence: 15
            }
            default {
                type: item
                item: P49_IDFORNECEDOR
            }
            serverSideCondition {
                type: never
            }
        )

        column IDPESSOA (
            reportColumnQueryId: 27
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Pessoa
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(trim(p.nomepessoa)) display_value
                         , P.IDPESSOA return_value
                    from pessoas p
                    where p.ativo = 'S'
                    order by 1
                    ```
                nullDisplayValue: - Selecione a Pessoa -
            }
            layout {
                sequence: 10
            }
        )

        column IDREPRESENTANTE (
            reportColumnQueryId: 10
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Distribuidor
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_romance.fnc_nomepessoa(r.idpessoa)||' ( '||pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(r.idrepresentante))||' )' display_value
                         , r.idrepresentante return_value
                    from representantes r
                    where idgerente = ( select idgerente from gerentes where idfilial = :P49_IDFILIAL)
                    order by 1
                    ```
                nullDisplayValue: - Selecione o Distribuidor-
            }
            layout {
                sequence: 11
            }
            appearance {
                width: 30
            }
        )

