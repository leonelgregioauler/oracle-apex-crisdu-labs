    process valida-pessoa (
        name: Valida_pessoa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  if :IDREPRESENTANTE is null and :IDPESSOA is null then
                    --
                    raise_application_error(-20001,'IDREPRESENTANTE: '||:IDREPRESENTANTE||' / IDPESSOA: '||:IDPESSOA);
                    --raise_application_error(-20001,'Informe Pessoa ou Distribuidor');
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 3629052856811770602
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

