        column IDCIDADE (
            type: popupLov
            heading {
                heading: Cidade
            }
            settings {
                displayAs: modalDialog
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(nomecidade) ||' - '||e.sigla display_value
                    , idcidade return_value
                    from cidades c
                       , estados e
                    where c.idestado = e.idestado
                    order by 1
                    ```
            }
            layout {
                sequence: 120
            }
            source {
