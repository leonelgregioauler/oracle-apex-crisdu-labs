    region inclusão-de-cheques-old (
        name: Inclusão de Cheques OLD
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDCHEQUE",
                "IDCHEQUE" IDCHEQUE_DISPLAY,
                "LEITURA",
                "CODBANCO",
                "AGENCIA",
                "CONTA",
                "NRCHEQUE",
                "IDBANCO",
                "DATAINCLUSAO",
                "IDREPRESENTANTE",
                "IDCIDADE",
                "VALOR",
                "PREDATADO",
                "IDFORNECEDOR",
                "OBSERVACAO",
                "DESTINO",
                "CODCOMPENSACAO",
                "SEMFUNDO",
                "PAGO",
                "ENVIADOCOBRANCA",
                "DATACOBRANCA",
                "IDCONTBANC",
                "EMPRESTIMO",
                "CHEQUEPREDATADO",
                "IDENTIFICACAO",
                "IDFILIALDESTINO",
                "IDPESSOA"
                from "#OWNER#"."CHEQUES2"
                where 1 = 2
                ```
        }
        layout {
            sequence: 15
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P49_INCLUI
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Clique em Inserir Linhas!
        }
        componentAdvanced {
            stripHtml: true
        }

