page 49 (
    name: Inclusão de cheques
    alias: MULTICHEQUES
    title: Inclusão de cheques
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                <script language="javascript">
                  function incluicheques() 
                    {
                      vfilial = document.getElementById('P49_IDFILIAL').options[document.getElementById('P49_IDFILIAL').selectedIndex].value;
                      //vforn = document.getElementById('P49_IDFORNECEDOR').options[document.getElementById('P49_IDFORNECEDOR').selectedIndex].value;
                      //vcont = document.getElementById('P49_IDCONTBANC').options[document.getElementById('P49_IDCONTBANC').selectedIndex].value;
                        if (document.getElementById('P49_SEMFUNDO_0').checked)  
                        { 
                            vsf = document.getElementById('P49_SEMFUNDO_0').value;
                        }
                        else
                        { 
                            vsf = '' 
                        }
                        if (document.getElementById('P49_ENVIADOCOBRANCA_0').checked)  
                        { 
                            vec = document.getElementById('P49_ENVIADOCOBRANCA_0').value;
                        }
                        else
                        { 
                            vec =''; 
                        }
                        if (document.getElementById('P49_EMPRESTIMO_0').checked)  
                        { 
                            vemp = document.getElementById('P49_EMPRESTIMO_0').value;
                        }
                        else
                        { 
                            vemp =''; 
                        }
                        if (document.getElementById('P49_CHEQUEPREDATADO_0').checked)  
                        { 
                            vpre = document.getElementById('P49_CHEQUEPREDATADO_0').value;
                        }
                        else
                        { 
                            vpre =''; 
                        }
                        window.location='f?p=&APP_ID.:49:&SESSION.::NO::P49_IDFILIAL,P49_SEMFUNDO,P49_ENVIADOCOBRANCA,P49_EMPRESTIMO,P49_CHEQUEPREDATADO,P49_INCLUI:'+vfilial+','+vsf+','+vec+','+vemp+','+vpre+',s'; 
                    }
                </script>
                ```
        }
    )

    region inclusão-de-cheques (
        name: Inclusão de Cheques
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idcheque, 
                leitura, 
                codbanco, 
                agencia, 
                conta, 
                nrcheque, 
                idbanco, 
                datainclusao, 
                idrepresentante, 
                idcidade, 
                valor, 
                predatado, 
                idfornecedor, 
                observacao, 
                destino, 
                codcompensacao, 
                semfundo, 
                pago, 
                enviadocobranca, 
                datacobranca, 
                datapago, 
                idcontbanc, 
                idfilial, 
                idsemanadtinclusao, 
                numeroconsulta, 
                emprestimo, 
                perda, 
                chequepredatado, 
                identificacao, 
                idfilialdestino, 
                distrato, 
                juros, 
                taxas, 
                idunidadedestino, 
                idpessoa
                  from CHEQUES2 c
                where 1 = 2
                ```
        }
        layout {
            sequence: 25
            slot: body-3
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: add
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 3629375906400934110
        }

