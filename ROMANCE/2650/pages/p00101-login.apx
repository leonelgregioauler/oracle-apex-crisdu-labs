page 101 (
    name: Login
    alias: LOGIN
    title: Login
    appearance {
        pageTemplate: @/login
        templateOptions: #DEFAULT#
        cssClasses: login
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            .image_login {
                background-image: url("#APP_FILES#img_login.jpg");
            }
            
            /* === Responsividade - Tablet === */
            @media screen and (max-width: 992px) {
                #content_image_login {
                    padding: 30px 20px;
                }
                #login_asset_optimus_branco {
                    max-width: 160px;
                }
                #text_image_login h4 {
                    font-size: 1.1rem;
                }
                #text_image_login p {
                    font-size: 0.85rem;
                }
                #logos_grupo {
                    max-width: 160px;
                }
            }
            
            /* === Responsividade - Mobile === */
            @media screen and (max-width: 768px) {
                /* Oculta a coluna inteira do painel de imagem */
                body.login .col-start {
                    display: none !important;
                }
                /* Coluna do formulario ocupa 100% da tela */
                body.login .col-end {
                    flex: 0 0 100% !important;
                    max-width: 100% !important;
                    width: 100% !important;
                    padding: 0 16px !important;
                }
                /* Regiao de login centralizada */
                .login_region {
                    width: 100% !important;
                    max-width: 420px !important;
                    margin: 20px auto !important;
                    box-sizing: border-box !important;
                }
                /* Inputs ocupam largura total */
                .input100P {
                    width: 100% !important;
                    box-sizing: border-box !important;
                }
                /* Botoes ocupam largura total */
                .btn_login,
                .btn_primeiro_acesso {
                    width: 100% !important;
                    display: block !important;
                }
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        enableDuplicatePageSubmissions: false
        reloadOnSubmit: always
    }

    region background-image (
        name: Background Image
        type: staticContent
        source {
            htmlCode:
                ```html
                <div id="content_image_login">
                    <img src="#APP_FILES#logo_optimus_branco.png" id="login_asset_optimus_branco">
                    <div id="text_image_login">
                        <h4>Sua gestão, mais inteligente.</h4>
                        <p>Centralize atividades, acompanhe processos e acesse todas as ferramentas<br/>em um único ambiente.</p>
                        <img id="logos_grupo" alt="logo crisdu" src="#APP_FILES#logos_grupo.png"/>
                    </div>
                </div>
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: image_login
        }
    )

    region seja-bem-vindo-ao-optimus-financeiro (
        name: Seja Bem-vindo ao Optimus Financeiro!
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
            startNewRow: false
            columnAttributes: align="center"
        }
        appearance {
            template: @/login
            templateOptions: #DEFAULT#
            cssClasses: login_region
        }
        advanced {
            customAttributes: align="center"
        }
        settings {
            outputAs: text
        }
    )

    pageItem LABELOU (
        type: displayOnly
        label {
            label: Labelou
            alignment: left
        }
        layout {
            sequence: 30
            region: @seja-bem-vindo-ao-optimus-financeiro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
            cssClasses: label_redefinir_senha
        }
    )

    pageItem P101_PASSWORD (
        type: password
        label {
            label: Senha
            alignment: left
        }
        layout {
            sequence: 20
            region: @seja-bem-vindo-ao-optimus-financeiro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            cssClasses: [
                input100P
                input_password
            ]
            width: 20
        }
        validation {
            maxLength: 20
        }
        source {
            used: always
        }
        sessionState {
            storage: request
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P101_USERNAME (
        type: textField
        label {
            label: Usuário
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 10
            region: @seja-bem-vindo-ao-optimus-financeiro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            cssClasses: [
                input100P
                input_username
            ]
            width: 20
        }
        validation {
            maxLength: 20
        }
        advanced {
            postText: <span class="t-Login-iconValidation a-Icon icon-check"></span>
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button p101-login (
        buttonName: P101_LOGIN
        label: Entrar
        layout {
            sequence: 20
            region: @seja-bem-vindo-ao-optimus-financeiro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
            cssClasses: [
                btn_login
                btn_black
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: P101_LOGIN
        }
    )

    button p101-redefinirsenha (
        buttonName: P101_REDEFINIRSENHA
        label: Redefinir Senha
        layout {
            sequence: 40
            region: @seja-bem-vindo-ao-optimus-financeiro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
            cssClasses: [
                btn_redefinir_senha
                btn_white
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 106
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation controle-de-autenticação (
        name: Controle de autenticação
        execution {
            sequence: 20
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                   vRetorno boolean;
                begin
                   vRetorno := PCK_AUDITORIAROMANCE.fnc_validalogin(pusuario => :P101_USERNAME);
                
                
                   if not vRetorno then
                      return 'Usuário inativo';
                   end if;
                end;
                ```
        }
        error {
            associatedItem: @P101_USERNAME
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 from parametros
                where idfilial = 340
                and nome = 'CONTROLE_AUTENTICACAO'
                and valor = 'S';
                ```
        }
    )

    validation p101-username (
        name: P101_USERNAME
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuariossistemas u
                where u.usuario = trim(upper(v('P101_USERNAME')))
                and u.idsistema = 2600
                and u.ativo = 'S'
                ```
        }
        error {
            errorMessage: Você não tem permissão de acesso a este sistema!
            displayLocation: inlineInNotification
        }
    )

    process clear-page-s-cache (
        name: Clear Page(s) Cache
        type: clearSessionState
        execution {
            sequence: 30
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 180969356799438625
        }
    )

    process get-username-cookie (
        name: Get Username Cookie
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    v varchar2(255) := null;
                    c owa_cookie.cookie;
                begin
                   c := owa_cookie.get('LOGIN_USERNAME_COOKIE');
                   :P101_USERNAME := c.vals(1);
                exception when others then null;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 180969258275438625
        }
    )

    process login (
        name: Login
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                wwv_flow_custom_auth_std.login(
                    P_UNAME       => trim(:P101_USERNAME),
                    P_PASSWORD    => :P101_PASSWORD,
                    P_SESSION_ID  => v('APP_SESSION'),
                    P_FLOW_PAGE   => :APP_ID||':1'
                    );
                ```
        }
        execution {
            sequence: 20
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 180969067144438625
        }
    )

    process set-username-cookie (
        name: Set Username Cookie
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    SendorAddress   varchar2(30) := 'sistema@crisdu.com.br';
                    ReceiverAddress varchar2(30) := 'everton@romancemoda.com.br';
                    EmailServer     varchar2(30) := 'smtp.crisdu.com.br';
                    Port            number  := 587;
                    conn UTL_SMTP.CONNECTION;
                    crlf VARCHAR2(2):= CHR(13) || CHR(10);
                    mesg VARCHAR2(4000);
                    vnome    varchar(100);
                    verro varchar2(1000);
                begin
                  --
                  owa_util.mime_header('text/html', FALSE);
                  owa_cookie.send(name=>'LOGIN_USERNAME_COOKIE',
                                  value=>lower(:P101_USERNAME));
                  --
                /*  conn:= utl_smtp.open_connection(EmailServer,Port);
                  utl_smtp.auth(c => conn
                               , username => 'sistema@crisdu.com.br'
                               , password => 'Inf~roman@1');
                  utl_smtp.helo(conn,EmailServer);
                  utl_smtp.mail(conn,SendorAddress);
                  utl_smtp.rcpt(conn,nvl(ReceiverAddress,'ti@romancemoda.com.br'));
                  mesg:= 'Content-Type: text/plain; charset="UTF-8"' || crlf ||
                         'From:'||SendorAddress|| crlf ||
                         'Subject: Login no 600!' || crlf ||
                         'To: '||ReceiverAddress || crlf|| crlf ||
                         '' || crlf ||
                         'O usuario '||:P101_USERNAME||' efetuou login no 600.'|| crlf || crlf||
                         '-> '||to_char(sysdate,'dd/mm/rrrr hh24:mi:ss');
                  utl_smtp.data(conn,mesg);
                  utl_smtp.quit(conn);*/
                  --
                exception
                  when others then 
                     verro := sqlerrm;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 180969159119438625
        }
    )

)

