                    ```sql
                    select nome
                         , idfilial
                    from vw_filiais f
                    where f.ativo = 'S'
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 130
            }
            source {
                databaseColumn: IDFILIAL
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDFILIALDEST (
            type: selectList
            heading {
                heading: Destino
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nome
                         , idfilial
                    from vw_filiais f
                    where f.ativo = 'S'
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 140
                columnAlignment: center
            }
            source {
                databaseColumn: IDFILIALDEST
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
