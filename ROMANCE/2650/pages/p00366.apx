page 366 (
    name: Apoio de Regras para Saídas Diversas
    title: Apoio de Regras para Saídas Diversas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region apoio-de-regras-para-saídas-lançadas (
        name: Apoio de Regras para Saídas Lançadas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.idsaida
                     , s.idfilial
                     , s.idfilialdest 
                     , s.data
                     , (select nomeconta
                        from contasfinanceiras c
                        where c.idcontafinan = s.idcontacontabil) conta
                     , (select nomeconta
                        from subcontasfinanceiras sc
                        where sc.idsubcontafinan = s.idsubcontacontabil) subconta
                     , s.valortotal
                     , s.descricao
                     , s.idmatrizclassificacao
                from saidasdiversas s
                where ( :P366_TIPOPESQUISA is null
                      or ( :P366_TIPOPESQUISA = 'S' and exists ( select 1
                                                                 from fechamentossemanais f
                                                                 where f.idfechamento = s.idfechamento
                                                                   and f.idsemana     = :P366_SEMANA )  )
                      or ( :P366_TIPOPESQUISA = 'P' and trunc(s.data) between to_date(:P366_DATAINICIO) and to_date(:P366_DATAFIM) ) )
                  and ( :P366_IDFILIAL is null or s.idfilial = :P366_IDFILIAL )
                  and ( :P366_COM_MATRIZ = 'A'
                    or ( :P366_COM_MATRIZ = 'S' and s.idmatrizclassificacao is null )
                    or ( :P366_COM_MATRIZ = 'C' and s.idmatrizclassificacao is not null ) )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        performance {
            lazyLoading: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 8230360389621931402
        }

