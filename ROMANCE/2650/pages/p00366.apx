        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
    )

    button buscar (
        buttonName: BUSCAR
        label: Buscar Despesas
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction tipo (
        name: Tipo
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P366_TIPOPESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P366_TIPOPESQUISA
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P366_SEMANA
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P366_DATAINICIO
                    P366_DATAFIM
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P366_SEMANA
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P366_DATAINICIO
                    P366_DATAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    process apoio-de-regras-para-saídas-lançadas-save-interactive-grid-data (
        name: Apoio de Regras para Saídas Lançadas - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @apoio-de-regras-para-saídas-lançadas
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 4130619387451507088
        }
        serverSideCondition {
            whenButtonPressed: @aplicar
        }
    )

    branch (
        name: Go To Page 366
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 366
                items: {
                    P366_TIPOPESQUISA: &P366_TIPOPESQUISA.
                    P366_IDFILIAL: &P366_IDFILIAL.
                    P366_DATAINICIO: &P366_DATAINICIO.
                    P366_DATAFIM: &P366_DATAFIM.
                    P366_COM_MATRIZ: &P366_COM_MATRIZ.
                    P366_SEMANA: &P366_SEMANA.
                }
                clearCache: 366
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

)

