                layout {
                    frozen: true
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDMATRIZCLASSIFICACAO
                layout {
                    width: 391
                    sequence: 10
                }
            )

            displayColumn (
                column: @CONTA
                layout {
                    width: 159
                    sequence: 5
                }
            )

            displayColumn (
                column: @SUBCONTA
                layout {
