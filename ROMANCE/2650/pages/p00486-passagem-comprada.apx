page 486 (
    name: Passagem Comprada
    alias: PASSAGEM-COMPRADA
    title: Passagem Comprada
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 60%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_remove(pidpessoapassagem)
            {
                apex.confirm("Deseja realmente remover este passageiro da passagem?", {
              request:"DELETAR",
              set:{"P486_IDREMOVER":pidpessoapassagem}
              });
            }
            ```
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region passageiros (
        name: Passageiros
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpessoaconvencao
                     , p.nomecompleto nome
                     , p.documento passaporte
                     , p.datavencimentodocumento vencimento_passaporte
                     , p.rg
                     , p.cpf
                     , p.datanascimento
                     , pck_romance.fnc_nomecidade(p.origem) origem
                     , '<a href="javascript: fnc_remove('||pp.idpessoapassagemconvencao||');">Remover</a>' remover
                from pessoasconvencao p
                   , pessoaspassagensconvencao pp
                where pp.idpessoaconvencao = p.idpessoaconvencao
                  and pp.idpassagemconvencao = :P486_IDPASSAGEMCONVENCAO
                order by 2
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum passageiro cadastrado!
        }
        advanced {
            savedReportMappingIdentifier: 92896189063758639
        }

        column CPF (
            type: plainText
            heading {
                heading: Cpf
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

