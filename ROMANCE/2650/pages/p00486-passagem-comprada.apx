    button adicionar-passageiros (
        buttonName: ADICIONAR_PASSAGEIROS
        label: Adicionar Passageiros
        layout {
            sequence: 10
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 488
                items: {
                    P488_IDPASSAGEMCONVENCAO: &P486_IDPASSAGEMCONVENCAO.
                    P488_PAGINA: 486
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button anexos (
        buttonName: ANEXOS
        label: Anexos
        layout {
            sequence: 10
            region: @buttons
            slot: edit
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 492
                items: {
                    P492_IDANEXODELETAR:
                    P492_IDANEXOPASSAGEM:
                    P492_IDPASSAGEM: &P486_IDPASSAGEMCONVENCAO.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 327
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button delete (
        buttonName: DELETE
        label: Excluir
        layout {
            sequence: 10
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button update (
        buttonName: UPDATE
        label: SALVAR
        layout {
            sequence: 20
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process processo-dml-em-passagens-compradas (
        name: Processo DML em Passagens Compradas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  PCK_CADASTROS_RMC.PRC_PASSAGENSCONVENCAO ( PIDPASSAGEMCONVENCAO => :P486_IDPASSAGEMCONVENCAO
                                                           , PTIPO_PASSAGEM => :P486_TIPO_PASSAGEM
                                                           , PCOMPANHIA => :P486_COMPANHIA
                                                           , PNUMERO_VOO => :P486_NUMERO_VOO
                                                           , PLOCALIZADOR => :P486_LOCALIZADOR
                                                           , PDATA => :P486_DATA
                                                           , PHORA_PARTIDA => :P486_HORA_PARTIDA
                                                           , PHORA_CHEGADA => :P486_HORA_CHEGADA
                                                           , PSTATUS_VOO => :P486_STATUS_VOO
                                                           , PCOMPRAR_HOTEL => :P486_COMPRAR_HOTEL
                                                           , PVALOR => :P486_VALOR
                                                           , PAEROPORTO_ORIGEM => :P486_AEROPORTO_ORIGEM
                                                           , PAEROPORTO_DESTINO => :P486_AEROPORTO_DESTINO
                                                           , PMD5 => :P486_MD5
                                                           , POPERACAO_DML => 'S' );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 92895996703758637
        }
    )

    process processo-dml-em-passagens-convencao (
        name: Processo DML em Passagens Convencao
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  --
                  if v('REQUEST') = 'UPDATE' then
                    --
                    voperacao_dml := 'U';
                    --
                  elsif v('REQUEST') = 'DELETE' then
                    --
                    voperacao_dml := 'D';
                    --
                  end if;
                  --
                  PCK_CADASTROS_RMC.PRC_PASSAGENSCONVENCAO ( PIDPASSAGEMCONVENCAO => :P486_IDPASSAGEMCONVENCAO
                                                           , PTIPO_PASSAGEM => :P486_TIPO_PASSAGEM
                                                           , PCOMPANHIA => :P486_COMPANHIA
                                                           , PNUMERO_VOO => :P486_NUMERO_VOO
                                                           , PLOCALIZADOR => :P486_LOCALIZADOR
                                                           , PDATA => :P486_DATA
                                                           , PHORA_PARTIDA => :P486_HORA_PARTIDA
                                                           , PHORA_CHEGADA => :P486_HORA_CHEGADA
                                                           , PSTATUS_VOO => :P486_STATUS_VOO
                                                           , PCOMPRAR_HOTEL => :P486_COMPRAR_HOTEL
                                                           , PVALOR => :P486_VALOR
                                                           , PAEROPORTO_ORIGEM => :P486_AEROPORTO_ORIGEM
                                                           , PAEROPORTO_DESTINO => :P486_AEROPORTO_DESTINO
                                                           , PMD5 => :P486_MD5
                                                           , POPERACAO_DML => voperacao_dml );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 94152956317620454
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('UPDATE','DELETE')
        }
    )

    process remove-passageiro (
        name: Remove Passageiro
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  delete pessoaspassagensconvencao p
                  where p.idpessoapassagemconvencao = :P486_IDREMOVER;
                  --
                  :P486_IDREMOVER := null;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Passageiro removido com suecsso!
        }
        advanced {
            executionMappingIdentifier: 186636331519049528
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

)

