            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 942654 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CPF (
                sequence: 5
            )

            displayColumn DATANASCIMENTO (
                sequence: 6
            )

            displayColumn NOME (
                sequence: 1
            )

            displayColumn ORIGEM (
                sequence: 7
            )

            displayColumn PASSAPORTE (
                sequence: 2
            )

            displayColumn REMOVER (
                sequence: 8
            )

            displayColumn RG (
                sequence: 4
            )

            displayColumn VENCIMENTO_PASSAPORTE (
                sequence: 3
            )

        )

    )

