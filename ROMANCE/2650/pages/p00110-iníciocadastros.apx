page 110 (
    name: Cadastros
    alias: INÍCIOCADASTROS
    title: Cadastros
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region cadastros (
        name: Cadastros
        type: list
        source {
            list: @cadastros
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            listTemplate: @/cards
            templateOptions: [
                #DEFAULT#
                t-Cards--featured force-fa-lg
                t-Cards--displayIcons
                t-Cards--4cols
                u-colors
                t-Cards--animColorFill
            ]
        }
    )

    region clientes-ativos (
        name: Clientes Ativos
        type: chart
        layout {
            sequence: 20
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: pie
        }
        title {
            title: Clientes Ativos
        }
        chartLayout {
            height: 800
        }
        performance {
            lazyLoading: true
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }

        series clientes-ativos (
            name: Clientes Ativos
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select null link
                         , pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(idrepresentante)) display
                         , count(1) value
                    from representantes
                    where ativo = 'S'
                      and pck_romance.fnc_filialrepresentante(idrepresentante) is not null
                    group by pck_romance.fnc_filialrepresentante(idrepresentante)
                    ```
            }
            columnMapping {
                label: DISPLAY
                value: VALUE
            }
            label {
                show: true
            }
        )

    )

)

