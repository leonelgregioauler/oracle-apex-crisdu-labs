    pageItem P39_IDCONTA_DESTINO (
        type: selectList
        label {
            label: Conta Destino
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(cb.beneficiario,p.apelido)||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||') - Empresa Destino: '||pck_romance.fnc_nomefilial(f.idfilial)||' - V3= '||pck_romance.fnc_nomepessoa(idpessoa_relatorio) display_value
                     , cb.idcontabanc    return_value
                from contasbancarias cb
                   , bancos b
                   , pessoas p
                   , notasfiscais nf
                   , filiais         f
                where cb.idbanco      = b.idbanco
                  and cb.idpessoa     = p.idpessoa
                  and f.idpessoa      = p.idpessoa
                  and f.idfilial      = nf.idfilialdestino
                  and cb.ativo        = 'S'
                  and nf.idnotafiscal = :P39_IDNOTAFISCAL
                  and (cb.tipoconta is null or cb.tipoconta = 'F')
                order by 1
                ```
            nullDisplayValue: - Selecione a Conta -
        }
        layout {
            sequence: 250
            region: @vencimentos-da-nf
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDCONTA_DESTINO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

