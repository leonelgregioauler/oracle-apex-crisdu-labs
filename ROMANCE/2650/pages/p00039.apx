    dynamicAction create (
        name: create
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @create
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: CREATE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction feriado (
        name: Feriado
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P39_DATAVENCIMENTO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                        select 'S'
                          into :P39_FERIADO
                          from favorita.feriados
                         where dataferiado = :P39_DATAVENCIMENTO;
                      exception
                        when no_data_found then
                          :P39_FERIADO:='N';
                         
                    end;
                    ```
                itemsToSubmit: P39_DATAVENCIMENTO
                itemsToReturn: P39_FERIADO
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction mensagem (
        name: Mensagem
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P39_FERIADO
        }
        clientSideCondition {
            type: item=value
            item: P39_FERIADO
            value: S
        }

        action native-alert (
            action: alert
            settings {
                message: Feriado neste dia!
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction mostra-conta-para-v (
        name: Mostra Conta para V2
        execution {
            sequence: 70
        }
        when {
            selectionType: items
            items: P39_GERA_V2
        }
        clientSideCondition {
            type: item=value
            item: P39_GERA_V2
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P39_IDCONTA_DESTINO
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P39_IDCONTA_DESTINO
            }
            execution {
                sequence: 10
