        }
    )

    pageItem P39_IDCONTABANC (
        type: selectList
        label {
            label: Conta para Depósito/Transf
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(cb.beneficiario,p.apelido)||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||') - Fornecedor: '||initcap(p.nomepessoa) display_value
                     , cb.idcontabanc    return_value
                from contasbancarias cb
                   , bancos b
                   , pessoas p
                   , fornecedores f
                   , notasfiscais nf
                where cb.idbanco      = b.idbanco
                  and cb.idpessoa     = p.idpessoa
                  and f.idpessoa      = p.idpessoa
                  and f.idfornecedor  = nf.idfornemitente
                  and cb.ativo        = 'S'
                  and nf.idnotafiscal = :P39_IDNOTAFISCAL
                union
                select initcap(nvl(cb.beneficiario,p.apelido)||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||') - Fornecedor Destino: '||pck_romance.fnc_nomefornecedor(f.idfornecedor) display_value
                     , cb.idcontabanc    return_value
                from contasbancarias cb
                   , bancos b
                   , pessoas p
                   , fornecedores f
                   , notasfiscais nf
                where cb.idbanco      = b.idbanco
                  and cb.idpessoa     = p.idpessoa
                  and f.idpessoa      = p.idpessoa
                  and f.idfornecedor  = nf.idfornecedordestino
                  and cb.ativo        = 'S'
                  and nf.idnotafiscal = :P39_IDNOTAFISCAL
                  order by 1
                /*select initcap(nvl(cb.beneficiario,p.apelido)||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||') - Fornecedor: '||initcap(p.nomepessoa) display_value
                     , cb.idcontabanc    return_value
                from roman.contasbancarias cb
                   , roman.bancos b
                   , catal.pessoas p
                   , catal.fornecedores f
                   , roman.notasfiscais nf
                where cb.idbanco      = b.idbanco
                  and cb.idfornecedor = f.idfornecedor  -- FIX 15823832: vincula pelo fornecedor, nao mais por idpessoa
                  and f.idpessoa      = p.idpessoa      -- mantido so pra exibicao do nome da pessoa
                  and f.idfornecedor  = nf.idfornemitente
                  and cb.ativo        = 'S'
                  and nf.idnotafiscal = :P39_IDNOTAFISCAL
                union
                select initcap(nvl(cb.beneficiario,p.apelido)||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||') - Fornecedor Destino: '||roman.pck_romance.fnc_nomefornecedor(f.idfornecedor) display_value
                     , cb.idcontabanc    return_value
                from roman.contasbancarias cb
                   , roman.bancos b
                   , catal.pessoas p
                   , catal.fornecedores f
                   , roman.notasfiscais nf
                where cb.idbanco      = b.idbanco
                  and cb.idfornecedor = f.idfornecedor  -- FIX 15823832: vincula pelo fornecedor, nao mais por idpessoa
                  and f.idpessoa      = p.idpessoa      -- mantido so pra exibicao do apelido no fallback do beneficiario
                  and f.idfornecedor  = nf.idfornecedordestino
                  and cb.ativo        = 'S'
                  and nf.idnotafiscal = :P39_IDNOTAFISCAL
                  order by 1;
                */
                ```
        }
        layout {
            sequence: 180
            region: @vencimentos-da-nf
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDCONTABANC
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P39_IDCONTAFINANCEIRA (
        type: selectList
        label {
            label: Conta
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomeconta     display_value
                     , idcontafinan  return_value
                from contasfinanceiras c
                where ativo = 'S'
                  and exists ( select 1
                               from matrizregrasdespesas md
                               where md.idmatrizregra = :P39_IDMATRIZREGRA
                                 and md.idcontafinan = c.idcontafinan ) 
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P39_IDMATRIZREGRA
        }
        layout {
            sequence: 120
            region: @vencimentos-da-nf
