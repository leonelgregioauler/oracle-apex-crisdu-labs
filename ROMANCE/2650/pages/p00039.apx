    pageItem P39_LINHADIGITAVEL (
        type: displayOnly
        label {
            label: Linha Digitável
            alignment: left
        }
        settings {
            showLineBreaks: false
            sendOnPageSubmit: false
        }
        layout {
            sequence: 65
            region: @vencimentos-da-nf
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select rp.linhadigitavel
                from roman.requisicoespagamentos rp
                   , roman.vencimentos v
                where v.idvencimento    = :P39_IDVENCIMENTO
                  and v.tipopagamento   = 'G'
                  and rp.idnotafiscal   = v.idnotafiscal
                  and rp.linhadigitavel is not null
                  and rownum = 1
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select rp.linhadigitavel
                from roman.requisicoespagamentos rp
                   , roman.vencimentos v
                where v.idvencimento    = :P39_IDVENCIMENTO
                  and v.tipopagamento   = 'G'
                  and rp.idnotafiscal   = v.idnotafiscal
                  and rp.linhadigitavel is not null
                  and rownum = 1
                ```
        }
        security {
            encryptSessionState: false
        }
        comments {
            comments: Ticket 16244255 - Linha digitável informada na requisição de pagamento (vinculada pela nota fiscal). Exibida somente quando o vencimento é Guia (G).
        }
    )

    pageItem P39_MENSAGEM (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
            sendOnPageSubmit: false
        }
        layout {
            sequence: 50
            region: @vencimentos-da-nf
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select 
                case
                  when sum(n.valorliquido) - nvl( ( select sum( v.valor - nvl(v.desconto,0) + nvl(v.acrescimo,0) )  
                                                    from vencimentos  v 
                                                    where v.idnotafiscal  = n.idnotafiscal ),0) > 0 then
                     chr(60)||'b'||chr(62)||chr(60)||'font color=red> Divergência no Total da NF: </b>'||to_char(sum(n.valorliquido),'FML999G999G990D00') ||' <b>com Total de vencimentos: </b>'||to_char(nvl( (select sum( v.valor - nvl(v.desconto,0) + nvl(v.acrescimo,0) )  
                                                from vencimentos  v 
                                                where v.idnotafiscal  = n.idnotafiscal ),0),'FML999G999G990D00')||'</font>'
                  when sum(n.valorliquido) - nvl(( select sum( v.valor - nvl(v.desconto,0) + nvl(v.acrescimo,0) )  
                                                 from vencimentos  v 
                                                 where v.idnotafiscal  = n.idnotafiscal),0) < 0 then
                    chr(60)||'b'||chr(62)||chr(60)||'font color=red> Divergência no Total da NF: </b>'||to_char(sum(n.valorliquido),'FML999G999G990D00') ||' <b>com Total de vencimentos: </b>'||to_char(nvl( (select sum( v.valor - nvl(v.desconto,0) + nvl(v.acrescimo,0) )  
                                                from vencimentos  v 
                                                where v.idnotafiscal  = n.idnotafiscal ),0),'FML999G999G990D00')||'</font>'
                end
                from notasfiscais n
                where n.idnotafiscal = :P39_IDNOTAFISCAL
                group by n.idnotafiscal
                ```
            used: always
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P39_TIPONOTA in ('D','C')
        }
        security {
            encryptSessionState: false
        }
    )

