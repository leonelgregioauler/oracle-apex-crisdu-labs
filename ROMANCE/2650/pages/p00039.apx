    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 40
            region: @vencimentos-da-nf
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
            databaseAction: insert
        }
        advanced {
            htmlDomId: INSERT
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                 --Somente mostra o botão Inserir caso exista vencimento com pagamento não realizado. 
                 --Union para não afetar os demais tipos de nota. 
                select 1
                from ( select distinct (1) teste1
                       from roman.notasfiscais nf
                         , ( select count(v.idvencimento) cv
                             from roman.vencimentos v
                             where v.idnotafiscal = :P39_IDNOTAFISCAL) X
                         , ( select count( pg.idvencimento ) cp
                             from roman.pagamentosfornecedores pg 
                             where pg.idnotafiscal = :P39_IDNOTAFISCAL
                               and pg.databaixa is not null ) y
                       where  x.cv != y.cp ) z
                    ,( select 1 teste2
                      from roman.notasfiscais n
                      where n.idnotafiscal = :P39_IDNOTAFISCAL
                        and n.situacao = 'U'
                        and n.tiponota = 'R' )w 
                where z.teste1 = 1 
                  and w.teste2 = 1 
                and :P39_IDVENCIMENTO is null
                union
                select 1
                from roman.notasfiscais n 
                where n.tiponota != 'R'
                 and :P39_IDVENCIMENTO is null
                 and n.idnotafiscal = :P39_IDNOTAFISCAL;
                ```
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @vencimentos-da-nf
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                 --Somente mostra o botão Excluir caso o vencimento selecionado não tenha pagamento realizado. 
                 --Union para não afetar os demais tipos de nota. 
                select 1
                from roman.notasfiscais nf 
                   , roman.vencimentos v 
                where nf.idnotafiscal = v.idnotafiscal
                 and nf.situacao = 'U'
                 and nf.tiponota = 'R'
                 and v.idvencimento = :P39_IDVENCIMENTO 
                 and nf.idnotafiscal = :P39_IDNOTAFISCAL
                 and not exists ( select 1
                                  from roman.pagamentosfornecedores pf
                                  where pf.idnotafiscal = nf.idnotafiscal
                                    and pf.idvencimento = v.idvencimento
                                    and pf.databaixa is not null )
                union
                select 1
                from roman.notasfiscais n 
                where n.tiponota != 'R'
                 and :P39_IDVENCIMENTO is not null
                 and n.idnotafiscal = :P39_IDNOTAFISCAL;
                ```
        }
    )

