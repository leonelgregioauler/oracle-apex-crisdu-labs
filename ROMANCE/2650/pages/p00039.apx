    validation valida-alteração-de-informações (
        name: Valida Alteração de informações
        execution {
            sequence: 110
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentomovimentacoes fm
                   , pagamentosfornecedores  pf
                where fm.datafechamento  = pf.databaixa
                  and fm.idcontabancaria = pf.idcontapagamento
                  and pf.idvencimento    = :P39_IDVENCIMENTO
                  and not exists ( select 1
                                   from vencimentos v
                                   where v.idvencimento = :P39_IDVENCIMENTO 
                                     and v.gera_v3 = 'S' )
                union
                select 1
                  from roman.fechamentomovimentacoes f
                  where f.datafechamento  = :P39_DATAVENCIMENTO
                    and f.idcontabancaria = :P39_IDCONTABANCARIA
                  and not exists ( select 1
                                   from vencimentos v
                                   where v.idvencimento = :P39_IDVENCIMENTO 
                                     and v.gera_v3 = 'S' )
                ```
        }
        error {
            errorMessage: Fechamento já encerrado para este dia! Entre em contato com o responsável pelo fechamento.
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('DELETE','SAVE','CREATE')
        }
    )

