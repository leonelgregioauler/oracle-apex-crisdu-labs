        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
    )

    pageItem P39_ACRESCIMO (
        type: numberField
        label {
            label: Multa/ Juros(+)
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 160
            region: @vencimentos-da-nf
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 13
        }
        source {
            type: databaseColumn
            databaseColumn: ACRESCIMO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P39_AVISOALTERACAOREQ (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: html
        }
        layout {
            sequence: 20
            region: @vencimentos-da-nf
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            preText: <font color=red><h3>Notas de requisição precisam estar em situação de ajuste para alteração!</h3></font>
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.notasfiscais nf 
                where nf.situacao != 'U'
                 and nf.tiponota = 'R'
                 and :P39_IDVENCIMENTO is not null
                 and nf.idnotafiscal = :P39_IDNOTAFISCAL
                ```
        }
    )

    pageItem P39_DATAVENCIMENTO (
        type: datePickerJquery
        label {
            label: Data Vencimento
            alignment: left
        }
        layout {
            sequence: 100
            region: @vencimentos-da-nf
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 11
        }
        validation {
            maxLength: 10
        }
        source {
            type: databaseColumn
            databaseColumn: DATAVENCIMENTO
            used: always
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual 
                where exists ( select 1 
                              from roman.notasfiscais nf
                                 , roman.vencimentos v 
                              where v.idnotafiscal = nf.idnotafiscal
                                and nf.tiponota = 'R'
                                and nf.idnotafiscal = :P39_IDNOTAFISCAL
                                and v.idvencimento = :P39_IDVENCIMENTO 
                                and exists ( select 1
                                             from roman.rateiosnotasfiscais rt 
                                             where rt.idnotafiscal = nf.idnotafiscal ) )
                ```
        }
        security {
            encryptSessionState: false
        }
        comments {
            comments: "Deixado o campo data vencimento congelado somente para as notas que sejam do tipo R e que possuam rateio, as demais permite alterações na data de vencimento. "
        }
    )

