    validation valida-vencimento-duplicado (
        name: Valida Vencimento Duplicado
        execution {
            sequence: 150
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.vencimentos v 
                where v.idnotafiscal = :P39_IDNOTAFISCAL
                  and v.datavencimento = :P39_DATAVENCIMENTO
                  and exists ( select 1 
