                from dual
                where v('REQUEST') in ('CREATE')
                ```
        }
        comments {
            comments: "Validação aplicada somente para notas que possuam rateio, as demais notas segundo a Débora pode existir dois vencimentos com a mesma data. "
        }
    )

    process atualiza (
        name: "Atualiza "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  update vencimentos
                  set tipopagamento = :P39_TIPOPAGAMENTO
                    , idcontafinanceira     = :P39_IDCONTAFINANCEIRA
                    , idsubcontafinanceira  = :P39_IDSUBCONTAFINANCEIRA
                    , idcontabanc           = :P39_IDCONTABANC
                    , idmoeda               = :P39_IDMOEDA
                  where idnotafiscal  = :P39_IDNOTAFISCAL
                    and tipopagamento is null
                    and idcontabanc is null;
                end;
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 1279127890649936309
        }
    )

    process atualiza-prioridade (
        name: Atualiza prioridade
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vprioridade varchar2(1) := nvl(:P39_PRIORIDADE,'0');
                begin
                  --
                  if vprioridade != '1' then
                    vprioridade := null;
                  end if;
                  --
                  update pagamentosfornecedores
                  set prioridade = vprioridade 
                  where idvencimento = :P39_IDVENCIMENTO ;
                  --
                end;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 1403517191778779515
        }
    )

    process atualiza-provisao (
        name: Atualiza Provisao
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vtipopagamento varchar2(3) := :P39_TIPOPAGAMENTO;
                begin
                  --
                  if vtipopagamento = 'P' then
                    vtipopagamento := 'S';
                  else
                    vtipopagamento := null;
                  end if;
                  --
                  update notasfiscais
                  set provisao = vtipopagamento 
                  where idnotafiscal = :P39_IDNOTAFISCAL ;
                  --
                end;
                ```
        }
        execution {
            sequence: 90
        }
        advanced {
            executionMappingIdentifier: 367970708804213406
        }
    )

