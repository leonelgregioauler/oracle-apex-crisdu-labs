            sqlQuery:
                ```sql
                select nome
                     , c.idcentrodecusto
                from centrodecustos c
                where exists ( select 1
                               from matrizregrasdespesas md
                               where md.idcentrodecusto = c.idcentrodecusto
                                 and md.idmatrizregra   = :P39_IDMATRIZREGRA )
                order by 1
                
