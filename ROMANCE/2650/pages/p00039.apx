    validation valida-pagamento-existente-data-vencimento (
        name: Valida pagamento existente - Data Vencimento
        execution {
            sequence: 140
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.vencimentos v
                where v.idvencimento = :P39_IDVENCIMENTO
                  and v.idnotafiscal = :P39_IDNOTAFISCAL
                  and v.gera_v3 != 'S'
                  and v.datavencimento != :P39_DATAVENCIMENTO  -- Osiel - 26/09/2024 Projeto Melhorias Notas Despesas E Requisições
                  and exists ( select 1 
                               from roman.pagamentosfornecedores p 
                               where p.idnotafiscal = v.idnotafiscal
                                 and v.idvencimento = p.idvencimento
                                 and p.valorpago > 0 )
                ```
        }
        error {
            errorMessage: Não permitido alteração, pagamento já realizado.
            displayLocation: inlineInNotification
            associatedItem: @P39_DATAVENCIMENTO
        }
        serverSideCondition {
            whenButtonPressed: @save
