    process gera-vencimento-v (
        name: Gera Vencimento V2
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vdatavencimento date;
                  vvalor          number := :P39_VALOR*-1;
                  vnumbernull     number;
                  vidextrato      number;
                  vgeradeposito   varchar2(1) := 'N';
                  vtipopagamento  varchar2(1) := 'D';
                begin
                  --
                  vdatavencimento := to_date(:P39_DATAVENCIMENTO,'DD/MM/RRRR');
                  --
                  if v('REQUEST') = 'CREATE' then
                    :P39_OPERACAO_DML := 'I';
                  elsif v('REQUEST') = 'SAVE' then  
                    :P39_OPERACAO_DML := 'U';
                  elsif v('REQUEST') = 'DELETE' then  
                    :P39_OPERACAO_DML := 'D';
                  END IF;
                  --
                  :P39_OBSERVACAO := 'Movimentação Para Gerar Depósito V2';
                  --
                  if :P39_GERA_V2 = 'S' then
                    --
                    if :P39_OPERACAO_DML in ('U','D') then
                      --
                      begin
                        --
                        select e.idextratocontabancaria
                        into vidextrato
                        from extratoscontasbancarias e
                        where e.idvencimento_orig = :P39_IDVENCIMENTO;
                        --
                      exception
                        when no_data_found then
                          --
                          vidextrato := null;
                          --
                      end;
                      --
                    end if;
                    --
                    if vidextrato is null and :P39_OPERACAO_DML = 'U' then 
                      --
                      :P39_OPERACAO_DML := 'I';
                      --
                    end if;
                    --
                    pck_financeiro_rmc.prc_extratoscontasbancarias(pidextratocontabancaria => vidextrato,
                                                                   pdatamovimento => vdatavencimento,
                                                                   pvalormovimento => vvalor,
                                                                   pidcontabancaria => :P39_IDCONTA_DESTINO,
                                                                   pidvencimento => vnumbernull,
                                                                   pidnotafiscal => :P39_IDNOTAFISCAL,
                                                                   piddepositodiario_orig => vnumbernull,
                                                                   pdescricao => :P39_OBSERVACAO,
                                                                   pidentificado => :P39_IDENTIFICADO,
                                                                   ptipopagamento => vtipopagamento,
                                                                   pidextratocontabancaria_orig => vnumbernull,
                                                                   pgera_deposito => vgeradeposito,
                                                                   pidvencimento_orig => :P39_IDVENCIMENTO,
                                                                   pmd5 => :P39_MD5,
                                                                   poperacao_dml => :P39_OPERACAO_DML);
                      --
                  end if;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 98856789330063219
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('SAVE','CREATE')
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDVENCIMENTOS.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P39_IDVENCIMENTO := get_pk; 
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Não é possível obter valor de item de chave primária.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 179692417500648999
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

