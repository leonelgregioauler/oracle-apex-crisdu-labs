    region lista-de-vencimentos (
        name: Lista de Vencimentos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.dias
                     , v.datavencimento
                     , v.valor valororiginal
                     ,( v.valor - nvl(v.desconto,0) + nvl(v.acrescimo,0) ) valor 
                     , (  select initcap(cb.beneficiario||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||')'||' Cnpj:' ||cb.documento
                         --select initcap(cb.beneficiario||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||')'||'Cnpj:' ||p.cnpj
                         from bancos b
                            , contasbancarias cb
                            , catal.pessoas p
                         where cb.idbanco      = b.idbanco
                           and p.idpessoa = cb.idpessoa
                           and cb.idcontabanc = v.idcontabanc ) conta
                     , v.idvencimento
                     , v.tipopagamento codigotipopagamento
                     , ( select tp.descricao
                         from formaspagamentos  tp
                         where tp.idformapagamento = v.tipopagamento  ) tipopagamento
                     , v.observacao
                     , pck_romance.fnc_nomecontafinan(v.idcontafinanceira) idcontafinanceira
                     , pck_romance.fnc_nomesubcontafinan(v.idsubcontafinanceira) idsubcontafinanceira
                     , ( select m.sigla
                         from moedas m
                         where m.idmoeda = v.idmoeda ) idmoeda
                     , ( select sum(d.valordeposito)
                         from depositosdiarios d
                            , pagamentosfornecedores pg
                         where d.idpgtoforn = pg.idpgtoforn
                           and pg.idvencimento = v.idvencimento ) depositado
                     , decode(v.identificado,'S','Sim','N','Não') identificado
                     , ( select c.nome
                         from centrodecustos c
                         where c.idcentrodecusto = v.idcentrodecusto ) idcentrodecusto
                     , v.desconto
                     , v.acrescimo
                     , v.motivoatraso
                     , case
                         when exists ( select 1
                                       from extratoscontasbancarias ex
                                       where ex.idvencimento_orig = v.idvencimento ) then
                           'Gerado V3 na conta - '||( select initcap(cb.beneficiario||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||')' 
                                                      from bancos b
                                                         , contasbancarias cb
                                                         , extratoscontasbancarias ex
                                                      where cb.idbanco      = b.idbanco
                                                        and ex.idvencimento_orig = v.idvencimento
                                                        and cb.idcontabanc = ex.idcontabancaria )
                         else
                           'Normal'
                       end tipo_vencimento
                     , (select p2.databaixa
                          from roman.pagamentosfornecedores p2
                         where v.idvencimento = p2.idvencimento) databaixa
                from roman.vencimentos  v
                   
                where v.idnotafiscal  = :P39_IDNOTAFISCAL
                  and not exists ( select 1
                                   from extratoscontasbancarias ex
                                   where ex.idvencimento = v.idvencimento )
                ```
        }
