    region lista-de-vencimentos-2 (
        name: Lista de Vencimentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.dias
                     , v.datavencimento
                     , v.valor valororiginal
                     , ( v.valor - nvl(v.desconto,0) + nvl(v.acrescimo,0) ) valor 
                     , ( select initcap(nvl(cb.beneficiario,p.apelido)||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||')' 
                         from bancos b
                            , contasbancarias cb
                         where cb.idbanco      = b.idbanco
                           and cb.idcontabanc = v.idcontabanc ) conta
                     , v.idvencimento
                     , ( select descricao
                         from formaspagamentos t
                         where idformapagamento = v.tipopagamento ) "Tipo Pagamento"
                     , v.observacao "Observação"
                     , null link
                     , pg.idpgtoforn 
                     , ( select c.nomeconta  
                         from contasfinanceiras c
                         where c.idcontafinan = pg.idcontafinanceira ) contafinan
                    , ( select c.nomeconta
                        from subcontasfinanceiras c 
                        where c.idsubcontafinan = pg.idsubcontafinanceira ) subconta
                    , pck_util.fnc_siglamoedaid( v.idmoeda) moeda
                    , ( select sum(d.valordeposito)
                        from depositosdiarios d
                        where d.idpgtoforn = pg.idpgtoforn ) "Total Depositado"
                    , decode(v.identificado,'S','Sim','N','Não') identificado
                    , ( select cd.nome
                        from centrodecustos cd
                        where cd.idcentrodecusto = v.idcentrodecusto ) centrodecusto
                    , v.desconto
                    , v.acrescimo
                    , v.motivoatraso
                from pessoas p
                   , fornecedores f
                   , notasfiscais nf
                   , vencimentos  v
                   , pagamentosfornecedores pg
                where v.idnotafiscal  = nf.idnotafiscal
                  and f.idpessoa      = p.idpessoa
                  and f.idfornecedor  = nf.idfornemitente
                  and v.idvencimento  = pg.idvencimento
                  and nf.idnotafiscal = :P39_IDNOTAFISCAL
                union
                select v.dias
                     , v.datavencimento
                     , v.valor valororiginal
                     , ( v.valor - nvl(v.desconto,0) + nvl(v.acrescimo,0) ) valor 
                     , ( select initcap(nvl(cb.beneficiario,p.apelido)||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||')' 
                         from bancos b
                            , contasbancarias cb
                         where cb.idbanco      = b.idbanco
                           and cb.idcontabanc = v.idcontabanc ) conta
                     , v.idvencimento
                     , ( select descricao
                         from formaspagamentos t
                         where idformapagamento = v.tipopagamento ) "Tipo Pagamento"
                     , v.observacao "Observação"
                     , null link
                     , pg.idpgtoforn 
                     , ( select c.nomeconta  
                         from contasfinanceiras c
                         where c.idcontafinan = pg.idcontafinanceira ) contafinan
                    , ( select c.nomeconta
                        from subcontasfinanceiras c 
                        where c.idsubcontafinan = pg.idsubcontafinanceira ) subconta
                    , pck_util.fnc_siglamoedaid( v.idmoeda) moeda
                    , ( select sum(d.valordeposito)
                        from depositosdiarios d
                        where d.idpgtoforn = pg.idpgtoforn ) "Total Depositado"
                    , decode(v.identificado,'S','Sim','N','Não') identificado
                    , ( select cd.nome
                        from centrodecustos cd
                        where cd.idcentrodecusto = v.idcentrodecusto ) centrodecusto
                    , v.desconto
                    , v.acrescimo
                    , v.motivoatraso
                from pessoas p
                   , fornecedores f
                   , notasfiscais nf
                   , vencimentos  v
                   , pagamentosfornecedores pg
                where v.idnotafiscal  = nf.idnotafiscal
                  and f.idpessoa      = p.idpessoa
                  and v.idvencimento  = pg.idvencimento
                  and nf.idnotafiscal = :P39_IDNOTAFISCAL  
                  and exists ( select 1
                               from pagamentosfornecedores pgf
                               where pgf.idvencimento = v.idvencimento
                                 and pgf.idfornecedor = f.idfornecedor )
                union
                select v.dias
                     , v.datavencimento
                     , v.valor valororiginal
                     , ( v.valor - nvl(v.desconto,0) + nvl(v.acrescimo,0) ) valor 
                     , null conta
                     , v.idvencimento
                     , ( select descricao
                         from formaspagamentos t
                         where idformapagamento = v.tipopagamento ) "Tipo Pagamento"
                     , v.observacao "Observação"
                     , null link
                     , pg.idpgtoforn 
                     , ( select c.nomeconta  
                         from contasfinanceiras c
                         where c.idcontafinan = pg.idcontafinanceira ) contafinan
                    , ( select c.nomeconta
                        from subcontasfinanceiras c 
                        where c.idsubcontafinan = pg.idsubcontafinanceira ) subconta
                    , pck_util.fnc_siglamoedaid( v.idmoeda) moeda
                    , ( select sum(d.valordeposito)
                        from depositosdiarios d
                        where d.idpgtoforn = pg.idpgtoforn ) "Total Depositado"
                    , decode(v.identificado,'S','Sim','N','Não') identificado
                    , ( select cd.nome
                        from centrodecustos cd
                        where cd.idcentrodecusto = v.idcentrodecusto ) centrodecusto
                    , v.desconto
                    , v.acrescimo
                    , v.motivoatraso
                from notasfiscais nf
                   , vencimentos  v
                   , pagamentosfornecedores pg
                where v.idnotafiscal  = nf.idnotafiscal
                  and v.idcontabanc  is null
                  and v.idvencimento  = pg.idvencimento
                  and nf.idnotafiscal = :P39_IDNOTAFISCAL  
                  and exists ( select 1
                               from pagamentosfornecedores pgf
                               where pgf.idvencimento = v.idvencimento)
                order by 1
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: never
        }
        link {
            linkColumn: customTarget
