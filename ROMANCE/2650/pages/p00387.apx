page 387 (
    name: Compras Detalhadas da Lucratividade
    title: Compras Detalhadas da Lucratividade
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region mercadorias-detalhadas (
        name: Mercadorias Detalhadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select n.dtnf
                     , decode(n.tiponota,'D','Despesa','C','Compra','T','Transferencia','V','Venda','Outros') tipo
                     , case
                         when n.tiponota != 'T' then 
                           pck_romance.fnc_nomefornecedor(n.idfornemitente)
                         else
                           pck_romance.fnc_nomefilial(n.idfilialemitente)
                       end fornecedor
                     , n.documento
                     , n.valorliquido
                     , decode(n.situacaofilial,'A','Aguardando Recebimento','R','Recebida','Outros') situacao
                from notasfiscais n
                where n.idsemananota = :P387_SEMANAINI
                  and n.idfilialdestino = :P387_IDFILIAL
                --    and n.tiponota != 'E'
                  and exists ( select 1
                               from itemnf i
                                  , produtos pp
                               where i.idnotafiscal = n.idnotafiscal
                                 and i.idproduto    = pp.idproduto
                                 and pp.venda       = 'S' )
                order by 1
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 4899010403859749914
        }

        column DOCUMENTO (
            type: plainText
            heading {
                heading: Documento
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column DTNF (
            type: plainText
            heading {
                heading: Data Nota
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: A
            }
        )

        column FORNECEDOR (
            type: plainText
            heading {
                heading: Emitente
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column SITUACAO (
            type: plainText
            heading {
                heading: Situação
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column TIPO (
            type: plainText
            heading {
                heading: Tipo da Nota
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column VALORLIQUIDO (
            type: plainText
            heading {
                heading: Valor Líquido
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 49078737 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DOCUMENTO (
                sequence: 4
            )

            displayColumn DTNF (
                sequence: 1
            )

            displayColumn FORNECEDOR (
                sequence: 3
            )

            displayColumn SITUACAO (
                sequence: 6
            )

            displayColumn TIPO (
                sequence: 2
            )

            displayColumn VALORLIQUIDO (
                sequence: 5
            )

            aggregate (
                column: VALORLIQUIDO
            )

        )

    )

    pageItem P387_IDFILIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @mercadorias-detalhadas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P387_SEMANAINI (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @mercadorias-detalhadas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

