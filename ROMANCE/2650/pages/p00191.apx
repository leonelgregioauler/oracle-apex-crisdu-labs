page 191 (
    name: imprime
    title: imprime
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region cobranças-acumuladas-por-semana (
        name: Cobranças Acumuladas por Semana
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_imprime.prc_cobrancasacumuladas;
                end;
                
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
    )

    process excel (
        name: excel
        type: executeCode
        source {
            plsqlCode: "  owa_util.mime_header('application/vnd.ms-excel',TRUE);"
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 530136718022462922
        }
    )

)

