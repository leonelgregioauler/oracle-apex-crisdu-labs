page 389 (
    name: Tamanhos (Grades)
    title: Tamanhos (Grades)
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region relação-de-tamanhos (
        name: Relação de Tamanhos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select g.idgrade
                     , g.descricao
                     , g.sigla
                     , g.ordem
                     , g.valorcodbarras
                     , g.tamanhoreal
                from grades g;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 4988124869489204239
        }

        column DESCRICAO (
            type: plainText
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column IDGRADE (
            type: link
            heading {
                heading: Ver/Editar
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 390
                    items: {
                        P390_IDGRADE: #IDGRADE#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column ORDEM (
            type: plainText
            heading {
                heading: Ordem
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column SIGLA (
            type: plainText
            heading {
                heading: Sigla
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column TAMANHOREAL (
            type: plainText
            heading {
                heading: Tamanho a Considerar
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column VALORCODBARRAS (
            type: plainText
            heading {
                heading: Valor Cód. Barras
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 49961842 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DESCRICAO (
                sequence: 2
            )

            displayColumn IDGRADE (
                sequence: 1
            )

            displayColumn ORDEM (
                sequence: 5
            )

            displayColumn SIGLA (
                sequence: 3
            )

            displayColumn TAMANHOREAL (
                sequence: 4
            )

            displayColumn VALORCODBARRAS (
                sequence: 6
            )

        )

    )

    button novo-tamanho (
        buttonName: NOVO_TAMANHO
        label: Novo
        layout {
            sequence: 10
            region: @relação-de-tamanhos
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 390
                items: {
                    P390_DESCRICAO:
                    P390_IDGRADE:
                    P390_ORDEM:
                    P390_SIGLA:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

