page 406 (
    name: Solicitação de Compras
    title: Solicitação de Compras
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region solicitações-de-compras (
        name: "Solicitações de Compras "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.idsolicitacaocompra
                     , w.idchamado
                     , w.empresa
                     , w.datasolicitacao
                     , w.datafechado
                     , w.usuario feito_por
                     , w.valorinicial
                     , w.valorfechado
                     , w.valoreconomizado
                     , w.cashback
                     , w.valorcashback
                     , w.produtos
                     , w.observacao
                     , w.frete
                from vw_solicitacoes_compras w
                where ( :P406_DATAINICIO is null
                     or ( ( :P406_TIPODATA = 'S' and w.datasolicitacao between to_date(:P406_DATAINICIO) and to_date(:P406_DATAFIM) 
                     or ( :P406_TIPODATA = 'F' and w.datafechado between to_date(:P406_DATAINICIO) and to_date(:P406_DATAFIM) ) ) ) )
                  and ( :P406_IDFILIAL is null or w.idfilial = :P406_IDFILIAL )
                  and ( :P406_IDCHAMADO is null or w.idchamado = :P406_IDCHAMADO )
                  
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 5363714611370389448
        }

        column CASHBACK (
            type: plainText
            heading {
                heading: Cashback
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: J
            }
        )

        column DATAFECHADO (
            type: plainText
            heading {
                heading: Compra Fechada em
                alignment: center
            }
            layout {
