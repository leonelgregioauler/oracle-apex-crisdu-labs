        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 53945404 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CASHBACK (
                sequence: 10
            )

            displayColumn DATAFECHADO (
                sequence: 5
            )

            displayColumn DATASOLICITACAO (
                sequence: 4
            )

            displayColumn EMPRESA (
                sequence: 3
            )

            displayColumn FEITO_POR (
                sequence: 6
            )

            displayColumn FRETE (
                sequence: 14
            )

            displayColumn IDCHAMADO (
                sequence: 2
            )

            displayColumn IDSOLICITACAOCOMPRA (
                sequence: 1
            )

            displayColumn OBSERVACAO (
                sequence: 13
            )

            displayColumn PRODUTOS (
                sequence: 12
            )

            displayColumn VALORCASHBACK (
                sequence: 11
            )

            displayColumn VALORECONOMIZADO (
                sequence: 9
            )

            displayColumn VALORFECHADO (
                sequence: 8
            )

            displayColumn VALORINICIAL (
                sequence: 7
