    process tickets-em-aberto-priorização-save-interactive-grid-data (
        name: Tickets em Aberto (Priorização) - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @tickets-em-aberto-priorização
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1807987409626532408
        }
    )

    process verifica-setor (
        name: Verifica Setor
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  select case
                           when ( select u.idgerente
                                  from usuarios u
                                  where u.usuario = v('APP_USER') ) = 29 then 1 --Comercial Favorita
                           when ( select u.idgerente
                                  from usuarios u
                                  where u.usuario = v('APP_USER') ) = 280 then 4 --Comercial Romance
                           when ( select u.idgerente
                                  from usuarios u
                                  where u.usuario = v('APP_USER') ) = 180  then 13 --Financeiro Central
                           when ( select u.idgerente
                                  from usuarios u
                                  where u.usuario = v('APP_USER') ) = 199  then 9 --Estoque Romance
                           when ( select u.idgerente
                                  from usuarios u
                                  where u.usuario = v('APP_USER') ) = 299  then 17 --Analise de Crédito
                           when ( select u.idgerente
                                  from usuarios u
                                  where u.usuario = v('APP_USER') ) = 257  then 5 --Controladoria
                         end setor
                  into :P539_IDSETORCHAMADO
                  from dual;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1807914061313598904
        }
    )

)

