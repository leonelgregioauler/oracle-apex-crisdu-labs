    region tickets-em-aberto-priorização (
        name: Tickets em Aberto (Priorização)
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ch.idchamado
                     , ch.descricao
                     , ch.titulo
                     , ch.dataabertura
                     , ch.usuario
                     , ch.prioridade
                     , ch.idsetorchamado 
                FROM roman.chamados ch
                WHERE ch.idsetorchamado = :P539_IDSETORCHAMADO
                  AND ch.idsituacaokanban in (600, 615) --Análise e Documentação e Fila para Desenvolvimento
                  AND ch.idsituacao in (0, 1, 20) --Aberto, Em Atendimento e Em Espera
                  AND (:P539_IDCHAMADO is null or ch.idchamado = :P539_IDCHAMADO )
                  and exists ( select 1
                               from projetos p 
                               where p.idprojeto = ch.idprojeto 
                                 and p.idtipoprojeto = 1 )
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: update
        }
