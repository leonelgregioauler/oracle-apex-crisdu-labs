    region tickets-concluídos (
        name: Tickets Concluídos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ch.idchamado
                     , ch.descricao
                     , ch.titulo
                     , ch.dataabertura
                     , ch.usuario
                     , ch.prioridade
                     , ( SELECT s.setor
                         FROM roman.setoreschamados s
                         WHERE s.idsetorchamado = ch.idsetorchamado ) setor
                FROM roman.chamados ch
                WHERE ch.idsetorchamado = :P539_IDSETORCHAMADO
                  AND ch.idsituacaokanban in (645) --Concluído
                  AND ch.idsituacao in (2, 40) --Encerrado e Aguardando Aprovação
                  AND (:P539_IDCHAMADO is null or ch.idchamado = :P539_IDCHAMADO )
                  and exists ( select 1
                               from projetos p 
                               where p.idprojeto = ch.idprojeto 
                                 and p.idtipoprojeto = 1 )
                
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
