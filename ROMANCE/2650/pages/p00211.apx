page 211 (
    name: Comissões Recebidas
    title: Comissões Recebidas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 80%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region comissões-recebidas (
        name: Comissões Recebidas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(idfilial) empresa
                     , destino
                     , sum(total) total
                from (
                        select pdd.idfilial
                             , case
                                 when pcp.idrepresentante is not null then
                                   'Distribuidor'
                                 else
                                   'Gerente' 
                                   end destino
                             , sum(valorpago) total
                        from pagamentocomissoes pcp
                           , pedidos            pdd
                        where pcp.fechamento = ( select f.semana 
                                                 from fechamentossemanais f 
                                                 where f.idfechamento = :P211_IDFECHAMENTO )
                          and pcp.idpedido   = pdd.idpedido
                        group by pdd.idfilial
                               , case
                                 when pcp.idrepresentante is not null then
                                   'Distribuidor'
                                 else
                                   'Gerente' 
                                   end 
                
                        union
                        select pdf.idfilialromance
                             , case
                                 when pcp.idrepresentante is not null then
                                   'Distribuidor'
                                 else
                                   'Gerente' 
                                   end destino
                             , sum(valorpago * nvl(pdf.fatorconversao,1)) total
                        from pagamentocomissoes pcp
                           , favorita.pedidos   pdf
                        where pcp.fechamento = ( select f.semana 
                                                 from fechamentossemanais f 
                                                 where f.idfechamento = :P211_IDFECHAMENTO )  
                                and not exists ( select 1
                                                 from favorita.classificacoespedidos c
                                                 where c.idpedido = pdf.idpedido
                                                   and c.idcaracteristicapedido  = 73 )
                          and pcp.idpedido          = pdf.idpedido 
                        group by pdf.idfilialromance
                               , case
                                 when pcp.idrepresentante is not null then
                                   'Distribuidor'
                                 else
                                   'Gerente' 
                                   end )
                group by idfilial
                     , destino 
                order by 1, 2
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 2551336097004913627
        }

        column DESTINO (
            type: plainText
            heading {
                heading: Destino
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column EMPRESA (
            type: plainText
            heading {
                heading: Empresa
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column TOTAL (
            type: plainText
            heading {
                heading: Total
                alignment: end
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 25513465 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DESTINO (
                sequence: 2
            )

            displayColumn EMPRESA (
                sequence: 1
            )

            displayColumn TOTAL (
                sequence: 3
            )

            aggregate (
                column: TOTAL
            )

        )

    )

    pageItem P211_IDFECHAMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @comissões-recebidas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

