page 455 (
    name: Saldo Devedor Vencido/Atrasado
    title: Saldo Devedor Vencido/Atrasado
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region legenda (
        name: Legenda
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-useLocalStorage
                is-expanded
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <b><font color="white">...</font>Legenda:</b><br><br>
                <b><font color="white">...</font><font color="red">Vencidos após 15d = Depois de 15 dias</font></b><br>
                <b><font color="white">...</font><font color="blue">Vencidos até 15d = Em Até 15 dias</font></b><br><br>
                
                
                ```
        }
    )

    region saldos (
        name: Saldos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select atrasados.data_vencimento
                     , atrasados.distribuidor
                     , atrasados.valor
                     , atrasados.situacao
                     , atrasados.calc
                     , atrasados.tipo_debito
                     , atrasados.filial
                  from( select nvl(pck_romance.fnc_nomerepresentante(n.idrepresentante),pck_romance.fnc_nomepessoa(n.idpessoa)) distribuidor
                             , pn.datapagamento data_vencimento 
                             , pn.valorpago valor
                             , 'Atrasado' situacao
                             , (trunc(sysdate) - trunc(pn.datapagamento)) calc
                             , (select t.descricao from tiposnegociacoes t where t.idtiponegociacao = n.idtiponegociacao) tipo_debito
                             , (select f.nome from roman.vw_filiais f where f.idfilial = n.idfilial) filial
                          from pagamentosnegociacoes pn
                             , negociacoes n
                         where pn.idnegociacao = n.idnegociacao
                           and pn.situacao <> 'Q'
                           and (trunc(sysdate) - trunc(pn.datapagamento)) between 0 and 15 -- Atrasado
                           and (:P455_TIPO = 'T' or :P455_TIPO = 'A')
                           and trunc(n.data) between :P455_DATAINICIO and :P455_DATAFIM
                           and (:P455_IDFILIAL = -1 --/*todos*/
                            or (:P455_IDFILIAL = -2 and n.idfilial is null)
                            or (:P455_IDFILIAL = 1 and exists(select 1 --/*brasil*/
                                                                from vw_filiais f
                                                               where f.idfilial = n.idfilial
                                                                 and f.idgrupo is not null
                                                                 and f.ididioma = 1))
                            or (:P455_IDFILIAL = 2 and exists(select 1 --/*america latina*/
                                                                from vw_filiais f
                                                               where f.idfilial = n.idfilial
                                                                 and f.idgrupo is not null
                                                                 and f.ididioma not in (1,5,9,10,11)))
                            or (:P455_IDFILIAL > 2 and n.idfilial = :P455_IDFILIAL))
                           and (:P455_IDDISTRIBUIDOR = -1 or n.idrepresentante = :P455_IDDISTRIBUIDOR)
                           and (:P455_TIPO_DEBITO is null or (:P455_TIPO_DEBITO not in (-2, -4, -5) and n.idtiponegociacao = :P455_TIPO_DEBITO ))
                        union
                        select pck_romance.fnc_nomerepresentante(nb.idrepresentante) distribuidor
                             , pnb.data_vencimento 
                             , pnb.valor
                             , 'Atrasado' situacao
                             , (trunc(sysdate) - trunc(pnb.data_vencimento)) calc
                             , 'Balanço (Antigo)' tipo_debito
                             , (select f.nome from roman.vw_filiais f where f.idfilial = nb.idfilial) filial
                          from parcelanegociacaobalanco pnb
                             , negociacoesbalanco nb
                         where pnb.idnegociacaobalanco = nb.idnegociacaobalanco
                           and pnb.situacao <> 'QUI'
                           and (trunc(sysdate) - trunc(pnb.data_vencimento)) between 0 and 15 -- Atrasado
                           and (:P455_TIPO = 'T' or :P455_TIPO = 'A')
                           and trunc(nb.data) between :P455_DATAINICIO and :P455_DATAFIM
                           and (:P455_IDFILIAL = -1 --/*todos*/
                            or (:P455_IDFILIAL = -2 and nb.idfilial is null)
                            or (:P455_IDFILIAL = 1 and exists(select 1 --/*brasil*/
                                                                from vw_filiais f
                                                               where f.idfilial = nb.idfilial
                                                                 and f.idgrupo is not null
                                                                 and f.ididioma = 1))
                            or (:P455_IDFILIAL = 2 and exists(select 1 --/*america latina*/
                                                                from vw_filiais f
                                                               where f.idfilial = nb.idfilial
                                                                 and f.idgrupo is not null
                                                                 and f.ididioma not in (1,5,9,10,11)))
                            or (:P455_IDFILIAL > 2 and nb.idfilial = :P455_IDFILIAL))
                           and (:P455_IDDISTRIBUIDOR = -1 or nb.idrepresentante = :P455_IDDISTRIBUIDOR)
                           and (:P455_TIPO_DEBITO is null or :P455_TIPO_DEBITO = -2)
                        union
                        select nvl(pck_romance.fnc_nomerepresentante(em.idrepresentante),em.nome) distribuidor
                             , trunc(pe.datavencimento) data_vencimento
                             , pe.valorapagar valor 
                             , 'Atrasado' situacao
                             , (trunc(sysdate) - trunc(pe.datavencimento)) calc
                             , 'Empréstimo (Antigo)' tipo_debito
                             , (select f.nome from roman.vw_filiais f where f.idfilial = em.idfilial) filial
                          from parcelamentosemprestimos pe
                             , emprestimos em
                         where pe.idemprestimo = em.idemprestimo
                           and pe.situacao <> 'Q'
                           and (trunc(sysdate) - trunc(pe.datavencimento)) between 0 and 15 -- atrasado
                           and (:P455_TIPO = 'T' or :P455_TIPO = 'A')
                           and trunc(em.data) between :P455_DATAINICIO and :P455_DATAFIM
                           and (:P455_IDFILIAL = -1 --/*todos*/
                            or (:P455_IDFILIAL = -2 and em.idfilial is null)
                            or (:P455_IDFILIAL = 1 and exists(select 1 --/*brasil*/
                                                                from vw_filiais f
                                                               where f.idfilial = em.idfilial
                                                                 and f.idgrupo is not null
                                                                 and f.ididioma = 1))
                            or (:P455_IDFILIAL = 2 and exists(select 1 --/*america latina*/
                                                                from vw_filiais f
                                                               where f.idfilial = em.idfilial
                                                                 and f.idgrupo is not null
                                                                 and f.ididioma not in (1,5,9,10,11)))
                            or (:P455_IDFILIAL > 2 and em.idfilial = :P455_IDFILIAL))
                           and (:P455_IDDISTRIBUIDOR = -1 or em.idrepresentante = :P455_IDDISTRIBUIDOR)
                           and (:P455_TIPO_DEBITO is null or :P455_TIPO_DEBITO = -4)
                      ) atrasados
                 -- where atrasados.calc between 0 and 15
                union
                select vencidos.data_vencimento
                     , vencidos.distribuidor
                     , vencidos.valor
                     , vencidos.situacao
                     , vencidos.calc
                     , vencidos.tipo_debito
                     , vencidos.filial
                  from( select nvl(pck_romance.fnc_nomerepresentante(n.idrepresentante),pck_romance.fnc_nomepessoa(n.idpessoa)) distribuidor
                             , pn.datapagamento data_vencimento 
                             , pn.valorpago valor
                             , 'Vencido' situacao
                             , (trunc(sysdate) - trunc(pn.datapagamento)) calc
                             , (select t.descricao from tiposnegociacoes t where t.idtiponegociacao = n.idtiponegociacao) tipo_debito
                             , (select f.nome from roman.vw_filiais f where f.idfilial = n.idfilial) filial
                          from pagamentosnegociacoes pn
                             , negociacoes n
                         where pn.idnegociacao = n.idnegociacao
                           and pn.situacao <> 'Q'
                           and (trunc(sysdate) - trunc(pn.datapagamento)) > 15 -- vencido
                           and (:P455_TIPO = 'T' or :P455_TIPO = 'V')
                           and trunc(n.data) between :P455_DATAINICIO and :P455_DATAFIM
                           and (:P455_IDFILIAL = -1 --/*todos*/
                            or (:P455_IDFILIAL = -2 and n.idfilial is null)
                            or (:P455_IDFILIAL = 1 and exists(select 1 --/*brasil*/
                                                                from vw_filiais f
                                                               where f.idfilial = n.idfilial
                                                                 and f.idgrupo is not null
                                                                 and f.ididioma = 1))
                            or (:P455_IDFILIAL = 2 and exists(select 1 --/*america latina*/
                                                                from vw_filiais f
                                                               where f.idfilial = n.idfilial
                                                                 and f.idgrupo is not null
                                                                 and f.ididioma not in (1,5,9,10,11)))
                            or (:P455_IDFILIAL > 2 and n.idfilial = :P455_IDFILIAL))
                           and (:P455_IDDISTRIBUIDOR = -1 or n.idrepresentante = :P455_IDDISTRIBUIDOR)
                           and (:P455_TIPO_DEBITO is null or (:P455_TIPO_DEBITO not in (-2, -4, -5) and n.idtiponegociacao = :P455_TIPO_DEBITO ))
                        union
                        select pck_romance.fnc_nomerepresentante(nb.idrepresentante) distribuidor
                             , pnb.data_vencimento
                             , pnb.valor
                             , 'Vencido' situacao
                             , (trunc(sysdate) - trunc(pnb.data_vencimento)) calc
                             , 'Balanço (Antigo)' tipo_debito
                             , (select f.nome from roman.vw_filiais f where f.idfilial = nb.idfilial) filial
                          from parcelanegociacaobalanco pnb
                             , negociacoesbalanco nb
                         where pnb.idnegociacaobalanco = nb.idnegociacaobalanco
                           and pnb.situacao <> 'QUI'
                           and (trunc(sysdate) - trunc(pnb.data_vencimento)) > 15 -- vencido
                           and (:P455_TIPO = 'T' or :P455_TIPO = 'V')
                           and trunc(nb.data) between :P455_DATAINICIO and :P455_DATAFIM
                           and (:P455_IDFILIAL = -1 --/*todos*/
                            or (:P455_IDFILIAL = -2 and nb.idfilial is null)
                            or (:P455_IDFILIAL = 1 and exists(select 1 --/*brasil*/
                                                                from vw_filiais f
                                                               where f.idfilial = nb.idfilial
                                                                 and f.idgrupo is not null
                                                                 and f.ididioma = 1))
                            or (:P455_IDFILIAL = 2 and exists(select 1 --/*america latina*/
                                                                from vw_filiais f
                                                               where f.idfilial = nb.idfilial
                                                                 and f.idgrupo is not null
                                                                 and f.ididioma not in (1,5,9,10,11)))
                            or (:P455_IDFILIAL > 2 and nb.idfilial = :P455_IDFILIAL))
                           and (:P455_IDDISTRIBUIDOR = -1 or nb.idrepresentante = :P455_IDDISTRIBUIDOR)
                           and (:P455_TIPO_DEBITO is null or :P455_TIPO_DEBITO = -2)
                        union
                        select nvl(pck_romance.fnc_nomerepresentante(em.idrepresentante),em.nome) distribuidor
                             , trunc(pe.datavencimento)
                             , pe.valorapagar valor
                             , 'Vencido' situacao
                             , (trunc(sysdate) - trunc(pe.datavencimento)) calc
                             , 'Emprestimo (Antigo)' tipo_debito
                             , (select f.nome from roman.vw_filiais f where f.idfilial = em.idfilial) filial
                          from parcelamentosemprestimos pe
                             , emprestimos em
                         where pe.idemprestimo = em.idemprestimo
                           and pe.situacao <> 'Q'
                           and (trunc(sysdate) - trunc(pE.datavencimento)) > 15 -- vencido
                           and (:P455_TIPO = 'T' or :P455_TIPO = 'V')
                           and trunc(em.data) between :P455_DATAINICIO and :P455_DATAFIM
                           and (:P455_IDFILIAL = -1 --/*todos*/
                            or (:P455_IDFILIAL = -2 and em.idfilial is null)
                            or (:P455_IDFILIAL = 1 and exists(select 1 --/*brasil*/
                                                                from vw_filiais f
                                                               where f.idfilial = em.idfilial
                                                                 and f.idgrupo is not null
                                                                 and f.ididioma = 1))
                            or (:P455_IDFILIAL = 2 and exists(select 1 --/*america latina*/
                                                                from vw_filiais f
                                                               where f.idfilial = em.idfilial
                                                                 and f.idgrupo is not null
                                                                 and f.ididioma not in (1,5,9,10,11)))
                            or (:P455_IDFILIAL > 2 and em.idfilial = :P455_IDFILIAL))
                           and (:P455_IDDISTRIBUIDOR = -1 or em.idrepresentante = :P455_IDDISTRIBUIDOR)
                           and (:P455_TIPO_DEBITO is null or :P455_TIPO_DEBITO = -4)
                      ) vencidos
                  --where vencidos.calc > 15
                   -- and :P455_EXECUTA = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1506035122287891144
        }

