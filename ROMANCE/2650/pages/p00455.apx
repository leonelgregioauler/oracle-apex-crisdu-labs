    pageItem P455_DATAFIM (
        type: datePickerJquery
        label {
            label: Data Final Negociação
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/YYYY
            width: 30
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P455_DATAINICIO (
        type: datePickerJquery
        label {
            label: Data Inicial Negociação
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/YYYY
            width: 30
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P455_EXECUTA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P455_IDDISTRIBUIDOR (
        type: selectOne
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ' Todos' d, -1 r
                from dual
                union
                select pck_romance.fnc_nomerepresentante(r.idrepresentante) d
                     , r.idrepresentante r
                from representantes r
                where r.idgerente in ( select idgerente 
                                      from gerentes g
                                         , filiais fil
                                      where g.idfilial = fil.idfilial
                                        and ( :P455_IDFILIAL = -1  -- Todos
                                         or ( :P455_IDFILIAL = 1 and fil.idgrupo != 5  ) -- Brasil
                                         or ( :P455_IDFILIAL = 2 and fil.idgrupo  = 5  ) -- America Latina
                                         or ( :P455_IDFILIAL > 2 and g.idfilial = :P455_IDFILIAL )))
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P455_IDFILIAL
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        default {
            type: static
            staticValue: -1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P455_IDFILIAL (
        type: selectOne
        label {
            label: Empresa
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select '   Todos', -1
                from dual
                union
                select '  Sem Filial', -2
                from dual
                union
                select ' Brasil', 1
                from dual
                union
                select ' America Latina', 2
                from dual
                union
                select nome
                     , idfilial
                from vw_filiais f
                where f.ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        default {
            type: static
            staticValue: -1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P455_TIPO (
        type: radioGroup
        label {
            label: Situação
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Vencidos após 15d;V,Vencidos até 15d;A
            displayExtraValues: false
            nullDisplayValue: Todos
            nullReturnValue: T
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: T
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P455_TIPO_DEBITO (
        type: selectList
        label {
            label: Tipo Débito
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select descricao
                     , idtiponegociacao
                  from (select descricao
                             , idtiponegociacao
                             , idtiponegociacao ordem
                          from tiposnegociacoes
                         union
                        select 'Balanço (Antigo)', -2, 8
                          from dual
                         union
                        select 'Empréstimos  (Antigo)', -4, 7
                          from dual
                         union
                        select 'Cheques', -5, 5
                          from dual)
                order by ordem
                ```
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: Filtrar
        label: Filtrar
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction executa (
        name: Executa
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action native-set-value (
            action: setValue
            settings {
                value: S
            }
            affectedElements {
                selectionType: items
                items: P455_EXECUTA
            }
            execution {
                sequence: 10
            }
        )

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode: :P455_EXECUTA := 'N';
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 3494659001290678542
        }
    )

)

