    validation fechamento-pertence-à-filial (
        name: Fechamento pertence à filial
        execution {
            sequence: 15
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  v_existe number;
                begin
                  --
                  if v('REQUEST') not in ('SALVAR','CRIAR') then
                    return null; -- passa
                  end if;
                  --
                  if nvl(:P405_IDFECHAMENTO,0) = 0 then
                    return null; -- passa
                  end if;
                  --
                  select count(*)
                    into v_existe
                    from fechamentossemanais f
                   where f.idfechamento = :P405_IDFECHAMENTO
                     and f.idfilial = :P405_IDFILIAL;
                  --
                  if v_existe = 0 then
                    return 'Fechamento não pertence à filial informada. (idfechamento='||:P405_IDFECHAMENTO||' / idfilial='||:P405_IDFILIAL||')';
                  end if;
                  --
                  return null; -- passa
                  --
                exception
                  when others then
                    return 'DEBUG ERRO: '||sqlerrm||' | idfechamento='||:P405_IDFECHAMENTO||' / idfilial='||:P405_IDFILIAL;
                end;
                ```
        }
    )

