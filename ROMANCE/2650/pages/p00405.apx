    pageItem P405_SALDO (
        type: displayOnly
        label {
            label: Saldo (=)
            alignment: left
        }
        layout {
            sequence: 210
            region: @negociação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select to_char(( nvl(n.valor,0) + nvl(n.valorjuros,0) - nvl(n.entrada,0) - nvl(n.valordescontonegociacao,0)) - nvl(( select sum(pn.valorpago)
                                                                       from pagamentosnegociacoes pn
                                                                       where pn.idnegociacao = n.idnegociacao
                                                                         and pn.situacao = 'Q' ),0) ,'999G999G999G999G999G990D00')pago
                from negociacoes n
                where n.idnegociacao = :P405_IDNEGOCIACAO
                ```
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P405_IDNEGOCIACAO
        }
        security {
            encryptSessionState: false
        }
    )

