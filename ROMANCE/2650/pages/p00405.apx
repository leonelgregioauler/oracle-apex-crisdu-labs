    region parcelas-negociação (
        name: "Parcelas Negociação "
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pg.idpagamentonegociacao
                     , pg.idnegociacao
                     , PG.IDFORMAPAGAMENTO
                     , pg.datainclusao
                     , pg.datapagamento
                     , pg.valorpago
                     , pg.usuario
                     , pg.observacao
                     , pg.situacao
                     , pg.tipo
                     , pg.idmatrizclassificacaoentrada
                     , pg.juros
                     , pg.multa
                     , pck_negociacoes_rmc.fnc_retornajurosdaparcelapaga(pg.idpagamentonegociacao) amortizacao
                from pagamentosnegociacoes pg
                  -- , negociacoes n
                where pg.idnegociacao = :P405_IDNEGOCIACAO
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P405_IDNEGOCIACAO
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
