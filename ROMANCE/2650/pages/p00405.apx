    process reverter-cancelamento (
        name: Reverter Cancelamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    
                    /* Define o status da negociação de balanço como não cancelado*/
                    update roman.negociacoes n
                       set n.cancelado = 'N'
                     where n.idnegociacao = :P405_IDNEGOCIACAO;
                
                    /* Ajusta a situação das parcelas da negociação de CANCELADA para VENCIDA*/
                    update roman.pagamentosnegociacoes p
                       set p.situacao = 'V'
                     where p.idnegociacao = :P405_IDNEGOCIACAO
                       and p.situacao = 'C'
                       and trunc(datapagamento) < trunc(sysdate);
                
                    /* Ajusta a situação das parcelas da negociação de CANCELADA para VENCIDA*/
                    update roman.pagamentosnegociacoes p
                       set p.situacao = 'A'
                     where p.idnegociacao = :P405_IDNEGOCIACAO
                       and p.situacao = 'C'
                       and trunc(datapagamento) >= trunc(sysdate);
                
                
                    /* Exibe mensagem aviso de sucesso*/
                    apex_application.g_print_success_message := '<span style="color : white ">Revertido o cancelamento da Negociação Balanço com sucesso! </span>';
                
                    /* Confirma a alteração de cancelamento*/
                    Commit;
                
                /* Tratamento de erros da rotina de cancelamento*/
                exception
                    when others then
                        apex_error.add_error( p_message          => 'Erro ao tentar reverter o cancelamneto da negociação de balanço:  '|| SQLERRM
                   				            , p_display_location => apex_error.c_inline_in_notification);
                end;
                ```
        }
        execution {
            sequence: 110
        }
        advanced {
            executionMappingIdentifier: 371578157130912646
        }
        serverSideCondition {
            whenButtonPressed: @reverter-cancelamento
        }
    )

    process seta-classificacao-negociacao (
        name: Seta Classificacao Negociacao
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidclassificacaonegociacao  number;
                  vidcaracteristicanegociacao number := 0;
                  vidnegociacao               number;
                  vdataclassificacao          date;
                  vidusuario                  number;
                  vobservacao                 varchar2(1000);
                  vidcheque                   number;
                  videmprestimo               number;
                  vidnegociacaobalanco        number;
                  vmd5                        varchar2(1000);
                  voperacao_dml               varchar2(1) := 'I';
                  v_count                     number;
                  --
                begin
                  --
                  if v('REQUEST') = 'RENEGOCIADA' then
                    vidcaracteristicanegociacao     := 1;
                    elsif v('REQUEST') = 'DEVEDORA' then
                    vidcaracteristicanegociacao      := 2;
                    elsif v('REQUEST') = 'PERDIDA' then
                    vidcaracteristicanegociacao      := 3;
                  end if;
                  --
                  --raise_application_error(-20000,'vidcaracteristica '||v('REQUEST'));
                  --
                  if vidcaracteristicanegociacao in (1,2,3) then
                    --
                    select u.idusuario
                      into vidusuario
                      from usuarios u
                     where u.usuario = v('APP_USER');
                    --
                    vidclassificacaonegociacao  := seq_idclassificacaonegociacao.Nextval;
                    vidnegociacao               := :P405_IDNEGOCIACAO;
                    vdataclassificacao          := sysdate;
                    --
                    pck_cadastros_rmc.prc_classificacoesnegociacoes( pidclassificacaonegociacao  => vidclassificacaonegociacao
                                                                   , pidcaracteristicanegociacao => vidcaracteristicanegociacao
                                                                   , pidnegociacao               => vidnegociacao
                                                                   , pdataclassificacao          => vdataclassificacao
                                                                   , pidusuario                  => vidusuario
                                                                   , pobservacao                 => vobservacao
                                                                   , pidcheque                   => vidcheque
                                                                   , pidemprestimo               => videmprestimo
                                                                   , pidnegociacaobalanco        => vidnegociacaobalanco
                                                                   , pmd5                        => vmd5
                                                                   , poperacao_dml               => voperacao_dml );
                    --
                    if vidcaracteristicanegociacao = 3 then
                      --
                      update negociacoes n
                         set n.perda = 'S'
                       where n.idnegociacao   = :P405_IDNEGOCIACAO
                         and nvl(n.perda,'N') = 'N';
                      --
                    end if;
                    --
                    commit;
                    --
                    apex_application.g_print_success_message := '<span style="color : white ">Negociação Classificada com sucesso! </span>';
                    --
                    elsif vidcaracteristicanegociacao = 0 and v('REQUEST') = 'REMOVER' then
                      --
                      delete from classificacoesnegociacoes cl
                            where cl.idclassificacaonegociacao = :P405_IDCLASSIFICACAONEGOCIACAO;
                      --
                      commit;
                      --
                      -- Verifica se realmente deletou o registro
                      select count(*)
                        into v_count
                        from classificacoesnegociacoes cl
                       where cl.idclassificacaonegociacao = :P405_IDCLASSIFICACAONEGOCIACAO;
                      --
                      if v_count = 0 then
                        --
                        apex_application.g_print_success_message := '<span style="color : white ">Classificação Removida com Sucesso!!! </span>';
                        --
                      end if;
                      -- Erro ao remover a Classificação. Verifique!
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 1505673249053836535
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('RENEGOCIADA','DEVEDORA','PERDIDA','REMOVER')
                ```
        }
    )

    process sinaliza-donnapay (
        name: Sinaliza DonnaPay
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidclassificacaonegociacao  number;
                  vidcaracteristicanegociacao number := 6; -- DonnaPay
                  vidnegociacao               number := :P405_IDNEGOCIACAO;
                  vdataclassificacao          date   := sysdate;
                  vidusuario                  number;
                  vobservacao                 varchar2(1000);
                  vidcheque                   number;
                  videmprestimo               number;
                  vidnegociacaobalanco        number;
                  vmd5                        varchar2(1000);
                  voperacao_dml               varchar2(1) := 'I';
                  v_count                     number;
                  --
                begin
                  --
                  -- Somente negociacoes do tipo Emprestimo (idtiponegociacao = 4)
                  select count(*)
                    into v_count
                    from negociacoes n
                   where n.idnegociacao     = vidnegociacao
                     and n.idtiponegociacao = 4;
                  --
                  if v_count = 0 then
                    raise_application_error(-20001,'Sinalização DonnaPay disponível somente para negociações de Empréstimo.');
                  end if;
                  --
                  -- Evita duplicidade (duplo clique / duas abas)
                  select count(*)
                    into v_count
                    from classificacoesnegociacoes cl
                   where cl.idnegociacao               = vidnegociacao
                     and cl.idcaracteristicanegociacao = vidcaracteristicanegociacao;
                  --
                  if v_count > 0 then
                    raise_application_error(-20002,'Negociação já sinalizada como DonnaPay.');
                  end if;
                  --
                  select u.idusuario
                    into vidusuario
                    from usuarios u
                   where u.usuario = v('APP_USER');
                  --
                  vidclassificacaonegociacao := seq_idclassificacaonegociacao.nextval;
                  --
                  pck_cadastros_rmc.prc_classificacoesnegociacoes( pidclassificacaonegociacao  => vidclassificacaonegociacao
                                                                 , pidcaracteristicanegociacao => vidcaracteristicanegociacao
                                                                 , pidnegociacao               => vidnegociacao
                                                                 , pdataclassificacao          => vdataclassificacao
                                                                 , pidusuario                  => vidusuario
                                                                 , pobservacao                 => vobservacao
                                                                 , pidcheque                   => vidcheque
                                                                 , pidemprestimo               => videmprestimo
                                                                 , pidnegociacaobalanco        => vidnegociacaobalanco
                                                                 , pmd5                        => vmd5
                                                                 , poperacao_dml               => voperacao_dml );
                  --
                  commit;
                  --
                  apex_application.g_print_success_message := '<span style="color : white ">Negociação sinalizada como DonnaPay com sucesso! </span>';
                  --
                end;
                ```
        }
        execution {
            sequence: 75
        }
        advanced {
            executionMappingIdentifier: 7405202610090005
        }
        serverSideCondition {
            type: request=Value
            value: DONNAPAY
        }
    )

