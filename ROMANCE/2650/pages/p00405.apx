    process cancelar-negociação-balanço (
        name: Cancelar Negociação Balanço
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    
                    /* Define o status da negociação de balanço como cancelado*/
                    update roman.negociacoes n
                       set n.cancelado = 'S'
                     where n.idnegociacao = :P405_IDNEGOCIACAO;
                
                    /* Ajusta a situação das parcelas da negociação para cancelado (OBS: AJUSTA SOMENTE PARCELAS NÃO QUITADAS)*/
                    update roman.pagamentosnegociacoes p
                       set p.situacao = 'C'
                     where p.idnegociacao = :P405_IDNEGOCIACAO
                       and p.situacao != 'Q';
                
                    /* Exibe mensagem aviso de sucesso*/
                    apex_application.g_print_success_message := '<span style="color : white ">Negociação Balanço Cancelada com sucesso! </span>';
                
                    /* Confirma a alteração de cancelamento*/
                    Commit;
                
                /* Tratamento de erros da rotina de cancelamento*/
                exception
                    when others then
                        apex_error.add_error( p_message          => 'Erro ao tentar cancelar a negociação de balanço:  '|| SQLERRM
                   				            , p_display_location => apex_error.c_inline_in_notification);
                end;
                ```
        }
        execution {
            sequence: 100
        }
        advanced {
            executionMappingIdentifier: 371578009654912645
        }
        serverSideCondition {
            whenButtonPressed: @cancelar-neg-balanco
        }
    )

