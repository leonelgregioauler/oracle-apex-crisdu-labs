    process atualizar-pagamentos (
        name: Atualizar Pagamentos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  cursor c1 is
                    select *
                    from negociacoes n
                    where n.idnegociacao = :P405_IDNEGOCIACAO;
                    
                  --
                  r1 c1%rowtype;
                  --
                  vmd5 varchar2(1000);
                  --
                begin
                  --
                  open c1;
                  fetch c1 into r1;
                    --
                    if c1%found then
                      --
                      pck_cadastros_rmc.prc_negociacoes( pidnegociacao     => r1.idnegociacao    ,
                                                         pidtiponegociacao => r1.idtiponegociacao,
                                                         pidfilial         => r1.idfilial        ,
                                                         pidrepresentante  => r1.idrepresentante ,
                                                         pidpessoa         => r1.idpessoa        ,
                                                         pidsemana         => r1.idsemana        ,
                                                         pdata             => r1.data            ,
                                                         pusuario          => r1.usuario         ,
                                                         pvalor            => r1.valor           ,
                                                         pentrada          => r1.entrada         ,
                                                         ptipoentrada      => r1.tipoentrada     ,
                                                         pvalorjuros       => r1.valorjuros      ,
                                                         pvalortotal       => r1.valortotal      ,
                                                         pvalorpago        => r1.valorpago       ,
                                                         psaldo            => r1.saldo           ,
                                                         pparcelas         => r1.parcelas        ,
                                                         pobservacao       => r1.observacao      ,
                                                         pidunidadedenegocio => r1.idunidadedenegocio,
                                                         pidmatrizentrada  => r1.idmatrizclassificacaoentrada,
                                                         PPERDA               => r1.perda,
                                                         pidfechamento        => r1.idfechamento,
                                                         pdistrato            => r1.distrato,
                                                         pcancelado           => r1.cancelado,
                                                         pvalordescontonegociacao => r1.valordescontonegociacao,
                                                         pnaooperacional   => r1.naooperacional,
                                                         pmd5              => vmd5,
                                                         poperacao_dml     => 'U');
                      --
                    end if;
                    --
                  close c1;
                   --
                   /* if voperacao_dml = 'I' then
                      --
                      apex_application.g_print_success_message := '<span style="color : white ">Parcelas inseridas com sucesso! </span>';  
                      
                    elsif  voperacao_dml = 'U' then
                      --
                      apex_application.g_print_success_message := '<span style="color : white ">Alteração de parcelas realizado com sucesso! </span>';
                    
                    elsif  voperacao_dml = 'D' then
                      --
                      apex_application.g_print_success_message := '<span style="color : white ">Exclusão de parcela realizado com sucesso! </span>';
                    end if;*/
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 5363713547740389437
