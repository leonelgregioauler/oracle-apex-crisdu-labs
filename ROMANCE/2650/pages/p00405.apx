        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select to_char((nvl(n.valor,0) + nvl(n.valorjuros,0)) - nvl(n.valordescontonegociacao,0),'999G999G999G999G999G990D00') valor
                --(nvl(to_char(n.valor,'999G999G999G999G999G990D00'),0) + nvl(to_char(n.valorjuros,'999G999G999G999G999G990D00'),0)) - nvl(to_char(n.valordescontonegociacao,'999G999G999G999G999G990D00'),0) valor
                from negociacoes n
                where n.idnegociacao = :P405_IDNEGOCIACAO
                ```
        }
        security {
            encryptSessionState: false
        }
    )

