    dynamicAction confirma (
        name: Confirma
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @renegociada
        }

        action native-confirm (
            action: confirm
            settings {
                message: Deseja realmente marcar como Renegociada?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: RENEGOCIADA
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

