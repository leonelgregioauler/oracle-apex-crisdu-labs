    process processo-dml-em-negociacoes (
        name: Processo DML em Negociacoes
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  voperacao_dml varchar2(1);
                  vvalortotal   number;
                  vvalor        number;
                  vvalorjuros   number;
                  ventrada      number;
                  vsaldo        number;
                  vpago         number;
                  vdescontonegociacao number;
                  --
                  vidsemana     number;
                  vusuario      varchar2(100) := v('APP_USER');
                  vcancelado    varchar2(1);
                  --
                  -- DIEGO - 28/08/2026 - CORRECAO ORA-01722 (Erro ao processar validação) ao
                  -- clicar em Criar Negociação. Causa: os campos numericos (P405_VALOR,
                  -- P405_VALORJUROS, etc.) sao exibidos/enviados no formato brasileiro
                  -- (','=decimal, '.'=milhar - mascara 999G999G999G999G990D00). O codigo
                  -- antigo so tirava o ponto (replace(valor,'.','')) e deixava a conversao
                  -- implicita para NUMBER por conta da sessao. Como o banco usa
                  -- NLS_NUMERIC_CHARACTERS = '.,' (ponto decimal), a string resultante
                  -- (ex.: "250000,00") tem uma virgula que a sessao nao reconhece como
                  -- decimal -> ORA-01722. Ajuste: usar TO_NUMBER explicito informando o
                  -- formato e o NLS_NUMERIC_CHARACTERS corretos, independente da sessao.
                  vfmt varchar2(30) := '999G999G999G999G990D00';
                  vnls varchar2(40) := 'NLS_NUMERIC_CHARACTERS = '',.''';
                  --
                begin
                  --
                  if v('REQUEST') = 'CRIAR' then
                    --
                    if :P405_IDREPRESENTANTE is null and :P405_IDPESSOA is null then
                      --
                      raise_application_error(-20001,'Informe o Distribuidor ou Pessoa');
                      --
                    end if;
                    --
                    voperacao_dml := 'I';
                    vvalor               := to_number(:P405_VALOR, vfmt, vnls);
                    vvalorjuros          := to_number(:P405_VALORJUROS, vfmt, vnls);
                    ventrada             := to_number(:P405_ENTRADA, vfmt, vnls);
                    vsaldo               := to_number(:P405_SALDO, vfmt, vnls);
                    vpago                := to_number(:P405_VALORPAGO, vfmt, vnls);
                    -- DIEGO - 28/08/2026: adicionado NVL(...,0) no desconto, que faltava e
                    -- deixava vvalortotal/saldo NULL quando o campo Desconto Negociação
                    -- estava vazio.
                    vdescontonegociacao  := nvl(to_number(:P405_VALORDESCONTONEGOCIACAO, vfmt, vnls), 0);
                    vvalortotal          := nvl(vvalor,0) + nvl(vvalorjuros,0) - vdescontonegociacao;
                  
                  elsif v('REQUEST') = 'SALVAR' then
                    --
                    if :P405_cancelado = 'Sim' and v('REQUEST') = 'SALVAR' then
                      --
                      raise_application_error(-20002,'Ops! Não é possível alterar a negociação porque ela está cancelada.');
                      --
                    end if;
                    --
                    if :P405_IDREPRESENTANTE is null and :P405_IDPESSOA is null then
                      --
                      raise_application_error(-20002,'Informe o Distribuidor ou Pessoa');
                      --
                    end if;
                    --
                    voperacao_dml := 'U';
                    vvalor               := to_number(:P405_VALOR, vfmt, vnls);
                    vvalorjuros          := to_number(:P405_VALORJUROS, vfmt, vnls);
                    ventrada             := to_number(:P405_ENTRADA, vfmt, vnls);
                    vsaldo               := to_number(:P405_SALDO, vfmt, vnls);
                    vpago                := to_number(:P405_VALORPAGO, vfmt, vnls);
                    -- DIEGO - 28/08/2026: mesmo ajuste do NVL aplicado aqui tambem.
                    vdescontonegociacao  := nvl(to_number(:P405_VALORDESCONTONEGOCIACAO, vfmt, vnls), 0);
                    vvalortotal          := nvl(vvalor,0) + nvl(vvalorjuros,0) - vdescontonegociacao;
                  
                  elsif v('REQUEST') = 'DELETAR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  vidsemana := pck_util.fnc_idsemanadata(sysdate);
                  --
                  select decode(:P405_cancelado,'Sim','S','N')
                    into vcancelado
                    from dual;
                  --
                  if v('APP_USER') = 'DIEGOPIECHO' THEN
                    apex_application.g_print_success_message := 'TESTE 01';
                  END IF;
                  --
                  PCK_CADASTROS_RMC.PRC_NEGOCIACOES( PIDNEGOCIACAO => :P405_IDNEGOCIACAO,
                                                     PIDTIPONEGOCIACAO => :P405_IDTIPONEGOCIACAO,
                                                     PIDFILIAL => :P405_IDFILIAL,
                                                     PIDREPRESENTANTE => :P405_IDREPRESENTANTE,
                                                     PIDPESSOA => :P405_IDPESSOA,
                                                     PIDSEMANA =>  vidsemana,
                                                     PDATA => :P405_DATA,
                                                     PUSUARIO => vusuario,
                                                     PVALOR => vvalor,
                                                     PENTRADA => ventrada,
                                                     PTIPOENTRADA => :P405_TIPOENTRADA,
                                                     PVALORJUROS => vvalorjuros,
                                                     PVALORTOTAL => vvalortotal,
                                                     PVALORPAGO => vpago,
                                                     PSALDO => vsaldo,
                                                     PPARCELAS => :P405_PARCELAS,
                                                     POBSERVACAO => :P405_OBSERVACAO,
                                                     PIDUNIDADEDENEGOCIO => :P405_IDUNIDADEDENEGOCIO,
                                                     PIDMATRIZENTRADA => :P405_IDMATRIZENTRADA,
                                                     PPERDA               => :P405_perda,
                                                     pidfechamento        => :P405_idfechamento,
                                                     pdistrato            => :P405_distrato,
                                                     pcancelado           => vcancelado,--:P405_cancelado,
                                                     pvalordescontonegociacao => vdescontonegociacao,
                                                     pnaooperacional => :P405_NAOOPERACIONAL,
                                                     PMD5 => :P405_MD5,
                                                     POPERACAO_DML => voperacao_dml);
                  --
                  if v('APP_USER') = 'DIEGOPIECHO' THEN
                    apex_application.g_print_success_message := 'TESTE 02';
                  END IF;
                  --
                  :P405_IDSEMANA := vidsemana;
                  :P405_USUARIO  := vusuario;
                   --
                    if voperacao_dml = 'I' then
                      --
                      apex_application.g_print_success_message := '<span style="color : white ">Negociação criada com sucesso! </span>';  
                      
                    elsif  voperacao_dml = 'U' then
                      --
                      apex_application.g_print_success_message := '<span style="color : white ">Alteração realizada com sucesso! </span>';
                    
                    elsif  voperacao_dml = 'D' then
                      --
                      apex_application.g_print_success_message := '<span style="color : white ">Exclusão realizada com sucesso! </span>';
                    end if;
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 5359546584294057963
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('SALVAR','DELETAR','CRIAR')
                ```
        }
    )

    process remover-classificação (
        name: Remover Classificação
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  v_count number;
