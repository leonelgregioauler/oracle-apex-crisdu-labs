page 405 (
    name: Controle de Negociações
    title: Controle de Negociações
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_remover(pid)
            {
              apex.confirm("Deseja realmente remover a classificação?", {
              request:"REMOVER",
              set:{"P405_IDCLASSIFICACAONEGOCIACAO":pid}
              });
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region classificações-da-negociação (
        name: Classificações da Negociação
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select cl.idclassificacaonegociacao
                     , cl.idcaracteristicanegociacao
                     , cl.idnegociacao
                     , cl.dataclassificacao
                     , (select u.usuario
                          from usuarios u
                         where u.idusuario = cl.idusuario) usuario
                     , cl.observacao
                     , ca.descricao
                   --  , '<a href=javascript:fnc_remover('||cl.idclassificacaonegociacao||');><span aria-hidden="true" class="fa fa-trash-o"></span></a>' remover
                     --, '<a href=javascript:fnc_remover('||cl.idclassificacaonegociacao||');><img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt=""></a>' remover
                  from classificacoesnegociacoes cl
                     , caracteristicasnegociacoes ca
                 where cl.idcaracteristicanegociacao = ca.idcaracteristicanegociacao
                   and cl.idnegociacao = :P405_IDNEGOCIACAO
                   --ORDER BY cl.dataclassificacao DESC
                   --<img src="#IMAGE_PREFIX#menu/trash_32.gif" style="max-width:px;" alt="" title="" />
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from classificacoesnegociacoes cl
                 where cl.idnegociacao = :P405_IDNEGOCIACAO
                ```
        }
        edit {
            enabled: true
            allowedOperations: delete
        }
        performance {
            lazyLoading: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            showTotalCount: false
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                saveButton
            ]
        }
        enableUsersTo {
            download: false
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 3493813777559140611
        }

