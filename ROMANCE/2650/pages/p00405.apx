    process consulta-em-negociações (
        name: Consulta em Negociações
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vvalortotal   number(15,2) := replace(:P405_VALORTOTAL ,'.','');
                  vvalor        number(15,2) := replace(:P405_VALOR ,'.','');
                  ventrada      number(15,2) := replace(:P405_ENTRADA ,'.','');
                  vvalorjuros   number(15,2) := replace(:P405_VALORJUROS ,'.','');
                  vvalorpago    number(15,2) := replace(:P405_VALORPAGO ,'.','');
                  vsaldo        number(15,2) := replace(:P405_SALDO ,'.','');
                  vVALORDESCONTONEGOCIACAO number(15,2) := replace(:P405_VALORDESCONTONEGOCIACAO ,'.','');
                  vdata         date;
                  vcancelado   varchar2(1);
                  --
                begin
                  --
                  PCK_CADASTROS_RMC.PRC_NEGOCIACOES( PIDNEGOCIACAO        => :P405_IDNEGOCIACAO,
                                                     PIDTIPONEGOCIACAO    => :P405_IDTIPONEGOCIACAO,
                                                     PIDFILIAL            => :P405_IDFILIAL,
                                                     PIDREPRESENTANTE     => :P405_IDREPRESENTANTE,
                                                     PIDPESSOA            => :P405_IDPESSOA,
                                                     PIDSEMANA            => :P405_IDSEMANA,
                                                     PDATA                => vdata,
                                                     PUSUARIO             => :P405_USUARIO,
                                                     PVALOR               => vvalor,
                                                     PENTRADA             => ventrada,
                                                     PTIPOENTRADA         => :P405_TIPOENTRADA,
                                                     PVALORJUROS          => vvalorjuros,
                                                     PVALORTOTAL          => vvalortotal,
                                                     PVALORPAGO           => vvalorpago,
                                                     PSALDO               => vsaldo,
                                                     PPARCELAS            => :P405_PARCELAS,
                                                     POBSERVACAO          => :P405_OBSERVACAO,
                                                     PIDUNIDADEDENEGOCIO  => :P405_IDUNIDADEDENEGOCIO,
                                                     PIDMATRIZENTRADA     => :P405_IDMATRIZENTRADA,
                                                     PPERDA               => :P405_PERDA,
                                                     pidfechamento        => :P405_idfechamento,
                                                     pdistrato            => :P405_distrato,
                                                     pcancelado           => vcancelado,
                                                     pvalordescontonegociacao => vVALORDESCONTONEGOCIACAO,
                                                     pnaooperacional      => :P405_NAOOPERACIONAL,
                                                     PMD5                 => :P405_MD5,
                                                     POPERACAO_DML        => 'S');
                  --
                  
                  --:P405_VALOR      := trim(to_char(vvalor      ,'999G999G999G999G999G990D00')); 
                  --:P405_ENTRADA    := trim(to_char(ventrada    ,'999G999G999G999G999G990D00')); 
                  ---:P405_VALORJUROS := trim(to_char(vvalorjuros ,'999G999G999G999G999G990D00')); 
                 -- :P405_VALORTOTAL := trim(to_char(vvalortotal ,'999G999G999G999G999G990D00')); 
                  --:P405_VALORPAGO  := trim(to_char(vvalorpago  ,'999G999G999G999G999G990D00')); 
                  --:P405_VALORPAGO  := vvalorpago; 
                  :P405_SALDO      := to_char(vsaldo     ,'999G999G999G999G999G990D00'); 
                  :P405_VALOR      := to_char(vvalor      ,'999G999G999G999G999G990D00'); 
                  :P405_ENTRADA    := to_char(ventrada    ,'999G999G999G999G999G990D00'); 
                  :P405_VALORJUROS := to_char(vvalorjuros ,'999G999G999G999G999G990D00'); 
                  --:P405_VALORTOTAL := to_char(vvalortotal ,'999G999G999G999G999G990D00'); 
                  :P405_VALORPAGO  := to_char(vvalorpago  ,'999G999G999G999G999G990D00'); 
                  :P405_VALORDESCONTONEGOCIACAO := to_char(vVALORDESCONTONEGOCIACAO  ,'999G999G999G999G999G990D00'); 
                  --
                  :P405_DATA       := to_date(vdata,'DD/MM/RRRR HH24:MI:SS');
                  --
                  select decode(vcancelado,'S','Sim','Não')
                    into :P405_cancelado
                    from dual;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 5356974512915876829
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P405_IDNEGOCIACAO
        }
    )

