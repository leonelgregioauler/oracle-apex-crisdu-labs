    pageItem P405_VALORPAGO (
        type: displayOnly
        label {
            label: Pago ( - )
            alignment: left
        }
        layout {
            sequence: 200
            region: @negociação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select to_char(nvl(t.pago,0) + nvl(n.entrada,0),'999G999G999G999G999G990D00')
                from ( 
                        select nvl(sum(pn.valorpago),0) pago
                        from pagamentosnegociacoes pn
                        where pn.idnegociacao = :P405_IDNEGOCIACAO
                          and pn.situacao = 'Q' ) t
                   , ( select nvl(entrada,0) entrada
                       from negociacoes n
                       where n.idnegociacao = :P405_IDNEGOCIACAO ) n
                ```
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P405_IDNEGOCIACAO
        }
        security {
            encryptSessionState: false
        }
    )

