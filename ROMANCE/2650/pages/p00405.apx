                items: {
                    P440_IDNEGOCIACAO: &P405_IDNEGOCIACAO.
                    P440_VALORPAGO: &P405_SALDO.
                }
                clearCache: 440
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select * 
                from dual
                where not exists ( select 1 
