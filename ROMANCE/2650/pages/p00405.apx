    pageItem P405_IDFECHAMENTO (
        type: selectList
        label {
            label: Fechamento
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select semana display_value
                     , idfechamento return_value
                from fechamentossemanais
                where idfilial = :P405_IDFILIAL
                  and concluido = 'N'
                  and :P405_IDTIPONEGOCIACAO = 4
                 -- and :P405_IDNEGOCIACAO IS not NULL
                order by 2 desc
                ```
        }
        cascadingLov {
            parentItems: [
                P405_IDFILIAL
                P405_IDTIPONEGOCIACAO
            ]
            parentRequired: false
        }
        layout {
            sequence: 260
            region: @negociação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        serverSideCondition {
            type: item=value
            item: P405_IDTIPONEGOCIACAO
            value: 4
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P405_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idfilial
                from vw_filiais f
                where f.ativo = 'S'
                ```
        }
        layout {
            sequence: 50
            region: @negociação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select * 
                from dual
                where exists ( select 1 
                             from roman.pagamentosnegociacoes p
                             where p.idnegociacao = :P405_IDNEGOCIACAO )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P405_IDMATRIZENTRADA (
        type: selectList
