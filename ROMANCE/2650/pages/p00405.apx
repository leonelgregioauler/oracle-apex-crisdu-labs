        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select mc.classificacaoentrada||' ('||f.nome||')' classificacaoentrada
                     , mc.idmatrizentrada
                from roman.matrizclassificacoesentradas mc
                   , roman.vw_filiais f
                where  mc.idfilial = f.idfilial
                  and f.idunidadedenegocio = :P405_IDUNIDADEDENEGOCIO
                  order by 1
                ```
        }
        cascadingLov {
            parentItems: P405_IDUNIDADEDENEGOCIO
        }
        layout {
