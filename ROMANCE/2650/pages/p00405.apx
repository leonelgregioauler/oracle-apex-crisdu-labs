    pageItem P405_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(r.idrepresentante) display_value
                     , r.idrepresentante return_value
                from representantes r
                   , gerentes g
                where r.idgerente = g.idgerente
                  and g.idfilial  = :P405_IDFILIAL
                order by 1
                ```
        }
