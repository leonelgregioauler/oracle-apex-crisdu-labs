page 143 (
    name: Anexos de Saídas
    title: Anexos de Saídas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 40%
        height: 60%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function fnc_verimg(pid)
            {
              window.open('http://anexos.romancemoda.com.br/'+pid);
              void(0);
            }
            
            function fnc_removeanexo(pidanexo,pnomeanexo)
            {
                apex.confirm("Deseja realmente remover o anexo "+pnomeanexo+"?", {
              request:"DELETAR",
              set:{"P143_IDANEXODELETAR":pidanexo}
              });
            }
            ```
    }

    region anexos-de-saídas (
        name: Anexos de Saídas
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    region arquivos-anexados (
        name: Arquivos Anexados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomearquivo
                --     , idsaida||idanexosaida||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10) link
                     , url_bucket link
                --     , '<a href="javascript: fnc_verimg('''||idsaida||idanexosaida||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10)||''');">Ver arquivo</a>' link
                     , dataanexo
                     , ( select pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario ) usuario 
                     , '<a href="javascript: fnc_removeanexo('||idanexosaida||','''||t.nomearquivo||''');">Remover</a>' remover
                from anexossaidas t
                where idsaida = :P143_IDSAIDA
                order by t.dataanexo
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P143_IDSAIDA
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 2175203154133327908
        }

        column DATAANEXO (
            type: plainText
            heading {
                heading: Data Anexo
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column LINK (
            type: link
            heading {
                heading: Link
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            link {
                target: {
                    type: url
                    url: #LINK#
                }
                linkText: Ver Arquivo
                linkAttributes: target="_blank"
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NOMEARQUIVO (
            type: plainText
            heading {
                heading: Arquivo
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column REMOVER (
            type: plainText
            heading {
                heading: Remover
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
            security {
                escapeSpecialChars: false
            }
        )

        column USUARIO (
            type: plainText
            heading {
                heading: Anexado Por
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        savedReport 14081389 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAANEXO (
                sequence: 3
            )

            displayColumn LINK (
                sequence: 2
            )

            displayColumn NOMEARQUIVO (
                sequence: 1
            )

            displayColumn REMOVER (
                sequence: 5
            )

            displayColumn USUARIO (
                sequence: 4
            )

        )

    )

    pageItem P143_ARQUIVOTEMP (
        type: fileUpload
        label {
            label: Arquivo
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
        }
        storage {
            filenameColumn: NOMEARQUIVO
        }
        layout {
            sequence: 20
            region: @anexos-de-saídas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: ARQUIVOTEMP
            used: always
        }
    )

    pageItem P143_DATAANEXO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @anexos-de-saídas
            slot: regionBody
        }
        appearance {
            formatMask: DD/MM/RRRR HH24:MI:SS
        }
        source {
            type: databaseColumn
            databaseColumn: DATAANEXO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  return sysdate;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P143_IDANEXODELETAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @anexos-de-saídas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P143_IDANEXOSAIDA (
        type: hidden
        layout {
            sequence: 10
            region: @anexos-de-saídas
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDANEXOSAIDA
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P143_IDSAIDA (
        type: numberField
        label {
            label: ID Saída
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 20
            region: @anexos-de-saídas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: IDSAIDA
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P143_IDUSUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @anexos-de-saídas
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDUSUARIO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidusuario number;
                begin
                  --
                  select idusuario 
                  into vidusuario 
                  from usuarios
                  where usuario = v('APP_USER');
                  --
                  return vidusuario;
                  --
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P143_NOMEARQUIVO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @anexos-de-saídas
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: NOMEARQUIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Anexar este arquivo!
        layout {
            sequence: 30
            region: @anexos-de-saídas
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P143_IDANEXOSAIDA
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 20
            region: @anexos-de-saídas
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P143_IDANEXOSAIDA
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @arquivos-anexados
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 93
                items: {
                    P93_IDSAIDA: &P143_IDSAIDA.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process anexar (
        name: Anexar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  commit;
                  -- Call the procedure
                  pck_anexos.blob_to_file_saidas(pidsaida => :P143_IDSAIDA
                                                ,pidanexo => :P143_IDANEXOSAIDA);
                  commit;
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 1408143288473832339
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process deletar (
        name: Deletar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  :P143_IDANEXOSAIDA := null;
                  pck_anexos.prc_apagaanexo_saidas(pidanexosaida => :P143_IDANEXODELETAR);
                end;
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 1408143602985832341
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    process fetch-row-from-anexossaidas (
        name: Fetch Row from ANEXOSSAIDAS
        type: autoRowFetch
        source {
            tableName: ANEXOSSAIDAS
            pkColumn: IDANEXOSAIDA
            pkItem: P143_IDANEXOSAIDA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1408144037415832341
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P143_IDANEXOSAIDA is null then
                        select "#OWNER#"."SEQ_IDANEXOSAIDA".nextval
                          into :P143_IDANEXOSAIDA
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1408144418748832342
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-anexossaidas (
        name: Process Row of ANEXOSSAIDAS
        type: autoRowProcessing
        target {
            tableName: ANEXOSSAIDAS
            pkColumn: IDANEXOSAIDA
            pkItem: P143_IDANEXOSAIDA
            supportedOperations: [
                insert
                update
            ]
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Arquivo anexado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1408144820015832342
        }
    )

    branch (
        name: Go To Page 143
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 143
                items: {
                    P143_IDSAIDA: &P143_IDSAIDA.
                    P143_IDANEXOSAIDA:
                    P143_IDANEXODELETAR:
                }
                action: resetPagination
            }
        }
    )

)

