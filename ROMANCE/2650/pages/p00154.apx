page 154 (
    name: Arquivos Anexados em Saidas
    title: Arquivos Anexados em Saidas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_verimg(pid)
            {
              window.open('http://anexos.romancemoda.com.br/'+pid);
              void(0);
            }
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region arquivos-anexados-em-saidas (
        name: Arquivos Anexados em Saidas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomearquivo
                     --, idsaida||idanexosaida||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10) link
                     , roman.pck_bucket.sp_abre_anexo(url_bucket) preview
                     , dataanexo
                     , ( select pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario ) usuario 
                     , APEX_ITEM.CHECKBOX2(1, idsaida , NULL ) visto
                from roman.anexossaidas t
                where idsaida = :P154_IDSAIDA
                order by t.dataanexo
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 1408154726616200138
        }

        column DATAANEXO (
            type: plainText
            heading {
                heading: Data do Anexo
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column NOMEARQUIVO (
            type: plainText
            heading {
                heading: Nome do Arquivo
                alignment: center
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column PREVIEW (
            type: plainText
            heading {
                heading: Anexo
                alignment: center
            }
            layout {
                sequence: 24
