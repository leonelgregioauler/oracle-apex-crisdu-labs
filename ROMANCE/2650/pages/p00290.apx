page 290 (
    name: Venda para Romance
    title: Venda para Romance
    appearance {
        pageMode: nonModalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 900
        height: 800
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region venda-para-romance-por-nota (
        name: Venda para Romance - POR NOTA
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial( nn.idfilialdestino )  "Empresa Destino"
                     , nn.documento rnf
                     , NN.valortotal                                   
                     ,  ( select sum( i.valortotal)
                          from itemnf i          
                          where i.idnotafiscal   = nn.idnotafiscal
                            and not exists ( select 1
                                             from classificacoesprodutos c
                                             where c.idproduto = i.idproduto
                                               and c.idcaracteristicaproduto = 0 ) ) valorproprio
                     ,  ( select sum( i.valortotal)
                          from itemnf i          
                          where i.idnotafiscal   = nn.idnotafiscal
                            and exists ( select 1
                                         from classificacoesprodutos c
                                         where c.idproduto = i.idproduto
                                           and c.idcaracteristicaproduto = 0 ) ) valordeterceiro
                     ,  ( select listagg(pck_romance.fnc_nomeproduto(i.idproduto)) within group (order by 1)
                          from itemnf i          
                          where i.idnotafiscal   = nn.idnotafiscal  ) produtos
                from  notasfiscais nn
                where nn.idfornemitente       = pck_romance.fnc_fornecedorfilial( 1075 )
                  and trim(to_char(extract( month from nn.dtnf ),'00')) || extract( year  from nn.dtnf ) = :P290_MESANO
                order by 1  
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 300
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: setPaginationSelectList
        }
        performance {
            maxRowsToProcess: 5000
        }
        messages {
            whenNoDataFound: No data found.
        }
        breakFormatting {
            breakColumns: col1
        }
        componentAdvanced {
            stripHtml: true
        }
        download {
            csvExportEnabled: true
        }

        column "Empresa Destino" (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Empresa destino
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column PRODUTOS (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Produtos
                alignment: center
            }
            layout {
                sequence: 6
            }
            sorting {
                sortable: false
            }
        )

        column RNF (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Rnf
                alignment: center
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

        column VALORDETERCEIRO (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Valor de Terceiro
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
            advanced {
                computeSum: true
            }
        )

        column VALORPROPRIO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Valor Próprio
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
            sorting {
                sortable: false
            }
            advanced {
                computeSum: true
            }
        )

        column VALORTOTAL (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Valor Total Nota
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
            advanced {
                computeSum: true
            }
        )

    )

    region venda-para-romance-por-vencimento (
        name: Venda para Romance - POR VENCIMENTO
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.idvencimento
                     , v.datavencimento dtvencimento
                     , pck_romance.fnc_nomefilial( nn.idfilialdestino )  "Empresa Destino"
                     , ( select s.semana  
                         from semana_dias s
                         where v.datavencimento between s.dt_ini and s.dt_fim ) Semanan
                     , nn.documento rnf
                     , v.valor                     
                from vencimentos  v
                   ,  notasfiscais nn
                where to_char( datavencimento,'MMRRRR') = :P290_MESANO
                  and v.idnotafiscal           = nn.idnotafiscal
                  and nn.idfornemitente       = pck_romance.fnc_fornecedorfilial( 1075 )
                ```
        }
        layout {
            sequence: 30
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: never
        }
        reportLayout {
            numberOfRows: 300
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: setPaginationSelectList
        }
        performance {
            maxRowsToProcess: 5000
        }
        messages {
            whenNoDataFound: No data found.
        }
        breakFormatting {
            breakColumns: col1
        }
        componentAdvanced {
            stripHtml: true
        }
        download {
            csvExportEnabled: true
        }

        column DTVENCIMENTO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Vencimento
                alignment: center
            }
            layout {
                sequence: 2
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
            sorting {
                defaultSequence: 1
            }
        )

        column "Empresa Destino" (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Empresa destino
                alignment: center
            }
            layout {
                sequence: 3
            }
        )

        column IDVENCIMENTO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column RNF (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Rnf
                alignment: center
            }
            layout {
                sequence: 5
            }
        )

        column SEMANAN (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Semana
                alignment: center
            }
            layout {
                sequence: 4
            }
            appearance {
                formatMask: 00
            }
        )

        column VALOR (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Valor
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            advanced {
                computeSum: true
            }
        )

    )

    pageItem P290_IDFORNECEDOR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @venda-para-romance-por-nota
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P290_MESANO (
        type: textField
        label {
            label: Semana
            alignment: left
        }
        layout {
            sequence: 10
            region: @venda-para-romance-por-nota
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 8
        }
        advanced {
            customAttributes: readonly
        }
        security {
            encryptSessionState: false
        }
    )

)

