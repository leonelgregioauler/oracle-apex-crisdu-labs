page 375 (
    name: "Lançamento Diverso "
    title: "Lançamento Diverso "
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }

    region lançamento-diverso (
        name: "Lançamento Diverso "
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P375_DATA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 180
            region: @lançamento-diverso
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: DATA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P375_DATAVENCIMENTO (
