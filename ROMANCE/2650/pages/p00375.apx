    pageItem P375_IDFORNECEDOREMITENTE (
        type: selectList
        label {
            label: Fornecedor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) display_value
                     , f.idfornecedor return_value 
                from fornecedores f
                   , pessoas p
                where f.idpessoa = p.idpessoa
                  and f.ativo    = 'S'
                  and exists ( select 1
                               from matrizregrasdespesas m
                               where m.idfornecedor = f.idfornecedor )
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @lançamento-diverso
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFORNECEDOREMITENTE
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

