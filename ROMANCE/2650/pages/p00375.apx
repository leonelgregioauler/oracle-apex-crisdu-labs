    button aplicar (
        buttonName: APLICAR
        label: Aplicar Alterações
        layout {
            sequence: 20
            region: @lançamento-diverso
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
    )

