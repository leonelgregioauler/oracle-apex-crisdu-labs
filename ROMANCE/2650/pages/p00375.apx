    process fetch-row-from-lancamentosdiversos (
        name: Fetch Row from LANCAMENTOSDIVERSOS
        type: autoRowFetch
        source {
            tableName: LANCAMENTOSDIVERSOS
            pkColumn: IDLANCAMENTODIVERSO
            pkItem: P375_IDLANCAMENTODIVERSO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 54567952527409408
        }
    )

    process process-row-of-lancamentosdiversos (
        name: Process Row of LANCAMENTOSDIVERSOS
        type: autoRowProcessing
        target {
            tableName: LANCAMENTOSDIVERSOS
            pkColumn: IDLANCAMENTODIVERSO
            pkItem: P375_IDLANCAMENTODIVERSO
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: "Ação Processada. "
        }
        advanced {
            executionMappingIdentifier: 54568726141409412
        }
    )

    process processos-em-lançamentos-diversos (
        name: Processos em Lançamentos Diversos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  voperacao_dml varchar2(1);
                  --
                begin
                  --
                  if v('REQUEST') = 'DELETAR' then
                    voperacao_dml := 'D';
                  elsif v('REQUEST') = 'APLICAR' then
                    voperacao_dml := 'U';
                  end if;
                  --
                  pck_notasfiscais_rmc.prc_atualizalancamentos(pidlancamentodiverso => :p375_idlancamentodiverso,
                                                               poperacao_dml => voperacao_dml);
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Valor alterado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 54593497501930109
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('DELETAR','APLICAR')
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 374
                items: {
                    P374_DOCUMENTO:
                    P374_FORMAPAGAMENTO:
                    P374_IDFORNECEDOR:
                    P374_INICIAR: N
                    P374_VENCIMENTO:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @deletar
        }
    )

)

