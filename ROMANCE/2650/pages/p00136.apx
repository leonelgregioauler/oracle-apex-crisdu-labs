page 136 (
    name: Cadastro de Vendedoras
    title: Cadastro de Vendedoras
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 70%
        height: 70%
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region cadastro-de-vendedoras (
        name: Cadastro de Vendedoras
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P136_ATIVO (
        type: selectList
        label {
            label: Ativo
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @cadastro-de-vendedoras
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: ATIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P136_IDPESSOA (
        type: hidden
        layout {
            sequence: 60
            region: @cadastro-de-vendedoras
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDPESSOA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P136_IDREPRESENTANTE (
        type: selectList
        label {
            label: Representante
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(pr.nomepessoa||' ['||pr.apelido||'] ( '||nvl(p.apelido,p.nomepessoa)||' )'
                ||' ['||pr.codigosisdist||']') display_value
                     , r.idrepresentante  return_value
                from estados         e
                   , cidades         c
                   , pessoas         p
                   , filiais         f
                   , gerentes        g
                   , representantes  r
                   , pessoas         pr
                where c.idestado        = e.idestado
                  and p.idcidade        = c.idcidade
                  and r.idpessoa        = pr.idpessoa
                  and f.idpessoa        = p.idpessoa
                  and g.idfilial        = f.idfilial
                  and r.idgerente       = g.idgerente
                  and r.ativo           = 'S'
                  order by 1
                ```
            nullDisplayValue: - Selecione o Representante -
        }
        layout {
            sequence: 20
            region: @cadastro-de-vendedoras
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDREPRESENTANTE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P136_IDVENDEDORA (
        type: hidden
        layout {
            sequence: 10
            region: @cadastro-de-vendedoras
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDVENDEDORA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P136_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 50
            region: @cadastro-de-vendedoras
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 500
        }
        source {
            type: databaseColumn
            databaseColumn: OBSERVACAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P136_PONTOS (
        type: numberField
        label {
            label: Pontos
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 40
            region: @cadastro-de-vendedoras
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        validation {
            maxLength: 4000
        }
        source {
            type: databaseColumn
            databaseColumn: PONTOS
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 30
            region: @cadastro-de-vendedoras
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P136_IDVENDEDORA
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 10
            region: @cadastro-de-vendedoras
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P136_IDVENDEDORA
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Alterações
        layout {
            sequence: 20
            region: @cadastro-de-vendedoras
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P136_IDVENDEDORA
        }
    )

    process fetch-row-from-vendedoras (
        name: Fetch Row from VENDEDORAS
        type: autoRowFetch
        source {
            tableOwner: CATAL
            tableName: VENDEDORAS
            pkColumn: IDVENDEDORA
            pkItem: P136_IDVENDEDORA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Não é possível extrair a linha.
        }
        advanced {
            executionMappingIdentifier: 184661133380005080
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDVENDEDORA.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P136_IDVENDEDORA := get_pk; 
                end;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Não é possível obter valor de item de chave primária.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 184661330396005081
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-vendedoras (
        name: Process Row of VENDEDORAS
        type: autoRowProcessing
        target {
            tableOwner: CATAL
            tableName: VENDEDORAS
            pkColumn: IDVENDEDORA
            pkItem: P136_IDVENDEDORA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        error {
            errorMessage: Não é possível processar a linha da tabela VENDEDORAS.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 184661527066005081
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 184661732815005083
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 136
            }
            saveStateBeforeBranching: true
        }
    )

)

