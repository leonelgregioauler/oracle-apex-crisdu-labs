page 9 (
    name: Cadastro de Categorias
    title: Cadastro de Categorias
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function fnc_popup(editar)
            {vid = document.getElementById("P9_IDCATEGORIA").value;
            
            window.open('f?p=&APP_ID.:212:&SESSION.::NO::P212_IDCARACTERISTICACATEG,P212_IDCATEGORIA:'+editar+','+vid ,'cadastro', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1000,height=200,left=250,top=100','_blank'); void(0);
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region cadastro-de-categorias (
        name: Cadastro de Categorias
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region caracteristicas (
        name: Caracteristicas
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDCARACTERISTICACATEG
                     , NOME
                     , IDCATEGORIA
                     , decode(TIPO,'M','Material','C','Característica','D','Modelo','S','Gênero') tipo
                from CARACTERISTICASCATEGORIAS
                where idcategoria = :P9_IDCATEGORIA
                order by 4
                ```
        }
        layout {
            sequence: 20
            parentRegion: @cadastro-de-categorias
            slot: subRegions
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P9_IDCATEGORIA
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Não há característica cadastrada.
        }
        componentAdvanced {
            stripHtml: true
        }

        column IDCARACTERISTICACATEG (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: ID
                alignment: center
            }
            layout {
                sequence: 2
            }
        )

        column IDCATEGORIA (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 5
            }
        )

        column LINK$01 (
            reportColumnQueryId: 5
            derivedColumn: Y
            type: link
            heading {
                heading: &nbsp;
                alignment: center
            }
            layout {
                sequence: 1
            }
            link {
                target: {
                    page: 212
                    items: {
                        P212_IDCATEGORIA: #IDCATEGORIA#
                        P212_IDCARACTERISTICACATEG: #IDCARACTERISTICACATEG#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NOME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

        column TIPO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Tipo
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

    )

    region grades (
        name: Grades
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDGRADE",
                "IDGRADE" IDGRADE_DISPLAY,
                "DESCRICAO",
                "SIGLA",
                "ORDEM"
                from "#OWNER#"."GRADES"
                ```
        }
        layout {
            sequence: 35
            slot: body-3
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: never
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (nulo)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Dados não encontrados.
        }

        column CHECK$01 (
            reportColumnQueryId: 1
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: &nbsp;
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column DESCRICAO (
            reportColumnQueryId: 4
            derivedColumn: N
            type: textField
            heading {
                heading: Descricao
                alignment: center
            }
            layout {
                sequence: 4
            }
            appearance {
                width: 16
            }
        )

        column IDGRADE (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDGRADE
            }
        )

        column IDGRADE_DISPLAY (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Idgrade
                alignment: center
            }
            layout {
                sequence: 3
            }
        )

        column ORDEM (
            reportColumnQueryId: 6
            derivedColumn: N
            type: textField
            heading {
                heading: Ordem
                alignment: center
            }
            layout {
                sequence: 6
            }
            appearance {
                width: 16
            }
        )

        column SIGLA (
            reportColumnQueryId: 5
            derivedColumn: N
            type: textField
            heading {
                heading: Sigla
                alignment: center
            }
            layout {
                sequence: 5
            }
            appearance {
                width: 12
            }
        )

    )

    pageItem P9_ATIVO (
        type: selectList
        label {
            label: Ativo
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @cadastro-de-categorias
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: ATIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P9_DESCRICAO (
        type: textField
        label {
            label: Descrição
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @cadastro-de-categorias
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 80
        }
        validation {
            maxLength: 100
        }
        source {
            type: databaseColumn
            databaseColumn: DESCRICAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P9_IDCATEGORIA (
        type: displayOnly
        label {
            label: ID Categoria
            alignment: left
        }
        layout {
            sequence: 1
            region: @cadastro-de-categorias
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: IDCATEGORIA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P9_NOME (
        type: textField
        label {
            label: Nome
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @cadastro-de-categorias
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 50
        }
        source {
            type: databaseColumn
            databaseColumn: NOME
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P9_OBSERVACAO (
        type: hidden
        layout {
            sequence: 60
            region: @cadastro-de-categorias
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: OBSERVACAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P9_PERCLUCRO (
        type: hidden
        layout {
            sequence: 40
            region: @cadastro-de-categorias
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: PERCLUCRO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P9_REFERENCIA (
        type: textField
        label {
            label: Referência Base
            alignment: left
        }
        layout {
            sequence: 70
            region: @cadastro-de-categorias
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        validation {
            maxLength: 3
        }
        source {
            type: databaseColumn
            databaseColumn: REFERENCIA
            used: always
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('APP_USER') in ('GUILHERME','FERNANDO')
        }
        readOnly {
            type: itemIsNotNull
            item: P9_REFERENCIA
        }
        security {
            encryptSessionState: false
        }
    )

    button add (
        buttonName: ADD
        label: Adicionar Linha
        layout {
            sequence: 40
            region: @grades
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button cadastrar (
        buttonName: CADASTRAR
        label: Cadastrar
        layout {
            sequence: 10
            region: @caracteristicas
            slot: aboveBox
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 212
                items: {
                    P212_IDCATEGORIA: &P9_IDCATEGORIA.
                    P212_IDCARACTERISTICACATEG:
                    P212_NOME:
                    P212_TIPO:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @grades
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 9
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 40
            region: @cadastro-de-categorias
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P9_IDCATEGORIA
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @cadastro-de-categorias
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P9_IDCATEGORIA
        }
    )

    button multi-row-delete (
        buttonName: MULTI_ROW_DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @grades
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'MULTI_ROW_DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @cadastro-de-categorias
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P9_IDCATEGORIA
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Submeter
        layout {
            sequence: 30
            region: @grades
            slot: CHANGE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation ordem-must-be-numeric (
        name: ORDEM must be numeric
        execution {
            sequence: 50
        }
        validation {
            editableRegion: @grades
            type: columnIsNumeric
            column: ORDEM
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ser numérico.
            associatedColumn: ORDEM
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @grades
        target {
            tableName: GRADES
            pkColumn: IDGRADE
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Linha(s) #MRD_COUNT# deletadas.
        }
        error {
            errorMessage: Não é possível processar a deleção.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 181407423939618893
        }
        serverSideCondition {
            type: request=Value
            value: MULTI_ROW_DELETE
            executeCondition: once
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @grades
        target {
            tableName: GRADES
            pkColumn: IDGRADE
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Linha(s) #MRU_COUNT# atualizada(s); linha(s) #MRI_COUNT# inserida(s).
        }
        error {
            errorMessage: Não foi possível processar a atualização.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 181407237638618892
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process fetch-row-from-categorias (
        name: Fetch Row from CATEGORIAS
        type: autoRowFetch
        source {
            tableName: CATEGORIAS
            pkColumn: IDCATEGORIA
            pkItem: P9_IDCATEGORIA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Unable to fetch row.
        }
        advanced {
            executionMappingIdentifier: 181068442080645928
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDCATEGORIA.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P9_IDCATEGORIA := get_pk; 
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Unable to get primary key item value.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 181068664466645931
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-categorias (
        name: Process Row of CATEGORIAS
        type: autoRowProcessing
        target {
            tableName: CATEGORIAS
            pkColumn: IDCATEGORIA
            pkItem: P9_IDCATEGORIA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        error {
            errorMessage: Unable to process row of table CATEGORIAS.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 181068865131645931
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 181069047912645934
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 2
            }
            saveStateBeforeBranching: true
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 9
            }
            saveStateBeforeBranching: true
        }
    )

)

