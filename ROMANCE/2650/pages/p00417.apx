page 417 (
    name: Itens da Transferência
    title: Itens da Transferência
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region itens-da-transferência (
        name: Itens da Transferência
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P417_CUSTOUND (
        type: numberField
        label {
            label: Custo
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 50
            region: @itens-da-transferência
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G990D00
            width: 6
        }
        validation {
            maxLength: 10
        }
        source {
            type: databaseColumn
            databaseColumn: CUSTOUND
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P417_IDITNF (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @itens-da-transferência
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDITNF
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P417_IDNOTAFISCAL (
        type: hidden
        settings {
            valueProtected: false
        }
