    button create (
        buttonName: CREATE
        label: Adicionar
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P417_IDITNF
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P417_IDITNF
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P417_IDITNF
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @buttons
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 396
                items: {
                    P396_IDNOTAFISCAL: &P417_IDNOTAFISCAL.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process fetch-row-from-itemnf (
        name: Fetch Row from ITEMNF
        type: autoRowFetch
        source {
            tableName: ITEMNF
            pkColumn: IDITNF
            pkItem: P417_IDITNF
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 221505516408469873
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P417_IDITNF is null then
                        select "#OWNER#"."SEQ_IDTEMNF".nextval
                          into :P417_IDITNF
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 221505943627469874
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-itemnf (
        name: Process Row of ITEMNF
        type: autoRowProcessing
        target {
            tableName: ITEMNF
            pkColumn: IDITNF
            pkItem: P417_IDITNF
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Processo realizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 221506249123469874
        }
    )

    branch (
        name: Go To Page 396
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 396
                items: {
                    P396_IDNOTAFISCAL: &P417_IDNOTAFISCAL.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: DELETE
        }
    )

)

