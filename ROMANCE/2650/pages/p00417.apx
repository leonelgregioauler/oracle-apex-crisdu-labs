        }
    )

    pageItem P417_IDPRODUTO (
        type: selectList
        label {
            label: Produto
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.codigosisdist||' - '||initcap(p.nomeproduto) display_value
                     , p.idproduto return_value
                from produtos p
                where idproduto = :P417_IDPRODUTO
                ```
        }
        layout {
            sequence: 40
            region: @itens-da-transferência
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDPRODUTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P417_PRODUTODNAOCADASTRADO (
        type: displayOnly
        label {
            alignment: left
        }
        layout {
            sequence: 10
            region: @itens-da-transferência
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vnome varchar2(4000);
                begin
                  --
                  select i.nomeprodutosemcad
                  into vnome
                  from itemnf i
                  where i.iditnf = :P417_IDITNF;
                  --
                  return vnome;
                  --
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

