page 54 (
    name: Lista de Comissões por Filial
    title: Lista de Comissões por Filial
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region lista-de-comissões-por-filial (
        name: Lista de Comissões por Filial
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idcomissaofilial
                     , initcap(nvl(p.apelido,p.nomepessoa)) "Filial"
                     , vlrinicial
                     , vlrfinal
                     , percpromotor
                     , decode(c.ativo,'S','Sim','Não') Ativo
                from comissoesfiliais c
                   , filiais          f
                   , pessoas          p
                where c.idfilial  = f.idfilial
                  and f.idpessoa  = p.idpessoa
                  
                
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 55
                items: {
                    P55_IDCOMISSAOFILIAL: #IDCOMISSAOFILIAL#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhum cadastro efetuado.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column ATIVO (
            type: plainText
            heading {
                heading: Ativo
            }
            layout {
                sequence: 15
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        column Filial (
            type: plainText
            heading {
                heading: Filial
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Filial
                endUserAlias: G
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDCOMISSAOFILIAL (
            type: plainText
            heading {
                heading: Idcomissaofilial
                alignment: center
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDCOMISSAOFILIAL
                endUserAlias: A
            }
            enableUsersTo {
                pivot: false
            }
        )

        column PERCPROMOTOR (
            type: plainText
            heading {
                heading: Perc. Promotor
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: end
            }
            appearance {
                formatMask: 990D00
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: PERCPROMOTOR
                endUserAlias: H
            }
            enableUsersTo {
                pivot: false
            }
        )

        column VLRFINAL (
            type: plainText
            heading {
                heading: Valor Final
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: VLRFINAL
                endUserAlias: D
            }
            enableUsersTo {
                pivot: false
            }
        )

        column VLRINICIAL (
            type: plainText
            heading {
                heading: Valor Inicial
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: VLRINICIAL
                endUserAlias: C
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 15372 (
            visibility: primaryDefault
            view {
                rowsPerPage: 500
            }

            displayColumn "Filial" (
                sequence: 1
            )

            displayColumn PERCPROMOTOR (
                sequence: 4
            )

            displayColumn VLRFINAL (
                sequence: 3
            )

            displayColumn VLRINICIAL (
                sequence: 2
            )

            sort (
                column: VLRINICIAL
                sort {
                    sequence: 1
                }
            )

            controlBreak (
                column: "Filial"
                layout {
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Novo
        layout {
            sequence: 30
            region: @lista-de-comissões-por-filial
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 55
                clearCache: 55
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

