page 140 (
    name: Disribuidores e Consultoras
    title: Disribuidores e Consultoras
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_abre(pid)
            {
             var myWindow =  window.open('f?p=&APP_ID.:184:&SESSION.::NO::P184_SEMANAINI:'+pid,'DETALHE', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1600,height=800,left=10,top=10','_blank'); void(0);
              myWindow.focus();
            }
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region consultoras-por-empresa (
        name: Consultoras por Empresa
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select f.idfilial
                     , pck_romance.fnc_nomefilial(f.idfilial) empresa
                     , count(1) quantidade
                from vendedoras v
                   , representantes r
                   , gerentes g
                   , filiais f
                where v.ativo = 'S'
                  and v.idrepresentante  = r.idrepresentante
                  and r.idgerente        = g.idgerente
                  and g.idfilial         = f.idfilial
                  and f.tipofilial       = 'D'
                  and f.ativo = 'S'
                  and r.ativo = 'S'
                  and f.idfilial not in ( 1063, 1079,160)
                group by f.idfilial
                order by 2
                ```
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: EMPRESA
            valueColumn: QUANTIDADE
            maximumRows: 40
        }
    )

    region distribuidores-por-empresa (
        name: Distribuidores por Empresa
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select f.idfilial
                     , pck_romance.fnc_nomefilial(f.idfilial) empresa
                     , count(1) quantidade
                from representantes r
                   , gerentes g
                   , filiais f
                where r.idgerente      = g.idgerente
                  and g.idfilial       = f.idfilial
                  and f.tipofilial     = 'D'
                  and r.ativo = 'S'
                  and f.ativo          = 'S'
                  and f.idfilial not in ( 1063, 1079,160)
                  and exists ( select 1
                               from regioesrepresentantes rr
                               where rr.idrepresentante  = r.idrepresentante
                                 and rr.ultimaalteracao  >=  trunc(sysdate)-20 )
                group by f.idfilial
                order by 2
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: EMPRESA
            valueColumn: QUANTIDADE
            maximumRows: 40
        }
    )

    region media-consultoras-por-distribuidor (
        name: Media Consultoras por Distribuidor
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select f.idfilial
                     , pck_romance.fnc_nomefilial(f.idfilial) empresa
                     , count(1) quantidade
                     , ( select count(1)
                         from representantes r
                         where idgerente = g.idgerente
                           and ativo = 'S' 
                          and exists ( select 1
                                       from regioesrepresentantes rr
                                       where rr.idrepresentante  = r.idrepresentante
                                         and rr.ultimaalteracao  >=  trunc(sysdate)-20 )) disti
                     , case 
                        when ( select count(1)
                               from representantes r
                               where idgerente = g.idgerente
                                 and ativo = 'S' 
                                  and exists ( select 1
                                               from regioesrepresentantes rr
                                               where rr.idrepresentante  = r.idrepresentante
                                                 and rr.ultimaalteracao  >=  trunc(sysdate)-20 )) > 0 then
                             round(count(1) 
                            /  ( select count(1)
                         from representantes r
                         where idgerente = g.idgerente
                           and ativo = 'S' 
                          and exists ( select 1
                                       from regioesrepresentantes rr
                                       where rr.idrepresentante  = r.idrepresentante
                                         and rr.ultimaalteracao  >=  trunc(sysdate)-20 ))) 
                         else 
                           0
                           end media
                from vendedoras v
                   , representantes r
                   , gerentes g
                   , filiais f
                where v.idrepresentante  = r.idrepresentante
                  and r.idgerente        = g.idgerente
                  and g.idfilial         = f.idfilial
                  and f.tipofilial       = 'D'
                  and v.ativo = 'S'
                  and r.ativo = 'S'
                  and f.ativo = 'S'
                  and f.idfilial not in ( 1063, 1079,160)
                group by f.idfilial, g.idgerente
                order by 2
                ```
        }
        layout {
            sequence: 50
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: EMPRESA
            valueColumn: MEDIA
            maximumRows: 40
        }
    )

    region média-geral (
        name: Média Geral
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select 'Média Geral' media
                     , round(
                        ( select count(1) 
                          from vendedoras v
                             , representantes r
                             , gerentes g
                             , filiais f
                          where v.idrepresentante  = r.idrepresentante
                            and r.idgerente        = g.idgerente
                            and g.idfilial         = f.idfilial
                            and f.tipofilial       = 'D'
                            and v.ativo = 'S'
                            and r.ativo = 'S'
                            and f.ativo = 'S'
                            and f.idfilial not in ( 1063, 1079,160) )
                         / ( select count(1)
                             from representantes r
                             where ativo = 'S' 
                                and exists ( select 1
                                             from regioesrepresentantes rr
                                             where rr.idrepresentante  = r.idrepresentante
                                               and rr.ultimaalteracao  >=  trunc(sysdate)-20 ) ) ) valor
                from dual                               
                ```
        }
        layout {
            sequence: 10
            parentRegion: @media-consultoras-por-distribuidor
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            labelColumn: MEDIA
            valueColumn: VALOR
        }
    )

    region total (
        name: Total
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select 'Total' total
                     , count(1) quantidade
                from representantes r
                   , gerentes g
                   , filiais f
                where r.idgerente      = g.idgerente
                  and g.idfilial       = f.idfilial
                  and f.tipofilial     = 'D'
                  and r.ativo = 'S'
                  and f.ativo          = 'S'
                  and f.idfilial not in ( 1063, 1079,160)
                  and exists ( select 1
                               from regioesrepresentantes rr
                               where rr.idrepresentante  = r.idrepresentante
                                 and rr.ultimaalteracao  >=  trunc(sysdate)-20 )
                order by 2
                ```
        }
        layout {
            sequence: 10
            parentRegion: @distribuidores-por-empresa
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            labelColumn: TOTAL
            valueColumn: QUANTIDADE
        }
    )

    region total-2 (
        name: Total
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select 'Total' total
                     , count(1) quantidade
                from vendedoras v
                   , representantes r
                   , gerentes g
                   , filiais f
                where v.idrepresentante  = r.idrepresentante
                  and r.idgerente        = g.idgerente
                  and g.idfilial         = f.idfilial
                  and f.tipofilial       = 'D'
                  and v.ativo = 'S'
                  and f.ativo = 'S'
                  and f.idfilial not in ( 1063, 1079,160)
                order by 2
                ```
        }
        layout {
            sequence: 10
            parentRegion: @consultoras-por-empresa
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            labelColumn: TOTAL
            valueColumn: QUANTIDADE
        }
    )

)

