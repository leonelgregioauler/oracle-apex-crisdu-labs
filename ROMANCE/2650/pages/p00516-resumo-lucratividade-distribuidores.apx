page 516 (
    name: Resumo Lucratividade Distribuidores
    alias: RESUMO-LUCRATIVIDADE-DISTRIBUIDORES
    title: Resumo Lucratividade Distribuidores
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            $(".emp td[headers=filial]").each(function(){
                let celldata = $(this).text().trim(); // Remove espaços extras
            
                if (celldata === "Soma") {
                    $(this).parent().children().css({
                        "background-color": "#F5F5F5", // Azul Claro e Agradável
                        "font-weight": "bold",
                        "font-size": "13px"
                    });
                }
            
                if (celldata === "Média") {
                    $(this).parent().children().css({
                        "background-color": "#F5F5F5", // Azul Claro e Agradável
                        "font-weight": "bold",
                        "font-size": "13px"
                    });
                }
            });
            ```
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
    )

    region resumo-das-formulas-das-colunas (
        name: Resumo das formulas das colunas
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        headerAndFooter {
            headerText:
                ```html
                <div style="font-family: Arial, sans-serif; font-size: 20px; color: #4a4a4a; text-align: left; padding-top: 20px; padding-bottom: 20px; border: 1px solid #b3b3b3; background-color: #f2f2f2; margin-bottom: 30px;">
                  <ul style="list-style-type: disc; padding-left: 20px;">
                    <div style="margin-bottom: 5px;"> <strong>Colunas:</strong> </div>
                    <li><b>Crédito De Compra: </b> (R$ Cobrança * 0,18) - R$ Resultado </li>
                    <li><b>% Lucro: </b> Indica o percentual que a coluna R$ Resultado representa sobre a coluna R$ Cobrança </li>
                  </ul>
                </div>
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from roman.usuariosgruposatendimento uga
                 where uga.idgrupoatendimento = 0
                   and uga.usuario = v('APP_USER');
                ```
        }
    )

    region resumo-lucratividade-distribuidoras-por-regional (
        name: Resumo Lucratividade Distribuidoras (Por Regional)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select aux.filial
                     , aux.totalcobranca
                     , aux.resultadodasemana
                     , aux.resultadodasemana - (aux.totalcobranca * 0.18)as "Crédito de Compra"
                     , (aux.resultadodasemana * 100) / nullif(aux.totalcobranca, 0)as "% Lucro"
                  from ( select 1 ordem
                              , f.filial
                              , sum(f.totalcobranca) totalcobranca
                              , sum(f.resultadodasemana) resultadodasemana
                           from roman.vw_fechamentosdistribuidoras_mv f
                          where f.idsemana between :P516_ID_SEMANA_INICIO and :P516_ID_SEMANA_FIM
                            and f.idfilial in (select f.idfilial
                                                 from catal.filiais f
                                                where f.regional = :P516_REGIONAL)
                          group by f.filial) aux
                 order by aux.ordem
                        , aux.filial
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: emp
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 378226579308442512
        }

        column "% Lucro" (
            type: plainText
            heading {
                heading: % Lucro
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column "Crédito de Compra" (
            type: plainText
            heading {
                heading: R$ Crédito De Compra
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column FILIAL (
            type: plainText
            heading {
                heading: Filial
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: filial
                endUserAlias: A
            }
        )

        column RESULTADODASEMANA (
            type: plainText
            heading {
                heading: R$ Resultado
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1
                      from roman.usuariosgruposatendimento uga
                     where uga.idgrupoatendimento = 0
                       and uga.usuario = v('APP_USER');
                    ```
            }
        )

        column TOTALCOBRANCA (
            type: plainText
            heading {
                heading: R$ Cobrança
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 3783869 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn "% Lucro" (
                sequence: 5
            )

            displayColumn "Crédito de Compra" (
                sequence: 3
            )

            displayColumn FILIAL (
                sequence: 1
            )

            displayColumn RESULTADODASEMANA (
                sequence: 4
            )

            displayColumn TOTALCOBRANCA (
                sequence: 2
            )

            aggregate (
                column: TOTALCOBRANCA
            )

            aggregate (
                column: "Crédito de Compra"
            )

            aggregate (
                column: RESULTADODASEMANA
            )

        )

    )

    pageItem P516_ID_SEMANA_FIM (
        type: selectList
        label {
            label: <b>Semana Fim</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.semanacompleta as display_value
                     , s.idsemana       as retun_value
                  from roman.semana_dias s
                 where s.idsemana >= 1004
                 order by s.idsemana
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select s.idsemana
                  from roman.semana_dias s
                 where trunc(sysdate) between s.dt_ini and s.dt_fim
                   and rownum = 1
                ```
        }
    )

    pageItem P516_ID_SEMANA_INICIO (
        type: selectList
        label {
            label: <b>Semana Início</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.semanacompleta as display_value
                     , s.idsemana       as retun_value
                  from roman.semana_dias s
                 where s.idsemana >= 1004
                 order by s.idsemana
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select s.idsemana
                  from roman.semana_dias s
                 where trunc(sysdate) between s.dt_ini and s.dt_fim
                   and rownum = 1
                ```
        }
    )

    pageItem P516_REGIONAL (
        type: selectList
        label {
            label: <b>Regional</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Regional 1' as display_value
                     , 1            as return_value
                  from dual
                 where v('APP_USER') in ('RAFAELK','DANIELEPACHECO','NATHALIAKINAST','MAICONAIMI','GUILHERME','DIEGOPIECHO','CESARH','ADRIELMULLER')
                
                union
                
                select 'Regional 2' as display_value
                     , 2            as return_value
                  from dual
                 where v('APP_USER') in ('RAFAELK','NAYARAMUNIZ','NATHALIAKINAST','MAICONAIMI','GUILHERME','DIEGOPIECHO','CESARH','ADRIELMULLER')
                
                union
                
                select 'Regional 3' as display_value
                     , 3            as return_value
                  from dual
                 where v('APP_USER') in ('RAFAELK','BETHANIASOUTO','NATHALIAKINAST','MAICONAIMI','GUILHERME','DIEGOPIECHO','CESARH','ADRIELMULLER')
                
                union
                
                select 'Regional 4' as display_value
                     , 4            as return_value
                  from dual
                 where v('APP_USER') in ('RAFAELK','TIESSAMASOTTI','NATHALIAKINAST','MAICONAIMI','GUILHERME','DIEGOPIECHO','CESARH','ADRIELMULLER')
                ```
            nullDisplayValue: Selecione...
            nullReturnValue: 999999
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        validation {
            valueRequired: true
        }
        sessionState {
            storage: user
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--stretch
                t-Button--gapTop
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

