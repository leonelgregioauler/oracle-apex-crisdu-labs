page 249 (
    name: Compras por Fornecedor
    title: Compras por Fornecedor
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_abre(pid)
            {
             window.open('f?p=&APP_ID.:27:&SESSION.::NO::P27_IDNOTAFISCAL:'+pid,'_blank'); 
            }
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region compras-por-fornecedor (
        name: Compras por Fornecedor
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select decode( nf.tiponota, 'T', 'Transferência'
                                          , 'C', 'Compra' ) "Tipo NF"
                     , decode( nf.tiponota, 'T', pck_romance.fnc_nomefilial(pidfilial => nf.idfilialemitente  )
                                          , 'C', pck_romance.fnc_nomefornecedor(pidforn =>  nf.idfornemitente  ) ) Emitente
                     , listagg('<a href="javascript: fnc_abre('||nf.idnotafiscal||')">'|| nf.documento||' </a>' ) within group (order by 1) documento
                     , sum(nf.valortotal)
                from notasfiscais nf
                where tiponota in ( 'C','T')
                  and nf.idfilialdestino = :P249_IDFILIAL
                  and nf.idsemananota      = :P249_SEMANA
                    and exists ( select 1
                                     from itemnf i
                                        , produtos pp
                                     where i.idnotafiscal = nf.idnotafiscal
                                       and i.idproduto    = pp.idproduto
                                       and pp.venda       = 'S' ) 
                group by tiponota
                       , idfilialemitente
                       , idfornemitente
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: setPaginationSelectList
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhuma compra efetuada.
        }
        componentAdvanced {
            stripHtml: true
        }

        column DOCUMENTO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Documento
            }
            layout {
                sequence: 4
            }
            security {
                escapeSpecialChars: false
            }
        )

        column EMITENTE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Emitente
                alignment: center
            }
            layout {
                sequence: 2
            }
        )

        column "SUM(NF.VALORTOTAL)" (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Total
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            advanced {
                computeSum: true
            }
        )

        column "Tipo NF" (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Tipo Nf
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

    )

    pageItem P249_IDFILIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @compras-por-fornecedor
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P249_SEMANA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @compras-por-fornecedor
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

