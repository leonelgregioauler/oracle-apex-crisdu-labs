page 471 (
    name: Apoio a Resultados das Unidades Detalhado
    title: Apoio a Resultados das Unidades Detalhado
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region detalhe-dos-resultados-divergentes (
        name: Detalhe dos Resultados Divergentes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.id
                     , d.movimento
                     , d.data
                     , d.valor
                     , 'Despesa '||d.observacao observacao
                from despesascentroscustos d
                where d.idunidadedenegocio = :P471_IDUNIDADE
                  and exists ( select 1
                               from resultado_unidades_congelado r
                               where r.idunidadedenegocio = d.idunidadedenegocio
                                 and r.ano                = d.ano
                                 and r.problema           = 'S'
                                 and nvl(r.diferenca_despesas,0) != 0 )
                  and ( not exists ( select 1
                                     from vw_despesascentroscustos_m w
                                     where w.id = d.id 
                                       and w.idunidadedenegocio = d.idunidadedenegocio
                                       and w.ano = d.ano )
                     or exists ( select 1
                                 from vw_despesascentroscustos_m w
                                 where w.id = d.id 
                                   and w.idunidadedenegocio = d.idunidadedenegocio
                                   and w.ano = d.ano
                                   and w.valor != d.valor ) )
                union
                select rc.id
                     , rc.tipomovimentacao
                     , rc.data
                     , rc.valor
                     , 'Receita' 
                from receitascentroscustos rc
                where rc.idunidadedenegocio = :P471_IDUNIDADE
                  and exists ( select 1
                               from resultado_unidades_congelado r
                               where r.idunidadedenegocio = rc.idunidadedenegocio
                                 and r.ano                = rc.ano
                                 and r.problema           = 'S'
                                 and nvl(r.diferenca_receitas,0) != 0 )
                  and ( not exists ( select 1
                                     from vw_receitascentroscustos_m rw
                                     where rw.id = rc.id 
                                       and rw.idunidadedenegocio = rc.idunidadedenegocio
                                       and rw.ano = rc.ano )
                     or exists ( select 1
                                 from vw_receitascentroscustos_m rw
                                 where rw.id = rc.id 
                                   and rw.idunidadedenegocio = rc.idunidadedenegocio
                                   and rw.ano = rc.ano
                                   and rw.valor != rc.valor ) )
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado de diferença localizado!
        }
        advanced {
            savedReportMappingIdentifier: 1804022813034407449
        }

        column DATA (
            type: plainText
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column ID (
            type: plainText
            heading {
                heading: Id
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column MOVIMENTO (
            type: plainText
            heading {
                heading: Movimento
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column OBSERVACAO (
            type: plainText
            heading {
                heading: Observacao
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column VALOR (
            type: plainText
            heading {
                heading: Valor
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 29443035 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATA (
                sequence: 3
            )

            displayColumn ID (
                sequence: 1
            )

            displayColumn MOVIMENTO (
                sequence: 2
            )

            displayColumn OBSERVACAO (
                sequence: 5
            )

            displayColumn VALOR (
                sequence: 4
            )

        )

    )

    pageItem P471_IDUNIDADE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @detalhe-dos-resultados-divergentes
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

