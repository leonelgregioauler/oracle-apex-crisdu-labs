page 42 (
    name: Depósitos por Conta
    title: Depósitos por Conta
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region depósitos-por-conta (
        name: Depósitos por Conta
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(pf.apelido,pf.nomepessoa)) "Fornecedor"
                     , initcap(b.nomebanco) "Banco"
                     , cbf.agencia||'/'||cbf.conta "Conta Bancária"
                     , initcap(cbf.beneficiario) "Beneficiário"
                     , sum(dd.valordeposito)       "Valor Depósito"
                from contasbancarias cbf
                   , bancos          b
                   , fornecedores    f
                   , pessoas         pf
                   , depositosdiarios dd 
                where cbf.idfornecedor = f.idfornecedor(+)
                  and cbf.idbanco      = b.idbanco(+)
                  and f.idpessoa       = pf.idpessoa(+)
                  and dd.idcontabanc   = cbf.idcontabanc
                  and dd.idrepresentante != 0
                	and (:P42_DATAINI is null or  trunc(dd.data) between to_date(:P42_DATAINI,'DD/MM/RRRR') and to_date(:P42_DATAFIM,'DD/MM/RRRR') )
                group by pf.apelido
                       , pf.nomepessoa
                       , b.nomebanco
                       , cbf.agencia
                       , cbf.conta
                       , cbf.beneficiario
                union
                select initcap(nvl(pf1.apelido,pf1.nomepessoa)) "Fornecedor"
                     , initcap(b1.nomebanco) "Banco"
                     , cbf1.agencia||'/'||cbf1.conta
                     , initcap(cbf1.beneficiario)
                     , sum(dd1.valordeposito)       
                from contasbancariasfiliais cbf1
                   , bancos          b1
                   , filiais         f1
                   , pessoas         pf1
                   , depositosdiarios dd1
                where cbf1.idfilial = f1.idfilial(+)
                  and cbf1.idbanco      = b1.idbanco(+)
                  and f1.idpessoa       = pf1.idpessoa(+)
                  and dd1.idcontabanc   = cbf1.idcontabanc
                  and dd1.idrepresentante != 0
                	and (:P42_DATAINI is null or  trunc(dd1.data) between to_date(:P42_DATAINI,'DD/MM/RRRR') and to_date(:P42_DATAFIM,'DD/MM/RRRR') )
                group by pf1.apelido
                       , pf1.nomepessoa
                       , b1.nomebanco
                       , cbf1.agencia
                       , cbf1.conta
                       , cbf1.beneficiario
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

        column Banco (
            type: plainText
            heading {
                heading: Banco
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Banco
                endUserAlias: B
            }
            enableUsersTo {
                pivot: false
            }
        )

        column Beneficiário (
            type: plainText
            heading {
                heading: Beneficiário
                alignment: center
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Beneficiário
                endUserAlias: D
            }
            enableUsersTo {
                pivot: false
            }
        )

        column "Conta Bancária" (
            type: plainText
            heading {
                heading: Conta Bancária
                alignment: center
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Conta_Bancaria
                endUserAlias: C
            }
            enableUsersTo {
                pivot: false
            }
        )

        column Fornecedor (
            type: plainText
            heading {
                heading: Fornecedor
                alignment: center
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: Fornecedor
                endUserAlias: A
            }
            enableUsersTo {
                pivot: false
            }
        )

        column "Valor Depósito" (
            type: plainText
            heading {
                heading: Valor Depósito
                alignment: end
            }
            layout {
                sequence: 5
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990d00
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: Valor_Deposito
                endUserAlias: E
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 13757 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100
            }

            displayColumn "Banco" (
                sequence: 2
            )

            displayColumn "Beneficiário" (
                sequence: 4
            )

            displayColumn "Conta Bancária" (
                sequence: 3
            )

            displayColumn "Fornecedor" (
                sequence: 1
            )

            displayColumn "Valor Depósito" (
                sequence: 5
            )

            sort (
                column: "Fornecedor"
                sort {
                    sequence: 1
                }
            )

            sort (
                column: "Banco"
                sort {
                    sequence: 2
                }
            )

            sort (
                column: "Beneficiário"
                sort {
                    sequence: 3
                }
            )

            aggregate (
                column: "Valor Depósito"
            )

        )

    )

    pageItem P42_DATAFIM (
        type: datePickerJquery
        label {
            label: até
            alignment: left
        }
        layout {
            sequence: 20
            region: @depósitos-por-conta
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P42_DATAINI (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 10
            region: @depósitos-por-conta
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: Filtrar
        label: Filtrar
        layout {
            sequence: 30
            region: @depósitos-por-conta
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 42
                items: {
                    P42_DATAINI: &P42_DATAINI.
                    P42_DATAFIM: &P42_DATAFIM.
                }
                action: resetPagination
            }
        }
    )

)

