    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region orçamentos (
        name: Orçamentos
        type: list
        source {
            list: @orçamentos
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            listTemplate: @/cards
