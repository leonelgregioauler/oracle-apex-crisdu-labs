page 332 (
    name: Importação de Arquivo
    title: Importação de Arquivo
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }

    region importação-de-arquivo (
        name: Importação de Arquivo
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P332_ARQUIVO (
        type: fileUpload
        label {
            label: Arquivo
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
        }
        layout {
            sequence: 30
            region: @importação-de-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: ARQUIVO
            used: always
        }
    )

    pageItem P332_IDCONTA (
        type: selectList
        label {
            label: Selecione a Conta
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select b.nomebanco||' - Ag: '||cb.agencia||' Cc: '||cb.conta||' - Beneficiario: '||initcap(p.apelido) display_value
                     , cb.idcontabanc return_value
                from bancos b
                   , contasbancarias cb
                   , pessoas p
                where cb.idbanco = b.idbanco
                  and p.idpessoa = cb.idpessoa
                  and cb.idcontabanc in (3822, 2399)
                ```
        }
        layout {
            sequence: 20
            region: @importação-de-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDCONTABANCARIA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P332_ROWID (
        type: hidden
        layout {
            sequence: 10
            region: @importação-de-arquivo
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ROWID
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 40
            region: @importação-de-arquivo
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 331
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button importar (
        buttonName: IMPORTAR
        label: Importar Arquivo
        layout {
            sequence: 30
            region: @importação-de-arquivo
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from importacoesbb
                ```
        }
    )

    button processar (
        buttonName: PROCESSAR
        label: Processar
        layout {
            sequence: 10
            region: @importação-de-arquivo
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from importacoesbb
                ```
        }
    )

    button reiniciar (
        buttonName: REINICIAR
        label: Reiniciar
        layout {
            sequence: 20
            region: @importação-de-arquivo
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from importacoesbb
                ```
        }
    )

    validation valida-arquivo (
        name: Valida Arquivo
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P332_ARQUIVO
        }
        error {
            errorMessage: Por favor, adicione um arquivo!
        }
        serverSideCondition {
            type: request=Value
            value: IMPORTAR
        }
    )

    process fetch-row-from-importacoesbb (
        name: Fetch Row from IMPORTACOESBB
        type: autoRowFetch
        source {
            tableName: IMPORTACOESBB
            pkColumn: 0
            pkItem: P332_ROWID
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 11837167992235026
        }
    )

    process process-row-of-importacoesbb (
        name: Process Row of IMPORTACOESBB
        type: autoRowProcessing
        target {
            tableName: IMPORTACOESBB
            pkColumn: ROWID
            pkItem: P332_ROWID
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada com sucesso.
        }
        advanced {
            executionMappingIdentifier: 11837529268235026
        }
    )

    process processa-arquivo (
        name: Processa Arquivo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidusuario number;
                  vidconta   number := :P332_IDCONTA;
                begin
                  --
                  select idusuario
                  into vidusuario
                  from usuarios u
                  where u.usuario = v('APP_USER');
                  --
                  pck_integracao_rmc.prc_importa_arquivo_extrato( pidconta => vidconta,
                                                                  pidusuario => vidusuario);
                  --
                  pck_integracao_rmc.prc_processaarquivo(pidconta => vidconta,
                                                         pidusuario => vidusuario);
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Arquivo processado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 11836766804235026
        }
        serverSideCondition {
            type: request=Value
            value: PROCESSAR
        }
    )

    process reinicia-processo (
        name: Reinicia Processo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_integracao_rmc.prc_reiniciaprocesso;
                end;
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 11836352773235026
        }
        serverSideCondition {
            type: request=Value
            value: REINICIAR
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 332
                items: {
                    P332_IDCONTA: &P332_IDCONTA.
                    P332_ARQUIVO: &P332_ARQUIVO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: IMPORTAR
        }
    )

)

