page 403 (
    name: Cadastro de Acessos
    title: Cadastro de Acessos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-de-acessos (
        name: Cadastro de Acessos
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P403_EMAIL (
        type: textField
        label {
            label: Email
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 50
            region: @cadastro-de-acessos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P403_IDCADASTROCOMPRA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @cadastro-de-acessos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P403_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.ativo = 'S'
                ```
        }
        layout {
            sequence: 30
            region: @cadastro-de-acessos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P403_IDFORNECEDOR (
        type: popupLov
        label {
            label: Fornecedor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefornecedor(f.idfornecedor) display_value
                     , f.idfornecedor return_value
                from fornecedores f
                where f.ativo = 'S'
                order by 1
                ```
            nullDisplayValue: - Selecione o Fornecedor -
        }
        layout {
            sequence: 20
            region: @cadastro-de-acessos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P403_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @cadastro-de-acessos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P403_NOMESITE (
        type: textField
        label {
            label: Nome do Site
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @cadastro-de-acessos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P403_SENHA (
        type: textField
        label {
            label: Senha
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 60
            region: @cadastro-de-acessos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 20
        }
        security {
            encryptSessionState: false
        }
    )

    button criar (
        buttonName: CRIAR
        label: Criar
        layout {
            sequence: 40
            region: @cadastro-de-acessos
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P403_IDCADASTROCOMPRA
        }
    )

    button deletar (
        buttonName: DELETAR
        label: Deletar
        layout {
            sequence: 10
            region: @cadastro-de-acessos
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P403_IDCADASTROCOMPRA
        }
    )

    button salvar (
        buttonName: SALVAR
        label: Salvar
        layout {
            sequence: 20
            region: @cadastro-de-acessos
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P403_IDCADASTROCOMPRA
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 30
            region: @cadastro-de-acessos
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 402
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process consulta-dml-em-cadastros-compras (
        name: Consulta DML em Cadastros Compras
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  PCK_CADASTROS_RMC.PRC_CADASTROSCOMPRAS( PIDCADASTROCOMPRA => :P403_IDCADASTROCOMPRA,
                                                          PIDFORNECEDOR => :P403_IDFORNECEDOR,
                                                          PIDFILIAL => :P403_IDFILIAL,
                                                          PNOMESITE => :P403_NOMESITE,
                                                          PEMAIL => :P403_EMAIL,
                                                          PSENHA => :P403_SENHA,
                                                          PMD5 => :P403_MD5,
                                                          POPERACAO_DML => 'S' );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 5356973486313876818
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P403_IDCADASTROCOMPRA
        }
    )

    process processo-dml-em-cadastros-compras (
        name: Processo DML em Cadastros Compras
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  voperacao_dml varchar2(1);
                  --
                begin
                  --
                  if v('REQUEST') = 'CRIAR' then
                    --
                    voperacao_dml := 'I';
                    --
                  elsif v('REQUEST') = 'SALVAR' then
                    --
                    voperacao_dml := 'S';
                    --
                  elsif v('REQUEST') = 'DELETAR' then
                    --
                    voperacao_dml := 'D';
                    --
                  end if;
                  --
                  PCK_CADASTROS_RMC.PRC_CADASTROSCOMPRAS( PIDCADASTROCOMPRA => :P403_IDCADASTROCOMPRA,
                                                          PIDFORNECEDOR => :P403_IDFORNECEDOR,
                                                          PIDFILIAL => :P403_IDFILIAL,
                                                          PNOMESITE => :P403_NOMESITE,
                                                          PEMAIL => :P403_EMAIL,
                                                          PSENHA => :P403_SENHA,
                                                          PMD5 => :P403_MD5,
                                                          POPERACAO_DML => voperacao_dml );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo realizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 5357135681150993850
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('CRIAR','SALVAR','DELETAR')
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 403
                items: {
                    P403_IDCADASTROCOMPRA:
                    P403_IDFORNECEDOR:
                    P403_IDFILIAL:
                    P403_NOMESITE:
                    P403_EMAIL:
                    P403_SENHA:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @deletar
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 403
                items: {
                    P403_IDCADASTROCOMPRA: &P403_IDCADASTROCOMPRA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request!=Value
            value: DELETAR
        }
    )

)

