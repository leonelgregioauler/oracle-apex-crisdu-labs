page 278 (
    name: Cadastro e Acessos
    title: Cadastro e Acessos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region cadastros-e-acessos (
        name: Cadastros e Acessos
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    region usuários-que-pode-acessar (
        name: Usuários que pode acessar
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDACESSOTIPOSFILIAIS",
                "IDACESSOTIPOSFILIAIS" IDACESSOTIPOSFILIAIS_DISPLAY,
                "IDTIPOFILIAL",
                "USUARIO"
                from "#OWNER#"."ACESSOSTIPOSFILIAIS"
                where idtipofilial = :P278_IDTIPOFILIAL
                
                ```
        }
        layout {
            sequence: 20
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P278_IDTIPOFILIAL
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 1
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column IDACESSOTIPOSFILIAIS (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_ACESSOSTPFIL
            }
        )

        column IDACESSOTIPOSFILIAIS_DISPLAY (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

        column IDTIPOFILIAL (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 4
            }
            default {
                type: item
                item: P278_IDTIPOFILIAL
            }
        )

        column USUARIO (
            reportColumnQueryId: 5
            derivedColumn: N
            type: selectList
            heading {
                heading: Usuario
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(usuario) display_value
                         , usuario return_value
                    from usuariossistemas u
                    where u.idsistema = 2600
                    ```
                displayNullValue: false
            }
            layout {
                sequence: 5
            }
        )

    )

    pageItem P278_DESCRICAO (
        type: textField
        label {
            label: Descrição
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @cadastros-e-acessos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 100
        }
        source {
            type: databaseColumn
            databaseColumn: DESCRICAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P278_IDTIPOFILIAL (
        type: textField
        label {
            label: ID
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 10
            region: @cadastros-e-acessos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 5
        }
        source {
            type: databaseColumn
            databaseColumn: IDTIPOFILIAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button add (
        buttonName: ADD
        label: Adicionar Usuário
        layout {
            sequence: 40
            region: @usuários-que-pode-acessar
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.widget.tabular.addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @usuários-que-pode-acessar
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 277
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 40
            region: @cadastros-e-acessos
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P278_IDTIPOFILIAL
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @cadastros-e-acessos
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P278_IDTIPOFILIAL
        }
    )

    button multi-row-delete (
        buttonName: MULTI_ROW_DELETE
        label: Retirar acesso
        layout {
            sequence: 20
            region: @usuários-que-pode-acessar
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'MULTI_ROW_DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @cadastros-e-acessos
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P278_IDTIPOFILIAL
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Salvar
        layout {
            sequence: 30
            region: @usuários-que-pode-acessar
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation idtipofilial-not-null (
        name: IDTIPOFILIAL not null
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @usuários-que-pode-acessar
            type: columnIsNotNull
            column: IDTIPOFILIAL
        }
        error {
            errorMessage: #COLUMN_HEADER# must have a value.
            associatedColumn: IDTIPOFILIAL
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation usuario-not-null (
        name: USUARIO not null
        execution {
            sequence: 40
        }
        validation {
            editableRegion: @usuários-que-pode-acessar
            type: columnIsNotNull
            column: USUARIO
        }
        error {
            errorMessage: #COLUMN_HEADER# must have a value.
            associatedColumn: USUARIO
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @usuários-que-pode-acessar
        target {
            tableName: ACESSOSTIPOSFILIAIS
            pkColumn: IDACESSOTIPOSFILIAIS
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: #MRD_COUNT# row(s) deleted.
        }
        advanced {
            executionMappingIdentifier: 590482723360574452
        }
        serverSideCondition {
            type: request=Value
            value: MULTI_ROW_DELETE
            executeCondition: once
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @usuários-que-pode-acessar
        target {
            tableName: ACESSOSTIPOSFILIAIS
            pkColumn: IDACESSOTIPOSFILIAIS
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# row(s) updated, #MRI_COUNT# row(s) inserted.
        }
        advanced {
            executionMappingIdentifier: 590482503057574450
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process fetch-row-from-tiposfiliais (
        name: Fetch Row from TIPOSFILIAIS
        type: autoRowFetch
        source {
            tableName: TIPOSFILIAIS
            pkColumn: IDTIPOFILIAL
            pkItem: P278_IDTIPOFILIAL
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 590458415582499767
        }
    )

    process process-row-of-tiposfiliais (
        name: Process Row of TIPOSFILIAIS
        type: autoRowProcessing
        target {
            tableName: TIPOSFILIAIS
            pkColumn: IDTIPOFILIAL
            pkItem: P278_IDTIPOFILIAL
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 590458629178499769
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 590458808539499770
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 277
            }
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 278
            }
        }
    )

)

