    region sim-adm (
        name: Sim ADM
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(1075) filial
                     , '-'MESANO
                     , 2018 ano
                     --
                     , (nvl(( select sum(nvl(e.valortotal,0))
                             from entradasdiversas e
                             where to_number(to_char(e.data,'RRRR')) <= 2018
                               and e.idfilial = 1075),0)
                       + nvl( ( select sum(dd.valordeposito)
                              from depositosdiarios dd
                              where to_number(to_char(dd.data,'RRRR')) <= 2018
                                and dd.valordeposito > 0
                                and dd.idpgtoforn in ( select idpgtoforn 
                                                       from pagamentosfornecedores pgf
                                                       where pgf.idnotafiscal in ( select idnotafiscal
                                                                                   from notasfiscais nn
                                                                                   where nn.idfilialdestino = 1075 ) )) ,0) 
                        + nvl(( select  sum(v.valor) 
                            from vencimentosreceber v
                               ,  notasfiscais nn
                            where v.idnotafiscal = nn.idnotafiscal
                              and to_number(to_char(datavencimento,'RRRR')) <= 2018
                              and (nn.idfilialdestino =  1075
                                or nn.idfornecedordestino = pck_romance.fnc_fornecedorfilial(1075 )  ) ),0) )
                         + 19255054.72-- por causa da limpeza até 29/2016
                          "Dinheiro recebido"
                     ---------------------------------
                     , nvl(( select sum(nvl(s.valortotal,0))
                             from saidasdiversas s
                             where to_number(to_char(s.data,'RRRR')) <= 2018
                               and s.idfilial = 1075)
                               + 5093619.76-- por causa da limpeza até 29/2016
                               ,0) "Saídas Diversas"
                     ---------------------------------
                     , nvl(( select sum(f.valornobanco)
                         from fechamentossemanais f
                         where f.idfilial = 1075
                           and to_number(substr(trim(f.mesvalornobanco),4,4)) <= 2018) ,0)
                           + 2740240.97 -- por causa da limpeza até 29/2016
                           "Entradas Banco"
                     ---------------------------------
                     , nvl(( select sum(nvl(p.valorpagar,0)) valorpagar
                             from pagamentosfornecedores p
                             where to_number(to_char(p.dtvencimento,'RRRR')) <= 2018
                               and p.idfornecedor = pck_romance.fnc_fornecedorfilial( 1075)  ),0) 
                     "Venda Para Romance"
                     ---------------------------------
                      ,nvl(( select sum(nvl(s.valortotal,0))
                             from saidasdiversas s
                             where to_number(to_char(s.data,'RRRR')) <= 2018
                               and s.idfilial = 1075),0) + 5093619.76-- por causa da limpeza até 29/2016 
                     -----------------------------------saidas
                     + nvl(( select sum(f.valornobanco)
                         from fechamentossemanais f
                         where f.idfilial = 1075
                           and to_number(substr(trim(f.mesvalornobanco),4,4)) <= 2018)  ,0)
                            + 2740240.97 -- por causa da limpeza até 29/2016            
                     -----------------------------------valorbanco 
                      +nvl(( select sum(nvl(p.valorpagar,0)) valorpagar
                             from pagamentosfornecedores p
                             where to_number(to_char(p.dtvencimento,'RRRR')) <= 2018
                               and p.idfornecedor = pck_romance.fnc_fornecedorfilial( 1075)  ),0) 
                      - (nvl(( select sum(nvl(e.valortotal,0))
                             from entradasdiversas e
                             where to_number(to_char(e.data,'RRRR')) <= 2018
                               and e.idfilial = 1075),0)
                       + nvl( ( select sum(dd.valordeposito)
                                from depositosdiarios dd
                                where to_number(to_char(dd.data,'RRRR')) <= 2018
                                  and dd.valordeposito > 0
                                  and dd.idpgtoforn in ( select idpgtoforn 
                                                         from pagamentosfornecedores pgf
                                                         where pgf.idnotafiscal in ( select idnotafiscal
                                                                                     from notasfiscais nn
                                                                                     where nn.idfilialdestino = 1075 ) ))  ,0)
                       + nvl(( select  sum(v.valor) 
                            from vencimentosreceber v
                               ,  notasfiscais nn
                            where to_number(to_char(datavencimento,'RRRR')) <= 2018
                              and v.idnotafiscal = nn.idnotafiscal
                              and (nn.idfilialdestino =  1075
                                or nn.idfornecedordestino = pck_romance.fnc_fornecedorfilial(1075 )  ) ),0) )  
                         - 19255054.72-- por causa da limpeza até 29/2016
                      ----------------------------------- dinheirorecebido 
                                                                                   Resultado
                     , '+' mais1
                     , '+' mais2
                     , '+' mais3
                     , '-' menos
                     , '=' igual
                from dual
                ```
        }
