    region sim-adm-2 (
        name: Sim ADM
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select filial
                     , mes
                     , numero
                     , mesano
                     , ano
                     , dinheirorecebido "Dinheiro recebido"
                     , saidasdiversas   "Saídas Diversas"
                     , entradasbanco    "Entradas Banco"
                     , vendapararomance "Venda Para Romance"
                     , saidasdiversas + entradasbanco + vendapararomance - dinheirorecebido resultado       
                     , vendadeterceiros
                     , '+' mais1
                     , '+' mais2
                     , '+' mais3
                     , '|' separa
                     , '-' menos
                     , '=' igual
                from ( 
                        select pck_romance.fnc_nomefilial(1075) filial
                             , m.mes
                             , m.numero
                             , m.numero||:P295_ANO MESANO
                             , to_number(:P295_ANO) ano
                             , -- entradas diversas
                               ( nvl(( select sum(nvl(e.valortotal,0))
                                       from entradasdiversas e
                                       --where to_char( e.data,'MM/RRRR') = trim(m.numero||'/'||:P295_ANO)
                                       where extract ( month from e.data ) = m.numero
                                         and extract ( year from e.data )  = :P295_ANO
                                         and e.idfilial = 1075 ) ,0 )
                               -- depositos diarios       
                               + nvl( ( select  sum(v.valor) 
                                        from vencimentos  v
                                           ,  notasfiscais nn
                                        --where to_char( datavencimento,'MM/RRRR') =  trim(m.numero||'/'||:P295_ANO)
                                        where extract ( month from datavencimento ) = m.numero
                                          and extract ( year from datavencimento )  = :P295_ANO
                                          and v.idnotafiscal           = nn.idnotafiscal
                                          and nn.idfilialdestino       = 1075 ),0 ) 
                               -- vencimentos a receber
                               + nvl( ( select  sum(v.valor) 
                                        from vencimentosreceber v
                                           ,  notasfiscais nn
                                        --where to_char( datavencimento,'MM/RRRR') =  trim(m.numero||'/'||:P295_ANO)
                                        where extract ( month from datavencimento ) = m.numero
                                          and extract ( year from datavencimento )  = :P295_ANO
                                          and v.idnotafiscal           = nn.idnotafiscal
                                          and ( nn.idfilialdestino     =  1075
                                             or nn.idfornecedordestino = pck_romance.fnc_fornecedorfilial(1075 )  ) ),0 ) 
                                             ) dinheirorecebido
                             , -- saidas diversas
                               nvl(( select sum(nvl(s.valortotal,0))
                                     from saidasdiversas s
                                     --where to_char( s.data,'MM/RRRR') = trim(m.numero||'/'||:P295_ANO) 
                                     where extract(month from s.data ) = m.numero
                                       and extract(year  from s.data ) = :P295_ANO
                                       and s.idfilial                 = 1075),0  )                                          saidasdiversas
                             , -- entradas banco
                               nvl( ( select sum(f.valornobanco)
                                      from fechamentossemanais f
                                      where f.idfilial              = 1075
                                        and trim(f.mesvalornobanco) = trim(m.numero||'/'||:P295_ANO) ) , 0 )                 entradasbanco
                              -- venda para a romance
                            /*   nvl( ( select sum(nvl(p.valorpagar,0)) valorpagar
                                      from pagamentosfornecedores p
                                      where to_char(p.dtvencimento,'MM/RRRR') = trim(m.numero||'/'||:P295_ANO) -- = f.semana
                                        and p.idfornecedor                    = pck_romance.fnc_fornecedorfilial( 1075 )  ) , 0 )  */     
                         /*
                            antigo
                               ( select  sum(v.valor) 
                                        from vencimentos  v
                                           ,  notasfiscais nn
                                        where to_char( datavencimento,'MM/RRRR') =  trim(m.numero||'/'||:P295_ANO)
                                          and v.idnotafiscal           = nn.idnotafiscal
                                          and nn.idfornemitente       = pck_romance.fnc_fornecedorfilial( 1075 ) )   vendapararomance  */
                             --valor da venda só da indústria
                             ,  ( select sum( i.valortotal)
                                  from itemnf i              
                                     , notasfiscais nn
                                  where i.idnotafiscal   = nn.idnotafiscal
                                    --and to_char( nn.dtnf,'MM/RRRR') =  trim(m.numero||'/'||:P295_ANO) 
                                    and extract( month from nn.dtnf ) = m.numero
                                    and extract( year  from nn.dtnf ) = :P295_ANO
                                    and not exists ( select 1
                                                     from classificacoesprodutos c
                                                     where c.idproduto = i.idproduto
                                                       and c.idcaracteristicaproduto = 0 )
                                    and nn.idfornemitente       = pck_romance.fnc_fornecedorfilial( 1075 ) )   vendapararomance
                             --valor da revenda de terceirizados (EXEMPLO COTA)    
                             ,  ( select sum( i.valortotal)
                                  from itemnf i              
                                     , notasfiscais nn
                                  where i.idnotafiscal   = nn.idnotafiscal
                                    --and to_char( nn.dtnf,'MM/RRRR') =  trim(m.numero||'/'||:P295_ANO) 
                                    and extract( month from nn.dtnf ) = m.numero
                                    and extract( year  from nn.dtnf ) = :P295_ANO
                                    and exists ( select 1
                                                 from classificacoesprodutos c
                                                 where c.idproduto = i.idproduto
                                                   and c.idcaracteristicaproduto = 0 )
                                    and nn.idfornemitente       = pck_romance.fnc_fornecedorfilial( 1075 ) )   vendadeterceiros
                    
                    
                              --
                              --                                                  
                        from meses m )
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
