        headerAndFooter {
            headerText:
                ```html
                <b>Positivo:</b><br>
                01 - Venda para Romance = Mercadoria que a Sim Indústria vendeu para Romance Moda.<br>
                02 - Saídas Diversas = Valores que a Fábrica pagou para outras filiais.<br>
                03 - Entradas Banco = Dinheiro de venda da Fábrica que entrou direto na conta da Romance Moda<br>
                <br>
                <b>Negativo:</b><br>
                01 - Dinheiro Recebido = Valores em Entradas Diversas do Caixa + Valores depositados pela Romance Moda para pagar fornecedores da Fábrica<br><br><br>
                ```
        }
