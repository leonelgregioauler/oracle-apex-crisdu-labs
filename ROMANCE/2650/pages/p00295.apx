    pageItem P295_ANO (
        type: selectList
        label {
            label: Ano
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct ano display_value
                     , ano return_value
                from semana_dias
                where ano between 2014 and to_number(to_char(sysdate,'RRRR'))+1
                order by 1 desc
                ```
            nullDisplayValue: - Selecione o Ano -
        }
        layout {
            sequence: 20
            region: @sim-adm-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                return to_char(sysdate,'RRRR');
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

