        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_venda(pidforn, pmesano)
            {
              pjanela = window.open('f?p=&APP_ID.:290:&SESSION.::NO:290:P290_IDFORNECEDOR,P290_MESANO:'+pidforn+','+pmesano,'compra','toolbar=yes,location=no,status=no,menubar=no,scrollbars=no,resizable=no,width="80%",height="80%",screenX=50,screenY =100');void(0);
            pjanela.focus();
            }
            
            function fnc_abatimentos(pidforn, pmesano)
            {
              pjanela = window.open('f?p=&APP_ID.:291:&SESSION.::NO:291:P291_IDFORNECEDOR,P291_MESANO:'+pidforn+','+pmesano,'compra','toolbar=yes,location=no,status=no,menubar=no,scrollbars=no,resizable=no,width="80%",height="80%",screenX=50,screenY =100');void(0);
            pjanela.focus();
            }
            
            function fnc_saidas(pidfilial, pmesano)
            {
              pjanela = window.open('f?p=&APP_ID.:293:&SESSION.::NO:293:P293_IDFILIAL,P293_MESANO:'+pidfilial+','+pmesano,'compra','toolbar=yes,location=no,status=no,menubar=no,scrollbars=no,resizable=no,width="80%",height="80%",screenX=50,screenY =100');void(0);
            pjanela.focus();
            }
            
            
            function fnc_dinheiro(pidfilial, pmesano)
            {
              pjanela = window.open('f?p=&APP_ID.:294:&SESSION.::NO:294:P294_IDFILIAL,P294_MESANO:'+pidfilial+','+pmesano,'compra','toolbar=yes,location=no,status=no,menubar=no,scrollbars=no,resizable=no,width=1000,height="8%",screenX="80%",screenY =100');void(0);
            pjanela.focus();
