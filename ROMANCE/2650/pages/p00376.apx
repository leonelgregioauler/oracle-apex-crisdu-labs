page 376 (
    name: Quitação de Fornecedores
    title: Quitação de Fornecedores
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_imprime_termo()
            {
              vidfornecedor  = document.getElementById('P376_IDFORNECEDOR').value;
              vidrazaosocial = document.getElementById('P376_IDRAZAOSOCIAL').value;
              vidrazaosocialfilial = document.getElementById('P376_IDRAZAOSOCIAL_DESTINO').value;
              vdatainicio    = document.getElementById('P376_DATA_INICIO').value;
              vdatafim       = document.getElementById('P376_DATA_FIM').value;
               
              window.open( 'f?p=&APP_ID.:377:&SESSION.::NO::P377_IDFORNECEDOR,P377_IDRAZAOSOCIAL,P377_IDRAZAOSOCIALDESTINO,P377_DATAINICIO,P377_DATAFIM:'+vidfornecedor+','+vidrazaosocial+','+vidrazaosocialfilial+','+vdatainicio+','+vdatafim , 'IMPRIME COMPLETO', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=600,height=500,left=250,top=100','_blank'); void(0);
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region notas-fiscais-encontradas (
        name: Notas Fiscais Encontradas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select trunc(nf.dataemissao) dataemissao
                     , nf.numero
                     , nf.valortotalnota
                     , rz.razaosocial
                     --, regexp_replace(LPAD(rz.cnpj,14),'([0-9]{2})([0-9]{3})([0-9]{3})([0-9]{4})','\1.\2.\3/\4-')as cnpj
                     , REGEXP_REPLACE(rz.cnpj, '^([A-Z0-9]{2})([A-Z0-9]{3})([A-Z0-9]{3})([A-Z0-9]{4})([0-9]{2})$', '\1.\2.\3/\4-\5', 1, 1, 'i') as cnpj
                     --
                from crisdu.notasfiscais nf
                   , crisdu.razoessociais rz
                where rz.idrazaosocial         = nf.idrazaosocialdestinatario
                  and nf.idrazaosocialemitente = ( select rs.idrazaosocial
                                                   from crisdu.razoessociais rs
                                                      , razoessociaisfornec rf
                                                   where rf.idrazaosocialforn = :P376_IDRAZAOSOCIAL
                                                     and rs.cnpj              = rf.cnpj )
                  and nf.idrazaosocialdestinatario = ( select rrz.idrazaosocial
                                                       from crisdu.razoessociais rrz
                                                          , razoessociaisfiliais rff
                                                       where rff.idrazaosocialfilial = :P376_IDRAZAOSOCIAL_DESTINO
                                                         and rrz.cnpj                = rff.cnpj )                                             
                  and nf.dataemissao between to_date(:P376_DATA_INICIO||' 00:00:01', 'DD/MM/RRRR HH24:MI:SS') and to_date(:P376_DATA_FIM||' 23:59:59', 'DD/MM/RRRR HH24:MI:SS')
                order by 1
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P376_FILTRAR
            value: S
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 57328158077592213
        }

        column CNPJ (
            type: plainText
            heading {
                heading: Cnpj
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column DATAEMISSAO (
