    pageItem P376_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.idgrupo != 5
                ```
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P376_IDFORNECEDOR (
        type: selectList
        label {
            label: Fornecedor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefornecedor(idfornecedor) ||'  --  '||pck_romance.fnc_nomepessoa(idpessoa) ||'   ID:'||idfornecedor display_value
                     , fe.idfornecedor return_value
                from fornecedores fe
                where fe.ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P376_IDRAZAOSOCIAL (
        type: selectList
        label {
            label: Razão Social
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.razaosocial||' - CNPJ: '||r.cnpj a
                     , r.idrazaosocialforn b
                from razoessociaisfornec r
                where r.idfornecedor = :P376_IDFORNECEDOR
                  and exists ( select 1
                               from crisdu.razoessociais rz
                               where rz.cnpj = r.cnpj )
                ```
            nullDisplayValue: - Selecione a Razão Social do Fornecedor -
        }
        cascadingLov {
            parentItems: P376_IDFORNECEDOR
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P376_IDRAZAOSOCIAL_DESTINO (
        type: selectList
        label {
            label: Razão Social
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.razaosocial||' - CNPJ: '||r.cnpj display_value
                     , r.idrazaosocialfilial return_value
                from razoessociaisfiliais r
                where r.idfilial = :P376_IDFILIAL
                  and exists ( select 1
                               from crisdu.razoessociais rz
                               where rz.cnpj = r.cnpj )
                               
                ```
        }
        cascadingLov {
            parentItems: P376_IDFILIAL
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P376_MENSAGEM (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 10
            region: @pré-visualização-do-texto
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<font align="CENTER"><h2>'||UPPER(R.RAZAOSOCIAL)
                       ||', pessoa jurídica de direito privado, inscrita no CNPJ sob nº'||REGEXP_REPLACE(cnpj, '^([A-Z0-9]{2})([A-Z0-9]{3})([A-Z0-9]{3})([A-Z0-9]{4})([0-9]{2})$', '\1.\2.\3/\4-\5', 1, 1, 'i')
                       ||', com sede à '||initcap(r.endereco)||', nº '||r.numero||' - '||initcap(r.bairro)||' - '||pck_romance.fnc_nomecidade(r.idcidade)
                       ||', declaro para os devidos fins, nos termos da lei nº 12.007/2009, que as notas fiscais relacionadas abaixo referente à '
                       ||to_char(to_date(:P376_DATA_INICIO),'Month','nls_date_language =''brazilian portuguese''')||'/'||to_char(to_date(:P376_DATA_INICIO),'RRRR')||' a '
                       ||to_char(to_date(:P376_DATA_FIM),'Month','nls_date_language =''brazilian portuguese''')||'/'||to_char(to_date(:P376_DATA_FIM),'RRRR')||' encontram-se quitadas em sua totalidade na presente data.</h2></font>'  dados
                from razoessociaisfornec r
                where r.idrazaosocialforn = :P376_IDRAZAOSOCIAL
                ```
            used: always
        }
        serverSideCondition {
            type: item=value
            item: P376_FILTRAR
            value: S
        }
        security {
            encryptSessionState: false
        }
    )

    button buscar-notas (
        buttonName: BUSCAR_NOTAS
        label: Buscar Notas
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button imprimir-termo (
        buttonName: IMPRIMIR_TERMO
        label: Imprimir Termo
        layout {
            sequence: 10
            region: @notas-fiscais-encontradas
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: fnc_imprime_termo();
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 376
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 376
                items: {
                    P376_IDFORNECEDOR: &P376_IDFORNECEDOR.
                    P376_IDRAZAOSOCIAL: &P376_IDRAZAOSOCIAL.
                    P376_DATA_INICIO: &P376_DATA_INICIO.
                    P376_DATA_FIM: &P376_DATA_FIM.
                    P376_FILTRAR: S
                    P376_IDFILIAL: &P376_IDFILIAL.
                    P376_IDRAZAOSOCIAL_DESTINO: &P376_IDRAZAOSOCIAL_DESTINO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar-notas
        }
    )

)

