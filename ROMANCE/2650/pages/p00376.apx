            }
            advanced {
                endUserAlias: A
            }
        )

        column NUMERO (
            type: plainText
            heading {
                heading: Número Nota
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column RAZAOSOCIAL (
            type: plainText
            heading {
                heading: Empresa Destino
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column VALORTOTALNOTA (
            type: plainText
            heading {
                heading: Valor
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            appearance {
                formatMask: FML999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 573366 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CNPJ (
                sequence: 5
            )

            displayColumn DATAEMISSAO (
                sequence: 1
            )

            displayColumn NUMERO (
                sequence: 2
            )

            displayColumn RAZAOSOCIAL (
                sequence: 4
            )

            displayColumn VALORTOTALNOTA (
                sequence: 3
            )

        )

    )

