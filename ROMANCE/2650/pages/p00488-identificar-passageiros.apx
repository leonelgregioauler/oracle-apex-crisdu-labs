page 488 (
    name: Identificar Passageiros
    alias: IDENTIFICAR-PASSAGEIROS
    title: Identificar Passageiros
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 60%
        resizable: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 30
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region identificar-passageiros (
        name: Identificar Passageiros
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select APEX_ITEM.CHECKBOX2(1, p.idpessoaconvencao , NULL ) selecionar
                     , p.nomecompleto nome
                     , p.documento passaporte
                     , p.datavencimentodocumento vencimento_passaporte
                     , p.rg
                     , p.cpf
                     , p.datanascimento
                     , pck_romance.fnc_nomecidade(p.origem) origem
                from pessoasconvencao p
                where p.origem is not null
                  and p.origem = :P488_ORIGEM
                ```
            pageItemsToSubmit: P488_ORIGEM
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 92894977641758627
        }

        column CPF (
            type: plainText
            heading {
                heading: Cpf
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column DATANASCIMENTO (
            type: plainText
            heading {
                heading: Datanascimento
            }
            layout {
                sequence: 70
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: G
            }
        )

        column NOME (
            type: plainText
            heading {
                heading: Nome
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column ORIGEM (
            type: plainText
            heading {
                heading: Origem
            }
            layout {
                sequence: 80
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column PASSAPORTE (
            type: plainText
            heading {
                heading: Passaporte
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column RG (
            type: plainText
            heading {
                heading: Rg
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column SELECIONAR (
            type: plainText
            heading {
                heading: Selecionar
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column VENCIMENTO_PASSAPORTE (
            type: plainText
            heading {
                heading: Vencimento Passaporte
            }
            layout {
                sequence: 40
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 937072 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CPF (
                sequence: 6
            )

            displayColumn DATANASCIMENTO (
                sequence: 7
            )

            displayColumn NOME (
                sequence: 2
            )

            displayColumn ORIGEM (
                sequence: 8
            )

            displayColumn PASSAPORTE (
                sequence: 3
            )

            displayColumn RG (
                sequence: 5
            )

            displayColumn SELECIONAR (
                sequence: 1
            )

            displayColumn VENCIMENTO_PASSAPORTE (
                sequence: 4
            )

        )

    )

    pageItem P488_IDPASSAGEMCONVENCAO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @identificar-passageiros
            slot: regionBody
        }
    )

    pageItem P488_IDPASSAGEMCONVENCAO_1 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @identificar-passageiros
            slot: regionBody
        }
    )

    pageItem P488_ORIGEM (
        type: selectOne
        label {
            label: Origem Partida
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct pck_romance.fnc_nomecidade(p.origem) display_value
                     , p.origem return_value
                from pessoasconvencao p
                where p.origem is not null
                order by 1
                ```
        }
        layout {
            sequence: 40
            region: @identificar-passageiros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P488_PAGINA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @identificar-passageiros
            slot: regionBody
        }
    )

    button finalizar (
        buttonName: FINALIZAR
        label: Finalizar
        layout {
            sequence: 10
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    dynamicAction atualiza-grid (
        name: Atualiza Grid
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P488_ORIGEM
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @identificar-passageiros
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process insere-pessoas-na-passagem (
        name: Insere Pessoas na Passagem
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  vidpessoaconvencao number;
                begin
                  --
                  if APEX_APPLICATION.G_F01.COUNT > 0 then 
                    --
                    FOR I in 1..APEX_APPLICATION.G_F01.COUNT LOOP
                      --
                      vidpessoaconvencao := to_number(APEX_APPLICATION.G_F01(i));
                      --
                      insert into pessoaspassagensconvencao ( idpessoapassagemconvencao
                                                            , idpassagemconvencao
                                                            , idpessoaconvencao )
                      values ( seq_idpessoapassagemconvencao.nextval
                             , :P488_IDPASSAGEMCONVENCAO
                             , vidpessoaconvencao );            
                      --
                      if :P488_IDPASSAGEMCONVENCAO_1 is not null and :P488_PAGINA = 489 then
                        --
                        insert into pessoaspassagensconvencao ( idpessoapassagemconvencao
                                                              , idpassagemconvencao
                                                              , idpessoaconvencao )
                        values ( seq_idpessoapassagemconvencao.nextval
                               , :P488_IDPASSAGEMCONVENCAO_1
                               , vidpessoaconvencao );                                     
                        --
                      end if;
                      --
                      commit;
                      --
                    END LOOP;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Passagem Finalizada!
        }
        advanced {
            executionMappingIdentifier: 92895836085758636
        }
        serverSideCondition {
            whenButtonPressed: @finalizar
        }
    )

    branch (
        name: Go To Page 487
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 487
                items: {
                    P487_IDPASSAGEMCONVENCAO: &P488_IDPASSAGEMCONVENCAO.
                }
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression: v('REQUEST') = 'VOLTAR' and :P488_PAGINA = 487
        }
    )

    branch (
        name: Go To Page 327
        execution {
            sequence: 30
        }
        behavior {
            target: {
                page: 327
            }
        }
        serverSideCondition {
            whenButtonPressed: @finalizar
        }
    )

    branch (
        name: Go To Page 486
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 486
                items: {
                    P486_IDPASSAGEMCONVENCAO: &P488_IDPASSAGEMCONVENCAO.
                }
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'FINALIZAR' and :P488_PAGINA = 486
        }
    )

)

