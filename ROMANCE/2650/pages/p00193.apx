page 193 (
    name: Relatório de Lucratividade Geral
    title: Relatório de Lucratividade Geral
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region lucratividade-geral (
        name: Lucratividade Geral
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT IDSEMANACOBRANCA
                --     , filial
                     , decode( NRACERTOS,0,0,TOTALCOBRANCA/NRACERTOS)  "Ticket Médio"
                     , COBRANCA            "Cobrança"
                     , TOTALMERCADORIAS    "Total Mercadorias" 
                     , TOTALCOBRANCA       "Total Cobrança"
                     , NRACERTOS           "Nro de Acertos"
                     , TOTALDESPESAS       "Total de Despesas"
                     , COMISSOES           "Comissões"
                     , VLRLIQUIDO          "Valor Liquido"
                     , NOTASNOVAS          "Notas novas"
                     , TOTALVENDAFAVORITA  "Total Venda Favorita"
                     , PERCVENDAFAVORITA   "% Venda Favorita"
                     , DESPESASOUTROS
                     , LIQUIDOREAL
                     , percdespesa  "% Despesa"
                     ,  ( select decode(nvl(sum(fr.vlralvo),0), 0, 0, ((sum(fr.totalgeral)/(sum(fr.vlralvo)*2))*100) )
                                                                            from fechamentorepresentantes fr
                                                                               , fechamentossemanais ff
                                                                            where fr.idfechamento = ff.idfechamento
                                                                              and ff.idsemana  = idsemanacobranca) "% Venda"
                      --
                      -- emprestimo/retorno
                        , invsapucaia        "Emp/Ret Sapucaia"   
                        , invindustria       "Emp/Ret Taquara"
                        , invfavorita        "Emp/Ret Favorita"
                        , invtopbojo         "Emp/Ret Top Bojo"
                        , emprestconcedido   "Empréstimo Concedido"
                        --
                        ,emprestimos    "Empréstimos"
                        --
                        , definitivo DEFINITIVO  
                         
                     , definitivo     -   ( select sum(fs.totaldespesas* nvl(fs.fatorconversao,1)) 
                                            from fechamentossemanais fs
                                            where fs.idsemana = f.idsemanacobranca
                                              and pck_romance.fnc_tipofilial(fs.idfilial) != 'D' )
                /*       ( select sum( d.valor * nvl(( select fs.fatorconversao
                                                                     from fechamentossemanais fs
                                                                     where fs.idfechamento = d.idfechamentoorigem),f.fatorconversao) )
                                         from fechamentossemanais F
                                            , despesas d
                                         where d.idfechamento = f.idfechamento
                                           and not exists ( select 1 from IGNORARDESPESASLUCARTIVIDADE i where i.iddespesa = d.iddespesa)--tabela gambiarra para não levar em conta valores duplciados de pagamento de forncedores
                                           and exists ( select 1
                                                        from filiais fff
                                                        where fff.idfilial = f.idfilial
                                                          and fff.tipofilial not in ('C', 'D','F' ))
                                           and f.idsemana = f.idsemanacobranca )*/ saldofinal        
                     , case
                         when TOTALCOBRANCA > 0 then
                            ( select sum(fs.totaldespesas* nvl(fs.fatorconversao,1)) 
                                            from fechamentossemanais fs
                                            where fs.idsemana = f.idsemanacobranca
                                              and pck_romance.fnc_tipofilial(fs.idfilial) != 'D' )
                           /*( select sum( d.valor * nvl(( select fs.fatorconversao
                                                                     from fechamentossemanais fs
                                                                     where fs.idfechamento = d.idfechamentoorigem),f.fatorconversao) )
                                         from fechamentossemanais F
                                            , despesas d
                                         where d.idfechamento = f.idfechamento
                                           and not exists ( select 1 from IGNORARDESPESASLUCARTIVIDADE i where i.iddespesa = d.iddespesa)--tabela gambiarra para não levar em conta valores duplciados de pagamento de forncedores
                                           and exists ( select 1
                                                        from filiais fff
                                                        where fff.idfilial = f.idfilial
                                                          and fff.tipofilial not in ('C', 'D','F' ))
                                           and f.idsemana = f.idsemanacobranca )*/ *100 / TOTALCOBRANCA 
                         else
                           0
                       end percdebitosrmc 
                     , ANO
                     , SEMANA
                     , emprestconcedido  "Empréstimo Recebido"
                     , qtdempresas
                     , /*( select sum( d.valor * nvl(( select fs.fatorconversao
                                                                     from fechamentossemanais fs
                                                                     where fs.idfechamento = d.idfechamentoorigem),f.fatorconversao) )
                         from fechamentossemanais F
                            , despesas d
                         where d.idfechamento = f.idfechamento
                           and exists ( select 1
                                        from filiais fff
                                        where fff.idfilial = f.idfilial
                                          and fff.tipofilial not in ('C', 'D','F' )) 
                           and f.idsemana = f.idsemanacobranca )*/
                           ( select sum(fs.totaldespesas* nvl(fs.fatorconversao,1) )
                                            from fechamentossemanais fs
                                            where fs.idsemana = f.idsemanacobranca
                                              and pck_romance.fnc_tipofilial(fs.idfilial) != 'D' ) *-1 despesascaixas
                       , '|' s1
                       , depositos
                FROM vw_lucratividadegeral_mv F
                where IDSEMANACOBRANCA > 719
                and NRACERTOS > 0
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
