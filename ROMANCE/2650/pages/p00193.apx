            aggregate (
                column: "Pepinos Pagos"
            )

            aggregate (
                column: "Saldo"
            )

            aggregate (
                column: DESPESASOUTROS
            )

            aggregate (
                column: LIQUIDOREAL
            )

            aggregate (
                column: "Emp/Ret"
            )

            aggregate (
                column: DEFINITIVO
            )

            aggregate (
                column: "Empréstimos"
            )

            aggregate (
                column: SALDOFINAL
            )

            aggregate (
                column: DESPESASCAIXAS
            )

            highlight ir-condition (
                name: Def. Negativo
                condition {
                    column: DEFINITIVO
                    operator: <
                    value: 0
                }
                highlight {
                    type: cell
                }
                colors {
                    text: #E00303
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-2 (
                name: Def. Positivo
                condition {
                    column: DEFINITIVO
                    operator: >=
                    value: 0
                }
                highlight {
                    type: cell
                }
                colors {
                    text: #0B8F10
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-3 (
                name: Saldo Final Negativo
                condition {
                    column: SALDOFINAL
                    operator: <
                    value: 0
                }
                highlight {
                    type: cell
                }
                colors {
                    text: #E00303
                }
                execution {
                    sequence: 100
                }
            )

            highlight ir-condition-4 (
                name: Saldo FInal Positivo
                condition {
                    column: SALDOFINAL
                    operator: >
                    value: 0
                }
                highlight {
                    type: cell
                }
                colors {
                    text: #0B8F10
                }
                execution {
                    sequence: 10
                }
            )

        )

    )

    region new (
        name: New
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @lucratividade-geral
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P193_PERCDESPESASROMANCE (
        type: displayOnly
        label {
            label: % Desp. Romance
            alignment: left
        }
        layout {
            sequence: 10
            region: @new
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                SELECT round((sum(TOTALDESPESAS+COMISSOES)*-1) *100 / sum(TOTALCOBRANCA) ,2) percdebitosrmc
                FROM vw_lucratividadegeral_mv F
                where IDSEMANACOBRANCA > 719
                and NRACERTOS > 0
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P193_PERCDESPESASSETORES (
        type: displayOnly
        label {
            label: % Desp. Setores
            alignment: left
        }
        layout {
            sequence: 20
            region: @new
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                SELECT round(sum(  ( select sum( d.valor * nvl(( select fs.fatorconversao
                                                                     from fechamentossemanais fs
                                                                     where fs.idfechamento = d.idfechamentoorigem),f.fatorconversao) )
                                         from fechamentossemanais F
                                            , despesas d
                                         where d.idfechamento = f.idfechamento
                                           and not exists ( select 1 from IGNORARDESPESASLUCARTIVIDADE i where i.iddespesa = d.iddespesa)--tabela gambiarra para não levar em conta valores duplciados de pagamento de forncedores
                                           and exists ( select 1
                                                        from filiais fff
                                                        where fff.idfilial = f.idfilial
                                                          and fff.tipofilial not in ('C', 'D','F' ))
                                           and f.idsemana = f.idsemanacobranca )
                                   ) *100 / sum(TOTALCOBRANCA) ,2) percdebitosrmc
                FROM vw_lucratividadegeral_mv F
                where IDSEMANACOBRANCA > 719
                and NRACERTOS > 0
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P193_PROXIMAATUALIZACAO (
        type: displayOnly
        label {
            label: " "
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 10
            region: @lucratividade-geral
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<font color="green">Última Atualização: '||to_char(last_date,'hh24:mi:ss')  
                      ||' <br>Hora atual: '||to_char(sysdate,'hh24:mi:ss')
                      ||' <br>Próxima atualização será '||to_char(next_date,'hh24:mi:ss')||'</font>' proxima
                from all_jobs
                where what like '%VW_LUCRATIVIDADEGERAL_MV%'
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction tipo (
        name: Tipo
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P193_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P193_TIPO
            value: 1
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P193_SEMANAINI
                    P193_SEMANAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P193_SEMANAINI
                    P193_SEMANAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

)

