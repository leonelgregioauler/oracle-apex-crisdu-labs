page 240 (
    name: Empréstimos
    title: Empréstimos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region empréstimos (
        name: Empréstimos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select documento
                     , cliente
                     , dtnf
                     , valortotal
                     , valorreceber
                     , idparcelaemprestimo
                     , datavencimento
                     , valorparcela
                     , notaabatida 
                from vw_emprestimosrecebimentos
                order by datavencimento
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 193037022031170080
        }

        column CLIENTE (
            type: plainText
            heading {
                heading: Cliente
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: CLIENTE
                endUserAlias: B
            }
            enableUsersTo {
                pivot: false
            }
        )

        column DATAVENCIMENTO (
            type: plainText
            heading {
                heading: Vencimento
                alignment: center
            }
            layout {
                sequence: 7
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                htmlDomId: DATAVENCIMENTO
                endUserAlias: G
            }
            enableUsersTo {
                pivot: false
            }
        )

        column DOCUMENTO (
            type: plainText
            heading {
                heading: Documento
                alignment: center
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: DOCUMENTO
                endUserAlias: A
            }
            enableUsersTo {
                pivot: false
            }
        )

        column DTNF (
            type: plainText
            heading {
                heading: " "
                alignment: center
            }
            layout {
                sequence: 3
            }
            source {
                dataType: date
            }
            advanced {
                htmlDomId: DTNF
                endUserAlias: C
            }
            enableUsersTo {
                pivot: false
            }
        )

        column IDPARCELAEMPRESTIMO (
            type: plainText
            heading {
                heading: Idparcelaemprestimo
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: IDPARCELAEMPRESTIMO
                endUserAlias: F
            }
            enableUsersTo {
                pivot: false
            }
        )

        column NOTAABATIDA (
            type: plainText
            heading {
                heading: Nota Abatida
                alignment: center
            }
            layout {
                sequence: 9
            }
            source {
                dataType: varchar2
            }
            advanced {
                htmlDomId: NOTAABATIDA
                endUserAlias: I
            }
            enableUsersTo {
                pivot: false
            }
        )

        column VALORPARCELA (
            type: plainText
            heading {
                heading: Valor
                alignment: center
            }
            layout {
                sequence: 8
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: VALORPARCELA
                endUserAlias: H
            }
            enableUsersTo {
                pivot: false
            }
        )

        column VALORRECEBER (
            type: plainText
            heading {
                heading: Valor Receber
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: VALORRECEBER
                endUserAlias: E
            }
            enableUsersTo {
                pivot: false
            }
        )

        column VALORTOTAL (
            type: plainText
            heading {
                heading: " "
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                htmlDomId: VALORTOTAL
                endUserAlias: D
            }
            enableUsersTo {
                pivot: false
            }
        )

        savedReport 1930381 (
            visibility: alternativeDefault
            name: Vencidos não abatidos
            view {
                rowsPerPage: 100
            }

            displayColumn CLIENTE (
                sequence: 1
            )

            displayColumn DATAVENCIMENTO (
                sequence: 4
            )

            displayColumn DTNF (
                sequence: 2
            )

            displayColumn NOTAABATIDA (
                sequence: 6
            )

            displayColumn VALORPARCELA (
                sequence: 5
            )

            displayColumn VALORTOTAL (
                sequence: 3
            )

            sort (
                column: CLIENTE
                sort {
                    sequence: 1
                }
            )

            sort (
                column: DTNF
                sort {
                    sequence: 2
                }
            )

            sort (
                column: DATAVENCIMENTO
                sort {
                    sequence: 3
                }
            )

            aggregate (
                column: VALORPARCELA
            )

            aggregate (
                function: count
                column: DATAVENCIMENTO
            )

            filter ir-condition (
                type: rowExpression
                rowExpression: G < trunc(sysdate) and I is null
                identification {
                    name: vencidos
                }
            )

            controlBreak (
                column: DOCUMENTO
                layout {
                    sequence: 1
                }
            )

            controlBreak (
                column: CLIENTE
                layout {
                    sequence: 2
                }
            )

            controlBreak (
                column: DTNF
                layout {
                    sequence: 3
                }
            )

            controlBreak (
                column: VALORTOTAL
                layout {
                    sequence: 4
                }
            )

            controlBreak (
                column: VALORRECEBER
                layout {
                    sequence: 5
                }
            )

        )

        savedReport 1930384 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100
            }

            displayColumn CLIENTE (
                sequence: 1
            )

            displayColumn DATAVENCIMENTO (
                sequence: 4
            )

            displayColumn DTNF (
                sequence: 2
            )

            displayColumn NOTAABATIDA (
                sequence: 6
            )

            displayColumn VALORPARCELA (
                sequence: 5
            )

            displayColumn VALORTOTAL (
                sequence: 3
            )

            sort (
                column: CLIENTE
                sort {
                    sequence: 1
                }
            )

            sort (
                column: DTNF
                sort {
                    sequence: 2
                }
            )

            sort (
                column: DATAVENCIMENTO
                sort {
                    sequence: 3
                }
            )

            aggregate (
                column: VALORPARCELA
            )

            aggregate (
                function: count
                column: DATAVENCIMENTO
            )

            controlBreak (
                column: DOCUMENTO
                layout {
                    sequence: 1
                }
            )

            controlBreak (
                column: CLIENTE
                layout {
                    sequence: 2
                }
            )

            controlBreak (
                column: DTNF
                layout {
                    sequence: 3
                }
            )

            controlBreak (
                column: VALORTOTAL
                layout {
                    sequence: 4
                }
            )

            controlBreak (
                column: VALORRECEBER
                layout {
                    sequence: 5
                }
            )

        )

    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @empréstimos
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 235
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

