    pageItem P316_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(f.idfilial) display_value 
                     , f.idfilial return_value 
                from filiais f
                where f.tipofilial in ( select idtipofilial
                                        from acessostiposfiliais
                                        where usuario = v('APP_USER') ) 
                  and f.ativo       = 'S'
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 20
            region: @contas-para-depositar
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
