            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                 select 1
                  from depositosdiarios_orig d
                  where not exists( select 1 from depositosdiarios dd where dd.iddepositodiarios = d.iddepositodiarios )
                    and not exists( select 1 from extratoscontasbancarias ee where ee.iddepositodiario_orig = d.iddepositodiarios ) 
                    and extract(year from d.data) >= 2019
                ```
        }
    )

    region contas-para-depositar (
        name: Contas para Depositar
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                -- Created on 29/07/2022 by CESAR.HUNNING 
                declare 
                  -- Local variables here
                  p_where   varchar2(4000) ;
                  p_where_2 varchar2(4000) ;
                  
                begin
                  -- Test statements here
                  
                  if :P316_PRIORIDADE = 'S'  THEN
                
                     p_where := p_where || ' and exists ( select 1
                                                            from ordensdepositos o
                                                            where o.idcontabancaria = e.idcontabancaria
                                                              and o.identificado    = e.identificado 
                                                              and priorizado        = ''S''
                                                            having sum(o.valor - nvl( ( select sum(valordeposito)
                                                                                        from depositosdiarios_orig d
                                                                                        where d.idordemdeposito = o.idordemdeposito ),0)) > 0 )  ';
                  end if;
                
                  if :P316_IDFORNECEDOR IS NOT NULL  THEN
                     p_where := p_where || ' and exists ( select 1
                                                               from contasbancarias c
                                                               where c.idcontabanc = e.idcontabancaria 
                                                                 and c.idpessoa    =  ' || V('P316_IDFORNECEDOR') || ' ) ';
                     
                     
                  end if;
                
                  if :P316_IDFILIAL IS NOT NULL  THEN
                
                     p_where := p_where || ' and exists (  select 1 from notasfiscais nn, vencimentos  vv      
                                                            where nn.idnotafiscal = vv.idnotafiscal
                                                              and vv.idvencimento = e.idvencimento  
                                                              and nn.idfilialdestino = ' || V('P316_IDFILIAL') || 
                                                            ' and e.valormovimento < 0   )  ';
                  end if;
                
                  p_where := p_where || ' group by e.idcontabancaria, identificado, tipopagamento ';
                
                  p_where_2 := 'select ( select pck_romance.fnc_nomepessoa( c.idpessoa)  from contasbancarias c
                              where c.idcontabanc = e.idcontabancaria ) destino
                     , ( select c.idpessoa
                         from contasbancarias c
                         where c.idcontabanc = e.idcontabancaria ) idpessoaforn
                     , pck_cadastros_rmc.fnc_retornacontabancaria(e.idcontabancaria) conta
                     
                     , ( select max(ee.datamovimento)
                         from extratoscontasbancarias ee
                         where ee.idcontabancaria = e.idcontabancaria 
                           and ee.idvencimento    is not null
                           and ee.datamovimento <= to_date(' || '''' ||  V('P316_DATABASEDEPOSITOS') ||' 23:59:59'',''DD/MM/RRRR HH24:MI:SS'')' || --
                           ' and ee.identificado    = e.identificado) ultimovencimento' ||
                     ', ( select decode(p.tipochave, ''1'',''CPF/CNPJ'',''2'',''Chave Aleatória'',''3'',''Telefone'',''4'',''Email'') || '' - ''|| p.chave ' || --
                     '    from roman.chavespix p
                         where p.idcontabancaria = e.idcontabancaria ) Chave_pix
                     , sum(e.valormovimento) saldo                                        
                     , e.idcontabancaria               
                     , nvl( ( select sum(o.valor - nvl( ( select sum(valordeposito)
                                                          from depositosdiarios_orig d
                                                          where d.idordemdeposito = o.idordemdeposito ),0))
                                 from ordensdepositos o
                                 where o.idcontabancaria = e.idcontabancaria
                                   and o.identificado    = e.identificado ) ,0) saldodepositar
                     , decode(identificado, ''S'', ''Sim'', ''Não'') descidentificado
                     , identificado        
                     , nvl( (select min(o.data)
                             from ordensdepositos o
                             where o.idcontabancaria = e.idcontabancaria
                               and o.identificado    = e.identificado
                               and o.valor           > 0),null) datapagamento    
                     , case
                         when  nvl( ( select sum(o.valor - nvl( ( select sum(valordeposito)
                                                          from depositosdiarios_orig d
                                                          where d.idordemdeposito = o.idordemdeposito ),0))
                                       from ordensdepositos o
                                       where o.idcontabancaria = e.idcontabancaria
                                         and o.identificado    = e.identificado ) ,0) >  sum(e.valormovimento) *-1 then
                           ''AVISOORDEMMAIOR'' 
                         else
                           ''OK''
                           end AVISOORDEMMAIOR
                     , case
                         when  exists ( select 1
                                        from ordensdepositos o
                                        where o.idcontabancaria = e.idcontabancaria
                                          and o.identificado    = e.identificado 
                                          and priorizado        = ''S''
                                        having sum(o.valor - nvl( ( select sum(valordeposito)
                                                                    from depositosdiarios_orig d
                                                                    where d.idordemdeposito = o.idordemdeposito ),0)) > 0 ) then
                             ''Sim''
                          else
                             ''Não''
                           end prioridade                                      
                from extratoscontasbancarias e
                where e.contabilizar     = ''S''
                  and e.tipopagamento    = ''D'' 
                  and e.datamovimento <= to_date('|| '''' || V('P316_DATABASEDEPOSITOS') ||' 23:59:59'',''DD/MM/RRRR HH24:MI:SS'')' ;
                  
                 
                return p_where_2||' '||p_where;
                
                end;
                ```
            pageItemsToSubmit: [
                P316_IDFORNECEDOR
                P316_DATABASEDEPOSITOS
                P316_IDFILIAL
                P316_PRIORIDADE
            ]
