    process caixapostal (
        name: CAIXAPOSTAL
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidcontrole   number := :P316_IDCONTROLE;
                begin
                  --
                  select c.idcontrole 
                  into vidcontrole
                  from controleligacoes c
                  where c.idcontrole = vidcontrole;
                  --
                  update controleligacoes
                  set situacao = 'A'
                  where idcontrole = vidcontrole;
                  --
                  update controleligacoes c
