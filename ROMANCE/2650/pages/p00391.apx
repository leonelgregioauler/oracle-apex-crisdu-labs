page 391 (
    name: Cores
    title: Cores
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cores (
        name: Cores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select "IDCOR", 
                "DESCRICAO",
                "CODIGOHTML",
                "VALORCODBARRAS",
                DECODE(ATIVO,'S','Sim','N','Não') "ATIVO",
                "CODIGOVA",
                "VERSAO"
                from "#OWNER#"."CORES" 
                  
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 392
                items: {
                    P392_IDCOR: #IDCOR#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 4996281676353184618
        }

        column ATIVO (
            type: plainText
            heading {
                heading: Ativo
                alignment: center
            }
            layout {
                sequence: 23
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column CODIGOHTML (
            type: plainText
            heading {
                heading: Codigohtml
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column CODIGOVA (
            type: plainText
            heading {
                heading: Código VA
                alignment: center
            }
            layout {
                sequence: 33
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column DESCRICAO (
            type: plainText
            heading {
                heading: Descricao
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column IDCOR (
            type: plainText
            heading {
                heading: ID
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column VALORCODBARRAS (
            type: plainText
            heading {
                heading: Valor Cód. Barras
                alignment: center
            }
            layout {
                sequence: 13
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column VERSAO (
            type: plainText
            heading {
                heading: Versão
                alignment: center
            }
            layout {
                sequence: 43
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 49963210 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ATIVO (
                sequence: 5
            )

            displayColumn CODIGOHTML (
                sequence: 3
            )

            displayColumn CODIGOVA (
                sequence: 6
            )

            displayColumn DESCRICAO (
                sequence: 2
            )

            displayColumn IDCOR (
                sequence: 1
            )

            displayColumn VALORCODBARRAS (
                sequence: 4
            )

            displayColumn VERSAO (
                sequence: 7
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Nova Cor
        layout {
            sequence: 30
            region: @cores
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 392
                clearCache: 392
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction create-button-dialog-closed (
        name: Create Button - Dialog Closed
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @cores
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @cores
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @cores
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

