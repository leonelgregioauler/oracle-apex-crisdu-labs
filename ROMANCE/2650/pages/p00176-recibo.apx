    region recibo (
        name: recibo
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  vidsaida number := 1480;
                  --
                  cursor c1 is
                    select *
                    from saidasdiversas s
                    where s.idsaida = vidsaida;
                  --
                  r1   c1%rowtype;
                  --
                begin
                  --
                  open c1;
                  fetch c1 into r1;
                  close c1;
                  --
                  htp.p('<html>');
                  htp.p('  <table border="1">');
                  htp.p('    <tr>');
                  htp.p('      <td> Nrº 123456');
                  htp.p('      </td>');
                  htp.p('      <td> RECIBO');
                  htp.p('      </td>');
                  htp.p('      <td style="text-align: right;"> Valor: R$ 100,00 ');
                  htp.p('      </td>');
                  htp.p('    </tr>');
                  htp.p('    <tr>');
                  htp.p('      <td colspan="3"> Recebi de Crisdu Moda Intima');
                  htp.p('      </td>');
                  htp.p('    </tr>');
                  htp.p('    <tr>');
                  htp.p('      <td colspan="3"> A importância de cem reais');
                  htp.p('      </td>');
                  htp.p('    </tr>');
                  htp.p('    <tr>');
                  htp.p('      <td colspan="3"> Referente a teste do sistema');
                  htp.p('      </td>');
                  htp.p('    </tr>');
                  htp.p('    <tr>');
                  htp.p('      <td colspan="3"> ___________________, ______ de _______________________ de _____________');
                  htp.p('      </td>');
                  htp.p('    </tr>');
                  htp.p('    <tr>');
                  htp.p('      <td colspan="3">Emitente: TI Romance');
                  htp.p('      </td>');
                  htp.p('    </tr>');
                  htp.p('    <tr>');
                  htp.p('      <td colspan="3">&nbsp');
                  htp.p('      </td>');
                  htp.p('    </tr>');
                  htp.p('    <tr>');
                  htp.p('      <td colspan="3" style="text-align: right;">______________________________________________');
                  htp.p('      </td>');
                  htp.p('    </tr>');
                  htp.p('  </body>');
                  htp.p('</html>');
                  --  
                end;
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
