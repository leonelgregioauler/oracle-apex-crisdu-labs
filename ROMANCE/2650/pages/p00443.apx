    region gestão-orçamentária-pivot-2 (
        name: Gestão Orçamentária - Pivot
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select o.idgestaoorcamentaria
                     , o.conta
                     , o.subconta
                     , o.numero
                     , o.mes
                     , o.orcado valor_orcado
                     , sum(d.valor) valor_gasto
                     , case when o.orcado > 0 
                         then round((sum(d.valor) / o.orcado) * 100 ,2) 
                         else 
                           0
                       end Perc_Usado
                
                    from vw_gestaoorcamentaria      o
                       , vw_despesascentroscustos_m d
                              -- Maicon Aimi - 9156071 - 15/08/2024 - ajuste para permitir todos os centros de custo
                   where (   (:P443_IDCENTRODECUSTO is null and exists (select 1
                                                                          from roman.centrodecustos cc
                                                                         where cc.idcentrodecusto = o.idcentrodecusto
                                                                           and cc.tipo in (1,4)))
                          or ( o.idcentrodecusto = :P443_IDCENTRODECUSTO))
                      and o.idcentrodecusto = d.idcentrodecusto
                      and o.idcontafinanceira = d.idcontafinan
                      and o.idsubcontafinanceira = d.idsubcontafinan
                      and o.numero = d.mes
                      and o.vigencia = d.ano
                      and o.vigencia   = (select vigencia 
                                            from gestaoorcamentaria
                                           where idgestaoorcamentaria = :P443_PERIODO_ORCAMENTO)
                      and o.mesinicial = (select mesinicial
                                            from gestaoorcamentaria
                                           where idgestaoorcamentaria = :P443_PERIODO_ORCAMENTO)
                      and o.mesfinal   = (select mesfinal
                                            from gestaoorcamentaria
                                           where idgestaoorcamentaria = :P443_PERIODO_ORCAMENTO)
                    group by o.idgestaoorcamentaria
                           , o.conta
                           , o.subconta
                           , o.mes
                           , o.numero
                           , o.orcado
                ---------
                UNION ALL
                ---------
                select o.idgestaoorcamentaria
                     , o.conta
                     , o.subconta
                     , '99' numero
                     , 'ACUMULADOS' mes
                     --
                     , (select sum(orcado) 
                          from vw_gestaoorcamentaria
                         where idcentrodecusto = :P443_IDCENTRODECUSTO
                           and idgestaoorcamentaria = o.idgestaoorcamentaria ) proposta
                     --
                     , sum(d.valor) contra_proposta --valor_gasto
                     --
                     , case when (select sum(orcado) 
                                    from vw_gestaoorcamentaria
                                   where idcentrodecusto = :P443_IDCENTRODECUSTO
                                     and idgestaoorcamentaria = o.idgestaoorcamentaria )  > 0 
                         then round((sum(d.valor) / 
                                     (select sum(orcado) 
                                        from vw_gestaoorcamentaria
                                       where idcentrodecusto = :P443_IDCENTRODECUSTO
                                         and idgestaoorcamentaria = o.idgestaoorcamentaria )  
                                    ) * 100 ,2) 
                         else 
                           0
                       end orcamento --Perc_Usado
                      --
                from vw_gestaoorcamentaria      o
                       , vw_despesascentroscustos_m d
                          -- Maicon Aimi - 9156071 - 15/08/2024 - ajuste para permitir todos os centros de custo
                where (   (:P443_IDCENTRODECUSTO is null and exists (select 1
                                                                      from roman.centrodecustos cc
                                                                     where cc.idcentrodecusto = o.idcentrodecusto
                                                                       and cc.tipo in (1,4)))
                      or ( o.idcentrodecusto = :P443_IDCENTRODECUSTO))
                      
                      
                      and o.idcentrodecusto = d.idcentrodecusto
                      and o.idcontafinanceira = d.idcontafinan
                      and o.idsubcontafinanceira = d.idsubcontafinan
                      and o.numero = d.mes
                      and o.vigencia = d.ano
                      and o.vigencia   = (select vigencia 
                                            from gestaoorcamentaria
                                           where idgestaoorcamentaria = :P443_PERIODO_ORCAMENTO)
                      and o.mesinicial = (select mesinicial
                                            from gestaoorcamentaria
                                           where idgestaoorcamentaria = :P443_PERIODO_ORCAMENTO)
                      and o.mesfinal   = (select mesfinal
                                            from gestaoorcamentaria
                                           where idgestaoorcamentaria = :P443_PERIODO_ORCAMENTO)
                    group by o.idgestaoorcamentaria
                           , o.conta
                           , o.subconta
                order by 2, 3, 5
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
