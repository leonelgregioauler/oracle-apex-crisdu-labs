    pageItem P443_PERIODO_ORCAMENTO (
        type: selectList
        label {
            label: Vigência
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct display
                     , retorno
                from ( select g.vigencia||' - '||( select initcap(m.mes)
                                                   from roman.meses m
                                                   where m.numero = g.mesinicial )||' a '||( select initcap(m.mes)
                                                                                             from roman.meses m
                                                                                             where m.numero = g.mesfinal ) display
                            , max(idgestaoorcamentaria) retorno
                       from roman.gestaoorcamentaria g
                       where ( :P443_IDCENTRODECUSTO is null or g.idcentrodecusto = :P443_IDCENTRODECUSTO)
                         and g.mesinicial is not null
                       group by vigencia, mesinicial, mesfinal)
                 order by retorno desc
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P443_IDCENTRODECUSTO
            parentRequired: false
