page 443 (
    name: Gestão Orçamentária
    title: Gestão Orçamentária
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: <font color="red"><b>Para editar o Orçamento, é necessário buscar um período base.</b></font>
        }
    )

    region gestão-orçamentária-det (
        name: Gestão Orçamentária Det
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select *
                 from (
                        select (select nome from centrodecustos where idcentrodecusto = w.idcentrodecusto) NomeCentroCusto,
                               w.idgestaoorcamentaria, 
                               w.conta, 
                               w.subconta, 
                               nvl(w.proposta,0) proposta, 
                               nvl(w.contraproposta,0) contraproposta, 
                               nvl(w.orcado,0) orcado,
                               w.mes,
                               w.idcontrapropostaorcamentomes, 
                               w.idorcamentomes 
                          from vw_gestaoorcamentaria w
                         where (   (:P443_IDCENTRODECUSTO is null and exists (select 1
                                                                          from roman.centrodecustos cc
                                                                         where cc.idcentrodecusto = w.idcentrodecusto
                                                                           and cc.tipo in (1,4)))
                                or ( w.idcentrodecusto = :P443_IDCENTRODECUSTO))
                           and vigencia = (select vigencia 
                                             from gestaoorcamentaria
                                            where idgestaoorcamentaria = :P443_PERIODO_ORCAMENTO)
                           and mesinicial = (select mesinicial
                                               from gestaoorcamentaria
                                            where idgestaoorcamentaria = :P443_PERIODO_ORCAMENTO)
                           and mesfinal = (select mesfinal
                                               from gestaoorcamentaria
                                            where idgestaoorcamentaria = :P443_PERIODO_ORCAMENTO)     
                         order by w.numero
                         ) w
                  PIVOT ( SUM(PROPOSTA) PROPOSTA,
                          SUM(CONTRAPROPOSTA) CONTRAPROP,
                          SUM(ORCADO) ORCAMENTO
                         FOR mes 
                           IN ('JANEIRO','FEVEREIRO','MARCO','ABRIL','MAIO','JUNHO','JULHO','AGOSTO','SETEMBRO','OUTUBRO','NOVEMBRO','DEZEMBRO')
                         )
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: 0
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado.
        }
        advanced {
            savedReportMappingIdentifier: 1124928875061560461
        }

