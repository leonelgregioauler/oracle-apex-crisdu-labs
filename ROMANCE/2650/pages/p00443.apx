    process gera-orçamento (
        name: Gera Orçamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 vexiste number;
                begin
                  --
                  begin
                  select 1 
                    into vexiste
                    from gestaoorcamentaria w
                   where idcentrodecusto = :P443_IDCENTRODECUSTO
                     and referente       = :P443_ANO
                     and (:P443_MESINICIAL between w.mesinicial and w.mesfinal or
                          :P443_MESFINAL   between w.mesinicial and w.mesfinal);
                  exception
                   when others then null;
                  end;
                  if nvl(vexiste,0) > 0 then
                    raise_application_error(-20001,'Já existe orçamento para os parâmetros informados!');
                  end if;
                  --
                  pck_centrodecustos_rmc.prc_geraorcamento_v2(pidcentrodecusto => :P443_IDCENTRODECUSTO,
                                                              pano             => :P443_ANO,
                                                              pidmes_inicio    => :P443_MESINICIAL,
