    pageItem P443_IDCENTRODECUSTO (
        type: selectList
        label {
            label: Centro de Custo
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nome             as display_value
                     , c.idcentrodecusto  as return_value
                  from roman.centrodecustos c
                       -- Maicon Aimi - 14/05/2025 - 10112660 
                       -- ajustado o filtro da tabela centro de custos para trazer somente do os que são do tipo 1 Gerencial (Rateio Automático)
                       -- 16604061 - incluído o tipo 4 (Gerencial CSC) junto com o tipo 1 (Gerencial Direto)
                 where c.tipo in (1,4)
                   and c.ativo = 'S'
                   and (    ( pck_util.fnc_verificaacesso(2901061,v('APP_USER')) = 'S')
                         or ( c.idpessoaresponsavel = ( select u.idpessoa
                                                          from usuarios u
                                                         where u.usuario = v('APP_USER'))))
                 order by 1
                 
                 /*select c.nome             as display_value
                     , c.idcentrodecusto  as return_value
                  from roman.centrodecustos c
                       -- Maicon Aimi - 14/05/2025 - 10112660 
                       -- ajustado o filtro da tabela centro de custos para trazer somente do os que são do tipo 1 Gerencial (Rateio Automático)
                 where c.tipo = 1 --'Gerencial (Rateio Automático)'
                   and c.ativo = 'S'
                   and (    ( pck_util.fnc_verificaacesso(2901061,v('APP_USER')) = 'S')
                         or ( c.idpessoaresponsavel = ( select u.idpessoa
                                                          from usuarios u
                                                         where u.usuario = v('APP_USER'))))
                 order by 1*/
                 
                
                
                
                /*
                       -- Maicon Aimi - 14/05/2025 - 10112660 query antiga
                select c.nome             as display_value
                     , c.idcentrodecusto  as return_value
                  from roman.centrodecustos c
                 where (    pck_util.fnc_verificaacesso(2901061,v('APP_USER')) = 'S'
                         or c.idpessoaresponsavel = ( select u.idpessoa
                                                        from usuarios u
                                                       where u.usuario = v('APP_USER') ) )
                 order by 1;
                 */
                ```
            nullDisplayValue: - Todos -
