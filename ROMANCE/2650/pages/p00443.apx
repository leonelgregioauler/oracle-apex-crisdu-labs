                          and mesinicial = (select mesinicial
                                              from gestaoorcamentaria
                                             where idgestaoorcamentaria = :P443_PERIODO_ORCAMENTO)
                          and mesfinal = (select mesfinal
                                            from gestaoorcamentaria
                                           where idgestaoorcamentaria = :P443_PERIODO_ORCAMENTO) 
                          having sum(nvl(o.janeiro,0) + nvl(o.fevereiro,0) + nvl(o.marco,0) + nvl(o.abril,0) + nvl(o.maio,0) + nvl(o.junho,0) + nvl(o.julho,0) + nvl(o.agosto,0) + nvl(o.setembro,0) + nvl(o.outubro,0) + nvl(o.novembro,0) + nvl(o.dezembro,0)) = 0;
                        
                    ```
