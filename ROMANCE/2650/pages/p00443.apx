    dynamicAction pergunta (
        name: Pergunta
        execution {
            sequence: 50
        }
        when {
            event: click
            selectionType: button
            button: @exclui-orcamento
        }

        action alerta-sobre-orcamento-com-valor (
            name: Alerta sobre orcamento com valor
            action: alert
            settings {
                title: Ação Cancelada
                message: Orçamento não pode ser excluído, existe valor orçado. Verifique!
                style: danger
                icon: fa-alert
                okLabel: Ok
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1
                          from gestaoorcamentaria w
                             , orcamentosmes      o
                         where o.idgestaoorcamentaria   = w.idgestaoorcamentaria
                           and w.idcentrodecusto = :P443_IDCENTRODECUSTO
                          and vigencia = (select vigencia 
                                            from gestaoorcamentaria
                                           where idgestaoorcamentaria = :P443_PERIODO_ORCAMENTO)
                          and mesinicial = (select mesinicial
                                              from gestaoorcamentaria
                                             where idgestaoorcamentaria = :P443_PERIODO_ORCAMENTO)
                          and mesfinal = (select mesfinal
                                            from gestaoorcamentaria
                                           where idgestaoorcamentaria = :P443_PERIODO_ORCAMENTO) 
                          having sum(nvl(o.janeiro,0) + nvl(o.fevereiro,0) + nvl(o.marco,0) + nvl(o.abril,0) + nvl(o.maio,0) + nvl(o.junho,0) + nvl(o.julho,0) + nvl(o.agosto,0) + nvl(o.setembro,0) + nvl(o.outubro,0) + nvl(o.novembro,0) + nvl(o.dezembro,0)) > 0;
                        
                    ```
            }
        )

        action exclui-orcamento (
            name: Exclui Orcamento
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      -- T9995419
                    v_verifica number := 0;
                      --
                    begin
                      --
                      begin
                        --
                        select 1
                          into v_verifica
                          from gestaoorcamentaria w
                             , orcamentosmes      o
                         where o.idgestaoorcamentaria = w.idgestaoorcamentaria
                           and w.idcentrodecusto = :P443_IDCENTRODECUSTO
                          and vigencia = (select vigencia 
                                            from gestaoorcamentaria
                                           where idgestaoorcamentaria = :P443_PERIODO_ORCAMENTO)
                          and mesinicial = (select mesinicial
                                              from gestaoorcamentaria
                                             where idgestaoorcamentaria = :P443_PERIODO_ORCAMENTO)
                          and mesfinal = (select mesfinal
                                            from gestaoorcamentaria
                                           where idgestaoorcamentaria = :P443_PERIODO_ORCAMENTO) 
                          having sum(nvl(o.janeiro,0) + nvl(o.fevereiro,0) + nvl(o.marco,0) + nvl(o.abril,0) + nvl(o.maio,0) + nvl(o.junho,0) + nvl(o.julho,0) + nvl(o.agosto,0) + nvl(o.setembro,0) + nvl(o.outubro,0) + nvl(o.novembro,0) + nvl(o.dezembro,0)) > 0;
                        --
                        exception when no_data_found then
                          --
                          v_verifica := 0;
                          --
                      end;
                      --
                      if v_verifica = 0 and :P443_IDCENTRODECUSTO is not null and :P443_PERIODO_ORCAMENTO is not null then
                        --
                        for c in (select w.idgestaoorcamentaria
                                    from gestaoorcamentaria w
                                       , orcamentosmes      o
                                   where o.idgestaoorcamentaria   = w.idgestaoorcamentaria
                                     and w.idcentrodecusto = :P443_IDCENTRODECUSTO
                                    and vigencia = (select vigencia 
                                                      from gestaoorcamentaria
                                                     where idgestaoorcamentaria = :P443_PERIODO_ORCAMENTO)
                                    and mesinicial = (select mesinicial
                                                        from gestaoorcamentaria
                                                       where idgestaoorcamentaria = :P443_PERIODO_ORCAMENTO)
                                    and mesfinal = (select mesfinal
                                                      from gestaoorcamentaria
                                                     where idgestaoorcamentaria = :P443_PERIODO_ORCAMENTO)  )
                        loop
                          --
                          delete from roman.orcamentosmes o
                          where o.idgestaoorcamentaria = c.idgestaoorcamentaria;
                          --
                          delete from contrapropostasorcamentosmes cp
                          where cp.idgestaoorcamentaria = c.idgestaoorcamentaria;
                          --
                          delete from propostasorcamentosmes p
                          where p.idgestaoorcamentaria = c.idgestaoorcamentaria;
                          --
                          delete from gestaoorcamentaria g
                          where g.idgestaoorcamentaria = c.idgestaoorcamentaria;
                          --
                        end loop;
                        --
                      end if;
                      --
                    end;
                    ```
            }
            execution {
                sequence: 80
                fireOnInit: false
            }
        )

