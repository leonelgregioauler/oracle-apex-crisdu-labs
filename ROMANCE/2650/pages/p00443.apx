    region gestão-orçamentária-pivot (
        name: Gestão Orçamentária - Pivot
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rownum seq_id,
                       w.idgestaoorcamentaria, 
                       w.conta, 
                       w.subconta, 
                       w.mes,
                       w.proposta, 
                       w.contraproposta contra_proposta, 
                       w.orcado orcamento,
                       w.numero
                    from vw_gestaoorcamentaria w
                           -- Maicon Aimi - 9156071 - 15/08/2024 - ajuste para permitir todos os centros de custo
                    where (  (:P443_IDCENTRODECUSTO is null and exists (select 1
                                                                          from roman.centrodecustos cc
                                                                         where cc.idcentrodecusto = w.idcentrodecusto
                                                                           and cc.tipo = 1))
                          or ( w.idcentrodecusto = :P443_IDCENTRODECUSTO))
                      and vigencia   = (select vigencia 
                                          from gestaoorcamentaria
                                         where idgestaoorcamentaria = :P443_PERIODO_ORCAMENTO)
                      and mesinicial = (select mesinicial
                                          from gestaoorcamentaria
                                         where idgestaoorcamentaria = :P443_PERIODO_ORCAMENTO)
                      and mesfinal   = (select mesfinal
                                          from gestaoorcamentaria
                                         where idgestaoorcamentaria = :P443_PERIODO_ORCAMENTO)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
