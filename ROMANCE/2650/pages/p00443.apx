            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    -- este select esta aqui para controlar o submit, executar apenas depois que realmente tiver uma exclusão executada
                    select 1
                          from gestaoorcamentaria w
                             , orcamentosmes      o
                         where o.idgestaoorcamentaria   = w.idgestaoorcamentaria
                           and w.idcentrodecusto = :P443_IDCENTRODECUSTO
                          and vigencia = (select vigencia 
                                            from gestaoorcamentaria
