    pageItem P443_ANO (
        type: selectList
        label {
            label: Ano Base das Despesas
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ANO D, ANO R
                FROM (
                SELECT EXTRACT(YEAR FROM SYSDATE) -2 "ANO" FROM DUAL
                UNION
                SELECT EXTRACT(YEAR FROM SYSDATE) -1 "ANO" FROM DUAL
                UNION
                SELECT EXTRACT(YEAR FROM SYSDATE)  "ANO" FROM DUAL
                UNION
                SELECT EXTRACT(YEAR FROM SYSDATE) +1 "ANO" FROM DUAL
                )
                ```
        }
        layout {
            sequence: 30
            region: @novo-orçamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
