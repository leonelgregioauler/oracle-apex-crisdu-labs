page 377 (
    name: Impressão do Termo de Quitação
    title: Impressão do Termo de Quitação
    appearance {
        pageTemplate: @impressão-limpa
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region impressão-do-termo (
        name: Impressão do Termo
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                  -- 
                  pck_imprime.prc_declaracaodivida(pidfornecedor => :P377_IDFORNECEDOR,
                                                   pidrazaosocial => :P377_IDRAZAOSOCIAL,
                                                   pidrazaosocialfilial => :P377_IDRAZAOSOCIALDESTINO,
                                                   pdatainicio => :P377_DATAINICIO,
                                                   pdatafim => :P377_DATAFIM);
                end;
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
    )

    pageItem P377_DATAFIM (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @impressão-do-termo
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P377_DATAINICIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @impressão-do-termo
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P377_IDFORNECEDOR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @impressão-do-termo
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P377_IDRAZAOSOCIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @impressão-do-termo
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P377_IDRAZAOSOCIALDESTINO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @impressão-do-termo
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

