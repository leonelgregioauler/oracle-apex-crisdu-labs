page 156 (
    name: Nova Saida
    title: Nova Saida
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='Confirma a exclusão da Saída?';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region nova-saida (
        name: Nova Saida
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P156_DATA (
        type: hidden
        layout {
            sequence: 70
            region: @nova-saida
            slot: regionBody
        }
        appearance {
            formatMask: DD/MM/RRRR
        }
        source {
            type: databaseColumn
            databaseColumn: DATA
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                return sysdate;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P156_DESCRICAO (
        type: textarea
        label {
            label: Descrição
            alignment: right
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 90
            region: @nova-saida
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
            height: 4
        }
        validation {
            maxLength: 200
        }
        source {
            type: databaseColumn
            databaseColumn: DESCRICAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P156_FECHAMENTOORIG (
        type: selectList
        label {
            label: Fechamento
            alignment: right
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select semana DISPLAY_VALUE
                , semana return_value
                from fechamentossemanais 
                where idfechamento = :P156_IDFECHAMENTO
                ```
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @nova-saida
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            customAttributes: style="text-align: right;" readonly
        }
        source {
            type: databaseColumn
            databaseColumn: FECHAMENTOORIG
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P156_IDFECHAMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 100
            region: @nova-saida
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFECHAMENTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P156_IDFILIAL (
        type: selectList
        label {
            label: Filial
            alignment: right
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(p.apelido,p.nomepessoa)) display_value
                     , f.idfilial return_value
                from filiais    f
                   , pessoas    p
                where f.idpessoa  = p.idpessoa
                  and ( (pck_romance.fnc_verificaacesso('PERM_ALTERAFECHA', v('APP_USER')) = 'S')
                       or f.idfilial = ( select  f.idfilial 
                                        from filiais    f
                                           , usuarios   u
                                           , gerentes   g
                                        where g.idfilial  = f.idfilial
                                          and u.idgerente = g.idgerente
                                          and u.usuario   = v('APP_USER')))
                ```
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @nova-saida
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P156_IDFILIALDEST (
        type: selectList
        label {
            label: Filial Destino
            alignment: right
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct initcap(nvl(p.apelido,p.nomepessoa)) display_value
                     , f.idfilial return_value
                from filiais    f
                   , pessoas    p
                   , usuarios   u
                   , gerentes   g
                where f.idpessoa  = p.idpessoa
                  and g.idfilial  = f.idfilial
                  and u.idgerente(+) = g.idgerente
                order by 1
                ```
            nullDisplayValue: - Selecione a Filial Destino -
        }
        layout {
            sequence: 30
            region: @nova-saida
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIALDEST
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P156_IDSAIDA (
        type: hidden
        layout {
            sequence: 10
            region: @nova-saida
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDSAIDA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P156_SEMANA (
        type: hidden
        layout {
            sequence: 50
            region: @nova-saida
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: SEMANA
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                return to_char(sysdate,'IW/RRRR');
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P156_TIPO (
        type: radioGroup
        label {
            label: Tipo
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Dinheiro;D,Pagamento de Conta;O
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @nova-saida
            slot: regionBody
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: TIPO
            used: always
        }
        default {
            type: static
            staticValue: O
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P156_VALORTOTAL (
        type: numberField
        label {
            label: Valor Total
            alignment: right
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 80
            region: @nova-saida
            slot: regionBody
            alignment: left
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G990D00
            width: 15
        }
        validation {
            maxLength: 255
        }
        advanced {
            customAttributes: style="text-align: right;"
        }
        source {
            type: databaseColumn
            databaseColumn: VALORTOTAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @nova-saida
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 155
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 40
            region: @nova-saida
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P156_IDSAIDA
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @nova-saida
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P156_IDSAIDA
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @nova-saida
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P156_IDSAIDA
        }
    )

    validation p156-descricao (
        name: P156_DESCRICAO
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P156_DESCRICAO
        }
        error {
            errorMessage: #LABEL# deve ser informado!
            associatedItem: @P156_DESCRICAO
        }
    )

    validation p156-idfilialdest (
        name: P156_IDFILIALDEST
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P156_IDFILIALDEST
        }
        error {
            errorMessage: #LABEL# deve ser informado.
            associatedItem: @P156_IDFILIALDEST
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    validation p156-tipo (
        name: P156_TIPO
        execution {
            sequence: 40
        }
        validation {
            type: itemIsNotNull
            item: P156_TIPO
        }
        error {
            errorMessage: #LABEL# deve ser informado.
            associatedItem: @P156_TIPO
        }
    )

    validation p156-valortotal (
        name: P156_VALORTOTAL
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P156_VALORTOTAL
        }
        error {
            errorMessage: #LABEL# deve ser informado!
            associatedItem: @P156_VALORTOTAL
        }
    )

    process fetch-row-from-saidasdiversas (
        name: Fetch Row from SAIDASDIVERSAS
        type: autoRowFetch
        source {
            tableName: SAIDASDIVERSAS
            pkColumn: IDSAIDA
            pkItem: P156_IDSAIDA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Unable to fetch row.
        }
        advanced {
            executionMappingIdentifier: 254502930368190651
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDSAIDASDIVERSAS.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P156_IDSAIDA := get_pk; 
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Unable to get primary key item value.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 254503107587190651
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-saidasdiversas (
        name: Process Row of SAIDASDIVERSAS
        type: autoRowProcessing
        target {
            tableName: SAIDASDIVERSAS
            pkColumn: IDSAIDA
            pkItem: P156_IDSAIDA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        error {
            errorMessage: Unable to process row of table SAIDASDIVERSAS.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 254503306123190651
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        clear {
            type: pages
            pages: 66
        }
        execution {
            sequence: 40
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 254503507917190651
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 155
            }
            saveStateBeforeBranching: true
        }
    )

)

