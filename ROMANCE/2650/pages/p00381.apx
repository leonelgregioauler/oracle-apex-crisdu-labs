page 381 (
    name: Importação de Extrato
    title: Importação de Extrato
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }

    region importação-de-arquivo (
        name: Importação de Arquivo
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P381_TIPO
            value: P
        }
        settings {
            outputAs: text
        }
    )

    region importação-de-arquivo-nova (
        name: Importação de Arquivo Nova
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P381_TIPO
            value: C
        }
        settings {
            outputAs: text
        }
    )

    pageItem P381_ARQUIVO (
        type: fileUpload
        label {
            label: Arquivo
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
        }
        layout {
            sequence: 30
            region: @importação-de-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: ARQUIVO
            used: always
        }
    )

    pageItem P381_ARQUIVO_C (
        type: fileUpload
        label {
            label: Arquivo
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
        }
        layout {
            sequence: 30
            region: @importação-de-arquivo-nova
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: ARQUIVO
            used: always
        }
    )

    pageItem P381_IDBANCO (
        type: selectList
        label {
            label: Selecione o Banco
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select b.nomebanco
                     , b.idbanco
                from bancos b
                order by 1
                ```
        }
        layout {
            sequence: 20
            region: @importação-de-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDCONTABANCARIA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P381_ROWID (
        type: hidden
        layout {
            sequence: 10
            region: @importação-de-arquivo
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ROWID
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P381_ROWID_C (
        type: hidden
        layout {
            sequence: 10
            region: @importação-de-arquivo-nova
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ROWID
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P381_TIPO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @importação-de-arquivo
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 40
            region: @importação-de-arquivo
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 380
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button fechar-c (
        buttonName: FECHAR_C
        label: Fechar
        layout {
            sequence: 20
            region: @importação-de-arquivo-nova
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 380
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button importar (
        buttonName: IMPORTAR
        label: Importar Arquivo
        layout {
            sequence: 30
            region: @importação-de-arquivo
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from importacoesbb
                ```
        }
    )

    button importar-c (
        buttonName: IMPORTAR_C
        label: Importar Arquivo
        layout {
            sequence: 30
            region: @importação-de-arquivo-nova
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from importacoesbb
                ```
        }
    )

    button processar (
        buttonName: PROCESSAR
        label: Processar
        layout {
            sequence: 10
            region: @importação-de-arquivo
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from importacoesbb
                ```
        }
    )

    button processar-c (
        buttonName: PROCESSAR_C
        label: Processar
        layout {
            sequence: 10
            region: @importação-de-arquivo-nova
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from importacoesbb
                ```
        }
    )

    button reiniciar (
        buttonName: REINICIAR
        label: Reiniciar
        layout {
            sequence: 20
            region: @importação-de-arquivo
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from importacoesbb
                ```
        }
    )

    button reiniciar-c (
        buttonName: REINICIAR_C
        label: Reiniciar
        layout {
            sequence: 40
            region: @importação-de-arquivo-nova
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from importacoesbb
                ```
        }
    )

    validation valida-arquivo (
        name: Valida Arquivo
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P381_ARQUIVO
        }
        error {
            errorMessage: Por favor, adicione um arquivo!
        }
        serverSideCondition {
            type: request=Value
            value: IMPORTAR
        }
    )

    process fetch-row-from-importacoesbb (
        name: Fetch Row from IMPORTACOESBB
        type: autoRowFetch
        source {
            tableName: IMPORTACOESBB
            pkColumn: 0
            pkItem: P381_ROWID
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 69098626497007699
        }
    )

    process process-row-of-importacoesbb (
        name: Process Row of IMPORTACOESBB
        type: autoRowProcessing
        target {
            tableName: IMPORTACOESBB
            pkColumn: ROWID
            pkItem: P381_ROWID
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada com sucesso.
        }
        advanced {
            executionMappingIdentifier: 69099058984007699
        }
        serverSideCondition {
            whenButtonPressed: @importar
        }
    )

    process process-row-of-importacoesbb-c (
        name: Process Row of IMPORTACOESBB_C
        type: autoRowProcessing
        target {
            tableName: IMPORTACOESBB
            pkColumn: ROWID
            pkItem: P381_ROWID_C
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Ação Processada com sucesso.
        }
        advanced {
            executionMappingIdentifier: 5545954594229955421
        }
        serverSideCondition {
            whenButtonPressed: @importar-c
        }
    )

    process processa-arquivo (
        name: Processa Arquivo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidusuario number;
                begin
                  --
                  select idusuario
                  into vidusuario
                  from usuarios u
                  where u.usuario = v('APP_USER');
                  --
                  pck_bancos_rmc.prc_importa_arquivo(pidbanco => :P381_IDBANCO,
                                                     pidusuario => vidusuario);
                  --
                  if :P381_IDBANCO = 41 then
                    pck_bancos_rmc.prc_processa_bradesco;
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Arquivo processado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 69098289097007699
        }
        serverSideCondition {
            type: request=Value
            value: PROCESSAR
        }
    )

    process processa-arquivo-conciliação (
        name: Processa Arquivo Conciliação
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidusuario number;
                begin
                  --
                  select idusuario
                  into vidusuario
                  from usuarios u
                  where u.usuario = v('APP_USER');
                  --
                  pck_bancos_rmc.prc_importa_conciliacao(vidusuario);
                  --
                end;
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 5545954686331955422
        }
        serverSideCondition {
            type: request=Value
            value: PROCESSAR_C
        }
    )

    process reinicia-processo (
        name: Reinicia Processo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  delete importacoesbb;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 69097880821007698
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('REINICIAR','REINICIAR_C')
        }
    )

    branch (
        name: Go To Page 381
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 381
                items: {
                    P381_ARQUIVO: &P381_ARQUIVO.
                    P381_IDBANCO: &P381_IDBANCO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: IMPORTAR
        }
    )

)

