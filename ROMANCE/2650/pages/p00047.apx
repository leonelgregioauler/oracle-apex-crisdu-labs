    region históricos (
        name: Históricos
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idhistoricochamado
                     , idchamado
                     , datahistorico
                     , descricao
                     , usuario
                     , pck_romance.fnc_emailusuario(pusuario => trim(upper(:P47_USUARIO))) email
                     , DATAFIM 
                from historicochamados
                where idchamado = :P47_idchamado
                  and publico = 'S'
                order by idhistoricochamado
                ```
        }
        layout {
            sequence: 40
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
