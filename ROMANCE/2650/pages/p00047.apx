    process programar (
        name: Programar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  update chamados c
                  set c.idsituacao = 60
                     , c.dataprogramado = :P47_DATAPROGRAMADO
                  where c.idchamado = :P47_IDCHAMADO;
                 --
                  catal.pck_util.prc_enviaemail(ppara => 'ti@romancemoda.com.br',
                                                passunto => '[Informativo] Evento '||:P47_IDCHAMADO ||' foi programado',
                                                ptexto => 'Olá!'||chr(10)||chr(10)||
                                                          'O evento nrº '||:P47_IDCHAMADO||' foi analisado e programado para reabrir dia '||:P47_DATAPROGRAMADO||'.'||chr(10)||chr(10)||
                                                          'Atenciosamente,'||chr(10)||        
                                                          'TI - Romance Moda' );
                end;
                ```
        }
        execution {
            sequence: 210
        }
        advanced {
            executionMappingIdentifier: 232621043656488557
        }
    )

    process reabrir-evento (
        name: Reabrir Evento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  update chamados c
                  set c.idsituacao = 0
                    , DATAATENDIDO = null
                    , PERCCONCLUIDO = 0
                    , idsituacaokanban = 600
                  where c.idchamado = :P47_IDCHAMADO;
                  --
                  insert into historicochamados (idhistoricochamado, idchamado, datahistorico, descricao, email, usuario, datafim,situacao)
                  values ( seq_idhistoricochamado.nextval, :P47_IDCHAMADO, sysdate, 'Ticket reaberto.','N',v('APP_USER'),sysdate,'R');
                  --
                  catal.pck_util.prc_enviaemail(ppara => 'ti@romancemoda.com.br',
                                                pcopia => :P47_EMAIL,
                                                passunto => '[Informativo] Evento '||:P47_IDCHAMADO ||' reaberto.',
                                                ptexto => 'Olá!'||chr(10)||chr(10)||
                                                          'O evento nrº '||:P47_IDCHAMADO||' foi reaberto!'||chr(10)||chr(10)||
                                                          'Atenciosamente,'||chr(10)||        
                                                          'TI - Romance Moda' );
                
                end;
                ```
        }
        execution {
            sequence: 150
        }
        advanced {
            executionMappingIdentifier: 232620239387488557
        }
        serverSideCondition {
            whenButtonPressed: @reabrir
        }
    )

