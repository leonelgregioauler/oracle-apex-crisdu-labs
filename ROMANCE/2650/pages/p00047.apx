    process envia-email (
        name: envia email
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  catal.pck_util.prc_enviaemail(ppara => :P47_EMAIL,
                                                passunto => '[Informativo] Evento '||:P47_IDCHAMADO ||' respondido.',
                                                ptexto => 'Olá!'||chr(10)||chr(10)||
                                                          'O evento nrº '||:P47_IDCHAMADO||' foi respondido!'||chr(10)||chr(10)||
                                                          'Atenciosamente,'||chr(10)||        
                                                          'TI - Romance Moda' );
                
                  for i in ( select ( select email 
                             from pessoas
                             where idpessoa = ( select idpessoa
                                                from usuarios
                                                where usuario = u.usuario ) ) email
                             from usuarioschamados u
                             where u.idchamado= :P47_IDCHAMADO )
                  loop
                    catal.pck_util.prc_enviaemail(ppara => i.EMAIL,
                                                  passunto => '[Informativo] Chamado '||:P47_IDCHAMADO ||' respondido.',
                                                  ptexto => 'Olá!'||chr(10)||chr(10)||
                                                            'O evento nrº '||:P47_IDCHAMADO||' foi respondido!'||chr(10)||chr(10)||
                                                            'Você está recebendo este email por estar vinculado a este evento.'||chr(10)||chr(10)||
                                                            'Atenciosamente,'||chr(10)||        
                                                            'TI - Romance Moda' );
                
                  end loop;
                end;
                ```
        }
        execution {
            sequence: 230
        }
        successMessage {
            successMessage: Email enviado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 232621461135488557
        }
        serverSideCondition {
            type: request=Value
            value: ENVIAEMAIL
        }
    )

