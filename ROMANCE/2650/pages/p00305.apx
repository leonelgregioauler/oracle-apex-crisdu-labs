    region filtro (
        name: Filtro
        type: staticContent
        source {
            htmlCode:
                ```html
                <script language="Javascript">
                function filtra()
                { if ( P305_BENEFICIARIO.selectedIndex >= 0 )
                  {
                   vbeneficiario = P305_BENEFICIARIO.options[P305_BENEFICIARIO.selectedIndex].value;
                  }
                  else
                   {
                    vbeneficiario = ''
                   }
                window.location='f?p=&APP_ID.:45:&SESSION.::YES::P305_FORNECEDOR,P305_BENEFICIARIO,P305_REPRESENTANTE,P305_NOTAFISCAL,P305_VALOR,P305_SITUACAO,P305_FILIAL,P305_CONSULTAR,P305_FECHAMENTO,P305_MES,P305_ANO,P305_IDSEMANA:'
                +P305_FORNECEDOR.options[P305_FORNECEDOR.selectedIndex].value+','
                +vbeneficiario+','
                +P305_REPRESENTANTE.options[P305_REPRESENTANTE.selectedIndex].value+','
                +P305_NOTAFISCAL.options[P305_NOTAFISCAL.selectedIndex].value
                +','+P305_VALOR.value
                +','+P305_SITUACAO.options[P305_SITUACAO.selectedIndex].value+','
                +P305_FILIAL.options[P305_FILIAL.selectedIndex].value
                +',S'+','
                +P305_FECHAMENTO.options[P305_FECHAMENTO.selectedIndex].value
                +','+P305_MES.options[P305_MES.selectedIndex].value
                +','+P305_ANO.options[P305_ANO.selectedIndex].value
                +','+P305_IDSEMANA.options[P305_IDSEMANA.selectedIndex].value;void(0);
                }
                </script>
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--accent2
                t-Region--scrollBody
                t-Form--slimPadding
            ]
            renderComponents: belowContent
        }
        headerAndFooter {
            headerText:
                ```html
                <script language="Javascript">
                function confirmaexclusao() {
                	var answer = confirm("Deseja realmente excluir o depósito?")
                	if (answer){
                		apex.submit('EXCLUIRDEP');
                	}
                        else
                        {
                        document.getElementById('P38_EXCLUIR').value = '';
                        }
                }
                
                function confirmadesvinculo() {
                	var answer = confirm("Deseja realmente desvincular o depósito do acerto?")
                	if (answer){
                		apex.submit('DESVINCULARDEP');
                	}
                        else
                        {
                        document.getElementById('P38_EXCLUIR').value = '';
                        }
                }
                </script>
                ```
        }
    )

