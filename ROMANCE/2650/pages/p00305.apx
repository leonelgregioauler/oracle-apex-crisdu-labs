    }

    region atualizar-valor-comprovante-depósito (
        name: Atualizar Valor/Comprovante Depósito
        type: tabform
        source {
            sqlQuery:
                ```sql
                select '<a href="javascript:document.getElementById(''P305_EXCLUIR'').value = '||IDDEPOSITODIARIOS||';confirmaexclusao();">Excluir</a>' Excluir,
                        "IDDEPOSITODIARIOS",
                        "IDDEPOSITODIARIOS" IDDEPOSITODIARIOS_DISPLAY,
                        "DATA",
                        IDREPRESENTANTE IDREPRESENTANTE,
                        ( select  initcap(bb.nomebanco) || ' - <b>' || cb.agencia ||'/'||cb.conta||'</b> - <i>'||initcap(cb.beneficiario)||'</i>' 
                          from contasbancarias cb
                             , bancos          bb
                          where cb.idbanco      = bb.idbanco
                            and cb.idcontabanc  = dep.idcontabanc) "IDCONTABANC",
                        "IDPGTOFORN",
                        "VALORDEPOSITO",
                        "COMPROVADO",
                        "NROCOMPROVANTE",
                        "OBSERVACAO",
                        "OBSERVACAOGERENTE",
                        "TIPO",
                        "NROENVELOPE"
                        , ( select decode(o.identificado,'S','<b>Sim</b>','Não')||'' 
                            from ordensdepositos o
                            where o.idordemdeposito = dep.idordemdeposito ) identificado
                        , ( select semana
                            from fechamentorepresentantes f 
                            where f.idfechamentorepres = dep.idfechamentorepres ) fechamento
                        , '<a href="javascript:document.getElementById(''P305_EXCLUIR'').value = '||IDDEPOSITODIARIOS||';confirmadesvinculo();">Desvincular</a>' "Desvincular do Acerto"
                        , initcap(TO_CHAR(dep.DATA,'MONTH')) mes
                        , "IDENTIFICACAO"             
                     , ( select count(1)||' - '||listagg(trim(to_char(dd.valor_digitado,'999G999G999G999G990D00'))||' - '||dd.nroidentificacao_digitado,'; ') within group (order by 1)
                         from depositosdiarios_leituraocr dd
                         where dd.iddepositodiario = dep.IDDEPOSITODIARIOS ) fotos
                     , idordemdeposito
                from "#OWNER#"."DEPOSITOSDIARIOS_ORIG" dep
                where not exists ( select 1 from depositosdiarios d where d.iddepositodiarios = dep.iddepositodiarios)
                  and( nvl(:P305_FILIAL,'#') = '#'
                    or ( dep.idrepresentante in ( select r.idrepresentante 
                                                  from representantes r
                                                     , gerentes  g
                                                  where r.idgerente = g.idgerente
                                                    and g.idfilial = :P305_FILIAL) ) )
                  and dep.idrepresentante  != 0
                  and ( :P305_ANO           is null or EXTRACT ( year from dep.DATA) = :P305_ANO )
                  and ( :P305_SEMANA        is null or dep.idsemana        = :P305_IDSEMANA )
                  and ( (nvl(:P305_SITUACAO,'#') = '#' and dep.comprovado != 'M')  or ( dep.comprovado = :P305_SITUACAO))
                  AND ( :P305_BENEFICIARIO  is null or dep.idcontabanc     = :P305_BENEFICIARIO )
                  and ( :P305_representante is null or dep.idrepresentante = :P305_representante )
                  and ( :P305_VALOR         is null or dep.valordeposito   = :P305_VALOR )
                  and ( :P305_MES           is null or to_char(dep.data,'MM') = :P305_MES)    
                  AND ( :P305_TIPO          is null or TIPO = :P305_TIPO)
                  AND ( :P305_DATA          is null or ( dep.data between to_date(:P305_DATA||' 00:00:00','DD/MM/RRRR HH24:MI:SS') AND to_date(:P305_DATA||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                                                    or dep.data = :P305_DATA) )                         
                  and ( :P305_fornecedor is null or exists ( select 1 
                                                             from contasbancarias c 
                                                             where c.idpessoa       = :P305_fornecedor 
                                                               and c.idcontabanc   = dep.idcontabanc ) )
                  and ( :P305_NOTAFISCAL is null or exists ( select 1
                                                             from ordensdepositos o
                                                                , extratoscontasbancarias ex
                                                             where o.idordemdeposito  = dep.idordemdeposito
                                                               and ex.idcontabancaria = o.idcontabancaria
                                                               and ex.identificado    = o.identificado
                                                               and ex.idnotafiscal    = :p305_notafiscal ) )
                  and ( :P305_FECHAMENTO is null or exists ( select 1 
                                                             from fechamentorepresentantes f 
                                                             where f.idfechamentorepres = dep.idfechamentorepres 
                                                               and f.idfechamento       = :P305_FECHAMENTO ) )
                  and :P305_CONSULTAR is not null
                ```
        }
        layout {
            sequence: 50
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
