    pageItem P305_NOTAFISCAL (
        type: selectList
        label {
            label: Nr Nota
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct nf.documento  display_value
                     , nf.idnotafiscal return_value 
                from depositosdiarios_orig dd 
                   , ordensdepositos o
                   , notasfiscais   nf
                where dd.idordemdeposito = o.idordemdeposito
                  and exists ( select 1
                               from contasbancarias c
                                  , fornecedores f
                               where c.idcontabanc  = o.idcontabancaria
                                 and f.idpessoa     = c.idpessoa
                                 and f.idfornecedor = :P305_FORNECEDOR )
                  and ( nvl(:P305_REPRESENTANTE,'#') = '#' or dd.idrepresentante = :P305_REPRESENTANTE )
                  and exists ( select 1
                               from extratoscontasbancarias e
                               where e.idcontabancaria = o.idcontabancaria
                                 and e.identificado    = o.identificado
                                 and e.idnotafiscal    = nf.idnotafiscal )
                ```
            nullDisplayValue: " "
        }
        cascadingLov {
            parentItems: P305_FORNECEDOR
        }
        layout {
            sequence: 20
