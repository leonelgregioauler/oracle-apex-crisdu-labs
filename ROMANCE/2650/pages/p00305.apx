    pageItem P305_FORNECEDOR (
        type: selectList
        label {
            label: Fornecedor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(pe.apelido,pe.nomepessoa)) display_value
                     , fe.idpessoa return_value
                from fornecedores fe
                   , pessoas     pe
                where fe.idpessoa = pe.idpessoa 
                  and exists ( select 1
                               from contasbancarias c
                                  , depositosdiarios_orig d
                               where d.idordemdeposito is not null
                                 and d.idcontabanc     = c.idcontabanc
                                 and c.idpessoa        = pe.idpessoa )
                order by 1
                ```
            nullDisplayValue: - Selecione um Fornecedor -
        }
        layout {
            sequence: 30
            region: @new-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P305_IDSEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(semana,'00')) ||'/'||ano  display_value
                     , idsemana return_value
                from semana_dias
                where ano between EXTRACT ( year from sysdate) -2 and EXTRACT ( year from sysdate)
                order by 2 desc
                ```
