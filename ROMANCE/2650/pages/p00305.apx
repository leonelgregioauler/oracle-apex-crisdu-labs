    pageItem P305_FILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(p.apelido,p.nomepessoa)) display_value
                     , f.idfilial return_value
                from filiais f
                   , pessoas p
                where p.idpessoa = f.idpessoa
                  and f.ativo = 'S'
                order by 1 
                ```
