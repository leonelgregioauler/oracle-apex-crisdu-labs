    region depositos-abertos-a-mais-de-20-dias (
        name: Depositos abertos a mais de 20 dias
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.data
                     , d.nrocomprovante
                     , d.nroenvelope
                     , pck_romance.fnc_nomerepresentante(d.idrepresentante) nome
                     , pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(d.idrepresentante)) filial
                     , ( select cb.beneficiario||' - '||b.nomebanco
                              ||' - '|| cb.agencia ||' - '||
                              cb.conta
                         from contasbancarias cb
                            , bancos b
                         where cb.idbanco     = b.idbanco 
                           and cb.idcontabanc = d.idcontabanc ) conta
                     , d.valordeposito
                     , decode( d.identificacao, 'CA', 'Carro'
                                              , 'CH', 'Cheque Sem Fundo'
                                              , 'EE', 'Empréstimo'
                                              , 'CT', 'Catálogo'
                                              , 'TF', 'Transferência'
                                              , 'BC', 'Boca do Caixa'
                                              , 'OT', 'Outros' ) identificacao   
                     , ( select count(1)
                         from depositosdiarios_leituraocr dd
                         where dd.iddepositodiario = d.iddepositodiarios ) fotos
                from depositosdiarios_orig d
                where trunc(sysdate) - trunc(d.datacriacao) >= 20
                  and d.datacriacao is not null
                  and d.idfechamentorepres is null
                  and d.comprovado = 'S'
                  and d.idordemdeposito is not null
                  and exists ( select 1
                               from regioesrepresentantes rr
                               where rr.idrepresentante = d.idrepresentante )
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from depositosdiarios_orig d
                where trunc(sysdate) - trunc(d.datacriacao) >= 20
                  and d.datacriacao is not null
                  and d.idfechamentorepres is null
                  and d.comprovado = 'S'
                  and exists ( select 1
                               from regioesrepresentantes rr
                               where rr.idrepresentante = d.idrepresentante );
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 3
        }
        messages {
            whenNoDataFound: Nenhum depósito aberto a mais de 20 dias.
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 4737328692822524549
        }

