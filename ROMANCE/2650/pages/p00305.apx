    pageItem P305_ANO (
        type: selectList
        label {
            label: Ano
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct ano  display_value
                     , ano return_value
                from semana_dias
                where ano <= EXTRACT ( year from sysdate) 
                order by 1 desc
                ```
        }
        layout {
            sequence: 50
            region: @new
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P305_BENEFICIARIO (
        type: selectList
        label {
            label: Beneficiário
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select  initcap(bb.nomebanco) || ' - ' || cb.agencia ||'/'||cb.conta||' - '||initcap(cb.beneficiario) display_value
                , cb.idcontabanc return_value
                from contasbancarias cb
                   , fornecedores    ff
                   , bancos          bb
                where ff.idpessoa     = cb.idpessoa
                  and cb.idbanco      = bb.idbanco
                  and cb.idpessoa     = :P305_FORNECEDOR
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P305_FORNECEDOR
        }
        layout {
            sequence: 40
            region: @new-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

