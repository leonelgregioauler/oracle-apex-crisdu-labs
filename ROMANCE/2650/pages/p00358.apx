page 358 (
    name: Indicadores de Distribuidores
    title: Indicadores de Distribuidores
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region 15-distribuidores-com-valores-em-mãos (
        name: 15+ Distribuidores com valores em mãos
        type: plugin/d3BarChart
        source {
            sqlQuery:
                ```sql
                select t.distribuidor
                     , t.valor
                from (
                      select pck_romance.fnc_nomerepresentante(idrepresentante)||'('||pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(b.idrepresentante))||')' distribuidor
                           , round(sum(b.valorpago)*0.8,2) valor
                      from biroman.pagamentosnotasvendas b
                      where b.datapagamento >= ( select max(d.data)
                                                 from depositosdiarios_orig d
                                                 where d.idrepresentante = b.idrepresentante ) 
                        and b.datapagamento >= ( select max(fr.dataacerto )
                                                   from fechamentorepresentantes fr
                                                   where fr.idrepresentante = b.idrepresentante )                          
                        and exists ( select 1
                                     from representantes r
                                     where r.idrepresentante = b.idrepresentante 
                                       and r.ativo           = 'S')                             
                        and exists ( select 1
                                     from vw_filiais f
                                     where f.idfilial = pck_romance.fnc_filialrepresentante(b.idrepresentante)
                                       and f.ididioma = 1                           )                         
                      group by idrepresentante
                      order by 2 desc ) t
                where rownum <= 15
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            xValuesColumn: DISTRIBUIDOR
            yValuesColumn: VALOR
            display: horizontalSideBySide
            seriesName: Valor Por Empresa
            multipleColors: true
            valueFormatMask: attributeValue3
            tooltips: showYValue
            colorScheme: modern
        }
    )

    region distribuidores-com-valores-em-mãos (
        name: Distribuidores com valores em mãos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select b.idrepresentante
                     , pck_romance.fnc_filialrepresentante(b.idrepresentante) idempresa
                     , pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(b.idrepresentante) ) empresa
                     , pck_romance.fnc_nomerepresentante(idrepresentante) distribuidor
                     , round(sum(b.valorpago)*0.8,2) /*sem a comissão deles*/ valor
                     , max(b.datapagamento) dataatualizacao
                     ,  ( select max(d.data)
                           from depositosdiarios_orig d
                           where d.idrepresentante = b.idrepresentante ) ultimodeposito
                     , ( select max(fr.dataacerto )
                         from fechamentorepresentantes fr
                         where fr.idrepresentante = b.idrepresentante ) ultimoacerto 
                   /*  , ( select fr.vlrespecie
                         from fechamentorepresentantes fr
                         where fr.idfechamentorepres = ( select max(idfechamentorepres )
                                                         from fechamentorepresentantes fr
                                                         where fr.idrepresentante = b.idrepresentante ) ) valorespecie*/
                from biroman.pagamentosnotasvendas b
                where b.datapagamento >= ( select max(d.data)
                                           from depositosdiarios_orig d
                                           where d.idrepresentante = b.idrepresentante ) 
                  and b.datapagamento >= ( select max(fr.dataacerto )
                                             from fechamentorepresentantes fr
                                             where fr.idrepresentante = b.idrepresentante )                          
                  and exists ( select 1
                               from representantes r
                               where r.idrepresentante = b.idrepresentante 
                                 and r.ativo           = 'S')                             
                  and exists ( select 1
                               from vw_filiais f
                               where f.idfilial = pck_romance.fnc_filialrepresentante(b.idrepresentante)
                                 and f.ididioma = 1                           )                         
                group by b.idrepresentante
                
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 12671307967985947
        }

