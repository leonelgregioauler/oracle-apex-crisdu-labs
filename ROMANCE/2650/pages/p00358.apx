    region previsto-por-empresa (
        name: Previsto por Empresa
        type: plugin/d3BarChart
        source {
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(b.idrepresentante)) Empresa
                     , round(sum(b.valorpago)*0.8,2) valor
                from biroman.pagamentosnotasvendas b
                where b.datapagamento >= ( select max(d.data)
                                           from depositosdiarios_orig d
                                           where d.idrepresentante = b.idrepresentante ) 
                  and b.datapagamento >= ( select max(fr.dataacerto )
                                             from fechamentorepresentantes fr
                                             where fr.idrepresentante = b.idrepresentante )                          
                  and exists ( select 1
                               from representantes r
                               where r.idrepresentante = b.idrepresentante 
                                 and r.ativo           = 'S')                             
                  and exists ( select 1
                               from vw_filiais f
                               where f.idfilial = pck_romance.fnc_filialrepresentante(b.idrepresentante)
                                 and f.ididioma = 1                           )                         
                group by pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(b.idrepresentante))
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            xValuesColumn: EMPRESA
            yValuesColumn: VALOR
            display: horizontalSideBySide
            seriesName: Valor Por Empresa
            multipleColors: true
            valueFormatMask: attributeValue3
            tooltips: showYValue
            spacingBetweenCategories: 12
            colorScheme: modern2
        }
    )

    region top-10-distribuidores-melhores (
        name: Top 10 Distribuidores Melhores
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select rownum||' - '||distribuidor posicao
                     , mediageral
                from ( select t.*
                       from (  
                           select p.empresa
                                , p.distribuidor
                                , p.contagemacertos contacertos
                                , p.mediageral
                                , p.mediaromance
                                , p.mediafavorita
                             --   , p.mediafavoritaparis
                             --   , p.contagemfavoritaparis 
                           from vw_pontuacaogeral_rmc p
                           where ( :P358_IDFILIAL = -1 or p.idfilial = :P358_IDFILIAL )
                             and exists ( select 1
                                          from vw_filiais f
                                          where f.idfilial = p.idfilial
                                            and f.idgrupo != 5 )
                           order by mediageral desc ) t )
                where rownum <= 10
                ```
            pageItemsToSubmit: P358_IDFILIAL
        }
        layout {
            sequence: 10
            parentRegion: @top-10-distribuidores-pontuação
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        settings {
            labelColumn: POSICAO
            valueColumn: MEDIAGERAL
            barWidthCalculation: relative
            maximumRows: 10
            messageWhenNoDataFound: Nenhum dado localizado!
        }
    )

    region top-10-distribuidores-piores (
        name: Top 10 Distribuidores Piores
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select rownum||' - '||distribuidor posicao
                     , mediageral
                from ( select t.*
                       from (  
                           select p.empresa
                                , p.distribuidor
                                , p.contagemacertos contacertos
                                , p.mediageral
                                , p.mediaromance
                                , p.mediafavorita
                              --  , p.mediafavoritaparis
                              --  , p.contagemfavoritaparis 
                           from vw_pontuacaogeral_rmc p
                           where ( :P358_IDFILIAL = -1 or p.idfilial = :P358_IDFILIAL )
                             and exists ( select 1
                                          from vw_filiais f
                                          where f.idfilial = p.idfilial
                                            and f.idgrupo != 5 )
                           order by mediageral ) t )
                where rownum <= 10
                ```
            pageItemsToSubmit: P358_IDFILIAL
        }
        layout {
            sequence: 20
            parentRegion: @top-10-distribuidores-pontuação
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        settings {
            labelColumn: POSICAO
            valueColumn: MEDIAGERAL
            barWidthCalculation: relative
            maximumRows: 10
            messageWhenNoDataFound: Nenhum dado localizado!
        }
    )

    region top-10-distribuidores-pontuação (
        name: Top 10 Distribuidores - Pontuação
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent10
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P358_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                  and f.idgrupo != 5
                
                ```
            displayExtraValues: false
            nullDisplayValue: "- Todos - "
            nullReturnValue: -1
        }
        layout {
            sequence: 10
            region: @top-10-distribuidores-pontuação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction atualiza-grafico-melhores (
        name: Atualiza Grafico Melhores
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P358_IDFILIAL
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @top-10-distribuidores-melhores
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction atualiza-grafico-piores (
        name: Atualiza Grafico Piores
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P358_IDFILIAL
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @top-10-distribuidores-piores
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

