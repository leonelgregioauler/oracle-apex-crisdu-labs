page 52 (
    name: Controle de Acessos
    title: Controle de Acessos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function retirar(pid)
            {
              document.getElementById('P52_IDACESSO').value = pid;
              apex.submit('RETIRAR');
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region acessos (
        name: Acessos
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct idaplicacao
                     , descricao
                     , hierarquia
                     , decode( hierarquia , null , '<b>'||LPAD('* ', 3 * (level - 1)) || TO_CHAR(descricao) ||'</b>'
                     , '<i>'||LPAD('* ', 3 * (level - 1)) || TO_CHAR(descricao)||'</i>') nivel_hierarquico
                     , idacesso
                  from ( select a.idaplicacao
                              , a.descricao
                              , a.hierarquia
                              , b.idacesso
                         from aplicacoes a 
                            , acessos b
                         where a.idsistema = 600
                           and a.idaplicacao = b.idaplicacao
                           and b.usuario = :P52_USUARIOS )
                 start with hierarquia is null
                connect by prior idaplicacao = hierarquia
                order by descricao
                ```
        }
        layout {
            sequence: 15
            parentRegion: @usuário
            slot: subRegions
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: dados não encontrados
        }
        componentAdvanced {
            stripHtml: true
        }

        column DESCRICAO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

        column HIERARQUIA (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 4
            }
        )

        column IDACESSO (
            reportColumnQueryId: 5
            derivedColumn: N
            type: hidden
            layout {
                sequence: 6
            }
        )

        column IDAPLICACAO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column LINK$01 (
            reportColumnQueryId: 6
            derivedColumn: Y
            type: link
            heading {
                heading: &nbsp;
                alignment: center
            }
            layout {
                sequence: 1
            }
            link {
                target: {
                    type: url
                    url: javascript: retirar(#IDACESSO#);
                }
                linkText: <img src="#IMAGE_PREFIX#menu/pencil2_16x16.gif" alt="">
            }
            sorting {
                sortable: false
            }
        )

        column NIVEL_HIERARQUICO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Descrição
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region retirar-acessos (
        name: Retirar Acessos
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDACESSO",
                "IDACESSO" IDACESSO_DISPLAY,
                "USUARIO",
                "IDAPLICACAO",
                "ATIVO"
                from "#OWNER#"."ACESSOS"
                where usuario = :P52_USUARIOS
                ```
        }
        layout {
            sequence: 25
            parentRegion: @usuário
            slot: subRegions
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: never
        }
        reportLayout {
            numberOfRows: 400
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: showAll
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhum acesso liberado!
        }
        componentAdvanced {
            stripHtml: true
        }

        column ATIVO (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 6
            }
            sorting {
                sortable: false
            }
        )

        column CHECK$01 (
            reportColumnQueryId: 1
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: &nbsp;
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column IDACESSO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingTrigger
            }
            sorting {
                sortable: false
            }
        )

        column IDACESSO_DISPLAY (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

        column IDAPLICACAO (
            reportColumnQueryId: 5
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Aplicações
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select decode(hierarquia,null,  '<b>'|| TO_CHAR(descricao) ||'</b>'
                                                     , '<i>'||'* '|| TO_CHAR(descricao)||'</i>') display_value
                    , idaplicacao return_value
                    from aplicacoes
                    ```
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column USUARIO (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

    )

    region usuário (
        name: Usuário
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
    )

    pageItem P52_IDACESSO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @usuário
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P52_USUARIOS (
        type: selectList
        label {
            label: Usuário
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(username) display_value
                ,username return_value
                from dba_users d
                where trunc(d.created) >= to_date('07/12/2010','dd/mm/rrrr')
                AND USERNAME NOt IN ('APEX_PUBLIC_USER','APEX_040000','CATAL')
                and account_status != 'LOCKED'
                order by 1
                ```
            nullDisplayValue: - Selecione o Usuário -
        }
        layout {
            sequence: 10
            region: @usuário
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @retirar-acessos
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 51
                items: {
                    P51_USUARIOS: &P52_USUARIOS.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button multi-row-delete (
        buttonName: MULTI_ROW_DELETE
        label: Retirar Acessos
        layout {
            sequence: 20
            region: @retirar-acessos
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'MULTI_ROW_DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Salvar
        layout {
            sequence: 30
            region: @retirar-acessos
            slot: CHANGE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation idaplicacao-must-be-numeric (
        name: IDAPLICACAO must be numeric
        execution {
            sequence: 40
        }
        validation {
            editableRegion: @retirar-acessos
            type: columnIsNumeric
            column: IDAPLICACAO
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: IDAPLICACAO
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @retirar-acessos
        target {
            tableName: ACESSOS
            pkColumn: IDACESSO
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: #MRD_COUNT# row(s) deleted.
        }
        error {
            errorMessage: Unable to process delete.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 178747013653577794
        }
        serverSideCondition {
            type: request=Value
            value: MULTI_ROW_DELETE
            executeCondition: once
        }
    )

    process deletar-usuario (
        name: deletar usuario
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                delete from acessos
                where idacesso = :P52_IDACESSO;
                END;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Acesso retirado.
        }
        advanced {
            executionMappingIdentifier: 881649720142714828
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 52
                items: {
                    P52_USUARIOS: &P52_USUARIOS.
                }
                successMessage: false
            }
        }
        comments {
            comments: Created 24-JAN-2013 18:28 by ROMAN
        }
    )

)

