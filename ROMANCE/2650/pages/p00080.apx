    button novo-questionamento (
        buttonName: Novo_questionamento
        label: Novo Questionamento
        layout {
            sequence: 10
            region: @entradas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 433
                items: {
                    P433_QUESTIONAMENTO:
                    P433_IDFECHAMENTO: &P0_IDFECHAMENTO.
                    P433_IDFILIAL: &P0_IDFILIALCAIXA.
                    P433_PAGINA: 80
                    P433_IDQUESTIONAMENTO:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuariosgruposatendimento ug
                where ug.idgrupoatendimento in ( 2 , 0 )
                  and ug.usuario = v('APP_USER')
                  and :P0_IDFECHAMENTO is not null
                ```
        }
    )

    button revisarentradas (
        buttonName: Revisarentradas
        label: Revisar Entradas
        layout {
            sequence: 50
            region: @entradas
            slot: rightOfInteractiveReportSearchBar
