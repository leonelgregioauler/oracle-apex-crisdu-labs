    button novaentrada (
        buttonName: novaentrada
        label: Nova Entrada
        layout {
            sequence: 20
            region: @entradas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 64
                items: {
                    P64_IDFILIAL: &P0_IDFILIALCAIXA.
                    P64_IDFECHAMENTO: &P0_IDFECHAMENTO.
                }
                clearCache: 64
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                 pck_util.fnc_verificaacesso(2733,v('APP_USER')) = 'S' and ( select concluido
                                                                             from fechamentossemanais f
                                                                             where f.idfechamento = :P0_IDFECHAMENTO ) = 'N'
                ```
        }
    )

