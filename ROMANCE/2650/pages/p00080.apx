page 80 (
    name: Entradas Diversas
    title: Entradas Diversas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region entradas (
        name: Entradas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select identrada
                     , w.semanad semana
                     , Filial
                     , ano "Ano"
                     , semana "Semana"
                     , w.idfechamento
                     , idfilial
                     , anopgto "Ano Pgto"
                     , Filialorig--"Filial Origem"
                     , Filialdestino
                     , mes "Mês"
                     , fechamentoorig
                     , conta
                     , subconta
                     , valortotal
                     , descricao
                     , Tipo
                     , descricaoorigem "Descrição da Origem"
                     , data "Data"
                     , replace(to_char(data,'MM/YYYY'),' ','') meslancamento
                     , nota "Nota"
                     , w.tipoentrada "Tipo Entrada"
                     , w.idfilialorig
                     , case
                         when w.idmovimentogeral is not null then
                           ( select count(1)
                             from saidasdiversas s
                                , movimentosgeral m
                             where m.idmovimentogeral = w.idmovimentogeral 
                               and s.idsaida          = m.idsaidadiversa )
                       else 
                         ( select count(1)
                           from anexosentradas a
                           where a.identrada = w.identrada )
                       end anexos
                     , w.classificacao
                from vw_entradasdiversas w
                where w.idfilial = :P0_IDFILIALCAIXA
                  and (:P0_IDFECHAMENTO = 999999999999 
                        or idfechamento = :P0_IDFECHAMENTO )
                order by idsemana desc
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: Para informar entradas de valores, entre em contato com o Escritório.
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: pck_util.fnc_verificaacesso(2732,v('APP_USER')) = 'S'
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhuma entrada confirmada.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

