page 294 (
    name: Dinheiro Recebido
    title: Dinheiro Recebido
    appearance {
        pageMode: nonModalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region dinheiro-recebido (
        name: Dinheiro Recebido
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select identrada
                     , to_char(data,'IW/RRRR') semana
                     , data
                     , valortotal valor
                     , descricao
                     , descricaoorigem
                     , e.data datavencimento
                     , to_char(e.data,'MONTH') mesvencimento
                     , 'Entrada Caixa '||decode(e.tipoentrada,'D','Dinheiro','Pagamento de Conta') tipo
                from entradasdiversas e
                where to_char( e.data,'MMRRRR') = :P294_MESANO
                  and e.idfilial = :P294_IDFILIAL
                union
                select null
                     , to_char(dd.data,'IW/RRRR') semana
                     , trunc(dd.data) data
                     , sum(dd.valordeposito)
                     , decode(pf.tipopagamento,'B','Boleto pago. ', 'Depósito para ')||
                       pck_romance.fnc_nomefornecedor(pf.idfornecedor) ||' - '
                       || ( select n.documento||'(ID '||n.idnotafiscal||')'
                            from notasfiscais n
                            where n.idnotafiscal = pf.idnotafiscal ) descricao
                     , null descricaoorigem
                     , pf.dtvencimento
                     , to_char(pf.dtvencimento,'MONTH') mesvencimento
                     , 'Pagamento de Fornecedor' tipo
                from depositosdiarios dd
                   , pagamentosfornecedores pf
                where to_char( dd.data,'MMRRRR') = :P294_MESANO
                  and dd.valordeposito > 0
                  and dd.idpgtoforn = pf.idpgtoforn
                  and dd.idpgtoforn in ( select idpgtoforn 
                                         from pagamentosfornecedores pgf
                                         where pgf.idnotafiscal in ( select idnotafiscal
                                                                     from notasfiscais nn
                                                                     where nn.idfilialdestino =  :P294_IDFILIAL  ) )
                group by to_char(dd.data,'IW/RRRR'),trunc(dd.data), pf.idfornecedor, pf.idnotafiscal, pf.dtvencimento, pf.tipopagamento
                union
                select null
                     , to_char(v.datavencimento,'IW/RRRR') semana
                     , datavencimento
                     , v.valor
                     , 'Depósito para '||pck_romance.fnc_nomefornecedor(nn.idfornemitente) 
                     , ( select 'Compra de '||pck_romance.fnc_nomefornecedor(n.idfornemitente) ||' - ' ||n.documento 
                          from notasfiscais n
                          where idnotafiscal = nn.idnotafiscalcompra ) 
                     , v.datavencimento
                     , to_char(v.datavencimento,'MONTH') mesvencimento
                     , 'Valores Recebidos' tipo
                from vencimentosreceber v
                   ,  notasfiscais nn
                where to_char( datavencimento,'MMRRRR') = :P294_MESANO
                  and v.idnotafiscal = nn.idnotafiscal
                  and (nn.idfilialdestino =  :P294_IDFILIAL 
                    or nn.idfornecedordestino = pck_romance.fnc_fornecedorfilial(:P294_IDFILIAL )  )
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 600
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        performance {
            maxRowsToProcess: 5000
        }
        messages {
            whenNoDataFound: No data found.
        }
        breakFormatting {
            breakColumns: col1
        }
        componentAdvanced {
            stripHtml: true
        }
        download {
            csvExportEnabled: true
        }

        column DATA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 2
            }
            sorting {
                defaultSequence: 1
            }
        )

        column DATAVENCIMENTO (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Vencimento
                alignment: center
            }
            layout {
                sequence: 7
            }
        )

        column DESCRICAO (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 3
            }
        )

        column DESCRICAOORIGEM (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Descricaoorigem
                alignment: center
            }
            layout {
                sequence: 5
            }
        )

        column IDENTRADA (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 4
            }
        )

        column MESVENCIMENTO (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Mês Vencto
                alignment: center
            }
            layout {
                sequence: 8
            }
        )

        column SEMANA (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Semana
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column TIPO (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Tipo
                alignment: center
            }
            layout {
                sequence: 9
            }
        )

        column VALOR (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Valor
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            advanced {
                computeSum: true
            }
        )

    )

    pageItem P294_IDFILIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @dinheiro-recebido
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P294_MESANO (
        type: textField
        label {
            label: Semana
            alignment: left
        }
        layout {
            sequence: 10
            region: @dinheiro-recebido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 8
        }
        advanced {
            customAttributes: readonly
        }
        security {
            encryptSessionState: false
        }
    )

)

