    region rateios-de-centro-de-custos (
        name: Rateios de Centro de Custos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idrateiocentrocusto
                     , idcentrodecusto
                     , percentual
                     , idunidadedenegocio
                     , ( select gn.descricao
                         from gruposnegocios gn
                            , unidadesdenegocios un
                         where gn.idgruponegocio = un.idgruponegocio
                           and un.idunidadedenegocio = r.idunidadedenegocio ) grupo
                     , ( select c.nome
                         from centrodecustos c
                         where c.idcentrodecusto = r.idcentrodecusto ) centrodecusto
                     , ( select decode(c.tipo,1,'1 - Gerencial Direto',2,'2 - Unidades de Negócio',3,'3 - Não Operacional',4,'4 - Gerencial CSC')
                         from centrodecustos c
                         where c.idcentrodecusto = r.idcentrodecusto ) tipo
                     , ( select pck_romance.fnc_nomepessoa(c.idpessoaresponsavel)
                         from centrodecustos c
                         where c.idcentrodecusto = r.idcentrodecusto ) responasvel
                     , mesinicial
                     , mesfinal
                     , vigencia 
                from rateioscentroscustos r
                where r.idcentrodecusto = :P353_IDCENTRODECUSTO
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P353_IDCENTRODECUSTO
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        componentAppearance {
            showNullValuesAs: -
        }
        messages {
            whenNoDataFound: Nenhum rateio de centro de custo informado.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        enableUsersTo {
            savePublicReport: true
        }
        download {
            formats: csv
            sendAsEmail: false
        }
