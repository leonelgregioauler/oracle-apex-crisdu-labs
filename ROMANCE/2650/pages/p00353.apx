    pageItem P353_TIPO (
        type: selectList
        label {
            label: Tipo
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select '1 - Gerencial Direto' d, 1 r from dual
                union
                select '2 - Unidades de Negócio', 2 from dual
                union
                select '3 - Não Operacional', 3 from dual
                union
                select '4 - Gerencial CSC', 4 from dual
                order by 2
                
                /*select '1 - Gerencial (Rateio Automático)' d
                     , 1 r
                from dual
                union
                select '2 - Unidades de Negócio' 
                     , 2
                from dual
                union
                select '3 - Não Operacional'
                     , 3
                from dual
