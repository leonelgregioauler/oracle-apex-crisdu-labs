    pageItem P353_IDPESSOARESPONSAVEL (
        type: popupLov
        label {
            label: Responsável
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' CPF: '||p.cpf d
                     , p.idpessoa r
                from pessoas p
                where exists ( select 1
                               from usuarios u
                               where u.idpessoa = p.idpessoa 
                                 and u.ididioma = 1
                                 and u.ativo    = 'S' )
                order by 1 
                ```
            nullDisplayValue: -
        }
        layout {
            sequence: 40
            region: @cadastro-de-centro-de-custo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

