    process processo-dml-em-centro-de-custo (
        name: Processo DML em Centro de Custo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  --
                  if v('REQUEST') = 'CRIAR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'SALVAR' then
                    voperacao_dml := 'U';
                  end if;
                  --
                  PCK_CADASTROS_RMC.PRC_CENTRODECUSTOS( PIDCENTRODECUSTO => :P353_IDCENTRODECUSTO,
                                                        PNOME => :P353_NOME,
                                                        PTIPO => :P353_TIPO,
                                                        PIDPESSOARESPONSAVEL => :P353_IDPESSOARESPONSAVEL,
                                                        POBSERVACAO => :P353_OBSERVACAO,
                                                        PCONTABILIZADESPESA => :P353_CONTABILIZADESPESA,
                                                        PCONTABILIZARATEIO => :P353_CONTABILIZARATEIO,
                                                        PCODIGOVIRTUALAGE => :P353_CODIGOVIRTUALAGE,
                                                        PATIVO => :P353_ATIVO,
                                                        PCODIGOCONTABIL => :P353_CODIGOCONTABIL,
                                                        PMD5 => :P353_MD5,
                                                        POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo realizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 12429991715841260
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('CRIAR','SALVAR')
        }
    )

