    process replicar-centro-de-custos-em-rateios (
        name: Replicar Centro de Custos em Rateios
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidrateiocentrocusto number;
                  vidcentrodecusto     number := :P353_IDCENTRODECUSTO;
                  vpercentual          number;
                  vidunidadedenegocio  number;
                  vmd5                 varchar2(1000);
                  --
                begin
                  --
                  for uni in ( select *
                               from unidadesdenegocios u
                               where exists ( select 1
                                              from segmentosnegocios s
                                              where s.idsegmentonegocio = u.idsegmentonegocio 
                                                and s.tipo              = :P353_TIPOGRUPO ) )
                  loop
                    --
                    vidrateiocentrocusto := null;
                    vidunidadedenegocio  := uni.idunidadedenegocio;
                    --
                    pck_cadastros_rmc.prc_rateioscentroscustos( pidrateiocentrocusto => vidrateiocentrocusto,
                                                                pidcentrodecusto     => vidcentrodecusto,
                                                                ppercentual          => vpercentual,
                                                                pidunidadedenegocio  => vidunidadedenegocio,
                                                                pmd5                 => vmd5,
                                                                poperacao_dml        => 'I');
                    --
                  end loop;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Rateios de Unidades atualizado!
        }
        advanced {
            executionMappingIdentifier: 3201191190558213042
        }
        serverSideCondition {
            type: request=Value
            value: APLICAR_REPLICA
        }
    )

