page 198 (
    name: Entradas da Semana
    title: Entradas da Semana
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 80%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region entradas-da-semana (
        name: Entradas da Semana
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select E.Identrada
                     , e.semana
                     , e.data
                     , e.valortotal
                     , '<i>'||e.descricaoorigem||'</i> - '||e.descricao descricao
                     , e.idcontacontabil
                     , e.idsubcontacontabil
                from entradasdiversas e
                where e.idfechamento = :P198_IDFECHAMENTO
                  and e.idmovimentogeral is not null   
                union
                select nf.idnotafiscal
                     , f.semana
                     , nf.dtnf 
                     , nf.valortotal
                     , '<i>'||'Despesa referente a/o '||pck_romance.fnc_nomefornecedor(nf.idfornemitente)||'</i> - NRNF: '||nf.documento descricao
                     , null
                     , null
                from notasfiscais nf
                   , fechamentossemanais f
                where f.idfechamento = :P198_IDFECHAMENTO
                  and nf.idrazaosocialfildestino = 1381
                  and nf.tiponota                = 'D'
                  --and nf.idfornemitente          = 2231
                  and nf.idfilialdestino         = 1186
                  and nf.situacao                = 'A' 
                  and nf.idsemananota            = f.idsemana
                  and exists ( select 1
                               from rateiosnotasfiscais rn
                               where rn.idnotafiscal = nf.idnotafiscal
                                 and rn.idcontafinan in (302,289,273) )
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 2549126463608223564
        }

        column DATA (
            type: plainText
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: P
            }
        )

        column DESCRICAO (
            type: plainText
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: R
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDCONTACONTABIL (
            type: plainText
            heading {
                heading: Idcontacontabil
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: S
            }
        )

        column IDENTRADA (
            type: plainText
            heading {
                heading: Identrada
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: N
            }
        )

        column IDSUBCONTACONTABIL (
            type: plainText
            heading {
                heading: Idsubcontacontabil
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: T
            }
        )

        column SEMANA (
            type: plainText
            heading {
                heading: Semana
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: O
            }
        )

        column VALORTOTAL (
            type: plainText
            heading {
                heading: Valor
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: Q
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 25491399 (
            visibility: primaryDefault
            view {
                rowsPerPage: 1000
            }

            displayColumn DATA (
                sequence: 1
            )

            displayColumn DESCRICAO (
                sequence: 2
            )

            displayColumn VALORTOTAL (
                sequence: 3
            )

            aggregate (
                column: VALORTOTAL
            )

        )

    )

    pageItem P198_IDFECHAMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @entradas-da-semana
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

