page 402 (
    name: Acessos para Compras
    title: Acessos para Compras
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region cadastros-realizados (
        name: Cadastros Realizados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idcadastrocompra
                     , c.idfornecedor
                     , pck_romance.fnc_nomefornecedor(c.idfornecedor) fornecedores
                     , c.idfilial
                     , pck_romance.fnc_nomefilial(c.idfilial) empresa
                     , c.nomesite
                     , c.email
                     , c.senha
                from cadastroscompras c
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 5356971829390876802
        }

        column EMAIL (
            type: plainText
            heading {
                heading: Email
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column EMPRESA (
            type: plainText
            heading {
                heading: Empresa
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column FORNECEDORES (
            type: plainText
            heading {
                heading: Fornecedor
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column IDCADASTROCOMPRA (
            type: link
            heading {
                heading: Ver/Editar
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 403
                    items: {
                        P403_IDCADASTROCOMPRA: #IDCADASTROCOMPRA#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column IDFILIAL (
            type: hidden
            heading {
                heading: Idfilial
            }
            layout {
                sequence: 40
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDFORNECEDOR (
            type: hidden
            heading {
                heading: Idfornecedor
            }
            layout {
                sequence: 20
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NOMESITE (
            type: plainText
            heading {
                heading: Site
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column SENHA (
            type: plainText
            heading {
                heading: Senha
                alignment: center
            }
            layout {
                sequence: 80
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 53569852 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn EMAIL (
                sequence: 7
            )

            displayColumn EMPRESA (
                sequence: 5
            )

            displayColumn FORNECEDORES (
                sequence: 3
            )

            displayColumn IDCADASTROCOMPRA (
                sequence: 1
            )

            displayColumn IDFILIAL (
                sequence: 4
            )

            displayColumn IDFORNECEDOR (
                sequence: 2
            )

            displayColumn NOMESITE (
                sequence: 6
            )

            displayColumn SENHA (
                sequence: 8
            )

        )

    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 403
                items: {
                    P403_IDCADASTROCOMPRA:
                    P403_EMAIL:
                    P403_IDFILIAL:
                    P403_IDFORNECEDOR:
                    P403_MD5:
                    P403_NOMESITE:
                    P403_SENHA:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

