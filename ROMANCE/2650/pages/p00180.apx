page 180 (
    name: Finalizando Fechamento
    title: Finalizando Fechamento
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function enviaemail() 
            {
               javascript:window.open("http://www.atacadofavorita.com.br/romance/sendmailfech.php?gerente="+document.getElementById('P180_USUARIO').value+
                                                                                                 "&semana="+document.getElementById('P180_SEMANA').value+
                                                                                                 "&cobranca="+document.getElementById('P180_TOTALCOBRANCA').value+
                                                                                                 "&gaveta="+document.getElementById('P180_TOTALGAVETA').value ,'MAIL','toolbar=no,location=no,status=no,menubar=yes,scrollbars=no,resizable=no,width=2,height=2,left=400,top=400','_blank'); void(0);  		
            apex.submit('ENVIAR_PARA_ROMANCE');
               
            }
            ```
    }
    headerAndFooter {
        footerText: <script language="Javascript"> enviaemai2l();</script>
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region finalizando-fechamento (
        name: Finalizando Fechamento
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
    )

    pageItem P180_IDFECHAMENTO (
        type: numberField
        label {
            label: Idfechamento
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 50
            region: @finalizando-fechamento
            slot: regionBody
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 4000
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P180_SEMANA (
        type: textField
