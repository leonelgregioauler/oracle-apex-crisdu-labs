page 148 (
    name: Formas Pagamentos
    title: Formas Pagamentos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region formas-de-pagamento (
        name: Formas de Pagamento
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idformapagamento
                     , descricao
                     , ( select listagg(pck_romance.fnc_nomeusuario(usuario),' ') within group (order by 1)
                         from usuariosformaspagamentos p
                            , usuarios u
                         where p.idformapagamento = f.idformapagamento 
                           and p.idusuario        = u.idusuario)  usuarios
                from formaspagamentos f
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: A tela de Faturas irá aparecer de acordo com o que for liberado para os usuários nesta tela.
        }
        link {
            linkColumn: customTarget
            target: {
                page: 149
                items: {
                    P149_IDFORMAPAGAMENTO: #IDFORMAPAGAMENTO#
                }
                action: resetPagination
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1274193070956386309
        }

        column DESCRICAO (
            type: plainText
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column IDFORMAPAGAMENTO (
            type: plainText
            heading {
                heading: Código
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column USUARIOS (
            type: plainText
            heading {
                heading: Usuarios
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 12764858 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DESCRICAO (
                sequence: 2
            )

            displayColumn IDFORMAPAGAMENTO (
                sequence: 1
            )

            displayColumn USUARIOS (
                sequence: 3
            )

        )

    )

)

