page 393 (
    name: "Rateios Pendentes "
    title: "Rateios Pendentes "
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 50%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region rateios-pendentes-de-lançamentos (
        name: Rateios Pendentes de Lançamentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select l.idlancamentodiverso
                     , l.fornecedor
                     , l.empresa
                     , l.formapagamento
                     , l.datavencimento
                     , nvl( ( select sum(rn.valor)
                              from rateiosnotasfiscais rn
                              where rn.idlancamentodiverso = l.idlancamentodiverso ) ,0) valortotal
                     , l.usuario
                     , l.data
                from vw_lancamentosdiversos l
                where exists ( select 1
                               from rateiosnotasfiscais rn
                               where rn.idlancamentodiverso = l.idlancamentodiverso
                                 and rn.idnotafiscal is null )
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 82239681954270549
        }

        column DATA (
            type: plainText
            heading {
                heading: Data Criação
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: H
            }
        )

        column DATAVENCIMENTO (
            type: plainText
            heading {
                heading: Data do Vencimento
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: E
            }
        )

        column EMPRESA (
            type: plainText
            heading {
                heading: Destino
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column FORMAPAGAMENTO (
            type: plainText
            heading {
                heading: Forma de Pgto
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column FORNECEDOR (
            type: plainText
            heading {
                heading: Fornecedor
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column IDLANCAMENTODIVERSO (
            type: link
            heading {
                heading: Rever Lançamento
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 374
                    items: {
                        P374_IDLANCAMENTODIVERSO: #IDLANCAMENTODIVERSO#
                        P374_PAGINA: 393
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-view.png" class="apex-edit-view" alt="">
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column USUARIO (
            type: plainText
            heading {
                heading: Feito Por
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column VALORTOTAL (
            type: plainText
            heading {
                heading: Valor Total
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        savedReport 881207 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATA (
                sequence: 8
            )

            displayColumn DATAVENCIMENTO (
                sequence: 5
            )

            displayColumn EMPRESA (
                sequence: 3
            )

            displayColumn FORMAPAGAMENTO (
                sequence: 4
            )

            displayColumn FORNECEDOR (
                sequence: 2
            )

            displayColumn IDLANCAMENTODIVERSO (
                sequence: 1
            )

            displayColumn USUARIO (
                sequence: 7
            )

            displayColumn VALORTOTAL (
                sequence: 6
            )

        )

    )

)

