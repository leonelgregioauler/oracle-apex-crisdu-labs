            maxLength: 20
        }
        source {
            type: databaseColumn
            databaseColumn: USUARIO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @histórico-de-ligações
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 270
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 40
            region: @histórico-de-ligações
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P272_IDHISTORICOLIGACOES
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @histórico-de-ligações
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P272_IDHISTORICOLIGACOES
        }
    )

    process fetch-row-from-historicoligacoes (
        name: Fetch Row from HISTORICOLIGACOES
        type: autoRowFetch
        source {
            tableName: HISTORICOLIGACOES
            pkColumn: IDHISTORICOLIGACOES
            pkItem: P272_IDHISTORICOLIGACOES
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 527265702089797690
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P272_IDHISTORICOLIGACOES is null then
                        select "SEQ_IDHISTORICOLIG".nextval
                          into :P272_IDHISTORICOLIGACOES
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 527265927113797691
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-historicoligacoes (
        name: Process Row of HISTORICOLIGACOES
        type: autoRowProcessing
        target {
            tableName: HISTORICOLIGACOES
            pkColumn: IDHISTORICOLIGACOES
            pkItem: P272_IDHISTORICOLIGACOES
            supportedOperations: [
                insert
                update
            ]
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 527266125650797691
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 527266319925797692
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 270
            }
        }
    )

)

