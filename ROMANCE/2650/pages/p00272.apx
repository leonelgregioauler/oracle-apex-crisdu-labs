page 272 (
    name: Histórico de Ligações
    title: Histórico de Ligações
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region histórico-de-ligações (
        name: Histórico de Ligações
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P272_DATA (
        type: datePickerJquery
        label {
            label: Data
            alignment: right
        }
        layout {
            sequence: 30
            region: @histórico-de-ligações
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: DATA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P272_IDCONTROLELIGACOES (
        type: hidden
        layout {
            sequence: 20
            region: @histórico-de-ligações
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDCONTROLELIGACOES
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P272_IDHISTORICOLIGACOES (
