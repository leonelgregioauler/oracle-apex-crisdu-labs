        layout {
            sequence: 10
            region: @histórico-de-ligações
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDHISTORICOLIGACOES
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P272_OBSERVACAO (
        type: textarea
        label {
            label: Observacao
            alignment: right
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 50
            region: @histórico-de-ligações
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 500
        }
        source {
            type: databaseColumn
            databaseColumn: OBSERVACAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P272_USUARIO (
        type: textField
