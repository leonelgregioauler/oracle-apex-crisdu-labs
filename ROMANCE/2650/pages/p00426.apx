page 426 (
    name: Detalhamento Investimentos
    title: Detalhamento Investimentos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 50%
        resizable: false
    }
    css {
        inline: ".t-Region-body { background-color: Beige !important;}"
    }
    security {
        pageAccessProtection: unrestricted
    }

    region despesas (
        name: Despesas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select dm.id
                     , dm.data
                     , dm.valor
                     , dm.conta
                     , dm.origem||'(NF: '||( select nf.documento
                                             from notasfiscais nf
                                             where nf.idnotafiscal = dm.idnotafiscal )||')' origem
                     , dm.subconta
                from vw_despesascentroscustos_m dm
                where dm.idunidadedenegocio = :P426_IDUNIDADE
                  and dm.mes = :P426_MES
                  and dm.ano = :P426_ANO
                  and not exists ( select 1
                                   from rateioscentroscustos rr
                                   where rr.idcentrodecusto = dm.idcentrodecusto
                                     and rr.percentual is not null )
                union
                select dm.id
                     , dm.data
                     , round(r.percentual * dm.valor / 100,2) valor
                     , dm.conta
                     , dm.origem
                     , dm.subconta
                from vw_despesascentroscustos_m dm
                   , vw_rateioscentroscustos r
                where r.idcentrodecusto = dm.idcentrodecusto
                  and r.idunidadedenegocio = :P426_IDUNIDADE
                  and r.percentual > 0
                  and dm.mes between r.mesinicial and r.mesfinal
                  and r.vigencia = dm.ano
                  and r.tipo = 'M'
                  and r.contabilizadespesa = 'S'
                  and dm.mes = :P426_MES
                  and dm.ano = :P426_ANO
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P426_TIPO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 391169450953938114
        }

