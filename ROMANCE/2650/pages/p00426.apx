    region receitas (
        name: Receitas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.tipomovimentacao
                     , sum(r.valor) valores
                from vw_receitascentroscustos_m r
                where r.idunidadedenegocio = :P426_IDUNIDADE
                  and r.ano = :P426_ANO 
                  and r.idmes = :P426_MES
                group by r.tipomovimentacao
                ```
        }
        layout {
