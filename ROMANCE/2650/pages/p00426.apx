    region rateios (
        name: Rateios
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select dm.data
                     , sum(round(r.percentual * dm.valor / 100,2)) valor
                     , dm.conta
                     , dm.origem
                     , dm.subconta
                     , ( select nf.documento
                         from notasfiscais nf
                         where nf.idnotafiscal = dm.idnotafiscal ) documento
                     , dm.centrodecusto 
                from vw_despesascentroscustos_m dm
                   , vw_rateioscentroscustos r
                where r.idcentrodecusto = dm.idcentrodecusto
                  and r.idunidadedenegocio = :P426_IDUNIDADE
                  and r.percentual > 0
                  and dm.mes between r.mesinicial and r.mesfinal
                  and r.vigencia = dm.ano
                  and r.tipo = 'M'
                  and r.contabilizarateio = 'S'
                  and dm.mes = :P426_MES
                  and dm.ano = :P426_ANO
                group by dm.idnotafiscal
                     , dm.data
                     , dm.conta
                     , dm.origem
                     , dm.subconta
                     , dm.centrodecusto 
                ```
        }
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
