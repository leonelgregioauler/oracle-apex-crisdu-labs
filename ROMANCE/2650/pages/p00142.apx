    region pagamentos (
        name: Pagamentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct to_char(pagforn.dtvencimento,'IW') Semana
                     , initcap(pes.apelido||' ('||cid.nomecidade)||'-'||e.sigla||')' Fornecedor
                     , pagforn.dtvencimento
                     , forn.IDFORNECEDOR
                     , ( select nvl(n.documento,n.nrnf) from notasfiscais n where n.idnotafiscal = pagforn.idnotafiscal) numeronota
                     , decode(pagforn.tipo, 'D','Depósito'
                                          , 'R','Resgate'
                                          , 'F','Fornecedor') Tipo
                     , initcap(nvl(contbanc.beneficiario,pes.apelido)||'('||contbanc.nomebanco)||' - '||contbanc.agencia ||', '||contbanc.conta||')' contabanc
                     , to_char(sum(pagforn.valorpagar),'999G999G990D00') ValorPagar
                     , to_char(sum(pagforn.valorpago),'999G999G990D00') ValorPago
                     , to_char(sum(pagforn.valorpago) - sum(pagforn.valorpagar),'999G999G990D00') Saldo
                from pagamentosfornecedores pagforn
                   , pessoas         pes
                   , cidades         cid
                   , estados         e
                   , fornecedores      forn
                   , ( select cb.beneficiario
                            , b.nomebanco
                            , cb.agencia 
                            , cb.conta
                            , idcontabanc
                       from contasbancarias cb
                          , bancos b
                       where cb.idbanco         = b.idbanco ) contbanc
                where forn.idpessoa       = pes.idpessoa
                  and pes.idcidade        = cid.idcidade
                  and cid.idestado        = e.idestado
                  and forn.idfornecedor   = pagforn.idfornecedor   
                  and pagforn.idcontabanc  = contbanc.idcontabanc  (+)  
                  and pagforn.idpgtoforn  = :P142_IDPGTOFORN
                group by to_char(pagforn.dtlancamento,'IW') 
                     , initcap(pes.apelido||' ('||cid.nomecidade)||'-'||e.sigla||')'
                     , pagforn.dtvencimento
                     , forn.IDFORNECEDOR
                     , pagforn.tipo
                     ,  initcap(nvl(contbanc.beneficiario,pes.apelido)||'('||contbanc.nomebanco)||' - '||contbanc.agencia ||', '||contbanc.conta||')'
                     ,pagforn.idnotafiscal
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        componentAppearance {
            showNullValuesAs: -
        }
