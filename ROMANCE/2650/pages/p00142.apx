    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @efetuar-depósitos
        target {
            tableName: DEPOSITOSDIARIOS
            pkColumn: IDDEPOSITODIARIOS
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRI_COUNT# depósito(s) efetuado(s).
