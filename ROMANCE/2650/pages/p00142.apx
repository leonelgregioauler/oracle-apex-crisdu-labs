page 142 (
    name: Faturas Fábrica - Pagamentos
    title: Faturas Fábrica - Pagamentos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region depóstos-efetuados (
        name: Depóstos Efetuados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                "IDDEPOSITODIARIOS",
                "IDDEPOSITODIARIOS" IDDEPOSITODIARIOS_DISPLAY,
                "DATA",
                "IDREPRESENTANTE",
                "IDCONTABANC",
                "IDPGTOFORN",
                "VALORDEPOSITO",
                decode(COMPROVADO,'S','Sem Comprovante'
                                     ,'C','Cópia'
                                     ,'M','Em Mãos') "COMPROVADO",
                 "NROCOMPROVANTE",
                 "NROENVELOPE",
                "OBSERVACAO",
                decode(TIPO,'DD','Dinheiro'
                                     ,'CC','Cheque'
                                     ,'CD','Cheque Pré Depósito'
                                     ,'CR','Cheque Pré Resgate'
                                     ,'M','Em Mãos') "TIPO",
                "IDCHEQUE",
                "IDPGTOFORN_ORIG",
                "IDDEPOSITODIARIOS_ORIG"
                , referentea
                , valororiginal
                , destinosaldo "Destino do saldo"
                from "#OWNER#"."DEPOSITOSDIARIOS"
                where IDPGTOFORN = :p142_IDPGTOFORN
                order by 3
                ```
        }
        layout {
            sequence: 25
            parentRegion: @pagamentos
            slot: subRegions
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 80
        }
        componentAppearance {
            template: @/search-results
            templateOptions: #DEFAULT#
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhum depósito efetuado.
        }
        componentAdvanced {
            stripHtml: true
        }

        column COMPROVADO (
            reportColumnQueryId: 8
            derivedColumn: N
            type: displayAsTextSavesState
            heading {
                heading: Comprovado
            }
