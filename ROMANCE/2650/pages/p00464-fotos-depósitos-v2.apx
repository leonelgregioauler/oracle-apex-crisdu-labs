    process considerar-cálculo (
        name: Considerar Cálculo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- não deve assinalar todos os comprovantes ao selecionar uma solicitação
                update roman.depositosdiarios_leituraocr ocr
                set considerar_calculo = 'S'
                where idrepresentante = :P464_IDREPRESENTANTE
                and iddepositodiario is null
                and exists ( select 1 from comprovantes comp where comp.idcomprovante = ocr.idcomprovante );
