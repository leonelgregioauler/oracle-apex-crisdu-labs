    region fotos-recebidas (
        name: Fotos Recebidas
        type: themeTemplateComponent/mediaList
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(d.idrepresentante)||' - '||roman.pck_romance.fnc_nomefilial(d.idfilial) as distribuidor
                     , count(1)          as qtdfotos
                     , (select min(dd.dataleitura) from roman.depositosdiarios_leituraocr dd where dd.idrepresentante = d.idrepresentante) as menor_data_leitura_do_distribuidor
                     , d.idrepresentante 
                  from roman.depositosdiarios_leituraocr d
                 where (d.iddepositodiario is null or (:P464_IDREPRESENTANTE_FILTRO is not null and d.idrepresentante = :P464_IDREPRESENTANTE_FILTRO))
                   and exists ( select 1 from comprovantes comp where comp.idcomprovante = d.idcomprovante )
                   and ( :P464_IDFILIAL is null or d.idfilial = :P464_IDFILIAL)
                   and ( (:P464_DATA_INICIAL is null and :P464_DATA_FINAL is null) or (trunc(dataleitura) between to_date(:P464_DATA_INICIAL, 'dd/mm/rrrr') and to_date(:P464_DATA_FINAL, 'dd/mm/rrrr') ) )
                   and (   ( nvl(:P464_FILTRO,'T') = 'T')
                        or ( :P464_FILTRO = 'A' and d.usuariorevisao is null )
                        or ( :P464_FILTRO = 'R' and d.usuariorevisao is not null ) )
                 group by d.idrepresentante, d.idfilial
                
                
                 /*
                
                    Maicon Aimi - 26/03/2025 - 10054472
                    substituido a query a baixo pela query de cima!!
                
                select pck_romance.fnc_nomerepresentante(d.idrepresentante)||' - '||pck_romance.fnc_nomefilial(d.idfilial)  distribuidor
                     , count(1) qtdfotos                                  
                     , d.idrepresentante
                     , d.dataleitura
                from depositosdiarios_leituraocr d
                where iddepositodiario is null
                  and (:P464_IDFILIAL is null or d.idfilial = :P464_IDFILIAL)
                  and ( nvl(:P464_FILTRO,'T') = 'T' or ( :P464_FILTRO = 'A' and d.usuariorevisao is null )
                                           or ( :P464_FILTRO = 'R' and d.usuariorevisao is not null ) )
                group by idrepresentante, d.idfilial , d.dataleitura
                union all
                select distinct pck_romance.fnc_nomerepresentante(d.idrepresentante)||' - '||pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(idrepresentante))  distribuidor
                     , ( select count(1)                                         
                         from depositosdiarios_leituraocr dd  
                         where dd.idrepresentante = d.idrepresentante
                           and dd.iddepositodiario is null  ) qtdfotos                                  
                     , d.idrepresentante  
                     , d.data  
                from depositosdiarios_orig d
                where d.valordeposito != nvl(( select sum(dd.valor_digitado)
                                             from depositosdiarios_leituraocr dd  
                                             where dd.idrepresentante = d.idrepresentante
                                               and dd.iddepositodiario is null  ) ,0)
                  and exists ( select 1
                               from depositosdiarios_leituraocr dd  
                               where dd.idrepresentante = d.idrepresentante
                                 and dd.iddepositodiario is null  ) 
                  and not exists ( select 1 from depositosdiarios ddd where ddd.iddepositodiarios = d.iddepositodiarios )                 
                  and d.comprovado != 'M'                            
                  and not exists ( select 1
                               from depositosdiarios_leituraocr dd  
                               where dd.iddepositodiario = d.iddepositodiarios ) 
                  and :P464_FILTRO = 'V'
                  order by 4
                
                  */
                ```
            pageItemsToSubmit: P464_IDFILIAL
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        accessibility {
            landmarkType: region
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            display: report
        }
        settings {
            title: QTDFOTOS
            description: DISTRIBUIDOR
            displayBadge: true
            layout: horizontalSpan
            size: large
            applyThemeColors: false
        }
        plugin-badge {
            label: &DISTRIBUIDOR.
            value: QTDFOTOS
            style: subtle
            shape: square
        }

        column DISTRIBUIDOR (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: DISTRIBUIDOR
                dataType: varchar2
            }
        )

        column IDREPRESENTANTE (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDREPRESENTANTE
                dataType: number
            }
        )

        column MENOR_DATA_LEITURA_DO_DISTRIBUIDOR (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: MENOR_DATA_LEITURA_DO_DISTRIBUIDOR
                dataType: date
            }
        )

        column QTDFOTOS (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: QTDFOTOS
                dataType: number
            }
        )

        action action (
            position: link
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 464
                    items: {
                        P464_IDREPRESENTANTE: &IDREPRESENTANTE.
                        P464_IDDEPOSITODIARIO:
                    }
