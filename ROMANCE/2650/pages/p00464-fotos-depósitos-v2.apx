    process corrigir (
        name: Corrigir
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vvalorinformado  number(15,2);
                  valordepositoori number(15,2);
                  verro            varchar2(4000);
                  --
                begin
                  -- 
                  update DEPOSITOSDIARIOS_LEITURAOCR   s
                  set iddepositodiario = :P464_IDDEPOSITODIARIO
                    , idrequisicao = :P464_IDREQUISICAO -- TROCA O IDREQUISICAO PARA QUANDO VINCULAM O COMPROVANTE A OUTRA SOLICITAÇÃO
                    , s.datarevisao    = sysdate
                    , s.usuariorevisao = v('APP_USER')
                  where iddepositodiario is null
                    and s.valor_digitado is not null       
                    and idrepresentante = :P464_IDREPRESENTANTE
                    ---and s.iddepositodiario = :P464_IDDEPOSITODIARIO
                    and s.considerar_calculo = 'S'
                    and not exists ( select 1 from comprovantes c where c.idcomprovante = s.idcomprovante and statuscomprovante = 'R')
                  returning sum(valor_digitado)
                  into vvalorinformado ;
                  --
                  select d.valordeposito
                  into valordepositoori
                  from depositosdiarios_orig d
                  where d.iddepositodiarios = :P464_IDDEPOSITODIARIO;
                  --
                  if valordepositoori != vvalorinformado then
                    --
                    execute immediate 'alter table DEPOSITOSDIARIOS_LEITURAOCR disable constraint DK_DEPDIA_OCR_DEPDIA';
                    --
                    pck_financeiro_rmc.prc_alteravalordeposito(piddepositodiario => :P464_IDDEPOSITODIARIO,
                                                               pvalordeposito    => vvalorinformado,
                                                               ppagina           => 464);
                    --
                    execute immediate 'alter table DEPOSITOSDIARIOS_LEITURAOCR enable constraint DK_DEPDIA_OCR_DEPDIA';
                    --
                  end if;
                  --
                  update DEPOSITOSDIARIOS_ORIG
                  set idstatus = 3
                    , comprovado = 'M'
                    , idrequisicao = :P464_IDREQUISICAO   -- TROCA O IDREQUISICAO PARA QUANDO VINCULAM O COMPROVANTE A OUTRA SOLICITAÇÃO
                  where iddepositodiarios = :P464_IDDEPOSITODIARIO;
                  --
                  update comprovantes
                  set statuscomprovante = 'C'
                  where iddepositosdiarios = :P464_IDDEPOSITODIARIO
                  and statuscomprovante != 'R';
                  --
                  update depositosdiarios
                  set comprovado = 'M'
                  where iddepositodiarios = :P464_IDDEPOSITODIARIO;
                  --
                  commit;
                  --
                  roman.pck_auditoria_solicitacoes.prc_registrar_etapa(
                    pidprocesso           => :P464_IDDEPOSITODIARIO,
                    pidetapa              => 4,
                    pdescricao_tecnica    => 'UPDATE DEPOSITOSDIARIOS_LEITURAOCR e DEPOSITOSDIARIOS_ORIG ; IDREQUISICAO=' || :P464_IDDEPOSITODIARIO,
                    pdescricao_financeiro => 'Financeiro confirmou a revisão da solicitação.',
                    pidrepresentante      => :P464_IDREPRESENTANTE,
                    porigem               => v('APP_USER')
                  );
                
                exception
                  when others then
                    --
                    begin
                      --
                      update depositosdiarios_leituraocr   s
                      set iddepositodiario = :P464_IDDEPOSITODIARIO
                        , idrequisicao = :P464_IDREQUISICAO -- TROCA O IDREQUISICAO PARA QUANDO VINCULAM O COMPROVANTE A OUTRA SOLICITAÇÃO
                        , s.datarevisao    = sysdate
                        , s.usuariorevisao = v('APP_USER')
                      where iddepositodiario is null
                        and s.valor_digitado is not null
                        and idrepresentante = :P464_IDREPRESENTANTE
                        --and s.iddepositodiario = :P464_IDDEPOSITODIARIO
                        and s.considerar_calculo = 'S'
                        and not exists ( select 1 from comprovantes c where c.idcomprovante = s.idcomprovante and statuscomprovante = 'R')
                      returning sum(valor_digitado)
                      into vvalorinformado ;
                      --
                      select d.valordeposito
                      into valordepositoori
                      from depositosdiarios_orig d
                      where d.iddepositodiarios = :P464_IDDEPOSITODIARIO;
                      --
                      if valordepositoori != vvalorinformado then
                        --
                        execute immediate 'alter table DEPOSITOSDIARIOS_LEITURAOCR disable constraint DK_DEPDIA_OCR_DEPDIA';
                        --
                        pck_financeiro_rmc.prc_alteravalordeposito(piddepositodiario => :P464_IDDEPOSITODIARIO,
                                                                   pvalordeposito    => vvalorinformado,
                                                                   ppagina           => 464);
                        --
                        execute immediate 'alter table DEPOSITOSDIARIOS_LEITURAOCR enable constraint DK_DEPDIA_OCR_DEPDIA';
                        --
                      end if;
                      --  
                      update depositosdiarios_orig
                      set idstatus = 3
                        , comprovado = 'M'
                        , idrequisicao = :P464_IDREQUISICAO -- TROCA O IDREQUISICAO PARA QUANDO VINCULAM O COMPROVANTE A OUTRA SOLICITAÇÃO
                      where iddepositodiarios = :P464_IDDEPOSITODIARIO;
                      --
                      update comprovantes
                      set statuscomprovante = 'C'
                      where iddepositosdiarios = :P464_IDDEPOSITODIARIO
                      and statuscomprovante != 'R';
                      --
                      update depositosdiarios
                      set comprovado = 'M'
                      where iddepositodiarios = :P464_IDDEPOSITODIARIO;
                      --
                      commit;
                      --
                    exception
                      when others then
                        --
                        verro := sqlerrm;
                        --
                        insert into chamados ( idchamado
                                             , dataabertura
                                             , usuario
                                             , titulo
                                             , descricao 
                                             , idgrupoatendimento )
                        values ( seq_idchamado.nextval
                               , sysdate
                               , v('APP_USER')
                               , 'Erro na revisao de fotos de depositos'
                               , 'Deposito de nr: '||:P464_IDDEPOSITODIARIO||' apresentou o erro: '||verro
                               , 0 );
                        --
                        commit;                     
                        --
                    end;
                    --
                end;
                
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 46408289641903393
        }
        serverSideCondition {
            type: request=Value
            value: CORRIGIR
        }
    )

