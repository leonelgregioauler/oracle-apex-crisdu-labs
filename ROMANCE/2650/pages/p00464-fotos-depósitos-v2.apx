    region lista-comprovantes (
        name: Lista Comprovantes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select apex_item.CHECKBOX2(2,c.idleituraocr_deposito, null) as check_1
                     , c.idleituraocr_deposito                              as "ID Comprovante"
                     , c.dataleitura                                        as "Data Leitura"
                     , c.valor                                              as "Valor"
                     , c.banco                                              as "Banco"
                     , c.nroidentificacao                                   as "Identificação"
                     , decode(c.pix,'S','Sim','Não')                        as "Pix"
                     , decode(c.transferencia,'S','Sim','Não')              as "Transferência"
                  from roman.depositosdiarios_leituraocr c
                 where idrepresentante = :P464_IDREPRESENTANTE
                   and iddepositodiario is null
                   and (  ( :P464_IDDEPOSITODIARIO is not null)
                       or ( :P464_IDDEPOSITODIARIO is null and not exists ( select 1 
                                                                              from roman.depositosdiarios_orig d
                                                                             where comprovado = 'S'
                                                                               and d.idrepresentante = c.idrepresentante
                                                                               and idrepresentante = :P464_IDREPRESENTANTE)))
                 order by 1;
                ```
        }
        layout {
            sequence: 10
            parentRegion: @deletar-comprovante-duplicado
            slot: subRegions
        }
