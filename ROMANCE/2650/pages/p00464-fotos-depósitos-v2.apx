    region fotos-enviadas (
        name: Fotos Enviadas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idleituraocr_deposito
                     , iddepositodiario
                     , usuario
                     , dataleitura
                     , datadeposito
                     , idbanco
                     , nomearquivo
                     , idfilial
                     , idrepresentante 
                     , nroidentificacao_digitado
                     , considerar_calculo
                     , transferencia
                     , pix
                     , ( select urlcomprovante
                         from comprovantes comp
                         where comp.idcomprovante = c.idcomprovante) urlcomprovante
                     , valor_digitado valor_comprovante
                     , idcomprovante
                     , ( select dd.observacao
                         from depositosdiarios_orig dd
                         where dd.idrequisicao = c.idrequisicao ) observacaosolicitacao
                     , ( select oc.textoobservacao
                         from   roman.observacoescomprovante oc
                         where  oc.idleituraocr_deposito = c.idleituraocr_deposito
                         order  by oc.datahoraregistro desc
                         FETCH  FIRST 1 ROWS ONLY ) observacaocomprovante
                     , case when ( select statuscomprovante 
                                   from comprovantes co
                                   where co.idcomprovante = c.idcomprovante ) = 'R' then 'desabilitar'
                       else
                            null
                       end classe_comprovante_reprovado
                     , case when ( select statuscomprovante 
                                   from comprovantes co
                                   where co.idcomprovante = c.idcomprovante ) = 'R' then true
                       else
                            false
                       end comprovante_reprovado
                from depositosdiarios_leituraocr c
                where idrepresentante = :P464_IDREPRESENTANTE
                  and exists ( select 1 from comprovantes comp where comp.idcomprovante = c.idcomprovante )
                  and ( (:P464_DATA_INICIAL is null and :P464_DATA_FINAL is null) or (trunc(dataleitura) between to_date(:P464_DATA_INICIAL, 'dd/mm/rrrr') and to_date(:P464_DATA_FINAL, 'dd/mm/rrrr') ) )
                  and iddepositodiario is null
                ```
        }
        layout {
            sequence: 110
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        advanced {
            htmlDomId: FOTOS_ENVIADAS
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config) {
                
                  var $ = apex.jQuery;
                
                  var toolbarData = $.apex.interactiveGrid.copyDefaultToolbar();
                
                  toolbarData.toolbarFind("actions1").controls.push({
                    type: "BUTTON",
                    action: "save-grid",
                    cssClasses: "t-Button--hot"
                  });
                
                  config.initActions = function(actions) {
                    actions.add({
                      name: "save-grid",
                      label: "Salvar",
                      action: function(event, focusElement) {
                
                        apex.submit();
                
                        apex.message.showPageSuccess("Registro Salvo.");
                      }
                    });
                  };
                
                  config.toolbarData = toolbarData;
                
                  return config;
                }
                ```
        }
        advanced {
            savedReportMappingIdentifier: 89589775489843083
        }

