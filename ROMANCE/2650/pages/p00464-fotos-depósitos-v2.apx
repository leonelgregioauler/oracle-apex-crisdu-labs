    dynamicAction selecionar-comprovante-do-depósito (
        name: Selecionar comprovante do Depósito
        execution {
            sequence: 80
            eventScope: dynamic
        }
        when {
            event: region/interactiveGrid/interactivegridselectionchange
            selectionType: region
            region: @fotos-enviadas
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    const element = document.querySelector('body');
                    
                    async function toggleClasses() {
                        const actionContent = document.querySelector('.t-Body-actionsContent');
                        const actionToggle = document.querySelector('.t-Body-actionsToggle');
                    
                        await new Promise(resolve => setTimeout(resolve, 1000))
                    
                        const cardView = actionContent.querySelector('.a-CardView')
                    
                        if (element.classList.contains('js-rightCollapsed') && cardView && cardView.classList.contains('has-media')) {
                            element.classList.remove('js-rightCollapsed');
                            element.classList.add('js-rightExpanded');
                            actionToggle.classList.add('is-active');
                            actionContent.style.visibility = 'inherit';
                            // } else {
                            //     element.classList.add('js-rightCollapsed');
                            //     element.classList.remove('js-rightExpanded');
                            //     actionToggle.classList.remove('is-active');
                            //     actionContent.style.visibility = '';
                        } else if (element.classList.contains('js-rightExpanded') && (!cardView || !cardView.classList.contains('has-media'))) {
                            element.classList.add('js-rightCollapsed');
                            element.classList.remove('js-rightExpanded');
                            actionToggle.classList.remove('is-active');
                            actionContent.style.visibility = '';
                        }
                    }
                    
                    toggleClasses();
                    
                    
                    let ig = apex.region("FOTOS_ENVIADAS").widget();
                    let view = ig.interactiveGrid("getViews", "grid");
                    let model = view.model;
                    let selected = view.getSelectedRecords();
                    let uRLBucketComprovantes = 'https://objectstorage.sa-vinhedo-1.oraclecloud.com/n/axt4gfpg90i6/b/bucket-comprovantes/o/';
                    
                    if (selected.length > 0) {
                        let fileName = model.getValue(selected[0], "NOMEARQUIVO");
                        let idLeituraOCRExcluir = model.getValue(selected[0], "IDLEITURAOCR_DEPOSITO");
                        let idComprovante = model.getValue(selected[0], "IDCOMPROVANTE");
                    
                        // debugger;
                    
                        apex.item("P464_URL_BUCKET_COMPROVANTE").setValue(`${uRLBucketComprovantes}${fileName}`);
                        apex.item("P464_IDLEITURAOCR_EXCLUIR").setValue(idLeituraOCRExcluir);
                        apex.item("P464_IDCOMPROVANTE").setValue(idComprovante);
                    }
                    
                    
                    
                    ```
            }
            affectedElements {
                selectionType: items
                items: [
                    P464_URL_BUCKET_COMPROVANTE
                    P464_IDLEITURAOCR_EXCLUIR
                    P464_IDCOMPROVANTE
                    P464_IDDEPOSITODIARIO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (function () {
                        var REGION_ID = "FOTOS_ENVIADAS";
                        var ALVO_ID   = "P464_DEP_INFORMADO_VALOR";
                    
                        function getRegion() {
                            try { return apex.region(REGION_ID); } catch (e) { return null; }
                        }
                    
                        function getModel() {
                            try {
                                var view = getRegion().widget().interactiveGrid("getViews", "grid");
                                return (view && view.model) ? view.model : null;
                            } catch (e) { return null; }
                        }
                    
                        function fmt(v) {
                            return (v || 0).toLocaleString("pt-BR", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        }
                    
                        function toNumber(v) {
                            if (v === null || v === undefined || v === "") { return 0; }
                            if (typeof v === "number") { return v; }
                            var s = String(v).trim().replace(/\s|R\$/g, "");
                            if (s.indexOf(",") > -1) { s = s.replace(/\./g, "").replace(",", "."); }
                            var n = parseFloat(s);
                            return isNaN(n) ? 0 : n;
                        }
                    
                        function isReprovado(model, record) {
                            var r = model.getValue(record, "COMPROVANTE_REPROVADO");
                            return (r === true || r === "true" || r === "Y" || r === "S");
                        }
                    
                        function recalcular() {
                            var model = getModel();
                            if (!model) { return; }
                            var alvo = document.getElementById(ALVO_ID);
                            if (!alvo) { return; }
                            var total = 0;
                            model.forEach(function (record) {
                                if (model.getValue(record, "CONSIDERAR_CALCULO") === "S" && !isReprovado(model, record)) {
                                    total += toNumber(model.getValue(record, "VALOR_COMPROVANTE"));
                                }
                            });
                            alvo.textContent = "R$ " + fmt(total);
                        }
                    
                        var region = getRegion();
                        if (!region) { return; }
                        var cont = region.element[0];
                    
                        if (cont && !cont._depInformadoBound) {
                            cont._depInformadoBound = true;
                            cont.addEventListener("change", function (e) {
                                if (e.target && e.target.type === "checkbox") { setTimeout(recalcular, 0); }
                            }, true);
                            cont.addEventListener("click", function (e) {
                                if (e.target && e.target.type === "checkbox") { setTimeout(recalcular, 0); }
                            }, true);
                        }
                    
                        setTimeout(recalcular, 300);
                        setTimeout(recalcular, 1200);
                    })();
                    ```
            }
            execution {
                sequence: 30
            }
        )

        action native-refresh (
            action: refresh
            settings {
                maintainPagination: true
            }
            affectedElements {
                selectionType: region
                region: @comprovante-cards
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: null
                itemsToSubmit: [
                    P464_URL_BUCKET_COMPROVANTE
                    P464_IDLEITURAOCR_EXCLUIR
                    P464_IDCOMPROVANTE
                ]
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: items
                items: [
                    P464_URL_BUCKET_COMPROVANTE
                    P464_IDLEITURAOCR_EXCLUIR
                    P464_IDCOMPROVANTE
                ]
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction valores-diferente-exige-confirmação (
        name: Valores Diferente Exige Confirmação
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @corrigir
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                    vValorDepositoSelecionado number;
                    vValorDepósitoInformado   number;
                begin
                
                    
                    /*Valor Selecionado*/
                    begin
                        select valordeposito
                          into vValorDepositoSelecionado
                          from depositosdiarios_orig d
                         where d.iddepositodiarios = :P464_IDDEPOSITODIARIO;
                    exception
                        when others then
                            vValorDepositoSelecionado := 0;
                    end;
                
                    
                    /*Valor Informado*/
                    begin
                        select sum(valor_digitado)
                          into vValorDepósitoInformado
                          from depositosdiarios_leituraocr d
                         where iddepositodiario is null
                           and considerar_calculo = 'S'
                           and not exists ( select 1 from comprovantes c where c.idcomprovante = d.idcomprovante and statuscomprovante = 'R')
                           and idrepresentante = :P464_IDREPRESENTANTE;
                    exception
                        when others then
                            vValorDepósitoInformado := 0;
                    end;
                         
                    
                    /*Retorno da Function*/
                    if vValorDepósitoInformado != vValorDepositoSelecionado then
                        return true;
                    else
                        return false;
                    end if;
                end;
                ```
        }

        action native-confirm (
            action: confirm
            settings {
                title: Confirmar Revisão
                message:
                    ```html
                    Atenção!
                    Depósito selecionado diferente do Depósito informado!
                    Deseja Confirmar a revisão?
                    ```
                style: information
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: CORRIGIR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction valores-iguais-não-exige-confirmação (
        name: Valores Iguais Não Exige Confirmação
        execution {
            sequence: 50
        }
        when {
            event: click
            selectionType: button
            button: @corrigir
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                    vValorDepositoSelecionado number;
                    vValorDepósitoInformado   number;
                begin
                
                    
                    /*Valor Selecionado*/
                    begin
                        select valordeposito
                          into vValorDepositoSelecionado
                          from depositosdiarios_orig d
                         where d.iddepositodiarios = :P464_IDDEPOSITODIARIO;
                    exception
                        when others then
                            vValorDepositoSelecionado := 0;
                    end;
                
                    
                    /*Valor Informado*/
                    begin
                        select sum(valor_digitado)
                          into vValorDepósitoInformado
                          from depositosdiarios_leituraocr d
                         where iddepositodiario is null
                           and considerar_calculo = 'S'
                           and not exists ( select 1 from comprovantes c where c.idcomprovante = d.idcomprovante and statuscomprovante = 'R')
                           and idrepresentante = :P464_IDREPRESENTANTE;
                    exception
                        when others then
                            vValorDepósitoInformado := 0;
                    end;
                         
                    
                    /*Retorno da Function*/
                    if vValorDepósitoInformado = vValorDepositoSelecionado then
                        return true;
                    else
                        return false;
                    end if;
                end;
                ```
        }

        action native-confirm (
            action: confirm
            settings {
                title: Confirmar Revisão
