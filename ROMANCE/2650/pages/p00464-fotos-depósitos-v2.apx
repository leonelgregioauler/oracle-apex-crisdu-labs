page 464 (
    name: Fotos Depósitos
    alias: FOTOS-DEPÓSITOS-V2
    title: Fotos Depósitos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_abrejanela(psessao, pid)
              {
              window.open("/apex/f?p=2650:32:"+psessao+"::NO:32:P32_IDPGTOFORN:"+pid,"_blank");
              }
            
            function fnc_excluirfoto (pid)
            {
              apex.confirm("Deseja realmente excluir esta foto?"
                         , {  request:"DELETAR"
                            , set:{"P464_IDLEITURAOCR_EXCLUIR":pid}}
                           );
            }
            
            function toggleClasses() {
            
                // debugger;
                const element = document.querySelector('body');
                const actionContent = document.querySelector('.t-Body-actionsContent');
                const action = document.querySelector('.t-Body-actions');
                const actionToggle = document.querySelector('.t-Body-actionsToggle');
            
                
                if (element.classList.contains('js-rightCollapsed')) {
                    element.classList.remove('js-rightCollapsed');
                    element.classList.add('js-rightExpanded');
                    actionContent.style.visibility = 'inherit';
                    action.style.width = 400;
                    actionToggle.classList.add('is-active');
                } else {
                    element.classList.remove('js-rightExpanded');
                    element.classList.add('js-rightCollapsed');
                    ///actionContent.style.visibility = '';
                    action.style.width = 0;
                    actionToggle.classList.remove('is-active');
                }
            }
            
            // toggleClasses();
            ```
    }
    css {
        inline:
            ```css
            .img html body img{
                max-width: 500px;
            }
            .img {
                border: 1px solid black;
            }
            
            .acionar {
                cursor: pointer;
                color: red;
            }
            
            .desabilitar {
                pointer-events: none; /* Impede que o elemento receba eventos de clique */
                opacity: 0.5; /* Torna o elemento visualmente mais claro, indicando que está desabilitado */
                cursor: not-allowed; /* Mostra um cursor de "não permitido" quando o mouse passa sobre o elemento */
            }
            
            
            .t-Body-actions {
                width: 400px;
            }
            
            .js-rightCollapsed .t-Body-actions {
                width: 0rem;
            }
            
            .cinza {
                color: gray;
            }
            
            .azul  {
                color: blue;
            }
            
            .verde {
                color: green;
            }
            
            .vermelho {
                color: red;
            }
            
            button[data-action="save-grid"] {
              background-color: rgb(5, 106, 200);
              color: white;
            }
            
            .t-Body-actions {
                width: 490px !important;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region aguardando-revisao (
        name: Aguardando Revisao
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select 'Comprovantes Aguardando Revisão' situacao
                     , count(1) qtdfotos                            
                 from depositosdiarios_leituraocr d
                 where iddepositodiario is null
                   and (:P464_IDFILIAL is null or d.idfilial = :P464_IDFILIAL)
                   and d.usuariorevisao is null 
                ```
        }
        layout {
            sequence: 20
            parentRegion: @comprovantes
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        settings {
            labelColumn: SITUACAO
            valueColumn: QTDFOTOS
            chartType: circular
        }
    )

