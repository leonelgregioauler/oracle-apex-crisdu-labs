    region envio-pendente-de-fotos (
        name: Envio Pendente de Fotos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(d.idrepresentante ) ) empresa
                     , pck_romance.fnc_nomerepresentante(d.idrepresentante ) distribuidor
                     , count(1) - ( select count(1)
                                    from depositosdiarios_leituraocr
                                    where idrepresentante = d.idrepresentante
                                      and iddepositodiario is null ) quantidade  
                     , listagg(trim(to_char(d.valordeposito))||' - '||TO_CHAR(d.data,'DD/MM/RRRR')||'<br>')within group (order by 1) detalhe 
                     , d.idrepresentante                      
                from depositosdiarios_orig d
                where exists ( select *
                               from parametrosrepresentantes p
                               where parametro = 'HABILITAFOTODEPOSITO'
                                 and p.idrepresentante = d.idrepresentante
                                 and p.valor = 'S')
                  and ( (:P464_DATA_INICIAL is null and :P464_DATA_FINAL is null) or (trunc(datacriacao) between to_date(:P464_DATA_INICIAL, 'dd/mm/rrrr') and to_date(:P464_DATA_FINAL, 'dd/mm/rrrr') ) )
                  and comprovado = 'S'
                having  count(1) - ( select count(1)
                                    from depositosdiarios_leituraocr
                                    where idrepresentante = d.idrepresentante
                                      and iddepositodiario is null ) > 0
                group by d.idrepresentante
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 3024448806809958968
        }

