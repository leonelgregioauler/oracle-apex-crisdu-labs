    region depósitos-informados (
        name: Depósitos Informados
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select initcap(cb.beneficiario)||'('||b.nomebanco||' - '||cb.agencia ||', '||cb.conta||')'
                         from contasbancarias cb
                            , bancos b
                         where cb.idbanco         = b.idbanco
                           and cb.idcontabanc = d.idcontabanc )||' ['
                    || to_char(data,'DD/MM/RRRR HH24:MI:SS' ) ||'] 'display_value
                     , trim(to_char(valordeposito ,'999G999G999G990D00')) return_value
                     , idrepresentante
                     , d.iddepositodiarios
                     , ds.descricao status_descricao
                     , case
                         when ds.idstatus = 1 then 'cinza'
                         when ds.idstatus = 2 then 'azul'
                         when ds.idstatus = 3 then 'verde'
                         when ds.idstatus = 4 then 'vermelho'
                       end color_status
                     , apex_page.get_url(
                                p_page => 464
                              , p_items => 'P464_IDDEPOSITODIARIO,P464_IDREPRESENTANTE,P464_IDREQUISICAO'
                              , p_values => iddepositodiarios || ',' || idrepresentante || ',' || idrequisicao
                              --, p_request => 'CONSIDERAR_CALCULO'
                             ) link
                     , apex_page.get_url(
                                p_page => 463
                              , p_items => 'P463_IDDEPOSITODIARIO'
                              , p_values => iddepositodiarios
                             ) link_leiturascomprovantes
                from depositos_status ds
                   , depositosdiarios_orig d
                where ds.idstatus = d.idstatus
                  and d.idstatus is not null -- idstatus = null foi utilizado para solicitações antigas de gestores
                  and idrepresentante = :P464_IDREPRESENTANTE
                  and (:P464_IDSTATUS_DEPOSITO = 0 or d.idstatus = :P464_IDSTATUS_DEPOSITO)
                  and ( (:P464_DATA_INICIAL is null and :P464_DATA_FINAL is null) or (trunc(datacriacao) between to_date(:P464_DATA_INICIAL, 'dd/mm/rrrr') and to_date(:P464_DATA_FINAL, 'dd/mm/rrrr') ) )
                  and extract ( year from data ) >= 2021
                  and extract ( month from data ) >= to_number(to_char(sysdate,'MM'))-1
                order by d.data desc;
                
                ```
            pageItemsToSubmit: [
                P464_IDDEPOSITODIARIO
                P464_IDREPRESENTANTE
            ]
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            gridColumns: 3
        }
        title {
            advancedFormatting: true
            htmlExpression:
                ```html
                <a href="&LINK.">
                    <h1>&RETURN_VALUE.</h1>
                </a>
                
                ```
        }
        subtitle {
            advancedFormatting: true
            htmlExpression:
                ```html
                <a href="&LINK_LEITURASCOMPROVANTES.">
                    <p>&DISPLAY_VALUE.</p>
                </a>
                ```
        }
        body {
            advancedFormatting: true
            htmlExpression:
                ```html
                <a href="&LINK.">
                    <h2>
                        <i><span class="&COLOR_STATUS.">&STATUS_DESCRICAO.</span></i>
                    <h2>
                </a>
                
                ```
        }
        iconAndBadge {
            iconSource: initials
            iconColumn: STATUS_DESCRICAO
            iconPosition: end
        }
    )

    region detalhe (
        name: Detalhe
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vnroidentificacaodigitado  varchar2(4000);
                  vvalorinformado            number(15,2);
                  vqtddeposito               number;
                  --
                  cursor cdep is
                    select ( select initcap(cb.beneficiario)||'('||b.nomebanco||' - '||cb.agencia ||', '||cb.conta||')'
                             from contasbancarias cb
                                , bancos b
                             where cb.idbanco         = b.idbanco
                               and cb.idcontabanc = d.idcontabanc ) detalhes
                         ,  to_char(data,'DD/MM/RRRR HH24:MI:SS' ) DATA
                         , trim(TO_CHAR(valordeposito ,'999G999G999G990D00')) valor
                         , idrepresentante
                         , d.iddepositodiarios
                         , D.IDPGTOFORN        
                         , d.nrocomprovante
                    from DEPOSITOSDIARIOS_orig d
                    where d.iddepositodiarios = :P464_IDDEPOSITODIARIO
                    and ( (:P464_DATA_INICIAL is null and :P464_DATA_FINAL is null) or (trunc(datacriacao) between to_date(:P464_DATA_INICIAL, 'dd/mm/rrrr') and to_date(:P464_DATA_FINAL, 'dd/mm/rrrr') ) )
                    order by 1;
                  --
                  rdep  cdep%rowtype;
                  --
                begin
                  --
                  select sum(valor)
                  into vvalorinformado                                                                  
                  from depositosdiarios_leituraocr d
                  where idrepresentante = :P464_IDREPRESENTANTE
                   and iddepositodiario is null
                   and considerar_calculo = 'S'
                   and not exists ( select 1 from comprovantes c where c.idcomprovante = d.idcomprovante and statuscomprovante = 'R'); -- RF-11 - LEONEL GREGIO AULER
                  --            
                  for a in (  select d.nroidentificacao_digitado
                                   , count(1) qtd
                              from depositosdiarios_leituraocr d
                              where idrepresentante = :P464_IDREPRESENTANTE
                                and iddepositodiario is null
                                and considerar_calculo = 'S'
                                and not exists ( select 1 from comprovantes c where c.idcomprovante = d.idcomprovante and statuscomprovante = 'R')
                              group by nroidentificacao_digitado
                              order by 1 )
                  loop
                    --
                    if a.qtd > 1 then
                      vnroidentificacaodigitado := vnroidentificacaodigitado|| '<font color="red">'||a.nroidentificacao_digitado||' - '||a.qtd||'</font><br>';         
                    else
                      vnroidentificacaodigitado := vnroidentificacaodigitado|| a.nroidentificacao_digitado||' - '||a.qtd||'<br>';         
                    end if;
                    --
                  end loop;   
                  --
                  open cdep;
                  fetch cdep into rdep;
                  close cdep;
                  --
                  if :P464_IDDEPOSITODIARIO is not null then
                      --
                      htp.p('<table border=0 width="100%" style="margin-top: 20px; padding-top: 20px;">');
                      htp.p('  <tr>');
                      htp.p('    <td width="50%" align="center">');
                      htp.p('       <font size="6">Depósito selecionado</font>');
                      htp.p('    </td>');
                      htp.p('    <td align="center">');
                      htp.p('       <font size="6">Depósito informado</font>');
                      htp.p('    </td>');
                      htp.p('  </tr>');
                      htp.p('  <tr>');
                      htp.p('    <td colspan=2><hr> </td>');
                      htp.p('  </tr>');
                      htp.p('  <tr>');
                      htp.p('    <td align="center">');
                      htp.p('       <font size="6">R$ '||rdep.valor);--trim(to_char(vvalorinformado,'999G999G999G990D00'))||'</font>');
                      htp.br;
                      htp.p('       <font size="4"> '||rdep.detalhes);--trim(to_char(vvalorinformado,'999G999G999G990D00'))||'</font>');
                      htp.br;
                      htp.p('       <font size="4"> '||rdep.nrocomprovante);--trim(to_char(vvalorinformado,'999G999G999G990D00'))||'</font>');
                      htp.br;
                      htp.p(      rdep.DATA);
                      htp.br;
                      htp.p('       <font size="4"> <a href="javascript: fnc_abrejanela('''||v('APP_SESSION')||''','''||rdep.idpgtoforn||''')">Ver Fatura</a></font>');
                      htp.p('    </td>');
                      htp.p('    <td align="center">');                                                                                
                      htp.p('       <font size="6"><span id="P464_DEP_INFORMADO_VALOR">R$ '||trim(to_char(nvl(vvalorinformado,0),'999G999G999G990D00'))||'</span></font>');     
                      htp.br;
                      htp.p('       <font size="4"> '||vnroidentificacaodigitado);
                      htp.p('    </td>');
                      htp.p('  </tr>');
                      htp.p('</table>');
                      htp.br;
                      --
                   else
                     --
                     select count(1)
                     into vqtddeposito
                      from DEPOSITOSDIARIOS_orig d
                      where comprovado = 'S'
                        and idrepresentante = :P464_IDREPRESENTANTE
                        and ( (:P464_DATA_INICIAL is null and :P464_DATA_FINAL is null) or (trunc(datacriacao) between to_date(:P464_DATA_INICIAL, 'dd/mm/rrrr') and to_date(:P464_DATA_FINAL, 'dd/mm/rrrr') ) );
                     --
                     if vqtddeposito = 0 and :P464_IDREPRESENTANTE is not null then   
                       --
                       htp.p('<table border=0 width="100%">');
                       htp.p('  <tr>');
                       htp.p('    <td width="50%" align="center">');
                       htp.p('       <font size="4">Não há depósitos pendentes de revisão.</font>');
                       htp.p('    </td>');
                       htp.p('  </tr>');
                       htp.p('</table>');
                       htp.br;
                       --
                     end if;  
                     --
                   end if;
                end;
                
                ```
        }
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region distribuidor-selecionado (
        name: Distribuidor Selecionado
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vusuario varchar2(1000);
                  --
                begin
                  --
                  begin
                      select listagg(usuario) within group (order by 1)
                      into vusuario
                      from ( select distinct initcap(d.usuariorevisao) usuario
                              from depositosdiarios_leituraocr d
                              where idrepresentante = :P464_IDREPRESENTANTE
                                and d.usuariorevisao is not null
                                and (d.iddepositodiario is null or (:P464_IDREPRESENTANTE_FILTRO is not null and d.idrepresentante = :P464_IDREPRESENTANTE_FILTRO) ) );
                  exception
                    when others then
                      vusuario := null;
                  end;
                  --
                  htp.p('<table border=0 width="100%">');
                  htp.p('  <tr>');
                  htp.p('    <td width="100%" align="center">');
                  htp.p('       <font size="6">'||pck_romance.fnc_nomerepresentante(:P464_IDREPRESENTANTE)||' - '||pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(:P464_IDREPRESENTANTE))||'</font>');
                  htp.p('    </td>');
                  htp.p('  </tr>');
                  --
                  if vusuario is not null then
                    --
                      htp.p('  <tr>');
                      htp.p('  <br>');
                      htp.p('    <td width="100%" align="center">');
                      htp.p('       <font size="4" color="red"><b>Em revisão por '||vusuario||'</b></font>');
                      htp.p('    </td>');
                      htp.p('  </tr>');
                    --
                  end if;
                  --
                  htp.p('</table>');
                  htp.br;
                  --
                end;
                
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                margin-top-lg
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P464_IDREPRESENTANTE
        }
    )

