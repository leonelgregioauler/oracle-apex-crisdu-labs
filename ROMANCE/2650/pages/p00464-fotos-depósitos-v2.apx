    dynamicAction abrir-modal-excluir-comprovante (
        name: Abrir Modal Excluir Comprovante
        execution {
            sequence: 120
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .excluir-comprovante
        }

        action abrir-modal-excluir-comprovante (
            name: Abrir Modal Excluir Comprovante
            action: confirm
            settings {
                title: Excluir Comprovante
                message: Confirma a exclusão do comprovante ?
                style: danger
                icon: fa-trash-o
                confirmLabel: Sim
                cancelLabel: Não
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                        v_qtd number;
                    begin
                        select count(*)
                          into v_qtd
                          from roman.conciliacoesbancarias
                         where idleituraocr_deposito = :P464_IDLEITURAOCR_EXCLUIR;
                    
                        if v_qtd > 0 then
                            raise_application_error(-20001, 'Este comprovante já está conciliado e não pode ser excluído.');
                        end if;
                    
                        -- filhas da leitura OCR
                        delete from roman.auditoria_processos         where idleituraocr_deposito = :P464_IDLEITURAOCR_EXCLUIR;
                        delete from roman.depositosdiarios_reprovacao where idleituraocr_deposito = :P464_IDLEITURAOCR_EXCLUIR;
                        delete from roman.observacoescomprovante      where idleituraocr_deposito = :P464_IDLEITURAOCR_EXCLUIR;
                    
                        delete from roman.depositosdiarios_leituraocr where idleituraocr_deposito = :P464_IDLEITURAOCR_EXCLUIR;
                    
                        -- filhas do comprovante
                        delete from roman.auditoria_processos         where idcomprovante = :P464_IDCOMPROVANTE;
                        delete from roman.depositosdiarios_reprovacao where idcomprovante = :P464_IDCOMPROVANTE;
                        delete from roman.observacoescomprovante      where idcomprovante = :P464_IDCOMPROVANTE;
                    
                        delete from roman.comprovantes where idcomprovante = :P464_IDCOMPROVANTE;
                    end;
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

