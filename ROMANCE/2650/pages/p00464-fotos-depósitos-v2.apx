    region comprovantes-reprovados (
        name: Comprovantes Reprovados
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select 'Comprovantes Reprovados' situacao
                      , count(1) qtdfotos                                  
                from depositosdiarios_leituraocr d
                where (:P464_IDFILIAL is null or d.idfilial = :P464_IDFILIAL)
                  and exists (select 1 
                              from depositosdiarios_reprovacao dr
                                 , depositosdiarios_orig d
                              where dr.iddepositodiario = d.iddepositodiario
                              and d.idstatus = 4
                              and dr.data_correcao is null)
                ```
        }
        layout {
            sequence: 40
            parentRegion: @comprovantes
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            labelColumn: SITUACAO
            valueColumn: QTDFOTOS
            chartType: circular
        }
    )

