    process deletar-selecionados (
        name: DELETAR_SELECIONADOS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    v_id  roman.depositosdiarios_leituraocr.idleituraocr_deposito%type;
                    v_qtd number;
                begin
                    for i in 1..APEX_APPLICATION.G_F02.COUNT loop
                        if APEX_APPLICATION.G_F02(i) != 'S' then
                            v_id := APEX_APPLICATION.G_F02(i);
                
                            -- não deixa excluir comprovante já conciliado
                            select count(*)
                              into v_qtd
                              from roman.conciliacoesbancarias
                             where idleituraocr_deposito = v_id;
                
                            if v_qtd > 0 then
                                raise_application_error(-20001,
                                    'O comprovante ' || v_id || ' já está conciliado e não pode ser excluído.');
                            end if;
                
                            -- filhas da leitura OCR
                            delete from roman.auditoria_processos         where idleituraocr_deposito = v_id;
                            delete from roman.depositosdiarios_reprovacao where idleituraocr_deposito = v_id;
                            delete from roman.observacoescomprovante      where idleituraocr_deposito = v_id;
                
                            -- pai
                            delete from roman.depositosdiarios_leituraocr where idleituraocr_deposito = v_id;
                        end if;
                    end loop;
                
                    commit;
                
                    apex_application.g_print_success_message := '<span style="color : white ">Itens selecionados foram excluídos com sucesso! </span>';
                
                exception
                    when others then
                        rollback;
                        apex_error.add_error(
                            p_message => 'Ops! Ocorreu um erro no processo Deletar Comprovantes Selecionados. Erro: ' || SQLERRM || ' - Código: ' || SQLCODE,
                            p_display_location => apex_error.c_inline_in_notification
                        );
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 46408694139903394
        }
        serverSideCondition {
            whenButtonPressed: @deletar-selecionados
        }
    )

