page 339 (
    name: Depósitos Solicitados
    title: Depósitos Solicitados
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region depósitos-solicitados (
        name: Depósitos Solicitados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select depdia.iddepositodiarios  
                     , depdia.data  Data_deposito
                     , pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(depdia.idrepresentante)) empresa
                     , pck_romance.fnc_nomerepresentante(depdia.idrepresentante) distribuidor
                     , initcap(bb.nomebanco)  Banco
                     , cb.agencia ||', '||cb.conta  agencia_conta
                     , initcap(cb.beneficiario) beneficiario
                     , depdia.valordeposito Valor_depositado
                     , ( select t.descricao
                         from tipospagamentos t
                         where t.codigo = depdia.tipo )tipo
                     , decode(depdia.comprovado,'S','Sem Comprovante'
                                               ,'C','Cópia'
                                               ,'G','Com Gerente'
                                               ,'M','Em Mãos') Comprovado
                     , depdia.nrocomprovante
                     , depdia.OBSERVACAOGERENTE observacao
                     , depdia.usuario solicitado_por
                     , depdia.usuarioconfirmou
                     , depdia.dataconfirmacao
                     , ( select count(1)
                         from depositosdiarios_leituraocr dr
                         where dr.iddepositodiario = depdia.iddepositodiarios ) qtd_fotos
                     , extract(month from depdia.data) mes
                     , 'Versão 1' versao
                from depositosdiarios_orig depdia
                   , pagamentosfornecedores pgf
                   , contasbancarias cb
                   , bancos          bb 
                where cb.idbanco         = bb.idbanco    
                  and depdia.idcontabanc = cb.idcontabanc
                  and depdia.idpgtoforn = pgf.idpgtoforn 
                  and depdia.data >= to_date('21/05/2019 00:00:00','DD/MM/RRRR HH24:MI:SS')
                  and ( depdia.usuario = 'ROMAN' or exists ( select 1
                                                             from usuarios u
                                                                , representantes r
                                                             where u.idpessoa = r.idpessoa
                                                               and u.usuario  = depdia.usuario 
                                                               and r.idrepresentante = depdia.idrepresentante ) )
                  and ( :P339_DATAINICIO IS NULL
                      OR ( depdia.data between to_date(:P339_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P339_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') ) )
                  and ( :P339_IDFILIAL is null or pck_romance.fnc_filialrepresentante(depdia.idrepresentante) = :P339_IDFILIAL )
                  and ( :P339_IDREPRESENTANTE is null or depdia.idrepresentante = :P339_IDREPRESENTANTE )
                union all
                select depdia.iddepositodiarios  
                     , depdia.data  Data_deposito
                     , pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(depdia.idrepresentante)) empresa
                     , pck_romance.fnc_nomerepresentante(depdia.idrepresentante) distribuidor
                     , initcap(bb.nomebanco)  Banco
                     , cb.agencia ||', '||cb.conta  agencia_conta
                     , initcap(cb.beneficiario) beneficiario
                     , depdia.valordeposito Valor_depositado
                     , ( select t.descricao
                         from tipospagamentos t
                         where t.codigo = depdia.tipo )tipo
                     , decode(depdia.comprovado,'S','Sem Comprovante'
                                               ,'C','Cópia'
                                               ,'G','Com Gerente'
                                               ,'M','Em Mãos') Comprovado
                     , depdia.nrocomprovante
                     , depdia.OBSERVACAOGERENTE observacao
                     , depdia.usuario solicitado_por
                     , depdia.usuarioconfirmou
                     , depdia.dataconfirmacao
                     , ( select count(1)
                         from depositosdiarios_leituraocr dr
                         where dr.iddepositodiario = depdia.iddepositodiarios ) qtd_fotos
                     , extract(month from depdia.data) mes
                     , 'Versão 2' versao
                from depositosdiarios_orig depdia
                   , ordensdepositos o
                   , contasbancarias cb
                   , bancos          bb 
                where cb.idbanco             = bb.idbanco    
                  and depdia.idcontabanc     = cb.idcontabanc
                  and depdia.idordemdeposito = o.idordemdeposito
                  and depdia.data >= to_date('21/05/2019 00:00:00','DD/MM/RRRR HH24:MI:SS')
                  and ( depdia.usuario = 'ROMAN' or exists ( select 1
                                                             from usuarios u
                                                                , representantes r
                                                             where u.idpessoa = r.idpessoa
                                                               and u.usuario  = depdia.usuario 
                                                               and r.idrepresentante = depdia.idrepresentante ) )
                  and ( :P339_DATAINICIO IS NULL OR ( depdia.data between to_date(:P339_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P339_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') ) )
                  and ( :P339_IDFILIAL is null or pck_romance.fnc_filialrepresentante(depdia.idrepresentante) = :P339_IDFILIAL )
                  and ( :P339_IDREPRESENTANTE is null or depdia.idrepresentante = :P339_IDREPRESENTANTE )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 3039595196908557421
        }

