    pageItem P339_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P339_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) distribuidor
                     , r.idrepresentante
                from representantes r
                where ( :P339_IDFILIAL is null  or r.idgerente = ( select idgerente 
                                                                   from gerentes g
                                                                   where g.idfilial = :P339_IDFILIAL ) )
                order by 1
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P339_IDFILIAL
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button buscar (
        buttonName: BUSCAR
        label: Buscar
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 339
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 339
                items: {
                    P339_IDFILIAL: &P339_IDFILIAL.
                    P339_IDREPRESENTANTE: &P339_IDREPRESENTANTE.
                    P339_DATAINICIO: &P339_DATAINICIO.
                    P339_DATAFIM: &P339_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: BUSCAR
        }
    )

)

