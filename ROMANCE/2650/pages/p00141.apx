page 141 (
    name: Anexos Cheques
    title: Anexos Cheques
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 40%
        height: 70%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function fnc_verimg(pid)
            {
              window.open('http://anexos.romancemoda.com.br/'+pid);
              void(0);
            }
            
            
            function fnc_removeanexo(pidanexo,pnomeanexo)
            {
              apex.confirm("Deseja realmente remover o anexo "+pnomeanexo+"?", {
              request:"DELETAR",
              set:{"P141_IDANEXODELETAR":pidanexo}
              });
            }
            ```
    }

    region anexos (
        name: Anexos
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region anexos-cheques (
        name: Anexos Cheques
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @anexos
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            footerText: <font color="green"> Você pode anexar mais de um arquivo.</font>
        }
        settings {
            outputAs: text
        }
    )

    region arquivos-anexados (
        name: Arquivos Anexados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomearquivo
                     --, '<a href="javascript: fnc_verimg('''||idcheque||idanexocheque||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10)||''');">Ver arquivo</a>' link
                     , idcheque||idanexocheque||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10) link
                     , dataanexo data
                     , ( select pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario ) usuario
                     , '<a href="javascript: fnc_removeanexo('||idanexocheque||','''||t.nomearquivo||''');">Remover</a>' remover
                from anexoscheques t
                where idcheque = :P141_IDCHEQUE
                order by t.dataanexo
                ```
        }
        layout {
            sequence: 20
            parentRegion: @anexos
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column DATA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 3
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
            sorting {
                sortable: false
            }
        )

        column LINK (
            reportColumnQueryId: 2
            derivedColumn: N
            type: link
            heading {
                heading: Ver Anexo
                alignment: center
            }
            layout {
                sequence: 2
            }
            link {
                target: {
                    page: 162
                    items: {
                        P162_ARQUIVO: #LINK#
                    }
                    action: resetPagination
                }
                linkText: Ver Anexo
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NOMEARQUIVO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column REMOVER (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Remover
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column USUARIO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Usuário
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P141_ARQUIVOTEMP (
        type: fileUpload
        label {
            label: Arquivo
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
        }
        storage {
            filenameColumn: NOMEARQUIVO
        }
        layout {
            sequence: 50
            region: @anexos-cheques
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: ARQUIVOTEMP
            used: always
        }
    )

    pageItem P141_DATAANEXO (
        type: hidden
        layout {
            sequence: 80
            region: @anexos-cheques
            slot: regionBody
        }
        appearance {
            formatMask: DD/MM/RRRR HH24:MI:SS
        }
        source {
            type: databaseColumn
            databaseColumn: DATAANEXO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  return sysdate;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P141_IDANEXOCHEQUE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @anexos-cheques
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDANEXOCHEQUE
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P141_IDANEXODELETAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @anexos-cheques
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P141_IDCHEQUE (
        type: hidden
        layout {
            sequence: 30
            region: @anexos-cheques
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDCHEQUE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P141_IDUSUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @anexos-cheques
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDUSUARIO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidusuario number;
                BEGIN
                  select idusuario
                  into vidusuario
                  from usuarios 
                  where usuario = v('APP_USER');
                  return vidusuario;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P141_NOMEARQUIVO (
        type: hidden
        layout {
            sequence: 40
            region: @anexos-cheques
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: NOMEARQUIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P141_PAGINA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 100
            region: @anexos-cheques
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Anexar este arquivo!
        layout {
            sequence: 30
            region: @anexos-cheques
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P141_IDANEXOCHEQUE
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 20
            region: @anexos-cheques
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P141_IDANEXOCHEQUE
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @anexos
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 44
                items: {
                    P44_IDCHEQUE: &P141_IDCHEQUE.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation selecione-o-arquivo (
        name: Selecione o Arquivo
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P141_ARQUIVOTEMP
        }
        error {
            errorMessage: Selecione o arquivo para anexar!
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process anexar (
        name: Anexar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  commit;
                  -- Call the procedure
                  pck_anexos.blob_to_file_cheques(pidcheque => :P141_IDCHEQUE);
                  commit;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 1386955991059103773
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P141_ARQUIVOTEMP
        }
    )

    process deletar (
        name: Deletar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_anexos.prc_apagaanexo_cheques(pidanexocheque => :P141_IDANEXODELETAR);
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1386957415983103775
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    process fetch-row-from-anexoscheques (
        name: Fetch Row from ANEXOSCHEQUES
        type: autoRowFetch
        source {
            tableName: ANEXOSCHEQUES
            pkColumn: IDANEXOCHEQUE
            pkItem: P141_IDANEXOCHEQUE
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1386956263954103775
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P141_IDANEXOCHEQUE is null then
                        select "#OWNER#"."SEQ_IDANEXOCHEQUE".nextval
                          into :P141_IDANEXOCHEQUE
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 1386956676231103775
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: itemIsNotNull
            item: P141_ARQUIVOTEMP
        }
    )

    process process-row-of-anexoscheques (
        name: Process Row of ANEXOSCHEQUES
        type: autoRowProcessing
        target {
            tableName: ANEXOSCHEQUES
            pkColumn: IDANEXOCHEQUE
            pkItem: P141_IDANEXOCHEQUE
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada
        }
        advanced {
            executionMappingIdentifier: 1386957076738103775
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P141_ARQUIVOTEMP
        }
    )

    branch (
        name: Anexar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 141
                items: {
                    P141_IDCHEQUE: &P141_IDCHEQUE.
                    P141_IDANEXOCHEQUE:
                }
                action: resetPagination
                successMessage: false
            }
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 44
                items: {
                    P44_IDCHEQUE: &P141_IDCHEQUE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') = 'VOLTAR'
                  and :P141_PAGINA = 44
                ```
        }
    )

    branch (
        execution {
            sequence: 30
        }
        behavior {
            target: {
                page: 43
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') = 'VOLTAR'
                  and :P141_PAGINA = 43
                ```
        }
    )

)

