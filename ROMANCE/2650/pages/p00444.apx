                      END IF;
                      --
                      IF :NUMERO = '04' THEN
                          UPDATE contrapropostasorcamentosmes c
                             SET c.abril   = REPLACE(:CONTRA_PROPOSTA,'.','')
                           WHERE idcontrapropostaorcamentomes = :IDCONTRAPROPOSTA;
                          --
                          UPDATE orcamentosmes o
                             SET o.abril   = REPLACE(:ORCAMENTO,'.','')
                           WHERE idorcamentomes = :IDORCAMENTOMES;
                      END IF;
                      --
                      IF :NUMERO = '05' THEN
