        behavior {
            action: redirectThisApp
            target: {
                page: 443
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction atualizaregiao (
        name: AtualizaRegiao
        execution {
            sequence: 50
        }
        when {
            event: custom
            customEvent: interactivegridsave
            selectionType: region
            region: @gestão-orçamentária-detalhada
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @gestão-orçamentária-detalhada
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction confirmacopiar (
        name: ConfirmaCopiar
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @copiar-cp
        }

        action native-confirm (
            action: confirm
            settings {
                message: Confirma aceitar todos os dados da contra-proposta?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: COPIAR_CP
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction confirmaperc (
        name: ConfirmaPerc
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @aplicar-percentual
        }

        action native-confirm (
            action: confirm
            settings {
                message: Confirma aplicar %Previsto para a contra-proposta?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: APLICAR_PERCENTUAL
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction submit (
        name: Submit
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P444_PERIODO_ORCAMENTO
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: REFRESH
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction valida-escolha (
        name: Valida Escolha
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P444_PERIODO_ORCAMENTO
