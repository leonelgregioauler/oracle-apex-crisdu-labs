    process aplica-percentual (
        name: Aplica Percentual
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                
                 MERGE INTO contrapropostasorcamentosmes c
                 USING (select g.idgestaoorcamentaria
                             , p.janeiro
                             , p.fevereiro
                             , p.marco
                             , p.abril
                             , p.maio
                             , p.junho
                             , p.julho
                             , p.agosto
                             , p.setembro
                             , p.outubro
                             , p.novembro
                             , p.dezembro
                          from gestaoorcamentaria     g
                             , propostasorcamentosmes p
                         where g.idcentrodecusto = :P444_IDCENTRODECUSTO
                           and g.idgestaoorcamentaria = p.idgestaoorcamentaria 
                           and g.vigencia   = (select vigencia 
                                                 from gestaoorcamentaria
                                                where idgestaoorcamentaria = :P444_IDGESTAOORCAMENTARIA)
                           and g.mesinicial = (select mesinicial
                                                 from gestaoorcamentaria
                                                where idgestaoorcamentaria = :P444_IDGESTAOORCAMENTARIA)
                           and g.mesfinal   = (select mesfinal
                                                 from gestaoorcamentaria
                                                where idgestaoorcamentaria = :P444_IDGESTAOORCAMENTARIA)            
                       ) pd
                  ON (c.idgestaoorcamentaria = pd.idgestaoorcamentaria)
                 WHEN MATCHED THEN
                 UPDATE SET c.janeiro   = pd.janeiro   + ( pd.janeiro   * :P444_PERCENTUAL_PREVISTO /100)
                          , c.fevereiro = pd.fevereiro + ( pd.fevereiro * :P444_PERCENTUAL_PREVISTO /100)
                          , c.marco     = pd.marco     + ( pd.marco     * :P444_PERCENTUAL_PREVISTO /100)
                          , c.abril     = pd.abril     + ( pd.abril     * :P444_PERCENTUAL_PREVISTO /100)
                          , c.maio      = pd.maio      + ( pd.maio      * :P444_PERCENTUAL_PREVISTO /100)
                          , c.junho     = pd.junho     + ( pd.junho     * :P444_PERCENTUAL_PREVISTO /100)
                          , c.julho     = pd.julho     + ( pd.julho     * :P444_PERCENTUAL_PREVISTO /100)
                          , c.agosto    = pd.agosto    + ( pd.agosto    * :P444_PERCENTUAL_PREVISTO /100)
                          , c.setembro  = pd.setembro  + ( pd.setembro  * :P444_PERCENTUAL_PREVISTO /100)
                          , c.outubro   = pd.outubro   + ( pd.outubro   * :P444_PERCENTUAL_PREVISTO /100)
                          , c.novembro  = pd.novembro  + ( pd.novembro  * :P444_PERCENTUAL_PREVISTO /100)
                          , c.dezembro  = pd.dezembro  + ( pd.dezembro  * :P444_PERCENTUAL_PREVISTO /100); 
                
                END;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Percentual Aplicado
        }
        advanced {
            executionMappingIdentifier: 562906683107144786
        }
        serverSideCondition {
            type: request=Value
            value: APLICAR_PERCENTUAL
        }
    )

    process copiar-cp (
        name: Copiar_CP
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                
                 MERGE INTO orcamentosmes o
                 USING (select g.idgestaoorcamentaria
                             , p.janeiro
                             , p.fevereiro
                             , p.marco
                             , p.abril
                             , p.maio
                             , p.junho
                             , p.julho
                             , p.agosto
                             , p.setembro
                             , p.outubro
                             , p.novembro
                             , p.dezembro
                          from gestaoorcamentaria     g
                             , contrapropostasorcamentosmes p
                         where g.idcentrodecusto = :P444_IDCENTRODECUSTO
                           and g.idgestaoorcamentaria = p.idgestaoorcamentaria
                           and g.vigencia   = (select vigencia 
                                                 from gestaoorcamentaria
                                                where idgestaoorcamentaria = :P444_IDGESTAOORCAMENTARIA)
                           and g.mesinicial = (select mesinicial
                                                 from gestaoorcamentaria
                                                where idgestaoorcamentaria = :P444_IDGESTAOORCAMENTARIA)
                           and g.mesfinal   = (select mesfinal
                                                 from gestaoorcamentaria
                                                where idgestaoorcamentaria = :P444_IDGESTAOORCAMENTARIA)            
                       ) pd
                   ON (o.idgestaoorcamentaria = pd.idgestaoorcamentaria)
                 WHEN MATCHED THEN
                 UPDATE SET o.janeiro   = pd.janeiro   
                          , o.fevereiro = pd.fevereiro 
                          , o.marco     = pd.marco     
                          , o.abril     = pd.abril     
                          , o.maio      = pd.maio      
                          , o.junho     = pd.junho     
                          , o.julho     = pd.julho     
                          , o.agosto    = pd.agosto    
                          , o.setembro  = pd.setembro  
                          , o.outubro   = pd.outubro   
                          , o.novembro  = pd.novembro  
                          , o.dezembro  = pd.dezembro ; 
                
                END;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Orçamento atualizado!
        }
        advanced {
            executionMappingIdentifier: 562905825709144785
        }
        serverSideCondition {
            type: request=Value
            value: COPIAR_CP
        }
    )

    process excluir-interactive-grid (
        name: Excluir Interactive Grid
        type: executeCode
        editableRegion: @gestão-orçamentária-detalhada
        source {
            plsqlCode:
                ```plsql
                DECLARE
                 --
                  --
                BEGIN
                  --
                  IF :APEX$ROW_STATUS = 'D' THEN -- DELETE
                
                 --raise_application_error(-20001,:IDGESTAOORCAMENTARIA);
                  --
                  delete roman.orcamentosmes o 
                  where o.idgestaoorcamentaria = :IDGESTAOORCAMENTARIA; 
                
                  delete roman.propostasorcamentosmes p 
                  where p.idgestaoorcamentaria = :IDGESTAOORCAMENTARIA;
                
                  delete roman.contrapropostasorcamentosmes c
                  where c.idgestaoorcamentaria = :IDGESTAOORCAMENTARIA;
                
                  delete roman.gestaoorcamentaria g
                  where g.idgestaoorcamentaria = :IDGESTAOORCAMENTARIA ;
                  --
                  END IF;
                   
                  COMMIT;
                  
                END;
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 3629101994966369201
        }
    )

    process save-interactive-grid (
        name: Save Interactive Grid
        type: executeCode
        editableRegion: @gestão-orçamentária-detalhada
        source {
            plsqlCode:
                ```plsql
                DECLARE
                 --
                 vvalor_prop  number;
                 vvalor_orcam number;
                 vexiste number;
                 vidgestao      number := :P444_IDGESTAOORCAMENTARIA;
                 vidcentrocusto number := :P444_IDCENTRODECUSTO;
                 vano number;
                 vmesini number;
                 vmesfim number;
                 vorcamentozerado varchar2(2);
                 vano_vigencia number;
                 --
                BEGIN
                
                  IF :APEX$ROW_STATUS = 'C' THEN -- CREATE
                  --
                      begin
                      select referente, mesinicial, mesfinal
                        into vano, vmesini, vmesfim
                        from gestaoorcamentaria w
                       where idgestaoorcamentaria = vidgestao;
                      exception
                       when no_data_found then 
                         raise_application_error(-20001,'Não foi localizado gestão orçamentaria base!');
                      end;
                      --
                     -- RAISE_APPLICATION_ERROR(-20001,' conta='||:IDCONTAFINANCEIRA||' subconta='||:IDSUBCONTAFINANCEIRA);
                      
                      pck_centrodecustos_rmc.prc_geraorcamento_v2(pidcentrodecusto => vidcentrocusto,
                                                                  pano             => vano,
                                                                  pidmes_inicio    => vmesini,
                                                                  pidmes_fim       => vmesfim,
                                                                  pusuario         => v('APP_USER'),
                                                                  pidconta         => :IDCONTAFINANCEIRA,
                                                                  pidsubconta      => :IDSUBCONTAFINANCEIRA,
                                                                  porcamentozerado => vorcamentozerado,
                                                                  pano_vigencia    => vano_vigencia);
                      --
                  END IF;
                  --
                  IF :APEX$ROW_STATUS = 'U' THEN
                  
                      IF :NUMERO = '01' THEN
                          UPDATE contrapropostasorcamentosmes c
                             SET c.janeiro   = REPLACE(:CONTRA_PROPOSTA,'.','')
                           WHERE idcontrapropostaorcamentomes = :IDCONTRAPROPOSTA;
