page 444 (
    name: Administração do Orçamento
    title: Administração do Orçamento
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region definições (
        name: Definições
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region gestão-orçamentária-detalhada (
        name: Gestão Orçamentária Detalhada
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rownum seq_id
                     , x.idgestaoorcamentaria
                     , x.conta
                     , x.subconta
                     , x.mes
                     , to_char(x.proposta,'999G999G990D00') proposta
                     , x.contraproposta contra_proposta
                     , x.orcado orcamento
                     , x.numero
                     , x.idcontrapropostaorcamentomes idcontraproposta
                     , x.idorcamentomes
                     , x.idcontafinanceira
                     , x.idsubcontafinanceira
                     , x.idsubcontafinanceira idsubcontafinanceira_display
                     , initcap(c.nome) as NomeCentroCusto
                     , nvl((select sum(valor) 
                              from roman.vw_despesascentroscustos_m d
                             where d.ano = x.vigencia
                               and d.mes = x.numero
                               and d.conta = x.conta
                               and d.subconta = x.subconta
                               and d.idcentrodecusto = x.idcentrodecusto ),0) as realizado /*Maicon Aimi - 9233147 - 29/10/2024 - Adicioinado a coluna Realizado */
                  from vw_gestaoorcamentaria x
                     , roman.centrodecustos  c
                 where c.idcentrodecusto = x.idcentrodecusto
                   and (     (:P444_IDCENTRODECUSTO is null and exists (select 1
                                                                          from roman.centrodecustos cc
                                                                         where cc.idcentrodecusto = x.idcentrodecusto
                                                                           and cc.tipo in (1,4)))
                          or ( x.idcentrodecusto = :P444_IDCENTRODECUSTO))
                   and x.vigencia = (select vigencia 
                                       from gestaoorcamentaria
                                      where idgestaoorcamentaria = :P444_IDGESTAOORCAMENTARIA)
                   and mesinicial = (select mesinicial
                                       from gestaoorcamentaria
                                      where idgestaoorcamentaria = :P444_IDGESTAOORCAMENTARIA)
                   and mesfinal   = (select mesfinal
                                       from gestaoorcamentaria
                                      where idgestaoorcamentaria = :P444_IDGESTAOORCAMENTARIA)
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            htmlDomId: GOD
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <div style="font-family: Arial, sans-serif; font-size: 15px; color: #003366; text-align: left; padding: 10px; border: 1px solid #5b9bd5; background-color: #e6f0ff;">
                  <strong>Legenda:</strong> <br>
                  <strong>Saldo</strong> = Orçamento - Realizado 
                
                </div>
                <br>
                ```
        }
        customization {
            customizable: shownByDefault
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
