            source {
                databaseColumn: CONTRA_PROPOSTA
                dataType: number
            }
            columnFilter {
                lovType: none
            }
            readOnly {
                type: noRowsReturned
                sqlQuery:
                    ```sql
                    select 1
                    from usuarios u
                       , centrodecustos c
                    where u.idpessoa = c.idpessoaresponsavel
                      and c.idcentrodecusto = :P444_IDCENTRODECUSTO
                      and ( v('APP_USER') = u.usuario or v('APP_USER')='CESARH' )
                      
                    ```
                execute: forEachRow
            }
        )

