    button aplicar-percentual (
        buttonName: APLICAR_PERCENTUAL
        label: Aplicar %
        layout {
            sequence: 70
            region: @definições
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
                t-Button--gapTop
            ]
        }
        behavior {
            action: definedByDynamicAction
            databaseAction: update
        }
    )

    button copiar-cp (
        buttonName: COPIAR_CP
        label: Aceitar Contra-Proposta
        layout {
            sequence: 80
            region: @definições
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
            databaseAction: update
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                  FROM USUARIOS
                 WHERE IDUSUARIO = :P0_IDUSUARIO
                  AND IDGERENTE IN (180,143)
                ```
        }
    )

