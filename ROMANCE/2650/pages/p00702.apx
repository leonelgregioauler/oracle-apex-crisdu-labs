    region últimos-eventos-log-de-comunicação (
        name: Últimos eventos (log de comunicação)
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(l.momento,'DD/MM/RRRR HH24:MI:SS') momento
                     , l.idpix
                     , l.operacao
                     , l.http_status
                     , cast( substr( nvl(l.erro, dbms_lob.substr(l.payload_resp,200,1)), 1, 200)
                            as varchar2(200) ) detalhe
                  from pix_log l
                 order by l.idlog desc
                 fetch first 50 rows only
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent15
