page 702 (
    name: Pix Santander - Acompanhamento
    title: Pix Santander - Acompanhamento
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @autoriza-pix-operador
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--accent5
                t-Region--scrollBody
                t-Form--slimPadding
            ]
            renderComponents: belowContent
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            outputAs: text
        }
    )

    region pagamentos-pix-santander (
        name: Pagamentos Pix Santander
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select apex_item.checkbox2(1, px.idpix
                                          , p_attributes => decode(:P702_MARCARTODOS,'S','CHECKED',null) ) sel
                     , px.idpix
                     , px.idpgtoforn
                     , pck_romance.fnc_nomefornecedor(pf.idfornecedor) fornecedor
                     , to_char(px.valor,'FM999G999G999G990D00') valor
                     , case px.status
                         when 'READY_TO_PAY'         then 'Aguardando autorização'
                         when 'AUTORIZANDO'          then 'Autorizando (em segundo plano)'
                         when 'JA_PAGO_BANCO'       then '(!) Banco: titulo ja pago - conferir extrato'
                         when 'AUTHORIZED'           then 'Autorizado, processando'
                         when 'PENDING_CONFIRMATION' then 'Pendente no banco'
                         when 'PAYED'                then 'Pago'
                         when 'REJECTED'             then 'Rejeitado'
                         when 'ERRO'                 then 'Erro de comunicação'
                         else px.status
                       end situacao
                     , substr(px.reject_reason,1,100) motivo_rejeicao
                     , decode(px.baixado,'S','Sim','Não') baixado
                     , to_char(px.dt_post,'DD/MM HH24:MI')    enviado
                     , to_char(px.dt_patch,'DD/MM HH24:MI')   autorizado
                     , to_char(px.dt_retorno,'DD/MM HH24:MI') retorno
                     , px.usuario_post
                     , px.usuario_patch
                     , (select substr(cbp.beneficiario,1,30) from contasbancarias cbp
                         where cbp.idcontabanc = px.idcontapagamento) conta_pagadora
                     , case px.forma
                         when 'DICT'         then 'Pix (chave)'
                         when 'BENEFICIARIO' then 'Transferência (ag/conta)'
                         when 'BOLETO'       then 'Boleto'
                         else px.forma
                       end forma_pagamento
                  from pix_pagamentos px
                       join pagamentosfornecedores pf on pf.idpgtoforn = px.idpgtoforn
                 where ( :P702_DATAINICIO is null
                         or trunc(px.dt_post) between to_date(:P702_DATAINICIO,'DD/MM/RRRR')
                                                  and nvl(to_date(:P702_DATAFIM,'DD/MM/RRRR'),sysdate) )
                   and ( :P702_STATUS is null or :P702_STATUS = 'TODOS' or px.status = :P702_STATUS )
                   and ( :P702_CONTA is null or px.idcontapagamento = :P702_CONTA )
                   and ( :P702_IDFORNECEDOR is null or pf.idfornecedor = :P702_IDFORNECEDOR )
                   -- Valor digitado como 1.234,56 ou 1234,56. Aproximado = ate 5% para mais ou para menos.
                   and ( :P702_VALOR is null
                         or ( nvl(:P702_VALOR_TIPO,'A') = 'I'
                              and px.valor = to_number(replace(:P702_VALOR,'.',''), '999999999990D99', 'NLS_NUMERIC_CHARACTERS='',.''') )
                         or ( nvl(:P702_VALOR_TIPO,'A') = 'A'
                              and px.valor between to_number(replace(:P702_VALOR,'.',''), '999999999990D99', 'NLS_NUMERIC_CHARACTERS='',.''') * 0.95
                                               and to_number(replace(:P702_VALOR,'.',''), '999999999990D99', 'NLS_NUMERIC_CHARACTERS='',.''') * 1.05 ) )
                 order by px.idpix desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        download {
            csvExportEnabled: true
        }

