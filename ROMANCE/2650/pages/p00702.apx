    button consultar (
        buttonName: CONSULTAR
        label: Reconsultar no Santander
        layout {
            sequence: 10
            region: @pagamentos-pix-santander
            slot: regionBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button desfazer (
        buttonName: DESFAZER
        label: Desfazer Pagamento
        layout {
            sequence: 20
            region: @pagamentos-pix-santander
            slot: regionBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Desfazer os pagamentos selecionados? A fatura volta a ficar disponível para novo envio. Pagamentos JÁ PAGOS em produção não podem ser desfeitos.
            style: danger
        }
    )

    process desfaz-pagamentos-selecionados (
        name: Desfaz pagamentos selecionados
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vok    number := 0;
                  verros number := 0;
                  vmsg   varchar2(32767);
                begin
                  if apex_application.g_f01.count = 0 then
                    apex_error.add_error(
                      p_message          => 'Selecione ao menos um pagamento.',
                      p_display_location => apex_error.c_inline_in_notification);
                    return;
                  end if;
                
                  for i in 1 .. apex_application.g_f01.count loop
                    declare
                      vpayid varchar2(36);
                    begin
                      select px.pix_payment_id into vpayid
                        from roman.pix_pagamentos px
                       where px.idpix = to_number(apex_application.g_f01(i));
                
                      roman.pck_santander_pix.prc_desfazer_pagamento(
                        pidpix   => to_number(apex_application.g_f01(i)),
                        pmotivo  => 'Desfeito pela página 702' ||
                                    case when vpayid is not null and :P702_CIENTE_BANCO = 'S'
                                         then ' - pagamento segue no Santander (id ' || vpayid ||
                                              '), pendente de cancelamento pelo banco' end,
                        pusuario => :APP_USER,
                        pciente_banco => nvl(:P702_CIENTE_BANCO,'N') );
                      vok := vok + 1;
                    exception
                      when others then
                        verros := verros + 1;
                        vmsg := substr(vmsg || 'Pagamento ' || apex_application.g_f01(i) || ': ' ||
                                       sqlerrm || ' | ', 1, 30000);
                    end;
                  end loop;
                
                  if verros > 0 then
                    apex_error.add_error(
                      p_message          => vok || ' desfeito(s), ' || verros || ' com erro. ' || vmsg,
                      p_display_location => apex_error.c_inline_in_notification);
                  end if;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Pagamentos desfeitos. As faturas voltaram a ficar disponiveis na pagina 700.
        }
        advanced {
            executionMappingIdentifier: 971000000000702081
        }
        serverSideCondition {
            whenButtonPressed: @desfazer
        }
    )

    process reconsulta-status-no-santander (
        name: Reconsulta status no Santander
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if apex_application.g_f01.count = 0 then
                    apex_error.add_error(
                      p_message          => 'Selecione ao menos um pagamento.',
                      p_display_location => apex_error.c_inline_in_notification);
                    return;
                  end if;
                
                  for i in 1 .. apex_application.g_f01.count loop
                    begin
                      roman.pck_santander_pix.prc_consultar_status(to_number(apex_application.g_f01(i)));
                    exception
                      when others then null;  -- erro individual fica registrado em pix_log
                    end;
                  end loop;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Consulta executada. Status atualizados.
        }
        advanced {
            executionMappingIdentifier: 971000000000702080
        }
        serverSideCondition {
            whenButtonPressed: @consultar
        }
    )

    branch (
        name: Go To Page 702
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 702
                items: {
                    P702_DATAINICIO: &P702_DATAINICIO.
                    P702_DATAFIM: &P702_DATAFIM.
                    P702_STATUS: &P702_STATUS.
                }
                action: resetPagination
            }
        }
    )

)

