    pageItem P702_CIENTE_BANCO (
        type: radioGroup
        label {
            label: Desfazer mesmo com pagamento vivo no banco
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Não - recusar se o pagamento ainda existir no Santander;N,Sim - assumo o risco de duplicidade;S
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: N
        }
        help {
            helpText: Um pagamento que ainda existe no Santander pode ser efetivado por lá mesmo depois de cancelado aqui. Marque Sim apenas quando o título NÃO for pago por outro canal - por exemplo, quando a conta pagadora foi escolhida errada e a fatura será reenviada pelo hub. O id do pagamento órfão fica registrado no motivo do cancelamento, para pedir o cancelamento ao banco depois.
        }
    )

