page 74 (
    name: Lista de Cheques sem fundo do Representante
    title: Lista de Cheques sem fundo do Representante
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region lista-de-cheques-sem-fundo-do-representante-abertos (
        name: Lista de Cheques sem fundo do Representante (Abertos)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.IDCHEQUE
                     , v('P74_IDFECHAMENTOREPRES') idfechamento
                     , initcap(bb.nomebanco) Banco
                     , c.AGENCIA
                     , c.CONTA
                     , c.NRCHEQUE
                     , c.DATAINCLUSAO
                     , initcap(nvl(pr.apelido,pr.nomepessoa)||' ( '||nvl(pf.apelido,pf.nomepessoa)||' ) ') Representante
                     , initcap(cc.nomecidade)||' - '||upper(ee.sigla) cidade
                     , c.VALOR
                     , c.PREDATADO
                     , c.OBSERVACAO
                     , c.DESTINO
                     , decode(c.semfundo, 'S','Sim', 'Não') Semfundo
                     , decode(c.pago, 'S','Sim', 'Não') Pago
                     , ( select nvl(sum(p.valor),0) from cheques2pgto p where p.idcheque = c.idcheque ) valorpago
                from CHEQUES2 c
                   , bancos   bb
                   , representantes r
                   , gerentes g
                   , pessoas  pr
                   , filiais    f
                   , pessoas    pf
                   , cidades cc
                   , estados ee
                where c.idbanco         = bb.idbanco   (+)
                  and c.idrepresentante = r.idrepresentante(+)
                  and r.idpessoa        = pr.idpessoa(+)
                  and r.idgerente       = g.idgerente
                  and g.idfilial        = f.idfilial(+)
                  and f.idpessoa        = pf.idpessoa(+)
                  and c.idcidade        = cc.idcidade(+)
                  and cc.idestado       = ee.idestado(+)
                  and c.semfundo = 'S'
                  and c.idrepresentante = :P74_IDREPRESENTANTE
                having c.valor > ( select nvl(sum(p.valor),0) from cheques2pgto p where p.idcheque = c.idcheque )
                group by c.IDCHEQUE
                     , bb.nomebanco 
                     , c.AGENCIA
                     , c.CONTA
                     , c.NRCHEQUE
                     , c.DATAINCLUSAO
                     , pr.apelido
                     , pr.nomepessoa
                     , pf.apelido
                     , pf.nomepessoa
                     , cc.nomecidade
                     , ee.sigla
                     , c.VALOR
                     , c.PREDATADO
                     , c.OBSERVACAO
                     , c.DESTINO
                     , c.semfundo
                     , c.pago
                     , c.valor
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 75
                items: {
                    P75_IDFECHAMENTOREPRES: #IDFECHAMENTO#
                    P75_IDCHEQUE: #IDCHEQUE#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil2_16x16.gif" alt="">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhum cheque em aberto para este representante.
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        searchBar {
            includeSearchBar: false
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

