    validation valida-data-de-emissao-do-doc (
        name: Valida Data de Emissao do DOC
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where :P482_DATAEMISSAODOCUMENTO > trunc(sysdate)
                ```
        }
        error {
            errorMessage: Data de Emissão do Documento não pode ser maior que a data atual.
            associatedItem: @P482_DATAEMISSAODOCUMENTO
        }
        serverSideCondition {
            type: request!=Value
            value: DELETE
        }
    )

