            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT c.NOMECIDADE ||' - '||e.SIGLA || ' - '||p.SIGLA   display_value
                     , c.IDCIDADE return_value
                FROM cidades c
                   , estados e
                   , paises p
                WHERE c.idestado = e.IDESTADO 
                  AND e.IDPAIS   = p.IDPAIS 
                ORDER BY 1
