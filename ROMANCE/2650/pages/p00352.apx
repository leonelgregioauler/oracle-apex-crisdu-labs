page 352 (
    name: Centro de Custos
    title: Centro de Custos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region centro-de-custo (
        name: Centro de Custo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDCENTRODECUSTO
                     , NOME
                     , TIPO
                     --, decode(tipo,1,'Gerencial (Rateio Automático)',2,'Unidades de Negócio',3,'Não Operacionais') desctipo
                    , decode(tipo,1,'Gerencial Direto',2,'Unidades de Negócio',3,'Não Operacionais',4,'Gerencial CSC') desctipo --T16604061
                     , pck_romance.fnc_nomepessoa(idpessoaresponsavel) responsavel
                     , nvl(( select count(r.idunidadedenegocio)
                             from rateioscentroscustos r
                             where r.idcentrodecusto = c.idcentrodecusto ),0) unidadesdenegocio
                     , observacao
                     , decode(c.contabilizadespesa,'S','Sim','N','Não') contabilizadespesa
                     , decode(c.contabilizarateio,'S','Sim','N','Não') contabilizarateio
                     , usuario
                     , datacriacao
                     , case c.ativo
                          when 'S' then 'Ativo'
                          when 'N' then 'Inativo'
                          else 'Não informado'
                       end as status
                from CENTRODECUSTOS C
                order by 1
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 12415054955824700
        }

        column CONTABILIZADESPESA (
            type: plainText
            heading {
                heading: Contabiliza Despesa
                alignment: center
            }
            layout {
                sequence: 74
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: K
            }
        )

        column CONTABILIZARATEIO (
            type: plainText
            heading {
                heading: Contabiliza Rateio
                alignment: center
            }
            layout {
                sequence: 84
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: L
            }
        )

        column DATACRIACAO (
            type: plainText
            heading {
                heading: Criado Em
                alignment: center
            }
            layout {
                sequence: 64
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: J
            }
        )

        column DESCTIPO (
            type: plainText
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 14
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column IDCENTRODECUSTO (
            type: link
            heading {
                heading: Ver Centro de Custo
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
            link {
                target: {
                    page: 353
                    items: {
                        P353_IDCENTRODECUSTO: #IDCENTRODECUSTO#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column NOME (
            type: plainText
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column OBSERVACAO (
            type: plainText
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 44
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column RESPONSAVEL (
            type: plainText
            heading {
                heading: Responsável
                alignment: center
            }
            layout {
                sequence: 24
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 94
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: M
            }
        )

        column TIPO (
            type: plainText
            heading {
                heading: Tipo
                alignment: center
            }
            layout {
                sequence: 4
