            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column UNIDADESDENEGOCIO (
            type: plainText
            heading {
                heading: Unidade de Negócios
                alignment: center
            }
            layout {
                sequence: 34
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column USUARIO (
            type: plainText
            heading {
                heading: Criado Por
                alignment: center
            }
            layout {
                sequence: 54
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 124463 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CONTABILIZADESPESA (
                sequence: 11
            )

            displayColumn CONTABILIZARATEIO (
                sequence: 12
            )

            displayColumn DATACRIACAO (
                sequence: 9
            )

            displayColumn DESCTIPO (
                sequence: 4
            )

            displayColumn IDCENTRODECUSTO (
                sequence: 1
            )

            displayColumn NOME (
                sequence: 2
            )

            displayColumn OBSERVACAO (
                sequence: 7
            )

            displayColumn RESPONSAVEL (
                sequence: 5
            )

            displayColumn STATUS (
                sequence: 10
            )

            displayColumn TIPO (
                sequence: 3
            )

            displayColumn UNIDADESDENEGOCIO (
                sequence: 6
            )

            displayColumn USUARIO (
                sequence: 8
            )

            sort (
                column: TIPO
                sort {
                    sequence: 1
                }
            )

            sort (
                column: NOME
                sort {
                    sequence: 2
                }
            )

        )

    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 353
                items: {
                    P353_IDCENTRODECUSTO:
                    P353_MD5:
                    P353_NOME:
                    P353_TIPO:
                }
                clearCache: 353
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction create-button-dialog-closed (
        name: Create Button - Dialog Closed
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @novo
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @centro-de-custo
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

