page 304 (
    name: Depósitos Efetuados
    title: Depósitos Efetuados
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region depositos-efetuados (
        name: Depositos Efetuados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select /*FIRST_ROWS(100)*/dep.idordemdeposito
                     , dep.iddepositodiarios
                     , dep.iddepositodiarios IDDEPOSITO
                     , pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(dep.idrepresentante)) Filial
                     , pck_romance.fnc_nomerepresentante(dep.idrepresentante) Representante
                     , trunc(dep.data)  Data_deposito
                     , to_char(dep.data,'rrrr') ano
                     , to_char(dep.data,'MONTH') MES
                     , to_char(dep.data,'MM') mes_numero
                    -- , to_char(dep.data,'IW/RRRR') SEMANA
                     , pck_util.fnc_semanaid( dep.idsemana ) SEMANA
                     , pck_romance.fnc_nomepessoa(cb.idpessoa) Depositado_para--nvl(contbanc.apelidofornecedor, contbanc.Fornecedor) Depositado_para
                     , dep.idfornecedor
                     , ( select b.nomebanco from bancos b where b.idbanco = cb.idbanco) Banco
                     , cb.agencia ||', '||cb.conta agencia_conta
                     , initcap(cb.beneficiario) beneficiario
                     , dep.valordeposito Valor_depositado
                     , ( select descricao 
                         from tipospagamentos t
                         where t.codigo = dep.tipo ) tipo
                     , decode(dep.comprovado,'S','Sem Comprovante'
                                            ,'C','Cópia'
                                            ,'M','Em Mãos'
                                            ,'G','Com Gerente') Comprovado
                     , dep.nrocomprovante
                     , dep.observacao
                     , dep.observacaogerente "Obs. Gerente"
                     , dep.nroenvelope "Nro Envelope"
                     , ( select f.semana from fechamentorepresentantes f where f.idfechamentorepres = dep.idfechamentorepres ) Fechamento
                     , decode(dep.tipopagamento,'D','Depósito','B','Boleto','AB','Abatimento','VA','Variação Cambial','T','Transferência','Não Informado')  "Tipo Pagamento"
                     , ( select cb.beneficiario||' - '||b.nomebanco
                              ||' - '|| cb.agencia ||' - '||
                              cb.conta
                         from contasbancarias cb
                            , bancos b
                         where cb.idbanco         = b.idbanco 
                           and cb.idcontabanc = ( select idcontabancraiz
                                                  from contasbancarias
                                                  where idcontabanc =  dep.idcontabanc))  "Conta Raíz"
                     , decode(dep.pendencia,'MA', 'Valor Maior'
                                           ,'ME', 'Valor Menor'
                                           ,'NL', 'Não Localizado' ) pendencia
                     , ( select v.descricao
                         from roman.siglasistema s
                            , roman.valorsiglasistema v
                        where s.idsiglasistema = v.idsiglasistema
                          and s.nomesigla      = 'TIPO_FORNECEDOR'
                          and v.sigla          = ff.tipo_fornecedor ) "Tipo Fornecedor"                    
                     , dep.valorlocalizado
                     , dep.dataresolvido
                     , dep.idrepresentante
                     , decode(dep.transferencia,'S','Sim','Não') transferencia
                     , nvl( ( select 'Sim'
                              from dual
                              where exists ( select 1
                                             from depositosdiarios_leituraocr dd
                                             where dd.iddepositodiario = dep.iddepositodiarios
                                               and dd.pix = 'S' )),'Não') pix
                     , decode(o.identificado,'S','Sim','Não') identificado
                     , decode(dep.identificacao,'CA','Carro','CH','Cheque S/ Fundo','EE','Emprestimo','OT','Outro'
                                               ,'CT','Catálogo','TF','Transferência','BC','Boca do Caixa' 
                                               ,'EM','Embalagens') identificacao
                     , ( select /*count(1)||' - '||*/listagg((trim(to_char(nvl(dd.valor_digitado, dd.valor),'999G999G999G999G990D00'))||' - '||dd.nroidentificacao_digitado),'; ') within group (order by 1)
                         from depositosdiarios_leituraocr dd
                         where dd.iddepositodiario = dep.iddepositodiarios ) fotos     
                     -- Maicon Aimi - 9910688 - 11/03/2025 (adicionado a coluna identificacao_comprovante)
                     , ( select listagg((dd.nroidentificacao_digitado),' - ') within group (order by 1)
                         from depositosdiarios_leituraocr dd
                         where dd.iddepositodiario = dep.iddepositodiarios ) identificacao_comprovante
                     , ( select listagg( distinct dd.usuariorevisao, ' - ') within group (order by dd.usuariorevisao)
                         from depositosdiarios_leituraocr dd
                         where dd.iddepositodiario = dep.iddepositodiarios ) revisadopor
                     , nvl(( select sum ( decode ( nvl(pix.valor_digitado,0), 0, nvl(pix.valor,0), pix.valor_digitado ) ) valor
                           from roman.depositosdiarios_leituraocr pix
                          where pix.iddepositodiario = dep.iddepositodiarios
                            and pix.pix = 'S'),0)  as "Valor Pago em PIX"
                     , nvl(dep.valordeposito,0) - nvl( (select sum ( decode ( nvl(pix.valor_digitado,0), 0, nvl(pix.valor,0), pix.valor_digitado ) ) valor
                                                          from roman.depositosdiarios_leituraocr pix
                                                         where pix.iddepositodiario = dep.iddepositodiarios
                                                           and pix.pix = 'S'),0)  as "Valor Pago Por Depósito"
                     ,( select count (1)
                          from roman.depositosdiarios_leituraocr ocr
                         where ocr.iddepositodiario = dep.iddepositodiarios )  comprovantes
                     -- Maicon Aimi - 9928777 - 11/03/2025 (Adicionado a coluna Data_revisao)
                     , ( select max(d.datarevisao)
                           from roman.DEPOSITOSDIARIOS_LEITURAOCR d 
                          where d.iddepositodiario = dep.iddepositodiarios) as data_revisao
                     , ( select min(d.datadeposito)
                           from roman.DEPOSITOSDIARIOS_LEITURAOCR d 
                          where d.iddepositodiario = dep.iddepositodiarios) as data_movimento
                     , dep.observacao observacaosolicitacao
                     , dep.observacao_interna observacaosolicitacaointerna
                from depositosdiarios_orig dep
                   , ordensdepositos o
                   , contasbancarias cb
                   , fornecedores ff
                where o.idcontabancaria   = cb.idcontabanc
                  and dep.idordemdeposito = o.idordemdeposito
                  and dep.idcontabanc     = cb.idcontabanc  
                 -- and cb.idpessoa = ff.idpessoa
                  and ff.idfornecedor = nvl( cb.idfornecedor
                                        , ( select min(ff2.idfornecedor)
                                        from fornecedores ff2
                                        where ff2.idpessoa = cb.idpessoa ) )
                
                  --and rownum <= 100
                  --and dep.data >= '01/01/2025'
                
                  and ( :P304_PIX             is null or exists ( select 1
                                                                  from depositosdiarios_leituraocr dd
                                                                  where dd.iddepositodiario = dep.iddepositodiarios
                                                                    and dd.pix = 'S' ) )
                  and ( :P304_TRANSFERENCIA   is null or exists ( select 1
                                                                  from depositosdiarios_leituraocr dd
                                                                  where dd.iddepositodiario = dep.iddepositodiarios 
                                                                    and dd.transferencia    = 'S' ) )
                  and ( :P304_DATA            is null or trunc(dep.data) = to_date(:P304_DATA) )
                  and ( :P304_IDFORNECEDOR    is null or cb.idpessoa = :P304_IDFORNECEDOR )
                  and ( :P304_TIPO_FORNECEDOR is null or ff.tipo_fornecedor in ( select * from table(apex_string.split(:P304_TIPO_FORNECEDOR, ':'))))
                
                  and ( :P304_IDCONTABANCARIA is null or cb.idcontabanc = :P304_IDCONTABANCARIA )
                  and ( :P304_IDFILIAL is null or exists ( select 1
                                                          from representantes r
                                                             , gerentes g
                                                          where r.idgerente        = g.idgerente
                                                            and g.idfilial         = :P304_IDFILIAL
                                                            and r.idrepresentante  = dep.idrepresentante ) )
                  and ( :P304_IDREPRESENTANTE is null or dep.idrepresentante = :P304_IDREPRESENTANTE )
                  and ( :P304_VALORDEPOSITO   is null or dep.valordeposito = to_number(:P304_VALORDEPOSITO ) )
                  AND :P304_FILTRAR IS NOT NULL
                ```
        }
        layout {
            sequence: 20
            slot: body-1
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: This query returns more than 10,000 rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 1742763105508131049
        }

