    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body-1
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--accent5
                t-Region--scrollBody
                t-Form--slimPadding
            ]
            renderComponents: belowContent
        }
    )

    pageItem P304_DATA (
        type: datePickerJquery
        label {
            label: Data
            alignment: left
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 12
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P304_FILTRAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P304_IDCONTABANCARIA (
        type: popupLov
        label {
            label: Conta
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomepessoa(c.idpessoa)|| ' --- '||  c.beneficiario||' - '|| agencia||'/'||conta||' - '||  b.nomebanco display_value
                     , c.idcontabanc return_value
                from contasbancarias c
                   , bancos b
                where c.idbanco = b.idbanco
                  and c.ativo = 'S'
                  and ( :P304_IDFORNECEDOR is null or c.idpessoa = :P304_IDFORNECEDOR ) 
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Todas -
        }
        cascadingLov {
            parentItems: P304_IDFORNECEDOR
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P304_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome     display_value
                     , idfilial return_value
                from vw_filiais
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P304_IDFORNECEDOR (
        type: popupLov
        label {
            label: Fornecedor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(pe.apelido) display_value
                     , fe.idpessoa return_value
                from fornecedores fe
                    , pessoas     pe
                where fe.idpessoa = pe.idpessoa 
                  and exists ( select 1
                               from ordensdepositos o
                                  , depositosdiarios_orig dr
                                  , contasbancarias c
                               where dr.idordemdeposito = o.idordemdeposito
                                 and o.idcontabancaria  = c.idcontabanc
                                 and fe.idpessoa        = c.idpessoa )
                order by 1
                ```
            nullDisplayValue: " - Todos -"
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 90
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P304_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomepessoa(w.idpessoa) ||' - '||pck_romance.fnc_nomefilial(g.idfilial)     display_value
                     , w.idrepresentante     return_value
                from representantes w
                   ,  gerentes      g
                where g.idgerente = w.idgerente
                  and w.ativo     = 'S'
                  and (:P304_IDFILIAL  is null or g.idfilial  = :P304_IDFILIAL  ) 
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Todos -
        }
        cascadingLov {
            parentItems: P304_IDFILIAL
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P304_PIX (
        type: plugin/simpleCheckbox
        label {
            label: PIX?
            alignment: left
        }
        settings {
            checkedValue: S
        }
        layout {
            sequence: 100
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P304_TIPO_FORNECEDOR (
        type: selectMany
        label {
            label: Tipo Fornecedor
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.descricao, v.sigla
                        from roman.siglasistema s
                           , roman.valorsiglasistema v
                       where s.idsiglasistema = v.idsiglasistema
                         and s.nomesigla      = 'TIPO_FORNECEDOR';
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P304_TRANSFERENCIA (
        type: plugin/simpleCheckbox
        label {
            label: Transferência?
            alignment: left
        }
        settings {
            checkedValue: S
        }
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P304_VALORDEPOSITO (
        type: numberField
        label {
            label: Valor
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 20
            region: @filtros
            slot: belowBox
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button rastrear-depositos (
        buttonName: RASTREAR_DEPOSITOS
        label: Rastrear Fotos
        layout {
            sequence: 10
            region: @filtros
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 367
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 304
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 304
                items: {
                    P304_IDFORNECEDOR: &P304_IDFORNECEDOR.
                    P304_IDCONTABANCARIA: &P304_IDCONTABANCARIA.
                    P304_IDFILIAL: &P304_IDFILIAL.
                    P304_IDREPRESENTANTE: &P304_IDREPRESENTANTE.
                    P304_DATA: &P304_DATA.
                    P304_VALORDEPOSITO: &P304_VALORDEPOSITO.
                    P304_FILTRAR: S
                    P304_TRANSFERENCIA: &P304_TRANSFERENCIA.
                    P304_PIX: &P304_PIX.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: FILTRAR
        }
    )

)

