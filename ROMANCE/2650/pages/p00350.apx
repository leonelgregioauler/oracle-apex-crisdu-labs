page 350 (
    name: Unidades de Negócios
    title: Unidades de Negócios
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region unidades-de-negócios (
        name: Unidades de Negócios
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDUNIDADEDENEGOCIO
                     , NOME
                     , IDSEGMENTONEGOCIO
                     , ( select nome
                         from segmentosnegocios  
                         where idsegmentonegocio = u.idsegmentonegocio ) segmento
                     , IDGRUPONEGOCIO
                     , ( select descricao
                         from gruposnegocios 
                         where idgruponegocio = u.idgruponegocio ) grupo
                     , ( select decode(s.tipo,'A','Grupo de Serviço','C','Grupo Crisdu','N','Grupo Não Operacional')
                         from segmentosnegocios s
                         where s.idsegmentonegocio = u.idsegmentonegocio ) tiposegmento
                     , decode(contabilizarbi,'S','Sim','N','Não') contabilizarbi
                     , decode(ativo,'S','Sim','N','Não') ativo
                     , ( select lu.dataalteracao
                         from logroman.log_unidadesdenegocios lu
                         where lu.idunidadedenegocio = u.idunidadedenegocio
                           and lu.tipoalteracao = 'INSERT' ) data_inclusao
                from UNIDADESDENEGOCIOS u
                  
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 12371524706244935
        }

        column ATIVO (
            type: plainText
            heading {
                heading: Ativo
                alignment: center
            }
            layout {
                sequence: 55
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: J
            }
        )

        column CONTABILIZARBI (
            type: plainText
            heading {
                heading: Contabilizar BI?
                alignment: center
            }
            layout {
                sequence: 45
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        column DATA_INCLUSAO (
            type: plainText
            heading {
                heading: Data Inclusão
                alignment: center
            }
            layout {
                sequence: 65
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: K
            }
        )

        column GRUPO (
            type: plainText
            heading {
                heading: Grupo
                alignment: center
            }
            layout {
                sequence: 25
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column IDGRUPONEGOCIO (
            type: hidden
            heading {
                heading: Idgruponegocio
            }
            layout {
                sequence: 5
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDSEGMENTONEGOCIO (
            type: hidden
            heading {
                heading: Idsegmentonegocio
            }
            layout {
                sequence: 4
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDUNIDADEDENEGOCIO (
            type: link
            heading {
                heading: Ver Unidade
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
            link {
                target: {
                    page: 351
                    items: {
                        P351_IDUNIDADEDENEGOCIO: #IDUNIDADEDENEGOCIO#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column NOME (
            type: plainText
            heading {
                heading: Unidade de Negócio
                alignment: center
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column SEGMENTO (
            type: plainText
            heading {
                heading: Segmento
                alignment: center
            }
            layout {
                sequence: 15
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column TIPOSEGMENTO (
            type: plainText
            heading {
                heading: Tipo do Segmento
                alignment: center
            }
            layout {
                sequence: 35
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 124051 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100000
            }

            displayColumn ATIVO (
                sequence: 7
            )

            displayColumn CONTABILIZARBI (
                sequence: 6
            )

            displayColumn DATA_INCLUSAO (
                sequence: 8
            )

            displayColumn GRUPO (
                sequence: 3
            )

            displayColumn IDUNIDADEDENEGOCIO (
                sequence: 4
            )

            displayColumn NOME (
                sequence: 5
            )

            displayColumn SEGMENTO (
                sequence: 2
            )

            displayColumn TIPOSEGMENTO (
                sequence: 1
            )

            sort (
                column: GRUPO
                sort {
                    sequence: 1
                }
            )

            controlBreak (
                column: TIPOSEGMENTO
                layout {
                    sequence: 1
                }
            )

            controlBreak (
                column: SEGMENTO
                layout {
                    sequence: 2
                }
            )

            controlBreak (
                column: GRUPO
                layout {
                    sequence: 3
                }
            )

        )

    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 351
                items: {
                    P351_IDGRUPONEGOCIO:
                    P351_IDSEGMENTONEGOCIO:
                    P351_IDUNIDADEDENEGOCIO:
                    P351_MD5:
                    P351_NOME:
                }
                clearCache: 351
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction create-button-dialog-closed (
        name: Create Button - Dialog Closed
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @novo
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @unidades-de-negócios
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

