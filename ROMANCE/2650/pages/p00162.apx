page 162 (
    name: Abre anexo
    title: Abre anexo
    appearance {
        pageMode: nonModalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function abrirFoto(url) {
              const w = window.open("", "_blank");
              w.document.write(`
                <html>
                  <head>
                    <title>Foto</title>
                    <style>
                      body {
                        margin: 0;
                        background: #111;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        min-height: 100vh;
                      }
                      img {
                        max-width: 100%;
                        max-height: 100vh;
                        object-fit: contain;
                      }
                    </style>
                  </head>
                  <body>
                    <img src="${url}">
                  </body>
                </html>
              `);
              w.document.close();
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region imagem-bucket (
        name: Imagem Bucket
        type: staticContent
        source {
            htmlCode:
                ```html
                <a href="javascript:void(0);" onclick="abrirFoto('&P162_LINK.')">
                  <img src="&P162_LINK."
                       style="width:360px;height:240px;object-fit:cover;border-radius:8px;box-shadow:0 2px 6px rgba(0,0,0,0.3);" />
                </a>
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: img_foto
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P162_LINK
        }
    )

    region new (
        name: New
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P162_ARQUIVO (
        type: hidden
        layout {
            sequence: 10
            region: @new
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P162_IDANEXODESPESA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @new
            slot: regionBody
        }
    )

    pageItem P162_LINK (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @new
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    process abre-arquivo (
        name: aBRE ARQUIVO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_anexos.prc_abreanexos_web(pnomearquivo => :P162_ARQUIVO);
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 2176627703679296406
        }
        serverSideCondition {
            type: never
        }
    )

    process carrega-link-foto-bucket (
        name: CARREGA_LINK_FOTO_BUCKET
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                select t.url_bucket
                  into :P162_link
                from roman.anexosdespesas t
                where t.idanexodespesa = :P162_IDANEXODESPESA;
                -- 'https://objectstorage.sa-vinhedo-1.oraclecloud.com/n/axt4gfpg90i6/b/bucket-anexos-publico/o/anexos/despesas/'||t.iddespesa||'_'||t.idanexodespesa||'.png'
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 498911969636744212
        }
    )

)

