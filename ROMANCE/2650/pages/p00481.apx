    region lista-de-participantes-da-convenção-2 (
        name: Lista de Participantes da Convenção
        title: Participantes da Convenção + Passagens
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select PP.IDPESSOACONVENCAO 
                     , pck_romance.FNC_NOMEFILIAL(IDFILIAL) empresa
                     , pck_romance.FNC_NOMEREPRESENTANTE(IDREPRESENTANTE)  distribuidor
                     , NOMECOMPLETO
                     , SEXO
                     , DATANASCIMENTO   
                     , NACIONALIDADE  
                     , ''''||DOCUMENTO||'''' DOCUMENTO
                     , ''''||CPF||'''' CPF
                     , DATAEMISSAODOCUMENTO    
                     , ( SELECT   p.nome
                         FROM paises  p
                         WHERE p.idpais =  pp.IDPAISEMISSAODOCUMENTO ) paisemissaodocuennto
                     , DATAVENCIMENTODOCUMENTO 
                     , ( SELECT c.NOMECIDADE
                         FROM cidades c
                         WHERE c.idcidade  = pp.IDCIDADENASCIMENTO ) cidade_nascimento
                     ,  TELEFONE 
                     , EMAIL 
                     , RUA
                     , NUMERO  
                     , CEP 
                     , ( SELECT c.NOMECIDADE
                         FROM cidades c
                         WHERE c.idcidade  = pp.IDCIDADEENDERECO ) cidade_endereco 
                     , PARENTESCO
                     , ( SELECT count(1)
                         FROM anexospessoasconvencao a
                         WHERE a.IDPESSOACONVENCAO = pp.IDPESSOACONVENCAO ) anexos
                     , CABINE
                     , decode(PP.REVISADO,'N','Não','S','Sim') REVISADO
                     , PP.DATAREVISAO
                     , ''''||PP.RG||'''' RG
                     , ''''||PP.CNH||'''' CNH
                     , PP.DATAVENCIMENTOCNH
                     , PP.DOCUMENTOAPRESENTACAO
                     , ( SELECT G.SIGLA
                         FROM GRADES G
                         WHERE G.IDGRADE = PP.Idgradecamiseta ) TAMANHO_CAMISETA
                     , ( SELECT INITCAP(NOMEPESSOA)
                         FROM PESSOAS P
                         WHERE P.IDPESSOA = PP.ACOMPANHANTE_DE ) ACOMPANHANTE_DE
                     , ( SELECT c.NOMECIDADE ||' - '||e.SIGLA || ' - '||p.SIGLA 
                          FROM cidades c
                             , estados e
                             , paises p
                          WHERE c.idestado = e.IDESTADO 
                            AND e.IDPAIS   = p.IDPAIS 
                            AND c.idcidade  = pp.origem )  origem_partida
                     , ( select initcap(p.nomepessoa) 
                         from fornecedores f
                            , pessoas p
                         where p.idpessoa = f.idpessoa
                           and f.idfornecedor = pp.idfornecedor ) fornecedor
                     , ( select s.setor
                         from setoreschamados s
                         where s.idsetorchamado = pp.idsetor ) setor
                     , UPPER(SUBSTR( NOMECOMPLETO, 1, INSTR( NOMECOMPLETO,' ')-1)) NOME
                     , UPPER(substr( NOMECOMPLETO, INSTR( NOMECOMPLETO, ' ', -1))) SOBRENOME
                     , OBSERVACAO
                     , case
                         WHEN DOCUMENTOAPRESENTACAO = 'RG' THEN
                           ''''||RG||''''
                         WHEN DOCUMENTOAPRESENTACAO = 'CNH' THEN
                           ''''||CNH||''''
                         WHEN DOCUMENTOAPRESENTACAO = 'PASSAPORTE' THEN
                           ''''||DOCUMENTO||''''
                         WHEN DOCUMENTOAPRESENTACAO = 'CERTIDAO' THEN
                           ''''||RG||''''
                         ELSE
                           ''''||PP.DOCUMENTO||''''
                       end DOCUMENTO_CRUZEIRO
                     , case
                         WHEN DOCUMENTOAPRESENTACAO = 'RG' THEN
                           add_months(dataemissaodocumento,120) 
                         WHEN DOCUMENTOAPRESENTACAO = 'CNH' THEN
                           PP.DATAVENCIMENTOCNH
                         WHEN DOCUMENTOAPRESENTACAO = 'PASSAPORTE' THEN
                           PP.DATAVENCIMENTODOCUMENTO
                         WHEN DOCUMENTOAPRESENTACAO = 'CERTIDAO' THEN
                           add_months(dataemissaodocumento,120) 
                       end VENCIMENTO_DOCUMENTO
                     , case
                         WHEN DOCUMENTOAPRESENTACAO = 'RG' THEN
                           PP.DATAEMISSAODOCUMENTO
                         WHEN DOCUMENTOAPRESENTACAO = 'CNH' THEN
                           CASE
                             WHEN EXTRACT(YEAR FROM PP.DATAVENCIMENTOCNH) - EXTRACT(YEAR FROM SYSDATE) < 5 THEN
                               add_months(DATAVENCIMENTOCNH,-60)
                             WHEN EXTRACT(YEAR FROM PP.DATAVENCIMENTOCNH) - EXTRACT(YEAR FROM SYSDATE) >= 5 THEN
                               add_months(DATAVENCIMENTOCNH,-120)
                           END
                         WHEN DOCUMENTOAPRESENTACAO = 'PASSAPORTE' THEN
                           CASE
                             when trunc((months_between(sysdate, datanascimento))/12) = 1 THEN
                               add_months(DATAVENCIMENTODOCUMENTO,-12)
                             WHEN trunc((months_between(sysdate, datanascimento))/12) BETWEEN 1 AND 2 THEN
                               add_months(DATAVENCIMENTODOCUMENTO,-24)
                             WHEN trunc((months_between(sysdate, datanascimento))/12) BETWEEN 2 AND 3 THEN
                               add_months(DATAVENCIMENTODOCUMENTO,-36)
                             WHEN trunc((months_between(sysdate, datanascimento))/12) BETWEEN 3 AND 4 THEN
                               add_months(DATAVENCIMENTODOCUMENTO,-48)
                             WHEN trunc((months_between(sysdate, datanascimento))/12) BETWEEN 4 AND 18 THEN
                               add_months(DATAVENCIMENTODOCUMENTO,-60)
                             WHEN trunc((months_between(sysdate, datanascimento))/12) > 18 THEN
                               add_months(DATAVENCIMENTODOCUMENTO,-120)
                           END
                         WHEN DOCUMENTOAPRESENTACAO = 'CERTIDAO' THEN
                           PP.DATAEMISSAODOCUMENTO 
                       end EMISSAO_DOCUMENTO
                     , nvl( ( select 'Sim'
                              from dual
                              where exists ( select 1
                                             from passagensconvencao ps
                                                , pessoaspassagensconvencao pps
                                             where pps.idpassagemconvencao = ps.idpassagemconvencao
                                               and ps.tipo_passagem = 1
                                               and pps.idpessoaconvencao = pp.idpessoaconvencao ) ),'Não') PASSAGEM_COMPRADA_IDA
                     , nvl( ( select 'Sim'
                              from dual
                              where exists ( select 1
                                             from passagensconvencao ps
                                                , pessoaspassagensconvencao pps
                                             where pps.idpassagemconvencao = ps.idpassagemconvencao
                                               and ps.tipo_passagem = 2
                                               and pps.idpessoaconvencao = pp.idpessoaconvencao ) ),'Não') PASSAGEM_COMPRADA_VOLTA
                     , case 
                         when ( select count(1)
                                from passagensconvencao ps
                                   , pessoaspassagensconvencao pps
                                where pps.idpassagemconvencao = ps.idpassagemconvencao
                                  and pps.idpessoaconvencao = pp.idpessoaconvencao ) = 2 then
                           'Sim' 
                         else
                           'Não'
                       end PASSAGEM_COMPLETA
                     , '-' ida
                     , ida.aeroporto_origem aeroporto_partida_ida
                     , ida.aeroporto_destino aeroporto_chegada_ida
                     , ida.companhia companhia_ida
                     , ida.numero_voo numero_voo_ida
                     , ida.localizador localizador_ida
                     , ida.data data_ida
                     , ida.hora_partida hora_partida_ida
                     , ida.hora_chegada hora_chegada_ida
                     , '-' volta
                     , volta.aeroporto_origem
                     , volta.aeroporto_destino
                     , volta.companhia
                     , volta.numero_voo
                     , volta.localizador
                     , volta.data
                     , volta.hora_partida
                     , volta.hora_chegada 
                     , decode(pp.vaiparticipardoevento,'S','Sim','N','Não') "Convenção 05/12"
                     , pp.codigoreserva
                from PESSOASCONVENCAO pp
                   , ( select pa.aeroporto_origem
                            , pa.aeroporto_destino
                            , pa.companhia
                            , pa.numero_voo
                            , pa.localizador
                            , pa.data
                            , pa.hora_partida
                            , pa.hora_chegada 
                            , pp.idpessoaconvencao
                       from passagensconvencao pa
                          , pessoaspassagensconvencao pp
                       where pp.idpassagemconvencao = pa.idpassagemconvencao
                         and pa.tipo_passagem = 1 ) ida
                   , ( select pa.aeroporto_origem
                            , pa.aeroporto_destino
                            , pa.companhia
                            , pa.numero_voo
                            , pa.localizador
                            , pa.data
                            , pa.hora_partida
                            , pa.hora_chegada 
                            , pp.idpessoaconvencao
                       from passagensconvencao pa
                          , pessoaspassagensconvencao pp
                       where pp.idpassagemconvencao = pa.idpassagemconvencao
                         and pa.tipo_passagem = 2 ) volta
                where pp.idpessoaconvencao = ida.idpessoaconvencao(+)
                  and pp.idpessoaconvencao = volta.idpessoaconvencao(+)
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
