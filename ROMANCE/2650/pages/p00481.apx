        buttonName: NOVO
        label: Novo
        layout {
            sequence: 30
            region: @lista-de-participantes-da-convenção-2
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 482
                items: {
                    P482_IDPESSOACONVENCAO:
                }
                clearCache: 482
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: pck_util.fnc_verificaacesso(2700035613,v('APP_USER')) = 'S'
        }
    )

