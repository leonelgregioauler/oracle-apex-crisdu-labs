page 368 (
    name: Rastrear Matrizes
    title: Rastrear Matrizes
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region compras-despesas-encontradas (
        name: Compras / Despesas encontradas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nf.idnotafiscal
                     , v.idvencimento
                     , nf.documento
                     , nf.datainclusao
                     , ( select pck_romance.fnc_nomefornecedor(f.idfornecedor) 
                         from fornecedores f 
                         where f.idfornecedor = nf.idfornemitente ) fornecedor
                     , nf.idfilialdestino
                     , pck_romance.fnc_nomefilial(nf.idfilialdestino) empresa
                     , v.datavencimento
                     , v.valor
                     , ( select nomeconta
                         from contasfinanceiras c
                         where c.idcontafinan = v.idcontafinanceira ) conta
                     , ( select nomeconta
                         from subcontasfinanceiras s
                         where s.idsubcontafinan = v.idsubcontafinanceira ) subconta
                from notasfiscais nf
                   , vencimentos v
                where v.idnotafiscal = nf.idnotafiscal
                  and ( v.idmatrizregradespesa = :P368_IDMATRIZDESPESA
                     or exists ( select 1
                                 from matrizregrasdespesas m
                                 where m.idmatrizregra   = :P368_IDMATRIZDESPESA
                                   and m.idfornecedor    = nf.idfornemitente
                                   and m.idfilial        = nf.idfilialdestino
                                   and m.idcentrodecusto = v.idcentrodecusto
                                   and m.idcontafinan    = v.idcontafinanceira
                                   and m.idsubcontafinan = v.idsubcontafinanceira ) )
                order by nf.idnotafiscal desc
                ```
            pageItemsToSubmit: P368_IDMATRIZDESPESA
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma compra ou despesa localizada para esta matriz!
        }
        advanced {
            savedReportMappingIdentifier: 4409425267841913844
        }

        column CONTA (
            type: plainText
            heading {
                heading: Conta
                alignment: center
            }
            layout {
                sequence: 100
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: K
            }
        )

        column DATAINCLUSAO (
            type: plainText
            heading {
                heading: Data Inclusão
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: E
            }
        )

        column DATAVENCIMENTO (
            type: plainText
            heading {
                heading: Vencimento
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: I
            }
        )

        column DOCUMENTO (
            type: plainText
            heading {
                heading: Documento
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column EMPRESA (
            type: plainText
            heading {
                heading: Empresa
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column FORNECEDOR (
            type: plainText
            heading {
                heading: Fornecedor
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column IDFILIALDESTINO (
            type: hidden
            heading {
                heading: Idfilialdestino
            }
            layout {
                sequence: 60
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDNOTAFISCAL (
            type: link
            heading {
                heading: Ver Nota
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 27
                    items: {
                        P27_IDNOTAFISCAL: #IDNOTAFISCAL#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-view.png" class="apex-edit-view" alt="">
                linkAttributes: target="_blank"
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column IDVENCIMENTO (
            type: hidden
            heading {
                heading: Idvencimento
            }
            layout {
                sequence: 20
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
            security {
                escapeSpecialChars: false
            }
        )

        column SUBCONTA (
            type: plainText
            heading {
                heading: Subconta
                alignment: center
            }
            layout {
                sequence: 110
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: L
            }
        )

        column VALOR (
            type: plainText
            heading {
                heading: Valor
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: J
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 44137025 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CONTA (
                sequence: 8
            )

            displayColumn DATAINCLUSAO (
                sequence: 3
            )

            displayColumn DATAVENCIMENTO (
                sequence: 6
            )

            displayColumn DOCUMENTO (
                sequence: 2
            )

            displayColumn EMPRESA (
                sequence: 5
            )

            displayColumn FORNECEDOR (
                sequence: 4
            )

            displayColumn IDNOTAFISCAL (
                sequence: 1
            )

            displayColumn SUBCONTA (
                sequence: 9
            )

            displayColumn VALOR (
                sequence: 7
            )

        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P368_IDMATRIZDESPESA (
        type: popupLov
        label {
            label: Matriz
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'For: '||pck_romance.fnc_nomefornecedor(m.idfornecedor)||
                       ' Emp: '||pck_romance.fnc_nomefilial(m.idfilial)||
                       ' Centro de Custo: '||( select c.nome
                                               from centrodecustos c
                                               where c.idcentrodecusto = m.idcentrodecusto )||
                       ' Conta: '||( select cf.nomeconta
                                     from contasfinanceiras cf
                                     where cf.idcontafinan = m.idcontafinan  )||
                       ' Sub: '||( select sf.nomeconta
                                     from subcontasfinanceiras sf
                                     where sf.idsubcontafinan = m.idsubcontafinan ) display_value
                     , m.idmatrizregra return_value
                from matrizregrasdespesas m
                order by pck_romance.fnc_nomefornecedor(m.idfornecedor)
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 150
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction escolhe-matriz (
        name: Escolhe Matriz
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P368_IDMATRIZDESPESA
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @compras-despesas-encontradas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

