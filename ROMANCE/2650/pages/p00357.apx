page 357 (
    name: Regra de Receita de Unidade de Negocio
    title: Regra de Receita de Unidade de Negocio
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region new (
        name: New
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
    )

    region regra-de-receita-de-unidade-de-negocio (
        name: Regra de Receita de Unidade de Negocio
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "IDREGRARECEITA",
                "IDREGRARECEITA" IDREGRARECEITA_DISPLAY,
                "IDSUBCONTAFINAN",
                "IDUNIDADEDENEGOCIO",
                "REGRAAUTOMATIZADA"
                from "#OWNER#"."REGRASRECEITASUNIDADESNEG"
                where idsubcontafinan = :P357_IDSUB
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhuma regra definida.
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 6
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column IDREGRARECEITA (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDREGRARECEITA
            }
        )

        column IDREGRARECEITA_DISPLAY (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

        column IDSUBCONTAFINAN (
            reportColumnQueryId: 3
            derivedColumn: N
            type: selectList
            heading {
                heading: Sub Conta Financeira
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select s.nomeconta
                         , s.idsubcontafinan
                    from subcontasfinanceiras s
                    where s.idsubcontafinan = :P357_IDSUB
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 4
            }
        )

        column IDUNIDADEDENEGOCIO (
            reportColumnQueryId: 4
            derivedColumn: N
            type: selectList
            heading {
                heading: Unidade de Negócio
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select nome
                         , idunidadedenegocio
                    from unidadesdenegocios 
                    order by 1
                    ```
                displayExtraValues: false
            }
            layout {
                sequence: 5
            }
        )

        column REGRAAUTOMATIZADA (
            reportColumnQueryId: 5
            derivedColumn: N
            type: textField
            heading {
                heading: Regra
                alignment: center
            }
            layout {
                sequence: 6
            }
            appearance {
                width: 30
            }
        )

    )

    pageItem P357_IDCONTA (
        type: textField
        label {
            label: Idconta
            alignment: left
        }
        layout {
            sequence: 10
            region: @new
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P357_IDSUB (
        type: textField
        label {
            label: New
            alignment: left
        }
        layout {
            sequence: 20
            region: @new
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button add (
        buttonName: ADD
        label: Adicionar +
        layout {
            sequence: 40
            region: @regra-de-receita-de-unidade-de-negocio
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.widget.tabular.addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button multi-row-delete (
        buttonName: MULTI_ROW_DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @regra-de-receita-de-unidade-de-negocio
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Deseja deletar as regras selecionadas?','MULTI_ROW_DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Criar Regras
        layout {
            sequence: 30
            region: @regra-de-receita-de-unidade-de-negocio
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @regra-de-receita-de-unidade-de-negocio
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 14
                items: {
                    P14_IDCONTAFINAN: &P357_IDCONTA.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @regra-de-receita-de-unidade-de-negocio
        target {
            tableName: REGRASRECEITASUNIDADESNEG
            pkColumn: IDREGRARECEITA
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: #MRD_COUNT# row(s) deleted.
        }
        advanced {
            executionMappingIdentifier: 12585234604375962
        }
        serverSideCondition {
            type: request=Value
            value: MULTI_ROW_DELETE
            executeCondition: once
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @regra-de-receita-de-unidade-de-negocio
        target {
            tableName: REGRASRECEITASUNIDADESNEG
            pkColumn: IDREGRARECEITA
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# row(s) updated, #MRI_COUNT# row(s) inserted.
        }
        advanced {
            executionMappingIdentifier: 12584894693375962
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        name: Go To Page 357
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 357
                items: {
                    P357_IDCONTA: &P357_IDCONTA.
                    P357_IDSUB: &P357_IDSUB.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('MULTI_ROW_DELETE','SUBMIT')
        }
    )

)

