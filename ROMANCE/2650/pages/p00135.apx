page 135 (
    name: Cadastro de Distribuidor
    title: Cadastro de Distribuidor
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 70%
        height: 70%
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region cadastro-de-representante (
        name: Cadastro de Representante
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P135_ATIVO (
        type: selectList
        label {
            label: Ativo
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @cadastro-de-representante
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: ATIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P135_IDCOMISSAO (
        type: selectList
        label {
            label: Comissão
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(c.percpromotor,'999G999G990D00')||'%' display_value
                     , c.idcomissaofilial return_value
                from comissoesfiliais         c
                where c.idfilial = ( select idfilial
                                     from gerentes 
                                     where idgerente = :P135_IDGERENTE )
                order by 2
                ```
        }
        cascadingLov {
            parentItems: P135_IDGERENTE
        }
        layout {
            sequence: 35
            region: @cadastro-de-representante
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDCOMISSAO
            used: always
        }
        readOnly {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1  -- 9978740 -- Apenas TI e Controladoria podem alterar o campo
                  from roman.usuariosgruposatendimento uga
                 where uga.idgrupoatendimento in (0,2) -- TI / Controladoria de Despesas
                   and uga.usuario = v('APP_USER')
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P135_IDFILIAL (
        type: hidden
        layout {
            sequence: 50
            region: @cadastro-de-representante
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P135_IDGERENTE (
        type: selectList
        label {
            label: Gerente
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa||' ( '||c.nomecidade)||' - '||e.sigla||' )' display_value
                     , g.idgerente return_value
                from gerentes g
                   , pessoas p
                   , cidades c
                   , estados e
                where g.idpessoa = p.idpessoa
                  and p.idcidade = c.idcidade
                  and c.idestado = e.idestado
                  and g.ativo    = 'S'
                order by 1
                ```
            nullDisplayValue: - Selecione o Gerente -
        }
        layout {
            sequence: 15
            region: @cadastro-de-representante
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDGERENTE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P135_IDPESSOA (
        type: hidden
        layout {
            sequence: 20
            region: @cadastro-de-representante
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDPESSOA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P135_IDREPRESENTANTE (
        type: hidden
        layout {
            sequence: 1
            region: @cadastro-de-representante
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDREPRESENTANTE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P135_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @cadastro-de-representante
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
            height: 3
        }
        validation {
            maxLength: 150
        }
        source {
            type: databaseColumn
            databaseColumn: OBSERVACAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 30
            region: @cadastro-de-representante
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P135_IDREPRESENTANTE
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 10
            region: @cadastro-de-representante
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P135_IDREPRESENTANTE
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Alterações
        layout {
            sequence: 20
            region: @cadastro-de-representante
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P135_IDREPRESENTANTE
        }
    )

    process fetch-row-from-representantes (
        name: Fetch Row from REPRESENTANTES
        type: autoRowFetch
        source {
            tableOwner: CATAL
            tableName: REPRESENTANTES
            pkColumn: IDREPRESENTANTE
            pkItem: P135_IDREPRESENTANTE
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Não é possível extrair a linha.
        }
        advanced {
            executionMappingIdentifier: 184655415283973986
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDREPRESENTANTE.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P135_IDREPRESENTANTE := get_pk; 
                end;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Não é possível obter valor de item de chave primária.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 184655619548973986
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-representantes (
        name: Process Row of REPRESENTANTES
        type: autoRowProcessing
        target {
            tableOwner: CATAL
            tableName: REPRESENTANTES
            pkColumn: IDREPRESENTANTE
            pkItem: P135_IDREPRESENTANTE
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        error {
            errorMessage: Não é possível processar a linha da tabela REPRESENTANTES.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 184655830478973986
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 184656018971973987
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 135
            }
            saveStateBeforeBranching: true
        }
    )

)

