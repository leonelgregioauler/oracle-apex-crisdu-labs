page 55 (
    name: Cadastro de Comissões por Filial
    title: Cadastro de Comissões por Filial
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region cadastro-de-comissões-por-filial (
        name: Cadastro de Comissões por Filial
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P55_ATIVO (
        type: selectList
        label {
            label: Ativo
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Sim;S,Não;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @cadastro-de-comissões-por-filial
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: ATIVO
            used: always
        }
        default {
            type: static
            staticValue: S
        }
    )

    pageItem P55_IDCOMISSAOFILIAL (
        type: hidden
        layout {
            sequence: 1
            region: @cadastro-de-comissões-por-filial
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDCOMISSAOFILIAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P55_IDFILIAL (
        type: selectList
        label {
            label: Filial
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(apelido,p.nomepessoa)) display_value
                     , f.idfilial return_value
                from filiais f
                   , pessoas p
                where p.idpessoa = f.idpessoa
                order by 1 
                ```
            nullDisplayValue: - Selecione a Filial -
        }
        layout {
            sequence: 20
            region: @cadastro-de-comissões-por-filial
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIAL
            used: always
        }
        readOnly {
            type: itemIsNotNull
            item: P55_IDFILIAL
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P55_PERCPROMOTOR (
        type: numberField
        label {
            label: % Promotor
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 70
            region: @cadastro-de-comissões-por-filial
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 6
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: PERCPROMOTOR
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P55_VLRFINAL (
        type: numberField
        label {
            label: " até "
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 40
            region: @cadastro-de-comissões-por-filial
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 15
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: VLRFINAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P55_VLRINICIAL (
        type: numberField
        label {
            label: De
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 30
            region: @cadastro-de-comissões-por-filial
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 15
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: VLRINICIAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Inlcuir
        layout {
            sequence: 40
            region: @cadastro-de-comissões-por-filial
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P55_IDCOMISSAOFILIAL
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @cadastro-de-comissões-por-filial
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P55_IDCOMISSAOFILIAL
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar Alterações
        layout {
            sequence: 30
            region: @cadastro-de-comissões-por-filial
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P55_IDCOMISSAOFILIAL
        }
    )

    process fetch-row-from-comissoesfiliais (
        name: Fetch Row from COMISSOESFILIAIS
        type: autoRowFetch
        source {
            tableName: COMISSOESFILIAIS
            pkColumn: IDCOMISSAOFILIAL
            pkItem: P55_IDCOMISSAOFILIAL
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Unable to fetch row.
        }
        advanced {
            executionMappingIdentifier: 178753912838163627
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDCOMISSAOFILIAL.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P55_IDCOMISSAOFILIAL := get_pk; 
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Unable to get primary key item value.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 178754118362163627
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-comissoesfiliais (
        name: Process Row of COMISSOESFILIAIS
        type: autoRowProcessing
        target {
            tableName: COMISSOESFILIAIS
            pkColumn: IDCOMISSAOFILIAL
            pkItem: P55_IDCOMISSAOFILIAL
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        error {
            errorMessage: Unable to process row of table COMISSOESFILIAIS.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 178754340949163629
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 178754513385163629
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 54
            }
            saveStateBeforeBranching: true
        }
    )

)

