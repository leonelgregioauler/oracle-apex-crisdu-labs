page 243 (
    name: Favorita
    title: Favorita
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region boletos-quitados (
        name: Boletos Quitados
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select null link
                     , trunc(databaixa) display_value
                     , sum(b.valorcobrado) "Valor Quitado"
                     , count(1) "Qtd Boletos"
                from boletos b
                where trunc(b.databaixa) >= trunc(sysdate) - 7
                group by trunc(databaixa)  
                order by 2 
                ```
        }
        layout {
            sequence: 40
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            escapeSpecialChars: false
        }
        chart {
            type: line
        }
        title {
            title: Boletos Quitados
        }
        chartLayout {
            maxWidth: 700
            height: 350
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        tooltip {
            showSeriesName: false
        }
        legend {
            position: bottom
            hideAndShowBehavior: none
        }
        messages {
            whenNoDataFound: No data found.
        }

        series series (
            name: Series 1
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: "\"2\""
                value: "\"3\""
            }
            marker {
                shape: circle
            }
            label {
                show: true
                position: aboveMarker
            }
            performance {
                maxRowsToProcess: 15
            }
        )

        axis x (
            name: x
            title: Dia
            value {
                formatScaling: none
            }
            minorTicks {
                show: true
            }
        )

        axis y (
            name: y
            title: Valor
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            majorTicks {
                show: false
            }
            minorTicks {
                show: false
            }
        )

    )

    region pedidos-de-hoje-por-empresa (
        name: Pedidos de Hoje por Empresa
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select null link
                     , pck_romance.fnc_nomefilial(idfilial) label
                     , sum(p.vlrtotalsemcomissao) value1
                from pedidos p
                where trunc(p.dtemissao) = trunc(sysdate)
                  and p.situacao != 'C'
                group by idfilial
                ```
        }
        layout {
            sequence: 30
            slot: body-3
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            escapeSpecialChars: false
        }
        chart {
            type: donut
        }
        title {
            title: Pedidos de Hoje por Empresa
        }
        chartLayout {
            maxWidth: 700
            height: 400
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        value {
            format: decimal
            formatScaling: none
        }
        legend {
            show: false
        }
        messages {
            whenNoDataFound: No data found.
        }

        series series (
            name: Series 1
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: "\"2\""
                value: "\"3\""
            }
            label {
                show: true
                position: outsideSlice
            }
            performance {
                maxRowsToProcess: 15
            }
        )

    )

    region pedidos-realizados (
        name: Pedidos Realizados
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select null link
                     , trunc(p.dtemissao) label
                     , sum(p.vlrtotalsemcomissao) "Vlr S/ Comis"
                     , count(1) "Qtd Pedidos"
                from pedidos p
                where trunc(p.dtemissao) >= trunc(sysdate)-7
                  and p.situacao != 'C'
                  and p.tipo = 'P'
                group by trunc(p.dtemissao)
                order by 2
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            escapeSpecialChars: false
        }
        chart {
            type: line
        }
        title {
            title: Pedidos Realizados
        }
        chartLayout {
            maxWidth: 900
            height: 500
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        animation {
            onDataChange: none
        }
        tooltip {
            showSeriesName: false
        }
        legend {
            position: bottom
            hideAndShowBehavior: none
        }
        messages {
            whenNoDataFound: No data found.
        }

        series pedidos (
            name: Pedidos
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: "\"2\""
                value: "\"3\""
            }
            marker {
                shape: circle
            }
            label {
                show: true
                position: aboveMarker
            }
            performance {
                maxRowsToProcess: 15
            }
        )

        axis x (
            name: x
            title: Dia
            value {
                formatScaling: none
            }
            minorTicks {
                show: true
            }
        )

        axis y (
            name: y
            title: Valor
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            majorTicks {
                show: false
            }
            minorTicks {
                show: false
            }
        )

    )

)

