page 254 (
    name: Detalhes da Filial
    title: Detalhes da Filial
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region detalhes-da-filial (
        name: Detalhes da Filial
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select filial 
                     , idfilial
                     , semana
                     , semanacobranca semanacobranca
                     , totalmercadorias *-1 totalmercadorias 
                     , totaltransferencias  totaltransferencias
                     , f.totalcobranca totalcobranca
                     , (f.totaldespesas+f.impostos) *-1 totaldespesas
                     , f.totalcomissoes *-1 totalcomissoes
                     , f.comisromanrepres*-1 comisromanrepres
                     , f.comissromanger*-1 comissromanger
                     , f.valorliquido   valorliquido
                     , f.ResultadodaSemana ResultadodaSemana
                     , f.percdespesa percdespesa
                     , f.Notasnovas Notasnovas
                     , f.NrodeAcertos NrodeAcertos
                     , f.TotalVendaFavorita  TotalVendaFavorita
                     , f.percvendafavorita  percvendafavorita 
                     , nvl(totalboletosfavorita,0)          totalboletosfavorita
                     , nvl(totalchqsemfundorecebidos,0)     totalchqsemfundorecebidos
                     , nvl(totaldepositosespecie,0)         totaldepositosespecie
                     , nvl(totaldepsitoscheques,0)          totaldepsitoscheques
                     , nvl(f.comissfavrepres,0)  comissfavrepres
                     , nvl(f.comissfavgerente,0) comissfavgerente
                     , '|' pepino
                     , f.debitosnovos debitosnovos
                     , f.debitospagos debitospagos
                     , f.saldodebitos saldodebitos
                     , f.saldodebitosacumulado saldodebitosacumulado 
                     , f.idsemana
                     , f.impostos *-1 impostos
                from vw_fechamentosdistribuidoras f
                where idsemana between to_number(:P254_SEMANAINI) and to_number(:P254_SEMANAFIM)
                  and idfilial = :P254_IDFILIAL
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            subscription: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 242875720388249099
        }

