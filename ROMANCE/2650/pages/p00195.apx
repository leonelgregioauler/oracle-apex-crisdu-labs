        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        validation {
            maxLength: 10
        }
        advanced {
            customAttributes: "onkeyPress=\"javascript:{formatar_mascara(this, '#####-###',event); }\""
        }
        source {
            type: databaseColumn
            databaseColumn: CEP
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

