    )

    validation p195-cnpj-2 (
        name: P195_CNPJ
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vvalida   boolean;
                  vteste    number;
                begin
                  --
                  vvalida := pck_romance.validacnpj(:P195_CNPJ);
                  vteste  := sys.diutil.bool_to_int(vvalida );
                  --
                  if vteste  = 2 then
                    return 'CNPJ informado não é válido!';
                  end if;
                  --
                end;
                ```
        }
        error {
            associatedItem: @P195_CNPJ
        }
    )

