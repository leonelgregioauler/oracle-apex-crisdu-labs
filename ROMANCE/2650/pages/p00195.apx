    process fetch-row-from-mei (
        name: Fetch Row from MEI
        type: autoRowFetch
        source {
            tableName: MEI
            pkColumn: IDMEI
            pkItem: P195_IDMEI
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 540235700427714171
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P195_IDMEI is null then
                        select "SEQ_IDMEI".nextval
                          into :P195_IDMEI
                          from dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 540235901983714172
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-mei (
        name: Process Row of MEI
        type: autoRowProcessing
        target {
            tableName: MEI
            pkColumn: IDMEI
            pkItem: P195_IDMEI
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        advanced {
            executionMappingIdentifier: 540236123520714172
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        clear {
            type: pages
            pages: 121
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 540236305870714172
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 195
            }
        }
    )

)

