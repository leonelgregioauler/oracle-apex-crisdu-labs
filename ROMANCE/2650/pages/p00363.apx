page 363 (
    name: Inconsistência de Lançamentos
    title: Inconsistência de Lançamentos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region despesas-de-caixas (
        name: Despesas de Caixas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.iddespesa
                     , d.datalancamento
                     , d.idfilial
                     , pck_romance.fnc_nomefilial(d.idfilial) empresa
                     , d.valor
                     , d.observacao
                     , d.idcontacontabil
                     , ( select nomeconta
                         from contasfinanceiras c
                         where c.idcontafinan = d.idcontacontabil ) conta
                     , d.idsubcontacontabil
                     , ( select nomeconta
                         from subcontasfinanceiras s
                         where s.idsubcontafinan = d.idsubcontacontabil ) subconta
                from despesas d
                where d.datalancamento between to_date(:P363_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P363_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                  and not exists ( select 1
                                   from matrizclassificacoesdespesas m
                                   where m.idcontafinan = d.idcontacontabil
                                     and m.idsubcontafinan = d.idsubcontacontabil
                                     and m.idfilial = d.idfilial )
                  and d.idfechamento is not null
                order by 2
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P363_TIPO_LANCAMENTO
            value: P
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma informação encontrada.
        }
        advanced {
            savedReportMappingIdentifier: 51429511509136208
        }

