    region notas-de-compras-e-despesas (
        name: Notas de Compras e Despesas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nf.idnotafiscal
                     , nf.documento
                     , nf.datainclusao
                     , nf.idfornemitente idfornecedor
                     , pck_romance.fnc_nomefornecedor(nf.idfornemitente) fornecedor
                     , nf.idfilialdestino
                     , pck_romance.fnc_nomefilial(nf.idfilialdestino) empresa
                     , v.datavencimento
                     , v.valor
                     , v.idcontafinanceira
                     , ( select nomeconta
                         from contasfinanceiras c
                         where c.idcontafinan = v.idcontafinanceira ) conta
                     , v.idsubcontafinanceira
                     , ( select nomeconta
                         from subcontasfinanceiras s
                         where s.idsubcontafinan = v.idsubcontafinanceira ) subconta
                from notasfiscais nf
                   , vencimentos v
                where v.idnotafiscal = nf.idnotafiscal
                  and nf.datainclusao between to_date(:P363_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P363_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                  and nf.tiponota = :P363_TIPO_LANCAMENTO
                  and v.idcentrodecusto is null
                  and v.idcontafinanceira is not null
                  and not exists ( select 1
                                   from matrizregrasdespesas md
                                   where md.idfornecedor       = nf.idfornemitente
                                     and md.idfilial           = nf.idfilialdestino
                                     and md.idcontafinan       = v.idcontafinanceira )
                  and :P363_TIPO_LANCAMENTO in ('D','C')
                order by 3
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P363_TIPO_LANCAMENTO in ('D','C')
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma informação encontrada.
        }
        advanced {
            savedReportMappingIdentifier: 51427930382136192
        }

