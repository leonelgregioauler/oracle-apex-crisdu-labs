    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 363
                items: {
                    P363_TIPO_LANCAMENTO: &P363_TIPO_LANCAMENTO.
                    P363_DATAINICIO: &P363_DATAINICIO.
                    P363_DATAFIM: &P363_DATAFIM.
