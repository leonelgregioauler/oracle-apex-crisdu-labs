    region lucratividade-distribuidoras-por-empresa (
        name: Lucratividade Distribuidoras (Por Empresa)
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select filial "Filial"
                     , idfilial
                     , sum(totalmercadorias) *-1 "Total Mercadorias"
                     , sum(totaltransferencias)  "Total Transferências"--saídas
                     , sum(f.totalcobranca) "Total Cobrança"
                     , (sum(f.totaldespesas)+sum(impostos)) *-1 "Total de Despesas"
                     , sum(f.totalcomissoes) *-1 "Comissões"
                     , sum(f.comisromanrepres) *-1 "Comissões Representantes"
                     , sum(f.comissromanger) *-1 "Comissões Gerente"
                     , sum(f.valorliquido)    "Valor Liquido"
                     , sum(f.ResultadodaSemana) "Resultado da Semana"
                     , (sum(f.totaldespesas)+sum(f.totalcomissoes)) *-1 "Despesas+Comissões"
                     , case 
                          when sum(f.totalcobranca) > 0  then
                            round((sum(f.totaldespesas)+sum(f.impostos)+sum(f.totalcomissoes)) *100 /  sum(f.totalcobranca),2)
                           else
                             0
                           end  "% Despesa e Comis"
                     , case 
                          when sum(f.totalcobranca) > 0  then
                             round((sum(f.totalcomissoes)) *100 /  sum(f.totalcobranca),2)
                           else
                             0
                           end  "% Despesa S/ Com"
                     , case 
                          when sum(f.totalcobranca) > 0  then
                             round((sum(f.comissromanger)) *100 /  sum(f.totalcobranca),2)
                           else
                             0
                           end  "% Comis Ger"
                     , case 
                          when sum(f.totalcobranca) > 0  then
                             round((sum(f.comisromanrepres)) *100 /  sum(f.totalcobranca),2)
                           else
                             0
                           end  "% Comis Distrib"
                     , sum(f.Notasnovas) "Notas novas"
                     , sum(f.NrodeAcertos) "Nro de Acertos"
                     , sum(f.totalvendadireta) "Total Venda Direta"
                     , sum(f.TotalVendaFavorita)   "Total Venda Favorita"
                     , sum(f.percvendafavorita ) "% Venda Favorita"
                     , sum(nvl(totalboletosfavorita,0))          totalboletosfavorita
                     , sum(nvl(totalchqsemfundorecebidos,0))     totalchqsemfundorecebidos
                     , sum(nvl(totaldepositosespecie,0))         totaldepositosespecie
                     , sum(nvl(totaldepsitoscheques,0))          totaldepsitoscheques
                     , sum(nvl(f.comissfavrepres,0) ) totalcomissoesfavoritarepres
                     , sum(nvl(f.comissfavgerente,0)) totalcomissoesfavoritagerente
                     , '|' pepino
                     , sum(f.debitosnovos )*-1 "Pepinos Novos"
                     , sum(f.debitospagos) "Pepinos Pagos"
                     , sum(f.saldodebitos) "Saldo"
                     , max(f.saldodebitosacumulado) "Saldo Acumulado" 
                     , case
                         when sum(f.totalcobranca) > 0 then
                           sum(f.ResultadodaSemana) / sum(f.totalcobranca) * 100
                         else
                           0
                         end "% Lucro"
                     , sum(f.qtdnotasacertadas) qtdnotasacertadas
                    -- ,  '<a href="javascript: fnc_abre('||idfilial||','||:P253_SEMANAINI||','||:P253_SEMANAFIM||')"><img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt=""></a>'  detalhe
                     , null detalhe
                     , :P253_SEMANAINI idsemanaini
                     , :P253_SEMANAFIM idsemanafim
                
                     , case 
                         when sum(f.totalcobranca) > 0  then
                            sum(totalmercadorias) *100 / sum(f.totalcobranca) 
                          else
                            0
                          end "% Compra sobre Cobrança"
                     , sum(f.totaldebitosnovos ) totaldebitosnovos
                     , sum(f.totaldebitorecebidos ) totaldebitorecebidos
                     , sum(f.totaldebitorecebidos - f.totaldebitosnovos ) saldos
                     , case 
                         when sum(f.totalcobranca) > 0  then
                             sum(  f.totaldebitorecebidos - f.totaldebitosnovos ) * 100 / sum(f.totalcobranca) 
                          else
                            0
                          end "% Saldo Debitos sobre Cobrança"
                     , sum(impostos)*-1 impostos
                from ( select filial 
                           , idfilial
                           , idsemana
                           , semanacobranca
                           , totalmercadorias 
                           , totaltransferencias
                           , totalcobranca
                           , totaldespesas
                           , totalcomissoes
                           , comisromanrepres
                           , comissromanger
                           , valorliquido
                           , ResultadodaSemana
                           , percdespesa
                           , Notasnovas
                           , NrodeAcertos
                           , TotalVendaFavorita
                           , percvendafavorita 
                           , totalvendadireta
                           , totalboletosfavorita
                           , totalchqsemfundorecebidos
                           , totaldepositosespecie
                           , totaldepsitoscheques
                           , comissfavrepres
                           , comissfavgerente
                           , '|' pepino
                           , debitosnovos
                           , debitospagos
                           , saldodebitos
                           , saldodebitosacumulado 
                       /*    , semanacobranca        semanacobranca
                           , totalmercadorias      totalmercadorias 
                           , totaltransferencias   totaltransferencias
                           , f.totalcobranca       totalcobranca
                           , f.totaldespesas       totaldespesas
                           , f.totalcomissoes      totalcomissoes
                           , f.comisromanrepres    comisromanrepres
                           , f.comissromanger      comissromanger
                           , f.valorliquido        valorliquido
                           , f.ResultadodaSemana   ResultadodaSemana
                           , f.percdespesa         percdespesa
                           , f.Notasnovas          Notasnovas
                           , f.NrodeAcertos        NrodeAcertos
                           , f.TotalVendaFavorita  TotalVendaFavorita
                           , f.percvendafavorita   percvendafavorita 
                           , f.totalvendasdiretas  totalvendadireta
                           , nvl(totalboletosfavorita,0)          totalboletosfavorita
                           , nvl(totalchqsemfundorecebidos,0)     totalchqsemfundorecebidos
                           , nvl(totaldepositosespecie,0)         totaldepositosespecie
                           , nvl(totaldepsitoscheques,0)          totaldepsitoscheques
                           , nvl(f.comissfavrepres,0)  comissfavrepres
                           , nvl(f.comissfavgerente,0) comissfavgerente
                           , '|' pepino
                           , f.debitosnovos           debitosnovos
                           , f.debitospagos           debitospagos
                           , f.saldodebitos           saldodebitos
                           , f.saldodebitosacumulado  saldodebitosacumulado */
                           , qtdnotasacertadas
                           , f.totaldebitosnovos
                           , f.totaldebitorecebidos
                           , f.impostos
                      from vw_fechamentosdistribuidoras_mv f
                      where idsemana between to_number(:P253_SEMANAINI) and to_number(:P253_SEMANAFIM)
                        and exists ( select 1
                                     from usuariosfiliais u
                                     where u.idfilial = f.idfilial
                                       and u.usuario  = v('APP_USER') ) ) f
                group by filial,idfilial
                
                ```
        }
