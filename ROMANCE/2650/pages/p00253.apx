    region lucratividade-por-empresa (
        name: Lucratividade por Empresa
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
    )

    region new (
        name: New
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @lucratividade-distribuidoras-por-empresa
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P253_PERCDESPESA (
        type: displayOnly
        label {
            label: .
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 10
            region: @new
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '% Despesa: '||TRIM(to_char( ( ( sum(totaldespesas) + nvl(sum(impostos),0) + sum(F.totalcomissoes) ) * 100 /  sum(totalcobranca) ),'999G990D00')) 
                    ||'<br> % Favorita: '||TRIM(to_char( ( sum(totalvendafavorita)  * 100 /  sum(totalcobranca) ),'999G990D00')) 
                    ||'<br> % Resultado: '|| TRIM(to_char( ( sum(f.ResultadodaSemana) * 100 /  sum(totalcobranca) ),'999G990D00'))  perc
                from VW_FECHAMENTOSDISTRIBUIDORAS_MV f
                where idsemana between to_number(:P253_SEMANAINI) and to_number(:P253_SEMANAFIM)
                    and exists ( select 1
                                     from usuariosfiliais u
                                     where u.idfilial = f.idfilial
                                       and u.usuario  = v('APP_USER') )
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P253_PROXIMAATUALIZACAO (
        type: displayOnly
        label {
            label: " "
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 10
            region: @lucratividade-distribuidoras-por-empresa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<font color"green">Atualizado em '|| to_char(a.last_start_date,'dd/mm/rrrr hh24:mi:ss')||', a próxima atualização será '|| to_char(next_run_date,'dd/mm/rrrr hh24:mi:ss')||'</font>' a
                from all_scheduler_jobs a
                where a.job_action like '%VW_FECHAMENTOSDISTRIBUIDORAS_MV%';
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P253_SEMANAFIM (
        type: selectList
        label {
            label: até
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(d.semana,'00') || '/' || d.ano) as display_value,
                       d.idsemana as return_value
                from semana_dias d
                where ( d.ano = to_number(to_char(sysdate,'IYYY'))
                        and d.semana <= to_number(to_char(sysdate,'IW')) )
                   or ( d.ano < to_number(to_char(sysdate,'IYYY')) )
                order by d.idsemana desc;
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @lucratividade-por-empresa
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P253_SEMANAINI (
        type: selectList
        label {
            label: De
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(d.semana,'00') || '/' || d.ano) as display_value,
                       d.idsemana as return_value
                from semana_dias d
                where ( d.ano = to_number(to_char(sysdate,'IYYY'))
                        and d.semana <= to_number(to_char(sysdate,'IW')) )
                   or ( d.ano < to_number(to_char(sysdate,'IYYY')) )
                order by d.idsemana desc;
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @lucratividade-por-empresa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 10
            region: @lucratividade-por-empresa
            slot: bottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button relatório-por-semana (
        buttonName: RELATÓRIO_POR_SEMANA_1
        label: Ver Relatório Por Semana
        layout {
            sequence: 10
            region: @lucratividade-distribuidoras-por-empresa
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 247
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        name: filtra
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 253
                items: {
                    P253_SEMANAINI: &P253_SEMANAINI.
                    P253_SEMANAFIM: &P253_SEMANAFIM.
                }
                successMessage: false
            }
        }
    )

)

