    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_abre(pidfil, semanaini, semanafim)
            {
             var myWindow =  window.open('f?p=&APP_ID.:254:&SESSION.::NO::P254_IDFILIAL,P254_SEMANAINI,P254_SEMANAFIM:'+pidfil+','+semanaini+','+semanafim,'DETALHE', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1600,height=800,left=10,top=10','_blank'); void(0);
              myWindow.focus();
            }
            
            ```
    }
