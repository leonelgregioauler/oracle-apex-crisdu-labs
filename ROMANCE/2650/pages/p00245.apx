page 245 (
    name: Despesas
    title: Despesas
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='Confirma a exclusão da Despesa?';
            
            function  confirmadespesa(event)
            { 
            var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
            
            if (tecla==13) {
            var answer = confirm("Confirma inclusão da despesa?")
            	if (answer){            
            		apex.submit('CREATE');
            	}
            }
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region despesas (
        name: Despesas
        type: tabform
        source {
            sqlQuery:
                ```sql
                select d.idfechamento 
                     , d.nomefilial filial
                     , d.ano "Ano"
                     , d.semana "Semana"
                     , d.IDCONTACONTABIL Conta
                     , d.IDSUBCONTACONTABIL subConta
                     , d.observacao
                     , d.valor
                     , d.valor * f.fatorconversao valorconvertido
                     , d.iddespesa
                     , d.iddespesa idcontrole
                     , d.datavencimento
                     , d.mes  "Mês"
                     , d.descricaoorigem "Descrição de Origem"
                     , f.fatorconversao 
                from vw_despesas_distribuidoras d
                   , fechamentossemanais  f
                where f.idfechamento = :P245_IDFECHAMENTO
                  and f.idfechamento = d.idfechamento
                ```
        }
        layout {
            sequence: 15
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 500
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: " "
        }
        pagination {
            type: showAll
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Dados não encontrados.
        }
        componentAdvanced {
            stripHtml: true
        }

        column Ano (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

        column CONTA (
            reportColumnQueryId: 5
            derivedColumn: N
            type: hidden
            layout {
                sequence: 12
            }
        )

        column DATAVENCIMENTO (
            reportColumnQueryId: 12
            derivedColumn: N
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 7
            }
            appearance {
                formatMask: Dd/mm/rrrr
            }
            sorting {
                sortable: false
            }
        )

        column "Descrição de Origem" (
            reportColumnQueryId: 14
            derivedColumn: N
            heading {
                heading: Descrição de origem
                alignment: center
            }
            layout {
                sequence: 8
            }
            sorting {
                sortable: false
            }
        )

        column FATORCONVERSAO (
            reportColumnQueryId: 15
            derivedColumn: N
            heading {
                heading: Fator Conv.
                alignment: center
            }
            layout {
                sequence: 16
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
        )

        column FILIAL (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Empresa/Setor
                alignment: center
            }
            layout {
                sequence: 6
            }
            sorting {
                sortable: false
            }
        )

        column IDCONTROLE (
            reportColumnQueryId: 11
            derivedColumn: N
            type: hidden
            layout {
                sequence: 14
            }
        )

        column IDDESPESA (
            reportColumnQueryId: 10
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingTrigger
            }
            sorting {
                sortable: false
            }
        )

        column IDFECHAMENTO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
        )

        column LINK$01 (
            reportColumnQueryId: 16
            derivedColumn: Y
            type: hidden
            layout {
                sequence: 1
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1
                    from fechamentossemanais f
                    where (nvl(f.concluido,'N') = 'N'
                      and f.idfechamento = :P82_IDFECHAMENTO)
                    or  (pck_romance.fnc_verificaacesso('PERM_ALTERAFECHA', v('APP_USER')) = 'S')
                    ```
            }
        )

        column Mês (
            reportColumnQueryId: 13
            derivedColumn: N
            type: hidden
            layout {
                sequence: 15
            }
        )

        column OBSERVACAO (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 11
            }
            sorting {
                sortable: false
            }
        )

        column SUBCONTA (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 13
            }
        )

        column Semana (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hidden
            layout {
                sequence: 4
            }
        )

        column VALOR (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Moeda Local
            }
            layout {
                sequence: 9
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
            advanced {
                computeSum: true
            }
        )

        column VALORCONVERTIDO (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Valor Convertido
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
            advanced {
                computeSum: true
            }
        )

    )

    pageItem P245_IDFECHAMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @despesas
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button fechar (
        buttonName: Fechar
        label: Fechar
        layout {
            sequence: 10
            region: @despesas
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: window.close();
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        clear {
            type: pages
            pages: 60
        }
        execution {
            sequence: 40
            point: newSession
        }
        advanced {
            executionMappingIdentifier: 340105516066549566
        }
        serverSideCondition {
            type: never
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 245
            }
            saveStateBeforeBranching: true
        }
    )

)

