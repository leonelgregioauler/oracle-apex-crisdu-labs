page 502 (
    name: Relatorio Orcamentos Semanais
    alias: RELATORIO-ORCAMENTOS-SEMANAIS
    title: Relatorio Orcamentos Semanais
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function setcolor_ir_cells() {
              // for each cell in marked column (Interactive Report)
              $(".setcolor .orc_real").each(function() {
                var $cell = $(this);
                var $tr   = $cell.closest("tr");
            
                // get values (ORCAMENTO_REALIZADO vs ORCAMENTO_SEMANA)
                var tReal   = $cell.text();
                var tSemana = $tr.find(".orc_semana").text();
            
                // parse numbers (remove thousands, change comma to dot)
                var realizado = parseFloat(String(tReal).trim().replace(/\./g,"").replace(",","."));
                var semana    = parseFloat(String(tSemana).trim().replace(/\./g,"").replace(",","."));
            
                // rules for coloring
                this.style.color = "";
                if (!isNaN(realizado) && !isNaN(semana)) {
                  if (realizado < semana) {
                    this.style.color = "green";
                  } else if (realizado > semana) {
                    this.style.color = "red";
                  } // equal -> neutral
                }
              });
            }
            
            // rodar após refresh do IR e na carga
            $("#ir_orcamento").on("apexafterrefresh", function(){ setcolor_ir_cells(); });
            setcolor_ir_cells();
            
            
            (function() {
              var items = ["P502_SEMANAINICIAL", "P502_SEMANAFINAL"];
              var state = {}; // por item: {prevDigits, caretStart, caretEnd, op, data}
            
              function fmt(d) {
                d = (d || "").replace(/\D/g, "").slice(0, 6); // SS + AAAA
                return d.length <= 2 ? d : d.slice(0,2) + "/" + d.slice(2);
              }
              function digitsBeforeCaret(str, pos) {
                var n = 0;
                for (var i=0; i<Math.min(pos, str.length); i++) if (/\d/.test(str[i])) n++;
                return n;
              }
              function caretFromDigitIndex(idx, formatted) {
                if (idx <= 0) return 0;
                var seen = 0;
                for (var i=0; i<formatted.length; i++) {
                  if (/\d/.test(formatted[i])) {
                    seen++;
                    if (seen === idx) return i + 1;
                  }
                }
                return formatted.length;
              }
              function applyEdit(prevDigits, op, data, dStart, dEnd) {
                // edita a STRING DE DÍGITOS com base na operação
                var left  = prevDigits.slice(0, dStart);
                var mid   = prevDigits.slice(dStart, dEnd);
                var right = prevDigits.slice(dEnd);
            
                // default: retorna prevDigits e caret no mesmo lugar
                var newDigits = prevDigits, newCaret = dStart;
            
                if (op === "insertText") {
                  var add = (data || "").replace(/\D/g,"");
                  if (!add) return {digits: prevDigits, caret: dStart};
                  newDigits = left + add + right;
                  newCaret  = dStart + add.length;
                } else if (op === "insertFromPaste") {
                  var addP = (data || "").replace(/\D/g,"");
                  if (!addP) return {digits: prevDigits, caret: dStart};
                  newDigits = left + addP + right;
                  newCaret  = dStart + addP.length;
                } else if (op === "deleteContentBackward") {
                  if (dStart !== dEnd) {
                    newDigits = left + right;
                    newCaret  = dStart;
                  } else if (dStart > 0) {
                    newDigits = prevDigits.slice(0, dStart-1) + prevDigits.slice(dStart);
                    newCaret  = dStart - 1;
                  }
                } else if (op === "deleteContentForward") {
                  if (dStart !== dEnd) {
                    newDigits = left + right;
                    newCaret  = dStart;
                  } else if (dStart < prevDigits.length) {
                    newDigits = prevDigits.slice(0, dStart) + prevDigits.slice(dStart+1);
                    newCaret  = dStart;
                  }
                } else {
                  // fallback (ex.: auto-preenchimentos): reconstrói a partir do valor atual
                  var addF = (data || "").replace(/\D/g,"");
                  if (dStart !== dEnd) {
                    newDigits = left + addF + right;
                    newCaret  = dStart + addF.length;
                  } else {
                    newDigits = left + addF + right;
                    newCaret  = dStart + addF.length;
                  }
                }
            
                // limita no máx 6 dígitos
                if (newDigits.length > 6) {
                  newDigits = newDigits.slice(0,6);
                  if (newCaret > 6) newCaret = 6;
                }
                return {digits: newDigits, caret: newCaret};
              }
            
              items.forEach(function(id){
                var el = document.getElementById(id);
                if (!el) return;
                el.setAttribute("maxlength","7");
            
                state[id] = {prevDigits: (el.value||"").replace(/\D/g,"").slice(0,6)};
            
                // antes de aplicar a alteração: capturamos contexto
                el.addEventListener("beforeinput", function(e){
                  var s = state[id];
                  s.prevDigits = (el.value || "").replace(/\D/g,"").slice(0,6);
                  s.caretStart = digitsBeforeCaret(el.value, el.selectionStart);
                  s.caretEnd   = digitsBeforeCaret(el.value, el.selectionEnd);
                  s.op         = e.inputType || "";
                  s.data       = e.data || "";
                });
            
                // após a alteração do navegador: nós substituímos pelo nosso cálculo estável
                el.addEventListener("input", function(){
                  var s = state[id] || {};
                  // Se o navegador não disparou beforeinput (alguns casos), inicializa agora
                  if (s.prevDigits == null) {
                    s.prevDigits = (el.value || "").replace(/\D/g,"").slice(0,6);
                    s.caretStart = digitsBeforeCaret(el.value, el.selectionStart);
                    s.caretEnd   = digitsBeforeCaret(el.value, el.selectionEnd);
                    s.op         = "";
                    s.data       = "";
                  }
            
                  var res = applyEdit(s.prevDigits, s.op, s.data, s.caretStart, s.caretEnd);
                  var formatted = fmt(res.digits);
            
                  if (el.value !== formatted) el.value = formatted;
            
                  var newCaret = caretFromDigitIndex(res.caret, formatted);
                  requestAnimationFrame(function(){
                    try { el.setSelectionRange(newCaret, newCaret); } catch(e){}
                  });
            
                  // prepara próximo ciclo
                  state[id] = {prevDigits: res.digits};
                });
            
                // formata o valor inicial (se houver)
                var init = fmt((el.value||"").replace(/\D/g,""));
                if (el.value !== init) el.value = init;
            
                // validação (opcional)
                el.addEventListener("blur", function(){
                  var v = el.value;
                  if (!v) return;
                  var ok = /^(0[1-9]|[1-4][0-9]|5[0-3])\/(19|20)\d{2}$/.test(v);
                  if (!ok) {
                    apex.message.showErrors([{
                      type: "error",
                      location: "inline",
                      pageItem: id,
                      message: "Use o formato SS/AAAA (semana 01–53)."
                    }]);
                    el.focus();
                  }
                });
              });
            })();
            ```
        executeWhenPageLoads: setcolor_ig_cells()
    }

    region filtros (
        name: Filtros
