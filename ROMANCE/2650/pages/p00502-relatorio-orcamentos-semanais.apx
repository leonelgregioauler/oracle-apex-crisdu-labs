    region relatório-de-orçamentos-semanais-fornecedores (
        name: Relatório de Orçamentos Semanais (FORNECEDORES)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT oc.idorcamentopedidocompra
                     , ( SELECT pm.nomepromocao
                         FROM roman.promocoescompras pm 
                        WHERE pm.idpromocaocompra = oc.idpromocaocompra ) promocao
                     , oc.idfornecedor
                     , oc.idsemana
                     , oc.valororcamento
                     , ( SELECT SUM(it.valortotal)
                         FROM roman.pedidoscomprasroman pd
                            , roman.itenspedidocompraroman it
                         WHERE pd.idpedidocompraroman = it.idpedidocompraroman
                           AND pd.idsemanaentrega = oc.idsemana
                           AND pd.idfornecedor = oc.idfornecedor ) orcamento_realizado
                FROM roman.orcamentospedidoscompras oc
                WHERE ( :P502_SEMANAINICIAL is null or oc.idsemana BETWEEN ( SELECT s.idsemana
                                                                            FROM roman.semana_dias s
                                                                            WHERE s.semanacompleta = :P502_SEMANAINICIAL ) AND ( SELECT s.idsemana
                                                                                                                                 FROM roman.semana_dias s
                                                                                                                                 WHERE s.semanacompleta = :P502_SEMANAFINAL ))
                  AND :P502_FILTRAR = 'S'
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
