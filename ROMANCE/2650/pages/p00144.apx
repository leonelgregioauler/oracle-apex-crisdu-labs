page 144 (
    name: Previsão de Gastos
    title: Previsão de Gastos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region previsão-de-gastos (
        name: Previsão de Gastos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.dtvencimento    
                     , t.filialdestino
                     , t.moeda
                     , t.tipopagamento
                     , t.identificado
                     , t.crisdu
                     , t.semana       
                     , t.idsemanavencimento
                     , sum(t.valorpagar)  valorpagar
                     , sum(t.valorpago )  valorpago
                     , sum(t.Saldo     )  Saldo
                     , 'Faturas' origem
                	 , t.Fornecedor motivo
                     , 'Fatura confirmada'  situacao
                from VW_FATURASFORNECEDORES_RMC t
                where  t.idsemanavencimento  >= pck_util.fnc_idsemanadata(sysdate)
                group by t.dtvencimento
                     , t.moeda
                     , t.tipopagamento
                     , t.identificado
                     , t.crisdu
                     , t.semana
                     , t.idsemanavencimento        
                     , t.filialdestino
                     , t.Fornecedor
                union
                select vencimento
                     , v.destino
                     , moeda
                     , v.formapagamento
                     , identificado
                     , crisdu
                     , v.semana
                     , idsemanavencimento
                     , sum(valorapagar )  valorapagar
                     , sum(valorpago   )  valorpago
                     , sum(saldo       )*-1  saldo
                     , 'Favorita' origem
                     , v.destinatario
                     , 'Previsão Favorita' situacao
                from favorita.vw_previsaogastoscompras_fav v
                group by vencimento
                     , moeda
                     , v.formapagamento
                     , identificado
                     , crisdu 
                     , v.semana
                     , idsemanavencimento      
                     , v.destino
                     , v.destinatario
                union
                select w.dataprevisao         vencimento
                     , w.nomefilial
                     , moeda                  moeda
                     , w.formapagamento        tipopagamento
                     , null                   identificado
                     , crisdu                 crisdu
                     , w.semanaprevisao       semana
                     , w.idsemanaprevisao     idsemanavencimento
                     , sum(w.valorprevisao)   valorapagar
                     , sum(0)                 valorpago
                     , sum(w.valorprevisao)*-1   saldo
                     , 'Reservas Caixas' origem
                     , w.descricao
                     , 'Previsão Setores' situacao
                from vw_previsoespagamentos w
                group by dataprevisao
                     , moeda
                     , w.formapagamento
                     , crisdu 
                     , w.semanaprevisao
                     , idsemanaprevisao
                     , w.nomefilial
                		 , w.descricao
                order by 8, 1
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 1568731426236911156
        }

