    pageItem P183_BONUSFAVORITA (
        type: numberField
        label {
            label: Bônus Favorita
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 70
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 5
        }
        validation {
            maxLength: 4000
        }
        default {
            type: static
            staticValue: 0
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P183_IDCAMPANHA (
        type: selectList
        label {
            label: Campanha
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select descricao||'('||semanaini||'-'||semanafim||')' display_value
                     , c.idcampanha 
                from campanhas c
                order by semanaini
                ```
        }
        layout {
            sequence: 60
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P183_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.nome display_value
                     , v.idfilial
                from vw_filiais v
                where tipofilial = 'D'
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: "- Selecione a Empresa - "
        }
        layout {
            sequence: 100
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P183_IDGRUPO (
        type: radioGroup
        label {
            label: Grupo
            alignment: left
        }
        settings {
            noOfCols: 5
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select descricao display_value
                     , idgrupo  return_value
                from gruposromance
                order by 2
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 90
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

