        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
    )

    region pontuação-representantes-romance-x-favorita (
        name: Pontuação Representantes (Romance x Favorita)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select :P183_SEMANAINI semanaini
                     , :P183_SEMANAFIM semanafim
                     , r.idrepresentante
                     , pck_romance.fnc_nomefilial( pck_romance.fnc_filialgerente( pck_romance.fnc_gerenterepresentante(r.idrepresentante))) "Filial"
                     , pck_romance.fnc_nomegerente(pck_romance.fnc_gerenterepresentante(r.idrepresentante)) "Gerente"
                     , pck_romance.fnc_nomerepresentante(r.idrepresentante)  "Representante"
                     , pck_romance.fnc_pontuacaoromance ( psemanaini       => :P183_SEMANAINI
                                                          , psemanafim       => :P183_SEMANAFIM
                                                          , pidrepresentante => r.idrepresentante ) "Pontuação Romance"
                     , pck_romance.fnc_pontuacaofavorita ( psemanaini       => :P183_SEMANAINI
                                                           , psemanafim       => :P183_SEMANAFIM
                                                           , pidrepresentante => r.idrepresentante ) "Pontuação Favorita"
                     , pck_romance.fnc_contagemacertos ( psemanaini       => :P183_SEMANAINI
                                                         , psemanafim       => :P183_SEMANAFIM
                                                         , pidrepresentante => r.idrepresentante )   "Contagem de Acertos"
                     , ( pck_romance.fnc_pontuacaofavorita ( psemanaini       => :P183_SEMANAINI
                                                                               , psemanafim       => :P183_SEMANAFIM
                                                                               , pidrepresentante => r.idrepresentante ) 
                                            * ( to_number(nvl(:P183_BONUSFAVORITA,'1') )/100) )  "Bônus Favorita"
                     , pck_romance.fnc_pontuacaoromance ( psemanaini       => :P183_SEMANAINI
                                                          , psemanafim       => :P183_SEMANAFIM
                                                          , pidrepresentante => r.idrepresentante )
                     + ( pck_romance.fnc_pontuacaofavorita ( psemanaini       => :P183_SEMANAINI
                                                                         , psemanafim       => :P183_SEMANAFIM
                                                                         , pidrepresentante => r.idrepresentante ) 
                                       + ( pck_romance.fnc_pontuacaofavorita ( psemanaini       => :P183_SEMANAINI
                                                                               , psemanafim       => :P183_SEMANAFIM
                                                                               , pidrepresentante => r.idrepresentante ) 
                                            * ( to_number(nvl(:P183_BONUSFAVORITA,'1') )/100) ) ) "Pontuação Total"
                     , round( 
                             ( pck_romance.fnc_pontuacaoromance ( psemanaini       => :P183_SEMANAINI
                                                                  , psemanafim       => :P183_SEMANAFIM
                                                                  , pidrepresentante => r.idrepresentante )
                             + ( pck_romance.fnc_pontuacaofavorita ( psemanaini       => :P183_SEMANAINI
                                                                         , psemanafim       => :P183_SEMANAFIM
                                                                         , pidrepresentante => r.idrepresentante ) 
                                       + ( pck_romance.fnc_pontuacaofavorita ( psemanaini       => :P183_SEMANAINI
                                                                               , psemanafim       => :P183_SEMANAFIM
                                                                               , pidrepresentante => r.idrepresentante ) 
                                            * ( to_number(nvl(:P183_BONUSFAVORITA,'1') )/100) ) ) )
                          /
                     decode( pck_romance.fnc_contagemacertos ( psemanaini       => :P183_SEMANAINI
                                                               , psemanafim       => :P183_SEMANAFIM
                                                               , pidrepresentante => r.idrepresentante ) , 0 , 1
                                                                                                             , pck_romance.fnc_contagemacertos ( psemanaini       => :P183_SEMANAINI
                                                                                                                                                 , psemanafim       => :P183_SEMANAFIM
                                                                                                                                                 , pidrepresentante => r.idrepresentante ) ) ) "Média"
                     , ( select mc.valormetaroman
                         from metascampanha mc
                         where mc.idcampanha = :P183_IDCAMPANHA
                           and mc.idrepresentante = r.idrepresentante ) "Meta Romance"
                     , ( select mc.valormetafavorita
                         from metascampanha mc
                         where mc.idcampanha = :P183_IDCAMPANHA
                           and mc.idrepresentante = r.idrepresentante ) "Meta Favorita"
                     , ( select mc.valormetageral
                         from metascampanha mc
                         where mc.idcampanha = :P183_IDCAMPANHA
                           and mc.idrepresentante = r.idrepresentante ) "Meta Geral"
                     --
                     , (round( 
                             ( pck_romance.fnc_pontuacaoromance ( psemanaini       => :P183_SEMANAINI
                                                                  , psemanafim       => :P183_SEMANAFIM
                                                                  , pidrepresentante => r.idrepresentante )
                             + ( pck_romance.fnc_pontuacaofavorita ( psemanaini       => :P183_SEMANAINI
                                                                         , psemanafim       => :P183_SEMANAFIM
                                                                         , pidrepresentante => r.idrepresentante ) 
                                       + ( pck_romance.fnc_pontuacaofavorita ( psemanaini       => :P183_SEMANAINI
                                                                               , psemanafim       => :P183_SEMANAFIM
                                                                               , pidrepresentante => r.idrepresentante ) 
                                            * ( to_number(nvl(:P183_BONUSFAVORITA,'1') )/100) ) ) )
                          /
                     decode( pck_romance.fnc_contagemacertos ( psemanaini       => :P183_SEMANAINI
                                                               , psemanafim       => :P183_SEMANAFIM
                                                               , pidrepresentante => r.idrepresentante ) , 0 , 1
                                                                                                             , pck_romance.fnc_contagemacertos ( psemanaini       => :P183_SEMANAINI
                                                                                                                                                 , psemanafim       => :P183_SEMANAFIM
                                                                                                                                                 , pidrepresentante => r.idrepresentante ) ) )
                     - ( select mc.valormetageral
                         from metascampanha mc
                         where mc.idcampanha = :P183_IDCAMPANHA
                           and mc.idrepresentante = r.idrepresentante )) "Vlr Meta Sul"
                     --
                     , (round( 
                             ( pck_romance.fnc_pontuacaoromance ( psemanaini       => :P183_SEMANAINI
                                                                  , psemanafim       => :P183_SEMANAFIM
                                                                  , pidrepresentante => r.idrepresentante )
                             + ( pck_romance.fnc_pontuacaofavorita ( psemanaini       => :P183_SEMANAINI
                                                                         , psemanafim       => :P183_SEMANAFIM
                                                                         , pidrepresentante => r.idrepresentante ) 
                                       + ( pck_romance.fnc_pontuacaofavorita ( psemanaini       => :P183_SEMANAINI
                                                                               , psemanafim       => :P183_SEMANAFIM
                                                                               , pidrepresentante => r.idrepresentante ) 
                                            * ( to_number(nvl(:P183_BONUSFAVORITA,'1') )/100) ) ) )
                          /
                     decode( pck_romance.fnc_contagemacertos ( psemanaini       => :P183_SEMANAINI
                                                               , psemanafim       => :P183_SEMANAFIM
                                                               , pidrepresentante => r.idrepresentante ) , 0 , 1
                                                                                                             , pck_romance.fnc_contagemacertos ( psemanaini       => :P183_SEMANAINI
                                                                                                                                                 , psemanafim       => :P183_SEMANAFIM
                                                                                                                                                 , pidrepresentante => r.idrepresentante ) ) )
                     - ( select mc.valormetageral
                         from metascampanha mc
                         where mc.idcampanha = :P183_IDCAMPANHA
                           and mc.idrepresentante = r.idrepresentante ))  "Vlr Meta Norte"
                     --
                   ,  ( pck_romance.fnc_pontuacaofavorita ( psemanaini       => :P183_SEMANAINI
                                                                         , psemanafim       => :P183_SEMANAFIM
                                                                         , pidrepresentante => r.idrepresentante )* 100 
                                        / pck_romance.fnc_pontuacaoromance ( psemanaini       => :P183_SEMANAINI
                                              , psemanafim       => :P183_SEMANAFIM
                                              , pidrepresentante => r.idrepresentante ) )  "% Venda Favorita" 
                    , pck_romance.fnc_pontuacaoromance_det ( psemanaini       => :P183_SEMANAINI
                                                          , psemanafim       => :P183_SEMANAFIM
                                                          , pidrepresentante => r.idrepresentante ) "Romance Detalhado"
                    , pck_util.fnc_idsemana(:P183_SEMANAFIM) - pck_util.fnc_idsemana(:P183_SEMANAINI)+1 qtdsemanas
                from representantes r
                where r.ativo = 'S'
                  and exists ( select 1
                               from gerentes g
                               where g.idgerente = r.idgerente
                                 and (( :P183_TIPO = 'G' and exists ( select 1 
                                                                      from filiais f
                                                                      where f.idfilial = g.idfilial
                                                                        and f.idgrupo  = :P183_IDGRUPO ) )
                                  or (:P183_TIPO = 'E' and g.idfilial = :P183_IDFILIAL) ) )
                  and pck_romance.fnc_contagemacertos ( psemanaini       => :P183_SEMANAINI
                                                           , psemanafim       => :P183_SEMANAFIM
                                                           , pidrepresentante => r.idrepresentante ) > 0
                group by r.idrepresentante
                order by 2,3,4
                ```
        }
