    pageItem P183_TIPO (
        type: radioGroup
        label {
            label: Tipo
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC:Empresa;E,Grupo;G
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: F
        }
        security {
            encryptSessionState: false
        }
    )

    button p183-filtrar (
        buttonName: P183_FILTRAR
        label: Filtrar
        layout {
            sequence: 110
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        advanced {
            htmlDomId: P183_FILTRAR
        }
    )

    dynamicAction filtrar (
        name: Filtrar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @p183-filtrar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction tipo (
        name: Tipo
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P183_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P183_TIPO
            value: G
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P183_IDFILIAL
            }
            execution {
                sequence: 20
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P183_IDGRUPO
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P183_IDGRUPO
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P183_IDFILIAL
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    branch (
        name: Go To Page 183
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 183
                items: {
                    P183_SEMANAINI: &P183_SEMANAINI.
                    P183_SEMANAFIM: &P183_SEMANAFIM.
                    P183_IDCAMPANHA: &P183_IDCAMPANHA.
                    P183_TIPO: &P183_TIPO.
                    P183_IDGRUPO: &P183_IDGRUPO.
                    P183_IDFILIAL: &P183_IDFILIAL.
                }
                successMessage: false
            }
        }
        comments {
            comments: Created 13-ABR-2012 09:24 by ROMAN
        }
    )

)

