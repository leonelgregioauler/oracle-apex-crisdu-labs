page 97 (
    name: Pagamentos de Cheques
    title: Pagamentos de Cheques
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region pagamentos-de-cheques (
        name: Pagamentos de Cheques
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select cp.idcheque
                     , initcap(bb.nomebanco) banco
                     , cc.nrcheque
                     , cc.agencia
                     , cc.conta
                     , cc.observacao
                     , cc.idfornecedor
                     , cp.datapgto
                     , cp.valor
                     , cp.semana
                     , initcap(nvl(pf.apelido,pf.nomepessoa)) Filial
                     , initcap(nvl(pr.apelido,pr.nomepessoa)) Representante
                from cheques2pgto             cp
                   , cheques2                 cc
                   , fechamentorepresentantes fr
                   , representantes           rr
                   , pessoas                  pr
                   , bancos                   bb
                   , pessoas                  pf
                   , filiais                  ff
                   , gerentes                 gg
                where cp.idfechamentorepres = fr.idfechamentorepres
                  and fr.idrepresentante    = rr.idrepresentante
                  and rr.idpessoa           = pr.idpessoa
                  and cp.idcheque           = cc.idcheque
                  and cc.idbanco            = bb.idbanco
                  and ff.idpessoa           = pf.idpessoa
                  and ff.idfilial           = gg.idfilial
                  and gg.idgerente          = rr.idgerente
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Dados não encontrados.
            whenMoreDataFound: Esta consulta retorna mais de #MAX_ROW_COUNT# linhas. Filtre seus dados para garantir resultados completos.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

