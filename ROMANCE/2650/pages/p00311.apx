page 311 (
    name: Grupos de Fornecedores
    title: Grupos de Fornecedores
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region grupos-de-fornecedores (
        name: Grupos de Fornecedores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select g.idgrupofornecedor
                     , g.descricao 
                     , nvl(( select listagg(pck_romance.fnc_nomefornecedor(fg.idfornecedor),' ') within group (order by 1)
                             from fornecedoresgruposforn fg
                             where fg.idgrupofornecedor = g.idgrupofornecedor ),'Nenhum fornecedor cadastrado!') fornecedores
                from gruposfornecedores g
                order by 1 desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado.
        }
        advanced {
            savedReportMappingIdentifier: 1568223515035374646
        }

        column DESCRICAO (
            type: plainText
            heading {
                heading: Nome do Grupo
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column FORNECEDORES (
            type: plainText
            heading {
                heading: Fornecedores vinculados ao grupo
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column IDGRUPOFORNECEDOR (
            type: link
            heading {
                heading: Ver / Editar
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 312
                    items: {
                        P312_IDGRUPOFORNECEDOR: #IDGRUPOFORNECEDOR#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 15755927 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DESCRICAO (
                sequence: 2
            )

            displayColumn FORNECEDORES (
                sequence: 3
            )

            displayColumn IDGRUPOFORNECEDOR (
                sequence: 1
            )

        )

    )

    button novo (
        buttonName: NOVO
        label: Novo Grupo
        layout {
            sequence: 10
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--primary
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 312
                items: {
                    P312_IDGRUPOFORNECEDOR:
                    P312_DESCRICAO:
                    P312_MD5:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

