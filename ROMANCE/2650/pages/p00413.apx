    pageItem P413_DOCUMENTO (
        type: popupLov
        label {
            label: Documento
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nf.documento
                     , nf.idnotafiscal
                from notasfiscais nf
                where nf.idfornemitente = :P413_IDFORNECEDOR
                order by 1 desc
                ```
        }
        cascadingLov {
            parentItems: P413_IDFORNECEDOR
        }
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P413_IDFORNECEDOR (
        type: popupLov
        label {
            label: Fornecedor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefornecedor(idfornecedor) display_value
                     , fe.idfornecedor return_value
                from fornecedores fe
                where fe.ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button buscar (
        buttonName: BUSCAR
        label: Buscar
        layout {
            sequence: 110
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 413
                items: {
                    P413_IDFORNECEDOR: &P413_IDFORNECEDOR.
                    P413_DOCUMENTO: &P413_DOCUMENTO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

