page 413 (
    name: Log Vencimentos
    title: Log Vencimentos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--accent5
                t-Region--scrollBody
            ]
            renderComponents: belowContent
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region log-vencimentos (
        name: Log Vencimentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select lv.usuarioalteracao
                     , decode(lv.tipoalteracao,'INSERT','Inclusão','UPDATE','Alteração','DELETE','Exclusão') "Tipo Alt."
                     , lv.dataalteracao
                     , lv.idvencimento
                     , lv.idnotafiscal
                     , ( select documento
                         from roman.notasfiscais nf
                         where nf.idnotafiscal = lv.idnotafiscal ) "Documento"
                     , lv.dias
                     , lv.datavencimento
                     , lv.valor
                     , ( select descricao
                         from roman.formaspagamentos t
                         where t.idformapagamento = lv.tipopagamento ) "Tipo Pagamento"
                     , lv.observacao
                     , decode(lV.identificado,'S','Sim','N','Não') "Identificado"
                     , lv.idsemanavencimento
                     , lv.idcontafinanceira
                     , lv.idsubcontafinanceira
                     , lv.fixavariavel
                     , lv.gera_transferencia
                     , lv.idcentrodecusto
                     , lv.idconta_destino
                     , lv.idmatrizregradespesa
                     , lv.tipo  
                     , lv.valorpago
                     , lv.desconto
                     , lv.acrescimo
                     , lv.motivoatraso
                from logroman.log_vencimentos lv
                where lv.idnotafiscal = :P413_DOCUMENTO
                order by 3 desc
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: - Nenhum registro encontrado -
        }
        advanced {
            savedReportMappingIdentifier: 5713828970502555407
        }

