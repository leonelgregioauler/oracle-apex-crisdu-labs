    process apagaitem (
        name: APAGAITEM
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_financeiro_rmc.prc_deletadeposito(piddepositodiario => :P45_EXCLUIR);
                end;
                
                ```
        }
        execution {
            sequence: 5
