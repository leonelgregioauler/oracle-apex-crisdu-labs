    region filtro (
        name: Filtro
        type: staticContent
        source {
            htmlCode:
                ```html
                <script language="Javascript">
                function filtra()
                { if ( P45_BENEFICIARIO.selectedIndex >= 0 )
                  {
                   vbeneficiario = P45_BENEFICIARIO.options[P45_BENEFICIARIO.selectedIndex].value;
                  }
                  else
                   {
                    vbeneficiario = ''
                   }
                window.location='f?p=&APP_ID.:45:&SESSION.::YES::P45_FORNECEDOR,P45_BENEFICIARIO,P45_REPRESENTANTE,P45_NOTAFISCAL,P45_NRDOCUMENTO,P45_VALOR,P45_SITUACAO,P45_FILIAL,P45_CONSULTAR,P45_FECHAMENTO,P45_MES,P45_ANO,P45_IDSEMANA:'
                +P45_FORNECEDOR.options[P45_FORNECEDOR.selectedIndex].value+','
                +vbeneficiario+','
                +P45_REPRESENTANTE.options[P45_REPRESENTANTE.selectedIndex].value+','
                +P45_NOTAFISCAL.options[P45_NOTAFISCAL.selectedIndex].value
                +','+P45_NRDOCUMENTO.value
                +','+P45_VALOR.value
                +','+P45_SITUACAO.options[P45_SITUACAO.selectedIndex].value+','
                +P45_FILIAL.options[P45_FILIAL.selectedIndex].value
                +',S'+','
                +P45_FECHAMENTO.options[P45_FECHAMENTO.selectedIndex].value
                +','+P45_MES.options[P45_MES.selectedIndex].value
                +','+P45_ANO.options[P45_ANO.selectedIndex].value
                +','+P45_IDSEMANA.options[P45_IDSEMANA.selectedIndex].value;void(0);
                }
                </script>
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--accent2
                t-Region--scrollBody
                t-Form--slimPadding
            ]
            renderComponents: belowContent
        }
        headerAndFooter {
            headerText:
                ```html
                <script language="Javascript">
                function confirmaexclusao() {
                	var answer = confirm("Deseja realmente excluir o depósito?")
                	if (answer){
                		apex.submit('EXCLUIRDEP');
                	}
                        else
                        {
                        document.getElementById('P38_EXCLUIR').value = '';
                        }
                }
                
                function confirmadesvinculo() {
                	var answer = confirm("Deseja realmente desvincular o depósito do acerto?")
                	if (answer){
                		apex.submit('DESVINCULARDEP');
                	}
                        else
                        {
                        document.getElementById('P38_EXCLUIR').value = '';
                        }
                }
                </script>
                ```
        }
    )

