    process atualiza-pgtoforn (
        name: atualiza pgtoforn
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vid number;
                begin
                  --
                  commit;
                  --
                  select idpgtoforn 
                  into vid 
                  from depositosdiarios 
                  where iddepositodiarios = :P45_EXCLUIR;
                  --
                 pck_romance.prc_atualiza_pagtoforn(vid);
                  -- 
                end;
                ```
        }
        execution {
            sequence: 30
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 238774998350442119
        }
        serverSideCondition {
            type: never
        }
    )

    process atualizadivergencia (
        name: atualizadivergencia
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                commit;
                
                update depositosdiarios d1
                set (d1.data,d1.comprovado,d1.observacao,d1.idrepresentante,d1.tipo) = ( select d2.data,d2.comprovado,d2.observacao,d2.idrepresentante,d2.tipo
                                                                                         from depositosdiarios_orig d2
                                                                                         where d2.iddepositodiarios = d1.iddepositodiarios)
                where exists ( select 1
                              from depositosdiarios_orig d2
                              where d2.iddepositodiarios = d1.iddepositodiarios
                                and( d1.data     != d2.data
                                    or d1.comprovado != d2.comprovado
                                    or d1.observacao != d2.observacao
                                    or d1.tipo       != d2.tipo
                                    or d1.idrepresentante != d2.idrepresentante));
                end;
                ```
        }
        execution {
            sequence: 20
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 238775614132442121
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process desvincula-fechamento (
        name: desvincula fechamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidpgtoforn         number;
                  vidfechamentorepres number;
                  vidfechamento       number;
                  --
                begin
                  --
                  commit;
                  --
                  select idpgtoforn, idfechamentorepres
                  into vidpgtoforn , vidfechamentorepres
                  from depositosdiarios_orig
                  where iddepositodiarios = :P45_EXCLUIR;
                  --
                  begin
                    --
                    select idfechamento
                    into vidfechamento
                    from fechamentorepresentantes
                    where idfechamentorepres = vidfechamentorepres;
                  exception
                    when others then
                      null;
                  end;
                  --
                  update depositosdiarios_orig d
                  set d.idfechamentorepres = null
                    , d.comprovado = 'M'
                  where iddepositodiarios = :P45_EXCLUIR;
                  --
                  if vidfechamentorepres is not null then
                    pck_acertosfechamento.prc_atualiza_acerto ( vidfechamentorepres);
                  end if;
                  --
                  if vidfechamento is not null then
                    pck_acertosfechamento.prc_atualiza_gavetas ( vidfechamento);
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 4
        }
        successMessage {
            successMessage: Depósito desvinculado do acerto com sucesso!
        }
        error {
            errorMessage: Problemas ao excluir o depósito!
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 238775203448442119
        }
        serverSideCondition {
            type: request=Value
            value: DESVINCULARDEP
        }
    )

