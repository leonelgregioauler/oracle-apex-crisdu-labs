        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct ano  display_value
                     , ano return_value
                from semana_dias
                where ano <= EXTRACT ( year from sysdate) 
                order by 1 desc
                ```
        }
        layout {
            sequence: 40
            region: @new
            slot: regionBody
            alignment: left
