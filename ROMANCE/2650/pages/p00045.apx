    pageItem P45_CONTAPAG (
        type: selectOne
        label {
            label: Conta Pagamento
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                 select  distinct(cb.beneficiario)||' <br> '||b.nomebanco||' - '|| cb.agencia ||' - '|| cb.conta display_value
                       , cb.idcontabanc return_value
                 from roman.contasbancarias cb
                    , roman.bancos b
                    , roman.pagamentosfornecedores p
                 where cb.idbanco = b.idbanco
                   and p.idcontapagamento = cb.idcontabanc
                   and p.idfornecedor = :P45_FORNECEDOR
                   and cb.ativo = 'S'
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P45_FORNECEDOR
        }
        layout {
            sequence: 100
            region: @new
            slot: regionBody
            alignment: left
