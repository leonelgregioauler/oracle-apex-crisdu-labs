    )

    pageItem P45_BENEFICIARIO (
        type: selectList
        label {
            label: Beneficiário
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select  initcap(bb.nomebanco) || ' - ' || cb.agencia ||'/'||cb.conta||' - '||initcap(cb.beneficiario) display_value
                , cb.idcontabanc return_value
                from contasbancarias cb
                   , fornecedores    ff
                   , pessoas         pf
                   , bancos          bb
                where cb.idfornecedor = ff.idfornecedor
                  and ff.idpessoa     = pf.idpessoa
                  and cb.idbanco      = bb.idbanco
                  and ff.idfornecedor = :P45_FORNECEDOR
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P45_FORNECEDOR
        }
        layout {
            sequence: 40
            region: @new-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

