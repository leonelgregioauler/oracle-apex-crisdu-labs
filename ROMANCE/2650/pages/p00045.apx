        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region atualizar-valor-comprovante-depósito (
        name: Atualizar Valor/Comprovante Depósito
        type: tabform
        source {
            sqlQuery:
                ```sql
                select case
                         when exists ( select 1
                                       from pagamentosfornecedores pf
                                          , fechamentomovimentacoes fm
                                       where pf.idpgtoforn = depdia.idpgtoforn
                                         and fm.idcontabancaria = pf.idcontapagamento
                                         and fm.datafechamento  = trunc(depdia.data) ) then
                           '<font color="red">Fechamento do dia já Realizado!</font>'
                         else
                           '<a href="javascript:document.getElementById(''P45_EXCLUIR'').value = '||IDDEPOSITODIARIOS||';confirmaexclusao();">Excluir</a>'
                       end Excluir,
                        "IDDEPOSITODIARIOS",
                        "IDDEPOSITODIARIOS" IDDEPOSITODIARIOS_DISPLAY,
                        "DATA",
                        IDREPRESENTANTE IDREPRESENTANTE,
                        ( select  initcap(bb.nomebanco) || ' - <b>' || cb.agencia ||'/'||cb.conta||'</b> - <i>'||initcap(cb.beneficiario)||'</i>' 
                        from contasbancarias cb
                           , fornecedores    ff
                           , pessoas         pf
                           , bancos          bb
                        where ( cb.idfornecedor = ff.idfornecedor
                             or cb.idpessoa     = ff.idpessoa )
                          and ff.idpessoa     = pf.idpessoa
                          and cb.idbanco      = bb.idbanco
                          and cb.idcontabanc  = depdia.idcontabanc) "IDCONTABANC",
                        "IDPGTOFORN",
                        "VALORDEPOSITO",
                        "COMPROVADO",
                        "NROCOMPROVANTE",
                        "OBSERVACAO",
                        "OBSERVACAOGERENTE",
                        "TIPO",
                        "NROENVELOPE",
                        (select distinct documento ||' <br>'||decode(pf.identificado,'S','<b>Sim</b>','Não')||'' from notasfiscais nf, pagamentosfornecedores pf where pf.idnotafiscal = nf.idnotafiscal and pf.idpgtoforn = depdia.idpgtoforn ) notafiscal
                        ,/*( select semana from fechamentossemanais ff where ff.idfechamento = */(select semana /*f.idfechamento*/ from fechamentorepresentantes f where f.idfechamentorepres = depdia.idfechamentorepres ) /*)*/ fechamento
                        , '<a href="javascript:document.getElementById(''P45_EXCLUIR'').value = '||IDDEPOSITODIARIOS||';confirmadesvinculo();">Desvincular</a>' "Desvincular do Acerto"
                        , initcap(TO_CHAR(DEPDIA.DATA,'MONTH')) mes
                        , "IDENTIFICACAO"             
                     , ( select count(1)||' - '||listagg(trim(to_char(dd.valor_digitado,'999G999G999G999G990D00'))||' - '||dd.nroidentificacao_digitado,'; ') within group (order by 1)
                         from depositosdiarios_leituraocr dd
                         where dd.iddepositodiario = depdia.IDDEPOSITODIARIOS ) fotos
                from "#OWNER#"."DEPOSITOSDIARIOS_ORIG"  depdia
                where idordemdeposito is null
                  and (depdia.idpgtoforn_orig is null
                  and (nvl(:P45_FILIAL,'#') = '#'
                    or (depdia.idrepresentante in ( select r.idrepresentante 
                                                  from representantes r
                                                     , gerentes  g
                                                  where r.idgerente = g.idgerente
                                                    and g.idfilial = :P45_FILIAL)) ) 
                  and depdia.idrepresentante  != 0
                  and (:P45_ANO is null or  EXTRACT ( year from DEPDIA.DATA) = :P45_ANO)
                  and (:P45_SEMANA is  null or exists ( select 1 from depositosdiarios dd where dd.iddepositodiarios = depdia.iddepositodiarios and dd.idsemana = :P45_IDSEMANA))
                  and ( (nvl(:P45_SITUACAO,'#') = '#' and  nvl(depdia.comprovado,'-') != 'M')  or ( depdia.comprovado = :P45_SITUACAO))
                  AND ( nvl(:P45_BENEFICIARIO,-1) = -1                                         or depdia.idcontabanc = :P45_BENEFICIARIO)
                  and ( nvl(:P45_representante,'#') = '#'                                      or depdia.idrepresentante = :P45_representante)
                  and ( nvl(:P45_VALOR,-1) = -1                                                or depdia.valordeposito = :P45_VALOR)
                  and ( :P45_MES is null or extract(month from depdia.data) = :P45_MES)
                  and (:P45_fornecedor is null
                       or exists ( select 1 
                                   from pagamentosfornecedores pgf 
                                   where pgf.idfornecedor = :P45_fornecedor 
                                     and pgf.idpgtoforn = depdia.idpgtoforn
                                     and ( nvl(:p45_notafiscal,'#') = '#' or pgf.idnotafiscal = :p45_notafiscal) ) )
                  and ( :P45_NRDOCUMENTO is null or exists ( select 1
                                                             from pagamentosfornecedores pfg
                                                                , notasfiscais nf
                                                             where pfg.idnotafiscal = nf.idnotafiscal
                                                               and pfg.idfornecedor = :P45_fornecedor 
                                                                and pfg.idpgtoforn = depdia.idpgtoforn
                                                               and upper(nf.documento) = upper(:P45_NRDOCUMENTO) ) )
                  and ( ( :P45_FECHAMENTO is null ) or ( exists ( select 1 
                                                                  from fechamentorepresentantes f 
                                                                  where f.idfechamentorepres = depdia.idfechamentorepres 
                                                                    and f.idfechamento       = :P45_FECHAMENTO ) ) )
                  and ( :P45_DATABAIXA is null or exists ( select 1
                                                           from pagamentosfornecedores pfg
                                                           where pfg.idpgtoforn = depdia.idpgtoforn
                                                             and pfg.idfornecedor = :P45_fornecedor 
                                                             and pfg.databaixa = :P45_DATABAIXA  ) )
                  --and ( :P45_CONTAPAG is null or depdia.idcontabanc = :P45_CONTAPAG )
                   and ( :P45_CONTAPAG is null or exists ( select 1 
                                                           from roman.pagamentosfornecedores pfg
                                                           where pfg.idpgtoforn = depdia.idpgtoforn
                                                             and pfg.idcontapagamento = :P45_CONTAPAG ) )
                  AND :P45_CONSULTAR IS NOT NULL )
                  or depdia.idrepresentante  is null
                ```
        }
