    pageItem P45_FORNECEDOR (
        type: selectOne
        label {
            label: Fornecedor
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(pe.apelido,pe.nomepessoa)) display_value
                     , fe.idfornecedor return_value
                from fornecedores fe
                    , pessoas     pe
                where fe.idpessoa = pe.idpessoa 
                  and exists ( select 1
                               from pagamentosfornecedores pp
                                  , depositosdiarios       dd
                               where pp.idpgtoforn = dd.idpgtoforn   
                                 and pp.idfornecedor = fe.idfornecedor
                                 and dd.comprovado != 'M' )
                order by 1
                ```
        }
        layout {
            sequence: 30
            region: @new-2
            slot: regionBody
