page 504 (
    name: Relatorio Promocoes
    alias: RELATORIO-PROMOCOES
    title: Relatório de Promoções
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region relatório-de-promoções (
        name: Relatório de Promoções
        type: interactiveReport
        source {
            location: localDatabase
            tableName: PROMOCOESCOMPRAS
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 49119433667709428
        }

        column IDPROMOCAOCOMPRA (
            type: link
            heading {
                heading: Editar
                alignment: center
            }
            layout {
                sequence: 0
                columnAlignment: center
            }
            link {
                target: {
                    page: 505
                    items: {
                        P505_IDPROMOCAOCOMPRA: #IDPROMOCAOCOMPRA#
                    }
                    clearCache: 505
                }
                linkText: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            }
            source {
                primaryKey: true
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column NOMEPROMOCAO (
            type: plainText
            heading {
                heading: Descrição da Promoção
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column VALIDADEFINAL (
            type: plainText
            heading {
                heading: Validade Final
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column VALIDADEINICIAL (
            type: plainText
            heading {
                heading: Validade Inicial
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Relatorio Promocoes
        }

        savedReport 491529 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn IDPROMOCAOCOMPRA (
                sequence: 1
            )

            displayColumn NOMEPROMOCAO (
                sequence: 4
            )

            displayColumn VALIDADEFINAL (
                sequence: 3
            )

            displayColumn VALIDADEINICIAL (
                sequence: 2
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Novo Registro
        layout {
            sequence: 10
            region: @relatório-de-promoções
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 505
                items: {
                    P505_IDPROMOCAOCOMPRA:
                }
                clearCache: 505
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

