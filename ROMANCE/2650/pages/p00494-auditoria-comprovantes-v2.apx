    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P494_DATA_DEPOSITO (
        type: datePicker
        label {
            label: Data
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P494_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct pck_romance.fnc_nomerepresentante(r.idrepresentante)  display_value
                     , r.idrepresentante return_value
                from representantes r
                   , depositosdiarios_orig d
                where r.idrepresentante = d.idrepresentante
                and r.ativo = 'S'
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            columnSpan: 1
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 40
            region: @filtros
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 464
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

