page 494 (
    name: Auditoria Comprovantes V2
    alias: AUDITORIA-COMPROVANTES-V2
    title: Auditoria Comprovantes V2
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region auditoria-comprovantes-v (
        name: Auditoria Comprovantes V2
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ap.*,
                       coalesce(
                         (select do.idrequisicao
                            from roman.depositosdiarios_orig do
                           where do.iddepositodiarios = to_number(ap.idprocesso)),
                         to_number(ap.idprocesso)
                       ) as idrequisicao_grupo
                from auditoria_processos ap
                where ap.idrepresentante = :P494_IDREPRESENTANTE
                --and trunc(ap.datahora) = trunc(sysdate - 1)
                and trunc(ap.datahora) = :P494_DATA_DEPOSITO
                order by min(idauditoriaprocessos) over (partition by idrequisicao_grupo), idauditoriaprocessos
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 3374818313039641632
        }

        column DATAHORA (
            type: plainText
            heading {
                heading: Data / Hora
                alignment: center
            }
            layout {
                sequence: 11
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: K
            }
        )

