page 152 (
    name: Despesas
    title: Despesas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region agrupador (
        name: Agrupador
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                                        from dual 
                                        where pck_romance.fnc_verificaacesso('PERM_ALTERAFECHA', v('APP_USER')) = 'S'
                                          or exists ( select 1 
                                                      from gerentes g
                                                      where g.idpessoa = ( select u.idpessoa 
                                                                           from usuarios u
                                                                           where u.usuario = v('APP_USER') ) )
                ```
        }
    )

    region despesas (
        name: Despesas
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                IDDESPESA,
                IDDESPESA IDDESPESA_DISPLAY,
                IDREPRESENTANTE,
                IDFECHAMENTOREPRES,
                IDCONTACONTABIL,
                IDSUBCONTACONTABIL,
                OBSERVACAO,
                SEMANA,
                ANO,
                VALOR,
                IDFILIAL,
                IDFECHAMENTO,
                emmaos,
                DESCRICAOORIGEM
                from DESPESASROMAN
                where idfechamento = :P152_IDFECHAMENTO
                ```
        }
        layout {
            sequence: 15
            slot: body-3
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        reportLayout {
            numberOfRows: 500
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: " "
        }
        pagination {
            type: showAll
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Dados não encontrados.
        }
        componentAdvanced {
            stripHtml: true
        }

        column ANO (
            reportColumnQueryId: 9
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 10
            }
        )

        column DESCRICAOORIGEM (
            reportColumnQueryId: 14
            derivedColumn: N
            heading {
                heading: Descrição de Origem
                alignment: center
            }
            layout {
                sequence: 14
            }
        )

        column EMMAOS (
            reportColumnQueryId: 13
            derivedColumn: N
            type: simpleCheckbox
            heading {
                heading: Em Mãos
                alignment: center
            }
            lov {
                checkboxValues: S
            }
            layout {
                sequence: 15
                columnAlignment: center
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1
                    from dual
                    where pck_romance.fnc_verificaacesso('PERM_ALTERAFECHA', v('APP_USER')) = 'S'
                    ```
            }
        )

        column IDCONTACONTABIL (
            reportColumnQueryId: 5
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Conta
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(nomeconta) display_value
                         , idcontafinan return_value
                    from contasfinanceiras
                    ```
            }
            layout {
                sequence: 4
            }
        )

        column IDDESPESA (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingTrigger
            }
        )

        column IDDESPESA_DISPLAY (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

        column IDFECHAMENTO (
            reportColumnQueryId: 12
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 13
            }
        )

        column IDFECHAMENTOREPRES (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 6
            }
        )

        column IDFILIAL (
            reportColumnQueryId: 11
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 12
            }
        )

        column IDREPRESENTANTE (
            reportColumnQueryId: 3
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Representante
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(nvl(p.apelido,p.nomepessoa))
                         , r.idrepresentante
                    from pessoas p
                       , representantes r
                    where p.idpessoa = r.idpessoa
                    order by 1 
                    ```
            }
            layout {
                sequence: 8
            }
            sorting {
                defaultSequence: 1
            }
        )

        column IDSUBCONTACONTABIL (
            reportColumnQueryId: 6
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Sub Conta
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(nomeconta) display_value
                         , idSUBcontafinan return_value
                    from subcontasfinanceiras
                    ```
            }
            layout {
                sequence: 5
            }
        )

        column LINK$01 (
            reportColumnQueryId: 15
            derivedColumn: Y
            type: link
            heading {
                heading: Editar
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            link {
                target: {
                    page: 60
                    items: {
                        P60_IDDESPESA: #IDDESPESA#
                    }
                }
                linkText: <img src="#IMAGE_PREFIX#menu/pencil2_16x16.gif" alt="">
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1
                    from fechamentossemanais f
                    where (nvl(f.concluido,'N') = 'N'
                      and f.idfechamento = :P60_IDFECHAMENTO)
                    or  (pck_romance.fnc_verificaacesso('PERM_ALTERAFECHA', v('APP_USER')) = 'S')
                    ```
            }
        )

        column OBSERVACAO (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Observação
            }
            layout {
                sequence: 7
            }
        )

        column SEMANA (
            reportColumnQueryId: 8
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 9
            }
        )

        column VALOR (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Valor
            }
            layout {
                sequence: 11
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
            }
            sorting {
                defaultSequence: 2
            }
            advanced {
                computeSum: true
            }
        )

    )

    region despesas-detalhadas (
        name: Despesas Detalhadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select iddespesa
                     , semana
                     , ( select initcap(nvl(pf.apelido,pf.nomepessoa))
                         from filiais f
                            , pessoas pf
                         where f.idfilial = d.idfilial
                           and f.idpessoa = pf.idpessoa )  Filial
                     , ( select initcap(nvl(p.apelido,p.nomepessoa))
                         from representantes r
                            , pessoas        p
                         where r.idrepresentante = d.idrepresentante
                           and r.idpessoa = p.idpessoa ) Representante
                     , initcap(c.nomeconta) contafinanceira
                     , d.observacao
                     , d.valor
                     , d.descricaoorigem "Descrição Origem"
                from despesasroman           d
                   , contasfinanceiras  c
                where d.idcontacontabil = c.idcontafinan
                  and d.idfechamento = :P152_IDFECHAMENTO
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhuma despesa incluída neste fechamento.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1
        }

