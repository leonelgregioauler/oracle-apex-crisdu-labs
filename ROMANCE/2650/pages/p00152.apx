    pageItem P152_IDFILIAL (
        type: hidden
        layout {
            sequence: 90
            region: @inserir-nova-despesa
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIAL
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                 vfilial number;
                begin
                select f.idfilial
                into vfilial 
                from filiais    f
                   , pessoas    p
                   , usuarios   u
                   , gerentes   g
                where f.idpessoa  = p.idpessoa
                  and g.idfilial  = f.idfilial
                  and u.idgerente = g.idgerente
                  and u.usuario   = v('APP_USER');
                return vfilial;
                exception
                  when others then 
                  return null;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

