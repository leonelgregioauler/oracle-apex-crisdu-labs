        }
    )

    pageItem P152_NOTASFECHADAS (
        type: textField
        label {
            label: Notas Fechadas
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 60
            region: @agrupador
            slot: regionBody
            startNewRow: false
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 8
        }
        validation {
            maxLength: 4000
        }
        advanced {
            customAttributes: style="text-align: right;" readonly
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select sum(f.qtdnotasfechou)
                from fechamentorepresentantes f
