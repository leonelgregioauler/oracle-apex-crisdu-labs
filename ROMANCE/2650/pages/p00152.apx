    pageItem P152_COMISSAODESPESA (
        type: textField
        label {
            label: Comissões + Despesas
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 120
            region: @agrupador
            slot: regionBody
            columnSpan: 1
            rowSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 15
        }
        validation {
            maxLength: 4000
        }
        advanced {
            customAttributes: style="text-align: right;" readonly
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select  REPLACE(TO_chAR(nvl(comissao.valor + despesas.valor,0),'999G999G999G999G990D00'),' ','')
                from ( select sum(f.vlrcomissao)+nvl(sum(f.totalgeral)*3/100,0) valor
                       from fechamentorepresentantes f
                       where f.idfechamento = :P152_IDFECHAMENTO) comissao
                   , ( select sum(d.valor) valor
                       from despesas           d
                       where d.idfechamento = :P152_IDFECHAMENTO) despesas
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

