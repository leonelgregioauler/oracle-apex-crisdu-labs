    region inserir-nova-despesa (
        name: Inserir Nova Despesa
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentossemanais f
                where (nvl(f.concluido,'N') = 'N'
                  and f.idfechamento = :P152_IDFECHAMENTO)
                or  (pck_romance.fnc_verificaacesso('PERM_ALTERAFECHA', v('APP_USER')) = 'S')
                ```
        }
    )

    region mensagem (
        name: Mensagem
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                  vmsg  varchar2(300);
                begin
                  select TO_CHAR(round((to_number(:P152_COMISSAODESPESA,'999G999G999G990D00')/
                	to_number(:P152_TOTALCOBRANCA,'999G999G999G990D00'))*100,2),'990D00')
                  into vmsg
                  from dual;
                htp.p('<b><font color="red" size=5> COMISSÕES E DESPESAS REPRESENTAM '||vmsg||'%</font>');
                exception
                when others then null;
                end;
                ```
        }
        layout {
            sequence: 30
            parentRegion: @agrupador
            slot: subRegions
            startNewRow: false
            newColumn: false
        }
    )

