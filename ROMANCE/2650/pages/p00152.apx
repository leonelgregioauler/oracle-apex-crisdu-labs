    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @despesas
        target {
            tableName: DESPESASROMAN
            pkColumn: IDDESPESA
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Linha(s) #MRU_COUNT# atualizada(s); linha(s) #MRI_COUNT# inserida(s).
        }
        error {
            errorMessage: Não foi possível processar a atualização.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 253360402306581043
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process atualiza-fechamentos (
        name: atualiza fechamentos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  pck_romance.prc_atualiza_gavetas ( :P152_IDFECHAMENTO , v('APP_USER'));
                end;
                ```
        }
        execution {
            sequence: 50
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 253359604291581043
        }
    )

    process fetch-row-from-despesas (
        name: Fetch Row from DESPESAS
        type: autoRowFetch
        source {
            tableName: DESPESASROMAN
            pkColumn: IDDESPESA
            pkItem: P152_IDDESPESA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Unable to fetch row.
        }
        advanced {
            executionMappingIdentifier: 253360001906581043
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDDESPESAS.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P152_IDDESPESA := get_pk; 
                end;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Unable to get primary key item value.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 253360223751581043
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-despesas (
        name: Process Row of DESPESAS
        type: autoRowProcessing
        target {
            tableName: DESPESASROMAN
            pkColumn: IDDESPESA
            pkItem: P152_IDDESPESA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        error {
            errorMessage: Unable to process row of table DESPESAS.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 253360609494581043
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
            point: newSession
        }
        advanced {
