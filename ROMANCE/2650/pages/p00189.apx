page 189 (
    name: Cadastro de Meta
    title: Cadastro de Meta
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='Deseja realmente excluir esta meta?';
            
            function  confirma(event)
            { 
            var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
            
            if (tecla==13) {
            		apex.submit('CREATE');
            }
            }
            ```
        executeWhenPageLoads:
            ```javascript-browser
             window.opener.location.reload();
            if (document.getElementById("P189_IDCAMPANHA").value == '')
            {
              window.opener.location.reload();
              window.close();
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region cadastro-de-meta (
        name: Cadastro de Meta
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P189_IDCAMPANHA (
        type: hidden
        layout {
            sequence: 20
            region: @cadastro-de-meta
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDCAMPANHA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P189_IDMETASCAMPANHA (
        type: hidden
        layout {
            sequence: 10
            region: @cadastro-de-meta
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDMETASCAMPANHA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P189_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Representante
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(pidrepresentante => r.idrepresentante)||' - '||pck_romance.fnc_nomefilial(pck_romance.fnc_filialrepresentante(pidrepresentante => r.idrepresentante)) display_value
                     , r.idrepresentante return_value
                from representantes r
                where r.ativo = 'S'
                  and ( ( :P189_IDMETASCAMPANHA is null
                         and not exists ( select 1
                                           from metascampanha mc
                                           where mc.idrepresentante = r.idrepresentante
                                             and mc.idcampanha      = :P189_IDCAMPANHA ))
                      or :P189_IDMETASCAMPANHA is not null )
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @cadastro-de-meta
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: IDREPRESENTANTE
            used: always
        }
        readOnly {
            type: itemIsNotNull
            item: P189_IDMETASCAMPANHA
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P189_VALORMETAFAVORITA (
        type: numberField
        label {
            label: Meta Favorita
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 50
            region: @cadastro-de-meta
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 15
        }
        validation {
            maxLength: 255
        }
        advanced {
            customAttributes: javascript: onKeyUp="confirma(event)"; style="text-align: right;"
        }
        source {
            type: databaseColumn
            databaseColumn: VALORMETAFAVORITA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P189_VALORMETAGERAL (
        type: numberField
        label {
            label: Meta Geral
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 60
            region: @cadastro-de-meta
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 15
        }
        validation {
            maxLength: 255
        }
        advanced {
            customAttributes: javascript: onKeyUp="confirma(event)"; style="text-align: right;"
        }
        source {
            type: databaseColumn
            databaseColumn: VALORMETAGERAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P189_VALORMETAROMAN (
        type: numberField
        label {
            label: Meta Romance
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 40
            region: @cadastro-de-meta
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 15
        }
        validation {
            maxLength: 15
        }
        advanced {
            customAttributes: javascript: onKeyUp="confirma(event)"; style="text-align: right;"
        }
        source {
            type: databaseColumn
            databaseColumn: VALORMETAROMAN
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Salvar
        layout {
            sequence: 40
            region: @cadastro-de-meta
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P189_IDMETASCAMPANHA
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @cadastro-de-meta
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P189_IDMETASCAMPANHA
        }
    )

    button fechar (
        buttonName: Fechar
        label: Fechar
        layout {
            sequence: 10
            region: @cadastro-de-meta
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 186
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Alterações
        layout {
            sequence: 30
            region: @cadastro-de-meta
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P189_IDMETASCAMPANHA
        }
    )

    process fetch-row-from-metascampanha (
        name: Fetch Row from METASCAMPANHA
        type: autoRowFetch
        source {
            tableName: METASCAMPANHA
            pkColumn: IDMETASCAMPANHA
            pkItem: P189_IDMETASCAMPANHA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 504960098702789520
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P189_IDMETASCAMPANHA is null then
                        select "SEQ_IDMETASCAMPANHA".nextval
                          into :P189_IDMETASCAMPANHA
                          from dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 504960328114789520
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-metascampanha (
        name: Process Row of METASCAMPANHA
        type: autoRowProcessing
        target {
            tableName: METASCAMPANHA
            pkColumn: IDMETASCAMPANHA
            pkItem: P189_IDMETASCAMPANHA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        advanced {
            executionMappingIdentifier: 504960521180789520
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 504960706586789520
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 189
                items: {
                    P189_IDCAMPANHA: &P189_IDCAMPANHA.
                    P189_IDMETASCAMPANHA:
                }
                successMessage: false
            }
        }
    )

)

