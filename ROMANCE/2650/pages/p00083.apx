page 83 (
    name: Distribuição/Semana
    title: Distribuição/Semana
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region distribuição-semana (
        name: Distribuição/Semana
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util.fnc_semanaid(dd.idsemana) semana
                     ,  sum(nvl(QTDPP  ,0)
                     + nvl(QTDP   ,0)
                     + nvl(QTDM   ,0)
                     + nvl(QTDG   ,0)
                     + nvl(QTDGG  ,0)
                     + nvl(QTDEGG ,0)
                     + nvl(QTDEXGG,0)
                     + nvl(QTDXXGG,0)
                     + nvl(QTDU   ,0) ) qtd
                     ,  sum((nvl(QTDPP  ,0)
                     + nvl(QTDP   ,0)
                     + nvl(QTDM   ,0)
                     + nvl(QTDG   ,0)
                     + nvl(QTDGG  ,0)
                     + nvl(QTDEGG ,0)
                     + nvl(QTDEXGG,0)
                     + nvl(QTDXXGG,0)
                     + nvl(QTDU   ,0)) * precocusto ) total
                from distribuicaoempresas dd
                where dd.idfilial = :P83_IDFILIAL
                  and dd.idproduto = :P83_IDPRODUTO
                  and dd.idsemana between :P83_IDSEMANA -7 and :P83_IDSEMANA-1 
                group by dd.idsemana
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: showAll
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
        }
        componentAdvanced {
            stripHtml: true
        }

        column QTD (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Qtd
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            appearance {
                formatMask: 999G999G990
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
            advanced {
                computeSum: true
            }
        )

        column SEMANA (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Semana
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column TOTAL (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Total
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
            advanced {
                computeSum: true
            }
        )

    )

    pageItem P83_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(:P83_IDFILIAL) display_value
                     , :P83_IDFILIAL  return_value
                from dual
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @distribuição-semana
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P83_IDPRODUTO (
        type: selectList
        label {
            label: Produto
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomeproduto(:P83_IDPRODUTO) display_value
                     , :P83_IDPRODUTO return_value
                from dual
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @distribuição-semana
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P83_IDSEMANA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @distribuição-semana
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

