page 246 (
    name: Fotos Depósitos
    title: Fotos Depósitos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 80%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            debugger;
            function fnc_excluirfoto (pid)
            {
              apex.confirm("Deseja realmente excluir esta foto?"
                         , {  request:"DELETAR"
                            , set:{"P246_EXCLUIR":pid}}
                           );
            }    
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region fotos-depósitos (
        name: Fotos Depósitos
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idleituraocr_deposito
                     , iddepositodiario
                     , idrepresentante 
                     , '<iframe  width=500px; height=655px; src="/apex/f?p=2650:261:&APP_SESSION.::NO:RP:P261_ARQUIVO:'||nomearquivo||'"></iframe>' foto
                     , ( select urlcomprovante
                         from comprovantes comp
                         where comp.idcomprovante = d.idcomprovante) urlcomprovante
                     , nvl( nroidentificacao_digitado, ( select dd.nrocomprovante
                                                         from depositosdiarios_orig dd
                                                         where dd.iddepositodiarios = d.iddepositodiario )  ) nroidentificacao_digitado
                     , valor_digitado                      
                     , d.usuariorevisao       
                     , d.datarevisao
                     , decode(d.transferencia,'S','Sim','Não') transferencia
                     , '<button onclick="javascript: fnc_excluirfoto ('||IDLEITURAOCR_DEPOSITO||');" class="t-Button t-Button--danger lto238774214550442118_0" type="button" ><span class="t-Button-label">Deletar</span></button>' deletar     
                from depositosdiarios_leituraocr          D
                where iddepositodiario = :P246_IDDEPOSITODIARIO
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--horizontalBorders
            ]
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }

        column DATAREVISAO (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Data Revisão
                alignment: center
            }
            layout {
                sequence: 73
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
        )

        column DELETAR (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: Deletar
                alignment: center
            }
            layout {
                sequence: 93
            }
            security {
                escapeSpecialChars: false
            }
        )

        column FOTO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Foto
                alignment: center
            }
            layout {
                sequence: 23
            }
            serverSideCondition {
                type: noRowsReturned
                sqlQuery:
                    ```sql
                    select 1
                    from comprovantes
                    where iddepositosdiarios = :P246_IDDEPOSITODIARIO
                    ```
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDDEPOSITODIARIO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column IDLEITURAOCR_DEPOSITO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column IDREPRESENTANTE (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

        column NROIDENTIFICACAO_DIGITADO (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Identificação
                alignment: center
            }
            layout {
                sequence: 43
                columnAlignment: center
            }
        )

        column TRANSFERENCIA (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Transferência
                alignment: center
            }
            layout {
                sequence: 83
                columnAlignment: center
            }
        )

        column URLCOMPROVANTE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Foto (Versão 2)
                alignment: center
            }
            layout {
                sequence: 13
            }
            columnFormatting {
                htmlExpression: <img src="#URLCOMPROVANTE#" style="height: 655px; width: 500px;"/>
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1
                    from comprovantes
                    where iddepositosdiarios = :P246_IDDEPOSITODIARIO
                    ```
            }
        )

        column USUARIOREVISAO (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Usuário
                alignment: center
            }
            layout {
                sequence: 63
                columnAlignment: center
            }
        )

        column VALOR_DIGITADO (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Valor
                alignment: center
            }
            layout {
                sequence: 53
                columnAlignment: center
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
        )

    )

    pageItem P246_EXCLUIR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @fotos-depósitos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P246_IDDEPOSITODIARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @fotos-depósitos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    process exclui-comprovante-do-depósito (
        name: Exclui Comprovante do Depósito
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vvalorinformado  number(15,2);
                  valordepositoori number(15,2);
                  verro            varchar2(4000);
                  vqtdconciliado   number := 0;
                  e_comprovante_vinculado exception;
                  --
                begin
                  --
                  -- Bloqueia a exclusao se o comprovante ja estiver vinculado a uma conciliacao bancaria
                  --
                  select count(*)
                  into vqtdconciliado
                  from roman.conciliacoesbancarias c
                  where c.idleituraocr_deposito = :P246_EXCLUIR;
                  --
                  if vqtdconciliado > 0 then
                    raise e_comprovante_vinculado;
                  end if;
                  --
                  begin
                    pck_financeiro_rmc.prc_removefoto(pidleituraocr_deposito => :P246_EXCLUIR);
                  exception
                    when others then
                      null;
                  end;
                  --
                  select sum(dl.valor_digitado)
                  into vvalorinformado
                  from depositosdiarios_leituraocr dl
                  where dl.iddepositodiario = :P246_IDDEPOSITODIARIO;
                  --
                  select d.valordeposito
                  into valordepositoori
                  from depositosdiarios_orig d
                  where d.iddepositodiarios = :P246_IDDEPOSITODIARIO;
                  --
                  if valordepositoori != vvalorinformado then
                    --
                    execute immediate 'alter table DEPOSITOSDIARIOS_LEITURAOCR disable constraint DK_DEPDIA_OCR_DEPDIA';
                    --
                    pck_financeiro_rmc.prc_alteravalordeposito(piddepositodiario => :P246_IDDEPOSITODIARIO,
                                                               pvalordeposito    => vvalorinformado,
                                                               ppagina           => 230);
                    --
                    execute immediate 'alter table DEPOSITOSDIARIOS_LEITURAOCR enable constraint DK_DEPDIA_OCR_DEPDIA';
                    --
                  end if;
                  --
                  update depositosdiarios
                  set comprovado = 'M'
                  where iddepositodiarios = :P246_IDDEPOSITODIARIO;
                  --
                  update depositosdiarios_orig
                  set comprovado = 'M'
                  where iddepositodiarios = :P246_IDDEPOSITODIARIO;
                  --
                  commit;
                  --
                exception
                  when e_comprovante_vinculado then
                    --
                    raise_application_error(-20001, 'Este comprovante ja esta vinculado a uma conciliacao bancaria e nao pode ser excluido por aqui. Entre em contato com o Financeiro para realizar este ajuste.');
                    --
                  when others then
                    --
                    verro := sqlerrm;
                    --
                    insert into chamados ( idchamado
                                         , dataabertura
                                         , usuario
                                         , titulo
                                         , descricao
                                         , idgrupoatendimento )
                    values ( seq_idchamado.nextval
                           , sysdate
                           , v('APP_USER')
                           , 'Erro na exclusao de comprovante para ajuste de valores do deposito. PAGINA 246'
                           , 'Deposito de nr: '||:P246_IDDEPOSITODIARIO||' apresentou o erro: '||verro
                           , 0 );
                    --
                    commit;
                    --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 4996191212691106650
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 246
                items: {
                    P246_IDDEPOSITODIARIO: &P246_IDDEPOSITODIARIO.
                    P246_EXCLUIR:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

)

