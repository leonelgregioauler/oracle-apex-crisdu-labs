page 458 (
    name: Registros Detalhados SPC
    title: Registros Detalhados SPC
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 70%
        height: 40%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region registros-detalhados (
        name: Registros Detalhados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.estado
                     , r.nomeassociado
                     , r.telefoneassociado
                     , r.nomeentidade
                     , r.tipo
                     , r.contrato
                     , r.datainclusao
                     , r.datavencimento
                     , r.valor
                from vw_restricoesconsultaspc_rmc r
                where r.idconsultaspc = :P458_IDCONSULTASPC
                order by datainclusao
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: "Nenhuma restrição Encontrada! "
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 3510520966607700487
        }

        column CONTRATO (
            type: plainText
            heading {
                heading: Contrato
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column DATAINCLUSAO (
            type: plainText
            heading {
                heading: Inclusão
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: G
            }
        )

        column DATAVENCIMENTO (
            type: plainText
            heading {
                heading: Vencimento
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: H
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: Estado
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column NOMEASSOCIADO (
            type: plainText
            heading {
                heading: Associado
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column NOMEENTIDADE (
            type: plainText
            heading {
                heading: Entidade
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column TELEFONEASSOCIADO (
            type: plainText
            heading {
                heading: Telefone
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column TIPO (
            type: plainText
            heading {
                heading: Tipo da Restrição
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column VALOR (
            type: plainText
            heading {
                heading: Valor
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: I
            }
        )

        savedReport 15066230 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CONTRATO (
                sequence: 6
            )

            displayColumn DATAINCLUSAO (
                sequence: 7
            )

            displayColumn DATAVENCIMENTO (
                sequence: 8
            )

            displayColumn ESTADO (
                sequence: 1
            )

            displayColumn NOMEASSOCIADO (
                sequence: 2
            )

            displayColumn NOMEENTIDADE (
                sequence: 4
            )

            displayColumn TELEFONEASSOCIADO (
                sequence: 3
            )

            displayColumn TIPO (
                sequence: 5
            )

            displayColumn VALOR (
                sequence: 9
            )

            aggregate (
                column: VALOR
            )

        )

    )

    pageItem P458_IDCONSULTASPC (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @registros-detalhados
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

