page 321 (
    name: Cadastro de Usuários
    alias: CADASTRO-DE-USUÁRIOS
    title: Cadastro de Usuários
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 65%
        height: 65%
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    headerAndFooter {
        footerText:
            ```html
            <script javascript>
             window.resizeTo(screen.width*.46,screen.height*.46);  
                window.moveTo(screen.width*.26, screen.height*.20);  
            </script>
            ```
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region cadastro-de-usuários (
        name: Cadastro de Usuários
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
    )

    pageItem P321_ATIVO (
        type: selectList
        label {
            label: Ativo
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @cadastro-de-usuários
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: ATIVO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P321_IDFORNECEDOR (
        type: popupLov
        label {
            label: Fornecedor
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-fornecedor
        }
        layout {
            sequence: 60
            region: @cadastro-de-usuários
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: databaseColumn
            databaseColumn: IDFORNECEDOR
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P321_IDGERENTE (
        type: selectList
        label {
            label: Gerente
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomegerente(idgerente) display_value
                     , idgerente return_value
                from gerentes g
                where pck_romance.fnc_filialgerente(idgerente) = :P0_IDFILIAL
                ```
        }
        layout {
            sequence: 50
            region: @cadastro-de-usuários
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDGERENTE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P321_IDIOMA (
        type: selectList
        label {
            label: Idioma
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(i.nome)||' - '||i.codigo display_value
                 , ididioma return_value
                from favorita.idiomas i
                ```
        }
        layout {
            sequence: 90
            region: @cadastro-de-usuários
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDIDIOMA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P321_IDPESSOA (
        type: hidden
        layout {
            sequence: 20
            region: @cadastro-de-usuários
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDPESSOA
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P321_IDPOSTOAVANCADO (
        type: selectList
        label {
            label: Posto Avançado
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nome
                     , p.idpostoavancado
                from postoavancado p
                where p.idfilial = :P0_IDFILIAL
                ```
        }
        layout {
            sequence: 80
            region: @cadastro-de-usuários
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDPOSTOAVANCADO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P321_IDUSUARIO (
        type: textField
        label {
            label: ID
            alignment: left
        }
        layout {
            sequence: 10
            region: @cadastro-de-usuários
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 10
        }
        advanced {
            customAttributes: readonly
        }
        source {
            type: databaseColumn
            databaseColumn: IDUSUARIO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P321_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 100
            region: @cadastro-de-usuários
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
            height: 3
        }
        validation {
            maxLength: 150
        }
        source {
            type: databaseColumn
            databaseColumn: OBSERVACAO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P321_USUARIO (
        type: textField
        label {
            label: Usuário
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @cadastro-de-usuários
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 50
        }
        source {
            type: databaseColumn
            databaseColumn: USUARIO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 150
            region: @cadastro-de-usuários
            slot: regionBody
            startNewRow: false
            column: 12
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P321_IDUSUARIO
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 130
            region: @cadastro-de-usuários
            slot: regionBody
            startNewRow: false
            columnSpan: 1
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P321_IDUSUARIO
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Alterações
        layout {
            sequence: 120
            region: @cadastro-de-usuários
            slot: regionBody
            columnSpan: 1
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P321_IDUSUARIO
        }
    )

    process fetch-row-from-usuarios (
        name: Fetch Row from USUARIOS
        type: autoRowFetch
        source {
            tableOwner: CATAL
            tableName: USUARIOS
            pkColumn: IDUSUARIO
            pkItem: P321_IDUSUARIO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Não é possível extrair a linha.
        }
        advanced {
            executionMappingIdentifier: 371623038898371691
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDUSUARIO.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P321_IDUSUARIO := get_pk; 
                end;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Não é possível obter valor de item de chave primária.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 371623409443371692
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process insere-usuariossistemas (
        name: Insere usuariossistemas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vpossui varchar2(1);
                  vexiste number;
                begin
                  --
                   begin
                    --
                    select 'S'
                    into vpossui
                    from dual
                    where exists (select 1
                                  from usuariossistemas 
                                  where usuario = upper(:P321_USUARIO) 
                                    and idsistema = 2600);
                  exception
                    when others then
                      vpossui := 'N';
                  end;
                  --
                  
                  --raise_application_error(-20001,'vpossui= '||vpossui || ' USUARIO= '||:P321_USUARIO);
                
                  if vpossui = 'N' then
                    --
                    begin
                      --
                      execute immediate 'create user '||upper(:P321_USUARIO)||' identified by "'||:P321_USUARIO||'"';
                      --
                    exception
                      when others then
                        null;
                    end;
                    --
                    insert into usuariossistemas (idusuariosistema,idsistema,usuario,ativo)
                    values (seq_idusuariossistema.nextval, 2600, upper(:P321_USUARIO), 'S');
                    --
                    COMMIT;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 371624630031371693
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-usuarios (
        name: Process Row of USUARIOS
        type: autoRowProcessing
        target {
            tableOwner: CATAL
            tableName: USUARIOS
            pkColumn: IDUSUARIO
            pkItem: P321_IDUSUARIO
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        error {
            errorMessage: Não é possível processar a linha da tabela USUARIOS.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 371623869066371692
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 60
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 371624217190371692
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        name: Go To Page 8
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 8
            }
            saveStateBeforeBranching: true
        }
    )

    branch (
        name: Voltar para pagina 8
        execution {
            sequence: 11
        }
        behavior {
            target: {
                page: 8
                items: {
                    P8_IDPESSOA: &P321_IDPESSOA.
                }
                clearCache: 8
            }
            saveStateBeforeBranching: true
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

)

