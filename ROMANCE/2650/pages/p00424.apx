    region recebimentos (
        name: Recebimentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select empresa
                     , sum(total) total
                from (  select pck_romance.fnc_nomefilial(o.idfilial) empresa
                             , sum(b.valorcobrado) total
                        from catal.boletos b
                           , pedidos       o
                        where b.semanabaixa = ( select f.semana 
                                                 from fechamentossemanais f 
                                                 where f.idfechamento = :P424_IDFECHAMENTO )
                          and b.idpedido    = o.idpedido
                          and o.idfilial    != 1041 
                        group by o.idfilial
                        union
                        select pck_romance.fnc_nomefilial(p.idfilial) empresa
                             , sum(p.vlrtotalsemcomissao)
                        from catal.pedidos p
                        where p.situacao     = 'O'
                         and semanaemissao   = ( select f.semana 
                                                 from fechamentossemanais f 
                                                 where f.idfechamento = :P424_IDFECHAMENTO )
                         and p.idfilial     != 1041
                         and not exists ( select 1
                                          from boletos b
                                          where b.idpedido = p.idpedido)
                        group by p.idfilial                  
                        union
                        select pck_romance.fnc_nomefilial(pff.idfilialromance) empresa
                             , sum(pf2.valorpago * nvl(pff.fatorconversao,1))
                        from favorita.pagamentospedidos pf2
                           , favorita.vencimentospedidos v
                           , favorita.pedidos pff
                        where pf2.idsemanapago      = ( select f.idsemana 
                                                        from fechamentossemanais f 
                                                        where f.idfechamento = :P424_IDFECHAMENTO )
                          and v.idpedido           = pff.idpedido
                          and v.idvencimentopedido = pf2.idvencimentopedido
                          and pf2.idsituacao       = 20 --- quitado
                          and not  exists ( select 1
                                            from favorita.classificacoespedidos c
                                            where c.idpedido = pff.idpedido
                                              and c.idcaracteristicapedido  = 73 )
                          and v.situacaovencimento = 'V'
                        group by pff.idfilialromance )
                group by empresa
                order by 1
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: item=value
            item: P424_TIPO
            value: R
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
