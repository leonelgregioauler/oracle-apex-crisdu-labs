    region repasses-romance (
        name: Repasses Romance
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select ff.nomefilialfavorita
                         from favorita.filiaisfavorita ff
                         where ff.idfilialfavorita = cp.idfilialfavoritaorigem ) origem
                     , pck_romance.fnc_nomefilial(cp.idfilialromancedestino) destino
                     , cp.numero
                     , sum(ic.quantidadecomprada*ic.valorcusto) total
                from favorita.comprastransferencias cp
                  , favorita.itenscomprastransferencias ic
                where cp.idtipocomptransrem = 6
                  and cp.idcompratransferencia = ic.idcompratransferencia
                  and pck_util.fnc_idsemanadata(dataemissao)  = :P424_IDSEMANA
                group by cp.idfilialfavoritaorigem
                       , cp.idfilialromancedestino
                       , cp.numero
                ```
