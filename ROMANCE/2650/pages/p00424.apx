    region despesas (
        name: Despesas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.unidade 
                     , d.conta
                     , d.subconta
                     , sum(d.valor) valor
                from vw_despesascentroscustos_m d
                   , semana_dias s
                   , fechamentossemanais f
                where f.idfechamento = :P424_IDFECHAMENTO
                  and d.idgruponegocio = 0
                  and d.idcontafinan != 272
                  and d.idregra in ('D','I','X')
                  and d.data between s.dt_ini and s.dt_fim
                  and s.idsemana = f.idsemana
                  and not exists ( select 1
                                   from rateioscentroscustos rr
                                   where rr.idcentrodecusto = d.idcentrodecusto
                                     and rr.percentual is not null )
                group by d.unidade 
                     , d.conta
                     , d.subconta
                union
                select dm.unidade
                     , dm.conta
                     , dm.subconta
                     , sum(round(r.percentual * dm.valor / 100,2)) valor
                from vw_despesascentroscustos_m dm
                   , vw_rateioscentroscustos r
                   , semana_dias s
                where r.idcentrodecusto = dm.idcentrodecusto
                  and exists ( select 1
                               from unidadesdenegocios u
                               where u.idunidadedenegocio = r.idunidadedenegocio
                                 and u.idgruponegocio     = 0 )
                  and s.idsemana = :P424_IDSEMANA
                  and r.percentual > 0
                  and dm.data between s.dt_ini and s.dt_fim
                  and s.mes between r.mesinicial and r.mesfinal
                  and r.vigencia = s.ano
                  and r.tipo = 'M'
                  and r.contabilizadespesa = 'S'
                group by dm.unidade
                     , dm.conta
                     , dm.subconta
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: item=value
            item: P424_TIPO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
