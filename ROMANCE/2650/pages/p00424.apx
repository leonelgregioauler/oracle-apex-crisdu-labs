    region comissões (
        name: Comissões
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(idfilial) empresa
                     , destino
                     , sum(total) total
                from (
                        select pdd.idfilial
                             , case
                                 when pcp.idrepresentante is not null then
                                   'Distribuidor'
                                 else
                                   'Gerente' 
                                   end destino
                             , sum(valorpago) total
                        from pagamentocomissoes pcp
                           , pedidos            pdd
                        where pcp.fechamento = ( select f.semana 
                                                 from fechamentossemanais f 
                                                 where f.idfechamento = :P424_IDFECHAMENTO )
                          and pcp.idpedido   = pdd.idpedido
                        group by pdd.idfilial
                               , case
                                 when pcp.idrepresentante is not null then
                                   'Distribuidor'
                                 else
                                   'Gerente' 
                                   end 
                
                        union
                        select pdf.idfilialromance
                             , case
                                 when pcp.idrepresentante is not null then
                                   'Distribuidor'
                                 else
                                   'Gerente' 
                                   end destino
                             , sum(valorpago * nvl(pdf.fatorconversao,1)) total
                        from pagamentocomissoes pcp
                           , favorita.pedidos   pdf
                        where pcp.fechamento = ( select f.semana 
                                                 from fechamentossemanais f 
                                                 where f.idfechamento = :P424_IDFECHAMENTO )  
                                and not exists ( select 1
                                                 from favorita.classificacoespedidos c
                                                 where c.idpedido = pdf.idpedido
                                                   and c.idcaracteristicapedido  = 73 )
                          and pcp.idpedido          = pdf.idpedido 
                        group by pdf.idfilialromance
                               , case
                                 when pcp.idrepresentante is not null then
                                   'Distribuidor'
                                 else
                                   'Gerente' 
                                   end )
                group by idfilial
                     , destino 
                order by 1, 2
                ```
        }
        layout {
            sequence: 60
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: item=value
            item: P424_TIPO
            value: C
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 262805083656852250
        }

