    region rateios (
        name: Rateios
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select c.nome
                         from centrodecustos c
                         where c.idcentrodecusto = r.idcentrodecusto ) centrodecusto
                     , ( select u.nome
                         from unidadesdenegocios u
                         where u.idunidadedenegocio = r.idunidadedenegocio ) unidadedenegocio
                     , r.percentual
                     , rateio.valor
                     , round(( r.percentual * rateio.valor / 100 ),2) rateio
                from vw_rateioscentroscustos r
                   , semana_dias s
                   , ( select md.idcentrodecusto
                            , sum(md.valor) valor 
                       from vw_despesascentroscustos_m md
                          , semana_dias s
                       where s.idsemana = :P424_IDSEMANA
                         and md.data between s.dt_ini and s.dt_fim
                       group by md.idcentrodecusto ) rateio 
                where exists ( select 1
                               from unidadesdenegocios u
                               where u.idgruponegocio = 0
                                 and u.idunidadedenegocio = r.idunidadedenegocio )
                  and r.vigencia = s.ano
                  and s.idsemana = :P424_IDSEMANA
                  and r.percentual > 0
                  and s.mes between r.mesinicial and r.mesfinal
                  and r.tipo = 'M'
                  and r.contabilizarateio = 'S'
                  and r.idcentrodecusto = rateio.idcentrodecusto(+);
                ```
        }
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
