    region por-fornecedor-v1-v (
        name: " Por Fornecedor ( v1 + v2 )"
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH params AS (
                    SELECT to_date(:P241_DATA_INI, 'DD/MM/RRRR') dt_ini,
                           to_date(:P241_DATA_FIM, 'DD/MM/RRRR') + 1 dt_fim
                    FROM dual
                ),
                tipos AS (
                    SELECT column_value tipo_fornecedor
                    FROM table(apex_string.split(:P241_TIPOFORNECEDORES, '/'))
                ),
                forn AS (
                    SELECT ff.idfornecedor,
                           ff.idpessoa,
                           initcap(p.nomepessoa) fornecedor,
                           v.descricao tipo_fornecedor
                    FROM fornecedores ff
                       , pessoas p
                       , roman.siglasistema s
                       , roman.valorsiglasistema v
                    WHERE p.idpessoa = ff.idpessoa
                      AND s.idsiglasistema = v.idsiglasistema
                      AND s.nomesigla = 'TIPO_FORNECEDOR'
                      AND ff.tipo_fornecedor = v.sigla
                      AND ff.ativo = 'S'
                      AND (:P241_FORNECEDOR IS NULL OR :P241_FORNECEDOR = p.idpessoa)
                      AND (
                            :P241_TIPOFORNECEDORES IS NULL
                            OR ff.tipo_fornecedor IN (SELECT tipo_fornecedor FROM tipos)
                          )
                ),
                depositos_validos AS (
                    SELECT cb.idpessoa,
                           SUM(d.valordeposito * NVL(f.fatorconversao,1)) v2
                    FROM depositosdiarios_orig d
                       , contasbancarias cb
                       , params p
                       , filiais f
                    WHERE d.idcontabanc = cb.idcontabanc
                      AND d.tipo <> 'AB'
                      AND d.data >= p.dt_ini
                      AND d.data <  p.dt_fim
                      AND f.idfilial = pck_romance.fnc_filialrepresentante(d.idrepresentante)
                      AND NOT EXISTS (
                            SELECT 1
                            FROM depositosdiarios dd
                            WHERE dd.iddepositodiarios = d.iddepositodiarios
                          )
                    GROUP BY cb.idpessoa
                ),
                pagamentos_validos AS (
                    SELECT pf.idfornecedor,
                           SUM(pf.valorpago) v1
                    FROM pagamentosfornecedores pf
                       , params p
                    WHERE pf.idcontapagamento NOT IN (6789, 4646)
                      AND pf.databaixa >= p.dt_ini
                      AND pf.databaixa <  p.dt_fim
                      AND NOT EXISTS (
                            SELECT 1
                            FROM notasfiscais nf
                            WHERE nf.idnotafiscal = pf.idnotafiscal
                              AND nf.idcompratransferencia IS NOT NULL
                          )
                    GROUP BY pf.idfornecedor
                ),
                fornecedores_com_deposito AS (
                    SELECT DISTINCT c.idpessoa
                    FROM depositosdiarios_orig dp
                       , contasbancarias c
                       , params p
                    WHERE dp.idcontabanc = c.idcontabanc
                      AND dp.tipo <> 'AB'
                      AND dp.idordemdeposito IS NOT NULL
                      AND dp.data >= p.dt_ini - 10
                      AND dp.data <  p.dt_fim
                )
                SELECT f.fornecedor,
                       f.tipo_fornecedor,
                       NVL(p.v1, 0) v1,
                       NVL(d.v2, 0) v2,
                       NVL(p.v1, 0) + NVL(d.v2, 0) valores
                FROM forn f
                LEFT JOIN depositos_validos d
                       ON d.idpessoa = f.idpessoa
                LEFT JOIN pagamentos_validos p
                       ON p.idfornecedor = f.idfornecedor
                WHERE EXISTS (
                        SELECT 1
                        FROM fornecedores_com_deposito x
                        WHERE x.idpessoa = f.idpessoa
                      )
                  AND NVL(p.v1, 0) + NVL(d.v2, 0) > 0
                ORDER BY 5 desc
                ```
            pageItemsToSubmit: [
                P241_DATA_INI
                P241_DATA_FIM
                P241_MERCADO
                P241_FORNECEDOR
                P241_TIPOFORNECEDORES
            ]
        }
        layout {
            sequence: 20
            parentRegion: @agrupado
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent6
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        reportLayout {
            numberOfRows: 100
