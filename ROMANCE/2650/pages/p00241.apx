    process normaliza-intervalo-de-datas (
        name: Normaliza Intervalo de Datas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  -- Preenche defaults e protege o intervalo (evita varredura de anos)
                  --
                  if :P241_DATA_INI is null then
                    :P241_DATA_INI := to_char(trunc(sysdate),'DD/MM/RRRR');
                  end if;
                  --
                  if :P241_DATA_FIM is null then
                    :P241_DATA_FIM := to_char(trunc(sysdate),'DD/MM/RRRR');
                  end if;
                  --
                  if to_date(:P241_DATA_FIM,'DD/MM/RRRR') < to_date(:P241_DATA_INI,'DD/MM/RRRR') then
                    :P241_DATA_FIM := :P241_DATA_INI;
                  end if;
                  --
                  if to_date(:P241_DATA_FIM,'DD/MM/RRRR')
                   - to_date(:P241_DATA_INI,'DD/MM/RRRR') > 180 then
                    :P241_DATA_INI := to_char(to_date(:P241_DATA_FIM,'DD/MM/RRRR') - 180,'DD/MM/RRRR');
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 5422662676664572134
        }
    )

    branch (
        name: Filtrar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 241
                items: {
                    P241_DATA_INI: &P241_DATA_INI.
                    P241_DATA_FIM: &P241_DATA_FIM.
                }
                action: resetPagination
            }
        }
    )

)

