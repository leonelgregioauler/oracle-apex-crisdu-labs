                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: Nenhuma informação localizada
        }
