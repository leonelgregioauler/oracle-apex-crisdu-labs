            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nomepessoa "Fornecedor", p.idpessoa
                  from fornecedores f
                     , pessoas p
                 where p.idpessoa = f.idpessoa
                   and p.ativo = 'S'
                 order by p.nomepessoa
