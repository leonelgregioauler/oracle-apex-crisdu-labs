            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Mercado
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column QTD_DEPOSITOS (
            reportColumnQueryId: 3
