    region por-fornecedor (
        name: " Por Fornecedor"
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH params AS (
                    SELECT to_date(:P241_DATA_INI, 'DD/MM/RRRR') dt_ini,
                           to_date(:P241_DATA_FIM, 'DD/MM/RRRR') + 1 dt_fim
                    FROM dual
                ),
                depositos AS (
                    SELECT c.idpessoa,
                           pck_romance.fnc_filialrepresentante(d.idrepresentante) idfilial,
                           d.valordeposito
                    FROM depositosdiarios_orig d
                       , contasbancarias c
                       , params p
                    WHERE c.idcontabanc = d.idcontabanc
                      AND d.data >= p.dt_ini
                      AND d.data <  p.dt_fim
                      AND d.tipo <> 'AB'
                      AND (:P241_FORNECEDOR IS NULL OR :P241_FORNECEDOR = c.idpessoa)
                      AND NOT EXISTS (
                            SELECT 1
                            FROM depositosdiarios dd
                            WHERE dd.iddepositodiarios = d.iddepositodiarios
                          )
                ),
                depositos_filtrados AS (
                    SELECT d.idpessoa,
                           SUM(d.valordeposito * NVL(f.fatorconversao,1)) value
                    FROM depositos d
                       , filiais f
                    WHERE f.idfilial = d.idfilial
                    GROUP BY d.idpessoa
                )
                SELECT pck_romance.fnc_nomepessoa(df.idpessoa) fornecedor,
                       df.value
                FROM depositos_filtrados df
                ORDER BY fornecedor
                ```
