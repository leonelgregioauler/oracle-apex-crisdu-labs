    region por-empresa (
        name: " Por empresa"
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH params AS (
                    SELECT to_date(:P241_DATA_INI,'DD/MM/RRRR')     dt_ini
                         , to_date(:P241_DATA_FIM,'DD/MM/RRRR') + 1 dt_fim
                      FROM dual
                ),
                tipos AS (
                    SELECT column_value tipo_fornecedor
                      FROM table(apex_string.split(:P241_TIPOFORNECEDORES,'/'))
                ),
                -- ####################################################################
                -- #  UNICO ponto de configuracao do criterio Brasil x Mercado Externo #
                -- #  Troque o CASE abaixo se existir coluna de pais / sigla propria.  #
                -- ####################################################################
                filial_mercado AS (
                    SELECT f.idfilial
                         , NVL(f.fatorconversao,1) fatorconversao
                         , CASE WHEN NVL(f.fatorconversao,1) = 1
                                THEN 'Brasil'
                                ELSE 'Mercado Externo'
                           END mercado
                      FROM filiais f
                ),
                depositos AS (
                    SELECT pck_romance.fnc_filialrepresentante(d.idrepresentante) idfilial
                         , c.idpessoa
                         , d.data
                         , d.valordeposito
                      FROM depositosdiarios_orig d
                         , contasbancarias      c
                         , params               p
                     WHERE c.idcontabanc = d.idcontabanc
                       AND d.data  >= p.dt_ini
                       AND d.data  <  p.dt_fim
                       AND d.tipo  <> 'AB'
                       AND NOT EXISTS (SELECT 1
                                         FROM depositosdiarios dd
                                        WHERE dd.iddepositodiarios = d.iddepositodiarios)
                       AND (:P241_FORNECEDOR IS NULL OR :P241_FORNECEDOR = c.idpessoa)
                       AND (:P241_TIPOFORNECEDORES IS NULL
                            OR EXISTS (SELECT 1
                                         FROM fornecedores ff
                                        WHERE ff.idpessoa = c.idpessoa
                                          AND ff.tipo_fornecedor IN (SELECT tipo_fornecedor FROM tipos)))
                ),
                base AS (
                    SELECT d.idfilial
                         , m.mercado
                         , d.data
                         , d.valordeposito * m.fatorconversao valor
                      FROM depositos      d
                      JOIN filial_mercado m ON m.idfilial = d.idfilial
                     WHERE (:P241_MERCADO IS NULL OR m.mercado = :P241_MERCADO)
                )
                SELECT NULL                                   link
                     , pck_romance.fnc_nomefilial(b.idfilial) label
                     , SUM(b.valor)                           value
                     , b.mercado                              mercado
                  FROM base b
                 GROUP BY b.mercado, b.idfilial, pck_romance.fnc_nomefilial(b.idfilial)
                 ORDER BY b.mercado, 3 DESC
                ```
            pageItemsToSubmit: [
                P241_DATA_INI
                P241_DATA_FIM
                P241_MERCADO
                P241_FORNECEDOR
                P241_TIPOFORNECEDORES
            ]
        }
        layout {
            sequence: 10
            parentRegion: @agrupado
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 500
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: Nenhuma informação localizada
        }
        componentAdvanced {
            stripHtml: true
        }
        download {
            csvExportEnabled: true
            linkText: Clique aqui para fazer Download
