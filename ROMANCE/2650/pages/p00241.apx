    region por-fornecedor-conta (
        name: " Por Fornecedor / Conta"
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH params AS (
                    SELECT to_date(:P241_DATA_INI, 'DD/MM/RRRR') dt_ini,
                           to_date(:P241_DATA_FIM, 'DD/MM/RRRR') + 1 dt_fim
                    FROM dual
                ),
                tipos AS (
                    SELECT column_value tipo_fornecedor
                    FROM table(apex_string.split(:P241_TIPOFORNECEDORES, '/'))
                ),
                depositos AS (
                    SELECT d.idcontabanc,
                           c.idpessoa,
                           pck_romance.fnc_filialrepresentante(d.idrepresentante) idfilial,
                           d.valordeposito
                    FROM depositosdiarios_orig d,
                         contasbancarias c,
                         params p
                    WHERE c.idcontabanc = d.idcontabanc
                      AND d.data >= p.dt_ini
                      AND d.data <  p.dt_fim
                      AND d.tipo <> 'AB'
                      AND (:P241_FORNECEDOR IS NULL OR :P241_FORNECEDOR = c.idpessoa)
                      AND (
                            :P241_TIPOFORNECEDORES IS NULL
                            OR EXISTS (
                                  SELECT 1
                                  FROM fornecedores ff
                                  WHERE ff.idpessoa = c.idpessoa
                                    AND ff.tipo_fornecedor IN (SELECT tipo_fornecedor FROM tipos)
                                )
                          )
                      AND NOT EXISTS (
                            SELECT 1
                            FROM depositosdiarios dd
                            WHERE dd.iddepositodiarios = d.iddepositodiarios
                          )
                ),
                depositos_filtrados AS (
                    SELECT d.idcontabanc,
                           d.idpessoa,
                           SUM(d.valordeposito * NVL(f.fatorconversao,1)) value
                    FROM depositos d,
                         filiais f
                    WHERE f.idfilial = d.idfilial
                    GROUP BY d.idcontabanc,
                             d.idpessoa
                )
                SELECT pck_cadastros_rmc.fnc_retornacontabancaria(df.idcontabanc) label,
                       pck_romance.fnc_nomepessoa(df.idpessoa) fornecedor,
