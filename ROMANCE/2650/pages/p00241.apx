page 241 (
    name: Indicadores de Depósitos
    title: Indicadores de Depósitos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region agrupado (
        name: Agrupado
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region análise-de-quantidade-de-depósitos-por-dia (
        name: Análise de Quantidade de Depósitos por dia
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select null link
                     , trunc(data) label
                   --  , sum(valordeposito) "Valor Depositado"
                     , count(distinct idrepresentante)"Distribuidores Atendidos"
                from depositosdiarios_orig d
                where data >= to_date(:P241_DATA_INI,'DD/MM/RRRR')
                  and data <  to_date(:P241_DATA_FIM,'DD/MM/RRRR') + 1
                  and pck_romance.fnc_filialrepresentante(d.idrepresentante) != 240
                 -- and d.usuario in ('KEURIN','NEIDI','DIONARA')
                group by  trunc(data) 
                order by 2 
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            escapeSpecialChars: false
        }
        chart {
            type: combination
        }
        title {
            title: Depósitos por Dia
        }
        chartLayout {
            height: 400
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        animation {
            onDataChange: none
        }
        tooltip {
            showSeriesName: false
        }
        legend {
            position: end
            hideAndShowBehavior: none
        }
        messages {
            whenNoDataFound: no data found
        }

