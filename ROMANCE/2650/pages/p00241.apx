    region análise-de-valores-de-depósitos-por-hora (
        name: Análise de Valores de Depósitos por Hora
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select null link
                     , to_number(to_char(data,'HH24')) label
                  --   , sum(valordeposito) "Valor Depositado"
                     , count(1)"Qtd de Depósitos"
                from depositosdiarios_orig d
                where data >= to_date(:P241_DATA_INI,'DD/MM/RRRR')
                  and data <  to_date(:P241_DATA_FIM,'DD/MM/RRRR') + 1
                  and pck_romance.fnc_filialrepresentante(d.idrepresentante) != 240
                  and exists( select 1
                              from filiais f
                              where f.idfilial = pck_romance.fnc_filialrepresentante(d.idrepresentante)
                                and fatorconversao = 1 )
                group by  to_number(to_char(data,'HH24')) 
                order by 2 
                ```
        }
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            escapeSpecialChars: false
        }
