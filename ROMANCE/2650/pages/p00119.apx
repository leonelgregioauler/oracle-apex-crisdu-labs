    pageItem P119_IDCIDADE (
        type: popupLov
        label {
            label: Cidade
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nomecidade ||' - '|| e.sigla
                     , c.idcidade
                from cidades c
                   , estados e
                where c.idestado = e.idestado
                order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 200
            region: @contato-do-site
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: IDCIDADE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

