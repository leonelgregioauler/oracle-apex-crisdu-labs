    process fetch-row-from-controlecontatossite (
        name: Fetch Row from CONTROLECONTATOSSITE
        type: autoRowFetch
        source {
            tableName: CONTROLECONTATOSSITE
            pkColumn: IDCONTROLECONTATOSSITE
            pkItem: P119_IDCONTROLECONTATOSSITE
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Não é possível extrair a linha.
        }
        advanced {
            executionMappingIdentifier: 182581223881569006
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select SEQ_IDCTRLCONTATOSITE.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P119_IDCONTROLECONTATOSSITE := get_pk; 
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Não é possível obter valor de item de chave primária.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 182581429978569009
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-controlecontatossite (
        name: Process Row of CONTROLECONTATOSSITE
        type: autoRowProcessing
        target {
            tableName: CONTROLECONTATOSSITE
            pkColumn: IDCONTROLECONTATOSSITE
            pkItem: P119_IDCONTROLECONTATOSSITE
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        error {
            errorMessage: Não é possível processar a linha da tabela CONTROLECONTATOSSITE.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 182581636584569009
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 182581820079569009
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 21
        }
        behavior {
            target: {
                page: 119
            }
            saveStateBeforeBranching: true
        }
    )

    branch (
