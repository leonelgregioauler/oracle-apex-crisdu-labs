    pageItem P119_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomefilial(idfilial) display_value
                     , idfilial return_Value
                from filiais F
                where f.tipofilial = 'D'
                  and f.ativo = 'S'
                order by 1 
                ```
        }
        layout {
            sequence: 50
            region: @contato-do-site
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P119_IDREPRESENTANTE (
        type: selectList
        label {
            label: Representante
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_romance.fnc_nomerepresentante(idrepresentante) display_value
                    , idrepresentante return_value
                from representantes R
                where r.ativo = 'S'
                  and idgerente = ( select idgerente from gerentes where idfilial = :P119_IDFILIAL)
                order by 1 
                ```
        }
        cascadingLov {
            parentItems: P119_IDFILIAL
        }
        layout {
            sequence: 100
            region: @contato-do-site
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDREPRESENTANTE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

