    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 40
            region: @contato-do-site
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P119_IDCONTROLECONTATOSSITE
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @contato-do-site
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P119_IDCONTROLECONTATOSSITE
        }
    )

