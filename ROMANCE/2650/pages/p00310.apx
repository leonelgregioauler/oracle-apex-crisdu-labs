page 310 (
    name: Filtro de Fornecedores
    title: Filtro de Fornecedores
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region filtro-de-fornecedores (
        name: Filtro de Fornecedores
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "ROWID",
                "IDFORNECEDOR",
                "USUARIO"
                from "#OWNER#"."FILTROSFORNECEDORES"
                where usuario = v('APP_USER')
                ```
        }
        layout {
            sequence: 15
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhum fornecedor selecionado
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 4
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column IDFORNECEDOR (
            reportColumnQueryId: 2
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Fornecedor
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_romance.fnc_nomefornecedor(idfornecedor) display_value
                         , fe.idfornecedor return_value
                    from fornecedores fe
                    where fe.ativo = 'S'
                    order by 1
                    ```
            }
            layout {
                sequence: 3
            }
            advanced {
                cellWidth: 30
            }
        )

        column ROWID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
            security {
                escapeSpecialChars: false
            }
        )

        column USUARIO (
            reportColumnQueryId: 3
            derivedColumn: N
            type: textField
            heading {
                heading: Usuario
                alignment: center
            }
            layout {
                sequence: 4
            }
            appearance {
                width: 15
            }
            default {
                type: plsqlExpression
                plsqlExpression: v('APP_USER')
            }
            advanced {
                customAttributes: readonly
            }
        )

    )

    button add (
        buttonName: ADD
        label: Add +
        layout {
            sequence: 40
            region: @filtro-de-fornecedores
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.widget.tabular.addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button deletar (
        buttonName: DELETAR
        label: Deletar
        layout {
            sequence: 20
            region: @filtro-de-fornecedores
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Deseja realmente deletar?','DELETAR');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Criar
        layout {
            sequence: 30
            region: @filtro-de-fornecedores
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @filtro-de-fornecedores
        target {
            tableName: FILTROSFORNECEDORES
            pkColumn: ROWID
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: #MRD_COUNT# linha(s) deletada.
        }
        advanced {
            executionMappingIdentifier: 1575467226708676250
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
            executeCondition: once
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @filtro-de-fornecedores
        target {
            tableName: FILTROSFORNECEDORES
            pkColumn: ROWID
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# linha(s) atualizada, #MRI_COUNT# linha(s) inserida.
        }
        advanced {
            executionMappingIdentifier: 1575466859063676249
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        name: Go To Page 310
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 310
            }
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

)

