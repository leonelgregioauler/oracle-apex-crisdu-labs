    region investimentos (
        name: Investimentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                        select ( select u.nome
                                 from unidadesdenegocios u
                                 where u.idunidadedenegocio = :P314_IDUNIDADEDENEGOCIO ) unidade
                             , :P314_ANO ano
                             , m.mes
                             , m.numero
                            -- , t.numero
                             , nvl(r.receitas,0) receitas
                             , ( nvl(d.despesas,0) + 
                                 nvl( ( pck_centrodecustos_rmc.fnc_valoresrateios_despesas(:P314_IDUNIDADEDENEGOCIO,m.numero,m.numero,:P314_ANO) ),0) 
                                )*-1 pagamentos
                             --
                
                             , ( nvl(r.receitas,0) -
                                 nvl(d.despesas,0) -
                                 nvl( ( pck_centrodecustos_rmc.fnc_valoresrateios_despesas(:P314_IDUNIDADEDENEGOCIO,m.numero,m.numero,:P314_ANO) ),0)
                                ) resultado
                             --
                             , nvl( pck_centrodecustos_rmc.fnc_valoresrateios(:P314_IDUNIDADEDENEGOCIO,m.numero, m.numero,:P314_ANO),0 ) * -1 as rateios
                             --
                             , ( nvl(r.receitas,0)
                               - nvl(d.despesas,0)
                               - nvl( ( pck_centrodecustos_rmc.fnc_valoresrateios_despesas(:P314_IDUNIDADEDENEGOCIO,m.numero,m.numero,:P314_ANO) ),0)
                               - nvl( pck_centrodecustos_rmc.fnc_valoresrateios( :P314_IDUNIDADEDENEGOCIO,m.numero, m.numero,:P314_ANO),0 ) 
                               ) resultado_liquido
                             --
                
                          from ( select dd.mes, sum(dd.valor) despesas
                                   from vw_despesascentroscustos_m dd
                                      , meses                      mm
                                  where dd.idunidadedenegocio = :P314_IDUNIDADEDENEGOCIO
                                    and dd.mes = mm.numero
                                    and dd.ano = :P314_ANO
                                    and not exists ( select 1
                                                     from rateioscentroscustos rr
                                                     where rr.idcentrodecusto = dd.idcentrodecusto
                                                       and rr.percentual is not null ) 
                                    group by dd.mes )   d
                             --
                             , ( select rr.idmes, sum(rr.valor) receitas
                                   from vw_receitascentroscustos_m rr
                                      , meses                      mm
                                  where rr.idmes              = mm.numero
                                    and rr.idunidadedenegocio = :P314_IDUNIDADEDENEGOCIO
                                    and rr.ano                = :P314_ANO 
                                  group by rr.idmes )    r
                             --
                             , meses                        m
                         where m.numero = d.mes(+)
                           and m.numero = r.idmes(+)  
                  
                   order by m.numero
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
