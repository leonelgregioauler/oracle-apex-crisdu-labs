    region acompanhamento-anual-das-lojas (
        name: Acompanhamento Anual das Lojas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , i.ano
                     , i.receita
                     , i.despesas
                     , i.resultado
                     , i.rateios
                     , i.resultadoliquido
                from vw_filiais f
                   , investimentosanuais i
                where f.ativo = 'S'
                  and f.tipofilial = 'A'
                  and i.idunidadedenegocio = f.idunidadedenegocio
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 493332857033633411
        }

