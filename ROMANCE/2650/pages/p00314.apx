    pageItem P314_ANO (
        type: selectList
        label {
            label: Ano
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct ano display_value
                    , ano return_value
                from semana_dias s
                where s.ano between 2020 and 2025
                order by 1 desc
                ```
        }
        layout {
            sequence: 20
            region: @investimentos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                return to_char(sysdate,'RRRR');
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P314_IDUNIDADEDENEGOCIO (
        type: selectList
        label {
            label: Unidade
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.UIDADEDENEGOCIO
                     , f.idunidadedenegocio
                from vw_filiais f
                where tipofilial = 'A'
                  and f.ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @investimentos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction refresh-pagina (
        name: Refresh Pagina
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P314_IDUNIDADEDENEGOCIO
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-pagina-2 (
        name: Refresh Pagina 2
        execution {
            sequence: 20
        }
