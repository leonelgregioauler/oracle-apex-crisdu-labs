page 362 (
    name: "Receitas "
    title: "Receitas "
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region receitas (
        name: Receitas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.nome  segmento
                     , g.descricao  grupo
                     , u.nome unidadenegocio
                     , pck_romance.fnc_nomepessoa(f.idpessoa) caixa
                     , nvl(( select round(sum(ff.totalcobranca*ff.fatorconversao) ,2)
                             from fechamentossemanais ff
                             where ff.idfilial = f.idfilial 
                               and ff.idsemana between :P362_IDSEMANAINICIO and :P362_IDSEMANAFIM ),0) totalfinanceiro
                     , nvl(( select round(sum(ff.totalcomissoesrepresentantes*ff.fatorconversao) ,2)
                             from fechamentossemanais ff
                             where ff.idfilial = f.idfilial 
                               and ff.idsemana between :P362_IDSEMANAINICIO and :P362_IDSEMANAFIM ),0) comissoesdistribuidores
                     , nvl(( select round(sum(ff.totalcomissaogerente*ff.fatorconversao) ,2)
                             from fechamentossemanais ff
                             where ff.idfilial = f.idfilial 
                               and ff.idsemana between :P362_IDSEMANAINICIO and :P362_IDSEMANAFIM ),0) comissoesgestores
                from unidadesdenegocios u
                   , gruposnegocios g  
                   , segmentosnegocios s
                   , filiais f
                where f.idunidadedenegocio = u.idunidadedenegocio
                  and g.idgruponegocio     = u.idgruponegocio
                  and s.idsegmentonegocio  = g.idsegmentonegocio 
                order by 1, 2, 4, 5;
                
                ```
            pageItemsToSubmit: [
                P362_IDSEMANAINICIO
                P362_IDSEMANAFIM
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P362_IDSEMANAINICIO is not null and :P362_IDSEMANAFIM is not null
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 12398593248302542
        }

