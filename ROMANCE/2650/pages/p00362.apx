    pageItem P362_IDSEMANAFIM (
        type: selectList
        label {
            label: Até
            alignment: left
        }
        settings {
            pageActionOnSelection: submitPage
            executeValidations: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(s.semana,'00')||'/'||s.ano semana
                     , s.idsemana
                from semana_dias s
                where s.ano between to_char(sysdate,'RRRR')-1 and to_char(sysdate,'RRRR')
                order by idsemana
                ```
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
