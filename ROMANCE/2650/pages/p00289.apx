page 289 (
    name: Habilitar Produtos
    title: Habilitar Produtos
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region habilitar-produtos (
        name: Habilitar Produtos
        type: tabform
        source {
            sqlQuery:
                ```sql
                select idestoquefilial
                     , ( select case 
                                  when f.ididioma not in (1,2) then
                                    ( select p.nome
                                      from paises p
                                      where p.idpais = f.ididioma )||' - '||f.nome
                                  else
                                    f.nome
                                end nome
                         from vw_filiais f
                         where f.idfilial = e.idfilial ) filial
                     , idproduto
                     , ativo
                     , comissao
                     , vlrvenda
                     , idestoquefilial id
                from estoquefilial e
                where idproduto = :P289_IDPRODUTO
                  and idfilial != 1122
                  and exists (select 1 from vw_filiais f where f.idfilial = e.idfilial)
                ```
        }
        layout {
            sequence: 15
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 200
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
        }
        componentAdvanced {
            stripHtml: true
        }

        column ATIVO (
            reportColumnQueryId: 4
            derivedColumn: N
            type: radioGroup
            heading {
                heading: Ativo
            }
            lov {
                type: staticValues
                staticValues: STATIC:Sim;S,Não;N
                displayNullValue: false
            }
            layout {
                sequence: 4
            }
            element {
                numberOfColumns: 2
            }
        )

        column COMISSAO (
            reportColumnQueryId: 5
            derivedColumn: N
            type: radioGroup
            heading {
                heading: Comissão
            }
            lov {
                type: staticValues
                staticValues: STATIC:Sim;S,Não;N
                displayNullValue: false
            }
            layout {
                sequence: 5
            }
            element {
                numberOfColumns: 2
            }
        )

        column FILIAL (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Filial
                alignment: center
            }
            layout {
                sequence: 2
            }
            sorting {
                defaultSequence: 1
            }
        )

        column ID (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: ID
                alignment: center
            }
            layout {
                sequence: 7
            }
        )

        column IDESTOQUEFILIAL (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 1
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDESTOQUEFIL
            }
        )

        column IDPRODUTO (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 3
            }
            default {
                type: item
                item: P289_IDPRODUTO
            }
        )

        column VLRVENDA (
            reportColumnQueryId: 6
            derivedColumn: N
            type: textField
            heading {
                heading: Vlr Venda
            }
            layout {
                sequence: 6
            }
            appearance {
                formatMask: 999G999G999G999G999G990D00
                width: 8
            }
            advanced {
                customAttributes: " style=\"text-align:right\""
            }
        )

    )

    pageItem P289_IDPRODUTO (
        type: selectList
        label {
            label: Produto
            alignment: right
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nomeproduto) display_value
                     , idproduto return_value
                from produtos
                where idproduto = :P289_IDPRODUTO
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @habilitar-produtos
            slot: regionBody
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Fechar
        layout {
            sequence: 10
            region: @habilitar-produtos
            slot: topAndBottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: window.parent.location.reload(); window.close();
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Salvar
        layout {
            sequence: 20
            region: @habilitar-produtos
            slot: topAndBottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation comissao (
        name: COMISSAO
        execution {
            sequence: 100
        }
        validation {
            editableRegion: @habilitar-produtos
            type: columnIsNotNull
            column: COMISSAO
        }
        error {
            errorMessage: Informe se tem comissão!
            associatedColumn: COMISSAO
        }
    )

    validation vlrvenda-must-be-numeric (
        name: VLRVENDA must be numeric
        execution {
            sequence: 90
        }
        validation {
            editableRegion: @habilitar-produtos
            type: columnIsNumeric
            column: VLRVENDA
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: VLRVENDA
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @habilitar-produtos
        target {
            tableName: ESTOQUEFILIAL
            pkColumn: IDESTOQUEFILIAL
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# row(s) updated, #MRI_COUNT# row(s) inserted.
        }
        advanced {
            executionMappingIdentifier: 710343319705551042
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process fix-habilitar-produtos-mobile-css (
        name: Fix Habilitar Produtos Mobile CSS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                apex_css.add(p_css => '
                .t-Region--accent4 input[type=radio] {
                  width:20px !important;
                  height:20px !important;
                  margin:0 6px 0 14px !important;
                  vertical-align:middle !important;
                  -webkit-appearance:radio !important;
                  appearance:auto !important;
                }
                .t-Region--accent4 input[type=radio]:first-of-type {
                  margin-left:0 !important;
                }
                .t-Region--accent4 .t-Button,
                .t-Region--accent4 button {
                  display:inline-block !important;
                  visibility:visible !important;
                  opacity:1 !important;
                }
                @media (max-width: 640px) {
                  label[for="P289_IDPRODUTO"] {
                    display:block !important;
                    margin:0 0 8px 20px !important;
                  }
                  #P289_IDPRODUTO {
                    display:block !important;
                    width:calc(100% - 40px) !important;
                    max-width:calc(100% - 40px) !important;
                    margin-left:20px !important;
                    box-sizing:border-box !important;
                  }
                  .t-Region--scrollBody {
                    display:block !important;
                    overflow-x:visible !important;
                    width:100% !important;
                    max-width:100% !important;
                    min-width:0 !important;
                  }
                  .t-Region--scrollBody div:has(table) {
                    display:block !important;
                    overflow-x:visible !important;
                    width:100% !important;
                    max-width:100% !important;
                    min-width:0 !important;
                    box-sizing:border-box !important;
                  }
                  .t-Region--accent4 div:has(> table) {
                    margin:0 !important;
                    padding:0 !important;
                  }
                  .t-Region--accent4 table {
                    margin:0 !important;
                  }
                  .t-Region--accent4 table thead,
                  .t-Region--accent4 table tfoot,
                  .t-Region--accent4 .t-Report-paginationText,
                  .t-Region--accent4 .t-PaginationRegion,
                  .t-Region--accent4 .a-IRR-pagination,
                  .t-Region--accent4 table tbody tr:not(:has(input)):not(:has(button)) {
                    display:none !important;
                  }
                  .t-Region--accent4 table, .t-Region--accent4 table tbody {
                    display:block !important;
                    width:100% !important;
                    max-width:100% !important;
                    min-width:0 !important;
                    box-sizing:border-box !important;
                  }
                  .t-Region--accent4 table tbody tr {
                    display:flex !important;
                    flex-direction:column !important;
                    width:100% !important;
                    max-width:100% !important;
                    box-sizing:border-box !important;
                    background:#ffffff !important;
                    border:1px solid #e5e7eb !important;
                    border-radius:12px !important;
                    box-shadow:0 1px 3px rgba(16,24,40,.06) !important;
                    padding:16px !important;
                    margin:0 0 16px !important;
                    gap:12px !important;
                  }
                  .t-Region--accent4 table tbody td {
                    display:flex !important;
                    flex-wrap:wrap !important;
                    justify-content:space-between !important;
                    align-items:center !important;
                    border:none !important;
                    padding:0 !important;
                    text-align:left !important;
                  }
                  .t-Region--accent4 table tbody td::before {
                    font-weight:600 !important;
                    color:#8a8f98 !important;
                    font-size:11px !important;
                    letter-spacing:.03em !important;
                    text-transform:uppercase !important;
                    flex:0 0 auto !important;
                    margin-right:10px !important;
                  }
                  .t-Region--accent4 table tbody td:nth-child(1) {
                    order:1 !important;
                    font-size:16px !important;
                    font-weight:700 !important;
                    color:#1f2430 !important;
                    padding-bottom:12px !important;
                    border-bottom:1px solid #f0f1f3 !important;
                  }
                  .t-Region--accent4 table tbody td:nth-child(1)::before { content:none !important; }
                  .t-Region--accent4 table tbody td:nth-child(2)::before { content:"Ativo"; }
                  .t-Region--accent4 table tbody td:nth-child(2) { order:2 !important; }
                  .t-Region--accent4 table tbody td:nth-child(3)::before { content:"Comissao"; }
                  .t-Region--accent4 table tbody td:nth-child(3) { order:3 !important; }
                  .t-Region--accent4 table tbody td:nth-child(4)::before { content:"Vlr Venda"; }
                  .t-Region--accent4 table tbody td:nth-child(4) {
                    order:4 !important;
                    padding-top:12px !important;
                    border-top:1px solid #f0f1f3 !important;
                  }
                  .t-Region--accent4 table tbody td:nth-child(5)::before { content:"ID"; }
                  .t-Region--accent4 table tbody td:nth-child(5) {
                    order:5 !important;
                    font-size:11px !important;
                    color:#c1c5cc !important;
                    margin-top:2px !important;
                  }
                  .t-Region--accent4 table tbody td:nth-child(5)::before {
                    color:#c1c5cc !important;
                    font-size:10px !important;
                  }
                  .t-Region--accent4 table tbody td input[type=text] {
                    display:inline-block !important;
                    margin:0 !important;
                    max-width:120px !important;
                    padding:8px 10px !important;
                    border:1px solid #dfe2e8 !important;
                    border-radius:6px !important;
                    text-align:center !important;
                  }
                }
                ');
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 710344500000551060
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 289
            }
        }
    )

)

