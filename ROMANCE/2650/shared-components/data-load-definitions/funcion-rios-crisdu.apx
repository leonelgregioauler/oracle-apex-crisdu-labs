dataLoadDefinition funcion_rios_crisdu (
    name: Funcionários Crisdu
    target {
        tableName: FUNCIONARIOS_CRISDU
        loadingMethod: replace
    }
    advanced {
        commitInterval: 200
    }
    dataProfile {
        name: Funcionários Crisdu
        format: xlsx
    }
    advanced {
        encoding: utf-8
        defaultXlsxSheetName: sheet1.xml
    }

    dataProfileColumn bairro (
        columnName: BAIRRO
        source {
            sequence: 8
            dataType: varchar2
            maxLength: 50
        }
        parsing {
            selector: BAIRRO
        }
    )

    dataProfileColumn cargo (
        columnName: CARGO
        source {
            sequence: 20
            dataType: varchar2
            maxLength: 100
        }
        parsing {
            selector: CARGO
        }
    )

    dataProfileColumn celular (
        columnName: CELULAR
        source {
            sequence: 13
            dataType: varchar2
            maxLength: 50
        }
        parsing {
            selector: CELULAR
        }
    )

    dataProfileColumn centrodecusto (
        columnName: CENTRODECUSTO
        source {
            sequence: 21
            dataType: varchar2
            maxLength: 100
        }
        parsing {
            selector: CENTRO_DE_CUSTOS
        }
    )

    dataProfileColumn cep (
        columnName: CEP
        source {
            sequence: 11
            dataType: varchar2
            maxLength: 50
        }
        parsing {
            selector: CEP
        }
    )

    dataProfileColumn cidade (
        columnName: CIDADE
        source {
            sequence: 9
            dataType: varchar2
            maxLength: 50
        }
        parsing {
            selector: CIDADE
        }
    )

    dataProfileColumn cnpj (
        columnName: CNPJ
        source {
            sequence: 1
            dataType: varchar2
            maxLength: 50
        }
        parsing {
            selector: CNPJ
        }
    )

    dataProfileColumn contrato (
        columnName: CONTRATO
        source {
            sequence: 2
            dataType: number
        }
        parsing {
            selector: CONTRATO
        }
    )

    dataProfileColumn cpf (
        columnName: CPF
        source {
            sequence: 5
            dataType: varchar2
            maxLength: 50
        }
        parsing {
            selector: CPF
        }
    )

    dataProfileColumn dataadminissao (
        columnName: DATAADMINISSAO
        source {
            sequence: 19
            dataType: date
        }
        parsing {
            selector: ADMISSÃO
            formatMask: YYYY"-"MM"-"DD
            hasTimeZone: false
        }
    )

    dataProfileColumn datanascimento (
        columnName: DATANASCIMENTO
        source {
            sequence: 6
            dataType: date
        }
        parsing {
            selector: DATA_NASCIMENTO
            formatMask: YYYY"-"MM"-"DD
            hasTimeZone: false
        }
    )

    dataProfileColumn dddcelular (
        columnName: DDDCELULAR
        source {
            sequence: 12
            dataType: varchar2
            maxLength: 50
        }
        parsing {
            selector: DDD
        }
    )

    dataProfileColumn emailcorporativo (
        columnName: EMAILCORPORATIVO
        source {
            sequence: 18
            dataType: varchar2
            maxLength: 100
        }
        parsing {
            selector: E_MAIL_CORPORATIVO
        }
    )

    dataProfileColumn endereco (
        columnName: ENDERECO
        source {
            sequence: 7
            dataType: varchar2
            maxLength: 200
        }
        parsing {
            selector: ENDEREÇO
        }
    )

    dataProfileColumn estado-civil (
        columnName: ESTADO_CIVIL
        source {
            sequence: 14
            dataType: varchar2
            maxLength: 100
        }
        parsing {
            selector: ESTADO_CIVIL
        }
    )

    dataProfileColumn nacionalidade (
        columnName: NACIONALIDADE
        source {
            sequence: 15
            dataType: varchar2
            maxLength: 100
        }
        parsing {
            selector: NACIONALIDADE
        }
    )

    dataProfileColumn nome (
        columnName: NOME
        source {
            sequence: 3
            dataType: varchar2
            maxLength: 200
        }
        parsing {
            selector: NOME
        }
    )

    dataProfileColumn rg (
        columnName: RG
        source {
            sequence: 17
            dataType: varchar2
            maxLength: 100
        }
        parsing {
            selector: IDENTIDADE
        }
    )

    dataProfileColumn sexo (
        columnName: SEXO
        source {
            sequence: 4
            dataType: varchar2
            maxLength: 50
        }
        parsing {
            selector: SEXO
        }
    )

    dataProfileColumn situacao (
        columnName: SITUACAO
        source {
            sequence: 16
            dataType: varchar2
            maxLength: 100
        }
        parsing {
            selector: SITUAÇÃO
        }
    )

    dataProfileColumn uf (
        columnName: UF
        source {
            sequence: 10
            dataType: varchar2
            maxLength: 50
        }
        parsing {
            selector: UF
        }
    )

)

