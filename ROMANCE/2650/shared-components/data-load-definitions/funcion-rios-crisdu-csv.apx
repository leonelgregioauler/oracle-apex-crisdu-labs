dataLoadDefinition funcion_rios_crisdu_csv (
    name: Funcionários Crisdu CSV
    target {
        tableName: FUNCIONARIOS_CRISDU
        loadingMethod: replace
    }
    advanced {
        commitInterval: 200
    }
    dataProfile {
        name: Funcionários Crisdu CSV
        format: csv
    }
    advanced {
        encoding: iso-8859-1
        csvEnclosedBy: "
    }

    dataProfileColumn bairro (
        columnName: BAIRRO
        source {
            sequence: 9
            dataType: varchar2
            maxLength: 50
        }
        parsing {
            selector: BAIRRO
        }
    )

    dataProfileColumn cargo (
        columnName: CARGO
        source {
            sequence: 20
            dataType: varchar2
            maxLength: 100
        }
        parsing {
            selector: CARGO
        }
    )

    dataProfileColumn celular (
        columnName: CELULAR
        source {
            sequence: 14
            dataType: varchar2
            maxLength: 50
        }
        parsing {
            selector: CELULAR
        }
    )

    dataProfileColumn centrodecusto (
        columnName: CENTRODECUSTO
        source {
            sequence: 21
            dataType: varchar2
            maxLength: 100
        }
        parsing {
            selector: NOME_CCUSTO_2
        }
    )

    dataProfileColumn cep (
        columnName: CEP
        source {
            sequence: 12
            dataType: varchar2
            maxLength: 50
        }
        parsing {
            selector: CEP
        }
    )

    dataProfileColumn cidade (
        columnName: CIDADE
        source {
            sequence: 10
            dataType: varchar2
            maxLength: 50
        }
        parsing {
            selector: CIDADE
        }
    )

    dataProfileColumn cnpj (
        columnName: CNPJ
        source {
            sequence: 1
            dataType: varchar2
            maxLength: 50
        }
        parsing {
            selector: CNPJ
        }
    )

    dataProfileColumn contrato (
        columnName: CONTRATO
        source {
            sequence: 2
            dataType: number
        }
        parsing {
            selector: CONTRATO
        }
    )

    dataProfileColumn cpf (
        columnName: CPF
        source {
            sequence: 6
            dataType: varchar2
            maxLength: 50
        }
        parsing {
            selector: CPF
        }
    )

    dataProfileColumn dataadmissao (
        columnName: DATAADMISSAO
        source {
            sequence: 19
            dataType: date
        }
        parsing {
            selector: ADMISSAO
            formatMask: DD/MM/RRRR
            hasTimeZone: false
        }
    )

    dataProfileColumn datanascimento (
        columnName: DATANASCIMENTO
        source {
            sequence: 7
            dataType: date
        }
        parsing {
            selector: DATA_NASCIMENTO
            formatMask: DD/MM/RRRR
            hasTimeZone: false
        }
    )

    dataProfileColumn dddcelular (
        columnName: DDDCELULAR
