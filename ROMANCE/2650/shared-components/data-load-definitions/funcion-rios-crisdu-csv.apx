            sequence: 13
            dataType: varchar2
            maxLength: 50
        }
        parsing {
            selector: DDD_CELULAR
        }
    )

    dataProfileColumn emailcorporativo (
        columnName: EMAILCORPORATIVO
        source {
            sequence: 18
            dataType: varchar2
            maxLength: 100
        }
        parsing {
            selector: E_MAIL_PESSOAL
        }
    )

    dataProfileColumn endereco (
        columnName: ENDERECO
        source {
            sequence: 8
            dataType: varchar2
            maxLength: 200
        }
        parsing {
            selector: ENDERECO
        }
    )

    dataProfileColumn estado-civil (
        columnName: ESTADO_CIVIL
