            dataType: varchar2
            maxLength: 200
        }
        parsing {
            selector: NOME
        }
    )

    dataProfileColumn rg (
        columnName: RG
        source {
            sequence: 17
            dataType: varchar2
            maxLength: 100
        }
        parsing {
            selector: IDENTIDADE
        }
    )

    dataProfileColumn sexo (
        columnName: SEXO
        source {
            sequence: 5
            dataType: varchar2
            maxLength: 50
        }
        parsing {
            selector: SEXO
        }
    )

    dataProfileColumn situacao (
