dataLoadDefinition funcion_rios_crisdu_csv_demitidos (
    name: Funcionários Crisdu CSV - DEMITIDOS
    target {
        tableName: FUNCIONARIOS_CRISDU_DEMITIDOS
        loadingMethod: replace
    }
    advanced {
        commitInterval: 200
    }
    dataProfile {
        name: Funcionários Crisdu CSV - DEMITIDOS
        format: csv
    }
    advanced {
        encoding: iso-8859-1
        csvEnclosedBy: "
    }

    dataProfileColumn contrato (
        columnName: CONTRATO
        source {
            sequence: 1
            dataType: number
        }
        parsing {
            selector: CONTRATO
        }
    )

    dataProfileColumn cpf (
        columnName: CPF
        source {
            sequence: 5
            dataType: varchar2
            maxLength: 50
        }
        parsing {
            selector: CPF
        }
    )

    dataProfileColumn dataadmissao (
        columnName: DATAADMISSAO
        source {
            sequence: 3
            dataType: date
        }
        parsing {
            selector: DATA_DE_ADMISSAO
            formatMask: DD/MM/RRRR
        }
    )

    dataProfileColumn datademissao (
        columnName: DATADEMISSAO
        source {
            sequence: 4
            dataType: date
        }
        parsing {
            selector: DATA_DEMISSAO
            formatMask: DD/MM/RRRR
        }
    )

    dataProfileColumn nome (
        columnName: NOME
        source {
            sequence: 2
            dataType: varchar2
            maxLength: 200
        }
        parsing {
            selector: NOME
        }
    )

)

