list relatórios (
    name: Relatórios
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select level
                 , descricao        label
                 , 'f?p=&APP_ID.:'||PAGINA||':&SESSION.::NO:::'          target
                 , paginascorrentes  is_current_list_entry
                 , imagem image
              from ( select a.idaplicacao
                          , a.descricao
                          , a.hierarquia
                          , a.pagina
                          , a.imagem
                          , a.paginascorrentes
                     from aplicacoes a 
                     where a.idsistema = 2600
                       and hierarquia = 2605
                       and exists ( select 1 
                                    from acessos b 
                                    where b.idaplicacao = a.idaplicacao 
                                      and b.usuario = v('APP_USER')))
            connect by prior idaplicacao = hierarquia
            ```
    }
)

