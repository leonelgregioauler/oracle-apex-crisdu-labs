list financeiro-v (
    name: Financeiro V2
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select level
                 , descricao        label
                 , 'f?p=&APP_ID.:'||PAGINA||':&SESSION.::NO:::'          target
                 , paginascorrentes  is_current_list_entry
                 , imagem image
              from ( select a.idaplicacao
                          , a.descricao
                          , a.hierarquia
                          , a.pagina
                          , a.imagem
                          , a.paginascorrentes
                     from aplicacoes a 
                       -- , aplicacoestraduzidas aa
                     where a.idsistema = 2600
                      -- and a.idaplicacao  = aa.idaplicacao (+)
                     --  and aa.idioma = nvl(APEX_UTIL.GET_SESSION_LANG,'pt-br')
                       and hierarquia = 2720
                       and exists ( select 1 
                                    from acessos b 
                                    where b.idaplicacao = a.idaplicacao 
                                      and b.usuario = v('APP_USER')))
            connect by prior idaplicacao = hierarquia
            ```
    }
)

