list eventos (
    name: Eventos
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select null
                 , titulo  label
                 , APEX_UTIL.PREPARE_URL(  p_url => 'f?p=&APP_ID.:47:'|| v('APP_SESSION')||'::NO::P47_IDCHAMADO:'||idchamado, p_checksum_type => 'SESSION') target 
                 , 'YES' is_current
                 , NULL image
                 , '' image_attrib
                 , descricao   text
                 , descricao   a01
                 , ( select h.descricao
                     from historicochamados h
                     where h.idhistoricochamado = cc.idhistoricochamado ) a02
                 , idchamado-20000 a03
              from ( select c.idchamado
                          , titulo
                          , c.descricao
                          , ( select max(h.idhistoricochamado )
                               from historicochamados h
                               where h.idchamado = c.idchamado ) idhistoricochamado
                     from chamados c
                     where ( c.usuario = v('APP_USER')
                        or exists ( select 1 from usuarioschamados u where u.idchamado = c.idchamado and u.usuario = v('APP_USER') ) )
                       and nvl(idsituacao,0)  = :P40_SITUACAO
                     order by c.idchamado desc) cc
            where rownum < 20
            
            ```
    }
)

