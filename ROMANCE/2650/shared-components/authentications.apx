authentication application-express (
    name: Application Express
    type: oracleApexAccounts
    postLogout {
        redirectTo: url
        url: f?p=&APP_ID.:12
    }
    comments {
        comments: Use internal Application Express account credentials and login page in this application.
    }
)

authentication database (
    name: DATABASE
    type: noAuth
    comments {
        comments: Use database authentication (user identified by DAD).
    }
)

authentication database-account (
    name: DATABASE ACCOUNT
    type: databaseAccounts
    postLogout {
        redirectTo: url
        url: f?p=&APP_ID.:1
    }
    sessionSharing {
        type: custom
        cookieName: RMCOOKIE
    }
    comments {
        comments: Use database account credentials.
    }
)

