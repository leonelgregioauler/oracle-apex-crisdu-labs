restDataSource N8N_LEITURA_COMPROVANTE_OCR (
    name: N8N_LEITURA_COMPROVANTE_OCR
    source {
        type: http
        remoteServer: @N8N_FINANCEIRO_AISTEN_AI
        urlPathPrefix: /webhook/leitura-comprovante-v3
    }

    operation n8n_leitura_comprovante_ocr (
        label: POST
        operation {
            urlPattern: .
            httpMethod: post
            databaseOperation: insert
        }
        requestBody {
            template: #DATA#
            versionNumber: 1
        }
    )

    parameter content-type (
        name: Content-Type
        parameter {
            type: httpHeader
        }
        value {
            defaultValueType: staticValue
            staticValue: application/json
        }
    )

    parameter data (
        name: DATA
        operation: @n8n_leitura_comprovante_ocr
        parameter {
            type: requestOrResponseBody
        }
    )

    parameter response (
        name: RESPONSE
        operation: @n8n_leitura_comprovante_ocr
        parameter {
            type: requestOrResponseBody
            direction: out
        }
    )

    dataProfile {
        name: N8N_LEITURA_COMPROVANTE_OCR
        rowSelector: items
    }
)

