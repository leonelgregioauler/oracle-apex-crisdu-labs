appProcess busca-eventos-aguardando-aprovacao (
    name: Busca Eventos aguardando aprovacao
    source {
        plsqlCode:
            ```plsql
            begin
             --
             select count(1)
             into :AGUARDANDOAPROVACAO 
             from chamados c
             where c.usuario = v('APP_USER')
               and nvl(idsituacao,0)  = 40;
            END;
            ```
    }
    execution {
        sequence: 1
    }
)

appProcess busca-fotos (
    name: Busca fotos
    source {
        plsqlCode:
            ```plsql
            begin
                select count(1)
                into :FOTOSRECEBIDAS
                from depositosdiarios_leituraocr 
                where iddepositodiario is null;
            end;
            ```
    }
    execution {
        sequence: 1
    }
)

appProcess busca-fotos-cobraki (
    name: Busca Fotos Cobraki
    source {
        plsqlCode:
            ```plsql
            begin
                select count(1)
            into :FOTOSCOBRAKI
            from depositosnegociacoesparc d
            where d.datarevisao is null;
            end;
            
            
            ```
    }
    execution {
        sequence: 1
    }
)

appProcess busca-qtd-ligações (
    name: Busca qtd Ligações
    source {
        plsqlCode:
            ```plsql
            begin
                select count(1)
                into :QTDLIGACOES
                from controleligacoes c
                where c.situacao = 'P'
                  and c.idcontroleorig is null
                order by dataligacao;
            end;
            ```
    }
    execution {
        sequence: 1
    }
)

appProcess busca-questionamentos-pendentes-de-respostas (
    name: Busca Questionamentos pendentes de Respostas
    source {
        plsqlCode:
            ```plsql
            begin
             --
             select count(1)
             into :QUESTIONAMENTO
             from questionamentoscontroladoria q
             where ( nvl(q.confirmacaoleitura,'N') = 'N'
                  or ( confirmacaoleitura = 'S' and resposta is null ) )
               and confirmarenvio = 'S'
               and pck_romance.fnc_filialusuario(v('APP_USER')) = q.idfilial;
             --
            END;
            ```
    }
    execution {
        sequence: 1
    }
)

appProcess buscapreco (
    name: buscapreco
    source {
        plsqlCode:
            ```plsql
            declare 
              --
              vprod number := to_number(v('F60023IDPRODUTO'));
              --
              vvlr number(10,2);
              --
              vretorno varchar2(20);
              --
            begin
              --
              begin
                select p.precocusto
                into vvlr
                from produtos p
                where p.idproduto = vprod;
              exception
                when others then
                  vvlr := vprod;
              end;
              --
              vretorno := TRIM(to_char(vvlr,'999G999G990D00'));
              htp.prn(VRETORNO);
              --
            end;
            ```
    }
    execution {
        sequence: 1
        point: ajaxCallback
    }
)

