customAttribute attribute_01 (
    apexlangName: googleApiKey
    attribute: 1
    name: Google API Key
    scope: app
    appearance {
        sequence: 10
    }
    help {
        helpText: Optional. If you don't set this, you may get a "Google Maps API warning: NoApiKeys" warning in the console log. You can add this later if required. Refer: https://developers.google.com/maps/documentation/javascript/get-api-key#get-an-api-key
    }
)

customAttribute attribute_01 (
    apexlangName: mapHeight
    attribute: 1
    name: Map Height
    type: integer
    validation {
        required: true
        maxLength: 22
    }
    appearance {
        sequence: 10
    }
    builder {
        unit: pixels
        displayWidth: 5
    }
    default {
        value: 400
    }
    help {
        helpText: Map Height in pixels
    }
)

customAttribute attribute_02 (
    apexlangName: googleSignIn
    attribute: 2
    name: Google Sign-in
    type: yesNo
    appearance {
        sequence: 20
    }
    help {
        helpText: Set to Yes to sign-in user to Google (only applicable if Google API Key is provided)
    }
)

customAttribute attribute_03 (
    apexlangName: dissipating
    attribute: 3
    name: Dissipating
    type: yesNo
    appearance {
        sequence: 30
    }
    help {
        helpText: Specifies whether heatmaps dissipate on zoom. Yes means the radius of influence of a data point is specified by the radius option only. When dissipating is disabled, the radius option is interpreted as a radius at zoom level 0.
    }
)

customAttribute attribute_04 (
    apexlangName: opacity
    attribute: 4
    name: Opacity
    type: number
    validation {
        required: true
    }
    appearance {
        sequence: 40
    }
    builder {
        displayWidth: 5
    }
    default {
        value: 0.6
    }
    help {
        helpText: The opacity of the heatmap, expressed as a number between 0 and 1.
    }
)

customAttribute attribute_05 (
    apexlangName: radius
    attribute: 5
    name: Radius
    type: number
    validation {
        required: true
    }
    appearance {
        sequence: 50
    }
    builder {
        unit: pixels
        displayWidth: 5
    }
    default {
        value: 5
    }
    help {
        helpText: The radius of influence for each data point, in pixels.
    }
)

customAttribute attribute_06 (
    apexlangName: mapStyle
    attribute: 6
    name: Map Style
    type: textarea
    appearance {
        sequence: 60
    }
    help {
        helpText: Easiest way is to copy one from a site like https://snazzymaps.com/
    }
    examples {
        examples:
            ```
            Here is an example, a light greyscale style map:
            <pre>
            [{"featureType":"water","elementType":"geometry","stylers":[{"color":"#e9e9e9"},{"lightness":17}]},{"featureType":"landscape","elementType":"geometry","stylers":[{"color":"#f5f5f5"},{"lightness":20}]},{"featureType":"road.highway","elementType":"geometry.fill","stylers":[{"color":"#ffffff"},{"lightness":17}]},{"featureType":"road.highway","elementType":"geometry.stroke","stylers":[{"color":"#ffffff"},{"lightness":29},{"weight":0.2}]},{"featureType":"road.arterial","elementType":"geometry","stylers":[{"color":"#ffffff"},{"lightness":18}]},{"featureType":"road.local","elementType":"geometry","stylers":[{"color":"#ffffff"},{"lightness":16}]},{"featureType":"poi","elementType":"geometry","stylers":[{"color":"#f5f5f5"},{"lightness":21}]},{"featureType":"poi.park","elementType":"geometry","stylers":[{"color":"#dedede"},{"lightness":21}]},{"elementType":"labels.text.stroke","stylers":[{"visibility":"on"},{"color":"#ffffff"},{"lightness":16}]},{"elementType":"labels.text.fill","stylers":[{"saturation":36},{"color":"#333333"},{"lightness":40}]},{"elementType":"labels.icon","stylers":[{"visibility":"off"}]},{"featureType":"transit","elementType":"geometry","stylers":[{"color":"#f2f2f2"},{"lightness":19}]},{"featureType":"administrative","elementType":"geometry.fill","stylers":[{"color":"#fefefe"},{"lightness":20}]},{"featureType":"administrative","elementType":"geometry.stroke","stylers":[{"color":"#fefefe"},{"lightness":17},{"weight":1.2}]}]
            </pre>
            ```
    }
)

