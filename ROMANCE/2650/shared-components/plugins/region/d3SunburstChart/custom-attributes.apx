customAttribute attribute_21 (
    apexlangName: minimumHeight
    attribute: 21
    name: Minimum Height
    type: integer
    validation {
        maxLength: 5
    }
    appearance {
        sequence: 140
    }
    builder {
        showInWizard: false
        unit: px
        displayWidth: 5
    }
    help {
        helpText: Enter the minimum height, in pixels, of the chart. Chart width will adapt to the size of the region.
    }
)

customAttribute attribute_22 (
    apexlangName: maximumHeight
    attribute: 22
    name: Maximum Height
    type: integer
    validation {
        maxLength: 5
    }
    appearance {
        sequence: 150
    }
    builder {
        showInWizard: false
        unit: px
        displayWidth: 5
    }
    help {
        helpText: Enter the maximum height, in pixels, of the chart. Chart width will adapt to the size of the region.
    }
)

customAttribute attribute_23 (
    apexlangName: legend
    attribute: 23
    name: Legend
    type: selectList
    componentLov {
        nullText: No Legend
    }
    appearance {
        sequence: 90
    }
    help {
        helpText: Select where the legend is displayed on the chart.
    }

    entry aboveChart (
        sequence: 10
        display: Above Chart
        return: TOP
    )

    entry belowChart (
        sequence: 20
        display: Below Chart
        return: BOTTOM
    )

)

customAttribute attribute_24 (
    apexlangName: showTooltips
    attribute: 24
    name: Show Tooltips
    type: yesNo
    appearance {
        sequence: 80
    }
    help {
        helpText: Select whether to show tooltips.
    }
)

customAttribute attribute_25 (
    apexlangName: legendColorMapping
    attribute: 25
    name: Legend Color Mapping
    type: textarea
    validation {
        required: true
        maxLength: 500
    }
    appearance {
        sequence: 130
    }
    builder {
        showInWizard: false
        displayWidth: 40
    }
    default {
        value: "{\"red\":\"Legend for red\",\"blue\":\"Legend for Blue\"}"
    }
    dependingOn {
        attribute: @attribute_02/component
        conditionType: =
        value: COLUMN
    }
    help {
        helpText: Enter the color mapping for the legend.
    }
)

