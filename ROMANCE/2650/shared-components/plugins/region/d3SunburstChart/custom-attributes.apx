    name: Value Column
    type: regionSqlQueryColumn
    validation {
        required: true
    }
    appearance {
        sequence: 20
    }
    supports {
        dataTypes: number
    }
    help {
        helpText: Select the column from the region SQL Query that holds the values for the chart.
    }
)

customAttribute attribute_14 (
    apexlangName: primaryKeyColumn
    attribute: 14
    name: Primary Key Column
    type: regionSqlQueryColumn
    validation {
        required: true
    }
    appearance {
        sequence: 40
    }
    help {
        helpText: Select the column from the region SQL Query that holds the primary key values for the chart. The primary key and parent key columns are used to define the hierarchy for the chart.
    }
)

