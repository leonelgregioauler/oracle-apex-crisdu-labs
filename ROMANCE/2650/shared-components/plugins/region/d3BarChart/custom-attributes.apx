customAttribute attribute_01 (
    apexlangName: maximumAspectRatio
    attribute: 1
    name: Maximum Aspect Ratio
    scope: app
    type: number
    validation {
        required: true
    }
    appearance {
        sequence: 510
    }
    builder {
        common: false
        showInWizard: false
        displayWidth: 5
    }
    default {
        value: 3
    }
    help {
        helpText:
            ```
            <p>Enter the maximum aspect ratio that charts use to recommend a height. A maximum aspect ratio of 3 means that the chart's width should be no greater than 3 times its height. </p>
            <p>Note: This setting can be overridden by the 'Maximum Height' setting on the region.</p>
            ```
    }
)

customAttribute attribute_01 (
    apexlangName: xValuesColumn
    attribute: 1
    name: X Values Column
    type: regionSqlQueryColumn
    validation {
        required: true
    }
    appearance {
        sequence: 10
    }
    help {
        helpText: Select the column from the region SQL Query which holds the X-axis values for the chart.
    }
)

customAttribute attribute_02 (
    apexlangName: minimumAspectRatio
    attribute: 2
    name: Minimum Aspect Ratio
    scope: app
    type: number
    validation {
        required: true
    }
    appearance {
        sequence: 500
    }
    builder {
        common: false
        showInWizard: false
        displayWidth: 5
    }
    default {
        value: 1.333
    }
    help {
        helpText:
            ```
            <p>Enter the minimum aspect ratio that charts use to recommend a height. A minimum aspect ratio of 1.333 means that the chart's width should be no less than 1.333 times its height. </p>
            <p>Note: This setting can be overridden by the 'Minimum Height' setting on the region.</p>
            ```
    }
)

customAttribute attribute_02 (
    apexlangName: yValuesColumn
    attribute: 2
    name: Y Values Column
    type: regionSqlQueryColumn
    validation {
        required: true
    }
    appearance {
        sequence: 20
    }
    supports {
        dataTypes: number
    }
    help {
        helpText: Select the column from the region SQL Query which holds the Y-axis values for the chart.
    }
)

customAttribute attribute_03 (
    apexlangName: responsiveBehaviorThreshold
    attribute: 3
    name: Responsive Behavior Threshold
    scope: app
    type: integer
    validation {
        required: true
        maxLength: 5
    }
    appearance {
        sequence: 540
    }
    builder {
        common: false
        showInWizard: false
        unit: px
        displayWidth: 5
    }
    default {
        value: 480
    }
    help {
        helpText: Enter the threshold (in pixels) at which the responsive behavior will be activated.
    }
)

customAttribute attribute_03 (
    apexlangName: multipleSeries
    attribute: 3
    name: Multiple Series
    type: checkboxes
    appearance {
        sequence: 50
    }
    help {
        helpText: Check multiple series if you want the chart displaying more than one series of data. The different series must be specified by a column from the region SQL Query.
    }

    entry attributeValue (
        sequence: 10
        display: " "
        return: Y
    )

)

customAttribute attribute_04 (
    apexlangName: responsiveBehaviorMeasure
    attribute: 4
    name: Responsive Behavior Measure
    scope: app
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 530
    }
    builder {
        common: false
        showInWizard: false
    }
    default {
        value: WINDOW
    }
    help {
        helpText: Select whether the responsive behavior threshold will be compared to the window or the region width.
    }

    entry region (
        sequence: 20
        display: Region
        return: REGION
    )

    entry window (
        sequence: 10
        display: Window
        return: WINDOW
    )

)

customAttribute attribute_04 (
    apexlangName: seriesColumn
    attribute: 4
    name: Series Column
    type: regionSqlQueryColumn
    validation {
        required: true
    }
    appearance {
        sequence: 60
    }
    dependingOn {
        attribute: @attribute_03/component
        conditionType: =
        value: Y
    }
    help {
        helpText: Select the column from the region SQL Query that defines the multiple series for the chart. The values from this column will become the labels for the series.
    }
)

customAttribute attribute_05 (
    apexlangName: enableTransitions
    attribute: 5
    name: Enable Transitions
    scope: app
    type: yesNo
    appearance {
        sequence: 550
    }
    default {
        value: true
    }
    help {
        helpText: Select whether transitions are enabled for the chart.
    }
)

customAttribute attribute_05 (
    apexlangName: seriesName
    attribute: 5
    name: Series Name
    validation {
        required: true
    }
    appearance {
        sequence: 70
    }
    builder {
        translatable: true
    }
    dependingOn {
        attribute: @attribute_03/component
        conditionType: isNull
    }
    help {
        helpText: Enter the name of the single data series which is shown on the legend.
    }
)

customAttribute attribute_06 (
    apexlangName: responsiveBehavior
    attribute: 6
    name: Responsive Behavior
    scope: app
    type: yesNo
    appearance {
        sequence: 520
    }
    default {
        value: true
    }
    help {
        helpText: Select whether responsive behavior is enabled for the chart.
    }
)

customAttribute attribute_06 (
    apexlangName: display
    attribute: 6
    name: Display
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 40
    }
    default {
        value: VERTICAL,SIDE-BY-SIDE
    }
    help {
        helpText: Select how the bar chart data is displayed.
    }

    entry horizontalSideBySide (
        sequence: 20
        display: Horizontal, Side by Side
        return: HORIZONTAL,SIDE-BY-SIDE
    )

    entry horizontalStacked (
        sequence: 40
        display: Horizontal, Stacked
        return: HORIZONTAL,STACKED
    )

    entry verticalSideBySide (
        sequence: 10
        display: Vertical, Side by Side
        return: VERTICAL,SIDE-BY-SIDE
    )

    entry verticalStacked (
        sequence: 30
        display: Vertical, Stacked
        return: VERTICAL,STACKED
    )

)

customAttribute attribute_08 (
    apexlangName: xAxisTitle
    attribute: 8
    name: X-Axis Title
    appearance {
        sequence: 90
    }
    builder {
        translatable: true
        displayWidth: 20
    }
    help {
        helpText: Enter the label for the X-axis.
    }
)

customAttribute attribute_09 (
    apexlangName: yAxisTitle
    attribute: 9
    name: Y-Axis Title
    appearance {
        sequence: 100
    }
    builder {
        translatable: true
        displayWidth: 20
    }
    help {
        helpText: The label for the Y-axis.
    }
)

customAttribute attribute_10 (
    apexlangName: tooltips
    attribute: 10
    name: Tooltips
    type: checkboxes
    appearance {
        sequence: 130
    }
    builder {
        common: false
        showInWizard: false
    }
    help {
        helpText:
            ```
            <p>Check which attributes are shown on the tooltip for each data point. The 'Custom column' option allows you to specify text for each individual data point as an additional column in the region SQL Query.</p>
            <p>Note: Leave all options unchecked to disable the tooltip.</p>
            ```
    }

    entry customColumn (
        sequence: 30
        display: Custom column
        return: CUSTOM
    )

    entry showSeriesName (
        sequence: 0
        display: Show series name
        return: SERIES
    )

    entry showXValue (
        sequence: 10
        display: Show X value
        return: X
    )

    entry showYValue (
        sequence: 20
        display: Show Y value
        return: Y
    )

)

customAttribute attribute_11 (
    apexlangName: tooltipColumn
    attribute: 11
    name: Tooltip Column
    type: regionSqlQueryColumn
    validation {
        required: true
    }
    appearance {
        sequence: 140
    }
    builder {
        common: false
        showInWizard: false
    }
    dependingOn {
        attribute: @attribute_10/component
        conditionType: inList
        list: [
            SERIES:X:Y:CUSTOM
            SERIES:X:CUSTOM
            SERIES:Y:CUSTOM
            X:Y:CUSTOM
            SERIES:CUSTOM
            X:CUSTOM
            Y:CUSTOM
            CUSTOM
        ]
    }
    help {
        helpText: Enter the column from the region SQL Query that holds the custom tooltip values.
    }
)

customAttribute attribute_12 (
    apexlangName: legend
    attribute: 12
    name: Legend
    type: selectList
    componentLov {
        nullText: No Legend
    }
    appearance {
        sequence: 150
    }
    help {
        helpText: Select where the legend is displayed on the chart.
    }

    entry aboveChart (
        sequence: 10
        display: Above chart
        return: TOP
    )

    entry belowChart (
        sequence: 20
        display: Below chart
        return: BOTTOM
    )

)

customAttribute attribute_13 (
    apexlangName: colorScheme
    attribute: 13
    name: Color Scheme
    type: selectList
    componentLov {
        nullText: Theme Default
    }
    appearance {
        sequence: 250
    }
    builder {
        common: false
        showInWizard: false
    }
    default {
        value: MODERN
    }
    help {
        helpText:
            ```
            <p>Select the color scheme used to render the chart.</p>
            <p>Note: For multiple series charts, each series will be assigned a different color depending on the setting for 'Multiple Colors'.</p>
            ```
    }

    entry custom (
        sequence: 60
        display: Custom
        return: CUSTOM
    )

    entry metro (
        sequence: 40
        display: Metro
        return: METRO
    )

    entry modern (
        sequence: 10
        display: Modern
        return: MODERN
    )

    entry modern2 (
        sequence: 20
        display: Modern 2
        return: MODERN2
    )

    entry solar (
        sequence: 30
        display: Solar
        return: SOLAR
    )

    entry sqlQuery (
        sequence: 50
        display: SQL Query
        return: COLUMN
    )

)

customAttribute attribute_14 (
    apexlangName: colors
    attribute: 14
    name: Colors
    validation {
        required: true
    }
    appearance {
        sequence: 260
    }
    builder {
        common: false
        showInWizard: false
    }
    dependingOn {
        attribute: @attribute_13/component
        conditionType: =
        value: CUSTOM
    }
    help {
        helpText: <p>Enter a colon-separated list of color strings for the custom colors to be used in the chart.</p>
    }
    examples {
        examples:
            ```
            <dl>
              <dt>Hexadecimal (hex) notation</dt><dd><pre>#FF3377</pre>;</dd>
              <dt>RGB color notation  (red,green,blue)</dt><dd><pre>rgba(0,25,47,0.5)</pre>; or </dd>
              <dt>RGBA color notation (red,green,blue,alpha)</dt><dd><pre>rgba(0,25,47,0.5)</pre>; or </dd>
              <dt>HTML colors</dt><dd><pre>blue</pre>.</dd>
            </dl>
            ```
    }
)

customAttribute attribute_15 (
    apexlangName: customValueFormatting
    attribute: 15
    name: Custom Value Formatting
    validation {
        required: true
    }
    appearance {
        sequence: 120
    }
    builder {
        common: false
        showInWizard: false
    }
    default {
        value: FRIENDLY
    }
    dependingOn {
        attribute: @attribute_25/component
        conditionType: isNull
    }
    help {
        helpText: Enter the D3 format string used to format the Y-axis values on axes, tooltips and legends. Use <pre>FRIENDLY</pre> to utilize sensible formatting defaults for your data.
    }
    examples {
        examples:
            ```
            <ul>
            <li><b>,d</b> = 14,435</li>
            <li><b>d</b> = 14435</li>
            <li><b>,.2f</b> = 14,435.49</li>
            <li><b>.2f</b> = 14435.49</li>
            <li><b>.3s</b> = 14.4k</li>
            <li><b>$,d</b> = $14,435</li>
            <li><b>$d</b> = $14435</li>
            <li><b>$,.2f</b> = $14,435.49</li>
            <li><b>$.2f</b> = $14435.49</li>
            <li><b>$.3s</b> = $14.4k</li>
            <li><b>n" ft."</b> = 14435.49 ft. **</li>
            <li><b>"[["$.3s"]]"</b> = [[$14.4k]] **</li>
            <li>Refer to https://github.com/mbostock/d3/wiki/Formatting#d3_format for the full syntax specification</li>
            </ul>
            <br/>
            ** You may use leading and trailing double-quoted literals, but this feature is not part of the standard D3 specification
            ```
    }
)

customAttribute attribute_16 (
    apexlangName: spacingBetweenCategories
    attribute: 16
    name: Spacing Between Categories
    type: integer
    validation {
        required: true
        maxLength: 3
    }
    appearance {
        sequence: 200
    }
    builder {
        common: false
        showInWizard: false
        unit: %
        displayWidth: 5
    }
    default {
        value: 10
    }
    help {
        helpText: Enter the spacing between categories, expressed as an integer percentage (1-100).
    }
)

customAttribute attribute_17 (
    apexlangName: spacingBetweenSeries
    attribute: 17
    name: Spacing Between Series
    type: integer
    validation {
        required: true
        maxLength: 3
    }
    appearance {
        sequence: 210
    }
    builder {
        common: false
        showInWizard: false
        unit: %
        displayWidth: 5
    }
    default {
        value: 10
    }
    dependingOn {
        attribute: @attribute_03/component
        conditionType: isNotNull
    }
    help {
        helpText:
            ```
            <p>Enter the spacing between series on the same category (X-axis value). It is represented as an integer percentage (0-100).</p>
            <p>Note: This setting only affects charts using the "Side by Side" display modes.</p>
            ```
    }
)

customAttribute attribute_18 (
    apexlangName: minimumHeight
    attribute: 18
    name: Minimum Height
    type: integer
    appearance {
        sequence: 180
    }
    builder {
        common: false
        showInWizard: false
        unit: px
        displayWidth: 5
    }
    help {
        helpText: Enter the minimum height, in pixels, of the chart. Chart width will adapt to the size of the region. Defaults to 100px.
    }
)

customAttribute attribute_19 (
    apexlangName: maximumHeight
    attribute: 19
    name: Maximum Height
    type: integer
    appearance {
        sequence: 190
    }
    builder {
        common: false
        showInWizard: false
        unit: px
        displayWidth: 5
    }
    help {
        helpText: The maximum height, in pixels, of the chart. Chart width will adapt to the size of the region. Defaults to 500px.
    }
)

customAttribute attribute_20 (
    apexlangName: linkTarget
    attribute: 20
    name: Link Target
    type: linkToTargetPageUrl
    appearance {
        sequence: 30
    }
    builder {
        includeColumnsInItemsPicker: true
    }
    help {
        helpText: <p>Enter a target page to be called when the user clicks a chart entry.</p>
    }
    examples {
        examples:
            ```
            <p>Example 1: URL to navigate to page 10 and set P10_EMPNO to the EMPNO value of the clicked entry.
            <pre>f?p=&amp;APP_ID.:10:&amp;APP_SESSION.::&amp;DEBUG.:RP,10:P10_EMPNO:&amp;EMPNO.</pre>
            </p>
            <p>Example 2: Display the EMPNO value of the clicked entry in a JavaScript alert
            <pre>javascript:alert('current empno: &amp;EMPNO.');</pre>
            </p>
            ```
    }
)

customAttribute attribute_21 (
    apexlangName: heightMeasure
    attribute: 21
    name: Height Measure
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 170
    }
    default {
        value: BARS
    }
    help {
        helpText: Select how the minimum and maximum height of the chart is calculated.
    }

    entry barsArea (
        sequence: 10
        display: Bars Area
        return: BARS
        help {
            helpText: Minimum and maximum height for the area is determined by the height of the the bars drawn. Axis labels may take additional space.
        }
    )

    entry chartArea (
        sequence: 20
        display: Chart Area
        return: CHART
        help {
            helpText: Minimum and maximum height will include the axes dimensions.
        }
    )

)

customAttribute attribute_22 (
    apexlangName: showGridLines
    attribute: 22
    name: Show Grid Lines
    type: checkboxes
    appearance {
        sequence: 160
    }
    builder {
        common: false
        showInWizard: false
    }
    help {
        helpText: Check the axes to display grid lines for that axis.
    }

    entry xAxis (
        sequence: 10
        display: X-Axis
        return: X
    )

    entry yAxis (
        sequence: 20
        display: Y-Axis
        return: Y
    )

)

customAttribute attribute_23 (
    apexlangName: colorSqlQuery
    attribute: 23
    name: Color SQL Query
    type: sqlQuery
    validation {
        required: true
        minColumns: 2
        maxColumns: 2
    }
    appearance {
        sequence: 270
    }
    builder {
        common: false
        showInWizard: false
    }
    dependingOn {
        attribute: @attribute_13/component
        conditionType: =
        value: COLUMN
    }
    help {
        helpText:
            ```
            Enter a SQL Query that maps a series name to an RGB color. The first column must contain the series names (and those values must match the ones returned from the region SQL) and the second column must have the RGB or RGBA color notation for the series. 
            Both columns must be VARCHAR2.
            ```
    }
    examples {
        examples:
            ```
            <pre>select 'SALES', rgb(0,255,0)
            from dual
            UNION
            select 'RESEARCH', rgba(0,25,47,0.5)
            from dual;</pre>
            ```
    }
)

customAttribute attribute_24 (
    apexlangName: multipleColors
    attribute: 24
    name: Multiple Colors
    type: yesNo
    appearance {
        sequence: 80
    }
    dependingOn {
        attribute: @attribute_03/component
        conditionType: isNull
    }
    help {
        helpText: Select whether each series is displayed in a different color.
    }
)

customAttribute attribute_25 (
    apexlangName: valueFormatMask
    attribute: 25
    name: Value Format Mask
    type: selectList
    componentLov {
        nullText: Custom
    }
    appearance {
        sequence: 110
    }
    builder {
        common: false
        showInWizard: false
    }
    help {
        helpText: Select the format mask to apply to the displayed values.
    }

    entry 144k (
        sequence: 71
        display: 14.4k
        return: .3s
        help {
            helpText: Precision 3, SI suffixes
        }
    )

    entry 144k2 (
        sequence: 120
        display: $14.4k
        return: $.3s
        help {
            helpText: Currency, precison 3, SI suffixes
        }
    )

    entry attributeValue (
        sequence: 30
        display: 14,435
        return: ,.0f
        help {
            helpText: Comma-separated thousands, integers
        }
    )

    entry attributeValue2 (
        sequence: 40
        display: 14435
        return: .0f
        help {
            helpText: Integer
        }
    )

    entry attributeValue3 (
        sequence: 60
        display: 14,435.49
        return: ,.2f
        help {
            helpText: Comma-separated thousands, 2 decimals
        }
    )

    entry attributeValue4 (
        sequence: 70
        display: 14435.49
        return: .2f
        help {
            helpText: 2 decimals
        }
    )

    entry attributeValue5 (
        sequence: 80
        display: $14,435
        return: $,.0f
        help {
            helpText: Currency, comma-separated thousands, integer
        }
    )

    entry attributeValue6 (
        sequence: 90
        display: $14435
        return: $.0f
        help {
            helpText: Currency, integer
        }
    )

    entry attributeValue7 (
        sequence: 99
        display: $14,435.49
        return: $,.2f
        help {
            helpText: Currency, comma-separated thousands, 2 decimals
        }
    )

    entry attributeValue8 (
        sequence: 100
        display: $14435.49
        return: $.2f
        help {
            helpText: Currency, 2 decimals
        }
    )

)

