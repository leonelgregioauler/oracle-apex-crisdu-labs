legacyDataLoadDefinition planilha-de-distribuição (
    name: Planilha de Distribuição
    target {
        tableOwner: #OWNER#
        tableName: IMPORTADISTRIBUICAO
    }
    uniqueKeys {
        uniqueColumn1: ORDEM
    }

    transformationRule semana (
        name: semana
        execution {
            sequence: 10
        }
        transformation {
            columnNames: SEMANA
            type: trim
        }
    )

)

