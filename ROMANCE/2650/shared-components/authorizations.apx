authorization atendimento (
    name: ATENDIMENTO
    type: existsSqlQuery
    settings {
        sqlQuery:
            ```sql
            select 1
            from dual 
            where upper(v('APP_USER')) IN ( 'EVERTON','MATEUS','GUILHERME','FERNANDO','CRISTIAN','EQUIPAMENTO','MAURICIO','LUCASRAMOS','LUIZV','EDIMILSON') 
            ```
    }
    error {
        errorMessage: Você não tem acesso a este item!
    }
)

authorization autoriza-pix-operador (
    name: AUTORIZA_PIX_OPERADOR
    type: existsSqlQuery
    settings {
        sqlQuery:
            ```sql
            select 1
              from roman.usuarios_pix_santander u
             where u.usuario = upper(v('APP_USER'))
               and u.ativo   = 'S'
               and u.perfil in ('OPERADOR','GESTOR')
            ```
    }
    error {
        errorMessage: Você não tem acesso ao fluxo Pix Santander. Solicite ao Financeiro.
    }
    advanced {
        evaluationType: perSession
    }
)

authorization autoriza-pix-santander (
    name: AUTORIZA_PIX_SANTANDER
    type: existsSqlQuery
    settings {
        sqlQuery:
            ```sql
            select 1
              from roman.usuarios_pix_santander u
             where u.usuario = upper(v('APP_USER'))
               and u.ativo   = 'S'
               and u.perfil  = 'GESTOR'
            ```
    }
    error {
        errorMessage: Somente gestores autorizados podem efetivar pagamentos Pix.
    }
    advanced {
        evaluationType: perSession
    }
)

authorization controle-de-autenticação (
    name: Controle de autenticação
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody:
            ```plsql
            begin
              --
               if pck_romance.fnc_retornaparametro(parametro => 'CONTROLE_AUTENTICACAO',pidfilial => 340) = 'N' then 
                  --
                  return true;
                  --
               end if;
              --
              return
              --
              pck_auditoriaromance.fnc_bloqueiaacesso(pusuario => v('APP_USER'));
              --
            end;
            ```
    }
    error {
        errorMessage:
            ```
            Voce precisa redefinir a sua senha!
            Verifique seu email. 
            ```
    }
)

