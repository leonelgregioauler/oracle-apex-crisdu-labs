classicNavigationBarEntry liberar-distribuidor (
    label: Liberar Distribuidor
    layout {
        sequence: 100
    }
    link {
        target: {
            page: 330
            clearCache: 330
        }
    }
    serverSideCondition {
        type: rowsReturned
        sqlQuery:
            ```sql
            select 1
            from dual
            where v('APP_USER') in ('GUILHERME','EVERTON','NEIDI','ELISIANEM','SARAK','JESSICAALTHAUS','RAMILEDENTE','GRAZIELEF','MICHELEZIMPEL','TATIANELEHNEN','MAICONAIMI','RAFAELASCHIMITT','EMILYSOARES', 'BRUNAZORN', 'ANAPFERREIRA')
            
            ```
    }
)

classicNavigationBarEntry liberar-sync (
    label: Liberar SYNC
    layout {
