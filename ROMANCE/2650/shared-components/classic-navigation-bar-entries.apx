classicNavigationBarEntry bi-crisdu (
    label: BI CRISDU
    layout {
        sequence: 11
    }
    link {
        target: {
            type: url
            url: javascript: irparabi();
        }
    }
    serverSideCondition {
        type: rowsReturned
        sqlQuery:
            ```sql
            select 1
            from usuariossistemas u
            where u.usuario = v('APP_USER')
              and u.idsistema = 29000
            ```
    }
)

