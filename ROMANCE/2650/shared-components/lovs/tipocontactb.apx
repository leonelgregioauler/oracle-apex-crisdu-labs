lov tipocontactb (
    name: TIPOCONTACTB
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            select v.valordominio d
                 , v.notacaovalordominio r
              from dominioscrisdu d
                 , valoresdominioscrisdu v
             where d.iddominioscrisdu = v.iddominioscrisdu
               and upper(d.nomedominio) = :ITEM_NOME_LOV --'TIPOS DE CONTAS CONTÁBEIS'
            order by 1
            ```
    }
)

