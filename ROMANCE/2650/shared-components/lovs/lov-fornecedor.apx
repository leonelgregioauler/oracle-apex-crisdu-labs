lov lov-fornecedor (
    name: LOV_FORNECEDOR
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select p.nomepessoa d
                 , f.idfornecedor r
              from fornecedores f
                 , pessoas p
             where f.idpessoa = p.idpessoa
             
            ```
    }
    columnMapping {
        return: R
        display: D
        defaultSort: D
    }
)

