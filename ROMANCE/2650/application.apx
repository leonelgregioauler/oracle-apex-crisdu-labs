app FINAN26002650 (
    name: Gerenciador Financeiro
    version: release 2.0
    group: @rm
    logo {
        type: text
        text: Gerenciador Financeiro
    }
    navigation {
        homeUrl: {
            page: 1
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            js-defaultCollapsed
            js-navCollapsed--default
            t-TreeNav--classic
        ]
        list: @menu-de-navegação
    }
    navigationBar {
        implementation: classic
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
        usersCanChooseThemeStyle: true
    }
    appFormatMasks {
        date: DD/MM/YYYY
    }
    javaScript {
        fileUrls: #WORKSPACE_FILES#funcoes_anexos.js
        includeLegacyJavascript: [
            pre18
            18
        ]
        includeJqueryMigrate: true
    }
    css {
        fileUrls: [
            #IMAGE_PREFIX#pkgapp_ui/css/5.0#MIN#.css
            #APP_FILES#global#MIN#.css
        ]
    }
    authentication {
        scheme: @database-account
        publicUser: APEX_PUBLIC_USER
    }
    authorization {
        runOnPublicPages: true
        sourceForRoleOrGroupSchemes: authenticationScheme
    }
    security {
        referrerPolicy: strictOriginWhenCrossOrigin
        allowBotAccess: true
        runtimeApiUsage: [
            modifyThisApp
            modifyOtherApps
            modifyWorkspaceRepository
        ]
    }
    sessionStateProtection {
        bookmarkHashFunction: sha1
        acceptPre202UrlChecksums: false
    }
    sessionManagement {
        rejoinSessions: publicSessions
        sessionStateCommits: immediate
    }
    globalization {
        primaryLanguage: pt-br
        documentDirection: leftToRight
    }
    progressiveWebApp {
        enable: false
    }
    rowSearch {
        tokenize: false
    }
    reportPrinting {
        type: useInstanceSettings
    }
    runtime {
        friendlyUrls: false
        allowFeedback: true
        compatibilityMode: 21.2
        accessibleReadOnlyItems: false
    }
    advanced {
        passEcid: false
        modernizeApp: true
    }

    substitution APP_NAME (
        value {
            staticValue: Optimus
        }
    )

)

