lov lov-edicoesrevistas (
    name: LOV_EDICOESREVISTAS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
              select nome as d,
                   idedicaorevista as r
              from edicoesrevistas
             order by 1
             
             
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

