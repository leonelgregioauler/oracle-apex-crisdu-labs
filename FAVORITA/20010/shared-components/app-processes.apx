appProcess busca-semana (
    name: busca semana
    source {
        plsqlCode:
            ```plsql
            begin
              select trim(to_char(semana,'00')||'/'||to_char(ano))
              into :SEMANAATUAL
              from semana_dias
              where sysdate between dt_ini and dt_fim;
            exception
              when others then
                null;
            end;
            ```
    }
    execution {
        sequence: 1
    }
)

