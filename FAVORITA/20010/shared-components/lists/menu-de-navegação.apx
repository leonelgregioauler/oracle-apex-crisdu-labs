list menu-de-navegação (
    name: Menu de Navegação
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select level
                 , descricao        label
                 , 'f?p=&APP_ID.:'||PAGINA||':&SESSION.::NO:::'          target
                 , paginascorrentes  is_current_list_entry
                 , imagem image
              from ( select a.idaplicacao
                          , a.descricao
                          , a.hierarquia
                          , a.pagina
                          , a.imagem
                          , a.paginascorrentes
                          , a.url
                          , a.ordem
                     from roman.aplicacoes a 
                 --       , aplicacoestraduzidas aa
                     where a.idsistema = 20010
                 --      and a.idaplicacao  = aa.idaplicacao (+)
                --       and aa.idioma = nvl(APEX_UTIL.GET_SESSION_LANG,'pt-br')
                       and aparecer = 'S'
                       and exists ( select 1 
                                    from roman.acessos b 
                                    where b.idaplicacao = a.idaplicacao 
                                      and b.usuario = v('APP_USER'))
                     union
                     select a.idaplicacao
                          , a.descricao
                          , a.hierarquia
                          , a.pagina
                          , a.imagem
                          , a.paginascorrentes
                          , a.url
                          , a.ordem
                     from roman.aplicacoes a 
                    --    , aplicacoestraduzidas aa
                     where a.idsistema = 20010
                     --  and a.idaplicacao  = aa.idaplicacao (+)
                     --  and aa.idioma = nvl(APEX_UTIL.GET_SESSION_LANG,'pt-br')
                       and a.hierarquia is null
                       and aparecer = 'S'
                       and exists ( select 1 
                                    from roman.acessos b 
                                    where b.idaplicacao = a.idaplicacao 
                                      and b.usuario = v('APP_USER'))
                     order by ordem)
             start with hierarquia is null
            connect by prior idaplicacao = hierarquia
            order by ordem
            ```
    }
)

