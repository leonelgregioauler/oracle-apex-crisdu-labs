plugin pretiusApexEnhancedModalDialog (
    name: Pretius APEX Enhanced Modal dialog
    staticId: PRETIUS_APEX_ENHANCED_MODAL_DIALOG
    type: dynamicAction
    source {
        plsqlCode:
            ```plsql
            function render_plugin (
              p_dynamic_action in apex_plugin.t_dynamic_action,
              p_plugin         in apex_plugin.t_plugin 
            ) return apex_plugin.t_dynamic_action_render_result
            is
              v_result apex_plugin.t_dynamic_action_render_result;
            
              v_apex_page_row APEX_APPLICATION_PAGES%rowtype;
            BEGIN
            
              apex_javascript.add_library(
                p_name      => 'pamr_onload_2nd',
                p_directory => p_plugin.file_prefix,
                p_version   => NULL 
              );
            
              apex_css.add_file (  
                p_name => 'pamr_style',
                p_directory => p_plugin.file_prefix, 
                p_version => null
              );
            
              v_result.ajax_identifier := APEX_PLUGIN.GET_AJAX_IDENTifIER();
              v_result.attribute_01 := p_dynamic_action.attribute_01;
              v_result.attribute_02 := p_dynamic_action.attribute_02;
              v_result.attribute_04 := p_dynamic_action.attribute_04;
              v_result.attribute_05 := p_dynamic_action.attribute_05;
              v_result.attribute_06 := p_dynamic_action.attribute_06;
              v_result.attribute_07 := p_dynamic_action.attribute_07;
              v_result.attribute_08 := p_dynamic_action.attribute_08;
              v_result.attribute_09 := p_dynamic_action.attribute_09;
              v_result.attribute_10 := p_dynamic_action.attribute_10;
            
              v_result.attribute_10 := p_plugin.attribute_01;
            
              select
                *
              into
                v_apex_page_row
              from 
                APEX_APPLICATION_PAGES
              where
                application_id = :APP_ID
                and page_id = :APP_PAGE_ID;
                
              if upper(v_apex_page_row.PAGE_MODE) = 'NORMAL' then
                v_result.javascript_function := 'function() {prepareParent(this);}';
            
              elsif upper(v_apex_page_row.PAGE_MODE) = 'MODAL DIALOG' AND (:REQUEST <> 'STOP_PASM' OR :REQUEST is null) then
                v_result.javascript_function := '
                  function() {
                    var pageData = {
                      ''app_id'': '||:APP_ID||',
                      ''page_id'': '||:APP_PAGE_ID||',
                      ''page_title'': '''||v_apex_page_row.PAGE_TITLE||''',
                      ''dialog_width'': '''||NVL(v_apex_page_row.DIALOG_WIDTH, 'auto')||''',
                      ''dialog_height'': '''||NVL(v_apex_page_row.DIALOG_HEIGHT, 'auto')||''',
                      ''dialog_max_width'': '''||v_apex_page_row.DIALOG_MAX_WIDTH||''',
                      ''dialog_attributes'': '''||v_apex_page_row.DIALOG_ATTRIBUTES||''',
                      ''dialog_css_classes'': '''||v_apex_page_row.DIALOG_CSS_CLASSES||''',
                      ''dialog_chained'': '''||v_apex_page_row.DIALOG_CHAINED||'''
                    }
                    
                    pretius_apex_resize_modal(this, pageData);
                  }
                ';    
            
              else
                v_result.javascript_function := 'function(){ apex.debug(''Do not run plugin.'') }';
              end if;
            
              APEX_PLUGIN_UTIL.DEBUG_DYNAMIC_ACTION (
                p_plugin         => p_plugin,
                p_dynamic_action => p_dynamic_action
              );  
            
              return v_result;
            
            EXCEPTION
              WHEN OTHERS then
                htp.p( SQLERRM );
                return v_result;
            end render_plugin;
            
            ```
    }
    callbacks {
        apiInterface: function
        renderProcedureName: render_plugin
    }
    advanced {
        category: effect
        substituteAttributeValues: true
    }
    information {
        version: 1.0
    }
)

