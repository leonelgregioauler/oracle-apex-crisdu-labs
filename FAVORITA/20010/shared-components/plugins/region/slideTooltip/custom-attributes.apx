customAttribute attribute_01 (
    apexlangName: iconColumn
    attribute: 1
    name: Icon Column
    type: regionSqlQueryColumn
    validation {
        required: true
    }
    appearance {
        sequence: 2
    }
    help {
        helpText: Select the column from the region SQL Query that holds the icon displayed before the title.
    }
)

customAttribute attribute_02 (
    apexlangName: titleColumn
    attribute: 2
    name: Title Column
    type: regionSqlQueryColumn
    validation {
        required: true
    }
    appearance {
        sequence: 3
    }
    supports {
        dataTypes: [
            varchar2
            number
            date
            timestamp
            timestampWithTimeZone
            timestampWithLocalTimeZone
            intervalYearToMonth
            intervalDayToSecond
            blob
            clob
            bfile
            rowid
        ]
    }
    help {
        helpText: Select the column from the region SQL Query that holds the values displayed in the report.
    }
)

customAttribute attribute_03 (
    apexlangName: badgeColumn
    attribute: 3
    name: Badge Column
    type: regionSqlQueryColumn
    validation {
        required: true
    }
    appearance {
        sequence: 5
    }
    supports {
        dataTypes: [
            varchar2
            number
            date
            timestamp
            timestampWithTimeZone
            timestampWithLocalTimeZone
            intervalYearToMonth
            intervalDayToSecond
            blob
            clob
            bfile
            rowid
        ]
    }
    help {
        helpText: Select the column from the region SQL Query that holds the value displayed at the end of each row displayed.
    }
)

customAttribute attribute_04 (
    apexlangName: mode
    attribute: 4
    name: Mode
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 1
    }
    default {
        value: slide
    }
    help {
        helpText: Select how the report fields are displayed.
    }

    entry slide (
        sequence: 10
        display: Slide
        return: slide
        help {
            helpText: A dropdown indicator is included at end of each record. Pressing this indicator displays the additional fields inline within the report, pushing additional records down.
        }
    )

    entry tooltip (
        sequence: 20
        display: Tooltip
        return: tooltip
        help {
            helpText: The additional fields are displayed as a tooltip next to the record. The tooltip is displayed when you hover over the record.
        }
    )

)

customAttribute attribute_05 (
    apexlangName: linkTarget
    attribute: 5
    name: Link Target
    type: linkToTargetPageUrl
    appearance {
        sequence: 4
    }
    help {
        helpText: <p>Enter a target page to be called when the user clicks a record.</p>
    }
)

