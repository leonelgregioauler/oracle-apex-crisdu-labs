    region atendimentos-hoje (
        name: Atendimentos Hoje
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select t.qtde qtde
                     , 'Tempo Médio: '||nvl(t.tempo,'0:00') tempo
                 from ( select h.atendimentos qtde
                             , beeadmin.retorna_segundos_em_horas(trunc(h.tempo_atendimentos/h.atendimentos)) tempo
                          from beefavorita.historico_atendimentos h
                         where h.data = trunc(sysdate)) t
                ```
        }
        layout {
            sequence: 20
            parentRegion: @tarefas
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        security {
            escapeSpecialChars: false
        }
        settings {
            value: QTDE
            bottomLabel: TEMPO
            color: yes
        }
    )

    region em-atendimento (
        name: Em Atendimento
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select t.qtde qtde, 'Tempo Médio: '||nvl(t.tempo,'0:00') tempo
                 from (select count(1) qtde, beeadmin.retorna_segundos_em_horas(sum(nvl(tempo,0))) TEMPO
                         from (
                                select (sysdate - p.data_ultimo_resgate) * 86400 TEMPO
                                  FROM beefavorita.prospects_original po, beefavorita.prospects p, beefavorita.parametros par
                                 where po.cod_campanha = p.cod_campanha 
                                   and po.codigo = p.codigo
                                   and p.cod_status = par.cod_status_em_uso
                                   and po.coluna_21 = '6'
                                   and p.data_ultimo_resgate > sysdate-(2/24)
                                 union all
                                select (sysdate - p.data_ultimo_resgate) * 86400 TEMPO
                                  FROM beeunified.prospects_original po, beeunified.prospects p, beeunified.parametros par
                                 where po.cod_campanha = p.cod_campanha 
                                   and po.codigo = p.codigo
                                   and p.cod_status = par.cod_status_em_uso
                                   and po.coluna_21 = '6'
                                   and p.data_ultimo_resgate > sysdate-(2/24))
                      ) t
                ```
        }
        layout {
            sequence: 40
            parentRegion: @tarefas
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        security {
            escapeSpecialChars: false
        }
        settings {
            value: QTDE
            bottomLabel: TEMPO
            color: yes
        }
    )

