            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select de.regiao_geografica dado
                         , sum(abordado) qtde
                         , 'Abordagem: ' || round((sum(abordado) / sum(ligacoes)) * 100,2) || '%' percentual
                      from beeweb.vw_resumo_ligacoes_ddd_call v
                         , beedialer.ddds_estados de
                     where v.ddd = de.ddd
                     group by de.regiao_geografica
                     order by 1
                    
                    ```
            }
            columnMapping {
                label: DADO
                value: QTDE
                customTooltip: PERCENTUAL
            }
        )

