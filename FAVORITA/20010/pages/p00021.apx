    region histórico-de-atendimento (
        name: Histórico de Atendimento
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(h.data,'dd/mm/yyyy') || ' (' || to_char(h.data,'Dy') || ')' data
                     , h.atendentes "ATENDENTES"
                     , beepeople.retorna_segundos_em_horas(trunc((h.jornada_normal+h.jornada_extra) / h.atendentes)) "TEMPO MÉDIO JORNADA"
                     , beepeople.retorna_segundos_em_horas(trunc(h.tempo_pausas / h.atendentes)) "TEMPO MÉDIO DE PAUSA"
                     , h.tarefas_novas_dia "TAREFAS NOVAS"
                     , h.tarefas_atendidas "TAREFAS ATENDIDAS"
                     , beepeople.retorna_segundos_em_horas(h.tme_dia_util) "TEMPO MÉDIO RETORNO"
                     , h.atendimentos "ATENDIMENTOS EM TELA"
                     , h.ligacoes "LIGAÇÕES"
                     , beepeople.retorna_segundos_em_horas(trunc(h.tempo_ligacoes / h.ligacoes)) "TEMPO MÉDIO LIGAÇÕES"
                     , h.ligacoes_improdutivas "LIGAÇÕES IMPRODUTIVAS"
                     , beepeople.retorna_segundos_em_horas(trunc(h.tempo_improdutivo / h.atendentes)) "TEMPO MÉDIO IMPRODUTIVO"
                     , beepeople.retorna_segundos_em_horas(trunc(h.tempo_improdutivo)) "TEMPO TOTAL IMPRODUTIVO"
                     , h.perdas "TAREFAS PERDIDAS POR TENTATIVA"
                     , t.pedidos "PEDIDOS"
                     , to_char(t.revista,'FM999G999G990D00') "VALOR REVISTA"
                     , to_char(t.valores,'FM999G999G990D00') "VALOR DAS VENDAS"
                     , to_char(t.revista/t.pedidos,'FM999G999G990D00') "TICKET MÉDIO"
                  from beefavorita.historico_atendimentos h
                     , (select trunc(vw.dataemissao) data
                             , count(1) pedidos
                             , sum(nvl(vw.valortotal,0)) revista
                             , sum(nvl(vw.valorapagar,0)) valores
                          from favorita.vw_dashboardatendimento_bee vw
                         where vw.dataemissao > trunc(sysdate-14)
                         group by trunc(vw.dataemissao)) t
                 where h.data = t.data
                   and h.data >= trunc(sysdate-14)
                 order by h.data desc
                ```
        }
        layout {
            sequence: 95
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--noBorders
                js-showMaximizeButton
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
