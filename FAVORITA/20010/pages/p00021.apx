    region resumo-de-atividade (
        name: Resumo de Atividade
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ca.atividade link
                     , ca.atividade
                     , count(1) quantidade
                  from beeweb.controle_atividade ca, beeadmin.usuarios u, beepeople.controle_frequencia cf
                 where ca.cod_usuario = u.codigo
                   and u.cod_pessoa = cf.cod_pessoa
                   and u.empresa = cf.empresa
                   and sysdate between cf.data_entrada_efetiva and cf.data_saida_prevista
                   and cf.cod_centro_custo = '4'
                   and ca.atividade != 'LOGOUT'
                   and ca.data_termino is null
                   and ca.data_inicio > sysdate - (6/24)
                 group by ca.atividade
                
                ```
        }
        layout {
            sequence: 115
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: donut
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        animation {
            onDataChange: none
        }
        legend {
            hideAndShowBehavior: none
        }

        series resumo (
            name: Resumo
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select ca.atividade link
                         , ca.atividade
                         , count(1) quantidade
                      from beeweb.controle_atividade ca
                         , beefavorita.usuarios_atendimento ua
                         , beefavorita.grupos_atendimento ga 
                     where ca.cod_usuario = ua.cod_usuario
                       and ua.cod_grupo = ga.codigo
                       and instr(',' || ga.tipos_tarefas || ',',',6,') > 0
                       and  ca.atividade != 'LOGOUT'
                       and ca.data_termino is null
                       and ca.data_inicio > sysdate - (6/24)
                     group by ca.atividade
                    ```
            }
            columnMapping {
                label: ATIVIDADE
                value: QUANTIDADE
            }
            link {
                type: redirectThisApp
                target: {
                    page: 23
                    items: {
                        P23_VALOR: &ATIVIDADE.
                    }
                    action: resetPagination
                }
            }
        )

    )

