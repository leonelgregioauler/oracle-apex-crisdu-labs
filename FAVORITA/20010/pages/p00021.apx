    region tarefas-novas (
        name: Tarefas Novas
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select nvl(t.qtde,0) || ' (' || (select to_char(max(datainclusao),'hh24:mi') from favorita.vw_tarefas_bee where idtipotarefa = 6) || ')'qtde
                     , 'Maior Tempo: '||nvl(t.tempo,'0:00') tempo
                 from ( select count(1) qtde
                             , beeadmin.retorna_segundos_em_horas(trunc((sysdate-min(t.datainclusao)) * 86400)) tempo
                          from favorita.vw_tarefas_bee t, beedialer.ddds_estados de
                         where t.idgrupoatendimento = 4
                           and t.idtipotarefa = '6'
                           and beepeople.sonumeros(length(t.telefone)) > 10
                           and nvl(substr(beepeople.sonumeros(t.telefone),1,2),'51') = de.ddd
                           and beepeople.sonumeros(t.telefone) not like '0%'
                           and t.idsituacao = 0) t
                ```
        }
        layout {
            sequence: 10
            parentRegion: @tarefas
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        security {
            escapeSpecialChars: false
        }
        settings {
            value: QTDE
            bottomLabel: TEMPO
            color: yes
        }
    )

