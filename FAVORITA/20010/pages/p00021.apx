page 21 (
    name: Dashboard Callcenter
    title: Dashboard Callcenter
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function doLoad()
            {
               setTimeout( "refresh()", 30*1000 );
            }
            
            function refresh()
            {
            window.location.href = window.location;
             apex.submit('TROCAPAGINA');
            }
            
            ```
        executeWhenPageLoads: doLoad();
    }
    security {
        pageAccessProtection: unrestricted
    }

    region acompanhamento-online (
        name: Acompanhamento Online
        type: chart
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: lineWithArea
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        tooltip {
            showGroupName: false
        }
        legend {
            hideAndShowBehavior: none
        }

        series resumo (
            name: Resumo
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select to_char(data,'hh24:mi:ss') data, dado, quantidade
                      from beefavorita.snapshot_atendimento
                     where data >= sysdate-(15/60/24)
                     order by 1
                    ```
            }
            columnMapping {
                seriesName: DADO
                label: DATA
                value: QUANTIDADE
            }
            line {
                type: curved
            }
        )

        axis x (
            name: x
            title: Horário
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Quantidade
            value {
                format: decimal
                baselineScaling: min
            }
            minorTicks {
                show: false
            }
        )

        axis y-1 (
            name: y2
            minorTicks {
                show: false
            }
        )

    )

