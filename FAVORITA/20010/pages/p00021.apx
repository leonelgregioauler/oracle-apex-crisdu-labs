    region atendentes-por-atividade (
        name: Atendentes por Atividade
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ca.atividade
                     , op.nome atendente
                     , beeadmin.retorna_segundos_em_horas(trunc((sysdate - data_inicio) * 86400)) tempo
                     , ca.estacao PA
                  from beeweb.controle_atividade ca
                     , beeadmin.usuarios u
                     , beepeople.vw_pessoas op
                     , beepeople.controle_frequencia cf
                 where ca.cod_usuario = u.codigo
                   and u.cod_pessoa = op.codigo
                   and u.empresa = op.empresa
                   and op.codigo = cf.cod_pessoa
                   and op.empresa = cf.empresa
                   and ca.data_termino is null
                   and ca.atividade != 'LOGOUT'
                   and ca.data_inicio > sysdate - (6/24)
                   and ca.data_inicio between cf.data_entrada_efetiva and cf.data_saida_prevista
                order by ca.atividade
                     , ca.data_inicio
                ```
        }
        layout {
            sequence: 135
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        searchBar {
            searchField: false
            reportsSelectList: false
        }
        actionsMenu {
            filter: false
        }
        advanced {
            savedReportMappingIdentifier: 2746472407431198213
        }

