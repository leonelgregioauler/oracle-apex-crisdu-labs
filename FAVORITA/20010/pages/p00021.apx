    region histórico-de-vendas (
        name: Histórico de Vendas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.mes "MÊS"
                     , to_char(t.tarefas,'999G990') tarefas
                     , to_char(t.pedidos, '999G999G990') pedidos
                     , to_char(t.valortotal,'FM999G999G990D00') "VALOR TOTAL"
                     , to_char(t.valorapagar,'FM999G999G990D00') "VALOR À PAGAR"
                     , to_char(round(t.valortotal / t.pedidos,2),'FM999G999G990D00') "TICKET MÉDIO"
                     , t.atendentes
                     , to_char(round(t.valortotal / decode(t.total_atendentes,0,1,t.total_atendentes),2),'FM999G999G990D00') "VALOR MÉDIO POR ATENDENTE"
                  from (
                        select t.mes
                             , t.data
                             , (select count(1) 
                                  from tarefas where idtipotarefa = '6' 
                                   and datainclusao between to_date(t.data,'yymmdd') 
                                                and add_months(to_date(t.data,'yymmdd'),1)) tarefas
                             , beepeople.fun_media_logados ('4', to_date(t.data,'yymmdd'), add_months(to_date(t.data,'yymmdd'),1)-1) atendentes
                             , beepeople.fun_total_logados ('4', to_date(t.data,'yymmdd'), add_months(to_date(t.data,'yymmdd'),1)-1) total_atendentes
                             , t.pedidos
                             , t.valorapagar
                             , t.valortotal
                          from (
                                select to_char(p.dataemissao,'Mon/yyyy') mes
                                     , to_char(p.dataemissao,'yymm')||'01' data
                                     , count(1) pedidos  
                                     , sum(nvl(p.valorapagar,0)) valorapagar
                                     , sum(nvl(p.valortotal,0)) valortotal
                                  from favorita.vw_dashboardatendimento_bee p
                                 where p.dataemissao between to_date('01/' || to_char(trunc(add_months(sysdate,-13)),'mm/yyyy'),'dd/mm/yyyy') 
                                                         and sysdate
                                 group by to_char(p.dataemissao,'Mon/yyyy')
                                        , to_char(p.dataemissao,'yymm')||'01'
                                ) t ) t 
                  order by t.data desc
                ```
        }
        layout {
            sequence: 145
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--noBorders
            ]
        }
