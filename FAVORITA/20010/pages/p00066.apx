    region estoques (
        name: Estoques
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                    -- Variáveis de controle da rotina
                    v_select   varchar2(4000);
                    v_from     varchar2(4000);
                    v_where    varchar2(4000);
                
                begin
                
                    -- Monta o select
                    v_select := '
                    select e.idfilialfavorita
                         , e.filialfavorita
                         , e.nomeprodutodetalhado
                         , e.idcategoria
                         , e.nomecategoria
                         , e.idcategoriasite
                         , e.nomecategoriasite
                         , e.nomefornecedor
                         , e.descontinuado_revista
                         , e.idestoque
                         , e.idproduto
                         , e.idprodutodetalhado
                         , e.quantidade
                         , e.reservado
                         , e.quantidadedisponivel
                         , e.valorpagaritem
                         , p.valorvenda * e.quantidade totalpagar
                         , (p.valorvenda * e.quantidade) / decode(e.idpais,4,1700,2,9,1) totalpagarconvertido
                         , (e.quantidade * valorCusto.valorcusto) totalcusto
                         , (e.valorpagaritem / decode(e.idpais,4,1.700,2,9,1)) valorpagaritem_cov
                         , (e.totalpagar / decode(e.idpais,4,1.700,2,9,1)) totalpagar_conv
                         , ((e.quantidade * valorCusto.valorcusto) / decode(e.idpais,4,1.700,2,9,1)) totalcusto_conv
                         , e.tagsproduto
                         , e.idpais
                         , decode(e.idpais,4,1700,2,9,1) fator_conversao
                         , pr.dataliberadovenda ';
                
                    -- Monta o From 
                    v_from := '
                  from favorita.vw_estoques_fav_bi_val e
                     , favorita.temp_relacaoprecosprodutos p
                     , favorita.produtos pr
                     , ( select pp.valorcusto
                              , pp.idprodutodetalhado
                           from favorita.precosprodutos pp
                          where pp.idprecoproduto = ( select max(ppp.idprecoproduto)
                                                         from favorita.precosprodutos ppp
                                                        where ppp.idprodutodetalhado = pp.idprodutodetalhado)  ) valorcusto ';
                    -- Monta o Where
                    v_where := '
                 where e.idprodutodetalhado = p.idprodutodetalhado(+) 
                   and e.idpais = p.idpais(+)
                   and valorCusto.idprodutodetalhado = e.idprodutodetalhado
                   and e.idproduto = pr.idproduto ';
                
                    -- filial favorita 
                    if :P66_IDFILIALFAVORITA is null then
                        v_where := v_where || ' 
                                                and exists ( select 1
                               from favorita.usuariosfiliaisfavorita ff
                              where ff.idfilialfavorita = e.idfilialfavorita 
                                and ff.idusuario        = :P0_IDUSUARIO )';
                    else
                        v_where := v_where || ' 
                                           and :P66_IDFILIALFAVORITA = e.idfilialfavorita';
                    end if;
                
                    -- fornecedor
                    if :P66_IDFORNECEDOR is not null then
                        v_where := v_where || ' 
                                           and exists ( select 1 
                                                          from favorita.fornecedoresprodutos f
                                                         where f.idfornecedor = :P66_IDFORNECEDOR
                                                           and f.idproduto    = e.idproduto )';
                    end if;
                
                    -- produto
                    if :P66_IDPRODUTO is not null then
                        v_where := v_where || '
                                           and  e.idproduto  = :P66_IDPRODUTO';
                    end if;
                
                    -- produto detalhado
                    if :P66_IDPRODUTODETALHADO is not null then
                        v_where := v_where || ' 
                                            and e.idprodutodetalhado = :P66_IDPRODUTODETALHADO';
                    end if;
                
                    -- pais
                    if :P66_IDPAIS is not null then
                        v_where := v_where || '
                                           and e.idpais = :P66_IDPAIS';
                    end if;
                
                    -- categoria
                    if :P66_IDCATEGORIA is not null then
                        v_where := v_where || '
                                           and e.idcategoria = :P66_IDCATEGORIA';
                    end if;
                
                    -- categoria site
                    if :P66_IDCATEGORIA is not null then
                        v_where := v_where || '
                                           and e.idcategoriasite = :P66_IDCATEGORIASITE';
                    end if;
                
                    -- Grava log
                    roman.prc_grava_log_debug_desenvolvedores('oaifdhg87sdyv87av8g',v_select,v_from,v_where);
                
                    -- Retorna a quey completa
                    return v_select || v_from || v_where;
                end;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
