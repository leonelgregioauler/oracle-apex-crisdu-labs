    button filtrar (
        buttonName: Filtrar
        label: Filtrar
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--stretch
                t-Button--gapTop
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            customAttributes: "            style=\"background-color:#309fdb; color:white; border: 1px solid #1f6fa5; border-radius: 4px; font-weight: bold; transition: 0.3s ease-in-out;\"   			onmouseover=\"this.style.backgroundColor='#267db6'; this.style.boxShadow='0 0 25px rgba(48, 159, 219, 0.7)';\"   			onmouseout=\"this.style.backgroundColor='#309fdb'; this.style.boxShadow='none';\""
        }
    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                    -- Inicializa a DATA INICIAL
                    if :P90_DATA_INICIAL is null then
                        :P90_DATA_INICIAL := TRUNC(ADD_MONTHS(SYSDATE, -1), 'MM');
                    end if;
                
                    -- inicializa a P90_DATA_FINAL
                    if :P90_DATA_FINAL is null then
                        :P90_DATA_FINAL := LAST_DAY(ADD_MONTHS(SYSDATE, -1));
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 378506364262702930
        }
    )

)

