page 90 (
    name: Inteligência de Mercado
    alias: INTELIGÊNCIA-DE-MERCADO
    title: Inteligência de Mercado
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }

    region análise-de-faturamento-por-filial-de-pedidos-de-distribuidor (
        name: Análise de Faturamento por Filial de Pedidos de Distribuidor
        title: Análise de Faturamento por Filial de Pedidos de Distribuidor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(pp.apelido, pp.nomepessoa))      as "Nome Filial"
                     , nvl(sum(p.valorapagar * p.fatorconversao),0) as "Valor Atingido"
                  from favorita.pedidos p
                     , catal.filiais f
                     , catal.pessoas pp
                     , catal.vendedoras v
                     , catal.representantes r
                 where f.idfilial = p.idfilialromance
                   and v.idvendedora = p.idvendedora
                   and r.idpessoa = v.idpessoa
                   and f.idpessoa = pp.idpessoa
                   and p.datacancelamento is null
                   and p.dataemissao between to_date(trim(:P90_DATA_INICIAL)||' 00:00:00','DD/MM/RRRR HH24:MI:SS') 
                                         and to_date(trim(:P90_DATA_FINAL)  ||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                 group by nvl(pp.apelido, pp.nomepessoa)
                 order by 1
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 378504376374702910
        }

        column "Nome Filial" (
            type: plainText
            heading {
                heading: Filial
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column "Valor Atingido" (
            type: plainText
            heading {
                heading: Valor Atingido
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Análise de Faturamento por Filial de Pedidos de Distribuidor
        }

        savedReport 3787391 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn "Nome Filial" (
                sequence: 1
            )

            displayColumn "Valor Atingido" (
                sequence: 2
            )

        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
    )

    region quantidade-de-vendedoras-ativas-por-país (
        name: Quantidade de Vendedoras Ativas por País
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pp.nome as "País"
                     , count(distinct n.idvendedora) as "Qtd. Vendedoras"
                  from roman.notasvendas n
                     , catal.vendedoras v
                     , catal.pessoas p
                     , catal.paises pp
                 where n.idvendedora = v.idvendedora
                   and p.idpessoa = v.idpessoa
                   and pp.idpais = p.idpais
                   and v.ativo = 'S'
                   and n.datanota between to_date(trim(:P90_DATA_INICIAL)||' 00:00:00','DD/MM/RRRR HH24:MI:SS') 
                                      and to_date(trim(:P90_DATA_FINAL)  ||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                 group by pp.nome
                 order by 1
                ```
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 378504783000702914
        }

        column País (
            type: plainText
            heading {
                heading: País
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column "Qtd. Vendedoras" (
            type: plainText
            heading {
                heading: Qtd. Vendedoras
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 3787433 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn "País" (
                sequence: 1
            )

            displayColumn "Qtd. Vendedoras" (
                sequence: 2
            )

        )

    )

