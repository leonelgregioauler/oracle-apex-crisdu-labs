    process alimenta-data (
        name: Alimenta Data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P82_DATAINICIO is null then
                    :P82_DATAINICIO := trunc(sysdate,'MM');
                  end if;
                  --
                  if :P82_DATAFIM is null then
                    :P82_DATAFIM := trunc(last_day(sysdate));
                  end if;
                  --
                END;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1095776519903186639
        }
        serverSideCondition {
            type: itemIsNull
            item: P82_DATAINICIO
        }
    )

)

