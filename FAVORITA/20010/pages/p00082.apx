page 82 (
    name: Comissões Pagas
    title: Comissões Pagas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtrar (
        name: Filtrar
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region lucros-distribuidores (
        name: Lucros Distribuidores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) distribuidor
                     , nvl(p.documentoestrangeiro,p.cpf) documento
                     , r.idrepresentante
                     , r.idfilial
                     , roman.pck_romance.fnc_nomefilial(r.idfilial) franquia
                     , round(( select sum(nvl(pg.valorpago,0))
                               from pagamentocomissoes pg
                               where pg.idrepresentante = r.idrepresentante
                                 and pg.datapagamento >= to_date(trunc(sysdate-90,'MM')||' 00:00:01','DD/MM/RRRR hh24:mi:ss') )/3,2) media_3_ultimos
                     , ( select sum(nvl(pg.valorpago,0))
                         from pagamentocomissoes pg
                         where pg.idrepresentante = r.idrepresentante
                           and extract(year from pg.datapagamento) >= 2023 ) total_sacado
                     , ( select round(sum(cp.comissaodistribuidor),2)
                         from VW_COMISSOESPAGAR_NOVA_M cp
                         where cp.idrepresentante = r.idrepresentante
                           and not exists ( select 1
                                            from pagamentocomissoes pc
                                            where pc.idpedido = cp.idpedido
                                              and pc.idvencimentopedido = cp.idvencimentopedido
                                              and pc.idrepresentante is not null ) ) disponivel
                     , ( select nvl(sum(md.valoratualizado),0)
                         from roman.debitosdistribuidoresfav md
                         where md.idrepresentante = r.idrepresentante
                           and md.valorpago < md.valororiginal ) debitos
                     , ( select nvl(sum(pp.valorpago),0)
                         from pagamentocomissoes pp
                         where pp.idrepresentante = r.idrepresentante
                           and pp.idgerente is null
                           and pp.datapagamento between to_date(:P82_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') 
                                                    and to_date(:P82_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') ) pagamentos_no_periodo
                from representantes r
                   , pessoas p
                where r.ativo = 'S'
                  and p.idpessoa = r.idpessoa
                  and not exists ( select 1
                                   from gerentes g
                                   where g.idpessoa = r.idpessoa );
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 3377110124050864106
        }

