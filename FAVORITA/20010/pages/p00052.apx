page 52 (
    name: Estoque
    title: Estoque
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region estoque (
        name: Estoque
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idfilialfavorita_est
                    , t.filialfavorita_est
                    , t.nomeproduto
                    , t.disponivel
                from FAVORITA.temp_analisenecessidadecomp1 t 
                where t.idprodutodetalhado         = :P52_IDPRODUTODETALHADO
                  and t.idfilialorigem_abatecedor  = :P52_IDFILIALFAVORITA   
                order by 2
                ```
            pageItemsToSubmit: [
                P52_IDFILIALFAVORITA
                P52_IDPRODUTODETALHADO
            ]
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 9152360063077214143
        }

        column DISPONIVEL (
            type: plainText
            heading {
                heading: Disponível
                alignment: end
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column FILIALFAVORITA_EST (
            type: plainText
            heading {
                heading: Estoque
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column IDFILIALFAVORITA_EST (
            type: plainText
            heading {
                heading: Idfilialfavorita Est
                alignment: end
            }
            layout {
                sequence: 1
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column NOMEPRODUTO (
            type: plainText
            heading {
                heading: Produto
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 45312326 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DISPONIVEL (
                sequence: 3
            )

            displayColumn FILIALFAVORITA_EST (
                sequence: 1
            )

            displayColumn NOMEPRODUTO (
                sequence: 2
            )

            aggregate (
                column: DISPONIVEL
            )

            controlBreak (
                column: NOMEPRODUTO
                layout {
                    sequence: 1
                }
            )

        )

    )

    pageItem P52_IDFILIALFAVORITA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @estoque
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P52_IDPAIS (
        type: hidden
        layout {
            sequence: 30
            region: @estoque
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P52_IDPRODUTODETALHADO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @estoque
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

