    pageItem P44_IDEDICAOREVISTA (
        type: plugin/select
        label {
            label: Edição de Revista
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                  select pck_util_fav.fnc_edicaorevista(idedicaorevista) as d,
                       idedicaorevista as r
                  from edicoesrevistas
                 order by 1
                ```
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P44_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Filial Favorita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) as d,
                       idfilialfavorita as r
                  from filiaisfavorita
                  where ((:P44_TIPOFILIAL = 'F' and tipofilial not in ('L') )
                      or (:P44_TIPOFILIAL = 'T')
                      or (:P44_TIPOFILIAL = 'L' and tipofilial in ('L') ))
                     and idpais = :P44_IDPAIS
                 order by 1
                ```
            nullDisplayValue: - Todas Filiais -
        }
        cascadingLov {
            parentItems: [
                P44_TIPOFILIAL
                P44_IDPAIS
            ]
            itemsToSubmit: [
                P44_TIPOFILIAL
                P44_IDPAIS
            ]
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P44_IDFILIALROMANCE (
        type: plugin/select
        label {
            label: Distrib. Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct 
                       pck_util_fav.fnc_nomefilialromance(afr.idfilialdestino) as d,
                       afr.idfilialdestino as r
                  from atendimentosfiliaisrmc afr
                     , filiaisfavorita f
                 where afr.idfilialfavoritaorigem = f.idfilialfavorita
                   and f.idfilialfavorita = nvl(:P44_IDESTOQUE, f.idfilialfavorita)
                 order by 1
                ```
            nullDisplayValue: - Todas Filiais -
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P44_IDFORNECEDOR (
        type: plugin/select
        label {
            label: Fornecedores
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct cp.nomepessoa select_value
                     , cd.idfornecedor return_value
                from catal.fornecedores   cd
                   , catal.pessoas        cp
                   , fornecedoresprodutos fr
                where cd.idpessoa     = cp.idpessoa
                  and cd.idfornecedor = fr.idfornecedor 
                order by 1
                ```
            nullDisplayValue: " - Todos - "
        }
        layout {
            sequence: 120
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P44_IDPAIS (
        type: selectList
        label {
            label: País
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome as d
                     , idpais as r
                from catal.paises
