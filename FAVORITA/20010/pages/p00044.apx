    region porcentagem-venda-por-produto-comprado (
        name: Porcentagem Venda por Produto Comprado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomeproduto
                     , qtdcomprada
                     , qtdvendida
                     , qtdperda
                     , MovimentacaoManual
                     , case
                         when qtdcomprada > 0 then
                          CAST( (qtdvendida*100)/qtdcomprada AS DECIMAL (10,2))
                         else
                           qtdcomprada
                         end PorcentagemVenda
                from (select favorita.pck_util_fav.fnc_nomeprodutodetalhado(pd.idprodutodetalhado,1) nomeproduto
                           , nvl( ( select sum(ict.quantidadecomprada)
                                    from favorita.itenscomprastransferencias ict
                                       , favorita.comprastransferencias cct
                                    where ict.idprodutodetalhado  = pd.idprodutodetalhado
                                      and ict.idcompratransferencia = cct.idcompratransferencia
                                      and  trunc(cct.dataemissao) between  to_date(:P44_DATAINICIOF,'DD/MM/RRRR') and to_date(:P44_DATAFIMF,'DD/MM/RRRR')) ,0) qtdcomprada
                           , nvl( ( select sum(i.quantidade)
                                    from favorita.itenspedidos i
                                    where i.idprodutodetalhado = pd.idprodutodetalhado ) ,0) qtdvendida
                           , nvl( ( select sum(i.quantidade)
                                    from favorita.itensindisponiveispedidos i
                                    where i.idprodutodetalhado = pd.idprodutodetalhado ) ,0) qtdperda
                           , nvl((select sum(me.quantidade)
                                  from favorita.movimentosestoques me
                                  where me.iditemcompratransf is null
                                  and me.idprodutodetalhado = pd.idprodutodetalhado) ,0) MovimentacaoManual
                      from favorita.produtosdetalhados pd )
                Where :P44_TIPOFILTROFORNECEDOR = 3;
                  
                  
                
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent6
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where :P44_TIPOFILTRO = 2
                  and :P44_TIPOFILTROFORNECEDOR = 3
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Não encontrou informações.
        }
        advanced {
            savedReportMappingIdentifier: 6294852756149850744
        }

