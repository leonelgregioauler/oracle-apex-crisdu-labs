    dynamicAction desabilita-filiais (
        name: Desabilita Filiais
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P44_TIPOFILIAL
        }
        clientSideCondition {
            type: item=value
            item: P44_TIPOFILIAL
            value: T
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: items
                items: P44_IDFILIALFAVORITA
            }
            execution {
                sequence: 10
            }
        )

        action native-disable-2 (
            action: disable
            affectedElements {
                selectionType: items
                items: P44_IDFILIALROMANCE
            }
            execution {
                sequence: 20
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: items
                items: P44_IDFILIALFAVORITA
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-enable-2 (
            action: enable
            affectedElements {
                selectionType: items
                items: P44_IDFILIALROMANCE
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-set-value (
            action: setValue
            affectedElements {
                selectionType: items
                items: P44_IDFILIALFAVORITA
            }
            execution {
                sequence: 30
            }
        )

        action native-set-value-2 (
            action: setValue
            affectedElements {
                selectionType: items
                items: P44_IDFILIALROMANCE
            }
            execution {
                sequence: 40
            }
        )

    )

