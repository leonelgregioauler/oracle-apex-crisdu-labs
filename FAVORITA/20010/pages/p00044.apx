    region porcentagem-por-fonecedor (
        name: Porcentagem por Fonecedor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT fornecedor
                     , Quantidade
                     , ValorTotal
                     , CustoTotal
                     , LucroTotal
                     , CASE WHEN ValorTotal>0 THEN
                           CAST((CustoTotal*100 / ValorTotal ) AS DECIMAL (5,2)) 
                       ELSE
                           CAST(ValorTotal AS DECIMAL (5,2)) 
                           
                       END PorcentagemCusto  
                FROM(select roman.pck_romance.fnc_nomefornecedor(fn.idfornecedor) fornecedor
                          , sum(fi.quantidade) Quantidade
                          , SUM(fi.quantidade*fi.valorcusto) CustoTotal
                          , nvl(SUM(fi.valorvenda*fi.quantidade), 000.1) ValorTotal
                          , SUM((fi.valorvenda*fi.quantidade)-(fi.quantidade*fi.valorcusto)) LucroTotal
                     from favorita.vw_itenspedidos_fav fi
                        , favorita.pedidos fp
                        , favorita.fornecedoresprodutos fn
                     where fi.idpedido        = fp.idpedido
                       and fn.idproduto       = fi.idproduto
                       and fi.ididioma        = 1
                       and :P44_TIPOFILTROFORNECEDOR = 2
                       and fp.datacancelamento is null
                       and ( trunc(fp.dataemissao) between  to_date(:P44_DATAINICIOF,'DD/MM/RRRR') and to_date(:P44_DATAFIMF,'DD/MM/RRRR') )
                     group by fn.idfornecedor)
                order by 1 
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where :P44_TIPOFILTRO = 2
                  and :P44_TIPOFILTROFORNECEDOR = 2
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Não encontrou informações.
        }
        advanced {
            savedReportMappingIdentifier: 6294655064806597687
        }

