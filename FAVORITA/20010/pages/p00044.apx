    region vendas-por-fornecedores (
        name: Vendas por Fornecedores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.nomeproduto              produto
                     , nvl(sum(it.quantidade),0)                                              quantidadevendido
                     , nvl(sum(( select sum(pck_estoque_fav.fnc_estoquedisponivel(pidestoque => es.idestoque))
                         from estoques es
                            , produtosdetalhados p
                         where es.idprodutodetalhado = p.idprodutodetalhado
                           and p.idproduto           = w.idproduto
                           and ( :P44_IDFILIALFAVORITA   is null or es.idfilialfavorita = :P44_IDFILIALFAVORITA ) ) ) ,0)           quantidadeestoque
                     , nvl(sum(it.custototal),0)                                              custototal
                     , nvl(sum(it.valortotal),0)                                              valortotal
                     , nvl(sum(it.lucrobruto),0)                                              lucrobruto
                     --
                     , nvl(sum(itperda.quantidadeperda),0)                                    quantidadeperda
                     , nvl(sum(itperda.CustoTotalperda),0)                                    CustoTotalperda
                     , nvl(sum(itperda.ValorTotalperda),0)                                    ValorTotalperda
                     , nvl(sum(itperda.lucrobrutoperda),0)                                    lucrobrutoperda 
                     --     
                     , w.idproduto
                from vw_produtos_fav w
                   , fornecedoresprodutos f
                   , ( select fi.idproduto
                            , sum(fi.quantidade) Quantidade
                            , SUM( ( fi.quantidade * fi.valorcusto ) * fp.fatorconversao ) CustoTotal
                            , SUM( ( fi.quantidade * fi.valorvenda ) * fp.fatorconversao ) ValorTotal
                            , SUM( ( ( fi.quantidade * fi.valorvenda )  
                                   - ( fi.quantidade * fi.valorcusto ) ) * fp.fatorconversao ) lucrobruto  
                      from favorita.itenspedidos fi
                         , favorita.pedidos fp
                      where fi.idpedido            = fp.idpedido
                        and fp.datacancelamento    is null
                        and (( :P44_TIPOFILIAL = 'L' and (:P44_IDFILIALFAVORITA   is null or fp.idfilialfavorita  = :P44_IDFILIALFAVORITA )  ) 
                          or ( :P44_TIPOFILIAL = 'F' and (:P44_IDFILIALFAVORITA   is null or fp.idfilialromance  in ( select afr.idfilialdestino
                                                                                                                    from atendimentosfiliaisrmc afr
                                                                                                                    where afr.idfilialfavoritaorigem = :P44_IDFILIALFAVORITA ) ) )
                          or ( :P44_TIPOFILIAL = 'F' and :P44_IDFILIALFAVORITA = 1 and fp.idfilialfavorita = 1 )
                          or ( :P44_TIPOFILIAL = 'T' )) 
                        and ( :P44_IDFILIALROMANCE    is null or fp.idfilialromance  = :P44_IDFILIALROMANCE  ) 
                        and (  ( :P44_TIPODATA = 1 and trunc(fp.dataemissao) between  to_date(:P44_DATAINICIO,'DD/MM/RRRR') and to_date(:P44_DATAFIM,'DD/MM/RRRR') )
                            or ( :P44_TIPODATA = 2 and trunc(fp.dataentrega) between  to_date(:P44_DATAINICIO,'DD/MM/RRRR') and to_date(:P44_DATAFIM,'DD/MM/RRRR') ) )
                        and ( :P44_IDEDICAOREVISTA is null or fp.idedicaorevista = :P44_IDEDICAOREVISTA )
                      group by fi.idproduto ) it
                   , ( select fid.idproduto
                            , sum(fid.quantidade)                                                quantidadeperda
                            , SUM( ( fid.quantidade * fid.valorcusto ) * fp.fatorconversao )     CustoTotalperda
                            , SUM( ( fid.quantidade * fid.valorvenda ) * fp.fatorconversao )     ValorTotalperda
                            , SUM( ( ( fid.quantidade * fid.valorvenda )  
                                   - ( fid.quantidade * fid.valorcusto ) ) * fp.fatorconversao ) lucrobrutoperda  
                       from itensindisponiveispedidos fid
                          , pedidos                   fp
                       where fp.idpedido     = fid.idpedido 
                         and fp.datacancelamento is null
                        and (( :P44_TIPOFILIAL = 'L' and (:P44_IDFILIALFAVORITA   is null or fp.idfilialfavorita  = :P44_IDFILIALFAVORITA )  ) 
                          or ( :P44_TIPOFILIAL = 'F' and (:P44_IDFILIALFAVORITA   is null or fp.idfilialromance  in ( select afr.idfilialdestino
                                                                                                                    from atendimentosfiliaisrmc afr
                                                                                                                    where afr.idfilialfavoritaorigem = :P44_IDFILIALFAVORITA ) ) )
                          or ( :P44_TIPOFILIAL = 'F' and :P44_IDFILIALFAVORITA = 1 and fp.idfilialfavorita = 1 )
                          or ( :P44_TIPOFILIAL = 'T' )) 
                        and ( :P44_IDFILIALROMANCE    is null or fp.idfilialromance  = :P44_IDFILIALROMANCE  ) 
                        and (  ( :P44_TIPODATA = 1 and trunc(fp.dataemissao) between  to_date(:P44_DATAINICIO,'DD/MM/RRRR') and to_date(:P44_DATAFIM,'DD/MM/RRRR') )
                            or ( :P44_TIPODATA = 2 and trunc(fp.dataentrega) between  to_date(:P44_DATAINICIO,'DD/MM/RRRR') and to_date(:P44_DATAFIM,'DD/MM/RRRR') ) )
                        and ( :P44_IDEDICAOREVISTA is null or fp.idedicaorevista = :P44_IDEDICAOREVISTA )
                      group by fid.idproduto )  itperda
                where w.idproduto            = it.idproduto 
                  and f.idproduto            = w.idproduto
                  and w.idproduto            = itperda.idproduto (+)
                  and ( :P44_IDFORNECEDOR     is null or f.idfornecedor = :P44_IDFORNECEDOR  )
                  and ( :P44_IDPRODUTO        is null or w.idproduto     = :P44_IDPRODUTO     )
                  and w.ididioma = 1
                group by w.nomeproduto
                       , w.idproduto
                ORDER BY 1
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where :P44_TIPOFILTRO = 2
                  and :P44_TIPOFILTROFORNECEDOR = 1
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Não encontrou informações.
        }
        advanced {
            savedReportMappingIdentifier: 6294654444502597681
        }

