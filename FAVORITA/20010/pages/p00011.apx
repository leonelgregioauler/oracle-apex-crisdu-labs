page 11 (
    name: Controle de Acessos
    title: Controle de Acessos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region aplicações (
        name: Aplicações
        type: tabform
        source {
            sqlQuery:
                ```sql
                select idaplicacao
                      ,descricao
                      ,hierarquia
                      ,decode( hierarquia , null , '<b>'||LPAD('* ', 3 * (level - 1)) || TO_CHAR(descricao) ||'</b>'
                                                 , DECODE(LEVEL , 2 , '<i>'||LPAD('* ', 3 * (level - 1)) || TO_CHAR(descricao)||'</i>'
                                                                , 3 , '<i>'||LPAD('-> ', 3 * (level - 1)) || TO_CHAR(descricao)||'</i>') ) nivel_hierarquico
                      , nvl( ( select 'Já possui acesso!'
                               from roman.acessos b 
                                where b.idaplicacao = a.idaplicacao 
                                  and b.usuario = :P11_USUARIOS),'<font color="red">Não possui acesso!</font>') possuiacesso
                              , a.pagina
                  from ( select a.idaplicacao
                              , a.descricao
                              , a.hierarquia
                              , a.pagina
                         from roman.aplicacoes a 
                         where a.idsistema = 20010
                         union
                         select a.idaplicacao
                              , a.descricao
                              , a.hierarquia
                              , a.pagina
                         from roman.aplicacoes a 
                         where a.idsistema = 20010
                           and a.hierarquia is null
                         ORDER BY IDAPLICACAO) a
                 start with hierarquia is null
                connect by prior idaplicacao = hierarquia
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_USUARIOS
        }
        reportLayout {
            numberOfRows: 800
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: showAll
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Usuário com acesso total.
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 7
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: &nbsp;
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
        )

        column DESCRICAO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
            security {
                escapeSpecialChars: false
            }
        )

        column HIERARQUIA (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 4
            }
        )

        column IDAPLICACAO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingTrigger
            }
            sorting {
                sortable: false
            }
        )

        column NIVEL_HIERARQUICO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Aplicação
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column PAGINA (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Pagina
                alignment: center
            }
            layout {
                sequence: 7
            }
        )

        column POSSUIACESSO (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Possui Acesso
                alignment: center
            }
            layout {
                sequence: 6
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region controle (
        name: Controle
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
    )

    pageItem P11_USUARIOS (
        type: selectList
        label {
            label: Usuários
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(usuario) display_value
                     , usuario return_value 
                  from roman.usuariossistemas u 
                 where idsistema = 20010
                   and ativo = 'S'
                order by usuario;
                ```
        }
        layout {
            sequence: 10
            region: @controle
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button editaracessos (
        buttonName: EDITARACESSOS
        label: Editar Acessos
        layout {
            sequence: 20
            region: @controle
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-pencil
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 12
                items: {
                    P12_USUARIOS: &P11_USUARIOS.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_USUARIOS
        }
    )

    button liberaracesso (
        buttonName: LIBERARACESSO
        label: Liberar Acesso
        layout {
            sequence: 30
            region: @controle
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-pencil
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process liberaracesso (
        name: liberaracesso
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  vpedido number;
                begin
                  FOR i IN 1.. HTMLDB_APPLICATION.G_F01.COUNT 
                  loop
                    insert into roman.acessos (idacesso, usuario, idaplicacao, ativo)
                    values (roman.seq_idacessos.nextval, :P11_USUARIOS, HTMLDB_APPLICATION.G_F02(HTMLDB_APPLICATION.G_F01(i)), 'S');
                  END LOOP;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 1403279594971900533
        }
    )

    branch (
        name: Go To Page 11
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 11
            }
            saveStateBeforeBranching: true
        }
    )

)

