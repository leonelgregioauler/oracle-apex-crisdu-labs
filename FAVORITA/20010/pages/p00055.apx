page 55 (
    name: Atendimento de Estoques
    title: Atendimento de Estoques
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region atendimentos-de-estoque (
        name: Atendimentos de Estoque
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomefilialfavorita(idfilialfavoritaorigem    ) origem
                     , favorita.pck_util_fav.fnc_nomefilialfavorita(idfilialfavoritadestino    ) destino
                --     , a.*
                from favorita.atendimentosestoques a
                order by 1,2
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 200
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: showAll
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
        }
        breakFormatting {
            breakColumns: col1
        }
        componentAdvanced {
            stripHtml: true
        }
        download {
            csvExportEnabled: true
        }

        column DESTINO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Destino
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

        column ORIGEM (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Origem
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

    )

)

