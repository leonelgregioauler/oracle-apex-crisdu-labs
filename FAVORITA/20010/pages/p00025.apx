    process análise-de-compras (
        name: Análise de Compras
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vsql                varchar2(32767);
                  vidpais             number               := :P25_IDPAIS;
                  vconsultarestoque   varchar2(1)          := :P25_CONSULTARESTOQUE;
                  vtipofilial         varchar2(1)          := :P25_TIPOFILIAL;
                  vdetalharfilialfav  varchar2(1)          := :P25_DETALHARFILIALFAVORITA;
                  vidfilialfavorita   number               := :P25_IDFILIALFAVORITA;
                  vidfilialromance    number               := :P25_IDFILIALROMANCE;
                  vtipodata           varchar2(1)          := :P25_TIPODATA;
                  vdatainicompra      date                 := :P25_DATAINICIOCOMPRA;
                  vdatafimcompra      date                 := :P25_DATAFIMCOMPRA;
                  vdatainivenda       date                 := to_date(:P25_DATAINICIOVENDA, 'dd/mm/rrrr');
                  vdatafimvenda       date                 := to_date(:P25_DATAFIMVENDA,    'dd/mm/rrrr');
                  vciclo              number               := :P25_CICLO;
                  vdetalharproduto    varchar2(1)          := :P25_DETALHARPRODUTO;
                  vidfornecedor       number               := :P25_IDFORNECEDOR;
                  vidproduto          number;
                  vidprodutodetalhado number               := :P25_IDPRODUTODETALHADO;
                  vidcompratransf     number               := :P25_IDCOMPRATRANSFERENCIA;
                  --
                begin
                  --
                  vsql:= pck_bi_fav.fnc_analisecompras_bi ( pidpais                     => vidpais,
                                                            pconsultarestoque           => vconsultarestoque,
                                                            ptipofilial                 => vtipofilial,      
                                                            pdetalharfilialfavorita     => vdetalharfilialfav,
                                                            pidfilialfavorita           => vidfilialfavorita,
                                                            pidfilialromance            => vidfilialromance,
                                                            ptipodata                   => vtipodata,
                                                            pdatainicialcompra          => vdatainicompra,
                                                            pdatafinalcompra            => vdatafimcompra,
                                                            pdatainicialvenda           => vdatainivenda,
                                                            pdatafinalvenda             => vdatafimvenda,
                                                            pdetalharproduto            => vdetalharproduto,
                                                            pidfornecedor               => vidfornecedor,
                                                            pidproduto                  => vidproduto,
                                                            pidprodutodetalhado         => vidprodutodetalhado,
                                                            pidcompratransferencia      => vidcompratransf );
                  --
                  execute immediate 'create or replace view vw_analisecompras_fav as '||vsql;
                  --    
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1500410445862823675
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P25_PARAMETRO = 1;
        }
    )

    branch (
        name: GoTo Page 25
        execution {
            sequence: 30
        }
        behavior {
            target: {
                page: 25
                items: {
                    P25_PARAMETRO: 1
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'GERARDADOS'
        }
    )

    branch (
        name: GoTo Page 25
        execution {
            sequence: 30
        }
        behavior {
            target: {
                page: 25
                items: {
                    P25_PARAMETRO: 0
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'FILTRAR'
        }
    )

)

