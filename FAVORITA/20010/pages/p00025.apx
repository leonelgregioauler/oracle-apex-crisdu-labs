page 25 (
    name: Análise de Compras
    title: Análise de Compras
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    htmlHeader {
        htmlHeader:
            ```html
            <style>
                
                .active .alerta {
            	      animation: pisca_in 1000ms ease-out 0s infinite normal forwards;
                }
            
                @keyframes pisca_in{
            	      0%{ color: transparent;}
            	      10%{ color: red;}
            	      80%{ color: red;}
            	      100%{ color: transparent;}
                }
                
                .totalvenda {
                    font-weight: bold;
                    font-style: italic;
                }
                
                .preto {
                    font-weight: bold;
                    font-style: italic;
                }
                
                .azul {
                    font-weight: bold;
                    font-style: italic;
                    color: blue;
                }
                
                .verde {
                    color: green;
                    font-weight: bold;
                }
                
                .laranja {
                    color: orange;
                    font-weight: bold;
                }
                
                .vermelho {
                    color: red;
                    font-weight: bold;
                }
                
                .alerta {
                    color: red;
                    font-weight: bold;
                }
                
                .a-GV-breakValue {
                    color: black;
                    font-weight: bold;
                }
                
                
            </style>
            
            <script 
              src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js">
            </script>
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region análise-de-compras (
        name: Análise de Compras
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nvl(idfilialfavoritadestino, 99) idfilialfavoritadestino
                     , case grouping_id (idprodutodetalhado, nvl(idfilialfavoritadestino, 99))
                         when 0 then max(filialfavorita)
                         when 1 then '<div class="azul">Sub Total:</div>' 
                         when 3 then '<div class="preto">Total:</div>'
                       end filialfavorita
                     , grouping_id(idprodutodetalhado, nvl(idfilialfavoritadestino, 99))  ordem
                     , idprodutodetalhado
                     , case grouping_id (idprodutodetalhado, nvl(idfilialfavoritadestino, 99))
                         when 0 then
                           ( select pck_util_fav.fnc_nomeprodutodetalhado(idprodutodetalhado, 1)
                             from produtosdetalhados pd
                             where pd.idprodutodetalhado = v.idprodutodetalhado
                             and rownum = 1 )
                       end nomeprodutodetalhado
                     , case 
                         when grouping_id (idprodutodetalhado, nvl(idfilialfavoritadestino, 99)) in (1, 3) then 
                           --'<div class="preto">'||
                             null -- to_char(sum(nvl(quantidadeestoque, 0) ) )||
                           --'</div>'
                         when :P25_DETALHARFILIALFAVORITA = 'S' and :P25_DETALHARPRODUTO = 'S' then
                           to_char(max(nvl(quantidadeestoque, 0) ) )
                         else 
                           null
                       end quantidadeestoque
                     , case 
                         when grouping_id (idprodutodetalhado, nvl(idfilialfavoritadestino, 99)) in (1, 3) then 
                           '<div class="preto">'||
                             to_char(sum(nvl(estoqueminimo, 0) ) )||
                           '</div>'
                         when :P25_DETALHARFILIALFAVORITA = 'S' and :P25_DETALHARPRODUTO = 'S' then
                           to_char(sum(nvl(estoqueminimo, 0) ) )
                         else 
                           null
                       end estoqueminimo
                     , case 
                         when grouping_id (idprodutodetalhado, nvl(idfilialfavoritadestino, 99)) in (1, 3) then 
                           '<div class="preto">'||
                             to_char(sum(nvl(estoquemaximo, 0) ) )||
                           '</div>'
                         when :P25_DETALHARFILIALFAVORITA = 'S' and :P25_DETALHARPRODUTO = 'S' then
                           to_char(sum(nvl(estoquemaximo, 0) ) )
                         else 
                           null
                       end estoquemaximo
                     , case 
                         when grouping_id (idprodutodetalhado, nvl(idfilialfavoritadestino, 99)) in (1, 3) then 
                           '<div class="preto">'||
                             to_char(sum(nvl(quantidadecomprada, 0) ) )||
                           '</div>'
                         when :P25_DETALHARFILIALFAVORITA = 'S' and :P25_DETALHARPRODUTO = 'S' then
                           to_char(sum(nvl(quantidadecomprada, 0) ) )
                         else
                           null
                         end quantidadecomprada
                     , case 
                         when grouping_id (idprodutodetalhado, nvl(idfilialfavoritadestino, 99)) in (1, 3) then 
                           '<div class="preto">'||
                             to_char(sum(nvl(quantidadecompradaaguardando, 0) ) )||
                           '</div>'
                         when :P25_DETALHARFILIALFAVORITA = 'S' and :P25_DETALHARPRODUTO = 'S' then
                           to_char(sum(nvl(quantidadecompradaaguardando, 0) ) )
                         else 
                           null
                         end quantidadecompradaaguardando
                     , case 
                         when grouping_id (idprodutodetalhado, nvl(idfilialfavoritadestino, 99)) in (1, 3) then 
                           '<div class="preto">'||
                             to_char(sum(nvl(quantidadeitenscomprados, 0) ) )||
                           '</div>'
                         when :P25_DETALHARFILIALFAVORITA = 'S' and :P25_DETALHARPRODUTO = 'S' then
                           to_char(sum(nvl(quantidadeitenscomprados, 0) ) )
                         else 
                           null
                         end quantidadeitenscomprados
                     , case 
                         when grouping_id (idprodutodetalhado, nvl(idfilialfavoritadestino, 99)) in (1) then 
                           '<div class="preto">'||
                             to_char(sum(nvl(quantidadecomprasrealizadas, 0) ) )||
                           '</div>'
                         when :P25_DETALHARFILIALFAVORITA = 'S' and :P25_DETALHARPRODUTO = 'S' and grouping_id (idprodutodetalhado, nvl(idfilialfavoritadestino, 99)) in (0) then
                           to_char(sum(nvl(quantidadecomprasrealizadas, 0) ) )
                         else 
                           null
                         end quantidadecomprasrealizadas
                     , case 
                         when grouping_id (idprodutodetalhado, nvl(idfilialfavoritadestino, 99)) in (1, 3) then 
                           '<div class="preto">'||
                             to_char(sum(nvl(valortotalcompra, 0) ) )||
                           '</div>'
                         when :P25_DETALHARFILIALFAVORITA = 'S' and :P25_DETALHARPRODUTO = 'S' then
                           to_char(sum(nvl(valortotalcompra, 0) ) )
                         else
                           null
                         end valortotalcompra
                     , case 
                         when grouping_id (idprodutodetalhado, nvl(idfilialfavoritadestino, 99)) in (1, 3) then 
                           '<div class="preto">'||
                             sum(nvl(qtdvendaprimeirociclo ,0) )||
                           '</div>'
                         else 
                           to_char(sum(nvl(qtdvendaprimeirociclo ,0) ) )
                         end totalvendaprimeirociclo
                     , case
                         when grouping_id (idprodutodetalhado, nvl(idfilialfavoritadestino, 99)) in (1, 3) then
                           '<div class="preto">'||
                             sum(nvl(qtdvendasegundociclo ,0) )||
                           '</div>'
                         else 
                           to_char(sum(nvl(qtdvendasegundociclo ,0) ) )
                         end totalvendasegundociclo
                     , case
                         when grouping_id (idprodutodetalhado, nvl(idfilialfavoritadestino, 99)) in (1, 3) then
                           '<div class="preto">'||
                             sum(nvl(qtdvendaterceirociclo ,0) )||
                           '</div>'
                         else 
                           to_char(sum(nvl(qtdvendaterceirociclo ,0) ) )
                         end totalvendaterceirociclo
                     , case
                         when grouping_id (idprodutodetalhado, nvl(idfilialfavoritadestino, 99)) in (1, 3) then
                           '<div class="preto">'||
                             sum(nvl(qtdvendaquartociclo ,0) )||
                           '</div>'
                         else 
                           to_char(sum(nvl(qtdvendaquartociclo ,0) ) )
                         end totalvendaquartociclo
                     , case 
                         when grouping_id (idprodutodetalhado, nvl(idfilialfavoritadestino, 99)) in (1, 3) then 
                           '<div class="preto">'||
                             sum(nvl(qtdperdaprimeirociclo ,0) )||
                           '</div>'
                         else 
                           to_char(sum(nvl(qtdperdaprimeirociclo ,0) ) )
                         end totalperdaprimeirociclo
                     , case
                         when grouping_id (idprodutodetalhado, nvl(idfilialfavoritadestino, 99)) in (1, 3) then
                           '<div class="preto">'||
                             sum(nvl(qtdperdasegundociclo ,0) )||
                           '</div>'
                         else 
                           to_char(sum(nvl(qtdperdasegundociclo ,0) ) )
                         end totalperdasegundociclo
                     , case
                         when grouping_id (idprodutodetalhado, nvl(idfilialfavoritadestino, 99)) in (1, 3) then
                           '<div class="preto">'||
                             sum(nvl(qtdperdaterceirociclo ,0) )||
                           '</div>'
                         else 
                           to_char(sum(nvl(qtdperdaterceirociclo ,0) ) )
                         end totalperdaterceirociclo
                     , case
                         when grouping_id (idprodutodetalhado, nvl(idfilialfavoritadestino, 99)) in (1, 3) then
                           '<div class="preto">'||
                             sum(nvl(qtdperdaquartociclo ,0) )||
                           '</div>'
                         else 
                           to_char(sum(nvl(qtdperdaquartociclo ,0) ) )
                         end totalperdaquartociclo
                     , to_char('<div class="preto">'||
                          sum(qtdvendatotal) ) vendatotal
                     , to_char('<div class="preto">'||
                          sum(qtdperdatotal) ) perdatotal
                     , to_char('<div class="preto">'||
                          sum(nvl(qtdmediavenda, 0) ) ) mediavendas
                     , to_char('<div class="preto">'||
                          sum(nvl(qtdmediaperda, 0) ) ) mediaperdas
                    , to_char('<div class="preto">'||
                          ( sum(nvl(qtdvendaprimeirociclo, 0) + nvl(qtdvendasegundociclo, 0) + nvl(qtdvendaterceirociclo, 0) + nvl(qtdvendaquartociclo, 0)) +
                            sum(nvl(qtdperdaprimeirociclo, 0) + nvl(qtdperdasegundociclo, 0) + nvl(qtdperdaterceirociclo, 0) + nvl(qtdperdaquartociclo, 0)) ) ) vendapotencial
                from vw_analisecompras_fav v
                group by rollup (idprodutodetalhado, nvl(idfilialfavoritadestino, 99) )
                ```
        }
        layout {
