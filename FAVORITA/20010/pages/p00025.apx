    pageItem P25_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Filial Favorita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) as d,
                       idfilialfavorita as r
                  from filiaisfavorita
                  where ((:P25_TIPOFILIAL = 'F' and tipofilial not in ('L') )
                      or (:P25_TIPOFILIAL = 'T')
                      or (:P25_TIPOFILIAL = 'L' and tipofilial in ('L') ))
                     and idpais = :P25_IDPAIS
                 order by 1
                ```
            nullDisplayValue: - Todas Filiais -
        }
        cascadingLov {
            parentItems: [
                P25_IDPAIS
                P25_TIPOFILIAL
            ]
            itemsToSubmit: [
                P25_IDPAIS
                P25_TIPOFILIAL
            ]
        }
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P25_IDFILIALROMANCE (
        type: selectList
        label {
            label: Distrib. Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct 
                       pck_util_fav.fnc_nomefilialromance(afr.idfilialdestino) as d,
                       afr.idfilialdestino as r
                  from atendimentosfiliaisrmc afr
                     , filiaisfavorita f
                 where afr.idfilialfavoritaorigem = f.idfilialfavorita
                  and f.idfilialfavorita = nvl(:P25_IDFILIALFAVORITA, f.idfilialfavorita) 
                 order by 1
                ```
            nullDisplayValue: - Todas Filiais -
        }
        cascadingLov {
            parentItems: P25_IDFILIALFAVORITA
        }
        layout {
            sequence: 100
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

