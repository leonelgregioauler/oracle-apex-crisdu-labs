    region análise-de-vendas (
        name: Análise de Vendas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nvl(idfilialfavoritadestino, 99) idfilialfavoritadestino
                     , case grouping_id (nvl(idfilialfavoritadestino, 99), idprodutodetalhado)
                         when 0 then max(filialfavorita)
                         when 1 then '<div class="azul">Sub Total:</div>' 
                         when 3 then '<div class="preto">Total:</div>'
                       end filialfavorita
                     , grouping_id(nvl(idfilialfavoritadestino, 99), idprodutodetalhado)  ordem
                     , idprodutodetalhado
                     , ( select pck_util_fav.fnc_nomeprodutodetalhado(idprodutodetalhado, 1)
                         from produtosdetalhados pd
                         where pd.idprodutodetalhado = v.idprodutodetalhado
                         and rownum = 1 ) nomeprodutodetalhado
                     , case 
                         when grouping_id (nvl(idfilialfavoritadestino, 99), idprodutodetalhado) in (1, 3) then 
                           '<div class="preto">'||
                             to_char(sum(nvl(quantidadeestoque, 0) ) )||
                           '</div>'
                         when :P25_DETALHARFILIALFAVORITA = 'S' and :P25_DETALHARPRODUTO = 'S' then
                           to_char(max(nvl(quantidadeestoque, 0) ) )
                         else 
                           null
                       end quantidadeestoque
                     , case 
                         when grouping_id (nvl(idfilialfavoritadestino, 99), idprodutodetalhado) in (1, 3) then 
                           '<div class="preto">'||
                             to_char(sum(nvl(quantidadecomprada, 0) ) )||
                           '</div>'
                         when :P25_DETALHARFILIALFAVORITA = 'S' and :P25_DETALHARPRODUTO = 'S' then
                           to_char(max(nvl(quantidadecomprada, 0) ) )
                         else
                           null
                         end quantidadecomprada
                     , case 
                         when grouping_id (nvl(idfilialfavoritadestino, 99), idprodutodetalhado) in (1, 3) then 
                           '<div class="preto">'||
                             to_char(sum(nvl(quantidadecompradaaguardando, 0) ) )||
                           '</div>'
                         when :P25_DETALHARFILIALFAVORITA = 'S' and :P25_DETALHARPRODUTO = 'S' then
                           to_char(max(nvl(quantidadecompradaaguardando, 0) ) )
                         else 
                           null
                         end quantidadecompradaaguardando
                     , case 
                         when grouping_id (nvl(idfilialfavoritadestino, 99), idprodutodetalhado) in (1, 3) then 
                           '<div class="preto">'||
                             to_char(sum(nvl(quantidadeitenscomprados, 0) ) )||
                           '</div>'
                         when :P25_DETALHARFILIALFAVORITA = 'S' and :P25_DETALHARPRODUTO = 'S' then
                           to_char(max(nvl(quantidadeitenscomprados, 0) ) )
                         else 
                           null
                         end quantidadeitenscomprados
                     , case 
                         when grouping_id (nvl(idfilialfavoritadestino, 99), idprodutodetalhado) in (1, 3) then 
                           '<div class="preto">'||
                             to_char(sum(nvl(quantidadecomprasrealizadas, 0) ) )||
                           '</div>'
                         when :P25_DETALHARFILIALFAVORITA = 'S' and :P25_DETALHARPRODUTO = 'S' then
                           to_char(sum(nvl(quantidadecomprasrealizadas, 0) ) )
                         else 
                           null
                         end quantidadecomprasrealizadas
                     , case 
                         when grouping_id (nvl(idfilialfavoritadestino, 99), idprodutodetalhado) in (1, 3) then 
                           '<div class="preto">'||
                             to_char(sum(nvl(valortotalcompra, 0) ) )||
                           '</div>'
                         when :P25_DETALHARFILIALFAVORITA = 'S' and :P25_DETALHARPRODUTO = 'S' then
                           to_char(max(nvl(valortotalcompra, 0) ) )
                         else
                           null
                         end valortotalcompra
                     , case 
                         when grouping_id (nvl(idfilialfavoritadestino, 99), idprodutodetalhado) in (1, 3) then 
                           '<div class="preto">'||
                             sum(nvl(quantidadeitensvendidos ,0) )||
                           '</div>'
                         else 
                           to_char(sum(nvl(quantidadeitensvendidos ,0) ) )
                       end totalvendafiliais
                     , case
                         when grouping_id (nvl(idfilialfavoritadestino, 99), idprodutodetalhado) in (1, 3) then
                           '<div class="preto">'||
                             sum(nvl(quantidadeitensindisponiveis ,0) )||
                           '</div>'
                         else 
                           to_char(sum(nvl(quantidadeitensindisponiveis ,0) ) )
                         end totalperdafiliais
                     , sum(nvl(quantidadeitensvendidos, 0) ) + sum(nvl(quantidadeitensindisponiveis, 0) ) vendapotencial
                     , case 
                         when to_number(to_date(:P25_DATAFIM, 'DD/MM/RRRR') - to_date(:P25_DATAINICIO, 'DD/MM/RRRR') ) = 0 then
                             round( (sum(nvl(quantidadeitensvendidos, 0) ) + sum(nvl(quantidadeitensindisponiveis, 0) ) ) / 1, 2)       
                         else                    
                             round( (sum(nvl(quantidadeitensvendidos, 0) ) + sum(nvl(quantidadeitensindisponiveis, 0) ) ) / to_number( to_date(:P25_DATAFIM, 'DD/MM/RRRR') - to_date(:P25_DATAINICIO, 'DD/MM/RRRR')+1 ), 2)
                         end vendadiaria
                     , case 
                         when to_number( to_date(:P25_DATAFIM, 'DD/MM/RRRR') - to_date(:P25_DATAINICIO, 'DD/MM/RRRR') ) = 0 then
                           ( round( (sum(nvl(quantidadeitensvendidos, 0) ) + sum(nvl(quantidadeitensindisponiveis, 0) ) ) / 1, 2) ) * 181
                         else 
                           ( round( (sum(nvl(quantidadeitensvendidos, 0)) + sum(nvl(quantidadeitensindisponiveis, 0) ) ) / to_number( to_date(:P25_DATAFIM, 'DD/MM/RRRR') - to_date(:P25_DATAINICIO, 'DD/MM/RRRR')+1 ), 2) ) * 181 
                         end projecaoprimeirosemestre
                     , case
                         when to_number( to_date(:P25_DATAFIM, 'DD/MM/RRRR') - to_date(:P25_DATAINICIO, 'DD/MM/RRRR') ) = 0 then
                           ( round( (sum(nvl(quantidadeitensvendidos, 0) ) + sum(nvl(quantidadeitensindisponiveis, 0) ) ) / 1, 2) ) * 140
                         else
                           ( round( (sum(nvl(quantidadeitensvendidos, 0) ) + sum(nvl(quantidadeitensindisponiveis, 0) ) ) / to_number( to_date(:P25_DATAFIM, 'DD/MM/RRRR') - to_date(:P25_DATAINICIO, 'DD/MM/RRRR')+1 ), 2) ) * 140 
                         end projecao140dias
                     , case
                         when to_number( to_date(:P25_DATAFIM, 'DD/MM/RRRR') - to_date(:P25_DATAINICIO, 'DD/MM/RRRR') ) = 0 then
                           ( round( (sum(nvl(quantidadeitensvendidos, 0) ) + sum(nvl(quantidadeitensindisponiveis, 0) ) ) / 1, 2) ) * 30 
                         else
                           ( round( (sum(nvl(quantidadeitensvendidos, 0) ) + sum(nvl(quantidadeitensindisponiveis, 0) ) ) / to_number( to_date(:P25_DATAFIM, 'DD/MM/RRRR') - to_date(:P25_DATAINICIO, 'DD/MM/RRRR')+1 ), 2) ) * 30 
                         end programacaomensal
                from vw_analisevendas_fav v
                group by rollup (nvl(idfilialfavoritadestino, 99), idprodutodetalhado )
                ```
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent9
                t-Region--scrollBody
            ]
            cssClasses: container
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P25_PARAMETRO = 0 and 1 = 2;
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 2983526759744300605
        }

