page 9 (
    name: Mapa de Calor
    title: Mapa de Calor
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region heatmap-quantidade (
        name: HeatMap - Quantidade
        type: plugin/geoheatmap
        source {
            sqlQuery:
                ```sql
                select x.latitude   
                     , x.longitude
                     , count(idpedido) qtd
                from catal.cidades x
                   , favorita.pedidos p
                   , vendedoras v
                   , pessoas pe
                where p.idvendedora  = v.idvendedora
                  and v.idpessoa     = pe.idpessoa
                  and pe.idcidade = x.idcidade
                  and p.dataemissao between nvl(to_date(:P9_DE,'DD/MM/RRRR'), sysdate-30 ) and NVL(to_date(:P9_ATE,'DD/MM/RRRR'),sysdate)
                  and x.latitude is not null
                group by x.latitude   
                     , x.longitude
                order by 3 desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            mapHeight: 1000
        }
        reportLayout {
            numberOfRows: 5000
        }
    )

    region heatmap-valores (
        name: HeatMap - Valores
        type: plugin/geoheatmap
        source {
            sqlQuery:
                ```sql
                select x.latitude   
                     , x.longitude
                     , round(sum(valortotal)) qtd
                from catal.cidades x
                   , favorita.pedidos p
                   , vendedoras v
                   , pessoas pe
                where p.idvendedora  = v.idvendedora
                  and v.idpessoa     = pe.idpessoa
                  and pe.idcidade = x.idcidade
                  and p.dataemissao between nvl(to_date(:P9_DE,'DD/MM/RRRR'), sysdate-30 ) and NVL(to_date(:P9_ATE,'DD/MM/RRRR'),sysdate)
                  and x.latitude is not null
                  and valortotal is not null
                group by x.latitude   
                     , x.longitude
                order by 3 desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            mapHeight: 1000
            opacity: 1
        }
        reportLayout {
            numberOfRows: 5000
        }
    )

    pageItem P9_ATE (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: expression
            plsqlExpression: SYSDATE
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P9_DE (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        settings {
            show: both
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: expression
            plsqlExpression: SYSDATE-30
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: Filtrar
        label: Filtrar
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 9
                items: {
                    P9_DE: &P9_DE.
                    P9_ATE: &P9_ATE.
                }
                action: resetPagination
            }
        }
    )

)

