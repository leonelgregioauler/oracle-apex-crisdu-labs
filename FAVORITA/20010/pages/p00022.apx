    process criar-view (
        name: Criar View
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vsql                CLOB;
                  vidpais             number               := :P22_IDPAIS;
                  videstoque          number               := :P22_ESTOQUE;
                  vtipofilial         varchar2(1)          := :P22_TIPOFILIAL;
                  vdetalharfilialfav  varchar2(1)          := :P22_DETALHARFILIALFAVORITA;
                  vdetalharfilialrmc  varchar2(1)          := :P22_DETALHARFILIALROMANCE;
                  vidfilialfavorita   number               := :P22_IDFILIALFAVORITA;
                  vidfilialromance    number               := :P22_IDFILIALROMANCE;
                  vtipodata           varchar2(1)          := :P22_TIPODATA;
                  vdataini            date                 := :P22_DATAINICIO;
                  vdatafim            date                 := :P22_DATAFIM;
                  videdicao           number               := :P22_IDEDICAOREVISTA;
                  vdetalharproduto    varchar2(1)          := :P22_DETALHARPRODUTO;
                  vidfornecedor       number               := :P22_IDFORNECEDOR;
                  vidproduto          number               := :P22_IDPRODUTO;
                  vidprodutodetalhado number               := :P22_IDPRODUTODETALHADO;
                  vcampototalvenda    varchar2(20)         := :P22_TOTAISVENDA;
                  vcampototalperda    varchar2(20)         := :P22_TOTAISPERDA;
                  --
                begin
                  --
                  vsql:= pck_bi_fav.fnc_vendaperdamensal_bi ( pidpais                     => vidpais,
                                                              pidestoque                  => videstoque,
                                                              ptipofilial                 => vtipofilial,      
                                                              pdetalharfilialfavorita     => vdetalharfilialfav,
                                                              pdetalharfilialromance      => vdetalharfilialrmc,
                                                              pidfilialfavorita           => vidfilialfavorita,
                                                              pidfilialromance            => vidfilialromance,
                                                              ptipodata                   => vtipodata,
                                                              pdatainicial                => vdataini,
                                                              pdatafinal                  => vdatafim,
                                                              pidedicaorevista            => videdicao,
                                                              pdetalharproduto            => vdetalharproduto,
                                                              pidfornecedor               => vidfornecedor,
                                                              pidproduto                  => vidproduto,
                                                              pidprodutodetalhado         => vidprodutodetalhado,
                                                              pcampototalvenda            => vcampototalvenda,
                                                              pcampototalperda            => vcampototalperda);
                  --
                  execute immediate 'create or replace view vw_vendaperdamensal_fav as '||vsql;
                  --    
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1483012519917570204
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'GERARDADOS'
        }
    )

