page 22 (
    name: Vendas x Perdas Mensal
    title: Vendas x Perdas Mensal
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    htmlHeader {
        htmlHeader:
            ```html
            <style>
                
                .alerta {
            	      animation: pisca_in 1000ms ease-out 0s infinite normal forwards;
                  color: red;
                  font-weight: bold;
                }
            
                @keyframes pisca_in{
            	      0%{ color: transparent;}
            	      10%{ color: red;}
            	      80%{ color: red;}
            	      100%{ color: transparent;}
                }
                
                .totalvenda {
                    font-weight: bold;
                    font-style: italic;
                }
                
                .preto {
                    font-weight: bold;
                    font-style: italic;
                }
                
                .azul {
                    font-weight: bold;
                    font-style: italic;
                    color: blue;
                }
                
                .verde {
                    color: green;
                    font-weight: bold;
                }
                
                .laranja {
                    color: orange;
                    font-weight: bold;
                }
                
                .vermelho {
                    color: red;
                    font-weight: bold;
                }
               
                
                
            </style>
            
            <script 
              src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js">
            </script>
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: </>Filtros
        type: staticContent
        layout {
            sequence: 40
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region vendas-x-perda-mensal (
        name: Vendas x Perda Mensal 2017 / 2018 / 2019
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select  idfilial
                      , filial
                      , idproduto
                      , pck_util_fav.fnc_nomeproduto(idproduto, 1, 'S') nomeproduto
                      , janeiro2017_venda
                	  , janeiro2017_perda
                      , fevereiro2017_venda
                	  , fevereiro2017_perda
                      , março2017_venda
                	  , março2017_perda
                      , abril2017_venda
                	  , abril2017_perda
                      , maio2017_venda
                	  , maio2017_perda
                      , junho2017_venda
                	  , junho2017_perda
                      , julho2017_venda
                	  , julho2017_perda
                      , agosto2017_venda
                	  , agosto2017_perda
                      , setembro2017_venda
                	  , setembro2017_perda
                      , outubro2017_venda
                	  , outubro2017_perda
                      , novembro2017_venda
                	  , novembro2017_perda
                      , dezembro2017_venda
                	  , dezembro2017_perda
                      , janeiro2018_venda
                	  , janeiro2018_perda
                      , fevereiro2018_venda
                	  , fevereiro2018_perda
                      , março2018_venda
                	  , março2018_perda
                      , abril2018_venda
                	  , abril2018_perda
                      , maio2018_venda
                	  , maio2018_perda
                      , junho2018_venda
                	  , junho2018_perda
                      , julho2018_venda
                      , julho2018_perda
                      , agosto2018_venda
                      , agosto2018_perda
                      , setembro2018_venda
                      , setembro2018_perda
                      , outubro2018_venda
                	  , outubro2018_perda
                      , novembro2018_venda
                	  , novembro2018_perda
                      , dezembro2018_venda
                	  , dezembro2018_perda      
                      , janeiro2019_venda
                	  , janeiro2019_perda
                      , fevereiro2019_venda
                	  , fevereiro2019_perda
                      , março2019_venda
                	  , março2019_perda
                      , abril2019_venda
                	  , abril2019_perda
                      , maio2019_venda
                	  , maio2019_perda
                      , junho2019_venda
                	  , junho2019_perda
                      , julho2019_venda
                      , julho2019_perda
                      , agosto2019_venda
                      , agosto2019_perda
                      , setembro2019_venda
                      , setembro2019_perda
                      , outubro2019_venda
                	  , outubro2019_perda
                      , novembro2019_venda
                	  , novembro2019_perda
                      , dezembro2019_venda
                	  , dezembro2019_perda
                from vw_vendaperdamensal_fav v;
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent8
                t-Region--scrollBody
            ]
            cssClasses: container
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P22_PARAMETRO = 0
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 1482823066113665402
        }

