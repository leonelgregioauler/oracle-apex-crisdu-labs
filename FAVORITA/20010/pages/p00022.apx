    dynamicAction destacar-valores-conforme (
        name: Destacar Valores Conforme %
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    function init() {
                      $( ".container t-Region-bodyWrap" ).attr("class", "active");
                    }
                    
                    window.onload = function() { 
                      init(); 
                    }
                    
                    $(".valoresvenda").each(function() {
                      $( this ).addClass( "totalvenda" );
                    } );
                    
                    $(".valoresperda").each(function(idx) {
                        
                      var valoresvenda = document.getElementsByClassName( "valoresvenda" )[idx].innerHTML;
                      var valoresperda = document.getElementsByClassName( "valoresperda" )[idx].innerHTML;
                      
                      valoresvenda = valoresvenda.replace(" ", "").replace(",", "").replace(".", "").replace(".", "");
                      valoresperda = valoresperda.replace(" ", "").replace(",", "").replace(".", "").replace(".", "");
                        
                      valoresvenda = valoresvenda / 100;
                      valoresperda = valoresperda / 100;
                        
                      valoresvenda = formatNumber(valoresvenda);
                      valoresperda = formatNumber(valoresperda);
                        
                      valoresvenda = valoresvenda.replace(" ", "").replace(",", "").replace(".", "").replace(".", "");
                      valoresperda = valoresperda.replace(" ", "").replace(",", "").replace(".", "").replace(".", "");
                        
                      valoresvenda = parseFloat(valoresvenda);
                      valoresperda = parseFloat(valoresperda);
                        
                      if (valoresvenda > 0) {
                        var total = ( valoresperda * 100 ) / valoresvenda;
                      } else {
                        var total = 0  
                      }
                        
                      if ( total <= 5 ) {
                        $( this ).addClass( "verde" );
                      } else if ( total > 5 && total <= 10 ) {
                        $( this ).addClass( "laranja" );
                      } else if ( total > 10 && total <= 20 ) {
                        $( this ).addClass( "vermelho" );
                      } else if ( total == 0 ) {
                        $( this ).addClass( "verde" );
                      } else {
                        $( this ).addClass( "alerta" );
                      }
                      
                        
                    });
                        
                    ```
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction destacar-valores-conforme-ao-mudar-paginação (
        name: Destacar Valores Conforme % ao Mudar Paginação
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: region
            region: @vendas-x-perda-mensal
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    function init() {
                      $( ".container t-Region-bodyWrap" ).attr("class", "active");
                    }
                    
                    window.onload = function() { 
                      init(); 
                    }
                    
                    $(".valoresvenda").each(function() {
                      $( this ).addClass( "totalvenda" );
                    } );
                    
                    $(".valoresperda").each(function(idx) {
                        
                      var valoresvenda = document.getElementsByClassName( "valoresvenda" )[idx].innerHTML;
                      var valoresperda = document.getElementsByClassName( "valoresperda" )[idx].innerHTML;
                      
                      valoresvenda = valoresvenda.replace(" ", "").replace(",", "").replace(".", "").replace(".", "");
                      valoresperda = valoresperda.replace(" ", "").replace(",", "").replace(".", "").replace(".", "");
                        
                      valoresvenda = valoresvenda / 100;
                      valoresperda = valoresperda / 100;
                        
                      valoresvenda = formatNumber(valoresvenda);
                      valoresperda = formatNumber(valoresperda);
                        
                      valoresvenda = valoresvenda.replace(" ", "").replace(",", "").replace(".", "").replace(".", "");
                      valoresperda = valoresperda.replace(" ", "").replace(",", "").replace(".", "").replace(".", "");
                        
                      valoresvenda = parseFloat(valoresvenda);
                      valoresperda = parseFloat(valoresperda);
                        
                      if (valoresvenda > 0) {
                        var total = ( valoresperda * 100 ) / valoresvenda;
                      } else {
                        var total = 0  
                      }
                        
                      if ( total <= 5 ) {
                        $( this ).addClass( "verde" );
                      } else if ( total > 5 && total <= 10 ) {
                        $( this ).addClass( "laranja" );
                      } else if ( total > 10 && total <= 20 ) {
                        $( this ).addClass( "vermelho" );
                      } else if ( total == 0 ) {
                        $( this ).addClass( "verde" );
                      } else {
                        $( this ).addClass( "alerta" );
                      }
                      
                        
                    });
                        
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

