    pageItem P22_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Filial Favorita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) as d,
                       idfilialfavorita as r
                  from filiaisfavorita
                  where ((:P22_TIPOFILIAL = 'F' and tipofilial not in ('L') )
                      or (:P22_TIPOFILIAL = 'T')
                      or (:P22_TIPOFILIAL = 'L' and tipofilial in ('L') ))
                     and idpais = :P22_IDPAIS
                 order by 1
                ```
            nullDisplayValue: - Todas Filiais -
        }
        cascadingLov {
            parentItems: [
                P22_IDPAIS
                P22_TIPOFILIAL
            ]
            itemsToSubmit: [
                P22_IDPAIS
                P22_TIPOFILIAL
            ]
        }
        layout {
            sequence: 100
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P22_IDFILIALROMANCE (
        type: selectList
        label {
            label: Distrib. Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct 
                       pck_util_fav.fnc_nomefilialromance(afr.idfilialdestino) as d,
                       afr.idfilialdestino as r
                  from atendimentosfiliaisrmc afr
                     , filiaisfavorita f
                 where afr.idfilialfavoritaorigem = f.idfilialfavorita
                   and ( f.idfilialfavorita = nvl(:P22_ESTOQUE, f.idfilialfavorita) or :P22_ESTOQUE = 0 )
                 order by 1
                ```
            nullDisplayValue: - Todas Filiais -
        }
        cascadingLov {
            parentItems: P22_ESTOQUE
        }
        layout {
            sequence: 110
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

