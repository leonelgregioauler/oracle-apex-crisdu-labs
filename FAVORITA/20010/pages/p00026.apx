                    to: 4
                }
                colors {
                    background: #FFFF99
                    text: #000000
                }
                execution {
                    sequence: 10
                }
            )

        )

    )

    region estoque-manaus (
        name: Estoque Manaus
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.idprodutodetalhado
                     , favorita.pck_util_fav.fnc_nomeprodutodetalhado(e.idprodutodetalhado,1) NomeProduto
                     , e.idfilialfavorita
                     , f.nomefilialfavorita
                     , ( select distinct max(trunc(mm.datamovimento))
                         from movimentosestoques mm
                         where mm.idestoque = e.idestoque) ultimadata
                     , nvl(( select s.idsemana
                             from semana_dias s
                             where s.semana = to_char(sysdate,'IW')
                               and s.ano    = to_char(sysdate,'RRRR')) - ( select s.idsemana
                                                                           from semana_dias s
                                                                           where s.semana = to_char(e.ultimamovimentacao,'IW')
                                                                             and s.ano    = to_char(e.ultimamovimentacao,'RRRR')),0) idsemana 
                     , e.quantidade
                     , pck_estoque_fav.fnc_estoquedisponivel(e.idestoque) disponivel
                from favorita.estoques e
                   , favorita.filiaisfavorita f
                where e.idfilialfavorita = f.idfilialfavorita
                  and f.tipofilial = 'E'
                  and e.idfilialfavorita = 4
                  and nvl(( select s.idsemana
                            from semana_dias s
                            where s.semana = to_char(sysdate,'IW')
                              and s.ano    = to_char(sysdate,'RRRR')) - ( select s.idsemana
                                                                           from semana_dias s
                                                                           where s.semana = to_char(e.ultimamovimentacao,'IW')
                                                                             and s.ano    = to_char(e.ultimamovimentacao,'RRRR')),0) > 2
                  and ((:P26_REVISTATIVA = 0 and e.quantidade > 0 and not exists ( select 1
                                                                                   from favorita.produtosdetedrevistas pdr
                                                                                      , favorita.edicoesrevistas ed
                                                                                   where pdr.idprodutodetalhado = e.idprodutodetalhado
                                                                                     and pdr.idedicaorevista = ed.idedicaorevista
                                                                                     and trunc(ed.datafinal) >= trunc(sysdate)
                                                                                     and ed.tipovenda = 'R')) 
                        or ( :P26_REVISTATIVA = 1 and exists ( select 1
                                                               from favorita.produtosdetedrevistas pdr
                                                                  , favorita.edicoesrevistas ed
                                                               where pdr.idprodutodetalhado = e.idprodutodetalhado
                                                                 and pdr.idedicaorevista = ed.idedicaorevista
                                                                 and trunc(ed.datafinal) >= trunc(sysdate)
                                                                 and trunc(ed.datainicial) <= trunc(sysdate)
                                                                 and ed.tipovenda = 'R'
                                                                 and exists ( select *
                                                                              from favorita.filiaisedicoesrevistas fer
                                                                                 , favorita.atendimentosfiliaisrmc afr
                                                                              where fer.idfilial = afr.idfilialdestino
                                                                                and ed.idedicaorevista = fer.idedicaorevista
                                                                                and afr.idfilialfavoritaorigem = 4))
                             and not exists ( select 1
                                              from favorita.produtosdetalhados pd
                                              where pd.idprodutodetalhado = e.idprodutodetalhado
                                                and nvl(pd.descontinuado,'N') = 'S')))
                  and (:P26_IDCATEGORIASITE is null or exists ( select distinct 1
                                                                from favorita.produtosdetalhados p
                                                                where e.idprodutodetalhado = p.idprodutodetalhado
                                                                  and exists ( select distinct 1
                                                                               from favorita.produtos pp
                                                                               where pp.idproduto = p.idproduto
                                                                                 and exists( select distinct 1 
                                                                                             from favorita.categorias c
                                                                                             where c.idcategoria = pp.idcategoria
                                                                                               and c.idcategoriasite = :P26_IDCATEGORIASITE) ))) 
                  and :P26_IDFILIALFAVORITA = 4
                order by 6 ,7
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent10
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P26_IDFILIALFAVORITA = 4
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        advanced {
            savedReportMappingIdentifier: 1479776463030034406
        }

