        savedReport 14797952 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn IDSEMANA (
                sequence: 2
            )

            displayColumn NOMEPRODUTO (
                sequence: 1
            )

            displayColumn QUANTIDADE (
                sequence: 3
            )

            sort (
                column: IDSEMANA
                sort {
                    direction: desc
                    sequence: 1
                }
            )

            highlight ir-condition (
                name: 4 Semanas
                condition {
                    column: IDSEMANA
                    operator: >
                    value: 4
                }
                colors {
                    background: #FF7755
                    text: #000000
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-2 (
                name: 3 Semanas
                condition {
                    column: IDSEMANA
                    operator: between
                    from: 3
                    to: 4
                }
                colors {
                    background: #FFFF99
                    text: #000000
                }
                execution {
                    sequence: 10
                }
            )

        )

    )

