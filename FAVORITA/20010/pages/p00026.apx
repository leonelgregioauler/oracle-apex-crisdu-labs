                                                                                and ed.idedicaorevista = fer.idedicaorevista
                                                                                and afr.idfilialfavoritaorigem = 2))
                             and not exists ( select 1
                                              from favorita.produtosdetalhados pd
                                              where pd.idprodutodetalhado = e.idprodutodetalhado
                                                and nvl(pd.descontinuado,'N') = 'S')))
                  and (:P26_IDCATEGORIASITE is null or exists ( select distinct 1
