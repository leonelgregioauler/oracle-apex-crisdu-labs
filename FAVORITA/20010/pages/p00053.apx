page 53 (
    name: Compras
    title: Compras
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region compras (
        name: Compras
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ct.numero
                     , ct.notafiscal
                     , ct.nomefornecedor fornecedor
                     , favorita.pck_util_fav.fnc_nomeprodutodetalhado( ict.idprodutodetalhado, 1) produto   
                     , ( select tempoproducao+tempoentrega 
                         from favorita.fornecedorestemposentrega ff       
                         where ff.idfornecedor = ct.idfornecedor 
                           and ff.idfilialfavorita  = ct.idfilialfavoritadestino ) lt_tt
                     , sum(nvl(ict.quantidadecomprada, 0))                      qtd        
                     , ct.dataemissao
                     , ct.dataprevisaoentrega
                     , ct.dataembarque     
                     , nvl(( select oc.transportadora
                             from favorita.vw_orcamentoscomprastransf_fav oc
                             where oc.idcompratransferencia = ct.idcompratransferencia
                               and oc.utilizado             = 'Sim'
                               and rownum                   = 1 ),'Sem Transporte') transportadora
                 from favorita.itenscomprastransferencias ict
                    , favorita.vw_comprastransferencias_fav ct
                 where ict.idcompratransferencia = ct.idcompratransferencia
                   and ct.ididioma               = 1
                   and ct.idtipocomptransrem     in ( 0,1) --compra e transferencia
                   and ct.idsituacao             in (10,20,11,30)
                   and ct.idfilialfavoritadestino = :P53_IDFILIALFAVORITA
                   and ict.idprodutodetalhado     = :P53_IDPRODUTODETALHADO 
                having sum(nvl(ict.quantidadecomprada, 0)) > 0
                group by ct.numero
                     , ct.notafiscal
                     , ict.idprodutodetalhado
                     , ct.idfilialfavoritadestino  
                     , ct.idfornecedor 
                     , ct.nomefornecedor 
                     , ct.dataemissao
                     , ct.dataprevisaoentrega
                     , ct.dataembarque
                     , ct.idcompratransferencia
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhuma compra localizada.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 9141879020900016993
        }

        column DATAEMBARQUE (
            type: plainText
            heading {
                heading: Embarque
                alignment: center
            }
            layout {
                sequence: 45
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: I
            }
        )

        column DATAEMISSAO (
            type: plainText
            heading {
                heading: Emissão
                alignment: center
            }
            layout {
                sequence: 25
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: G
            }
        )

        column DATAPREVISAOENTREGA (
            type: plainText
            heading {
                heading: Previsao Entrega
                alignment: center
            }
            layout {
                sequence: 35
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: H
            }
        )

        column FORNECEDOR (
            type: plainText
            heading {
                heading: Fornecedor
                alignment: center
            }
            layout {
                sequence: 15
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column LT_TT (
            type: plainText
            heading {
                heading: LT + TT
                alignment: end
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column NOTAFISCAL (
            type: plainText
            heading {
                heading: Nota Fiscal
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column NUMERO (
            type: plainText
            heading {
                heading: Nr Compra
                alignment: end
            }
            layout {
                sequence: 1
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column PRODUTO (
            type: plainText
