        savedReport 45312399 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAEMBARQUE (
                sequence: 8
            )

            displayColumn DATAEMISSAO (
                sequence: 7
            )

            displayColumn DATAPREVISAOENTREGA (
                sequence: 9
            )

            displayColumn FORNECEDOR (
                sequence: 1
            )

            displayColumn LT_TT (
                sequence: 5
            )

            displayColumn NOTAFISCAL (
                sequence: 3
            )

            displayColumn NUMERO (
                sequence: 2
            )

            displayColumn PRODUTO (
                sequence: 4
            )

            displayColumn QTD (
                sequence: 6
            )

            displayColumn TRANSPORTADORA (
                sequence: 10
            )

            aggregate (
                column: QTD
            )

            controlBreak (
                column: FORNECEDOR
                layout {
                    sequence: 1
                }
            )

            controlBreak (
                column: PRODUTO
                layout {
                    sequence: 2
                }
            )

        )

    )

    pageItem P53_IDFILIALFAVORITA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @compras
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P53_IDPRODUTODETALHADO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @compras
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

