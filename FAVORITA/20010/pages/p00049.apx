page 49 (
    name: Venda Perdida
    title: Venda Perdida
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region venda-perdida (
        name: Venda Perdida
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial( FP.Idfilialromance ) empresa
                      , pck_util_fav.fnc_nomeprodutodetalhado(fid.idprodutodetalhado,1) produto
                     , sum(fid.quantidade)  QTD
                     from itensindisponiveispedidos fid
                    , pedidos                   fp
                 where fp.idpedido     = fid.idpedido 
                   and fp.datacancelamento is null  
                   and fid.idproduto = :P49_IDPRODUTO
                    and not exists ( select 1 
                                     from classificacoespedidos c
                                     where c.idpedido = fp.idpedido
                                       and c.idcaracteristicapedido = 25 ) 
                group by FP.Idfilialromance, fid.idprodutodetalhado
                ```
            pageItemsToSubmit: P49_IDPRODUTO
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
        }
        breakFormatting {
            breakColumns: col1
        }
        componentAdvanced {
            stripHtml: true
        }

        column EMPRESA (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Empresa
            }
            layout {
                sequence: 1
            }
            sorting {
                defaultSequence: 1
            }
        )

        column PRODUTO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Produto
            }
            layout {
                sequence: 2
            }
        )

        column QTD (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Quantidade
                alignment: center
            }
            layout {
                sequence: 3
            }
            appearance {
                formatMask: 999G999G990
            }
            advanced {
                computeSum: true
            }
        )

    )

    pageItem P49_IDPRODUTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @venda-perdida
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

