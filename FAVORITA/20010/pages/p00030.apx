page 30 (
    name: Resumo dos Atendimentos no Dia
    title: Resumo dos Atendimentos no Dia
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
        browserCache: false
    }
    advanced {
        enableDuplicatePageSubmissions: false
        reloadOnSubmit: always
    }

    region resumo-de-atendimentos-no-dia (
        name: Resumo de Atendimentos no Dia
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select op.nome atendente,
                       beeadmin.retorna_segundos_em_horas(nvl( 
                       (select (nvl(data_saida_efetiva,sysdate) - data_entrada_efetiva) * 86400 
                          from beepeople.controle_frequencia  
                         where cod_pessoa = u.cod_pessoa 
                           and empresa = u.empresa 
                           and data = trunc(to_date(:P30_VALOR,'dd/mm/yyyy hh24:mi:ss')) 
                           and sysdate > data_entrada_efetiva 
                           and tipo_escala = 'N'),0)) "JORNADA NORMAL",
                       beeadmin.retorna_segundos_em_horas(nvl(( 
                        select (nvl(data_saida_efetiva,sysdate) - data_entrada_efetiva) * 86400 
                          from beepeople.controle_frequencia  
                         where cod_pessoa = u.cod_pessoa 
                           and empresa = u.empresa 
                           and data = trunc(to_date(:P30_VALOR,'dd/mm/yyyy hh24:mi:ss')) 
                           and sysdate > data_entrada_efetiva 
                           and tipo_escala = 'E'),0)) "JORNADA EXTRA",
                       (select count(1) || ' - ' || beeadmin.retorna_segundos_em_horas(nvl(sum(nvl(cu.data_termino,sysdate)-cu.data_inicio),0) * 86400) 
                          from beepeople.compromissos_usuarios cu 
                         where cod_usuario = u.codigo 
                           and data_inicio between trunc(to_date(:P30_VALOR,'dd/mm/yyyy hh24:mi:ss')) and trunc(to_date(:P30_VALOR,'dd/mm/yyyy hh24:mi:ss')+1)) pausas,
                       nvl(t.ligacoes_transferidas,0)  ligações,
                       beeadmin.retorna_segundos_em_horas(nvl(t.tempo_atendimentos,0)) "TEMPO DE TELA",
                       beeadmin.retorna_segundos_em_horas ( 
                        case 
                         when nvl(t.atendimentos,0) > 0 then trunc(t.tempo_atendimentos / nvl(t.atendimentos,0)) 
                         else 0 
                        end 
                       ) tma, 
                       nvl(t.abordagens,0) abordagens,
                       nvl(t.vendas,0)  vendas,
                       nvl(t.produtos,0) pedidos,
                       nvl(t.valores,0) valor
                  from ( 
                        select cod_usuario, cod_superior, 
                               sum(nvl(ligacoes_transferidas,0)) ligacoes_transferidas,  
                               sum(nvl(atendimentos,0)) atendimentos, sum(nvl(tempo_atendimentos,0)) tempo_atendimentos,  
                               sum(nvl(abordagens,0)) abordagens, 
                               sum(nvl(target,0)) target, sum(nvl(recusa,0)) recusas,  
                               sum(nvl(tempo_recusa,0)) tempo_recusas,  
                               sum(nvl(vendas_pendentes,0)) vendas, 
                               sum(nvl(produtos_pendentes,0)) produtos, 
                               sum(nvl(valores_pendentes,0)) valores, 
                               sum(nvl(tempo_conversao,0)) tempo_vendas  
                         from ( 
                            /* ligaçÕes */ 
                            select l.cod_usuario, l.cod_superior,  
                                   count(1) ligacoes_transferidas,  nvl(sum(l.tempo_ligacao),0) tempo_ligacoes, 
                                   null atendimentos, null tempo_atendimentos,  
                                   null abordagens, null target, null recusa, null conversao, 
                                   null tempo_abordagem, 
                                   null tempo_recusa, 
                                   null tempo_conversao, 
                                   null vendas_pendentes, 
                                   null produtos_pendentes, 
                                   null valores_pendentes, 
                                   null vendas_retratacao, 
                                   null produtos_retratacao, 
                                   null valores_retratacao, 
                                   null vendas_recusadas, 
                                   null produtos_recusadas, 
                                   null valores_recusadas, 
                                   null vendas_confirmadas, 
                                   null produtos_confirmadas, 
                                   null valores_confirmadas 
                              from beefavorita.log_prospects_fones l, beefavorita.prospects p 
                             where l.cod_campanha = p.cod_campanha 
                               and l.cod_prospect = p.codigo 
                               and l.data_ligacao between trunc(to_date(:P30_VALOR,'dd/mm/yyyy hh24:mi:ss')) and trunc(to_date(:P30_VALOR,'dd/mm/yyyy hh24:mi:ss')+1) 
                               and l.data_ligacao <= nvl(p.data_final_performance,l.data_ligacao) 
                               and l.cod_superior is not null 
                             group by l.cod_usuario, l.cod_superior  
                            union all 
                            /* atendimentos */ 
                            select l.cod_usuario, l.cod_superior,  
                                   null ligacoes_transferidas, null tempo_ligacoes,  
                                   count(1) atendimentos, nvl(sum(l.tempo_tela),0) tempo_atendimentos,  
                                   sum(css.abordado) abordagens, sum(css.target) target, sum(css.recusa) recusa, sum(css.conversao_pre+css.conversao_auditada+css.conversao_recusada) conversao, 
                                   sum(decode(css.abordado,1,l.tempo_tela,null)) tempo_aboragem, 
                                   sum( 
                                    case 
                                     when css.recusa > 0 then l.tempo_tela 
                                     else null 
                                    end 
                                   ) tempo_recusa, 
                                   sum( 
                                    case  
                                     when css.conversao_pre+css.conversao_auditada+css.conversao_recusada > 0 then l.tempo_tela 
                                     else null 
                                    end 
                                   ) tempo_conversao, 
                                   null vendas_pendentes, 
                                   null produtos_pendentes, 
                                   null valores_pendentes, 
                                   null vendas_retratacao, 
                                   null produtos_retratacao, 
                                   null valores_retratacao, 
                                   null vendas_recusadas, 
                                   null produtos_recusadas, 
                                   null valores_recusadas, 
                                   null vendas_confirmadas, 
                                   null produtos_confirmadas, 
                                   null valores_confirmadas 
                              from beefavorita.log_prospects l, beefavorita.prospects p, beedialer.controle_status_sistemas css 
                             where l.cod_campanha = p.cod_campanha 
                               and l.cod_prospect = p.codigo 
                               and l.cod_status = css.codigo 
                               and l.data_resgate between trunc(to_date(:P30_VALOR,'dd/mm/yyyy hh24:mi:ss')) and trunc(to_date(:P30_VALOR,'dd/mm/yyyy hh24:mi:ss')+1)
                               and l.data_resgate <= nvl(p.data_final_performance,l.data_resgate) 
                             group by l.cod_usuario, l.cod_superior  
                            union all 
                            /* vendas */
                            select cod_usuario, 
                                   cod_superior, 
                                   null ligacoes_transferidas, 
                                   null tempo_ligacoes, 
                                   null atendimentos, 
                                   null tempo_atendimentos,  
                                   null abordagens, 
                                   null target, 
                                   null recusa, 
                                   null conversao, 
                                   null tempo_aboragem, 
                                   null tempo_recusa, 
                                   null tempo_conversao, 
                                   sum(vendas) vendas_pendentes, 
                                   sum(produtos) produtos_pendentes, 
                                   sum(valores) valores_pendentes, 
                                   0 vendas_retratacao, 
                                   0 produtos_retratacao, 
                                   0 valores_retratacao, 
                                   0 vendas_recusadas, 
                                   0 produtos_recusadas, 
                                   0 valores_recusadas, 
                                   0 vendas_confirmadas, 
                                   0 produtos_confirmadas, 
                                   0 valores_confirmadas 
                              from ( 
                                      select p.cod_usuario
                                           , p.cod_superior
                                           , count(1) vendas    
                                           , 0 produtos    
                                           , 0 valores    
                                           , 0 vendas_confirmadas  
                                           , 0 produtos_confirmadas  
                                           , 0 valores_confirmadas 
                                        from beefavorita.prospects p    
                                           , beedialer.controle_status_sistemas css    
                                       where p.cod_status = css.codigo  
                                         and p.data_ultimo_resgate between trunc(to_date(:P30_VALOR,'dd/mm/yyyy hh24:mi:ss')) and trunc(to_date(:P30_VALOR,'dd/mm/yyyy hh24:mi:ss'))+1  
                                         and css.conversao_pre + css.conversao_auditada + css.conversao_recusada > 0 
                                       group by p.cod_usuario, p.cod_superior
                                       union 
                                      select u.codigo cod_usuario
                                           , us.codigo cod_superior
                                           , 0 vendas
                                           , count(1) produtos
                                           , sum(vw.valorapagar) valores  
                                           , 0 vendas_confirmadas   
                                           , 0 produtos_confirmadas   
                                           , 0 valores_confirmadas  
                                        from favorita.vw_dashboardatendimento_bee vw
                                           , catal.usuarios cau
                                           , beeadmin.usuarios u
                                           , beeadmin.usuarios us
                                           , beepeople.vw_pessoas_contratos pc
                                       where vw.idusuario = cau.idusuario
                                         and cau.usuario = u.nome_login
                                         and u.cod_pessoa = pc.cod_pessoa
                                         and u.empresa = pc.empresa
                                         and pc.cod_gerente = us.cod_pessoa
                                         and pc.empresa_gerente = us.empresa
                                         and vw.dataemissao between trunc(to_date(:P30_VALOR,'dd/mm/yyyy hh24:mi:ss')) and trunc(to_date(:P30_VALOR,'dd/mm/yyyy hh24:mi:ss'))+1
                                     group by u.codigo, us.codigo
                                            ) GROUP BY COD_USUARIO, COD_SUPERIOR  ) T 
                                  GROUP BY COD_USUARIO, COD_SUPERIOR ) t
                                  , beeadmin.usuarios u
                                  , beepeople.vw_pessoas op
                                  , beepeople.vw_pessoas_contratos c
                                  , beepeople.vw_pessoas sup
                                  , beeadmin.usuarios us
                                  , beeadmin.tipos_usuarios_cargos tuc 
                 where t.cod_usuario(+) = u.codigo 
                   and u.cod_pessoa = c.cod_pessoa 
                   and u.empresa = c.empresa 
                   and c.cargo = tuc.cargo    
                   and tuc.tipo_usuario = 'A'    
                   and c.cod_pessoa = op.codigo 
                   and c.empresa = op.empresa 
                   and c.cod_gerente = sup.codigo 
                   and c.empresa_gerente = sup.empresa 
                   and sup.codigo = us.cod_pessoa 
                   and sup.empresa = us.empresa 
                   and u.em_treinamento = 0 
                   and exists (select 1 
                                 from beeadmin.sistemas_centros_custo scc, beeadmin.sistemas s 
                                where scc.cod_sistema = s.codigo 
                                  and scc.cod_centro_custo = c.cod_centro_custo 
                                  and upper(s.db_username) = 'BEEFAVORITA') 
                   and exists (select 1 
                                 from beepeople.controle_frequencia 
                                where cod_pessoa = u.cod_pessoa 
                                  and empresa = u.empresa 
                                  and cod_centro_custo = c.cod_centro_custo 
                                  and data = trunc(trunc(to_date(:P30_VALOR,'dd/mm/yyyy hh24:mi:ss'))) 
                                  and sysdate >= data_entrada_prevista) 
                   and t.valores > 0
                  order by 1
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--noBorders
                margin-top-lg
                margin-bottom-lg
                margin-left-lg
                margin-right-lg
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 2784606073762372229
        }

