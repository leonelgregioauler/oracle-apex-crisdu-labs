page 81 (
    name: Lojas
    title: Lojas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region acompanhamento-das-lojas (
        name: Acompanhamento das Lojas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nomefilialfavorita
                     , fma.faturado "Fat. Mês Anterior"
                     , fm.faturado "Fat. Mês Atual"
                     , fm_anterior.faturado "Fat. Mês Atual 2024"
                     , case 
                         when fm_anterior.faturado > 0 then
                           round( (fm.faturado/fm_anterior.faturado)*100,2)-100
                         else
                           0
                       end  "% Crescimento Fat."
                     , adimp.percentual "% Adimplência"    
                     , adimp_anterior.percentual "% Adimp. Ano Anterior"
                     , inad.percentual "% Inadimplência"
                     , inad_anterior.percentual "% Inad. Ano Anterior"
                     , f.idfilialfavorita
                from filiaisfavorita f
                   , ( select w.idfilialfavorita
                            , round(sum(nvl(w.valorapagarfavorita, 0) * w.fatorconversao),2)  faturado
                       from vw_rank_pedidos_dist_m w
                       where to_char(w.dataemissao,'MM/RRRR') = to_char(sysdate,'MM/RRRR')
                       group by w.idfilialfavorita ) fm
                   , ( select w.idfilialfavorita
                            , round(sum(nvl(w.valorapagarfavorita, 0) * w.fatorconversao),2)  faturado
                       from vw_rank_pedidos_dist_m w
                       where trunc(w.dataemissao) < add_months(trunc(sysdate),-12)
                         and extract(year from w.dataemissao) = extract(year from sysdate)-1
                         and extract(month from w.dataemissao) = extract(month from sysdate)
                       group by w.idfilialfavorita ) fm_anterior
                   , ( select w.idfilialfavorita
                            , round(sum(nvl(w.valorapagarfavorita, 0) * w.fatorconversao),2)  faturado
                       from vw_rank_pedidos_dist_m w
                       where extract(year from w.dataemissao) = extract(year from sysdate)
                         and extract(month from w.dataemissao) = extract(month from sysdate)-1
                       group by w.idfilialfavorita ) fma
                   , ( select idfilialfavorita
                            , ( sum( case  
                                       when nvl(pg.datapagamento,pg.databaixa) <= v.datavencimento 
                                         then nvl(pg.valorpago,0) * nvl(p.fatorconversao,1) 
                                       else 
                                          0 end) / sum(nvl(v.valorpagar,0) * nvl(p.fatorconversao,1))) * 100  percentual
                       from favorita.vencimentospedidos v                 
                          , favorita.pedidos p                             
                          , ( select sum(valorpago) valorpago             
                                   , min(trunc(datapagamento)) datapagamento
                                   , min(trunc(databaixa)) databaixa   
                                   , idvencimentopedido                    
                              from pagamentospedidos                     
                              where idsituacao = 20                       
                              group by idvencimentopedido ) pg
                       where v.idpedido = p.idpedido             
                         and p.datacancelamento is null                            
                         and v.situacaovencimento = 'V'                                
                         and v.idvencimentopedido = pg.idvencimentopedido(+)           
                         and v.valorpagar > 0                                          
                         and trunc(v.datavencimento) between add_months(trunc(sysdate)-1,-12) and trunc(sysdate-1)
                       group by p.idfilialfavorita ) adimp
                   , ( select idfilialfavorita
                            , ( sum( case  
                                       when nvl(pg.datapagamento,pg.databaixa) <= v.datavencimento 
                                         then nvl(pg.valorpago,0) * nvl(p.fatorconversao,1) 
                                       else 
                                          0 end) / sum(nvl(v.valorpagar,0) * nvl(p.fatorconversao,1))) * 100  percentual
                       from favorita.vencimentospedidos v                 
                          , favorita.pedidos p                             
                          , ( select sum(valorpago) valorpago             
                                   , min(trunc(datapagamento)) datapagamento
                                   , min(trunc(databaixa)) databaixa   
                                   , idvencimentopedido                    
                              from pagamentospedidos                     
                              where idsituacao = 20                       
                              group by idvencimentopedido ) pg
                       where v.idpedido = p.idpedido             
                         and p.datacancelamento is null                            
                         and v.situacaovencimento = 'V'                                
                         and v.idvencimentopedido = pg.idvencimentopedido(+)           
                         and v.valorpagar > 0                                          
                         and trunc(v.datavencimento) between add_months(trunc(sysdate)-1,-24) and add_months(trunc(sysdate)-1,-12)
                       group by p.idfilialfavorita ) adimp_anterior
                   , ( select t.idfilialfavorita
                            , round ( ((t.total_pagar) - (valor_pago_emdia) - (pago_30dias) - (pago_42dias) - (pago_90dias)) / (t.total_pagar) *100 ,2) percentual
                       from (
                             select p.idfilialfavorita 
                                  , count(1) Qtd_Vencimentos 
                                  , sum(nvl(v.valorpagar,0) * nvl(p.fatorconversao,1)) total_pagar 
                                  , sum( nvl(pg.valorpago,0) * nvl(p.fatorconversao,1)) total_pago
                                  , sum( case  
                                           when nvl(pg.datapagamento,pg.databaixa) <= v.datavencimento 
                                             then nvl(pg.valorpago,0) * nvl(p.fatorconversao,1) 
                                           else 
                                             0 
                                         end )  valor_pago_emdia
                                  , sum( case 
                                           when nvl(pg.datapagamento,pg.databaixa) between v.datavencimento + 1 and v.datavencimento + 30 
                                             then nvl(pg.valorpago,0) * nvl(p.fatorconversao,1) 
                                           else 
                                             0 
                                         end ) pago_30dias
                                  , sum( case  
                                           when nvl(pg.datapagamento,pg.databaixa) between v.datavencimento + 31 and v.datavencimento + 42 
                                             then nvl(pg.valorpago,0) * nvl(p.fatorconversao,1) 
                                           else 
                                             0 
                                         end ) pago_42dias
                                  , sum( case 
                                           when nvl(pg.datapagamento,pg.databaixa) between v.datavencimento + 43 and v.datavencimento + 90 
                                             then nvl(pg.valorpago,0) * nvl(p.fatorconversao,1) 
                                           else 
                                             0 
                                         end ) pago_90dias
                              from favorita.vencimentospedidos v                 
                                 , favorita.pedidos p                             
                                 , (select sum(valorpago) valorpago             
                                         , min(trunc(datapagamento)) datapagamento
                                         , min(trunc(databaixa)) databaixa   
                                         , idvencimentopedido                    
                                      from pagamentospedidos                     
                                     where idsituacao = 20                       
                                     group by idvencimentopedido ) pg
                             where v.idpedido = p.idpedido                                
                               and p.datacancelamento is null                            
                               and v.situacaovencimento = 'V'                               
                               and v.idvencimentopedido = pg.idvencimentopedido(+)    
                               and v.valorpagar > 0                                          
                               and v.datavencimento between add_months(trunc(sysdate)-1,-12) and trunc(sysdate-1)
                             group by p.idfilialfavorita ) t ) inad
                   , ( select t.idfilialfavorita
                            , round ( ((t.total_pagar) - (valor_pago_emdia) - (pago_30dias) - (pago_42dias) - (pago_90dias)) / (t.total_pagar) *100 ,2) percentual
                       from (
                             select p.idfilialfavorita 
                                  , count(1) Qtd_Vencimentos 
                                  , sum(nvl(v.valorpagar,0) * nvl(p.fatorconversao,1)) total_pagar 
                                  , sum( nvl(pg.valorpago,0) * nvl(p.fatorconversao,1)) total_pago
                                  , sum( case  
                                           when nvl(pg.datapagamento,pg.databaixa) <= v.datavencimento 
                                             then nvl(pg.valorpago,0) * nvl(p.fatorconversao,1) 
                                           else 
                                             0 
                                         end )  valor_pago_emdia
                                  , sum( case 
                                           when nvl(pg.datapagamento,pg.databaixa) between v.datavencimento + 1 and v.datavencimento + 30 
                                             then nvl(pg.valorpago,0) * nvl(p.fatorconversao,1) 
                                           else 
                                             0 
                                         end ) pago_30dias
                                  , sum( case  
                                           when nvl(pg.datapagamento,pg.databaixa) between v.datavencimento + 31 and v.datavencimento + 42 
                                             then nvl(pg.valorpago,0) * nvl(p.fatorconversao,1) 
                                           else 
                                             0 
                                         end ) pago_42dias
                                  , sum( case 
                                           when nvl(pg.datapagamento,pg.databaixa) between v.datavencimento + 43 and v.datavencimento + 90 
                                             then nvl(pg.valorpago,0) * nvl(p.fatorconversao,1) 
                                           else 
                                             0 
                                         end ) pago_90dias
                              from favorita.vencimentospedidos v                 
                                 , favorita.pedidos p                             
                                 , (select sum(valorpago) valorpago             
                                         , min(trunc(datapagamento)) datapagamento
                                         , min(trunc(databaixa)) databaixa   
                                         , idvencimentopedido                    
                                      from pagamentospedidos                     
                                     where idsituacao = 20                       
                                     group by idvencimentopedido ) pg
                             where v.idpedido = p.idpedido                                
                               and p.datacancelamento is null                            
                               and v.situacaovencimento = 'V'                               
                               and v.idvencimentopedido = pg.idvencimentopedido(+)    
                               and v.valorpagar > 0                                          
                               and v.datavencimento between add_months(trunc(sysdate)-1,-24) and add_months(trunc(sysdate)-1,-12)
                             group by p.idfilialfavorita ) t ) inad_anterior
                where f.tipofilial = 'L'
                  and f.ativo = 'S'
                  and f.idfilialfavorita = fm.idfilialfavorita(+)
                  and f.idfilialfavorita = fm_anterior.idfilialfavorita(+)
                  and f.idfilialfavorita = fma.idfilialfavorita(+)
                  and f.idfilialfavorita = adimp.idfilialfavorita(+)
                  and f.idfilialfavorita = adimp_anterior.idfilialfavorita(+)
                  and f.idfilialfavorita = inad.idfilialfavorita(+)
                  and f.idfilialfavorita = inad_anterior.idfilialfavorita(+)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
