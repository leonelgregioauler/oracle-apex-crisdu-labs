    region legenda (
        name: Legenda
        type: staticContent
        source {
            htmlCode:
                ```html
                <b>Fat. Mês Anterior - </b>Faturamento realizado no mês anterior a partir do primeiro dia até D-1.<br>
                <b>Fat. Mês Atual - </b>Faturamento realizado no mês atual a partir do primeiro dia até D-1.<br>
                <b>% Adimplência - </b>Sempre no período de 1 ano, até o dia de ontem. Ex: Puxado dia 11/03, o filtro será 10/03/2023 até 10/03/2024.<br>
                <b>% Inadimplência - </b>Sempre no período de 1 ano, até o dia de ontem. Ex: Puxado dia 11/03, o filtro será 10/03/2023 até 10/03/2024.<br>
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
