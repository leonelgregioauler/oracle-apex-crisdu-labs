                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-2 (
                name: % Comp. Positivo
                condition {
                    column: "% Crescimento Fat."
                    operator: >
                    value: 0
                }
                highlight {
                    type: cell
                }
                colors {
                    text: #99FF99
                }
                execution {
