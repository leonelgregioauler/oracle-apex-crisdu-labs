page 40 (
    name: Login Bee
    title: Login Bee
    appearance {
        pageTemplate: @/login
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region identifique-se (
        name: Identifique-se
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/login
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P40_PASSWORD (
        type: password
        label {
            label: Senha
            alignment: left
        }
        layout {
            sequence: 20
            region: @identifique-se
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            icon: fa-lock-password
            width: 30
        }
        validation {
            valueRequired: true
        }
        source {
            used: always
        }
        sessionState {
            storage: request
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P40_USERNAME (
        type: textField
        label {
            label: Usuário
            alignment: left
        }
        layout {
            sequence: 10
            region: @identifique-se
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            icon: fa-user
            width: 30
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    button ok (
        buttonName: OK
        label: OK
        layout {
            sequence: 10
            region: @identifique-se
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Goto Page 39
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 39
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @ok
            type: rowsReturned
            sqlQuery:
                ```sql
                 select 1
                   from beeadmin.usuarios
                  where nome_login = :P40_USERNAME
                    and senha = beeadmin.encodetext(:P40_PASSWORD,23)
                ```
        }
    )

)

