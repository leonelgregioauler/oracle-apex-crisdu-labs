    pageItem P13_PERCQUANTIDADE (
        type: displayOnly
        label {
            label: % Quantidade Brasil
            alignment: left
        }
        layout {
            sequence: 10
            region: @total-por-valor-de-venda-por-filial
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select case 
                        when sum(QuantidadeRom) > 0 then
                          round((sum(QuantidadeFav)/sum(QuantidadeRom))*100,2) 
                        else 
                          round((sum(QuantidadeRom)/sum(1))*100,2) 
                        end PercQtd
                from
                (
                          select roman.pck_romance.fnc_nomefilial(n.idfilial) filial
                               , count(distinct n.idvendedora) QuantidadeRom
                               , round(sum((n.valortotalvendalqd * n.fatorconversao)),2) ValorRom
                               , 0 QuantidadeFav
                               , 0 ValorFav
                          from roman.notasvendas n
                          where n.dataacerto between to_date(:P13_DE||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and TO_DATE(:P13_ATE||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                            and ( :P13_IDFILIAL is null or n.idfilial = :P13_IDFILIAL )
                            and n.idsituacaonotavenda =4   
                            and n.fatorconversao = 1
                          group by n.idfilial
                          union
                          select roman.pck_romance.fnc_nomefilial(p.idfilialromance) filial
                               , 0 QuantidadeRom
                               , 0 ValorRom
                               , count(distinct p.idvendedora) QuantidadeFav
                               , round(sum((p.valorapagar * p.fatorconversao)),2) ValorFav
                          from favorita.pedidos p
                          where p.idsituacaoentrega != 50
                            and ( :P13_IDFILIAL is null or p.idfilialromance = :P13_IDFILIAL )
                            and p.tipopedido in ('P','V')
                            and p.fatorconversao = 1
                            and not exists ( select 1
                                             from favorita.classificacoespedidos cp
                                             where cp.idpedido = p.idpedido
                                               and cp.idcaracteristicapedido = 5
                                               and ( select sum(vp.valorpagar)
                                                     from favorita.vencimentospedidos vp
                                                     where vp.idpedido = cp.idpedido
                                                       and vp.situacaovencimento = 'V') = 0)
                            and not exists ( select 1
                                             from classificacoespedidos cp
                                             where cp.idpedido = p.idpedido
                                             and cp.idcaracteristicapedido = 25 )
                            and p.dataentrega between to_date(:P13_DE||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and TO_DATE(:P13_ATE||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                          group by p.idfilialromance
                          order by 1)
                ```
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P13_DE
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P13_PERCQUANTIDADE_AL (
        type: displayOnly
