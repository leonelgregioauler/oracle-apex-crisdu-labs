    region relatório-geral-clientes-favorita (
        name: Relatório Geral Clientes Favorita
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(p.idfilialromance) filial
                     , count(distinct p.idvendedora) Quantidade
                     , round(sum((p.valorapagar * p.fatorconversao)),2) Valor
                from favorita.pedidos p
                where ( :P13_IDFILIAL is null or p.idfilialromance = :P13_IDFILIAL)
                  and p.idsituacaoentrega != 50
                  and p.tipopedido in ('P','V')
                  and not exists ( select 1
                                   from favorita.classificacoespedidos cp
                                   where cp.idpedido = p.idpedido
                                     and cp.idcaracteristicapedido = 5
                                     and ( select sum(vp.valorpagar)
                                           from favorita.vencimentospedidos vp
                                           where vp.idpedido = cp.idpedido
                                             and vp.situacaovencimento = 'V') = 0)
                  and not exists ( select 1
                                   from classificacoespedidos cp
                                   where cp.idpedido = p.idpedido
                                   and cp.idcaracteristicapedido = 25 )
                  and p.dataentrega between to_date(:P13_DE||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and TO_DATE(:P13_ATE||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                group by p.idfilialromance
                order by 1
                ```
            pageItemsToSubmit: [
                P13_DE
                P13_ATE
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: 0
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum dado encontrado.
        }
        advanced {
            savedReportMappingIdentifier: 1740528227841899307
        }

