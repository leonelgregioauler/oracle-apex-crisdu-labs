    pageItem P20_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Filial Favorita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) as d,
                       idfilialfavorita as r
                  from filiaisfavorita
                  where ((:P20_TIPOFILIAL = 'F' and tipofilial not in ('L') )
                      or (:P20_TIPOFILIAL = 'T')
                      or (:P20_TIPOFILIAL = 'L' and tipofilial in ('L') ))
                     and idpais = :P20_IDPAIS
                 order by 1
                ```
            nullDisplayValue: - Todas Filiais -
        }
        cascadingLov {
            parentItems: [
                P20_IDPAIS
                P20_TIPOFILIAL
            ]
            itemsToSubmit: [
                P20_IDPAIS
                P20_TIPOFILIAL
            ]
        }
        layout {
            sequence: 100
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P20_IDFILIALROMANCE (
        type: selectList
        label {
            label: Distrib. Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct 
                       pck_util_fav.fnc_nomefilialromance(afr.idfilialdestino) as d,
                       afr.idfilialdestino as r
                  from atendimentosfiliaisrmc afr
                     , filiaisfavorita f
                 where afr.idfilialfavoritaorigem = f.idfilialfavorita
                  and ( f.idfilialfavorita = nvl(:P20_ESTOQUE, f.idfilialfavorita) or :P20_ESTOQUE = 0 )
                 order by 1
                ```
            nullDisplayValue: - Todas Filiais -
        }
        cascadingLov {
            parentItems: P20_ESTOQUE
        }
        layout {
            sequence: 110
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P20_IDFORNECEDOR (
        type: plugin/select
        label {
            label: Fornecedores
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct cp.nomepessoa select_value
                     , cd.idfornecedor return_value
                from catal.fornecedores   cd
                   , catal.pessoas        cp
                   , fornecedoresprodutos fr
                where cd.idpessoa     = cp.idpessoa
                  and cd.idfornecedor = fr.idfornecedor 
                order by 1
                ```
            nullDisplayValue: " - Todos - "
        }
        layout {
            sequence: 130
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
