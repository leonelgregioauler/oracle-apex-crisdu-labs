                  --    
                  --
                  vsql:= pck_bi_fav.fnc_vendaperdaromance_bi ( pidpais                     => vidpais,
                                                               pidestoque                  => videstoque,
                                                               pconsultarestoque           => vconsultarestoque,
                                                               ptipofilial                 => vtipofilial,      
