    dynamicAction detectar-dispositivo-desktop (
        name: Detectar Dispositivo Desktop
        execution {
            sequence: 40
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: item=value
            item: P0_DESKTOP_MOBILE
            value: D
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: region
                region: @resumo-filial-2
            }
            execution {
                sequence: 30
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: region
                region: @resumo-filial-cancelados-2
            }
            execution {
                sequence: 40
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: region
                region: @resumo-filial
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: region
                region: @resumo-filial-cancelados
            }
            execution {
                sequence: 20
            }
        )

    )

