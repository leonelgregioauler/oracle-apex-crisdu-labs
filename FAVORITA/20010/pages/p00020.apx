    process criar-view-filial-favorita (
        name: Criar View Filial Favorita
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vsql                varchar2(32767);
                  vidpais             number               := :P20_IDPAIS;
                  videstoque          number               ;
                  vconsultarestoque   varchar2(1)          := 'N';
                  vtipofilial         varchar2(1)          := :P20_TIPOFILIAL;
                  vdetalharfilialrmc  varchar2(1)          := 'N';
                  vtipofilialfavorita varchar2(1)          ;
                  vidfilialfavorita   number               := :P20_IDFILIALFAVORITA;
                  vidfilialromance    number               := :P20_IDFILIALROMANCE;
                  vtipodata           varchar2(1)          := :P20_TIPODATA;
                  vdataini            date                 := :P20_DATAINICIO;
                  vdatafim            date                 := :P20_DATAFIM;
                  videdicao           number               := :P20_IDEDICAOREVISTA;
                  vdetalharproduto    varchar2(1)          := 'N';
                  vidfornecedor       number               := :P20_IDFORNECEDOR;
                  vidproduto          number               := :P20_IDPRODUTO;
                  vidprodutodetalhado number               := :P20_IDPRODUTODETALHADO;
                  vdetalharvalores    varchar2(1)          := 'S';
                  vsomentecancelados  varchar2(1)          := 'S';
                  vcampototalvenda    varchar2(20)         ;
                  vcampototalperda    varchar2(20)         ;
                  --
                begin
                  --
                  vsql:= pck_bi_fav.fnc_vendaperdafavorita_bi ( pidpais                     => vidpais,
                                                                pidestoque                  => videstoque,
                                                                pconsultarestoque           => vconsultarestoque,
                                                                ptipofilial                 => vtipofilial,      
                                                                pdetalharfilialromance      => vdetalharfilialrmc,
                                                                ptipofilialfavorita         => vtipofilialfavorita,
                                                                pidfilialfavorita           => vidfilialfavorita,
                                                                pidfilialromance            => vidfilialromance,
                                                                ptipodata                   => vtipodata,
                                                                pdatainicial                => vdataini,
                                                                pdatafinal                  => vdatafim,
                                                                pidedicaorevista            => videdicao,
                                                                pdetalharproduto            => vdetalharproduto,
                                                                pidfornecedor               => vidfornecedor,
                                                                pidproduto                  => vidproduto,
                                                                pidprodutodetalhado         => vidprodutodetalhado,
                                                                pdetalharvalores            => vdetalharvalores,
                                                                pcampototalvenda            => vcampototalvenda,
                                                                pcampototalperda            => vcampototalperda);
                  --
                  execute immediate 'create or replace view vw_vendadetalhada_fav as '||vsql;
                  --    
                  --
                  vsql:= pck_bi_fav.fnc_vendaperdafavorita_bi ( pidpais                     => vidpais,
                                                                pidestoque                  => videstoque,
                                                                pconsultarestoque           => vconsultarestoque,
                                                                ptipofilial                 => vtipofilial,      
                                                                pdetalharfilialromance      => vdetalharfilialrmc,
                                                                ptipofilialfavorita         => vtipofilialfavorita,
                                                                pidfilialfavorita           => vidfilialfavorita,
                                                                pidfilialromance            => vidfilialromance,
                                                                ptipodata                   => vtipodata,
                                                                pdatainicial                => vdataini,
                                                                pdatafinal                  => vdatafim,
                                                                pidedicaorevista            => videdicao,
                                                                pdetalharproduto            => vdetalharproduto,
                                                                pidfornecedor               => vidfornecedor,
                                                                pidproduto                  => vidproduto,
                                                                pidprodutodetalhado         => vidprodutodetalhado,
                                                                pdetalharvalores            => vdetalharvalores,
                                                                psomentecancelados          => vsomentecancelados,
                                                                pcampototalvenda            => vcampototalvenda,
                                                                pcampototalperda            => vcampototalperda);
                  --
                  execute immediate 'create or replace view vw_vendadetalhadacancelado_fav as '||vsql;
                  --
                end;
                
                
                
                
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 1492200585071556205
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P20_ROMANCE_FAVORITA = 'F' and :P20_PARAMETRO = 1;
        }
    )

