    name: Resumo Vendas Filial
    title: Resumo Vendas Filial
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    htmlHeader {
        htmlHeader:
            ```html
            <style>
            
                .preto {
                    color: black;
                    font-size: bold;
                }
                
                
            
            </style>
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: </>Filtros
        type: staticContent
        layout {
            sequence: 30
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region pedidos-cancelados (
        name: Pedidos / Cancelados
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.idproduto
                     , v.idprodutodetalhado
                     , v.nomeprodutodetalhado
                     , v.quantidadeestoque
                     , v.filial_pedidos
                     , v.filial_valorpagaraberto
                     , v.filial_valorpagarvencido
                     , v.filial_valorpagargeral
                     , v.filial_valorpagoaberto
                     , v.filial_valorpagovencido
                     , v.filial_valorpagogeral
                     , v.filial_saldoaberto
                     , v.filial_saldovencido
                     , v.filial_saldogeral
                     , v.filial_valorpagarcancelados
                     , 'Valor Pedidos Geral' coluna
                     , "FILIAL_VALORPAGARGERAL" valor
                from vw_vendadetalhada_fav v
                union all
                select v.idproduto
                     , v.idprodutodetalhado
                     , v.nomeprodutodetalhado
                     , v.quantidadeestoque
                     , v.filial_pedidos
                     , v.filial_valorpagaraberto
                     , v.filial_valorpagarvencido
                     , v.filial_valorpagargeral
                     , v.filial_valorpagoaberto
                     , v.filial_valorpagovencido
                     , v.filial_valorpagogeral
                     , v.filial_saldoaberto
                     , v.filial_saldovencido
                     , v.filial_saldogeral
                     , v.filial_valorpagarcancelados
                     , 'Valor Pedidos Cancelados' coluna
                     , "FILIAL_VALORPAGARCANCELADOS" valor
                from vw_vendadetalhadacancelado_fav v
                ```
        }
        layout {
            sequence: 90
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent6
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P20_PARAMETRO = 0;
        }
        chart {
            type: donut
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        animation {
            onDataChange: none
        }
        legend {
            position: top
            hideAndShowBehavior: none
        }

        series pedidos-cancelados (
            name: Pedidos / Cancelados
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select v.idproduto
                         , v.idprodutodetalhado
                         , v.nomeprodutodetalhado
                         , v.quantidadeestoque
                         , v.filial_pedidos
                         , v.filial_valorpagaraberto
                         , v.filial_valorpagarvencido
                         , v.filial_valorpagargeral
                         , v.filial_valorpagoaberto
                         , v.filial_valorpagovencido
                         , v.filial_valorpagogeral
                         , v.filial_saldoaberto
                         , v.filial_saldovencido
                         , v.filial_saldogeral
                         , v.filial_valorpagarcancelados
                         , 'Valor Pedidos Geral' coluna
                         , "FILIAL_VALORPAGARGERAL" valor
                    from vw_vendadetalhada_fav v
                    union all
                    select v.idproduto
                         , v.idprodutodetalhado
                         , v.nomeprodutodetalhado
                         , v.quantidadeestoque
                         , v.filial_pedidos
                         , v.filial_valorpagaraberto
                         , v.filial_valorpagarvencido
                         , v.filial_valorpagargeral
                         , v.filial_valorpagoaberto
                         , v.filial_valorpagovencido
                         , v.filial_valorpagogeral
                         , v.filial_saldoaberto
                         , v.filial_saldovencido
                         , v.filial_saldogeral
                         , v.filial_valorpagarcancelados
                         , 'Valor Pedidos Cancelados' coluna
                         , "FILIAL_VALORPAGARCANCELADOS" valor
                    from vw_vendadetalhadacancelado_fav v
                    
                    ```
            }
            columnMapping {
                label: COLUNA
                value: VALOR
            }
            label {
                show: true
                displayAs: percentage
            }
        )

    )

    region relatório-de-caixa (
        name: Relatório de Caixa
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idfechamento
                     , semana
                     , roman.pck_romance.fnc_nomefilial(f.idfilial) Filial
                     , saldoanteriorgaveta
                     , totalcobranca
                     , f.totalentradasdiversas
                     , totalvendasdiretas
                     , totalchqsemfundorecebidos
                     , totalboletosfavorita
                     , totaldespesas
                     , totalcomissoesrepresentantes
                     , totalcomissaogerente
                     , totaldepositosespecie
                     , totaldepsitoscheques
                     , totalcomissoesfavoritarepres
                     , totalcomissoesfavoritagerente
                     , saldofinalespecie
                     , saldofinalcheque
                     , subtotalgaveta
                     , totalsaidasdiversas
                     , totalgaveta
                     , decode(concluido,'S','Sim','Não') concluido
                     , to_number(substr(f.semana,4,4)) "Ano"
                     , f.observacao
                     , f.totaldepositosfavorita
                from roman.fechamentossemanais f
                where f.idfilialfavorita = :P20_IDFILIALFAVORITA 
                order by 3, 1 desc
                ```
        }
        layout {
            sequence: 100
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                :P20_PARAMETRO = 0
                and :P20_IDFILIALFAVORITA is not null
                and :P20_TIPOFILIAL = 'L'
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 1482297839972633550
        }

