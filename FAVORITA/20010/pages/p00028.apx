            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select to_char(data,'dd/mm') data, valor
                      from (
                            select trunc(h.data) data
                                 , sum(nvl(h.valores,0)) VALOR
                              from beecobranca.historico_atendimentos h
                             where h.data >= trunc(sysdate-14)
                             --  and h.id_tipo_tarefa in (9,10)
                             group by trunc(data)) t
                     order by t.data
                    ```
            }
            columnMapping {
                label: DATA
