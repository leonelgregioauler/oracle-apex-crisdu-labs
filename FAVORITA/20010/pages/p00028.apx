            onDataChange: none
        }
        legend {
            hideAndShowBehavior: none
        }

        series valor (
            name: Valor
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select to_char(t.data,'dd/mm')  data, valor
                      from (
                            select trunc(h.data) data
                                 , trunc(sum(h.valores)/sum(h.produtos),2) VALOR
                              from beecobranca.historico_atendimentos h
                             where h.data >= trunc(sysdate-14)
                             --  and h.id_tipo_tarefa in (9,10)
                               and nvl(h.produtos,0) > 0
                             group by trunc(h.data)) t
                     order by t.data
                    ```
            }
            columnMapping {
                label: DATA
                value: VALOR
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            minorTicks {
                show: false
            }
        )

    )

    region valor-total (
