            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            minorTicks {
                show: false
            }
        )

    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 42
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: TROCAPAGINA
        }
    )

