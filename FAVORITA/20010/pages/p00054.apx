page 54 (
    name: Atualiza Ciclos
    title: Atualiza Ciclos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region ciclos (
        name: Ciclos
        type: tabform
        source {
            sqlQuery:
                ```sql
                select c.idcicloedicao
                     , c.numerociclo
                     , ( select  e.idedicaorevista||' - '||nome        
                        from favorita.edicoesrevistas e
                        where c.idedicaorevista = e.idedicaorevista ) edicao
                     , c.datainicio
                     , c.datafim
                     , c.identificacaorelatorio
                from favorita.ciclosedicoes             c
                where exists ( select 1
                               from favorita.edicoesrevistas           e
                               where c.idedicaorevista  = e.idedicaorevista
                                 and e.tipovenda        = 'R' 
                                 and e.idpais           = :P51_IDPAIS )
                and datainicio >= sysdate - 300
                order by datainicio
                ```
            pageItemsToSubmit: P51_IDPAIS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: <font color="red"> Apenas escolha os ciclos caso precise muda-los. Caso contrário, não é necessário.</font>
        }
        reportLayout {
            numberOfRows: 30
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        breakFormatting {
            breakColumns: col1
        }

        column DATAFIM (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Data Final
                alignment: center
            }
            layout {
                sequence: 5
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
            sorting {
                sortable: false
            }
        )

        column DATAINICIO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Data Início
                alignment: center
            }
            layout {
                sequence: 4
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
            sorting {
                sortable: false
            }
        )

        column EDICAO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Edição
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column IDCICLOEDICAO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

        column IDENTIFICACAORELATORIO (
            reportColumnQueryId: 6
            derivedColumn: N
            type: selectList
            heading {
                heading: Identificar Como
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC:Ciclo_1;Ciclo_1,Ciclo_2;Ciclo_2,Ciclo_3;Ciclo_3,Ciclo_4;Ciclo_4,Ciclo_5;Ciclo_5,Ciclo_6;Ciclo_6
                nullDisplayValue: - Selecione -
            }
            layout {
                sequence: 6
            }
            sorting {
                sortable: false
            }
        )

        column NUMEROCICLO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Ciclo
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P54_CICLOATUALIZADO (
        type: displayOnly
        label {
            label: "Ciclo atualizado em "
            alignment: left
        }
        layout {
            sequence: 10
            region: @ciclos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select distinct trim(to_char(NVL(last_date,NEXT_DATE-1),'dd/mm/rrrr hh24:mi:ss'))||'. Próxima atualização: '||trim(to_char(next_date,'DD/MM/RRRR HH24:MI:SS'))||'.' a
                from ALL_jobs
                where what like '%VW_ITENSVENDA_DIA_FAV_MV%'
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button salvar (
        buttonName: SALVAR
        label: Salvar e Gerar Base
        layout {
            sequence: 10
            region: @ciclos
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction filtra (
        name: filtra
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P54_IDEDICAOREVISTA
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction salvar (
        name: SALVAR
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @salvar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: SALVAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process atualiza-ciclo (
        name: Atualiza Ciclo
        type: tabformUpdate
        editableRegion: @ciclos
        target {
            tableName: CICLOSEDICOES
            pkColumn: IDCICLOEDICAO
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Atualizado com sucesso!
        }
        error {
            errorMessage: Não repita o identificador do ciclo.
        }
        advanced {
            executionMappingIdentifier: 4531246711838374204
        }
        serverSideCondition {
            whenButtonPressed: @salvar
        }
    )

    process gerar-dados (
        name: Gerar Dados
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  favorita.pck_bi_fav.prc_geranecessidadecompra_tabs(:P51_IDPAIS);
                end;
                
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 4531247196388374204
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 51
                action: resetPagination
            }
        }
    )

)

