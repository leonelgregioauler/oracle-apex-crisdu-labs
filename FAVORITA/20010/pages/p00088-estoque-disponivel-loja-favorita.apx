page 88 (
    name: Estoque Disponível Loja Favorita
    alias: ESTOQUE-DISPONIVEL-LOJA-FAVORITA
    title: Estoque Disponível Loja Favorita
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }

    region estoque-disponível-loja-favorita (
        name: Estoque Disponível Loja Favorita
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nomefilialfavorita                                             as "Loja Favorita"
                     , e.quantidade - pck_estoque_fav.fnc_estoquereservado(e.idestoque) as "Est. Disp. Loja"
                  from favorita.estoques e
                     , favorita.filiaisfavorita f
                 where f.idfilialfavorita = e.idfilialfavorita
                   and e.idprodutodetalhado = :P88_IDPRODUTODETALHADO
                   and e.idfilialfavorita != :P88_IDFILIALFAVORITA
                   and ( e.quantidade - favorita.pck_estoque_fav.fnc_estoquereservado(e.idestoque)) > 0
                   and e.idfilialfavorita in (select a.idfilialfavoritadestino
                                                from favorita.atendimentosestoques a
                                               where a.idfilialfavoritaorigem = :P88_IDFILIALFAVORITA)
                 order by 1;
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 372296667239229332
        }

        column "Est. Disp. Loja" (
            type: plainText
            heading {
                heading: Est. Disp. Loja
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column "Loja Favorita" (
            type: plainText
            heading {
                heading: Loja Favorita
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 3724052 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn "Est. Disp. Loja" (
                sequence: 2
            )

            displayColumn "Loja Favorita" (
                sequence: 1
            )

            aggregate (
                column: "Est. Disp. Loja"
            )

        )

    )

    pageItem P88_IDFILIALFAVORITA (
        type: hidden
        layout {
            sequence: 20
            region: @estoque-disponível-loja-favorita
            slot: regionBody
        }
    )

    pageItem P88_IDPRODUTODETALHADO (
        type: hidden
        layout {
            sequence: 10
            region: @estoque-disponível-loja-favorita
            slot: regionBody
        }
    )

)

