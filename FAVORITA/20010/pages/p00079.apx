    }
    security {
        pageAccessProtection: unrestricted
    }

    region adimplência-por-distribuidor (
        name: Adimplência por Distribuidor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idrepresentante
                     , roman.pck_romance.fnc_nomerepresentante(p.idrepresentante) distribuidor
                  --   , count(1) Qtd_Vencimentos 
                     , round(sum(nvl(v.valorpagar,0) * nvl(p.fatorconversao,1)),2) total_pagar 
                --     , sum( nvl(pg.valorpago,0) * nvl(p.fatorconversao,1)) Total_Pago
                     , round(sum( case  
                              when nvl(pg.datapagamento,pg.databaixa) <= v.datavencimento 
                                then nvl(pg.valorpago,0) * nvl(p.fatorconversao,1) 
                              else 
                                0 
                            end ),2)  valor_pago_em_dia
                     , round( ( sum( case  
                                      when nvl(pg.datapagamento,pg.databaixa) <= v.datavencimento 
                                        then nvl(pg.valorpago,0) * nvl(p.fatorconversao,1) 
                                      else 
                                        0 end) / sum(nvl(v.valorpagar,0) * nvl(p.fatorconversao,1))) * 100,2) percentual
                from favorita.vencimentospedidos v                 
                   , favorita.pedidos p                            
                   , filiaisfavorita f                             
                   , ( select sum(valorpago) valorpago             
                            , min(trunc(datapagamento)) datapagamento
                            , min(trunc(databaixa)) databaixa   
                            , idvencimentopedido                    
                       from pagamentospedidos                     
                       where idsituacao = 20                       
                       group by idvencimentopedido ) pg
                where v.idpedido = p.idpedido       
                  and p.datacancelamento is null                            
                  and v.situacaovencimento = 'V'                       
                  and p.idfilialfavorita = f.idfilialfavorita                   
                  and v.idvencimentopedido = pg.idvencimentopedido(+)      
                  and p.idfilialromance = :P79_IDFILIAL      
                  and v.valorpagar > 0                                          
                  and trunc(v.datavencimento) between add_months(trunc(sysdate)-1,-12) and trunc(sysdate-1)
                  and not exists ( select 1
                                   from representantes r
                                   where r.idrepresentante = p.idrepresentante
                                     and r.ativo = 'N')
                group by p.idrepresentante
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P79_IDFILIAL
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 3053101823152920850
        }

