page 89 (
    name: Compras Fornecedores
    alias: COMPRAS-FORNECEDORES
    title: Compras Fornecedores
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }

    region compras-fornecedores (
        name: Compras Fornecedores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select Initcap(p.nomepessoa) as "Fornecedor"
                     , i.quantidadecomprada  as "Qtd. Comprada"
                     , c.dataemissao         as "Data Compra"
                  from favorita.comprastransferencias c
                     , favorita.itenscomprastransferencias i
                     , catal.fornecedores f
                     , catal.pessoas p
                 where f.idfornecedor = c.idfornecedor
                   and f.idpessoa = p.idpessoa
                   and i.idcompratransferencia = c.idcompratransferencia
                   and i.idprodutodetalhado = :P89_IDPRODUTODETALHADO
                   and c.idsituacao not in (-1,40)
                   and c.idfilialfavoritadestino = :P89_IDFILIALFAVORITA
                   and nvl(i.quantidadecomprada,0) > 0 
                 order by 3
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 372297442418229340
        }

        column "Data Compra" (
            type: plainText
            heading {
                heading: Data Compra
            }
            layout {
                sequence: 30
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column Fornecedor (
            type: plainText
            heading {
                heading: Fornecedor
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column "Qtd. Comprada" (
            type: plainText
            heading {
                heading: Qtd. Comprada
                alignment: end
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 3724226 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn "Data Compra" (
                sequence: 3
            )

            displayColumn "Fornecedor" (
                sequence: 1
            )

            displayColumn "Qtd. Comprada" (
                sequence: 2
            )

            aggregate (
                column: "Qtd. Comprada"
            )

        )

    )

    pageItem P89_IDFILIALFAVORITA (
        type: hidden
        layout {
            sequence: 10
            region: @compras-fornecedores
            slot: regionBody
        }
    )

    pageItem P89_IDPRODUTODETALHADO (
        type: hidden
        layout {
            sequence: 20
            region: @compras-fornecedores
            slot: regionBody
        }
    )

)

