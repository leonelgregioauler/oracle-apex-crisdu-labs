    )

    process atualiza-tabela-temporária (
        name: Atualiza Tabela Temporária
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                 pck_bi_fav.prc_rel_analise_compras (:P58_IDPAIS, :P58_FILIAL, :P58_FORNECEDOR, :P58_DESCONTINUADOS, :P58_VENDAS, :APP_USER, :P58_IDFILIALT2, :P58_IDFILIALT3, :P58_IDFILIALT4, 
                                                     :P58_ED1, :P58_ED2, :P58_ED3, :P58_EDFINAL, :P58_IDFILT2, :P58_IDFILT3, :P58_IDFILT4);
                 :P58_QTD_T2 := 'Qtd.'||:P58_IDFILIALT2;
                 :P58_QTD_T3 := 'Qtd.'||:P58_IDFILIALT3;
                 :P58_QTD_T4 := 'Qtd.'||:P58_IDFILIALT4;
                 :P58_QTDD_T2 := 'Cbt.Desej.'||:P58_IDFILIALT2;
                 :P58_QTDD_T3 := 'Cbt.Desej.'||:P58_IDFILIALT3;
                 :P58_QTDD_T4 := 'Cbt.Desej.'||:P58_IDFILIALT4;
                 :P58_COB_T2 := 'Cbt.'||:P58_IDFILIALT2;
                 :P58_COB_T3 := 'Cbt.'||:P58_IDFILIALT3;
                 :P58_COB_T4 := 'Cbt.'||:P58_IDFILIALT4;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 5233131685332221971
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

    process atualizar-a-base (
        name: Atualizar a Base
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  pck_bi_fav.prc_geranecessidadecompra_tabx(null);
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage:
                ```
                Processo concluído com sucesso!
                Aplique os filtros novamente...
                ```
        }
        advanced {
            executionMappingIdentifier: 5233132498565221971
        }
        serverSideCondition {
            type: request=Value
            value: ATUALIZABASE
        }
    )

    process dados-da-atualização (
        name: Dados da Atualização
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    select 'Atualizado ' || to_char(max(data_fim),'dd/mm hh24:mi') dados  
                      into :P58_ATUALIZACAO
                      from log_tmp_rel_compras
                     where data_inicio <> data_fim;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 5233132089489221971
        }
    )

    process listagem-save-interactive-grid-data (
        name: Listagem - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @listagem
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                begin
                 if :APEX$ROW_STATUS = 'U' then
                     --
                     update tmp_rel_analise_compras
                        set cobertura_desejada = :COBERTURA_DESEJADA
                      where idprodutodetalhado = :IDPRODUTODETALHADO
                        and idfilialfavorita = :IDFILIALFAVORITA
                        and usuario = :APP_USER;
                
                     update tmp_rel_analise_compras
                        set cobertura_desejada = :QTD_DESEJADA_T2
                      where idprodutodetalhado = :IDPRODUTODETALHADO
                        and idfilialfavorita = :P58_IDFILT2
                        and usuario = :APP_USER;
                
                     update tmp_rel_analise_compras
                        set cobertura_desejada = :QTD_DESEJADA_T3
                      where idprodutodetalhado = :IDPRODUTODETALHADO
                        and idfilialfavorita = :P58_IDFILT3
                        and usuario = :APP_USER;
                
                     update tmp_rel_analise_compras
                        set cobertura_desejada = :QTD_DESEJADA_T4
                      where idprodutodetalhado = :IDPRODUTODETALHADO
                        and idfilialfavorita = :P58_IDFILT4
                        and usuario = :APP_USER;
                
                   --
                
                    if :COBERTURA_DESEJADA is null then
                         delete produtoscoberturafilial
                          where idprodutodetalhado = :IDPRODUTODETALHADO
                            and idfilial = :IDFILIALFAVORITA;
                     else
                         update produtoscoberturafilial
                            set coberturadesejada = :COBERTURA_DESEJADA
                          where idprodutodetalhado = :IDPRODUTODETALHADO
                            and idfilial = :IDFILIALFAVORITA;
                         if sql%rowcount = 0 then
                          insert into produtoscoberturafilial
                                      ( idfilial
                                      , idprodutodetalhado
                                      , coberturadesejada)
                               values ( :IDFILIALFAVORITA
                                      , :IDPRODUTODETALHADO
                                      , :COBERTURA_DESEJADA);
                         end if;
                    end if;
                
                    if :QTD_DESEJADA_T2 is null then
                         delete produtoscoberturafilial
                          where idprodutodetalhado = :IDPRODUTODETALHADO
                            and idfilial = :P58_IDFILT2;
                     else
                         update produtoscoberturafilial
                            set coberturadesejada = :QTD_DESEJADA_T2
                          where idprodutodetalhado = :IDPRODUTODETALHADO
                            and idfilial = :P58_IDFILT2;
                         if sql%rowcount = 0 then
                          insert into produtoscoberturafilial
                                      ( idfilial
                                      , idprodutodetalhado
                                      , coberturadesejada)
                               values ( :P58_IDFILT2
                                      , :IDPRODUTODETALHADO
                                      , :QTD_DESEJADA_T2);
                         end if;
                    end if;
                
                    if :QTD_DESEJADA_T3 is null then
                         delete produtoscoberturafilial
                          where idprodutodetalhado = :IDPRODUTODETALHADO
                            and idfilial = :P58_IDFILT3;
                     else
                         update produtoscoberturafilial
                            set coberturadesejada = :QTD_DESEJADA_T3
                          where idprodutodetalhado = :IDPRODUTODETALHADO
                            and idfilial = :P58_IDFILT3;
                         if sql%rowcount = 0 then
                          insert into produtoscoberturafilial
                                      ( idfilial
                                      , idprodutodetalhado
                                      , coberturadesejada)
                               values ( :P58_IDFILT3
                                      , :IDPRODUTODETALHADO
                                      , :QTD_DESEJADA_T3);
                         end if;
                    end if;
                
                    if :QTD_DESEJADA_T4 is null then
                         delete produtoscoberturafilial
                          where idprodutodetalhado = :IDPRODUTODETALHADO
                            and idfilial = :P58_IDFILT4;
                     else
                         update produtoscoberturafilial
                            set coberturadesejada = :QTD_DESEJADA_T4
                          where idprodutodetalhado = :IDPRODUTODETALHADO
                            and idfilial = :P58_IDFILT4;
                         if sql%rowcount = 0 then
                          insert into produtoscoberturafilial
                                      ( idfilial
                                      , idprodutodetalhado
                                      , coberturadesejada)
                               values ( :P58_IDFILT4
                                      , :IDPRODUTODETALHADO
                                      , :QTD_DESEJADA_T4);
                         end if;
                    end if;
                
                 end if;
                 commit;
                end;
                ```
        }
        lockRow {
            lockRow: false
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 5233130192757221967
        }
    )

    process zerar-análise (
        name: Zerar Análise
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                 delete produtoscoberturafilial where idfilial = :P58_IDFILIAL;
                 commit;
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage:
                ```
                Processo concluído com sucesso!
                Aplique os filtros novamente...
                ```
        }
        advanced {
            executionMappingIdentifier: 5233132814331221971
        }
        serverSideCondition {
            type: request=Value
            value: APAGAR
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 58
                items: {
                    P58_IDPAIS: &P58_IDPAIS.
                    P58_FILIAL: &P58_FILIAL.
                    P58_FORNECEDOR: &P58_FORNECEDOR.
                    P58_VENDAS: &P58_VENDAS.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

)

