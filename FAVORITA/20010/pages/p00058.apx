page 58 (
    name: Análise de Compras
    title: Análise de Compras
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region dados-da-análise (
        name: Dados da Análise
        type: staticContent
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        comments {
            comments: Base do relatório gerada através de job chamando a pck_bi_fav.prc_geranecessidadecompra_tabx
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region listagem (
        name: Listagem
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.*
                     , case
                        when t.dt_compra is not null then trunc(sysdate-t.dt_compra)
                        else null
                       end prazo
                  from ( 
                        select relatorio.idfornecedor, relatorio.fornecedor
                             , ( select max(ct.dataemissao)
                                   from favorita.itenscomprastransferencias ict
                                      , favorita.vw_comprastransferencias_fav ct
                                  where ict.idcompratransferencia = ct.idcompratransferencia
                                    and ct.ididioma               = 1
                                    and ct.idtipocomptransrem     in ( 0,1) --compra e transferencia
                                    and ct.idsituacao             in (10,11,20,30)
                                    and ct.idfilialfavoritadestino = relatorio.idfilialfavorita
                                    and ict.idprodutodetalhado     = relatorio.idprodutodetalhado
                                 having sum(nvl(ict.quantidadecomprada, 0)) > 0) dt_compra
                             , relatorio.tempo_entrega_em_ciclos
                             , relatorio.prioridade  
                             , relatorio.idfilialfavorita
                             , relatorio.idprodutodetalhado
                             , relatorio.qtd_disponivel
                             , relatorio.qtd_ajustada
                             , relatorio.qtd_ed1
                             , relatorio.qtd_ed2
                             , relatorio.qtd_ed3
                             , relatorio.media_atual
                             , relatorio.venda_considerada
                             , relatorio.qtd_comprada
                             , relatorio.qtd_transferida
                             , relatorio.qtd_edfinal
                             , relatorio.cobertura_ciclo_atual
                             , relatorio.necessidade_compra_ciclo
                             , relatorio.cobertura_desejada
                             , relatorio.necessidade_compra
                             , relatorio.ciclos_morte
                             , relatorio.qtd_disponivel_t2
                             , relatorio.qtd_desejada_t2
                             , relatorio.cobertura_ciclo_t2
                             , relatorio.qtd_disponivel_t3
                             , relatorio.qtd_desejada_t3
                             , relatorio.cobertura_ciclo_t3
                             , relatorio.qtd_disponivel_t4
                             , relatorio.qtd_desejada_t4
                             , relatorio.cobertura_ciclo_t4
                             , relatorio.usuario
                             , relatorio.id_rel_analise_compras
                             , (select count(distinct k.idkitvenda)
                                  from itenskitsvendas ik, kitsvendas k
                                 where ik.idkitvenda = k.idkitvenda 
                                   --and k.ativo = 'S'
                                   and ik.idprodutodetalhado = relatorio.idprodutodetalhado) kits
                          from tmp_rel_analise_compras relatorio
                         where usuario = :APP_USER
                           and :P58_FILIAL is not null) t
                ```
        }
        layout {
            sequence: 50
            parentRegion: @dados-da-análise
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
