                t-Button--stretch
                t-Button--gapTop
            ]
            icon: fa-refresh
        }
        behavior {
            action: redirectUrl
            targetUrl: "javascript:apex.confirm(\"Deseja certeza que deseja atualizar a base?\", {     request:\"ATUALIZABASE\",     showWait:true     });"
            warnOnUnsavedChanges: doNotCheck
        }
    )

