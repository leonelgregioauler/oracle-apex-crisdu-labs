page 33 (
    name: Ranking CallCenter Mês
    title: Ranking CallCenter Mês
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function doLoad()
            {
               setTimeout( "refresh()", 20*1000 );
            }
            
            function refresh()
            {
            window.location.href = window.location;
             apex.submit('TROCAPAGINA');
            }
            
            ```
        executeWhenPageLoads: doLoad();
    }
    security {
        pageAccessProtection: unrestricted
    }

    region mensagem (
        name: Mensagem
        type: staticContent
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region ranking-do-mês (
        name: Ranking do Mês
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.posicao "POSIÇÃO"
                     , case 
                         when t.valores >= 15000.00 then
                           '<font color="green"><b>'||p.nome||'</b></font>'
                         when t.valores between 10000.00 and 14999.99 then
                           '<font color="blue"><b>'||p.nome||'</b></font>'
                         else
                           p.nome
                       end atendente
                     , case 
                         when t.valores >= 15000.00 then
                           '<font color="green"><b>'||to_char(t.valores,'FM999G999G990D00')||'</b></font>'
                         when t.valores between 10000.00 and 14999.99 then
                           '<font color="blue"><b>'||to_char(t.valores,'FM999G999G990D00')||'</b></font>'
                         else
                           to_char(t.valores,'FM999G999G990D00')
                       end valor
                     , t.pedidos
                     , to_char(t.valores/decode(t.pedidos,0,1,t.pedidos),'FM999G999G990D00') "TICKET MÉDIO"
                  from (
                        select rownum posicao
                             , t.*
                          from (
                                select vw.idusuario
                                     , count(vw.idpedido) pedidos
                                     , sum(nvl(valorapagar,0)) valores 
                                  from favorita.vw_dashboardatendimento_bee vw
                                 where extract ( month from vw.dataemissao ) = to_number(to_char(sysdate,'MM'))
                                   and extract ( year from vw.dataemissao ) = to_number(to_char(sysdate,'RRRR'))
                                 group by vw.idusuario
                                 order by 3 desc) t
                         where rownum <= 30) t
                     , catal.usuarios cau
                     , beeadmin.usuarios u
                     , beepeople.vw_pessoas p
                 where t.idusuario = cau.idusuario
                   and cau.usuario = u.nome_login
                   and u.cod_pessoa = p.codigo
                   and u.empresa = p.empresa
                 order by 1
                
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 30
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column ATENDENTE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Atendente
                alignment: center
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column PEDIDOS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Pedidos
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

        column POSIÇÃO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Posição
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column "TICKET MÉDIO" (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Ticket médio
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
        )

        column VALOR (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Valor
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region ranking-do-mês-2 (
        name: Ranking do Mês
        type: chart
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chartAppearance {
            orientation: horizontal
        }
        chartLayout {
            maxWidth: 800
            height: 800
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        animation {
            onDataChange: none
        }
        tooltip {
            showSeriesName: false
            showGroupName: false
            showValue: false
        }
        legend {
            show: false
        }

        series mes (
            name: MES
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select t.posicao "POSIÇÃO"
                         , p.nome atendente
                         , t.valores valor
                         , t.pedidos
                         , to_char(t.valores/decode(t.pedidos,0,1,t.pedidos),'FM999G999G990D00') "TICKET MÉDIO"
                         , 'Total: '||t.valores||' Qtd Pedidos: '||t.pedidos legenda
                      from (
                            select rownum posicao
                                 , t.*
                              from (
                                    select vw.idusuario
                                         , count(vw.idpedido) pedidos
                                         , sum(nvl(valorapagar,0)) valores 
                                      from favorita.vw_dashboardatendimento_bee vw
                                     where extract ( month from vw.dataemissao ) = to_number(to_char(sysdate,'MM'))
                                       and extract ( year from vw.dataemissao ) = to_number(to_char(sysdate,'RRRR'))
                                     group by vw.idusuario
                                     order by 3 desc) t
                             where rownum <= 30) t
                         , catal.usuarios cau
                         , beeadmin.usuarios u
                         , beepeople.vw_pessoas p
                     where t.idusuario = cau.idusuario
                       and cau.usuario = u.nome_login
                       and u.cod_pessoa = p.codigo
                       and u.empresa = p.empresa
                     order by 3 DESC
                    
                    
                    ```
            }
            columnMapping {
                label: ATENDENTE
                value: VALOR
                customTooltip: LEGENDA
                legendTooltip: LEGENDA
            }
            label {
                show: true
                position: aboveMarker
            }
        )

        axis x (
            name: x
            title: Atendente
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            showAxis: false
            title: Valor
            value {
                format: decimal
                scale: log
            }
            minorTicks {
                show: false
            }
        )

    )

    pageItem P33_MENSAGEM (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 10
            region: @mensagem
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<font size=24 color="GREEN"><br> Rumo a Novos Recordes!  </br></font>' return
                from dual
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 32
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: TROCAPAGINA
        }
    )

)

