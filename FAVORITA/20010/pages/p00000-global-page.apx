    region new (
        name: New
        type: staticContent
        source {
            htmlCode:
                ```html
                <style>
                .js-navCollapsed .t-TreeNav .a-TreeView-node--topLevel>.a-TreeView-content.is-hover .a-TreeView-label {
                	visibility: visible;
                	left: 48px;
                	padding: 0 16px;
                	width: auto; 
                	background-color: #0459a1; /* This would be your primary color */
                }
                
                
                </style>
                ```
        }
        layout {
            sequence: 10
            slot: footer
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            excludeTitleFromTranslation: true
        }
        headerAndFooter {
            headerText:
                ```html
                <script>
                    
                  function detectar_dispositivo() { 
                    if( navigator.userAgent.match(/Android/i)
                     || navigator.userAgent.match(/webOS/i)
                     || navigator.userAgent.match(/iPhone/i)
                     || navigator.userAgent.match(/iPad/i)
                     || navigator.userAgent.match(/iPod/i)
                     || navigator.userAgent.match(/BlackBerry/i)
                     || navigator.userAgent.match(/Windows Phone/i)
                    ){
                    var mobile = "M";
                      document.getElementById("P0_DESKTOP_MOBILE").value = mobile;
                    }
                    else {
                      var desktop = "D";
                      document.getElementById("P0_DESKTOP_MOBILE").value = desktop;
                    }
                  }
                    
                
                  
                //retornará 1.234,53
                function formatNumber(value) {
                    value = convertToFloatNumber(value);
                    return value.formatMoney(2, ',', '.');
                }
                
                
                //transforma a entrada em número float
                 var convertToFloatNumber = function(value) {
                     value = value.toString();
                      if (value.indexOf('.') !== -1 && value.indexOf(',') !== -1) {
                          if (value.indexOf('.') <  value.indexOf(',')) {
                             //inglês
                             return parseFloat(value.replace(/,/gi,''));
                          } else {
                            //português
                             return parseFloat(value.replace(/./gi,'').replace(/,/gi,'.'));
                          }      
                      } else {
                         return parseFloat(value);
                      }
                   }
                
                //prototype para formatar a saída  
                Number.prototype.formatMoney = function (c, d, t) {
                    var n = this,
                        c = isNaN(c = Math.abs(c)) ? 2 : c,
                        d = d == undefined ? "." : d,
                        t = t == undefined ? "," : t,
                        s = n < 0 ? "-" : "",
                        i = parseInt(n = Math.abs(+n || 0).toFixed(c)) + "",
                        j = (j = i.length) > 3 ? j % 3 : 0;
                    return s + (j ? i.substr(0, j) + t : "") + i.substr(j).replace(/(\d{3})(?=\d)/g, "$1" + t) + (c ? d + Math.abs(n - i).toFixed(c).slice(2) : "");
                };
                
                </script>
                
                ```
        }
        serverSideCondition {
            type: currentPageNotInList
            pages: [
                52
                53
                54
