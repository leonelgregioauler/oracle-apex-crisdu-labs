    pageItem P0_DESKTOP_MOBILE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @new
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P0_IDFILIALROMANCE (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select '- Ver Tudo -' display_value
                     , 999999999999   return_value
                from dual
                where exists ( select 1 
                               from roman.usuariosgruposatendimento u 
                               where u.usuario = v('APP_USER') )
                union
                select (select initcap(nvl(apelido,nomepessoa))
                        from catal.pessoas 
                        where idpessoa = f.idpessoa )|| CASE when v('APP_USER') in ('EVERTON','GUILHERME','LUIZV','FERNANDO') then
                                                                    ' - '||f.idfilial
                                                                    end display_value
                     , f.idfilial
                from catal.filiais f
                where f.tipofilial = 'D'
                  and f.ativo = 'S'
                  and exists ( select 1
                               from roman.usuariosfiliais u
                               where u.idfilial  = f.idfilial
                                 and u.usuario   = v('APP_USER') )
                union
                select (select initcap(nvl(apelido,nomepessoa))
                        from catal.pessoas 
                        where idpessoa = f.idpessoa )|| CASE when v('APP_USER') in ('EVERTON','GUILHERME','LUIZV','FERNANDO','RICIERYS') then
                                                                    ' - '||f.idfilial
                                                                    end display_value
                     , f.idfilial
                from catal.filiais f
                where idfilial = roman.pck_romance.fnc_filialusuario(v('APP_USER'))
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: "- Selecione a Opção - "
        }
        layout {
            sequence: 10
            region: @empresa-romance
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P0_IDIDIOMA (
        type: hidden
        layout {
            sequence: 30
            region: @new
            slot: regionBody
        }
        source {
            type: staticValue
            staticValue: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P0_IDUSUARIO (
        type: hidden
        layout {
            sequence: 20
            region: @new
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select idusuario
                from usuarios
                where usuario = v('APP_USER')
                ```
        }
        security {
            encryptSessionState: false
        }
    )

)

