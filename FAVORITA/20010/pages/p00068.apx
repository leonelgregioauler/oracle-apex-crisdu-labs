page 68 (
    name: Pagamentos Pedidos
    title: Pagamentos Pedidos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region acompanhamento-dos-pagamentos (
        name: Acompanhamento dos Pagamentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(p.idfilialfavorita) Loja
                     , trunc(pp.datapagamento) datapagamento
                     , count(1) qtd_pagamentos
                     , sum(( select count(1)
                             from pagamentospedidos pag
                             where pag.idvencimentopedido = v.idvencimentopedido
                               and pag.idsituacao = 20
                               and trunc(pag.datapagamento) between to_date(:P68_DATAINICIO,'DD/MM/RRRR') and to_date(:P68_DATAFIM,'DD/MM/RRRR')
                               and pag.idformapagamento in (3,21) )) qtd_pago_cartao
                from pedidos p
                   , vencimentospedidos v
                   , pagamentospedidos pp
                where v.idvencimentopedido = pp.idvencimentopedido
                  and p.idpedido = v.idpedido
                  and ( :P68_IDFILIALFAVORITA is null or p.idfilialfavorita = :P68_IDFILIALFAVORITA )
                  and exists ( select 1
                               from filiaisfavorita ff
                               where ff.idfilialfavorita = p.idfilialfavorita
                                 and ff.tipofilial = 'L' )
                  and trunc(pp.databaixa) between to_date(:P68_DATAINICIO,'DD/MM/RRRR') and to_date(:P68_DATAFIM,'DD/MM/RRRR')
                  and p.datacancelamento is null
                  and ( :P68_TIPOORIGEM in ('T','C') 
                     --or ( :P68_TIPOORIGEM = 'C' and p.origempagamento = 'C' )
                     or ( :P68_TIPOORIGEM = 'S' and pp.origempagamento != 'C' )
                     or ( :P68_TIPOORIGEM = 'P' and pp.origempagamento = :P68_ORIGEM ) )
                group by idfilialfavorita, trunc(pp.datapagamento)
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum pagamento encontrado, verifique os filtros!
        }
        advanced {
            savedReportMappingIdentifier: 1095773045973186604
        }

