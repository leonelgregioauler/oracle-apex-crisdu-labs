            )

            displayColumn LOJA (
                sequence: 1
            )

            displayColumn QTD_PAGAMENTOS (
                sequence: 3
            )

            displayColumn QTD_PAGO_CARTAO (
                sequence: 4
            )

            computation APXWS_CC_001 (
                identifier: C01
                source {
                    expression:
                        ```sql
                        case when  D > 0 then
                           round( (D/C) *100,2) 
                        end
                        ```
                    dataType: number
                }
                label {
                    column: % de PGTO Diferente
                }
            )

            pivotColumn (
                column: DATAPAGAMENTO
                layout {
                    sequence: 1
                }
            )

            pivotRowColumn (
                column: LOJA
                layout {
                    sequence: 1
                }
            )

            pivotAggregate ir-pivot-agg (
                heading: % de PGTO Diferente
                aggregate {
                    function: median
                    column: APXWS_CC_001
                }
                appearance {
                    formatMask: 999G999G999G999G990
                }
                layout {
                    sequence: 3
                }
            )

            pivotAggregate ir-pivot-agg-2 (
                heading: Qtd Pagamentos
                aggregate {
                    function: sum
                    column: QTD_PAGAMENTOS
                    displaySum: true
                }
                appearance {
                    formatMask: 999G999G999G999G990
                }
                layout {
                    sequence: 1
                }
            )

            pivotAggregate ir-pivot-agg-3 (
                heading: Qtd Pago Cartão
                aggregate {
                    function: sum
                    column: QTD_PAGO_CARTAO
                    displaySum: true
                }
                appearance {
                    formatMask: 999G999G999G999G990
                }
                layout {
                    sequence: 2
                }
            )

        )

    )

