    dynamicAction por-origem (
        name: Por Origem
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P68_TIPOORIGEM
        }
        clientSideCondition {
            type: item=value
            item: P68_TIPOORIGEM
            value: P
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P68_ORIGEM
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P68_ORIGEM
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: Go To Page 68
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 68
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

