    region pagamentos-de-pedidos (
        name: "Pagamentos de Pedidos "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idfilialfavorita,
                       nomefilialfavorita,
                       idformapagamento,
                       descricao,
                       numeropedido,
                       vlrpagarped,
                       fatorconversao,
                       valorpagar,
                       valorpago,
                       valorliquido,
                       acrescimos_juros,
                       desconto,
                       valorpagar_conv,
                       valorpago_conv,
                       valorliquido_conv,
                       acrescimo_conv acrescimos_juros_conv,
                       desconto_conv,
                       descorigempagamento
                from vw_pagamentospedidosBI_fav p
                where (p.datapagamento) between to_date(:P68_DATAINICIO||'00:00:00','dd/mm/rrrr hh24:mi:ss') 
                                       and to_date(:P68_DATAFIM||'23:59:59','dd/mm/rrrr hh24:mi:ss')
                  and ( :P68_IDFILIALFAVORITA is null or p.idfilialfavorita = :P68_IDFILIALFAVORITA )
                  and ( :P68_TIPOORIGEM in ('T','C') 
                     --or ( :P68_TIPOORIGEM = 'C' and p.origempagamento = 'C' )
                     or ( :P68_TIPOORIGEM = 'S' and p.origempagamento != 'C' )
                     or ( :P68_TIPOORIGEM = 'P' and p.origempagamento = :P68_ORIGEM ) )
                
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Nenhum Pagamento Localizado
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            savePublicReport: true
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 4417038619941662330
        }

