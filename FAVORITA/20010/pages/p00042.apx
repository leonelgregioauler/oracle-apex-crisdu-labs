    region negociações (
        name: Negociações
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.responsavel
                     , t.total
                     , t.valormeta
                from ( select initcap(p.nomepessoa) responsavel
                            , nvl(( select sum(pn.valorapagar) 
                                        from roman.notasvendas n
                                           , roman.parcelamentosnotasvendas pn
                                        where pn.idnotavenda = n.idnotavenda
                                          and pn.situacao = 'Q'
                                          and pn.idnegociacaoparceiro is null
                                          and extract ( year from pn.databaixa ) = to_char(sysdate,'RRRR')
                                          and extract ( month from pn.databaixa ) = to_char(sysdate,'MM')
                                          and n.responsavelcobranca = u.usuario ),0)
                                + nvl(( select sum(pp.valorapagar) valor
                                        from pedidos p
                                           , parcelamentospedidos pp
                                        where pp.idpedido = p.idpedido
                                          and pp.situacao = 'Q'
                                          and p.idnegociadoraresponsavel = u.idusuario 
                                          and pp.idnegociacaoparceiro is null
                                          and extract ( year from pp.databaixa ) = to_char(sysdate,'RRRR')
                                          and extract ( month from pp.databaixa ) = to_char(sysdate,'MM') ),0)
                                + nvl(( select sum(nvl(b.valorpagonegociacao,b.valorcobrado))
                                        from boletos b
                                        where b.situacao = 'Q'
                                          and not exists ( select 1
                                                           from catal.parcelamentosboletos pb
                                                           where pb.idboleto = b.idboleto )
                                          and extract ( year from b.databaixa ) = to_char(sysdate,'RRRR')
                                          and extract ( month from b.databaixa ) = to_char(sysdate,'MM')
                                          and b.responsavelcobranca = u.usuario ),0)
                                + nvl(( select sum(ppr.valorapagar)
                                        from roman.pepinosrepresentantes pr
                                           , roman.parcelamentospepinosrepres ppr
                                        where ppr.idpepinorepresentante = pr.idpepinosrepresentante
                                          and ppr.situacao = 'Q'
                                          and extract ( year from ppr.databaixa ) = to_char(sysdate,'RRRR')
                                          and extract ( month from ppr.databaixa ) = to_char(sysdate,'MM')
                                          and pr.responsavelcobranca = u.usuario ),0)
                                + nvl(( select sum(pb.VALORAPAGAR)
                                        from boletos b
                                           , catal.parcelamentosboletos pb
                                        where b.responsavelcobranca = u.usuario
                                          and pb.idboleto = b.idboleto
                                          and pb.situacao = 'Q'
                                          and pb.idnegociacaoparceiro is null
                                          and extract ( year from pb.databaixa ) = to_char(sysdate,'RRRR')
                                          and extract ( month from pb.databaixa ) = to_char(sysdate,'MM') ),0) total
                                , nvl( ( select mc.valormeta
                                         from metascobrancas mc
                                         where mc.idusuario = u.idusuario
                                           and extract ( year from mc.datainicio ) = to_char(sysdate,'RRRR')
                                           and extract ( month from mc.datainicio ) = to_char(sysdate,'MM') ),0 ) valormeta
                       from usuarios u
                          , pessoas p
                       where u.idgerente = 80
                         and p.idpessoa  = u.idpessoa 
                         and u.ativo     = 'S'
                         and exists ( select 1
                                      from metascobrancas mc
                                      where mc.idusuario = u.idusuario ) 
                      order by 1 ) t
                where rownum <= 13
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
