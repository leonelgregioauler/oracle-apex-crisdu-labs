            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P39_GERAR (
        type: hidden
        layout {
            sequence: 100
            region: @lista-de-atendimentos
            slot: regionBody
        }
        source {
            type: staticValue
            staticValue: 0
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P39_OPERADOR (
        type: plugin/select
        label {
            label: Operador
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'TODOS' nome, null codigo
                  from dual
                union all
                select nome, codigo
                  from (
                        select p.nome, u.codigo
                          from beeadmin.usuarios u, beepeople.vw_pessoas p, beepeople.vw_pessoas_contratos c, beepeople.vw_pessoas g, beeadmin.usuarios ug
                         where u.cod_pessoa = c.cod_pessoa  
                           and u.empresa = c.empresa 
                           and c.cod_pessoa = p.codigo  
                           and c.empresa = p.empresa  
                           and c.cod_gerente = g.codigo 
                           and c.empresa_gerente = g.empresa 
                           and g.codigo = ug.cod_pessoa 
                           and g.empresa = ug.empresa 
                           and ug.codigo = nvl(:P39_SUPERIOR,ug.codigo)
                           and c.cargo in (select cargo 
                                             from beeadmin.tipos_usuarios_cargos tuc, beeadmin.tipos_usuarios tu 
                                            where tuc.tipo_usuario = tu.codigo 
                                              and tu.perfil_operador = '1') 
                                              and nvl(c.data_desligamento,sysdate) > trunc(sysdate) 
                         order by p.nome
                        )
                ```
            nullDisplayValue: Todos
        }
        cascadingLov {
            parentItems: P39_SUPERIOR
            itemsToSubmit: P39_SUPERIOR
            parentRequired: false
        }
        layout {
            sequence: 30
            region: @lista-de-atendimentos
            slot: regionBody
            alignment: left
            column: 3
            columnSpan: 6
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P39_SMS (
        type: plugin/select
        label {
            label: SMS nos últimos 7 dias
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Não;0,Sim;1
            nullDisplayValue: Desconsiderar
        }
        layout {
            sequence: 80
            region: @lista-de-atendimentos
            slot: regionBody
            alignment: left
            column: 3
            columnSpan: 6
        }
        appearance {
            template: @/optional-above
            templateOptions: [
