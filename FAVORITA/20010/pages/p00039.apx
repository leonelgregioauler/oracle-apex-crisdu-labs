page 39 (
    name: Lista de Atendimentos
    title: Lista de Atendimentos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
    }
    security {
        pageAccessProtection: unrestricted
    }

    region lista-de-atendimentos (
        name: Lista de Atendimentos
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--accent1
                t-Region--hiddenOverflow
            ]
            cssClasses: FILTRO
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region resultado-da-consulta (
        name: Resultado da Consulta
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select po.coluna_19 "ID TAREFA"
                     , po.coluna_20 "TIPO DE TAREFA"
                     , po.coluna_17 "DT.TAREFA"
                     , decode(cli.nome,null,pro.nome,cli.nome) "CLIENTE"
                     , pro.cpf
                     , l.ddd || l.fone "TELEFONE"
                     , to_char(l.data_ligacao,'dd/mm/rrrr hh24:mi') "DT.LIGAÇÃO"
                     , beeadmin.retorna_segundos_em_horas(l.tempo_ligacao) "TEMPO"
                     , decode(css.nome,null,css.nome_crm,css.nome)  "TABULAÇÃO" 
                     , p.nome "ATENDENTE"
                     , ps.nome "SUPERVISOR" 
                     , l.id_gravacao "ID GRAVAÇÃO"
                     , csa.nome "STATUS ANTERIOR"
                     , beeunified.fun_retorna_usuario_tarefa(t.idtarefa) "CRIADA POR" 
                  from beeunified.log_prospects_fones l, beeunified.prospects_original po, beeunified.prospects pro, beeunified.clientes cli, beeunified.campanhas ca 
                     , beedialer.controle_status_sistemas css, beedialer.controle_status_sistemas csa
                     , beeadmin.usuarios u, beeadmin.usuarios us
                     , beepeople.vw_pessoas p, beepeople.vw_pessoas ps 
                     , tarefas t, favorita.vw_clientes_bee c, favorita.vw_representantes_bee rep 
                 where l.cod_campanha = pro.cod_campanha 
                   and l.cod_prospect = pro.codigo 
                   and pro.cod_campanha = po.cod_campanha 
                   and pro.codigo = po.codigo 
                   and po.cod_campanha = ca.codigo 
                   and po.coluna_19 = t.idtarefa(+) 
                   and t.idpessoa = c.idpessoa(+) 
                   and c.idrepresentante = rep.idrepresentante(+) 
                   and pro.cod_campanha = cli.cod_campanha(+) 
                   and pro.codigo = cli.cod_prospect(+) 
                   and pro.cod_status = csa.codigo 
                   and l.cod_status = css.codigo 
                   and l.cod_usuario = u.codigo 
                   and l.cod_superior = us.codigo 
                   and u.cod_pessoa = p.codigo 
                   and u.empresa = p.empresa 
                   and us.cod_pessoa = ps.codigo 
                   and us.empresa = ps.empresa 
                   --and instr(nvl(:P39_TIPOTAREFA,t.idtipotarefa),t.idtipotarefa) > 0
                   and case
                        when :P39_TIPOTAREFA is null then 1
                        when instr(:P39_TIPOTAREFA,t.idtipotarefa) > 0 then 1
                       end = 1
                   --and l.cod_superior = nvl(:P39_SUPERIOR,l.cod_superior) 
                   and case
                        when :P39_SUPERIOR is null then 1
                        when l.cod_superior = :P39_SUPERIOR then 1
                       end = 1
                   --and l.cod_usuario = nvl(:P39_OPERADOR,l.cod_usuario)
                   and case
                        when :P39_OPERADOR is null then 1
                        when l.cod_usuario = :P39_OPERADOR then 1
                       end = 1
                   -- and rep.idfilial = nvl(:P39_FILIAL,rep.idfilial)
                   and case
                        when :P39_FILIAL is null then 1
                        when rep.idfilial = :P39_FILIAL then 1
                       end = 1
                   and case
                         when :P39_SMS = 1 and exists (select 1
                                                         from roman.mensagenssms 
                                                        where datainclusao > trunc(t.datainclusao) - 7 
                                                          and telefone = l.ddd||l.fone) then 1
                         when :P39_SMS = 0 and not exists (select 1
                                                             from roman.mensagenssms 
                                                            where datainclusao > trunc(t.datainclusao) - 7 
                                                              and telefone = l.ddd||l.fone) then 1
                         when :P39_SMS is null then 1
                       end = 1
                   and case
                        when :P39_CLIENTE is null then 1
                        when upper(pro.nome) like upper(:P39_CLIENTE)||'%' then 1
                       end = 1
                
                   and l.data_ligacao between to_date(:P39_DATA_INICIAL,'dd/mm/rrrr hh24:mi:ss') 
                                          and to_date(:P39_DATA_FINAL,'dd/mm/rrrr hh24:mi:ss') 
                
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P39_GERAR
            value: 1
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 2904864762266966635
        }

