                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P39_SUPERIOR (
        type: plugin/select
        label {
            label: Superior
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome, codigo
                  from (
                        select p.nome, u.codigo
                          from beepeople.vw_pessoas p, beeadmin.usuarios u   
                         where u.cod_pessoa = p.codigo   
                           and u.empresa = p.empresa   
                           and (p.codigo,p.empresa) in   
                               (select distinct c.cod_gerente, c.empresa_gerente   
                                  from beepeople.vw_pessoas_contratos c, beeadmin.sistemas_centros_custo scc  
                                 where c.cod_centro_custo = scc.cod_centro_custo  
                                   and nvl(c.data_desligamento,sysdate) >= trunc(sysdate)
                                )  
                         order by p.nome)
                ```
            nullDisplayValue: Todos
        }
        layout {
            sequence: 10
            region: @lista-de-atendimentos
            slot: regionBody
            alignment: left
            column: 3
            columnSpan: 6
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P39_TIPOTAREFA (
        type: plugin/select
        label {
            label: Tipo de Tarefa
            alignment: left
        }
        settings {
            selectListType: multiValueSelectList
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct bn.nome, bn.idtipotarefa codigo
                  from beeunified.grupos_atendimento_baldes gab, beeunified.balde_nomes bn 
                 where gab.cod_balde = bn.codigo 
                 order by 1
                
                ```
            nullDisplayValue: Todos
        }
        layout {
            sequence: 40
            region: @lista-de-atendimentos
            slot: regionBody
            alignment: left
            column: 3
            columnSpan: 6
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    button gerar (
        buttonName: Gerar
        label: Gerar Relatório
        layout {
            sequence: 10
            region: @lista-de-atendimentos
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction escondefiltro (
        name: EscondeFIltro
        execution {
            sequence: 20
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: item=value
            item: P39_GERAR
            value: 1
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $(".FILTRO.a-Collapsible.is-expanded").removeClass('is-expanded').addClass('is-collapsed');
                    $(".FILTRO.a-Collapsible .a-Collapsible-content").hide();
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction geraraction (
        name: GerarAction
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @gerar
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        name: Goto Page 39
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 39
                items: {
                    P39_GERAR: 1
                }
                action: resetPagination
            }
        }
    )

)

