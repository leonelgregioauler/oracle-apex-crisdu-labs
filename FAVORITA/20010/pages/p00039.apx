        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct nomefilial nome, idfilial codigo
                  from vw_gerentes_bee 
                 where ativo = 'S'
                 order by 1
                
                ```
            nullDisplayValue: Todos
        }
        layout {
            sequence: 50
            region: @lista-de-atendimentos
            slot: regionBody
            alignment: left
            column: 3
            columnSpan: 6
        }
        appearance {
