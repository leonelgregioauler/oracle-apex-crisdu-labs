page 38 (
    name: Relatório de Atividade
    title: Relatório de Atividade
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
        browserCache: false
    }
    advanced {
        enableDuplicatePageSubmissions: false
        reloadOnSubmit: always
    }

    region relatório-de-atividade (
        name: Relatório de Atividade
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select op.nome
                     , pc.centro_custo "Centro de Custo"
                     , to_char(ca.data_inicio,'hh24:mi:ss') início
                     , beepeople.retorna_segundos_em_horas((sysdate-ca.data_inicio)*86400) tempo
                     , ca.estacao PA
                  from beeweb.controle_atividade ca
                     , beeadmin.usuarios u
                     , beepeople.controle_frequencia cf
                     , beepeople.vw_pessoas_contratos pc
                     , beepeople.vw_pessoas op
                 where ca.cod_usuario = u.codigo
                   and u.cod_pessoa = cf.cod_pessoa
                   and u.empresa = cf.empresa
                   and cf.cod_pessoa = pc.cod_pessoa
                   and cf.empresa = pc.empresa
                   and pc.cod_pessoa = op.codigo
                   and pc.empresa = op.empresa
                   and ca.data_inicio between cf.data_entrada_efetiva and cf.data_saida_prevista
                   and ca.atividade = :P38_VALOR
                   and ca.data_termino is null
                   and ca.data_inicio > sysdate - (6/24)
                 order by pc.centro_custo
                     , ca.atividade
                     , ca.data_inicio
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--noBorders
                margin-top-lg
                margin-bottom-lg
                margin-left-lg
                margin-right-lg
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 2800906726401892627
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @NOME
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @"Centro de Custo"
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @INÍCIO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @TEMPO
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @PA
                layout {
                    sequence: 5
                }
            )

        )

        column "Centro de Custo" (
            type: textField
            heading {
                heading: Centro de Custo
            }
            layout {
                sequence: 20
            }
            source {
                databaseColumn: Centro de Custo
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column INÍCIO (
            type: textField
            heading {
                heading: Início
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: INÍCIO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column NOME (
            type: textField
            heading {
                heading: Nome
            }
            layout {
                sequence: 10
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: NOME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column PA (
            type: textField
            heading {
                heading: PA
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: PA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column TEMPO (
            type: textarea
            heading {
                heading: Tempo
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: TEMPO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

    )

    pageItem P38_VALOR (
        type: hidden
        layout {
            sequence: 20
            region: @relatório-de-atividade
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

