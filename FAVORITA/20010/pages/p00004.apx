                t-Form--large
                t-Form--stretchInputs
                t-Form--labelsAbove
            ]
        }
    )

    region new (
        name: New
        type: regionDisplaySelector
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            rememberSelection: bySession
        }
    )

    region produtos (
        name: Produtos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                      select p.idproduto
                           , ( select pck_util_fav.fnc_nomefornecedor(idfornecedor ) 
                               from fornecedoresprodutos f
                               where f.idproduto = p.idproduto
                                 and rownum      = 1 ) idfornecedor
                           , pck_util_fav.fnc_nomeproduto(p.idproduto,1,'S') nomeproduto
                           , sum(we.quantidadedisponivel)  disponivel
                           , nvl(sum( venda.quantidadevendida ),0) quantidadevendida
                           , sum( venda.valorapagar       ) valorapagar 
                           , sum( venda.valorcustototal   ) valorcustototal
                           , sum( venda.valorvendatotal   ) valorvendatotal
                           , sum( venda.valorlucrobruto   ) valorlucrobruto  
                           , ( select cc.nomecategoria
                               from favorita.categorias c
                                  , favorita.categoriassite cc
                                  , favorita.produtos pp
                               where c.idcategoria = pp.idcategoria
                                 and cc.idcategoriasite = c.idcategoriasite
                                 and pp.idproduto = p.idproduto) categoriasite
                         , ( select c.nome
                             from favorita.categorias c
                                , favorita.produtos pp
                             where c.idcategoria = pp.idcategoria
                               and pp.idproduto = p.idproduto) categoria
                         -- Substitui a chamada pela pck_util_fav que trazia errado - Cléber 07/07/2026
                         , ( select sc.nome
                             from favorita.subcategorias sc
                             where sc.idsubcategoria = (select pp.idsubcategoria
                                                        from favorita.produtos pp
                                                        where pp.idproduto = p.idproduto)) sub_categoria
                
                         /*, ( select favorita.pck_util_fav.fnc_nomesubcategoria(pp.idsubcategoria,1)
                             from favorita.produtos pp
                             where pp.idproduto = p.idproduto) sub_categoria*/
                      from (     
                              select w.idproduto
                                   , w.idprodutodetalhado       
                                   , w.idestoque
                                   , sum( w.quantidadevendida ) quantidadevendida
                                   , sum( w.valorapagar       ) valorapagar  
                                   , sum( w.valorcustototal   ) valorcustototal
                                   , sum( w.valorvendatotal   ) valorvendatotal
                                   , sum( w.valorlucrobruto   ) valorlucrobruto  
                              from mv_itensvendidos_fav w
                              where w.dataemissao between  to_date(:P4_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P4_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')      
                               and ( :P4_IDFILIALROMANCE  is null or w.idfilialromance  = :P4_IDFILIALROMANCE  ) 
                               /*   or ( :P4_TIPODATA = 3 and exists ( select 1
                                                                       from classificacoespedidos cp
                                                                       where cp.idpedido = fp.idpedido
                                                                         and cp.idcaracteristicapedido = 18 
                                                                         and cp.dataclassificado between  to_date(:P4_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P4_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') ) ) )
                                                                                                                                                                                                                                            */
                              group by w.idproduto
                                     , w.idprodutodetalhado
                                     , w.nomeprodutodetalhado 
                                     , w.idestoque )  venda
                          , produtosdetalhados p
                          , VW_ESTOQUES_FAV_BI_VAL we
                      where we.idprodutodetalhado  = p.idprodutodetalhado
                        and we.idestoque           = venda.idestoque   (+)  
                        and p.idproduto in (select f.idproduto
                                              from fornecedoresprodutos f
                                             where p.idproduto = f.idproduto
                                               and (:P4_IDFORNECEDOR is null or f.idfornecedor = :P4_IDFORNECEDOR))
                        and ( :P4_IDPRODUTO        is null or p.idproduto        = :P4_IDPRODUTO        )
                        and ( :P4_IDPAIS           is null or exists ( select 1
                                                                       from favorita.filiaisfavorita fili
                                                                       where fili.idfilialfavorita = we.idfilialfavorita
                                                                         and fili.idpais           = :P4_IDPAIS  ) )
                        and ( :P4_IDTAGPRODUTO     is null or exists ( select 1
                                                                       from classificacoesprodutos pp
                                                                       where pp.idprodutodetalhado = we.idprodutodetalhado
                                                                         and pp.idtagproduto       = :P4_IDTAGPRODUTO ) )
                        and (( :P4_TIPOFILIAL = 'L' and ( ( :P4_IDFILIALFAVORITA is null and exists ( select 1
                                                                                                      from favorita.filiaisfavorita fili
                                                                                                      where fili.tipofilial       = 'L' 
                                                                                                        and fili.idfilialfavorita = we.idfilialfavorita-- w.idfilialfavorita_est 
                                                                                                        and fili.idpais           = :P4_IDPAIS ) ) 
                                                        or we.idfilialfavorita /*w.idfilialfavorita_est*/  = :P4_IDFILIALFAVORITA )  ) 
                          or ( :P4_TIPOFILIAL = 'E' and ( ( :P4_IDFILIALFAVORITA  is null and exists ( select 1
                                                                                                       from favorita.filiaisfavorita fili
                                                                                                       where fili.tipofilial       = 'E'
                                                                                                         and fili.idfilialfavorita =  we.idfilialfavorita-- w.idfilialfavorita_est 
                                                                                                         and fili.idpais           = :P4_IDPAIS) )
                                                          or (  we.idfilialfavorita /*w.idfilialfavorita_est*/  = :P4_IDFILIALFAVORITA ) 
                                                                                                               /* 16/06/2020 -- retirada opção de mostrar a venda das lojas junto quando for filtrado CD
                                                                                                                    Reunião com Ezequias, Everton, Patricia e Bruno 
                                                                                                                   in ( select afr.IDFILIALFAVORITADESTINO
                                                                                                                     from favorita.atendimentosestoques afr
                                                                                                                     where afr.idfilialfavoritaorigem = :P4_IDFILIALFAVORITA  ) */ ) ) 
                          or ( :P4_TIPOFILIAL = 'O' and ( (:P4_IDFILIALFAVORITA is null and not exists ( select 1
                                                                                                         from favorita.filiaisfavorita fili
                                                                                                         where fili.tipofilial in ('E', 'L' )
                                                                                                           and fili.idfilialfavorita = we.idfilialfavorita /*w.idfilialfavorita_est*/ )) 
                                                        or   we.idfilialfavorita /*w.idfilialfavorita_est*/  = :P4_IDFILIALFAVORITA )  )
                          or ( :P4_TIPOFILIAL = 'T' ))    
                      group by p.idproduto 
                order by 2
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P4_TIPORELATORIO
            value: P
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 4530316577819565116
        }

