    button ranking-emana (
        buttonName: RANKING_EMANA
        label: Ranking Emana
        layout {
            sequence: 10
            region: @especiais
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 67
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation valida-data (
        name: Valida Data
        execution {
            sequence: 10
        }
        validation {
            language: sql
            sqlExpression: :P4_DATAINICIO is not null and :P4_DATAFIM is not null
        }
        error {
            errorMessage: Informe a data inicio e fim!
        }
    )

    branch (
        name: Go To Page 4
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 4
                items: {
                    P4_IDPAIS: &P4_IDPAIS.
                    P4_TIPOFILIAL: &P4_TIPOFILIAL.
                    P4_IDFILIALFAVORITA: &P4_IDFILIALFAVORITA.
                    P4_IDFILIALROMANCE: &P4_IDFILIALROMANCE.
                    P4_IDFORNECEDOR: &P4_IDFORNECEDOR.
                    P4_IDPRODUTO: &P4_IDPRODUTO.
                    P4_IDPRODUTODETALHADO: &P4_IDPRODUTODETALHADO.
                    P4_IDTAGPRODUTO: &P4_IDTAGPRODUTO.
                    P4_DATAINICIO: &P4_DATAINICIO.
                    P4_DATAFIM: &P4_DATAFIM.
                    P4_TIPORELATORIO: &P4_TIPORELATORIO.
                    P4_FILTRAR: S
                }
                clearCache: 4
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

