page 4 (
    name: Relatório de itens vendidos
    title: Relatório de itens vendidos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region definições (
        name: Definições
        type: staticContent
        source {
            htmlCode: Informações de venda e estoques são atualizadas de acordo com os horários acima.
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region especiais (
        name: Especiais
        type: staticContent
