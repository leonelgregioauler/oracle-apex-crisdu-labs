        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 45313116 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CARACTERISTICA (
                sequence: 6
            )

            displayColumn CATEGORIA (
                sequence: 13
            )

            displayColumn CATEGORIASITE (
                sequence: 12
            )

            displayColumn COR (
                sequence: 5
            )

