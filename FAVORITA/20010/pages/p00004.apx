    pageItem P4_HORARIOATUALIZACAO (
        type: displayOnly
        label {
            label: Venda atualizada em
            alignment: left
        }
        layout {
            sequence: 10
            region: @definições
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select trim(to_char(NVL(last_start_date,next_run_date-1),'dd/mm/rrrr hh24:mi:ss'))||'. Próxima atualização: '||trim(to_char(next_run_date,'DD/MM/RRRR HH24:MI:SS'))||'.' a
                from all_scheduler_jobs
                where job_name = 'DBMS_JOB$_7011736'
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P4_HORARIOATUALIZACAO_ESTOQUE (
        type: displayOnly
        label {
            label: Estoques Atualizados em
            alignment: left
        }
        layout {
            sequence: 20
            region: @definições
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select trim(to_char(NVL(last_start_date,next_run_date-1),'dd/mm/rrrr hh24:mi:ss'))||'. Próxima atualização: '||trim(to_char(next_run_date,'DD/MM/RRRR HH24:MI:SS'))||'.' a
                from all_scheduler_jobs
                where job_name = 'MV_RF$J_0_S_47860'
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P4_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Estoque Favorita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) as d,
                       idfilialfavorita as r
                  from filiaisfavorita
                  where ( tipofilial = :P4_TIPOFILIAL 
                            or :P4_TIPOFILIAL  = 'T'
                            or ( :P4_TIPOFILIAL  = 'O'  and tipofilial not in ('E','L')) )
                
                     and idpais = :P4_IDPAIS
                 order by 1
                ```
            nullDisplayValue: - Todas -
        }
        cascadingLov {
            parentItems: [
                P4_TIPOFILIAL
                P4_IDPAIS
            ]
            itemsToSubmit: [
                P4_TIPOFILIAL
                P4_IDPAIS
            ]
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P4_IDFILIALROMANCE (
        type: plugin/select
        label {
            label: Distrib. Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct 
                       pck_util_fav.fnc_nomefilialromance(afr.idfilialdestino) as d,
                       afr.idfilialdestino as r
                  from atendimentosfiliaisrmc afr
                     , filiaisfavorita f
                 where afr.idfilialfavoritaorigem = f.idfilialfavorita
                  -- and (:P4_IDFILIALFAVORITA = -1 or f.idfilialfavorita = :P4_IDFILIALFAVORITA )
                   and idpais = :P4_IDPAIS
                 order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Todas Filiais -
        }
        cascadingLov {
            parentItems: P4_IDFILIALFAVORITA
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P4_IDFORNECEDOR (
        type: popupLov
        label {
            label: Fornecedores
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct cp.nomepessoa select_value
                     , cd.idfornecedor return_value
                from catal.fornecedores   cd
                   , catal.pessoas        cp
                   , FAVORITA.fornecedoresprodutos fr
                where cd.idpessoa     = cp.idpessoa
                  and cd.idfornecedor = fr.idfornecedor 
                order by 1
                ```
            nullDisplayValue: " - Todos - "
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P4_IDPAIS (
        type: selectList
        label {
            label: País
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct nome  display_value
                     , p.idpais  return_value
                from roman.paises p
                   , favorita.filiaisfavorita f
                where f.idpais = p.idpais
                order by nome
                ```
            displayExtraValues: false
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P4_IDPRODUTO (
        type: popupLov
        label {
            label: Produtos
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select referencia||'-'||nomeproduto display_value
                  , idproduto
                from favorita.vw_produtos_fav w
                where ididioma = 1
                  and ( :P4_IDFORNECEDOR is null or exists ( select 1
                                                                 from favorita.fornecedoresprodutos f
                                                                 where f.idproduto    = w.idproduto
                                                                   and f.idfornecedor = :P4_IDFORNECEDOR ) )
                order by nomeproduto
                ```
            displayExtraValues: false
            nullDisplayValue: " - Todos - "
        }
        cascadingLov {
            parentItems: P4_IDFORNECEDOR
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

