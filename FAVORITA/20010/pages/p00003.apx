page 3 (
    name: Vencimentos
    title: Vencimentos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region previsão-de-recebimento (
        name: Previsão de Recebimento
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select trunc(datavencimento) datavencimento
                     , to_char(s.datavencimento,'MM') nrmes
                     , to_char(s.datavencimento,'MONTH') mes
                     , s.semana
                     , catal.pck_util.fnc_idsemana(s.semana) ordemsemana
                     , sum(valorpagar) previsaorecebimento
                from vw_vencimentospedidos_fav s
                where s.codsituacaovencimento = 'V'--válido
                group by trunc(datavencimento)
                       , to_char(s.datavencimento,'MONTH')
                       , to_char(s.datavencimento,'MM') 
                       , s.semana
                order by 1 DESC
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 246522574060817767
        }

        column DATAVENCIMENTO (
            type: plainText
            heading {
                heading: Data
            }
            layout {
                sequence: 1
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: A
            }
        )

        column MES (
            type: plainText
            heading {
                heading: Mês
                alignment: center
            }
            layout {
                sequence: 12
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column NRMES (
            type: plainText
            heading {
                heading: NR
                alignment: center
            }
            layout {
                sequence: 22
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column ORDEMSEMANA (
            type: plainText
            heading {
                heading: Ordem
                alignment: center
            }
            layout {
                sequence: 42
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column PREVISAORECEBIMENTO (
            type: plainText
            heading {
                heading: Valor Previsto
                alignment: end
            }
            layout {
                sequence: 2
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column SEMANA (
            type: plainText
            heading {
                heading: Semana
                alignment: center
            }
            layout {
                sequence: 32
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 2465242 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAVENCIMENTO (
                sequence: 1
            )

            displayColumn MES (
                sequence: 2
            )

            displayColumn NRMES (
                sequence: 4
            )

            displayColumn ORDEMSEMANA (
                sequence: 6
            )

            displayColumn PREVISAORECEBIMENTO (
                sequence: 3
            )

            displayColumn SEMANA (
                sequence: 5
            )

            aggregate (
                column: PREVISAORECEBIMENTO
            )

        )

    )

    region recebido (
        name: Recebido
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select trunc(v.datapagamento) datapagamento
                     , to_char(v.datapagamento,'MM') nrmes
                     , to_char(v.datapagamento,'MONTH') mes
                     , catal.pck_util.fnc_semanaid(v.idsemanapago) semanapago
                     , sum(valorpago) valorpago
                from vw_pagamentospedidos_fav v
                where v.valorpago > 0
                  and ididioma = 1
                group by trunc(v.datapagamento)
                       , to_char(v.datapagamento,'MM')
                       , to_char(v.datapagamento,'MONTH')
                       , v.idsemanapago
                order by 1 DESC
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent7
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 246527882057822202
        }

        column DATAPAGAMENTO (
            type: plainText
            heading {
                heading: "Data "
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: A
            }
        )

        column MES (
            type: plainText
            heading {
                heading: Mês
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column NRMES (
            type: plainText
            heading {
                heading: Nr
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column SEMANAPAGO (
            type: plainText
            heading {
                heading: Semana Pago
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column VALORPAGO (
            type: plainText
            heading {
                heading: Valor Pago
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 2465345 (
            visibility: primaryDefault
            view {
                groupBy: true
                default: groupBy
                rowsPerPage: 50
            }

            displayColumn DATAPAGAMENTO (
                sequence: 1
            )

            displayColumn MES (
                sequence: 2
            )

            displayColumn NRMES (
                sequence: 5
            )

            displayColumn SEMANAPAGO (
                sequence: 3
            )

            displayColumn VALORPAGO (
                sequence: 4
            )

            aggregate (
                column: SUM(VALORPAGO)
            )

            groupByColumn (
                column: NRMES
                layout {
                    sequence: 1
                }
            )

            groupByColumn (
                column: MES
                layout {
                    sequence: 2
                }
            )

            groupByAggregate (
                heading: Valor Recebido
                aggregate {
                    column: VALORPAGO
                    displaySum: true
                }
                appearance {
                    formatMask: 999G999G999G999G990D00
                }
                layout {
                    sequence: 1
                }
            )

            groupBySort (
                column: NRMES
                sort {
                    sequence: 1
                }
            )

        )

    )

)

