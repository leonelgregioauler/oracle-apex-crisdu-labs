        savedReport 30600751 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100000
            }

            displayColumn "% Saldo Devedor até 90 dias" (
                sequence: 4
            )

            displayColumn DISTRIBUIDOR (
                sequence: 1
            )

            displayColumn "Saldo Devedor até 90 dias" (
                sequence: 3
            )

            displayColumn TOTAL_PAGAR (
                sequence: 2
            )

            sort (
                column: DISTRIBUIDOR
                sort {
                    sequence: 1
                }
            )

            highlight ir-condition (
                name: Azul
                condition {
                    column: "% Saldo Devedor até 90 dias"
                    operator: <
                    value: 9
                }
                highlight {
                    type: cell
                }
                colors {
                    background: #99CCFF
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-2 (
                name: Vermelho
                condition {
                    column: "% Saldo Devedor até 90 dias"
                    operator: >=
                    value: 14
                }
                highlight {
                    type: cell
                }
                colors {
                    background: #FF7755
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-3 (
                name: Verde
                condition {
                    column: "% Saldo Devedor até 90 dias"
                    operator: between
                    from: 9
                    to: 13.99999000
                }
                highlight {
                    type: cell
                }
                colors {
                    background: #99FF99
                }
                execution {
                    sequence: 10
                }
            )

        )

    )

    region inadimplência-por-franquia (
        name: Inadimplência por Franquia
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idfilialromance
                     , t.franquia
                     , (total_pagar) total_pagar
                     , ((t.total_pagar) - (valor_pago_emdia) - (pago_30dias) - (pago_42dias) - (pago_90dias) )   "Saldo Devedor até 90 dias"
                     , round ( ((t.total_pagar) - (valor_pago_emdia) - (pago_30dias) - (pago_42dias) - (pago_90dias)) / (t.total_pagar) *100 ,2) "% Saldo Devedor até 90 dias"
                from (
                      select p.idfilialromance 
                           , favorita.pck_util_fav.fnc_nomefilialromance(p.idfilialromance) franquia
                           , count(1) Qtd_Vencimentos 
                           , sum(nvl(v.valorpagar,0) * nvl(p.fatorconversao,1)) total_pagar 
                           , sum( nvl(pg.valorpago,0) * nvl(p.fatorconversao,1)) total_pago
                           , sum( case  
                                    when nvl(pg.datapagamento,pg.databaixa) <= v.datavencimento 
                                      then nvl(pg.valorpago,0) * nvl(p.fatorconversao,1) 
                                    else 
                                      0 
                                  end )  valor_pago_emdia
                           , sum( case 
                                    when nvl(pg.datapagamento,pg.databaixa) between v.datavencimento + 1 and v.datavencimento + 30 
                                      then nvl(pg.valorpago,0) * nvl(p.fatorconversao,1) 
                                    else 
                                      0 
                                  end ) pago_30dias
                           , sum( case  
                                    when nvl(pg.datapagamento,pg.databaixa) between v.datavencimento + 31 and v.datavencimento + 42 
                                      then nvl(pg.valorpago,0) * nvl(p.fatorconversao,1) 
                                    else 
                                      0 
                                  end ) pago_42dias
                           , sum( case 
                                    when nvl(pg.datapagamento,pg.databaixa) between v.datavencimento + 43 and v.datavencimento + 90 
                                      then nvl(pg.valorpago,0) * nvl(p.fatorconversao,1) 
                                    else 
                                      0 
                                  end ) pago_90dias
                       from favorita.vencimentospedidos v                 
                          , favorita.pedidos p                            
                          , filiaisfavorita f                             
                          , (select sum(valorpago) valorpago             
                                  , min(trunc(datapagamento)) datapagamento
                                  , min(trunc(databaixa)) databaixa   
                                  , idvencimentopedido                    
                               from pagamentospedidos                     
                              where idsituacao = 20                       
                              group by idvencimentopedido ) pg
                      where v.idpedido = p.idpedido 
                        and p.idfilialromance is not null
                        and p.idfilialromance not in (1216,1258,1220,1063,200)                                     
                        and p.datacancelamento is null                            
                        and v.situacaovencimento = 'V'                       
                        and p.idfilialfavorita = f.idfilialfavorita                   
                        and v.idvencimentopedido = pg.idvencimentopedido(+)    
                        and v.valorpagar > 0                                          
                        and v.datavencimento between add_months(trunc(sysdate)-1,-12) and trunc(sysdate-1)
                        and not exists ( select 1
                                           from representantes r
                                           where r.idrepresentante = p.idrepresentante
                                             and r.ativo = 'N')
                      group by p.idfilialromance ) t
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
