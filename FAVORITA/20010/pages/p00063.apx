    region total-por-valor-de-venda-por-filial (
        name: %Total Por Valor de Venda Por Filial
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome filial
                     , (d.qtdromance) QuantidadeRom
                     , (d.valor_romance) ValorRom
                     , (d.qtd_ped) QuantidadeFav
                     , (d.valor_ped) ValorFav
                     , case 
                         when (d.qtdromance) > 0 then
                           round(((d.qtd_ped)/(d.qtdromance))*100,2) 
                         else 
                           round(((d.qtdromance)/(1))*100,2) 
                         end PercQtd
                     , case 
                         when (d.valor_romance) > 0 then
                           round(((d.valor_ped)/(d.valor_romance))*100,2) 
                         else 
                           round(((d.valor_ped)/(1))*100,2) 
                       end PercVlr
                from ( 
                      select f.nome  
                           , nvl( ( select count(distinct idvendedora)
                                    from roman.notasvendas nv
                                    where nv.idfilial = f.idfilial
                                      and nv.idsituacaonotavenda = 4
                                      and nv.idsemanacobranca between :P63_IDSEMANA and :P63_IDSEMANA_FIM ),0) qtdromance
                           , nvl( ( select round(sum((nv.valortotalvendalqd * nv.fatorconversao)),2)
                                    from roman.notasvendas nv
                                    where nv.idfilial = f.idfilial
                                      and nv.idsituacaonotavenda = 4
                                      and nv.idsemanacobranca between :P63_IDSEMANA and :P63_IDSEMANA_FIM ),0) valor_romance
                           , nvl( ( select count(distinct idvendedora) qtd
                                    from pedidos p
                                    where p.idsituacaoentrega >= 20000    
                                      and p.idfilialromance = f.idfilial
                                      and p.tipopedido in ('P','V')
                                      and not exists ( select 1
                                                       from representantes r
                                                          , catal.vendedoras v
                                                       where r.idpessoa = v.idpessoa
                                                         and v.idvendedora = p.idvendedora)
                                      and not exists ( select 1
                                                       from gerentes g 
                                                          , catal.vendedoras v
                                                       where g.idpessoa = v.idpessoa 
                                                         and v.idvendedora = p.idvendedora)
                                      and exists ( select 1
                                                   from roman.notasvendas nv
                                                   where nv.idnotavenda = p.idnotavenda
                                                     and nv.idsituacaonotavenda = 4
                                                     and nv.idsemanacobranca between :P63_IDSEMANA and :P63_IDSEMANA_FIM  )
                                      and not exists ( select 1
                                                       from favorita.classificacoespedidos cp
                                                       where cp.idpedido = p.idpedido
                                                         and cp.idcaracteristicapedido = 5
                                                         and ( select sum(vp.valorpagar)
                                                               from favorita.vencimentospedidos vp
                                                               where vp.idpedido = cp.idpedido
                                                                 and vp.situacaovencimento = 'V') = 0)
                                      and p.datacancelamento is null ),0 ) qtd_ped
                           , nvl( ( select round(sum(p.valorapagar * p.fatorconversao),2)
                                    from pedidos p
                                    where p.idsituacaoentrega >= 20000    
                                      and p.idfilialromance = f.idfilial
                                      and p.tipopedido in ('P','V')
                                      and not exists ( select 1
                                                       from representantes r
                                                          , catal.vendedoras v
                                                       where r.idpessoa = v.idpessoa
                                                         and v.idvendedora = p.idvendedora)
                                      and not exists ( select 1
                                                       from gerentes g 
                                                          , catal.vendedoras v
                                                       where g.idpessoa = v.idpessoa 
                                                         and v.idvendedora = p.idvendedora)
                                      and exists ( select 1
                                                   from roman.notasvendas nv
                                                   where nv.idnotavenda = p.idnotavenda
                                                     and nv.idsituacaonotavenda = 4
                                                     and nv.idsemanacobranca between :P63_IDSEMANA and :P63_IDSEMANA_FIM )
                                      and not exists ( select 1
                                                       from favorita.classificacoespedidos cp
                                                       where cp.idpedido = p.idpedido
                                                         and cp.idcaracteristicapedido = 5
                                                         and ( select sum(vp.valorpagar)
                                                               from favorita.vencimentospedidos vp
                                                               where vp.idpedido = cp.idpedido
                                                                 and vp.situacaovencimento = 'V') = 0)
                                      and p.datacancelamento is null ),0 ) valor_ped
                      from roman.vw_filiais f
                      where f.tipofilial = 'D'
                        and f.ativo = 'S'
                        and ( :P63_PESQUISA_POR = 'T'
                            or ( :P63_PESQUISA_POR = 'E' and f.idfilial = :P63_IDFILIAL )
                            or ( :P63_PESQUISA_POR = 'P' and f.ididioma = :P63_IDPAIS ) ) ) d
                ```
        }
