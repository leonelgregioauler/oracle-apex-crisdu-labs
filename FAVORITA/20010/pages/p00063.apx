    region relatório-geral-clientes-romance (
        name: Relatório Geral Clientes Romance
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.filial
                     , d.quantidade
                     , d.valor
                     , ( select sum(fr.totalgeral)
                         from fechamentorepresentantes fr
                            , fechamentossemanais f
                         where fr.idfilial               = d.idfilial
                           and fr.idfechamentopontuacao  = f.idfechamento
                           and f.idsemana between :P63_IDSEMANA and :P63_IDSEMANA_FIM ) totalcobrado
                from (
                      select roman.pck_romance.fnc_nomefilial(n.idfilial) filial
                           , n.idfilial
                           , count(distinct v.idvendedora) Quantidade
                           , round(sum((n.valortotalvendalqd * n.fatorconversao)),2) Valor
                      from roman.notasvendas n
                         , vendedoras v
                      where n.idvendedora = v.idvendedora
                        and n.idsemanacobranca between :P63_IDSEMANA and :P63_IDSEMANA_FIM
                        and ( :P63_PESQUISA_POR = 'T'
                          or ( :P63_PESQUISA_POR = 'E' and n.idfilial = :P63_IDFILIAL )
                          or ( :P63_PESQUISA_POR = 'P' and exists ( select 1
                                                                    from roman.vw_filiais f
                                                                    where f.idfilial = n.idfilial
                                                                      and f.ididioma = :P63_IDPAIS ) ) )
                        and not exists ( select 1
                                         from representantes r
                                         where r.idpessoa = v.idpessoa )
                        and not exists ( select 1
                                         from gerentes g 
                                         where g.idpessoa = v.idpessoa )
                        and n.idsituacaonotavenda != 5
                      group by n.idfilial ) d
                ```
            pageItemsToSubmit: [
                P63_IDSEMANA
                P63_IDSEMANA_FIM
            ]
        }
        layout {
            sequence: 70
            slot: body
            startNewRow: false
        }
        appearance {
