    region relatório-por-distribuidora-clientes-romance (
        name: Relatório Por Distribuidora Clientes Romance
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                     , count(distinct v.idvendedora) Quantidade
                     , round(sum((n.valortotalvendalqd * n.fatorconversao)),2) Valor
                     , ( select sum(fr.totalgeral)
                         from fechamentorepresentantes fr
                            , fechamentossemanais f
                         where fr.idrepresentante = n.idrepresentante
                           and fr.idfechamentopontuacao    = f.idfechamento
                           and f.idsemana between :P63_IDSEMANA and :P63_IDSEMANA_FIM ) totalcobranca
                from roman.notasvendas n
                   , vendedoras v
                where v.idvendedora = n.idvendedora
                  and n.idsemanacobranca between :P63_IDSEMANA and :P63_IDSEMANA_FIM
                  and ( :P63_IDFILIAL is null or n.idfilial = :P63_IDFILIAL )
                  and n.idsituacaonotavenda = 4
                  and not exists ( select 1
                                   from representantes r
                                   where r.idpessoa = v.idpessoa )
                  and not exists ( select 1
                                   from gerentes g 
                                   where g.idpessoa = v.idpessoa )
                group by n.idrepresentante
                ```
            pageItemsToSubmit: [
                P63_IDSEMANA
                P63_IDSEMANA_FIM
                P63_IDFILIAL
