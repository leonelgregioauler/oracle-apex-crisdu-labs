    region clientes-com (
        name: Clientes com 40%
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Com Pedido' tipo
                     , roman.pck_romance.fnc_nomefilial(p.idfilialromance) filial
                     , count(distinct p.idvendedora) Quantidade
                     , round(sum((p.valorapagar * p.fatorconversao)),2) Valor
                     , p.idfilialromance
                from favorita.pedidos p
                   , vendedoras v
                   , roman.notasvendas nv
                where v.idvendedora  = p.idvendedora
                  and nv.idvendedora = p.idvendedora
                  and p.idnotavenda  = nv.idnotavenda
                  and ( :P63_PESQUISA_POR = 'T'
                    or ( :P63_PESQUISA_POR = 'E' and p.idfilialromance = :P63_IDFILIAL )
                    or ( :P63_PESQUISA_POR = 'P' and exists ( select 1
                                                              from roman.vw_filiais f
                                                              where f.idfilial = p.idfilialromance
                                                                and f.ididioma = :P63_IDPAIS ) ) )
                                                              
                  and p.idsituacaoentrega != 50
                  and p.idsituacaoentrega >= 20000
                  and p.tipopedido in ('P','V')
                  and not exists ( select 1
                                   from representantes r
                                   where r.idpessoa = v.idpessoa )
                  and not exists ( select 1
                                   from gerentes g 
                                   where g.idpessoa = v.idpessoa )
                  and not exists ( select 1
                                   from favorita.classificacoespedidos cp
                                   where cp.idpedido = p.idpedido
                                     and cp.idcaracteristicapedido = 5
                                     and ( select sum(vp.valorpagar)
                                           from favorita.vencimentospedidos vp
                                           where vp.idpedido = cp.idpedido
                                             and vp.situacaovencimento = 'V') = 0)
                  and p.datacancelamento is null
                  and nv.idsemanacobranca between :P63_IDSEMANA and :P63_IDSEMANA_FIM
                  and nv.idsituacaonotavenda = 4 
                group by p.idfilialromance
                union
                select 'Manualmente' tipo
                     , roman.pck_romance.fnc_nomefilial(nv.idfilial) filial
                     , count(distinct nv.idvendedora) Quantidade
                     , 0 Valor
                     , nv.idfilial
                from vendedoras v
                   , roman.notasvendas nv
                where v.idvendedora  = nv.idvendedora
                  and nv.perccomissao = 40
                  and not exists ( select 1
                                   from pedidos p
                                   where p.idnotavenda = nv.idnotavenda )
                  and ( :P63_PESQUISA_POR = 'T'
                    or ( :P63_PESQUISA_POR = 'E' and nv.idfilial = :P63_IDFILIAL )
                    or ( :P63_PESQUISA_POR = 'P' and exists ( select 1
                                                              from roman.vw_filiais f
                                                              where f.idfilial = nv.idfilial
                                                                and f.ididioma = :P63_IDPAIS ) ) )
                  and not exists ( select 1
                                   from representantes r
                                   where r.idpessoa = v.idpessoa )
                  and not exists ( select 1
                                   from gerentes g 
                                   where g.idpessoa = v.idpessoa )
                  and nv.idsemanacobranca between :P63_IDSEMANA and :P63_IDSEMANA_FIM
                  and nv.idsituacaonotavenda = 4 
                group by nv.idfilial
                ```
            pageItemsToSubmit: [
                P63_IDSEMANA
                P63_IDSEMANA_FIM
            ]
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 5273687346564101811
        }

