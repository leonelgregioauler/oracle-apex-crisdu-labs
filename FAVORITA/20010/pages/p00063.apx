    pageItem P63_PERCQUANTIDADE (
        type: displayOnly
        label {
            label: % Quantidade Brasil
            alignment: left
        }
        layout {
            sequence: 10
            region: @total-por-valor-de-venda-por-filial
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select case 
                        when sum(QuantidadeRom) > 0 then
                          round((sum(QuantidadeFav)/sum(QuantidadeRom))*100,2) 
                        else 
                          round((sum(QuantidadeRom)/sum(1))*100,2) 
                        end PercQtd
                from ( 
                      select f.nome filial
                           , (nota.qtd) QuantidadeRom
                           , (nota.valor) ValorRom
                           , (pedido.qtd) QuantidadeFav
                           , (pedido.valor) ValorFav
                           , case 
                              when (nota.qtd) > 0 then
                                round(((pedido.qtd)/(nota.qtd))*100,2) 
                              else 
                                round(((nota.qtd)/(1))*100,2) 
                              end PercQtd
                           , case 
                              when (nota.valor) > 0 then
                                round(((pedido.valor)/(nota.valor))*100,2) 
                              else 
                                round(((pedido.valor)/(1))*100,2) 
                              end PercVlr
                      from roman.vw_filiais f
                         , ( select nv.idfilial
                                  , count(distinct nv.idvendedora) qtd
                                  , round(sum((nv.valortotalvendalqd * nv.fatorconversao)),2) valor
                             from roman.notasvendas nv
                             where ( :P63_IDFILIAL is null or nv.idfilial = :P63_IDFILIAL )
                               and nv.idsemanacobranca between :P63_IDSEMANA and :P63_IDSEMANA_FIM
                               and nv.idsituacaonotavenda != 5
                             group by nv.idfilial ) nota
                         , ( select p.idfilialromance idfilial
                                  , count(distinct p.idvendedora) qtd
                                  , round(sum((p.valorapagar * p.fatorconversao)),2) valor
                             from pedidos p
                             where p.idsituacaoentrega != 50
                               and (:P63_IDFILIAL is null or p.idfilialromance = :P63_IDFILIAL )
                               and p.tipopedido in ('P','V')
                               and not exists ( select 1
                                                from favorita.classificacoespedidos cp
                                                where cp.idpedido = p.idpedido
                                                  and cp.idcaracteristicapedido = 5
                                                  and ( select sum(vp.valorpagar)
                                                        from favorita.vencimentospedidos vp
                                                        where vp.idpedido = cp.idpedido
                                                          and vp.situacaovencimento = 'V') = 0)
                               and p.datacancelamento is null
                               and pck_util.fnc_idsemanadata(p.dataentrega) between :P63_IDSEMANA and :P63_IDSEMANA_FIM
                             group by p.idfilialromance ) pedido
                      where f.ativo     = 'S'
                        and f.tipofilial = 'D'
                        and f.idfilial = nota.idfilial(+)
                        and f.idfilial = pedido.idfilial(+)
                        and ( :P63_IDFILIAL is null or f.idfilial = :P63_IDFILIAL ) ) fil
                ```
            used: always
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P63_PERCQUANTIDADE_AL (
        type: displayOnly
        label {
            label: % Quantidade America Latina
            alignment: left
        }
        layout {
            sequence: 20
            region: @total-por-valor-de-venda-por-filial
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select case 
                        when sum(QuantidadeRom) > 0 then
                          round((sum(QuantidadeFav)/sum(QuantidadeRom))*100,2) 
                        else 
                          round((sum(QuantidadeRom)/sum(1))*100,2) 
                        end PercQtd
                from
                (
                          select roman.pck_romance.fnc_nomefilial(n.idfilial) filial
                               , count(distinct n.idvendedora) QuantidadeRom
                               , round(sum((n.valortotalvendalqd * n.fatorconversao)),2) ValorRom
                               , 0 QuantidadeFav
                               , 0 ValorFav
                          from roman.notasvendas n
                          where n.dataacerto between to_date(:P63_DE||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and TO_DATE(:P63_ATE||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                            and ( :P63_IDFILIAL is null or n.idfilial = :P63_IDFILIAL )
                            and n.idsituacaonotavenda =4   
                            and n.fatorconversao != 1
                          group by n.idfilial
                          union
                          select roman.pck_romance.fnc_nomefilial(p.idfilialromance) filial
                               , 0 QuantidadeRom
                               , 0 ValorRom
                               , count(distinct p.idvendedora) QuantidadeFav
                               , round(sum((p.valorapagar * p.fatorconversao)),2) ValorFav
                          from favorita.pedidos p
                          where p.idsituacaoentrega != 50
                            and ( :P63_IDFILIAL is null or p.idfilialromance = :P63_IDFILIAL )
                            and p.tipopedido in ('P','V')
                            and p.fatorconversao != 1
                            and not exists ( select 1
                                             from favorita.classificacoespedidos cp
                                             where cp.idpedido = p.idpedido
                                               and cp.idcaracteristicapedido = 5
                                               and ( select sum(vp.valorpagar)
                                                     from favorita.vencimentospedidos vp
                                                     where vp.idpedido = cp.idpedido
                                                       and vp.situacaovencimento = 'V') = 0)
                            and not exists ( select 1
                                             from classificacoespedidos cp
                                             where cp.idpedido = p.idpedido
                                             and cp.idcaracteristicapedido = 25 )
                            and p.dataentrega between to_date(:P63_DE||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and TO_DATE(:P63_ATE||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                          group by p.idfilialromance
                          order by 1)
                ```
            used: always
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P63_PERCQUANTIDADE_GERAL (
        type: displayOnly
        label {
            label: % Quantidade Geral
            alignment: left
        }
        layout {
            sequence: 30
            region: @total-por-valor-de-venda-por-filial
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select case 
                        when sum(QuantidadeRom) > 0 then
                          round((sum(QuantidadeFav)/sum(QuantidadeRom))*100,2) 
                        else 
                          round((sum(QuantidadeRom)/sum(1))*100,2) 
                        end PercQtd
                from
                (
                          select roman.pck_romance.fnc_nomefilial(n.idfilial) filial
                               , count(distinct n.idvendedora) QuantidadeRom
                               , round(sum((n.valortotalvendalqd * n.fatorconversao)),2) ValorRom
                               , 0 QuantidadeFav
                               , 0 ValorFav
                          from roman.notasvendas n
                          where n.dataacerto between to_date(:P63_DE||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and TO_DATE(:P63_ATE||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                            and ( :P63_IDFILIAL is null or n.idfilial  = :P63_IDFILIAL )
                            and n.idsituacaonotavenda =4   
                          group by n.idfilial
                          union
                          select roman.pck_romance.fnc_nomefilial(p.idfilialromance) filial
                               , 0 QuantidadeRom
                               , 0 ValorRom
                               , count(distinct p.idvendedora) QuantidadeFav
                               , round(sum((p.valorapagar * p.fatorconversao)),2) ValorFav
                          from favorita.pedidos p
                          where p.idsituacaoentrega != 50
                            and ( :P63_IDFILIAL is null or p.idfilialromance = :P63_IDFILIAL )
                            and p.tipopedido in ('P','V')
                            and not exists ( select 1
                                             from favorita.classificacoespedidos cp
                                             where cp.idpedido = p.idpedido
                                               and cp.idcaracteristicapedido = 5
                                               and ( select sum(vp.valorpagar)
                                                     from favorita.vencimentospedidos vp
                                                     where vp.idpedido = cp.idpedido
                                                       and vp.situacaovencimento = 'V') = 0)
                            and not exists ( select 1
                                             from classificacoespedidos cp
                                             where cp.idpedido = p.idpedido
                                             and cp.idcaracteristicapedido = 25 )
                            and p.dataentrega between to_date(:P63_DE||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and TO_DATE(:P63_ATE||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                          group by p.idfilialromance
                          order by 1)
                ```
            used: always
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P63_PESQUISA_POR (
        type: radioGroup
        label {
            label: Pesquisa por
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Por Empresa;E,Por Pais;P,Todas;T
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        default {
            type: static
            staticValue: E
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 60
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--primary
                t-Button--iconRight
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction filtrar (
        name: FILTRAR
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction pesquisa-empresa (
        name: Pesquisa Empresa
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P63_PESQUISA_POR
        }
        clientSideCondition {
            type: item=value
            item: P63_PESQUISA_POR
            value: E
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P63_IDFILIAL
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P63_IDFILIAL
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction pesquisa-por-pais (
        name: Pesquisa por Pais
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P63_PESQUISA_POR
        }
        clientSideCondition {
            type: item=value
            item: P63_PESQUISA_POR
            value: P
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P63_IDPAIS
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P63_IDPAIS
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: Filtrar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 63
                items: {
                    P63_IDSEMANA: &P63_IDSEMANA.
                    P63_IDSEMANA_FIM: &P63_IDSEMANA_FIM.
                    P63_IDFILIAL: &P63_IDFILIAL.
                    P63_PESQUISA_POR: &P63_PESQUISA_POR.
                    P63_IDPAIS: &P63_IDPAIS.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: FILTRAR
        }
    )

)

