    )

    pageItem P46_IDUSUARIO (
        type: hidden
        layout {
            sequence: 100
            region: @cadastro-de-análise-de-compras
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select u.usuario showvalue
                from usuarios u
                   , favorita.analisecompras a
                where u.idusuario = a.idusuario
                  and a.idanalisecompra = :P46_IDANALISECOMPRA
                ```
        }
