    pageItem P46_IDEDICAO (
        type: plugin/select
        label {
            label: Edição
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.nome showvalue
                     , e.idedicaorevista returnvalue
                from favorita.edicoesrevistas e
                where e.tipovenda = 'R'
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @cadastro-de-análise-de-compras
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        readOnly {
            type: itemIsNotNull
            item: P46_IDANALISECOMPRA
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P46_IDFILIALFAVORITA (
        type: plugin/select
        label {
            label: Filial Favorita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nomefilialfavorita showvalue
                     , f.idfilialfavorita returnvalue
                from favorita.filiaisfavorita f
                where f.tipofilial in ('E','L')
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
