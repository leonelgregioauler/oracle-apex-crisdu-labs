page 46 (
    name: Cadastro de Análise de Compras
    title: Cadastro de Análise de Compras
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    htmlHeader {
        htmlHeader:
            ```html
            <style>
               
              .laranja {
                background-color: orange !important;
                color: white;
                width: 30px;
              }
                
              .vermelho {
                background-color:  red !important;
                color: white;
                width: 30px;
              }
                
              .azul {
                background-color:  blue !important;
                color: white;
                width: 30px;
              }
                
                
            .tooltip {
            position: relative;
            display: inline-block;
            border-bottom: 1px dotted black;
            }
            
            .tooltip .tooltiptext {
            visibility: hidden;
            width: 120px;
            background-color: #555;
            color: #fff;
            text-align: center;
            border-radius: 6px;
            padding: 5px 0;
            position: absolute;
            z-index: 1;
            bottom: 125%;
            left: 50%;
            margin-left: -60px;
            opacity: 0;
            transition: opacity 0.3s;
            }
            
            .tooltip .tooltiptext::after {
              content: "";
              position: absolute;
              top: 100%;
              left: 50%;
              margin-left: -5px;
              border-width: 5px;
              border-style: solid;
              border-color: #555 transparent transparent transparent;
            }
            
            .tooltip:hover .tooltiptext {
              visibility: visible;
              opacity: 1;
            }    
             
            
                
            </style>
            
            <script 
              src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js">
            
            </script>
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-de-análise-de-compras (
        name: Cadastro de Análise de Compras
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
                t-Form--slimPadding
                t-Form--stretchInputs
                t-Form--labelsAbove
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region itens-análise-de-compra (
        name: Itens Análise de Compra
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.produtodetalhado
                     , f.referencia
                     , f.categoria
                     , f.ciclo1anterior
                     , f.ciclo2anterior
                     , f.ciclo3anterior
                     , f.mediaanterior
                     , f.ciclo1atual
                     , f.ciclo2atual
                     , f.ciclo3atual
                     , f.mediaatual
                     , f.estoquedisponivel
                     , f.estoquemaximo
                     , f.estoqueminimo
                     , f.comprado 
                     , f.QTDitemcancelado
                     , f.diasenvio
                     , f.descontinuado
                     , f.fornecedor
                from vw_itemanalisecompra_fav f
                where f.ididioma = 1
                  and f.idanalisecompra =  :P46_IDANALISECOMPRA
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config) {
                    config.defaultGridViewOptions = {
                        tooltip: {
                            // when the tooltip is integrated with the grid view the content callback
                            // gets some extra helpful parameters
                            content: function(callback, model, recordMeta, colMeta, columnDef ) {
                                var text = null;
                
                                // if in/over the row header display a tooltip based on 
                                // the record edit state metadata
                                if (recordMeta && $(this).hasClass( "a-GV-rowHeader" ) ) {
                                    if ( recordMeta.deleted ) {
                                        text = "This record has been deleted";
                                    } else if ( recordMeta.inserted ) {
                                        text = "This record has been added";
                                    } else if ( recordMeta.updated ) {
                                        text = "This record has been changed";
                                    }
                                } else {
                                    if ( columnDef && recordMeta) {
                                        // if in/over the notes column put the notes in a tooltip so more of the notes can be seen
                                        // if in/over the name column show the hire date
                                        if ( columnDef.property === "COMPRADO" ) {
                                            text = model.getValue( recordMeta.record, "COMPRADO" );
                                        }
                                        if ( columnDef.property === "PRODUTODETALHADO" ) {
                                            text = model.getValue( recordMeta.record, "PRODUTODETALHADO" );
                                        }
                                    }
                                    // if in/over any other column display a tooltip based on 
                                    // the changed state metadata
                                    if ( colMeta && colMeta.changed ) {
                                        if ( text !== null) {
                                            text += "<br>";
                                        } else {
                                            text = "";
                                        }
                                        text += "This cell has been changed";
                                    }
                                }
                                return text;
                            }
                        }
                    };
                    return config;
                }
                ```
        }
        advanced {
            savedReportMappingIdentifier: 1592192083022521504
        }

