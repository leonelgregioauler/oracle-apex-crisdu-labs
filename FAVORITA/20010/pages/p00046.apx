    dynamicAction destacar-informações-estoque (
        name: Destacar Informações Estoque
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $(".qtdestoque").each(function(idx) {
                        
                      var qtdestoque       = $(".qtdestoque").eq(idx).text();
                      var qtdestoqueminimo = $(".qtdestoqueminimo").eq(idx).text();
                      var qtdestoquemaximo = $(".qtdestoquemaximo").eq(idx).text();
                        
                      qtdestoque        = parseInt(qtdestoque);
                      qtdestoqueminimo  = parseInt(qtdestoqueminimo);
                      qtdestoquemaximo  = parseInt(qtdestoquemaximo);
                       
                      if ( qtdestoque < qtdestoqueminimo ) {
                        $(this).closest("td").addClass( "vermelho" );
                      } else if ( qtdestoque > qtdestoquemaximo ) {
                        $(this).closest("td").addClass( "laranja" );    
                      }
                      
                    });
                    
                    
                    $(".produto").each(function(idx) {
                      
                      var descontinuado    = $(".descontinuado").eq(idx).text();
                        
                      if ( descontinuado == 'S' ) {
                        $(this).closest("td").addClass( "azul" );
                      }
                      
                    });
                    
                    /*$(".comprado").each(function(idx) {
                      
                      var comprado    = $(".comprado").eq(idx).text();
                        
                      $(this).closest("td").addClass( "tooltip" );
                        
                      //$(".tooltiptext").val = comprado;
                        $('.tooltiptext').tooltip(); 
                      
                      
                    });*/
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction destacar-informações-estoque-ao-clicar (
        name: Destacar Informações Estoque ao clicar
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: region
            region: @itens-análise-de-compra
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $(".qtdestoque").each(function(idx) {
                        
                      var qtdestoque       = $(".qtdestoque").eq(idx).text();
                      var qtdestoqueminimo = $(".qtdestoqueminimo").eq(idx).text();
                      var qtdestoquemaximo = $(".qtdestoquemaximo").eq(idx).text();
                        
                      qtdestoque        = parseInt(qtdestoque);
                      qtdestoqueminimo  = parseInt(qtdestoqueminimo);
                      qtdestoquemaximo  = parseInt(qtdestoquemaximo);
                       
                      if ( qtdestoque < qtdestoqueminimo ) {
                        $(this).closest("td").addClass( "vermelho" );
                      } else if ( qtdestoque > qtdestoquemaximo ) {
                        $(this).closest("td").addClass( "laranja" );    
                      }
                      
                    });
                    
                    
                    $(".produto").each(function(idx) {
                      
                      var descontinuado    = $(".descontinuado").eq(idx).text();
                        
                      if ( descontinuado == 'S' ) {
                        $(this).closest("td").addClass( "azul" );
                      }
                      
                    });
                    
                    /*$(".comprado").each(function(idx) {
                      
                      var comprado    = $(".comprado").eq(idx).text();
                        
                     // $(this).closest("td").addClass( "tooltip" );
                        
                      $(".tooltiptext").val = comprado;
                      
                      
                    });*/
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation verifica-ciclos-anteriores (
        name: Verifica Ciclos anteriores
        execution {
            sequence: 20
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                  select count(1)
                  from favorita.ciclosedicoes c
                  where c.idedicaorevista = favorita.pck_util_fav.fnc_edicaoanterior(:P46_IDEDICAO)
                  having count(1) =3
                ```
        }
        error {
            errorMessage: Ciclos da revista anterior não estão cadastrados corretamente
        }
    )

    validation verifica-ciclos-atuais (
        name: Verifica Ciclos atuais
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                  select count(1)
                  from favorita.ciclosedicoes c
                  where c.idedicaorevista = :P46_IDEDICAO
                  having count(1) =3
                ```
        }
        error {
            errorMessage: Ciclos da revista atual não estão cadastrados corretamente
        }
    )

    process carrega-analise-compra (
        name: Carrega Analise Compra
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vnumber number;
                  vdata   date;
                  vchar   varchar(5000);
                  --
                  voperacao varchar(2):= 'S';
                  vmd5      varchar(5000);
                  --
                begin
                  --
                  favorita.pck_bi_fav.prc_analisecompras ( pidanalisecompra   => :P46_IDANALISECOMPRA
                                                         , pidusuario         => :P46_IDUSUARIO
                                                         , pidedicao          => :P46_IDEDICAO
                                                         , pidfilialfavorita  => :P46_IDFILIALFAVORITA
                                                         , pdatacriado        => :P46_DATACRIADO
                                                         , pmd5               => vmd5
                                                         , poperacao_dml      => voperacao);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1592082107502092039
        }
    )

    process cria-análise-compra (
        name: Cria Análise Compra
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  --
                begin
                  --
                  if v('REQUEST') = 'INSERIR' then
                    --
                    favorita.pck_bi_fav.prc_processanalisecompra ( pidusuario        => :P0_IDUSUARIO
                                                                 , pidedicao         => :P46_IDEDICAO
                                                                 , pidfilialfavorita => :P46_IDFILIALFAVORITA
                                                                 , pidanalisecompra  => :P46_IDANALISECOMPRA);
                    end if;
                    --
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1592110612048445601
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 46
                items: {
                    P46_IDANALISECOMPRA: &P46_IDANALISECOMPRA.
                }
                action: resetPagination
            }
        }
    )

)

