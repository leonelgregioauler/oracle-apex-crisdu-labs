    region quantidade-de-pedidos-por-ano (
        name: Quantidade de Pedidos por Ano
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select null link
                     , to_number(to_char(dataemissao,'MM')) label
                     , nvl(count(1),0) "2017"
                from pedidos p
                where extract( year from p.dataemissao) = 2017
                  and not exists ( select 1
                                   from classificacoespedidos c
                                   where c.idcaracteristicapedido = 25
                                     and c.idpedido               = p.idpedido )
                group by to_number(to_char(dataemissao,'MM')) 
                order by to_number(to_char(dataemissao,'MM'))
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
