    pageItem P41_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Favorita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nomefilialfavorita
                     , f.idfilialfavorita
                from vw_filiaisfavorita f
                where f.ativo = 'Sim'
                order by 2 
                ```
            nullDisplayValue: - Selecione a Empresa -
        }
        layout {
