page 41 (
    name: Crescimento Favorita
    title: Crescimento Favorita
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region acompanhamento-de-pedidos (
        name: Acompanhamento de Pedidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.idfilialfavorita
                     , f.nomefilialfavorita
                     , t.mes
                     , t.ano
                     , nvl(t.total,0) total
                     , nvl(t.qtd,0) quantidade
                from vw_filiaisfavorita f
                   , ( select p.idfilialfavorita
                            , to_char(p.dataemissao,'MM') mes
                            , to_char(p.dataemissao,'RRRR') ano
                            , sum(p.valortotal*p.fatorconversao) total
                            , count(p.idpedido) qtd
                       from pedidos p
                       where not exists ( select 1
                                          from classificacoespedidos c
                                          where c.idcaracteristicapedido = 25
                                            and c.idpedido               = p.idpedido )
                       group by to_char(p.dataemissao,'MM')
                              , to_char(p.dataemissao,'RRRR')
                              , p.idfilialfavorita )/*
                       
                       union all
                       
                       select p.idfilialfavorita
                            , to_char(p.dataemissao,'MM') mes
                            , to_char(p.dataemissao,'RRRR') ano
                            , sum(p.valortotal*p.fatorconversao) total
                       from pedidos p
                       where not exists ( select 1
                                          from classificacoespedidos c
                                          where c.idcaracteristicapedido = 25
                                            and c.idpedido               = p.idpedido )
                         and extract ( year from p.dataemissao ) = 2018
                       group by to_char(p.dataemissao,'MM')
                              , p.idfilialfavorita
                        
                       union all
                       
                       select p.idfilialfavorita
                            , to_char(p.dataemissao,'MM') mes
                            , to_char(p.dataemissao,'RRRR') ano
                            , sum(p.valortotal*p.fatorconversao) total
                       from pedidos p
                       where not exists ( select 1
                                          from classificacoespedidos c
                                          where c.idcaracteristicapedido = 25
                                            and c.idpedido               = p.idpedido )
                         and extract ( year from p.dataemissao ) = 2019
                       group by to_char(p.dataemissao,'MM')
                              , p.idfilialfavorita )*/ t
                where f.idfilialfavorita = t.idfilialfavorita(+)
                  and t.mes is not null
                  and ( :P41_IDFILIALFAVORITA is null or f.idfilialfavorita = :P41_IDFILIALFAVORITA )
                order by f.idfilialfavorita  , t.mes , t.ano
                ```
            pageItemsToSubmit: P41_IDFILIALFAVORITA
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: 0
        }
        pagination {
