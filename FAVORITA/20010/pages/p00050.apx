page 50 (
    name: Venda
    title: Venda
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region venda-por-cd (
        name: Venda por CD
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(ae.idfilialfavoritaorigem) abastecedor
                     , w.filialfavorita_est
                     , w.nomeproduto
                     , ( select tipofilial
                         from vw_filiaisfavorita ww
                         where ww.idfilialfavorita = w.idfilialfavorita_est ) tipo
                     , sum( w.quantidadevendida ) quantidadevendida
                     , sum( w.valorapagar       ) valorapagar  
                     , sum( w.valorcustototal   ) valorcustototal
                     , sum( w.valorvendatotal   ) valorvendatotal
                     , sum( w.valorlucrobruto   ) valorlucrobruto  
                from mv_itensvendidos_fav w
                   , atendimentosestoques ae
                where w.idproduto        = :P50_IDPRODUTO        
                  and ae.idfilialfavoritadestino  = w.idfilialfavorita_est
                  and (:P50_IDPRODUTODETALHADO is null or w.idprodutodetalhado = :P50_IDPRODUTODETALHADO)
                  and (:P50_IDFILIALFAVORITA  is null or w.idfilialfavorita_est  in ( select afr.IDFILIALFAVORITADESTINO
                                                                                      from favorita.atendimentosestoques afr
                                                                                      where afr.idfilialfavoritaorigem = :P50_IDFILIALFAVORITA  ) )
                  and w.dataemissao between  to_date(:P50_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P50_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')   
                group by ae.idfilialfavoritaorigem
                       , w.idfilialfavorita_est
                       , w.filialfavorita_est
                       , w.nomeproduto
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 4533405457912633709
        }

