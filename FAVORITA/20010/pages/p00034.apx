    region atendimentos-hoje (
        name: Atendimentos Hoje
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select t.qtde qtde
                     , 'Tempo Médio: '||nvl(t.tempo,'0:00') tempo
                 from ( select h.atendimentos qtde
                             , beeadmin.retorna_segundos_em_horas(trunc(h.tempo_atendimentos/h.atendimentos)) tempo
                          from beefavorita.historico_atendimentos h
                         where h.data = trunc(sysdate)) t
                ```
        }
        layout {
            sequence: 20
            parentRegion: @tarefas
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        security {
            escapeSpecialChars: false
        }
        settings {
            value: QTDE
            bottomLabel: TEMPO
            color: yes
        }
    )

    region em-atendimento (
        name: Em Atendimento
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select t.qtde qtde, 'Tempo Médio: '||nvl(t.tempo,'0:00') tempo
                 from ( select count(1) qtde
                             , beeadmin.retorna_segundos_em_horas(avg(trunc((sysdate - p.data_ultimo_resgate) * 86400))) TEMPO
                          FROM beefavorita.prospects_original po, beefavorita.prospects p, beefavorita.parametros par
                         where po.cod_campanha = p.cod_campanha 
                           and po.codigo = p.codigo
                           and p.cod_status = par.cod_status_em_uso
                           and po.coluna_21 = '6'
                           and p.data_ultimo_resgate > sysdate-(2/24)) t
                ```
        }
        layout {
            sequence: 40
            parentRegion: @tarefas
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        security {
            escapeSpecialChars: false
        }
        settings {
            value: QTDE
            bottomLabel: TEMPO
            color: yes
        }
    )

    region em-pausa (
        name: Em Pausa
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select t.qtde qtde
                     , 'Tempo Médio: '||nvl(t.tempo_medio,'0:00') tempo
                 from ( select count(1) qtde
                             , beeadmin.retorna_segundos_em_horas(avg((sysdate-cu.data_inicio) * 86400)) tempo_medio
                             , beeadmin.retorna_segundos_em_horas(max((sysdate-cu.data_inicio) * 86400)) maior_tempo
                          from beepeople.compromissos_usuarios cu, beepeople.controle_frequencia cf, beeadmin.usuarios u, beeadmin.sistemas s
                         where cu.cod_usuario = u.codigo
                           and u.cod_pessoa = cf.cod_pessoa
                           and u.empresa = cf.empresa
                           and cf.cod_centro_custo = s.cod_centro_custo_padrao
                           and upper(s.db_username) = 'BEEFAVORITA'
                           and cu.data_inicio > trunc(sysdate)
                           and cu.data_termino is null
                           and cu.data_inicio between cf.data_entrada_efetiva and nvl(cf.data_saida_efetiva,cf.data_saida_prevista)) t
                ```
        }
        layout {
            sequence: 30
            parentRegion: @tarefas
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        security {
            escapeSpecialChars: false
        }
        settings {
            value: QTDE
            bottomLabel: TEMPO
            color: yes
        }
    )

