        series valor (
            name: Valor
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select to_char(data,'dd/mm') data
                         , trunc(valor/pedidos,2) VALOR
                     from (
                            select trunc(h.dataemissao) data
                                 , sum(nvl(h.valorapagar,0)) VALOR
                                 , count(distinct h.idpedido) pedidos
                              from favorita.vw_dashboardatendimento_bee h
                             where h.dataemissao >= trunc(sysdate-14)
                             group by trunc(h.dataemissao)) t
                     order by t.data
                    ```
            }
            columnMapping {
                label: DATA
                value: VALOR
            }
        )

