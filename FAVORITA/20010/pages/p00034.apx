page 34 (
    name: Monitoramento CallCenter
    title: Monitoramento CallCenter
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function doLoad()
            {
               setTimeout( "refresh()", 60*1000 );
            }
            
            function refresh()
            {
            window.location.href = window.location;
            }
            
            ```
        executeWhenPageLoads: doLoad();
    }
    security {
        pageAccessProtection: unrestricted
    }

    region acompanhamento-online (
        name: Acompanhamento Online
