            dimOnHover: false
        }
        tooltip {
            showGroupName: false
        }
        legend {
            hideAndShowBehavior: none
        }

        series resumo (
            name: Resumo
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select to_char(data,'hh24:mi:ss') data, dado, quantidade
                      from beefavorita.snapshot_atendimento
                     where data >= sysdate-(15/60/24)
                     order by 1
                    ```
            }
            columnMapping {
                seriesName: DADO
                label: DATA
                value: QUANTIDADE
            }
            line {
                type: curved
            }
        )

        axis x (
            name: x
            title: Horário
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Quantidade
