    region ranking-do-mês (
        name: Ranking do Mês
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.posicao "POSIÇÃO"
                     , case 
                         when t.valores >= 15000.00 then
                           '<font color="green"><b>'||p.nome||'</b></font>'
                         when t.valores between 10000.00 and 14999.99 then
                           '<font color="blue"><b>'||p.nome||'</b></font>'
                         else
                           p.nome
                       end atendente
                     , case 
                         when t.valores >= 15000.00 then
                           '<font color="green"><b>'||to_char(t.valores,'FM999G999G990D00')||'</b></font>'
                         when t.valores between 10000.00 and 14999.99 then
                           '<font color="blue"><b>'||to_char(t.valores,'FM999G999G990D00')||'</b></font>'
                         else
                           to_char(t.valores,'FM999G999G990D00')
                       end valor
                     , t.pedidos
                     , to_char(t.valores/decode(t.pedidos,0,1,t.pedidos),'FM999G999G990D00') "TICKET MÉDIO"
                  from (
                        select rownum posicao
                             , t.*
                          from (
                                select vw.idusuario
                                     , count(vw.idpedido) pedidos
                                     , sum(nvl(valorapagar,0)) valores 
                                  from favorita.vw_dashboardatendimento_bee vw
                                 where  ( extract( day from sysdate) <= 25 and  vw.dataemissao between to_date('26/'||to_char(add_months(sysdate,-1),'MM/RRRR')||' 00:00:00' ,'DD/MM/RRRR hh24:mi:ss') 
                                                                                          and to_date('25/'||to_char(sysdate,'MM/RRRR')||' 23:59:59','DD/MM/RRRR hh24:mi:ss' ) 
                                          or (extract( day from sysdate ) > 25 and  vw.dataemissao between to_date('26/'||to_char(sysdate,'MM/RRRR')||' 00:00:00' ,'DD/MM/RRRR hh24:mi:ss' ) 
                                                                                            and to_date('25/'||to_char(add_months(sysdate,+1),'MM/RRRR')||'  23:59:59','DD/MM/RRRR hh24:mi:ss')))
                                 group by vw.idusuario
                                 order by 3 desc) t
                         where rownum <= 30) t
                     , catal.usuarios cau
                     , beeadmin.usuarios u
                     , beepeople.vw_pessoas p
                 where t.idusuario = cau.idusuario
                   and cau.usuario = u.nome_login
                   and u.cod_pessoa = p.codigo
                   and u.empresa = p.empresa
                 order by 1
                
                
                ```
        }
        layout {
            sequence: 50
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 30
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

