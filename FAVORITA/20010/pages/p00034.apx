    region resumo-de-atividade (
        name: Resumo de Atividade
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ca.atividade link
                     , ca.atividade
                     , count(1) quantidade
                  from beeweb.controle_atividade ca
                     , beefavorita.usuarios_atendimento ua
                     , beefavorita.grupos_atendimento ga 
                 where ca.cod_usuario = ua.cod_usuario
                   and ua.cod_grupo = ga.codigo
                   and instr(',' || ga.tipos_tarefas || ',',',6,') > 0
                   and  ca.atividade != 'LOGOUT'
                   and ca.data_termino is null
                   and ca.data_inicio > sysdate - (6/24)
                 group by ca.atividade
                ```
        }
        layout {
            sequence: 100
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
