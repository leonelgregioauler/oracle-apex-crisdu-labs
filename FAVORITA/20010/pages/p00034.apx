                    select *
                      from (
                            select 0 ordem, 'Total' dado, ligacoes qtde
                              from beeweb.vw_resumo_ligacoes_call 
                            union
                            select 1 ordem, 'Localizado' dado, localizado qtde
                              from beeweb.vw_resumo_ligacoes_call
                            union
                            select 2 ordem, 'Abordado' dado, abordado qtde
