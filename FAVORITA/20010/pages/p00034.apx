    region atendentes-por-atividade (
        name: Atendentes por Atividade
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ca.atividade
                     , op.nome atendente
                     , beeadmin.retorna_segundos_em_horas(trunc((sysdate - data_inicio) * 86400)) tempo
                     , ca.estacao PA
                  from beeweb.controle_atividade ca
                     , beeadmin.usuarios u
                     , beepeople.vw_pessoas op
                     , beefavorita.usuarios_atendimento ua
                     , beefavorita.grupos_atendimento ga 
                 where ca.cod_usuario = ua.cod_usuario
                   and ua.cod_grupo = ga.codigo
                   and ua.cod_usuario = u.codigo
                   and u.cod_pessoa = op.codigo
                   and u.empresa = op.empresa
                   and instr(',' || ga.tipos_tarefas || ',',',6,') > 0
                   and ca.data_termino is null
                   and ca.atividade != 'LOGOUT'
                   and ca.data_inicio > sysdate - (6/24)
                 order by ca.atividade
                     , ca.data_inicio
                ```
        }
        layout {
            sequence: 110
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        searchBar {
            searchField: false
            reportsSelectList: false
        }
        actionsMenu {
            filter: false
        }
        advanced {
            savedReportMappingIdentifier: 5577841070040723490
        }

