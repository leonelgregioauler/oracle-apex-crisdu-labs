    region ticket-médio-por-grupo (
        name: Ticket Médio por Grupo
        type: plugin/d3PieChart
        source {
            sqlQuery:
                ```sql
                select 'Grupos de Clientes' nome
                     , 'Nível '||grupo||' -  De '||min(qtd)||' a '||max(qtd) grupo
                     , sum(valorapagar) / sum(qtd) ticketmedio
                from (
                        select idvendedora     
                             , count(1) qtd
                             , case
                                when count(1) >= 8 then
                                  1
                                when count(1) between 6 and 7 then
                                  2
                                when count(1) between 4 and 5 then
                                  3
                                when count(1) between 2 and 3 then
                                  4
                                when count(1) = 1 then
                                  5
                                end grupo
                             , sum(p.valorapagar) valorapagar
                             , round(sum(p.valorapagar) / count(1),2) ticketmedio
                        from favorita.pedidos p
                        where p.dataemissao >= trunc(sysdate) - 504
                          and p.datacancelamento is null
                          and exists ( select 1
                                       from filiais f
                                       where f.idfilial = p.idfilialromance
                                         and f.ididioma = 1 )
                          and not exists ( select 1
                                           from representantes r
                                              , vendedoras v
                                           where r.idpessoa    = v.idpessoa
                                             and v.idvendedora = p.idvendedora )
                          and not exists ( select 1
                                           from catal.funcionarios r
                                              , vendedoras v
                                           where r.idpessoa    = v.idpessoa
                                             and v.idvendedora = p.idvendedora )
                        having sum(p.valorapagar) > 0
                        group by idvendedora )
                group by grupo
                order by grupo
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        security {
            escapeSpecialChars: false
        }
        settings {
            labelColumn: GRUPO
            valueColumn: TICKETMEDIO
            width: 500
            displayOptions: [
                tooltip
                labels
            ]
            legend: aboveChart
            valueFormatMask: attributeValue
        }
    )

    region ticket-médio-por-grupo-2 (
        name: Ticket Médio por Grupo
        type: plugin/d3PieChart
        source {
            sqlQuery:
                ```sql
                select canalorigem
                     , sum(qtd) quantidade
                from (    
                        select ( select decode(f.tipofilial,'E','Estoque'
                                                           ,'L','Loja'
                                                           ,'S','Site'
                                                           ,'C','Call Center'
                                                           ,'V','Venda Direta')--||' - '||f.tipofilial||'-'||p.idfilialfavorita
                                 from filiaisfavorita f 
                                 where f.idfilialfavorita = p.idfilialfavorita ) canalorigem
                             , count(1) qtd
                             , sum(p.valorapagar) valorapagar
                             , round(sum(p.valorapagar) / count(1),2) ticketmedio
                        from favorita.pedidos p
                        where p.dataemissao > trunc(sysdate) - 504
                          and p.datacancelamento is null
                          and exists ( select 1
                                       from filiais f
                                       where f.idfilial = p.idfilialromance
                                         and f.ididioma = 1 )
                          and not exists ( select 1
                                           from representantes r
                                              , vendedoras v
                                           where r.idpessoa    = v.idpessoa
                                             and v.idvendedora = p.idvendedora )
                          and not exists ( select 1
                                           from catal.funcionarios r
                                              , vendedoras v
                                           where r.idpessoa    = v.idpessoa
                                             and v.idvendedora = p.idvendedora )
                        having sum(p.valorapagar) > 0
                        group by p.idfilialfavorita )
                group by canalorigem
                order by 1
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        security {
            escapeSpecialChars: false
        }
        settings {
            labelColumn: CANALORIGEM
            valueColumn: QUANTIDADE
            width: 500
            displayOptions: [
                tooltip
                labels
            ]
            legend: aboveChart
            valueFormatMask: attributeValue
        }
    )

    region ticket-médio-por-grupo-3 (
        name: Ticket Médio por Grupo
        type: plugin/d3PieChart
        source {
            sqlQuery:
                ```sql
                select tipo
                     , qtd quantidade
                from (    
                        select 'Concretizado' tipo
                             , count(1)  qtd
                        from favorita.pedidos p
                        where p.dataemissao > trunc(sysdate) - 504
                          and p.datacancelamento is null
                          and exists ( select 1
                                       from filiais f
                                       where f.idfilial = p.idfilialromance
                                         and f.ididioma = 1 )
                          and not exists ( select 1
                                           from representantes r
                                              , vendedoras v
                                           where r.idpessoa    = v.idpessoa
                                             and v.idvendedora = p.idvendedora )
                          and not exists ( select 1
                                           from catal.funcionarios r
                                              , vendedoras v
                                           where r.idpessoa    = v.idpessoa
                                             and v.idvendedora = p.idvendedora )
                        having sum(p.valorapagar) > 0 
                        union
                        select 'Cancelado' tipo
                             , count(1)  qtd
                        from favorita.pedidos p
                        where p.dataemissao > trunc(sysdate) - 504
                          and p.datacancelamento is not null
                          and exists ( select 1
                                       from filiais f
                                       where f.idfilial = p.idfilialromance
                                         and f.ididioma = 1 )
                          and not exists ( select 1
                                           from representantes r
                                              , vendedoras v
                                           where r.idpessoa    = v.idpessoa
                                             and v.idvendedora = p.idvendedora )
                          and not exists ( select 1
                                           from catal.funcionarios r
                                              , vendedoras v
                                           where r.idpessoa    = v.idpessoa
                                             and v.idvendedora = p.idvendedora )
                        having sum(p.valorapagar) > 0 )
                
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        security {
            escapeSpecialChars: false
        }
        settings {
            labelColumn: TIPO
            valueColumn: QUANTIDADE
            width: 500
            displayOptions: [
                tooltip
                labels
            ]
            legend: aboveChart
            valueFormatMask: attributeValue
        }
    )

)

