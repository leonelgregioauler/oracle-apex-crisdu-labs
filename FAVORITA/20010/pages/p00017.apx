page 17 (
    name: Grupos de Clientes
    title: Grupos de Clientes
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region grupos-de-clientes (
        name: Grupos de Clientes
        type: plugin/d3PieChart
        source {
            sqlQuery:
                ```sql
                select 'Grupos de Clientes' nome
                     , 'Nível '||grupo||' -  De '||min(qtd)||' a '||max(qtd) grupo
                     , count(1) qtd
                from (
                        select idvendedora     
                             , count(1) qtd
                             , case
                                when count(1) >= 8 then
                                  1
                                when count(1) between 6 and 7 then
                                  2
                                when count(1) between 4 and 5 then
                                  3
                                when count(1) between 2 and 3 then
                                  4
                                when count(1) = 1 then
                                  5
                                end grupo
                             , sum(p.valorapagar) valorapagar
                             , round(sum(p.valorapagar) / count(1),2) ticketmedio
                        from favorita.pedidos p
                        where p.dataemissao >= trunc(sysdate) - 504
                          and p.datacancelamento is null
                          and exists ( select 1
                                       from filiais f
                                       where f.idfilial = p.idfilialromance
                                         and f.ididioma = 1 )
                          and not exists ( select 1
                                           from representantes r
                                              , vendedoras v
                                           where r.idpessoa    = v.idpessoa
                                             and v.idvendedora = p.idvendedora )
                          and not exists ( select 1
                                           from catal.funcionarios r
                                              , vendedoras v
                                           where r.idpessoa    = v.idpessoa
                                             and v.idvendedora = p.idvendedora )
                        having sum(p.valorapagar) > 0
                        group by idvendedora )
                group by grupo
                order by grupo
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        headerAndFooter {
            headerText: Quantidade de pedidos dos últimos 504 dias.
        }
        security {
            escapeSpecialChars: false
        }
        settings {
            labelColumn: GRUPO
            valueColumn: QTD
            width: 500
            displayOptions: [
                tooltip
                labels
                percentages
            ]
            legend: aboveChart
            valueFormatMask: attributeValue
        }
    )

    region quantidade-de-pedidos-cancelados-nos-últimos-504-dias (
        name: Quantidade de Pedidos Cancelados nos últimos 504 dias
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                        select roman.pck_romance.fnc_nomefilial(p.idfilialromance) empresa
                             , roman.pck_romance.fnc_nomerepresentante(p.idrepresentante) distribuidor
                             , count(1) qtd
                        from favorita.pedidos p
                        where p.dataemissao > trunc(sysdate) - 504
                          and p.datacancelamento is not null
                          and exists ( select 1
                                       from filiais f
                                       where f.idfilial = p.idfilialromance
                                         and f.ididioma = 1 )
                          and not exists ( select 1
                                           from representantes r
                                              , vendedoras v
                                           where r.idpessoa    = v.idpessoa
                                             and v.idvendedora = p.idvendedora )
                          and not exists ( select 1
                                           from catal.funcionarios r
                                              , vendedoras v
                                           where r.idpessoa    = v.idpessoa
                                             and v.idvendedora = p.idvendedora )
                        having sum(p.valorapagar) > 0 
                        group by p.idfilialromance, p.idrepresentante
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 2326102194638405012
        }

        column DISTRIBUIDOR (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column EMPRESA (
            type: plainText
            heading {
                heading: Empresa
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column QTD (
            type: plainText
            heading {
                heading: Qtd
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
