page 27 (
    name: Atividade Call Center
    title: Atividade Call Center
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region atividade-do-call-center (
        name: Atividade do Call Center
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select op.nome
                     , to_char(ca.data_inicio,'hh24:mi:ss') início
                     , beepeople.retorna_segundos_em_horas((sysdate-ca.data_inicio)*86400) tempo
                  from beeweb.controle_atividade ca
                     , beeadmin.usuarios u
                     , beepeople.vw_pessoas op
                     , beepeople.controle_frequencia cf
                     , beeadmin.sistemas s
                 where ca.cod_usuario = u.codigo
                   and u.cod_pessoa = op.codigo
                   and u.empresa = op.empresa
                   and op.codigo = cf.cod_pessoa
                   and op.empresa = cf.empresa
                   and cf.data_entrada_efetiva > trunc(sysdate)
                   and nvl(cf.data_saida_efetiva,cf.data_saida_prevista) < sysdate
                   and cf.cod_centro_custo = s.cod_centro_custo_padrao
                   and upper(s.db_username) = 'BEEFAVORITA'
                   and ca.data_termino is null
                   and ca.atividade = :P27_ATIVIDADE
                   and ca.data_inicio > sysdate-0.5
                 order by ca.data_inicio
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 2743204034096916434
        }

        column INÍCIO (
            type: plainText
            heading {
                heading: Início
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column NOME (
            type: plainText
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column TEMPO (
            type: plainText
            heading {
                heading: Tempo
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 27494548 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn INÍCIO (
                sequence: 2
            )

            displayColumn NOME (
                sequence: 1
            )

            displayColumn TEMPO (
                sequence: 3
            )

        )

    )

    pageItem P27_ATIVIDADE (
        type: hidden
        layout {
            sequence: 10
            region: @atividade-do-call-center
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

