    region ranking-emana-uruguay (
        name: Ranking Emana Uruguay
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(t.idrepresentante) "Distribuidor Independente"
                     , roman.pck_romance.fnc_nomevendedora(t.idvendedora) "Consultora"
                     , pontos "Pontos"
                from ( select pd.idrepresentante
                            , pd.idvendedora
                            , sum(round(it.valorvenda/10)) pontos
                       from itenspedidos it
                          , pedidos pd
                       where it.idpedido = pd.idpedido
                         and pd.datacancelamento is null
                         and trunc(pd.dataemissao) between to_date(:P67_DATAINICIO,'DD/MM/RRRR') and to_date(:P67_DATAFIM,'DD/MM/RRRR')
                         and pd.idfilialromance = 1041
                         and not exists ( select 1
                                          from classificacoespedidos cp
                                          where cp.idclassificacaopedido = 28
                                            and cp.idpedido              = pd.idpedido )
                         and not exists ( select 1
                                          from representantes r
                                             , vendedoras v
                                          where v.idvendedora = pd.idvendedora
                                            and r.idpessoa    = v.idpessoa
                                            and r.ativo       = 'S' )
                         and exists ( select 1
                                      from vencimentospedidos vp
                                      where vp.idpedido = pd.idpedido
                                        and vp.situacaovencimento = 'V'
                                        and vp.valorpago >= vp.valorpago )
                       group by pd.idrepresentante
                              , pd.idvendedora
                       --       , pd.idpedido
                       order by 3 desc ) t
                where rownum <= 10
                  and :P67_PAIS = 2
                ```
            pageItemsToSubmit: [
                P67_DATAINICIO
                P67_DATAFIM
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
