page 67 (
    name: Ranking Emana
    title: Ranking Emana
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region ranking-emana (
        name: Ranking Emana
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(t.idfilialromance) "Empresa"
                     , roman.pck_romance.fnc_nomerepresentante(t.idrepresentante) "Distribuidor Independente"
                     , roman.pck_romance.fnc_nomevendedora(t.idvendedora) "Consultora"
                     , pontos "Pontos"
                from ( select pd.idfilialromance
                            , pd.idrepresentante
                            , pd.idvendedora
                            , sum(round(it.valorvenda*nvl(pd.fatorconversao,1))) pontos
                       from itenspedidos it
                          , pedidos pd
                       where it.idpedido = pd.idpedido
                         and pd.datacancelamento is null
                         and trunc(pd.dataemissao) between to_date(:P67_DATAINICIO,'DD/MM/RRRR') and to_date(:P67_DATAFIM,'DD/MM/RRRR')
                         and not exists ( select 1
                                          from classificacoespedidos cp
                                          where cp.idclassificacaopedido = 28
                                            and cp.idpedido              = pd.idpedido )
                         and not exists ( select 1
                                          from representantes r
                                             , vendedoras v
                                          where v.idvendedora = pd.idvendedora
                                            and r.idpessoa    = v.idpessoa
                                            and r.ativo       = 'S' )
                         and exists ( select 1
                                      from vencimentospedidos vp
                                      where vp.idpedido = pd.idpedido
                                        and vp.situacaovencimento = 'V'
                                        and vp.valorpago >= vp.valorpago )
                         and exists ( select 1
                                      from classificacoesprodutos cp
                                      where cp.idtagproduto = 163
                                        and cp.idprodutodetalhado = it.idprodutodetalhado )
                         and exists ( select 1
                                      from roman.vw_filiais f
                                      where f.ativo = 'S'
                                        and f.idgrupo != 5
                                        and f.idfilial = pd.idfilialromance )
                       group by pd.idfilialromance
                              , pd.idrepresentante
                              , pd.idvendedora
                       --       , pd.idpedido
                       order by 4 desc ) t
                where rownum <= 50
                  and :P67_PAIS = 1
                ```
            pageItemsToSubmit: [
                P67_DATAINICIO
                P67_DATAFIM
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P67_PAIS
            value: 1
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 108056974554057708
        }

        column Consultora (
            type: plainText
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

