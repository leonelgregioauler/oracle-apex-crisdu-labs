    dynamicAction refresh-dt-fim (
        name: Refresh dt_fim
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P67_DATAFIM
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @ranking-emana
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-dt-ini (
        name: Refresh dt_ini
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P67_DATAINICIO
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @ranking-emana
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process atualiza-filtro-data (
        name: Atualiza FIltro data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  if :P67_PAIS = 1 then
                    --
                    :P67_DATAINICIO := to_date('19/04/2021','DD/MM/RRRR');
                    :P67_DATAFIM    := to_date('11/07/2021','DD/MM/RRRR');
                    --
                  else
                    --
                    :P67_DATAINICIO := to_date('05/07/2021','DD/MM/RRRR');
                    :P67_DATAFIM    := to_date('26/09/2021','DD/MM/RRRR');
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 108057696361057715
        }
        serverSideCondition {
            type: itemIsNull
            item: P67_DATAINICIO
        }
    )

