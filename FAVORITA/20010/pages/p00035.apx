    region resumo-de-atividade (
        name: Resumo de Atividade
        type: chart
        layout {
            sequence: 80
            slot: body
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: donut
        }
        performance {
            lazyLoading: true
        }
        value {
            format: decimal
        }
        animation {
            onDataChange: none
        }
        legend {
            hideAndShowBehavior: none
        }

        series resumo (
            name: Resumo
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select decode(ca.atividade,'PAUSA DISCADOR','PAUSA',ca.atividade)  link
                         , decode(ca.atividade,'PAUSA DISCADOR','PAUSA',ca.atividade)  atividade
                         , count(1) quantidade
                      from beeweb.controle_atividade ca, beeadmin.usuarios u, beepeople.controle_frequencia cf
                     where ca.cod_usuario = u.codigo
                       and u.cod_pessoa = cf.cod_pessoa
                       and u.empresa = cf.empresa
                       and ca.data_inicio between cf.data_entrada_efetiva and cf.data_saida_prevista
                       and ca.atividade != 'LOGOUT'
                       and ca.data_termino is null
                       and ca.data_inicio > trunc(sysdate)
                     group by decode(ca.atividade,'PAUSA DISCADOR','PAUSA',ca.atividade) 
                    
                    ```
            }
            columnMapping {
                label: ATIVIDADE
                value: QUANTIDADE
            }
            link {
                type: redirectThisApp
                target: {
                    page: 38
                    items: {
                        P38_VALOR: &ATIVIDADE.
                    }
                    action: resetPagination
                }
            }
        )

    )

