    region últimas-tarefas-atendidas (
        name: Últimas Tarefas Atendidas
        type: chart
        layout {
            sequence: 60
            slot: body
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: pie
        }
        performance {
            lazyLoading: true
        }
        value {
            format: decimal
        }
        legend {
            hideAndShowBehavior: none
        }

        series resumo (
            name: Resumo
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select dado, quantidade
                      from beeunified.snapshot_atendimento t
                     where t.data = (select max(data) from beeunified.snapshot_atendimento)
                       and ordem > 0
                       and quantidade > 0
                    ```
            }
            columnMapping {
                seriesName: DADO
                label: DADO
                value: QUANTIDADE
            }
        )

    )

    region últimas-tarefas-atendidas-2 (
        name: Últimas Tarefas Atendidas
        type: chart
        layout {
            sequence: 40
            slot: body
            columnSpan: 8
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: lineWithArea
        }
        performance {
            lazyLoading: true
        }
        tooltip {
            showGroupName: false
        }
        legend {
            hideAndShowBehavior: none
        }

        series resumo (
            name: Resumo
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select to_char(data,'hh24:mi:ss') data, dado, quantidade
                      from beeunified.snapshot_atendimento t
                     where t.data >= sysdate-(15/60/24)
                       and t.ordem > 0
                       and exists (select 1
                                     from beeunified.snapshot_atendimento
                                    where ordem = t.ordem
                                      and data >= sysdate-(15/60/24)
                                      and quantidade > 0)
                     order by 1
                    ```
            }
            columnMapping {
                seriesName: DADO
                label: DATA
                value: QUANTIDADE
            }
            line {
                type: curved
            }
        )

        axis x (
            name: x
            title: Horário
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Quantidade
            value {
                format: decimal
                baselineScaling: min
            }
            minorTicks {
                show: false
            }
        )

        axis y-1 (
            name: y2
            minorTicks {
                show: false
            }
        )

    )

)

