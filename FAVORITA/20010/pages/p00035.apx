    region ligações-em-andamento (
        name: Ligações em Andamento
        type: plugin/justgageGauge
        source {
            sqlQuery:
                ```sql
                select t.logados,   
                       (select count(distinct agent)
                          from beedialer.pred_dialer_status pds
                         where pds.call_end_date is null
                           and pds.create_date > sysdate - (2/24)
                           and exists (select 1
                                         FROM beepeople.controle_frequencia cf, beepeople.vw_pessoas p
                                        WHERE cf.cod_pessoa = p.codigo
                                          AND cf.empresa = p.empresa
                                          AND cf.data = trunc(sysdate)
                                          AND cf.data_entrada_efetiva IS NOT NULL
                                          AND cf.data_saida_efetiva IS NULL
                                          AND cf.registra_ponto = 'S'
                                          AND to_number(substr(p.cpf,1,9)) = pds.agent)
                       ) qtde
                  from (
                        select sum(a.logados) logados
                          from beeweb.vw_aderencia_cc a) t
                ```
        }
        layout {
            sequence: 100
            parentRegion: @aderência
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                margin-bottom-none
            ]
        }
        settings {
            valueColumn: QTDE
            maxValueColumn: LOGADOS
            height: 180
        }
    )

