    region tarefas-em-atendimento (
        name: Tarefas em Atendimento
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select t.qtde qtde, 'Tempo Médio: '||nvl(t.tempo,'0:00') tempo
                 from (select count(1) qtde, beeadmin.retorna_segundos_em_horas(avg(nvl(tempo,0))) TEMPO
                         from (
                                select (sysdate - p.data_ultimo_resgate) * 86400 TEMPO
                                  FROM beecobranca.prospects_original po, beecobranca.prospects p, beecobranca.parametros par
                                 where po.cod_campanha = p.cod_campanha 
                                   and po.codigo = p.codigo
                                   and p.cod_status = par.cod_status_em_uso
                                   and p.data_ultimo_resgate > sysdate-(1/24)
                                 union all
                                select (sysdate - p.data_ultimo_resgate) * 86400 TEMPO
                                  FROM beeunified.prospects_original po, beeunified.prospects p, beeunified.parametros par
                                 where po.cod_campanha = p.cod_campanha 
                                   and po.codigo = p.codigo
                                   and p.cod_status = par.cod_status_em_uso
                                   and p.data_ultimo_resgate > sysdate-(1/24)
                                 union all
                                select (sysdate - p.data_ultimo_resgate) * 86400 TEMPO
                                  FROM beefavorita.prospects_original po, beefavorita.prospects p, beefavorita.parametros par
                                 where po.cod_campanha = p.cod_campanha 
                                   and po.codigo = p.codigo
                                   and p.cod_status = par.cod_status_em_uso
                                   and p.data_ultimo_resgate > sysdate-(1/24))
                
                      ) t
                ```
        }
        layout {
            sequence: 50
            parentRegion: @tarefas
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        security {
            escapeSpecialChars: false
        }
        settings {
            value: QTDE
            bottomLabel: TEMPO
            color: yes
        }
    )

    region tarefas-novas-de-call-back (
        name: Tarefas Novas de Call Back
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select nvl(v.qtde,0) || 'v + ' || nvl(c.qtde,0) || 'c' qtde
                     , 'Maior Tempo: '||nvl(v.tempo,'0:00') || 'v + ' || nvl(c.tempo,'0:00') || 'c' tempo
                 from ( select count(1) qtde
                             , beeadmin.retorna_segundos_em_horas(trunc((sysdate-min(t.datainclusao)) * 86400)) tempo
                          from favorita.vw_tarefas_bee t, beeunified.balde_nomes bn
                         where t.idtipotarefa = bn.idtipotarefa
                           and beepeople.sonumeros(length(t.telefone)) > 10
                           and beepeople.sonumeros(t.telefone) not like '0%'
                           and bn.call_back = 1
                           and t.idtipotarefa = 6
                           and t.idsituacao = 0) v,
                     (  select count(1) qtde
                             , beeadmin.retorna_segundos_em_horas(trunc((sysdate-min(t.datainclusao)) * 86400)) tempo
                          from favorita.vw_tarefas_bee t, beeunified.balde_nomes bn
                         where t.idtipotarefa = bn.idtipotarefa
                           and beepeople.sonumeros(length(t.telefone)) > 10
                           and beepeople.sonumeros(t.telefone) not like '0%'
                           and bn.call_back = 1
                           and t.idtipotarefa != 6
                           and t.idsituacao = 0) c
                                      
                ```
        }
        layout {
            sequence: 10
            parentRegion: @tarefas
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        security {
            escapeSpecialChars: false
        }
        settings {
            value: QTDE
            bottomLabel: TEMPO
            linkTarget: {
                page: 36
                action: resetPagination
            }
            color: yes
        }
    )

