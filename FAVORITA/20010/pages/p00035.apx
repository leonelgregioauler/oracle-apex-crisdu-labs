            maxValueColumn: PREVISTO
            headingLinkTarget: {
                page: 43
                action: resetPagination
            }
            height: 180
        }
    )

    region atendimentos-hoje (
        name: Atendimentos Hoje
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select t.qtde qtde
                     , 'Tempo Médio: '||nvl(t.tempo,'0:00') tempo
                 from ( select h.atendimentos qtde
                             , beeadmin.retorna_segundos_em_horas(trunc(h.tempo_atendimentos/h.atendimentos)) tempo
                          from beeunified.historico_atendimentos h
                         where h.data = trunc(sysdate)) t
                ```
        }
        layout {
            sequence: 30
            parentRegion: @tarefas
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        security {
            escapeSpecialChars: false
        }
        settings {
            value: QTDE
            bottomLabel: TEMPO
            color: yes
        }
    )

    region atendimentos-nos-últimos-7-dias (
        name: Atendimentos nos Últimos 7 Dias
        type: chart
        layout {
            sequence: 120
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        performance {
            lazyLoading: true
        }
        animation {
            onDataChange: none
        }
        legend {
            hideAndShowBehavior: none
        }

        series dados (
            name: Dados
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select to_char(tt.data,'dd/Mon (Dy)') data, tt."TIPO DE TAREFA" dado, nvl(t.qtde,0) qtde
                      from beeweb.vw_tarefas_atendidas t     
                         , (select distinct "TIPO DE TAREFA"
                                 , u7.data
                              from beeweb.vw_tarefas_atendidas
                                 , beeweb.vw_ultimos_7_dias u7
                             where u7.data >= trunc(sysdate-8)
                               and to_char(u7.data,'d') <> '1') tt
                     WHERE t."TIPO DE TAREFA"(+) = tt."TIPO DE TAREFA"
                       and t.data(+) = tt.data
                     order by tt.data
                    ```
            }
            columnMapping {
                seriesName: DADO
                label: DATA
                value: QTDE
            }
        )

        axis x (
            name: x
            title: Data
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Quantidade
            value {
                format: decimal
            }
            minorTicks {
                show: false
            }
        )

    )

    region em-pausa (
        name: Em Pausa
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select t.qtde qtde
                     , 'Tempo Médio: '||nvl(t.tempo_medio,'0:00') tempo
                 from ( select count(1) qtde
                             , beeadmin.retorna_segundos_em_horas(avg((sysdate-cu.data_inicio) * 86400)) tempo_medio
                             , beeadmin.retorna_segundos_em_horas(max((sysdate-cu.data_inicio) * 86400)) maior_tempo
                          from beepeople.compromissos_usuarios cu, beepeople.controle_frequencia cf, beeadmin.usuarios u
                         where cu.cod_usuario = u.codigo
                           and u.cod_pessoa = cf.cod_pessoa
                           and u.empresa = cf.empresa
                           and cu.data_inicio > trunc(sysdate)
                           and cu.data_termino is null
                           and cu.data_inicio between cf.data_entrada_efetiva and cf.data_saida_prevista
                           and not exists (select 1
                                             from beeweb.controle_atividade
                                            where cod_usuario = u.codigo
                                              and atividade = 'LOGOUT'
                                              and data_termino is null)) t
                           
                ```
        }
        layout {
            sequence: 40
            parentRegion: @tarefas
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        security {
            escapeSpecialChars: false
        }
        settings {
            value: QTDE
            bottomLabel: TEMPO
            color: yes
        }
    )

