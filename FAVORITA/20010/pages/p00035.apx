page 35 (
    name: Dashboard Unificado
    title: Dashboard Unificado
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function doLoad()
            {
               setTimeout( "refresh()", 30000 );
            }
            
            function refresh()
            {
            window.location.href = window.location;
            }
            ```
        executeWhenPageLoads: doLoad();
    }
    security {
        pageAccessProtection: unrestricted
    }

    region aderência (
        name: Aderência
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                i-h320
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
                margin-bottom-none
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region aderência-2 (
        name: Aderência
        type: plugin/justgageGauge
        source {
            sqlQuery:
                ```sql
                select sum(a.presentes) logados, sum(a.previsto) previsto
                  from beeweb.vw_aderencia_cc a
                
                ```
