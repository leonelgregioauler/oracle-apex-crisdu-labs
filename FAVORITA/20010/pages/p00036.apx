page 36 (
    name: Tarefas Aguardando Atendimento
    title: Tarefas Aguardando Atendimento
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region lista-de-tarefas-aguardando-atendimento (
        name: Lista de Tarefas Aguardando Atendimento
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(t.datainclusao,'dd/mm/rrrr hh24:mi:ss') "Data da Inclusão"
                     , t.nrtarefa "Id Tarefa"
                     , t.telefone
                     , t.tipotarefa "Tipo de Tarefa"
                     , t.nomepessoa "Cliente"
                     , t.nomeusuario "Usuário"
                     , t.observacao "Observação"
                  from favorita.vw_tarefas_bee t, beeunified.balde_nomes bn
                 where t.idtipotarefa = bn.idtipotarefa
                   and bn.call_back = 1
                   and t.idsituacao = 0
                   and beepeople.sonumeros(length(t.telefone)) > 10
                   and beepeople.sonumeros(t.telefone) not like '0%'
                 order by t.datainclusao
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 2800905659301892616
        }

        column Cliente (
            type: plainText
            heading {
                heading: Cliente
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column "Data da Inclusão" (
            type: plainText
            heading {
                heading: Data da inclusão
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column "Id Tarefa" (
