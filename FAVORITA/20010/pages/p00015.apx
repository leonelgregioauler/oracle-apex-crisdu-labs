page 15 (
    name: Home 3
    title: Home 3
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function doLoad()
            {
            setTimeout( "submit()", 60*1000 );
            }
            
            function submit()
            {
              apex.submit('SUBMIT');
            }
            ```
        executeWhenPageLoads: doLoad()
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
    )

    region quantidade-de-pedidos (
        name: "Quantidade de Pedidos "
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(p.idfilialromance) empresa
                     , COUNT(1) valorotal
                from pedidos p
                where trunc(dataemissao )   between to_date(:P15_DE) and to_date(:P15_ATE)
                  and p.datacancelamento is null
                  and ( :P0_IDFILIALROMANCE = '999999999999' or p.idfilialromance = :P0_IDFILIALROMANCE )
                  and p.idsituacaoentrega  >= 20000
                group by p.idfilialromance
                order by 2 desc
                ```
            pageItemsToSubmit: [
                P15_DE
                P15_ATE
            ]
        }
        layout {
            sequence: 80
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: EMPRESA
            valueColumn: VALOROTAL
            formatMask: 999G999G990
            colorScheme: modern
            maximumRows: 30
        }
    )

    region situações-de-pedidos-hoje (
        name: Situações de Pedidos (Hoje)
        type: plugin/slideTooltip
        source {
            sqlQuery:
                ```sql
                select 'fa-circle' icon
                     , pck_util_fav.fnc_situacaoentrega(p.idsituacaoentrega,'I',1) situacaoentrega
                     , count(1) quantidade
                     , to_char(sum(p.valortotal*p.fatorconversao) ,'999G999G999G990D00') valor_total
                     , to_char(sum(p.valortotalcusto*p.fatorconversao),'999G999G999G990D00') custo_total
                     , to_char(sum(p.valorapagar*p.fatorconversao),'999G999G999G990D00') valor_a_pagar
                from vw_pedidos_fav p
                where ididioma = 1
                  and trunc(dataemissao) between to_date(:P15_DE) and to_date(:P15_ATE)
                  and p.datacancelamento is null
                  and ( :P0_IDFILIALROMANCE = '999999999999' or p.idfilialromance = :P0_IDFILIALROMANCE )
                group by p.idsituacaoentrega
                order by 1
                ```
        }
        layout {
            sequence: 100
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            iconColumn: ICON
            titleColumn: SITUACAOENTREGA
            badgeColumn: QUANTIDADE
        }

        column CUSTO_TOTAL (
            source {
                dataType: VARCHAR2
            }
            heading {
                heading: Custo total
            }
            layout {
                sequence: 50
            }
        )

        column ICON (
            source {
                dataType: VARCHAR2
            }
            heading {
                heading: Icon
            }
            layout {
                sequence: 30
            }
        )

        column QUANTIDADE (
            source {
                dataType: NUMBER
            }
            heading {
                heading: Quantidade
            }
            layout {
                sequence: 20
            }
        )

        column SITUACAOENTREGA (
            source {
                dataType: VARCHAR2
            }
            heading {
                heading: Situacaoentrega
            }
            layout {
                sequence: 70
            }
        )

        column VALOR_A_PAGAR (
            source {
                dataType: VARCHAR2
            }
            heading {
                heading: Valor a pagar
            }
            layout {
                sequence: 60
            }
        )

        column VALOR_TOTAL (
            source {
                dataType: VARCHAR2
            }
            heading {
                heading: Valor total
            }
            layout {
                sequence: 40
            }
        )

    )

    region top-10-distribuidores (
        name: Top 10 Distribuidores
        type: chart
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chartAppearance {
            orientation: horizontal
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        animation {
            onDataChange: slideToRight
        }
        legend {
            show: false
        }
        autoRefresh {
            interval: 60
        }

        series top-distr (
            name: Top Distr.
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select distribuidor
                         , quantidade
                         , valortotal
                    from (select roman.pck_romance.fnc_nomerepresentante(p.idrepresentante)||' - '||roman.pck_romance.fnc_nomefilial(p.idfilialromance)  distribuidor 
                               , count(1) quantidade
                               , sum(p.valortotal*p.fatorconversao) valortotal
                          from pedidos p
                          where trunc(dataemissao )   between to_date(:P15_DE) and to_date(:P15_ATE)
                            and p.datacancelamento is null
                            and p.idsituacaoentrega  >= 20000
                            and ( :P0_IDFILIALROMANCE = '999999999999' or p.idfilialromance = :P0_IDFILIALROMANCE )
                          group by p.idrepresentante,p.idfilialromance
                          order by sum(p.valortotal*p.fatorconversao) desc)
                    where rownum <=10
                    ```
                pageItemsToSubmit: [
                    P15_DE
                    P15_ATE
                ]
            }
            columnMapping {
                label: DISTRIBUIDOR
                value: VALORTOTAL
                z: QUANTIDADE
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            minorTicks {
                show: false
            }
        )

    )

    region top-20-clientes (
        name: Top 20 Clientes
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select vendedora
                     , representante
                     , quantidade
                     , valortotal
                from ( select roman.pck_romance.fnc_nomevendedora(p.idvendedora) vendedora
                            , ( select roman.pck_romance.fnc_nomerepresentante(v.idrepresentante)||' ('||roman.pck_romance.fnc_nomefilial(roman.pck_romance.fnc_filialvendedora(v.idvendedora))||') '
                                from vendedoras v
                                where v.idvendedora = p.idvendedora ) representante
                            , count(1) quantidade
                            , sum(p.valorapagar*p.fatorconversao) valortotal
                       from pedidos p
                       where trunc(dataemissao) between to_date(:P15_DE) and to_date(:P15_ATE)
                         and p.datacancelamento is null
                         and p.idsituacaoentrega  >= 20000
                         and ( :P0_IDFILIALROMANCE = '999999999999' or p.idfilialromance = :P0_IDFILIALROMANCE )
                         and exists ( select 1
                                      from roman.vw_filiais f
                                      where f.idfilial = p.idfilialromance
                                        and f.tipofilial = 'D' )
                         and not exists ( select 1
                                          from classificacoespedidos c
                                          where c.idpedido = p.idpedido
                                            and c.idcaracteristicapedido = 28 )
                       group by p.idvendedora
                       order by 4 desc)
                where rownum <=20
                ```
        }
        layout {
            sequence: 110
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: <b> Não está sendo levado em consideração os pedidos de representantes </b>
        }
        reportLayout {
            numberOfRows: 20
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column QUANTIDADE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Qtd Pedidos
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
            advanced {
                computeSum: true
            }
        )

        column REPRESENTANTE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Representante
                alignment: center
            }
            layout {
                sequence: 4
            }
        )

        column VALORTOTAL (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Valor Total a Pagar
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            sorting {
                defaultSequence: 1
                direction: desc
            }
            advanced {
                computeSum: true
            }
        )

        column VENDEDORA (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Cliente
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

    )

    region total-de-pedidos (
        name: Total de Pedidos
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select 'Total de Pedidos' empresa
                     , sum(p.valorapagar*p.fatorconversao) valorotal
                from pedidos p
                where trunc(dataemissao )   between to_date(:P15_DE) and to_date(:P15_ATE)
                  and p.datacancelamento is null
                  and ( :P0_IDFILIALROMANCE = '999999999999' or p.idfilialromance = :P0_IDFILIALROMANCE )
                  and p.idsituacaoentrega  >= 20000;
                ```
            pageItemsToSubmit: [
                P15_DE
                P15_ATE
            ]
        }
        layout {
            sequence: 10
            parentRegion: @valor-de-pedidos
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        settings {
            labelColumn: EMPRESA
            valueColumn: VALOROTAL
            formatMask: 999G999G999G990D00
            colorScheme: modern
        }
    )

    region valor-de-pedidos (
        name: "Valor de Pedidos "
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(emp.idfilial) empresa
                     , emp.valortotal valortotal
                from ( select p.idfilialromance idfilial
                            , sum(p.valorapagar*p.fatorconversao) valortotal
                       from pedidos p
                       where trunc(dataemissao) between to_date(:P15_DE) and to_date(:P15_ATE)
                         and p.datacancelamento is null
                         and ( :P0_IDFILIALROMANCE = '999999999999' or p.idfilialromance = :P0_IDFILIALROMANCE )
                         and p.idsituacaoentrega  >= 20000
                         and exists ( select 1
                                      from roman.vw_filiais f
                                      where f.tipofilial = 'D'
                                        and f.idfilial = p.idfilialromance )
                       group by p.idfilialromance
                       union
                       select c.idfilialromancedestino idfilial
                            , sum(v.valorvencimento) valortotal
                       from vencimentoscomprastransf v
                          , comprastransferencias c
                       where c.idcompratransferencia = v.idcompratransferencia
                         and v.valorvencimento > 0
                         and v.situacaovencimento = 'V'
                         and ( :P0_IDFILIALROMANCE = '999999999999' or c.idfilialromancedestino = :P0_IDFILIALROMANCE )
                         and exists ( select 1
                                      from pedidos p
                                         , pedidosremessasct pr
                                      where p.idpedido = pr.idpedido
                                        and pr.idcompratransferencia = v.idcompratransferencia
                                        and p.datacancelamento is null
                                        and p.idsituacaoentrega  >= 20000
                                        and trunc(dataemissao) between to_date(:P15_DE) and to_date(:P15_ATE) )
                       group by c.idfilialromancedestino ) emp
                order by 2 desc
                         
                
                ```
            pageItemsToSubmit: [
                P15_DE
                P15_ATE
            ]
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: EMPRESA
            valueColumn: VALORTOTAL
            formatMask: 999G999G999G990D00
            colorScheme: modern
            maximumRows: 30
        }
    )

    pageItem P15_ATE (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        validation {
            valueRequired: true
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                BEGIN
                  RETURN trunc(sysdate);
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P15_DE (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        validation {
            valueRequired: true
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                BEGIN
                  RETURN trunc(sysdate);
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction change (
        name: Change
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P15_DE
                P15_ATE
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @quantidade-de-pedidos
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @situações-de-pedidos-hoje
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh-3 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @top-10-distribuidores
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-refresh-4 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @valor-de-pedidos
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

        action native-refresh-5 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @total-de-pedidos
            }
            execution {
                sequence: 80
                fireOnInit: false
            }
        )

        action native-refresh-6 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @top-20-clientes
            }
            execution {
                sequence: 90
                fireOnInit: false
            }
        )

    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 1
                items: {
                    P1_ATE: &P15_DE.
                    P1_DE: &P15_ATE.
                    P0_IDFILIALROMANCE: &P0_IDFILIALROMANCE.
                }
                action: resetPagination
            }
        }
    )

)

