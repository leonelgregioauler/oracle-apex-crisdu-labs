page 12 (
    name: Editar Acessos Liberados
    title: Editar Acessos Liberados
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region controle (
        name: Controle
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
    )

    region editar-acessos-do-usuário (
        name: Editar Acessos do Usuário
        type: tabform
        source {
            sqlQuery:
                ```sql
                select a.idacesso
                     , a.usuario
                     , a.idaplicacao
                     , a.ativo
                     , ap.pagina
                     , decode(hierarquia,null,  '<b>'|| TO_CHAR(descricao) ||'</b>'
                                             , '<i>'||'* '|| TO_CHAR(descricao)||'</i>') hierarquia
                from roman.acessos a
                   ,  roman.aplicacoes ap
                where a.usuario = :P12_USUARIOS
                  and ap.idaplicacao = a.idaplicacao 
                  and ap.idsistema = 20010 
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 500
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationLinks
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhum acesso liberado.
        }
        componentAdvanced {
            stripHtml: true
        }

        column ATIVO (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 6
            }
        )

        column CHECK$01 (
            reportColumnQueryId: 7
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: &nbsp;
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
        )

        column HIERARQUIA (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Aplicação
                alignment: center
            }
            layout {
                sequence: 3
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDACESSO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 4
            }
        )

        column IDAPLICACAO (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

        column PAGINA (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Pagina
                alignment: center
            }
            layout {
                sequence: 7
            }
        )

        column USUARIO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 5
            }
        )

    )

    pageItem P12_USUARIOS (
        type: selectList
        label {
            label: Usuários
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct initcap(usuario) display_value
                     , usuario return_value 
                  from roman.usuariossistemas u 
                 where idsistema = 20010
                   and ativo = 'S'
                order by usuario;
                ```
        }
        layout {
            sequence: 10
            region: @controle
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Retirar Acesso(s)
        layout {
            sequence: 20
            region: @controle
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 30
            region: @controle
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-reply
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 11
                items: {
                    P11_USUARIOS: &P12_USUARIOS.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @editar-acessos-do-usuário
        target {
            tableName: ACESSOS
            pkColumn: IDACESSO
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# linhas atualizadas.
        }
        error {
            errorMessage: Unable to process update.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 1403289031147906437
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
            type: never
        }
    )

    process delete-rows (
        name: Delete rows
        type: tabformDelete
        editableRegion: @editar-acessos-do-usuário
        target {
            tableOwner: ROMAN
            tableName: ACESSOS
            pkColumn: IDACESSO
        }
        execution {
            sequence: 20
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 1403289489690906438
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

    branch (
        name: Go To Page 12
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 12
            }
            saveStateBeforeBranching: true
        }
    )

    branch (
        name: Go To Page 12
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 12
            }
            saveStateBeforeBranching: true
        }
    )

)

