            )

            displayColumn QTD_CICLO5 (
                sequence: 7
            )

            displayColumn QTD_CICLO6 (
                sequence: 5
            )

            displayColumn VALOR_CICLO1 (
                sequence: 16
            )

            displayColumn VALOR_CICLO2 (
                sequence: 14
            )

            displayColumn VALOR_CICLO3 (
                sequence: 12
            )

            displayColumn VALOR_CICLO4 (
                sequence: 10
            )

            displayColumn VALOR_CICLO5 (
                sequence: 8
            )

            displayColumn VALOR_CICLO6 (
                sequence: 6
            )

            computation APXWS_CC_001 (
                identifier: C01
                source {
                    expression:
                        ```sql
                        case
                          when (  O > 0 ) and (  M > 0 ) and(  K > 0 ) and (  I > 0 ) and (  G > 0 ) and  (  E > 0 ) then
                            'Sim'
                          when (  O > 0 ) and (  M > 0 ) and (  K > 0 ) then
                            'Sim'
                          when (  M > 0 ) and (  K > 0 ) and (  I > 0 ) then
                            'Sim'
                          when (  K > 0 ) and (  I > 0 ) and (  G > 0 ) then
                            'Sim'
                          when (  I > 0 ) and (  G > 0 ) and (  E > 0 ) then
                            'Sim'
                          else
                            'Não' 
                        end
                        ```
                    dataType: varchar2
                }
                label {
                    column: Elegível?
                }
            )

        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region legenda (
        name: Legenda
        type: staticContent
        source {
            htmlCode: <b> Ciclo 1 = Edição de Revista Atual </b><br><br> Ciclo 2 = Ultima edição de revista vigente, assim, sucessivamente.
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                is-collapsed
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P65_IDFILIALROMANCE (
        type: selectList
        label {
            label: Filial
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from roman.vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                  and f.idgrupo != 5
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P65_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(r.idrepresentante)||' ('||decode(ativo,'S','Ativo','N','Inativo')||')' display_value
                     , r.idrepresentante 
                from representantes r
                where r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P65_IDFILIALROMANCE )
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P65_IDFILIALROMANCE
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P65_IDVENDEDORA (
        type: popupLov
        label {
            label: Consultora
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' CPF: '||p.cpf||' - Sit. '||decode(v.ativo,'S','Ativa','N','Inativa') display_value
                     , v.idvendedora return_value
                from vendedoras v
                   , pessoas p
                where p.idpessoa = v.idpessoa
                  and ( :P65_IDREPRESENTANTE is null or v.idrepresentante = :P65_IDREPRESENTANTE )
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P65_IDREPRESENTANTE
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction filtra-e-gera-relatório (
        name: Filtra e Gera Relatório
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process realiza-filtro-e-cria-relatório (
        name: Realiza filtro e Cria relatório
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_bi_fav.prc_gera_fidelidade;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 108056699121057705
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 65
                items: {
                    P65_IDFILIALROMANCE: &P65_IDFILIALROMANCE.
                    P65_IDREPRESENTANTE: &P65_IDREPRESENTANTE.
                    P65_IDVENDEDORA: &P65_IDVENDEDORA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

