        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 1080678 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn APXWS_CC_001 (
                sequence: 17
            )

            displayColumn CONSULTORA (
                sequence: 3
