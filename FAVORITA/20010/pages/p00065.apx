page 65 (
    name: Fidelidade de Clientes
    title: Fidelidade de Clientes
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region fidelidade-de-clientes (
        name: Fidelidade de Clientes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(t.idfilialromance) empresa
                     , roman.pck_romance.fnc_nomerepresentante(t.idrepresentante) distribuidor
                     , roman.pck_romance.fnc_nomevendedora(t.idvendedora) consultora
                     , roman.pck_romance.fnc_cpfvendedora(t.idvendedora) cpf
                     , t.qtd_ciclo6
                     , t.valor_ciclo6
                     , t.qtd_ciclo5
                     , t.valor_ciclo5
                     , t.qtd_ciclo4
                     , t.valor_ciclo4
                     , t.qtd_ciclo3
                     , t.valor_ciclo3
                     , t.qtd_ciclo2
                     , t.valor_ciclo2
                     , t.qtd_ciclo1
                     , t.valor_ciclo1
                from tmp_rel_fidelizados t
                where ( :P65_IDFILIALROMANCE is null or t.idfilialromance = :P65_IDFILIALROMANCE )
                  and ( :P65_IDREPRESENTANTE is null or t.idrepresentante = :P65_IDREPRESENTANTE )
                  and ( :P65_IDVENDEDORA is null or t.idvendedora = :P65_IDVENDEDORA )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 107921822612857234
        }

