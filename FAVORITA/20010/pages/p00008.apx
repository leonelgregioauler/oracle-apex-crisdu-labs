    region comissão-paga-distribuidor (
        name: Comissão Paga Distribuidor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(cp.idrepresentante) representante
                     , sum(cp.comissaodistribuidor) comissao
                     , roman.pck_romance.fnc_nomefilial(cp.idfilialromance) filialromance
                from vw_comissoes_pagar_fav cp
                where exists ( select 1
                               from catal.pagamentocomissoes pg
                               where pg.idpedido = cp.idpedido
                                 and pg.idrepresentante is not null )
                  and ( :P8_IDFILIALROMANCE is null or cp.idfilialromance = :P8_IDFILIALROMANCE ) 
                  and ( :P8_TIPOPESQUISA = 'T' or exists ( select 1
                                                           from catal.pagamentocomissoes pg
                                                           where pg.idpedido = cp.idpedido
                                                             and pg.idrepresentante is not null
                                                             and pck_util.fnc_idsemanadata(pg.datapagamento) between pck_util.fnc_idsemana(:P8_SEMANAINICIO) and pck_util.fnc_idsemana(:P8_SEMANAFIM) ) )
                  and :P8_FILTRAR = 'S'
                group by cp.idrepresentante 
                       , cp.idfilialromance
                order by 3 , 1
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 777022349066272011
        }

        column COMISSAO (
            type: plainText
            heading {
                heading: Comissão
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            appearance {
                formatMask: FML999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

