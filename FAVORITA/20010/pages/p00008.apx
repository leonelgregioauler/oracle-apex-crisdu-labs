page 8 (
    name: Comissões Favorita
    title: Comissões Favorita
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region comissão-a-pagar-distribuidor (
        name: Comissão a Pagar Distribuidor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(cp.idrepresentante) representante
                     , sum(cp.comissaodistribuidor) comissao
                     , roman.pck_romance.fnc_nomefilial(cp.idfilialromance) filialromance
                from vw_comissoes_pagar_fav cp
                where not exists ( select 1
                                   from catal.pagamentocomissoes pg
                                   where pg.idpedido = cp.idpedido
                                     and pg.idrepresentante is not null )
                  and ( :P8_IDFILIALROMANCE is null or cp.idfilialromance = :P8_IDFILIALROMANCE )
                  and cp.comissaodistribuidor > 0 
                  and :P8_FILTRAR = 'S'  
                group by cp.idrepresentante 
                       , cp.idfilialromance
                order by 3 , 1
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent10
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 777021618535272004
        }

        column COMISSAO (
            type: plainText
            heading {
                heading: Comissão
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            appearance {
                formatMask: FML999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column FILIALROMANCE (
            type: plainText
            heading {
                heading: Filial
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column REPRESENTANTE (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        savedReport 7770305 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100
            }

            displayColumn COMISSAO (
                sequence: 2
            )

            displayColumn FILIALROMANCE (
                sequence: 3
            )

            displayColumn REPRESENTANTE (
                sequence: 1
            )

            aggregate (
                column: COMISSAO
            )

            controlBreak (
                column: FILIALROMANCE
                layout {
                    sequence: 1
                }
            )

        )

    )

