        type: datePicker
        label {
            label: até
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 30
        }
