    region venda-por-loja-valor-de-boleto-ano-anterior (
        name: Venda por Loja (Valor de Boleto) - Ano Anterior
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select p.filialfavorita ||' - Pedidos: '||trim(to_char(count(1),'999G999G999G990')) 
                                        ||' Consult.: ' ||trim(to_char(count( distinct p.vendedora),'999G999G999G990')) 
                                        ||' Tk Médio: ' ||trim(to_char(avg(p.valorapagar*p.fatorconversao),'999G999G999G990D00'))  filialfavorita
                --     , trunc(p.dataemissao) dataemissao
                     , count( distinct p.vendedora) consultoras   
                     , round(sum(p.valorapagar*p.fatorconversao))  valorapagar
                from favorita.vw_pedidos_fav p
                where p.dataemissao  between to_date(:P86_DATAINICIO||' 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss')-365 and to_date(:P86_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss')-365
                --where p.dataemissao  between to_date('01/01/2020 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date('29/04/2020 23:59:59','DD/MM/RRRR  hh24:mi:ss')
                  and p.ididioma = 1
                  -- Maicon Aimi - 8545212 - 13/03/2024 - Solicitado para não exibir mais a filial 86-Loja Manaus Zona Leste ( Não Usar )
                  and p.idfilialfavorita != '86'
                  and p.valortotal  > 0
                  and exists ( select 1
                               from favorita.filiaisfavorita f
                               where f.idfilialfavorita = p.idfilialfavorita
                                 and tipofilial         = 'L' )
                  and p.datacancelamento is null
                  and p.idsituacaoentrega >= 20000
                group by p.filialfavorita
                union
                select w.nomefilialfavorita filialfavorita
                     , 0 consultoras
                     , 0 valorapgar
                from favorita.vw_filiaisfavorita w
                where w.tipofilial = 'Loja'
                  -- Maicon Aimi - 8545212 - 13/03/2024 - Solicitado para não exibir mais a filial 86-Loja Manaus Zona Leste ( Não Usar )
                  and w.idfilialfavorita != 86
                  and not exists ( select 1
                                   from favorita.vw_pedidos_fav p
                                   where p.dataemissao  between to_date(:P86_DATAINICIO||' 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss')-365 and to_date(:P86_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss')-365
                                   --where p.dataemissao  between to_date('01/01/2020 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date('29/04/2020 23:59:59','DD/MM/RRRR  hh24:mi:ss')
                                     and p.ididioma = 1 
                                     -- Maicon Aimi - 8545212 - 13/03/2024 - Solicitado para não exibir mais a filial 86-Loja Manaus Zona Leste ( Não Usar )
                                     and p.idfilialfavorita != 86
                                     and p.idfilialfavorita  = w.idfilialfavorita
                                     and p.valortotal  > 0
                                     and exists ( select 1
                                                  from favorita.filiaisfavorita f
                                                  where f.idfilialfavorita = p.idfilialfavorita
                                                    and tipofilial         = 'L' )
                                     and p.datacancelamento is null
                                     and p.idsituacaoentrega >= 20000 )
                  
                      -- , trunc(p.dataemissao)
                union
                select 'Total'  filialfavorita
                --     , trunc(p.dataemissao) dataemissao
                     , count( distinct p.vendedora) consultoras   
                     , round(sum(p.valorapagar*p.fatorconversao))  valorapagar
                from favorita.vw_pedidos_fav p
                where p.dataemissao  between to_date(:P86_DATAINICIO||' 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss')-365 and to_date(:P86_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss')-365
                --where p.dataemissao  between to_date('01/01/2020 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date('29/04/2020 23:59:59','DD/MM/RRRR  hh24:mi:ss')
                  and p.ididioma = 1
                  and p.valortotal  > 0
                  -- Maicon Aimi - 8545212 - 13/03/2024 - Solicitado para não exibir mais a filial 86-Loja Manaus Zona Leste ( Não Usar )
                  and p.idfilialfavorita != 86
                  and exists ( select 1
                               from favorita.filiaisfavorita f
                               where f.idfilialfavorita = p.idfilialfavorita
                                 and tipofilial         = 'L' )
                  and p.datacancelamento is null
                  and p.idsituacaoentrega >= 20000
                order by 1
                ```
            pageItemsToSubmit: [
                P86_DATAINICIO
                P86_DATAFIM
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from dual
                 where (:P86_DATAINICIO is not null and :P86_DATAFIM is not null)
                ```
        }
        settings {
            labelColumn: FILIALFAVORITA
            valueColumn: VALORAPAGAR
            maximumRows: 50
            messageWhenNoDataFound: Dados não encontrados
        }
    )

