    region 15-produtos-mais-vendidos-por-valor-de-boleto-ano-anterior (
        name: 15 Produtos Mais Vendidos - Por Valor de Boleto - Ano Anterior
        title: 15 Produtos Mais Vendidos - Por Valor de Boleto - Ano Anterior
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomeprodutodetalhado(i.idprodutodetalhado,1) ||' - Qtd:'|| sum(i.quantidade) nome 
                     , sum(i.quantidade) quantidade
                     , round(sum(i.valorapagar*p.fatorconversao)) valor
                  /*   , round(sum(( select favorita.pck_estoque_fav.fnc_estoquedisponivel(e.idestoque)
                         from favorita.estoques e
                         where e.idfilialfavorita   = p.idfilialfavorita
                           and e.idprodutodetalhado = i.idprodutodetalhado )) ) qtdestoqueloja
                     , round(sum(( select sum(ic.quantidadecomprada)
                         from favorita.itenscomprastransferencias ic
                         where ic.idprodutodetalhado = i.idprodutodetalhado
                           and exists ( select 1
                                        from favorita.comprastransferencias c
                                        where c.idcompratransferencia   = ic.idcompratransferencia
                                          and c.idfilialfavoritadestino = p.idfilialfavorita
                                          and c.idtipocomptransrem      = 1
                                          and c.idsituacao              in (0,3,5) ) ) )) qtdjasolicitada    */ 
                from favorita.itenspedidos i
                   , favorita.pedidos p
                where p.idpedido         = i.idpedido
                --  and p.dataemissao  between to_date('01/04/2020 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date('29/04/2020 23:59:59','DD/MM/RRRR  hh24:mi:ss')
                  and p.dataemissao  between to_date(:P86_DATAINICIO||' 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') -365 and to_date(:P86_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss') -365
                  and exists ( select 1
                               from favorita.filiaisfavorita f
                               where f.idfilialfavorita = p.idfilialfavorita
                                 and tipofilial         = 'L' )
                  and p.datacancelamento is null
                  and p.idsituacaoentrega >= 20000
                  -- Maicon Aimi - 8545212 - 13/03/2024 - Solicitado para não exibir mais a filial 86-Loja Manaus Zona Leste ( Não Usar )
                  and p.idfilialfavorita != 86
                group by i.idprodutodetalhado
                order by 3 desc
                ```
            pageItemsToSubmit: [
                P86_DATAINICIO
                P86_DATAFIM
            ]
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from dual
                 where (:P86_DATAINICIO is not null and :P86_DATAFIM is not null)
                ```
        }
        settings {
            labelColumn: NOME
            valueColumn: VALOR
            maximumRows: 15
            messageWhenNoDataFound: Dados não encontrados
        }
    )

