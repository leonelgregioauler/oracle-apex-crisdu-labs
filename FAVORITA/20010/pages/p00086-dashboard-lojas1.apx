    region análise-de-entregas (
        name: Análise de Entregas
        title: Análise de Entregas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idfilial
                     , roman.pck_romance.fnc_nomefilial(idfilial) empresa
                     , count(distinct idvendedora) atendidas_romance                         
                     --
                     -- previsão de entrega no periodo    
                     --
                     , ( select count(distinct w.idvendedora)
                                  from favorita.vw_pedidos_fav w
                                  where w.idfilialromance = n.idfilial
                                    and w.ididioma        = 1
                                    -- Maicon Aimi - 8545212 - 13/03/2024 - Solicitado para não exibir mais a filial 86-Loja Manaus Zona Leste ( Não Usar )
                                    and w.idfilialfavorita != 86
                                    and w.tipopedido      = 'P'
                                    and w.dataentrega between to_date(:P86_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss') and  to_date(:P86_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss')   
                                    -- montado
                                    and exists ( select 1
                                                 from favorita.classificacoespedidos c
                                                 where c.idpedido               = w.idpedido
                                                   and c.idcaracteristicapedido = 18 ) )  prev_entrega_no_p    
                     --
                     --  cancelados com entrega no periodo
                     --
                     , ( select count(distinct w.idvendedora)
                                  from favorita.vw_pedidos_fav w
                                  where w.idfilialromance = n.idfilial
                                    and w.ididioma        = 1                                            
                                    and w.tipopedido      = 'P'
                                    -- Maicon Aimi - 8545212 - 13/03/2024 - Solicitado para não exibir mais a filial 86-Loja Manaus Zona Leste ( Não Usar )
                                    and w.idfilialfavorita != 86
                                    and w.dataentrega between to_date(:P86_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss') and  to_date(:P86_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss')  
                                    -- montado
                                    and exists ( select 1
                                                 from favorita.classificacoespedidos c
                                                 where c.idpedido               = w.idpedido
                                                   and c.idcaracteristicapedido = 18 ) 
                                    -- cancelado           
                                    and w.datacancelamento is not null )   cancelados    
                     --
                     --  confirmado que não entregou  
                     --
                     , ( select count(distinct w.idvendedora)
                         from favorita.vw_pedidos_fav w
                         where w.idfilialromance = n.idfilial
                           and w.ididioma        = 1                                            
                           and w.tipopedido      = 'P'
                           -- Maicon Aimi - 8545212 - 13/03/2024 - Solicitado para não exibir mais a filial 86-Loja Manaus Zona Leste ( Não Usar )
                           and w.idfilialfavorita != 86
                           and w.dataentrega between to_date(:P86_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss') and  to_date(:P86_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss')     
                           -- montado
                           and exists ( select 1
                                        from favorita.classificacoespedidos c
                                        where c.idpedido               = w.idpedido
                                          and c.idcaracteristicapedido = 18 ) 
                           -- não cancelado 
                           and w.datacancelamento is null   
                            -- NÃO ENTREGUE                  
                            and exists ( select 1
                                               from favorita.classificacoespedidos c
                                               where c.idpedido               = w.idpedido
                                                 and c.idcaracteristicapedido = 75  ) 
                           and not exists ( select 1
                                               from favorita.classificacoespedidos c
                                               where c.idpedido               = w.idpedido
                                                 and c.idcaracteristicapedido = 76  ) ) confirmado_que_nao_entregou
                     --
                     -- confirmado que entregou
                     --     
                     , ( select count(distinct w.idvendedora)
                          from favorita.vw_pedidos_fav w
                          where w.idfilialromance = n.idfilial
                            and w.ididioma        = 1                                            
                            and w.tipopedido      = 'P'
                            -- Maicon Aimi - 8545212 - 13/03/2024 - Solicitado para não exibir mais a filial 86-Loja Manaus Zona Leste ( Não Usar )
                            and w.idfilialfavorita != 86
                            and w.dataentrega between to_date(:P86_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss') and  to_date(:P86_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss')     
                           -- montado
                           and exists ( select 1
                                        from favorita.classificacoespedidos c
                                        where c.idpedido               = w.idpedido
                                          and c.idcaracteristicapedido = 18 ) 
                            -- não cancelado 
                            and w.datacancelamento is null
                            -- ENTREGUE      
                            and exists ( select 1
                                          from favorita.classificacoespedidos c
                                          where c.idpedido               = w.idpedido
                                            and c.idcaracteristicapedido = 76 )   )   confirmado_que_entregou
                     --
                     -- confirmado que entregou
                     --     
                     , ( select count(distinct w.idvendedora)
                          from favorita.vw_pedidos_fav w
                          where w.idfilialromance = n.idfilial
                            and w.ididioma        = 1                                            
                            and w.tipopedido      = 'P'
                            -- Maicon Aimi - 8545212 - 13/03/2024 - Solicitado para não exibir mais a filial 86-Loja Manaus Zona Leste ( Não Usar )
                            and w.idfilialfavorita != 86
                            and w.dataentrega between to_date(:P86_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss') and  to_date(:P86_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss')     
                           -- montado
                           and exists ( select 1
                                        from favorita.classificacoespedidos c
                                        where c.idpedido               = w.idpedido
                                          and c.idcaracteristicapedido = 18 ) 
                            -- não cancelado 
                            and w.datacancelamento is null
                            -- sem retorno                   
                            and not exists ( select 1
                                                from favorita.classificacoespedidos c
                                                where c.idpedido               = w.idpedido
                                                  and c.idcaracteristicapedido in (75, 76   ) ) ) com_distribuidor
                     --                        
                     --                  
                from roman.notasvendas n
                where n.dataacerto between to_date(:P86_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss') and  to_date(:P86_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss') 
                  and n.idsituacaonotavenda = 4
                  and ( :P15_TIPOPESQUISA = 'T'
                     or ( :P86_TIPOPESQUISA = 'F' and (:P86_IDFILIAL is null or n.idfilial = :P86_IDFILIAL ) )
                     or ( :P86_TIPOPESQUISA = 'G' and n.idfilial in ( select ff.idfilial 
                                                                        from roman.filtrosfiliais ff
                                                                        where ff.usuario = v('APP_USER') ) ) )
                group by idfilial  
                order by 2
                ```
        }
        layout {
            sequence: 140
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                :P26_DATAINICIO is not null
                  and :P26_DATAFIM is not null
                and 1 = 2
                ```
        }
        comments {
            comments: Esta tela é uma copia da tela 26 do sistema 29000, alterações nesta tela devem ser replicadas.
        }
