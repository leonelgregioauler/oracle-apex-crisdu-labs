        }

        series new (
            name: New
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select p.filialfavorita
                         , trunc(p.dataemissao) dataemissao
                         , 'Qtd Pedidos: '||count(1) pedidos
                         , count( distinct p.vendedora) consultoras   
                         , sum(p.valorapagar*p.fatorconversao) valorapagar
                    from favorita.vw_pedidos_fav p
                    where p.dataemissao  between to_date(:P86_DATAINICIO||' 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date(:P86_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss')
                    --where p.dataemissao  between to_date('01/04/2020 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date('29/04/2020 23:59:59','DD/MM/RRRR  hh24:mi:ss')
                      and p.ididioma = 1
                      and p.valortotal  > 0
                      and exists ( select 1
                                   from favorita.filiaisfavorita f
                                   where f.idfilialfavorita = p.idfilialfavorita
                                     -- Maicon Aimi - 8545212 - 13/03/2024 - Solicitado para não exibir mais a filial 86-Loja Manaus Zona Leste ( Não Usar )
                                     and f.idfilialfavorita != 86
                                     and tipofilial         = 'L' )
                      and p.datacancelamento is null
                      and p.idsituacaoentrega >= 20000
                      -- Maicon Aimi - 8545212 - 13/03/2024 - Solicitado para não exibir mais a filial 86-Loja Manaus Zona Leste ( Não Usar )
                      and p.idfilialfavorita != 86
                    group by p.filialfavorita
                           , trunc(p.dataemissao)
                    order by 2, 5       
                    ```
            }
            columnMapping {
                seriesName: FILIALFAVORITA
                label: DATAEMISSAO
                value: CONSULTORAS
            }
