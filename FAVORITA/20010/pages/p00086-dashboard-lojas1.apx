page 86 (
    name: Dashboard Lojas
    alias: DASHBOARD-LOJAS1
    title: Dashboard Lojas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }

    region 15-atendentes-que-mais-vendem-por-valor-de-boleto-ano-anterior (
        name: 15 Atendentes que mais vendem - Por Valor de Boleto - Ano Anterior
        title: 15 Atendentes que mais vendem - Por Valor de Boleto - Ano Anterior
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select p.filialfavorita
                     , p.nomeusuario||' ('||p.filialfavorita||')' nomeusuario
                --     , trunc(p.dataemissao) dataemissao
                     , count(1) pedidos
                     , count( distinct p.vendedora) consultoras   
                     , round(sum(nvl(p.valorapagar,0)*p.fatorconversao)) valorapagar
                from favorita.vw_pedidos_fav p
                where p.dataemissao  between to_date(:P86_DATAINICIO||' 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') -365 and to_date(:P86_DATAFIM||'23:59:59','DD/MM/RRRR  hh24:mi:ss') -365
                --where p.dataemissao  between to_date('01/04/2020 00:00:00'  ,'DD/MM/RRRR hh24:mi:ss') and to_date('29/04/2020 23:59:59','DD/MM/RRRR  hh24:mi:ss')
                  and p.ididioma = 1
                  and p.valortotal  > 0
                  and exists ( select 1
                               from favorita.filiaisfavorita f
                               where f.idfilialfavorita = p.idfilialfavorita
                                 and tipofilial         = 'L' )
                  and p.datacancelamento is null
                  and p.idsituacaoentrega >= 20000
                  -- Maicon Aimi - 8545212 - 13/03/2024 - Solicitado para não exibir mais a filial 86-Loja Manaus Zona Leste ( Não Usar )
                  and p.idfilialfavorita != 86
                group by p.filialfavorita
                --       , trunc(p.dataemissao)
                       , p.nomeusuario
                order by 5 desc
                ```
            pageItemsToSubmit: [
                P86_DATAINICIO
                P86_DATAFIM
            ]
        }
        layout {
            sequence: 120
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from dual
                 where (:P86_DATAINICIO is not null and :P86_DATAFIM is not null)
                ```
        }
        settings {
            labelColumn: NOMEUSUARIO
            valueColumn: VALORAPAGAR
            maximumRows: 15
            messageWhenNoDataFound: Dados não encontrados
        }
    )

