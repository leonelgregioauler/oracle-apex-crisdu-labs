        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function doLoad()
            {
               setTimeout( "refresh()", 20*1000 );
            }
            
            function refresh()
            {
            window.location.href = window.location;
             apex.submit('TROCAPAGINA');
            }
            
            ```
        executeWhenPageLoads: doLoad();
    }
