        )

    )

    region ranking-do-mês-2 (
        name: Ranking do Mês
        type: chart
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chartAppearance {
            orientation: horizontal
        }
        chartLayout {
            maxWidth: 800
            height: 800
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        animation {
            onDataChange: none
        }
        tooltip {
            showSeriesName: false
            showGroupName: false
            showValue: false
        }
        legend {
            show: false
        }

        series mes (
            name: MES
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select aux.posicao                                                as "Posição"
                         , aux.atendente                                              as "Atendente"
                         , aux.valor                                                  as "Valor"
                         , aux.pedidos                                                as "Pedidos"
                         , to_char(trunc(aux.valor/aux.pedidos,2),'FM999G999G990D00') as "Ticket Médio"
                       , 'Total: '||aux.valor||' Qtd Pedidos: '||aux.pedidos        as "Legenda"
                      from (select row_number() over (order by sum(p.valorapagar * p.fatorconversao) desc) posicao
                                 , upper(pes.nomepessoa)                                                   atendente
                                 , trunc(sum(p.valorapagar * p.fatorconversao),2)                          valor
                                 , count(p.idpedido)                                                       pedidos
                              from favorita.pedidos  p
                                 , catal.usuarios    u
                                 , catal.pessoas     pes
                             where u.idusuario          = p.idusuario
                               and pes.idpessoa         = u.idpessoa
                               and nvl(p.valorapagar,0) > 0
                               and p.idsituacaoentrega  >= 20000
                               and p.tipopedido         in ('P','R')
                               and p.idfilialfavorita   = 1
                               and p.dataemissao        between trunc(sysdate,'MM') and last_day(sysdate)
                               and not exists ( select 1
                                                  from favorita.classificacoespedidos c
                                                 where c.idcaracteristicapedido = 25
                                                   and c.idpedido = p.idpedido )
                               and not exists ( select 1
                                                  from favorita.classificacoespedidos c
                                                 where c.idcaracteristicapedido = 8
                                                   and c.idvalorcaracteristica  = 16
                                                   and c.idpedido               = p.idpedido )
                             group by pes.nomepessoa) aux
                     order by aux.posicao
                    ```
            }
            columnMapping {
                label: "Atendente"
                value: "Valor"
                customTooltip: "Legenda"
                legendTooltip: "Legenda"
            }
            label {
                show: true
                position: aboveMarker
            }
        )

        axis x (
            name: x
            title: Atendente
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            showAxis: false
            title: Valor
            value {
                format: decimal
                scale: log
            }
            minorTicks {
                show: false
            }
        )

    )

    pageItem P76_QTD_PEDIDOS_GERAL (
        type: hidden
        layout {
            sequence: 20
            region: @ranking-do-mês
            slot: regionBody
        }
    )

    pageItem P76_TICKET_MEDIO_GERAL (
        type: hidden
        layout {
            sequence: 10
            region: @ranking-do-mês
            slot: regionBody
        }
    )

    pageItem P76_TOTAL_GERAL (
        type: hidden
        layout {
            sequence: 30
            region: @ranking-do-mês
            slot: regionBody
        }
    )

    process carrega-totalizadores (
        name: Carrega Totalizadores
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                    /* busca os totalizador para exibir na página do relatório*/
                    begin
                        select sum(p.valorapagar * p.fatorconversao) as valor
                             , count(p.idpedido)                     as pedidos
                          into :P76_TOTAL_GERAL
                             , :P76_QTD_PEDIDOS_GERAL
                          from favorita.pedidos  p
                         where nvl(p.valorapagar,0) > 0
                           and p.idsituacaoentrega  >= 20000
                           and p.tipopedido         in ('P','R')
                           and p.idfilialfavorita   = 1
                           and p.dataemissao        between trunc(sysdate, 'MM') and last_day(sysdate)
                           and not exists ( select 1
                                              from favorita.classificacoespedidos c
                                             where c.idcaracteristicapedido = 25
                                               and c.idpedido = p.idpedido )
                           and not exists ( select 1
                                              from favorita.classificacoespedidos c
                                             where c.idcaracteristicapedido = 8
                                               and c.idvalorcaracteristica  = 16
                                               and c.idpedido               = p.idpedido );
                    
                        /* monta o ticket médio geral*/
                        if nvl(:P76_TOTAL_GERAL,0) > 0 then
                            :P76_TICKET_MEDIO_GERAL := to_char(trunc((:P76_TOTAL_GERAL/nvl(:P76_QTD_PEDIDOS_GERAL,1)),2),'FM999G999G999D90');
                            :P76_TOTAL_GERAL := to_char(trunc(:P76_TOTAL_GERAL,2),'FM999G999G999D90');
                            :P76_QTD_PEDIDOS_GERAL := to_char(:P76_QTD_PEDIDOS_GERAL,'999G999G999G999');
                        else
                            :P76_TICKET_MEDIO_GERAL := 0;
                            :P76_TOTAL_GERAL := 0;
                            :P76_QTD_PEDIDOS_GERAL := 0;
                        end if;
                    exception
                        when others then
                            :P76_TICKET_MEDIO_GERAL := 0;
                            :P76_TOTAL_GERAL := 0;
                            :P76_QTD_PEDIDOS_GERAL := 0;
                    end;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 51701109084867608
        }
    )

    branch (
        name: Go To Page 75
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 75
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: TROCAPAGINA
        }
    )

)

