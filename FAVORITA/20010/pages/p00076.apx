    region ranking-do-mês (
        name: Ranking do Mês
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select aux.posicao                                                as "Posição"
                     , case 
                         when aux.valor >= 3000.00 then
                           '<font color="green"><b>'||aux.atendente||'</b></font>'
                         when aux.valor between 2000.00 and 2999.99 then
                           '<font color="blue"><b>'||aux.atendente||'</b></font>'
                         else
                           aux.atendente
                       end                                                        as "Atendente"
                     , case 
                         when aux.valor >= 3000.00 then
                           '<font color="green"><b>'||to_char(aux.valor,'FM999G999G990D00')||'</b></font>'
                         when aux.valor between 2000.00 and 2999.99 then
                           '<font color="blue"><b>'||to_char(aux.valor,'FM999G999G990D00')||'</b></font>'
                         else
                           to_char(aux.valor,'FM999G999G990D00')
                       end                                                        as "Valor"
                     , aux.pedidos                                                as "Pedidos"
                     , to_char(trunc(aux.valor/aux.pedidos,2),'FM999G999G990D00') as "Ticket Médio"
                  from (select row_number() over (order by sum(p.valorapagar * p.fatorconversao) desc) posicao
                             , upper(pes.nomepessoa)                                                   atendente
                             , trunc(sum(p.valorapagar * p.fatorconversao),2)                          valor
                             , count(p.idpedido)                                                       pedidos
                          from favorita.pedidos  p
                             , catal.usuarios    u
                             , catal.pessoas     pes
                         where u.idusuario          = p.idusuario
                           and pes.idpessoa         = u.idpessoa
                           and nvl(p.valorapagar,0) > 0
                           and p.idsituacaoentrega  >= 20000
                           and p.tipopedido         in ('P','R')
                           and p.idfilialfavorita   = 1
                           and p.dataemissao        between trunc(sysdate, 'MM') and last_day(sysdate)
                           and not exists ( select 1
                                              from favorita.classificacoespedidos c
                                             where c.idcaracteristicapedido = 25
                                               and c.idpedido = p.idpedido )
                           and not exists ( select 1
                                              from favorita.classificacoespedidos c
                                             where c.idcaracteristicapedido = 8
                                               and c.idvalorcaracteristica  = 16
                                               and c.idpedido               = p.idpedido )
                         group by pes.nomepessoa) aux
                 order by aux.posicao
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <br>
                <div style="border: 1px solid #1E90FF; padding: 10px 10px; width: fit-content; position: relative; background-color: #F0F8FF; color: #4682B4; font-size: 18px;">
                    <span style="position: absolute; top: -12px; left: 10px; background-color: #1E90FF; color: white; padding: 5 5px; font-weight: bold; border-radius: 3px;">Totalizados do MÊS</span>
                    <div style="display: flex; margin-top: 10px; gap: 50px;">
                        <div>Total R$: &P76_TOTAL_GERAL.</div>
                        <div>Pedidos: &P76_QTD_PEDIDOS_GERAL.</div>
                        <div>Ticket Médio R$: &P76_TICKET_MEDIO_GERAL.</div>
                    </div>
                </div>
                <br>
                ```
        }
        reportLayout {
            numberOfRows: 30
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column Atendente (
