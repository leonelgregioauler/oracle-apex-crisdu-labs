                     , sum("32_PERDA")  "32_PERDA"
                   , case 
                       when grouping_id (nvl(idfilialromance, 99), idprodutodetalhado) in (1, 3) then 
                         '<div class="preto">'||
                         sum(nvl("35_VENDA",0) + 
                             nvl("36_VENDA",0) +
                             nvl("10_VENDA",0) +
                             nvl("11_VENDA",0) + 
                             nvl("12_VENDA",0) +
                             nvl("13_VENDA",0) +
                             nvl("14_VENDA",0) + 
                             nvl("15_VENDA",0) +
                             nvl("16_VENDA",0) +
                             nvl("17_VENDA",0) + 
                             nvl("18_VENDA",0) +
                             nvl("19_VENDA",0) +
                             nvl("20_VENDA",0) + 
                             nvl("21_VENDA",0) +
                             nvl("22_VENDA",0) +
                             nvl("23_VENDA",0) + 
                             nvl("24_VENDA",0) +
                             nvl("25_VENDA",0) +
                             nvl("26_VENDA",0) + 
                             nvl("27_VENDA",0) +
                             nvl("28_VENDA",0) + 
                             nvl("29_VENDA",0) + 
                             nvl("32_VENDA",0))||
                         '</div>'
                     else
                       to_char(sum(nvl("35_VENDA",0) + 
                                   nvl("36_VENDA",0) +
                                   nvl("10_VENDA",0) +
                                   nvl("11_VENDA",0) + 
                                   nvl("12_VENDA",0) +
                                   nvl("13_VENDA",0) +
                                   nvl("14_VENDA",0) + 
                                   nvl("15_VENDA",0) +
                                   nvl("16_VENDA",0) +
                                   nvl("17_VENDA",0) + 
                                   nvl("18_VENDA",0) +
                                   nvl("19_VENDA",0) +
                                   nvl("20_VENDA",0) + 
                                   nvl("21_VENDA",0) +
                                   nvl("22_VENDA",0) +
                                   nvl("23_VENDA",0) + 
                                   nvl("24_VENDA",0) +
                                   nvl("25_VENDA",0) +
                                   nvl("26_VENDA",0) + 
                                   nvl("27_VENDA",0) +
                                   nvl("28_VENDA",0) + 
                                   nvl("29_VENDA",0) + 
                                   nvl("32_VENDA",0)))
                     end totalvendafiliais
                   , case
                       when grouping_id (nvl(idfilialromance, 99), idprodutodetalhado) in (1, 3) then
                         '<div class="preto">'||
                         sum(nvl("35_VENDA",0) + 
                             nvl("36_PERDA",0) +
                             nvl("10_PERDA",0) +
                             nvl("11_PERDA",0) + 
                             nvl("12_PERDA",0) +
                             nvl("13_PERDA",0) +
                             nvl("14_PERDA",0) + 
                             nvl("15_PERDA",0) +
                             nvl("16_PERDA",0) +
                             nvl("17_PERDA",0) + 
                             nvl("18_PERDA",0) +
                             nvl("19_PERDA",0) +
                             nvl("20_PERDA",0) + 
                             nvl("21_PERDA",0) +
                             nvl("22_PERDA",0) +
                             nvl("23_PERDA",0) + 
                             nvl("24_PERDA",0) +
                             nvl("25_PERDA",0) +
                             nvl("26_PERDA",0) + 
                             nvl("27_PERDA",0) +
                             nvl("28_PERDA",0) + 
                             nvl("29_PERDA",0) + 
                             nvl("32_PERDA",0))||
                         '</div>'
                     else
                       to_char(sum(nvl("35_VENDA",0) + 
                                   nvl("36_PERDA",0) +
                                   nvl("10_PERDA",0) +
                                   nvl("11_PERDA",0) + 
                                   nvl("12_PERDA",0) +
                                   nvl("13_PERDA",0) +
                                   nvl("14_PERDA",0) + 
                                   nvl("15_PERDA",0) +
                                   nvl("16_PERDA",0) +
                                   nvl("17_PERDA",0) + 
                                   nvl("18_PERDA",0) +
                                   nvl("19_PERDA",0) +
                                   nvl("20_PERDA",0) + 
                                   nvl("21_PERDA",0) +
                                   nvl("22_PERDA",0) +
                                   nvl("23_PERDA",0) + 
                                   nvl("24_PERDA",0) +
                                   nvl("25_PERDA",0) +
                                   nvl("26_PERDA",0) + 
                                   nvl("27_PERDA",0) +
                                   nvl("28_PERDA",0) + 
                                   nvl("29_PERDA",0) + 
                                   nvl("32_PERDA",0)))
                     end totalperdafiliais
                from vw_vendaperdavendadireta_fav v
                group by rollup (nvl(idfilialromance, 99), idprodutodetalhado )
                ```
