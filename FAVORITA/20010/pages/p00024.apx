    region lojas (
        name: Lojas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nvl(idfilialromance, 99) idfilialromance
                     , case grouping_id (nvl(idfilialromance, 99), idprodutodetalhado)
                         when 0 then max(filialromance)
                         when 1 then '<div class="azul">Sub Total:</div>' 
                         when 3 then '<div class="preto">Total:</div>'
                       end filialromance
                     , grouping_id(nvl(idfilialromance, 99), idprodutodetalhado)  ordem
                     , idprodutodetalhado
                     , ( select pck_util_fav.fnc_nomeprodutodetalhado(idprodutodetalhado, 1)
                         from produtosdetalhados pd
                         where pd.idprodutodetalhado = v.idprodutodetalhado
                         and rownum = 1 ) nomeprodutodetalhado
                     , case 
                         when grouping_id (nvl(idfilialromance, 99), idprodutodetalhado) in (1, 3) then 
                           '<div class="preto">'||
                             sum(nvl(quantidadeestoque, 0))||
                           '<div>' 
                         else 
                           to_char(sum(nvl(quantidadeestoque, 0)))  
                       end quantidadeestoque
                     , sum("5_VENDA")  "5_VENDA"
                     , sum("5_PERDA")  "5_PERDA"
                     , sum("7_VENDA")  "7_VENDA"
                     , sum("7_PERDA")  "7_PERDA"
                     , sum("31_VENDA")  "31_VENDA"
                     , sum("31_PERDA")  "31_PERDA"
                     , sum("37_VENDA")  "37_VENDA"
                     , sum("37_PERDA")  "37_PERDA"
                     , sum("38_VENDA")  "38_VENDA"
                     , sum("38_PERDA")  "38_PERDA"
                     , sum("78_VENDA")  "78_VENDA"
                     , sum("78_PERDA")  "78_PERDA"
                     , sum("80_VENDA")  "80_VENDA"
                     , sum("80_PERDA")  "80_PERDA"
                   , case 
                       when grouping_id (nvl(idfilialromance, 99), idprodutodetalhado) in (1, 3) then 
                         '<div class="preto">'||
                         sum(nvl("5_VENDA",0)  + 
                             nvl("7_VENDA",0)  +
                             nvl("31_VENDA",0) +
                             nvl("37_VENDA",0) +
                             nvl("38_VENDA",0) +
                             nvl("78_VENDA",0) +
                             nvl("80_VENDA",0) )||
                         '</div>'
                     else
                       to_char(sum(nvl("5_VENDA",0)  + 
                                   nvl("7_VENDA",0)  +
                                   nvl("31_VENDA",0) +
                                   nvl("37_VENDA",0) +
                                   nvl("38_VENDA",0) +
                                   nvl("78_VENDA",0) +
                                   nvl("80_VENDA",0)))
                     end totalvendafiliais
                   , case
                       when grouping_id (nvl(idfilialromance, 99), idprodutodetalhado) in (1, 3) then
                         '<div class="preto">'||
                         sum(nvl("5_PERDA",0)  + 
                             nvl("7_PERDA",0)  +
                             nvl("31_PERDA",0) +
                             nvl("37_PERDA",0) +
                             nvl("38_PERDA",0) +
                             nvl("78_PERDA",0) +
                             nvl("80_PERDA",0))||
                         '</div>'
                     else
                       to_char(sum(nvl("5_PERDA",0)  + 
                                   nvl("7_PERDA",0)  +
                                   nvl("31_PERDA",0) +
                                   nvl("37_PERDA",0) +
                                   nvl("38_PERDA",0) +
                                   nvl("78_PERDA",0) +
                                   nvl("80_PERDA",0)))
                     end totalperdafiliais
                from vw_vendaperdalojas_fav v
                group by rollup (nvl(idfilialromance, 99), idprodutodetalhado )
                ```
        }
        layout {
            sequence: 160
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: container
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P24_ROMANCE_FAVORITA = 'F' and :P24_PARAMETRO = 0;
        }
        componentAppearance {
            showNullValuesAs: -
        }
