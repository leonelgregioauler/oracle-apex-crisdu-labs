    process call-center-igrejinha (
        name: Call Center Igrejinha
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vsql                varchar2(32767);
                  vidpais             number               := :P24_IDPAIS;
                  videstoque          number               := :P24_ESTOQUE;
                  vconsultarestoque   varchar2(1)          := :P24_CONSULTARESTOQUE;
                  vtipofilial         varchar2(1)          := :P24_TIPOFILIAL;
                  vdetalharfilialrmc  varchar2(1)          := :P24_DETALHARFILIALROMANCE;
                  vtipofilialfavorita varchar2(1)          := 'C'; -- CALL CENTER
                  vidfilialfavorita   number               := :P24_IDFILIALFAVORITA;
                  vidfilialromance    number               := :P24_IDFILIALROMANCE;
                  vtipodata           varchar2(1)          := :P24_TIPODATA;
                  vdataini            date                 := :P24_DATAINICIO;
                  vdatafim            date                 := :P24_DATAFIM;
                  videdicao           number               := :P24_IDEDICAOREVISTA;
                  vdetalharproduto    varchar2(1)          := :P24_DETALHARPRODUTO;
                  vidfornecedor       number               := :P24_IDFORNECEDOR;
                  vidproduto          number               := :P24_IDPRODUTO;
                  vidprodutodetalhado number               := :P24_IDPRODUTODETALHADO;
                  vdetalharvalores    varchar2(1)          := 'N';
                  vidsituacaopedido   number               := :P24_IDSITUACAOPEDIDO;
                  vcampototalvenda    varchar2(20)         := :P24_TOTAISVENDA;
                  vcampototalperda    varchar2(20)         := :P24_TOTAISPERDA;
                  --
                begin
                  --
                  vsql:= pck_bi_fav.fnc_vendaperdafavorita_bi ( pidpais                     => vidpais,
                                                                pidestoque                  => videstoque,
                                                                pconsultarestoque           => vconsultarestoque,
                                                                ptipofilial                 => vtipofilial,      
                                                                pdetalharfilialromance      => vdetalharfilialrmc,
                                                                ptipofilialfavorita         => vtipofilialfavorita,
                                                                pidfilialfavorita           => vidfilialfavorita,
                                                                pidfilialromance            => vidfilialromance,
                                                                ptipodata                   => vtipodata,
                                                                pdatainicial                => vdataini,
                                                                pdatafinal                  => vdatafim,
                                                                pidedicaorevista            => videdicao,
                                                                pdetalharproduto            => vdetalharproduto,
                                                                pidfornecedor               => vidfornecedor,
                                                                pidproduto                  => vidproduto,
                                                                pidprodutodetalhado         => vidprodutodetalhado,
                                                                pdetalharvalores            => vdetalharvalores,
                                                                pidsituacaopedido           => vidsituacaopedido,
                                                                pcampototalvenda            => vcampototalvenda,
                                                                pcampototalperda            => vcampototalperda);
                  --
                  execute immediate 'create or replace view vw_vendaperdacallcenter_fav as '||vsql;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 110
        }
        advanced {
            executionMappingIdentifier: 1483575781503817904
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P24_ROMANCE_FAVORITA = 'F' and :P24_PARAMETRO = 1;
        }
    )

    process estoque-belém (
        name: Estoque Belém
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vsql                varchar2(32767);
                  vidpais             number               := :P24_IDPAIS;
                  videstoque          number               := 6; -- BELEM
                  vconsultarestoque   varchar2(1)          := :P24_CONSULTARESTOQUE;
                  vtipofilial         varchar2(1)          := :P24_TIPOFILIAL;
                  vdetalharfilialfav  varchar2(1)          := :P24_DETALHARFILIALFAVORITA;
                  vidfilialfavorita   number               := :P24_IDFILIALFAVORITA;
                  vidfilialromance    number               := :P24_IDFILIALROMANCE;
                  vtipodata           varchar2(1)          := :P24_TIPODATA;
                  vdataini            date                 := :P24_DATAINICIO;
                  vdatafim            date                 := :P24_DATAFIM;
                  videdicao           number               := :P24_IDEDICAOREVISTA;
                  vdetalharproduto    varchar2(1)          := :P24_DETALHARPRODUTO;
                  vidfornecedor       number               := :P24_IDFORNECEDOR;
                  vidproduto          number               := :P24_IDPRODUTO;
                  vidprodutodetalhado number               := :P24_IDPRODUTODETALHADO;
                  vdetalharvalores    varchar2(1)          := 'N';
                  vidsituacaopedido   number               := :P24_IDSITUACAOPEDIDO;
                  vcampototalvenda    varchar2(20)         := :P24_TOTAISVENDA;
                  vcampototalperda    varchar2(20)         := :P24_TOTAISPERDA;
                  --
                begin
                  --
                  vsql:= pck_bi_fav.fnc_vendaperdaromance_bi ( pidpais                 => vidpais,
                                                               pidestoque              => videstoque,
                                                               pconsultarestoque       => vconsultarestoque,
                                                               ptipofilial             => vtipofilial,   
                                                               pdetalharfilialfavorita => vdetalharfilialfav,
                                                               pidfilialfavorita       => vidfilialfavorita,
                                                               pidfilialromance        => vidfilialromance,
                                                               ptipodata               => vtipodata,
                                                               pdatainicial            => vdataini,
                                                               pdatafinal              => vdatafim,
                                                               pidedicaorevista        => videdicao,
                                                               pdetalharproduto        => vdetalharproduto,
                                                               pidfornecedor           => vidfornecedor,
                                                               pidproduto              => vidproduto,
                                                               pidprodutodetalhado     => vidprodutodetalhado,
                                                               pdetalharvalores        => vdetalharvalores,
                                                               pidsituacaopedido       => vidsituacaopedido,
                                                               pcampototalvenda        => vcampototalvenda,
                                                               pcampototalperda        => vcampototalperda);
                  --
                  execute immediate 'create or replace view vw_vendaperdabelem_fav as '||vsql;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 1483575472097817901
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P24_ESTOQUE in (6, 0) and :P24_ROMANCE_FAVORITA = 'R' and :P24_PARAMETRO = 1;
        }
    )

    process estoque-campo-grande (
        name: Estoque Campo Grande
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vsql                varchar2(32767);
                  vidpais             number               := :P24_IDPAIS;
                  videstoque          number               := 3; -- CAMPO GRANDE
