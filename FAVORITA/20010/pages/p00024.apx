    region estoque-loja-belém (
        name: Estoque Loja Belém
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nvl(idfilialfavorita, 99) idfilialfavorita
                     , case grouping_id (nvl(idfilialfavorita, 99), idprodutodetalhado)
                         when 0 then max(filialfavorita)
                         when 1 then '<div class="azul">Sub Total:</div>' 
                         when 3 then '<div class="preto">Total:</div>'
                       end filialfavorita
                     , grouping_id(nvl(idfilialfavorita, 99), idprodutodetalhado)  ordem
                     , idprodutodetalhado
                     , ( select pck_util_fav.fnc_nomeprodutodetalhado(idprodutodetalhado, 1)
                         from produtosdetalhados pd
                         where pd.idprodutodetalhado = v.idprodutodetalhado
                         and rownum = 1 ) nomeprodutodetalhado
                     , case 
                         when grouping_id (nvl(idfilialfavorita, 99), idprodutodetalhado) in (1, 3) then 
                           '<div class="preto">'||
                             sum(nvl(quantidadeestoque, 0))||
                           '<div>' 
                         else 
                           to_char(sum(nvl(quantidadeestoque, 0)))  
                       end quantidadeestoque
                     , sum("1089_VENDA")  "1089_VENDA"
                     , sum("1089_PERDA")  "1089_PERDA"
                     , sum("121_VENDA")   "121_VENDA"
                     , sum("121_PERDA")   "121_PERDA"
                     , sum("1072_VENDA")  "1072_VENDA"
                     , sum("1072_PERDA")  "1072_PERDA"
                     , sum("222_VENDA")   "222_VENDA"
                     , sum("222_PERDA")   "222_PERDA"
                     , sum("1090_VENDA")  "1090_VENDA"
                     , sum("1090_PERDA")  "1090_PERDA"
                     , sum("221_VENDA")   "221_VENDA"
                     , sum("221_PERDA")   "221_PERDA"
                     , sum("230_VENDA")   "230_VENDA"
                     , sum("230_PERDA")   "230_PERDA"
                   , case 
                       when grouping_id (nvl(idfilialfavorita, 99), idprodutodetalhado) in (1, 3) then 
                         '<div class="preto">'||
                         sum(nvl("1089_VENDA"  ,0) + 
                             nvl("121_VENDA"   ,0) + 
                             nvl("1072_VENDA"  ,0) + 
                             nvl("222_VENDA"   ,0) + 
                             nvl("1090_VENDA"  ,0) + 
                             nvl("221_VENDA"   ,0) + 
                             nvl("230_VENDA"   ,0))||
                         '</div>'
                     else
                       to_char(sum(nvl("1089_VENDA"  ,0) + 
                                   nvl("121_VENDA"   ,0) + 
                                   nvl("1072_VENDA"  ,0) + 
                                   nvl("222_VENDA"   ,0) + 
                                   nvl("1090_VENDA"  ,0) + 
                                   nvl("221_VENDA"   ,0) + 
                                   nvl("230_VENDA"   ,0)))
                     end totalvendafiliais
                   , case
                       when grouping_id (nvl(idfilialfavorita, 99), idprodutodetalhado) in (1, 3) then
                         '<div class="preto">'||
                         sum(nvl("1089_PERDA"  ,0) + 
                             nvl("121_PERDA"   ,0) + 
                             nvl("1072_PERDA"  ,0) + 
                             nvl("222_PERDA"   ,0) + 
                             nvl("1090_PERDA"  ,0) + 
                             nvl("221_PERDA"   ,0) + 
                             nvl("230_PERDA"   ,0))||
                         '</div>'
                     else
                       to_char(sum(nvl("1089_PERDA"  ,0) + 
                                   nvl("121_PERDA"   ,0) + 
                                   nvl("1072_PERDA"  ,0) + 
                                   nvl("222_PERDA"   ,0) + 
                                   nvl("1090_PERDA"  ,0) + 
                                   nvl("221_PERDA"   ,0) + 
                                   nvl("230_PERDA"   ,0)))
                     end totalperdafiliais
                from vw_vendaperdalojabelem_fav v
                group by rollup (nvl(idfilialfavorita, 99), idprodutodetalhado )
                ```
        }
