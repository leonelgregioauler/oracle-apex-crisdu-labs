    pageItem P24_IDEDICAOREVISTA (
        type: plugin/select
        label {
            label: Edição de Revista
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                  select pck_util_fav.fnc_edicaorevista(idedicaorevista) as d,
                       idedicaorevista as r
                  from edicoesrevistas
                 order by 1
                ```
        }
        layout {
            sequence: 200
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P24_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Filial Favorita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) as d,
                       idfilialfavorita as r
                  from filiaisfavorita
                  where ((:P24_TIPOFILIAL = 'F' and tipofilial not in ('L') )
                      or (:P24_TIPOFILIAL = 'T')
                      or (:P24_TIPOFILIAL = 'L' and tipofilial in ('L') ))
                     and idpais = :P24_IDPAIS
                 order by 1
                ```
            nullDisplayValue: - Todas Filiais -
        }
        cascadingLov {
            parentItems: [
                P24_IDPAIS
                P24_TIPOFILIAL
            ]
            itemsToSubmit: [
                P24_IDPAIS
                P24_TIPOFILIAL
            ]
        }
        layout {
            sequence: 110
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P24_IDFILIALROMANCE (
        type: selectList
        label {
            label: Distrib. Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct 
                       pck_util_fav.fnc_nomefilialromance(afr.idfilialdestino) as d,
                       afr.idfilialdestino as r
                  from atendimentosfiliaisrmc afr
                     , filiaisfavorita f
                 where afr.idfilialfavoritaorigem = f.idfilialfavorita
                  and ( f.idfilialfavorita = nvl(:P24_ESTOQUE, f.idfilialfavorita) or :P24_ESTOQUE = 0 )
                 order by 1
                ```
            nullDisplayValue: - Todas Filiais -
        }
        cascadingLov {
            parentItems: P24_ESTOQUE
        }
        layout {
            sequence: 120
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P24_IDFORNECEDOR (
        type: plugin/select
        label {
            label: Fornecedores
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct cp.nomepessoa select_value
                     , cd.idfornecedor return_value
                from catal.fornecedores   cd
                   , catal.pessoas        cp
                   , fornecedoresprodutos fr
                where cd.idpessoa     = cp.idpessoa
