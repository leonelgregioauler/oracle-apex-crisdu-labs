    region estoque-uruguay (
        name: Estoque Uruguay
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nvl(idfilialfavorita, 99) idfilialfavorita
                     , case grouping_id (nvl(idfilialfavorita, 99), idprodutodetalhado)
                         when 0 then max(filialfavorita)
                         when 1 then '<div class="azul">Sub Total:</div>' 
                         when 3 then '<div class="preto">Total:</div>'
                       end filialfavorita
                     , grouping_id(nvl(idfilialfavorita, 99), idprodutodetalhado)  ordem
                     , idprodutodetalhado
                     , ( select pck_util_fav.fnc_nomeprodutodetalhado(idprodutodetalhado, 1)
                         from produtosdetalhados pd
                         where pd.idprodutodetalhado = v.idprodutodetalhado
                         and rownum = 1 ) nomeprodutodetalhado
                     , case 
                         when grouping_id (nvl(idfilialfavorita, 99), idprodutodetalhado) in (1, 3) then 
                           '<div class="preto">'||
                             sum(nvl(quantidadeestoque, 0))||
                           '<div>' 
                         else 
                           to_char(sum(nvl(quantidadeestoque, 0)))  
                       end quantidadeestoque
                     , sum("1041_VENDA")  "1041_VENDA"
                     , sum("1041_PERDA")  "1041_PERDA"
                   , case 
                       when grouping_id (nvl(idfilialfavorita, 99), idprodutodetalhado) in (1, 3) then 
                         '<div class="preto">'||
                         sum(nvl("1041_VENDA"  ,0))||
                         '</div>'
                     else
                       to_char(sum(nvl("1041_VENDA"  ,0)))
                     end totalvendafiliais
                   , case
                       when grouping_id (nvl(idfilialfavorita, 99), idprodutodetalhado) in (1, 3) then
                         '<div class="preto">'||
                         sum(nvl("1041_PERDA"  ,0))||
                         '</div>'
                     else
                       to_char(sum(nvl("1041_PERDA"  ,0)))
                     end totalperdafiliais
                from vw_vendaperdauruguay_fav v
                group by rollup (nvl(idfilialfavorita, 99), idprodutodetalhado )
                ```
        }
        layout {
            sequence: 130
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent14
                t-Region--scrollBody
            ]
            cssClasses: container
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P24_ESTOQUE in (9, 0) and :P24_ROMANCE_FAVORITA = 'R' and :P24_PARAMETRO = 0;
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 1483377193206827224
        }

