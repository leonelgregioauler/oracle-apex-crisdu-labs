                	 , sum("401_PERDA")  "401_PERDA"
                     , sum("100_VENDA")  "100_VENDA"
                	 , sum("100_PERDA")  "100_PERDA"
                     , sum("1082_VENDA") "1082_VENDA"
                	 , sum("1082_PERDA") "1082_PERDA"
                     , sum("122_VENDA")  "122_VENDA"
                	 , sum("122_PERDA")  "122_PERDA"
                	 , sum("124_VENDA")  "124_VENDA"
                	 , sum("124_PERDA")  "124_PERDA"
                     , sum("1071_VENDA") "1071_VENDA"
                	 , sum("1071_PERDA") "1071_PERDA"
                   , case 
                       when grouping_id (nvl(idfilialfavorita, 99), idprodutodetalhado) in (1, 3) then 
                         '<div class="preto">'||
                         sum(nvl("123_VENDA"  ,0) + 
                             nvl("1106_VENDA" ,0) + 
                             nvl("1084_VENDA" ,0) + 
                             nvl("401_VENDA"  ,0) + 
                             nvl("100_VENDA"  ,0) + 
                             nvl("1082_VENDA" ,0) + 
                             nvl("122_VENDA"  ,0) + 
                             nvl("124_VENDA"  ,0) + 
                             nvl("1071_VENDA" ,0))||
                         '</div>'
                       else
                         to_char(sum(nvl("123_VENDA"  ,0) + 
                                     nvl("1106_VENDA" ,0) + 
                                     nvl("1084_VENDA" ,0) + 
                                     nvl("401_VENDA"  ,0) + 
                                     nvl("100_VENDA"  ,0) + 
                                     nvl("1082_VENDA" ,0) + 
                                     nvl("122_VENDA"  ,0) + 
                                     nvl("124_VENDA"  ,0) + 
                                     nvl("1071_VENDA" ,0)))
                     end totalvendafiliais
                   , case
                       when grouping_id (nvl(idfilialfavorita, 99), idprodutodetalhado) in (1, 3) then
                         '<div class="preto">'||
                         sum(nvl("123_PERDA"  ,0) + 
                             nvl("1106_PERDA" ,0) + 
                             nvl("1084_PERDA" ,0) + 
                             nvl("401_PERDA"  ,0) + 
                             nvl("100_PERDA"  ,0) + 
                             nvl("1082_PERDA" ,0) + 
                             nvl("122_PERDA"  ,0) + 
                             nvl("124_PERDA"  ,0) + 
                             nvl("1071_PERDA" ,0))||
                          '</div>'
                       else
                         to_char(sum(nvl("123_PERDA"  ,0) + 
                                     nvl("1106_PERDA" ,0) + 
                                     nvl("1084_PERDA" ,0) + 
                                     nvl("401_PERDA"  ,0) + 
                                     nvl("100_PERDA"  ,0) + 
                                     nvl("1082_PERDA" ,0) + 
                                     nvl("122_PERDA"  ,0) + 
                                     nvl("124_PERDA"  ,0) + 
                                     nvl("1071_PERDA" ,0)))
                     end totalperdafiliais
                from vw_vendaperdaigrejinha_fav v
                group by rollup (nvl(idfilialfavorita, 99), idprodutodetalhado )
                ```
        }
