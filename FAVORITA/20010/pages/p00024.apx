    region site (
        name: Site
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nvl(idfilialromance, 99) idfilialromance
                     , case grouping_id (nvl(idfilialromance, 99), idprodutodetalhado)
                         when 0 then max(filialromance)
                         when 1 then '<div class="azul">Sub Total:</div>' 
                         when 3 then '<div class="preto">Total:</div>'
                       end filialromance
                     , grouping_id(nvl(idfilialromance, 99), idprodutodetalhado)  ordem
                     , idprodutodetalhado
                     , ( select pck_util_fav.fnc_nomeprodutodetalhado(idprodutodetalhado, 1)
                         from produtosdetalhados pd
                         where pd.idprodutodetalhado = v.idprodutodetalhado
                         and rownum = 1 ) nomeprodutodetalhado
                     , case 
                         when grouping_id (nvl(idfilialromance, 99), idprodutodetalhado) in (1, 3) then 
                           '<div class="preto">'||
                             sum(nvl(quantidadeestoque, 0))||
                           '<div>' 
                         else 
                           to_char(sum(nvl(quantidadeestoque, 0)))  
                       end quantidadeestoque
                     , sum("8_VENDA")   "8_VENDA"
                     , sum("8_PERDA")   "8_PERDA"
                     , sum("34_VENDA")  "34_VENDA"
                     , sum("34_PERDA")  "34_PERDA"
                     , sum("33_VENDA")  "33_VENDA"
                     , sum("33_PERDA")  "33_PERDA"
                   , case 
                       when grouping_id (nvl(idfilialromance, 99), idprodutodetalhado) in (1, 3) then 
                         '<div class="preto">'||
                         sum(nvl("8_VENDA",0)  + 
                             nvl("34_VENDA",0) +
                             nvl("33_VENDA",0))||
                         '</div>'
                     else
                       to_char(sum(nvl("8_VENDA",0)  + 
                                   nvl("34_VENDA",0) +
                                   nvl("33_VENDA",0)))
                     end totalvendafiliais
                   , case
                       when grouping_id (nvl(idfilialromance, 99), idprodutodetalhado) in (1, 3) then
                         '<div class="preto">'||
                         sum(nvl("8_PERDA",0)  + 
                             nvl("34_PERDA",0)  +
                             nvl("33_PERDA",0))||
                         '</div>'
                     else
                       to_char(sum(nvl("8_PERDA",0)  + 
                                   nvl("34_PERDA",0)  +
                                   nvl("33_PERDA",0)))
                     end totalperdafiliais
                from vw_vendaperdasite_fav v
                group by rollup (nvl(idfilialromance, 99), idprodutodetalhado )
                ```
        }
        layout {
            sequence: 170
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent12
                t-Region--scrollBody
            ]
            cssClasses: container
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P24_ROMANCE_FAVORITA = 'F' and :P24_PARAMETRO = 0;
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 1483490689754317212
        }

