    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    htmlHeader {
        htmlHeader:
            ```html
            <style>
                
                 .alerta {
            	      animation: pisca_in 1000ms ease-out 0s infinite normal forwards;
                  color: red;
                  font-weight: bold;
                }
            
                @keyframes pisca_in{
            	      0%{ color: transparent;}
            	      10%{ color: red;}
            	      80%{ color: red;}
            	      100%{ color: transparent;}
                }
                
                .totalvenda {
                    font-weight: bold;
                    font-style: italic;
                }
                
                .preto {
                    font-weight: bold;
                    font-style: italic;
                }
                
                .azul {
                    font-weight: bold;
                    font-style: italic;
                    color: blue;
                }
                
                .verde {
                    color: green;
                    font-weight: bold;
                }
                
                .laranja {
                    color: orange;
                    font-weight: bold;
                }
                
                .vermelho {
                    color: red;
                    font-weight: bold;
                }
                
                
            </style>
            
            <script 
              src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js">
            </script>
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region call-center-igrejinha (
        name: Call Center Igrejinha
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nvl(idfilialromance, 99) idfilialromance
                     , case grouping_id (nvl(idfilialromance, 99), idprodutodetalhado)
                         when 0 then max(filialromance)
                         when 1 then '<div class="azul">Sub Total:</div>' 
                         when 3 then '<div class="preto">Total:</div>'
                       end filialromance
                     , grouping_id(nvl(idfilialromance, 99), idprodutodetalhado)  ordem
                     , idprodutodetalhado
                     , ( select pck_util_fav.fnc_nomeprodutodetalhado(idprodutodetalhado, 1)
                         from produtosdetalhados pd
                         where pd.idprodutodetalhado = v.idprodutodetalhado
                         and rownum = 1 ) nomeprodutodetalhado
                     , case 
                         when grouping_id (nvl(idfilialromance, 99), idprodutodetalhado) in (1, 3) then 
                           '<div class="preto">'||
                             sum(nvl(quantidadeestoque, 0))||
                           '<div>' 
                         else 
                           to_char(sum(nvl(quantidadeestoque, 0)))  
                       end quantidadeestoque
                     , sum("1_VENDA")  "1_VENDA"
                     , sum("1_PERDA")  "1_PERDA"
                   , case 
                       when grouping_id (nvl(idfilialromance, 99), idprodutodetalhado) in (1, 3) then 
                         '<div class="preto">'||
                         sum(nvl("1_VENDA" ,0))||
                         '</div>'
                     else
                       to_char(sum(nvl("1_VENDA" ,0)))
                     end totalvendafiliais
                   , case
                       when grouping_id (nvl(idfilialromance, 99), idprodutodetalhado) in (1, 3) then
                         '<div class="preto">'||
                         sum(nvl("1_PERDA" ,0))||
                         '</div>'
                     else
                       to_char(sum(nvl("1_PERDA" ,0)))
                     end totalperdafiliais
                from vw_vendaperdacallcenter_fav v
                group by rollup (nvl(idfilialromance, 99), idprodutodetalhado )
                ```
        }
        layout {
            sequence: 150
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent9
                t-Region--scrollBody
            ]
            cssClasses: container
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P24_ROMANCE_FAVORITA = 'F' and :P24_PARAMETRO = 0;
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 1483429132175064022
        }

