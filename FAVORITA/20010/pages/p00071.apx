    region quantidade-por-filial (
        name: Quantidade Por Filial
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- Pedidos Montados
                  
                select us.usuario,
                       ff.nomefilialfavorita,
                       count(*) qtdPedidos,
                       sum(pe.valorTotalCusto) valorCusto,
                       sum(pe.valorAPagar * pe.fatorconversao) valorAPagar
                  from favorita.pedidos               pe,
                       favorita.classificacoespedidos cp,
                       filiaisfavorita                ff,
                       usuarios                       us
                 where pe.idpedido                = cp.idpedido
                   and cp.idcaracteristicapedido  = 18
                   and pe.idfilialfavoritaestoque = ff.idfilialfavorita
                   and cp.idUsuario               = us.idUsuario
                   and cp.dataclassificado 
                          between to_date(to_char(:P71_DATAINICIAL)||' 00:00:01','dd/mm/rrrr hh24:mi:ss')
                              and to_date(to_char(:P71_DATAFINAL)  ||' 23:59:59','dd/mm/rrrr hh24:mi:ss')
                   and (:P71_IDFILIALFAVORITA is null or pe.idfilialfavoritaestoque = :P71_IDFILIALFAVORITA) 
                 group by us.usuario, ff.nomefilialfavorita
                 
                union
                
                -- Igrejinha Express
                select u.usuario,
                       f.nomefilialfavorita,
                       count(*) qtdPedidos,
                       sum(p.valorTotalCusto) valorCusto,
                       sum(p.valorAPagar * p.fatorconversao) valorAPagar
                  from favorita.pedidos               p,
                       favorita.classificacoespedidos c,
                       filiaisfavorita                f,
                       usuarios                       u
                 where p.idpedido                = c.idpedido
                   and p.idfilialfavoritaestoque = f.idfilialfavorita
                   and c.idUsuario               = u.idUsuario
                   and c.idcaracteristicapedido  = 13
                   and c.idvalorcaracteristica   = 6
                   and p.dataentrega 
                         between to_date(to_char(:P71_DATAINICIAL)||' 00:00:00','dd/mm/rrrr hh24:mi:ss')
                             and to_date(to_char(:P71_DATAFINAL)  ||' 23:59:59','dd/mm/rrrr hh24:mi:ss')
                   and (:P71_IDFILIALFAVORITA is null or p.idfilialfavoritaestoque = :P71_IDFILIALFAVORITA) 
                   
                 group by u.usuario, f.nomefilialfavorita;
                  
                ```
        }
        layout {
            sequence: 30
            parentRegion: @relatorio-de-b-p71-tipo-b
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: item=value
            item: P71_TIPORELATORIO
            value: Q
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        download {
            filename: QtdePorUsuario
        }
        advanced {
            savedReportMappingIdentifier: 17928372151009558
        }

