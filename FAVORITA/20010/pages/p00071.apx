        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 70
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-filter
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction setatipo (
        name: SetaTipo
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P71_TIPORELATORIO
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression:
                    ```plsql
                     CASE WHEN :P71_TIPORELATORIO = 'Q' THEN 'PEDIDOS MONTADOS'
                          WHEN :P71_TIPORELATORIO = 'P' THEN 'ITENS PEDIDOS MONTADOS'
                     ELSE 'TRANSFERENCIAS EFETUADAS'
                     END
                    
                    ```
                itemsToSubmit: P71_TIPORELATORIO
            }
            affectedElements {
                selectionType: items
                items: P71_TIPO
            }
            execution {
                sequence: 10
            }
        )

    )

)

