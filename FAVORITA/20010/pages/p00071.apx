    pageItem P71_IDFILIALFAVORITA (
        type: plugin/select
        label {
            label: Filial Favorita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ff.nomefilialfavorita
                , ff.idfilialfavorita
                from favorita.filiaisfavorita ff
                where ff.tipofilial = 'E'
                  /*and exists ( select 1
                               from usuariosfiliaisfavorita u
                               where u.idfilialfavorita = f.idfilialfavorita
                                 and u.consultar = 'S'
                                 and u.idusuario = :P0_IDUSUARIO )*/
                order by 1
                ```
            nullDisplayValue: - Selecione a Filial -
        }
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

