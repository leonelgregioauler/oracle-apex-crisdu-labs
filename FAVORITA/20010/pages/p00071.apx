    region transferencias (
        name: Transferencias
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select us.usuario --, pr.idproduto, pr.nomeproduto  
                     , sum(it.quantidadecomprada)      qtdProduto
                     , sum(it.valorcusto)              valorCusto
                     , sum(favorita.pck_util_fav.prc_buscavalorvende ( (select max(e.idEdicaoRevista) -- max para se tiver duas ativas ao mesmo tempo
                                                                          from favorita.edicoesRevistas e
                                                                         where sysdate between to_date( e.datainicial||' 00:00:00','dd/mm/rrrr hh24:mi:ss') 
                                                                                           and to_date( e.datafinal  ||' 23:59:59','dd/mm/rrrr hh24:mi:ss')
                                                                           and e.idPais = ff.idpais 
                                                                           and e.idedicaorevista != 56 ) ,
                                                                       it.idProdutoDetalhado, 
                                                                       1 /*ff.idPais*/) ) "valorAPagar"
                     
                  from favorita.comprastransferencias       ct
                     , favorita.classificacoescomprastransf cp
                     , favorita.itenscomprastransferencias  it
                     , favorita.produtosdetalhados          pd
                     , favorita.produtos                    pr
                     , favorita.filiaisfavorita             ff
                     , usuarios                             us
                 where ct.idcompratransferencia = cp.idcompratransferencia
                   and ct.idcompratransferencia = it.idcompratransferencia
                   and it.idprodutodetalhado    = pd.idprodutodetalhado
                   and pd.idproduto             = pr.idproduto
                   and ff.idfilialfavorita      = ct.idfilialfavoritaorigem
                   and us.idUsuario             = cp.idUsuario
                   and cp.idcaracteristicacomptransf = 5
                   and it.quantidadecomprada > 0
                   and cp.dataclassificado between to_date(to_char(:P71_DATAINICIAL)||' 00:00:01','dd/mm/rrrr hh24:mi:ss')
                                               and to_date(to_char(:P71_DATAFINAL)  ||' 23:59:59','dd/mm/rrrr hh24:mi:ss')
                   and (:P71_IDFILIALFAVORITA is null or ct.idfilialfavoritaorigem = :P71_IDFILIALFAVORITA) 
                   and (:P71_IDUSUARIO is null or cp.idUsuario = :P71_IDUSUARIO)
                
                  group by us.usuario--, pr.idproduto, pr.nomeproduto
                  order by us.usuario--, pr.nomeproduto
                ```
        }
        layout {
            sequence: 50
            parentRegion: @relatorio-de-b-p71-tipo-b
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: item=value
            item: P71_TIPORELATORIO
            value: T
        }
