    region inadimplência (
        name: Inadimplência
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select venc.qtdvencimentos qtdtotal
                     , venc.valorapagar valortotal
                     , vencdist.qtdvencimentos qtddistribuidores
                     , vencdist.valorapagar totaldistribuidores
                     , vencvend.qtdvencimentos qtdconsultoras
                     , vencvend.valorapagar totalconsultoras
                from ( select count(1) qtdvencimentos
                            , sum(v.valorpagar) valorapagar
                       from vencimentospedidos v
                       where v.situacaovencimento = 'V'
                         and v.datavencimento between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR')
                         and v.valorpagar > 0
                         and v.valorpago < v.valorpagar
                         and not exists ( select 1
                                          from classificacoespedidos c
                                          where c.idpedido = v.idpedido
                                            and c.idcaracteristicapedido = 25 )
                         and ( ( :P6_TIPOPAIS = 1 and exists ( select 1
                                                             from pedidos p
                                                             where idpedido = v.idpedido
                                                               and idfilialromance != 1041
                                                               and ( :P0_IDFILIALROMANCE = '999999999999' or  p.idfilialromance = :P0_IDFILIALROMANCE ) )
                            or :P6_TIPOPAIS = 2 and exists ( select 1
                                                             from pedidos p
                                                             where idpedido = v.idpedido
                                                               and idfilialromance = 1041 ) ) )
                         and exists ( select 1
                                      from pagamentospedidos pg
                                      where pg.idvencimentopedido = v.idvencimentopedido
                                        --and pg.idformapagamento   = 1
                                        and pg.valorpago          < v.valorpagar ) ) venc
                   , ( select count(1) qtdvencimentos
                            , sum(v.valorpagar) valorapagar
                       from vencimentospedidos v
                       where v.situacaovencimento = 'V'
                         and v.datavencimento between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR')
                         and v.valorpagar > 0
                         and v.valorpago = 0
                         and ( ( :P6_TIPOPAIS = 1 and exists ( select 1
                                                             from pedidos p
                                                             where idpedido = v.idpedido
                                                               and idfilialromance != 1041
                                                               and ( :P0_IDFILIALROMANCE = '999999999999' or  p.idfilialromance = :P0_IDFILIALROMANCE ) )
                            or :P6_TIPOPAIS = 2 and exists ( select 1
                                                             from pedidos p
                                                             where idpedido = v.idpedido
                                                               and idfilialromance = 1041 ) ) )
                         and exists ( select 1
                                      from classificacoespedidos c
                                      where c.idcaracteristicapedido = 28
                                        and c.idpedido               = v.idpedido )
                         and not exists ( select 1
                                          from classificacoespedidos c
                                          where c.idpedido = v.idpedido
                                            and c.idcaracteristicapedido = 25 )
                         and exists ( select 1
                                      from pagamentospedidos pg
                                      where pg.idvencimentopedido = v.idvencimentopedido
                                        --and pg.idformapagamento   = 1
                                        and pg.valorpago          < v.valorpagar ) ) vencdist
                   , ( select count(1) qtdvencimentos
                            , sum(v.valorpagar) valorapagar
                       from vencimentospedidos v
                       where v.situacaovencimento = 'V'
                         and v.datavencimento between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR')
                         and v.valorpagar > 0
                         and v.valorpago < v.valorpagar
                         and ( ( :P6_TIPOPAIS = 1 and exists ( select 1
                                                             from pedidos p
                                                             where idpedido = v.idpedido
                                                               and idfilialromance != 1041
                                                               and ( :P0_IDFILIALROMANCE = '999999999999' or  p.idfilialromance = :P0_IDFILIALROMANCE ) )
                            or :P6_TIPOPAIS = 2 and exists ( select 1
                                                             from pedidos p
                                                             where idpedido = v.idpedido
                                                               and idfilialromance = 1041 ) ) )
                         and not exists ( select 1
                                          from classificacoespedidos c
                                          where c.idcaracteristicapedido = 28
                                            and c.idpedido               = v.idpedido )
                         and not exists ( select 1
                                          from classificacoespedidos c
                                          where c.idpedido = v.idpedido
                                            and c.idcaracteristicapedido = 25 )
                         and exists ( select 1
                                      from pagamentospedidos pg
                                      where pg.idvencimentopedido = v.idvencimentopedido
                                        --and pg.idformapagamento   = 1
                                        and pg.valorpago          < v.valorpagar ) ) vencvend
                ```
        }
        layout {
            sequence: 60
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent11
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: <B> Inadimplências de acordo com o filtro de Datas utilizados! </b>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 777023930203272027
        }

