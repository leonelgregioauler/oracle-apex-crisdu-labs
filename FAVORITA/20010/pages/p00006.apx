    region pontos-utilizados (
        name: Pontos Utilizados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select count(1)
                     , sum(p.valorpontoutilizado)
                from favorita.vw_pedidos_fav p
                where ( :P6_TIPO = -1 
                      or (:P6_TIPO = 1 and trunc(p.dataemissao) between  to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                      or (:P6_TIPO = 2 and trunc(p.dataentrega) between  to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                      or (:P6_TIPO = 3 and trunc(p.datadespacho) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                      or (:P6_TIPO = 4 and exists ( select 1
                                                    from classificacoespedidos cp
                                                    where cp.idpedido = p.idpedido
                                                    and cp.idcaracteristicapedido = 48 
                                                    and trunc(cp.dataclassificado) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') ) )
                      or (:P6_TIPO = 5 and exists ( select 1
                                                    from classificacoespedidos cp
                                                    where cp.idpedido = p.idpedido
                                                    and cp.idcaracteristicapedido = 18 
                                                    and trunc(cp.dataclassificado) between  to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') ) ) )
                  and p.datacancelamento is null
                  and p.idsituacaoentrega >= 20000
                  and p.ididioma = 1
                  and ( ( :P6_TIPOPAIS = 1 and p.idfilialromance != 1041
                                           and ( :P0_IDFILIALROMANCE = '999999999999' or  p.idfilialromance = :P0_IDFILIALROMANCE ) )
                      or (:P6_TIPOPAIS = 2 and p.idfilialromance = 1041) )
                  and ididioma = 1
                  and p.valorpontoutilizado>0;
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 339694195427508812
        }

        column "COUNT(1)" (
            type: plainText
            heading {
                heading: Qtd Pedidos
                alignment: center
            }
