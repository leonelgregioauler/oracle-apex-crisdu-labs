    region médias-mensais (
        name: Médias Mensais
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select (pontosutilizados.total/12) mediapontosutilizados
                     , (inadimplencia.total/12) mediainadimplencia
                     , (vendatotal.total/12) mediavendatotal
                from ( select sum(p.valorpontoutilizado) total
                       from vw_pedidos_fav p
                       where p.datacancelamento is null
                         and p.ididioma = 1
                         and ( :P6_TIPOPAIS  = 1 and p.idfilialromance != 1041
                           or (:P6_TIPOPAIS = 2 and p.idfilialromance  = 1041))
                         and ididioma = 1
                         and exists ( select 1
                                      from classificacoespedidos c
                                      where c.idpedido = p.idpedido
                                        and c.idcaracteristicapedido = 5 ) ) pontosutilizados
                   , ( select sum(v.valorpagar) total
                       from vencimentospedidos v
                       where v.situacaovencimento = 'V'
                         and v.valorpagar > 0
                         and v.valorpago < v.valorpagar
                         and ( :P6_TIPOPAIS = 1 and exists ( select 1
                                                             from pedidos p
                                                             where idpedido = v.idpedido
                                                               and idfilialromance != 1041 )
                            or :P6_TIPOPAIS = 2 and exists ( select 1
                                                             from pedidos p
                                                             where idpedido = v.idpedido
                                                               and idfilialromance = 1041 ) )
                         and exists ( select 1
                                      from pagamentospedidos pg
                                      where pg.idvencimentopedido = v.idvencimentopedido
                                        --and pg.idformapagamento   = 1
                                        and pg.valorpago          < v.valorpagar ) ) inadimplencia
                    , ( select sum(p.valorapagar) total
                        from favorita.vw_pedidos_fav p
                        where p.datacancelamento is null
                          and p.ididioma = 1
                          and p.tipopedido = 'P'
                          and ( :P6_TIPOPAIS  = 1 and p.idfilialromance != 1041
                              or (:P6_TIPOPAIS = 2 and p.idfilialromance  = 1041) ) ) vendatotal
                ```
        }
        layout {
            sequence: 110
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent12
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: <B> Está sendo consideradas as informações gerais, não levando em consideração o período filtrado e sendo divido por 12(doze) meses para trazer a média mensal. </b>
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from gerentes g
                where g.idpessoa = ( select idpessoa 
                                     from usuarios u
                                     where u.usuario = v('APP_USER') )
                  and exists ( select 1
                               from roman.vw_filiais f
                               where f.tipofilial = 'D'
                                 and f.idfilial = g.idfilial )
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
