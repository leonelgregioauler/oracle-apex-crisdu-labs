        }
    )

    pageItem P6_TIPO (
        type: radioGroup
        label {
            label: Tipo da data
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Emissão;1,Entrega;2,Despacho;3,Faturamento;4,Montagem;5,Não Filtrar;-1
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @dre
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: 4
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P6_TIPOPAIS (
        type: radioGroup
        label {
            label: País
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pais
                     , idioma 
                from (  select 'Brasil' pais
                             , 1 idioma
                        from dual
                        union 
                        select 'Uruguai' pais
                             , 2 idioma
                        from dual 
                        union 
                        select 'Paraguay' pais
                             , 4 idioma 
                        from dual )
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @dre
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            used: always
        }
        default {
            type: expression
            plsqlExpression: pck_util_fav.fnc_retornaidiomausuario
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from gerentes g
                where g.idpessoa = ( select idpessoa 
                                     from usuarios u
                                     where u.usuario = v('APP_USER') )
                  and exists ( select 1
                               from roman.vw_filiais f
                               where f.tipofilial = 'D'
                                 and f.idfilial = g.idfilial )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: Filtrar
        label: Filtrar
        layout {
            sequence: 10
            region: @dre
