        }
    )

    pageItem P6_DATAINICIO (
        type: datePickerJquery
        label {
            label: Data inicial
            alignment: left
        }
        layout {
            sequence: 20
            region: @dre
            slot: regionBody
            alignment: left
        }
        appearance {
