    region total-de-vendas-origem (
        name: Total de Vendas Origem
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Loja Belem' estoque
                     , count(distinct i.idpedido) qtdpedidos
                     , sum(i.quantidade) quantidade
                     , sum(i.valortotalvenda*i.fatorconversao) totalvenda
                     , sum(i.valorapagar*i.fatorconversao) totalapagar
                     , sum(i.valorcusto*i.fatorconversao) totalcusto
                from vw_itenspedidos_fav i
                where i.ididioma = 1
                  and i.idfilialfavorita = 7
                  and :P6_TIPOPAIS = 1
                  and exists ( select 1
                               from pedidos p
                               where p.idpedido = i.idpedido
                                 and p.tipopedido = 'P'
                                 and not exists ( select 1
                                                  from classificacoespedidos cp
                                                  where cp.idpedido = i.idpedido
                                                  and cp.idcaracteristicapedido = 25 )
                                 and p.idsituacaoentrega >= 20000
                                 and ( :P6_TIPO = -1 
                                    or (:P6_TIPO = 1 and trunc(p.dataemissao)  between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 2 and trunc(p.dataentrega)  between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 3 and trunc(p.datadespacho) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 4 and exists ( select 1
                                                                  from classificacoespedidos cp
                                                                  where cp.idpedido = i.idpedido 
                                                                  and cp.idcaracteristicapedido = 48 
                                                                  and trunc(cp.dataclassificado) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') ) )
                                    or (:P6_TIPO = 5 and exists ( select 1
                                                                  from classificacoespedidos cp
                                                                  where cp.idpedido = i.idpedido 
                                                                  and cp.idcaracteristicapedido = 18 
                                                                  and trunc(cp.dataclassificado) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') ) ) ) )  
                union
                select 'Loja Zona Leste' estoque
                     , count(distinct i.idpedido) qtdpedidos
                     , sum(i.quantidade) quantidade
                     , sum(i.valortotalvenda*i.fatorconversao) totalvenda
                     , sum(i.valorapagar*i.fatorconversao) totalapagar
                     , sum(i.valorcusto*i.fatorconversao) totalcusto
                from vw_itenspedidos_fav i
                where i.ididioma = 1
                  and i.idfilialfavorita = 5
                  and :P6_TIPOPAIS = 1
                  and exists ( select 1
                               from pedidos p
                               where p.idpedido = i.idpedido
                                 and p.tipopedido = 'P'
                                 and not exists ( select 1
                                                  from classificacoespedidos cp
                                                  where cp.idpedido = i.idpedido
                                                  and cp.idcaracteristicapedido = 25 )
                                 and p.idsituacaoentrega >= 20000
                                 and ( :P6_TIPO = -1 
                                    or (:P6_TIPO = 1 and trunc(p.dataemissao)  between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 2 and trunc(p.dataentrega)  between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 3 and trunc(p.datadespacho) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 4 and exists ( select 1
                                                                  from classificacoespedidos cp
                                                                  where cp.idpedido = i.idpedido 
                                                                  and cp.idcaracteristicapedido = 48 
                                                                  and trunc(cp.dataclassificado) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') ) )
                                    or (:P6_TIPO = 5 and exists ( select 1
                                                                  from classificacoespedidos cp
                                                                  where cp.idpedido = i.idpedido 
                                                                  and cp.idcaracteristicapedido = 18 
                                                                  and trunc(cp.dataclassificado) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') ) ) ) )  union
                select 'Loja Plaza' estoque
                     , count(distinct i.idpedido) qtdpedidos
                     , sum(i.quantidade) quantidade
                     , sum(i.valortotalvenda*i.fatorconversao) totalvenda
                     , sum(i.valorapagar*i.fatorconversao) totalapagar
                     , sum(i.valorcusto*i.fatorconversao) totalcusto
                from vw_itenspedidos_fav i
                where i.ididioma = 1
                  and i.idfilialfavorita = 31
                  and :P6_TIPOPAIS = 1
                  and exists ( select 1
                               from pedidos p
                               where p.idpedido = i.idpedido
                                 and p.tipopedido = 'P'
                                 and not exists ( select 1
                                                  from classificacoespedidos cp
                                                  where cp.idpedido = i.idpedido
                                                  and cp.idcaracteristicapedido = 25 )
                                 and p.idsituacaoentrega >= 20000
                                 and ( :P6_TIPO = -1 
                                    or (:P6_TIPO = 1 and trunc(p.dataemissao)  between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 2 and trunc(p.dataentrega)  between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 3 and trunc(p.datadespacho) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 4 and exists ( select 1
                                                                  from classificacoespedidos cp
                                                                  where cp.idpedido = i.idpedido 
                                                                  and cp.idcaracteristicapedido = 48 
                                                                  and trunc(cp.dataclassificado) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') ) )
                                    or (:P6_TIPO = 5 and exists ( select 1
                                                                  from classificacoespedidos cp
                                                                  where cp.idpedido = i.idpedido 
                                                                  and cp.idcaracteristicapedido = 18 
                                                                  and trunc(cp.dataclassificado) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') ) ) ) )  
                union
                select 'Loja Campo Grande' estoque
                     , count(distinct i.idpedido) qtdpedidos
                     , sum(i.quantidade) quantidade
                     , sum(i.valortotalvenda*i.fatorconversao) totalvenda
                     , sum(i.valorapagar*i.fatorconversao) totalapagar
                     , sum(i.valorcusto*i.fatorconversao) totalcusto
                from vw_itenspedidos_fav i
                where i.ididioma = 1
                  and i.idfilialfavorita = 37
                  and :P6_TIPOPAIS = 1
                  and exists ( select 1
                               from pedidos p
                               where p.idpedido = i.idpedido
                                 and p.tipopedido = 'P'
                                 and not exists ( select 1
                                                  from classificacoespedidos cp
                                                  where cp.idpedido = i.idpedido
                                                  and cp.idcaracteristicapedido = 25 )
                                 and p.idsituacaoentrega >= 20000
                                 and ( :P6_TIPO = -1 
                                    or (:P6_TIPO = 1 and trunc(p.dataemissao)  between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 2 and trunc(p.dataentrega)  between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 3 and trunc(p.datadespacho) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 4 and exists ( select 1
                                                                  from classificacoespedidos cp
                                                                  where cp.idpedido = i.idpedido 
                                                                  and cp.idcaracteristicapedido = 48 
                                                                  and trunc(cp.dataclassificado) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') ) )
                                    or (:P6_TIPO = 5 and exists ( select 1
                                                                  from classificacoespedidos cp
                                                                  where cp.idpedido = i.idpedido 
                                                                  and cp.idcaracteristicapedido = 18 
                                                                  and trunc(cp.dataclassificado) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') ) ) ) )  
                union                                                 
                select 'Loja Canoas' estoque
                     , count(distinct i.idpedido) qtdpedidos
                     , sum(i.quantidade) quantidade
                     , sum(i.valortotalvenda*i.fatorconversao) totalvenda
                     , sum(i.valorapagar*i.fatorconversao) totalapagar
                     , sum(i.valorcusto*i.fatorconversao) totalcusto
                from vw_itenspedidos_fav i
                where i.ididioma = 1
                  and i.idfilialfavorita = 38
                  and :P6_TIPOPAIS = 1
                  and exists ( select 1
                               from pedidos p
                               where p.idpedido = i.idpedido
                                 and p.tipopedido = 'P'
                                 and not exists ( select 1
                                                  from classificacoespedidos cp
                                                  where cp.idpedido = i.idpedido
                                                  and cp.idcaracteristicapedido = 25 )
                                 and p.idsituacaoentrega >= 20000
                                 and ( :P6_TIPO = -1 
                                    or (:P6_TIPO = 1 and trunc(p.dataemissao)  between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 2 and trunc(p.dataentrega)  between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 3 and trunc(p.datadespacho) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 4 and exists ( select 1
                                                                  from classificacoespedidos cp
                                                                  where cp.idpedido = i.idpedido 
                                                                  and cp.idcaracteristicapedido = 48 
                                                                  and trunc(cp.dataclassificado) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') ) )
                                    or (:P6_TIPO = 5 and exists ( select 1
                                                                  from classificacoespedidos cp
                                                                  where cp.idpedido = i.idpedido 
                                                                  and cp.idcaracteristicapedido = 18 
                                                                  and trunc(cp.dataclassificado) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') ) ) ) )  
                union	
                select 'Site Brasil' estoque
                     , count(distinct i.idpedido) qtdpedidos
                     , sum(i.quantidade) quantidade
                     , sum(i.valortotalvenda*i.fatorconversao) totalvenda
                     , sum(i.valorapagar*i.fatorconversao) totalapagar
                     , sum(i.valorcusto*i.fatorconversao) totalcusto
                from vw_itenspedidos_fav i
                where i.ididioma = 1
                  and exists ( select 1
                               from pedidos ped
                               where ped.idpedido = i.idpedido
                               and ped.idfilialfavorita = 8 )
                  and :P6_TIPOPAIS = 1
                  and exists ( select 1
                               from pedidos p
                               where p.idpedido = i.idpedido
                                 and p.tipopedido = 'P'
                                 and not exists ( select 1
                                                  from classificacoespedidos cp
                                                  where cp.idpedido = i.idpedido
                                                  and cp.idcaracteristicapedido = 25 )
                                 and p.idsituacaoentrega >= 20000
                                 and ( :P6_TIPO = -1 
                                    or (:P6_TIPO = 1 and trunc(p.dataemissao)  between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 2 and trunc(p.dataentrega)  between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 3 and trunc(p.datadespacho) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 4 and exists ( select 1
                                                                  from classificacoespedidos cp
                                                                  where cp.idpedido = i.idpedido 
                                                                  and cp.idcaracteristicapedido = 48 
                                                                  and trunc(cp.dataclassificado) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') ) )
                                    or (:P6_TIPO = 5 and exists ( select 1
                                                                  from classificacoespedidos cp
                                                                  where cp.idpedido = i.idpedido 
                                                                  and cp.idcaracteristicapedido = 18 
                                                                  and trunc(cp.dataclassificado) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') ) ) ) )
                union
                select 'Call Center' estoque
                     , count(distinct i.idpedido) qtdpedidos
                     , sum(i.quantidade) quantidade
                     , sum(i.valortotalvenda*i.fatorconversao) totalvenda
                     , sum(i.valorapagar*i.fatorconversao) totalapagar
                     , sum(i.valorcusto*i.fatorconversao) totalcusto
                from vw_itenspedidos_fav i
                where i.ididioma = 1
                  and exists ( select 1
                               from pedidos ped
                               where ped.idpedido = i.idpedido
                               and ped.idfilialfavorita = 1 )
                  and :P6_TIPOPAIS = 1
                  and exists ( select 1
                               from pedidos p
                               where p.idpedido = i.idpedido
                                 and p.tipopedido = 'P'
                                 and not exists ( select 1
                                                  from classificacoespedidos cp
                                                  where cp.idpedido = i.idpedido
                                                  and cp.idcaracteristicapedido = 25 )
                                 and p.idsituacaoentrega >= 20000
                                 and ( :P6_TIPO = -1 
                                    or (:P6_TIPO = 1 and trunc(p.dataemissao)  between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 2 and trunc(p.dataentrega)  between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 3 and trunc(p.datadespacho) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 4 and exists ( select 1
                                                                  from classificacoespedidos cp
                                                                  where cp.idpedido = i.idpedido 
                                                                  and cp.idcaracteristicapedido = 48 
                                                                  and trunc(cp.dataclassificado) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') ) )
                                    or (:P6_TIPO = 5 and exists ( select 1
                                                                  from classificacoespedidos cp
                                                                  where cp.idpedido = i.idpedido 
                                                                  and cp.idcaracteristicapedido = 18 
                                                                  and trunc(cp.dataclassificado) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') ) ) ) )
                ```
        }
        layout {
            sequence: 100
            slot: body
            startNewRow: false
        }
