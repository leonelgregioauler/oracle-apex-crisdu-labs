            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--primary
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 6
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 6
                items: {
                    P6_TIPOPAIS: &P6_TIPOPAIS.
                    P6_TIPO: &P6_TIPO.
                    P6_DATAINICIO: &P6_DATAINICIO.
                    P6_DATAFIM: &P6_DATAFIM.
                }
                action: resetPagination
            }
        }
    )

