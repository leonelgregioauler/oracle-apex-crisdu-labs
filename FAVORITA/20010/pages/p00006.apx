    region comissão (
        name: Comissão
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Representantes' tipo
                     , sum(valorpago) "Valor Pago"
                from catal.pagamentocomissoes pc
                where nvl(pc.valorpago,0)    > 0
                  and idrepresentante is not null
                  and (:P6_TIPOPAIS = 1 and exists(select r.idrepresentante
                                                   from catal.representantes r
                                                   where r.idrepresentante = pc.idrepresentante 
                                                     and r.idgerente != 201)
                       or (:P6_TIPOPAIS = 2 and exists(select r.idrepresentante
                                                       from catal.representantes r
                                                       where r.idrepresentante = pc.idrepresentante 
                                                         and r.idgerente = 201)))
                  and ( :P6_TIPO = -1 
                      or (:P6_TIPO = 1 and trunc(datapagamento) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                      or (:P6_TIPO = 2 and trunc(datapagamento) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                      or (:P6_TIPO = 3 and trunc(datapagamento) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') ) )  
                union
                select 'Gerentes' tipo
                     , sum(valorpago) "Valor Pago"
                from catal.pagamentocomissoes pc
                where nvl(pc.valorpago,0)    > 0
                  and idgerente is not null
                  and (:P6_TIPOPAIS = 1 and idgerente != 201
                       or (:P6_TIPOPAIS = 2 and idgerente  = 201))
                  and ( :P6_TIPO = -1 
                      or (:P6_TIPO = 1 and trunc(datapagamento) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                      or (:P6_TIPO = 2 and trunc(datapagamento) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                      or (:P6_TIPO = 3 and trunc(datapagamento) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') ) ) 
                      
                      
                ```
        }
        layout {
            sequence: 80
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent6
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from gerentes g
                where g.idpessoa = ( select idpessoa 
                                     from usuarios u
                                     where u.usuario = v('APP_USER'))
                  and exists ( select 1
                               from roman.vw_filiais f
                               where f.tipofilial = 'D'
                                 and f.idfilial = g.idfilial )
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 339695079177508821
        }

