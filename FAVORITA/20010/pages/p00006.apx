    region total-de-vendas-cd (
        name: Total de Vendas CD
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'CD Igrejinha' estoque 
                     , count(distinct i.idpedido) qtdpedidos
                     , sum(i.quantidade) quantidade
                     , sum(i.valortotalvenda*i.fatorconversao) totalvenda
                     , sum(i.valorapagar*i.fatorconversao) totalapagar
                     , sum(i.valorcusto*i.fatorconversao) totalcusto
                from vw_itenspedidos_fav i
                where i.ididioma = 1
                  and i.idfilialfavorita = 2
                  and :P6_TIPOPAIS = 1
                  and exists ( select 1
                               from pedidos p
                               where p.idpedido = i.idpedido
                                 and p.tipopedido = 'P'
                                 and not exists ( select 1
                                                  from classificacoespedidos cp
                                                  where cp.idpedido = i.idpedido
                                                  and cp.idcaracteristicapedido = 25 )
                                 and p.idsituacaoentrega >= 20000
                                 and ( :P6_TIPO = -1 
                                    or (:P6_TIPO = 1 and trunc(p.dataemissao)  between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 2 and trunc(p.dataentrega)  between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 3 and trunc(p.datadespacho) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 4 and exists ( select 1
                                                                  from classificacoespedidos cp
                                                                  where cp.idpedido = i.idpedido 
                                                                  and cp.idcaracteristicapedido = 48 
                                                                  and trunc(cp.dataclassificado) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') ) )
                                    or (:P6_TIPO = 5 and exists ( select 1
                                                                  from classificacoespedidos cp
                                                                  where cp.idpedido = i.idpedido 
                                                                  and cp.idcaracteristicapedido = 18 
                                                                  and trunc(cp.dataclassificado) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') ) ) ) )  
                union
                select 'CD Campo Grande' estoque
                     , count(distinct i.idpedido) qtdpedidos
                     , sum(i.quantidade) quantidade
                     , sum(i.valortotalvenda*i.fatorconversao) totalvenda
                     , sum(i.valorapagar*i.fatorconversao) totalapagar
                     , sum(i.valorcusto*i.fatorconversao) totalcusto
                from vw_itenspedidos_fav i
                where i.ididioma = 1
                  and i.idfilialfavorita = 3
                  and :P6_TIPOPAIS = 1
                  and exists ( select 1
                               from pedidos p
                               where p.idpedido = i.idpedido
                                 and p.tipopedido = 'P'
                                 and not exists ( select 1
                                                  from classificacoespedidos cp
                                                  where cp.idpedido = i.idpedido
                                                  and cp.idcaracteristicapedido = 25 )
                                 and p.idsituacaoentrega >= 20000
                                 and ( :P6_TIPO = -1 
                                    or (:P6_TIPO = 1 and trunc(p.dataemissao)  between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 2 and trunc(p.dataentrega)  between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 3 and trunc(p.datadespacho) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 4 and exists ( select 1
                                                                  from classificacoespedidos cp
                                                                  where cp.idpedido = i.idpedido 
                                                                  and cp.idcaracteristicapedido = 48 
                                                                  and trunc(cp.dataclassificado) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') ) )
                                    or (:P6_TIPO = 5 and exists ( select 1
                                                                  from classificacoespedidos cp
                                                                  where cp.idpedido = i.idpedido 
                                                                  and cp.idcaracteristicapedido = 18 
                                                                  and trunc(cp.dataclassificado) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') ) ) ) )
                union
                select 'CD Manaus' estoque
                     , count(distinct i.idpedido) qtdpedidos
                     , sum(i.quantidade) quantidade
                     , sum(i.valortotalvenda*i.fatorconversao) totalvenda
                     , sum(i.valorapagar*i.fatorconversao) totalapagar
                     , sum(i.valorcusto*i.fatorconversao) totalcusto
                from vw_itenspedidos_fav i
                where i.ididioma = 1
                  and i.idfilialfavorita = 4
                  and :P6_TIPOPAIS = 1
                  and exists ( select 1
                               from pedidos p
                               where p.idpedido = i.idpedido
                                 and p.tipopedido = 'P'
                                 and not exists ( select 1
                                                  from classificacoespedidos cp
                                                  where cp.idpedido = i.idpedido
                                                  and cp.idcaracteristicapedido = 25 )
                                 and p.idsituacaoentrega >= 20000
                                 and ( :P6_TIPO = -1 
                                    or (:P6_TIPO = 1 and trunc(p.dataemissao)  between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 2 and trunc(p.dataentrega)  between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 3 and trunc(p.datadespacho) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 4 and exists ( select 1
                                                                  from classificacoespedidos cp
                                                                  where cp.idpedido = i.idpedido 
                                                                  and cp.idcaracteristicapedido = 48 
                                                                  and trunc(cp.dataclassificado) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') ) )
                                    or (:P6_TIPO = 5 and exists ( select 1
                                                                  from classificacoespedidos cp
                                                                  where cp.idpedido = i.idpedido 
                                                                  and cp.idcaracteristicapedido = 18 
                                                                  and trunc(cp.dataclassificado) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') ) ) ) )
                union
                select 'CD Belem' estoque
                     , count(distinct i.idpedido) qtdpedidos
                     , sum(i.quantidade) quantidade
                     , sum(i.valortotalvenda*i.fatorconversao) totalvenda
                     , sum(i.valorapagar*i.fatorconversao) totalapagar
                     , sum(i.valorcusto*i.fatorconversao) totalcusto
                from vw_itenspedidos_fav i
                where i.ididioma = 1
                  and i.idfilialfavorita = 6
                  and :P6_TIPOPAIS = 1
                  and exists ( select 1
                               from pedidos p
                               where p.idpedido = i.idpedido
                                 and p.tipopedido = 'P'
                                 and not exists ( select 1
                                                  from classificacoespedidos cp
                                                  where cp.idpedido = i.idpedido
                                                  and cp.idcaracteristicapedido = 25 )
                                 and p.idsituacaoentrega >= 20000
                                 and ( :P6_TIPO = -1 
                                    or (:P6_TIPO = 1 and trunc(p.dataemissao)  between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 2 and trunc(p.dataentrega)  between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 3 and trunc(p.datadespacho) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 4 and exists ( select 1
                                                                  from classificacoespedidos cp
                                                                  where cp.idpedido = i.idpedido 
                                                                  and cp.idcaracteristicapedido = 48 
                                                                  and trunc(cp.dataclassificado) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') ) )
                                    or (:P6_TIPO = 5 and exists ( select 1
                                                                  from classificacoespedidos cp
                                                                  where cp.idpedido = i.idpedido 
                                                                  and cp.idcaracteristicapedido = 18 
                                                                  and trunc(cp.dataclassificado) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') ) ) ) )
                union
                select 'CD Uruguai' estoque
                     , count(distinct i.idpedido) qtdpedidos
                     , sum(i.quantidade) quantidade
                     , sum(i.valortotalvenda*i.fatorconversao) totalvenda
                     , sum(i.valorapagar*i.fatorconversao) totalapagar
                     , sum(i.valorcusto*i.fatorconversao) totalcusto
                from vw_itenspedidos_fav i
                where i.ididioma = 1
                  and i.idfilialfavorita = 9
                  and :P6_TIPOPAIS = 2
                  and exists ( select 1
                               from pedidos p
                               where p.idpedido = i.idpedido
                                 and p.tipopedido = 'P'
                                 and not exists ( select 1
                                                  from classificacoespedidos cp
                                                  where cp.idpedido = i.idpedido
                                                  and cp.idcaracteristicapedido = 25 )
                                 and p.idsituacaoentrega >= 20000
                                 and ( :P6_TIPO = -1 
                                    or (:P6_TIPO = 1 and trunc(p.dataemissao)  between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 2 and trunc(p.dataentrega)  between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 3 and trunc(p.datadespacho) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 4 and exists ( select 1
                                                                  from classificacoespedidos cp
                                                                  where cp.idpedido = i.idpedido 
                                                                  and cp.idcaracteristicapedido = 48 
                                                                  and trunc(cp.dataclassificado) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') ) )
                                    or (:P6_TIPO = 5 and exists ( select 1
                                                                  from classificacoespedidos cp
                                                                  where cp.idpedido = i.idpedido 
                                                                  and cp.idcaracteristicapedido = 18 
                                                                  and trunc(cp.dataclassificado) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') ) ) ) )  
                union
                select 'CD Paraguay' estoque
                     , count(distinct i.idpedido) qtdpedidos
                     , sum(i.quantidade) quantidade
                     , sum(i.valortotalvenda*i.fatorconversao) totalvenda
                     , sum(i.valorapagar*i.fatorconversao) totalapagar
                     , sum(i.valorcusto*i.fatorconversao) totalcusto
                from vw_itenspedidos_fav i
                where i.ididioma = 1
                  and i.idfilialfavorita = 30
                  and :P6_TIPOPAIS = 4
                  and exists ( select 1
                               from pedidos p
                               where p.idpedido = i.idpedido
                                 and p.tipopedido = 'P'
                                 and not exists ( select 1
                                                  from classificacoespedidos cp
                                                  where cp.idpedido = i.idpedido
                                                  and cp.idcaracteristicapedido = 25 )
                                 and p.idsituacaoentrega >= 20000
                                 and ( :P6_TIPO = -1 
                                    or (:P6_TIPO = 1 and trunc(p.dataemissao)  between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 2 and trunc(p.dataentrega)  between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 3 and trunc(p.datadespacho) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 4 and exists ( select 1
                                                                  from classificacoespedidos cp
                                                                  where cp.idpedido = i.idpedido 
                                                                  and cp.idcaracteristicapedido = 48 
                                                                  and trunc(cp.dataclassificado) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') ) )
                                    or (:P6_TIPO = 5 and exists ( select 1
                                                                  from classificacoespedidos cp
                                                                  where cp.idpedido = i.idpedido 
                                                                  and cp.idcaracteristicapedido = 18 
                                                                  and trunc(cp.dataclassificado) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') ) ) ) )  
                union
                select 'Venda Direta' estoque
                     , count(distinct i.idpedido) qtdpedidos
                     , sum(i.quantidade) quantidade
                     , sum(i.valortotalvenda*i.fatorconversao) totalvenda
                     , sum(i.valorapagar*i.fatorconversao) totalapagar
                     , sum(i.valorcusto*i.fatorconversao) totalcusto
                from vw_itenspedidos_fav i
                where i.ididioma = 1
                  and exists ( select 1
                               from filiaisfavorita f
                               where f.idfilialfavorita = i.idfilialfavorita
                                 and f.tipofilial       = 'V' )
                  and :P6_TIPOPAIS = 1
                  and exists ( select 1
                               from pedidos p
                               where p.idpedido = i.idpedido
                                 and not exists ( select 1
                                                  from classificacoespedidos cp
                                                  where cp.idpedido = i.idpedido
                                                  and cp.idcaracteristicapedido = 25 )
                                 and p.idsituacaoentrega >= 20000
                                 and p.tipopedido = 'V'
                                 and ( :P6_TIPO = -1 
                                    or (:P6_TIPO = 1 and trunc(p.dataemissao)  between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 2 and trunc(p.dataentrega)  between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') )
                                    or (:P6_TIPO = 3 and trunc(p.datadespacho) between to_date(:P6_DATAINICIO,'DD/MM/RRRR') and to_date(:P6_DATAFIM,'DD/MM/RRRR') ) ) )
                
                ```
