    region produto (
        name: "Produto 1 "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idfilialfavorita,
                       nome,
                       Produto,
                       qtdAtual,
                       qtdDisp,
                       ((qtdMovim) * -1) qtdMovim,
                       sum(Qtd_Tran) Qtd_Tran,
                       sum(Qtd_Prep) Qtd_Prep,
                       Qtd_Receb
                  from (
                        --- Itens aguardando chegada na loja
                        select distinct e.idfilialfavorita,
                                         favorita.pck_util_fav.fnc_nomeprodutodetalhado(i.idprodutodetalhado,1) Produto,
                                         favorita.pck_util_fav.fnc_nomefilialfavorita(e.idfilialfavorita) nome,
                                         e.quantidade qtdAtual,
                                         e.idestoque,
                                         favorita.pck_estoque_fav.fnc_estoquedisponivel(e.idestoque) qtdDisp,
                                         ( select sum(m.quantidade)
                                           from favorita.movimentosestoques m
                                           where m.idestoque = e.idestoque 
                                             and m.quantidade < 0
                                             and m.datamovimento between
                                                 to_date(NVL(:P69_DATAINICIO,'31/12/2050') || ' 00:00:01', 'DD/MM/RRRR HH24:MI:SS') and
                                                 to_date(NVL(:P69_DATAFIM,'31/12/2050')    || ' 23:59:59', 'DD/MM/RRRR HH24:MI:SS')) qtdMovim,
                                         --
                                         case
                                           when c.idsituacao in (20, 30) -- Em Transido | Aguard. Conferencia
                                            then
                                            i.quantidadecomprada
                                           else
                                            0
                                         end Qtd_Tran -- transito e transferido
                                         --
                                         ,
                                         case
                                           when c.idsituacao between 0 and 11 -- Em Transido | Aguard. Conferencia
                                            then
                                            i.quantidadecomprada
                                           else
                                            0
                                         end Qtd_Prep -- qtde sendo preparada
                                         --
                                         ,
                                         ( select sum(m.quantidade)
                                           from favorita.movimentosestoques m
                                           where m.idestoque = e.idestoque 
                                             and m.quantidade > 0
                                             and m.iditemcompratransf is not null
                                             and m.datamovimento between
                                                 to_date(NVL(:P69_DATAINICIO,'31/12/2050') || ' 00:00:01', 'DD/MM/RRRR HH24:MI:SS') and
                                                 to_date(NVL(:P69_DATAFIM,'31/12/2050')    || ' 23:59:59', 'DD/MM/RRRR HH24:MI:SS')) Qtd_Receb
                      
                                         /*case
                                           when c.idsituacao in (40) -- Recebida
                                            then
                                            i.quantidaderecebida
                                           else
                                            0
                                         end Qtd_Receb */ --
                                        
                          from favorita.estoques                   e,
                                favorita.itenscomprastransferencias i,
                                favorita.comprastransferencias      c,
                                favorita.filiaisfavorita            f,
                                favorita.produtosdetalhados         p
                         where e.idfilialfavorita = f.idfilialfavorita
                           and e.idestoque = i.idestoquefildestino
                           and i.idcompratransferencia = c.idcompratransferencia
                           --and c.idsituacao not in (40)
                           and p.idproduto = 4296
                           and p.idprodutodetalhado = e.idprodutodetalhado
                           and exists
                         (select 1
                           from favorita.atendimentosestoques a
                          where c.idfilialfavoritadestino = a.idfilialfavoritadestino
                            and ( a.idfilialfavoritaorigem = :P69_IDFILIALFAVORITA  or :P69_IDFILIALFAVORITA is null)-- filtro de filial favorita
                            and exists ( select 1
                                           from favorita.filiaisfavorita f
                                         where f.idfilialfavorita = a.idfilialfavoritadestino
                                           and f.tipofilial in ('L','E')))  
                       group by e.idfilialfavorita,
                             e.quantidade,
                             i.idprodutodetalhado,
                             e.idestoque,
                             i.quantidadecomprada, 
                            -- i.quantidaderecebida,
                             c.idsituacao )        
                 group by idfilialfavorita, nome,Produto, qtdAtual, qtdAtual, qtdDisp, qtdMovim, Qtd_Receb
                 order by 1
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Não encontrou informações.
        }
        advanced {
            savedReportMappingIdentifier: 4540342141727989735
        }

