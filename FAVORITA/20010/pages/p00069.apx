            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Não encontrou informações.
        }
        advanced {
            savedReportMappingIdentifier: 4540344628331989760
        }

