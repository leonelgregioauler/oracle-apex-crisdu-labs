    region produto-2 (
        name: Produto 2
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idfilialfavorita,
                       nome,
                       Produto,
                       qtdAtual,
                       qtdDisp,
                       (sum(qtdMovim) * -1) qtdMovim,
                       sum(Qtd_Tran) Qtd_Tran,
                       sum(Qtd_Prep) Qtd_Prep
                  from (
                        --- Itens aguardando chegada na loja
                        select distinct e.idfilialfavorita,
                                         favorita.pck_util_fav.fnc_nomefilialfavorita(e.idfilialfavorita) nome,
                                         favorita.pck_util_fav.fnc_nomeprodutodetalhado(e.idprodutodetalhado,1) Produto,
                                         e.quantidade qtdAtual,
                                         e.idestoque,
                                         favorita.pck_estoque_fav.fnc_estoquedisponivel(e.idestoque) qtdDisp,
                                         -- m.idmovimentoestoque, --, i.idcompratransferencia, i.iditemcompratransferencia
                                         ( select sum(m.quantidade)
                                           from favorita.movimentosestoques m
                                           where m.idestoque = e.idestoque 
                                             and m.quantidade < 0
                                             and m.datamovimento between
                                                 to_date(NVL(:P69_DATAINICIO,'31/12/2050') || ' 00:00:01', 'DD/MM/RRRR HH24:MI:SS') and
                                                 to_date(NVL(:P69_DATAFIM,'31/12/2050')    || ' 23:59:59', 'DD/MM/RRRR HH24:MI:SS')) qtdMovim,
                                         ( select sum ( case
                                                       when c.idsituacao in (20, 30) -- Em Transido | Aguard. Conferencia
                                                       then
                                                        i.quantidadecomprada
                                                       else
                                                        0
                                                       end )
                                           from  favorita.itenscomprastransferencias i,
                                                 favorita.comprastransferencias      c 
                                           where e.idestoque = i.idestoquefildestino
                                             and i.idcompratransferencia = c.idcompratransferencia
                                             and c.idsituacao not in (40))Qtd_Tran -- transito e transferido
                                         --
                                        , ( select sum ( case
                                                         when c.idsituacao between 0 and 11 -- Em Transido | Aguard. Conferencia
                                                         then
                                                           i.quantidadecomprada
                                                         else
                                                           0
                                                         end )
                                           from  favorita.itenscomprastransferencias i,
                                                 favorita.comprastransferencias      c 
                                           where e.idestoque = i.idestoquefildestino
                                             and i.idcompratransferencia = c.idcompratransferencia
                                             and c.idsituacao not in (40))Qtd_Prep -- qtde sendo preparada
                          from favorita.estoques                    e,
                                favorita.filiaisfavorita            f,
                                favorita.produtosdetalhados         p
                         where e.idfilialfavorita = f.idfilialfavorita
                           and p.idproduto = 4953 -- 
                           and p.idprodutodetalhado = e.idprodutodetalhado
                           and ( :P69_IDFILIALFAVORITA is null or e.idfilialfavorita = :P69_IDFILIALFAVORITA )
                       group by e.idfilialfavorita,
                             e.quantidade,
                             e.idestoque,
                             e.idprodutodetalhado)          
                 group by idfilialfavorita, nome, qtdAtual, qtdAtual, qtdDisp, Produto
                 order by 1
                
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
