    dynamicAction filtrar (
        name: Filtrar
        execution {
            sequence: 70
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: SUBMIT
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction filtro-fornecedores (
        name: FILTRO FORNECEDORES
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P69_TIPOFILTRO
        }
        clientSideCondition {
            type: item=value
            item: P69_TIPOFILTRO
            value: 2
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P69_TIPOFILTROFORNECEDOR
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P69_IDFILIALFAVORITA
                    P69_TIPOFILTROFORNECEDOR
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction filtro-produtos (
        name: FILTRO PRODUTOS
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P69_TIPOFILTRO
        }
        clientSideCondition {
            type: item=value
            item: P69_TIPOFILTRO
            value: 1
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P69_IDPRODUTODETALHADO
                    P69_IDPAIS
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P69_IDFORNECEDOR
            }
            execution {
                sequence: 30
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P69_IDFILIALFAVORITA
                    P69_DATAINICIO
                    P69_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction não-filtrar (
        name: NÃO FILTRAR
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P69_TIPOFILTRO
        }
        clientSideCondition {
            type: item=value
            item: P69_TIPOFILTRO
            value: -1
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P69_IDFILIALFAVORITA
            }
            execution {
                sequence: 10
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: region
                region: @filtros
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: region
                region: @filtros
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    validation valida-data (
        name: Valida Data
        execution {
            sequence: 10
        }
        validation {
            language: sql
            sqlExpression: :P69_DATAINICIO is not null and :P69_DATAFIM is not null
        }
        error {
            errorMessage: Informe a data inicio e fim!
        }
    )

    branch (
        name: Go To Page 69
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 69
                items: {
                    P69_IDFILIALFAVORITA: &P69_IDFILIALFAVORITA.
                    P69_DATAINICIO: &P69_DATAINICIO.
                    P69_DATAFIM: &P69_DATAFIM.
                }
                clearCache: 4
                action: resetPagination
            }
        }
    )

)

