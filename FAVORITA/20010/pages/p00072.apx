page 72 (
    name: "Ranking Campanha "
    title: "Ranking Campanha "
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region ranking-campanha-ped-emitidos (
        name: Ranking Campanha Ped. Emitidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select xx.franquia
                     , xx.nomerep
                     , xx.nomeven
                     , sum(xx.pontos)pontos
                  from (select roman.pck_romance.fnc_nomefilial(p.idfilialromance)franquia
                             , p.idrepresentante
                             , roman.pck_romance.fnc_nomerepresentante(p.idrepresentante) nomerep
                             , p.idvendedora
                             , roman.pck_romance.fnc_nomevendedora(p.idvendedora) nomeven
                             , roman.pck_romance.fnc_cpfvendedora(p.idvendedora) cpf
                             --, sum(round(it.valorvenda*nvl(p.fatorconversao,1))) pontos
                             , case 
                                 when trunc(p.dataemissao) <= to_date('16/04/2023','dd/mm/rrrr') and it.idproduto in (  4791
                                                                                                                      , 5117
                                                                                                                      , 5305
                                                                                                                      , 5119
                                                                                                                      , 5306
                                                                                                                      , 5120
                                                                                                                      , 5307
                                                                                                                      , 5118
                                                                                                                      , 5302
                                                                                                                      , 5304
                                                                                                                      , 5321
                                                                                                                      , 3418
                                                                                                                      , 3740
                                                                                                                      , 4048 ) 
                                  then 0
                                  else
                                       round(nvl(it.valorapagar,0)*nvl(p.fatorconversao,1))
                               end pontos 
                        from favorita.pedidos p
                           , favorita.itenspedidos it
                        where p.idpedido = it.idpedido
                          and p.datacancelamento is null
                          and trunc(p.dataemissao) between to_date(:P72_DATADE,'DD/MM/RRRR') and to_date(:P72_DATAATE,'DD/MM/RRRR')
                          and not exists ( select 1
                                          from classificacoespedidos cp
                                          where cp.idclassificacaopedido = 28 -- pedido de dist
                                            and cp.idpedido              = p.idpedido )
                          and not exists ( select 1
                                          from representantes r
                                             , vendedoras v
                                          where v.idvendedora = p.idvendedora
                                            and r.idpessoa    = v.idpessoa
                                            and r.ativo       = 'S' )-- cliente o proprio dist
                          /*and exists ( select 1
                                          from vencimentospedidos vp
                                          where vp.idpedido = p.idpedido
                                            --and vp.situacaovencimento = 'V'
                                            and vp.valorpago >= vp.valorpagar ) */
                          and exists ( select 1
                                      from roman.vw_filiais f
                                      where f.ativo = 'S'
                                        and f.idgrupo != 5
                                        and f.idfilial = p.idfilialromance )
                          and it.idproduto in ( 4988
                                              , 4990
                                              , 4991
                                              , 4989
                                              , 5400
                                              , 5403
                                              , 5401
                                              , 5402
                                              , 5404
                                              , 4551
                                              , 4552
                                              , 4553
                                              , 4554 --Primeira lista
                                              
                                              
                                              , 4791
                                              , 5117
                                              , 5305
                                              , 5119
                                              , 5306
                                              , 5120
                                              , 5307
                                              , 5118
                                              , 5302
                                              , 5304
                                              , 5321
                                              , 3418
                                              , 3740 --segunda lista 
                                              , 4048
                                              
                                              , 3741 --ultima requisição tkt: 7810449 
                                              )) xx
                where  :P72_FILTRAR = 'S'
                group by xx.franquia
                       , xx.nomerep
                       , xx.nomeven
                order by 4 desc
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P72_TIPORELATORIO
            value: N
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 563616927172067615
        }

        column FRANQUIA (
            type: plainText
            heading {
                heading: Empresa
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column NOMEREP (
            type: plainText
            heading {
                heading: Distribuidor Independente
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column NOMEVEN (
            type: plainText
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column PONTOS (
            type: plainText
            heading {
                heading: Pontos
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 5636359 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn FRANQUIA (
                sequence: 1
            )

            displayColumn NOMEREP (
                sequence: 2
            )

            displayColumn NOMEVEN (
                sequence: 3
            )

            displayColumn PONTOS (
                sequence: 4
            )

        )

    )

