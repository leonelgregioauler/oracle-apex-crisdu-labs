page 16 (
    name: Últimos Preços Validos
    title: Últimos Preços Validos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region últimos-preços-validos (
        name: Últimos Preços Validos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idprecoproduto
                     , t.idedicaorevista
                     , t.edicaorevista
                     , t.idprodutodetalhado
                     , t.nomeprodutodetalhado
                     , t.idfilialromance
                     , t.filialromance
                     , t.pkg_data.valorcusto valorcusto
                     , t.pkg_data.valorvenda valorvenda
                     , t.idproduto
                     , t.pkg_data.perccomissaogerente perccomissaogerente
                     , t.pkg_data.perccomissaodistribuidor perccomissaodistribuidor
                     , t.pkg_data.perccomissaoconsultora perccomissaoconsultora
                     , t.pkg_data.valorcomissaoatendente valorcomissaoatendente
                 from (
                        select (select idprecoproduto from precosprodutos where idprodutodetalhado = t.idprodutodetalhado and idedicaorevista = :p16_idedicaorevista and idfilialromance = t.idfilialromance) idprecoproduto
                             , :p16_idedicaorevista idedicaorevista
                             , pck_util_fav.fnc_edicaorevista(:p16_idedicaorevista) edicaorevista
                             , t.idprodutodetalhado
                             , pck_util_fav.fnc_nomeprodutodetalhado(t.idprodutodetalhado,1) nomeprodutodetalhado
                             , t.idfilialromance
                             , roman.pck_romance.fnc_nomefilial(t.idfilialromance) filialromance
                             , ( select idproduto
                                 from produtosdetalhados pp
                                 where pp.idprodutodetalhado = t.idprodutodetalhado ) idproduto
                             , pck_integracao_fav_widecomm.fnc_buscavalorcomdesconto( :p16_idedicaorevista,t.idprodutodetalhado,:p16_idpais) pkg_data
                          from (
                                select pp.idprodutodetalhado, pp.idfilialromance
                                  from produtosdetalhados pd, precosprodutos pp, edicoesrevistas er, produtosdetedrevistas pdr
                                 where pdr.idprodutodetalhado = pp.idprodutodetalhado
                                   and pdr.idedicaorevista = pp.idedicaorevista
                                   and pp.idprodutodetalhado = pd.idprodutodetalhado
                                   and pp.idedicaorevista = er.idedicaorevista
                                   and er.idedicaorevista = :p16_idedicaorevista
                                   and er.idpais = :p16_idpais
                                   and er.tipovenda = :p16_tiporevista
                                   and (pd.idproduto = :p16_idproduto or :p16_idproduto is null)
                                   and (pp.idfilialromance = :p16_idfilialromance or :p16_idfilialromance is null)
                                 union 
                                select pp.idprodutodetalhado, pp.idfilialromance
                                  from produtosdetalhados pd, precosprodutos pp, edicoesrevistas er, produtosdetedrevistas pdr
                                 where pdr.idprodutodetalhado = pp.idprodutodetalhado
                                   and pdr.idedicaorevista = pp.idedicaorevista
                                   and pp.idprodutodetalhado = pd.idprodutodetalhado
                                   and pp.idedicaorevista = er.idedicaorevista
                                   and to_number(er.numeroedicao) < (select to_number(numeroedicao) 
                                                                       from edicoesrevistas 
                                                                      where idedicaorevista = :p16_idedicaorevista
                                                                        and idpais = :p16_idpais
                                                                        and tipovenda = :p16_tiporevista)
                                   and er.idpais = :p16_idpais
                                   and er.tipovenda = :p16_tiporevista
                                   and (pd.idproduto = :p16_idproduto or :p16_idproduto is null)
                                  and (pp.idfilialromance = :p16_idfilialromance or :p16_idfilialromance is null)
                                   and pd.descontinuado = 'N'
                                 minus
                                select pp.idprodutodetalhado, pp.idfilialromance
                                  from produtosdetalhados pd, precosprodutos pp, edicoesrevistas er, produtosdetedrevistas pdr
                                 where pdr.idprodutodetalhado = pp.idprodutodetalhado
                                   and pdr.idedicaorevista = pp.idedicaorevista
                                   and pp.idprodutodetalhado = pd.idprodutodetalhado
                                   and pp.idedicaorevista = er.idedicaorevista
                                   and to_number(er.numeroedicao) > (select to_number(numeroedicao) 
                                                                       from edicoesrevistas 
                                                                      where idedicaorevista = :p16_idedicaorevista
                                                                        and idpais = :p16_idpais
                                                                        and tipovenda = :p16_tiporevista)
                                   and er.idpais = :p16_idpais
                                   and er.tipovenda = :p16_tiporevista
                                   and (pd.idproduto = :p16_idproduto or :p16_idproduto is null)
                                   and (pp.idfilialromance = :p16_idfilialromance or :p16_idfilialromance is null)
                                   and pd.descontinuado = 'N'
                                   and not exists (
                                                    select 1
                                                      from produtosdetalhados pda, precosprodutos ppa, edicoesrevistas era, produtosdetedrevistas pdra
                                                     where pdra.idprodutodetalhado = ppa.idprodutodetalhado
                                                       and pdra.idedicaorevista = ppa.idedicaorevista
                                                       and ppa.idprodutodetalhado = pda.idprodutodetalhado
                                                       and ppa.idedicaorevista = era.idedicaorevista
                                                       and ppa.idprodutodetalhado = pp.idprodutodetalhado
                                                       and ppa.idfilialromance = pp.idfilialromance
                                                       and to_number(era.numeroedicao) <= (select to_number(numeroedicao) 
                                                                                           from edicoesrevistas 
                                                                                          where idedicaorevista = :p16_idedicaorevista
                                                                                            and idpais = :p16_idpais
                                                                                            and tipovenda = :p16_tiporevista)
                                                       and era.idpais = :p16_idpais
                                                       and era.tipovenda = :p16_tiporevista
                                                       and (pda.idproduto = :p16_idproduto or :p16_idproduto is null)
                                                       and (ppa.idfilialromance = :p16_idfilialromance or :p16_idfilialromance is null)
                                                       and pda.descontinuado = 'N'
                                                   )
                             ) t
                       )  t
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 1439123317390679508
        }

