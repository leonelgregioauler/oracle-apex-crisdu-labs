    pageItem P16_IDEDICAOREVISTA (
        type: selectList
        label {
            label: Ed. Revista
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                 select pck_util_fav.fnc_edicaorevista(idedicaorevista) as d,
                       idedicaorevista as r
                  from edicoesrevistas
                 order by 1
                 
                ```
            displayExtraValues: false
            nullDisplayValue: " - Todos -"
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P16_IDFILIALROMANCE (
        type: plugin/select
        label {
            label: Filial Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome as d,
                       idfilial as r
                  from roman.vw_filiais
                 where tipofilial in ('C', 'D', 'P')
                   and ativo = 'S'
                 order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: " - Todas - "
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P16_IDPAIS (
        type: selectList
        label {
            label: Pais
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nome showvalue
                     , p.idpais returnvalue
                from catal.paises p
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P16_IDPRODUTO (
        type: plugin/select
        label {
            label: Produto
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select referencia||'-'||nomeproduto display_value
                  , idproduto
                from vw_produtos_fav
                where ididioma = 1
                order by nomeproduto
                ```
            displayExtraValues: false
            nullDisplayValue: " - Todos - "
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P16_TIPOREVISTA (
        type: selectList
        label {
            label: Tipo de Revista
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Distribuidora;R,Loja;L
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconRight
                t-Button--stretch
            ]
            icon: fa-filter
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process últimos-preços-validos-save-interactive-grid-data (
        name: Últimos Preços Validos - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @últimos-preços-validos
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1441650143042675104
        }
    )

)

