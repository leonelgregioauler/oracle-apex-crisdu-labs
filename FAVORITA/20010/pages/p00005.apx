page 5 (
    name: TQG Favorita
    title: TQG Favorita
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pedidos-do-distribuidor (
        name: Pedidos do distribuidor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select fp.numeropedido
                     , fp.dataemissao
                     , fp.dataentrega
                     , fp.datavencimento
                     , fp.situacaoentregainterno
                     , fp.situacaofinanceirointerno
                     , fp.valortotal
                     , fp.valorapagar
                     , fp.distribuidor
                     , fp.filialromance
                from favorita.vw_pedidosromance_fav fp
                where exists(select v.idvendedora
                             from catal.vendedoras v
                             where exists(select cr.idpessoa
                                          from catal.representantes cr
                                          where idrepresentante = :P5_IDREPRESENTANTE
                                            and v.idpessoa = cr.idpessoa)
                               and v.idvendedora = fp.idvendedora)
                               
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 252853928014591306
        }

        column DATAEMISSAO (
            type: plainText
            heading {
                heading: Dataemissao
                alignment: center
            }
            layout {
                sequence: 140
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: N
            }
        )

        column DATAENTREGA (
            type: plainText
            heading {
                heading: Dataentrega
                alignment: center
            }
            layout {
                sequence: 150
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: O
            }
        )

        column DATAVENCIMENTO (
            type: plainText
            heading {
                heading: Datavencimento
                alignment: center
            }
            layout {
                sequence: 300
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AO
            }
        )

        column DISTRIBUIDOR (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 330
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AR
            }
        )

        column FILIALROMANCE (
            type: plainText
            heading {
                heading: Filialromance
                alignment: center
            }
            layout {
                sequence: 340
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AS
            }
        )

        column NUMEROPEDIDO (
            type: plainText
            heading {
                heading: Numeropedido
                alignment: center
            }
            layout {
                sequence: 290
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AN
            }
        )

        column SITUACAOENTREGAINTERNO (
            type: plainText
            heading {
                heading: Situacaoentregainterno
                alignment: center
            }
            layout {
                sequence: 310
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AP
            }
        )

        column SITUACAOFINANCEIROINTERNO (
            type: plainText
            heading {
                heading: Situacaofinanceirointerno
                alignment: center
            }
            layout {
                sequence: 320
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AQ
            }
        )

        column VALORAPAGAR (
            type: plainText
            heading {
                heading: Valorapagar
                alignment: center
            }
            layout {
                sequence: 280
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: AB
            }
        )

        column VALORTOTAL (
            type: plainText
            heading {
                heading: Valortotal
                alignment: center
            }
            layout {
                sequence: 230
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: W
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 2528859 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAEMISSAO (
                sequence: 2
            )

            displayColumn DATAENTREGA (
                sequence: 3
            )

            displayColumn DATAVENCIMENTO (
                sequence: 7
            )

            displayColumn DISTRIBUIDOR (
                sequence: 10
            )

            displayColumn FILIALROMANCE (
                sequence: 11
            )

            displayColumn IDIDFILIALFAVORITA (
                sequence: 1
            )

            displayColumn RASTREIOTRANSPORTECUSTO (
                sequence: 4
            )

            displayColumn SITUACAOENTREGAINTERNO (
                sequence: 8
            )

            displayColumn SITUACAOFINANCEIROINTERNO (
                sequence: 9
            )

            displayColumn VALORAPAGAR (
                sequence: 6
            )

            displayColumn VALORTOTAL (
                sequence: 5
            )

        )

    )

    pageItem P5_IDPESSOA (
        type: hidden
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select idpessoa
                from pessoas
                where cpf = replace(replace(:P280_CPF,'-',''),'.','');
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P5_IDREPRESENTANTE (
        type: plugin/select
        label {
            label: CPF
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select vr.Nome||' - '||vr.idrepresentante  display_value
                     , vr.idrepresentante return_value 
                from favorita.vw_representantes vr;
                ```
            nullDisplayValue: - Selecione o Distribuidor -
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P5_IDREPRESENTANTE
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

