page 23 (
    name: Relatório de Atividade Call Center
    title: Relatório de Atividade
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
        browserCache: false
    }
    advanced {
        enableDuplicatePageSubmissions: false
        reloadOnSubmit: always
    }

    region relatório-de-atividade (
        name: Relatório de Atividade
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select op.nome
                     , to_char(ca.data_inicio,'hh24:mi:ss') início
                     , beepeople.retorna_segundos_em_horas((sysdate-ca.data_inicio)*86400) tempo
                     , ca.estacao PA
                  from beeweb.controle_atividade ca
                     , beeadmin.usuarios u
                     , beepeople.controle_frequencia cf
                     , beepeople.vw_pessoas op
                 where ca.cod_usuario = u.codigo
                   and u.cod_pessoa = cf.cod_pessoa
                   and u.empresa = cf.empresa
                   and cf.cod_pessoa = op.codigo
                   and cf.empresa = op.empresa
                   and ca.data_inicio between cf.data_entrada_efetiva and cf.data_saida_prevista
                   and cf.cod_centro_custo = '4'
                   and ca.atividade = :P23_VALOR
                   and ca.data_termino is null
                   and ca.data_inicio > sysdate - (6/24)
                 order by ca.atividade
                     , ca.data_inicio
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--noBorders
                margin-top-lg
                margin-bottom-lg
                margin-left-lg
                margin-right-lg
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 2743205548397916449
        }

        column INÍCIO (
            type: plainText
            heading {
                heading: Início
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column NOME (
            type: plainText
            heading {
                heading: Nome
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column PA (
            type: plainText
            heading {
                heading: PA
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column TEMPO (
            type: plainText
            heading {
                heading: Tempo
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        savedReport 27497142 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn INÍCIO (
                sequence: 2
            )

            displayColumn NOME (
                sequence: 1
            )

            displayColumn PA (
                sequence: 4
            )

            displayColumn TEMPO (
                sequence: 3
            )

        )

    )

    pageItem P23_VALOR (
        type: hidden
        layout {
            sequence: 20
            region: @relatório-de-atividade
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

