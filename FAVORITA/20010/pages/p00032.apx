    region valor-total (
        name: Valor Total
        type: chart
        layout {
            sequence: 100
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        animation {
            onDataChange: none
        }
        legend {
            hideAndShowBehavior: none
        }

        series valor (
            name: Valor
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select to_char(data,'dd/mm') data
                         , valor
                         , data||' 00:00:00' link
                      from (
                            select trunc(h.dataemissao) data
                                 , sum(nvl(h.valortotal,0)) VALOR
                              from favorita.vw_dashboardatendimento_bee h
                             where h.dataemissao >= trunc(sysdate-14)
                             group by trunc(h.dataemissao)) t
                     order by t.data
                    
                    ```
            }
            columnMapping {
                label: DATA
                value: VALOR
            }
            link {
                type: redirectThisApp
                target: {
                    page: 30
                    items: {
                        P30_VALOR: &LINK.
                    }
                    action: resetPagination
                }
            }
            label {
                show: true
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            minorTicks {
                show: false
            }
        )

    )

    pageItem P32_MENSAGEM (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 10
            region: @mensagem
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<font size=24 color="GREEN"><br> Rumo a Novos Recordes!  </br></font>' return
                from dual
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction reload (
        name: Reload
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    function doLoad()
                    {
                       setTimeout( "refresh()", 15*1000 );
                    }
                    
                    function refresh()
                    {
                    window.location.href = window.location;
                    apex.submit('TROCAPAGINA');
                    }
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 21
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: TROCAPAGINA
        }
    )

)

