    region mensagem (
        name: Mensagem
        type: staticContent
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region ticket-médio (
        name: Ticket Médio
        type: chart
        layout {
            sequence: 120
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        animation {
            onDataChange: none
        }
        legend {
            hideAndShowBehavior: none
        }

        series valor (
            name: Valor
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select to_char(data,'dd/mm') data
                         , trunc(valor/pedidos,2) VALOR
                     from (
                            select trunc(h.dataemissao) data
                                 , sum(nvl(h.valortotal,0)) VALOR
                                 , count(distinct h.idpedido) pedidos
                              from favorita.vw_dashboardatendimento_bee h
                             where h.dataemissao >= trunc(sysdate-14)
                             group by trunc(h.dataemissao)) t
                     order by t.data
                    ```
            }
            columnMapping {
                label: DATA
                value: VALOR
            }
            label {
                show: true
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            minorTicks {
                show: false
            }
        )

    )

