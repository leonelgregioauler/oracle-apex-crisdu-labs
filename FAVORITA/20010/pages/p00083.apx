page 83 (
    name: Débitos de Distribuidores
    title: Débitos de Distribuidores
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region débitos-de-distribuidores (
        name: Débitos de Distribuidores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select md.numero nr_pedido
                     , md.origem
                     , md.valortotal
                     , md.vencimentos
                     , md.datavencimento
                     , md.diasatrasado
                     , md.situacao
                     , md.valoratualizado
                     , md.valororiginal
                     , md.vencimentooriginal
                     , md.valorpago
                from roman.debitosdistribuidoresfav md
                where md.idrepresentante = :P83_IDREPRESENTANTE
                  and md.valorpago < md.valororiginal;
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-showMaximizeButton
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1095774893872186622
        }

        column DATAVENCIMENTO (
            type: plainText
            heading {
                heading: Data Vencimento
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: E
            }
        )

        column DIASATRASADO (
            type: plainText
            heading {
                heading: Dias Atrasado
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column NR_PEDIDO (
            type: plainText
