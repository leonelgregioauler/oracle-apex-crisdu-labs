    region faturamento-x-crescimento (
        name: Faturamento x Crescimento
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT vf.NOME 
                     , sum(t.rmc_fat_2022) rmc_fat_2022
                     , sum(t.rmc_fat_2022_conv) rmc_fat_2022_conv
                     , sum(t.rmc_fat_2023) rmc_fat_2023
                     , sum(t.rmc_fat_2023_conv) rmc_fat_2023_conv
                     , CASE 
                      WHEN sum(rmc_fat_2023) > sum(rmc_fat_2022) THEN
                        round(pck_util_fav.FNC_DIVISOR_ZERO(sum(rmc_fat_2023), sum(rmc_fat_2022))*100,2)
                        else 
                         0
                       END rmc_crescimento
                     , sum(t.fav_fat_2022) fav_fat_2022 
                     , sum(t.fav_fat_2022_conv) fav_fat_2022_conv 
                     , sum(t.fav_fat_2023) fav_fat_2023
                     , sum(t.fav_fat_2023_conv) fav_fat_2023_conv
                     , CASE 
                      WHEN sum(fav_fat_2023) > sum(fav_fat_2022) THEN
                        round(pck_util_fav.FNC_DIVISOR_ZERO(sum(fav_fat_2023), sum(fav_fat_2022))*100,2)
                       else
                         0
                       END fav_crescimento
                FROM roman.VW_FILIAIS vf  
                   , (
                     SELECT f.idfilial
                        , NVL(sum(f.TOTALCOBRANCA+f.TOTALVENDASDIRETAS),0) rmc_fat_2022
                        , NVL(round(sum((f.TOTALCOBRANCA+f.TOTALVENDASDIRETAS)*f.FATORCONVERSAO),2),0) rmc_fat_2022_conv
                        , 0 rmc_fat_2023
                        , 0 rmc_fat_2023_conv
                        , 0 fav_fat_2022
                        , 0 fav_fat_2022_conv
                        , 0 fav_fat_2023
                        , 0 fav_fat_2023_conv
                     FROM roman.FECHAMENTOSSEMANAIS f 
                        , roman.SEMANA_DIAS sd 
                     WHERE sd.IDSEMANA = f.IDSEMANA 
                       AND sd.ANO  = :P74_ANO-1
                       AND sd.SEMANA BETWEEN :P74_SEMANAINI AND :P74_SEMANAFIM
                     GROUP BY f.IDFILIAL 
                     UNION ALL 
                     SELECT f.idfilial
                        , 0 rmc_fat_2022
                        , 0 rmc_fat_2022_conv
                        , NVL(sum(f.TOTALCOBRANCA+f.TOTALVENDASDIRETAS),0) rmc_fat_2023
                        , NVL(round(sum((f.TOTALCOBRANCA+f.TOTALVENDASDIRETAS)*f.FATORCONVERSAO),2),0) rmc_fat_2023_conv
                        , 0 fav_fat_2022
                        , 0 fav_fat_2022_conv
                        , 0 fav_fat_2023
                        , 0 fav_fat_2023_conv
                     FROM roman.FECHAMENTOSSEMANAIS f 
                        , roman.SEMANA_DIAS sd 
                     WHERE sd.IDSEMANA = f.IDSEMANA 
                       AND sd.ANO  = :P74_ANO
                       AND sd.SEMANA BETWEEN :P74_SEMANAINI AND :P74_SEMANAFIM
                     GROUP BY f.IDFILIAL 
                     UNION ALL 
                     SELECT p.IDFILIALROMANCE 
                        , 0 rmc_fat_2022
                        , 0 rmc_fat_2022_conv
                        , 0 rmc_fat_2023
                        , 0 rmc_fat_2023_conv
                        , NVL(sum(v.VALORPAGAR),0) fav_fat_2022
                        , NVL(sum(v.VALORPAGAR*P.FATORCONVERSAO),0) fav_fat_2022_conv
                        , 0 fav_fat_2023
                        , 0 fav_fat_2023_conv
                     FROM PEDIDOS P
                        , VENCIMENTOSPEDIDOS V
                        , roman.SEMANA_DIAS sd2 
                     WHERE P.DATACANCELAMENTO IS NULL 
                       AND P.IDPEDIDO = V.IDPEDIDO
                       AND V.SITUACAOVENCIMENTO = 'V'
                       AND SD2.IDSEMANA = p.IDSEMANAEMISSAO 
                       AND sd2.SEMANA BETWEEN :P74_SEMANAINI AND :P74_SEMANAFIM
                       AND sd2.ANO = :P74_ANO-1
                       AND p.IDSITUACAOENTREGA  >= 20000
                       AND p.TIPOPEDIDO IN ('P','V','T')
                       AND p.VALORAPAGAR  > 0 
                     GROUP BY p.IDFILIALROMANCE 
                     UNION ALL
                     SELECT p.IDFILIALROMANCE 
                        , 0 rmc_fat_2022
                        , 0 rmc_fat_2022_conv
                        , 0 rmc_fat_2023
                        , 0 rmc_fat_2023_conv
                        , 0 fav_fat_2022
                        , 0 fav_fat_2022_conv
                        , NVL(sum(v.VALORPAGAR),0) fav_fat_2023
                        , NVL(sum(v.VALORPAGAR*P.FATORCONVERSAO),0) fav_fat_2023_conv
                     FROM PEDIDOS p 
                        , VENCIMENTOSPEDIDOS V
                        , roman.SEMANA_DIAS sd2 
                     WHERE p.DATACANCELAMENTO IS NULL 
                       AND V.IDPEDIDO = P.IDPEDIDO
                       AND V.SITUACAOVENCIMENTO = 'V'
                       AND SD2.IDSEMANA = p.IDSEMANAEMISSAO 
                       AND sd2.SEMANA BETWEEN :P74_SEMANAINI AND :P74_SEMANAFIM
                       AND sd2.ANO = :P74_ANO
                       AND p.IDSITUACAOENTREGA  >= 20000
                       AND p.TIPOPEDIDO IN ('P','V','T')
                       AND p.VALORAPAGAR  > 0 
                     GROUP BY p.IDFILIALROMANCE 
                     ) T
                WHERE vf.IDFILIAL = t.idfilial(+)
                  AND vf.TIPOFILIAL  = 'D'
                  AND vf.ATIVO = 'S'
                  AND vf.IDGRUPO IS NOT null
                  and :P74_FILTRAR = 'S'
                group by vf.nome
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
