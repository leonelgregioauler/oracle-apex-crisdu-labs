    region representatividade-favorita-x-romance (
        name: Representatividade Favorita x Romance
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , fat_romance.faturado as rmc_faturado
                     , fat_romance.faturado_conv as rmc_faturado_conv
                     , fat_favorita.faturado as fav_faturado
                     , fat_favorita.faturado_conv as fav_faturado_conv
                     , round( favorita.pck_util_fav.FNC_DIVISOR_ZERO(fat_favorita.faturado,fat_romance.faturado) * 100,2) representatividade
                from roman.vw_filiais f
                   , ( select p.idfilialromance idfilial
                            , sum(v.valorpagar) faturado
                            , round(sum(v.valorpagar*p.fatorconversao),2) faturado_conv
                       from favorita.pedidos p
                          , favorita.vencimentospedidos v
                          , roman.semana_dias s
                       where p.idsemanaemissao = s.idsemana
                         and v.idpedido = p.idpedido
                         and v.situacaovencimento = 'V'
                         and s.semana between :P74_SEMANAINI and :P74_SEMANAFIM
                         and p.tipopedido in ('P','T','V')
                         and p.idsituacaoentrega >= 20000
                         and s.ano = :P74_ANO
                         and p.valorapagar > 0
                         and :P74_FILTRAR = 'S'
                       group by p.idfilialromance ) fat_favorita
                   , ( select idfilial
                            , sum(ff.totalcobranca+ff.totalvendasdiretas) faturado
                            , round(sum((ff.totalcobranca+ff.totalvendasdiretas)*ff.fatorconversao),2) faturado_conv
                       from roman.fechamentossemanais ff
                          , roman.semana_dias s
                       where ff.idsemana = s.idsemana
                         and s.semana between :P74_SEMANAINI and :P74_SEMANAFIM
                         and :P74_FILTRAR = 'S'
                         and s.ano = :P74_ANO
                       group by ff.idfilial ) fat_romance
                where f.tipofilial = 'D'
                  and f.idgrupo is not null
                  and f.ativo = 'S'
                  and f.idfilial = fat_romance.idfilial(+)
                  and f.idfilial = fat_favorita.idfilial(+)
                  and :P74_FILTRAR = 'S'
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
