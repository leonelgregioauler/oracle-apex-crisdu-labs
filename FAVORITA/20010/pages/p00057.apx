    pageItem P57_FILIAL (
        type: selectList
        label {
            label: Filial Abastecedora
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomefilialfavorita display_value
                     , idfilialfavorita   return_value
                  from favorita.filiaisfavorita f
                 where f.tipofilial in ('E')
                   and idpais = :P57_IDPAIS
                   and ativo = 'S'
                 order by 1
                
                ```
        }
        cascadingLov {
            parentItems: P57_IDPAIS
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P57_FORNECEDOR (
        type: selectList
        label {
            label: Fornecedor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select upper(p.nomepessoa), f.idfornecedor
                  from fornecedores f, pessoas p
                 where f.idpessoa = p.idpessoa
                   and f.idfornecedor in (select idfornecedor 
                                            from fornecedoresprodutos fp, produtosdetalhados pd, produtos pro
                                           where fp.idproduto = pro.idproduto
                                             and pro.idproduto = pd.idproduto
                                             and pd.descontinuado = 'N')
                 order by 1
                ```
            nullDisplayValue: Todos
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

