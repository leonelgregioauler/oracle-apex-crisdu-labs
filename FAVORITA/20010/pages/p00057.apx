    process atualiza-tabela-temporária (
        name: Atualiza Tabela Temporária
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                 
                 pck_bi_fav.prc_rel_analise_compras (:P57_IDPAIS, :P57_FILIAL, :P57_FORNECEDOR, :P57_DESCONTINUADOS, :P57_VENDAS, :APP_USER, :P57_IDFILIALT2, :P57_IDFILIALT3, :P57_IDFILIALT4, 
                                                     :P57_ED1, :P57_ED2, :P57_ED3, :P57_EDFINAL, :P57_IDFILT2, :P57_IDFILT3, :P57_IDFILT4);
                 :P57_QTD_T2 := 'Qtd.'||:P57_IDFILIALT2;
                 :P57_QTD_T3 := 'Qtd.'||:P57_IDFILIALT3;
                 :P57_QTD_T4 := 'Qtd.'||:P57_IDFILIALT4;
                 :P57_QTDD_T2 := 'Cbt.Desej.'||:P57_IDFILIALT2;
                 :P57_QTDD_T3 := 'Cbt.Desej.'||:P57_IDFILIALT3;
                 :P57_QTDD_T4 := 'Cbt.Desej.'||:P57_IDFILIALT4;
                 :P57_COB_T2 := 'Cbt.'||:P57_IDFILIALT2;
                 :P57_COB_T3 := 'Cbt.'||:P57_IDFILIALT3;
                 :P57_COB_T4 := 'Cbt.'||:P57_IDFILIALT4;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 90976335840526821
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

    process atualizar-a-base (
        name: Atualizar a Base
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  pck_bi_fav.prc_geranecessidadecompra_tabx(null);
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage:
                ```
                Processo concluído com sucesso!
                Aplique os filtros novamente...
                ```
        }
        advanced {
            executionMappingIdentifier: 91002223219205024
        }
        serverSideCondition {
            type: request=Value
            value: ATUALIZABASE
        }
    )

    process dados-da-atualização (
        name: Dados da Atualização
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    select 'Atualizado ' || to_char(max(data_fim),'dd/mm hh24:mi') dados  
                      into :P57_ATUALIZACAO
                      from log_tmp_rel_compras
                     where data_inicio <> data_fim;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 90976717253526821
        }
    )

    process listagem-save-interactive-grid-data (
        name: Listagem - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @listagem
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                begin
                 if :APEX$ROW_STATUS = 'U' then
                     --
                     update tmp_rel_analise_compras
                        set cobertura_desejada = :COBERTURA_DESEJADA
                      where idprodutodetalhado = :IDPRODUTODETALHADO
                        and idfilialfavorita = :IDFILIALFAVORITA
                        and usuario = :APP_USER;
                
                     update tmp_rel_analise_compras
                        set cobertura_desejada = :QTD_DESEJADA_T2
                      where idprodutodetalhado = :IDPRODUTODETALHADO
                        and idfilialfavorita = :P57_IDFILT2
                        and usuario = :APP_USER;
                
                     update tmp_rel_analise_compras
                        set cobertura_desejada = :QTD_DESEJADA_T3
                      where idprodutodetalhado = :IDPRODUTODETALHADO
                        and idfilialfavorita = :P57_IDFILT3
                        and usuario = :APP_USER;
                
                     update tmp_rel_analise_compras
                        set cobertura_desejada = :QTD_DESEJADA_T4
                      where idprodutodetalhado = :IDPRODUTODETALHADO
                        and idfilialfavorita = :P57_IDFILT4
                        and usuario = :APP_USER;
                
                   --
                
                    if :COBERTURA_DESEJADA is null then
                         delete produtoscoberturafilial
                          where idprodutodetalhado = :IDPRODUTODETALHADO
                            and idfilial = :IDFILIALFAVORITA;
                     else
                         update produtoscoberturafilial
                            set coberturadesejada = :COBERTURA_DESEJADA
                          where idprodutodetalhado = :IDPRODUTODETALHADO
                            and idfilial = :IDFILIALFAVORITA;
                         if sql%rowcount = 0 then
                          insert into produtoscoberturafilial
                                      ( idfilial
                                      , idprodutodetalhado
                                      , coberturadesejada)
                               values ( :IDFILIALFAVORITA
                                      , :IDPRODUTODETALHADO
                                      , :COBERTURA_DESEJADA);
                         end if;
                    end if;
                
                    if :QTD_DESEJADA_T2 is null then
                         delete produtoscoberturafilial
                          where idprodutodetalhado = :IDPRODUTODETALHADO
                            and idfilial = :P57_IDFILT2;
                     else
                         update produtoscoberturafilial
                            set coberturadesejada = :QTD_DESEJADA_T2
                          where idprodutodetalhado = :IDPRODUTODETALHADO
                            and idfilial = :P57_IDFILT2;
                         if sql%rowcount = 0 then
                          insert into produtoscoberturafilial
                                      ( idfilial
                                      , idprodutodetalhado
                                      , coberturadesejada)
                               values ( :P57_IDFILT2
                                      , :IDPRODUTODETALHADO
                                      , :QTD_DESEJADA_T2);
                         end if;
                    end if;
                
                    if :QTD_DESEJADA_T3 is null then
                         delete produtoscoberturafilial
                          where idprodutodetalhado = :IDPRODUTODETALHADO
                            and idfilial = :P57_IDFILT3;
                     else
                         update produtoscoberturafilial
