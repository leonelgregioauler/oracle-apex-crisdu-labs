page 57 (
    name: Análise de Compras
    title: Análise de Compras
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region dados-da-análise (
        name: Dados da Análise
        type: staticContent
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        comments {
            comments: Base do relatório gerada através de job chamando a pck_bi_fav.prc_geranecessidadecompra_tabx
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region listagem (
        name: Listagem
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select relatorio.idfornecedor, relatorio.fornecedor
                     , relatorio.tempo_entrega_em_ciclos
                     , relatorio.prioridade  
                     , relatorio.idfilialfavorita
                     , relatorio.idprodutodetalhado
                     , relatorio.qtd_disponivel
                     , relatorio.qtd_ajustada
                     , relatorio.qtd_ed1
                     , relatorio.qtd_ed2
                     , relatorio.qtd_ed3
                     , relatorio.media_atual
                     -- 9303521 - Maicon Aimi - 15/08/2024 - Ajuste no calculo da coluna Venda Considerada
                     --, relatorio.venda_considerada <--  OLD
                     --Verificado que atualmente a coluna da venda considerada faz a soma das 3 colunas de edição (edições 1.1, 1.2 e 1.3). Bruno solicitou que fosse alterado a regra da coluna venda considerada para o seguinte: 
                     --  Se (Ed76.1 * 50%) > (1.1+1.2+1.3) então Ed76.1 * 80%
                     --  Se o valor for menor que 50%, continua a regra já existente hoje que é a soma das 3 colunas de edições (1.1, 1.2 e 1.3).
                     , case 
                         when (relatorio.qtd_ed1 + relatorio.qtd_ed2 + relatorio.qtd_ed3) < (relatorio.qtd_edfinal / 2) then
                           round ((relatorio.qtd_edfinal * 0.8))
                         else
                           relatorio.qtd_ed1 + relatorio.qtd_ed2 + relatorio.qtd_ed3
                       end  venda_considerada
                     -- 9303521 FIM
                     , relatorio.qtd_comprada
                     , relatorio.qtd_transferida
                     , relatorio.qtd_edfinal
                     , relatorio.cobertura_ciclo_atual
                     , relatorio.necessidade_compra_ciclo
                     , relatorio.cobertura_desejada
                     , relatorio.necessidade_compra
                     , relatorio.ciclos_morte
                     , relatorio.qtd_disponivel_t2
                     , relatorio.qtd_desejada_t2
                     , relatorio.cobertura_ciclo_t2
                     , relatorio.qtd_disponivel_t3
                     , relatorio.qtd_desejada_t3
                     , relatorio.cobertura_ciclo_t3
                     , relatorio.qtd_disponivel_t4
                     , relatorio.qtd_desejada_t4
                     , relatorio.cobertura_ciclo_t4
                     , relatorio.usuario
                     , relatorio.id_rel_analise_compras
                     , (select count(distinct k.idkitvenda)
                          from itenskitsvendas ik, kitsvendas k
                         where ik.idkitvenda = k.idkitvenda 
                           and trunc(sysdate) between k.datainicial and k.datafinal
                           and ik.idprodutodetalhado = relatorio.idprodutodetalhado) kits
                     , (select sum(t.disponivel)
                         from FAVORITA.temp_analisenecessidadecomp1 t 
                         where t.idprodutodetalhado         = relatorio.idprodutodetalhado
                           and t.idfilialorigem_abatecedor  = relatorio.idfilialfavorita
                           and t.idfilialfavorita_est      != :P57_FILIAL) qtd_disponivel_lojas
                     -- Criado a coluna edicao_iniciou para atender o ticket 8766474 - Maicon Aimi - 25/04/2024
                     , (select e.nome
                          from favorita.edicoesrevistas e
                         where e.idpais = :P57_IDPAIS
                           and e.idedicaorevista = (select min(d.idedicaorevista)
                                                      from produtosdetedrevistas d
                                                     where d.idedicaorevista not in (63,62,56,121,122)
                                                       and d.idprodutodetalhado = relatorio.idprodutodetalhado
                                                       and exists (select 1 
                                                                     from favorita.edicoesrevistas ee
                                                                    where ee.idedicaorevista = d.idedicaorevista
                                                                      and ee.idpais =:P57_IDPAIS))) edicao_iniciou 
                  from tmp_rel_analise_compras relatorio
                 where usuario = :APP_USER
                   and :P57_FILIAL is not null
                   and ( :P57_IDKITVENDA is null or exists ( select 1
                                                               from itenskitsvendas it
                                                              where it.idkitvenda = :P57_IDKITVENDA
                                                                and it.idprodutodetalhado = relatorio.idprodutodetalhado));
                ```
        }
        layout {
            sequence: 50
            parentRegion: @dados-da-análise
            slot: subRegions
        }
