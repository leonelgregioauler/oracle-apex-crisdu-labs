    region necessidade-de-compra (
        name: Necessidade de Compra
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idfilialorigem_abatecedor
                     , filialorigem_abatecedor
                
                
                     , idfornecedor
                     , idprodutodetalhado
                     , nomeproduto
                     , disponivel              
                     , idcategoria
                     , nomecategoria
                     , descontinuado
                     --  
                     , '|' s1            
                     , ciclo_1
                     , ciclo_2
                     , ciclo_3 
                     , media_anterior   
                     --      
                     , '|' s2       
                     , ciclo_4
                     , ciclo_5
                     , ciclo_6                                         
                     , media_atual 
                     --         
                     , '|' s3  
                     , media_geral
                     --    
                     , '|' s4
                     , comprado        
                     --
                     , '|' s5    
                     , cobertura_ciclo  
                     , lead_transit_time 
                     , necessidadecompraciclo   
                     , necessidade_compra        
                     --
                     , case
                         when cobertura_ciclo < lead_transit_time then
                           1
                         when cobertura_ciclo between lead_transit_time and lead_transit_time+ 1 then
                           2
                         else --when cobertura_ciclo > lead_transit_time + 2 then
                           3
                        -- else
                         --  4
                           end prioridade   
                     , idpais
                     , nomepais     
                from ( select t.idfilialorigem_abatecedor
                             , t.filialorigem_abatecedor
                             , t.idfornecedor
                             , t.idprodutodetalhado
                             , t.nomeproduto
                             , t.disponivel
                             --                    
                             , t.idcategoria
                             , t.nomecategoria
                             , decode(t.descontinuado,'S','Sim') descontinuado
                             --  
                             , t.ciclo_1
                             , t.ciclo_2
                             , t.ciclo_3 
                             , t.media_anterior   
                             --      
                             , t.ciclo_4
                             , t.ciclo_5
                             , t.ciclo_6                                         
                             , t.media_atual 
                             --         
                             , t.media_geral
                             --    
                             , t.comprado        
                             --
                             , case
                                  when t.media_geral > 0 then
                                      round( t.disponivel/t.media_geral,1 )   
                                  end cobertura_ciclo
                             --      
                             , t.lead_transit_time
                             --
                             , case
                                 when ( t.lead_transit_time - case
                                                      when t.media_geral > 0 then
                                                          round( t.disponivel/t.media_geral,1 )   
                                                      end )   + 1     - nvl(t.comprado,0) < 0 then   
                                    0
                                  else
                                    ( t.lead_transit_time - case
                                                      when t.media_geral > 0 then
                                                          round( t.disponivel/t.media_geral,1 )   
                                                      end )   + 1     - nvl(t.comprado,0)
                                  end necessidadecompraciclo
                             ,  case
                                  when round(( t.media_geral *  ( ( t.lead_transit_time - case
                                                                                when t.media_geral > 0 then
                                                                                    round( t.disponivel/t.media_geral,1 )   
                                                                                end )   + 1)  ) - nvl(t.comprado,0) ) < 0 then
                                     0
                                   else
                                     round(( t.media_geral *  ( ( t.lead_transit_time - case
                                                                                when t.media_geral > 0 then
                                                                                    round( t.disponivel/t.media_geral,1 )   
                                                                                end )   + 1)  ) - nvl(t.comprado,0) ) 
                                   end                                                            necessidade_compra    
                              , idpais
                              , nomepais         
                        from ( select idfilialorigem_abatecedor -- t.idfilialfavorita_est
                                    , filialorigem_abatecedor  --t.filialfavorita_est
                                    , t.idfornecedor
                                    , t.idprodutodetalhado       
                                    , t.idcategoria
                                    , t.nomecategoria
                                    , t.descontinuado
                                    , t.nomeproduto
                                    , t.idpais       
                                    , ( select nome
                                        from roman.paises p
                                        where p.idpais = t.idpais ) nomepais    
                                    --
                                    , round( ( select tempoproducao+tempoentrega                   
                                                from favorita.fornecedorestemposentrega ff         
                                                where ff.idfornecedor      = t.idfornecedor                                   
                                                  and ff.idfilialfavorita  = t.idfilialorigem_abatecedor ) /42,1)  lead_transit_time   
                                    --
                                    , (  select round(  sum(quantidadevendida) / count(distinct idcicloedicao) )
                                               from favorita.vw_itensvenda_dia_fav_mv  w                     
                                                  , favorita.ciclosedicoes             c
                                               where w.dataemissao between c.datainicio and c.datafim
                                                 and c.identificacaorelatorio  in ('Ciclo_1','Ciclo_2','Ciclo_3')
                                                 and w.idprodutodetalhado    = t.idprodutodetalhado
                                                 and w.idfilialfavorita_est in ( select a.idfilialfavoritadestino
                                                                                  from favorita.atendimentosestoques a
                                                                                  where a.idfilialfavoritaorigem = t.idfilialorigem_abatecedor )
                                                 
                                                and c.datafim              < sysdate )  media_anterior     
                                    --
                                    , (  select round(  sum(quantidadevendida) / count(distinct idcicloedicao) )
                                               from favorita.vw_itensvenda_dia_fav_mv  w                     
                                                  , favorita.ciclosedicoes             c
                                               where w.dataemissao between c.datainicio and c.datafim
                                                 and c.identificacaorelatorio  in ('Ciclo_4','Ciclo_5','Ciclo_6')
                                                 and w.idprodutodetalhado    = t.idprodutodetalhado
                                                 and w.idfilialfavorita_est in ( select a.idfilialfavoritadestino
                                                                                  from favorita.atendimentosestoques a
                                                                                  where a.idfilialfavoritaorigem = t.idfilialorigem_abatecedor )
                                                 
                                                and c.datafim              < sysdate )  media_atual 
                                    --           
                                    , (  select round(  sum(quantidadevendida) / count(distinct idcicloedicao) )
                                               from favorita.vw_itensvenda_dia_fav_mv  w                     
                                                  , favorita.ciclosedicoes             c
                                               where w.dataemissao between c.datainicio and c.datafim
                                                 and w.idprodutodetalhado    = t.idprodutodetalhado
                                                 and w.idfilialfavorita_est in ( select a.idfilialfavoritadestino
                                                                                  from favorita.atendimentosestoques a
                                                                                  where a.idfilialfavoritaorigem = t.idfilialorigem_abatecedor )
                                                 
                                                and c.datafim              < sysdate ) media_geral
                                    --            
                                    , ( select sum(nvl(ict.quantidadecomprada, 0))
                                          from favorita.itenscomprastransferencias ict
                                             , favorita.comprastransferencias ct
                                          where ict.idcompratransferencia = ct.idcompratransferencia
                                            and ct.idtipocomptransrem     in ( 0,1) --compra e transferencia
                                            and ct.idsituacao             in (10,20,11,30)
                                            and ct.idfilialfavoritadestino = t.idfilialorigem_abatecedor
                                            and ict.idprodutodetalhado    = t.idprodutodetalhado ) comprado    
                
                                    , sum(t.disponivel)    disponivel
                                    , sum(t.ciclo_1   )    ciclo_1
                                    , sum(t.ciclo_2   )    ciclo_2
                                    , sum(t.ciclo_3   )    ciclo_3  
                                    , sum(t.ciclo_4   )    ciclo_4
                                    , sum(t.ciclo_5   )    ciclo_5
                                    , sum(t.ciclo_6   )    ciclo_6   
                                from FAVORITA.temp_analisenecessidadecompras t 
                                where t.idprodutodetalhado = :P56_IDPRODUTODETALHADO   
                                  and idfilialorigem_abatecedor    != :P56_IDFILIALFAVORITA
                                  and t.idpais             = :P56_IDPAIS
                                  --
                                  and t.descontinuado = :P51_DESCONTINUADO
                                  --
                                   --and t.idprodutodetalhado = :P48_IDPRODUTODETALHADO           
                                group by idfilialorigem_abatecedor -- t.idfilialfavorita_est
                                       , filialorigem_abatecedor  --t.filialfavorita_est
                                       , t.idprodutodetalhado       
                                       , t.idcategoria
                                       , t.nomecategoria
                                       , t.descontinuado
                                                           
                                       , t.idfornecedor
                                       
                                       , t.nomeproduto
                                       
                                        , t.idpais       
                             ) t     
                     )
                ```
            pageItemsToSubmit: [
                P56_IDPRODUTODETALHADO
                P56_IDPAIS
                P56_IDFILIALFAVORITA
            ]
        }
