page 18 (
    name: Estoque Atual
    title: Estoque Atual
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util_fav.fnc_verificaacesso(34251,:P0_IDUSUARIO) = 'S'
                ```
        }
    )

    region estoques (
        name: Estoques
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.idfilialfavorita
                     , favorita.pck_util_fav.fnc_nomefilialfavorita(e.idfilialfavorita) nomefilial
                     , produto
                     , produtodetalhado
                     , idcategoria
                     , nome
                     , idcategoriasite
                     , nomecategoria
                     , sum(e.quantidade) quantidade
                     , sum(e.quantidadereservada) quantidadereservada
                     , sum(e.quantidade - e.quantidadereservada) quantidadedisponivel
                     /*, replace(cast( wm_concat ( distinct '<b>'||filialfavorita
                                                               ||'</b><br> <i>Fís/Res: </i> '
                                                               || to_char(quantidade,'999G999G999G999G990') 
                                                               ||'/ '||  to_char(  quantidadereservada,'999G999G999G999G990')
                                                               ||'<br> <i>Est Mín: </i> '
                                                               || to_char( qtdestoqueminimo,'999G999G999G999G990') 
                                                               ||'<br>') as varchar2(4000) ),',','') */
                     , listagg(distinct '<b>'||filialfavorita 
                                             ||'</b><br> <i>Fís/Res: </i> '
                                             || to_char(quantidade,'999G999G999G999G990') 
                                             ||'/ '||  to_char(  quantidadereservada,'999G999G999G999G990')
                                             ||'<br> <i>Est Mín: </i> '
                                             || to_char( qtdestoqueminimo,'999G999G999G999G990') 
                                             ||'<br>' , ',') xxx
                   /*  , ( select replace(cast( wm_concat (   case 
                                                           when ii.quantidadecomprada > 0 then
                                                                '<b>'||pck_util_fav.fnc_nomefilialfavorita( c.idfilialfavoritadestino ) ||'</b>'
                                                                       ||'<br><i> Comp: </i> '||  to_char(  nvl(ii.quantidadecomprada,0),'999G999G999G999G990')
                                                                       ||'<br><i> Emissão: </i>'||c.dataemissao
                                                                       ||'<br><i> Embarque: </i>'||c.dataembarque
                                                                       ||'<br><i> Prev. Entrega: </i> '||c.dataprevisaoentrega||'<br>'
                                                             end) as varchar2(4000)  ),',','') ||'<br>---------------------------------' 
                          from itenscomprastransferencias ii
                             , comprastransferencias c
                          where c.idcompratransferencia = ii.idcompratransferencia
                            and c.idfilialfavoritadestino is not null
                            and c.idsituacao not in (-1,40)
                            and ii.idprodutodetalhado     = e.idprodutodetalhado
                            and (( :P18_IDFILIALFAVORITA is null or c.idfilialfavoritadestino = :P18_IDFILIALFAVORITA )) )  compra */
                     , ( select replace( listagg ( case 
                                                     when ii.quantidadecomprada > 0 then
                                                            '<b>'||pck_util_fav.fnc_nomefilialfavorita( c.idfilialfavoritadestino ) ||'</b>'
                                                                   ||'<br><i> Comp: </i> '||  to_char(  nvl(ii.quantidadecomprada,0),'999G999G999G999G990')
                                                                   ||'<br><i> Emissão: </i>'||c.dataemissao
                                                                   ||'<br><i> Embarque: </i>'||c.dataembarque
                                                                   ||'<br><i> Prev. Entrega: </i> '||c.dataprevisaoentrega||'<br>'
                                                   end  ,',') ,',','') ||'<br>---------------------------------' 
                          from itenscomprastransferencias ii
                             , comprastransferencias c
                          where c.idcompratransferencia = ii.idcompratransferencia
                            and c.idfilialfavoritadestino is not null
                            and c.idsituacao not in (-1,40)
                            and ii.idprodutodetalhado     = e.idprodutodetalhado
                            and (( :P18_IDFILIALFAVORITA is null or c.idfilialfavoritadestino = :P18_IDFILIALFAVORITA )) )  compra
                      --
                     , ( select sum(ii.quantidadecomprada)
                          from itenscomprastransferencias ii
                             , comprastransferencias c
                          where c.idcompratransferencia = ii.idcompratransferencia
                            and c.idfilialfavoritadestino is not null
                            and c.idsituacao not in (-1,40)
                            and ii.idprodutodetalhado     = e.idprodutodetalhado )  quantidadecomprada
                     ,  ((sum(e.quantidade - e.quantidadereservada) * pck_util_fav.prc_buscavalorvende ( pidedicaorevista    => :P18_IDEDICAOREVISTA
                                                         , pidprodutodetalhado => e.idprodutodetalhado
                                                         , pidpais             => :P18_IDPAIS))) ValorPagar
                     , (sum(e.quantidade - e.quantidadereservada) *max(valorcusto)) valorcusto
                     , ( select listagg(favorita.pck_util_fav.fnc_nomepessoa(f.idpessoa),',') within group (order by 1)
                         from catal.fornecedores f 
                            , favorita.fornecedoresprodutos ff
                         where f.idfornecedor = ff.idfornecedor
                           and ff.idproduto = e.idproduto) as Nome_Fornecedor
                     , descontinuado
                     , ( select favorita.pck_util_fav.fnc_nomesubcategoria(pp.idsubcategoria,1)
                         from favorita.produtos pp
                         where pp.idproduto = e.idproduto) subcategoria
                from vw_estoques_fav_bi e
                where ( (:P18_FILIAIS = 'N' and e.idfilialfavorita = :P18_IDFILIALFAVORITA) or
                        (:P18_FILIAIS = 'S' and e.idfilialfavorita in (select idfilialfavorita
                                                                                from favorita.filtrosfiliais ff
                                                                               where ff.idfilialfavorita = e.idfilialfavorita
                                                                                 and ff.idusuario = :P0_IDUSUARIO))  )
                     
                      /*( ( :P18_FILIAIS         = 'S' and exists ( select 1
                                                                  from filtrosfiliais ff
                                                                  where ff.idfilialfavorita = e.idfilialfavorita 
                                                                     and ff.idusuario        = :P0_IDUSUARIO ) )
                     or ( :P18_FILIAIS         = 'N' and  (idfilialfavorita = :P18_IDFILIALFAVORITA ) ) ) */
                     
                  and (:P18_IDCATEGORIA        is null     or idcategoria        = :P18_IDCATEGORIA)
                  and (:P18_IDCATEGORIASITE    is null     or idcategoriasite    = :P18_IDCATEGORIASITE)
                  and (:P18_IDPRODUTODETALHADO is null     or idprodutodetalhado = :P18_IDPRODUTODETALHADO)
                  and (:P18_IDPRODUTO          is null     or idproduto          = :P18_IDPRODUTO)
                  and (:P18_IDFORNECEDOR       is null     or exists ( select 1 
                                                                       from fornecedoresprodutos f
                                                                       where f.idfornecedor = :P18_IDFORNECEDOR
                                                                         and f.idproduto    = e.idproduto ) ) 
                  and ( :P18_IDEDICAOREVISTA   is null     or ( :P18_PRODPOREDICAO = 'S' and e.idprodutodetalhado in ( select pdr.idprodutodetalhado
                                                                                                                       from produtosdetedrevistas pdr
                                                                                                                       where pdr.idedicaorevista = :P18_IDEDICAOREVISTA )) 
                                                           or ( :P18_PRODPOREDICAO = 'N')  )
                  and (:P18_REFERENCIA         = 'N'       or exists ( select 1
                                                                        from filtrosprodutosestoques ff
                                                                        where ff.idproduto = e.idproduto
                                                                          and ff.idusuario = :P0_IDUSUARIO )) 
                  and ididioma = 1
                  and e.ativo = 'S'
                  and :P18_FILTRAR = 'S'
                  --and 1=2
                group by idfilialfavorita
                       , produto
                       , produtodetalhado
                       , idproduto
                       , idprodutodetalhado
                       , idcategoria
                       , nome
                       , idcategoriasite
                       , nomecategoria
                       , descontinuado
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Utilize os Filtros!
        }
        advanced {
            savedReportMappingIdentifier: 3888943044785870941
        }

