        behavior {
            action: redirectThisApp
            target: {
                page: 311
                items: {
                    P311_IDINVENTARIOESTOQUE:
                    P311_IDFILIALFAVORITA: &P18_IDFILIALFAVORITA.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
