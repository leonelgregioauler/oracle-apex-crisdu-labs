    dynamicAction filtrar (
        name: Filtrar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-filiais (
        name: Refresh Filiais
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P18_TIPO_F
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P18_IDFILIALFAVORITA
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo-filtro-filiais (
        name: Tipo Filtro Filiais
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P18_FILIAIS
        }
        clientSideCondition {
            type: item=value
            item: P18_FILIAIS
            value: N
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P18_IDFILIALFAVORITA
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: button
                button: @filtrar-filiais
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P18_IDFILIALFAVORITA
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: button
                button: @filtrar-filiais
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    branch (
        name: Filtrar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 18
                items: {
                    P18_IDFILIALFAVORITA: &P18_IDFILIALFAVORITA.
                    P18_IDPRODUTODETALHADO: &P18_IDPRODUTODETALHADO.
                    P18_IDFORNECEDOR: &P18_IDFORNECEDOR.
                    P18_IDPRODUTO: &P18_IDPRODUTO.
                    P18_FILIAIS: &P18_FILIAIS.
                    P18_REFERENCIA: &P18_REFERENCIA.
                    P18_FILTRAR: S
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

