    region acumulativo-por-franquia (
        name: Acumulativo por Franquia
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome franquia
                     , v1.qtdpedidos qtd_2023
                     , '<b>'||v2.qtdpedidos||'</b>' as qtd_2024
                     , case 
                         when v1.qtdpedidos > 0 then
                           round( (v2.qtdpedidos/v1.qtdpedidos)*100,2)-100
                         else
                           0
                       end qtd_comparativo
                     , '|' s1
                     , nvl(v1.faturado,0) faturado_2023
                     , '<b>'||trim(to_char(nvl(v2.faturado,0),'999G999G999G999G990D00'))||'</b>' faturado_2024
                     , case 
                         when v1.faturado > 0 then
                           round( (v2.faturado/v1.faturado)*100,2)-100
                         else
                           0
                       end faturado_comparativo
                     , '|' s2
                     , nvl(v1.ticke_medio,0) tm_2023
                     , '<b>'||trim(to_char(nvl(v2.ticke_medio,0),'999G999G999G999G990D00'))||'</b>' tm_2024
                     , case 
                         when v1.ticke_medio > 0 then
                           round( (v2.ticke_medio/v1.ticke_medio)*100,2)-100
                         else
                           0
                       end tm_comparativo
                     , f.idfilial
                from roman.vw_filiais f
                   , ( select w.idfilialromance
                            , sum(w.qtdfavorita) qtdpedidos
                            , round(sum(nvl(w.valorapagarfavorita, 0) * w.fatorconversao),2)  faturado
                            , round(sum(nvl(w.valorapagarfavorita, 0) * w.fatorconversao) / sum(qtdfavorita),2) ticke_medio
                       from vw_rank_pedidos_agrp_m w
                       where extract(year from w.dataemissao) = extract(year from sysdate)-1
                         and trunc(w.dataemissao) < add_months(trunc(sysdate),-12)
                       group by w.idfilialromance ) v1
                   , ( select w.idfilialromance
                            , sum(w.qtdfavorita) qtdpedidos
                            , round(sum(nvl(w.valorapagarfavorita, 0) * w.fatorconversao),2)  faturado
                            , round(sum(nvl(w.valorapagarfavorita, 0) * w.fatorconversao) / sum(qtdfavorita),2) ticke_medio
                       from vw_rank_pedidos_agrp_m w
                       where extract(year from w.dataemissao) = extract(year from sysdate)
                       group by w.idfilialromance ) v2
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                  and f.idgrupo is not null
                  and f.ididioma in (1,2,4)
                  and f.idfilial = v1.idfilialromance(+)
                  and f.idfilial = v2.idfilialromance(+)
                ------------------------------------------------------
                union
                ------------------------------------------------------
                select 'Z- Total -Z'     
                     , sum(v1.qtdpedidos) qtd_2023
                     , '<b>'||sum(v2.qtdpedidos)||'</b>' as qtd_2024
                     , case 
                         when sum(v1.qtdpedidos) > 0 then
                           round( (sum(v2.qtdpedidos)/sum(v1.qtdpedidos))*100,2)-100
                         else
                           100
                       end qtd_comparativo
                     , '|' s1
                     , nvl(sum(v1.faturado),0) faturado_2023
                     , '<b>'||trim(to_char(nvl(sum(v2.faturado),0),'999G999G999G999G990D00'))||'</b>' faturado_2024
                     , case 
                         when sum(v1.faturado) > 0 then
                           round( (sum(v2.faturado)/sum(v1.faturado))*100,2)-100
                         else
                           100
                       end faturado_comparativo
                     , '|' s2
                     , round(sum(v1.faturado)/sum(v1.qtdpedidos),2) tm_2023
                     , '<b>'||trim(to_char(round(sum(v2.faturado)/sum(v2.qtdpedidos),2), '999G999G999G999G990D00'))||'</b>' tm_2024
                     , round((sum(v2.faturado)/sum(v2.qtdpedidos)/sum(v1.faturado)/sum(v1.qtdpedidos))*100,2)-100 tm_comparativo
                     , -1
                from roman.vw_filiais f
                   , ( select w.idfilialromance
                            , sum(w.qtdfavorita) qtdpedidos
                            , round(sum(nvl(w.valorapagarfavorita, 0) * w.fatorconversao),2)  faturado
                       from vw_rank_pedidos_agrp_m w
                       where extract(year from w.dataemissao) = extract(year from sysdate)-1
                         and trunc(w.dataemissao) < add_months(trunc(sysdate),-12)
                       group by w.idfilialromance ) v1
                   , ( select w.idfilialromance
                            , sum(w.qtdfavorita) qtdpedidos
                            , round(sum(nvl(w.valorapagarfavorita, 0) * w.fatorconversao),2)  faturado
                       from vw_rank_pedidos_agrp_m w
                       where extract(year from w.dataemissao) = extract(year from sysdate)
                       group by w.idfilialromance ) v2
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                  and f.idgrupo is not null
                  and f.ididioma in (1,2,4)
                  and f.idfilial = v1.idfilialromance(+)
                  and f.idfilial = v2.idfilialromance(+)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
