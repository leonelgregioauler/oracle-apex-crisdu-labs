    region acumulativo-por-distribuidor (
        name: Acumulativo por Distribuidor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(r.idrepresentante) distribuidor
                     , nvl(v1.qtdpedidos,0) qtd_2023
                     , nvl(v2.qtdpedidos,0) qtd_2024
                     , case 
                         when v1.qtdpedidos > 0 then
                           round( (v2.qtdpedidos/v1.qtdpedidos)*100,2)-100
                         when v2.qtdpedidos = 0 then
                           0
                         else
                           0
                       end qtd_comparativo
                     , '|' s1
                     , nvl(v1.valorpagar,0) vlrtotal_2023
                     , nvl(v2.valorpagar,0) vlrtotal_2024
                     , case 
                         when v1.valorpagar > 0 then
                           round( (v2.valorpagar/v1.valorpagar)*100,2)-100
                         when v2.valorpagar = 0 then
                           0
                         else
                           0
                       end vlr_comparativo
                     , '|' s2
                     , nvl(round( (v1.valorpagar/v1.qtdpedidos),2),0) tm_2023
                     , nvl(round( (v2.valorpagar/v2.qtdpedidos),2),0) tm_2024
                     , case 
                         when round( (v1.valorpagar/v1.qtdpedidos),2) > 0 then
                           round( (round( (v2.valorpagar/v2.qtdpedidos),2)/round( (v1.valorpagar/v1.qtdpedidos),2))*100,2)-100
                         else
                           0
                       end tm_comparativo
                     , '|' s3
                     , tipo.call call_center
                     , tipo.site site
                     , (tipo.loja+tipo.delivery) loja
                     , tipo.vendadireta venda_direta
                from representantes r
                   , ( select rd.idrepresentante
                            , sum(rd.qtdfavorita) qtdpedidos
                            , round(sum(rd.valorapagar*rd.fatorconversao),2) valorpagar
                       from vw_rank_pedidos_dist_m rd
                       where extract(year from rd.dataemissao) = extract(year from sysdate)-1
                         and trunc(rd.dataemissao) < add_months(trunc(sysdate),-12)
                         and :P78_IDFILIAL is not null
                       group by rd.idrepresentante ) v1
                   , ( select rd.idrepresentante
                            , sum(rd.qtdfavorita) qtdpedidos
                            , round(sum(rd.valorapagar*rd.fatorconversao),2) valorpagar
                       from vw_rank_pedidos_dist_m rd
                       where extract(year from rd.dataemissao) = extract(year from sysdate)
                         and :P78_IDFILIAL is not null
                       group by rd.idrepresentante ) v2
                   , ( select t.idrepresentante
                            , sum(loja) loja
                            , sum(vendadireta) vendadireta
                            , sum(site) site
                            , sum(call) call
                            , sum(delivery) delivery
                       from ( select rd.idrepresentante
                                   , decode(ff.tipofilial,'L',round(rd.valorapagar*rd.fatorconversao,2),0) loja
                                   , decode(ff.tipofilial,'V',round(rd.valorapagar*rd.fatorconversao,2),0) vendadireta
                                   , decode(ff.tipofilial,'S',round(rd.valorapagar*rd.fatorconversao,2),0) site
                                   , decode(ff.tipofilial,'C',round(rd.valorapagar*rd.fatorconversao,2),0) call
                                   , decode(ff.tipofilial,'E',round(rd.valorapagar*rd.fatorconversao,2),0) delivery
                              from filiaisfavorita ff
                                 , vw_rank_pedidos_dist_m rd
                              where rd.idfilialfavorita = ff.idfilialfavorita
                                and :P78_IDFILIAL is not null
                                and extract(year from rd.dataemissao) = extract(year from sysdate) ) t
                       group by t.idrepresentante ) tipo
                where roman.pck_romance.fnc_filialrepresentante(r.idrepresentante) = :P78_IDFILIAL
                  and :P78_IDFILIAL is not null
                  --and r.ativo = 'S'
                  and r.idrepresentante = v2.idrepresentante(+)
                  and r.idrepresentante = v1.idrepresentante(+)
                  and r.idrepresentante = tipo.idrepresentante(+)
                ------------------------------------------------------
                union
                ------------------------------------------------------
                select 'Z- Total -Z'
                     , nvl(sum(v1.qtdpedidos),0) qtd_2023
                     , nvl(sum(v2.qtdpedidos),0) qtd_2024
                     , case 
                         when sum(v1.qtdpedidos) > 0 then
                           round( (sum(v2.qtdpedidos)/sum(v1.qtdpedidos))*100,2)-100
                         else
                           100
                       end qtd_comparativo
                     , '|' s1
                     , nvl(sum(v1.valorpagar),0) vlrtotal_2023
                     , nvl(sum(v2.valorpagar),0) vlrtotal_2024
                     , case 
                         when sum(v1.valorpagar) > 0 then
                           round( (sum(v2.valorpagar)/sum(v1.valorpagar))*100,2)-100
                         else
                           100
                       end vlr_comparativo
                     , '|' s2
                     , nvl(round( (sum(v1.valorpagar/v1.qtdpedidos)),2),0) tm_2023
                     , nvl(round( (sum(v2.valorpagar/v2.qtdpedidos)),2),0) tm_2024
                     , case 
                         when round( (sum(v1.valorpagar)/sum(v1.qtdpedidos)),2) > 0 then
                           round( (round( (sum(v2.valorpagar)/sum(v2.qtdpedidos)),2)/round( (sum(v1.valorpagar)/sum(v1.qtdpedidos)),2))*100,2)-100
                         else
                           100
                       end tm_comparativo
                     , '|' s3
                     , sum(tipo.call) call_center
                     , sum(tipo.site) site
                     , (sum(tipo.loja)+sum(tipo.delivery)) loja
                     , sum(tipo.vendadireta) venda_direta
                from representantes r
                   , ( select rd.idrepresentante
                            , sum(rd.qtdfavorita) qtdpedidos
                            , round(sum(rd.valorapagar*rd.fatorconversao),2) valorpagar
                       from vw_rank_pedidos_dist_m rd
                       where extract(year from rd.dataemissao) = extract(year from sysdate)-1
                         and trunc(rd.dataemissao) < add_months(trunc(sysdate),-12)
                         and :P78_IDFILIAL is not null
                       group by rd.idrepresentante ) v1
                   , ( select rd.idrepresentante
                            , sum(rd.qtdfavorita) qtdpedidos
                            , round(sum(rd.valorapagar*rd.fatorconversao),2) valorpagar
                       from vw_rank_pedidos_dist_m rd
                       where extract(year from rd.dataemissao) = extract(year from sysdate)
                         and :P78_IDFILIAL is not null
                       group by rd.idrepresentante ) v2
                   , ( select t.idrepresentante
                            , sum(loja) loja
                            , sum(vendadireta) vendadireta
                            , sum(site) site
                            , sum(call) call
                            , sum(delivery) delivery
                       from ( select rd.idrepresentante
                                   , decode(ff.tipofilial,'L',round(rd.valorapagar*rd.fatorconversao,2),0) loja
                                   , decode(ff.tipofilial,'V',round(rd.valorapagar*rd.fatorconversao,2),0) vendadireta
                                   , decode(ff.tipofilial,'S',round(rd.valorapagar*rd.fatorconversao,2),0) site
                                   , decode(ff.tipofilial,'C',round(rd.valorapagar*rd.fatorconversao,2),0) call
                                   , decode(ff.tipofilial,'E',round(rd.valorapagar*rd.fatorconversao,2),0) delivery
                              from filiaisfavorita ff
                                 , vw_rank_pedidos_dist_m rd
                              where rd.idfilialfavorita = ff.idfilialfavorita
                                and :P78_IDFILIAL is not null
                                and extract(year from rd.dataemissao) = extract(year from sysdate) ) t
                       group by t.idrepresentante ) tipo
                where roman.pck_romance.fnc_filialrepresentante(r.idrepresentante) = :P78_IDFILIAL
                  and :P78_IDFILIAL is not null
                  --and r.ativo = 'S'
                  and r.idrepresentante = v2.idrepresentante(+)
                  and r.idrepresentante = v1.idrepresentante(+)
                  and r.idrepresentante = tipo.idrepresentante(+)
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado, verifique a Franquia escolhida.
        }
        advanced {
            savedReportMappingIdentifier: 6107769832217437907
        }

