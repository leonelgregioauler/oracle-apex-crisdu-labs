    region legendas (
        name: Legendas
        type: staticContent
        source {
            htmlCode:
                ```html
                <font color="Blue"><h3>Acumulativo por Franquia</h3></font>
                <br> <b> - Dados do ano anterior são sempre do dia 01/01 até D-1 do ano anterior</b>
                <br> <b> - Dados do ano atual são sempre do dia 01/01 até D-1</b>
                <br> <b> - Dados de Faturamento usa valores a pagar (valor com desconto da empreendedora) valores de acordo com tela 257</b>
                <br> <b> - Dados de Faturamento por Canal de Venda são apenas do ano atual</b>
                <br> <b> - Ao clicar no nome da Franquia, irá abrir o Acumulativo dos distribuidores da Franquia</b>
                
                <br><br><font color="green"><h3>Acumulativo por Distribuidor</h3></font>
                <br> <b> - Mostra apenas Distribuidores ATIVOS, desde que o mesmo for inativado no sistema</b>
                <br> <b> - Dados do ano anterior são sempre do dia 01/01 até D-1 do ano anterior</b>
                <br> <b> - Dados do ano atual são sempre do dia 01/01 até D-1</b>
                <br> <b> - Dados de Faturamento usa valores a pagar (valor com desconto da empreendedora) valores de acordo com tela 257</b>
                <br> <b> - Dados de Faturamento por Canal de Venda são apenas do ano atual</b>
                
                <br><br><b>IDENTIFICAÇÃO DAS CORES:</b>
                <br><font color="green">Verde = Representa um percentual POSITIVO</font>
                <br><font color="red">Vermelho = Representa um percentual NEGATIVO</font>
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P78_IDFILIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @acumulativo-por-distribuidor
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

