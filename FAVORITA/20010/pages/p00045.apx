page 45 (
    name: Relatório Gerencial de Compras
    title: Relatório Gerencial de Compras
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region espaçamento (
        name: Espaçamento
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region filtros (
        name: FILTROS
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region relatório-gerencial-de-compras (
        name: Relatório Gerencial de Compras
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idanalisecompra                    
                     , idusuario     
                     , nomeusuario
                     , idedicao        
                     , numeroedicao    
                     , idfilialfavorita   
                     , nomefilial
                     , datacriado                         
                from vw_analisecompras_fav2 a
                where ( :P45_IDANALISECOMPRA is null or a.idanalisecompra =  :P45_IDANALISECOMPRA)
                  and ((:P45_DATAINICIO is null and :P45_DATAFIM is null) or (trunc(a.datacriado) between :P45_DATAINICIO and :P45_DATAFIM ))
                  and ( :P45_IDUSUARIO is null or a.idusuario =  :P45_IDUSUARIO)
                  and ( :P45_IDFILIALFAVORITA is null or a.idfilialfavorita =  :P45_IDFILIALFAVORITA);
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        performance {
            maxRowsToProcess: 1000
        }

        column DATACRIADO (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Data Criado
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
        )

        column IDANALISECOMPRA (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            link {
                target: {
                    page: 46
                    items: {
                        P46_IDANALISECOMPRA: #IDANALISECOMPRA#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
        )

        column IDEDICAO (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

        column IDFILIALFAVORITA (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 4
            }
        )

        column IDUSUARIO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column NOMEFILIAL (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Filial Favorita
                alignment: center
            }
            layout {
                sequence: 7
            }
        )

        column NOMEUSUARIO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Usuário
                alignment: center
            }
            layout {
                sequence: 8
            }
        )

        column NUMEROEDICAO (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Edição
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: center
            }
        )

    )

    pageItem P45_DATAFIM (
        type: datePickerJquery
        label {
            label: Data final
            alignment: left
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P45_DATAINICIO (
        type: datePickerJquery
        label {
            label: Data inicial
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P45_IDANALISECOMPRA (
        type: hidden
        layout {
            sequence: 10
            region: @relatório-gerencial-de-compras
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P45_IDFILIALFAVORITA (
        type: plugin/select
        label {
            label: Filial Favorita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nomefilialfavorita showvalue
                     , f.idfilialfavorita returnvalue
                from favorita.filiaisfavorita f
                   , favorita.analisecompras a
                where f.idfilialfavorita = a.idfilialfavorita
                ```
            displayExtraValues: false
            nullDisplayValue: " - Todos -"
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P45_IDUSUARIO (
        type: plugin/select
        label {
            label: Usuário
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select u.usuario showvalue
                     , u.idusuario returnvalue
                from usuarios u
                   , favorita.analisecompras a
                where u.idusuario = a.idusuario
                ```
            displayExtraValues: false
            nullDisplayValue: " - Todos -"
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconRight
                t-Button--stretch
            ]
            icon: fa-filter
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconRight
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 46
                items: {
                    P46_IDANALISECOMPRA:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

