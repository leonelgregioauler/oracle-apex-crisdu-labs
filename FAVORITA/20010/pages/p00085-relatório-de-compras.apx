            staticValue: N
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Aplicar Filtros
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
                t-Button--stretch
                t-Button--gapTop
            ]
            icon: fa-filter
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process atualiza-tabela-temporaria (
        name: Atualiza Tabela Temporaria
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    
                    /* Atualiza dados de compra na tabela temparária*/
                    favorita.pck_bi_fav.prc_rel_analise_compras_novo(p_idpais               => :P85_IDPAIS,
                                                                     p_idfilial             => :P85_FILIAL,
                                                                     p_idfornecedor         => :P85_FORNECEDOR,
                                                                     p_produtodescontinuado => :P85_DESCONTINUADOS,
                                                                     p_usuario              => v('APP_USER'));
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 370054726917365501
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

