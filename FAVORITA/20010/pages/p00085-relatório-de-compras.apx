    pageItem P85_DESCONTINUADOS (
        type: selectList
        label {
            label: Produtos Descontinuados
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Incluir Produtos com Morte Programada;S,Apenas Produtos Sem Morte Programada;N
            displayExtraValues: false
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P85_FILIAL (
        type: selectList
        label {
            label: Filial Abastecedora
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomefilialfavorita display_value
                     , idfilialfavorita   return_value
                  from favorita.filiaisfavorita f
                 where f.tipofilial in ('E')
                   and idpais = :P85_IDPAIS
                   and ativo = 'S'
                 order by 1
                
                ```
        }
        cascadingLov {
            parentItems: P85_IDPAIS
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P85_FORNECEDOR (
        type: selectList
        label {
            label: Fornecedor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select upper(p.nomepessoa), f.idfornecedor
                  from fornecedores f, pessoas p
                 where f.idpessoa = p.idpessoa
                   and f.idfornecedor in (select idfornecedor 
                                            from fornecedoresprodutos fp, produtosdetalhados pd, produtos pro
                                           where fp.idproduto = pro.idproduto
                                             and pro.idproduto = pd.idproduto
                                             and pd.descontinuado = 'N')
                 order by 1
                ```
            nullDisplayValue: Todos
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P85_IDKITVENDA (
        type: selectList
        label {
            label: Kit de Venda
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select k.referencia||' - '||k.descricao d
                     , k.idkitvenda r
                from kitsvendas k
                where trunc(sysdate) between k.datainicial and k.datafinal
                order by 1
                ```
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P85_IDPAIS (
        type: selectList
        label {
            label: País
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome, idpais
                  from roman.paises
                 where idpais in (
                                  select idpais
                                    from edicoesrevistas
                                   where sysdate between datainicial and datafinal
                                     and tipovenda = 'R')
                 order by 1
                
                ```
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P85_VENDAS (
        type: selectList
        label {
            label: Apenas Produtos Com Venda
            alignment: left
        }
        lov {
            type: staticValues
