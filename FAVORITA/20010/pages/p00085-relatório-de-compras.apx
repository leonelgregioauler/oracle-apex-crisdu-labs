        advanced {
            regionDisplaySelector: true
        }
    )

    region relatório-de-compras (
        name: Relatório de Compras
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select tmp.idfilialfavorita
                     , tmp.idprodutodetalhado
                     , tmp.idfilialAtende
                     , tmp.fornecedor
                     , tmp.dataliberadovenda
                     , tmp.morte_programada
                     , tmp.prioridade
                     , tmp.qtd_disponivel
                     , tmp.qtd_disponivel_loja
                     , tmp.lt_tt
                     , tmp.qtd_sem1
                     , tmp.qtd_sem2
                     , tmp.qtd_sem3
                     , tmp.qtd_sem4
                     , tmp.qtd_sem5
                     , tmp.qtd_sem6
                     , tmp.comprado
                     , tmp.transferido
                     , tmp.media_semanal    
                     , tmp.cobertura_ciclos
                     , tmp.cobertura_outroCD
                     , tmp.qtd_outroCD
                     , favorita.pck_util_fav.fnc_nomeprodutodetalhado(tmp.idprodutodetalhado, nvl(:P0_IDIDIOMA,1)) as "Produto Detalhado"
                     , CASE WHEN UPPER(tag.tagsproduto) LIKE 'CONTINUADO%' THEN 'Sim' ELSE 'Não' END AS "Continuado"
                  from favorita.tmp_rel_analise_compras_novo tmp
                  left join favorita.vw_estoques_fav_bi_val tag on tmp.idprodutodetalhado = tag.idprodutodetalhado and tmp.idfilialfavorita = tag.idfilialfavorita
                 where tmp.usuario = v('APP_USER')
                   and tmp.idfilialfavorita = :P85_FILIAL;   
                ```
        }
        layout {
            sequence: 10
            slot: body
            columnCssClasses: emp
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        accessibility {
            landmarkLabel: AAAAAAAAAAAAA
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 118401225140010739
        }

