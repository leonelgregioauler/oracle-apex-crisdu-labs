page 85 (
    name: Relatório de Compras
    alias: RELATÓRIO-DE-COMPRAS
    title: Relatório de Compras
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
              $(".emp td[headers=prioridade]").each(function(){
            		celldata= $(this).text();
            		if (celldata == 1) {
            		    $(this).parent().children().css('background-color','yellow');
                    }
                    if (celldata == 2) {
            		    $(this).parent().children().css('background-color','LightGreen');
                    }
            
                    if (celldata == 3) {
            		    $(this).parent().children().css('background-color','lightblue');
                    }
            	});
            ```
    }
    css {
        inline:
            ```css
            /*cor de fundo cabeçalho da grid*/
            #INTGRID .a-IRR-table tr th {
                background: #e4d9ed !important;
            }
            /*cor da fonte do cabeçalho da grid*/
            #INTGRID .a-IRR-table tr th a {
                color: black !important;
            }
            /*cor dos dados da grid*/
            /*#INTGRID .a-IRR-table tr td {
                background: pink !important;
                color: green !important;
            } */
            /*cor da fonte da grid*/
            #INTGRID .a-IRR-table tr td a {
                color: #3f0d06 !important;
            }
            ```
    }

