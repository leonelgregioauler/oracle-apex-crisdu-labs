page 62 (
    name: Lista de Recontatos em Em Atraso
    title: Lista de Recontatos em Em Atraso
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            if ($(".t-Body-actionsContent").attr("style") == 'visibility: inherit;') {
            	$("#t_Button_rightControlButton").click();
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent14
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region lista-de-recontatos-em-em-atraso (
        name: Lista de Recontatos em Em Atraso
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region relatório (
        name: Relatório
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idtarefa, nome, cliente, data_proximo_resgate, data_ultimo_resgate, status
                  from beeunified.vw_tarefas_recontato_atrasado
                 where cobranca = 0
                   and (:P62_IDTIPOTAREFA is null or idtipotarefa = :P62_IDTIPOTAREFA)
                 order by data_proximo_resgate desc
                ```
        }
        layout {
            sequence: 20
            parentRegion: @lista-de-recontatos-em-em-atraso
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 5211148136122261528
        }

        column CLIENTE (
            type: plainText
            heading {
                heading: Cliente
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column DATA_PROXIMO_RESGATE (
            type: plainText
            heading {
                heading: Próximo Atendimento
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: dd/mm/rrrr hh24:mi
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column DATA_ULTIMO_RESGATE (
            type: plainText
            heading {
                heading: Último Atendimento
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            appearance {
                formatMask: dd/mm/rrrr hh24:mi
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        column IDTAREFA (
            type: plainText
            heading {
                heading: Nº da Tarefa
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column NOME (
            type: plainText
            heading {
                heading: Tipo de Tarefa
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 52125941 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CLIENTE (
                sequence: 3
            )

            displayColumn DATA_PROXIMO_RESGATE (
                sequence: 4
            )

            displayColumn DATA_ULTIMO_RESGATE (
                sequence: 5
            )

            displayColumn IDTAREFA (
                sequence: 1
            )

            displayColumn NOME (
                sequence: 2
            )

            displayColumn STATUS (
                sequence: 6
            )

        )

    )

    pageItem P62_IDTIPOTAREFA (
        type: selectList
        label {
            label: Tipo de Tarefa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct nome, idtipotarefa 
                  from beeunified.vw_tarefas_recontato_atrasado
                 where cobranca = 0
                 order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: TODAS
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: Filtrar
        label: Atualizar
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: Voltar
        label: Voltar
        layout {
            sequence: 20
            region: @lista-de-recontatos-em-em-atraso
            slot: copy
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--simple
                t-Button--iconLeft
            ]
            icon: fa-arrow-circle-o-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 61
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

