    region notas-com-40-manualmente (
        name: Notas com 40% Manualmente
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(nv.idrepresentante) distribuidor
                     , roman.pck_romance.fnc_nomevendedora(nv.idvendedora) consultora
                     , nv.numeronota 
                     , nv.dataacerto 
                     , nv.valortotalnota
                     , nv.valortotalvenda
                     , nv.valorpago
                     , nv.saldo
                     , ( nv.valorcomissao - ( nv.valorcomissao * 0.9 ) ) diferenca
                from roman.notasvendas nv
                where nv.idsemanacobranca between :P64_IDSEMANA and :P64_IDSEMANA_FIM
                  and nv.idfilial = :P64_IDFILIAL
                  and nv.idsituacaonotavenda = 4
                  and nv.perccomissao = 40
                  and not exists ( select 1
                                   from pedidos p
                                   where p.idnotavenda = nv.idnotavenda )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
