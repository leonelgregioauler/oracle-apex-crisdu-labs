page 64 (
    name: Notas com 40%
    title: Notas com 40%
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region itens (
        name: Itens
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region notas-com-40-com-pedido (
        name: Notas com 40% com Pedido
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(nv.idrepresentante) distribuidor
                     , roman.pck_romance.fnc_nomevendedora(nv.idvendedora) consultora
                     , nv.numeronota 
                     , nv.dataacerto 
                     , nv.valortotalnota
                     , nv.valortotalvenda
                     , nv.valorpago
                     , nv.saldo
                     , p.idpedido nrpedido
                     , p.valorapagar valorapagar
                from roman.notasvendas nv
                   , pedidos p
                where nv.idsemanacobranca between :P64_IDSEMANA and :P64_IDSEMANA_FIM
                  and nv.idfilial = :P64_IDFILIAL
                  and nv.idsituacaonotavenda = 4
                  and nv.perccomissao = 40
                  and p.idnotavenda = nv.idnotavenda 
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P64_TIPO
            value: Com Pedido
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 5273690855125101846
        }

