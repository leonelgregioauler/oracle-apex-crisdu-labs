    pageItem P61_DATA_LIGACAO (
        type: hidden
        layout {
            sequence: 10
            region: @data-de-última-ligação
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select 'Última Ligação Registrada: ' || to_char(data_ligacao,'dd/mm/rrrr hh24:mi:ss') data_ligacao
                   from beedialer.registro_ultima_ligacao
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button data-ligacao (
        buttonName: DATA_LIGACAO
        label: &P61_DATA_LIGACAO.
        layout {
            sequence: 10
            region: @tarefas-novas-aguardando-atendimento
            slot: copy
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--noUI
                t-Button--padTop
                t-Button--padBottom
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction atualiza-data (
        name: Atualiza Data
        execution {
            sequence: 20
        }
        when {
            event: apexbeforerefresh
            selectionType: region
            region: @tarefas-novas-aguardando-atendimento
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var label = document.getElementById('P61_DATA_LIGACAO').value;
                    //var nome_btn = $(".lto5224952172976741824_0 .t-Button-label");
                    //nome_btn.text(label);
                    $('.lto5224952172976741824_0').html(label); 
                    ```
            }
            execution {
                sequence: 30
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select 'Última Ligação Registrada: ' || to_char(data_ligacao,'dd/mm/rrrr hh24:mi:ss') data_ligacao
                       from beedialer.registro_ultima_ligacao
                    ```
            }
            affectedElements {
                selectionType: items
                items: P61_DATA_LIGACAO
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction atualiza-lista-de-recontatos (
        name: Atualiza Lista de Recontatos
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P61_IDTIPOTAREFA
        }
    )

)

