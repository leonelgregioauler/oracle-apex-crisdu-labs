        series aguardando-atendimento (
            name: Aguardando Atendimento
            execution {
                sequence: 20
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nome, sum(aguardando) aguardando, sum(recontato_atrasado) recontato_atrasado, sum(recontato_futuro) recontato_futuro, sum(em_atendimento) em_atendimento 
                         , 'f?p=&APP_ID.:62:&SESSION.::NO::P62_IDTIPOTAREFA:' || idtipotarefa link
                      from (
                            select nome, qtde recontato_futuro, atrasados recontato_atrasado, 0 aguardando, 0 em_atendimento, idtipotarefa
                              from beeunified.vw_tarefas_recontato
                             where cobranca = 0
                             union all
                            select nome, 0 recontato_futuro, 0 recontato_atrasado, qtde aguardando, 0 em_atendimento, idtipotarefa
                              from beeunified.vw_tarefas_aguardando
                             where cobranca = 0
                             union all
                            select nome, 0 recontato_futuro, 0 recontato_atrasado, 0 aguardando, qtde em_atendimento, idtipotarefa
                              from beeunified.vw_tarefas_em_atendimento
                             where cobranca = 0
                           )
                     group by nome, idtipotarefa
                     order by nome
                    ```
            }
            columnMapping {
                label: NOME
                value: AGUARDANDO
            }
            appearance {
                color: #F5B803
            }
        )

        series em-atendimento (
            name: Em Atendimento
            execution {
                sequence: 40
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nome, sum(aguardando) aguardando, sum(recontato_atrasado) recontato_atrasado, sum(recontato_futuro) recontato_futuro, sum(em_atendimento) em_atendimento 
                         , 'f?p=&APP_ID.:62:&SESSION.::NO::P62_IDTIPOTAREFA:' || idtipotarefa link
                      from (
                            select nome, qtde recontato_futuro, atrasados recontato_atrasado, 0 aguardando, 0 em_atendimento, idtipotarefa
                              from beeunified.vw_tarefas_recontato
                             where cobranca = 0
                             union all
                            select nome, 0 recontato_futuro, 0 recontato_atrasado, qtde aguardando, 0 em_atendimento, idtipotarefa
                              from beeunified.vw_tarefas_aguardando
                             where cobranca = 0
                             union all
                            select nome, 0 recontato_futuro, 0 recontato_atrasado, 0 aguardando, qtde em_atendimento, idtipotarefa
                              from beeunified.vw_tarefas_em_atendimento
                             where cobranca = 0
                           )
                     group by nome, idtipotarefa
                     order by nome
                    ```
            }
            columnMapping {
                label: NOME
                value: EM_ATENDIMENTO
            }
            appearance {
                color: #66C1F2
            }
        )

        series recontato-em-atraso (
            name: Recontato em Atraso
            execution {
                sequence: 30
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nome, sum(aguardando) aguardando, sum(recontato_atrasado) recontato_atrasado, sum(recontato_futuro) recontato_futuro, sum(em_atendimento) em_atendimento 
                         , 'f?p=&APP_ID.:62:&SESSION.::NO::P62_IDTIPOTAREFA:' || idtipotarefa link
                      from (
                            select nome, qtde recontato_futuro, atrasados recontato_atrasado, 0 aguardando, 0 em_atendimento, idtipotarefa
                              from beeunified.vw_tarefas_recontato
                             where cobranca = 0
                             union all
                            select nome, 0 recontato_futuro, 0 recontato_atrasado, qtde aguardando, 0 em_atendimento, idtipotarefa
                              from beeunified.vw_tarefas_aguardando
                             where cobranca = 0
                             union all
                            select nome, 0 recontato_futuro, 0 recontato_atrasado, 0 aguardando, qtde em_atendimento, idtipotarefa
                              from beeunified.vw_tarefas_em_atendimento
                             where cobranca = 0
                           )
                     group by nome, idtipotarefa
                     order by nome
                    ```
            }
            columnMapping {
                label: NOME
                value: RECONTATO_ATRASADO
            }
            appearance {
                color: #DB7272
            }
            link {
                type: redirectUrl
                targetUrl: #LINK#
            }
        )

        series recontato-futuro (
            name: Recontato Futuro
            execution {
                sequence: 50
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nome, sum(aguardando) aguardando, sum(recontato_atrasado) recontato_atrasado, sum(recontato_futuro) recontato_futuro, sum(em_atendimento) em_atendimento 
                         , 'f?p=&APP_ID.:62:&SESSION.::NO::P62_IDTIPOTAREFA:' || idtipotarefa link
                      from (
                            select nome, qtde recontato_futuro, atrasados recontato_atrasado, 0 aguardando, 0 em_atendimento, idtipotarefa
                              from beeunified.vw_tarefas_recontato
                             where cobranca = 0
                             union all
                            select nome, 0 recontato_futuro, 0 recontato_atrasado, qtde aguardando, 0 em_atendimento, idtipotarefa
                              from beeunified.vw_tarefas_aguardando
                             where cobranca = 0
                             union all
                            select nome, 0 recontato_futuro, 0 recontato_atrasado, 0 aguardando, qtde em_atendimento, idtipotarefa
                              from beeunified.vw_tarefas_em_atendimento
                             where cobranca = 0
                           )
                     group by nome, idtipotarefa
                     order by nome
                    ```
            }
            columnMapping {
                label: NOME
                value: RECONTATO_FUTURO
            }
            appearance {
                color: #73C95B
            }
