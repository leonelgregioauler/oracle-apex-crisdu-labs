page 61 (
    name: Monitoramento de Tarefas
    title: Monitoramento de Tarefas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function doLoad() {
                setInterval("regionRefresh()", 15000);
            }
            
            function regionRefresh() {
            
                //console.log('atualizou regioes');    
                apex.region("badges_tarefas").refresh();
                apex.region("resumo_tarefas_callback").refresh();
                apex.region("resumo_tarefas_outras").refresh();
                apex.region("tarefas_nao_finalizadas").refresh();
                refreshCount++;
                if (refreshCount % 4 == 0 ) {
                    //console.log('atualizou');
                    apex.region("tarefas_atendidas").refresh();
                }
                
            }
            ```
        executeWhenPageLoads: doLoad();
    }
    htmlHeader {
        htmlHeader:
            ```html
            <script type="text/javascript">
             var refreshCount = 0;
            </script>
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region call-back (
        name: Call Back
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , qtde
                     , to_char(data_primeira,'dd/mm/rrrr hh24:mi:ss') "TAREFA MAIS ANTIGA"
                     , to_char(data_ultima,'dd/mm/rrrr hh24:mi:ss') "TAREFA MAIS RECENTE"
                  from beeunified.vw_tarefas_aguardando
                 where call_back = 1 and cobranca = 0
                 order by nome
                ```
        }
        layout {
            sequence: 30
            parentRegion: @resumo-por-tipo-de-tarefa
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--noBorders
                margin-top-none
            ]
        }
        advanced {
            htmlDomId: resumo_tarefas_callback
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        searchBar {
            includeSearchBar: false
        }
        heading {
            fixedTo: none
        }
