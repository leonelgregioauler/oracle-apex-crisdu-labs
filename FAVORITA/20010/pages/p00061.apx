    region tarefas-novas-aguardando-atendimento (
        name: Tarefas Novas Aguardando Atendimento
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select case
                        when call_back = 1 then NOME
                        else 'OUTRAS'
                       end nome, 
                       sum(QTDE) qtde,
                       call_back
                  from beeunified.vw_tarefas_aguardando 
                 where cobranca = 0
                 group by 
                       case
                        when call_back = 1 then NOME
                        else 'OUTRAS'
                       end
                     , call_back
                 ORDER BY call_back desc, nome
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent13
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: badges_tarefas
        }
        security {
            escapeSpecialChars: false
        }
        settings {
            topLabel: NOME
            value: QTDE
            linkTarget: {
                type: url
                url: javascript: openModal('resumo_tipo_tarefa');
            }
            color: yes
        }
    )

