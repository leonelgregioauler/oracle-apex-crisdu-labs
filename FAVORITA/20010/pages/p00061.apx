            showGroupName: false
        }
        legend {
            hideAndShowBehavior: none
        }

        series tarefas-atendidas (
            name: Tarefas Atendidas
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nome, to_char(data_resgate,'dd-Mon') data, qtde
                      from beeunified.vw_tarefas_atendidas_d7
                     where cobranca = 0
                     order by trunc(data_resgate)
                    ```
            }
            columnMapping {
                seriesName: NOME
                label: DATA
                value: QTDE
            }
        )

