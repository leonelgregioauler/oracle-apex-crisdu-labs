page 47 (
    name: Pedidos por Semana
    title: Pedidos por Semana
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtro-de-semana (
        name: Filtro de semana
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pedidos-por-semana (
        name: Pedidos por Semana
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idfilialromance
                     , p.filialromance
                     , count(1) quantidade
                     , sum(p.valorapagar*p.fatorconversao) valorotal   
                     , pck_util.fnc_ano_idsemana(p.idsemanaemissao )  ano
                 from vw_pedidos_fav p
                 where
                ( 
                  ( :P47_TIPO = 'S' AND ( p.idsemanaemissao between ( select idsemana
                                                                       from semana_dias s
                                                                       where s.semana = :P47_SEMANAINI
                                                                         AND S.Ano = extract(year from sysdate) ) and ( select idsemana
                                                                                                                         from semana_dias s
                                                                                                                         where s.semana = :P47_SEMANAFIM 
                                                                                                                           AND S.Ano = extract(year from sysdate) ) ) )
                 or ( :P47_TIPO = 'P' and dataemissao  between to_date(:P47_DATADE||' 00:00:00' ,'dd/mm/rrrr hh24:mi:ss' )  and to_date(:P47_DATAATE||' 23:59:59' ,'dd/mm/rrrr hh24:mi:ss')) )
                   and p.idsituacaoentrega  >= 20000
                   and p.tipopedido != 'F' -- sem favorita paris
                   and p.valorapagar > 0 
                   and p.ididioma = 1
                   and NOT exists ( select 1
                                    from classificacoespedidos c
                                    where c.idpedido               = p.idpedido
                                      and c.idcaracteristicapedido = 25 )
                  and (:P47_SEMANAINI is not null OR :P47_DATADE IS NOT NULL)
                group by p.idfilialromance
                     , p.filialromance
                     ,pck_util.fnc_ano_idsemana(p.idsemanaemissao )  
                union
                select p.idfilialromance
                     , p.filialromance
                     , count(1) quantidade
                     , sum(p.valorapagar*p.fatorconversao) valorotal   
                     , pck_util.fnc_ano_idsemana(p.idsemanaemissao )   ano
                 from vw_pedidos_fav p
                 where
                ( 
                  ( :P47_TIPO = 'S' AND ( p.idsemanaemissao between ( select idsemana
                                                                       from semana_dias s
                                                                       where s.semana = :P47_SEMANAINI
                                                                         AND S.Ano = extract(year from sysdate)-1 ) and ( select idsemana
                                                                                                                         from semana_dias s
                                                                                                                         where s.semana = :P47_SEMANAFIM 
                                                                                                                           AND S.Ano = extract(year from sysdate)-1 ) ) )
                 or ( :P47_TIPO = 'P' and dataemissao  between to_date(:P47_DATADE||' 00:00:00' ,'dd/mm/rrrr hh24:mi:ss' )-365  and to_date(:P47_DATAATE||' 23:59:59' ,'dd/mm/rrrr hh24:mi:ss')-365 ) )
                   and p.idsituacaoentrega  >= 20000
                   and p.tipopedido != 'F' -- sem favorita paris
                   and p.valorapagar > 0 
                   and p.ididioma = 1
                   and NOT exists ( select 1
                                    from classificacoespedidos c
                                    where c.idpedido               = p.idpedido
                                      and c.idcaracteristicapedido = 25 )
                  and (:P47_SEMANAINI is not null OR :P47_DATADE IS NOT NULL)
                group by p.idfilialromance
                     , p.filialromance
                     , pck_util.fnc_ano_idsemana(p.idsemanaemissao )  
                ```
            pageItemsToSubmit: [
                P47_SEMANAINI
                P47_SEMANAFIM
                P47_TIPO
                P47_DATADE
                P47_DATAATE
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 4136757157799843528
        }

        column ANO (
            type: plainText
            heading {
                heading: Ano
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column FILIALROMANCE (
            type: plainText
            heading {
                heading: Empresa
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column IDFILIALROMANCE (
            type: plainText
            heading {
                heading: Idfilialromance
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column QUANTIDADE (
            type: plainText
            heading {
                heading: Quantidade
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column VALOROTAL (
            type: plainText
            heading {
                heading: Valorotal
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 44434144 (
            visibility: primaryDefault
            view {
                pivot: true
                default: pivot
                rowsPerPage: 50
            }

            displayColumn ANO (
                sequence: 3
            )

            displayColumn FILIALROMANCE (
                sequence: 2
            )

            displayColumn IDFILIALROMANCE (
                sequence: 1
            )

            pivotColumn (
                column: ANO
                layout {
                    sequence: 1
                }
            )

            pivotRowColumn (
                column: FILIALROMANCE
                layout {
                    sequence: 1
                }
            )

            pivotAggregate ir-pivot-agg (
                heading: Quantidade
                aggregate {
                    function: sum
                    column: QUANTIDADE
                    displaySum: true
                }
                appearance {
                    formatMask: 999G999G999G999G990
                }
                layout {
                    sequence: 1
                }
            )

            pivotAggregate ir-pivot-agg-2 (
                heading: Valor
                aggregate {
                    function: sum
                    column: VALOROTAL
                    displaySum: true
                }
                appearance {
                    formatMask: 999G999G999G999G990D00
                }
                layout {
                    sequence: 2
                }
            )

        )

    )

    pageItem P47_DATAATE (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 50
            region: @filtro-de-semana
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P47_DATADE (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 40
            region: @filtro-de-semana
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P47_SEMANAFIM (
        type: selectList
        label {
            label: Até
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct semana    display_value
                     , semana             return_value
                from semana_dias
                where semana >= :P47_SEMANAINI
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P47_SEMANAINI
        }
        layout {
            sequence: 30
            region: @filtro-de-semana
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P47_SEMANAINI (
        type: selectList
        label {
            label: De
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct semana    display_value
                     , semana             return_value
                from semana_dias
                order by 1
                ```
        }
        layout {
            sequence: 20
            region: @filtro-de-semana
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P47_TIPO (
        type: radioGroup
        label {
            label: Tipo
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Semana;S,Periodo;P
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtro-de-semana
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: S
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: Filtrar
        label: Filtrar
        layout {
            sequence: 60
            region: @filtro-de-semana
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P47_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P47_TIPO
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P47_SEMANAINI
                    P47_SEMANAFIM
                ]
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P47_DATADE
                    P47_DATAATE
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P47_SEMANAINI
                    P47_SEMANAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P47_DATADE
                    P47_DATAATE
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    dynamicAction submit (
        name: Submit
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 47
                items: {
                    P47_TIPO: &P47_TIPO.
                    P47_SEMANAINI: &P47_SEMANAINI.
                    P47_SEMANAFIM: &P47_SEMANAFIM.
                    P47_DATADE: &P47_DATADE.
                    P47_DATAATE: &P47_DATAATE.
                }
                action: resetPagination
            }
        }
    )

)

