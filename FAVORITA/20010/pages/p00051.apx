    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 170
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction filtrar (
        name: FILTRAR
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation seleciona-pais (
        name: Seleciona Pais
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P51_IDPAIS
            alwaysExecute: true
        }
        error {
            errorMessage: Selecione o país
        }
        serverSideCondition {
            type: request=Value
            value: ANALISECOMPOSTA
        }
    )

    branch (
        name: Goto Page 57
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 57
                items: {
                    P57_IDPAIS: &P51_IDPAIS.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: ANALISECOMPOSTA
        }
    )

    branch (
        name: Go To Page 51
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 51
                items: {
                    P51_IDFILIALFAVORITA: &P51_IDFILIALFAVORITA.
                    P51_IDPRODUTO: &P51_IDPRODUTO.
                    P51_IDPRODUTODETALHADO: &P51_IDPRODUTODETALHADO.
                    P51_DESCONTINUADO: &P51_DESCONTINUADO.
                    P51_PRIORIDADE: &P51_PRIORIDADE.
                    P51_IDKITVENDA: &P51_IDKITVENDA.
                }
                action: resetPagination
            }
        }
    )

)

