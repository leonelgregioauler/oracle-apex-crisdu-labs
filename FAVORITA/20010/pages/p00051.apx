    region definições (
        name: Definições
        type: staticContent
        source {
            htmlCode:
                ```html
                O estoque é atualizado sempre que clicar no botão "Escolher Ciclos" e no "Salvar e Gerar Base".
                
                <br>
                <br>
                Escolha os Ciclos desejados no botão na direita da tela.
                <br>
                <br>
                - Ciclos são calculados de acordo com os escolhidos anteriormente.<br>
                - São considerado apenas produtos que estão no cliclo vigente.<br>
                - "Disponível" soma a quantidade de todos estoques que o CD abastece.<br>
                - "Media Geral" calcula a média apenas de ciclos fechados.<br>
                - "Comprado" leva em conta apenas compras para o CD Abastecedor.<br>
                - "Descontinuado" considera em tempo real o que estiver definido no cadastro de produtos.<br>
                
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
    )

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 30
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
                t-Form--large
                t-Form--stretchInputs
                t-Form--labelsAbove
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region gerar-base-de-dados (
        name: Gerar Base de Dados
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
                t-Form--large
                t-Form--stretchInputs
                t-Form--labelsAbove
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            footerText: Apenas escolha os ciclos caso precise muda-los. Caso contrário, não é necessário.
        }
    )

    pageItem P51_AVISOINCONSISTENCIA (
        type: displayOnly
        label {
            label: " "
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 10
            region: @definições
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: staticValue
            staticValue: <font color="red"><b>Há informações incorretas neste relatório, avise a TI.</b></font>
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from FAVORITA.temp_analisenecessidadecomp1 t 
                having count(1) > 1  
                group by t.idfilialfavorita_est
                       , t.filialfavorita_est               
                       , t.idprodutodetalhado    
                       , t.nomeproduto            
                       , t.nomeprodutodetalhado      
                       , t.idfilialorigem_abatecedor
                       , t.filialorigem_abatecedor
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P51_DESCONTINUADO (
        type: radioGroup
        label {
            label: Descontinuado
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Sim;S,Não;N,Todos;T
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 150
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P51_HORARIOATUALIZACAO (
        type: displayOnly
        label {
            label: Venda atualizada em
            alignment: left
        }
        layout {
            sequence: 20
            region: @definições
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select trim(to_char(NVL(last_date,NEXT_DATE-1),'dd/mm/rrrr hh24:mi:ss'))||'. Próxima atualização: '||trim(to_char(next_date,'DD/MM/RRRR HH24:MI:SS'))||'.' a
                from ALL_jobs
                where what like '%VW_ITENSVENDA_DIA_FAV_MV%'
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P51_IDFILIALFAVORITA (
        type: selectList
        label {
            label: CD Abastecedor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomefilialfavorita display_value
                     , idfilialfavorita   return_value
                from favorita.filiaisfavorita f
                where f.tipofilial in ('E')
                  and idpais = :P51_IDPAIS
                order by 1
                
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione um Estoque -
        }
        cascadingLov {
            parentItems: P51_IDPAIS
        }
        layout {
            sequence: 110
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P51_IDKITVENDA (
        type: selectList
        label {
            label: Kit de Venda
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select k.referencia||' - '||k.descricao d
                     , k.idkitvenda r
                from kitsvendas k
                where trunc(sysdate) between k.datainicial and k.datafinal
                order by 1
                ```
        }
        layout {
            sequence: 130
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P51_IDPAIS (
        type: selectList
        label {
            label: País
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct nome  display_value
                     , p.idpais  return_value
                from roman.paises p
                   , favorita.filiaisfavorita f
                where f.idpais = p.idpais
                order by nome
                ```
            displayExtraValues: false
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 10
            region: @gerar-base-de-dados
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P51_IDPRODUTO (
        type: popupLov
        label {
            label: Produto
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomeproduto display_value
                     , idproduto   return_value
                from favorita.vw_produtos_fav w
                where ididioma = 1
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 120
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P51_IDPRODUTODETALHADO (
        type: popupLov
        label {
            label: Produto Detalhado
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select replace(w.produto ||' '||Caracteristica||' '||cor||' '||grade,'  ',' ')    display_value
                    , w.idprodutodetalhado return_value
                from favorita.vw_produtosdetalhados_fav w
                where ididioma = 1 
                order by w.produtosemref
                ```
            displayExtraValues: false
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 140
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P51_PRIORIDADE (
        type: radioGroup
        label {
            label: Prioridade
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:1;1,2;2,3;3,Todos;-1
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 160
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: -1
        }
        security {
            encryptSessionState: false
        }
    )

