    region análise-de-necessidade-de-compra-uruguai (
        name: Análise de Necessidade de Compra Uruguai
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idfilialorigem_abatecedor
                     , filialorigem_abatecedor
                
                
                     , idfornecedor
                     , roman.pck_romance.fnc_nomefornecedor(idfornecedor) fornecedor
                     , idprodutodetalhado
                     , nomeprodutodetalhado nomeproduto
                     , disponivel              
                     , idcategoria
                     , nomecategoria
                     , descontinuado
                     --  
                     , '|' s1            
                     , tciclo_1
                     , tciclo_2
                     , tciclo_3 
                     , media_anterior   
                     --      
                     , '|' s2       
                     , tciclo_4
                     , tciclo_5
                     , tciclo_6                                         
                     , media_atual 
                     --         
                     , '|' s3  
                     , media_geral
                     --    
                     , '|' s4
                     , comprado            
                     , transferencia
                     --
                     , '|' s5    
                     , cobertura_ciclo  
                     , lead_transit_time 
                     , necessidadecompraciclo   
                     , case
                          when necessidade_compra  > 0 then
                            necessidade_compra
                          else
                            0
                          end necessidade_compra
                     --
                     , case
                         when cobertura_ciclo < lead_transit_time then
                           1
                         when cobertura_ciclo between lead_transit_time and lead_transit_time+ 1 then
                           2
                         else --when cobertura_ciclo > lead_transit_time + 2 then
                           3
                        -- else
                         --  4
                           end prioridade   
                     , idpais
                     , nomepais     
                from ( select t.idfilialorigem_abatecedor
                             , t.filialorigem_abatecedor
                             , t.idfornecedor
                             , t.idprodutodetalhado
                             , t.nomeproduto
                             , t.nomeprodutodetalhado
                             , t.disponivel
                             --                    
                             , t.idcategoria
                             , t.nomecategoria
                             , decode(t.descontinuado,'S','Sim') descontinuado
                             --  
                             , t.tciclo_1
                             , t.tciclo_2
                             , t.tciclo_3 
                             , t.media_anterior   
                             --      
                             , t.tciclo_4
                             , t.tciclo_5
                             , t.tciclo_6                                         
                             , t.media_atual 
                             --         
                             , t.media_geral
                             --    
                             , t.comprado   
                             , transferencia     
                             --
                             , case
                                  when t.media_geral > 0 then
                                      round( t.disponivel/t.media_geral,1 )   
                                  end cobertura_ciclo
                             --      
                             , t.lead_transit_time
                             --
                             , case
                                 when ( t.lead_transit_time - case
                                                      when t.media_geral > 0 then
                                                          round( t.disponivel/t.media_geral,1 )   
                                                      end )   + 1   < 0 then   
                                    0
                                  else
                                    ( t.lead_transit_time - case
                                                      when t.media_geral > 0 then
                                                          round( t.disponivel/t.media_geral,1 )   
                                                      end )   + 1   
                                  end necessidadecompraciclo
                 
                
                
                            ,  round(( t.media_geral *  ( ( t.lead_transit_time - case
                                                                                            when t.media_geral > 0 then
                                                                                                round( t.disponivel/t.media_geral,1 )   
                                                                                            end )   + 1)  ) - (nvl(t.comprado,0)+nvl(t.transferencia,0)) )              necessidade_compra    
                              , idpais
                              , nomepais         
                        from ( select idfilialorigem_abatecedor -- t.idfilialfavorita_est
                                    , filialorigem_abatecedor  --t.filialfavorita_est
                                    , t.idfornecedor
                                    , t.idprodutodetalhado   
                                    , t.nomeprodutodetalhado
                                    , t.idcategoria
                                    , t.nomecategoria
                                    , t.descontinuado
                                    , t.nomeproduto
                                    , t.idpais       
                                    , ( select nome
                                        from roman.paises p
                                        where p.idpais = t.idpais ) nomepais    
                                    --
                                    , round( ( select tempoproducao+tempoentrega                   
                                                from favorita.fornecedorestemposentrega ff         
                                                where ff.idfornecedor      = t.idfornecedor                                   
                                                  and ff.idfilialfavorita  = t.idfilialorigem_abatecedor ) /42,1)  lead_transit_time      
                                    --
                                    , round(  (sum(nvl(t.ciclo_1,0)) + sum(nvl(t.ciclo_2,0)) + sum(nvl(t.ciclo_3,0))) / 3)media_anterior     
                                    --
                                    , round(  (sum(nvl(t.ciclo_4,0)) + sum(nvl(t.ciclo_5,0)) + sum(nvl(t.ciclo_6,0))) / 3)  media_atual 
                                    --           
                                    , round(   (sum(nvl(t.ciclo_1,0)) + sum(nvl(t.ciclo_2,0)) + sum(nvl(t.ciclo_3,0)) + sum(nvl(t.ciclo_4,0)) + sum(nvl(t.ciclo_5,0)) + sum(nvl(t.ciclo_6,0))) / 6 ) media_geral
                                    --            
                                    , ( select sum(nvl(ict.quantidadecomprada, 0))
                                          from favorita.itenscomprastransferencias ict
                                             , favorita.comprastransferencias ct
                                          where ict.idcompratransferencia = ct.idcompratransferencia
                                            and ct.idtipocomptransrem     in ( 0) --compra
                                            and ct.idsituacao             in (10,20,11,30)
                                            and ct.idfilialfavoritadestino = t.idfilialorigem_abatecedor
                                            and ict.idprodutodetalhado    = t.idprodutodetalhado ) comprado    
                                    , ( select sum(nvl(ict.quantidadecomprada, 0))
                                          from favorita.itenscomprastransferencias ict
                                             , favorita.comprastransferencias ct
                                          where ict.idcompratransferencia = ct.idcompratransferencia
                                            and ct.idtipocomptransrem     in ( 1) --transferencia
                                            and ct.idsituacao             in (10,20,11,30)
                                            and ct.idfilialfavoritadestino = t.idfilialorigem_abatecedor
                                            and ict.idprodutodetalhado    = t.idprodutodetalhado ) transferencia    
                
                                    , sum(t.disponivel)    disponivel
                                    , sum(nvl(t.ciclo_1,0)   )    tciclo_1
                                    , sum(nvl(t.ciclo_2,0)   )    tciclo_2
                                    , sum(nvl(t.ciclo_3,0)   )    tciclo_3  
                                    , sum(nvl(t.ciclo_4,0)   )    tciclo_4
                                    , sum(nvl(t.ciclo_5,0)   )    tciclo_5
                                    , sum(nvl(t.ciclo_6,0)  )    tciclo_6   
                                from FAVORITA.temp_analisenecessidadecomp2  t 
                                where ( :P51_IDPAIS            is null or t.idpais                     = :P51_IDPAIS    )
                                  and ( :P51_IDPRODUTO         is null or t.idproduto                  = :P51_IDPRODUTO )
                                  and ( :P51_IDFILIALFAVORITA  is null or t.idfilialorigem_abatecedor  = :P51_IDFILIALFAVORITA  )  
                                  --
                                  --and (:P51_DESCONTINUADO = 'T' or t.descontinuado = :P51_DESCONTINUADO)
                                  --
                                  and exists (  select 1
                                                  from produtosdetedrevistas pdr, edicoesrevistas er, ciclosedicoes ce, produtosdetalhados pd
                                                 where pdr.idprodutodetalhado = pd.idprodutodetalhado
                                                   and pdr.idedicaorevista = er.idedicaorevista
                                                   and er.idedicaorevista = ce.idedicaorevista
                                                   and er.idpais = t.idpais
                                                   and sysdate between ce.datainicio and nvl(ce.datafim,sysdate+1)
                                                   and pdr.idprodutodetalhado = t.idprodutodetalhado
                                                   and (:P51_DESCONTINUADO = 'T' or pd.descontinuado = :P51_DESCONTINUADO)
                                               )
                                  --
                                  and not exists ( select 1
                                                   from favorita.classificacoesprodutos cp
                                                   where cp.idprodutodetalhado = t.idprodutodetalhado
                                                     and cp.idtagproduto in (1))
                                  --
                                   --and t.idprodutodetalhado = :P51_IDPRODUTODETALHADO           
                                group by idfilialorigem_abatecedor -- t.idfilialfavorita_est
                                       , filialorigem_abatecedor  --t.filialfavorita_est
                                       , t.idprodutodetalhado       
                                       , t.idcategoria
                                       , t.nomecategoria
                                       , t.descontinuado
                                                           
                                       , t.idfornecedor
                                       
                                       , t.nomeproduto
                                       , t.nomeprodutodetalhado
                                       
                                        , t.idpais       
                             ) t     
                     )
                 where ( :P51_PRIORIDADE = -1 or ( :P51_PRIORIDADE = 1 and cobertura_ciclo < lead_transit_time )
                                               or ( :P51_PRIORIDADE = 2 and cobertura_ciclo between lead_transit_time and lead_transit_time+ 1 )
                                               or ( :P51_PRIORIDADE = 3 and cobertura_ciclo < lead_transit_time ) )     
                ```
            pageItemsToSubmit: [
                P51_IDFILIALFAVORITA
                P51_IDPRODUTO
                P51_DESCONTINUADO
                P51_PRIORIDADE
            ]
        }
