    region produtos-top-p1-top (
        name: Produtos Top &P1_TOP.
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pro.nomeproduto as produto
                     , sum(ip.quantidade) as qtd_produtos
                     , sum(ip.valorvenda * ip.quantidade) as valor_venda
                  from favorita.pedidos p
                     , favorita.itenspedidos ip
                     , favorita.produtos pro
                 where ip.idpedido = p.idpedido
                   and pro.idproduto = ip.idproduto
                   -- período
                   and p.dataemissao between to_date(:P1_DE||' 00:00:00' ,'dd/mm/rrrr hh24:mi:ss' )
                                         and to_date(:P1_ATE||' 23:59:59' ,'dd/mm/rrrr hh24:mi:ss')
                   -- empresa romance
                   and ( :P0_IDFILIALROMANCE = '999999999999' or p.idfilialromance = :P0_IDFILIALROMANCE )
                   and p.idsituacaoentrega  >= 20000
                   and p.tipopedido          = 'P'    
                   and p.idpais              = 1
                   and nvl(ip.valorvenda,0)  > 0
                   and p.datacancelamento is null
                   and NOT exists ( select 1
                                      from favorita.classificacoespedidos c  
                                     where idpedido = p.idpedido
                                       and idcaracteristicapedido = 8 
                                       and idvalorcaracteristica  = 16 )
                 group by pro.nomeproduto
                 order by 2 desc
                 fetch first :P1_TOP rows only
                ```
            pageItemsToSubmit: [
