    region top-p1-top-distribuidores-pedidos-pagos (
        name: Top &P1_TOP. Distribuidores - Pedidos Pagos
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select distribuidor
                     , quantidade
                     , ROUND(valortotal) VALORTOTAL
                from (select roman.pck_romance.fnc_nomerepresentante(p.idrepresentante)||' - '||roman.pck_romance.fnc_nomefilial(p.idfilialromance)  distribuidor 
                           , count(1) quantidade
                           , sum(p.valortotal*p.fatorconversao) valortotal
                      from vw_pedidos_fav p
                      where exists ( select 1
                                     from vw_vencimentospedidos_fav v
                                        , vw_pagamentospedidos_fav pp
                                     where p.idpedido           = v.idpedido   
                                       and v.idvencimentopedido = pp.idvencimentopedido
                                       and pp.datapagamento  between to_date(:P1_DE||' 00:00:00' ,'dd/mm/rrrr hh24:mi:ss' )  and to_date(:P1_ATE||' 23:59:59' ,'dd/mm/rrrr hh24:mi:ss') )
                        and p.datacancelamento is null
                        and p.ididioma = 1
                        and p.idsituacaoentrega  >= 20000
                        and ( :P0_IDFILIALROMANCE = '999999999999' or p.idfilialromance = :P0_IDFILIALROMANCE )
                      group by p.idrepresentante,p.idfilialromance
                )
                ORDER BY VALORTOTAL DESC
                 fetch first :P1_TOP rows only
                ```
        }
        layout {
            sequence: 190
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: DISTRIBUIDOR
            valueColumn: VALORTOTAL
            formatMask: 999G999G999G990
            maximumRows: 20
        }
    )

    region top-p1-top-empreendedoras (
        name: Top &P1_TOP. Empreendedoras
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select vendedora
                     , representante
                     , quantidade
                     , valortotal
                     , cpf
                from ( select roman.pck_romance.fnc_nomevendedora(p.idvendedora) vendedora
                            , ( select roman.pck_romance.fnc_nomerepresentante(v.idrepresentante)||' ('||roman.pck_romance.fnc_nomefilial(roman.pck_romance.fnc_filialvendedora(v.idvendedora))||') '
                                from vendedoras v
                                where v.idvendedora = p.idvendedora ) representante
                            , count(1) quantidade
                            , sum(nvl(p.valorapagar,1)*p.fatorconversao) valortotal
                            , p.cpf
                       from vw_pedidos_fav p
                       where dataemissao  between to_date(:P1_DE||' 00:00:00' ,'dd/mm/rrrr hh24:mi:ss' ) and to_date(:P1_ATE||' 23:59:59' ,'dd/mm/rrrr hh24:mi:ss')
                         and p.datacancelamento is null
                         and p.ididioma = 1
                         and p.idsituacaoentrega  >= 20000
                         and ( :P0_IDFILIALROMANCE = '999999999999' or p.idfilialromance = :P0_IDFILIALROMANCE )
                         and exists ( select 1
                                      from roman.vw_filiais f
                                      where f.idfilial = p.idfilialromance
                                        and f.tipofilial = 'D' )
                         and not exists ( select 1
                                          from classificacoespedidos c
                                          where c.idpedido = p.idpedido
                                            and c.idcaracteristicapedido = 28 )
                       group by p.idvendedora,p.cpf
                       order by 4 desc
                       fetch first :P1_TOP rows only)
                
                ```
        }
        layout {
            sequence: 210
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: <b> Não está sendo levado em consideração os pedidos de distribuidores independentes</b>
        }
        reportLayout {
            numberOfRows: 20
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
