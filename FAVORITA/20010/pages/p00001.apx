    region faturamento-x-pago-por-distribuidor (
        name: Faturamento X Pago Por Distribuidor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select aux.distribuidor     as "Distribuidor",
                       sum(aux.valor_total) as "Valor Total",
                       sum(aux.valor_pago)  as "Valor Pago",
                       case 
                         when sum(aux.valor_pago) < sum(aux.valor_total) then
                           '<div style="color: red; font-weight: bold;">' || 
                           to_char(sum(aux.valor_pago) - sum(aux.valor_total), 'FM999G999G990D00', 'NLS_NUMERIC_CHARACTERS = '',.''') || 
                           '</div>'
                         else
                           '<div style="color: green; font-weight: bold;">' || 
                           to_char(sum(aux.valor_pago) - sum(aux.valor_total), 'FM999G999G990D00', 'NLS_NUMERIC_CHARACTERS = '',.''') || 
                           '</div>'
                       end as "Diferença"
                  from (    select initcap(pp.nomepessoa) as distribuidor
                                 , sum(p.valortotal) as valor_total
                                 , 0 as valor_pago
                              from favorita.pedidos p
                                 , catal.representantes r
                                 , catal.pessoas pp
                             where r.idrepresentante = p.idrepresentante
                               and pp.idpessoa = r.idpessoa
                               -- pedidos que não estão cancelados
                               and p.datacancelamento is null
                               -- período
                               and p.dataemissao between to_date(:P1_DE||' 00:00:00' ,'dd/mm/rrrr hh24:mi:ss' )
                                                     and to_date(:P1_ATE||' 23:59:59' ,'dd/mm/rrrr hh24:mi:ss')
                               -- Somente Brasil
                               and p.idpais = 1
                               -- apartir de Aguardando Montagem de Remessa
                               and p.idsituacaoentrega  >= 20000
                               -- sem favorita paris
                               and p.tipopedido         != 'F'
                               -- empresa romance
                               and ( :P0_IDFILIALROMANCE = '999999999999' or p.idfilialromance = :P0_IDFILIALROMANCE )      
                             group by pp.nomepessoa
                
                            union
                
                            select initcap(pp.nomepessoa) as distribuidor
                                 , 0 as valor_total
                                 , sum(pag.valorpago) as valor_pago
                              from favorita.pagamentospedidos pag
                                 , favorita.vencimentospedidos vp
                                 , favorita.pedidos p
                                 , catal.representantes r
                                 , catal.pessoas pp
                             where vp.idvencimentopedido = pag.idvencimentopedido
                               and p.idpedido = vp.idpedido
                               and r.idrepresentante = p.idrepresentante
                               and pp.idpessoa = r.idpessoa
                               -- pedidos que não estão cancelados
                               and p.datacancelamento is null
                               -- período
                               and pag.datapagamento between to_date(:P1_DE||' 00:00:00' ,'dd/mm/rrrr hh24:mi:ss' )
                                                         and to_date(:P1_ATE||' 23:59:59' ,'dd/mm/rrrr hh24:mi:ss')
                               -- Somente Brasil
                               and p.idpais = 1
                               -- apartir de Aguardando Montagem de Remessa
                               and p.idsituacaoentrega  >= 20000
                               -- sem favorita paris
                               and p.tipopedido         != 'F'
                               -- empresa romance
                               and ( :P0_IDFILIALROMANCE = '999999999999' or p.idfilialromance = :P0_IDFILIALROMANCE )
                             group by pp.nomepessoa) aux
                 group by aux.distribuidor
                 order by aux.distribuidor
                 
                
                
                
                
                
                
                ```
        }
        layout {
            sequence: 220
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent13
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 762850568982282743
        }

        column Diferença (
            type: plainText
            heading {
                heading: Diferença
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
