    region valor-de-pedidos-ano-anterior (
        name: Valor de Pedidos - Ano Anterior
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(emp.idfilial) ||' - Qtd: '||trim(to_char(emp.qtd,'999G999G990'))||' Ticket Médio: '||trim(to_char(emp.tiketmedio,'999G999G999G990D00'))  empresa
                     , ROUND(emp.valortotal) valortotal
                from ( select p.idfilialromance idfilial
                            , sum(p.valorapagar*p.fatorconversao) valortotal  
                            , avg(p.valorapagar*p.fatorconversao) tiketmedio
                            , count(1) qtd
                       from vw_pedidos_fav p
                       where dataemissao between to_date(:P1_DE_ANTERIOR||' 00:00:00' ,'dd/mm/rrrr hh24:mi:ss' ) and to_date(:P1_ATE_ANTERIOR||' 23:59:59' ,'dd/mm/rrrr hh24:mi:ss')
                         and ( :P0_IDFILIALROMANCE = '999999999999' or p.idfilialromance = :P0_IDFILIALROMANCE )                
                         and p.idsituacaoentrega  >= 20000
                         and p.tipopedido         != 'F'    -- sem favorita paris
                         and p.ididioma            = 1
                         and p.valorapagar_orig         > 0
                         and p.datacancelamento is null
                         and NOT exists ( select 1
                                          from classificacoespedidos c  
                                          where idpedido = p.idpedido
                                            and idcaracteristicapedido = 8 
                                            and idvalorcaracteristica  = 16 ) 
                         and exists ( select 1
                                      from roman.vw_filiais f
                                      where f.ativo    = 'S'
                                        --and f.tipofilial = 'D'
                                        and f.idfilial = p.idfilialromance)
                       group by p.idfilialromance ) emp
                order by 1
                ```
            pageItemsToSubmit: [
                P1_DE
                P1_ATE
            ]
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: EMPRESA
            valueColumn: VALORTOTAL
            formatMask: 999G999G999G990
            colorScheme: modern
            maximumRows: 50
        }
    )

    region valor-de-pedidos-ano-atual (
        name: Valor de Pedidos - Ano Atual
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(emp.idfilial) ||' - Qtd: '||trim(to_char(emp.qtd,'999G999G990'))||' Ticket Médio: '||trim(to_char(emp.tiketmedio,'999G999G999G990D00'))  empresa
                     , ROUND(emp.valortotal) valortotal
                from ( select p.idfilialromance idfilial
                            , round(sum(p.valorapagar*nvl(p.fatorconversao,1)),2) valortotal  
                            , avg(p.valorapagar*nvl(p.fatorconversao,1)) tiketmedio
                            , count(1) qtd
                       from vw_pedidos_fav p
                       where trunc(dataemissao) between to_date(:P1_DE,'dd/mm/rrrr') and to_date(:P1_ATE,'dd/mm/rrrr')
                         and ( :P0_IDFILIALROMANCE = '999999999999' or p.idfilialromance = :P0_IDFILIALROMANCE )                  
                         and p.idsituacaoentrega  >= 20000
                         and p.tipopedido         != 'F'    -- sem favorita paris
                         and p.ididioma            = 1
                         and p.valorapagar         > 0
                         and p.datacancelamento is null
                         and NOT exists ( select 1
                                          from classificacoespedidos c  
                                          where idpedido = p.idpedido
                                            and idcaracteristicapedido = 8 
                                            and idvalorcaracteristica  = 16 ) 
                         and exists ( select 1
                                      from roman.vw_filiais f
                                      where f.ativo    = 'S'
                                       -- and f.tipofilial = 'D'
                                        and f.idfilial = p.idfilialromance
                                        and f.idfilial != 1063 )
                       group by p.idfilialromance
                       ) emp
                where ROUND(emp.valortotal) > 0
                order by 1
                ```
            pageItemsToSubmit: [
                P1_DE
                P1_ATE
            ]
        }
        layout {
            sequence: 70
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: EMPRESA
            valueColumn: VALORTOTAL
            formatMask: 999G999G999G990
            colorScheme: modern
            maximumRows: 50
        }
    )

