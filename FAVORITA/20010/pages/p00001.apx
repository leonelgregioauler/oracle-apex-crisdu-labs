    region subcategoria-quantidade-vendida (
        name: Subcategoria - Quantidade Vendida
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select s.nome as "Subcategoria"
                     , trunc(sum(ip.quantidade)) as "Quantidade Vendida"
                  from favorita.itenspedidos ip
                     , favorita.produtos pp
                     , favorita.subcategorias s
                     , favorita.pedidos ped
                 where pp.idproduto = ip.idproduto
                   and s.idsubcategoria = pp.idsubcategoria
                   and ped.idpedido = ip.idpedido
                    -- pedidos que não estão cancelados
                   and ped.datacancelamento is null
                   -- período
                   and ped.dataemissao between to_date(:P1_DE||' 00:00:00' ,'dd/mm/rrrr hh24:mi:ss' )
                                           and to_date(:P1_ATE||' 23:59:59' ,'dd/mm/rrrr hh24:mi:ss')
                   -- Somente Brasil
                   and ped.idpais = 1
                   -- apartir de Aguardando Montagem de Remessa
                   and ped.idsituacaoentrega  >= 20000
                   -- sem favorita paris
                   and ped.tipopedido         != 'F'
                   -- empresa romance
                   and ( :P0_IDFILIALROMANCE = '999999999999' or ped.idfilialromance = :P0_IDFILIALROMANCE )      
                 group by s.nome
                 order by 2 desc
                
                
                
                
                
                
                
                ```
        }
        layout {
            sequence: 240
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent8
                t-Region--scrollBody
            ]
        }
        settings {
            labelColumn: "Subcategoria"
            valueColumn: "Quantidade Vendida"
            formatMask: 999G999G999G990
        }
    )

