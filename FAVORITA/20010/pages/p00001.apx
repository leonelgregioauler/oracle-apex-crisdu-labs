    process busca-totais-ano-anterior (
        name: Busca totais ano anterior
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  -- BUSCA DO TOTAL - ANO ANTERIOR
                  --
                  for a in ( select trim(to_char(count(1),'999G999G999G999G990')) quantidade
                                  , TRIM(TO_CHAR(sum(p.valorapagar_orig*p.fatorconversao),'999G999G999G999G990D00')) valorotal 
                             from vw_pedidos_fav p
                             where dataemissao between to_date(:P1_DE_ANTERIOR||' 00:00:00' ,'dd/mm/rrrr hh24:mi:ss' ) and to_date(:P1_ATE_ANTERIOR||' 23:59:59' ,'dd/mm/rrrr hh24:mi:ss')
                               and ( :P0_IDFILIALROMANCE = '999999999999' or p.idfilialromance = :P0_IDFILIALROMANCE )
                               and p.idsituacaoentrega  >= 20000
                               and p.tipopedido         != 'F'    -- sem favorita paris
                               and p.ididioma            = 1
                               and p.valorapagar_orig    > 0 
                               and NOT exists ( select 1
                                                from classificacoespedidos c  
                                                where idpedido = p.idpedido
                                                  and idcaracteristicapedido = 8 
                                                  and idvalorcaracteristica  = 16 ) 
                           )
                  loop
                    --
                    :P1_QUANTIDADETOTAL_ANOANTERIOR := nvl(A.quantidade,'0');
                    :P1_VALORTOTAL_ANOANTERIOR       := nvl(A.valorotal,'0,00');
                    --
                  end loop;
                  --
                  -- BUSCA DOS CANCELADOS - ANO ANTERIOR
                  --
                  for B in ( select trim(to_char(count(1),'999G999G999G999G990')) quantidade
                                  , TRIM(TO_CHAR(sum(p.valorapagar_orig*p.fatorconversao),'999G999G999G999G990D00')) valorotal 
                             from vw_pedidos_fav p
                             where dataemissao between to_date(:P1_DE_ANTERIOR||' 00:00:00' ,'dd/mm/rrrr hh24:mi:ss' ) and to_date(:P1_ATE_ANTERIOR||' 23:59:59' ,'dd/mm/rrrr hh24:mi:ss')
                               and ( :P0_IDFILIALROMANCE = '999999999999' or p.idfilialromance = :P0_IDFILIALROMANCE )
                               and p.idsituacaoentrega  >= 20000
                               and p.tipopedido         != 'F'    -- sem favorita paris
                               and p.ididioma            = 1
                               and p.valorapagar_orig         > 0
                               and exists ( select 1
                                            from classificacoespedidos c
                                            where c.idpedido               = p.idpedido
                                              and c.idcaracteristicapedido = 25 )
                               and NOT exists ( select 1
                                                from classificacoespedidos c  
                                                where idpedido = p.idpedido
                                                  and idcaracteristicapedido = 8 
                                                  and idvalorcaracteristica  = 16 )   )
                  loop
                    --
                    :P1_QTDCANECLADO_ANOANTERIOR   := nvl(B.quantidade,'0');
                    :P1_VALORCANECLADO_ANOANTERIOR := nvl(B.valorotal,'0,00');
                    --
                  end loop;
                  --
                  --
                  -- BUSCA DOS VÁLIDOS - ANO ANTERIOR
                  --
                  for C in ( select trim(to_char(count(1),'999G999G999G999G990')) quantidade
                                  , TRIM(TO_CHAR(sum(p.valorapagar*p.fatorconversao),'999G999G999G999G990D00')) valorotal 
                                  , TRIM(TO_CHAR(count(distinct idvendedora),'999G999G999G999G990')) qtdvendedoras
                             from vw_pedidos_fav p
                             where dataemissao between to_date(:P1_DE_ANTERIOR||' 00:00:00' ,'dd/mm/rrrr hh24:mi:ss' ) and to_date(:P1_ATE_ANTERIOR||' 23:59:59' ,'dd/mm/rrrr hh24:mi:ss')
                               and ( :P0_IDFILIALROMANCE = '999999999999' or p.idfilialromance = :P0_IDFILIALROMANCE )
                               and p.idsituacaoentrega  >= 20000
                               and p.tipopedido         != 'F'    -- sem favorita paris
                               and p.ididioma            = 1
                               and p.valorapagar_orig         > 0
                               and NOT exists ( select 1
                                                from classificacoespedidos c
                                                where c.idpedido               = p.idpedido
                                                  and c.idcaracteristicapedido = 25 )
                               and NOT exists ( select 1
                                                from classificacoespedidos c  
                                                where idpedido = p.idpedido
                                                  and idcaracteristicapedido = 8 
                                                  and idvalorcaracteristica  = 16 )  )
                  loop
                    --
                    :P1_QTDTOTAL_PEDIDOVALIDO      := nvl(C.quantidade,'0');
                    :P1_VALORTOTAL_PEDIDOVALIDO    := nvl(C.valorotal,'0,00');
                    :P1_CONSULTUNICAS_ANOANTERIOR  := NVL(C.qtdvendedoras,'0');
                    --
                  end loop;
                  --
                exception
                  when others then
                   null;
                end;
                
                
                
                ```
        }
        execution {
            sequence: 20
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 4441909927073134848
        }
    )

    process busca-totais-ano-atual (
        name: Busca totais ano atual
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  -- BUSCA DO TOTAL - ANO ATUAL
                  --
                  for a in ( select trim(to_char(count(distinct p.idpedido),'999G999G999G999G990')) quantidade
                                  , TRIM(TO_CHAR(round(sum(p.valorapagar*p.fatorconversao),2),'999G999G999G999G990D00')) valorotal 
                             from pedidos p
                             where trunc(p.dataemissao)  between to_date(:P1_DE) and to_date(:P1_ATE)
                               and ( :P0_IDFILIALROMANCE = '999999999999' or p.idfilialromance = :P0_IDFILIALROMANCE )
                               and p.idsituacaoentrega  >= 20000
                               and p.tipopedido         != 'F'    -- sem favorita paris
                               and p.valorapagar         > 0 
                               and p.datacancelamento is null
                               and NOT exists ( select 1
                                                from classificacoespedidos c  
                                                where idpedido = p.idpedido
                                                  and idcaracteristicapedido = 8 
                                                  and idvalorcaracteristica  = 16 ) 
                           )
                  loop
                    --
                    :P1_QUANTIDADETOTAL_ANOATUAL := nvl(A.quantidade,'0');
                    :P1_VALORTOTAL_ANOATUAL := nvl(A.valorotal,'0,00');
                    --
                  end loop;
                  --
                  -- BUSCA DOS CANCELADOS - ANO ATUAL
                  --
                  for B in ( select trim(to_char(count(1),'999G999G999G999G990')) quantidade
                                  , TRIM(TO_CHAR(sum(p.valorapagar_orig*p.fatorconversao),'999G999G999G999G990D00')) valorotal 
                             from vw_pedidos_fav_new p
                             where dataemissao  between to_date(:P1_DE||' 00:00:00' ,'dd/mm/rrrr hh24:mi:ss' ) and to_date(:P1_ATE||' 23:59:59' ,'dd/mm/rrrr hh24:mi:ss')
                               and ( :P0_IDFILIALROMANCE = '999999999999' or p.idfilialromance = :P0_IDFILIALROMANCE )
                               and p.idsituacaoentrega  >= 20000
                               and p.tipopedido         != 'F'    -- sem favorita paris
                               and p.valorapagar_orig         > 0
                               and p.datacancelamento is not null
                               and NOT exists ( select 1
                                                from classificacoespedidos c  
                                                where idpedido = p.idpedido
                                                  and idcaracteristicapedido = 8 
                                                  and idvalorcaracteristica  = 16 )   )
                  loop
                    --
                    :P1_QTDCANECLADO_ANOATUAL   := nvl(B.quantidade,'0');
                    :P1_VALORCANCELADO_ANOATUAL := nvl(B.valorotal,'0,00');
                    --
                  end loop;
                  --
                  --
                  -- BUSCA DOS VÁLIDOS - ANO ATUAL
                  --
                  for C in ( select trim(to_char(count(1),'999G999G999G999G990')) quantidade
                                  , TRIM(TO_CHAR(sum(p.valorapagar*p.fatorconversao),'999G999G999G999G990D00')) valorotal 
                                  , TRIM(TO_CHAR(count(distinct idvendedora),'999G999G999G999G990')) qtdvendedoras
                             from vw_pedidos_fav_new p
                             where trunc(dataemissao)  between to_date(:P1_DE)  and to_date(:P1_ATE)
                               and ( :P0_IDFILIALROMANCE = '999999999999' or p.idfilialromance = :P0_IDFILIALROMANCE )                     
                               and p.idsituacaoentrega  >= 20000
                               and p.tipopedido         != 'F'    -- sem favorita paris
                               and p.valorapagar         > 0
                               and p.datacancelamento is null
                               and NOT exists ( select 1
                                                from classificacoespedidos c  
                                                where idpedido = p.idpedido
                                                  and idcaracteristicapedido = 8 
                                                  and idvalorcaracteristica  = 16 )  )
                  loop
                    --
                    :P1_QTDTOTAL_PEDIDOVALIDOATUAL   := nvl(C.quantidade,'0');
                    :P1_VALORTOTAL_PEDVALIDOATUAL    := nvl(C.valorotal,'0,00');
                    :P1_CONSULTORASUNICAS_ATUAL      := nvl(C.qtdvendedoras,'0');
                    --
                  end loop;
                  --
                exception
                  when others then
                   null;
                end;
                
                
                
                ```
        }
        execution {
            sequence: 30
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 4441910191467134850
        }
    )

    process popula-campos (
        name: Popula campos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vid number;
                  vde date;
                  vate date;
                  vdia_1 varchar2(2);
                  vmes_1 varchar2(2);
                  vano_1 varchar2(4);
                  vdia_2 varchar2(2);
                  vmes_2 varchar2(2);
                  vano_2 varchar2(4);
                begin
                  --
                  if :P1_IDPEDAGIOREVISTA is null then
                    select max(idpedagiorevista )
                      into  :P1_IDPEDAGIOREVISTA
                      from pedagiosrevistas;
                  end if;
                  --
                  if :P1_TOP is null then
                    :P1_TOP := 20;
                  end if;
                
                  :P1_DE   := NVL(:P1_DE,TRUNC(SYSDATE));
                  :P1_ATE  := NVL(:P1_ATE,TRUNC(SYSDATE));
                  --
                  vde := :P1_DE;
                  vate := :P1_ATE;
                  --
                  vdia_1 := to_char(vde,'DD');
                  vmes_1 := to_char(vde,'MM');
                  vano_1 := to_char(vde,'RRRR')-1;
                  vdia_2 := to_char(vate,'DD');
                  vmes_2 := to_char(vate,'MM');
                  vano_2 := to_char(vate,'RRRR')-1;
                  vde := to_date(vdia_1||'/'||vmes_1||'/'||vano_1);
                  vate := to_date(vdia_2||'/'||vmes_2||'/'||vano_2);
                  --
                  :P0_IDFILIALROMANCE := nvl(:P0_IDFILIALROMANCE,'999999999999');
                  --
                  :P1_DE_ANTERIOR  := to_date(vde,'DD/MM/RRRR');
                  :P1_ATE_ANTERIOR := to_date(vate,'DD/MM/RRRR');
                  --
                exception
                  when others then
                      null;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 3973344393506627222
        }
    )

)

