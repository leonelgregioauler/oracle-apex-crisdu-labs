    region pedidos-por-canal-ano-anterior (
        name: Pedidos por Canal - Ano Anterior
        title: Valor de Pedidos por Canal - Ano Anterior
        type: chart
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        chart {
            type: donut
        }
        chartLayout {
            height: 400
        }
        performance {
            lazyLoading: true
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }
        tooltip {
            showValue: false
        }
        legend {
            position: top
        }

        series new (
            name: New
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select distinct decode( f.tipofilial , 'E','Estoque'
                                                , 'L','Loja'
                                                , 'S','Site'
                                                , 'V','Venda Direta'          
                                                , 'F','Favorita Paris'  
                                                , 'C','Call Center'
                                                , 'Outros - '||f.tipofilial ) ||' - Qtd: '||trim(to_char(emp.qtd,'999G999G990'))
                                                                              ||' - TM: '||trim(to_char(emp.tiketmedio,'999G999G999G990D00'))
                                                                              ||' - Valor: '||trim(to_char(nvl(ROUND(emp.valortotal),0),'999G999G999G990D00'))  empresa
                         , nvl(ROUND(emp.valortotal),0) valortotal
                    from ( select tipofilial
                                , sum(p.valorapagar*p.fatorconversao) valortotal  
                                , avg(p.valorapagar*p.fatorconversao) tiketmedio
                                , count(1) qtd
                           from vw_pedidos_fav p    
                              , favorita.filiaisfavorita ff
                           where dataemissao between to_date(:P1_DE_ANTERIOR||' 00:00:00' ,'dd/mm/rrrr hh24:mi:ss' ) and to_date(:P1_ATE_ANTERIOR||' 23:59:59' ,'dd/mm/rrrr hh24:mi:ss')
                             and ( :P0_IDFILIALROMANCE = '999999999999' or p.idfilialromance = :P0_IDFILIALROMANCE )  
                             and p.idfilialfavorita    = ff.idfilialfavorita              
                             and p.idsituacaoentrega  >= 20000
                             and p.tipopedido         != 'F'    -- sem favorita paris
                             and p.ididioma            = 1
                             and p.valorapagar_orig         > 0
                             and NOT exists ( select 1
                                              from classificacoespedidos c
                                              where c.idpedido               = p.idpedido
                                                and c.idcaracteristicapedido = 25 )  
                             and NOT exists ( select 1
                                              from classificacoespedidos c  
                                              where idpedido = p.idpedido
                                                and idcaracteristicapedido = 8 
                                                and idvalorcaracteristica  = 16 ) 
                             and exists ( select 1
                                          from roman.vw_filiais f
                                          where f.ativo    = 'S'
                                            --and f.tipofilial = 'D'
                                            and f.idfilial = p.idfilialromance)
                           group by ff.tipofilial ) emp
                       , favorita.filiaisfavorita f
                    where f.tipofilial = emp.tipofilial (+)  
                    order by 1
                    ```
                pageItemsToSubmit: [
                    P1_DE
                    P1_ATE
                ]
            }
            columnMapping {
                label: EMPRESA
                value: VALORTOTAL
            }
            label {
                show: true
                position: outsideSlice
                displayAs: value
            }
        )

    )

