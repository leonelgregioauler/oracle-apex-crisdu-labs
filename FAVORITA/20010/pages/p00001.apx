    region produtos-top-p1-top-mct (
        name: Produtos Top &P1_TOP. MCT
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeprodutodetalhado(idprodutodetalhado,1)  || ' - Qtd Total: '||quantidade||'. Qtd Pedidos: '||qtdpedidos nomeproduto
                    , to_char(round(valortotalvenda/1000,2),'999G999G990D00')||'K'  valortotalvendaK
                    , ROUND(valortotalvenda) valortotalvenda
                    , quantidade
                    , ROUND(MCT) MCT
                from (  select idprodutodetalhado
                             , sum(w.valortotalvenda*w.fatorconversao) valortotalvenda
                             , sum(w.quantidade) quantidade
                             , count(distinct idpedido) qtdpedidos
                             ,  ( select i.mct
                                   from favorita.itenspedagiosrevistas i
                                   where i.idprodutodetalhado = w.idprodutodetalhado 
                                     and i.idpedagiorevista = :P1_IDPEDAGIOREVISTA ) MCT
                        from vw_itenspedidos_fav w
                        where ididioma                        = 1 
                          and exists ( select i.mct
                                       from favorita.itenspedagiosrevistas i
                                       where i.idprodutodetalhado = w.idprodutodetalhado 
                                         and i.idpedagiorevista = :P1_IDPEDAGIOREVISTA )
                          and exists ( select 1
                                       from vw_pedidos_fav p
                                       where p.idpedido = w.idpedido
                                         and dataemissao  between to_date(:P1_DE||' 00:00:00' ,'dd/mm/rrrr hh24:mi:ss' )  and to_date(:P1_ATE||' 23:59:59' ,'dd/mm/rrrr hh24:mi:ss')
                                         and ( :P0_IDFILIALROMANCE = '999999999999' or p.idfilialromance = :P0_IDFILIALROMANCE )                     
                                         and p.idsituacaoentrega  >= 20000
                                         and p.tipopedido         != 'F'    -- sem favorita paris
                                         and p.ididioma            = 1
                                         and p.valorapagar_orig         > 0
                                         and NOT exists ( select 1
                                                          from classificacoespedidos c
                                                          where c.idpedido               = p.idpedido
                                                            and c.idcaracteristicapedido = 25 )  
                                         and NOT exists ( select 1
                                                          from classificacoespedidos c  
                                                          where idpedido = p.idpedido
                                                            and idcaracteristicapedido = 8 
                                                            and idvalorcaracteristica  = 16 ) ) 
                        group by idprodutodetalhado
                        order by 5 desc ) W
                 fetch first :P1_TOP rows only
                ```
            pageItemsToSubmit: P1_IDPEDAGIOREVISTA
        }
        layout {
            sequence: 160
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent15
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        comments {
            comments: Comentado em 04/08/2025 para atender o ticket 9954304
        }
        settings {
            labelColumn: NOMEPRODUTO
            valueColumn: MCT
            formatMask: 999G999G999G999G990
            barWidthCalculation: relative
            colorScheme: modern
            maximumRows: 30
        }
    )

    region quantidade-de-pedidos (
        name: "Quantidade de Pedidos "
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(p.idfilialromance) empresa
                     , COUNT(1) valorotal
                from vw_pedidos_fav p
                where dataemissao between to_date(:P1_DE||' 00:00:00' ,'dd/mm/rrrr hh24:mi:ss' )-365 and to_date(:P1_ATE||' 23:59:59' ,'dd/mm/rrrr hh24:mi:ss')-365
                  and p.datacancelamento is null
                  and ( :P0_IDFILIALROMANCE = '999999999999' or p.idfilialromance = :P0_IDFILIALROMANCE )                
                 and p.idsituacaoentrega  >= 20000
                 and p.tipopedido         != 'F'    -- sem favorita paris
                 and p.ididioma            = 1
                 and p.valorapagar_orig         > 0
                 and NOT exists ( select 1
                                  from classificacoespedidos c
                                  where c.idpedido               = p.idpedido
                                    and c.idcaracteristicapedido = 25 )  
                 and NOT exists ( select 1
                                  from classificacoespedidos c  
                                  where idpedido = p.idpedido
                                    and idcaracteristicapedido = 8 
                                    and idvalorcaracteristica  = 16 ) 
                group by p.idfilialromance
                order by 2 desc
                ```
