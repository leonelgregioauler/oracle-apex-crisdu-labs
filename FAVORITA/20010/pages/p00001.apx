page 1 (
    name: Home
    title: Home
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function doLoad()
            {
            setTimeout( "submit()", 60*1000 );
            }
            
            function submit()
            {
              apex.submit('SUBMIT');
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ano-anterior (
        name: Ano Anterior
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
    )

    region ano-atual (
        name: Ano Atual
        type: staticContent
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
        }
    )

    region dashboard (
        name: Dashboard
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(emp.idfilial) empresa
                     , ( select w.grupo from roman.vw_filiais w where w.idfilial = emp.idfilial ) grupo
                     , emp.qtd
                     , emp.tiketmedio 
                     , emp.valortotal 
                from ( select p.idfilialromance idfilial
                            , sum(p.valorapagar*p.fatorconversao) valortotal  
                            , avg(p.valorapagar*p.fatorconversao) tiketmedio
                            , count(1) qtd
                       from vw_pedidos_fav p
                       where dataemissao  between to_date(:P1_DE||' 00:00:00' ,'dd/mm/rrrr hh24:mi:ss' ) and to_date(:P1_ATE||' 23:59:59' ,'dd/mm/rrrr hh24:mi:ss')
                         and ( :P0_IDFILIALROMANCE = '999999999999' or p.idfilialromance = :P0_IDFILIALROMANCE )                  
                         and p.idsituacaoentrega  >= 20000
                         and p.tipopedido         != 'F'    -- sem favorita paris
                         and p.ididioma            = 1
                         and p.valorapagar_orig         > 0
                         and NOT exists ( select 1
                                          from classificacoespedidos c
                                          where c.idpedido               = p.idpedido
                                            and c.idcaracteristicapedido = 25 )  
                         and NOT exists ( select 1
                                          from classificacoespedidos c  
                                          where idpedido = p.idpedido
                                            and idcaracteristicapedido = 8 
                                            and idvalorcaracteristica  = 16 ) 
                         and exists ( select 1
                                      from roman.vw_filiais f
                                      where f.ativo    = 'S'
                                        --and f.tipofilial = 'D'
                                        and f.idfilial = p.idfilialromance)
                       group by p.idfilialromance
                       union
                       select c.idfilialromancedestino idfilial
                            , sum(v.valorvencimento) valortotal
                            , avg(v.valorvencimento) tiketmedio
                            , count(1) qtd
                       from vencimentoscomprastransf v
                          , comprastransferencias c
                       where c.idcompratransferencia = v.idcompratransferencia
                         and v.valorvencimento > 0
                         and v.situacaovencimento = 'V'
                         and ( :P0_IDFILIALROMANCE = '999999999999' or c.idfilialromancedestino = :P0_IDFILIALROMANCE )
                         and exists ( select 1
                                      from pedidos p
                                         , pedidosremessasct pr
                                      where p.idpedido = pr.idpedido
                                        and pr.idcompratransferencia = v.idcompratransferencia
                                        and p.datacancelamento is null
                                        and p.idsituacaoentrega  >= 20000
                                        and dataemissao between to_date(:P1_DE||' 00:00:00' ,'dd/mm/rrrr hh24:mi:ss' ) and to_date(:P1_ATE||' 23:59:59' ,'dd/mm/rrrr hh24:mi:ss') )
                       group by c.idfilialromancedestino 
                       union
                       select w.idfilial
                            , 0 valortotal
                            , 0 ticketmedio
                            , 0 qtd
                       from roman.vw_filiais   w
                       where tipofilial = 'D'
                         and ativo      = 'S'
                         and not exists ( select 1
                                          from vw_pedidos_fav p
                                          where dataemissao  between to_date(:P1_DE||' 00:00:00' ,'dd/mm/rrrr hh24:mi:ss' ) and to_date(:P1_ATE||' 23:59:59' ,'dd/mm/rrrr hh24:mi:ss')
                                            and ( :P0_IDFILIALROMANCE = '999999999999' or p.idfilialromance = :P0_IDFILIALROMANCE )
                                             and NOT exists ( select 1
                                                              from classificacoespedidos c  
                                                              where idpedido = p.idpedido
                                                                and idcaracteristicapedido = 8 
                                                                and idvalorcaracteristica  = 16 ) 
                                            and p.idsituacaoentrega  >= 20000
                                            and p.idfilialromance  = w.idfilial )
                         and not exists ( select 1
                                          from vencimentoscomprastransf v
                                             , comprastransferencias c
                                          where c.idcompratransferencia = v.idcompratransferencia
                                            and v.valorvencimento > 0
                                            and v.situacaovencimento = 'V'
                                            and ( :P0_IDFILIALROMANCE = '999999999999' or c.idfilialromancedestino = :P0_IDFILIALROMANCE )
                                            and exists ( select 1
                                                         from pedidos p
                                                            , pedidosremessasct pr
                                                         where p.idpedido = pr.idpedido 
                                                           and p.idfilialfavorita = w.idfilial
                                                           and pr.idcompratransferencia = v.idcompratransferencia
                                                           and p.datacancelamento is null
                                                           and p.idsituacaoentrega  >= 20000
                                                           and dataemissao between to_date(:P1_DE||' 00:00:00' ,'dd/mm/rrrr hh24:mi:ss' ) and to_date(:P1_ATE||' 23:59:59' ,'dd/mm/rrrr hh24:mi:ss') ) )
                       ) emp
                order by 1
                ```
        }
        layout {
            sequence: 120
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                js-useLocalStorage
                is-collapsed
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 4608587368639802707
        }

