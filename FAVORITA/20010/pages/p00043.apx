page 43 (
    name: Aderência
    title: Aderência
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region aderência-à-escala-de-trabalho (
        name: Aderência à Escala de Trabalho
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select atendente
                     , sistema
                     , "ENTRADA PREVISTA"
                     , "SAÍDA PREVISTA"
                     , decode("HORA DE LOGIN",null,'AUSENTE',"HORA DE LOGIN") "ENTRADA EFETIVA"
                     , "TIPO DE ESCALA"
                  from BEEWEB.VW_ADERENCIA_LISTA
                 order by decode("HORA DE LOGIN",null,0,1) desc, atendente
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--noBorders
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 2938182870104273933
        }

        column ATENDENTE (
            type: plainText
            heading {
                heading: Atendente
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column "ENTRADA EFETIVA" (
            type: plainText
            heading {
                heading: Entrada Efetiva
            }
            layout {
                sequence: 70
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column "ENTRADA PREVISTA" (
            type: plainText
            heading {
                heading: Entrada Prevista
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column "SAÍDA PREVISTA" (
            type: plainText
            heading {
                heading: Saída Prevista
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column SISTEMA (
            type: plainText
            heading {
                heading: Sistema
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column "TIPO DE ESCALA" (
            type: plainText
            heading {
                heading: Tipo de Escala
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 29783669 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ATENDENTE (
                sequence: 1
            )

            displayColumn "ENTRADA EFETIVA" (
                sequence: 6
            )

            displayColumn "ENTRADA PREVISTA" (
                sequence: 3
            )

            displayColumn "SAÍDA PREVISTA" (
                sequence: 4
            )

            displayColumn SISTEMA (
                sequence: 2
            )

            displayColumn "TIPO DE ESCALA" (
                sequence: 5
            )

        )

    )

)

