page 84 (
    name: Pagamentos de Comissões Realizado
    title: Pagamentos de Comissões Realizado
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region pagamentos-realizados (
        name: Pagamentos Realizados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pp.idpedido nr_pedido
                     , pp.idvencimentopedido cod_vencimento
                     , vc.datavencimento data_do_vencimento
                     , pp.datapagamento
                     , pp.valorpago
                     , pp.idfechamentorepres cod_acerto
                     , fr.semana semana_acerto
                from pagamentocomissoes pp
                   , roman.fechamentorepresentantes fr
                   , vencimentospedidos vc
                where pp.idrepresentante = :P84_IDREPRESENTANTE
                  and pp.idfechamentorepres = fr.idfechamentorepres
                  and vc.idvencimentopedido = pp.idvencimentopedido
                  and pp.idgerente is null
                  and pp.datapagamento between to_date(:P84_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') 
                                           and to_date(:P84_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') 
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-showMaximizeButton
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1095776838449186642
        }

        column COD_ACERTO (
            type: plainText
            heading {
                heading: Cod Acerto
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column COD_VENCIMENTO (
            type: plainText
            heading {
                heading: Cod Vencimento
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column DATAPAGAMENTO (
            type: plainText
            heading {
                heading: Paga em
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        column DATA_DO_VENCIMENTO (
            type: plainText
            heading {
                heading: Data Do Vencimento
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column NR_PEDIDO (
            type: plainText
            heading {
                heading: Nr Pedido
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column SEMANA_ACERTO (
            type: plainText
            heading {
                heading: Semana Acerto
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column VALORPAGO (
            type: plainText
            heading {
                heading: Valor
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 36245952 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100000
            }

            displayColumn COD_ACERTO (
                sequence: 6
            )

            displayColumn COD_VENCIMENTO (
                sequence: 2
            )

            displayColumn DATAPAGAMENTO (
                sequence: 4
            )

            displayColumn DATA_DO_VENCIMENTO (
                sequence: 3
            )

            displayColumn NR_PEDIDO (
                sequence: 1
            )

            displayColumn SEMANA_ACERTO (
                sequence: 7
            )

            displayColumn VALORPAGO (
                sequence: 5
            )

            aggregate (
                column: VALORPAGO
            )

            controlBreak (
                column: COD_ACERTO
                layout {
                    sequence: 1
                }
            )

            controlBreak (
                column: SEMANA_ACERTO
                layout {
                    sequence: 2
                }
            )

        )

    )

    pageItem P84_DATAFIM (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @pagamentos-realizados
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P84_DATAINICIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @pagamentos-realizados
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P84_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @pagamentos-realizados
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

