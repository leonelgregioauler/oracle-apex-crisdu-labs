page 2 (
    name: Gerencial
    title: Gerencial
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function doLoad()
            {
            setTimeout( "refresh()", 120*1000 );
            }
            
            function refresh()
            {
            window.location.href = window.location;
            }
            ```
        executeWhenPageLoads: doLoad()
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
    )

    region navegação (
        name: Navegação
        type: regionDisplaySelector
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            rememberSelection: bySession
        }
    )

    region quantidade-de-pedidos-últimos-30-dias (
        name: Quantidade de Pedidos últimos 30 dias
        type: chart
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent7
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: line
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        animation {
            onDataChange: none
        }
        legend {
            hideAndShowBehavior: none
        }

        series quantidade (
            name: Quantidade
            execution {
                sequence: 20
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select 'Quantidade' nome
                         , trunc(p.dataemissao) data
                         , count(1) valor
                    from vw_pedidos_fav p
                    where p.idsituacaoentrega >= 20000
                      and trunc(p.dataemissao) >= trunc(sysdate) -30
                      and ididioma            = 1
                      and p.datacancelamento is null
                    group by trunc(p.dataemissao)
                    ```
            }
            columnMapping {
                seriesName: NOME
                label: DATA
                value: VALOR
            }
        )

        axis x (
            name: x
            value {
                format: dateShort
            }
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Quantidade
            value {
                format: decimal
            }
            minorTicks {
                show: false
            }
        )

    )

    region resumo-pedidos-gerencial-liquido (
        name: Resumo Pedidos - Gerencial Liquido
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idfilialromance
                     , p.filialromance
                     , sum(p.valortotal*p.fatorconversao) valortotal
                     , '|'  s1
                     , sum(p.valorapagar*p.fatorconversao) valorareceber
                     , '-' s2
                     , sum(p.valorcusto*p.fatorconversao) custo
                     , '-' s3
                     , sum(p.comissaodistribuidor*p.fatorconversao) comissao
                     , '-' s4
                     , sum(p.comissaogerente*p.fatorconversao) comissaogerente
                     , '-' s5
                     , nvl( ( select sum(o.valororcamento)
                               from orcamentosfretecomprastransf o
                                  , comprastransferencias        c
                               where o.utilizado              = 'S'
                                 and c.idcompratransferencia  = o.idcompratransferencia 
                                 and trunc(c.dataemissao )    between to_date(:P2_DE) and to_date(:P2_ATE)
                                 and c.idfilialromancedestino = p.idfilialromance ) ,0) custotransporte
                     , '=' s6
                     , ( sum(p.valorapagar*p.fatorconversao) 
                       - sum(p.valorcusto*p.fatorconversao) 
                       - sum(p.comissaodistribuidor*p.fatorconversao) 
                       - sum(p.comissaogerente*p.fatorconversao) 
                       - nvl( ( select sum(o.valororcamento)
                                from orcamentosfretecomprastransf o
                                   , comprastransferencias        c
                                where o.utilizado              = 'S'
                                  and c.idcompratransferencia  = o.idcompratransferencia 
                                  and trunc(c.dataemissao )    between to_date(:P2_DE) and to_date(:P2_ATE)
                                  and c.idfilialromancedestino = p.idfilialromance ) ,0) ) liquido
                from vw_pedidos_fav p
                where trunc(dataemissao ) between to_date(:P2_DE) and to_date(:P2_ATE)
                  and ididioma            = 1
                  and p.datacancelamento is null
                group by idfilialromance
                       , filialromance
                ```
            pageItemsToSubmit: [
                P2_DE
                P2_ATE
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent9
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        advanced {
            savedReportMappingIdentifier: 235432894263696704
        }

