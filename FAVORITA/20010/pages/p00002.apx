    region valor-de-pedidos-últimos-30-dias (
        name: Valor de Pedidos últimos 30 dias
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select trunc(p.dataemissao) data
                     , count(1) qtd
                from vw_pedidos_fav p
                where p.idsituacaoentrega > 20000
                  and trunc(p.dataemissao) >= trunc(sysdate) -60
                  and ididioma            = 1
                  and p.datacancelamento is null
                group by trunc(p.dataemissao)
                order by 1
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: line
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        animation {
            onDataChange: none
        }
        legend {
            hideAndShowBehavior: none
        }

        series valor (
            name: Valor
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select 'Valor' nome
                         , trunc(p.dataemissao) data
                         , sum(p.valorapagar) valor
                    from vw_pedidos_fav p
                    where p.idsituacaoentrega >= 20000
                      and trunc(p.dataemissao) >= trunc(sysdate) -30
                      and ididioma            = 1
                      and p.datacancelamento is null
                    group by trunc(p.dataemissao)
                    order by 1
                    ```
            }
            columnMapping {
                seriesName: NOME
                label: DATA
                value: VALOR
            }
        )

        axis x (
            name: x
            title: Dia
            value {
                format: dateShort
            }
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Valor
            value {
                format: decimal
            }
            minorTicks {
                show: false
            }
        )

    )

