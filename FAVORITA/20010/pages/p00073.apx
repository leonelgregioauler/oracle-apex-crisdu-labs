page 73 (
    name: Acompanhamentos de Pagamentos
    title: Acompanhamentos de Pagamentos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region acompanhamento-dos-pagamentos (
        name: Acompanhamento dos Pagamentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(p.idfilialfavorita) Loja
                     , trunc(pp.datapagamento) datapagamento
                     , count(1) qtd_pagamentos
                     , sum(( select count(1)
                             from pagamentospedidos pag
                             where pag.idvencimentopedido = v.idvencimentopedido
                               and pag.idsituacao = 20
                               and trunc(pag.datapagamento) between to_date(:P73_DATAINICIO,'DD/MM/RRRR') and to_date(:P73_DATAFIM,'DD/MM/RRRR')
                               and pag.idformapagamento in (3,21) )) qtd_pago_cartao
                from pedidos p
                   , vencimentospedidos v
                   , pagamentospedidos pp
                where v.idvencimentopedido = pp.idvencimentopedido
                  and p.idpedido = v.idpedido
                  and exists ( select 1
                               from filiaisfavorita ff
                               where ff.idfilialfavorita = p.idfilialfavorita
                                 and ff.tipofilial = 'L' )
                  and trunc(pp.datapagamento) between to_date(:P73_DATAINICIO,'DD/MM/RRRR') and to_date(:P73_DATAFIM,'DD/MM/RRRR')
                  and p.datacancelamento is null
                group by idfilialfavorita, trunc(pp.datapagamento)
                
                ```
            pageItemsToSubmit: [
                P73_DATAINICIO
                P73_DATAFIM
            ]
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum pagamento encontrado, verifique os filtros!
        }
        advanced {
            savedReportMappingIdentifier: 890093627198824106
        }

        column DATAPAGAMENTO (
            type: plainText
            heading {
                heading: Data Pagamento
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        column LOJA (
            type: plainText
            heading {
                heading: Loja
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column QTD_PAGAMENTOS (
            type: plainText
            heading {
                heading: Qtd Pagamentos
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column QTD_PAGO_CARTAO (
            type: plainText
            heading {
                heading: Qtd Pago Cartao
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 8902057 (
            visibility: primaryDefault
            view {
                pivot: true
                default: pivot
                rowsPerPage: 100000
            }

            displayColumn APXWS_CC_001 (
                sequence: 4
            )

            displayColumn DATAPAGAMENTO (
                sequence: 5
            )

            displayColumn LOJA (
                sequence: 1
            )

            displayColumn QTD_PAGAMENTOS (
                sequence: 2
            )

            displayColumn QTD_PAGO_CARTAO (
                sequence: 3
            )

            computation APXWS_CC_001 (
                identifier: C01
                source {
                    expression:
                        ```sql
                        case when  C > 0 then
                           round( (C / B) *100,2) 
                        end
                        ```
                    dataType: number
                }
                label {
                    column: % de PGTO Diferente
                }
            )

            pivotColumn (
                column: DATAPAGAMENTO
                layout {
                    sequence: 1
                }
            )

            pivotRowColumn (
                column: LOJA
                layout {
                    sequence: 1
                }
            )

            pivotAggregate ir-pivot-agg (
                heading: % de Diferenças
                aggregate {
                    function: median
                    column: APXWS_CC_001
                }
                appearance {
                    formatMask: 999G999G999G999G990
                }
                layout {
                    sequence: 3
                }
            )

            pivotAggregate ir-pivot-agg-2 (
                heading: Qtd Pagamentos
                aggregate {
                    function: sum
                    column: QTD_PAGAMENTOS
                }
                appearance {
                    formatMask: 999G999G999G999G990
                }
                layout {
                    sequence: 1
                }
            )

            pivotAggregate ir-pivot-agg-3 (
                heading: Qtd Pagamentos Cartão
                aggregate {
                    function: sum
                    column: QTD_PAGO_CARTAO
                }
                appearance {
                    formatMask: 999G999G999G999G990
                }
                layout {
                    sequence: 2
                }
            )

            pivotSort (
                column: LOJA
                sort {
                    sequence: 1
                }
            )

        )

    )

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P73_DATAFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 20
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P73_DATAINICIO (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 20
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P73_DATAFIM
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-ini (
        name: Refresh_Ini
        execution {
            sequence: 1
        }
        when {
            selectionType: items
            items: P73_DATAINICIO
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process popula-data (
        name: Popula Data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  :P73_DATAINICIO := trunc(sysdate);
                  :P73_DATAFIM := trunc(sysdate);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 890094589465824115
        }
        serverSideCondition {
            type: itemIsNull
            item: P73_DATAINICIO
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 73
                items: {
                    P73_DATAINICIO: &P73_DATAINICIO.
                    P73_DATAFIM: &P73_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: FILTRAR
        }
    )

)

