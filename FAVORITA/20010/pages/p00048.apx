page 48 (
    name: Estoque
    title: Estoque
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region estoques (
        name: Estoques
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(es.idfilialfavorita) estoque
                     , pck_util_fav.fnc_nomeprodutodetalhado( es.idprodutodetalhado,1) produto
                     , pck_estoque_fav.fnc_estoquedisponivel(pidestoque => es.idestoque) quantidade
                 from estoques es
                    , produtosdetalhados p
                 where es.idprodutodetalhado = p.idprodutodetalhado
                   and p.idproduto           = :P48_IDPRODUTO
                   and ( :P48_IDPRODUTODETALHADO is null or p.idprodutodetalhado = :P48_IDPRODUTODETALHADO)
                 --  and pck_estoque_fav.fnc_estoquedisponivel(pidestoque => es.idestoque)  > 0
                   and (( :P48_TIPOFILIAL = 'L' and ( (:P48_IDFILIALFAVORITA is null and exists ( select 1
                                                                                               from favorita.filiaisfavorita fili
                                                                                               where fili.tipofilial = 'L' 
                                                                                                 and fili.idfilialfavorita = es.idfilialfavorita )) 
                                                  or es.idfilialfavorita  = :P48_IDFILIALFAVORITA )  ) 
                    or ( :P48_TIPOFILIAL = 'E' and ( ( :P48_IDFILIALFAVORITA  is null and  exists ( select 1
                                                                                                   from favorita.filiaisfavorita fili
                                                                                                   where fili.tipofilial  = 'E'
                                                                                                     and fili.idfilialfavorita = es.idfilialfavorita 
                                                                                                     and fili.idpais   = :P48_IDPAIS) )
                                                   or  ( es.idfilialfavorita  = :P48_IDFILIALFAVORITA )
                                                                                                  /* 16/06/2020 -- retirada opção de mostrar a venda das lojas junto quando for filtrado CD
                                                                                                         Reunião com Ezequias, Everton, Patricia e Bruno 
                                                                                                         in ( select afr.IDFILIALFAVORITADESTINO
                                                                                                               from favorita.atendimentosestoques afr
                                                                                                               where afr.idfilialfavoritaorigem = :P48_IDFILIALFAVORITA  )*/ ) ) 
                    or ( :P48_TIPOFILIAL = 'O' and ( (:P48_IDFILIALFAVORITA is null and not exists ( select 1
                                                                                                   from favorita.filiaisfavorita fili
                                                                                                   where fili.tipofilial in ('E', 'L' )
                                                                                                     and fili.idfilialfavorita = es.idfilialfavorita )) 
                                                  or es.idfilialfavorita  = :P48_IDFILIALFAVORITA )  )
                    or ( :P48_TIPOFILIAL = 'T' ))
                ```
            pageItemsToSubmit: [
                P48_IDPRODUTO
                P48_IDPRODUTODETALHADO
                P48_TIPOFILIAL
                P48_IDFILIALFAVORITA
                P48_IDPAIS
            ]
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 4531305206927922441
        }

        column ESTOQUE (
            type: plainText
            heading {
                heading: Estoque
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column PRODUTO (
            type: plainText
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column QUANTIDADE (
            type: plainText
            heading {
                heading: Quantidade
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 45333665 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ESTOQUE (
                sequence: 1
            )

            displayColumn PRODUTO (
                sequence: 2
            )

            displayColumn QUANTIDADE (
                sequence: 3
            )

            sort (
                column: ESTOQUE
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: QUANTIDADE
            )

            controlBreak (
                column: PRODUTO
                layout {
                    sequence: 1
                }
            )

        )

    )

    pageItem P48_IDFILIALFAVORITA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @estoques
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P48_IDPAIS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @estoques
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P48_IDPRODUTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @estoques
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P48_IDPRODUTODETALHADO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @estoques
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P48_TIPOFILIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @estoques
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

