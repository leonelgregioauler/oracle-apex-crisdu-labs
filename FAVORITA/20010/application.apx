app F_20010 (
    name: B.I. Favorita 2.0
    version: release 1.0
    logo {
        type: text
        text: B.I. Favorita 2.0
    }
    navigation {
        homeUrl: {
            page: 59
        }
        loginUrl: {
            page: LOGIN_DESKTOP
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: #DEFAULT#
        list: @menu-de-navegação
    }
    navigationBar {
        list: @desktop-navigation-bar
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
    }
    appFormatMasks {
        date: DD/MM/YYYY
        dateTime: DD/MM/YYYY HH24:MI:SS
        timestamp: DD/MM/YYYY HH24:MI:SS
        timestampTimeZone: DD/MM/YYYY HH24:MI:SS
    }
    javaScript {
        includeLegacyJavascript: 18
        includeJqueryMigrate: true
    }
    authentication {
        scheme: @database
        publicUser: APEX_PUBLIC_USER
    }
    authorization {
        sourceForRoleOrGroupSchemes: authenticationScheme
    }
    security {
        referrerPolicy: strictOriginWhenCrossOrigin
        allowBotAccess: true
    }
    sessionStateProtection {
        bookmarkHashFunction: sha1
        acceptPre202UrlChecksums: false
    }
    sessionManagement {
        sessionStateCommits: immediate
    }
    globalization {
        primaryLanguage: pt-br
        documentDirection: leftToRight
        autoCsvEncoding: false
    }
    progressiveWebApp {
        enable: false
    }
    rowSearch {
        tokenize: false
    }
    reportPrinting {
        type: useInstanceSettings
    }
    runtime {
        friendlyUrls: false
        compatibilityMode: 21.2
        accessibleReadOnlyItems: false
    }
    advanced {
        passEcid: false
        modernizeApp: true
    }
)

