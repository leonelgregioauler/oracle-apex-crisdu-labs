page 244 (
    name: Entradas Diversas
    title: Entradas Diversas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region entradas (
        name: Entradas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select Filial
                     , ano "Ano"
                     , semana "Semana"
                     , w.idfechamento
                     , idfilial
                     , Filialorig--"Filial Origem"
                     , Filialdestino
                     , mes "Mês"
                     , fechamentoorig
                     , conta
                     , subconta
                     , valortotal
                     , descricao
                     , Tipo
                     , descricaoorigem "Descrição da Origem"
                     , data "Data"
                     , replace(to_char(data,'MM/YYYY'),' ','') meslancamento
                     , w.tipoentrada "Tipo Entrada"
                     , w.identrada
                from roman.vw_entradas_distribuidoras w
                where exists ( select 1
                               from fechamentossemanais f
                               where f.idfechamento = w.idfechamento
                                 and f.idfilialfavorita = :P0_IDFILIALCAIXA )
                  and (:P0_IDFECHAMENTO = 999999999999 
                        or idfechamento = :P0_IDFECHAMENTO )
                order by data desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhuma entrada confirmada.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 5000398317536695234
        }

