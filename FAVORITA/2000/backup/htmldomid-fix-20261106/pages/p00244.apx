    button novaentrada (
        buttonName: NOVAENTRADA
        label: Nova Entrada
        layout {
            sequence: 10
            region: @entradas
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 635
                items: {
                    P635_IDFILIAL: &P0_IDFILIAL.
                    P635_IDFECHAMENTO: &P0_IDFECHAMENTO.
                }
                clearCache: 635
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentossemanais s
                where idfechamento = :P0_IDFECHAMENTO
                  and concluido = 'N'
                ```
        }
    )

)

