        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nomefilialfavorita
                     , f.idfilialfavorita
                from vw_filiaisfavorita f
                where f.tipofilial = 'Loja'
                  and f.ativo = 'Sim'
                order by 1;
                ```
