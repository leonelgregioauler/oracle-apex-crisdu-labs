    region relatório-de-questionamentos (
        name: Relatório de Questionamentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select q.idquestionamento
                     , q.datainclusao
                     , q.usuario
                     , q.idfilialfavorita
                     , pck_util_fav.fnc_nomefilialfavorita(q.idfilialfavorita) filial
                     , q.idpessoa
                     , roman.pck_romance.fnc_nomepessoa(q.idpessoa) pessoa
                     , q.questionamento
                     , q.resposta
                     , q.confirmacaoleitura
                     , decode(q.confirmacaoleitura,'S','Sim','N','Não') descconfirmacaoleitura
                     , q.dataleitura
                     , q.usuarioleitura
                     , nvl(( select 'Semana: '||f.semana||' - Cod: '||f.idfechamento
                             from fechamentossemanais f
                             where f.idfechamento = q.idfechamento ),'Sem Fechamento') fechamento
                     , q.conferido
                     , decode(q.conferido,'S','Sim','N','Não') descconferido
                     , dataconferencia
                     , usuarioconferencia
                     , decode(q.origem,'D','Despesa','S','Saída','X','Depósito') origem
                from roman.questionamentoscontroladoria q
                where q.idfilialfavorita is not null
                  and ( :P439_TIPODATA is null  
                      or ( :P439_TIPODATA = 'I' and trunc(q.datainclusao) between to_date(:P439_DATAINICIO) and to_date(:P439_DATAFIM) )
                      or ( :P439_TIPODATA = 'L' and trunc(q.dataleitura) between to_date(:P439_DATAINICIO) and to_date(:P439_DATAFIM) ) 
                      or ( :P439_TIPODATA = 'R' and trunc(q.dataconferencia) between to_date(:P439_DATAINICIO) and to_date(:P439_DATAFIM) ) )
                  and ( :P439_IDFILIALFAVORITA is null or q.idfilialfavorita = :P439_IDFILIALFAVORITA )
                  and ( :P439_LEITURA is null or nvl(q.confirmacaoleitura,'N') = :P439_LEITURA )
                  and ( :P439_REVISADO is null or nvl(q.conferido,'N') = :P439_REVISADO )
                order by 1 desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select *
                from roman.usuariosgruposatendimento ug
                where ug.idgrupoatendimento in (2)
                  and ug.usuario = v('APP_USER')
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
