    region acompanhamento-de-questionamentos (
        name: "Acompanhamento de Questionamentos "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select q.idquestionamento
                     , q.datainclusao
                     , q.usuario
                     , q.idfilial
                     , pck_util_fav.fnc_nomefilialfavorita(q.idfilialfavorita) filial
                     , q.idpessoa
                     , roman.pck_romance.fnc_nomepessoa(q.idpessoa) pessoa
                     , q.questionamento
                     , q.resposta
                     , q.confirmacaoleitura
                     , decode(q.confirmacaoleitura,'S','Sim','N','Não') descconfirmacaoleitura
                     , q.dataleitura
                     , q.usuarioleitura
                     , nvl(( select 'Semana: '||f.semana||' - Cod: '||f.idfechamento
                             from fechamentossemanais f
                             where f.idfechamento = q.idfechamento ),'Sem Fechamento') fechamento
                from roman.questionamentoscontroladoria q
                where ( (:P439_TIPO = 'P' and ( nvl(q.confirmacaoleitura,'N') = 'N'
                                             or ( nvl(q.confirmacaoleitura,'N') = 'S'
                                                and q.resposta is null ) ) )
                     or (:P439_TIPO = 'R' and q.confirmacaoleitura = 'S'
                                          and q.resposta is not null ) )
                  -- 10055921 - Maicon Aimi - 27/03/2025 -- Comentado para atender o ticket 10055921
                  --and q.confirmarenvio = 'S'
                  and q.idfilialfavorita is not null
                  and ( ( q.idpessoa = ( select idpessoa
                                         from usuarios u
                                         where u.usuario = v('APP_USER') ) )
                     or ( q.idfilialfavorita = :P439_IDFILIAL ) )
                order by 1 desc
                ```
            pageItemsToSubmit: [
                P439_TIPO
                P439_IDFILIAL
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where not exists ( select 1
                                   from roman.usuariosgruposatendimento ug
                                   where ug.idgrupoatendimento in (2)
                                     and ug.usuario = v('APP_USER') )
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum registro encontrado.
        }
        advanced {
            savedReportMappingIdentifier: 1475970975348918355
        }

