    process operação-dml-em-compras-e-transferências (
        name: Operação DML em Compras e Transferências
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                  vobservacao varchar2(4000);
                  vtotalcompra number(15,2) := replace(:P74_VALORTOTALCOMPRA,'.','');
                  vdataemissaoinicial date := to_date(:P74_DATAEMISSAOINICIAL,'DD/MM/RRRR HH24:MI:SS');
                  vdataemissaofinal date := to_date(:P74_DATAEMISSAOFINAL,'DD/MM/RRRR HH24:MI:SS');
                  vidordemcompra number;
                  --
                  vremessaAL varchar2(1) := 'N';
                  --
                begin
                  --
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                    :P74_IDUSUARIO := :P0_IDUSUARIO;
                    -- processo para salvar o idfilialromance nos casos da favorita paris
                    begin
                      --
                      select ff.idfilialromance
                      into :P74_IDFILIALROMANCEDESTINO
                      from favorita.filiaisfavorita ff
                      where ff.idfilialfavorita = :P74_IDFILIALFAVORITADESTINO
                        and ff.tipofilial = 'F';
                      --
                    exception
                      when others then null;
                    end;
                    --
                    --
                    -- Alterado por Cesar Hunning - 07/11/2023
                    -- Projeto "Remessas Alternativas América Latina"
                    -- 
                    -- Solicitei ao Cleber verificar se para Urugai também será por parâmetro ou se serão todas.
                    begin
                      select valor
                        into vremessaAL
                        from parametros 
                       where idfilialromance = :P74_IDFILIALROMANCEDESTINO
                         and nome = 'REMESSASAMERICALATINA';
                    exception
                      when others then vremessaAL := 'N';
                    end;
                    --
                    -- Se for filiai do Uruguai e Paraguai, altera a situaçao diretamente para 'Aguardando Montagem de Pedidos
                    if vremessaAL = 'S'                and 
                       :P74_IDENTIFICACAOINTERNA = 'L' and
                       v('REQUEST') = 'INSERIR'        then -- L=Remessa Alternativa
                       --
                      :P74_IDSITUACAO := 1; --'Aguardando Montagem de Pedidos'
                      :P74_ANALISECONCLUIDA := 'S'; -- A análise já foi feita na remessa mãe
                      --
                    end if;
                    --
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  if v('REQUEST') != 'CANCELAR' then
                    --
                    --raise_application_error(-20001,' identificacaointerna='||:P74_IDENTIFICACAOINTERNA||' analise='||:P74_ANALISECONCLUIDA);
                    
                    pck_comprastransf_fav.prc_comprastransferencias( pidcompratransferencia   => :P74_IDCOMPRATRANSFERENCIA,
                                                                  pidfornecedor            => :P74_IDFORNECEDOR,
                                                                  pidfilialfavoritaorigem  => :P74_IDFILIALFAVORITAORIGEM,
                                                                  pidfilialfavoritadestino => :P74_IDFILIALFAVORITADESTINO,
                                                                  pidfilialromancedestino  => :P74_IDFILIALROMANCEDESTINO,
                                                                  pidpostoavancadodestino  => :P74_IDPOSTOAVANCADODESTINO,
                                                                  pnumero                  => :P74_NUMERO,
                                                                  pidsituacao              => :P74_IDSITUACAO,
                                                                  pnotafiscal              => :P74_NOTAFISCAL,
                                                                  pdataemissao             => :P74_DATAEMISSAO,
                                                                  pdatarecebimento         => :P74_DATARECEBIMENTO,
                                                                  pdataembarque            => :P74_DATAEMBARQUE,
                                                                  pdataprevisaoentrega     => :P74_DATAPREVISAOENTREGA,
                                                                  pvalortotalcompra        => vtotalcompra,
                                                                  pcubagem                 => :P74_CUBAGEM,
                                                                  pvolume                  => :P74_VOLUME,
                                                                  ppeso                    => :P74_PESO,
                                                                  pobservacao              => :P74_OBSERVACAO,
                                                                  pidtipo                  => :P74_TIPO,
                                                                  poperacao_dml            => voperacao_dml,
                                                                  pmd5                     => :P74_MD5,
