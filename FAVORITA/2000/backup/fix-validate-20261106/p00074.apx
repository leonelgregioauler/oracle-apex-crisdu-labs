    pageItem P74_IDCOMPRATRANSFNOVA (
        type: selectList
        label {
            label: Remessas Disponíveis
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select numero||' - '|| pck_util_fav.fnc_retornatipocomptransrem(c.idtipocomptransrem,:P0_IDIDIOMA)
                             ||'('  ||decode(identificacaointerna,'N','Normal','A','Antecipada','L','Alternativa')
                             ||') - '||decode(analiseconcluida,'S','Concluida','Em Analise')
                             ||' - '||roman.pck_romance.fnc_nomepostoavancado(c.idpostoavancadodestino)display_value
                 , idcompratransferencia return_value
                from comprastransferencias c
                where ( idfilialromancedestino = :P74_IDFILIALROMANCEDESTINO
                      or exists ( select 1
                                  from atendimentosfiliaisrmc a
                                  where a.idfilialfavoritaorigem = c.idfilialfavoritadestino
                                    and a.idfilialdestino        = :P74_IDFILIALROMANCEDESTINO )
                      or exists ( select 1
                                  from atendimentosfiliaisrmc a
                                  where a.idfilialdestino = :P74_IDFILIALROMANCEDESTINO
                                  and a.idfilialfavoritaorigem = c.idfilialfavoritaorigem
                                  and c.idfilialromancedestino = 200  )   
                      and (:P74_IDPOSTOAVANCADODESTINO is null or idpostoavancadodestino = :P74_IDPOSTOAVANCADODESTINO ) )
                 /* and idtipocomptransrem = ( select idvalorcaracteristica
                                             from classificacoespedidos cp
                                             where cp.idpedido = :P74_IDPEDIDO
                                               and cp.idcaracteristicapedido = 19 ) */
                  and idsituacao in (0,1,2)
                  and idcompratransferencia != :P74_IDCOMPRATRANSFERENCIA
                 order by c.idcompratransferencia
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: [
                P74_IDFILIALROMANCEDESTINO
                P74_IDPOSTOAVANCADODESTINO
                P74_IDPEDIDO
            ]
        }
        layout {
            sequence: 20
            region: @pedidos-da-remessa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vidcompra number;
                begin
                  --
                  select idcompratransferencia
                  into vidcompra
                  from comprastransferencias cc
                  where idcompratransferencia = ( select min(idcompratransferencia)
                                                  from comprastransferencias c
                                                  where ( idfilialromancedestino = :P331_IDFILIALROMANCE
                                                        or exists ( select 1
                                                                    from atendimentosfiliaisrmc a
                                                                    where a.idfilialfavoritaorigem = c.idfilialfavoritadestino
                                                                      and a.idfilialdestino        = :P331_IDFILIALROMANCE ) )
                                                    and exists ( select 1
                                                                 from classificacoespedidos cp
                                                                 where cp.idpedido = :P331_IDPEDIDO
                                                                   and cp.idcaracteristicapedido = 19
                                                                   and cp.idvalorcaracteristica = c.idtipocomptransrem ) 
                                                    and ( :P331_IDPOSTOAVANCADO is null or idpostoavancadodestino = :P331_IDPOSTOAVANCADO )
                                                    and idsituacao in (0,3,5) );
                  --
                  return(vidcompra);
                  --
                exception
                  when others then
                     return(null);
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

