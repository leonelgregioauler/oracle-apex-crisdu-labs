    region itens-remessas-alíquota (
        name: Itens Remessas Alíquota 17%
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.nomeprodutodetalhado
                     , ( select e.quantidade
                         from estoques e
                         where e.idprodutodetalhado = i.idprodutodetalhado
                           and e.idfilialfavorita = ( select c.idfilialfavoritaorigem
                                                      from comprastransferencias c
                                                      where c.idcompratransferencia = i.idcompratransferencia ) ) qtdestoqueorigem
                     , ( select e.quantidade
                         from estoques e
                         where e.idprodutodetalhado = i.idprodutodetalhado
                           and e.idfilialfavorita = ( select c.idfilialfavoritadestino
                                                      from comprastransferencias c
                                                      where c.idcompratransferencia = i.idcompratransferencia ) ) qtdestoquedestino
                     , nvl(( select sum(Ip.QUANTIDADE)
                             from pedidos p
                                , itenspedidos ip
                             where p.idpedido   = ip.idpedido
                               and ip.idestoque = i.idestoquefilorigem
                               and p.idedicaorevista = :P74_IDEDICAOREVISTA
                               and trunc(p.dataemissao) between  to_date(:P74_DATAINI,'DD/MM/RRRR') and to_date(:P74_DATAFIM,'DD/MM/RRRR')),0) "Qtd Total Saída"
                     , NVL(( select sum(itc.quantidadecomprada) 
                             from comprastransferencias ct 
                                , itenscomprastransferencias itc
                             where itc.idprodutodetalhado = i.idprodutodetalhado
                               and itc.idcompratransferencia = ct.idcompratransferencia
                               and ct.datarecebimento is null
                               and ct.idsituacao in (0,10)
                               and ct.idcompratransferencia != :P74_IDCOMPRATRANSFERENCIA
                               and ct.idfilialfavoritadestino = :P74_IDFILIALFAVORITADESTINO ),0) "Qtd Comprada"
                     , nvl(( select sum(Ip.QUANTIDADE)
                             from pedidos p
                                , itenspedidos ip
                             where p.idpedido   = ip.idpedido
                               and ip.idestoque = i.idestoquefilorigem
                               and trunc(p.dataemissao) between  to_date(:P74_DATAINI,'DD/MM/RRRR') and to_date(:P74_DATAFIM,'DD/MM/RRRR')),0) "Qtd Total Saída Acumulada"
                   , i.valorcusto
                   , quantidadecomprada 
                   , i.quantidadecomprada * i.valorcusto "Total Item"
                   , i.observacao
                   , i.iditemcompratransferencia
                   , i.idcompratransferencia
                   , i.idprodutodetalhado
                   , i.quantidaderecebida 
                   , i.quantidadeavariada
                   , i.observacaoavaria
                from vw_itenscomprastransf_fav i
                   , produtosdetalhados pd
                   , produtos pt
                where i.idcompratransferencia = :P74_IDCOMPRATRANSFERENCIA
                  and i.ididioma = :P0_IDIDIOMA
                  and i.quantidadecomprada > 0
                  and i.idprodutodetalhado = pd.idprodutodetalhado
                  and pd.idproduto = pt.idproduto
                  and exists ( select 1
                               from aliquotasncmestados al
                               where al.idclassificacaofiscal = pt.idclassificacaofiscal
                               and trunc(al.aliquota) = 17 )
                order by 1
                ```
        }
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P74_IDCOMPRATRANSFERENCIA is not null
                  and exists ( select 1
                               from itenscomprastransferencias 
                               where idcompratransferencia = :P74_IDCOMPRATRANSFERENCIA 
                                 and quantidadecomprada > 0 )
                  and exists ( select 1
                                   from comprastransferencias c
                                   where c.idcompratransferencia = :P74_IDCOMPRATRANSFERENCIA
                                     and c.idfilialfavoritadestino = 3
                                     and c.idtipocomptransrem = 2 )
                ```
        }
        link {
            linkColumn: customTarget
            target: {
                page: 77
                items: {
                    P77_IDCOMPRATRANSFERENCIA: #IDCOMPRATRANSFERENCIA#
                    P77_IDITEMCOMPRATRANSFERENCIA: #IDITEMCOMPRATRANSFERENCIA#
                    P77_IDPRODUTODETALHADO: #IDPRODUTODETALHADO#
                    P77_QUANTIDADECOMPRADA: #QUANTIDADECOMPRADA#
                    P77_IDFILIALDESTINO: &P74_IDFILIALFAVORITADESTINO.
                    P77_IDFILIALORIGEM: &P74_IDFILIALFAVORITAORIGEM.
                    P77_OBSERVACAO: #OBSERVACAO#
                }
                action: resetPagination
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            conditionType: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P74_TIPO = 1
                  and :P74_IDSITUACAO != 40
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
        }
        advanced {
            savedReportMappingIdentifier: 7970703359071478486
        }

