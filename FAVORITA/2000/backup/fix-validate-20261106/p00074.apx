        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(p.apelido, p.nomepessoa)) display_value
                , f.idfornecedor
                from fornecedores f
                   , pessoas      p
                where f.idpessoa = p.idpessoa
                  and f.ativo = 'S'
                  and (:P74_IDFORNECEDOR is null or f.idfornecedor = :P74_IDFORNECEDOR)
                order by 1
