    process libera-bloquear-rfid (
        name: Libera/Bloquear RFID
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  vid_remessa number := :P74_IDCOMPRATRANSFERENCIA;
                  vid_usuario number := :P0_IDUSUARIO;
                  vrequest varchar2(30) := :REQUEST;
                  --
                begin
                  --
                  if vrequest = 'LIBERAR_RFID' then
                    --
                    insert into classificacoescomprastransf(idclassificacaocompratransf,
                                                            idcompratransferencia,
                                                            dataclassificado,
                                                            idusuario,
                                                            idcaracteristicacomptransf,
                                                            idvalorcaracteristica,
                                                            observacao)
                    values(seq_idclassificacaocomptransf.nextval,
                                                            vid_remessa,
                                                            sysdate,
                                                            vid_usuario,
                                                            31,
                                                            null,
                                                            null);
                
                    favorita.pck_rfid.prc_rfid_log_classificacao (
                                                                    p_remessa => vid_remessa,
                                                                    p_usuario => vid_usuario,
                                                                    p_acao    => 'Criou classificacao 31 - Liberado para RFID.'
                                                                );
                    --
                  elsif vrequest = 'BLOQUEAR_RFID' then
                    --
                    delete classificacoescomprastransf cf
                    where cf.idcompratransferencia = vid_remessa
                    and cf.idcaracteristicacomptransf = 31;
                
                    favorita.pck_rfid.prc_rfid_log_classificacao (
                                                                p_remessa => vid_remessa,
                                                                p_usuario => vid_usuario,
                                                                p_acao    => 'Deletou classificacao 31 - Liberado para RFID.'
                                                                );
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 70
        }
        successMessage {
            successMessage: Ação processada!
        }
        error {
            errorMessage: Erro ao processar ação.
        }
        advanced {
            executionMappingIdentifier: 33068166899282646
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: LIBERAR_RFID,BLOQUEAR_RFID
        }
    )

