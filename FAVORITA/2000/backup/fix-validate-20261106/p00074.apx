    pageItem P74_SESSION_IMPRIME (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 300
            region: @compras-transferências-e-remessas
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_url varchar2(2000);
                    l_app number := 2000;
                    l_session number := v('APP_SESSION');
                BEGIN
                    l_url := APEX_UTIL.PREPARE_URL(
                        p_url => 'f?p=' || l_app || ':108:'||l_session||'::NO::P108_IDCOMPRATRANSFERENCIA,P108_ORDENA:'||:P74_IDCOMPRATRANSFERENCIA||','||:P74_ORDENA,
                        p_checksum_type => 'SESSION');
                --        p_url => 'f?p=' || l_app || ':108:'||l_session||'::NO::P108_IDCOMPRATRANSFERENCIA:'||:P74_IDCOMPRATRANSFERENCIA,
                --        p_checksum_type => 'SESSION');
                    
                    return l_url;
                END;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P74_SESSION_IMPRIMERT (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 310
            region: @compras-transferências-e-remessas
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_url varchar2(2000);
                    l_app number := 2000;
                    l_session number := v('APP_SESSION');
                    
                    vqtdVolumes       number;
                    vNotaFiscal       number;
                    vFilial           varchar2(500);
                    vRemessa          number;
                    vObservacao       varchar2(2000);
                    
                BEGIN
                
                    select count(*) into vqtdVolumes
                      from favorita.volumespedidosremessas
                     where idcompratransferencia = :P74_IDCOMPRATRANSFERENCIA;
                    if nvl(vqtdVolumes,0) = 0 then
                       vqtdVolumes := 1;
                    end if;
                    
                    --
                    select c.notafiscal ,
                           case when c.idtipocomptransrem = 1 
                                  then 'FILIAL FAVORITA: '  || pck_util_fav.fnc_nomefilialfavorita(c.idfilialfavoritadestino)  
                                else
                                       'FRANQUIA ROMANCE: ' || nvl(roman.pck_romance.fnc_nomefilial(c.idfilialromancedestino),
                                                                   favorita.pck_util_fav.fnc_nomefilialfavorita(c.idfilialfavoritadestino)   )
                            end filial,
                           --
                           c.numero,
                           --
                           c.observacao
                      into vNotaFiscal, vFilial, vRemessa, vObservacao
                      from favorita.comprastransferencias  c
                     where c.idcompratransferencia = :P74_IDCOMPRATRANSFERENCIA; 
                
                    l_url:= 'https://dev.minhafavorita.com.br/static/etq-remessas/etiquetasremessas.html#geracaoetiquetas?qtdvolumes='||vqtdVolumes||
                            '&tiporemessa='||1234|| -- esse fica fixo
                            '&numeroremessa='||trim(vRemessa)||
                            '&filial='||favorita.pck_util_fav.fnc_encode_base_64(vFilial)||
                            '&nrnotafiscal='||trim(vNotaFiscal)||
                            '&obs='||favorita.pck_util_fav.fnc_encode_base_64(vObservacao);
                    
                    return l_url;
                exception
                  when others then
                    --
                    null;
                    --
                END;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

