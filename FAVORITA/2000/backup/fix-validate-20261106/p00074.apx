    process gera-e-imprime-etiquetas-de-volumes (
        name: Gera e Imprime Etiquetas de Volumes
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vtipo varchar2(1);
                  vvolumes  varchar2(200);
                  --
                begin
                  --
                  if v('REQUEST') = 'IMPRIMIRETIQUETA' then
                    --
                    vtipo := 'I';
                    --
                  elsif v('REQUEST') = 'REIMPRESSAOETIQUETAS' then
                    --
                    vtipo := 'R';
                    --
                  end if;
                  --
                  if :P74_VOLUMESTODOS = 'T' then
                    vvolumes := null;
                  elsif :P74_VOLUMES != 'T' then
                    vvolumes := :P74_VOLUMES;
                  end if;
                  -- 
                  pck_etiquetas.prc_etiqueta_volume_remessa( pidcompratransferencia => :P74_IDCOMPRATRANSFERENCIA
                                                           , ptipo                  => vtipo
                                                           , pvolume                => vvolumes
                                                           , pquantidade            => :P74_QUANTIDADE );
                  --
                end;
                ```
        }
