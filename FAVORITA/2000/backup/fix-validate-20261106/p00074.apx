    process cancela-compra-transferencia (
        name: Cancela Compra/Transferencia
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidnotificacaointerna   number;
                  viddestino              number := :P74_IDCOMPRATRANSFERENCIA; 
                  vdescricao              varchar2(1000) := 'Compra '||:P74_IDCOMPRATRANSFERENCIA||' Cancelada!';
                  vdataenviado            date;
                  vidgrupo                number:= 0;
                  vdata                   date;
                  vnumber                 number;
                  vvarchar                varchar2(1000);
                  --
                begin
                  --
                  -- Call the procedure
                  --
                  pck_comprastransf_fav.prc_cancelacompratransferencia(pidcompratransferencia => :P74_IDCOMPRATRANSFERENCIA,
                                                                       pidusuario => :P0_IDUSUARIO);
                    --
                    begin
                      --
                      select us.idgrupoatendimento
                      into vidgrupo
                      from roman.usuariosgruposatendimento us
                      where exists( select 1
                                    from usuarios u
                                    where u.idusuario = :P0_IDUSUARIO
                                      and us.usuario = u.usuario);
                      --
                    exception
                      when others then
                        null;
                    end;
                    --
                    favorita.PCK_COMUNICACAO_GLOBAL.prc_mensagensinternas ( pidmensageminterna    => vidnotificacaointerna 
                                                                       , pidgrupoatendimento    => vidgrupo
                                                                       , pdatainclusao          => vdataenviado
                                                                       , pmensagem              => vdescricao
                                                                       , pidcompratransferencia => viddestino
                                                                       , pidusuarioleitura      => vnumber
                                                                       , pdataleitura           => vdata
                                                                       , pidusuario             => vnumber
                                                                       , pidchamado             => vnumber
                                                                       , poperacao_dml          => 'I'
                                                                       , pmd5                   => vvarchar );
                  --
                end;
                
                ```
        }
        execution {
            sequence: 230
        }
        successMessage {
            successMessage: Cancelado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1410608942491911009
        }
        serverSideCondition {
            type: request=Value
            value: CANCELAR
        }
    )

