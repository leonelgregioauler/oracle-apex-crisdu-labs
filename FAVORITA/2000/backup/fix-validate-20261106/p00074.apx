    region pedidos-da-remessa (
        name: Pedidos da Remessa
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpedido,
                       '<a class="idpedido" href="javascript:window.open(''' ||
                       APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:' || v('APP_SESSION') ||
                                             '::NO::P68_IDPEDIDO:' || p.idpedido,
                                             'SESSION') || ''',''_blank''); void(0)">' ||
                       p.idpedido || '</a>' numeropedido,
                       '<input type="checkbox" name="selecionar" class="pedido">' selecionar,
                       p.vendedora,
                       p.representante,
                       p.valortotal,
                       p.valorapagar,
                       p.situacaoentregainterno,
                       p.situacaofinanceirointerno,
                       case
                         when pck_montagem_tablet.fnc_valida_ped_erro(p.idpedido) = 0 then
                           'Não'
                         else
                           '<a href="'||apex_util.prepare_url('f?p=&APP_ID.:497:&SESSION.::NO::P497_ID_PEDIDO:'||p.idpedido)||'">Sim</a>'
                       end as "Erro Montagem",
                       case
                          when exists (select 1
                                from classificacoespedidos c
                                where c.idpedido = p.idpedido
                                and c.idcaracteristicapedido = 43) and
                               p.idpedidovirtualage is not null then
                           '<font color="green"><b>Integrado</b></font>'
                          when exists (select 1
                                from classificacoespedidos c
                                where c.idpedido = p.idpedido
                                and c.idcaracteristicapedido = 43) and
                               p.idpedidovirtualage is null then
                           '<font color="red"><b>Rejeitado</b></font>'
                          when p.idpedidovirtualage is null and
                               p.mensagemintegracao is not null then
                           '<font color="red"><b>Rejeitado</b></font>'
                          when not exists (select 1
                                from classificacoespedidos c
                                where c.idpedido = p.idpedido
                                and c.idcaracteristicapedido = 43) and
                               p.mensagemintegracao is null then
                           '<font color="blue"><b>Não Integrado</b></font>'
                          when not exists (select 1
                                from classificacoespedidos c
                                where c.idpedido = p.idpedido
                                and c.idcaracteristicapedido = 43) and
                               p.idpedidovirtualage is not null then
                           '<font color="blue"><b>Não Integrado</b></font>'
                        end situacao,
                       (select ped.mensagemintegracao
                        from pedidos ped
                        where ped.idpedido = p.idpedido) mensagemintegracao,
                       p.dataentrega,
                       (select distinct (volume)
                        from pedidosremessasct
                        where idpedido = p.idpedido) volume,
                       p.regiaocliente regiaovenda,
                       p.numeropedido nrpedido,
                       (select prm.descretornototalexp
                        from pedidosremessasct prm
                        where prm.idpedido = p.idpedido) "Integração Total Exp"
                   -- Maicon Aimi - 22/10/2024 - 9534367
                   , apex_item.CHECKBOX2(2,p.idpedido, null) CHECK1
                from vw_pedidos_fav p
                where exists
                 (select 1
                       from pedidos ped, pedidosremessasct pr, comprastransferencias ct
                       where ped.idpedido = pr.idpedido
                       and pr.idcompratransferencia = ct.idcompratransferencia
                       and pr.idpedido = p.idpedido
                       and pr.idcompratransferencia = :P74_IDCOMPRATRANSFERENCIA)
                     /*and ( ct.idsituacao = 0  and ped.idsituacaoentrega = 30000
                     or ct.idsituacao = 1  and ped.idsituacaoentrega in (30000, 31000, 32000) 
                     or ct.idsituacao = 2  and ped.idsituacaoentrega in (30000, 31000, 32000) 
                     or ct.idsituacao = 3  and ped.idsituacaofinanceiro in (30000, 35000) 
                     or ct.idsituacao = 5  and ped.idsituacaoentrega = 34000
                     or ct.idsituacao = 7  and ped.idsituacaoentrega = 35000
                     or ct.idsituacao = 20 and ped.idsituacaoentrega = 40000 )  )*/
                and ididioma = :P0_IDIDIOMA
                
                ```
        }
        layout {
            sequence: 100
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P74_TIPO in (2,3,4,7,8)
                  and exists ( select 1
                               from pedidosremessasct 
                               where idcompratransferencia = :P74_IDCOMPRATRANSFERENCIA )
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 2000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
        }
        advanced {
            savedReportMappingIdentifier: 7017188253425785206
        }

