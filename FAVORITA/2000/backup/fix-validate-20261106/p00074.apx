    process entregar-pedido-funcionário (
        name: Entregar Pedido Funcionário
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidfilialromancedestino   number;
                begin
                  for i in ( select pr.idpedido
                                  , ct.idfilialromancedestino
                             from pedidosremessasct pr
                                , comprastransferencias ct
                             where ct.idcompratransferencia = :P74_IDCOMPRATRANSFERENCIA
                             and pr.idcompratransferencia   = ct.idcompratransferencia
                             and ct.idfilialromancedestino  = 200 )
                  --
                  loop
                    --
                    vidfilialromancedestino := i.idfilialromancedestino;
                    --
                    pck_movimentarpedidos_fav.prc_atualizasituacaoentrega ( i.idpedido
                                                                          , 50000
                                                                          , :P0_IDUSUARIO );
                    --
                    pck_movimentarpedidos_fav.prc_atualizasituacaofinanceiro ( i.idpedido
                                                                             , 50000
                                                                             , :P0_IDUSUARIO );
                    --
                  end loop;
                  --
                  if vidfilialromancedestino = 200 then
                    update comprastransferencias 
                    set idsituacao = 40
                    where idcompratransferencia = :P74_IDCOMPRATRANSFERENCIA;
                    --
                    commit;
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 200
        }
        advanced {
            executionMappingIdentifier: 1410611379941911010
        }
        serverSideCondition {
            type: never
        }
    )

