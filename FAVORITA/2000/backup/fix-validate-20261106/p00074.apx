    region produtos-não-transferidos (
        name: Produtos não transferidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select '<a href="javascript:apex.confirm(''Realize o ajuste do produto '||pck_util_fav.fnc_nomeprodutodetalhado(it.idprodutodetalhado, 1)||' no estoque Origem.
                                                           Em seguida, confirme a transferência.'', 
                             { request:''ITENSNAOTRANSFERIDOS'', set:{''P74_IDPRODUTODETALHADO'':'||it.idprodutodetalhado||',
                                                                      ''P74_IDITEMCOMPRATRANSFERENCIA'':'||it.iditemcompratransferencia||',
                                                                      ''P74_QUANTIDADERECEBIDA'':'||it.quantidaderecebida||',
                                                                      ''P74_QUANTIDADEESTOQUE'':'||( select e.quantidade - e.quantidadereservada
                                                                                                     from vw_estoques_fav e
                                                                                                     where e.idestoque = it.idestoquefilorigem
                                                                                                     and ididioma = 1 )||',
                                                                      ''P74_IDESTOQUEFILIALORIGEM'':'||it.idestoquefilorigem||',
                                                                      ''P74_IDESTOQUEFILIALDESTINO'':'||it.idestoquefildestino||'}})";><img src="#APP_IMAGES#ok.png"  border="0"></a>' link
                     , pck_util_fav.fnc_nomeprodutodetalhado(it.idprodutodetalhado, 1) produto
                     , quantidadecomprada
                     , quantidaderecebida  
                     , ( select e.quantidade - e.quantidadereservada
                         from vw_estoques_fav e
                         where e.idestoque = it.idestoquefilorigem
                         and ididioma = 1 ) quantidadeestoque
                 from itenscomprastransferencias it
                    , comprastransferencias c
                 where c.idcompratransferencia  = :P74_NUMERO
                   and it.idcompratransferencia = c.idcompratransferencia
                   and ( it.quantidaderecebida    >= 0 or it.quantidadeavariada >= 0)
                   and not exists ( select 1
                                    from movimentosestoques m
                                    where m.iditemcompratransf = it.iditemcompratransferencia )
                ```
        }
        layout {
            sequence: 110
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                :P74_TIPO in (1,12)
                and exists ( select 1
                             from movimentosestoques m
                                , itenscomprastransferencias i
                             where m.iditemcompratransf = i.iditemcompratransferencia 
                             and i.idcompratransferencia = :P74_NUMERO );
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 4339034305170973988
        }

