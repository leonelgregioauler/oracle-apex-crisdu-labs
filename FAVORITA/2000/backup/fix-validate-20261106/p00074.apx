        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P74_IDCOMPRATRANSFERENCIA is not null
                  and exists ( select 1
                               from itenscomprastransferencias 
                               where idcompratransferencia = :P74_IDCOMPRATRANSFERENCIA 
                                 and quantidadecomprada > 0 )
                  and exists ( select 1
                                   from comprastransferencias c
                                   where c.idcompratransferencia = :P74_IDCOMPRATRANSFERENCIA
                                     and c.idfilialfavoritadestino in (3, 37)
                                     and c.idtipocomptransrem in (1, 2) )
                ```
        }
    )

