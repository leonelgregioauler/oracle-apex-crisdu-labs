    )

    pageItem P74_IDFILIALROMANCEDESTINO (
        type: selectList
        label {
            label: Romance Destino
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome as d,
                       idfilial as r
                  from roman.vw_filiais
                 where tipofilial in ('C', 'D','A','F','L')
                   and ativo = 'S'
                   and idfilial not in (1088)
                 union
                 select nome 
                      , idfilial 
                 from roman.vw_filiais f
                 where f.idfilial = 200
                 union
                  select nome 
                      , idfilial 
                 from roman.vw_filiais f
                 where f.idfilial = 1220
                 order by 1
                ```
        }
        layout {
            sequence: 130
            region: @compras-transferências-e-remessas
