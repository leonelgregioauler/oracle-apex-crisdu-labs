    process alterar-remessa (
        name: Alterar Remessa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                /*
                    Maicon Aimi - 22/10/2024 - 9534367
                
                
                    -- esse codigo pode ser usado futuramente para debug em caso de algum erro futuro
                    apex_error.add_error( p_message => ' id nova remessa - ' || :P74_IDCOMPRATRANSFNOVA ||
                                                       ' Processo - ' || 'A' || 
                                                       ' Pedido - ' || to_number(APEX_APPLICATION.G_F02(i)) || 
                                                       ' iduser - ' || :P0_IDUSUARIO 
                       				    , p_display_location => apex_error.c_inline_in_notification);
                
                */
                
                begin
                
                    -- verifica se existe alguma linha selecionada na grade PEDIDOS DA REMESSA
                    if APEX_APPLICATION.G_F02.COUNT > 0 then 
                
                        -- faz um loop passa por todos as linhas que estiverem selecionadas.
                        for i in 1..APEX_APPLICATION.G_F02.COUNT loop
                
                            -- passa o pedido selecionado na grid PEDIDOS DA REMESSA para a nova remessa
                            pck_comprastransf_fav.prc_processomanualpedidos( pidcompratransferencia => :P74_IDCOMPRATRANSFNOVA
                                                                           , ptipoprocesso          => 'A'
                                                                           , pnumeropedido          => to_number(APEX_APPLICATION.G_F02(i))
                                                                           , pidusuario             => :P0_IDUSUARIO );
                
                        end loop;
                
                    end if;
                
                end;
                
                ```
        }
        execution {
            sequence: 310
        }
        successMessage {
            successMessage: Pedido(s) transferidos para a remessa: &P74_REMESSANOVA.
        }
        advanced {
            executionMappingIdentifier: 1410613361567911011
        }
        serverSideCondition {
            whenButtonPressed: @alterarremessa
        }
    )

