    region itens-devolução-para-fornecedor (
        name: Itens Devolução para Fornecedor
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.iditemcompratransferencia
                     , i.valorcusto
                     , i.idprodutodetalhado || ' - ' || pck_util_fav.fnc_nomeprodutodetalhadosref(i.idprodutodetalhado, :P0_IDIDIOMA) nomeproduto
                     , quantidadeavariada 
                     , quantidadedevolvida
                     , i.idestoquefilorigem                                      
                     , favorita.pck_estoque_fav.fnc_estoquedisponivel(i.idestoquefilorigem) qtdestoquedisponivelorigem
                     , favorita.pck_estoque_fav.fnc_estoquedefeitodisponivel(i.idestoquefilorigem) qtdestoquedefeitodisporigem
                     , i.observacao
                     , i.observacaoavaria
                from favorita.itenscomprastransferencias i
                where i.idcompratransferencia = :P74_IDCOMPRATRANSFERENCIA  
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P74_IDCOMPRATRANSFERENCIA is not null
                  and exists ( select 1
                               from itenscomprastransferencias 
                               where idcompratransferencia = :P74_IDCOMPRATRANSFERENCIA 
                                 and quantidadeavariada > 0 or quantidadedevolvida > 0 )
                  and exists ( select 1
                               from comprastransferencias 
                               where idcompratransferencia = :P74_IDCOMPRATRANSFERENCIA 
                                 and idtipocomptransrem = 5 )
                ```
        }
        edit {
            enabled: true
            allowedOperations: [
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 4341701464695801419
        }

