    pageItem P74_IDFILIALFAVORITADESTINO (
        type: selectList
        label {
            label: Favorita Destino
            alignment: left
        }
        lov {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin 
                if :P74_IDCOMPRATRANSFERENCIA IS NULL then
                
                return fnc_lov_retornadestinofav(:P74_TIPO
                                               , v('APP_USER')
                                               , :P74_SELECT);
                else
                  return 'SELECT NOMEFILIALFAVORITA D, IDFILIALFAVORITA R FROM FILIAISFAVORITA WHERE IDFILIALFAVORITA = '|| nvl(:P74_IDFILIALFAVORITADESTINO,0) ;
                end if;  
                end;                              
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P74_SELECT
            itemsToSubmit: P74_SELECT
        }
        layout {
            sequence: 120
            region: @compras-transferências-e-remessas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: expression
            plsqlExpression: null
        }
        readOnly {
            type: itemIsNotNull
            item: P74_IDCOMPRATRANSFERENCIA
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P74_IDFILIALFAVORITAORIGEM (
        type: selectList
        label {
            label: Favorita Origem
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) as d,
                       idfilialfavorita as r
                  from filiaisfavorita f
                where  exists ( select 1
                               from usuariosfiliaisfavorita u
                               where u.idfilialfavorita = f.idfilialfavorita
                                 and u.consultar        = 'S' 
                                 and u.idusuario        = :P0_IDUSUARIO )
                 order by 1
                 
                
                ```
        }
        layout {
            sequence: 110
            region: @compras-transferências-e-remessas
            slot: regionBody
            alignment: left
        }
        appearance {
