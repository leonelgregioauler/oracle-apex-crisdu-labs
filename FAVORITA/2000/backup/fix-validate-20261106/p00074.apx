            function AtivarIntegracaoVirtualAgeHML(callback_resultado) {
              IDCOMPRATRANSFERENCIA = document.getElementById('P74_IDCOMPRATRANSFERENCIA').value;
              IDUSUARIO = document.getElementById('P0_IDUSUARIO').value;
             
              winwidth  = 770;  // largura da nova janela
              winheight = 450;  // altura da nova janela 
              winleft   = 200;  // (nao alterar)
              wintop    = 200;  // (nao alterar)
            
              if(parseInt(navigator.appVersion)>=4) 
              {
                winleft = (screen.width / 2) - (winwidth / 2);  // centro da janela direita para esquerda
                wintop = (screen.height / 2) - (winheight / 2); // centro da janela cima para baixo
              }
             
              var iframe = $("<iframe>");
              window.evento = window.addEventListener("message", function(dados) {
              window.removeEventListener("message", window.evento, true);
              console.log("dados recebidos do filho!");
              console.log(dados);
              dados = JSON.parse(dados.data);
            
              if (typeof(dados.ERRO) != "undefined") {
                vendereco = document.getElementById("P74_SESSION_INTEGRAR").value;
                vjanela = window.open(vendereco, '_blank', 'top=' + wintop + ',left=' + winleft + ',height=' + winheight + ',width=' + winwidth); 
                vjanela.focus();
              }
            
              if (typeof(callback_resultado) != "undefined") {
               callback_resultado(dados);
              }
              
              $("body").remove(iframe);
              }, true);
              $("body").append(iframe);
              iframe.attr("src", 'https://dev_ws.catalogofavorita.com.br/executar/integracao_va/executar_remessa_cg?str={"IDCOMPRATRANSFERENCIA":' + IDCOMPRATRANSFERENCIA + ',"SISTEMA":true,"IDUSUARIO":' + IDUSUARIO + '}');
            }
            
            
            function AtivarIntegracaoVirtualAgePRD(callback_resultado) {
              IDCOMPRATRANSFERENCIA = document.getElementById('P74_IDCOMPRATRANSFERENCIA').value;
              IDUSUARIO = document.getElementById('P0_IDUSUARIO').value;
             
              winwidth  = 770;  // largura da nova janela
              winheight = 450;  // altura da nova janela 
              winleft   = 200;  // (nao alterar)
              wintop    = 200;  // (nao alterar)
            
              if(parseInt(navigator.appVersion)>=4) 
              {
                winleft = (screen.width / 2) - (winwidth / 2);  // centro da janela direita para esquerda
                wintop = (screen.height / 2) - (winheight / 2); // centro da janela cima para baixo
              }
             
              var iframe = $("<iframe>");
              window.evento = window.addEventListener("message", function(dados) {
              window.removeEventListener("message", window.evento, true);
              console.log("dados recebidos do filho!");
              console.log(dados);
              dados = JSON.parse(dados.data);
            
              if (typeof(dados.ERRO) != "undefined") {
                vendereco = document.getElementById("P74_SESSION_INTEGRAR").value;
                vjanela = window.open(vendereco, '_blank', 'top=' + wintop + ',left=' + winleft + ',height=' + winheight + ',width=' + winwidth); 
                vjanela.focus();
              }
            
              if (typeof(callback_resultado) != "undefined") {
               callback_resultado(dados);
              }
              
              $("body").remove(iframe);
              }, true);
              $("body").append(iframe);
              iframe.attr("src", 'https://ws.catalogofavorita.com.br/executar/integracao_va/executar_remessa_cg?str={"IDCOMPRATRANSFERENCIA":' + IDCOMPRATRANSFERENCIA + ',"SISTEMA":true,"IDUSUARIO":' + IDUSUARIO + '}');
            }
            
            function confirma_apagar_contagem(vitem)
            {
              apex.item('P74_IDITEMCOMPRATRANSFAPAGAR').setValue(vitem);
              var answer = confirm("Confirma que quer apagar a contagem do item?")
              if (answer)
              {
                apex.submit('RETIRACONTAGEM');
              }
                
            }
            
            function abre_pagina_584()
            {
              vurl = document.getElementById("P74_SESSION_PAG_584").value;
              pjan = window.open(vurl,'_blank'); void(0);
              pjan.focus();
            }
