    region lista-de-impressões (
        name: Lista de Impressões
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select cp.idlog
                     , cp.usuarioalteracao
                     , cp.dataalteracao dataimpressao
                from logfavorita.log_classificacoescomprast cp 
                where cp.idcompratransferencia = :P74_IDCOMPRATRANSFERENCIA 
                and cp.idcaracteristicacomptransf = 20 
                and cp.tipoalteracao = 'INSERT'
                union
                select cp.idlog
                     , cp.usuarioalteracao
                     , cp.dataalteracao dataimpressao
                from logfavorita.log_classificacoescomprast cp 
                where cp.idcompratransferencia = :P74_IDCOMPRATRANSFERENCIA 
                and cp.idcaracteristicacomptransf = 21 
                and cp.tipoalteracao = 'INSERT'
                order by 1 desc;
                ```
        }
        layout {
