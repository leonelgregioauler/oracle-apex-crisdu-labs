    validation quantidade-devolvida-não-pode-ser-maior-que-estoque-origem-devolução-fornecedor (
        name: Quantidade Devolvida não pode ser maior que Estoque Origem (Devolução Fornecedor)
        execution {
            sequence: 170
        }
        validation {
            editableRegion: @itens-devolução-para-fornecedor
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vquantidadeoutrasdevolucoes    number;
                  --vquantidadeavariadaoutrasdevol number;
                  vquantidadefinal               number;
                  --vquantidadeavariadafinal       number;
                begin
                  --
                  select sum(nvl(quantidadecomprada, 0)) + sum(nvl(quantidadedevolvida, 0))
                      -- , sum(nvl(quantidadeavariada, 0))
                  into vquantidadeoutrasdevolucoes
                     --, vquantidadeavariadaoutrasdevol
                  from itenscomprastransferencias i
                     , comprastransferencias c
                  where i.idcompratransferencia = c.idcompratransferencia 
                  and i.idestoquefilorigem      = :IDESTOQUEFILORIGEM
                  and c.idcompratransferencia  != :P74_IDCOMPRATRANSFERENCIA
                  and exists  ( select 1
                                from situacoescomprastransferencias s
                                where s.idsituacaocompratransf = c.idsituacao
                                and estoquereservado = 'S' );
                  --
                  vquantidadefinal := ( pck_estoque_fav.fnc_estoquedisponivel(:IDESTOQUEFILORIGEM) + pck_estoque_fav.fnc_estoquereservado(:IDESTOQUEFILORIGEM) ) - 
                                        :QUANTIDADEDEVOLVIDA - nvl(vquantidadeoutrasdevolucoes, 0) - pck_estoque_fav.fnc_estoquereservadopedidos(:IDESTOQUEFILORIGEM);
                  --
                  --vquantidadeavariadafinal := ( pck_estoque_fav.fnc_estoquedefeitodisponivel(:IDESTOQUEFILORIGEM) + pck_estoque_fav.fnc_estoquedefeitoreservado(:IDESTOQUEFILORIGEM) ) - 
                  --                              :QUANTIDADEAVARIADA - nvl(vquantidadeavariadaoutrasdevol, 0);
                  --                        
                  if vquantidadefinal >= 0 then 
                    return null;
                  --elsif vquantidadeavariadafinal >= 0 then
                  --  return null;
                  else 
                    return 'Quantidade devolvida ultrapassou a quantidade disponível no estoque origem';
                  end if;
                  --
                end;
                ```
        }
        error {
            associatedColumn: QUANTIDADEDEVOLVIDA
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P74_TIPO = 5
        }
    )

    validation valida-data-utilizada (
        name: Valida Data utilizada
        execution {
            sequence: 110
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where :P74_DATAPREVISAO is null
                   or :P74_DATAPREVISAO < trunc(sysdate)
                ```
        }
        error {
            errorMessage: Utilize uma data válida!
            associatedItem: @P74_DATAPREVISAO
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMAR_VENCIMENTO
        }
    )

    validation valida-edição-quantidade-itens-compras-transferências-e-remessas (
        name: Valida Edição Quantidade Itens Compras Transferências e Remessas
        execution {
            sequence: 200
        }
        validation {
            editableRegion: @itens-compras-transferências-e-remessas
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                    -- Variáveis para validação da transferência
                    v_tipo_transferencia       number;
                    v_situacao_transferencia   number;
                    v_descricao                varchar2(500);
                begin
                    -- Busca o tipo e situação da transferência com base no ID fornecido
                    select c.idtipocomptransrem,
                           c.idsituacao
                      into v_tipo_transferencia,
                           v_situacao_transferencia
                      from favorita.comprastransferencias c
                     where c.idcompratransferencia = :P74_IDCOMPRATRANSFERENCIA;
                
                    -- Valida o tipo da transferência
                    if v_tipo_transferencia in (2, 3, 4, 5, 7, 8, 10) then
                        select t.descricao
                          into v_descricao
                          from favorita.tiposcomptransrem t
                         where t.idtipocomptransrem = v_tipo_transferencia;
                
                        return 'Não é permitido alterar a quantidade quando o tipo for ' || v_descricao || '.';
                    end if;
                
                    -- Valida a situação da transferência
                    if v_situacao_transferencia in (-1, 7, 10, 11, 20, 30, 40) then
                        select s.descricao
                          into v_descricao
                          from favorita.situacoescomprastransferencias s
                         where s.idsituacaocompratransf = v_situacao_transferencia;
                
                        return 'Não é permitido alterar a quantidade quando a situação for ' || v_descricao || '.';
                    end if;
                
                exception
                    when others then 
                        return 'OPS! Ocorreu um erro inesperado, não foi possível alterar a quantidade! ' || SQLERRM;
                end;
                ```
        }
        error {
            associatedColumn: QUANTIDADECOMPRADA
        }
    )

    validation valida-envio-para-total-express (
        name: Valida envio para total express
        execution {
            sequence: 180
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from pedidosremessasct pr
                where pr.idcompratransferencia = :P74_IDCOMPRATRANSFERENCIA
                and not exists (select 1
                               from crisdu.notasfiscais nf
                               where nf.idpedidofavorita = pr.idpedido)
                ```
        }
        error {
            errorMessage: Remessa não pode ser enviada, existem pedidos sem nota fiscal vinculada!
        }
        serverSideCondition {
            type: request=Value
            value: INTEGRAR_TOTEXP
        }
    )

