    process consulta-compra-transferencia (
        name: Consulta Compra Transferencia
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vvalortotalcompra number;
                  vdataemissaoinicial date;
                  vdataemissaofinal   date;
                  vidordemcompra number;
                  --
                begin
                  --
                  pck_comprastransf_fav.prc_comprastransferencias(pidcompratransferencia   => :P74_IDCOMPRATRANSFERENCIA,
                                                                  pidfornecedor            => :P74_IDFORNECEDOR,
                                                                  pidfilialfavoritaorigem  => :P74_IDFILIALFAVORITAORIGEM,
                                                                  pidfilialfavoritadestino => :P74_IDFILIALFAVORITADESTINO,
                                                                  pidfilialromancedestino  => :P74_IDFILIALROMANCEDESTINO,
                                                                  pidpostoavancadodestino  => :P74_IDPOSTOAVANCADODESTINO,
                                                                  pnumero                  => :P74_NUMERO,
                                                                  pidsituacao              => :P74_IDSITUACAO,
                                                                  pnotafiscal              => :P74_NOTAFISCAL,
                                                                  pdataemissao             => :P74_DATAEMISSAO,
                                                                  pdatarecebimento         => :P74_DATARECEBIMENTO,
                                                                  pdataembarque            => :P74_DATAEMBARQUE,
                                                                  pdataprevisaoentrega     => :P74_DATAPREVISAOENTREGA,
                                                                  pvalortotalcompra        => vvalortotalcompra,
                                                                  pcubagem                 => :P74_CUBAGEM,
                                                                  pvolume                  => :P74_VOLUME,
                                                                  ppeso                    => :P74_PESO,
                                                                  pobservacao              => :P74_OBSERVACAO,
                                                                  pidtipo                  => :P74_TIPO,
                                                                  poperacao_dml            => 'S',
                                                                  pmd5                     => :P74_MD5,
                                                                  pidusuario               => :P74_IDUSUARIO,
                                                                  pidsemanaentrega         => :P74_SEMANAENTREGA,
                                                                  panaliseconcluida        => :P74_ANALISECONCLUIDA,
                                                                  pidentificacaointerna    => :P74_IDENTIFICACAOINTERNA,
                                                                  pdataemissaoinicial      => vdataemissaoinicial,
                                                                  pdataemissaofinal        => vdataemissaofinal,
                                                                  pidnotafiscal            => :pidnotafiscal,
                                                                  pidcompratransferenciaorigem => :pidcompratransferenciaorigem,
                                                                  pidordemcompra => vidordemcompra);
                  --
                  :P74_SELECT := NVL(:P74_IDFORNECEDOR,:P74_IDFILIALFAVORITAORIGEM);
                  :P74_VALORTOTALCOMPRA := to_char(vvalortotalcompra,'999G999G999G990D00');
                  :P74_DATAEMISSAOINICIAL := to_char(vdataemissaoinicial,'DD/MM/RRRR HH24:MI:SS');
                  :P74_DATAEMISSAOFINAL := to_char(vdataemissaofinal,'DD/MM/RRRR HH24:MI:SS');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1410604530070911007
        }
    )

    process descarregarfidtransferencia (
        name: DescarregaRFIDTransferencia
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    v_existeRecebimento NUMBER;
                    v_sucesso           VARCHAR2(1);
                    v_mensagem          VARCHAR2(4000);
                    v_ja_existe         NUMBER;
                BEGIN
                    SELECT COUNT(*)
                      INTO v_existeRecebimento
                      FROM favorita.rfid_recebimentos r
                     WHERE r.idcompratransferencia = :P74_IDCOMPRATRANSFERENCIA
                       AND r.processado = 'N';
                
                    IF v_existeRecebimento = 0 THEN
                        APEX_ERROR.ADD_ERROR(
                            p_message          => 'Nenhum retorno não processado disponível para a remessa..',
                            p_display_location => apex_error.c_inline_in_notification
                        );
                        RETURN;
                    END IF;
                
                    favorita.pck_rfid.prc_descarrega_rfid_transferencia(
                        p_idcompratransferencia => :P74_IDCOMPRATRANSFERENCIA,
                        p_usuario               => :P0_IDUSUARIO,
                        p_sucesso               => v_sucesso,
                        p_mensagem              => v_mensagem
                    );
                
                    IF v_sucesso <> 'S' THEN
                        APEX_ERROR.ADD_ERROR(
                            p_message          => v_mensagem,
                            p_display_location => apex_error.c_inline_in_notification
                        );
                        RETURN;
                    END IF;
                
                    -- registra/atualiza a classificacao "Descarregado RFID - Transferencia" (caracteristica 32)
                    -- upsert: evita violar UK_CLASSIFCOMPTRANSF_IDCOMP em execucoes repetidas;
                    -- mantem a data de criacao original (dataclassificado) e vai concatenando
                    -- cada nova execucao na observacao
                    SELECT COUNT(*)
                      INTO v_ja_existe
                      FROM classificacoescomprastransf
                     WHERE idcompratransferencia = :P74_IDCOMPRATRANSFERENCIA
                       AND idcaracteristicacomptransf = 32;
                
                    MERGE INTO classificacoescomprastransf cf
                    USING (SELECT :P74_IDCOMPRATRANSFERENCIA idcompratransferencia FROM dual) src
                    ON (cf.idcompratransferencia = src.idcompratransferencia
                        AND cf.idcaracteristicacomptransf = 32)
                    WHEN MATCHED THEN
                        UPDATE SET idusuario  = :P0_IDUSUARIO,
                                   observacao = NVL(cf.observacao || ' | ', NULL) || 'Descarregado novamente em ' || TO_CHAR(SYSDATE,'DD/MM/YYYY HH24:MI:SS')
                    WHEN NOT MATCHED THEN
                        INSERT (idclassificacaocompratransf, idcompratransferencia, dataclassificado,
                                idusuario, idcaracteristicacomptransf, idvalorcaracteristica, observacao)
                        VALUES (seq_idclassificacaocomptransf.nextval, src.idcompratransferencia, SYSDATE,
                                :P0_IDUSUARIO, 32, NULL, 'Descarregado em ' || TO_CHAR(SYSDATE,'DD/MM/YYYY HH24:MI:SS'));
                
                    favorita.pck_rfid.prc_rfid_log_classificacao (
                        p_remessa => :P74_IDCOMPRATRANSFERENCIA,
                        p_usuario => :P0_IDUSUARIO,
                        p_acao    => CASE WHEN v_ja_existe = 0
                                          THEN 'Criou classificacao 32 - Descarregado RFID Transferencia.'
                                          ELSE 'Atualizou classificacao 32 - Descarregado RFID Transferencia (nova execucao).'
                                     END
                    );
                
                    APEX_APPLICATION.G_PRINT_SUCCESS_MESSAGE := v_mensagem;
                END;
                ```
        }
        execution {
            sequence: 80
        }
        advanced {
            executionMappingIdentifier: 45126296646625421
        }
        serverSideCondition {
            whenButtonPressed: @descarregar-rfid
        }
    )

