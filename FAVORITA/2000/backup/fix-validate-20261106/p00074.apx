    region itens-valor-custo-fiscal-zerado (
        name: Itens Valor Custo Fiscal Zerado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select *
                from ( select favorita.pck_util_fav.fnc_nomeprodutodetalhado(it.idprodutodetalhado,1) Produto
                            , sum(it.custofiscal) custofiscal
                            , sum(it.quantidade) quantidadetotal
                       from itenspedidos it
                       where ( it.custofiscal = 0 or it.custofiscal is null)
                         and exists ( select 1
                                      from pedidosremessasct pr
                                      where pr.idcompratransferencia = :P74_IDCOMPRATRANSFERENCIA
                                        and pr.idpedido              = it.idpedido )
                       group by it.idprodutodetalhado)
                union
                select favorita.pck_util_fav.fnc_nomeprodutodetalhado(ic.idprodutodetalhado,1)
                     , sum(ic.custofiscal)
                     , sum(ic.quantidadecomprada)
                from itenscomprastransferencias ic
                where ic.idcompratransferencia = :P74_IDCOMPRATRANSFERENCIA
                  and ( ic.custofiscal = 0 or ic.custofiscal is null)
                group by ic.idprodutodetalhado ;
                ```
        }
        layout {
            sequence: 120
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 8645014984907928791
        }

