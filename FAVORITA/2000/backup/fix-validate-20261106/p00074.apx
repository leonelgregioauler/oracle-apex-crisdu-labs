    region itens-compras-transferências-e-remessas (
        name: Itens Compras Transferências e Remessas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nvl( ( select dep.skuvirtualage
                                from deparaprodfavoritavirtualage dep
                               where dep.idprodutodetalhado = pd.idprodutodetalhado), 6000000 + pd.idprodutodetalhado ) sku
                     , pck_util_fav.fnc_nomeprodutodetalhadosref(i.idprodutodetalhado, :P0_IDIDIOMA) nomeprodutodetalhadoref
                     , pck_util_fav.fnc_nomeprodutodetalhado(i.idprodutodetalhado, :P0_IDIDIOMA) nomeprodutodetalhado
                     , ( select e.quantidade
                         from estoques e
                         where e.idprodutodetalhado = i.idprodutodetalhado
                           and e.idfilialfavorita = ( select c.idfilialfavoritaorigem
                                                      from comprastransferencias c
                                                      where c.idcompratransferencia = i.idcompratransferencia ) ) qtdestoqueorigem
                     , i.idestoquefilorigem                                      
                     , pck_estoque_fav.fnc_estoquedisponivel(i.idestoquefilorigem) qtdestoquedisponivelorigem
                     , ( select e.quantidade
                         from estoques e
                         where e.idprodutodetalhado = i.idprodutodetalhado
                           and e.idfilialfavorita = ( select c.idfilialfavoritadestino
                                                      from comprastransferencias c
                                                      where c.idcompratransferencia = i.idcompratransferencia ) ) qtdestoquedestino
                     , nvl(( select sum(Ip.QUANTIDADE)
                             from pedidos p
                                , itenspedidos ip
                             where p.idpedido   = ip.idpedido
                               and ip.idestoque = i.idestoquefilorigem
                               and p.idedicaorevista = :P74_IDEDICAOREVISTA
                               and trunc(p.dataemissao) between  to_date(:P74_DATAINI,'DD/MM/RRRR') and to_date(:P74_DATAFIM,'DD/MM/RRRR')),0) "Qtd Total Saída"
                     , NVL(( select sum(itc.quantidadecomprada) 
                             from comprastransferencias ct 
                                , itenscomprastransferencias itc
                             where itc.idprodutodetalhado = i.idprodutodetalhado
                               and itc.idcompratransferencia = ct.idcompratransferencia
                               and itc.idcompratransferencia != :P74_IDCOMPRATRANSFERENCIA
                               and ct.idsituacao in (10,20,30)
                               and ct.idcompratransferencia != :P74_IDCOMPRATRANSFERENCIA
                               and ct.idfilialfavoritadestino = :P74_IDFILIALFAVORITADESTINO ),0) "Qtd Comprada"
                     , nvl(( select sum(Ip.QUANTIDADE)
                             from pedidos p
                                , itenspedidos ip
                             where p.idpedido   = ip.idpedido
                               and ip.idestoque = i.idestoquefilorigem
                               and trunc(p.dataemissao) between  to_date(:P74_DATAINI,'DD/MM/RRRR') and to_date(:P74_DATAFIM,'DD/MM/RRRR')),0) "Qtd Total Saída Acumulada"
                     , ( select ctss.nomecategoria
                         from favorita.produtos pt
                            , favorita.categorias cts
                            , favorita.categoriassite ctss
                         where pt.idcategoria = cts.idcategoria
                           and cts.idcategoriasite = ctss.idcategoriasite 
                           and pt.idproduto = pd.idproduto  ) Categoria
                     , i.valorcusto
                     , quantidadecomprada 
                     , i.quantidadecomprada * i.valorcusto "Total Item"
                     , i.observacao
                     , i.iditemcompratransferencia
                     , i.idcompratransferencia
                     , i.idprodutodetalhado
                     , i.quantidaderecebida 
                     , i.quantidadeavariada
                     , i.qtdbipada  
                     , i.qtdinformadamanual 
                     , i.qtdinformadafalta 
                     , i.observacaoavaria
                     , i.custofiscal
                     , pck_estoque_fav.fnc_prateleiraproddetalhado(pd.idprodutodetalhado, (select u.idfilialfavorita
                                                                                            from usuarios u
                                                                                           where u.usuario = v('APP_USER')
                                                                                             and not exists ( select 1
                                                                                                                from roman.usuariosgruposatendimento ugp
                                                                                                               where ugp.usuario = u.usuario
                                                                                                                 and ugp.idgrupoatendimento = 47)) ) as "Local"
                    
                    , (select favorita.pck_util_fav.fnc_nomefornecedor(max(fp.idfornecedor))
                       From favorita.fornecedoresprodutos fp
                       where fp.idproduto = pd.idproduto ) fornecedor
                    , (select d.descricao from favorita.defeitos d where d.iddefeito = i.iddefeito) Defeito
                    , i.qtd_rfid
                  from favorita.itenscomprastransferencias i, 
                       favorita.produtosdetalhados pd,
                       favorita.comprastransferencias ct
                 where i.idprodutodetalhado = pd.idprodutodetalhado
                   and i.idcompratransferencia = ct.idcompratransferencia
                   and i.idcompratransferencia = :P74_IDCOMPRATRANSFERENCIA
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P74_IDCOMPRATRANSFERENCIA is not null
                  and exists ( select 1
                               from itenscomprastransferencias 
                               where idcompratransferencia = :P74_IDCOMPRATRANSFERENCIA 
                                 and quantidadecomprada > 0 )
                  and not exists ( select 1
                                   from comprastransferencias c
                                   where c.idcompratransferencia = :P74_IDCOMPRATRANSFERENCIA
                                     and c.idfilialfavoritadestino = 3
                                     and c.idtipocomptransrem = 2 )
                ```
        }
