    button integracao-homologacao (
        buttonName: INTEGRACAO_HOMOLOGACAO
        label: Integrar Remessa <br>HML
        layout {
            sequence: 10
            region: @integração-virtual-age
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-exchange
        }
        behavior {
            action: redirectUrl
            targetUrl: "javascript: AtivarIntegracaoVirtualAgeHML(function(x){console.log(x)})"
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vhostname   varchar2(100);
                  vacessoliberado varchar2(1);
                begin
                  --
                  select sys_context('USERENV','SERVER_HOST') 
                  into vhostname
                  from dual;
                  --
                  select pck_util_fav.fnc_verificaacesso (28333, :P0_IDUSUARIO) acessoliberado
                  into vacessoliberado
                  from dual;
                  --
                  -- HOMOLOGAÇÃO
                  if vhostname = 'srvbd02' and vacessoliberado = 'S' then
                    return true;
                  -- PRODUÇÃO
                  elsif vhostname = 'srvbd01' then
                    return false;
                  end if;
                  --
                end;
                ```
        }
    )

    button integracao-producao (
        buttonName: INTEGRACAO_PRODUCAO
        label: Integrar Remessa
        layout {
            sequence: 20
            region: @integração-virtual-age
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-exchange
        }
        behavior {
            action: redirectUrl
            targetUrl: "javascript: AtivarIntegracaoVirtualAgePRD(function(x){console.log(x)})"
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vhostname       varchar2(100);
                  vacessoliberado varchar2(1);
                begin
                  --
                  select sys_context('USERENV','SERVER_HOST') 
                  into vhostname
                  from dual;
                  --
                  select pck_util_fav.fnc_verificaacesso (28333, :P0_IDUSUARIO) acessoliberado
                  into vacessoliberado
                  from dual;
                  --
                  -- HOMOLOGAÇÃO
                  if vhostname = 'srvbd02' then
                    return false;
                  -- PRODUÇÃO
                  elsif vhostname = 'DBCS-CRISDU' and vacessoliberado = 'S' then
                    return true;
                  end if;
                  --
                end;
                ```
        }
    )

