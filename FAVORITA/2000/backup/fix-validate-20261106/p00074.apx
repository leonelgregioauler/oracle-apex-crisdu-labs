    pageItem P74_SESSION_PAG_584 (
        type: hidden
        layout {
            sequence: 400
            region: @compras-transferências-e-remessas
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                    l_url     varchar2(2000);
                    l_app     number := 2000;
                    l_session number := v('APP_SESSION');
                begin
                    l_url := APEX_UTIL.PREPARE_URL(
                        p_url => 'f?p=' || l_app || ':584:'||l_session||'::NO::P584_IDCOMPRATRANSFERENCIA:'||:P74_IDCOMPRATRANSFERENCIA,
                        p_checksum_type => 'SESSION');
                    
                    return l_url;
                end;
                ```
        }
    )

    pageItem P74_SESSION_SUPORTE_FATURAMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 320
            region: @compras-transferências-e-remessas
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_url varchar2(2000);
                    l_app number := 2000;
                    l_session number := v('APP_SESSION');
                BEGIN
                    l_url := APEX_UTIL.PREPARE_URL(
                        p_url => 'f?p=' || l_app || ':256:'||l_session||'::NO::P256_IDCOMPRATRANSFERENCIA:'||:P74_IDCOMPRATRANSFERENCIA,
                        p_checksum_type => 'SESSION');
                    
                    return l_url;
                END;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P74_TAGS (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: html
        }
        layout {
            sequence: 410
            region: @compras-transferências-e-remessas
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                --Projeto RFID - Gabriel Andriola - 04/02/2026
                SELECT
                       '<div class="tag-pill">
                          <span class="tag-label">Tags:</span>'
                
                       ||
                
                       /* =======================
                          TAG: LIBERADO RFID
                          ======================= */
                       CASE
                         WHEN EXISTS (
                                SELECT 1
                                  FROM classificacoescomprastransf cct
                                 WHERE cct.idcompratransferencia      = :P74_IDCOMPRATRANSFERENCIA
                                   AND cct.idcaracteristicacomptransf = 31
                              )
                          AND (
                                SELECT ct.idtipocomptransrem
                                  FROM comprastransferencias ct
                                 WHERE ct.idcompratransferencia = :P74_IDCOMPRATRANSFERENCIA
                              ) IN (0,1)
                         THEN
                              '<span class="tag-rfid">
                                 <span class="fa fa-tag" aria-hidden="true"></span>
                                 Liberado RFID
                               </span>'
                       END
                
                       ||
                
                       /* =======================
                          TAG: LIBERADO TABLET
                          ======================= */
                       CASE
                         WHEN EXISTS (
                                SELECT 1
                                  FROM classificacoescomprastransf cct
                                 WHERE cct.idcompratransferencia      = :P74_IDCOMPRATRANSFERENCIA
                                   AND cct.idcaracteristicacomptransf = 24
                              )
                          AND pck_util_fav.fnc_verificaacesso(
                                pidaplicacao => 75013,
                                pidusuario   => :P0_IDUSUARIO
                              ) = 'S'
                          AND (
                                SELECT ct.idtipocomptransrem
                                  FROM comprastransferencias ct
                                 WHERE ct.idcompratransferencia = :P74_IDCOMPRATRANSFERENCIA
                              ) IN (0,1,3,5,6,8,9,10,11)
                         THEN
                              '<span class="tag-tablet">
                                  <span class="fa fa-tablet" aria-hidden="true"></span>
                                 Liberado Tablet
                               </span>'
                       END
                
                       ||
                
                       '</div>' AS tags_html
                FROM dual;
                ```
            used: always
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                EXISTS (
                                SELECT 1
                                  FROM classificacoescomprastransf cct
                                 WHERE cct.idcompratransferencia      = :P74_IDCOMPRATRANSFERENCIA
                                   AND cct.idcaracteristicacomptransf = 31
                              )
                          AND (
                                SELECT ct.idtipocomptransrem
                                  FROM comprastransferencias ct
                                 WHERE ct.idcompratransferencia = :P74_IDCOMPRATRANSFERENCIA
                              ) IN (0,1)
                
                OR     
                
                EXISTS (
                                SELECT 1
                                  FROM classificacoescomprastransf cct
                                 WHERE cct.idcompratransferencia      = :P74_IDCOMPRATRANSFERENCIA
                                   AND cct.idcaracteristicacomptransf = 24
                              )
                          AND pck_util_fav.fnc_verificaacesso(
                                pidaplicacao => 75013,
                                pidusuario   => :P0_IDUSUARIO
                              ) = 'S'
                          AND (
                                SELECT ct.idtipocomptransrem
                                  FROM comprastransferencias ct
                                 WHERE ct.idcompratransferencia = :P74_IDCOMPRATRANSFERENCIA
                              ) IN (1,3,5,6,8,9,10,11)
                ```
        }
    )

    pageItem P74_TIPO (
        type: radioGroup
        label {
            label: Tipo
            alignment: left
        }
        settings {
            noOfCols: 5
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_retornatipocomptransrem(t.idtipocomptransrem,:P0_IDIDIOMA) display_value
                  , t.idtipocomptransrem return_value
                from tiposcomptransrem t
                where exists ( select 1
                               from permissoestiposctrp p
                               where p.idtipocomptransrem = t.idtipocomptransrem
                                 and p.visualizar = 'S' 
                                 and p.idusuario = :P0_IDUSUARIO )
                   or exists ( select 1
                                  from roman.usuariosgruposatendimento uu
                                 where uu.usuario = v('APP_USER')
                                   and uu.idgrupoatendimento = 0)
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @compras-transferências-e-remessas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
