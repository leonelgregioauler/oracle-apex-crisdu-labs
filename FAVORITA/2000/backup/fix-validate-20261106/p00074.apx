    button concluir-fat-loja (
        buttonName: CONCLUIR_FAT_LOJA
        label: Concluir Faturamento
        layout {
            sequence: 30
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                :P74_IDFILIALROMANCEDESTINO in (select rv.idfilialromance
                                                from romancevirtualage rv,
                                                     empresasvirtualage ep
                                                where rv.idempresavirtualage = ep.idempresavirtualage
                                                and ep.tipo = 'LOJA')
                and exists (select 1
                            from classificacoescomprastransf cf
