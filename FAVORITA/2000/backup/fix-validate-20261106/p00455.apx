page 455 (
    name: Compras Transferâncias e Remessas
    title: Compras Transferâncias e Remessas
    pageGroup: 71124022821844069
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region compras-transferâncias-e-remessas (
        name: Compras Transferâncias e Remessas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select case
                        when c.idtipocomptransrem in (7,8,10) then
                          apex_util.prepare_url('f?p=&APP_ID.:464:&SESSION.::NO::P464_IDCOMPRATRANSFERENCIA:'||c.idcompratransferencia) 
                        when c.idtipocomptransrem in (9) then
                          apex_util.prepare_url('f?p=&APP_ID.:465:&SESSION.::NO::P465_IDCOMPRATRANSFERENCIA:'||c.idcompratransferencia) 
                        end as LINK,
                       c.idcompratransferencia,
                       c.dataemissao as "Dt Emissão",
                       tp.descricao as "Tipo",
                       pck_util_fav.fnc_nomefilialfavorita(c.idfilialfavoritaorigem) as "Fav Origem",
                       pck_util_fav.fnc_nomefilialfavorita(c.idfilialfavoritadestino) as "Fav Destino",
                       pck_util_fav.fnc_nomefilialromance(c.idfilialromancedestino) as "Rom Destino",
                       pck_util_fav.fnc_retornasitcompratransf(c.idsituacao,1) as "Situação",
                       c.numero as "Número",
                       case
                         when to_char(c.dataembarque,'HH24') < 12 then
                           'Manhã'
                         else
                           'Tarde'
                       end as "Turno",
                       c.dataembarque as "Dt Embarque",
                       c.notafiscal as "Nota Fiscal",
                       ( select sum(ci.quantidadecomprada * ci.valorcusto)
                           from favorita.itenscomprastransferencias ci
                          where ci.idcompratransferencia = c.idcompratransferencia) as "Valor Total",
                       c.observacao as "Observação"
                  from comprastransferencias c,
                       tiposcomptransrem     tp
                 where c.idtipocomptransrem = tp.idtipocomptransrem 
                   and c.idtipocomptransrem = :P455_IDTIPOCOMPTRANSREM;
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P455_IDTIPOCOMPTRANSREM
        }
        link {
            linkColumn: customTarget
            target: {
                type: url
                url: #LINK#
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
