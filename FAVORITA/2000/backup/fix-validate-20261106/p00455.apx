    button alterar-tipo (
        buttonName: ALTERAR_TIPO
        label: Alterar tipo
        layout {
            sequence: 10
            region: @compras-transferâncias-e-remessas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 455
                items: {
                    P455_IDTIPOCOMPTRANSREM:
                }
                clearCache: 455
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Nova Remessa
        layout {
            sequence: 20
            region: @compras-transferâncias-e-remessas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 453
                items: {
                    P453_IDTIPOCOMPTRANSREM: &P455_IDTIPOCOMPTRANSREM.
                }
                clearCache: 453
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

