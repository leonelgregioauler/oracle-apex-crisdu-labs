    region tipos-comp-transf (
        name: Tipos Comp/Transf
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idtipocomptransrem,
                       t.descricao as card_title,
                       apex_util.prepare_url('f?p=&APP_ID.:455:&SESSION.::NO::P455_IDTIPOCOMPTRANSREM:'||t.idtipocomptransrem) as card_link
                from tiposcomptransrem t
                where exists (select 1
                             from permissoestiposctrp p
                             where p.idtipocomptransrem = t.idtipocomptransrem 
                             and p.idusuario = :P0_IDUSUARIO)
                and t.idtipocomptransrem in (8,9,10)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNull
            item: P455_IDTIPOCOMPTRANSREM
        }
        componentAppearance {
            template: @/cards
            templateOptions: [
                #DEFAULT#
                t-Cards--basic
                t-Cards--3cols
                t-Cards--hideBody
                u-colors
                t-Cards--animColorFill
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column CARD_LINK (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Card link
                alignment: center
            }
            layout {
                sequence: 3
            }
        )

        column CARD_TITLE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Card title
                alignment: center
            }
            layout {
                sequence: 2
            }
        )

        column IDTIPOCOMPTRANSREM (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Idtipocomptransrem
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

    )

