page 248 (
    name: Imprimir Pedido Parceiras
    title: Imprimir Pedido Parceiras
    appearance {
        pageTemplate: @minimal-pedido
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: 773202041416886674
        authentication: public
        pageAccessProtection: unrestricted
    }
    advanced {
        enableDuplicatePageSubmissions: false
        reloadOnSubmit: always
    }

    region impressão-de-pedido (
        name: Impressão de Pedido
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_imprime_fav.prc_distribuidoraparceira(pidpedido  => :P248_IDPEDIDO );
                  --
                end;
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P248_IDPEDIDO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @impressão-de-pedido
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

