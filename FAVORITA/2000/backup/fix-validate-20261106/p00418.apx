    pageItem P418_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Indicar Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROMAN.pck_romance.fnc_nomerepresentante(idrepresentante) DISPLAY_VALUE
                     , idrepresentante RETURN_VALUE
                from representantes
                where (:P418_IDFILIAL is null or
                    ( :P418_IDFILIAL is not null and idgerente in ( select idgerente from gerentes where idfilial = :P418_IDFILIAL) ))
                  and ativo = 'S'
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P418_IDFILIAL
        }
        layout {
