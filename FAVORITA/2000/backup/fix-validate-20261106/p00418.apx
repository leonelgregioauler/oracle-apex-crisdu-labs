                    P418_CEP
                    P418_EMAIL
                    P418_MSN
                    P418_OBSERVACAO
                    P418_OBSERVACAOFILIAL
                    P418_ORIGEM
                    P418_SITUACAO
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

