    dynamicAction busca-informações-do-cep (
        name: Busca Informações do CEP
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P418_CEP
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P418_CEP
        }
        serverSideCondition {
            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                      vendereco varchar2(50);
                      vbairro   varchar2(50);
                      vidcidade number;
                      vcidade   varchar2(20);
                    begin
                      --
                      select c.bairro
                           , c.endereco
                           , c.cidade
                      into vbairro
                         , vendereco
                         , vcidade
                      from roman.vw_logradouro_por_cep c
                      where c.cep = trim(replace(replace(:P418_CEP,'.',''),'-',''))
                        and rownum = 1;
                      --
                      :P418_BAIRRO   := vbairro;
                      :P418_RUA      := vendereco;
                      --
                    end;
                    ```
                itemsToSubmit: [
                    P418_CEP
                    P418_RUA
                    P418_BAIRRO
                ]
                itemsToReturn: [
                    P418_RUA
                    P418_BAIRRO
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction cadastrado (
        name: CADASTRADO
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P418_CADASTRADO
        }
        clientSideCondition {
            type: item=value
            item: P418_CADASTRADO
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P418_RUA
                    P418_NR
                    P418_BAIRRO
                    P418_COMPLEMENTO
                    P418_MSN
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P418_IDFILIAL
                    P418_NOMECOMPLETO
                    P418_IDREPRESENTANTE
                    P418_CPF
                    P418_DATANASCIMENTO
                    P418_RUA
