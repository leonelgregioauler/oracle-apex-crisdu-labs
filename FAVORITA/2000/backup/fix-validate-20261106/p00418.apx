    pageItem P418_IDCIDADE (
        type: popupLov
        label {
            label: Cidade
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nomecidade||' - '||e.sigla display_value
                     , c.idcidade  return_value
                from roman.cidades c
                   , roman.estados e
                where c.idestado = e.idestado
                  --and ( :P418_IDCONTROLECONTAOSSITE is null and ( :P418_CEP is null or UPPER(c.nomecidade) = (select CIDADE
                  --                                                                               from roman.vw_logradouro_por_cep cc
                  --                                                                               where cc.cep = trim(replace(replace(:P418_CEP,'.',''),'-',''))
                  --                                                                                 and rownum = 1) ) )
                order by 1 
                ```
