    pageItem P418_SITUACAOCLIENTE (
        type: displayOnly
        label {
            label: SItuação da Cliente
            alignment: left
        }
        layout {
            sequence: 90
            region: @controle-sac-dados-pessoais
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vsituacao varchar2(100);
                begin
                  --
                  begin 
                    --
                    select decode(v.ativo,'S','Ativa','N','Inativa') situacao
                    into vsituacao
                    from vendedoras v
                       , pessoas p
                       , roman.controlecontatossite c
                    where v.idpessoa = p.idpessoa
                      and p.cpf      = trim(replace(replace(c.cpf,'.',''),'-',''))
                      and c.idcontrolecontatossite = :P418_IDCONTROLECONTATOSSITE;
                    --
                  exception
                    when others then
                      vsituacao := 'Não Cadastrado!';
                  end;
                  --
                  return vsituacao;
                  --
                end;
                ```
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P418_IDCONTROLECONTATOSSITE
        }
        security {
            encryptSessionState: false
        }
    )

