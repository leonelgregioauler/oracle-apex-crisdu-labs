page 418 (
    name: Controle de SAC V2
    title: Controle de SAC V2
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_excluir(pid)
            {
              document.getElementById("P124_IDEDITAR").value = pid;
              apex.submit('EXCLUIR_TAREFA');
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

