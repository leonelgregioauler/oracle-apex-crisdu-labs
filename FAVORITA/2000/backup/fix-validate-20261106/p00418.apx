    pageItem P418_ULTIMAEMPRESA (
        type: displayOnly
        label {
            label: Ultima Empresa que Atendeu
            alignment: left
        }
        layout {
            sequence: 310
            region: @controle-sac-dados-pessoais
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select nvl(roman.pck_romance.fnc_nomefilial(p.idfilialromance),'Cidade não atendida por nenhuma Empresa!') filial
                from pedidos p
                where p.idpedido = ( select max(idpedido)
                                     from pedidos pd
                                     where pd.datacancelamento is null
                                       and exists ( select 1
                                                    from vendedoras v
                                                       , pessoas pp
                                                    where v.idvendedora = pd.idvendedora
                                                      and v.idpessoa    = pp.idpessoa 
                                                      and pp.idcidade   = ( select idcidade
                                                                            from roman.controlecontatossite c
                                                                            where c.idcontrolecontatossite = :P418_IDCONTROLECONTATOSSITE ) ) );
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

