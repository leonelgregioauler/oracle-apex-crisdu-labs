    region classificações (
        name: Classificações
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                return q'~
                select w.idclassificacaosac
                     , w.dataclassificado
                     , w.usuario
                     , w.caracteristica
                     , w.observacao
                from roman.vw_classificacoessac w
                where w.idcontrolecontatossite = :P418_IDCONTROLECONTATOSSITE  
                order by w.idclassificacaosac desc 
                ~';
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
