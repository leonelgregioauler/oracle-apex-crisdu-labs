    process consulta-controle-sac (
        name: Consulta Controle SAC
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vcpf                varchar2(15);
                  vcep                varchar2(20);
                  vdatacadastro       date;
                  vdatanascimento     date;
                  vidpessoa           number;
                  vidvendedora        number;
                  vdocestrangeiro     varchar2(100);
                  vtipoprotocolo      varchar2(1);
                  vidsetor            number;
                  vsubtiposol         varchar2(100);
                  vidpais             number;
                  vnumeroprocesso     number;
                  --
                begin
                  --
                  PCK_SAC_FAV.PRC_CONTROLECONTATOSSITE( PIDCONTROLECONTATOSSITE => :P418_IDCONTROLECONTATOSSITE,
                                                        PNOMECOMPLETO => :P418_NOMECOMPLETO,
                                                        PCPF => vcpf,
                                                        PDATANASCIMENTO => vdatanascimento,
                                                        PRUA => :P418_RUA,
                                                        PNR => :P418_NR,
                                                        PCOMPLEMENTO => :P418_COMPLEMENTO,
                                                        PBAIRRO => :P418_BAIRRO,
                                                        PIDCIDADE => :P418_IDCIDADE,
                                                        PCEP => vcep,
                                                        PFONE => :P418_FONE,
                                                        PFONE2 => :P418_FONE2,
                                                        PEMAIL => :P418_EMAIL,
                                                        PMSN => :P418_MSN,
                                                        PMENSAGEM => :P418_MENSAGEM,
                                                        POBSERVACAO => :P418_OBSERVACAO,
                                                        PSITUACAO => :P418_SITUACAO,
                                                        PDATACADASTRO => vdatacadastro,
                                                        PIDFILIAL => :P418_IDFILIAL,
                                                        PIDREPRESENTANTE => :P418_IDREPRESENTANTE,
                                                        PDATALIBERADOFILIAL => :P418_DATALIBERADOFILIAL,
                                                        PDATAPASSADOREPRES => :P418_DATAPASSADOREPRES,
                                                        POBSERVACAOFILIAL => :P418_OBSERVACAOFILIAL,
                                                        PORIGEM => :P418_ORIGEM,
                                                        PTIPO => :P418_TIPO,
                                                        PIDFILIALORIG => :P418_IDFILIALORIG,
                                                        PIDREPRESENTANTEORIG => :P418_IDREPRESENTANTEORIG,
                                                        PIDVENDEDORAORIG => :P418_IDVENDEDORAORIG,
                                                        PCADASTRADO => :P418_CADASTRADO,
                                                        PTIPOSOLICITACAO => :P418_TIPOSOLICITACAOMANUAL,
                                                        PCIDADE => :P418_CIDADEMANUAL,
                                                        PINADIMPLENTE => :P418_INADIMPLENTE,
                                                        PNROCONSULTASPC => :P418_NROCONSULTASPC,
                                                        PUSUARIOCADASTROU => :P418_USUARIOCADASTROU,
                                                        PCADASTROSISTEMA => :P418_CADASTROSISTEMA,
                                                        PIDFILIALFAVORITA => :P418_IDFILIALFAVORITA,
                                                        PIDUSUARIO => :P418_IDUSUARIO,
                                                        PDOCUMENTOESTRANGEIRO => vdocestrangeiro,
                                                        PMD5 => :P418_MD5,
                                                        POPERACAO_DML => 'S',
                                                        PTIPOPROTOCOLO  => vtipoprotocolo,
                                                        PIDSETOR        => vidsetor,
                                                        PSUBTIPOSOL     => vsubtiposol,
                                                        pidpais         => vidpais,
                                                        PNUMEROPROCESSO => vnumeroprocesso);
                  --
                  :P418_CPF               := REGEXP_REPLACE(vcpf,  '^(\d{3})(\d{3})(\d{3})(\d{2})$', '\1.\2.\3-\4');
                  :P418_CEP               := REGEXP_REPLACE(vcep,  '^(\d{2})(\d{3})(\d{3})$', '\1.\2-\3');
                  :P418_DATACADASTRO      := to_char(vdatacadastro,'DD/MM/RRRR HH24:MI:SS');
                  :P418_DATANASCIMENTO    := to_char(vdatanascimento,'DD/MM/RRRR');
                  --
                  begin
                    --
                    select idpessoa
                    into vidpessoa
                    from pessoas p
                    where p.cpf = replace(replace(replace(vcpf,'.',''),'-',''),' ','');
                    --
                  exception
                    when others then 
                      vidpessoa := null;
                  end;
                  --
                  if vidpessoa is not null then
                    --
                    begin
                      --
                      select idvendedora
                      into vidvendedora
                      from vendedoras v
                      where v.idpessoa = vidpessoa;
                      --
                    exception
                      when others then
                        vidvendedora := null;
                    end;
                    --
                  end if;
                  --
                  :P418_IDPESSOA := vidpessoa;
                  :P418_IDVENDEDORA := vidvendedora;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1600080869036187691
        }
    )

    process deleta-tarefa (
        name: Deleta Tarefa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidtipotarefa        number;
                  vidticketcallcenter  number;
                  vtelefone            varchar2(20);
                  vdatainclusao        date;
                  vprioridade          number;
                  vidsituacao          number;
                  vobservacao          varchar2(100);
                  vidusuario           number;
                  vidpessoa            number;
                  vidgrupoatendimento  number;
                  vdatainicio          date;
                  vdataconclusao       date;
                  vnumeroposicaoatendimento varchar2(10);
                  vidpedido            number;
                  vcodigoarea          number;
                  vmd5                 varchar2(1000);
                  --
                  vidcaracteristicasac number;
                  --
                begin
                  --
                  select idtipotarefa
                  into vidtipotarefa
                  from tarefas t
                  where t.idtarefa = :P418_IDEDITAR;
                  --
                  if vidtipotarefa = 23 then
                    --
                    vidcaracteristicasac := 21;
                    --
                  elsif vidtipotarefa = 10 then
                    --
                    vidcaracteristicasac := 23;
                    --
                  elsif vidtipotarefa = 15 then
                    --
                    vidcaracteristicasac := 22;
                    --
                  end if;
                  --
                  delete roman.classificacoessac c
                  where c.idcontrolecontatossite = :P418_IDCONTROLECONTATOSSITE
                    and c.idcaracteristicasac = vidcaracteristicasac;
                  --
                  pck_tarefas_fav.prc_tarefas(pidtarefa => :P418_IDEDITAR,
                                              pidtipotarefa => vidtipotarefa,
                                              pidticketcallcenter => vidticketcallcenter,
                                              ptelefone => vtelefone,
                                              pdatainclusao => vdatainclusao,
                                              pprioridade => vprioridade,
                                              pidsituacao => vidsituacao,
                                              pobservacao => vobservacao,
                                              pidusuario => vidusuario,
                                              pidpessoa => vidpessoa,
                                              pidgrupoatendimento => vidgrupoatendimento,
                                              pdatainicio => vdatainicio,
                                              pdataconclusao => vdataconclusao,
                                              pnumeroposicaoatendimento => vnumeroposicaoatendimento,
                                              pidpedido => vidpedido,
                                              pcodigoarea => vcodigoarea,
                                              pmd5 => vmd5,
                                              poperacao_dml => 'D');
                  --
                end;
                ```
        }
        execution {
            sequence: 100
        }
        successMessage {
            successMessage: Tarefa Excluida com sucesso!
        }
        advanced {
            executionMappingIdentifier: 3281772429511651335
        }
        serverSideCondition {
            type: request=Value
            value: EXCLUIR_TAREFA
        }
    )

