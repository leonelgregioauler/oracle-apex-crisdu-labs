    region consulta-ao-spc (
        name: Consulta ao SPC
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                return q'~
                select c.dataconsulta
                     , c.protocolo
                     , c.nome
                     , c.nomemae
                     , c.datanascimento
                     , c.email
                     , c.regiaocpf
                     , c.situacaocpf
                     , c.rua
                     , c.numeroendereco
                     , c.complemento
                     , c.bairro
                     , c.cep
                     , c.spc_quantidade
                     , c.spc_valortotal
                     , c.spc_valorultimaocorrencia
                     , c.restricao
                     , c.idconsultaspc
                     , c.ccf
                from vw_consultaspc_fav c
                where c.cpf = replace(replace(replace(:P418_CPF,'.',''),'-',''),' ','')
                ~';
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from vw_consultraspc_fav c
                where c.cpf = replace(replace(:P418_CPF,'.',''),'-','')
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 4638859931288786461
        }

