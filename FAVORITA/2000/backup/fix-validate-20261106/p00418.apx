                ```plsql
                begin
                    htp.p('<h4 align="center" style="color:red;"> O CPF '||:P124_CPF ||' é inválido. Solicite o número correto.</h4>');
                end;
                ```
            used: always
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                if not pck_util_fav.fnc_validacpfcnpj(:P418_CPF) and :P418_IDCONTROLECONTATOSSITE is not null then
                  return true;
                else 
                  return false;
                end if;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

