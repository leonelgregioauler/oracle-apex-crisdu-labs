            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select nvl(sum( (select sum(saldo)
                             from roman.notasvendas n
                             where n.idvendedora = :P418_IDVENDEDORA
                               and n.idsituacaonotavenda = 4
                               and n.saldo               > 0 ) ) ,0)
                     + nvl(sum(( select sum(p.valorpago)
                               from roman.pepinosrepresentantes p
                               where p.cpf = replace(replace(replace(:P418_CPF,'.',''),'-',''),' ','')
                                 and p.valorsaldo > 0)),0) debito
                from dual
                ```
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P418_IDVENDEDORA
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

