    region tarefas-da-cliente (
        name: Tarefas da Cliente
        type: classicReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                return q'~
                select t.idtarefa
                     , t.datainclusao
                     , t.situacao
                     , t.datainicio
                     , t.dataconclusao
                     , t.observacao
                     , t.nomeusuario
                     , t.historicos
                     , case
                         when t.idsituacao = 0 then
                           '<a href="javascript:apex.confirm(''Confirmar a exclusão desta Tarefa ? '', 
                             { request:''EXCLUIR_TAREFA'', set:{''P418_IDEDITAR'':'||t.idtarefa||' }  } )";><img src="#APP_IMAGES#baixa.png" border="0"></a>'
                         else
                           'Tarefa não pode ser Excluída!'
                       end excluir
                from vw_tarefas_fav t
                where exists ( select 1
                               from roman.classificacoessac c
                               where c.idcontrolecontatossite = :P418_IDCONTROLECONTATOSSITE
                                 and c.idvalorclassificacao = t.idtarefa )
                order by 1 desc
                ~';
                ```
        }
        layout {
            sequence: 11
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from vw_tarefas_fav t
                where exists ( select 1
                               from roman.classificacoessac c
                               where c.idcontrolecontatossite = :P418_IDCONTROLECONTATOSSITE
                                 and c.idvalorclassificacao = t.idtarefa )
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column DATACONCLUSAO (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Concluído em
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
