    process operação-dml-em-controle-sac (
        name: Operação DML em Controle SAC
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                  vdatacadastro date;
                  vdocestrangeiro varchar2(100);
                  vtipoprotocolo  varchar2(1);
                  vidsetor        number;
                  vsubtiposol     varchar2(100);
                  vidpais         number := 1;
                  vnumeroprocesso number;
                  --
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                    vdatacadastro := sysdate;
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                    vdatacadastro := to_date(:P418_DATACADASTRO,'DD/MM/RRRR HH24:MI:SS');
                  end if;
                  --
                #OWNER#.PCK_SAC_FAV.PRC_CONTROLECONTATOSSITE(
                  PIDCONTROLECONTATOSSITE => :P418_IDCONTROLECONTATOSSITE,
                  PNOMECOMPLETO => :P418_NOMECOMPLETO,
                  PCPF => :P418_CPF,
                  PDATANASCIMENTO => :P418_DATANASCIMENTO,
                  PRUA => :P418_RUA,
                  PNR => :P418_NR,
                  PCOMPLEMENTO => :P418_COMPLEMENTO,
                  PBAIRRO => :P418_BAIRRO,
                  PIDCIDADE => :P418_IDCIDADE,
                  PCEP => :P418_CEP,
                  PFONE => :P418_FONE,
                  PFONE2 => :P418_FONE2,
                  PEMAIL => :P418_EMAIL,
                  PMSN => :P418_MSN,
                  PMENSAGEM => :P418_MENSAGEM,
                  POBSERVACAO => :P418_OBSERVACAO,
                  PSITUACAO => :P418_SITUACAO,
                  PDATACADASTRO => vdatacadastro,
                  PIDFILIAL => :P418_IDFILIAL,
                  PIDREPRESENTANTE => :P418_IDREPRESENTANTE,
                  PDATALIBERADOFILIAL => :P418_DATALIBERADOFILIAL,
                  PDATAPASSADOREPRES => :P418_DATAPASSADOREPRES,
                  POBSERVACAOFILIAL => :P418_OBSERVACAOFILIAL,
                  PORIGEM => :P418_ORIGEM,
                  PTIPO => :P418_TIPO,
                  PIDFILIALORIG => :P418_IDFILIALORIG,
                  PIDREPRESENTANTEORIG => :P418_IDREPRESENTANTEORIG,
                  PIDVENDEDORAORIG => :P418_IDVENDEDORAORIG,
                  PCADASTRADO => :P418_CADASTRADO,
                  PTIPOSOLICITACAO => :P418_TIPOSOLICITACAOMANUAL,
                  PCIDADE => :P418_CIDADEMANUAL,
                  PINADIMPLENTE => :P418_INADIMPLENTE,
                  PNROCONSULTASPC => :P418_NROCONSULTASPC,
                  PUSUARIOCADASTROU => :P418_USUARIOCADASTROU,
                  PCADASTROSISTEMA => :P418_CADASTROSISTEMA,
                  PIDFILIALFAVORITA => :P418_IDFILIALFAVORITA,
                  PIDUSUARIO => :P0_IDUSUARIO,
                  PDOCUMENTOESTRANGEIRO => vdocestrangeiro,
                  PMD5 => :P418_MD5,
                  POPERACAO_DML => voperacao_dml,
                  PTIPOPROTOCOLO  => vtipoprotocolo,
                  PIDSETOR        => vidsetor,
                  PSUBTIPOSOL     => vsubtiposol,
                  Pidpais         => vidpais,
                  PNUMEROPROCESSO => vnumeroprocesso);
                  
                end;
                ```
        }
        execution {
            sequence: 10
