    pageItem P418_IDFILIAL (
        type: popupLov
        label {
            label: Indicar Empresa
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idfilial
                from roman.vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                  and exists ( select 1
                               from roman.parametros pr
                               where pr.idfilial = f.idfilial
                                 and pr.nome     = 'ENVIOINDICACAOAUTOMATICA' 
                                 and pr.valor    = 'S' )
                union
                select nome
                     , idfilial
                from roman.vw_filiais f
                where f.idfilial = 1140
                ```
        }
        layout {
            sequence: 30
            region: @controle-sac-dados-pessoais
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
