    pageItem P418_AVISO_CADASTRODUPLO (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 30
            region: @avisos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<font color="blue"><h2>Os Protocolos '||listagg(c.idcontrolecontatossite,',') within group (order by 1)
                                                              ||' possuem o mesmo CPF cadastrado!</font></h2>' msg 
                from roman.controlecontatossite c
                where c.idcontrolecontatossite != :P418_IDCONTROLECONTATOSSITE
                  and replace(replace(c.cpf,'.',''),'-','') = replace(replace(:P418_CPF,'.',''),'-','')
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.controlecontatossite c
                where c.idcontrolecontatossite != :P418_IDCONTROLECONTATOSSITE
                  and replace(replace(c.cpf,'.',''),'-','') = replace(replace(:P418_CPF,'.',''),'-','')
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P418_AVISO_CODIGO_LIBERACAO (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 20
            region: @avisos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            preText:
                ```html
                <font color="Blue"><h3>
                    Existe um código de liberação ativo para este CPF! 
                    </h3></font>
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.historicosconsultasdoc h
                where replace(replace(replace(h.documento,'.',''),'-',''),' ','') = replace(replace(replace(:P418_CPF,'.',''),'-',''),' ','')
                  and DATACONSULTA > trunc(SYSDATE) - 5
                 -- AND ( trunc(sysdate) - trunc(h.dataconsulta) ) <= 5
                  and h.liberado = 'S'
                  and not exists ( select 1
                                   from roman.controlecontatossite c
                                   where c.idcontrolecontatossite = :P418_IDCONTROLECONTATOSSITE
                                     and codigoliberacao = h.codigoliberacao )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P418_AVISO_CPF_INVALIDO (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 10
            region: @avisos
            slot: regionBody
            alignment: left
        }
