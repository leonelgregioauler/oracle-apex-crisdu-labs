    validation cadastrado-obrigatório (
        name: CADASTRADO obrigatório
        execution {
            sequence: 70
        }
        validation {
            type: itemIsNotZero
            item: P418_CADASTRADO
        }
        error {
            errorMessage: #LABEL# deve ter algum valor.
            associatedItem: @P418_CADASTRADO
        }
        serverSideCondition {
            type: request=Value
            value: INSERIR
        }
    )

    validation cpf-obrigatório (
        name: CPF obrigatório
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P418_CPF
        }
        error {
            errorMessage: CPF deve ter um valor.
            associatedItem: @P418_CPF
        }
        serverSideCondition {
            type: never
        }
    )

    validation cpf-válido (
        name: CPF válido
        execution {
            sequence: 50
        }
        validation {
            type: itemMatchesRegexp
            item: P418_CPF
            regexp: "\\d{3}.\\d{3}.\\d{3}-\\d{2}"
        }
        error {
            errorMessage: CPF Inválido. Informe um CPF válido no formato: 000.000.000-00
            associatedItem: @P418_CPF
        }
        serverSideCondition {
            whenButtonPressed: @inserir
            type: never
        }
    )

