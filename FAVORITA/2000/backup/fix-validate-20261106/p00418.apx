    pageItem P418_ENVIADO_COBRANCA (
        type: textField
        label {
            label: Enviado Cobrança
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 150
            region: @controle-sac-dados-pessoais
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vcobranca varchar2(100);
                begin
                  --
                  select 'Sim'
                  into vcobranca
                  from dual
                  where exists ( select 1
                                 from roman.notasvendas n
                                 where n.idvendedora = :P418_IDVENDEDORA
                                   and n.saldo       > 0
                                   and n.idsituacaonotavenda = 4 
                                   and n.enviadocobranca = 'S')
                     or exists ( select 1
                                 from vendedoras v
                                 where v.idvendedora = :P418_IDVENDEDORA
                                   and v.SPC = 'S' )
                     or exists ( select 1
                                 from catal.pedidos po
                                 where po.idvendedora = :P418_IDVENDEDORA
                                   and po.situacao not in ('Q','Z')
                                   and exists ( select 1
                                                from catal.boletos b
                                                where b.idpedido = po.idpedido
                                                  and b.situacao not in ('Q','Z')
                                                  and b.responsavelcobranca is not null ) )
                     or exists ( select 1
                                 from pedidos p
                                 where p.idvendedora = :P418_IDVENDEDORA
                                   and p.datacancelamento is null
                                   and p.idsituacaocobranca > 50 
                                   and exists ( select 1
                                                from vencimentospedidos v
                                                where v.idpedido = p.idpedido
                                                  and v.situacaovencimento = 'V'
                                                  and v.datavencimento < trunc(sysdate)
                                                  and v.valorpago < v.valorpagar ) );
                  --
                  return vcobranca;
                  --
                exception
                  when others then
                    return 'Não';
                end;
                ```
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P418_IDVENDEDORA
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

