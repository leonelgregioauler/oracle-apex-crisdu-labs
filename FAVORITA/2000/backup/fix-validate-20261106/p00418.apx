    process aguardando-retorno-da-empresa (
        name: Aguardando Retorno da Empresa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidclassificacaosac     number := null;
                  vidcaracteristicasac    number := 30; 
                  vdataclassificado       date := sysdate;
                  vidvalorclassificacao   number;
                  vobservacao             varchar2(1000);
                  vidcontrolecontatossite number := :P418_IDCONTROLECONTATOSSITE;
                  vidusuario              number := :P0_IDUSUARIO;
                  vmd5                    varchar2(1000);
                  --
                begin
                  --
