    pageItem P418_DEBITO_FAVORITA (
        type: numberField
        label {
            label: Débito Favorita
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 140
            region: @controle-sac-dados-pessoais
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select nvl(( select sum(v.saldodevedor)
                               from vw_pedidos_fav v
                               where idvendedora    = :P418_IDVENDEDORA
                                 and ididioma       = :P0_IDIDIOMA
                                 and v.tipopedido   = 'P'
                                 and v.datacancelamento is null
                                 and v.saldodevedor > 0)  ,0)
                       + nvl(( select sum(c.saldodevedor)
                               from vw_pedidos_old c
                               where idvendedora    = :P418_IDVENDEDORA
                                 and c.saldodevedor > 0.5 
                                 and c.idsituacao not in ( 'Q','U','K') ) ,0)
                       + nvl(( select sum(t.saldodevedor)
                               from vw_pedidos_fav t
                               where idvendedora    = :P418_IDVENDEDORA
                                 and ididioma       = :P0_IDIDIOMA
                                 and t.tipopedido   = 'T'
                                 and t.valorapagar  > 0
                                 and t.saldodevedor > 0) ,0) saldo
                  from dual;
                ```
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P418_IDVENDEDORA
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P418_DEBITO_ROMANCE (
        type: numberField
        label {
            label: Débito Romance
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 130
