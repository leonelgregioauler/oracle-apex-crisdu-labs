    validation valida-observação (
        name: Valida Observação
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where length(:P227_OBSERVACAO) > 20
                ```
        }
        error {
            errorMessage: Informe uma descrição sucinta para poder efetuar o pagamento.
        }
    )

    validation valor-líquido-não-pode-ser-zero (
        name: Valor Líquido não pode ser ZERO
        execution {
            sequence: 80
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where nvl(to_number(:P227_VALORLIQUIDO, '999G999G999G990D00'),0) = 0
                ```
        }
        error {
            errorMessage: Valor Líquido deve ser maior que zero (0).
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where v('REQUEST') in ('INSERIR','ATUALIZAR')
                ```
        }
    )

    validation valor-pago-não-pode-ser-zero (
        name: Valor Pago não pode ser ZERO
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where nvl(to_number(:P227_VALORPAGO, '999G999G999G990D00'),0) = 0
                ```
        }
        error {
            errorMessage: Valor Original deve ser maior que zero (0).
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where v('REQUEST') in ('INSERIR','ATUALIZAR')
                ```
        }
    )

    validation valorliquido-obrigatório (
        name: VALORLIQUIDO obrigatório
        execution {
            sequence: 100
        }
