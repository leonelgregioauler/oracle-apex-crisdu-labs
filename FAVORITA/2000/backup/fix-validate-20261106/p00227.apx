    button anexar (
        buttonName: ANEXAR
        label: Anexar
        layout {
            sequence: 10
            region: @pagamentos-compras-transferências
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-paperclip
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 229
                items: {
                    P229_IDPAGAMENTOCOMPRATRANSF: &P227_IDPAGAMENTOCOMPRATRANSF.
                    P229_IDANEXOPGTOCOMPRATRANSF:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 60
            region: @pagamentos-compras-transferências
