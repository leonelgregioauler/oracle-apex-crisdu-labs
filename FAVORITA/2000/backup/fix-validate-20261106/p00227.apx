    pageItem P227_IDCONTABANCARIA (
        type: selectList
        label {
            label: Conta Bancária
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.beneficiario||' ('||b.nomebanco||' - Ag: '||c.agencia||'- CC: '||c.conta||')' d
                     , c.idcontabanc r
                from roman.contasbancarias c
                   , roman.bancos b
                where b.idbanco = c.idbanco
                  and c.ativo = 'S'
                  and c.usosetorcobranca = 'S'
                order by 1;
                ```
            nullDisplayValue: - Selecione a Conta -
        }
        layout {
            sequence: 90
            region: @pagamentos-compras-transferências
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P227_IDFORMAPAGAMENTO (
        type: selectList
        label {
            label: Forma do Pagamento
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select descricao as d,
                       idformapagamento as r
                  from formaspagamentos
                  where idformapagamento in (4, 5, 6)
                 order by 1
                ```
            nullDisplayValue: - Selecione a Forma de Pagamento -
        }
        layout {
            sequence: 70
            region: @pagamentos-compras-transferências
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        readOnly {
            type: itemIsNotNull
            item: P227_IDPAGAMENTOCOMPRATRANSF
        }
        security {
            encryptSessionState: false
        }
    )

