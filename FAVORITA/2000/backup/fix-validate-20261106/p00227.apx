    dynamicAction consulta-saldo-pagamento (
        name: Consulta Saldo Pagamento
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      vsaldo number;
                      vvalorpago number;
                    begin
                      --
                      if :P227_PAGINAORIGEM = 226 then 
                        --
                        select saldo
                        into vsaldo
                        from vw_vencimentoscompratransf_fav
                        where idvencimentocompratransf = :P227_IDVENCIMENTOCOMPRATRANSF;
                        --
                        :P227_VALORPAGO := to_char(vsaldo, '999G999G999G990D00');
                        --
                      else
                        -- 
                        select p.valorpago
                        into vvalorpago
                        from pagamentoscomprastransf p
                           , vencimentoscomprastransf v
                        where p.idvencimentocompratransf = v.idvencimentocompratransf
                        and p.idpagamentocompratransf = :P227_IDPAGAMENTOCOMPRATRANSF;
                        --
                        :P227_VALORPAGO := to_char(vvalorpago, '999G999G999G990D00');
                        --
                      end if;
                      --
                    end;
                    
                    ```
                itemsToSubmit: [
                    P227_IDVENCIMENTOCOMPRATRANSF
                    P227_PAGINAORIGEM
                ]
                itemsToReturn: P227_VALORPAGO
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction conta-bancaria (
        name: Conta Bancaria
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P227_IDFORMAPAGAMENTO
        }
        clientSideCondition {
            type: item=value
            item: P227_IDFORMAPAGAMENTO
            value: 4
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P227_IDCONTABANCARIA
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P227_IDCONTABANCARIA
            }
            execution {
                sequence: 10
            }
        )

    )

