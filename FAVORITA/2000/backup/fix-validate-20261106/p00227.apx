    dynamicAction calcular-valor-líquido-acréscimo (
        name: Calcular Valor Líquido (Acréscimo)
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P227_ACRESCIMO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    :P227_VALORLIQUIDO := (to_number(nvl(:P227_VALORPAGO, 0),     '999G999G999G990D00') - 
                                           to_number(nvl(:P227_DESCONTO,  0),     '999G999G999G990D00') +
                                           to_number(nvl(:P227_ACRESCIMO, 0),     '999G999G999G990D00'));
                    --
                    :P227_VALORLIQUIDO := to_char(:P227_VALORLIQUIDO, '999G999G999G990D00');
                    ```
                itemsToSubmit: [
                    P227_VALORPAGO
                    P227_ACRESCIMO
                    P227_DESCONTO
                ]
                itemsToReturn: P227_VALORLIQUIDO
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction calcular-valor-líquido-desconto (
        name: Calcular Valor Líquido (Desconto)
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P227_DESCONTO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    :P227_VALORLIQUIDO := (to_number(nvl(:P227_VALORPAGO, 0),     '999G999G999G990D00') - 
                                           to_number(nvl(:P227_DESCONTO,  0),     '999G999G999G990D00') +
                                           to_number(nvl(:P227_ACRESCIMO, 0),     '999G999G999G990D00'));
                    --
                    :P227_VALORLIQUIDO := to_char(:P227_VALORLIQUIDO, '999G999G999G990D00');
                    ```
                itemsToSubmit: [
                    P227_VALORPAGO
                    P227_ACRESCIMO
                    P227_DESCONTO
                ]
                itemsToReturn: P227_VALORLIQUIDO
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction calcular-valor-líquido-valor-original (
        name: Calcular Valor Líquido (Valor Original)
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P227_VALORPAGO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    :P227_VALORLIQUIDO := (to_number(nvl(:P227_VALORPAGO, 0),     '999G999G999G990D00') - 
                                           to_number(nvl(:P227_DESCONTO,  0),     '999G999G999G990D00') +
                                           to_number(nvl(:P227_ACRESCIMO, 0),     '999G999G999G990D00'));
                    --
                    :P227_VALORLIQUIDO := to_char(:P227_VALORLIQUIDO, '999G999G999G990D00');
                    ```
                itemsToSubmit: [
                    P227_VALORPAGO
                    P227_ACRESCIMO
                    P227_DESCONTO
                ]
                itemsToReturn: P227_VALORLIQUIDO
                showProcessing: true
            }
            execution {
