    )

    validation valorpago-obrigatório (
        name: VALORPAGO obrigatório
        execution {
            sequence: 90
        }
        validation {
            type: itemIsNotNull
            item: P227_VALORPAGO
        }
        error {
            errorMessage: Valor pago deve ter um valor.
            associatedItem: @P227_VALORPAGO
        }
    )

    process consulta-pagamentos-compras-transferências (
        name: Consulta Pagamentos Compras Transferências
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vdatapagamento    date;
                  vvalorpago        number(15,2);
                  vtaxa             number(15,2);
                  vacrescimo        number(15,2);
                  vdesconto         number(15,2);
                  vvalorliquido     number(15,2);
                  --
                  vidcontafinanceira    number;
                  vidsubcontafinanceira number;
                  videntificado         varchar2(1);
                  vdias                 number;
                  vidmoeda              number;
                  --
                begin
                  -- 
                  PCK_COMPRASTRANSFPARC_FAV.PRC_PAGAMENTOSCOMPRASTRANSF (
                    PIDPAGAMENTOCOMPRATRANSF    => :P227_IDPAGAMENTOCOMPRATRANSF,
                    PIDVENCIMENTOCOMPRATRANSF   => :P227_IDVENCIMENTOCOMPRATRANSF,
                    PIDFORMAPAGAMENTO           => :P227_IDFORMAPAGAMENTO,
                    PDATAPAGAMENTO              => vdatapagamento,
                    PVALORPAGO                  => vvalorpago,
                    PORIGEMPAGAMENTO            => :P227_ORIGEMPAGAMENTO,
                    PNUMEROBOLETO               => :P227_NUMEROBOLETO,
                    PIDSITUACAO                 => :P227_IDSITUACAO,
                    PTAXA                       => vtaxa,
                    PACRESCIMO                  => vacrescimo,
                    PDESCONTO                   => vdesconto,
                    PVALORLIQUIDO               => vvalorliquido,
                    PNUMEROCOMPROVANTE          => :P227_NUMEROCOMPROVANTE,
                    PIDCONTABANCARIA            => :P227_IDCONTABANCARIA,
                    POBSERVACAO                 => :P227_OBSERVACAO,
                    PIDUSUARIOPAGAMENTO         => :P0_IDUSUARIO,
                    pidcontafinanceira          => vidcontafinanceira,
                    pidsubcontafinanceira       => vidsubcontafinanceira,
                    pidentificado               => videntificado,
                    pdias                       => vdias, 
                    pidmoeda                    => vidmoeda,
                    PMD5                        => :P227_MD5,
                    POPERACAO_DML               => 'S' );
                  --
                  :P227_DATAPAGAMENTO := to_char(vdatapagamento   , 'DD/MM/RRRR');
                  :P227_VALORPAGO     := to_char(vvalorpago       , '999G999G999G990D00');
                  :P227_TAXA          := to_char(vtaxa            , '999G999G999G990D00');
                  :P227_ACRESCIMO     := to_char(vacrescimo       , '999G999G999G990D00');
                  :P227_DESCONTO      := to_char(vdesconto        , '999G999G999G990D00');
                  :P227_VALORLIQUIDO  := to_char(vvalorliquido    , '999G999G999G990D00');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 477330960937332766
        }
        serverSideCondition {
            type: itemIsNull
            item: P227_IDVENCIMENTOCOMPRATRANSF
        }
    )

