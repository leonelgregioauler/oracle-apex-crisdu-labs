    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 50
            region: @pagamentos-compras-transferências
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIR');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util_fav.fnc_verificaacesso(28605,:P0_IDUSUARIO) = 'S'
                  and :P227_IDPAGAMENTOCOMPRATRANSF is not null
                  and :P227_NUMEROBOLETO is null
                ```
        }
    )

