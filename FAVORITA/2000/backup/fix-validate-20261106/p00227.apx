page 227 (
    name: Pagamentos Compras Transferências
    title: Pagamentos Compras Transferências
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 70%
        height: 85%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region pagamentos-compras-transferências (
        name: Pagamentos Compras Transferências
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P227_ACRESCIMO (
        type: textField
        label {
            label: Acréscimo
            alignment: left
        }
        layout {
            sequence: 140
            region: @pagamentos-compras-transferências
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G990D00
            width: 15
        }
        advanced {
            customAttributes: style="text-align:right" onkeyup="formataMoeda(this);"
        }
        default {
            type: static
            staticValue: 0,00
        }
        readOnly {
            type: itemIsNotNull
            item: P227_IDPAGAMENTOCOMPRATRANSF
        }
        security {
            encryptSessionState: false
        }
    )

