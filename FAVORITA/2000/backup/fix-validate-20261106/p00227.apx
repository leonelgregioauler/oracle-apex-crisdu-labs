    process operação-dml-em-pagamentos-compras-transferências (
        name: Operação DML em Pagamentos Compras Transferências
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                  --
                  vdatapagamento    date;
                  vvalorpago        number(15,2);
                  vtaxa             number(15,2);
                  vacrescimo        number(15,2);
                  vdesconto         number(15,2);
                  vvalorliquido     number(15,2);
                  --
                  vidcontafinanceira    number;
                  vidsubcontafinanceira number;
                  videntificado         varchar2(1);
                  vdias                 number;
                  vidmoeda              number;
                  --
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  vdatapagamento := to_date(:P227_DATAPAGAMENTO   , 'DD/MM/RRRR');
                  vvalorpago     := to_number(:P227_VALORPAGO     , '999G999G999G990D00');
                  vtaxa          := to_number(:P227_TAXA          , '999G999G999G990D00');
                  vacrescimo     := to_number(:P227_ACRESCIMO     , '999G999G999G990D00');
                  vdesconto      := to_number(:P227_DESCONTO      , '999G999G999G990D00');
                  vvalorliquido  := to_number(:P227_VALORLIQUIDO  , '999G999G999G990D00');
                  --
                  #OWNER#.PCK_COMPRASTRANSFPARC_FAV.PRC_PAGAMENTOSCOMPRASTRANSF (
                    PIDPAGAMENTOCOMPRATRANSF    => :P227_IDPAGAMENTOCOMPRATRANSF,
                    PIDVENCIMENTOCOMPRATRANSF   => :P227_IDVENCIMENTOCOMPRATRANSF,
                    PIDFORMAPAGAMENTO           => :P227_IDFORMAPAGAMENTO,
                    PDATAPAGAMENTO              => vdatapagamento,
                    PVALORPAGO                  => vvalorpago,
                    PORIGEMPAGAMENTO            => :P227_ORIGEMPAGAMENTO,
                    PNUMEROBOLETO               => :P227_NUMEROBOLETO,
                    PIDSITUACAO                 => :P227_IDSITUACAO,
                    PTAXA                       => vtaxa,
                    PACRESCIMO                  => vacrescimo,
                    PDESCONTO                   => vdesconto,
                    PVALORLIQUIDO               => vvalorliquido,
                    PNUMEROCOMPROVANTE          => :P227_NUMEROCOMPROVANTE,
                    PIDCONTABANCARIA            => :P227_IDCONTABANCARIA,
                    POBSERVACAO                 => :P227_OBSERVACAO,
                    PIDUSUARIOPAGAMENTO         => :P0_IDUSUARIO,
                    pidcontafinanceira          => vidcontafinanceira,
                    pidsubcontafinanceira       => vidsubcontafinanceira,
                    pidentificado               => videntificado,
                    pdias                       => vdias, 
                    pidmoeda                    => vidmoeda,
                    PMD5                        => :P227_MD5,
                    POPERACAO_DML               => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 477330547240332766
        }
    )

    process valida-valor-pago-ao-atualizar (
        name: Valida Valor Pago ao Atualizar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vvalorpago number(15,2);
                  vvalorvencimento number (15,2);
                begin
                  --
                  select nvl(sum(valorpago), 0) + to_number(:P227_VALORPAGO, '999G999G999G990D00')
                  into vvalorpago
                  from pagamentoscomprastransf
                  where idvencimentocompratransf = :P227_IDVENCIMENTOCOMPRATRANSF
                  and idpagamentocompratransf not in (:P227_IDPAGAMENTOCOMPRATRANSF)
                  and idsituacao = 20;
                  --
                  select valorvencimento
                  into vvalorvencimento
                  from vencimentoscomprastransf
                  where idvencimentocompratransf = :P227_IDVENCIMENTOCOMPRATRANSF;
                  --
                  if (  vvalorpago > vvalorvencimento ) then
                    raise_application_error(-20001, 'Valor pago maior que o saldo. O saldo é R$ '||to_char(vvalorvencimento - (vvalorpago - to_number(:P227_VALORPAGO, '999G999G999G990D00')), '999G999G999G990D00')||'. Informe um valor menor ou igual.');
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 477331757671332767
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

    process valida-valor-pago-ao-inserir (
        name: Valida valor pago ao Inserir
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vsaldo number;
                begin
                  select saldo
                  into vsaldo
                  from vw_vencimentoscompratransf_fav
                  where idvencimentocompratransf = :P227_IDVENCIMENTOCOMPRATRANSF;
                  --
                  if (replace(:P227_VALORPAGO, '.', '')) > vsaldo then
                    raise_application_error(-20001, 'O saldo de pagamento é R$ '||to_char(vsaldo, '999G999G999G990D00')||'. Informe um valor menor.');
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 477331334968332767
        }
        serverSideCondition {
            whenButtonPressed: @inserir
        }
    )

