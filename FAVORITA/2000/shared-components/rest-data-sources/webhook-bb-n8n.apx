        parameter {
            type: requestOrResponseBody
            direction: out
        }
    )

    parameter url-destino (
        name: URL_DESTINO
        operation: @webhook_bb_n8n
        parameter {
            type: httpHeader
        }
        value {
            static: true
            defaultValueType: staticValue
            staticValue: https://webhook.intbancarias.crisdulabs.com.br/webhook/webhook_bb
        }
    )

    dataProfile {
        name: Webhook BB
        rowSelector: items
    }

    dataProfileColumn column-1-id (
        columnName: COLUMN_1_ID
        source {
            sequence: 1
            dataType: number
        }
        parsing {
            pathExpression: id
        }
    )

    dataProfileColumn column-2-name (
        columnName: COLUMN_2_NAME
        source {
            sequence: 2
            dataType: varchar2
            maxLength: 2000
        }
        parsing {
            pathExpression: name
        }
    )

    dataProfileColumn column-3-hiredate (
        columnName: COLUMN_3_HIREDATE
        source {
            sequence: 3
            dataType: date
        }
        parsing {
            pathExpression: hire-date
            formatMask: YYYY-MM-DD"T"HH24:MI:SS
            hasTimeZone: false
        }
    )

)

