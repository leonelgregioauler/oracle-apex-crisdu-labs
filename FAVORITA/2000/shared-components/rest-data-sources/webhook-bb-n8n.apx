restDataSource webhook_bb_n8n (
    name: Webhook BB
    source {
        type: http
        remoteServer: @MIDDLEMAN
        urlPathPrefix: /comunicar
    }

    operation webhook_bb_n8n (
        label: POST
        operation {
            urlPattern: .
            httpMethod: post
            databaseOperation: fetchRows
        }
        requestBody {
            template: #DATA#
            versionNumber: 1
        }
    )

    parameter content-type (
        name: Content-Type
        operation: @webhook_bb_n8n
        parameter {
            type: httpHeader
        }
        value {
            static: true
            defaultValueType: staticValue
            staticValue: application/json
        }
    )

