restDataSource TOKEN_BB_N8N (
    name: TokenBB
    source {
        type: http
        remoteServer: @MIDDLEMAN
        urlPathPrefix: /comunicar
    }

    operation token_bb_n8n (
        label: POST
        operation {
            urlPattern: .
            httpMethod: post
            databaseOperation: fetchRows
        }
        requestBody {
            template:
                ```
                {
                    "grant_type": "client_credentials",
                    "scope": "#SCOPE#",
                    "basic": "#BASIC#",
                    "app_key": "#APP_KEY#"
                }
                ```
            versionNumber: 1
        }
    )

    parameter app-key (
        name: APP_KEY
        operation: @token_bb_n8n
        parameter {
            type: requestOrResponseBody
        }
        value {
            defaultValueType: staticValue
            staticValue: 7091808b0fffbe801368e18130050a56b9d1a5b4
        }
    )

    parameter basic (
        name: BASIC
        operation: @token_bb_n8n
        parameter {
            type: requestOrResponseBody
        }
        value {
            defaultValueType: staticValue
            staticValue: Basic 
        }
    )

    parameter content-type (
        name: Content-Type
        operation: @token_bb_n8n
        parameter {
            type: httpHeader
        }
        value {
            static: true
            defaultValueType: staticValue
            staticValue: application/json
        }
    )

    parameter response (
        name: RESPONSE
        operation: @token_bb_n8n
        parameter {
            type: requestOrResponseBody
            direction: out
        }
    )

    parameter scope (
        name: SCOPE
        operation: @token_bb_n8n
        parameter {
            type: requestOrResponseBody
        }
        value {
            defaultValueType: staticValue
            staticValue: cobrancas.boletos-requisicao
        }
    )

    parameter url-destino (
        name: URL_DESTINO
        operation: @token_bb_n8n
        parameter {
            type: httpHeader
        }
        value {
            defaultValueType: staticValue
            staticValue: https://n8n.intbancarias.crisdulabs.com.br/webhook-test/gera_token
        }
    )

    dataProfile {
        name: Get Token
        rowSelector: items
    }
)

