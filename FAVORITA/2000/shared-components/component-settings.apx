componentSetting (
    type: dynamicAction
    name: showAiAssistant
)

componentSetting (
    type: dynamicAction
    name: plugin/pretiusApexNestedReports
)

componentSetting (
    type: dynamicAction
    name: plugin/pretiusApexEnhancedNotifications
)

componentSetting (
    type: item
    name: colorPicker
)

componentSetting (
    type: item
    name: datePicker
    settings {
        appearanceBehavior: [
            monthPicker
            yearPicker
            showTodayButton
        ]
    }
)

componentSetting (
    type: item
    name: geocodedAddress
    settings {
        mapPreview: [
            resultsPopup
            item
        ]
    }
)

componentSetting (
    type: item
    name: selectMany
)

componentSetting (
    type: item
    name: checkbox
    settings {
        uncheckedValue: N
    }
)

componentSetting (
    type: item
    name: starRating
    settings {
        tooltip: #VALUE#
    }
)

componentSetting (
    type: item
    name: switch
    settings {
        displayStyle: pillButton
        onValue: Y
    }
)

componentSetting (
    type: item
    name: plugin/select
    settings {
        noResultsFoundMessage: Nenhum registro encontrado.
        searchingMessage: Pesquisando..
        loadingMoreResultsMessage: Mostrar mais..
    }
)

componentSetting (
    type: process
    name: serverSideGeocoding
)

componentSetting (
    type: region
    name: regionDisplaySelector
)

componentSetting (
    type: region
    name: interactiveReport
    settings {
        actionsMenuStructure: legacy
        autoResetButton: false
    }
)

componentSetting (
    type: region
    name: map
)

componentSetting (
    type: region
    name: plugin/d3LineChart
)

componentSetting (
    type: region
    name: plugin/flotPieChart
)

componentSetting (
    type: restDataSource
    name: oracleCloudAppsSaas
)

componentSetting (
    type: restDataSource
    name: oracleCloudAppsBoss
)

