list menu-de-navegação (
    name: Menu de Navegação
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select level
                 , descricao        label
                 , 'f?p=&APP_ID.:'||PAGINA||':&SESSION.::NO:::'          target
                 , paginascorrentes  is_current_list_entry
                 , imagem image
              from ( select a.idaplicacao
                          , a.descricao
                          , a.hierarquia
                          , a.pagina
                          , a.imagem
                          , a.paginascorrentes
                     from roman.aplicacoes a 
                     where a.idsistema = 2000
                       and aparecer = 'S'
                       and exists ( select 1 
                                    from roman.acessos b 
                                    where b.idaplicacao = a.idaplicacao 
                                      and b.usuario = v('APP_USER'))
                     union
                     select a.idaplicacao
                          , a.descricao
                          , a.hierarquia
                          , a.pagina
                          , a.imagem
                          , a.paginascorrentes
                     from roman.aplicacoes a 
                     where a.idsistema = 2000
                       and a.hierarquia is null
                       and aparecer = 'S'
                       and exists ( select 1 
                                    from roman.acessos b 
                                    where b.idaplicacao = a.idaplicacao 
                                      and b.usuario = v('APP_USER'))
                     order by idaplicacao)
             start with hierarquia is null
            connect by prior idaplicacao = hierarquia
            ```
    }
)

