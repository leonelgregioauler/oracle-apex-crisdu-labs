    entry consumidor-final (
        label: Consumidor Final
        layout {
            sequence: 71
        }
        link {
            target: {
                page: 80
                items: {
                    P80_IDVENDEDORA: 2363887
                }
            }
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vliberar boolean;
                  vadapto varchar2(1);
                begin
                  --
                  begin
                    --
                    select valor
                    into vadapto
                    from parametros p
                    where p.nome = 'LOJA UTILIZANDO ADAPTO'
                      and p.idfilialfavorita = :P0_IDFILIALFAVORITA;
                    --
                  exception 
                    when others then
                      vadapto := 'N';
                  end;
                  --
                  vliberar :=  pck_controle_fav.fnc_validaacessopagina(pidpagina => 80 );
                  --
                  if (:P0_NUMEROPOSICAOATENDIMENTO is not null or :P0_IDPERFILATENDIMENTO is not null) and vliberar and vadapto = 'S' and :P0_IDIDIOMA = 1 then
                    --
                    return true;
                    --
                  end if;
                end;
                ```
        }
    )

