            imageIconCssClasses: fa-male
        }
        layout {
            sequence: 190
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry atendimento (
        label: Atendimento
        layout {
            sequence: 18
        }
        link {
            target: {
                page: 373
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.idgrupoatendimento in ( 0 , 9 )
                                 and ug.usuario = v('APP_USER') )
                
                ```
        }
    )

    entry concluir-análise (
        label: Concluir Análise
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 139
