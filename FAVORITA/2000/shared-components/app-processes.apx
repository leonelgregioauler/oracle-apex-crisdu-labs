)

appProcess informa-pefil (
    name: Informa Pefil
    source {
        plsqlCode:
            ```plsql
            begin
              --
              select pe.descricao || ' - ' || pv.descricao||' - '||pa.ididioma display_value
              into :NOMEPERFIL
              from PERFISATENDIMENTOS         pa
                 , PERFISVENDAS               pv
                 , PERFIS                     pe
             where pa.idperfilvenda       = pv.idperfilvenda
               and pv.idperfil            = pe.idperfil
               and pa.idperfilatendimento = :P0_IDPERFILATENDIMENTO;
              --
            end;
            ```
    }
    execution {
        sequence: 1
    }
    serverSideCondition {
        type: expression
        language: sql
        sqlExpression: :P0_IDPERFILATENDIMENTO is not null
    }
)

appProcess negociacaobipagem (
    name: negociacaobipagem
    source {
        plsqlCode:
            ```plsql
            declare
              --
              vnumero       varchar2(30);
              vtexto        varchar2(500);
              vlength       number;
              vnumeropedido number;
              --
            begin
              --  
              select length(v('F2000117ETIQUETA'))-3
              into vlength
              from dual;
              --
              select substr(v('F2000117ETIQUETA'),2,vlength)
              into vnumeropedido
              from dual;
              -- 
              select listagg(b.numeroboleto|| '-' || pck_util_fav.fnc_situacaopagamento(b.idsituacao,:P0_IDIDIOMA),' ') within group (order by 1)
              into vtexto
              from pagamentospedidos b
                 , vencimentospedidos v
              where b.idvencimentopedido = v.idvencimentopedido
                and v.idpedido = vnumeropedido;
              --
              htp.prn(vtexto);
              --
              exception
              when others then
                htp.prn(' '); 
            --
            end;
            ```
    }
    execution {
        sequence: 1
        point: ajaxCallback
    }
    security {
        authorizationScheme: mustNotBePublicUser
    }
)

