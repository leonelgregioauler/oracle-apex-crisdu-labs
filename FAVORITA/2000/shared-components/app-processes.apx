appProcess situacaobipagem (
    name: situacaobipagem
    source {
        plsqlCode:
            ```plsql
            declare
              --
              vnumero    varchar2(30);
              vsituacao  varchar2(50);
              vcancelado varchar2(1);
              vlength       number;
              vnumeropedido number;
              --
            begin
              --
              if v('APP_USER') is null then
                prc_create_apex_session( p_app_id      => 2000
                                       , p_app_user    => 'FAVORITA'
                                       , p_app_page_id => 1);
              end if;
              -- 
              select length(v('F2000117ETIQUETA'))-3
              into vlength
              from dual;
              --
              select substr(v('F2000117ETIQUETA'),2,vlength)
              into vnumeropedido
              from dual;
              --
              begin 
                --
                select v.idpedido
                into vnumero
                from vencimentospedidos v
                where v.idpedido =  vnumeropedido
                  and v.situacaovencimento = 'V';
                --  
              exception 
                when others then 
                  --
                  select v.idpedido
                  into vnumero
                  from vencimentospedidos v
                  where v.idpedido =  vnumeropedido
                    and v.situacaovencimento = 'C';
                  --
              end;
              --
              vcancelado := pck_util_fav.fnc_retornapedidocancelado(vnumero);
              --
              if vcancelado = 'N' then
                --
                select pck_pedidos_fav.fnc_situacaopagamentoped(p.idpedido)||' - '||nvl( (select 'SALA SOLUTION'
                                                                                          from classificacoespedidos cp
                                                                                          where cp.idcaracteristicapedido = 77
                                                                                            and cp.idpedido               = p.idpedido),'Normal')
                into vsituacao
                from pedidos p
                where p.idpedido = vnumero;
                --
              else
                --
                vsituacao := 'Cancelado';
                --
              end if;
              --
              htp.prn(vsituacao);
              --
              exception
              when others then
                htp.prn(v('F2000117ETIQUETA')); 
            --
            end;
            ```
    }
    execution {
        sequence: 1
        point: ajaxCallback
    }
    security {
        authorizationScheme: mustNotBePublicUser
    }
)

appProcess validacpfcnpj (
    name: validacpfcnpj
    source {
        plsqlCode:
            ```plsql
            declare
              lv_User_List varchar2(20) := '';
              vtipo        varchar2(1)  := v('F10008TIPO');
              vcpf         varchar2(30) := v('F10008CPF');
              vcnpj        varchar2(30) := v('F10008CNPJ');
              vvalida      boolean;
              vteste number;
            begin
              vcpf  := replace(replace(vcpf,'.',''),'-','');
              vcnpj := replace(replace(replace(vcnpj,'.',''),'-',''),'/','');
              begin
                --
                if vtipo  is not null then
                  if vtipo = 'F' then
                    vvalida := pck_util.validacpf( vcpf);
                  else
                    vvalida := pck_util.validacnpj(vcnpj);
                  end if;
                  --
                  vteste  := sys.diutil.bool_to_int(vvalida );
                  --
                else
                  --
                  vteste  := 0;
                  --
                end if;
                --
                if vteste  = 1 then
                  lv_User_List := 'V';
                else
                  lv_User_List := 'I';
                end if;
                --
              exception 
                when no_data_found then 
                  lv_User_List := '0';
                when others then 
                  lv_User_List := sqlerrm;
              end;
              htp.prn(lv_User_List);
            
            end;
            ```
    }
    execution {
        sequence: 1
        point: ajaxCallback
    }
    security {
        authorizationScheme: mustNotBePublicUser
    }
)

