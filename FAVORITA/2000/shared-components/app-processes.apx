appProcess buscaboletosnegociacao (
    name: buscaboletosnegociacao
    source {
        plsqlCode:
            ```plsql
            declare
            --
              vnumero       varchar2(30);
              vtexto        varchar2(500);
              vidboletoorig number;
            --
            begin
              --  
              if v('F2000117TIPONUMERACAO') = 'N' then
                --
                select b.idboleto
                into vidboletoorig
                from boletos b
                where b.numero =  '2846474'||lpad(v('F2000117NRBOLETO'),10,'0');
                --
              elsif v('F2000117TIPONUMERACAO') = 'A' then
                --
                select b.idboleto
                into vidboletoorig
                from boletos b
                where b.numero =  '21233'||lpad(v('F2000117NRBOLETO'),12,'0');
                --
              end if;
              -- 
              select listagg(b.numeroboleto|| '-' || pck_util_fav.fnc_situacaopagamento(b.idsituacao,:P0_IDIDIOMA),' ') within group (order by 1)
              into vtexto
              from pagamentospedidos b
              where b.idpagamentopedido = vidboletoorig;
              --
              htp.prn(vtexto);
              --
              exception
              when others then
                htp.prn(' '); 
            --
            end;
            ```
    }
    execution {
        sequence: 3
        point: ajaxCallback
    }
    security {
        authorizationScheme: mustNotBePublicUser
    }
)

appProcess buscarepresentante (
    name: buscarepresentante
    source {
        plsqlCode:
            ```plsql
            declare
              --
              vnumero        varchar2(30);
              vrepresentante varchar2(500);
              --
            begin 
              --
              begin 
                --
                select v.idpedido
                into vnumero
                from vencimentospedidos v
                where v.situacaovencimento = 'V'
                  and v.idpedido = v('F2000117NRBOLETO');
                --
              exception
                when others then
                  --
                  select v.idpedido
                  into vnumero
                  from vencimentospedidos v
                  where v.situacaovencimento = 'C'
                    and v.idpedido = v('F2000117NRBOLETO');
                  --
              end;
              --  
              select roman.pck_romance.fnc_nomerepresentante(p.idrepresentante)||' - '||roman.pck_romance.fnc_nomefilial(idfilialromance)
              into vrepresentante
              from pedidos p
              where p.idpedido = vnumero;
              --
              htp.prn(vrepresentante);
              --
              exception
              when others then
                htp.prn(v('F2000117NRBOLETO')); 
              --
            end;
            ```
    }
    execution {
        sequence: 2
        point: ajaxCallback
    }
    security {
        authorizationScheme: mustNotBePublicUser
    }
)

appProcess buscasituacao (
    name: buscasituacao
    source {
        plsqlCode:
            ```plsql
            declare
              --
              vnumero    varchar2(30);
              vsituacao  varchar2(50);
              vcancelado varchar2(1);
              --
            begin
              --
              if v('APP_USER') is null then
                prc_create_apex_session( p_app_id      => 2000
                                       , p_app_user    => 'FAVORITA'
                                       , p_app_page_id => 1);
              end if;
              -- 
              begin 
                --
                select v.idpedido
                into vnumero
                from vencimentospedidos v
                where v.idpedido =  v('F2000117NRBOLETO')
                  and v.situacaovencimento = 'V';
                --  
              exception 
                when others then 
                  --
                  select v.idpedido
                  into vnumero
                  from vencimentospedidos v
                  where v.idpedido =  v('F2000117NRBOLETO')
                    and v.situacaovencimento = 'C';
                  --
              end;
              --
              vcancelado := pck_util_fav.fnc_retornapedidocancelado(vnumero);
              --
              if vcancelado = 'N' then
                --
                select pck_pedidos_fav.fnc_situacaopagamentoped(p.idpedido)||' - '||nvl( (select 'SALA'
                                                                                          from classificacoespedidos cp
                                                                                          where cp.idcaracteristicapedido = 77
                                                                                            and cp.idpedido               = p.idpedido),'Normal')
                into vsituacao
                from pedidos p
                where p.idpedido = vnumero;
                --
              else
                --
                vsituacao := 'Cancelado';
                --
              end if;
              --
              htp.prn(vsituacao);
              --
              exception
              when others then
                htp.prn(v('F2000117NRBOLETO')); 
            --
            end;
            ```
    }
    execution {
        sequence: 1
        point: ajaxCallback
    }
    security {
        authorizationScheme: mustNotBePublicUser
    }
)

appProcess contadormensagem (
    name: ContadorMensagem
    source {
        plsqlCode:
            ```plsql
            begin 
              -- 
              select count(1) 
              into :QTDMENSAGEM 
              from favorita.mensagensinternas m 
              where :P0_IDUSUARIO = m.idusuario 
                and m.dataleitura is null; 
              -- 
            end;
            ```
    }
    execution {
        sequence: 1
    }
)

