authorization atendimento (
    name: ATENDIMENTO
    type: existsSqlQuery
    settings {
        sqlQuery:
            ```sql
            select 1
            from dual 
            where upper(v('APP_USER')) IN ( 'EVERTON','MATEUS','GUILHERME','FERNANDO','CRISTIAN','EQUIPAMENTO','MAURICIO','LUCASRAMOS','LUIZV','EDIMILSON') 
            ```
    }
    error {
        errorMessage: Você não tem acesso a este item!
    }
)

authorization valida-acesso-a-página (
    name: Valida acesso a página
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody:
            ```plsql
            begin
             return pck_controle_fav.fnc_validaacessopagina(pidpagina => v('APP_PAGE_ID'));
            end;
            ```
    }
    error {
        errorMessage: Você não tem permissão de acesso a esta página.
    }
)

