pageTemplate minimal-pedido (
    name: Minimal (PEDIDO)
    templateClass: popup
    page {
        header:
            ```html
            <!DOCTYPE html>
            <meta http-equiv="x-ua-compatible" content="IE=edge" />
            
            <!--[if lt IE 7]><html class="no-js lt-ie10 lt-ie9 lt-ie8 lt-ie7" lang="&BROWSER_LANGUAGE."> <![endif]-->
            <!--[if IE 7]><html class="no-js lt-ie10 lt-ie9 lt-ie8" lang="&BROWSER_LANGUAGE."> <![endif]-->
            <!--[if IE 8]><html class="no-js lt-ie10 lt-ie9" lang="&BROWSER_LANGUAGE."> <![endif]-->
            <!--[if IE 9]><html class="no-js lt-ie10" lang="&BROWSER_LANGUAGE."> <![endif]-->
            <!--[if gt IE 9]><!--> <html class="no-js" lang="&BROWSER_LANGUAGE."> <!--<![endif]-->
            <head>
              <meta charset="utf-8">  
              <title>#TITLE#</title>
              <style type="text/css">
                body { background-color: white !important; }
              </style>
              #APEX_CSS#
              #THEME_CSS#
              #TEMPLATE_CSS#
              #THEME_STYLE_CSS#
              #APPLICATION_CSS#
            #APEX_JAVASCRIPT#
            #THEME_JAVASCRIPT#
            #TEMPLATE_JAVASCRIPT#
            #APPLICATION_JAVASCRIPT#
            #PAGE_JAVASCRIPT#
              #PAGE_CSS#  
              #FAVICONS#
              #HEAD#
            #FORM_OPEN#
            </head>
            ```
        body: #BODY#
        footer:
            ```html
            #FORM_CLOSE#
            #GENERATED_CSS#
            #GENERATED_JAVASCRIPT#
            </body>
            </html>
            ```
    }
    subtemplate {
        successMessage:
            ```html
            <div class="t-Body-alert">
              <div class="t-Alert t-Alert--defaultIcons t-Alert--success t-Alert--horizontal t-Alert--page t-Alert--colorBG" id="t_Alert_Success" role="alert">
                <div class="t-Alert-wrap">
                  <div class="t-Alert-icon">
                    <span class="t-Icon"></span>
                  </div>
                  <div class="t-Alert-content">
                    <div class="t-Alert-header">
                      <h2 class="t-Alert-title">#SUCCESS_MESSAGE#</h2>
                    </div>
                  </div>
                  <div class="t-Alert-buttons">
                    <button class="t-Button t-Button--noUI t-Button--icon t-Button--closeAlert" type="button" title="#CLOSE_NOTIFICATION#"><span class="t-Icon icon-close"></span></button>
                  </div>
                </div>
              </div>
            </div>
            ```
        navigationBar:
            ```html
            <ul class="t-NavigationBar t-NavigationBar--classic" data-mode="classic">
              <li class="t-NavigationBar-item">
                <span class="t-Button t-Button--icon t-Button--noUI t-Button--header t-Button--navBar t-Button--headerUser">
                    <span class="t-Icon a-Icon icon-user"></span>
                    <span class="t-Button-label">&APP_USER.</span>
                </span>
              </li>#BAR_BODY#
            </ul>
            ```
        navigationBarEntry:
            ```html
            <li class="t-NavigationBar-item">
              <a class="t-Button t-Button--icon t-Button--header" href="#LINK#">
                  <span class="t-Icon #IMAGE#"></span>
                  <span class="t-Button-label">#TEXT#</span>
              </a>
            </li>
            ```
        notification:
            ```html
            <div class="t-Body-alert">
              <div class="t-Alert t-Alert--defaultIcons t-Alert--warning t-Alert--horizontal t-Alert--page t-Alert--colorBG" id="t_Alert_Notification" role="alert">
                <div class="t-Alert-wrap">
                  <div class="t-Alert-icon">
                    <span class="t-Icon"></span>
                  </div>
                  <div class="t-Alert-content">
                    <div class="t-Alert-body">
                      #MESSAGE#
                    </div>
                  </div>
                  <div class="t-Alert-buttons">
                    <button class="t-Button t-Button--noUI t-Button--icon t-Button--closeAlert" type="button" title="#CLOSE_NOTIFICATION#"><span class="t-Icon icon-close"></span></button>
                  </div>
                </div>
              </div>
            </div>
            ```
    }
    layout {
        maxColumns: 12
        alwaysUseMaxColumns: true
        defaultLabelColumnSpan: 3
        firstColumnAttributes: alpha
        lastColumnAttributes: omega
        containerTemplate:
            ```html
            <div class="container">
            #ROWS#
            </div>
            ```
        rowTemplate:
            ```html
            <div class="row">
            #COLUMNS#
            </div>
            ```
        columnTemplate:
            ```html
            <div class="col col-#COLUMN_SPAN_NUMBER# #CSS_CLASSES#" #ATTRIBUTES#>
            #CONTENT#
            </div>
            ```
    }
    positions {
        breadcrumbPosition: breadcrumbBar
    }
    errorPage {
        template:
            ```html
            <div class="t-Alert t-Alert--danger t-Alert--wizard t-Alert--defaultIcons">
              <div class="t-Alert-wrap">
                <div class="t-Alert-icon">
                  <span class="t-Icon"></span>
                </div>
                <div class="t-Alert-content">
                  <div class="t-Alert-body">
                    <h3>#MESSAGE#</h3>
                    <p>#ADDITIONAL_INFO#</p>
                    <div class="t-Alert-inset">#TECHNICAL_INFO#</div>
                  </div>
                </div>
                <div class="t-Alert-buttons">
                  <button onclick="#BACK_LINK#" class="t-Button t-Button--hot w50p t-Button--large" type="button">#OK#</button>
                </div>
              </div>
            </div>
            ```
    }
    advanced {
        identifier: MINIMAL_PEDIDO
    }

    slot beforeNavigationBar (
        name: Before Navigation Bar
        staticId: REGION_POSITION_08
        gridLayout {
            gridSupport: false
        }
    )

    slot breadcrumbBar (
        name: Breadcrumb Bar
        staticId: REGION_POSITION_01
        gridLayout {
            gridSupport: false
        }
    )

    slot contentBody (
        name: Content Body
        staticId: BODY
        supports {
            items: true
            buttons: true
        }
        gridLayout {
            maxFixedColumns: 12
        }
    )

    slot footer (
        name: Footer
        staticId: REGION_POSITION_05
        gridLayout {
            maxFixedColumns: 12
        }
    )

    slot inlineDialogs (
        name: Inline Dialogs
        staticId: REGION_POSITION_04
        gridLayout {
            maxFixedColumns: 12
        }
    )

    slot pageHeader (
        name: Page Header
        staticId: REGION_POSITION_07
        gridLayout {
            gridSupport: false
        }
    )

    slot pageNavigation (
        name: Page Navigation
        staticId: REGION_POSITION_06
        gridLayout {
            gridSupport: false
        }
    )

)

