lov lov-filiaisromance (
    name: LOV_FILIAISROMANCE
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            select nome as d,
                   idfilial as r
              from roman.vw_filiais
             where tipofilial in ('C', 'D','A','F','L')
               and ativo = 'S'
             union
             select nome 
                  , idfilial 
             from roman.vw_filiais f
             where f.idfilial = 200
             union
              select nome 
                  , idfilial 
             from roman.vw_filiais f
             where f.idfilial = 1220
             order by 1
            ```
    }
)

