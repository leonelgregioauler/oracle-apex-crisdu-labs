lov lov-situacoesfluxograma (
    name: LOV_SITUACOESFLUXOGRAMA
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            select descricaosistema as d,
                   idsituacaoentrega as r
            from vw_situacoesentrega_fav
            where :P104_TIPOSITUACAO = 'E'
            union
            select descricaosistema as d,
                   idsituacaofinanceiro as r
            from vw_situacoesfinanceiro_fav
            where :P104_TIPOSITUACAO = 'F'
            union
            select descricaosistema as d,
                   idsituacaocobranca as r
            from vw_situacoescobrancas_fav
            where :P104_TIPOSITUACAO = 'C'
            ```
    }
)

