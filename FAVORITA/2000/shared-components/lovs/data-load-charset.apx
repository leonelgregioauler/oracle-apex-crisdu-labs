lov data-load-charset (
    name: DATA_LOAD_CHARSET
    source {
        location: staticValues
    }

    entry big (
        sequence: 1
        display: Chinese Big5
        return: big5
    )

    entry euc-jp (
        sequence: 1
        display: Japanese EUC
        return: euc-jp
    )

    entry euc-kr (
        sequence: 1
        display: Korean EUC
        return: euc-kr
    )

    entry gbk (
        sequence: 1
        display: Chinese GBK
        return: gbk
    )

    entry iso (
        sequence: 1
        display: Arabic ISO-8859-6
        return: iso-8859-6
    )

    entry iso-2 (
        sequence: 1
        display: Cyrilic ISO-8859-5
        return: iso-8859-5
    )

    entry iso-3 (
        sequence: 1
        display: Eastern European ISO-8859-2
        return: iso-8859-2
    )

    entry iso-4 (
        sequence: 1
        display: Greek ISO-8859-7
        return: iso-8859-7
    )

    entry iso-5 (
        sequence: 1
        display: Northern European ISO-8859-4
        return: iso-8859-4
    )

    entry iso-6 (
        sequence: 1
        display: Southern European ISO-8859-3
        return: iso-8859-3
    )

    entry iso-7 (
        sequence: 1
        display: Turkish ISO-8859-9
        return: iso-8859-9
    )

    entry iso-8 (
        sequence: 1
        display: Western European ISO-8859-1
        return: iso-8859-1
    )

    entry iso-8859-8-i (
        sequence: 1
        display: Hebrew ISO-8859-8-i
        return: iso-8859-8-i
    )

    entry koi8-r (
        sequence: 1
        display: Cyrilic KOI8-R
        return: koi8-r
    )

    entry koi8-u (
        sequence: 1
        display: Cyrilic KOI8-U
        return: koi8-u
    )

    entry shift-jis (
        sequence: 1
        display: Japanese Shift JIS
        return: shift_jis
    )

    entry tis (
        sequence: 1
        display: Thai TIS-620
        return: tis-620
    )

    entry us-ascii (
        sequence: 1
        display: US-ASCII
        return: us-ascii
    )

    entry utf (
        sequence: 1
        display: Unicode UTF-8
        return: utf-8
    )

    entry utf-16be (
        sequence: 1
        display: Unicode UTF-16 Big Endian
        return: utf-16be
    )

    entry utf-16le (
        sequence: 1
        display: Unicode UTF-16 Little Endian
        return: utf-16le
    )

    entry windows (
        sequence: 1
        display: Arabic Windows 1256
        return: windows-1256
    )

    entry windows-2 (
        sequence: 1
        display: Cyrilic Windows 1251
        return: windows-1251
    )

    entry windows-3 (
        sequence: 1
        display: Eastern European Windows 1250
        return: windows-1250
    )

    entry windows-4 (
        sequence: 1
        display: Greek Windows 1253
        return: windows-1253
    )

    entry windows-5 (
        sequence: 1
        display: Hebrew Windows 1255
        return: windows-1255
    )

    entry windows-6 (
        sequence: 1
        display: Northern European Windows 1257
        return: windows-1257
    )

    entry windows-7 (
        sequence: 1
        display: Turkish Windows 1254
        return: windows-1254
    )

    entry windows-8 (
        sequence: 1
        display: Vietnamese Windows 1258
        return: windows-1258
    )

    entry windows-9 (
        sequence: 1
        display: Western European Windows 1252
        return: windows-1252
    )

)

