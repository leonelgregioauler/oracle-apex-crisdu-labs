lov lov-fornecedores (
    name: LOV_FORNECEDORES
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            select roman.pck_romance.fnc_nomefornecedor(f.idfornecedor)||' - '|| p.CNPJ display_value
                  , f.idfornecedor  return_value
              from catal.fornecedores f
                 , catal.pessoas p
            where p.idpessoa = f.idpessoa
            order by 1
            ```
    }
)

