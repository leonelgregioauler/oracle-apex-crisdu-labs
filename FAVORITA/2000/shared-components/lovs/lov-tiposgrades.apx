lov lov-tiposgrades (
    name: LOV_TIPOSGRADES
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            select listagg(sigla,',') within group (order by 1) as d,
                   idtipograde as r
              from grades
              group by idtipograde
              order by 1
            ```
    }
)

