lov lov-usuarios (
    name: LOV_USUARIOS
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            select pck_util_fav.fnc_nomeusuario(idusuario)||' - '||u.usuario  display_value
                 , idusuario  return_value
            from usuarios         u
            where exists ( select 1
                           from usuariossistemas s 
                           where s.usuario = u.usuario 
                             and s.idsistema = 2000 )
              and ativo = 'S'
            order by 1
            ```
    }
)

