lov lov-gruposatendimentos (
    name: LOV_GRUPOSATENDIMENTOS
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            select g.descricao          display_value
                 , g.idgrupoatendimento   return_value
            from roman.usuariosgruposatendimento U
               , roman.gruposatendimento         g
            where g.idgrupoatendimento  = u.idgrupoatendimento
              and usuario = v('APP_USER')
            order by 1
            ```
    }
)

