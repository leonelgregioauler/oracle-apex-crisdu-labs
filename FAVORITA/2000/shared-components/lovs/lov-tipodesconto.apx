lov lov-tipodesconto (
    name: LOV_TIPODESCONTO
    source {
        location: staticValues
    }

    entry lov_data (
        sequence: 1
        display: Desconto no Valor de Revista
        return: 1
    )

    entry lov_data-2 (
        sequence: 2
        display: Desconto no Valor a Pagar
        return: 2
    )

    entry lov_data-3 (
        sequence: 3
        display: Desconto em % Valor a Pagar
        return: 3
    )

)

