lov lov-distribuidorasparceiras (
    name: LOV_DISTRIBUIDORASPARCEIRAS
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            select nome as d,
                   idfilial as r
              from roman.vw_filiais
             where tipofilial in ('P')
               and ativo = 'S'
             order by 1
            ```
    }
)

