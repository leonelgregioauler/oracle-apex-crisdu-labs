lov lov-cidades (
    name: LOV_CIDADES
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            select c.nomecidade||' - '||c.sigla display_value
                 , c.idcidade  return_value
            from vw_cidades_fav c
            order by 1 
            ```
    }
)

