lov lov-vendedoras-geral (
    name: LOV_VENDEDORAS_GERAL
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            select /*FIRST_ROWS(20)*/ initcap(p.nomepessoa)||' - '||p.cpf||' ID: '||v.idvendedora||' '||decode(v.ativo,'N','- Inativa')||' Pontos: '||nvl(v.pontos,0) display_value
                 , v.idvendedora return_value
            from vendedoras v
               , pessoas p
            where p.idpessoa = v.idpessoa
            order by 1; 
            ```
    }
)

