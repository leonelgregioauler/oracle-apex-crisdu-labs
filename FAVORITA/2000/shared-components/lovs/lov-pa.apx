lov lov-pa (
    name: LOV_PA
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            select codigo as d,
                   codigo as r
              from posicoesatendimentos
              where idfilialfavorita = PCK_UTIL_FAV.fnc_retornaidfilialfavusuario(pck_util_fav.fnc_idusuario(v('APP_USER')) )
             order by codigo
            ```
    }
)

