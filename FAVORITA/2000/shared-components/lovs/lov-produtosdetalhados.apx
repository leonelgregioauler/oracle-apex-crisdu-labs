lov lov-produtosdetalhados (
    name: LOV_PRODUTOSDETALHADOS
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            select pck_util_fav.fnc_nomeprodutodetalhado(idprodutodetalhado, :P0_IDIDIOMA) as d
                 , idprodutodetalhado as r
               from produtosdetalhados
             order by 1
            ```
    }
)

