lov lov-funcionarios (
    name: LOV_FUNCIONARIOS
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            select roman.pck_romance.fnc_nomepessoa(p.idpessoa) ||' - '||p.cpf  display_value
                 , f.idfuncionario return_value
            from catal.funcionarios f
               , catal.pessoas p
            where p.idpessoa = f.idpessoa
            order by 1;
            ```
    }
)

