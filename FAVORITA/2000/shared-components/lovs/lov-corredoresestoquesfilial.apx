lov lov-corredoresestoquesfilial (
    name: LOV_CORREDORESESTOQUESFILIAL
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            select descricao as d,
                   idcorredorestoque as r
              from corredoresestoques
             where idfilialfavorita = :P0_IDFILIALFAVORITA 
            order by 1
            ```
    }
)

