app FAV2 (
    name: Optimus Favorita 2.0
    version: release 1.0
    logo {
        type: image
        imageUrl: #IMAGE_PREFIX#apex_ui/img/favicons/app-feedback.ico
    }
    navigation {
        homeUrl: {
            page: 1
        }
        loginUrl: {
            page: LOGIN_DESKTOP
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            #DEFAULT#
            js-defaultCollapsed
            js-navCollapsed--hidden
            t-TreeNav--classic
        ]
        list: @menu-de-navegação
    }
    navigationBar {
        list: @desktop-navigation-bar
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
    }
    javaScript {
        fileUrls: #WORKSPACE_FILES#funcoes_anexos.js
        includeLegacyJavascript: [
            pre18
            18
        ]
        includeJqueryMigrate: true
    }
    css {
        fileUrls: #IMAGE_PREFIX#pkgapp_ui/css/5.0#MIN#.css
    }
    authentication {
        scheme: @database-account
        publicUser: APEX_PUBLIC_USER
    }
    authorization {
        sourceForRoleOrGroupSchemes: authenticationScheme
    }
    security {
        embedInFrames: allowSameOrigin
        referrerPolicy: strictOriginWhenCrossOrigin
        allowBotAccess: true
    }
    sessionStateProtection {
        bookmarkHashFunction: sha1
        acceptPre202UrlChecksums: false
    }
    sessionManagement {
        sessionStateCommits: immediate
    }
    globalization {
        primaryLanguage: pt-br
        documentDirection: leftToRight
        autoTimeZone: true
    }
    progressiveWebApp {
        enable: false
    }
    rowSearch {
        tokenize: false
    }
    reportPrinting {
        type: useInstanceSettings
    }
    runtime {
        friendlyUrls: false
        compatibilityMode: 21.2
        accessibleReadOnlyItems: false
    }
    advanced {
        passEcid: false
        modernizeApp: true
        faviconHtml: <link rel="shortcut icon" href="#IMAGE_PREFIX#apex_ui/img/favicons/app-feedback.ico"><link rel="icon" sizes="16x16" href="#IMAGE_PREFIX#apex_ui/img/favicons/app-feedback-16x16.png"><link rel="icon" sizes="32x32" href="#IMAGE_PREFIX#apex_ui/img/favicons/app-feedback-32x32.png"><link rel="apple-touch-icon" sizes="180x180" href="#IMAGE_PREFIX#apex_ui/img/favicons/app-feedback.png">
    }

    substitution GETTING_STARTED_URL (
        value {
            staticValue: #
        }
    )

    substitution APP_NAME (
        value {
            staticValue: Optimus Favorita 2.0
        }
    )

)

