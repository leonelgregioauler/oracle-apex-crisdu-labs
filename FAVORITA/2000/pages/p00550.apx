page 550 (
    name: Ajustar Itens para Revista
    title: Ajustar Itens para Revista
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ajustar-itens-da-revista (
        name: Ajustar Itens da Revista
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDITEMVIRADADECATALOGO,
                       IDVIRADADECATALOGO,
                       IDPRODUTODETALHADO,
                       VALORVENDA,
                       MORTEPROGRAMADA,
                       PERCCOMISSAOVEN,
                       PONTOSPRODUTO,
                       IDTAGPRODUTO,
                       IDPRECOPRODUTO,
                       PERCCOMISSAODIS,
                       PERCCOMISSAOGER,
                       VALORCUSTO,
                       tipodestino,
                       precosugerido
                  from ITENSVIRADADECATALOGO
                 where IDVIRADADECATALOGO = :P550_IDVIRADADECATALOGO
                   and morteprogramada = 'N'
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
            ]
            addRowIfEmpty: false
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 65173418720252852
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
                rowsPerPage: 1000
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDITEMVIRADADECATALOGO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDVIRADADECATALOGO
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDPRODUTODETALHADO
                layout {
                    width: 468
                    sequence: 3
                }
            )

            displayColumn (
                column: @VALORVENDA
                layout {
                    width: 156
                    sequence: 5
                }
            )

            displayColumn (
                column: @MORTEPROGRAMADA
                layout {
                    width: 103
                    sequence: 6
                }
            )

            displayColumn (
                column: @PERCCOMISSAOVEN
                layout {
                    width: 90
                    sequence: 7
                }
            )

            displayColumn (
                column: @PONTOSPRODUTO
                layout {
                    width: 56
                    sequence: 10
                }
            )

            displayColumn (
                column: @IDTAGPRODUTO
                layout {
                    show: false
                    width: 248
                    sequence: 13
                }
            )

            displayColumn (
                column: @IDPRECOPRODUTO
                layout {
                    sequence: 11
                }
            )

            displayColumn (
                column: @PERCCOMISSAODIS
                layout {
                    width: 124
                    sequence: 8
                }
            )

            displayColumn (
                column: @PERCCOMISSAOGER
                layout {
                    width: 125
                    sequence: 9
                }
            )

            displayColumn (
                column: @VALORCUSTO
                layout {
                    width: 110
                    sequence: 4
                }
            )

            displayColumn (
                column: @TIPODESTINO
                layout {
                    show: false
                    width: 225
                    sequence: 12
                }
            )

            displayColumn (
                column: @PRECOSUGERIDO
                layout {
                    sequence: 14
                }
            )

            sort (
                column: @IDPRODUTODETALHADO
                sort {
                    nulls: last
                    sequence: 1
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column IDITEMVIRADADECATALOGO (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDITEMVIRADADECATALOGO
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDPRECOPRODUTO (
            type: hidden
            layout {
                sequence: 110
            }
            source {
                databaseColumn: IDPRECOPRODUTO
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDPRODUTODETALHADO (
            type: displayOnly
            heading {
                heading: Produto
            }
            settings {
                basedOn: lov
            }
            lov {
                type: sharedComponent
                lov: @lov-produtosdetalhados
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: IDPRODUTODETALHADO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: contains
                lovType: useLov
                exactMatch: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDTAGPRODUTO (
            type: selectList
            heading {
                heading: Tag do Produto
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select distinct t.nome display_value
                         , t.idtagproduto return_value
                      from tagsprodutos t
                         , classificacoesprodutos c
                     where t.idtagproduto = c.idtagproduto
                       --and c.idprodutodetalhado = :IDPRODUTODETALHADO
                    ```
            }
            layout {
                sequence: 100
            }
            source {
                databaseColumn: IDTAGPRODUTO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column IDVIRADADECATALOGO (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IDVIRADADECATALOGO
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column MORTEPROGRAMADA (
            type: hidden
            layout {
                sequence: 70
            }
            source {
                databaseColumn: MORTEPROGRAMADA
                dataType: varchar2
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column PERCCOMISSAODIS (
            type: numberField
            heading {
                heading: %Com.DIS
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 120
            }
            appearance {
                formatMask: 90D00
                width: 5
            }
            validation {
                maxLength: 5
            }
            source {
                databaseColumn: PERCCOMISSAODIS
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column PERCCOMISSAOGER (
            type: numberField
            heading {
                heading: %Com.GER
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 130
            }
            appearance {
                formatMask: 90D00
                width: 5
            }
            validation {
                maxLength: 5
            }
            source {
                databaseColumn: PERCCOMISSAOGER
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column PERCCOMISSAOVEN (
            type: numberField
            heading {
                heading: %Com.EMP
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 80
            }
            appearance {
                formatMask: 90D00
                width: 5
            }
            validation {
                maxLength: 5
            }
            source {
                databaseColumn: PERCCOMISSAOVEN
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column PONTOSPRODUTO (
            type: numberField
            heading {
                heading: Pontuação
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 90
            }
            source {
                databaseColumn: PONTOSPRODUTO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column PRECOSUGERIDO (
            type: numberField
            heading {
                heading: Preço Sugerido
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 160
                columnAlignment: end
            }
            source {
                databaseColumn: PRECOSUGERIDO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column TIPODESTINO (
            type: selectList
            heading {
                heading: Destino
            }
            lov {
                type: staticValues
                staticValues: STATIC2:Revista;R,Lucre Mais;L,Repasse RMC;E,Volta;V
                displayExtraValues: false
            }
            layout {
                sequence: 150
            }
            source {
                databaseColumn: TIPODESTINO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column VALORCUSTO (
            type: numberField
            heading {
                heading: Custo Produto
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 140
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                databaseColumn: VALORCUSTO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column VALORVENDA (
            type: numberField
            heading {
                heading: Valor Venda
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                databaseColumn: VALORVENDA
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

    )

    pageItem P550_IDVIRADADECATALOGO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            slot: legacyOrphanComponents
        }
        default {
            type: static
            staticValue: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button processar (
        buttonName: Processar
        label: Enviar Itens para Revista
        layout {
            sequence: 20
            region: @ajustar-itens-da-revista
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button voltar (
        buttonName: Voltar
        label: Voltar
        layout {
            sequence: 10
            region: @ajustar-itens-da-revista
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction confirma (
        name: Confirma
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @processar
        }

        action native-confirm (
            action: confirm
            settings {
                message: Confirma definir itens de revista?
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: CONFIRMA
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction limpacomdis (
        name: LimpaComDis
        execution {
            sequence: 40
        }
        when {
            event: focusin
            selectionType: columns
            interactiveGrid: @ajustar-itens-da-revista
            columns: PERCCOMISSAODIS
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: columns
                columns: PERCCOMISSAODIS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction limpacomger (
        name: LimpaComGer
        execution {
            sequence: 50
        }
        when {
            event: focusin
            selectionType: columns
            interactiveGrid: @ajustar-itens-da-revista
            columns: PERCCOMISSAOGER
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: columns
                columns: PERCCOMISSAOGER
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction limpacomven (
        name: LimpaComVen
        execution {
            sequence: 30
        }
        when {
            event: focusin
            selectionType: columns
            interactiveGrid: @ajustar-itens-da-revista
            columns: PERCCOMISSAOVEN
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: columns
                columns: PERCCOMISSAOVEN
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process gravaritens-revista (
        name: GravarItens_Revista
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                 vnome                 varchar2(200);
                 vdatainicial          date;
                 vdatafinal            date;
                 videdicaorevori       number;
                 videdicaorevdest      number;
                 vidpais               number;
                 vlinkcatalogo         varchar2(100);
                 vidusuarioinclusao    number;
                 vdatainclusao         date;
                 vidusuarioMP          number;
                 vdataMP               date;
                 vidusuarioajustaitens number;
                 vdataajustaitens      date;
                 vidusuarioajustaMP    number;
                 vdataajustaMP         date;
                 vetapa                number;
                 vmd5                  varchar2(4000);
                 v_idtag               number;
                 v_erro1               exception;
                 v_erro2               exception;
                 vidfilial             number;
                 
                BEGIN
                
                  vidusuarioajustaitens := :P0_IDUSUARIO;
                  vdataajustaitens      := SYSDATE;
                  --vetapa                := 3;
                
                  FOR c1 in (
                               select nome
                                    , datavalidadeini
                                    , datavalidadefim
                                    , idedicaorevistaorigem
                                    , idedicaorevistadestino
                                    , idpais
                                    , linkcatalogo
                                    , etapa
                                    , decode(idpais,2,1041,
                                                    4,1111,
                                             100) idfilial
                                 from viradasdecatalogo
                                where idviradadecatalogo = :P550_IDVIRADADECATALOGO
                  ) LOOP
                  
                    vnome                 := c1.nome;
                    vdatainicial          := c1.datavalidadeini;
                    vdatafinal            := c1.datavalidadefim;
                    videdicaorevori       := c1.idedicaorevistaorigem;
                    videdicaorevdest      := c1.idedicaorevistadestino;
                    vidpais               := c1.idpais;
                    vlinkcatalogo         := c1.linkcatalogo;
                    vidfilial             := c1.idfilial;
                    
                    -- Como o usuario pode escolher entre as etapas 3 e 4 qual executar primeiro, mantém o 4 caso ja tenha sido executada
                    if c1.etapa = 4 then 
                      vetapa := 4;
                    else
                      vetapa := 3;
                    end if;
                    --
                    pck_cadastros_fav.prc_viradadecatalogo(pidviradadecatalogo   => :P550_IDVIRADADECATALOGO,
                                                           pnome                 => vnome,
                                                           pdatainicial          => vdatainicial,
                                                           pdatafinal            => vdatafinal,
                                                           pidedicaorevori       => videdicaorevori,
                                                           pidedicaorevdest      => videdicaorevdest,
                                                           pidpais               => vidpais,
                                                           plinkcatalogo         => vlinkcatalogo,
                                                           pidusuarioinclusao    => vidusuarioinclusao,
                                                           pdatainclusao         => vdatainclusao,
                                                           pidusuariomp          => vidusuarioMP,
                                                           pdatamp               => vdataMP,
                                                           pidusuarioajustaitens => vidusuarioajustaitens,
                                                           pdataajustaitens      => vdataajustaitens,
                                                           pidusuarioajustamp    => vidusuarioajustamp,
                                                           pdataajustamp         => vdataajustamp,
                                                           petapa                => vetapa,
                                                           pmd5                  => vmd5,
                                                           poperacao_dml         => 'U');
                    --
                    -- Inclui Itens para revista destino
                    begin
                      INSERT INTO EXECUCOES_COMANDOS (IDCOMANDO, ORIGEM, DATAPROGRAMADO, COMANDO)
                        SELECT seq_idcomando.nextval
                             , 'VIRADA DE CATALOGO '||:P550_IDVIRADADECATALOGO
                             , vdatainicial
                             , 'INSERT INTO PRODUTOSDETEDREVISTAS ( idprodutodetedrevista, idedicaorevista, idprodutodetalhado) '||
                               ' VALUES ( seq_idprodutodetedrevista.nextval, ' || videdicaorevdest || ',' || i.idprodutodetalhado || ')'
                             --
                          FROM itensviradadecatalogo i
                         WHERE i.idviradadecatalogo = :P550_IDVIRADADECATALOGO
                           AND i.morteprogramada = 'N'  
                           AND ( i.idtagproduto is null or i.idtagproduto not in (183,184) ) -- tags Repasse RMC, Volta (revistas) essas nao devem continuar 
                           AND NOT EXISTS (select 1
                                             from produtosdetedrevistas
                                            where idedicaorevista = videdicaorevdest
                                              and idprodutodetalhado = i.idprodutodetalhado );                  
                                  
                    exception
                      when others then null;
                    end;
                    --
                    -- Se ja tiver itens na revista destino, sistema exclui para incluir o que está na virada (são os produtos lancamentos)
                    --begin
                    --  delete from produtosdetedrevistas
                    --    where idedicaorevista = videdicaorevdest;
                    --exception
                    --  when no_data_found then null;
                    --end;
                    
                    -- Verifica se há filiais na origem que não estão no destino. Se tiver, inclui.
                    --
                    FOR c3 in (select idfilial
                               from filiaisedicoesrevistas 
                               where idedicaorevista = videdicaorevori
                                 and idfilial not in (select idfilial
                                                        from filiaisedicoesrevistas
                                                       where idedicaorevista = videdicaorevdest) 
                      ) LOOP
                
                        INSERT INTO filiaisedicoesrevistas (idfilialedicaorevista, idedicaorevista, idfilial)
                             VALUES (seq_idfilialedicaorevista.nextval, videdicaorevdest, c3.idfilial);
                             
                        --
                    END LOOP;
                    --
                    begin
                      -- cria comando para inserir precos para todas as filiais
                      INSERT INTO execucoes_comandos (idcomando, origem, dataprogramado, comando)
                      select seq_idcomando.nextval
                           , 'VIRADA DE CATALOGO '||:P550_IDVIRADADECATALOGO
                           , vdatainicial
                           , 'INSERT INTO PRECOSPRODUTOS ( idprecoproduto, idedicaorevista, idprodutodetalhado, idfilialromance, valorcusto, '||
                                                          'valorvenda, perccomissaogerente, perccomissaodistribuidor, perccomissaoconsultora, precosugerido) ' ||
                               'VALUES (' ||
                               'seq_idprecoproduto.nextval'               || ',' ||
                               videdicaorevdest                           || ',' ||
                               i.idprodutodetalhado                       || ',' ||
                               f.idfilial                                 || ',' ||
                               replace(nvl(i.valorcusto,0),',','.')       || ',' ||               
                               replace(nvl(i.valorvenda,0),',','.')       || ',' ||
                               replace(nvl(i.perccomissaoger,0),',','.')  || ',' ||
                               replace(nvl(i.perccomissaodis,0),',','.')  || ',' ||
                               replace(nvl(i.perccomissaoven,0),',','.')  || ',' ||
                               replace(nvl(i.precosugerido,0),',','.')    || ')'
                          --
                        from viradasdecatalogo      v
                           , itensviradadecatalogo  i
                           , filiaisedicoesrevistas f
                       where v.idviradadecatalogo = :P550_IDVIRADADECATALOGO
                         and v.idviradadecatalogo = i.idviradadecatalogo
                         and f.idedicaorevista    = v.idedicaorevistadestino
                         and i.morteprogramada    = 'N'
                         and (i.idtagproduto is null or i.idtagproduto not in (183,184) ) -- tags Repasse RMC, Volta (revistas) essas nao devem continuar
                         and not exists (select 1
                                           from precosprodutos
                                          where idedicaorevista    = videdicaorevdest
                                            and idprodutodetalhado = i.idprodutodetalhado
                                            and idfilialromance    = f.idfilial);
                    exception
                      when others then
                       raise v_erro2;
                    end;
                    --
                    --
                    -- Insere tags de produtos caso nao existam
                    INSERT INTO execucoes_comandos (idcomando, origem, dataprogramado, comando)
                      select seq_idcomando.nextval
                           , 'VIRADA DE CATALOGO '||:P550_IDVIRADADECATALOGO
                           , vdatainicial
                           , 'INSERT INTO CLASSIFICACOESPRODUTOS ( idclassificacaoproduto, idprodutodetalhado, idtagproduto ) ' ||
                               'VALUES (' ||
                               'seq_idclassificacaoproduto.nextval'  || ',' ||
                               i.idprodutodetalhado                  || ',' ||
                               i.idtagproduto                        || ')' 
                          from viradasdecatalogo      v
                             , itensviradadecatalogo  i
                         where v.idviradadecatalogo = :P550_IDVIRADADECATALOGO
                           and v.idviradadecatalogo = i.idviradadecatalogo
                           and i.morteprogramada    = 'N' 
                           and i.idtagproduto not in (183,184) -- tags Repasse RMC, Volta (revistas) essas nao devem continuar
                           and i.idtagproduto is not null
                           and not exists (select 1
                                             from classificacoesprodutos
                                            where idtagproduto = i.idtagproduto
                                              and idprodutodetalhado = i.idprodutodetalhado); 
                
                    --
                    -- Atualiza Produtos (V=Volta; E=Repasse RMC)
                    IF vidpais = 1 then 
                      FOR c2 in ( select v.idedicaorevistadestino
                                       , i.idprodutodetalhado
                                       , i.idfilialromance
                                       , i.valorcusto
                                       , i.valorvenda
                                       , i.perccomissaoger
                                       , i.perccomissaodis
                                       , i.perccomissaoven
                                       , i.pontuacaonova pontosproduto
                                       , i.idtagproduto
                                       , i.idprecoproduto
                                    from viradasdecatalogo v
                                       , itensviradadecatalogo i
                                   where v.idviradadecatalogo = :P550_IDVIRADADECATALOGO
                                     and v.idviradadecatalogo = i.idviradadecatalogo
                                     and i.morteprogramada = 'N'
                                     and (i.idtagproduto is null or i.idtagproduto not in (183,184) ) -- tags Repasse RMC, Volta (revistas) essas nao devem continuar
                                ) LOOP
                                
                          insert into execucoes_comandos (idcomando, origem, dataprogramado, comando)
                           values (seq_idcomando.nextval,
                                   'VIRADA DE CATALOGO '||:P550_IDVIRADADECATALOGO,
                                   vdatainicial,
                                   'update produtos set valorpontos = '||c2.pontosproduto ||
                                   ' where idproduto = (select idproduto 
                                                from produtosdetalhados 
                                               where idprodutodetalhado = '||c2.idprodutodetalhado||')');
                
                      END LOOP;
                    END IF;
                    
                    -- Em 01/08/2023, Marcelo solicitou que fosse atualizada a edicao 20 para todos os produtos que tiveram alteração de preço na virada.
                    --
                    INSERT INTO EXECUCOES_COMANDOS (IDCOMANDO, ORIGEM, DATAPROGRAMADO, COMANDO)
                    SELECT seq_idcomando.nextval
                         , 'VIRADA DE CATALOGO '||:P550_IDVIRADADECATALOGO
                         , c1.datavalidadeini
                         , 'UPDATE PRECOSPRODUTOS '       ||
                           'SET '                         ||
                           ' VALORCUSTO = '               || replace(nvl(i.valorcusto,0),',','.')      || ',' ||
                           ' VALORVENDA = '               || replace(nvl(i.valorvenda,0),',','.')      || ',' ||
                           ' PERCCOMISSAOGERENTE = '      || replace(nvl(i.perccomissaoger,0),',','.') || ',' ||
                           ' PERCCOMISSAODISTRIBUIDOR = ' || case when nvl(i.perccomissaodis,0) in (15,18)
                                                                  then replace((i.perccomissaodis - 3),',','.') || ',' 
                                                                  else
                                                                    replace(nvl(i.perccomissaodis,0),',','.') || ',' 
                                                             end ||
                           ' PERCCOMISSAOCONSULTORA = '   || replace(nvl(i.perccomissaoven,0),',','.') || ',' ||
                           ' PRECOSUGERIDO = '            || replace(nvl(i.precosugerido,0),',','.') || 
                           ' WHERE IDPRECOPRODUTO = '     || p.idprecoproduto 
                      FROM viradasdecatalogo      v
                         , itensviradadecatalogo  i
                         --, filiaisedicoesrevistas f
                         , precosprodutos         p
                     WHERE v.idviradadecatalogo = :P550_IDVIRADADECATALOGO
                       AND v.idviradadecatalogo = i.idviradadecatalogo
                       --AND f.idedicaorevista    = v.idedicaorevistadestino
                       AND p.idedicaorevista    = 56
                       AND p.idprodutodetalhado = i.idprodutodetalhado
                       --AND p.idfilialromance    = f.idfilial
                       AND i.valorvenda         <> p.valorvenda
                       AND i.morteprogramada    = 'N'; 
                    
                    --
                  END LOOP;
                  
                  commit;
                
                  apex_application.g_print_success_message := '<span style=”color : yellow “>Parabéns!! Itens atualizados com sucesso! </span>';
                
                END;
                ```
        }
