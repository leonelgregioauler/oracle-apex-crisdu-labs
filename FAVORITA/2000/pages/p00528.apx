page 528 (
    name: Cadastro de Usuários
    title: Cadastro de Usuários
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 95%
        height: 60%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-de-usuários (
        name: Cadastro de Usuários
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P528_ATENDELOJA (
        type: plugin/select
        label {
            label: Atende Loja
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Sim;S,Não;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @cadastro-de-usuários
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P528_ATIVO (
        type: radioGroup
        label {
            label: Ativo
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Sim;S,Não;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @cadastro-de-usuários
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P528_IDFILIALFAVORITA (
        type: plugin/select
        label {
            label: Filial Favorita
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-filiaisfavorita
        }
        layout {
            sequence: 80
            region: @cadastro-de-usuários
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P528_IDGERENTE (
        type: plugin/select
        label {
            label: Gerente
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa||' ( '||c.nomecidade)||' - '||e.sigla||' )' display_value
                     , g.idgerente return_value
                from catal.gerentes g
                   , catal.pessoas p
                   , catal.cidades c
                   , catal.estados e
                where g.idpessoa = p.idpessoa
                  and p.idcidade = c.idcidade
                  and c.idestado = e.idestado
                  and g.ativo    = 'S'
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @cadastro-de-usuários
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P528_IDIDIOMA (
        type: plugin/select
        label {
            label: Idioma
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(i.nome)||' - '||i.codigo display_value
                  , i.ididioma return_value
                from favorita.idiomas i
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @cadastro-de-usuários
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P528_IDPESSOA (
        type: hidden
        layout {
            sequence: 20
            region: @cadastro-de-usuários
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P528_IDPOSTOAVANCADO (
        type: plugin/select
        label {
            label: Posto Avançado
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nome            showvalue
                     , p.idpostoavancado returnvalue
                from roman.postoavancado p;
                ```
            displayExtraValues: false
            nullDisplayValue: - Nenhum -
        }
        layout {
            sequence: 90
            region: @cadastro-de-usuários
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P528_IDUSUARIO (
        type: hidden
        layout {
            sequence: 10
            region: @cadastro-de-usuários
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P528_OBSERVACAO (
        type: textarea
        label {
            label: Observacao
            alignment: left
        }
        layout {
            sequence: 100
            region: @cadastro-de-usuários
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            height: 5
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P528_USUARIO (
        type: textField
        label {
            label: Usuario
            alignment: left
        }
        layout {
            sequence: 30
            region: @cadastro-de-usuários
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 10
            region: @cadastro-de-usuários
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P528_USUARIO
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 40
            region: @cadastro-de-usuários
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.usuariosgruposatendimento ug
                where ug.usuario = v('APP_USER')
                and ug.idgrupoatendimento = 0
                ```
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 30
            region: @cadastro-de-usuários
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 85
                items: {
                    P85_IDPESSOA: &P528_IDPESSOA.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 20
            region: @cadastro-de-usuários
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P528_USUARIO
        }
    )

    process carrega-as-informacoes (
        name: Carrega as informacoes
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vultimoacesso date;
                  vmd5          varchar2(4000);
                  VIDPESSOA     NUMBER := :P528_IDPESSOA;
                  --
                begin
                  --
                  begin
                    --
                    select u.idusuario
                      into :P528_IDUSUARIO
                    from usuarios u
                    where u.idpessoa = VIDPESSOA;
                    --
                  exception
                    when others then
                      --
                      :P528_IDUSUARIO := null; 
                      --:P528_IDPESSOA := null; 
                      :P528_ATIVO := null; 
                      :P528_OBSERVACAO := null; 
                      :P528_IDGERENTE := null; 
                      :P528_USUARIO := null; 
                      :P528_ATENDELOJA := null; 
                      :P528_IDPOSTOAVANCADO := null; 
                      --
                  end;
                  --
                  favorita.pck_cadastros_fav.prc_usuarios( pidusuario       => :P528_IDUSUARIO
                                                         , pidpessoa        => VIDPESSOA
                                                         , pativo           => :P528_ATIVO
                                                         , pobservacao      => :P528_OBSERVACAO
                                                         , pidgerente       => :P528_IDGERENTE
                                                         , pusuario         => :P528_USUARIO
                                                         , patendenteloja   => :P528_ATENDELOJA
                                                         , pultimoacesso    => vultimoacesso
                                                         , pidpostoavancado => :P528_IDPOSTOAVANCADO
                                                         , pmd5             => vmd5
                                                         , poperacao_dml    => 'S');
                    
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 10217360292921040
        }
    )

    process processos-dml (
        name: Processos DML
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  voperacao_dml varchar2(1);
                  vultimoacesso date;
                  vmd5          varchar2(4000);
                  --
                  --
                begin
                  --
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  if voperacao_dml is not null then
                    --
                    favorita.pck_cadastros_fav.prc_usuarios( pidusuario       => :P528_IDUSUARIO
                                                           , pidpessoa        => :P528_IDPESSOA
                                                           , pativo           => :P528_ATIVO
                                                           , pobservacao      => :P528_OBSERVACAO
                                                           , pidgerente       => :P528_IDGERENTE
                                                           , pusuario         => :P528_USUARIO
                                                           , patendenteloja   => :P528_ATENDELOJA
                                                           , pultimoacesso    => vultimoacesso
                                                           , pidpostoavancado => :P528_IDPOSTOAVANCADO
                                                           , pmd5             => vmd5
                                                           , poperacao_dml    => voperacao_dml);
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo Efetuado com Sucesso
        }
        error {
            errorMessage: Erro ao executar processo -> #SQLERRM#
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 10217894134921045
        }
    )

)

