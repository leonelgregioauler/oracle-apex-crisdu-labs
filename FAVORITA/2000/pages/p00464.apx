        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                -- Created on 28/08/2020 by MAX.BERKEUER 
                declare 
                  --
                  vsituacao varchar2(30);
                  --
                begin
                  --
                  select st.descricao
                  into vsituacao
                  from situacoescomprastransferencias st
                  where st.idsituacaocompratransf = pck_comprastransf_fav_v2.fnc_proxima_situacao(:P464_IDTIPOCOMPTRANSREM,:P464_IDSITUACAO);
                  --
                  return vsituacao;
                  --
                exception
                  when no_data_found then
                    return 'Fluxo Finalizado';  
                end;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P464_SESSION_SUPORTE_FATURAMENTO (
        type: hidden
        layout {
            sequence: 120
            region: @remessa-de-pedidos
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_url varchar2(2000);
                    l_app number := 2000;
                    l_session number := v('APP_SESSION');
                BEGIN
                    l_url := APEX_UTIL.PREPARE_URL(
                        p_url => 'f?p=' || l_app || ':256:'||l_session||'::NO::P256_IDCOMPRATRANSFERENCIA:'||:P464_IDCOMPRATRANSFERENCIA,
                        p_checksum_type => 'SESSION');
                    
                    return l_url;
                END;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

