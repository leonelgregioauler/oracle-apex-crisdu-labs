    process cancelar-remessa (
        name: Cancelar remessa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Created on 11/09/2020 by MAX.BERKEUER 
                declare 
                  --
                  vid_compra_transferencia number := :P464_IDCOMPRATRANSFERENCIA;
                  vexist number;
                  --
                begin
                  --
                  select count(1)
                  into vexist
                  from pedidosremessasct p
                  where p.idcompratransferencia = vid_compra_transferencia;
                  --
                  if vexist = 0 then
                    --
                    update comprastransferencias c
                    set c.idsituacao = -1
                    where c.idcompratransferencia = vid_compra_transferencia;
                    --
                  else
                    --
                    apex_error.add_error(p_message          => 'Remessa não pode ser cancelada, existem pedidos vinculados!',
                                         p_display_location => apex_error.c_inline_with_field_and_notif);
                    --
                  end if;
                  --
                end;
                ```
        }
