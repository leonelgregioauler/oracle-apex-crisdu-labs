    button impriir (
        buttonName: IMPRIIR
        label: Impriir Remessa
        layout {
            sequence: 110
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--primary
                t-Button--iconRight
                t-Button--stretch
            ]
            icon: fa-print
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:window.open("f?p=&APP_ID.:484:&SESSION.::NO::P484_ID_REMESSA:&P464_IDCOMPRATRANSFERENCIA.","_blank");
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                not exists (select pr.codretornototalexp  /*Valida todos os pedidos integrados com sucesso*/
                            from pedidosremessasct pr,
                                 pedidos p,
                                 situacoesentrega se,
                                 situacoesfinanceiro sf,
                                 etiquetaspostagem etq
                            where pr.idpedido = p.idpedido 
                            and p.idsituacaoentrega = se.idsituacaoentrega
                            and p.idsituacaofinanceiro = sf.idsituacaofinanceiro
                            and p.idpedido = etq.idpedido(+)
                            and pr.codretornototalexp != 0
                            and pr.idcompratransferencia = :P464_IDCOMPRATRANSFERENCIA)
                and (select c.idsituacao
                    from comprastransferencias c
                    where c.idcompratransferencia = :P464_IDCOMPRATRANSFERENCIA) in (7,40) /*Situação Aguardando Despacho ou Recebido*/
                ```
        }
    )

    button imprimir-pedidos (
        buttonName: IMPRIMIR_PEDIDOS
        label: Imprimir Pedidos
        layout {
            sequence: 40
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: &P464_URL_IMPRESSAO.
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                -- Created on 04/09/2020 by MAX.BERKEUER 
                declare 
                  --
                  vexist number;
                  vid_tipo number;
                  vid_situacao number;
                  vid_remessa number := :P464_IDCOMPRATRANSFERENCIA;
                  --
                begin
                  --
                  /*Verifica se existe pedido na remessa*/
                  select count(1)
                  into vexist
                  from pedidosremessasct prt
                  where prt.idcompratransferencia = vid_remessa; 
                  --
                  if vexist > 0 then
                    --
                    select c.idtipocomptransrem,
                           c.idsituacao
                    into vid_tipo,
                         vid_situacao
                    from comprastransferencias c
                    where c.idcompratransferencia = vid_remessa;
                    --
                    if vid_tipo in (3,4,7,8,10) and vid_situacao != -1 and pck_util.fnc_verificaacesso(58210,:APP_USER) = 'S' 
                       and pck_comprastransf_fav_v2.fnc_proxima_situacao(vid_tipo,vid_situacao) is not null then
                      --
                      return true;
                      --
                    else
                      --
                      return false;
                      --
                    end if;
                    --
                  else
                    --
                    return false;
                    --
                  end if;
                  --
                end;
                ```
        }
    )

