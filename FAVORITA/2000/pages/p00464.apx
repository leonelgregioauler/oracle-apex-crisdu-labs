page 464 (
    name: Remessa de Pedidos
    title: Remessa de Pedidos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_remove_pedido(pid_pedido) {
              apex.confirm("Deseja remover esse pedido? O pedido será incluído na remessa em andamento.", {
                request:"REMOVER_PEDIDO",
                set:{"P464_ID_PEDIDO_REMOVER":pid_pedido},
                showWait:true
                });  
            }
            
             function suportefaturamento() 
              {
                  vurl = document.getElementById("P464_SESSION_SUPORTE_FATURAMENTO").value;
                  pjan = window.open(vurl,'page','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1280,height=1024,left=20,top=10','_blank'); void(0);
                  pjan.focus();
              }
            $(document).keydown(function (e) {
            	if(e.which == 120)
            	document.getElementById('B73317809119730038').click();;
            });
            
            function fnc_trocar_remessa(pidpedido) {
              document.getElementById('P464_ID_PEDIDO').value = pidpedido;
              openModal('alt_remessa');
            };
            ```
    }
    css {
        inline:
            ```css
            a.vermelho:link, a.vermelho:visited, a.vermelho:hover, a.vermelho:active {
              text-decoration: none;
              color: #f00
              }
            ```
    }

