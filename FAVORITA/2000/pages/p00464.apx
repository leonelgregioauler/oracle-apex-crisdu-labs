    region classificações (
        name: Classificações
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.dataclassificado as "Data"
                     , c.nomeusuario as "Usuário"
                     , c.nomecaracteristica as "Característica"
                     , c.descricao as "Descrição"
                     , c.observacao as "Observação"
                from vw_classificacoescompras_fav c
                where c.idcompratransferencia = :P464_IDCOMPRATRANSFERENCIA
                  and c.ididioma = 1
                order by c.idclassificacaocompratransf
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
