    button registra-coleta (
        buttonName: REGISTRA_COLETA
        label: Registra Coleta
        layout {
            sequence: 50
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: "javascript:apex.confirm(\"Deseja efetuar o registro de coleta?\", {     request:\"ENV_TOTAL_EXP\",     showWait:true     });"
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                -- Created on 12/01/2021 by MAXBE 
                declare 
                  --
                  vid_remessa number := :P464_IDCOMPRATRANSFERENCIA;
                  vid_situacao number;
                  vtipo_remessa number;
                  vexist number;
                  --
                begin
                  --
                  select c.idsituacao,
                         c.idtipocomptransrem
                  into vid_situacao,
                       vtipo_remessa
                  from comprastransferencias c
                  where c.idcompratransferencia = vid_remessa;
                  --
                  if vtipo_remessa = 8 and vid_situacao = 7 and pck_util_fav.fnc_verificaacesso(75007,:P0_IDUSUARIO) = 'S'then
                    --
                    select count(1)
                    into vexist
                    from pedidosremessasct prt
                    where (prt.codretornototalexp != 0 or prt.codretornototalexp is null)
                    and prt.idcompratransferencia = vid_remessa;
                    --
                    if vexist > 0 then
                      --
                      return true;
                      --
                    end if;
                    --
                  end if;
                  --
                  return false;
                  --
                end;
                ```
        }
    )

