    region lista-de-pedidos (
        name: Lista de Pedidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpedido,
                       pck_util_fav.fnc_nomefilialfavorita(p.idfilialfavorita) as "Filial Fav",
                       pck_util_fav.fnc_nomefilialromance(p.idfilialromance) "Filial Rmc",
                       pck_util_fav.fnc_nomerepresentante(p.idrepresentante) "Representante",
                       pck_util_fav.fnc_nomevendedora(p.idvendedora) as "Cliente",
                       pck_util_fav.fnc_cpfvendedora(p.idvendedora) as "Cpf",
                       p.dataemissao as "Dt Emissão",
                       se.descricaosistema as "Sit Entrega",
                       sf.descricaosistema as "Sit Financeiro",
                       pr.descretornototalexp as "Int Total EXP",
                       etq.numeroetiquetacomdigitverific as "Etiqueta Correio",
                       case
                         when pck_montagem_tablet.fnc_valida_ped_erro(p.idpedido) = 0 then
                           'Não'
                         else
                           '<a href="'||apex_util.prepare_url('f?p=&APP_ID.:497:&SESSION.::NO::P497_ID_PEDIDO:'||p.idpedido)||'">Sim</a>'
                       end as "Erro Montagem",       
                       ( select volume
                       from pedidosremessasct 
                       where idpedido = p.idpedido ) as "Volume",
                       case
                         when exists (select 1
                                     from classificacoespedidos c
                                     where c.idpedido = p.idpedido
                                     and c.idcaracteristicapedido = 43 ) and p.idpedidovirtualage is not null then
                           'Integrado'
                         else
                           'Não Integrado' 
                       end as "Integração",
                       p.mensagemintegracao "Msg Integração",
                       pck_util_fav.fnc_link_pedido(p.idpedido,'S') as link,
                       '<a href="javascript:fnc_remove_pedido('||p.idpedido||');" class="vermelho"><span class="fa fa-remove fa-2x" aria-hidden="true"></span></a>' as del,
                       '<a href="javascript:fnc_trocar_remessa('||p.idpedido||');"><span aria-hidden="true" class="fa fa-exchange fa-2x"></span></a>' as ALT_REMESSA
                from pedidosremessasct pr,
                     pedidos p,
                     situacoesentrega se,
                     situacoesfinanceiro sf,
                     etiquetaspostagem etq
                where pr.idpedido = p.idpedido 
                and p.idsituacaoentrega = se.idsituacaoentrega
                and p.idsituacaofinanceiro = sf.idsituacaofinanceiro
                and p.idpedido = etq.idpedido(+)
                and pr.idcompratransferencia = :P464_IDCOMPRATRANSFERENCIA 
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
