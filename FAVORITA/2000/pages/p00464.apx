    pageItem P464_NOVA_REMESSA (
        type: popupLov
        label {
            label: Nova Remessa
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(c.dataembarque,'DD/MM/YYYY')||'-'||
                       case
                         when to_char(c.dataembarque,'HH24') < 12 then
                           'Manhã'
                         else
                           'Tarde'
                       end as turno,
                       c.idcompratransferencia
                from comprastransferencias c
                where c.idtipocomptransrem = 10
                and c.idsituacao != 40
                and c.idcompratransferencia != :P464_IDCOMPRATRANSFERENCIA
                order by c.dataembarque
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 10
            region: @alterar-remessa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--xlarge
            ]
            width: 30
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

