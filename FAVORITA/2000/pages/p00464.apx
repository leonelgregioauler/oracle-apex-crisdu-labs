    process libera-bloqueia-montagem-tablet (
        name: Libera/Bloqueia montagem tablet
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Created on 02/04/2021 by MAXBE 
                declare 
                  --
                  vid_remessa number := :P464_IDCOMPRATRANSFERENCIA;
                  vid_usuario number := :P0_IDUSUARIO;
                  vrequest varchar2(30) := :REQUEST;
                  --
                begin
                  --
                  if vrequest = 'LIBERAR_TABLET' then
                    --
                    insert into classificacoescomprastransf(idclassificacaocompratransf,
                                                            idcompratransferencia,
                                                            dataclassificado,
                                                            idusuario,
                                                            idcaracteristicacomptransf,
                                                            idvalorcaracteristica,
                                                            observacao)
                    values(seq_idclassificacaocomptransf.nextval,
                                                            vid_remessa,
                                                            sysdate,
                                                            vid_usuario,
                                                            24,
                                                            null,
                                                            null);
                    --
                  elsif vrequest = 'BLOQUEAR_TABLET' then
                    --
                    delete classificacoescomprastransf cf
                    where cf.idcompratransferencia = vid_remessa
                    and cf.idcaracteristicacomptransf = 24;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Ação processada!
        }
        advanced {
            executionMappingIdentifier: 105341085169803628
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: LIBERAR_TABLET,BLOQUEAR_TABLET
        }
    )

