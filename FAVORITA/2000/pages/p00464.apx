    pageItem P464_TURNO (
        type: displayOnly
        label {
            label: Turno
            alignment: left
        }
        layout {
            sequence: 90
            region: @remessa-de-pedidos
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select case
                         when to_char(c.dataembarque,'HH24') < 12 then
                           'Manhã'
                         else
                           'Tarde'
                       end as turno
                from comprastransferencias c
                where c.idcompratransferencia = :P464_IDCOMPRATRANSFERENCIA
                ```
            used: always
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P464_IDCOMPRATRANSFERENCIA is not null
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P464_URL_IMPRESSAO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 130
            region: @remessa-de-pedidos
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                -- Created on 23/09/2020 by MAX.BERKEUER 
                declare 
                  --
                  vtipo_remessa number := :P464_IDTIPOCOMPTRANSREM;
                  vurl varchar2(500);
                  vitens varchar2(200);
                  vvalores varchar2(200);
                  --
                begin
                  --
                  if vtipo_remessa = 10 then /*Link para impressão de remessa delivery*/
                    --
                    vitens := 'P118_IDCOMPRATRANSFERENCIA,P118_TIPO,P118_NR_PAGE_BRANCH,P118_BOLETO,P118_PROMISSORIA';
                    vvalores := '&P464_IDCOMPRATRANSFERENCIA.,I,464,1,1';
                    --
                    vurl := apex_util.prepare_url('f?p=&APP_ID.:118:&APP_SESSION.::::'||vitens||':'||vvalores);
                    --
                  else
                    --
                    vitens := 'P118_IDCOMPRATRANSFERENCIA,P118_TIPO,P118_NR_PAGE_BRANCH';
                    vvalores := '&P464_IDCOMPRATRANSFERENCIA.,I,464';
                    --    
                    vurl := apex_util.prepare_url('f?p=&APP_ID.:118:&APP_SESSION.::::'||vitens||':'||vvalores);
                    --
                  end if;
                  --
                  --dbms_output.put_line(vurl);
                  --
                  return vurl;
                  --
                end;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

