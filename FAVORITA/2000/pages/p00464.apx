    process enviar-remessa-total-exp (
        name: Enviar remessa total exp
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vid_remessa number := :P464_IDCOMPRATRANSFERENCIA;
                  vexists number;
                  v_array_pedidos apex_application_global.vc_arr2;
                  vlista_pedidos varchar2(500);
                  vmenssagem varchar2(2000);  
                  --
                begin
                  --
                  /*Valida pedidos sem nfe*/
                  select pr.idpedido
                  bulk collect
                  into v_array_pedidos
                  from pedidosremessasct pr
                  where pr.idcompratransferencia = vid_remessa
                  and not exists (select 1
                                 from crisdu.notasfiscais c
                                 where c.idpedidofavorita = pr.idpedido);
                  --
                  vlista_pedidos :=  apex_util.table_to_string(p_table => v_array_pedidos,p_string => ', ');  
                  --
                  if v_array_pedidos.count() > 0 then
                    --
                    apex_error.add_error(p_message          => 'Os seguinte pedidos não possuem nota fiscal vinculada - '||vlista_pedidos,
                                         p_display_location => apex_error.c_inline_with_field_and_notif);
                    --
                  end if;
                  --
                  /*Valida pedidos sem endereço correto*/
                  select pr.idpedido
                  bulk collect
                  into v_array_pedidos
                  from pedidosremessasct pr
                  where pr.idcompratransferencia = vid_remessa
                  and not exists (select 1
                                 from vw_enderecoentregapedidos v
                                 where v.idpedido = pr.idpedido);
                  --
                  vlista_pedidos :=  apex_util.table_to_string(p_table => v_array_pedidos,p_string => ', ');  
                  --
                  if v_array_pedidos.count() > 0 then
                    --
                    apex_error.add_error(p_message          => 'Os seguinte pedidos não possuem endereço correto - '||vlista_pedidos,
                                         p_display_location => apex_error.c_inline_with_field_and_notif);
                    --
                  end if;
                  --
                  if v_array_pedidos.count() = 0 then
                    --
                    pck_integracaototalexpress.prc_registraremessa(pidcompratransferencia => vid_remessa, pmenssagem => vmenssagem);
                    --
                    if vmenssagem != 'sucesso' then
                      --
                      apex_error.add_error(p_message          => vmenssagem,
                                           p_display_location => apex_error.c_inline_with_field_and_notif);
                      --
                    end if;
                    --
                  end if;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Ação Processada!
        }
        advanced {
            executionMappingIdentifier: 79151378210351832
        }
        serverSideCondition {
            type: request=Value
            value: ENV_TOTAL_EXP
        }
    )

