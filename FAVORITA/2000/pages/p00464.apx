    process remover-pedido (
        name: Remover pedido
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Created on 31/08/2020 by MAX.BERKEUER 
                declare 
                  --
                  vnr_pedidos number;
                  vid_remessa number;
                  vid_tipo_remessa number := :P464_IDTIPOCOMPTRANSREM;
                  --  
                begin
                  --
                  /*Verifica se o pedido não é o último da remessa*/
                  select count(1)
                  into vnr_pedidos
                  from pedidosremessasct prt
                  where prt.idcompratransferencia = :P464_IDCOMPRATRANSFERENCIA;
                  --
                  /*Seleciona a remessa em aberto*/
                  select cp.idcompratransferencia
                  into vid_remessa
                  from comprastransferencias cp
                  where cp.idtipocomptransrem = vid_tipo_remessa
                  and cp.idsituacao = 0;  
                  --
                  if vnr_pedidos <= 1 then
                    --
                    apex_error.add_error(p_message          => 'Não pode ser removido o último pedido da remessa!',
                                         p_display_location => apex_error.c_inline_with_field_and_notif);
                    --
                  elsif vid_remessa = :P464_IDCOMPRATRANSFERENCIA then
                    --
                    apex_error.add_error(p_message          => 'Não pode ser removido pedido de uma remessa em andamento!',
                                         p_display_location => apex_error.c_inline_with_field_and_notif);
                    --
                  else
                    --
                    update pedidosremessasct prt
                    set prt.idcompratransferencia = vid_remessa
                    where prt.idpedido = :P464_ID_PEDIDO_REMOVER;  
                    --
                  end if;
                  --
                exception
                  when no_data_found then
                    apex_error.add_error(p_message          => 'Não foi localizada remessa em andamento para adicionar o pedido!',
                                         p_display_location => apex_error.c_inline_with_field_and_notif);
                end;
                ```
        }
        execution {
            sequence: 100
        }
        successMessage {
            successMessage: Ação Processada!
        }
        error {
            errorMessage: Erro ao remover pedido!
        }
        advanced {
            executionMappingIdentifier: 71201322400909901
        }
        serverSideCondition {
            type: request=Value
            value: REMOVER_PEDIDO
        }
    )

