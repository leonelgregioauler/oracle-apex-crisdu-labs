page 172 (
    name: Filtrar Referências
    title: Filtrar Referências
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG_22"';
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region filtrar-referências (
        name: Filtrar Referências
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "ROWID",
                "IDUSUARIO",
                "IDPRODUTO",
                "IDPRODUTODETALHADO",
                "PAGINA"
                from "#OWNER#"."FILTROSPRODUTOS"
                where idusuario = :P0_IDUSUARIO
                  and pagina    = :P172_PAGINA
                
                ```
        }
        layout {
            sequence: 15
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhum Produto Informado!
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 6
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column IDPRODUTO (
            reportColumnQueryId: 3
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Produto
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select referencia||' - '||p.nomeproduto  display_value
                         , idproduto return_value
                    from produtos p
                    order by nomeproduto
                    ```
            }
            layout {
                sequence: 4
            }
            appearance {
                width: 30
            }
            serverSideCondition {
                type: expression
                language: sql
                sqlExpression: :P172_PAGINA = 169
            }
        )

        column IDPRODUTODETALHADO (
            reportColumnQueryId: 4
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Produto Detalhado
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_util_fav.fnc_nomeprodutodetalhado(idprodutodetalhado, :P0_IDIDIOMA) as d
                         , idprodutodetalhado as r
                       from produtosdetalhados
                     order by 1
                    ```
            }
            layout {
                sequence: 5
            }
            appearance {
                width: 70
            }
            serverSideCondition {
                type: expression
                language: sql
                sqlExpression:
                    ```sql
                    :P172_PAGINA = 318
                    or :P172_PAGINA = 369
                    ```
            }
        )

        column IDUSUARIO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 3
            }
            default {
                type: item
                item: P0_IDUSUARIO
            }
        )

        column PAGINA (
            reportColumnQueryId: 5
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 6
            }
            default {
                type: item
                item: P172_PAGINA
            }
        )

        column ROWID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    pageItem P172_PAGINA (
        type: hidden
        layout {
            sequence: 10
            region: @filtrar-referências
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button add (
        buttonName: ADD
        label: Adicionar Produto
        layout {
            sequence: 40
            region: @filtrar-referências
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.widget.tabular.addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button multi-row-delete (
        buttonName: MULTI_ROW_DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @filtrar-referências
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Deseja realmente remover os produtos?','MULTI_ROW_DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Salvar
        layout {
            sequence: 30
            region: @filtrar-referências
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @filtrar-referências
        target {
            tableName: FILTROSPRODUTOS
            pkColumn: ROWID
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: #MRD_COUNT# row(s) deleted.
        }
        advanced {
            executionMappingIdentifier: 186222173600909851
        }
        serverSideCondition {
            type: request=Value
            value: MULTI_ROW_DELETE
            executeCondition: once
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @filtrar-referências
        target {
            tableName: FILTROSPRODUTOS
            pkColumn: ROWID
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: #MRU_COUNT# row(s) updated, #MRI_COUNT# row(s) inserted.
        }
        advanced {
            executionMappingIdentifier: 186221730319909850
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 172
            }
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

)

