page 638 (
    name: Relatoiro Estoque X Picking
    title: Relatório Estoque X Picking
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 900
        height: 650
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region estoque-x-picking (
        name: Estoque X Picking
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ic.idinventariociclico
                     , favorita.pck_util_fav.fnc_nomefilialfavorita(f.idfilialfavorita) Filial
                     , ic.idprodutodetalhado
                     , favorita.pck_util_fav.fnc_nomeprodutodetalhado(pd.idprodutodetalhado,f.idpais) produto
                     , ( select favorita.pck_util_fav.fnc_nomecategoria(p.idcategoria,f.idpais)
                         from favorita.produtos p
                         where p.idproduto = pd.idproduto) categoria
                     , e.quantidade
                     , favorita.pck_estoque_fav.fnc_estoquereservado(e.idestoque) - favorita.pck_estoque_fav.fnc_estoquetransito(e.idestoque) qtdestoqueresevado
                     , e.quantidade + favorita.pck_estoque_fav.fnc_estoquereservado(e.idestoque) - favorita.pck_estoque_fav.fnc_estoquetransito(e.idestoque) qtdtotal
                     , ic.qtdfisicacontada qtdpicking
                     --, ( e.quantidade + favorita.pck_estoque_fav.fnc_estoquereservado(e.idestoque) - favorita.pck_estoque_fav.fnc_estoquetransito(e.idestoque) ) - ic.qtdfisicacontada  qtddiferenca
                     , ic.qtdfisicacontada - ( e.quantidade + favorita.pck_estoque_fav.fnc_estoquereservado(e.idestoque) - favorita.pck_estoque_fav.fnc_estoquetransito(e.idestoque) )  qtddiferenca
                from favorita.itensinventariociclico ic
                   , favorita.inventariociclico i
                   , favorita.produtosdetalhados pd
                   , favorita.produtos pr
                   , favorita.estoques e 
                   , favorita.filiaisfavorita f
                where i.idinventariociclico  = ic.idinventariociclico
                  and ic.idprodutodetalhado  = pd.idprodutodetalhado
                  and pd.idproduto           = pr.idproduto
                  and e.idprodutodetalhado   = ic.idprodutodetalhado
                  and e.idestoque            = ic.idestoque
                  and f.idfilialfavorita     = i.idfilial
                  and ic.idinventariociclico = :P638_IDINVENTARIOCICLICO
                  order by ic.qtdfisicacontada 
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 3072858472705849402
        }

