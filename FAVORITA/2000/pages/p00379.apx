page 379 (
    name: Compras em Andamento
    title: Compras em Andamento
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region compras-em-andamento (
        name: Compras em Andamento
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.numero
                     , roman.pck_romance.fnc_nomefornecedor(c.idfornecedor) fornecedor
                     , pck_util_fav.fnc_retornasitcompratransf(c.idsituacao,:P0_IDIDIOMA) situacao
                     , c.notafiscal
                     , c.dataemissao
                     , c.dataprevisaoentrega
                     , ii.quantidadecomprada
                     , ii.quantidadecomprada*ii.valorcusto custocomprado
                     , c.idcompratransferencia 
                from itenscomprastransferencias ii
                  , comprastransferencias c
                where c.idcompratransferencia   = ii.idcompratransferencia
                  and c.idfilialfavoritadestino = :P379_IDFILIALDESTINO
                  and ii.idprodutodetalhado     = :P379_IDPRODUTODETALHADO
                  and c.idsituacao not in (-1,40)
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhuma compra encontrada.
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 1529082175171350515
        }

        column CUSTOCOMPRADO (
            type: plainText
            heading {
                heading: Total Custo
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column DATAEMISSAO (
            type: plainText
            heading {
                heading: Emissão
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        column DATAPREVISAOENTREGA (
            type: plainText
            heading {
                heading: Previsão
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: E
            }
        )

        column FORNECEDOR (
            type: plainText
            heading {
                heading: Fornecedor
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column IDCOMPRATRANSFERENCIA (
            type: link
            heading {
                heading: Ver
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            link {
                target: {
                    page: 74
                    items: {
                        P74_IDCOMPRATRANSFERENCIA: #IDCOMPRATRANSFERENCIA#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-view.png" class="apex-edit-view" alt="">
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column NOTAFISCAL (
            type: plainText
            heading {
                heading: Notafiscal
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column NUMERO (
            type: plainText
            heading {
                heading: Número
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column QUANTIDADECOMPRADA (
            type: plainText
            heading {
                heading: Qtd Comprada
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column SITUACAO (
            type: plainText
            heading {
                heading: Situação
                alignment: center
            }
            layout {
                sequence: 90
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        savedReport 15291160 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CUSTOCOMPRADO (
                sequence: 8
            )

            displayColumn DATAEMISSAO (
                sequence: 5
            )

            displayColumn DATAPREVISAOENTREGA (
                sequence: 6
            )

            displayColumn FORNECEDOR (
                sequence: 2
            )

            displayColumn IDCOMPRATRANSFERENCIA (
                sequence: 9
            )

            displayColumn NOTAFISCAL (
                sequence: 4
            )

            displayColumn NUMERO (
                sequence: 1
            )

            displayColumn QUANTIDADECOMPRADA (
                sequence: 7
            )

            displayColumn SITUACAO (
                sequence: 3
            )

        )

    )

    pageItem P379_IDFILIALDESTINO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @compras-em-andamento
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P379_IDPRODUTODETALHADO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @compras-em-andamento
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

