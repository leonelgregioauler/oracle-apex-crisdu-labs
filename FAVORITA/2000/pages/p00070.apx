    process consulta-histórico (
        name: Consulta Histórico
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidticket number;
                  vtelefone varchar2(100);
                  vdata     date;
                  vprioridade number;
                  vidsituacao number;
                  vobservacao varchar2(1000);
                  vidusuario number;
                  vidpessoa number;
                  vidgrupoatendimento number;
                  vdatainicio date;
                  vdataconclusao date;
                  vnumeropa varchar2(100);
                  vidpedido number;
                  vcodigoarea number;
                  vmd5 varchar2(1000);
                  --
                begin
                  --
                  if :P70_IDHISTORICOTAREFA is not null then
                    --
                    pck_tarefas_fav.prc_historicostarefas(pidhistoricotarefa        => :P70_IDHISTORICOTAREFA,
                                                          pidtarefa                 => :P70_IDTAREFA,
                                                          pdatainicio               => :P70_DATAINICIO,
                                                          pdatafim                  => :P70_DATAFIM,
                                                          pobservacao               => :P70_OBSERVACAO,
                                                          pidsituacao               => :P70_IDSITUACAO,
                                                          pidusuario                => :P70_IDUSUARIO,
                                                          pnumeroposicaoatendimento => :P70_NUMEROPOSICAOATENDIMENTO,
                                                          pmd5                      => :P70_MD5,
                                                          poperacao_dml             => 'S');
                    --
                  end if;
                  --
                  pck_tarefas_fav.prc_tarefas(pidtarefa                 => :P70_IDTAREFA,
                                                pidtipotarefa             => :P70_IDTIPOTAREFA,
                                                pidticketcallcenter       => vidticket,
                                                ptelefone                 => vtelefone,
                                                pdatainclusao             => vdata,
                                                pprioridade               => vprioridade,
                                                pidsituacao               => vidsituacao,
                                                pobservacao               => vobservacao,
                                                pidusuario                => vidusuario,
                                                pidpessoa                 => vidpessoa,
                                                pidgrupoatendimento       => vidgrupoatendimento,
                                                pdatainicio               => vdatainicio,
                                                pdataconclusao            => vdataconclusao,
                                                pnumeroposicaoatendimento => vnumeropa,
                                                pidpedido                 => vidpedido,
                                                pcodigoarea               => vcodigoarea,
                                                pmd5                      => vmd5,
                                                poperacao_dml             => 'S');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 11454367712062821
        }
    )

    process em-atendimento (
        name: Em Atendimento
