    validation observacao (
        name: Observacao
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P70_OBSERVACAO
        }
        error {
            errorMessage: Por favor, insira uma observação!
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('EMESPERA','ATENDIMENTO','ANALISE','CONCLUIDO')
                ```
        }
    )

