    button analise (
        buttonName: ANALISE
        label: Aguardar Análise
        layout {
            sequence: 30
            region: @incluir-histórico-de-tareda
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconRight
            ]
            icon: fa-stethoscope
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P70_IDHISTORICOTAREFA
        }
    )

    button atendimento (
        buttonName: ATENDIMENTO
        label: Em Atendimento
        layout {
            sequence: 40
            region: @incluir-histórico-de-tareda
            slot: delete
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-phone
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where :P70_IDHISTORICOTAREFA is null 
                  and not exists ( select 1
                                   from tarefas t
                                   where t.idtarefa != :P70_IDTAREFA
                                     and t.idsituacao = 10
                                     and t.idusuario = pck_util_fav.fnc_retornaidusuario(v('APP_USER')))
                  and :P70_IDTAREFA is not null
                ```
        }
    )

