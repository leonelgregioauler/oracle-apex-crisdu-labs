    process operação-dml-em-históricos-de-tarefas (
        name: Operação DML em Históricos de Tarefas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  if v('REQUEST') = 'ATENDIMENTO' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'CONCLUIDO' 
                     or v('REQUEST') = 'ANALISE' 
                     or v('REQUEST') = 'EMESPERA'  then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --                     
                  #OWNER#.pck_tarefas_fav.prc_historicostarefas(pidhistoricotarefa        => :P70_IDHISTORICOTAREFA,
                                                                pidtarefa                 => :P70_IDTAREFA,
                                                                pdatainicio               => :P70_DATAINICIO,
                                                                pdatafim                  => :P70_DATAFIM,
                                                                pobservacao               => :P70_OBSERVACAO,
                                                                pidsituacao               => :P70_IDSITUACAO,
                                                                pidusuario                => :P70_IDUSUARIO,
                                                                pnumeroposicaoatendimento => :P70_NUMEROPOSICAOATENDIMENTO,
                                                                pmd5                      => :P70_MD5,
                                                                poperacao_dml             => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 11454815759062826
        }
    )

    process operação-dml-em-tarefas (
        name: Operação DML em Tarefas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  update tarefas
                  set idtipotarefa = :P70_IDTIPOTAREFA
                  where idtarefa = :P70_IDTAREFA;
                  --
                end;
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 29869419843949315
        }
    )

