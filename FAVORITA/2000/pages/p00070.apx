page 70 (
    name: Ver Históricos Tarefas
    title: Históricos Tarefas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 65%
        height: 85%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function editar(idhist) 
            {
            document.getElementById('P70_IDHISTORICOTAREFA').value = idhist;
            apex.submit('EDITAR');
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region históricos-da-tarefa (
        name: Históricos da Tarefa
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ht.idhistoricotarefa
                     , ht.idtarefa
                     , ht.datainicio
                     , ht.datafim
                     , ht.observacao
                     , pck_util_fav.fnc_retornasituacaotarefa(ht.idsituacao,:P0_IDIDIOMA) situacao
                     , pck_util_fav.fnc_nomeusuario(ht.idusuario) usuario
                     , decode(datafim, null, '<a href="javascript: editar('||idhistoricotarefa||');" ><img src="#IMAGE_PREFIX#menu/pencil2_16x16.gif" alt="Editar"></a>'
                                           , null ) Editar
                from vw_historicostarefas_fav ht
                where ht.idtarefa = :P70_IDTAREFAP
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 6933455214267722
        }

