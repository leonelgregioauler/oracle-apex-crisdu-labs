page 110 (
    name: Volumes Pedidos Remessas
    title: Volumes Pedidos Remessas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 70%
        height: 80%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region alterar-volume-do-pedido (
        name: Alterar Volume do Pedido
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region volumes-da-remessa-de-pedidos (
        name: Volumes da Remessa de Pedidos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.idvolumepedidoremessa
                     , v.idcompratransferencia
                     , v.volume
                     , v.peso
                     , decode(v.recebido,'S','Sim','Não') recebido
                     , (select substr(e.parametro4,16,20)
                        from etiquetasfavorita e
                        where e.idvolumepedidoremessa = v.idvolumepedidoremessa
                          and rownum = 1) codbarras
                from volumespedidosremessas v
                where v.idcompratransferencia = :P110_IDCOMPRATRANSFERENCIA
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 28484680112952725
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDVOLUMEPEDIDOREMESSA
                layout {
                    show: false
                    width: 40
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDCOMPRATRANSFERENCIA
                layout {
                    show: false
                    width: 63
                    sequence: 2
                }
            )

            displayColumn (
                column: @VOLUME
                layout {
                    width: 83
                    sequence: 3
                }
            )

            displayColumn (
                column: @PESO
                layout {
                    width: 156
                    sequence: 5
                }
            )

            displayColumn (
                column: @ROWID
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 0
                }
            )

            displayColumn (
                column: @RECEBIDO
                layout {
                    width: 161
                    sequence: 7
                }
            )

            displayColumn (
                column: @CODBARRAS
                layout {
                    sequence: 7
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column CODBARRAS (
            type: textField
            heading {
                heading: Cód. Barras
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            validation {
                maxLength: 20
            }
            source {
                databaseColumn: CODBARRAS
                dataType: varchar2
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column IDCOMPRATRANSFERENCIA (
            type: numberField
            heading {
                heading: CTRP
                alignment: center
            }
            settings {
                numberAlignment: center
                virtualKeyboard: text
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                databaseColumn: IDCOMPRATRANSFERENCIA
                dataType: number
                queryOnly: true
            }
            columnFilter {
                lovType: none
            }
        )

        column IDVOLUMEPEDIDOREMESSA (
            type: numberField
            heading {
                heading: IDVOLUME
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDVOLUMEPEDIDOREMESSA
                dataType: number
                queryOnly: true
            }
            columnFilter {
                lovType: none
            }
        )

        column PESO (
            type: numberField
            heading {
                heading: Peso
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                databaseColumn: PESO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column RECEBIDO (
            type: textField
            heading {
                heading: Recebido
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            validation {
                maxLength: 3
            }
            source {
                databaseColumn: RECEBIDO
                dataType: varchar2
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ROWID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ROWID
                dataType: rowid
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column VOLUME (
            type: numberField
            heading {
                heading: Volume
                alignment: center
            }
            settings {
                numberAlignment: center
                virtualKeyboard: text
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                databaseColumn: VOLUME
                dataType: number
                queryOnly: true
            }
            columnFilter {
                lovType: none
            }
        )

    )

    pageItem P110_IDCOMPRATRANSFERENCIA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @volumes-da-remessa-de-pedidos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P110_IDFILIALFAVORITAORIGEM (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @volumes-da-remessa-de-pedidos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P110_IDPEDIDO (
        type: plugin/select
        label {
            label: Pedido
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select idpedido as d
                     , idpedido  as r
                from pedidosremessasct
                 where idcompratransferencia = :P110_IDCOMPRATRANSFERENCIA
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 10
            region: @alterar-volume-do-pedido
            slot: regionBody
            alignment: left
            columnSpan: 7
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P110_TELAORIGEM (
        type: hidden
        layout {
            sequence: 40
            region: @alterar-volume-do-pedido
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P110_VOLUMEDESTINO (
        type: selectList
        label {
            label: Volume Destino
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Volume: '||vr.volume ||' - Pedidos: '|| ( select count(1)
                                                                  from pedidosremessasct pr
                                                                  where idcompratransferencia = :P110_IDCOMPRATRANSFERENCIA 
                                                                  and pr.volume = vr.volume ) as d
                     , vr.volume as r
                from volumespedidosremessas vr
                where vr.idcompratransferencia = :P110_IDCOMPRATRANSFERENCIA
                and vr.volume != :P110_VOLUMEORIGEM
                ```
            nullDisplayValue: - Selecione o Volume -
        }
        cascadingLov {
            parentItems: P110_VOLUMEORIGEM
        }
        layout {
            sequence: 30
            region: @alterar-volume-do-pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P110_VOLUMEORIGEM (
        type: selectList
        label {
            label: Volume Origem
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Volume: '||vr.volume ||' - Pedidos: '|| ( select count(1)
                                                                  from pedidosremessasct pr
                                                                  where idcompratransferencia = :P110_IDCOMPRATRANSFERENCIA 
                                                                  and pr.volume = vr.volume ) as d
                     , vr.volume as r
                from volumespedidosremessas vr
                where vr.idcompratransferencia = :P110_IDCOMPRATRANSFERENCIA
                and vr.volume in ( select pr.volume 
                                   from pedidosremessasct pr
                                   where :P110_IDPEDIDO is null or pr.idpedido = :P110_IDPEDIDO )
                ```
            nullDisplayValue: - Selecione o Volume -
        }
        cascadingLov {
            parentItems: P110_IDPEDIDO
        }
        layout {
            sequence: 20
            region: @alterar-volume-do-pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button adicionar-volume (
        buttonName: ADICIONAR_VOLUME
        label: Adicionar Volume Extra
        layout {
            sequence: 20
            region: @volumes-da-remessa-de-pedidos
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button alterarvolume (
        buttonName: ALTERARVOLUME
        label: Alterar Volume
        layout {
            sequence: 10
            region: @alterar-volume-do-pedido
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar e Fechar
        layout {
            sequence: 10
            region: @volumes-da-remessa-de-pedidos
            slot: belowBox
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation valida-peso-informado (
        name: Valida Peso informado
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from volumespedidosremessas v
                where v.peso is null
                  and v.idcompratransferencia = :P110_IDCOMPRATRANSFERENCIA
                ```
        }
        error {
            errorMessage: Por favor, informe o peso dos volumes!
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
            type: never
        }
    )

    validation volume-destino-obrigatório (
        name: Volume Destino Obrigatório
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P110_VOLUMEDESTINO
        }
        error {
            errorMessage: Volume Destino deve ser informado.
            associatedItem: @P110_VOLUMEDESTINO
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') = 'ALTERARVOLUME'
                ```
        }
    )

    validation volume-origem-obrigatório (
        name: Volume Origem Obrigatório
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P110_VOLUMEORIGEM
        }
        error {
            errorMessage: Volume Origem deve ser informado.
            associatedItem: @P110_VOLUMEORIGEM
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') = 'ALTERARVOLUME'
                ```
        }
    )

    process adiciona-volume-extra (
        name: Adiciona Volume Extra
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_comprastransf_fav.prc_adicionavolumeextra(pidcompratransferencia => :P110_IDCOMPRATRANSFERENCIA,
                                                                pidusuario => :P0_IDUSUARIO);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Volume Extra adicionado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 201969530731022118
        }
        serverSideCondition {
            whenButtonPressed: @adicionar-volume
        }
    )

    process atualiza-pedido-de-compra (
        name: Atualiza Pedido de compra
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                   PCK_COMPRASTRANSF_FAV.prc_atualizapesovolume ( pidcompratransferencia => :P110_IDCOMPRATRANSFERENCIA );
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Processo atualizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 28485925054952738
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

    process atualizar-volume-do-pedido (
        name: Atualizar Volume do Pedido
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  update pedidosremessasct
                  set volume = :P110_VOLUMEDESTINO
                  where idcompratransferencia = :P110_IDCOMPRATRANSFERENCIA
                  and :P110_IDPEDIDO is null or idpedido = :P110_IDPEDIDO
                  and volume = :P110_VOLUMEORIGEM;
                  --
                  delete 
                  from volumespedidosremessas vr
                  where vr.idcompratransferencia = :P110_IDCOMPRATRANSFERENCIA
                  and vr.volume = :P110_VOLUMEORIGEM
                  and exists ( select count(1)
                               from pedidosremessasct pr
                               where pr.idcompratransferencia = :P110_IDCOMPRATRANSFERENCIA 
                               and pr.volume = vr.volume
                               having count(1) = 0 );
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Volume do pedido atualizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1430380422960068515
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') = 'ALTERARVOLUME'
                ```
        }
    )

    process verifica-volumes (
        name: Verifica Volumes
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_comprastransf_fav.prc_verificavolumesremessas(pidcompratransferencia => :P110_IDCOMPRATRANSFERENCIA);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 30416235388112028
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where not exists ( select 1
                                   from volumespedidosremessas v
                                   where v.idcompratransferencia = :P110_IDCOMPRATRANSFERENCIA )
                ```
        }
    )

    process volumes-da-remessa-de-pedidos-save-interactive-grid-data (
        name: Volumes da Remessa de Pedidos - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @volumes-da-remessa-de-pedidos
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 28485510170952734
        }
    )

    branch (
        name: Atualiza processo 74
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 74
                items: {
                    P74_IDCOMPRATRANSFERENCIA: &P110_IDCOMPRATRANSFERENCIA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
            type: item=value
            item: P110_TELAORIGEM
            value: 74
        }
    )

    branch (
        name: go to apge 110
        execution {
            sequence: 30
        }
        behavior {
            target: {
                page: 110
                items: {
                    P110_IDCOMPRATRANSFERENCIA: &P110_IDCOMPRATRANSFERENCIA.
                    P110_IDFILIALFAVORITAORIGEM: &P110_IDFILIALFAVORITAORIGEM.
                    P110_VOLUMEORIGEM:
                    P110_VOLUMEDESTINO:
                }
                clearCache: 110
                action: resetPagination
            }
        }
    )

    branch (
        name: Atualiza processo 465
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 465
                items: {
                    P465_IDCOMPRATRANSFERENCIA: &P110_IDCOMPRATRANSFERENCIA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
            type: item=value
            item: P110_TELAORIGEM
            value: 465
        }
    )

)

