page 395 (
    name: Gerar Tarefas de Pedidos Vencidos
    title: Gerar Tarefas de Pedidos Vencidos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region marcar-atendente (
        name: Marcar Atendente
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pedidos-vencidos (
        name: Pedidos Vencidos
        type: tabform
        source {
            sqlQuery:
                ```sql
                /*select p.idpedido
                     , roman.pck_romance.fnc_nomefilial(p.idfilialromance) filialromance 
                     , roman.pck_romance.fnc_nomerepresentante(p.idrepresentante) representante
                     , roman.pck_romance.fnc_nomevendedora(p.idvendedora) vendedora
                     , ( select nvl(pp.documentoestrangeiro,pp.cpf)
                         from pessoas pp
                         where pp.idpessoa = v.idpessoa ) cpf
                     , p.dataemissao
                     , p.dataentrega
                     , p.valortotal
                     , p.valorapagar
                     , ( select sum(vp.valorpago)
                         from vencimentospedidos vp
                         where vp.idpedido = p.idpedido
                           and vp.situacaovencimento = 'V' ) valorpago
                     , v.idpessoa
                     , p.idvendedora
                     , roman.pck_romance.fnc_retornatelefones(p.idvendedora) telefones
                     , ( select max(t.datainclusao)
                         from tarefas t
                         where ( t.idtipotarefa = 21
                               or t.idtipotarefa = 59
                               or t.idtipotarefa = 60 )
                           and t.idpessoa = v.idpessoa ) ultima_tarefa
                from pedidos p
                   , vendedoras v
                where ( :P395_IDFILIALROMANCE = -1 or p.idfilialromance = :P395_IDFILIALROMANCE )
                  and p.idvendedora = v.idvendedora  
                  and p.datacancelamento is null
                  and ( :P395_SITUACAO_TAREFA is null
                     or ( :P395_SITUACAO_TAREFA = 'S' and exists ( select 1
                                                                   from tarefas t
                                                                   where ( t.idtipotarefa = 21
                                                                        or t.idtipotarefa = 59
                                                                        or t.idtipotarefa = 60 )
                                                                     and t.datainclusao < (sysdate)-30
                                                                     and t.idpessoa = v.idpessoa )
                                                      and not exists ( select 1
                                                                       from tarefas t
                                                                       where t.idtipotarefa in (21,59,60)
                                                                         and t.datainclusao > (sysdate - 30)
                                                                         and t.idpessoa = v.idpessoa ) )
                     or ( :P395_SITUACAO_TAREFA = 'N' and not exists ( select 1
                                                                       from tarefas t
                                                                       where t.idtipotarefa in (21,59,60)
                                                                         and t.idpedido = p.idpedido
                                                                         and t.idpessoa = v.idpessoa ) ) )
                  and exists ( select 1
                               from vencimentospedidos vc
                               where vc.idpedido = p.idpedido
                                 and vc.situacaovencimento = 'V'
                                 and vc.valorpagar > 0 
                                 and vc.valorpago < vc.valorpagar
                                 and trunc(vc.datavencimento) between to_date(:P395_DATAINICIO) and to_date(:P395_DATAFIM) )
                  and :P395_DATAINICIO is not null
                  and :P395_DATAFIM is not null */
                
                -- new
                select p.idpedido
                     , roman.pck_romance.fnc_nomefilial(p.idfilialromance) filialromance 
                     , roman.pck_romance.fnc_nomerepresentante(p.idrepresentante) representante
                     , roman.pck_romance.fnc_nomevendedora(p.idvendedora) vendedora
                     , ( select nvl(pp.documentoestrangeiro,pp.cpf)
                         from pessoas pp
                         where pp.idpessoa = v.idpessoa ) cpf
                     , p.dataemissao
                     , p.dataentrega
                     , p.valortotal
                     , p.valorapagar
                     , ( select sum(vp.valorpago)
                         from vencimentospedidos vp
                         where vp.idpedido = p.idpedido
                           and vp.situacaovencimento = 'V' ) valorpago
                     , v.idpessoa
                     , p.idvendedora
                     , roman.pck_romance.fnc_retornatelefones(p.idvendedora) telefones
                     , ( select max(t.datainclusao)
                         from tarefas t
                         where ( t.idtipotarefa = 21
                               or t.idtipotarefa = 59
                               or t.idtipotarefa = 60 )
                           and t.idpessoa = v.idpessoa ) ultima_tarefa
                     , vc.datavencimento
                     , trunc(sysdate) - trunc(( select min(vc2.datavencimento)
                                                  from vencimentospedidos vc2
                                                  where vc2.idpedido = p.idpedido
                                                    and vc2.situacaovencimento = 'V'
                                                    and vc2.valorpagar > 0
                                                    and vc2.valorpago < vc2.valorpagar )) dias_vencido --15824321
                from pedidos p
                   , vendedoras v
                   , vencimentospedidos vc
                where ( :P395_IDFILIALROMANCE = -1 or p.idfilialromance = :P395_IDFILIALROMANCE )
                  and p.idvendedora = v.idvendedora  
                  and p.datacancelamento is null
                  and vc.idpedido = p.idpedido
                  and vc.situacaovencimento = 'V'
                  and vc.valorpagar > 0
                  and vc.valorpago < vc.valorpagar
                  and trunc(vc.datavencimento) between to_date(:P395_DATAINICIO) and to_date(:P395_DATAFIM)
                  and ( :P395_SITUACAO_TAREFA is null
                     or ( :P395_SITUACAO_TAREFA = 'S' and exists ( select 1
                                                                   from tarefas t
                                                                   where ( t.idtipotarefa = 21
                                                                        or t.idtipotarefa = 59
                                                                        or t.idtipotarefa = 60 )
                                                                     and t.datainclusao < (sysdate)-30
                                                                     and t.idpessoa = v.idpessoa )
                                                      and not exists ( select 1
                                                                       from tarefas t
                                                                       where t.idtipotarefa in (21,59,60)
                                                                         and t.datainclusao > (sysdate - 30)
                                                                         and t.idpessoa = v.idpessoa ) )
                     or ( :P395_SITUACAO_TAREFA = 'N' and not exists ( select 1
                                                                       from tarefas t
                                                                       where t.idtipotarefa in (21,59,60)
                                                                         and t.idpedido = p.idpedido
                                                                         and t.idpessoa = v.idpessoa ) ) )
                  and :P395_DATAINICIO is not null
                  and :P395_DATAFIM is not null
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        messages {
            whenNoDataFound: Nenhum pedido localizado ou todos os pedidos já possuem tarefas.
        }
        download {
            csvExportEnabled: true
        }

