    pageItem P395_IDFILIALROMANCE (
        type: selectList
        label {
            label: Empresa Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from roman.vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                ```
            nullDisplayValue: - Todas -
            nullReturnValue: -1
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P395_IDUSUARIO (
        type: selectList
        label {
            label: Atendente
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomepessoa(u.idpessoa) nome
                     , idusuario id
                from usuarios u
                where u.idgerente = 80
                  and u.ativo     = 'S'
                  and u.idusuario != 241
                order by 1
                ```
            nullDisplayValue: - Para Todas -
        }
        layout {
            sequence: 10
            region: @marcar-atendente
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P395_SITUACAO_TAREFA (
        type: radioGroup
        label {
            label: Tarefa Gerada
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    button buscar (
        buttonName: BUSCAR
        label: Buscar
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button gerar-tarefas (
        buttonName: GERAR_TAREFAS
        label: Gerar Tarefas
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P395_DATAINICIO is not null
                  and :P395_DATAFIM is not null
                ```
        }
    )

    process gera-tarefas (
        name: Gera Tarefas
        type: executeCode
        editableRegion: @pedidos-vencidos
        source {
            plsqlCode:
                ```plsql
                declare
                  vidpessoa number;
                  vexiste varchar2(1);
                  vtelefone varchar2(30);
                  vcodigoarea number;
                  vidusuario number;
                  vspc varchar2(1);
                  vidpais number;
                  --
                  vidtipotarefa number;
                  vidgrupo      number;
                  --
                begin
                  --
                  vidpessoa := :IDPESSOA;
                  --
                  select ididioma
                  into vidpais
                  from roman.vw_filiais f
                  where f.idfilial = :P395_IDFILIALROMANCE;
                  --
                  if :P395_IDUSUARIO is null then
                    --
                    vidusuario := null;
                    --
                  else
                    --
                    vidusuario := :P395_IDUSUARIO;
                    --
                  end if;
                  --
                  begin
                    --
                    select translate(t.telefone,'0123456789AaBbCcDdEeFfGgHhIiJjKkLlMmNnOoPpQqRrSsTtUuVvXxYyWwZz_-,.  Ññ~ !@#$%?&*()/??','0123456789') telefone
                    into vtelefone
                    from telefonespessoas t
                    where t.idpessoa = vidpessoa
                      and rownum = 1
                    order by ultimaatualizacao;
                    --
                  exception 
                    when NO_DATA_FOUND then
                      vtelefone := null;
                  end;
                  --
                  if vtelefone is not null and vidpais = 1 then
                    --
                    select to_number(substr(replace(vtelefone,' ',''),0,2))
                    into vcodigoarea
                    from dual;
                    --
                  end if;
                  --
                  if vidpais = 1 then
                    --
                    vidtipotarefa := 21;
                    vidgrupo      := 3;
                    --
                  elsif vidpais = 2 then
                    --
                    vidtipotarefa := 59;
                    vidgrupo      := 55;
                    vcodigoarea   := 598;
                    --
                  elsif vidpais = 4 then
                    --
                    vidtipotarefa := 60;
                    vidgrupo      := 54;
                    vcodigoarea   := 595;
                
                    --
                  end if;
                  --
                  begin
                    --
                    select 'S'
                    into vexiste
                    from tarefas t
                    where t.idpessoa = vidpessoa
                      and t.idtipotarefa = vidtipotarefa
                      and t.idsituacao in (0,10,20);
                  exception 
                    when others then
                      vexiste := 'N';
                  end;
                  --
                  if vexiste = 'N' then
                    --
                    if vtelefone is not null then
                      --
                      insert into tarefas ( idtarefa            , datainclusao    , idsituacao
                                          , observacao          , idtipotarefa    , idpessoa
                                          , idgrupoatendimento  , telefone        , codigoarea 
                                          , idusuario           , idpedido )
                      values ( seq_idtarefa.nextval,   sysdate,  0
                             , roman.pck_romance.fnc_retornatelefones(:IDVENDEDORA) , vidtipotarefa  , vidpessoa
                             , vidgrupo , vtelefone , vcodigoarea
                             , vidusuario , :IDPEDIDO ); 
                      --
                    end if;
                    --
                  end if;
                  --
                exception
                  when others then
                    null;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Tarefas Geradas com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1557983060129524914
        }
        serverSideCondition {
            type: request=Value
            value: GERAR_TAREFAS
        }
    )

    branch (
        name: Go To Page 395
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 395
                items: {
                    P395_IDUSUARIO: &P395_IDUSUARIO.
                    P395_IDFILIALROMANCE: &P395_IDFILIALROMANCE.
                    P395_SITUACAO_TAREFA: &P395_SITUACAO_TAREFA.
                    P395_DATAINICIO: &P395_DATAINICIO.
                    P395_DATAFIM: &P395_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

)

