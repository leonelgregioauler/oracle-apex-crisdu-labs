page 635 (
    name: Nova Entrada
    title: Nova Entrada
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 80%
        resizable: false
