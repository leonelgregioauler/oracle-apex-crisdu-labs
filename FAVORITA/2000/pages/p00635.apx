    button anexos (
        buttonName: ANEXOS
        label: Anexar Documentos
        layout {
            sequence: 10
            region: @nova-entrada
            slot: belowBox
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 636
                items: {
                    P636_IDENTRADA: &P635_IDENTRADA.
                    P636_IDANEXOENTRADA:
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P635_IDENTRADA
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 244
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P635_ROWID
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
            databaseAction: delete
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentossemanais f
                where nvl(f.concluido,'N') = 'N'
                  and f.idfechamento = :P0_IDFECHAMENTO
                  and :P635_IDENTRADA is not null 
                  and pck_util.fnc_verificaacesso(2732,v('APP_USER')) = 'S'
                ```
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentossemanais
                where idfechamento = :P635_IDFECHAMENTO
                  and concluido = 'N'
                  and :P635_IDENTRADA is not null
                ```
        }
    )

    dynamicAction verifica-anexos (
        name: Verifica Anexos
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @delete
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      --
                      v_verifica number := 0;
                      --
                    begin
                      --
                      select count(*)
                        into v_verifica
                        from roman.anexosentradas a
                       where a.identrada = :P635_identrada;
                      --
                      if v_verifica > 0 then
                        --
                        raise_application_error(-20001, 'Primeiro delete os Anexos!');
                        --
                      end if;
                      --
                    end;
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: DELETE
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    validation valida-matriz (
        name: Valida Matriz
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P635_IDMATRIZENTRADA
        }
        error {
            errorMessage: Por favor, informe a classificação para esta entrada!
            associatedItem: @P635_IDMATRIZENTRADA
        }
    )

    process fetch-row-from-entradasdiversas (
        name: Fetch Row from ENTRADASDIVERSAS
        type: autoRowFetch
        source {
            tableOwner: ROMAN
            tableName: ENTRADASDIVERSAS
            pkColumn: IDENTRADA
            pkItem: P635_IDENTRADA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 2435564688992136655
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  if :P635_IDENTRADA is null then
                    --
                    select roman.seq_identradasdiversas.nextval
                      into :P635_IDENTRADA
                      from dual;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 2435829091592115001
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-entradasdiversas (
        name: Process Row of ENTRADASDIVERSAS
        type: autoRowProcessing
        target {
            tableOwner: ROMAN
            tableName: ENTRADASDIVERSAS
            pkColumn: ROWID
            pkItem: P635_ROWID
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 2435565047023136655
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 2435565445226136655
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

