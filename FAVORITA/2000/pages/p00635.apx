    pageItem P635_IDCONTACONTABIL (
        type: selectList
        label {
            label: Conta
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(c.nomeconta) display_value
                     , c.idcontafinan  return_value
                from roman.contasfinanceiras c
                where exists ( select 1
                               from roman.matrizclassificacoesentradas m
                               where m.idmatrizentrada = :P635_IDMATRIZENTRADA
                                 and m.idcontafinan          = c.idcontafinan )
                ```
        }
        cascadingLov {
            parentItems: P635_IDMATRIZENTRADA
        }
        layout {
            sequence: 20
            region: @nova-entrada
            slot: regionBody
            alignment: left
        }
        appearance {
