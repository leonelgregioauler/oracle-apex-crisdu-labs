page 535 (
    name: Pre-Transferencias
    title: Pre-Transferencias
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pré-transferências (
        name: Pré-Transferências
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.*
                  from pretransferencias p
                 where (:P535_IDFILIALFAVORIGEM  = -1 OR p.idfilialfavoritaorigem  = :P535_IDFILIALFAVORIGEM)
                   and (:P535_IDFILIALFAVDESTINO = -1 OR p.idfilialfavoritadestino = :P535_IDFILIALFAVDESTINO)
                   and (:P535_DATAINICIAL IS NULL OR p.data between to_date(:P535_DATAINICIAL ||' 00:00:01','dd/mm/rrrr hh24:mi:ss')
                                                                and to_date(:P535_DATAFINAL   ||' 23:59:59','dd/mm/rrrr hh24:mi:ss') )
                   and :P535_FILTRO is not null
                 order by p.idpretransferencia desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 22675948100453024
        }

        column DATA (
            type: plainText
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: B
            }
        )

        column DATAFIM (
            type: hidden
            heading {
                heading: Datafim
            }
            layout {
                sequence: 80
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: H
            }
            security {
                escapeSpecialChars: false
            }
        )

        column DATAINICIO (
            type: hidden
            heading {
                heading: Datainicio
            }
            layout {
                sequence: 70
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: G
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDCOMPRATRANSFERENCIA (
            type: hidden
            heading {
                heading: Idcompratransferencia
            }
            layout {
                sequence: 60
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDFILIALFAVORITADESTINO (
            type: plainTextBasedOnLov
            heading {
                heading: Favorita Destino
            }
            lov {
                lov: @lov-filiaisfavorita
            }
            layout {
                sequence: 50
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column IDFILIALFAVORITAORIGEM (
            type: plainTextBasedOnLov
            heading {
                heading: Favorita Origem
            }
            lov {
                lov: @lov-filiaisfavorita
            }
            layout {
                sequence: 40
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column IDPRETRANSFERENCIA (
            type: link
            heading {
                heading: Editar
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 377
                    items: {
                        P377_IDPRETRANSFERENCIA: #IDPRETRANSFERENCIA#
                        P377_TEMPO_REPOSICAO: #TEMPOREPOSICAO#
                        P377_VOLTAR: 535
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil-alt.png" class="apex-edit-pencil-alt" alt="">
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column IDUSUARIO (
            type: plainTextBasedOnLov
            heading {
                heading: Usuário
            }
            lov {
                lov: @lov-usuarios
            }
            layout {
                sequence: 30
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        column TEMPOREPOSICAO (
            type: plainText
            heading {
                heading: T.Reposição
            }
            layout {
                sequence: 90
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: I
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 227894 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATA (
                sequence: 2
            )

            displayColumn DATAFIM (
                sequence: 8
            )

            displayColumn DATAINICIO (
                sequence: 7
            )

            displayColumn IDCOMPRATRANSFERENCIA (
                sequence: 6
            )

            displayColumn IDFILIALFAVORITADESTINO (
                sequence: 5
            )

            displayColumn IDFILIALFAVORITAORIGEM (
                sequence: 4
            )

            displayColumn IDPRETRANSFERENCIA (
                sequence: 1
            )

            displayColumn IDUSUARIO (
                sequence: 3
            )

            displayColumn TEMPOREPOSICAO (
                sequence: 9
            )

        )

    )

    pageItem P535_DATAFINAL (
        type: datePickerJquery
        label {
            label: Data Final
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: dd/mm/rrrr
            width: 15
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P535_DATAINICIAL (
        type: datePickerJquery
        label {
            label: Data Inicial
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: dd/mm/rrrr
            width: 15
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P535_FILTRO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P535_IDFILIALFAVDESTINO (
        type: selectList
        label {
            label: Favorita Destino
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nomefilialfavorita
                     , f.idfilialfavorita
                from filiaisfavorita f
                where f.tipofilial = 'L'
                  and f.ativo      = 'S'
                order by f.idfilialfavorita
                ```
            nullDisplayValue: - Todas Lojas -
            nullReturnValue: -1
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: static
            staticValue: -1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P535_IDFILIALFAVORIGEM (
        type: selectList
        label {
            label: Favorita Origem
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nomefilialfavorita
                     , f.idfilialfavorita
                from filiaisfavorita f
                where f.ativo      = 'S'
                  --and f.tipofilial = 'L'
                order by f.idfilialfavorita
                ```
            nullDisplayValue: - Todas Lojas -
            nullReturnValue: -1
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: static
            staticValue: -1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction limpa (
        name: Limpa
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: null
            }
            affectedElements {
                selectionType: items
                items: P535_FILTRO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction pesquisar (
        name: Pesquisar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action native-set-value (
            action: setValue
            settings {
                value: 1
            }
            affectedElements {
                selectionType: items
                items: P535_FILTRO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

)

