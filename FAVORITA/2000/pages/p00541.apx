page 541 (
    name: Pagamentos de Pedidos - VPD
    title: Pagamentos de Pedidos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pagamentos-de-pedidos (
        name: Pagamentos de Pedidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select V.*
                     , case
                         when v.idsituacao = 20 and v.confirmabaixavirtualage is null and v.idpedidovirtualage is not null then
                           '<a href="javascript:apex.confirm(''Confirmar baixa de pagamento do pedido '||v.idpedido||' no Virtual Age ? '', 
                             { request:''CONFIRMARBAIXA'', set:{''P187_IDPAGAMENTOPEDIDO'':'||v.idpagamentopedido||' }} )";><img src="#APP_IMAGES#ok.png"  border="0"></a>'
                         when v.idsituacao != 20 and v.confirmabaixavirtualage is null then
                           null
                         when v.confirmabaixavirtualage is not null then 
                           'Baixado'
                       end confirmarbaixa
                     , (select idvalorcaracteristica
                          from classificacoespedidos
                         where idclassificacaopedido = (select max(idclassificacaopedido)
                                                          from classificacoespedidos
                                                         where idcaracteristicapedido = 91
                                                           and idpedido = V.IDPEDIDO) ) nota_fiscal
                  from VWFA_APP2000_P541_REL001 V
                 where :P541_FILTRAR = 'S'
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhum Pagamento Localizado
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            savePublicReport: true
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 5181630060090047625
        }

