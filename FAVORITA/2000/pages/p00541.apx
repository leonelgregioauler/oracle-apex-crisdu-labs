                identifier: C01
                source {
                    expression:
                        ```sql
                        CASE 
                          WHEN E IS NOT NULL THEN round(  E -  O ) END
                        ```
                    dataType: number
                }
                label {
                    column: Dias para o Pagamento
                }
            )

            aggregate (
                column: VALORPAGO
            )

            aggregate (
                column: VALORLIQUIDO
            )

            filter ir-condition (
