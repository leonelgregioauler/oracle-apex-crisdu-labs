    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 210
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-filter
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction desabilitar-conta (
        name: Desabilitar Conta
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P541_FORMAPAGAMENTO
        }
        clientSideCondition {
            type: item!=value
            item: P541_FORMAPAGAMENTO
            value: 3
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P541_OPERADORACARTAO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction habilitar-conta (
        name: Habilitar Conta
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P541_FORMAPAGAMENTO
        }
        clientSideCondition {
            type: item=value
            item: P541_FORMAPAGAMENTO
            value: 3
        }

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P541_OPERADORACARTAO
            }
            execution {
                sequence: 10
            }
        )

    )

    process confirmar-baixa (
        name: Confirmar Baixa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                update pagamentospedidos
                set confirmabaixavirtualage = 'S'
                where idpagamentopedido = :P541_IDPAGAMENTOPEDIDO;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 780343280692791839
        }
    )

    branch (
        name: Go To Page 541
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 541
                items: {
                    P541_TIPODATA: &P541_TIPODATA.
                    P541_DATAINICIO: &P541_DATAINICIO.
                    P541_DATAFIM: &P541_DATAFIM.
                    P541_IDFILIALROMANCE: &P541_IDFILIALROMANCE.
                    P541_FORMAPAGAMENTO: &P541_FORMAPAGAMENTO.
                    P541_NUMEROBOLETO: &P541_NUMEROBOLETO.
                    P541_IDFILIALFAVORITA: &P541_IDFILIALFAVORITA.
                    P541_ORIGEM: &P541_ORIGEM.
                    P541_DISTRIBUIDOR: &P541_DISTRIBUIDOR.
                    P541_CONSULTORA: &P541_CONSULTORA.
                    P541_IDUSUARIO: &P541_IDUSUARIO.
                    P541_NRCOMPROVANTE: &P541_NRCOMPROVANTE.
                    P541_IDPEDIDO: &P541_IDPEDIDO.
                    P541_ORIGEMPEDIDO: &P541_ORIGEMPEDIDO.
                    P541_FILTRAR: S
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

