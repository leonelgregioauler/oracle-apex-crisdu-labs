page 517 (
    name: Configurar Empresas que os pedidos serão integrados
    title: Configurar Empresas que os pedidos serão integrados
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region configurar-empresas-que-os-pedidos-serão-integrados (
        name: Configurar Empresas que os pedidos serão integrados
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.idromancevirtualage
                     , r.idfilialromance
                     , r.idempresavirtualage
                     , r.idpostoavancado
                     , r.idformaentrega
                from romancevirtualage r
                where (:P517_IDFILIALROMANCE = 0 or :P517_IDFILIALROMANCE = r.idfilialromance)
                  and (:P517_IDEMPRESAVIRTUALAGE = 0 or :P517_IDEMPRESAVIRTUALAGE = r.idempresavirtualage)
                  and (:P517_IDPOSTOAVANCADO = 0 or :P517_IDPOSTOAVANCADO = r.idpostoavancado)
                  and (:P517_IDFORMAENTREGA = 0 or :P517_IDFORMAENTREGA = r.idformaentrega)
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 3567907202740419
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDROMANCEVIRTUALAGE
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDFILIALROMANCE
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDEMPRESAVIRTUALAGE
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @IDPOSTOAVANCADO
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDFORMAENTREGA
                layout {
                    sequence: 5
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column IDEMPRESAVIRTUALAGE (
            type: selectList
            heading {
                heading: "Empresa Virtual "
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select idempresavirtualage||' - '||e.nome d
                         , e.idempresavirtualage r
                    from favorita.empresasvirtualage e
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDEMPRESAVIRTUALAGE
                dataType: number
            }
        )

        column IDFILIALROMANCE (
            type: selectList
            heading {
                heading: Filial Romance
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select f.nome
                         , f.idfilial 
                    from roman.vw_filiais f
                    where f.tipofilial = 'D'
                      and f.ativo = 'S'
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDFILIALROMANCE
                dataType: number
            }
        )

        column IDFORMAENTREGA (
            type: selectList
            heading {
                heading: Forma Entrega
            }
            lov {
                type: sharedComponent
                lov: @lov-formasentregas
                displayExtraValues: false
                nullDisplayValue: " - Nenhuma -"
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: IDFORMAENTREGA
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDPOSTOAVANCADO (
            type: selectList
            heading {
                heading: Posto Avançado
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pp.nome
                         , pp.idpostoavancado
                    from roman.postoavancado pp
                    ```
                displayExtraValues: false
                nullDisplayValue: - Nenhum -
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: IDPOSTOAVANCADO
                dataType: number
            }
        )

        column IDROMANCEVIRTUALAGE (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDROMANCEVIRTUALAGE
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P517_FILIALROMANCENULL (
        type: hidden
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P517_IDEMPRESAVIRTUALAGE (
        type: selectList
        label {
            label: Empresa Virtual
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.nome
                     , e.idempresavirtualage
                from favorita.empresasvirtualage e
                union
                select '- Todas -'
                     , 0
                from dual;
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P517_IDFILIALROMANCE (
        type: selectList
        label {
            label: Filial Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from roman.vw_filiais f
                where f.tipofilial = 'D'
                  and f.ativo = 'S'
                union
                select '- Todas -'
                     , 0
                from dual;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P517_IDFORMAENTREGA (
        type: selectList
        label {
            label: Formas Entregas
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-formasentregas
            displayExtraValues: false
            nullDisplayValue: - Todas -
            nullReturnValue: 0
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P517_IDPOSTOAVANCADO (
        type: selectList
        label {
            label: Posto Avançado
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pp.nome
                     , pp.idpostoavancado
                from roman.postoavancado pp
                where ( :P517_IDFILIALROMANCE = 0 or :P517_IDFILIALROMANCE = pp.idfilial) 
                union
                select '- Todas -'
                     , 0
                from dual;
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P517_IDFILIALROMANCE
            itemsToSubmit: P517_IDPOSTOAVANCADO
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconRight
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process new-save-interactive-grid-data (
        name: New - Save Interactive Grid Data
        type: executeCode
        editableRegion: @configurar-empresas-que-os-pedidos-serão-integrados
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vexist number;
                  --
                  vmd5              varchar2(4000);
                  vmensagem         varchar2(4000);
                  --
                begin  
                     case :APEX$ROW_STATUS  
                       when 'C' then
                         --
                         favorita.pck_cadastros_fav.prc_romancevirtualage ( pidromancevirtualage => :idromancevirtualage
                                                                          , pidfilialromance     => :idfilialromance
                                                                          , pidempresavirtualage => :idempresavirtualage
                                                                          , pidpostoavancado     => :idpostoavancado
                                                                          , pidformaentrega      => :idformaentrega 
                                                                          , pmd5                 => vmd5
                                                                          , poperacao_dml        => 'I');
                         --
                       when 'U' then  
                         --
                         favorita.pck_cadastros_fav.prc_romancevirtualage ( pidromancevirtualage => :idromancevirtualage
                                                                          , pidfilialromance     => :idfilialromance
                                                                          , pidempresavirtualage => :idempresavirtualage
                                                                          , pidpostoavancado     => :idpostoavancado
                                                                          , pidformaentrega      => :idformaentrega 
                                                                          , pmd5                 => vmd5
                                                                          , poperacao_dml        => 'U');
                         --
                       when 'D' then  
                         --
                         favorita.pck_cadastros_fav.prc_romancevirtualage ( pidromancevirtualage => :idromancevirtualage
                                                                          , pidfilialromance     => :idfilialromance
                                                                          , pidempresavirtualage => :idempresavirtualage
                                                                          , pidpostoavancado     => :idpostoavancado
                                                                          , pidformaentrega      => :idformaentrega 
                                                                          , pmd5                 => vmd5
                                                                          , poperacao_dml        => 'D');
                         --
                       end case;  
                       --
                exception
                  when others then
                    --
                    APEX_ERROR.ADD_ERROR ( p_message          => 'Erro ao execultar processo'
                                         , p_additional_info  => DBMS_UTILITY.FORMAT_ERROR_BACKTRACE||' - '||sqlerrm
                                         , p_display_location => apex_error.c_on_error_page );
                    --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 3568601000740426
        }
    )

)

