page 493 (
    name: "Cadastro de Codigos de Barras "
    title: "Cadastro de Codigos de Barras "
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_remove_codean(pid_cod_barra) {
              apex.confirm("Deseja remover o codigo de barra ?", {
                request:"REMOVER_ITEM",
                set:{"P493_ID_ITEM_REMOVER":pid_cod_barra},
                showWait:true
                });  
            }
            
            function fnc_deleta_codean(pid_cod_barra) {
              apex.confirm("Deseja DELETAR o codigo de barra ?", {
                request:"DELETAR_ITEM",
                set:{"P493_ID_ITEM_DELETAR":pid_cod_barra},
                showWait:true
                });  
            }
            ```
    }
    css {
        inline:
            ```css
            a.vermelho:link, a.vermelho:visited, a.vermelho:hover, a.vermelho:active {
              text-decoration: none;
              color: #f00
              }
            
            a.azul:link, a.azul:visited, a.azul:hover, a.azul:active {
              text-decoration: none;
              color: #00F
              }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-novo-codigo (
        name: Cadastro novo codigo
        type: staticContent
        layout {
            sequence: 19
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region codigos-de-barra (
        name: Codigos de Barra
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.codean
                     , c.datacadastro
                     , favorita.pck_util_fav.fnc_nomeusuario(c.usuariocadastrou) Usuario
                     , '<a href="javascript:fnc_remove_codean('||c.idcodigobarra||');" class="azul"><span class="fa fa-remove fa-2x" aria-hidden="true"></span></a>' as del
                     , '<a href="javascript:fnc_deleta_codean('||c.idcodigobarra||');" class="vermelho"><span class="fa fa-remove fa-2x" aria-hidden="true"></span></a>' as del2
                from favorita.codigosbarras c
                where c.idprodutodetalhado = :P493_IDPRODUTODETALHADO;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 103054256718494919
        }

        column CODEAN (
            type: plainText
            heading {
                heading: Codean
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column DATACADASTRO (
            type: plainText
            heading {
                heading: Data Cadastro
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            appearance {
                formatMask: dd/mm/rrrr hh24:mi:ss
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: B
            }
        )

        column DEL (
            type: plainText
            heading {
                heading: Remover Cod. Barra
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
            security {
                escapeSpecialChars: false
            }
        )

        column DEL2 (
            type: plainText
            heading {
                heading: Deletar Cod. Barra
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
            security {
                escapeSpecialChars: false
            }
        )

        column USUARIO (
            type: plainText
            heading {
                heading: Usuario
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 1052851 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CODEAN (
                sequence: 1
            )

            displayColumn DATACADASTRO (
                sequence: 3
            )

            displayColumn DEL (
                sequence: 4
            )

            displayColumn DEL2 (
                sequence: 5
            )

            displayColumn USUARIO (
                sequence: 2
            )

        )

    )

    region produto-detalhado-sku (
        name: Produto Detalhado "SKU"
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P493_CODEAN_PRINCIPAL (
        type: textField
        label {
            label: Codean Principal
            alignment: left
        }
        layout {
            sequence: 50
            region: @produto-detalhado-sku
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select c.codean
                from favorita.codigosbarras c
                where c.idcodigobarra = ( select pd.idcodigobarra
                                               from favorita.produtosdetalhados pd
                                               where pd.idcodigobarra = c.idcodigobarra
                                                 and pd.idprodutodetalhado = :P493_IDPRODUTODETALHADO );
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P493_CODIGO_NOVO (
        type: textField
        label {
            label: Codigo novo
            alignment: left
        }
        layout {
            sequence: 20
            region: @cadastro-novo-codigo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 29
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P493_IDPRODUTODETALHADO (
        type: hidden
        layout {
            sequence: 70
            region: @produto-detalhado-sku
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P493_IDPROTUDO (
        type: hidden
        layout {
            sequence: 20
            region: @produto-detalhado-sku
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P493_ID_ITEM_DELETAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @produto-detalhado-sku
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P493_ID_ITEM_REMOVER (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @produto-detalhado-sku
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P493_NOME_PRODUTO_DETALHADO (
        type: textField
        label {
            label: Nome Produto Detalhado
            alignment: left
        }
        layout {
            sequence: 10
            region: @produto-detalhado-sku
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: expression
            plsqlExpression: favorita.pck_util_fav.fnc_nomeprodutodetalhado(:P493_IDPRODUTODETALHADO,1)
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P493_PAGINA (
        type: hidden
        layout {
            sequence: 60
            region: @produto-detalhado-sku
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button cadastrar-codigo (
        buttonName: CADASTRAR_CODIGO
        label: Cadastrar Código de Barra
        layout {
            sequence: 10
            region: @cadastro-novo-codigo
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button gerar-cod-barra (
        buttonName: GERAR_COD_BARRA
        label: Gerar Cód. Barra
        layout {
            sequence: 20
            region: @produto-detalhado-sku
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @produto-detalhado-sku
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation novo-codean-numerico (
        name: Novo Codean Numerico
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNumeric
            item: P493_CODIGO_NOVO
        }
        error {
            errorMessage: O Novo código somente pode conter números
        }
        serverSideCondition {
            type: request=Value
            value: CADASTRAR_CODIGO
        }
    )

    process deleta-cod-barra (
        name: Deleta Cod. Barra
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vmensagem            varchar2(4000);
                  vidprodutodetalahado number;
                  --
                begin
                
                  pck_cadastros_fav.prc_delcodbarrasfornecedor ( pidprodutodetalhado => vidprodutodetalahado
                                                               , pidcodigobarra      => :P493_ID_ITEM_DELETAR
                                                               , msgerro             => vmensagem );
                  --
                  if vmensagem = 'Sucesso' then
                    --
                    apex_application.g_print_success_message := 'Codigo de barras APAGADO com sucesso';
                    --
                  else
                    --
                    apex_error.add_error(p_message          => vmensagem,
                                         p_display_location => apex_error.c_inline_with_field_and_notif);
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 107948971439913932
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR_ITEM
        }
    )

    process gerar-codigo-barra (
        name: Gerar Codigo Barra
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vcodigoean number;
                  vidcodigobarra number;
                  vidusuario number;
                  vmensagem varchar2(4000);
                begin
                  --
                  select u.idusuario
                  into vidusuario
                  from usuarios u
                  where u.usuario = v('APP_USER');
                  --
                  pck_cadastros_fav.prc_codigosbarras_produtdet( pidprodutodetalhado => :P493_IDPRODUTODETALHADO
                                                               , pidcodigobarra      => vidcodigobarra
                                                               , pcodigoean          => vcodigoean
                                                               , pidusuario          => vidusuario
                                                               , poperacao_dml       => 'I'
                                                               , msgerro             => vmensagem);
                  --
                  if vmensagem = 'Sucesso' then
                    --
                    apex_application.g_print_success_message := 'Codigo de barras gerado com sucesso';
                    --
                  else
                    --
                    apex_error.add_error(p_message          => 'Erro ao gerar o codigo de barras - '||vmensagem,
                                         p_display_location => apex_error.c_inline_with_field_and_notif);
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 103055752127494934
        }
        serverSideCondition {
            type: request=Value
            value: GERAR_COD_BARRA
        }
    )

    process novo-codigo-barra (
        name: Novo Codigo Barra
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vcodigoean number;
                  vidcodigobarra number;
                  vidusuario number;
                  vmensagem varchar2(4000);
                begin
                  --
                  select u.idusuario
                  into vidusuario
                  from usuarios u
                  where u.usuario = v('APP_USER');
                  --
                  pck_cadastros_fav.prc_codigosbarras_produtdet( pidprodutodetalhado => :P493_IDPRODUTODETALHADO
                                                               , pidcodigobarra      => vidcodigobarra
                                                               , pcodigoean          => :P493_CODIGO_NOVO
                                                               , pidusuario          => vidusuario
                                                               , poperacao_dml       => 'I'
                                                               , msgerro             => vmensagem);
                  --
                  if vmensagem = 'Sucesso' then
                    --
                    apex_application.g_print_success_message := 'Codigo de barras cadastrado com sucesso';
                    --
                  else
                    --
                    apex_error.add_error(p_message          => 'Erro ao cadastrar o codigo de barras - '||vmensagem,
                                         p_display_location => apex_error.c_inline_with_field_and_notif);
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 103056335845494940
        }
        serverSideCondition {
            type: request=Value
            value: CADASTRAR_CODIGO
        }
    )

    process retira-cod-barra (
        name: Retira Cod. Barra
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vcodigoean           number;
                  vidusuario           number;
                  vmensagem            varchar2(4000);
                  vidprodutodetalahado number;
                begin
                  --
                  select u.idusuario
                  into vidusuario
                  from usuarios u
                  where u.usuario = v('APP_USER');
                  --
                  pck_cadastros_fav.prc_codigosbarras_produtdet( pidprodutodetalhado => vidprodutodetalahado
                                                               , pidcodigobarra      => :P493_ID_ITEM_REMOVER
                                                               , pcodigoean          => vcodigoean
                                                               , pidusuario          => vidusuario
                                                               , poperacao_dml       => 'D'
                                                               , msgerro             => vmensagem);
                  --
                  if vmensagem = 'Sucesso' then
                    --
                    apex_application.g_print_success_message := 'Codigo de barras desvinculado com sucesso';
                    --
                  else
                    --
                    apex_error.add_error(p_message          => 'Erro ao desvincular o codigo de barras - '||vmensagem,
                                         p_display_location => apex_error.c_inline_with_field_and_notif);
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 103055559172494932
        }
        serverSideCondition {
            type: request=Value
            value: REMOVER_ITEM
        }
    )

    branch (
        name: Go To Page 5
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 5
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @voltar
            type: item=value
            item: P493_PAGINA
            value: 6
        }
    )

    branch (
        name: Go To Page 188
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 188
                items: {
                    P188_IDPRODUTO: &P493_IDPROTUDO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @voltar
            type: item=value
            item: P493_PAGINA
            value: 188
        }
    )

)

