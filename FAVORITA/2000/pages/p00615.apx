page 615 (
    name: Pedidos com Cupom Desconto
    title: Pedidos com Cupom Desconto
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pedidos-com-cupom-de-desconto (
        name: Pedidos Com Cupom de Desconto
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpedido
                     , p.numeropedido
                     , trunc(p.dataemissao) dataemissaopedido
                     , p.valortotalcomdesconto
                     , vw.valordesconto
                     , p.valorapagar
                     , vw.nome_cupom_desconto||' ('||vw.codigo||')' cupom
                     , pck_util_fav.fnc_nomefilialfavorita(p.idfilialfavorita) canal_vendas
                  from pedidos p
                     , vw_codigoscuponsdescontos_fav vw
                 where p.idpedido = vw.idpedido
                   and (:P615_DATAINICIAL is null or trunc(p.dataemissao) between to_date(:P615_DATAINICIAL,'dd/mm/yyyy') and to_date(:P615_DATAFINAL,'dd/mm/yyyy'))
                   and (:P615_TIPO_DESCONTO is null or vw.tipodesconto = :P615_TIPO_DESCONTO)
                   and p.tipopedido = 'P' -- P: Pedidos / T: Trocas
                   and p.datacancelamento is null
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 1517197301913371968
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @NUMEROPEDIDO
                layout {
                    width: 100
                    sequence: 1
                }
            )

            displayColumn (
                column: @DATAEMISSAOPEDIDO
                layout {
                    width: 132
                    sequence: 2
                }
            )

            displayColumn (
                column: @CANAL_VENDAS
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @VALORTOTALCOMDESCONTO
                layout {
                    width: 103
                    sequence: 4
                }
            )

            displayColumn (
                column: @VALORDESCONTO
                layout {
                    width: 113
                    sequence: 5
                }
            )

            displayColumn (
                column: @VALORAPAGAR
                layout {
                    width: 177
                    sequence: 6
                }
            )

            displayColumn (
                column: @CUPOM
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @IDPEDIDO
                layout {
                    width: 74
                    sequence: 0
                }
            )

            sort (
                column: @DATAEMISSAOPEDIDO
                sort {
                    direction: desc
                    nulls: last
                    sequence: 1
                }
            )

        )

        column CANAL_VENDAS (
            type: numberField
            heading {
                heading: Canal Vendas
            }
            settings {
                virtualKeyboard: text
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: CANAL_VENDAS
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
        )

        column CUPOM (
            type: textarea
            heading {
                heading: Cupom
            }
            layout {
                sequence: 80
            }
            validation {
                maxLength: 218
            }
            source {
                databaseColumn: CUPOM
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column DATAEMISSAOPEDIDO (
            type: datePickerJquery
            heading {
                heading: Data Emissão
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            appearance {
                formatMask: dd/mm/yyyy
            }
            source {
                databaseColumn: DATAEMISSAOPEDIDO
                dataType: date
            }
        )

        column IDPEDIDO (
            type: link
            heading {
                heading: Pedido
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 68
                    items: {
                        P68_IDPEDIDO: &IDPEDIDO.
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
                linkAttributes: target="_blank"
            }
            source {
                databaseColumn: IDPEDIDO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column NUMEROPEDIDO (
            type: numberField
            heading {
                heading: N° Pedido
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                databaseColumn: NUMEROPEDIDO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column VALORAPAGAR (
            type: numberField
            heading {
                heading: Valor Pagar com Desconto
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                databaseColumn: VALORAPAGAR
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column VALORDESCONTO (
            type: numberField
            heading {
                heading: Valor Desconto
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: VALORDESCONTO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column VALORTOTALCOMDESCONTO (
            type: numberField
            heading {
                heading: Valor Pagar
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                databaseColumn: VALORTOTALCOMDESCONTO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

    )

    pageItem P615_DATAFINAL (
        type: datePickerJquery
        label {
            label: Data Final
            alignment: left
        }
        layout {
            sequence: 50
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P615_DATAINICIAL (
        type: datePickerJquery
        label {
            label: Data Inicial
            alignment: left
        }
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P615_TIPO_DESCONTO (
        type: selectList
        label {
            label: Tipo de Desconto
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-tipodesconto
            nullDisplayValue: - Selecione -
        }
        layout {
            sequence: 60
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from favorita.cuponsdescontos fc
                where fc.idcupomdesconto = :P18_IDCUPOMDESCONTO
                  and exists ( select fcc.idcupomdesconto
                               from favorita.codigoscuponsdescontos fcc
                               where fcc.idcupomdesconto = fc.idcupomdesconto)
                
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: Filtrar
        label: Filtrar
        layout {
            sequence: 70
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-filter
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button novo (
        buttonName: Novo
        label: Novo
        layout {
            sequence: 10
            region: @pedidos-com-cupom-de-desconto
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 49
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

