    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function doLoad()
            {
            setTimeout( "refresh()", 120*1000 );
            }
            
            function refresh()
            {
            window.location.href = window.location;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region eventos-e-solicitações (
        name: Eventos e Solicitações
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                --11719284 - Gabriel Andriola - 13/01/2025 - Otimização de perfomance.
                declare
                    v_sql clob;
                begin
                    v_sql := '
                        select *
                        from (
                            -- Chamados do próprio usuário
                            select
                                  c.idchamado
                                , c.idchamado id
                                , c.dataabertura
                                , ( select g.descricao
                                    from roman.gruposatendimento g
                                    where g.idgrupoatendimento = c.idgrupoatendimento ) solicitadopara
                                , roman.pck_romance.fnc_nomefilial(
                                    roman.pck_romance.fnc_filialusuario(upper(c.usuario))
                                  ) "Empresa"
                                , initcap(c.usuario) Usuário
                                , c.idsituacao
                                , roman.pck_chamados.fnc_situacaochamado(c.idsituacao) situacao
                                , c.descricao
                                , roman.pck_chamados.fnc_tipochamado(c.idtipochamado) tipochamado
                                , roman.pck_chamados.fnc_itemchamado(c.iditemchamado) itemchamado
                                , roman.pck_chamados.fnc_servicochamado(c.idservicochamado) servicochamado
                                , ( select count(1)
                                    from roman.historicochamados h
                                    where h.idchamado = c.idchamado ) "Qtd de Históricos"
                                , roman.pck_chamados.fnc_impactochamado(c.idimpactotrabalho) impacto
                                , roman.pck_romance.fnc_nomeusuario(responsavel) responsavel
                                , c.dataencerrado
                                , catal.pck_util.fnc_tempodecorrido(
                                    (dataatendido - datainicioatendimento),''H''
                                  ) temposolucao
                                , catal.pck_util.fnc_tempodecorrido(
                                    (dataatendido - dataabertura),''H''
                                  ) tempototal
                                , c.datainicioatendimento
                            from roman.chamados c
                            where c.usuario = :APP_USER
                
                            union all
                
                            -- Chamados onde o usuário participa
                            select
                                  c.idchamado
                                , c.idchamado id
                                , c.dataabertura
                                , ( select g.descricao
                                    from roman.gruposatendimento g
                                    where g.idgrupoatendimento = c.idgrupoatendimento ) solicitadopara
                                , roman.pck_romance.fnc_nomefilial(
                                    roman.pck_romance.fnc_filialusuario(upper(c.usuario))
                                  ) "Empresa"
                                , initcap(c.usuario) Usuário
                                , c.idsituacao
                                , roman.pck_chamados.fnc_situacaochamado(c.idsituacao) situacao
                                , c.descricao
                                , roman.pck_chamados.fnc_tipochamado(c.idtipochamado) tipochamado
                                , roman.pck_chamados.fnc_itemchamado(c.iditemchamado) itemchamado
                                , roman.pck_chamados.fnc_servicochamado(c.idservicochamado) servicochamado
                                , ( select count(1)
                                    from roman.historicochamados h
                                    where h.idchamado = c.idchamado ) "Qtd de Históricos"
                                , roman.pck_chamados.fnc_impactochamado(c.idimpactotrabalho) impacto
                                , roman.pck_romance.fnc_nomeusuario(responsavel) responsavel
                                , c.dataencerrado
                                , catal.pck_util.fnc_tempodecorrido(
                                    (dataatendido - datainicioatendimento),''H''
                                  ) temposolucao
                                , catal.pck_util.fnc_tempodecorrido(
                                    (dataatendido - dataabertura),''H''
                                  ) tempototal
                                , c.datainicioatendimento
                            from roman.chamados c
                            where exists (
                                select 1
                                from roman.usuarioschamados u
                                where u.usuario   = :APP_USER
                                  and u.idchamado = c.idchamado
                            )
                            and c.usuario <> :APP_USER
                        )
                        where 1 = 1
                    ';
                
                    if :P43_DATAINICIO is not null then
                        v_sql := v_sql || '
                            and trunc(dataabertura) between :P43_DATAINICIO and :P43_DATAFIM 
                        ';
                    end if;
                
                    if :P43_IDCHAMADO is not null then
                        v_sql := v_sql || '
                            and idchamado = :P43_IDCHAMADO
                        ';
                    end if;
                
                    if :P43_IDSITUACAO is not null then
                        v_sql := v_sql || '
                            and idsituacao = :P43_IDSITUACAO
                        ';
                    end if;
                
                    if :P43_DATAINICIO is null
                       and :P43_IDCHAMADO is null
                       and :P43_IDSITUACAO is null then
                        v_sql := v_sql || '
                            and 1 = 2
                        ';
                    end if;
                
                    v_sql := v_sql || '
                        order by idchamado desc
                    ';
                
                    return v_sql;
                end;
                
                ```
        }
