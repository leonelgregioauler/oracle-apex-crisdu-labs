page 13 (
    name: Relatório de Grades
    title: Grades
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region grades (
        name: Grades
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idgrade
                     , sigla
                     , ordem
                     , idtipograde
                     , textotraduzido
                     , idtexto
                from vw_grades_fav
                where ididioma = :P0_IDIDIOMA;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 12485898299301219
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDGRADE
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @SIGLA
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @ORDEM
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDTEXTO
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @IDTIPOGRADE
                layout {
                    show: false
                    sequence: 5
                }
            )

            displayColumn (
                column: @TEXTOTRADUZIDO
                layout {
                    sequence: 3
                }
            )

        )

        column IDGRADE (
            type: link
            heading {
                heading: Editar
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 14
                    items: {
                        P14_IDGRADE: &IDGRADE.
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                databaseColumn: IDGRADE
                dataType: number
            }
        )

        column IDTEXTO (
            type: link
            heading {
                heading: Traduções
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            link {
                target: {
                    page: 100
                    items: {
                        P100_IDTEXTOTRADUZIDO: &IDTEXTO.
                    }
                    action: resetPagination
                }
                linkText: <b>Visualizar / Atualizar texto traduzido</b>
                linkAttributes: class="t-Button t-Button--sucess"
            }
            source {
                databaseColumn: IDTEXTO
                dataType: number
            }
        )

        column IDTIPOGRADE (
            type: numberField
            heading {
                heading: Idtipograde
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                databaseColumn: IDTIPOGRADE
                dataType: number
            }
        )

        column ORDEM (
            type: numberField
            heading {
                heading: Ordem
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                databaseColumn: ORDEM
                dataType: number
            }
        )

        column SIGLA (
            type: textField
            heading {
                heading: Sigla
                alignment: center
            }
            layout {
                sequence: 20
            }
            validation {
                valueRequired: true
                maxLength: 10
            }
            source {
                databaseColumn: SIGLA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column TEXTOTRADUZIDO (
            type: textarea
            heading {
                heading: Tradução Sigla
                alignment: center
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: TEXTOTRADUZIDO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

    )

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @opções
            slot: top
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 14
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button novo-2 (
        buttonName: Novo
        label: Novo
        layout {
            sequence: 10
            region: @grades
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 14
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

