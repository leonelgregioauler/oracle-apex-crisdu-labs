page 382 (
    name: Cidades Atendidas pelas Empresas
    title: Cidades Atendidas pelas Empresas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cidades-atendidas (
        name: Cidades Atendidas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.idcidadeatendida
                     , w.idfilial
                     , w.empresa
                     , w.idcidade
                     , w.cidade
                     , w.estado
                     , w.pais
                from roman.vw_cidades_atencidas_rmc w
                where ( :P382_IDFILIAL is null or w.idfilial = :P382_IDFILIAL )
                  and ( :P382_IDCIDADE is null or w.idcidade = :P382_IDCIDADE )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1541742585291207630
        }

        column CIDADE (
            type: plainText
            heading {
                heading: Cidade
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column EMPRESA (
            type: plainText
            heading {
                heading: Empresa
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: Estado
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column IDCIDADE (
            type: hidden
            heading {
                heading: Idcidade
            }
            layout {
                sequence: 40
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDCIDADEATENDIDA (
            type: link
            heading {
                heading: Ver/Editar
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 383
                    items: {
                        P383_IDCIDADEATENDIDA: #IDCIDADEATENDIDA#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column IDFILIAL (
            type: plainText
            heading {
                heading: ID Empresa
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column PAIS (
            type: plainText
            heading {
                heading: País
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 15419082 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CIDADE (
                sequence: 5
            )

            displayColumn EMPRESA (
                sequence: 3
            )

            displayColumn ESTADO (
                sequence: 6
            )

            displayColumn IDCIDADE (
                sequence: 4
            )

            displayColumn IDCIDADEATENDIDA (
                sequence: 1
            )

            displayColumn IDFILIAL (
                sequence: 2
            )

            displayColumn PAIS (
                sequence: 7
            )

            aggregate (
                function: count
                column: CIDADE
            )

            controlBreak (
                column: EMPRESA
                layout {
                    sequence: 1
                }
            )

            controlBreak (
                column: ESTADO
                layout {
                    sequence: 2
                }
            )

        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P382_IDCIDADE (
        type: popupLov
        label {
            label: Cidade
            alignment: left
        }
        settings {
            displayAs: modalDialog
            initialFetch: autoCurrentValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(c.nomecidade)||'/'||e.sigla||' - '||p.nome d
                     , c.idcidade r
                from roman.cidades c
                   , roman.estados e
                   , catal.paises p
                where c.idestado = e.idestado
                  and e.idpais   = p.idpais
                order by 1
                ```
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P382_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from roman.vw_filiais f
                where f.tipofilial = 'D'
                  and f.ativo = 'S'
                  and exists ( select 1
                               from roman.notasvendas nv
                               where nv.idfilial = f.idfilial )
                union
                select f.nome
                     , f.idfilial
                from roman.vw_filiais f
                where f.tipofilial = 'A'
                  and f.ativo = 'S'
                              
                ```
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button buscar (
        buttonName: BUSCAR
        label: Buscar
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button nova (
        buttonName: NOVA
        label: Nova
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--primary
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 383
                items: {
                    P383_IDCIDADE:
                    P383_IDCIDADEATENDIDA:
                    P383_IDFILIAL:
                    P383_MD5:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 382
                items: {
                    P382_IDFILIAL: &P382_IDFILIAL.
                    P382_IDCIDADE: &P382_IDCIDADE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: BUSCAR
        }
    )

)

