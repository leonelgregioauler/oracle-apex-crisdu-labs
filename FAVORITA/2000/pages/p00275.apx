page 275 (
    name: Cadastro de Defeitos
    title: Cadastro de Defeitos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-de-defeitos (
        name: Cadastro de Defeitos
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P275_APARECER (
        type: radioGroup
        label {
            label: Aparecer
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: sharedComponent
            lov: @lov-simnao
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @cadastro-de-defeitos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P275_DESCRICAO (
        type: textField
        label {
            label: Descrição
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @cadastro-de-defeitos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P275_IDDEFEITO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @cadastro-de-defeitos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P275_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @cadastro-de-defeitos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P275_OPERACAO_DML (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @cadastro-de-defeitos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P275_ORIGEM (
        type: radioGroup
        label {
            label: Origem
            alignment: left
        }
        settings {
            noOfCols: 4
        }
        lov {
            type: staticValues
            staticValues: STATIC:Estoque;E,Distribuidor;D,Fornecedor;F,Transportadora;T
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @cadastro-de-defeitos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 10
            region: @cadastro-de-defeitos
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P275_IDDEFEITO
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 30
            region: @cadastro-de-defeitos
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P275_IDDEFEITO
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 20
            region: @cadastro-de-defeitos
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNull
            item: P275_IDDEFEITO
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 40
            region: @cadastro-de-defeitos
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 274
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation p275-aparecer (
        name: P275_APARECER
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P275_APARECER
        }
        error {
            errorMessage: Por favor, informe se deve ou não aparecer!
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('INSERIR','ATUALIZAR')
                ```
        }
    )

    validation p275-descricao (
        name: P275_DESCRICAO
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P275_DESCRICAO
        }
        error {
            errorMessage: Por favor, informe a descrição!
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('INSERIR','ATUALIZAR')
                ```
        }
    )

    validation p275-origem (
        name: P275_ORIGEM
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P275_ORIGEM
        }
        error {
            errorMessage: Por favor, informe a origem do defeito!
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('INSERIR','ATUALIZAR')
                ```
        }
    )

    process consulta (
        name: Consulta
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                #OWNER#.PCK_CADASTROS_FAV.PRC_DEFEITOS( PIDDEFEITO => :P275_IDDEFEITO,
                                                          PDESCRICAO => :P275_DESCRICAO,
                                                          PORIGEM => :P275_ORIGEM,
                                                          PAPARECER => :P275_APARECER,
                                                          PMD5 => :P275_MD5,
                                                          POPERACAO_DML => 'S');
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 766872468034274919
        }
    )

    process processo-dml-em-defeitos (
        name: Processo DML em Defeitos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  --
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  #OWNER#.PCK_CADASTROS_FAV.PRC_DEFEITOS( PIDDEFEITO => :P275_IDDEFEITO,
                                                          PDESCRICAO => :P275_DESCRICAO,
                                                          PORIGEM => :P275_ORIGEM,
                                                          PAPARECER => :P275_APARECER,
                                                          PMD5 => :P275_MD5,
                                                          POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo executado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 766892690830580135
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('ATUALIZAR','INSERIR','EXCLUIR');
                ```
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 275
                items: {
                    P275_IDDEFEITO:
                }
                action: resetPagination
            }
        }
    )

)

