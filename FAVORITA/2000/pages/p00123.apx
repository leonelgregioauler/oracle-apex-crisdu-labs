    region relatório-análise-de-crédito (
        name: Relatório Análise de Crédito
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct(c.idcontrolecontatossite)
                     , decode(c.tipoprotocolo,'S','SAC','C','Crédito',' ') "Tp.Protocolo"
                     , c.nomecompleto
                     , c.cpf
                     , c.datanascimento
                     , c.rua
                     , c.nr
                     , c.complemento
                     , c.bairro
                     , c.idcidade
                     , c.cidade
                     , c.cep
                     , c.fone
                     , c.fone2
                     , c.email
                     , c.mensagem
                     , c.observacao
                     , c.situacao
                     , c.descricaosituacao
                     , c.datacadastro
                     , c.idfilial
                     , c.filialromance
                     , c.idrepresentante
                     , c.nomerepresentante
                     , c.dataliberadofilial
                     , c.datapassadorepres
                     , c.observacaofilial
                     , c.origemdesc origem
                     , c.tipo
                     , c.tiposolicitacaosac
                     , c.idfilialorig
                     , c.filialromanceorigem
                     , c.idrepresentanteorig
                     , c.nomerepresentanteorigem
                     , c.idvendedoraorig
                     , c.nomevendedoraorigem
                     , c.cadastrado
                     , c.tiposolicitacaomanual
                     , c.cidademanual
                     , c.inadimplente
                     , c.nroconsultaspc
                     , c.usuariocadastrou
                     , c.cadastrosistema
                     , c.situacaocliente
                     , cc.spc_quantidade
                     , cc.spc_valortotal
                     , cc.idade
                     , cc.idconsultaspc
                     , cc.ccf
                     , nvl((select 'Sim'
                            from dual
                            where exists ( select 1
                                           from roman.classificacoessac cc
                                           where cc.idcontrolecontatossite = c.idcontrolecontatossite 
                                             and cc.idcaracteristicasac in (21,22,23) )),'Não') possuitarefa
                     , c.atendidopor
                from vw_controlecontatossite_fav c
                   , roman.consultaspc cc
                where replace(replace(c.cpf,'.',''),'-','') = cc.cpf(+)
                  --and sysdate - cc.dataconsulta <= 30
                  --
                  and c.tipoprotocolo = 'C' -- Analise de Credito - Foi definido que aqui apareceriam somente os protocolos que o SAC definir como Tipo Protocolo = 'C'
                  --
                  and nvl(c.idpais,1) = 1
                  and c.situacao = 'M'
                  and ( :P123_NRPROTOCOLO is null or c.idcontrolecontatossite = :P123_NRPROTOCOLO )
                  and ( :P123_SITUACAO = 'XX' or c.situacao = :P123_SITUACAO )
                  and ( pck_util_fav.fnc_verificaacesso(52107,:P0_IDUSUARIO) = 'S' or c.idfilialfavorita = :P0_IDFILIALFAVORITA )
                  and ( :P123_CPF is null or c.cpf = replace(replace(:P123_CPF,'.',''),'-','') )
                  and ( :P123_NOME is null or lower(c.nomecompleto) like '%'||lower(:P123_NOME)||'%' )
                  and ( :P123_EMAIL is null or lower(c.email) like '%'||lower(:P123_EMAIL)||'%' )
                  and ( :P123_ORIGEM is null or c.origem = :P123_ORIGEM )
                  and ( :P123_IDCIDADE is null or c.idcidade = :P123_IDCIDADE )
                  and ( :P123_DATANASCIMENTO is null or c.datanascimento = to_date(:P123_DATANASCIMENTO,'DD/MM/RRRR') )
                  and ( :P123_DATACADASTRO_INI is null or trunc(c.datacadastro) between to_date(:P123_DATACADASTRO_INI,'DD/MM/RRRR') and to_date(:P123_DATACADASTRO_FIM,'DD/MM/RRRR') )
                  and ( :P123_COMTAREFA is null or exists ( select 1
                                                            from roman.classificacoessac cc
                                                            where cc.idcontrolecontatossite = c.idcontrolecontatossite 
                                                              and cc.idcaracteristicasac in (21,22,23) ) ) 
                  and ( :P123_COMCONSULTA is null or exists ( select 1
                                                              from roman.consultaspc spc
                                                              where replace(replace(c.cpf,'.',''),'-','') = spc.cpf ) )
                  and ( :P123_SITUACAO_CLIENTE is null or exists ( select 1
                                                                   from vendedoras v
                                                                      , pessoas p
                                                                   where v.idpessoa = p.idpessoa
                                                                     and v.ativo    = :P123_SITUACAO_CLIENTE
                                                                     and p.cpf      = replace(replace(c.cpf,'.',''),'-','') ) )
                  and ( :P123_VALORRESTRICAO is null or cc.spc_valortotal <= :P123_VALORRESTRICAO )
                  and ( :P123_QTDRESTRICAO is null or cc.spc_quantidade <= :P123_QTDRESTRICAO )
                  and ( :P123_IDADE is null or cc.idade >= :P123_IDADE )
                  and ( :P123_ESTADO is null or exists ( select 1
                                                           from roman.cidades cc
                                                           where cc.idcidade = c.idcidade 
                                                             and cc.idestado = :P123_ESTADO ) )
                  and ( :P123_DOC_ESTRANGEIRO is null or replace(replace(c.documentoestrangeiro,'.',''),'-','') = replace(replace(:P123_DOC_ESTRANGEIRO,'.',''),'-','') )
                  --and ( :P123_IDPAIS is null or nvl(c.idpais,1) = :P123_IDPAIS)
                  and :P123_FILTRAR = 'S'
                order by 1 desc
                  
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.usuariosgruposatendimento ug
                where ug.idgrupoatendimento = 48
                  and ug.usuario = v('APP_USER')
                  and :P123_IDPAIS = 1
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
