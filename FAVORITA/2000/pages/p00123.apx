    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P123_DISTRIBUIDOR
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    
                     IF :P123_DISTRIBUIDOR = -2  THEN  
                        :P123_NEW := 1;
                     ELSE  
                        :P123_NEW := 0 ;
                     END IF;
                    
                    END;
                    ```
                itemsToSubmit: P123_DISTRIBUIDOR
                itemsToReturn: P123_NEW
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process filtrar (
        name: FILTRAR
        type: executeCode
        source {
            plsqlCode: :P123_FILTRAR := 'S';
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 3405059968939031502
        }
        serverSideCondition {
            type: never
        }
        comments {
            comments: "Bruno - comentei porque não tem necessidade, coloquei na branche "
        }
    )

    branch (
        name: Go To Page 123
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 123
                items: {
                    P123_NRPROTOCOLO: &P123_NRPROTOCOLO.
                    P123_SITUACAO: &P123_SITUACAO.
                    P123_CPF: &P123_CPF.
                    P123_NOME: &P123_NOME.
                    P123_ORIGEM: &P123_ORIGEM.
                    P123_DATANASCIMENTO: &P123_DATANASCIMENTO.
                    P123_EMAIL: &P123_EMAIL.
                    P123_ESTADO: &P123_ESTADO.
                    P123_DATACADASTRO_FIM: &P123_DATACADASTRO_FIM.
                    P123_DATACADASTRO_INI: &P123_DATACADASTRO_INI.
                    P123_SITUACAO_CLIENTE: &P123_SITUACAO_CLIENTE.
                    P123_VALORRESTRICAO: &P123_VALORRESTRICAO.
                    P123_QTDRESTRICAO: &P123_QTDRESTRICAO.
                    P123_IDADE: &P123_IDADE.
                    P123_COMCONSULTA: &P123_COMCONSULTA.
                    P123_COMTAREFA: &P123_COMTAREFA.
                    P123_IDCIDADE: &P123_IDCIDADE.
                    P123_IDPAIS: &P123_IDPAIS.
                    P123_DOC_ESTRANGEIRO: &P123_DOC_ESTRANGEIRO.
                    P123_FILTRAR: S
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

)

