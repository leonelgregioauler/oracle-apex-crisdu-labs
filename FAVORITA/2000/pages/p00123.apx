page 123 (
    name: Relatório de Controle Crédito
    title: Relatório de Controle Crédito
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 30
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuarios u
                where exists ( select 1
                               from favorita.filiaisfavorita ff
                               where ff.idfilialfavorita = u.idfilialfavorita
                                 and ff.tipofilial       = 'L' )
                  and u.usuario = v('APP_USER')
                ```
        }
    )

    region controle-análise-crédito-para-loja (
        name: Controle Análise Crédito para Loja
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct(c.idcontrolecontatossite)
                     , decode(c.tipoprotocolo,'S','SAC','C','Crédito','L','Loja',' ') "Tp.Protocolo"
                     , favorita.pck_util_fav.fnc_nomefilialfavorita(c.idfilialfavorita) Loja
                     , c.nomecompleto
                     , c.cpf
                     , c.datanascimento
                     , c.rua
                     , c.nr
                     , c.complemento
                     , c.bairro
                     , c.idcidade
                     , c.cidade
                     , c.cep
                     , c.fone
                     , c.fone2
                     , c.email
                     , c.mensagem
                     , c.observacao
                     , c.situacao
                     , c.descricaosituacao
                     , c.datacadastro
                     , c.idfilial
                     , c.filialromance
                     , c.idrepresentante
                     , c.nomerepresentante
                     , c.dataliberadofilial
                     , c.datapassadorepres
                     , c.observacaofilial
                     , c.origemdesc origem
                     , c.tipo
                     , c.tiposolicitacaosac
                     , c.idfilialorig
                     , c.filialromanceorigem
                     , c.idrepresentanteorig
                     , c.nomerepresentanteorigem
                     , c.idvendedoraorig
                     , c.nomevendedoraorigem
                     , c.cadastrado
                     , c.tiposolicitacaomanual
                     , c.cidademanual
                     , c.inadimplente
                     , c.nroconsultaspc
                     , c.usuariocadastrou
                     , c.cadastrosistema
                     , c.situacaocliente
                     , c.atendidopor
                /*from vw_controlecontatossite_fav c
                where nvl(c.idpais,1) = 1
                  --
                  and c.tipoprotocolo = 'C' -- Analise de Credito - Foi definido que aqui apareceriam somente os protocolos que o SAC definir como Tipo Protocolo = 'C'
                  --
                  and c.origem = 'LF'
                  and c.idfilialfavorita = :P0_IDFILIALFAVORITA
                order by 1 desc*/
                from vw_controlecontatossite_fav c
                where nvl(c.idpais,1) = 1
                  and c.tipoprotocolo = (
                        case 
                          when exists ( select 1
                                        from usuarios u
                                             join favorita.filiaisfavorita ff
                                               on ff.idfilialfavorita = u.idfilialfavorita
                                        where u.usuario = v('APP_USER')
                                          and ff.tipofilial = 'L' )
                          then 'L'
                          else 'C'
                        end
                      )
                  and c.origem = 'LF'
                  and c.idfilialfavorita = :P0_IDFILIALFAVORITA
                order by 1 desc
                
                  
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuarios u
                where exists ( select 1
                               from favorita.filiaisfavorita ff
                               where ff.idfilialfavorita = u.idfilialfavorita
                                 and ff.tipofilial       = 'L' )
                  and u.usuario = v('APP_USER')
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado obtido. Verifique os filtros!
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 18027443870329905
        }

