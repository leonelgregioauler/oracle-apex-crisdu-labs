        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from roman.vw_filiais f
                where f.tipofilial = 'D'
                  and f.ativo = 'S'
                  and exists (select 1
                              from roman.postoavancado p
                              where p.idfilial = f.idfilial )
                ```
