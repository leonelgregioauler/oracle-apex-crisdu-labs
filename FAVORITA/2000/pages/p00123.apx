    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuarios u
                where ( exists ( select 1
                                 from favorita.filiaisfavorita ff
                                 where ff.idfilialfavorita = u.idfilialfavorita
                                 and ff.tipofilial       = 'L' )
                    and u.usuario = v('APP_USER')
                )
                and not exists ( select 1 from dual where pck_util_fav.fnc_verificaacesso(pidaplicacao => 52109, pidusuario => pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S' )
                ```
        }
    )

    region new (
        name: New
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select 'Protocolo Urgente' tipo
                     , count(1)  qtd
                from roman.controlecontatossite ec
                where idfilial = :P0_IDFILIAL
                  and ec.situacao in ('P') 
                  and ec.tipo = 3
                
                ```
        }
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.controlecontatossite ec
                where idfilial = :P0_IDFILIAL
                  and ec.situacao in ('E') 
                  and ec.tipo = 3
                ```
        }
        settings {
            labelColumn: TIPO
            valueColumn: QTD
            linkTarget: {
                page: 628
                action: resetPagination
            }
            color: yes
        }
    )

