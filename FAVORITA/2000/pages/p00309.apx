page 309 (
    name: Indicadores de Cadastros
    title: Indicadores de Cadastros
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region medidores-de-indicações (
        name: Medidores de Indicações
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome faixa
                     , nvl(indicacoes.qtd,0) indicacoes
                     , nvl(ativo.qtd,0) ativo
                     , trim(to_char(nvl(ativo.ticket,0),'999G999G999G999G999G999G990D00')) ticketativo
                     , round(nvl((ativo.sacolas/ativo.qtd),0)) mediasacolasativa
                     , nvl(inativo.qtd,0) inativo
                     , trim(to_char(nvl(inativo.ticket,0),'999G999G999G999G999G999G990D00')) ticketinativo
                     , round(nvl((inativo.sacolas/inativo.qtd),0)) mediasacolasinativa
                     , nvl(debito.qtd,0) debito
                from roman.faixasetarias f
                   , ( select count(distinct(c.idcontrolecontatossite)) qtd
                            , f.idfaixaetaria
                       from roman.controlecontatossite c
                          , roman.faixasetarias f
                       where c.datanascimento is not null
                         and ( :P309_IDFILIALROMANCE is null or c.idfilial = :P309_IDFILIALROMANCE )
                         and NVL(Floor(Months_Between(trunc(sysdate),c.datanascimento)/12),0) between f.valorinicial and f.valorfinal
                         and trunc(c.datacadastro) between to_date(:P309_DATAINICIO) and to_date(:P309_DATAFIM) 
                       group by f.idfaixaetaria ) indicacoes
                   , ( select count(distinct(p.idpessoa)) qtd
                            , f.idfaixaetaria
                            , avg(( select nvl((sum(n.valorpago) / count(n.idnotavenda)),0) 
                                    from roman.notasvendas n
                                       , vendedoras v
                                    where v.idvendedora         = n.idvendedora
                                      and v.idpessoa            = p.idpessoa
                                      and trunc(n.dataacerto) between to_date(:P309_DATAINICIO) and to_date(:P309_DATAFIM)
                                      and n.idsituacaonotavenda = 4)) ticket
                            , sum(( select count(distinct(n.idnotavenda))
                                    from roman.notasvendas n
                                       , vendedoras v
                                    where v.idvendedora         = n.idvendedora
                                      and v.idpessoa            = p.idpessoa
                                      and trunc(n.datanota) between to_date(:P309_DATAINICIO) and to_date(:P309_DATAFIM)
                                      and n.idsituacaonotavenda in (3,4) )) sacolas
                       from pessoas p
                          , roman.faixasetarias f
                       where NVL(Floor(Months_Between(trunc(sysdate),p.datanascimento)/12),0) between f.valorinicial and f.valorfinal
                         and exists ( select 1
                                      from vendedoras v
                                      where v.idpessoa = p.idpessoa
                                        and v.ativo    = 'S' )
                         and exists ( select 1
                                      from roman.controlecontatossite c
                                      where nvl(p.cpf,p.documentoestrangeiro) = replace(replace(replace(nvl(c.cpf,c.documentoestrangeiro),'.',''),'-',''),' ','')
                                        and ( :P309_IDFILIALROMANCE is null or c.idfilial = :P309_IDFILIALROMANCE )
                                        and trunc(c.datacadastro) between to_date(:P309_DATAINICIO) and to_date(:P309_DATAFIM) 
                                        and c.dataliberadofilial is not null )
                       group by f.idfaixaetaria ) ativo
                   , ( select count(distinct(p.idpessoa)) qtd
                            , f.idfaixaetaria
                            , avg(( select nvl((sum(n.valorpago) / count(n.idnotavenda)),0) 
                                    from roman.notasvendas n
                                       , vendedoras v
                                    where v.idvendedora         = n.idvendedora
                                      and v.idpessoa            = p.idpessoa
                                      and trunc(n.dataacerto) between to_date(:P309_DATAINICIO) and to_date(:P309_DATAFIM)
                                      and n.idsituacaonotavenda = 4)) ticket
                            , sum(( select count(distinct(n.idnotavenda))
                                    from roman.notasvendas n
                                       , vendedoras v
                                    where v.idvendedora         = n.idvendedora
                                      and v.idpessoa            = p.idpessoa
                                      and n.idsituacaonotavenda in (3,4)
                                      and trunc(n.datanota) between to_date(:P309_DATAINICIO) and to_date(:P309_DATAFIM))) sacolas
                       from pessoas p
                          , roman.faixasetarias f
                       where NVL(Floor(Months_Between(trunc(sysdate),p.datanascimento)/12),0) between f.valorinicial and f.valorfinal
                         and exists ( select 1
                                      from vendedoras v
                                      where v.idpessoa = p.idpessoa
                                        and v.ativo    = 'N' )
                         and exists ( select 1
                                      from roman.controlecontatossite c
                                      where nvl(p.cpf,p.documentoestrangeiro) = replace(replace(replace(nvl(c.cpf,c.documentoestrangeiro),'.',''),'-',''),' ','')
                                        and ( :P309_IDFILIALROMANCE is null or c.idfilial = :P309_IDFILIALROMANCE )
                                        and trunc(c.datacadastro) between to_date(:P309_DATAINICIO) and to_date(:P309_DATAFIM) 
                                        and c.dataliberadofilial is not null )
                       group by f.idfaixaetaria ) inativo
                   , ( select count(distinct(p.idpessoa)) qtd
                            , f.idfaixaetaria
                       from pessoas p
                          , vendedoras v
                          , roman.faixasetarias f
                       where p.idpessoa = v.idpessoa
                         and NVL(Floor(Months_Between(trunc(sysdate),p.datanascimento)/12),0) between f.valorinicial and f.valorfinal
                         and exists ( select 1
                                      from roman.controlecontatossite c
                                      where nvl(p.cpf,p.documentoestrangeiro) = replace(replace(replace(nvl(c.cpf,c.documentoestrangeiro),'.',''),'-',''),' ','')
                                        and ( :P309_IDFILIALROMANCE is null or c.idfilial = :P309_IDFILIALROMANCE )
                                        and trunc(c.datacadastro) between to_date(:P309_DATAINICIO) and to_date(:P309_DATAFIM) 
                                        and c.dataliberadofilial is not null )
                         and exists ( select 1
                                      from roman.notasvendas nv
                                      where nv.idvendedora = v.idvendedora
                                        and nv.idsituacaonotavenda = 4
                                        and nv.saldo > 0 )
                       group by f.idfaixaetaria ) debito
                where indicacoes.idfaixaetaria(+) = f.idfaixaetaria
                  and ativo.idfaixaetaria(+) = f.idfaixaetaria
                  and inativo.idfaixaetaria(+) = f.idfaixaetaria
                  and debito.idfaixaetaria(+) = f.idfaixaetaria
                  and :P309_DATAINICIO is not null
                union
                select 'Sem Faixa Etária'
                     , nvl(indicacoes.qtd,0) indicacoes
                     , nvl(ativo.qtd,0) ativo
                     , trim(to_char(nvl(ativo.ticket,0),'999G999G999G999G999G999G990D00')) ticketativo
                     , round(nvl((ativo.sacolas/ativo.qtd),0)) mediasacolasativa
                     , nvl(inativo.qtd,0) inativo
                     , trim(to_char(nvl(inativo.ticket,0),'999G999G999G999G999G999G990D00')) ticketinativo
                     , round(nvl((inativo.sacolas/inativo.qtd),0)) mediasacolasinativa
                     , nvl(debito.qtd,0) debito
                from ( select count(distinct(c.idcontrolecontatossite)) qtd
                       from roman.controlecontatossite c
                       where c.datanascimento is not null
                         and ( :P309_IDFILIALROMANCE is null or c.idfilial = :P309_IDFILIALROMANCE )
                         and not exists ( select 1
                                          from roman.faixasetarias f
                                          where NVL(Floor(Months_Between(trunc(sysdate),c.datanascimento)/12),0) between f.valorinicial and f.valorfinal )
                         and trunc(c.datacadastro) between to_date(:P309_DATAINICIO) and to_date(:P309_DATAFIM)  ) indicacoes
                   , ( select count(distinct(p.idpessoa)) qtd
                            , avg(( select nvl((sum(n.valorpago) / count(n.idnotavenda)),0) 
                                    from roman.notasvendas n
                                       , vendedoras v
                                    where v.idvendedora         = n.idvendedora
                                      and v.idpessoa            = p.idpessoa
                                      and trunc(n.dataacerto) between to_date(:P309_DATAINICIO) and to_date(:P309_DATAFIM)
                                      and n.idsituacaonotavenda = 4)) ticket
                            , sum(( select count(distinct(n.idnotavenda))
                                    from roman.notasvendas n
                                       , vendedoras v
                                    where v.idvendedora         = n.idvendedora
                                      and v.idpessoa            = p.idpessoa
                                      and trunc(n.datanota) between to_date(:P309_DATAINICIO) and to_date(:P309_DATAFIM)
                                      and n.idsituacaonotavenda in (3,4) )) sacolas
                       from pessoas p
                       where exists ( select 1
                                      from vendedoras v
                                      where v.idpessoa = p.idpessoa
                                        and v.ativo    = 'S' )
                         and not exists ( select 1
                                          from roman.faixasetarias f
                                          where NVL(Floor(Months_Between(trunc(sysdate),p.datanascimento)/12),0) between f.valorinicial and f.valorfinal )
                         and exists ( select 1
                                      from roman.controlecontatossite c
                                      where nvl(p.cpf,p.documentoestrangeiro) = replace(replace(replace(nvl(c.cpf,c.documentoestrangeiro),'.',''),'-',''),' ','')
                                        and ( :P309_IDFILIALROMANCE is null or c.idfilial = :P309_IDFILIALROMANCE )
                                        and trunc(c.datacadastro) between to_date(:P309_DATAINICIO) and to_date(:P309_DATAFIM) 
                                        and c.dataliberadofilial is not null ) ) ativo
                   , ( select count(distinct(p.idpessoa)) qtd
                            , avg(( select nvl((sum(n.valorpago) / count(n.idnotavenda)),0) 
                                    from roman.notasvendas n
                                       , vendedoras v
                                    where v.idvendedora         = n.idvendedora
                                      and v.idpessoa            = p.idpessoa
                                      and trunc(n.dataacerto) between to_date(:P309_DATAINICIO) and to_date(:P309_DATAFIM)
                                      and n.idsituacaonotavenda = 4)) ticket
                            , sum(( select count(distinct(n.idnotavenda))
                                    from roman.notasvendas n
                                       , vendedoras v
                                    where v.idvendedora         = n.idvendedora
                                      and v.idpessoa            = p.idpessoa
                                      and n.idsituacaonotavenda in (3,4)
                                      and trunc(n.datanota) between to_date(:P309_DATAINICIO) and to_date(:P309_DATAFIM))) sacolas
                       from pessoas p
                       where exists ( select 1
                                      from vendedoras v
                                      where v.idpessoa = p.idpessoa
                                        and v.ativo    = 'N' )
                         and not exists ( select 1
                                          from roman.faixasetarias f
                                          where NVL(Floor(Months_Between(trunc(sysdate),p.datanascimento)/12),0) between f.valorinicial and f.valorfinal )
                         and exists ( select 1
                                      from roman.controlecontatossite c
                                      where nvl(p.cpf,p.documentoestrangeiro) = replace(replace(replace(nvl(c.cpf,c.documentoestrangeiro),'.',''),'-',''),' ','')
                                        and ( :P309_IDFILIALROMANCE is null or c.idfilial = :P309_IDFILIALROMANCE )
                                        and trunc(c.datacadastro) between to_date(:P309_DATAINICIO) and to_date(:P309_DATAFIM) 
                                        and c.dataliberadofilial is not null ) ) inativo
                   , ( select count(distinct(p.idpessoa)) qtd
                       from pessoas p
                          , vendedoras v
                       where p.idpessoa = v.idpessoa
                         and not exists ( select 1
                                          from roman.faixasetarias f
                                          where NVL(Floor(Months_Between(trunc(sysdate),p.datanascimento)/12),0) between f.valorinicial and f.valorfinal )
                         and exists ( select 1
                                      from roman.controlecontatossite c
                                      where nvl(p.cpf,p.documentoestrangeiro) = replace(replace(replace(nvl(c.cpf,c.documentoestrangeiro),'.',''),'-',''),' ','')
                                        and ( :P309_IDFILIALROMANCE is null or c.idfilial = :P309_IDFILIALROMANCE )
                                        and trunc(c.datacadastro) between to_date(:P309_DATAINICIO) and to_date(:P309_DATAFIM) 
                                        and c.dataliberadofilial is not null )
                         and exists ( select 1
                                      from roman.notasvendas nv
                                      where nv.idvendedora = v.idvendedora
                                        and nv.idsituacaonotavenda = 4
                                        and nv.saldo > 0 ) ) debito
                order by 2 desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado, verifique os filtros.
        }
        advanced {
            savedReportMappingIdentifier: 1483977230160170241
        }

