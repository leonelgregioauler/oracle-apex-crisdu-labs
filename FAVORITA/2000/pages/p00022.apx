    region produtos-detalhados (
        name: Produtos Detalhados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idprodutodetedrevista
                     , idedicaorevista
                     , pck_util_fav.fnc_nomeprodutodetalhado(idprodutodetalhado, :P0_IDIDIOMA) produtodetalhado
                     , nvl(( select distinct 'Sim'
                             from favorita.precosprodutos pp
                             where pp.idprodutodetalhado = pd.idprodutodetalhado
                               and pp.idedicaorevista = pd.idedicaorevista),'Não') ExistePreco
                from produtosdetedrevistas pd
                where pd.idedicaorevista = :P22_IDEDICAOREVISTA
                  and pck_util_fav.fnc_nomeprodutodetalhado(idprodutodetalhado, :P0_IDIDIOMA) like '%'||:P22_PRODUTODETALHADO||'%'
                  and ( :P22_EXISTEPRECO = 0
                       or ( :P22_EXISTEPRECO = 1 and exists ( select 1
                                                                from favorita.precosprodutos pp
                                                                where pp.idprodutodetalhado = pd.idprodutodetalhado
                                                                  and pp.idedicaorevista = pd.idedicaorevista) )
                       or ( :P22_EXISTEPRECO = 2 and not exists ( select 1
                                                                    from favorita.precosprodutos pp
                                                                    where pp.idprodutodetalhado = pd.idprodutodetalhado
                                                                      and pp.idedicaorevista = pd.idedicaorevista) ))
                order by pck_util_fav.fnc_nomeprodutodetalhado(idprodutodetalhado, :P0_IDIDIOMA);
                ```
        }
        layout {
            sequence: 20
            parentRegion: @pesquisa-de-produtos
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 30
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSearchEngine
        }
        messages {
            whenNoDataFound: <center>Não encontrou informações.</center>
        }

