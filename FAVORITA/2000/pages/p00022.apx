    region preços-virtual-agel (
        name: Preços Virtual Agel
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nvl( ( select dep.skuvirtualage
                               from deparaprodfavoritavirtualage dep
                               where dep.idprodutodetalhado = a.idprodutodetalhado )
                             , 6000000 + a.idprodutodetalhado ) sku
                     , trim(to_char(a.a.valorvenda,'999G999G999G990D00')) valorvenda
                     , trim(to_char(a.a.valorconsultora,'999G999G999G990D00')) valorconsultora
                     , trim(to_char(a.a.valordistribuidor,'999G999G999G990D00')) valordistribuidor
                     , trim(to_char(a.a.valorfuncionario,'999G999G999G990D00')) valorfuncionario
                     , trim(to_char(a.a.perccomissaoconsultora,'999G999G999G990D00')) perccomissaoconsultora
                     , trim(to_char(a.a.perccomissaodistribuidor,'999G999G999G990D00')) perccomissaodistribuidor
                     , trim(to_char(a.a.perccomissaogerente,'999G999G999G990D00')) as percomissaofuncionario
                     , trim(to_char(a.valorpontos,'999G999G999G990D00')) valorpontos
                from  
                (select e.idprodutodetalhado
                      , p.valorpontos
                      , favorita.pck_integracao_fav_widecomm.fnc_buscavalorcomdesconto( pidedicaorevista    =>e.idedicaorevista ,
                                                                                        pidprodutodetalhado =>e.idprodutodetalhado ,
                                                                                        pidpais             =>1 ) a
                from favorita.produtosdetedrevistas e
                   , favorita.produtos p
                   , favorita.produtosdetalhados pd
                where e.idprodutodetalhado = pd.idprodutodetalhado
                  and pd.idproduto = p.idproduto
                  and e.idedicaorevista = 56) a
                where a.a.valorvenda > 0
                  and a.a.idedicaorevista = 56
                order by 1 ;
                
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P22_IDEDICAOREVISTA
            value: 56
        }
        customization {
            customizable: shownByDefault
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        download {
            csvExportEnabled: true
        }

