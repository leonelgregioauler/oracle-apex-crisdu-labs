    process operação-dml-em-edições-revistas (
        name: Operação DML em Edições Revistas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                #OWNER#.PCK_CADASTROS_FAV.PRC_EDICOESREVISTAS (
                    PIDEDICAOREVISTA   => :P22_IDEDICAOREVISTA,
                    PNOME              => :P22_NOME,
                    PNUMEROEDICAO      => :P22_NUMEROEDICAO,
                    PTIRAGEM           => :P22_TIRAGEM,
                    PDATAINICIAL       => :P22_DATAINICIAL,
                    PDATAFINAL         => :P22_DATAFINAL,
                    PQTDPAGINAS        => :P22_QTDPAGINAS,
                    PIDPAIS            => :P22_IDPAIS,
                    PMD5               => :P22_MD5,
                    POPERACAO_DML      => voperacao_dml,
                    PLIBERARCOMPRA     => :P22_LIBERARCOMPRA,
                    PTIPOVENDA         => :P22_TIPOVENDA,
                    plinkcatalogo      => :P22_LINKCATALOGO,
                    pvendaespecial     => :P22_VENDAESPECIAL);
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 3311992835936256
        }
    )

