    process adicionar-produtos-em-lote-proc (
        name: Adicionar Produtos em Lote
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vqtde number;
                begin
                  --
                  insert into produtosdetedrevistas
                    ( idprodutodetedrevista
                    , idedicaorevista
                    , idprodutodetalhado )
                  select seq_idprodutodetedrevista.nextval
                       , :P22_IDEDICAOREVISTA
                       , to_number(s.column_value)
                  from table(apex_string.split(:P22_ADDIDSPRODDET, ':')) s
                  where not exists ( select 1
                                     from produtosdetedrevistas e
                                     where e.idedicaorevista    = :P22_IDEDICAOREVISTA
                                       and e.idprodutodetalhado = to_number(s.column_value) );
                  --
                  vqtde := sql%rowcount;
                  --
                  apex_application.g_print_success_message := apex_application.g_print_success_message
                                                            || case when apex_application.g_print_success_message is not null then '<br/>' end
                                                            || vqtde || ' cor(es)/tamanho(s) adicionado(s) à edição.';
                  --
                end;
                ```
        }
        execution {
            sequence: 45
        }
        error {
            errorMessage: Erro ao adicionar os produtos à edição.
        }
        advanced {
            executionMappingIdentifier: 1703616600000008
        }
        serverSideCondition {
            whenButtonPressed: @inseriratualizar
            type: itemIsNotNull
            item: P22_ADDIDSPRODDET
        }
    )

