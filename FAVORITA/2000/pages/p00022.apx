    region produtos-detalhados-revistas (
        name: Produtos Detalhados Revistas
        type: tabform
        source {
            sqlQuery:
                ```sql
                select idprodutodetedrevista
                     , idedicaorevista
                     , idprodutodetalhado
                from produtosdetedrevistas
                where idedicaorevista = :P22_IDEDICAOREVISTA
                  and ( ( :P22_ADDIDPRODUTO is not null
                          and idprodutodetalhado in ( select pd.idprodutodetalhado
                                                      from produtosdetalhados pd
                                                      where pd.idproduto = :P22_ADDIDPRODUTO ) )
                     or ( :P22_ADDIDPRODUTO is null
                          and pck_util_fav.fnc_nomeprodutodetalhado(idprodutodetalhado, :P0_IDIDIOMA) like '%'||nvl(:P22_PRODUTODETALHADO, 'abcdefgh')||'%' ) )
                order by pck_util_fav.fnc_nomeprodutodetalhado(idprodutodetalhado, :P0_IDIDIOMA);
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 30
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSearchEngine
        }
        messages {
            whenNoDataFound: <center>Informe um filtro para a consulta.</center>
        }

        column CHECK$01 (
            reportColumnQueryId: 4
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            advanced {
                cellWidth: 50
            }
        )

        column IDEDICAOREVISTA (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 3
            }
            default {
                type: item
