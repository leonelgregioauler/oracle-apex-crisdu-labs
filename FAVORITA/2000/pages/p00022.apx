            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P22_DATAINICIAL
            alwaysExecute: true
        }
        error {
            errorMessage: Data inicial deve ter uma data válida.
            associatedItem: @P22_DATAINICIAL
        }
    )

    validation edicaoprodutodetalhado-unique (
        name: EDICAOPRODUTODETALHADO  unique
        execution {
            sequence: 90
        }
        validation {
            editableRegion: @produtos-detalhados-revistas
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  videdicaorevista number;
                  vidprodutodetalhado number;
                begin
                  select idedicaorevista
                       , idprodutodetalhado
                  into videdicaorevista
                     , vidprodutodetalhado
                  from produtosdetedrevistas
                  where idedicaorevista = :IDEDICAOREVISTA
                  and idprodutodetalhado = :IDPRODUTODETALHADO;
                  --
                  if videdicaorevista is not null and vidprodutodetalhado is not null then
                    return 'Existe um cadastro no sistema com estas informações. Não são permitidas informações repetidas para este cadastro.';
                  end if;
                  --
                exception
                  when no_data_found then
                    return '';
                end;
                ```
        }
        error {
            associatedColumn: IDPRODUTODETALHADO
        }
        serverSideCondition {
            whenButtonPressed: @inseriratualizar
        }
    )

