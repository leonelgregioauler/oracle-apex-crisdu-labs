                nullDisplayValue: " - Selecione o Produto Detalhado - "
            }
            layout {
                sequence: 4
            }
            appearance {
                width: 180
            }
            sorting {
                sortable: false
            }
            advanced {
                cellWidth: 180
            }
        )

        column IDPRODUTODETEDREVISTA (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDPRODUTODETEDREVISTA
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P22_ADDIDPRODUTO (
        type: popupLov
        label {
            label: Produto (Referência)
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.referencia || ' - ' || p.nomeproduto d
                     , p.idproduto                             r
                from produtos p
                where exists ( select 1
                               from produtosdetalhados pd
                               where pd.idproduto = p.idproduto
                                 and pd.ativo     = 'S' )
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione o produto -
        }
        layout {
            sequence: 10
            region: @produtos-detalhados-revistas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
            valuePlaceholder: - Selecione o produto -
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P22_ADDIDSPRODDET (
        type: checkboxGroup
        label {
            label: Cores / Tamanhos
            alignment: left
        }
        settings {
            noOfCols: 4
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeprodutodetalhado(pd.idprodutodetalhado, :P0_IDIDIOMA) d
                     , pd.idprodutodetalhado                                                    r
                from produtosdetalhados pd
                where pd.idproduto = :P22_ADDIDPRODUTO
                  and pd.ativo     = 'S'
                  and not exists ( select 1
                                   from produtosdetedrevistas e
                                   where e.idedicaorevista    = :P22_IDEDICAOREVISTA
                                     and e.idprodutodetalhado = pd.idprodutodetalhado )
                order by 1
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 20
            region: @produtos-detalhados-revistas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

