    dynamicAction filtrar-produto-selecionado (
        name: Filtrar pelo produto selecionado
        execution {
            sequence: 5
        }
        when {
            selectionType: items
            items: P22_ADDIDPRODUTO
        }

        action filtrar-produto-js (
            action: executeJsCode
            settings {
                jsCode: "if (apex.item('P22_ADDIDPRODUTO').isChanged()) { apex.submit({ request: 'FILTRARPRODUTO', showWait: true }); }"
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction marcar-todas-cores-tamanhos (
        name: Marcar todas as cores/tamanhos
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action marcar-todas-js (
            action: executeJsCode
            settings {
                jsCode: "var vals = $('#P22_ADDIDSPRODDET input[type=checkbox]').map(function(){ return this.value; }).get(); apex.item('P22_ADDIDSPRODDET').setValue(vals); if (vals.length === 0 && $v('P22_ADDIDPRODUTO')) { $('#P22_ADDIDSPRODDET').append('<span class=\"u-success-text\"><span class=\"fa fa-check-circle\" aria-hidden=\"true\"></span> Todas as cores/tamanhos ativos deste produto já estão nesta edição (listadas abaixo).</span>'); }"
            }
            execution {
                sequence: 10
            }
        )

    )

    validation datafinal-data-válida (
        name: DATAFINAL data válida
        execution {
            sequence: 50
        }
        validation {
            type: itemIsAValidDate
            item: P22_DATAFINAL
            alwaysExecute: true
        }
        error {
            errorMessage: Data final deve ter uma data válida.
            associatedItem: @P22_DATAFINAL
        }
    )

    validation datafinal-obrigatória (
        name: DATAFINAL obrigatória
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P22_DATAFINAL
            alwaysExecute: true
        }
        error {
            errorMessage: Data final deve ter uma data válida.
            associatedItem: @P22_DATAFINAL
        }
    )

