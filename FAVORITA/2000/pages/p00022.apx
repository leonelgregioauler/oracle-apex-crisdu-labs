    region ciclos (
        name: Ciclos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                    select idcicloedicao                      
                         , numerociclo                        
                         , idedicaorevista                    
                         , datainicio                         
                         , datafim                            
                    from ciclosedicoes
                    where (idedicaorevista = :P22_IDEDICAOREVISTA or :P22_IDEDICAOREVISTA is null)
                ```
