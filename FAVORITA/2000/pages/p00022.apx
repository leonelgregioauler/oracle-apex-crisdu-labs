    process dml-grid-save-interactive-grid-data (
        name: DML Grid - Save Interactive Grid Data
        type: executeCode
        editableRegion: @produtos-da-edição-revista
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  --
                  vmd5                      VARCHAR2(4000);
                  vidprecoproduto           NUMBER;
                  vidproduto                NUMBER;
                  vvalorcomissaoatendente   NUMBER;
                  vcustofiscaligrejinha     NUMBER;
                  vcustofiscalcampogrande   NUMBER;
                  vcustofiscalbelem         NUMBER;
                  vcustofiscalmanaus        NUMBER;
                  vidfilial                 NUMBER;
                  videdicaorevista          NUMBER := :IDEDICAOREVISTA;
                  vidprodutodetalhado       NUMBER := :LISTPRODUTOS;
                  --
                BEGIN
                  --
                  IF :APEX$ROW_STATUS = 'U' THEN
                    UPDATE favorita.precosprodutos pr
                    SET pr.valorvenda = :VALORVENDA,
                        pr.valorcusto = :VALORCUSTO,
                        pr.perccomissaoconsultora = :PERCCOMISSAOCONSULTORA,
                        pr.perccomissaodistribuidor = :PERCCOMISSAODISTRIBUIDOR,
                        pr.perccomissaogerente = :PERCCOMISSAOGERENTE
                    WHERE pr.idprodutodetalhado = :IDPRODUTODETALHADO
                      AND pr.idedicaorevista = :IDEDICAOREVISTA;
                  END IF;
                  --
                  IF :APEX$ROW_STATUS = 'D' THEN
                    DELETE favorita.precosprodutos pr
                    WHERE pr.idprodutodetalhado = :IDPRODUTODETALHADO
                      AND pr.idedicaorevista = :IDEDICAOREVISTA;
                      
                    DELETE favorita.produtosdetedrevistas dt
                    WHERE dt.idprodutodetalhado = :IDPRODUTODETALHADO
                      AND dt.idedicaorevista = :IDEDICAOREVISTA;
                  END IF;
                  --
                  IF :APEX$ROW_STATUS = 'C' THEN
                    FOR rfil IN (SELECT fd.idfilial
                                  FROM favorita.filiaisedicoesrevistas fd
                                  WHERE fd.idedicaorevista = videdicaorevista) LOOP
                
                    vidfilial := rfil.idfilial;
                
                      favorita.pck_cadastros_fav.prc_precosprodutos(pidprecoproduto           => vidprecoproduto,
                                                                    pidedicaorevista          => videdicaorevista,
                                                                    pidproduto                => vidproduto,
                                                                    pidprodutodetalhado       => vidprodutodetalhado,
                                                                    pidfilialromance          => vidfilial,
                                                                    pvalorcusto               => :VALORCUSTO,
                                                                    pvalorvenda               => :VALORVENDA,
                                                                    pperccomissaogerente      => :PERCCOMISSAOGERENTE,
                                                                    pperccomissaodistribuidor => :PERCCOMISSAODISTRIBUIDOR,
                                                                    pperccomissaoconsultora   => :PERCCOMISSAOCONSULTORA,
                                                                    pvalorcomissaoatendente   => vvalorcomissaoatendente,
                                                                    pcustofiscaligrejinha     => vcustofiscaligrejinha,
                                                                    pcustofiscalcampogrande   => vcustofiscalcampogrande,
                                                                    pcustofiscalbelem         => vcustofiscalbelem,
                                                                    pcustofiscalmanaus        => vcustofiscalmanaus,
                                                                    pmd5                      => vmd5,
                                                                    poperacao_dml             => 'I' );
                
                    END LOOP;
                    --
                    favorita.pck_cadastros_fav.prc_inclui_produtosdetedrevistas(pidedicaorevista    => videdicaorevista,
                                                                                pidprodutodetalhado => vidprodutodetalhado,
                                                                                poperacao_dml       => 'I' );
                  --
                  END IF;
                  --
                  COMMIT;
                 --
                END;
                
                ```
        }
        execution {
            sequence: 70
        }
        successMessage {
            successMessage: Alterado com Sucesso!
        }
        advanced {
            executionMappingIdentifier: 1504203876909824628
        }
    )

    process exclui-preços-do-produto-para-esta-edição (
        name: Exclui preços do produto para esta edição
        type: executeCode
        editableRegion: @produtos-detalhados-revistas
        source {
            plsqlCode:
                ```plsql
                declare
                  vnumbernull   number;
                  vvarnull      varchar2(50);
                begin
                  --
                  for i in ( select * 
                             from precosprodutos pp 
                             where idedicaorevista = :P22_IDEDICAOREVISTA
                             and idprodutodetalhado = :IDPRODUTODETALHADO ) 
                               /*in ( select pd.idprodutodetalhado
                                                         from produtosdetalhados pd
                                                            , produtos p
                                                         where pd.idproduto = p.idproduto
                                                         and p.referencia = :P22_PRODUTODETALHADO 
                                                         and pd.idprodutodetalhado = pp.idprodutodetalhado ) */ 
                                                        
                  loop 
                    --
                    pck_cadastros_fav.prc_precosprodutos ( pidprecoproduto           => i.idprecoproduto
                                                         , pidedicaorevista          => vnumbernull
                                                         , pidproduto                => vnumbernull
                                                         , pidprodutodetalhado       => vnumbernull
                                                         , pidfilialromance          => vnumbernull
                                                         , pvalorcusto               => vnumbernull
                                                         , pvalorvenda               => vnumbernull
                                                         , pperccomissaogerente      => vnumbernull
                                                         , pperccomissaodistribuidor => vnumbernull
                                                         , pperccomissaoconsultora   => vnumbernull
                                                         , pvalorcomissaoatendente   => vnumbernull
                                                         , pcustofiscaligrejinha     => vnumbernull
                                                         , pcustofiscalcampogrande   => vnumbernull
                                                         , pcustofiscalbelem         => vnumbernull
                                                         , pcustofiscalmanaus        => vnumbernull
                                                         , pmd5                      => vvarnull
                                                         , poperacao_dml             => 'D');
                    --
                  end loop;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 1432891058168269601
        }
        serverSideCondition {
            type: request=Value
            value: EXCLUIRLINHA
            executeCondition: once
        }
    )

