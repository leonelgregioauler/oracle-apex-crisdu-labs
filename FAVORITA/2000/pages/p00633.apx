page 633 (
    name: Cadastro de Regionais Favorita
    title: Cadastro de Regionais Favorita
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region regional (
        name: Regional
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rowid,
                       f.idregionalfavorita, 
                       f.descricaoregionalfavorita
                  from favorita.regionaislojasfavorita f
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 2435409698960462305
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDREGIONALFAVORITA
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @DESCRICAOREGIONALFAVORITA
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @ROWID
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column DESCRICAOREGIONALFAVORITA (
            type: textarea
            heading {
                heading: Drecrição Regional
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
                maxLength: 150
            }
            source {
                databaseColumn: DESCRICAOREGIONALFAVORITA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column IDREGIONALFAVORITA (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IDREGIONALFAVORITA
                dataType: number
            }
            default {
                type: expression
                plsqlExpression: FAVORITA.SEQ_IDREGIONALFAVORITA.NEXTVAL;
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ROWID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ROWID
                dataType: rowid
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

    )

    process regional-save-interactive-grid-data (
        name: Regional - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @regional
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 2435410201246462311
        }
    )

)

