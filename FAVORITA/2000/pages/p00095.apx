page 95 (
    name: Posições de Atendimento
    title: Posições de Atendimento
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region posições-de-atendimento (
        name: Posições de Atendimento
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idposicaoatendimento
                     , codigo
                     , descricao
                     , idfilialfavorita
                  from posicoesatendimentos
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 15239311761368605
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDPOSICAOATENDIMENTO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @CODIGO
                layout {
                    width: 300
                    sequence: 2
                }
            )

            displayColumn (
                column: @DESCRICAO
                layout {
                    width: 400
                    sequence: 3
                }
            )

            displayColumn (
                column: @IDFILIALFAVORITA
                layout {
                    sequence: 4
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column CODIGO (
            type: textField
            heading {
                heading: Código
                alignment: center
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
                maxLength: 6
            }
            source {
                databaseColumn: CODIGO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column DESCRICAO (
            type: textarea
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 1000
            }
            source {
                databaseColumn: DESCRICAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column IDFILIALFAVORITA (
            type: selectList
            heading {
                heading: Filial Favorita
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) as d,
                           idfilialfavorita as r
                      from filiaisfavorita
                      where tipofilial in ('E', 'L', 'C')
                     order by 1
                    ```
                nullDisplayValue: - Selecione a Filial Favorita -
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: IDFILIALFAVORITA
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDPOSICAOATENDIMENTO (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDPOSICAOATENDIMENTO
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: SEQ_IDPOSICAOATENDIMENTO
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

    )

    validation codigo-obrigatório (
        name: CODIGO obrigatório
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @posições-de-atendimento
            type: columnIsNotNull
            column: CODIGO
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ter um valor.
            associatedColumn: CODIGO
        }
    )

    validation filialfavorita-obrigatório (
        name: FILIALFAVORITA obrigatório
        execution {
            sequence: 20
        }
        validation {
            editableRegion: @posições-de-atendimento
            type: columnIsNotNull
            column: IDFILIALFAVORITA
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ter um valor.
            associatedColumn: IDFILIALFAVORITA
        }
    )

    process save-interactive-grid-data (
        name: " - Save Interactive Grid Data"
        type: interactiveGridAutoRowProcessing
        editableRegion: @posições-de-atendimento
        execution {
            sequence: 10
        }
        error {
            errorMessage: Erro ao atualizar informações.
        }
        advanced {
            executionMappingIdentifier: 15242906907368608
        }
    )

)

