            associatedItem: @P88_IDESTOQUE
        }
    )

    validation quantidade-inteiro (
        name: QUANTIDADE inteiro
        execution {
            sequence: 90
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  verro varchar2(1000);
                begin
                  if instr(:P88_QUANTIDADE, ',') > 0 or
                     instr(:P88_QUANTIDADE,'.') > 0 then
                    --
                    return 'Quantidade deve ser um número inteiro';
                    --
                  else
                    null;
                  end if;
                end;
                ```
        }
        error {
            associatedItem: @P88_QUANTIDADE
        }
    )

    validation quantidade-maior-que (
        name: QUANTIDADE maior que 0
        execution {
            sequence: 100
        }
        validation {
            plsqlExpression: :P88_QUANTIDADE > 0
        }
        error {
            errorMessage: "Quantidade deve ser maior que zero (0) "
            associatedItem: @P88_QUANTIDADE
        }
        serverSideCondition {
            type: expression
            plsqlExpression: instr(:P88_QUANTIDADE, '.') = 0
        }
    )

    validation quantidade-obrigatório (
        name: QUANTIDADE obrigatório
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P88_QUANTIDADE
        }
        error {
            errorMessage: Quantidade deve ser informada.
            associatedItem: @P88_QUANTIDADE
        }
    )

    validation tipomovimento-obrigatório (
        name: TIPOMOVIMENTO obrigatório
        execution {
            sequence: 50
        }
        validation {
            type: itemIsNotNull
            item: P88_TIPOMOVIMENTO
        }
        error {
            errorMessage: Selecione o tipo de movimento.
            associatedItem: @P88_TIPOMOVIMENTO
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P88_FORMAMOVIMENTACAO = 'M' and v('REQUEST') = 'MOVIMENTAR'
        }
    )

    process processo-dml-para-movimentar-estoque (
        name: Processo DML para Movimentar Estoque
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  vquantidade          number;
                  vquantidadeentrada   number;
                  vidprodutodetalhado  number;
                  videstoquedefeito    number;
                  viditemdevolucao     number;
                  viditempedidotrocado number;
                begin
                  -- 
                  select idprodutodetalhado
                    into vidprodutodetalhado
                    from estoques 
                   where idestoque = :P88_IDESTOQUE;
                  --
                  :P88_IDPRODUTODETALHADO := vidprodutodetalhado;
                  --
                  if :P88_TIPOMOVIMENTO = 'S' or :P88_FORMAMOVIMENTACAO = 'C' then
                    vquantidade := to_number(:P88_QUANTIDADE)*-1;
                  else 
                    vquantidade := to_number(:P88_QUANTIDADE);
                  end if;
                  --
                  pck_estoque_fav.prc_movimentosestoques( pidestoque          => :P88_IDESTOQUE
                                                        , pidfilialfavorita   => :P88_IDFILIALFAVORITA
                                                        , pidusuario          => :P88_IDUSUARIO
