        name: MOTIVO obrigatório
        execution {
            sequence: 80
        }
        validation {
            type: itemIsNotNull
            item: P88_MOTIVO
        }
        error {
            errorMessage: Motivo deve ter um valor.
            associatedItem: @P88_MOTIVO
        }
    )

    validation produto-obrigatório (
        name: PRODUTO obrigatório
        execution {
            sequence: 60
        }
        validation {
            type: itemIsNotNull
