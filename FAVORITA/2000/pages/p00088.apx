    pageItem P88_IDDEFEITO (
        type: selectList
        label {
            label: Defeito
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.descricao as display_value
                     , d.iddefeito as return_value
                  from favorita.defeitos d
                 order by 1
                ```
            nullDisplayValue: - Selecione -
        }
        layout {
            sequence: 160
            region: @movimentar-estoque
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P88_IDESTOQUE (
        type: plugin/select
        label {
            label: Produto
            alignment: left
        }
        settings {
            width: 450
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.produtodetalhado    display_value
                     , w.idestoque           return_value
                from vw_estoques_fav w
                where w.idfilialfavorita = :P88_IDFILIALFAVORITA
                  and w.ididioma         = :P0_IDIDIOMA
                order by 1
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: [
                P88_IDFILIALFAVORITA
                P0_IDIDIOMA
            ]
        }
        layout {
            sequence: 50
            region: @movimentar-estoque
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P88_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Estoque
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomefilialfavorita display_value
                     , idfilialfavorita  return_value
                from vw_filiaisfavorita w
                where exists ( select 1
                               from usuariosfiliaisfavorita u
                               where u.idfilialfavorita = w.idfilialfavorita
                                 and u.movimentar = 'S'
                                 and u.idusuario = :P0_IDUSUARIO )
                order by 1
                ```
            nullDisplayValue: " - Selecione o Estoque- "
        }
        layout {
            sequence: 20
            region: @movimentar-estoque
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

