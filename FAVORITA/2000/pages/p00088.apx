    dynamicAction valida-embalagem-do-pedido (
        name: Valida Embalagem do Pedido
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P88_EMBALAGEM
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P88_EMBALAGEM
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      vidprodutodetalhado number := null;
                      videstoque          number := null;
                    begin
                      --
                      select pck_util_fav.fnc_validaembalagempedido ( pcodean => :P88_EMBALAGEM ) 
                      into vidprodutodetalhado
                      from dual;
                      --
                      if vidprodutodetalhado is null then
                        :P88_DESCRICAOEMBALAGEM := '<font color="red" size="4"> Embalagem não encontrada. Pedido não será montado. </font>';
                        :P88_VALIDAEMBALAGEM    := 'N';
                        :P88_IDESTOQUE          := '';
                      else
                        :P88_DESCRICAOEMBALAGEM := '';
                        :P88_VALIDAEMBALAGEM    := 'S';
                      end if;
                      --
                      select idestoque
                      into videstoque
                      from estoques 
                      where idprodutodetalhado = vidprodutodetalhado
                      and idfilialfavorita = :P88_IDFILIALFAVORITA;
                      --
                      :P88_IDESTOQUE := videstoque;
                      --
                    exception
                      when others then 
                        :P88_DESCRICAOEMBALAGEM := '<font color="red" size="3"> Embalagem do Pedido Inválida. Pedido não será montado.</font>';
                        :P88_VALIDAEMBALAGEM    := 'N';
                        :P88_IDESTOQUE          := '';
                    end;
                         
                    ```
                itemsToSubmit: [
                    P88_EMBALAGEM
                    P88_IDFILIALFAVORITA
                ]
                itemsToReturn: [
                    P88_DESCRICAOEMBALAGEM
                    P88_VALIDAEMBALAGEM
                    P88_IDESTOQUE
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: [
                    P88_DESCRICAOEMBALAGEM
                    P88_VALIDAEMBALAGEM
                    P88_IDESTOQUE
                ]
            }
            execution {
                sequence: 20
            }
        )

    )

    validation estoque-obrigatório (
        name: ESTOQUE obrigatório
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P88_IDFILIALFAVORITA
        }
        error {
            errorMessage: Estoque deve ter um valor.
            associatedItem: @P88_IDFILIALFAVORITA
        }
    )

    validation loja-entrada (
        name: LOJA ENTRADA
        execution {
            sequence: 120
        }
        validation {
            language: sql
            sqlExpression:
                ```sql
                   V('APP_USER') in ('MARIARIVEROS','RAFAELAAUSTRIA ','MAGDALENAOVELAR','LUCIAGUILLAUMA','BRUNASANTOS','HAYANES','NELIANES')  
                or (:P88_TIPOMOVIMENTO      = 'E' and :P88_TIPOFILIALUSUARIO != 'L')
                or (:P88_TIPOFILIALUSUARIO  = 'L' and :P88_TIPOMOVIMENTO != 'E')
                or (:P88_TIPOFILIALUSUARIO != 'L')
                -- essa condilção foi criada para atender o ticket 8815052, critérios: filial do usuário = Loja e seja loja fora do BRASIL
                or (:P88_TIPOFILIALUSUARIO  = 'L' and exists (select 1
                                                                from catal.filiais fr
                                                               where fr.ididioma != 1
                                                                 and fr.idfilial = ( select ff.idfilialromance
                                                                                       from favorita.filiaisfavorita ff
                                                                                      where ff.idfilialfavorita = :P88_IDFILIALFAVORITA)))
                ```
            alwaysExecute: true
        }
        error {
            errorMessage: Loja nao pode realizar esse tipo de movimentação
        }
    )

    validation motivo-maior-que-20-caracteres (
        name: MOTIVO maior que 20 caracteres
        execution {
            sequence: 70
        }
        validation {
            plsqlExpression: length(:P88_MOTIVO) > 20
        }
        error {
            errorMessage: Motivo deve ter mais do que 20 caracteres.
            associatedItem: @P88_MOTIVO
        }
    )

