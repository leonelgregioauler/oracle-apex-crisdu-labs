    dynamicAction atualizar-lista-de-defeitos (
        name: Atualizar Lista de Defeitos
        execution {
            sequence: 80
        }
        when {
            selectionType: items
            items: P88_DESTINO
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P88_IDDEFEITO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction forma-de-movimentação-código-de-barras (
        name: Forma de Movimentação (Código de Barras)
        execution {
            sequence: 70
        }
        when {
            selectionType: items
            items: P88_FORMAMOVIMENTACAO
        }
        clientSideCondition {
            type: item=value
            item: P88_FORMAMOVIMENTACAO
            value: C
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P88_TIPOMOVIMENTO
            }
            execution {
                sequence: 20
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: [
                    P88_DESCRICAOEMBALAGEM
                    P88_VALIDAEMBALAGEM
                    P88_IDESTOQUE
                ]
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            affectedElements {
                selectionType: items
                items: [
                    P88_IDESTOQUE
                    P88_EMBALAGEM
                    P88_DESCRICAOEMBALAGEM
                ]
            }
            execution {
                sequence: 30
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P88_QUANTIDADE
                    P88_EMBALAGEM
                    P88_DESCRICAOEMBALAGEM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

