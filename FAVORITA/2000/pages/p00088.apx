page 88 (
    name: Movimentações de Estoque
    title: Movimentações de Estoque
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function confirmaitem(event)
            {
             var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
             console.log (tecla);
             if (tecla==13) 
             { 
              var answer = confirm("Confirma inclusão do item no estoque?")
              if (answer)
              {
                apex.submit('CREATE');
              }
             } 
              else 
              { if([190,188,110,194].indexOf(tecla) !=-1) 
                {
                 alert('Informe uma Quantidade Válida!'); 
                 return false;
                }
              }
            }
            
            function tem_casas_decimais(valor)
            {
             if (typeof(valor) != 'String')
              valor = valor.toString();
            
             return valor.match(/[.,]/) != null;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region movimentar-estoque (
        name: Movimentar Estoque
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P88_DESCRICAOEMBALAGEM (
