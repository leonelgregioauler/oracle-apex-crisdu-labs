page 315 (
    name: Programação de Entrega
    title: Programação de Entrega
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG_26"';
            
            function fnc_programacao(pid)
            {
              document.getElementById("P315_IDEDITAR").value = pid;
              apex.submit('DESFAZER');
            }
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region entregas-programadas (
        name: Entregas Programadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idcompratransferencia
                     , c.numero
                     , c.dataemissao
                     , c.dataprevisaoentrega
                     , c.observacao
                     , '<a href="javascript:fnc_programacao('|| idcompratransferencia ||')" ><img src="#APP_IMAGES#Deslike.png"  border="0"></a>' DESFAZER
                from comprastransferencias c
                where exists ( select 1
                               from programacoesentregas p
                               where p.idcompratransferencia = c.idcompratransferencia )
                  and exists ( select 1
                               from orcamentosfretecomprastransf oc
                               where oc.idcompratransferencia = c.idcompratransferencia
                                 and oc.idtransportadora      = :P315_IDTRANSPORTADORA
                                 and oc.utilizado             = 'S' )
                  and c.idsituacao < 7
                order by 1 
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P315_IDTRANSPORTADORA
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 1403480286823340211
        }

        column DATAEMISSAO (
            type: plainText
            heading {
                heading: Emissão
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column DATAPREVISAOENTREGA (
            type: plainText
            heading {
                heading: Previsão Entrega
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        column DESFAZER (
            type: plainText
            heading {
                heading: Desfazer Programação
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDCOMPRATRANSFERENCIA (
            type: plainText
            heading {
                heading: Cód. Remessa
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column NUMERO (
            type: plainText
            heading {
                heading: Número
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column OBSERVACAO (
            type: plainText
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        savedReport 14035025 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAEMISSAO (
                sequence: 3
            )

            displayColumn DATAPREVISAOENTREGA (
                sequence: 4
            )

            displayColumn DESFAZER (
                sequence: 6
            )

            displayColumn IDCOMPRATRANSFERENCIA (
                sequence: 1
            )

            displayColumn NUMERO (
                sequence: 2
            )

            displayColumn OBSERVACAO (
                sequence: 5
            )

        )

    )

    region programar-entrega (
        name: Programar Entrega
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region programação-de-entrega (
        name: Programação de Entrega
        type: tabform
        source {
            sqlQuery:
                ```sql
                select c.idcompratransferencia
                     , c.numero
                     , null observacao
                from comprastransferencias c
                where not exists ( select 1
                                   from orcamentosfretecomprastransf ofc
                                   where ofc.idcompratransferencia = c.idcompratransferencia
                                     and ofc.utilizado             = 'S' )
                  and c.idtipocomptransrem in ( 2,3,4 )
                  and ( ( :P315_DESTINO = 'F' and ( c.idfilialromancedestino = :P315_IDFILIALROMANCE
                                                  and c.idpostoavancadodestino is null ) )
                       or ( :P315_DESTINO = 'P' and c.idpostoavancadodestino = :P315_IDPOSTOAVANCADO ) )
                  and c.analiseconcluida = 'N'
                  and c.idsituacao <> -1
                order by 2
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P315_IDTRANSPORTADORA
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @/standard
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 4
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column IDCOMPRATRANSFERENCIA (
            reportColumnQueryId: 1
            derivedColumn: N
            type: textField
            heading {
                heading: Cód. Remessa
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
            appearance {
                width: 10
            }
            sorting {
                sortable: false
            }
            advanced {
                customAttributes: readonly
            }
        )

        column NUMERO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Número da Remessa
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

        column OBSERVACAO (
            reportColumnQueryId: 3
            derivedColumn: N
            type: textField
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 4
            }
            appearance {
                width: 75
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P315_DESTINO (
        type: radioGroup
        label {
            label: Destino
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Filial Romance;F,Posto Avançado;P
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @programar-entrega
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: F
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P315_IDEDITAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @entregas-programadas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P315_IDFILIALROMANCE (
        type: selectList
        label {
            label: Filial Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome display_value
                     , f.idfilial return_value
                from roman.vw_filiais f
                where f.tipofilial = 'D'
                  and f.ativo = 'S'
                  and exists ( select 1
                               from comprastransferencias c
                               where c.idfilialromancedestino = f.idfilial )
                order by 1
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 20
            region: @programar-entrega
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P315_IDPOSTOAVANCADO (
        type: selectList
        label {
            label: Posto Avançado
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nome
                     , p.idpostoavancado
                from roman.postoavancado p
                order by 1
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 30
            region: @programar-entrega
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P315_IDTRANSPORTADORA (
        type: popupLov
        label {
            label: Transportadora
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomepessoa(idpessoa) display_value
                     , t.idtransportadora return_value
                from transportadoras t
                where t.ativo = 'S'
                order by 1
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 40
            region: @programar-entrega
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Programar Entregas
        layout {
            sequence: 10
            region: @programação-de-entrega
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction recarrega (
        name: Recarrega
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P315_IDTRANSPORTADORA
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P315_IDTRANSPORTADORA
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: PROGRAMAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction tipo-destino (
        name: Tipo Destino
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P315_DESTINO
        }
        clientSideCondition {
            type: item=value
            item: P315_DESTINO
            value: F
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P315_IDPOSTOAVANCADO
            }
            execution {
                sequence: 20
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P315_IDFILIALROMANCE
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P315_IDFILIALROMANCE
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P315_IDPOSTOAVANCADO
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

    )

    process desfazer-entrega-de-remessas (
        name: Desfazer Entrega de Remessas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vobservacao varchar2(1000);
                begin
                  -- Call the procedure
                  pck_comprastransf_fav.prc_programarentregasremessas(pidcompratransferencia => :P315_IDEDITAR,
                                                                      pidtransportadora => :P315_IDTRANSPORTADORA,
                                                                      pidusuario => :P0_IDUSUARIO,
                                                                      pobservacao => vobservacao,
                                                                      poperacao_dml => 'D');
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Programação desfeita com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1403481053840340219
        }
        serverSideCondition {
            type: request=Value
            value: DESFAZER
        }
    )

    process programa-entrega-de-remessas (
        name: Programa Entrega de Remessas
        type: executeCode
        editableRegion: @programação-de-entrega
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_comprastransf_fav.prc_programarentregasremessas(pidcompratransferencia => :idcompratransferencia,
                                                                      pidtransportadora => :P315_IDTRANSPORTADORA,
                                                                      pidusuario => :P0_IDUSUARIO,
                                                                      pobservacao => :OBSERVACAO,
                                                                      poperacao_dml => 'I');
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Programação efetuada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1403479366451340202
        }
        serverSideCondition {
            type: request=Value
            value: SUBMIT
        }
    )

    branch (
        name: Go To Page 315
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 315
                items: {
                    P315_DESTINO: &P315_DESTINO.
                    P315_IDFILIALROMANCE: &P315_IDFILIALROMANCE.
                    P315_IDPOSTOAVANCADO: &P315_IDPOSTOAVANCADO.
                    P315_IDTRANSPORTADORA: &P315_IDTRANSPORTADORA.
                }
            }
        }
        serverSideCondition {
            type: request=Value
            value: PROGRAMAR
        }
    )

)

