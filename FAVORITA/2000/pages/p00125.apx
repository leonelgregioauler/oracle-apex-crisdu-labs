page 125 (
    name: Anexar Arquivo Controle SAC
    title: Anexar Arquivo
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function deletaanexo(pid)
            {
            
              var answer = confirm("Confirma exlusão do Anexo?")
              if (answer)
                {
                  document.getElementById('P125_DELETAR').value = pid;
                  apex.submit('DELETAR');
                }
            }
            
            
            
            ```
    }

    region anexar-arquivo (
        name: Anexar Arquivo
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    region arquivos-anexados (
        name: Arquivos Anexados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.idanexocontrolecontatosite,
                       a.idcontrolecontatossite,
                       attach_data,
                       attach_mimetype,
                       attach_filename,
                       attach_last_update,
                       attach_charset,
                       round(sys.dbms_lob.getlength(attach_data)/1024,2)||' kb' file_length,
                       sys.dbms_lob.getlength(attach_data) download,
                       '<a href="javascript: deletaanexo('||a.idanexocontrolecontatosite||')"> Excluir </a>' remover
                from roman.anexoscontrolecontatossite a
                where a.idcontrolecontatossite = :P125_IDCONTROLECONTATOSSITE;
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.anexoscontrolecontatossite a
                where a.idcontrolecontatossite = :P125_IDCONTROLECONTATOSSITE;
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 28326477700468504
        }

