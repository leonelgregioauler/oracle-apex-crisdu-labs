            pkColumn: IDANEXOCONTROLECONTATOSITE
            pkItem: P125_IDANEXOCONTRCONTATOSITE
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Não encontrou informações.
        }
        advanced {
            executionMappingIdentifier: 15757224923040774
        }
    )

    process getpk (
        name: GetPK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P125_IDANEXOCONTRCONTATOSITE is null then
                        select ROMAN.seq_idanexocontrolecontatosite.nextval
                          into :P125_IDANEXOCONTRCONTATOSITE
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 15953834060982245
        }
        serverSideCondition {
            whenButtonPressed: @inserir
        }
    )

    process process-row-of-anexoscontrolecontatossite (
        name: Process Row of ANEXOSCONTROLECONTATOSSITE
        type: autoRowProcessing
        target {
            tableOwner: ROMAN
            tableName: ANEXOSCONTROLECONTATOSSITE
            pkColumn: IDANEXOCONTROLECONTATOSITE
            pkItem: P125_IDANEXOCONTRCONTATOSITE
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 15757682597040774
        }
    )

    branch (
        name: Go To Page 125
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 125
                items: {
                    P125_IDCONTROLECONTATOSSITE: &P125_IDCONTROLECONTATOSSITE.
                    P125_IDANEXOCONTRCONTATOSITE:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 125
                items: {
                    P125_IDANEXOCONTRCONTATOSITE:
                    P125_IDCONTROLECONTATOSSITE: &P125_IDCONTROLECONTATOSSITE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @inserir
        }
    )

)

