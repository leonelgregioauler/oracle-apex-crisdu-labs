    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 30
            region: @anexar-arquivo
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P125_IDANEXOCONTRCONTATOSITE
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 20
            region: @anexar-arquivo
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-reply
        }
        behavior {
            action: redirectThisApp
            target: {
                page: &P125_VOLTARPARA.
                items: {
                    P124_IDCONTROLECONTATOSSITE: &P125_IDCONTROLECONTATOSSITE.
                    P626_IDCONTROLECONTATOSSITE: &P125_IDCONTROLECONTATOSSITE.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process deletar (
        name: DELETAR
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  delete roman.anexoscontrolecontatossite
                  where idanexocontrolecontatosite = :P125_DELETAR; 
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 28327753816468517
        }
    )

    process fetch-row-from-anexoscontrolecontatossite (
        name: Fetch Row from ANEXOSCONTROLECONTATOSSITE
        type: autoRowFetch
        source {
            tableOwner: ROMAN
