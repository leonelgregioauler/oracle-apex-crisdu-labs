    region ticket-médio-loja (
        name: Ticket Médio Loja
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomefilialfavorita(p.idfilialfavorita) as "Loja",
                       sum(sd.valorapagar * p.fatorconversao) as "Valor a Pagar",
                       count(p.idpedido) as "Qtd. Pedidos",
                       (sum(sd.valorapagar * p.fatorconversao) / count(p.idpedido)) as "Ticket Médio"
                  from ( select sum(v.valorpagar) valorapagar
                              , v.idpedido
                         from vencimentospedidos v
                         where v.situacaovencimento = 'V'
                         group by idpedido ) sd,
                       favorita.pedidos p,
                       favorita.filiaisfavorita f
                 where p.idfilialfavorita = f.idfilialfavorita
                   and sd.idpedido (+) = p.idpedido
                   and f.tipofilial = 'L'
                   and p.tipopedido <> 'R' --pedidos da Romance Casa são feitos na loja (antigamente não)
                   and trunc(p.dataemissao) between :P632_DATA_INICIAL and :P632_DATA_FINAL
                   and p.datacancelamento is null
                   and (:P632_ID_FILIAL is null or f.idfilialfavorita = :P632_ID_FILIAL)
                   -- 9867188 - Maicon Aimi - 24/03/2025 -- Adicionado a coluna para filtrar pedidos CANCELADO
                   and (   (:P632_CANCELADOS is null)
                        or (:P632_CANCELADOS = 'N' and p.datacancelamento is null)
                        or (:P632_CANCELADOS = 'S' and not p.datacancelamento is null))
                   and (:P632_ID_REGIONAL is null or exists (select 1
                                                               from favorita.filiaisfavorita f2
                                                              where f2.idfilialfavorita = p.idfilialfavorita
                                                                and f2.idregionalfavorita = :P632_ID_REGIONAL))
                
                   and p.valortotal > 0             
                 group by p.idfilialfavorita;
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
