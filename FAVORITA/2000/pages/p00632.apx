    pageItem P632_ID_FILIAL (
        type: selectList
        label {
            label: Loja Favorita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomefilialfavorita(f.idfilialfavorita) || ' - ' || nvl(r.descricaoregionalfavorita,'(Regional Não Cadastrada)') display_item,
                       f.idfilialfavorita return_item
                  from favorita.filiaisfavorita f,
                       favorita.regionaislojasfavorita r
                 where r.idregionalfavorita(+) = f.idregionalfavorita
                   and f.tipofilial = 'L';
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 40
            region: @filtrar
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P632_ID_REGIONAL (
        type: selectList
        label {
            label: Regional
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.descricaoregionalfavorita display_value,
                       f.idregionalfavorita return_value
                  from favorita.regionaislojasfavorita f
                 order by f.descricaoregionalfavorita;
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 30
            region: @filtrar
            slot: regionBody
            alignment: left
        }
        appearance {
