page 25 (
    name: Relatório de Situações Financeiro
    title: Situações Financeiro
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region situações-financeiro (
        name: Situações Financeiro
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idsituacaofinanceiro
                     , ididioma
                     , descricaosistema
                     , textotraduzidotextointerno
                     , descricaosite
                     , textotraduzidoexterno
                     , codigocor
                     , idtextosistema
                     , idtextosite
                from vw_situacoesfinanceiro_fav W
                where ididioma = :P0_IDIDIOMA
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 12488998794301250
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDSITUACAOFINANCEIRO
                layout {
                    width: 83
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDIDIOMA
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @DESCRICAOSISTEMA
                layout {
                    width: 159
                    sequence: 3
                }
            )

            displayColumn (
                column: @DESCRICAOSITE
                layout {
                    width: 156
                    sequence: 6
                }
            )

            displayColumn (
                column: @IDTEXTOSISTEMA
                layout {
                    width: 246
                    sequence: 5
                }
            )

            displayColumn (
                column: @IDTEXTOSITE
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @TEXTOTRADUZIDOTEXTOINTERNO
                layout {
                    width: 150
                    sequence: 4
                }
            )

            displayColumn (
                column: @TEXTOTRADUZIDOEXTERNO
                layout {
                    width: 156
                    sequence: 7
                }
            )

            displayColumn (
                column: @CODIGOCOR
                layout {
                    width: 118
                    sequence: 2
                }
            )

        )

        column CODIGOCOR (
            type: htmlExpression
            heading {
                heading: Codigocor
            }
            settings {
                htmlExpression: <font size="2" color="&CODIGOCOR.">&CODIGOCOR.</font>
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: CODIGOCOR
                dataType: varchar2
            }
        )

        column DESCRICAOSISTEMA (
            type: textarea
            heading {
                heading: Descrição Sistema
                alignment: center
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
                maxLength: 200
            }
            source {
                databaseColumn: DESCRICAOSISTEMA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column DESCRICAOSITE (
            type: textarea
            heading {
                heading: Descrição Site
            }
            layout {
                sequence: 70
            }
            validation {
                valueRequired: true
                maxLength: 200
            }
            source {
                databaseColumn: DESCRICAOSITE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column IDIDIOMA (
            type: hidden
            layout {
                sequence: 20
            }
            source {
                databaseColumn: IDIDIOMA
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDSITUACAOFINANCEIRO (
            type: link
            heading {
                heading: Editar
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 26
                    items: {
                        P26_IDSITUACAOFINANCEIRO: &IDSITUACAOFINANCEIRO.
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                databaseColumn: IDSITUACAOFINANCEIRO
                dataType: number
            }
        )

        column IDTEXTOSISTEMA (
            type: link
            heading {
                heading: Tradução Sistema
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            link {
                target: {
                    page: 100
                    items: {
                        P100_IDTEXTOTRADUZIDO: &IDTEXTOSISTEMA.
                    }
                    action: resetPagination
                }
                linkText: <b>Visualizar / Atualizar texto traduzido</b>
                linkAttributes: class="t-Button t-Button--sucess"
            }
            source {
                databaseColumn: IDTEXTOSISTEMA
                dataType: number
            }
        )

        column IDTEXTOSITE (
            type: link
            heading {
                heading: Tradução Site
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            link {
                target: {
                    page: 100
                    items: {
                        P100_IDTEXTOTRADUZIDO: &IDTEXTOSITE.
                    }
                    action: resetPagination
                }
                linkText: <b>Visualizar / Atualizar texto traduzido</b>
                linkAttributes: class="t-Button t-Button--sucess"
            }
            source {
                databaseColumn: IDTEXTOSITE
                dataType: number
            }
        )

        column TEXTOTRADUZIDOEXTERNO (
            type: textarea
            heading {
                heading: Tradução Site
                alignment: center
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: TEXTOTRADUZIDOEXTERNO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column TEXTOTRADUZIDOTEXTOINTERNO (
            type: textarea
            heading {
                heading: Tradução Sistema
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: TEXTOTRADUZIDOTEXTOINTERNO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @opções
            slot: top
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 26
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button novo-2 (
        buttonName: Novo
        label: Novo
        layout {
            sequence: 10
            region: @situações-financeiro
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 26
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

