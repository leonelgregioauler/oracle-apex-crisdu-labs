    dynamicAction valida-embalagem-do-pedido (
        name: Valida Embalagem do Pedido
        execution {
            sequence: 21
        }
        when {
            selectionType: items
            items: P327_EMBALAGEM
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P327_EMBALAGEM
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      vidprodutodetalhado number := null;
                    begin
                      --
                      select pck_util_fav.fnc_validaembalagempedido ( pcodean => :P327_EMBALAGEM ) 
                      into vidprodutodetalhado
                      from dual;
                      --
                      if vidprodutodetalhado is null then
                        :P327_DESCRICAOEMBALAGEM := '<font color="red" size="5"> &nbsp&nbsp&nbsp&nbsp Embalagem não encontrada. Pedido não será montado. </font>';
                        :P327_VALIDAEMBALAGEM    := 'N';
                      else
                        :P327_DESCRICAOEMBALAGEM := pck_util_fav.fnc_nomeprodutodetalhado ( vidprodutodetalhado, :P0_IDIDIOMA );
                        :P327_VALIDAEMBALAGEM    := 'S';
                      end if;
                      --
                    exception
                      when others then 
                        :P327_DESCRICAOEMBALAGEM := '<font color="red" size="4"> &nbsp&nbsp&nbsp&nbsp Embalagem do Pedido Inválida. Pedido não será montado.</font>';
                        :P327_VALIDAEMBALAGEM    := 'N';
                    end;
                         
                    ```
                itemsToSubmit: P327_EMBALAGEM
                itemsToReturn: [
                    P327_DESCRICAOEMBALAGEM
                    P327_VALIDAEMBALAGEM
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

