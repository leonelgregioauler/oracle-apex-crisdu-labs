    process montarpedido (
        name: MONTARPEDIDO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    vidusuario            number         := :P0_IDUSUARIO;
                    vnumeropedido         varchar2(100)  := :P327_NUMEROPEDIDO;
                    vcodbarraspedido      varchar2(100)  := :P327_CODBARRASPEDIDO;
                    vidpedidoetiqueta     number;
                    vcodean               number         := :P327_EMBALAGEM;
                    vidpedidofolha        number;
                    verro                 varchar2(1000);
                    vlibera_bipar_folha   number;
                    vembala               varchar2(1) := :P327_VALIDAEMBALAGEM;
                begin
                
                  select substr(vcodbarraspedido,2,length(vcodbarraspedido)-3)
                  into vidpedidofolha
                  from dual;
                
                  -- Maicon e Tamires Bauer fizeram o ajuste de -5 para -3
                  --select substr(vnumeropedido,2,length(vnumeropedido)-5)
                  select substr(vnumeropedido,2,length(vnumeropedido)-5)
                  into vidpedidoetiqueta
                  from dual;
                
                  select count(1)
                  into vlibera_bipar_folha
                  from pedidosremessasct pr,
                       comprastransferencias c
                  where pr.idcompratransferencia = c.idcompratransferencia
                  and exists (select 1
                             from classificacoescomprastransf cf
                             where cf.idcompratransferencia = c.idcompratransferencia
                             and cf.idcaracteristicacomptransf = 24)
                  and pr.idpedido = vidpedidoetiqueta;
                
                  if vidpedidofolha = null and vlibera_bipar_folha > 0 then
                    vidpedidofolha := vidpedidoetiqueta;
                  end if;
                
                  if vidusuario is null then
                    select idusuario
                      into vidusuario
                      from usuarios
                     where usuario = v('APP_USER');
                  end if;
                
                  -- alterado para já enviar o IDPEDIDO
                  :P327_NUMEROPEDIDO := null;
                  :P327_CODBARRASPEDIDO := null;
                
                
                  if vembala = 'S' then
                
                    pck_movimentarpedidos_fav.prc_montapedidos(pidpedidofolha    => vidpedidofolha,
                                                               pcodean           => vcodean,
                                                               pidpedidoetiqueta => vidpedidoetiqueta,
                                                               pidusuario        => vidusuario);
                  end if;                                                                                    
                  
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1821044471650466194
        }
        serverSideCondition {
            type: request=Value
            value: MONTARPEDIDO
