page 557 (
    name: Produtos Detalhados para Custo VA
    title: Produtos Detalhados para Custo VA
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <font color='blue'>- Lista de Produtos é baseada na Edição Geral de Lojas</font><br>
                <font color='green'>- Preços listados é baseado na Franquia de Igrejinha</font>
                ```
        }
    )

    region relação-de-produtos (
        name: Relação de Produtos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select aux.idprodutodetalhado
                     , aux.referencia
                     , aux.produto
                     , aux.cd_produto
                     , aux.valor_venda
                     , aux.custo_sugerido
                     /* Maicon Aimi - 11/09/2024 - 9220005
                        Adicionado a coluna Custo Produto conforme regra loucas passadas pelo MARCELOMELLO*/
                     , nvl(aux.custo_produto_edicao_20,custo_produto_edicao_10) custo_produto
                     , (aux.custo_sugerido * 0.6) custo_produto_60
                     , (nvl(aux.custo_produto_edicao_20,custo_produto_edicao_10) * :P557_MULTIPLICADORCUSTOPRODUTO) custo_produto_param
                  from (select p.idprodutodetalhado
                             , pck_util_fav.fnc_referenciaprodutodetalhado(p.idprodutodetalhado) referencia
                             , p.produto produto
                             , nvl( ( select dep.skuvirtualage
                                        from deparaprodfavoritavirtualage dep
                                       where dep.idprodutodetalhado = p.idprodutodetalhado ), 6000000 + p.idprodutodetalhado ) cd_produto
                             , ( select (pp.valorvenda)
                                   from precosprodutos pp
                                  where pp.idprodutodetalhado = p.idprodutodetalhado
                                    and pp.idfilialromance = 200
                                    and pp.idedicaorevista = 56 ) valor_venda
                             , round(( select (pp.valorvenda)
                                         from precosprodutos pp
                                        where pp.idprodutodetalhado = p.idprodutodetalhado
                                          and pp.idfilialromance = 200
                                          and pp.idedicaorevista = 56 ) * 0.70,2) custo_sugerido
                               /* Maicon Aimi - 11/09/2024 - 9220005
                                  Adicionado a coluna Custo Produto conforme regra loucas passadas pelo MARCELOMELLO*/
                             , (select pp.valorcusto
                                  from favorita.precosprodutos pp
                                 where pp.idprodutodetalhado = p.idprodutodetalhado
                                   and pp.idedicaorevista = 56 -- edição (Edição Geral Lojas Brasil)
                                   and pp.idfilialromance = 100
                                   and rownum = 1) custo_produto_edicao_20
                             , (select pp.valorcusto
                                  from favorita.precosprodutos pp
                                 where pp.idprodutodetalhado = p.idprodutodetalhado
                                   and pp.idedicaorevista = 63 -- edição (Edição Compra)
                                   and pp.idfilialromance = 100
                                   and rownum = 1) custo_produto_edicao_10
                          from vw_produtosdetalhados_fav p
                         where p.ididioma = 1
                           and exists ( select 1
                                          from precosprodutos pp
                                         where pp.idprodutodetalhado = p.idprodutodetalhado
                                           and pp.idfilialromance = 200
                                           and pp.idedicaorevista = 56 )
                           and ( :P557_IDFORNECEDOR = -1 or exists ( select 1
                                                                       from fornecedoresprodutos fp
                                                                      where fp.idproduto = p.idproduto 
                                                                        and fp.idfornecedor = :P557_IDFORNECEDOR ))) aux
                ```
            pageItemsToSubmit: P557_IDFORNECEDOR
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: "Nenhum produto encontrado, verifique o fornecedor. "
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 233352997985640567
        }

        column CD_PRODUTO (
            type: plainText
            heading {
                heading: SKU Virtual
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column CUSTO_PRODUTO (
            type: plainText
            heading {
                heading: Custo Produto
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column CUSTO_PRODUTO_60 (
            type: plainText
            heading {
                heading: Custo Produto 60
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: I
            }
        )

        column CUSTO_PRODUTO_PARAM (
            type: plainText
            heading {
                heading: Custo Produto Param
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: J
            }
        )

        column CUSTO_SUGERIDO (
            type: plainText
            heading {
                heading: Custo Sugerido
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column IDPRODUTODETALHADO (
            type: plainText
            heading {
                heading: Produto Detalhado
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column PRODUTO (
            type: plainText
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

