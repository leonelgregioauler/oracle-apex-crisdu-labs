        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 1345011 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CD_PRODUTO (
                sequence: 4
            )

            displayColumn CUSTO_PRODUTO (
                sequence: 7
            )

            displayColumn CUSTO_PRODUTO_60 (
                sequence: 8
            )

            displayColumn CUSTO_PRODUTO_PARAM (
                sequence: 9
            )

            displayColumn CUSTO_SUGERIDO (
                sequence: 6
            )

            displayColumn IDPRODUTODETALHADO (
                sequence: 1
            )

            displayColumn PRODUTO (
                sequence: 3
            )

            displayColumn REFERENCIA (
                sequence: 2
            )

            displayColumn VALOR_VENDA (
                sequence: 5
            )

            sort (
                column: IDPRODUTODETALHADO
                sort {
                    sequence: 1
                }
            )

        )

    )

    pageItem P557_IDFORNECEDOR (
        type: popupLov
        label {
            label: Fornecedor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefornecedor(f.idfornecedor) d
                     , f.idfornecedor r
                from fornecedores f
                where exists ( select 1
                               from fornecedoresprodutos ff
                               where ff.idfornecedor = f.idfornecedor )
                order by 1
                ```
            nullDisplayValue: - Mostrar Todos -
            nullReturnValue: -1
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P557_MULTIPLICADORCUSTOPRODUTO (
        type: hidden
        layout {
            sequence: 10
            region: @relação-de-produtos
            slot: regionBody
        }
    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P557_IDFORNECEDOR
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @relação-de-produtos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process busca-parametro (
        name: BUSCA PARAMETRO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    
                    -- busca parametro
                    begin
                        select valor
                          into :P557_MULTIPLICADORCUSTOPRODUTO
                          from favorita.parametros pp
                         where pp.nome = 'MULTIPLICADORCUSTOPRODUTO';
                    exception
                        when others then
                            :P557_MULTIPLICADORCUSTOPRODUTO := '1,89';
                    end;
                
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 47148480218635318
        }
    )

)

