page 208 (
    name: Detalhes dos Pagamentos
    title: Detalhes dos Pagamentos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 80%
        height: 60%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function imprimeboleto()
            {
              var idpedido = document.getElementById("P208_IDPEDIDO").value;
              var idvendedora = document.getElementById("P208_IDVENDEDORA").value;
                
              /*vurl = 'https://boleto.romancemoda.com.br/boleto_bb_favorita_sem_iframe_com_pix_v2.php?cod1='+idpedido+'&cod2='+idvendedora;*/
              vurl = document.getElementById('P0_URLBOLETOBASE').value+'?cod1='+idpedido+'&cod2='+idvendedora;
              pjan = window.open(vurl,'boleto','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1024,height=1000,left=20,top=10','_blank'); 
              pjan.focus();
            }
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region pagamentos (
        name: Pagamentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pp.idpagamentopedido
                     , pf.formapagamento
                     , pf.datapagamento
                     , pf.valorpago
                     , pf.situacaopagamento
                     , pf.observacao
                     , pp.attach_data
                     , pp.attach_mimetype
                     , pp.attach_filename
                     , pp.attach_last_update
                     , pp.attach_charset
                     , round(sys.dbms_lob.getlength(pp.attach_data)/1024,2)||' kb' file_length
                     , case
                         when length(attach_data) = 1 then null
                       else
                         sys.dbms_lob.getlength(pp.attach_data)
                       end download
                     , case 
                         when pf.idformapagamento in (1,26,27,34,36,37,43) and pf.idsituacao is null then
                           --'<a href="http://boletos.romancemoda.com.br:7777/boleto/boleto_bb_favorita_novo.php?cod1='||v.idpedido||'&cod2='||v.idvendedora||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' 
                           '<a href=javascript:imprimeboleto();><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' 
                         else
                          '-'
                       end url
                     , case
                         when length(attach_data) = 1 then
                           'Foto Recebida'
                         else
                           pf.numerocomprovante
                       end numerocomprovante
                     , nvl(pck_util_fav.fnc_nomeusuario(pf.idusuariopagamento),'Automático') usuariopagamento
                     , pp.databaixa
                     , ( select log.dataalteracao
                         from logfavorita.log_pagamentospedidos log
                         where log.idpagamentopedido = pp.idpagamentopedido
                           and log.tipoalteracao  = 'INSERT'
                          order by log.dataalteracao asc
                         fetch first 1 row only) dadainsert
                     , nvl(pf.chavepix, pf.EMVQRCODE)  chavepix   
                     , pp.acrescimo
                     , pp.desconto
                     , pp.valorliquido
                     , pp.linkcartaocredito
                from pagamentospedidos pp
                   , vw_pagamentospedidos_fav pf
                where pp.idpagamentopedido = pf.idpagamentopedido
                  and ( pf.idvencimentopedido = :P208_IDVENCIMENTOPEDIDO
                  /*or exists ( select 1
                              from vencimentospedidos vp
                              where vp.idvencimentopedido = pp.idvencimentopedido 
                              and vp.idpedido = :P208_IDPEDIDO
                              and vp.situacaovencimento = 'V')*/ )
                  and pf.ididioma = :P0_IDIDIOMA
                order by pf.idpagamentopedido
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
