            plsqlFunctionBody:
                ```plsql
                declare 
                  vidvendedora number;
                begin
                  --
                  select idvendedora
                  into vidvendedora
                  from pedidos p
                  where p.idpedido = :P208_IDPEDIDO;
                  --
                  return vidvendedora;
                  --
                end;
                ```
            used: always
        }
        security {
