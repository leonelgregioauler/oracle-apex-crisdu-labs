    pageItem P208_IDPEDIDO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @pagamentos
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vidpedido number;
                begin
                  --
                  select idpedido
                  into vidpedido 
                  from vencimentospedidos v
                  where v.idvencimentopedido = :P208_IDVENCIMENTOPEDIDO;
                  --
                  return vidpedido;
                  --
                end;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

