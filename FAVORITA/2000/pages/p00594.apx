    region jaentregues (
        name: JaEntregues
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select SEQ_ID, 
                       C001 IDPEDIDO,
                       C002 "Vendedora",
                       C003 "Distribuidor", 
                       C004 "Dt Emissão",
                       C005 "Sit Entrega",
                       C006  "Sub-Remessa",
                       case 
                         when C007 = 'S' then
                           APEX_ITEM.CHECKBOX2(2, C001 , 'CHECKED' )
                         else
                           APEX_ITEM.CHECKBOX2(2, C001 , NULL )
                       end "Re-Imprimir",
                       C008 "Recebido em",
                       --
                       C009 "Filial"
                  from apex_collections c
                 where c.collection_name = 'COL_PAG594_2000_REIMP_'||v('APP_USER')
                ```
            pageItemsToSubmit: P594_IDPEDIDOREIMP
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--noBorders
            ]
        }
        advanced {
            htmlDomId: LISTAPEDIDOSREIMP
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <table><tr>
                <td style="width:45%"><hr/></td>
                <td style="vertical-align:middle; text-align: center; color:red">Pedidos Já Entregues ao Distribuidor</td>
                <td style="width:45%"><hr/></td>
                </tr></table>
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            formats: [
                html
                pdf
            ]
            sendAsEmail: false
            filename: PedidosEntregues
        }
        advanced {
            savedReportMappingIdentifier: 801866692959597138
        }

