    process imprimirpedidos (
        name: ImprimirPedidos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vid_pedido  number;
                  vid_subremessa number;
                  v_existe number;
                  v_char varchar2(1000);
                  v_data timestamp;
                  v_idusuario number := :P0_IDUSUARIO;
                  v_idcaract  number := 103;
                  v_idvalor   number := 1;
                  v_obs       varchar2(100) := 'Pedido retirado pelo distribuidor' ;
                  v_md5       varchar2(2000);
                  vidclassificacaopedido number;
                  --
                begin
                  --
                  if not apex_collection.collection_exists('COL_IMPRIMEREL_'||v('APP_USER')) then 
                    apex_collection.create_collection('COL_IMPRIMEREL_'||v('APP_USER'));
                  else
                    apex_collection.truncate_collection('COL_IMPRIMEREL_'||v('APP_USER'));
                  end if;
                  --
                  if v_idusuario is null then
                    select idusuario 
                      into v_idusuario
                      from usuarios
                     where usuario = v('APP_USER');
                  end if;
                  --
                  if APEX_APPLICATION.G_F01.COUNT > 0 or 
                     APEX_APPLICATION.G_F02.COUNT > 0 then
                    --
                    FOR I in 1..APEX_APPLICATION.G_F01.COUNT 
                    LOOP
                      --
                      vid_pedido := to_number(APEX_APPLICATION.G_F01(i));
                      apex_collection.add_member(
                                      p_collection_name => 'COL_IMPRIMEREL_'||v('APP_USER'),
                                      p_c001 => vid_pedido );
                      
                      begin
                        select idsubremessa
                          into vid_subremessa
                          from pedidos
                         where idpedido = vid_pedido;
                      exception
                        when others then null;
                      end;
                      --
                      v_data := sysdate;
                      
                      pck_pedidos_fav.prc_classificacoespedidos( pidclassificacaopedido  => vidclassificacaopedido
                                                               , pidpedido               => vid_pedido
                                                               , pdataclassificado       => v_data
                                                               , pidusuario              => v_idusuario
                                                               , pidcaracteristicapedido => v_idcaract
                                                               , pidvalorcaracteristica  => v_idvalor
                                                               , pobservacao             => v_obs
                                                               , pmd5                    => v_md5
                                                               , poperacao_dml           => 'I' );
                      --
                      -- valida se todos os pedidos da subremessa foram entregues, então pode fechar a subremessa
                      begin
                        select count(*) 
                          into v_existe
                          from pedidos p
                         where p.idsubremessa = vid_subremessa
                           and not exists (select 1
                                            from classificacoespedidos c
                                           where c.idpedido = p.idpedido
                                             and c.idcaracteristicapedido = v_idcaract
                                             and c.idvalorcaracteristica = 1);
                         if nvl(v_existe,0) > 0 then -- caract. 103 representa pedido recebido pelo distribuidor.
                                                    -- enquanto o select acima retornar registros, sinal que ainda não foram todos recebidos.
                           null;
                         else
                           --
                           v_data := sysdate;
                           UPDATE subremessas
                              SET datafechamento      = v_data
                                , idusuariofechamento = v_idusuario
                            WHERE idsubremessa        = vid_subremessa;
                           --
                         end if;
                      end;
                      
                      /*if nvl(vid_subremessa,0) > 0 then
                        begin
                          select 1
                          into v_existe
                          from subremessas s
                         where idsubremessa = vid_subremessa
                           and INSTR(s.pedidosentregues, vid_pedido) > 0;
                        --
                        exception
                          when no_data_found then
                            -- busca pedidos ja impressos
                            select pedidosentregues
                              into v_char
                              from subremessas s
                             where idsubremessa = vid_subremessa;
                            --
                            if v_char is null then 
                              v_char := vid_pedido;
                            else
                              v_char := v_char || ', ' || vid_pedido;
                            end if;
                            --
                            update subremessas
                               set pedidosentregues = v_char
                             where idsubremessa = vid_subremessa;
                        end;
                      end if; */
                    END LOOP;
                    --
                    -- Verifica se tem pedidos já entregues marcados para reimpressao
                    if APEX_APPLICATION.G_F02.COUNT > 0 then
                      vid_pedido := null;
                      FOR I in 1..APEX_APPLICATION.G_F02.COUNT 
                      LOOP
                        vid_pedido := to_number(APEX_APPLICATION.G_F02(i));
                        apex_collection.add_member(
                                        p_collection_name => 'COL_IMPRIMEREL_'||v('APP_USER'),
                                        p_c001 => vid_pedido );
                      END LOOP;
                    end if;
                  else
                    raise_application_error(-20001,'Selecione ao menos um pedido para impressão!');
                --    apex_error.add_error ( p_message => 'Selecione ao menos um pedido para impressão!',
                --                           p_display_location => apex_error.c_inline_in_notification );  
                  end if;  
                
                commit;
                
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 566599930552246857
        }
        serverSideCondition {
            type: request=Value
            value: IMPRIMIR
        }
    )

    process populacollection (
        name: PopulaCollection
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                 l_query varchar2(32000);
                    
                BEGIN
                
                  l_query := 'select p.idpedido,
                       pck_util_fav.fnc_nomevendedora(p.idvendedora) Vendedora,
                       pck_util_fav.fnc_nomerepresentante(p.idrepresentante) Distribuidor,
                       to_char(p.dataemissao,''dd/mm/rrrr hh24:mi:ss'') dataemissao, --"Dt Emissão",
                       se.descricaosistema sitentrega, --as "Sit Entrega",
                       sf.descricaosistema sitfinanceiro, --as "Sit Financeiro",
                       --
                       APEX_ITEM.CHECKBOX2(1, p.idpedido , NULL )  imprimir, --as "Imprimir",
                       --
                       p.idsubremessa,
                       --
                       case
                         when p.idsubremessa is not null then
                           sr.descricao
                       end as subremessa --"Sub-Remessa"
                       --
                     , re.descricao Remessa
                     , favorita.pck_util_fav.fnc_nomefilialfavorita(p.idfilialfavorita) Filial
                    from pedidos p,
                         subremessas sr,
                         remessas    re,
                         situacoesentrega se,
                         situacoesfinanceiro sf
                    where p.idsituacaoentrega = se.idsituacaoentrega
                    and p.idsituacaofinanceiro = sf.idsituacaofinanceiro
                    and p.idsubremessa = sr.idsubremessa
                    and sr.idremessa = re.idremessa
                    and p.datacancelamento is null
                    and p.idsituacaoentrega in (60000) 
                    and p.idfilialfavorita = 1
                    and exists (select 1
                               from classificacoespedidos c
                               where c.idcaracteristicapedido = 13
                               and c.idvalorcaracteristica in (6,7)
                               and c.idpedido = p.idpedido) 
                    and exists (select 1
                                     from classificacoespedidos
                                    where idcaracteristicapedido = 102 -- pedido deve ter sido recebido pela loja
                                      and idvalorcaracteristica = 1
                                      and idpedido = p.idpedido) 
                    and not exists (select 1
                                     from classificacoespedidos
                                    where idcaracteristicapedido = 103 -- pedido ainda não entregue ao distribuidor
                                      and idvalorcaracteristica = 1
                                      and idpedido = p.idpedido)  ';
                
                
                  if apex_collection.collection_exists('COL_PAG594_2000_'||v('APP_USER') ) then
                    APEX_COLLECTION.DELETE_COLLECTION ( p_collection_name => 'COL_PAG594_2000_'||v('APP_USER'));
                  end if;
                  
                
                  begin -- ticket 8312935 -- Maicon Aimi - adicionei esse begin para evitar erro ORA-20104 cousado por excesso de F5 da usuária.
                    APEX_COLLECTION.CREATE_COLLECTION_FROM_QUERY (
                          p_collection_name => 'COL_PAG594_2000_'||v('APP_USER'), 
                          p_query => l_query,
                          p_generate_md5 => 'NO');
                  exception
                      when others then 
                        null;
                  end;
                
                END;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 566496713499872020
        }
    )

    process populacollectionreimp (
        name: PopulaCollectionReimp
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                 l_query varchar2(32000);
                    
                BEGIN
                  
                  l_query := 'SELECT pe.idpedido
                                   , pck_util_fav.fnc_nomevendedora(pe.idvendedora) --Vendedora
                                   , pck_util_fav.fnc_nomerepresentante(pe.idrepresentante) --Distribuidor
                                   , to_char(pe.dataemissao,''dd/mm/rrrr hh24:mi:ss'') --dataemissao --"Dt Emissão"
                                   , se.descricaosistema --sitentrega --as "Sit Entrega"
                                   , sr.descricao --"Sub-Remessa"
                                   --
                                   , APEX_ITEM.CHECKBOX2(2, pe.idpedido , NULL )  --as "Re-Imprimir"
                                   --
                                   , to_char(cl.dataclassificado,''dd/mm/rrrr hh24:mi:ss'') --"Recebido em"
                                   --
                                   , favorita.pck_util_fav.fnc_nomefilialfavorita(pe.idfilialfavorita) --Filial
                                   FROM pedidos             pe,
                                        subremessas         sr,
                                        situacoesentrega    se,
                                        situacoesfinanceiro sf,
                                  ( select idpedido
                                         , dataclassificado
                                    from classificacoespedidos
                                    where idcaracteristicapedido = 103 ) cl
                                  --
                              WHERE pe.idsituacaoentrega    = se.idsituacaoentrega
                                AND pe.idsituacaofinanceiro = sf.idsituacaofinanceiro
                                AND pe.idsubremessa         = sr.idsubremessa(+)
                                AND pe.idpedido             = cl.idpedido
                                AND pe.datacancelamento is null
                                and pe.idfilialfavorita = 1
                                and pe.idsituacaoentrega in (60000) ';
                
                  if apex_collection.collection_exists( 'COL_PAG594_2000_REIMP_'||v('APP_USER') ) then
                    APEX_COLLECTION.DELETE_COLLECTION ( p_collection_name => 'COL_PAG594_2000_REIMP_'||v('APP_USER'));
                  end if;
                
                  begin -- ticket 8312935 -- Maicon Aimi - adicionei esse begin para evitar erro ORA-20104 cousado por excesso de F5 da usuária.
                    APEX_COLLECTION.CREATE_COLLECTION_FROM_QUERY (
                            p_collection_name => 'COL_PAG594_2000_REIMP_'||v('APP_USER'), 
                            p_query => l_query,
                            p_generate_md5 => 'NO'); 
                  exception
                    when others then 
                      null;
                  end;
                
                END;
                ```
        }
        execution {
            sequence: 20
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1502953178713457704
        }
    )

)

