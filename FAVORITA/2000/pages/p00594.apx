    dynamicAction buscasr (
        name: BuscaSR
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P594_IDSUBREMESSA
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    
                    --raise_application_error(-20001,'xxxx'||:P594_IDSUBREMESSA);
                    
                    SELECT IDREMESSA,
                           DESCRICAO,
                           IDFILIALFAVORITA,
                           TIPOSUBREMESSA
                      INTO :P594_IDREMESSA,
                           :P594_NOMESR,
                           :P594_IDFILIALFAVORITA,
                           :P594_TIPOSR
                      FROM subremessas
                     WHERE idsubremessa = :P594_IDSUBREMESSA;
                    
                     exception
                       when no_data_found then 
                        :P594_IDREMESSA        := null ;
                        :P594_NOMESR           := null ;
                        :P594_IDFILIALFAVORITA := 2 ;
                        :P594_TIPOSR           := 'I' ;
                        
                    end;
                    ```
                itemsToSubmit: P594_IDSUBREMESSA
                itemsToReturn: [
                    P594_IDREMESSA
                    P594_NOMESR
                    P594_IDFILIALFAVORITA
                    P594_TIPOSR
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction marcaimprimir (
        name: MarcaImprimir
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P594_IDPEDIDO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                      --
                      -- busca o id atraves do pedido para então atualizar a collection
                      for c1 in ( 
                        select seq_id, 
                               C001 ,
                               C002 ,
                               C003 , 
                               C004 ,
                               C005 ,
                               C006 ,
                               C008 ,
                               C009 ,
                               C010 ,
                               C011 
                          from apex_collections c
                         where c.collection_name = 'COL_PAG594_2000_'||v('APP_USER') 
                           and C001 = to_number(substr(:P594_IDPEDIDO,5,11) ))
                      loop
                        
                        APEX_COLLECTION.UPDATE_MEMBER (
                            p_collection_name => 'COL_PAG594_2000_'||v('APP_USER'),
                            p_seq  => c1.seq_id,
                            p_C001 => c1.C001,
                            p_C002 => c1.C002,
                            p_C003 => c1.C003,
                            p_C004 => c1.C004,
                            p_C005 => c1.C005,
                            p_C006 => c1.C006,
                            p_c007 => 'S',
                            p_C008 => c1.C008,
                            p_C009 => c1.C009,
                            p_C010 => c1.C010,
                            p_C011 => c1.C011    );
                            
                      end loop;
                    end;
                    
                    ```
                itemsToSubmit: P594_IDPEDIDO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                     apex.region("LISTAPEDIDOS").refresh();
                     document.getElementById("P594_IDPEDIDO").value = '';
                     document.getElementById("P594_IDPEDIDO").focus();
                    ```
            }
            execution {
                sequence: 40
            }
        )

    )

    dynamicAction marcareimprimir (
        name: MarcaReimprimir
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P594_IDPEDIDOREIMP
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                      --
                      -- busca o id atraves do pedido para então atualizar a collection
                     -- raise_application_error(-20001, 'xxxx'||substr(:P594_IDPEDIDOREIMP,9,7));
                      for c1 in ( 
                        select seq_id, 
                               C001 ,
                               C002 ,
                               C003 , 
                               C004 ,
                               C005 ,
                               C006 ,
                               C008 ,
                               C009 ,
                               C010 ,
                               C011
                          from apex_collections c
                         where c.collection_name = 'COL_PAG594_2000_REIMP_'||v('APP_USER') 
                           and C001 = to_number(substr(:P594_IDPEDIDOREIMP,5,11) ))
                      loop
                        
                        APEX_COLLECTION.UPDATE_MEMBER (
                            p_collection_name => 'COL_PAG594_2000_REIMP_'||v('APP_USER'),
                            p_seq  => c1.seq_id,
                            p_C001 => c1.C001,
                            p_C002 => c1.C002,
                            p_C003 => c1.C003,
                            p_C004 => c1.C004,
                            p_C005 => c1.C005,
                            p_C006 => c1.C006,
                            p_c007 => 'S',
                            p_C008 => c1.C008,
                            p_C009 => c1.C009,
                            p_C010 => c1.C010,
                            p_C011 => c1.C011 );
                            
                      end loop;
                    end;
                    ```
                itemsToSubmit: P594_IDPEDIDOREIMP
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                     apex.region("LISTAPEDIDOSREIMP").refresh();
                     document.getElementById("P594_IDPEDIDOREIMP").value = '';
                     document.getElementById("P594_IDPEDIDOREIMP").focus();
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

