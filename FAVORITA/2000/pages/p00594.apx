                ```sql
                select SEQ_ID, 
                       C001 IDPEDIDO,
                       C002 "Vendedora",
                       C003 "Distribuidor", 
                       C004 "Dt Emissão",
                       C005 "Sit Entrega",
                       C006 "Sit Financeiro",
                       case 
                         when C007 = 'S' then
                           APEX_ITEM.CHECKBOX2(1, C001 , 'CHECKED' )
                         else
                           APEX_ITEM.CHECKBOX2(1, C001 , NULL )
                       end "Imprimir",
                       C008 idsubremessa,
                       C009 "Sub-Remessa",
                       C010 "Remessa",
                       --
                       C011 "Filial"
                  from apex_collections c
                 where c.collection_name = 'COL_PAG594_2000_'||v('APP_USER')
                
