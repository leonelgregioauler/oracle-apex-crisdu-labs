page 594 (
    name: Lista de Entrega de Pedidos
    title: Entregar Pedidos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_entrega_pedido(pid_pedido) {
              apex.confirm("Deseja marcar esse pedido como entregue?", {
                request:"ENTREGAR_PEDIDO",
                set:{"P479_ID_PEDIDO_ENTREGAR":pid_pedido},
                showWait:true
                });  
            }
            ```
        executeWhenPageLoads: //$("#R85014125112168631_control_panel").hide();
    }
    css {
        inline:
            ```css
            a.vermelho:link, a.vermelho:visited, a.vermelho:hover, a.vermelho:active {
              text-decoration: none;
              color: #3BAA2C
              }
            
            /*Trecho abaixo oculta o SPINNER*/
            .u-Processing {
               display:none !important;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

