    validation data-de-vencimento-entrada-obrigatório (
        name: Data de Vencimento Entrada obrigatório
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P214_VENCIMENTOENTRADA
        }
        error {
            errorMessage: Por favor, informe a data de vencimento da Entrada.
        }
        serverSideCondition {
            whenButtonPressed: @parcelar
            type: item=value
            item: P214_TIPOPARCELAMENTO
            value: E
        }
    )

    validation forma-de-pagamento-obrigatório (
        name: Forma de Pagamento Obrigatório
        execution {
            sequence: 50
        }
        validation {
            plsqlExpression: :P214_FORMAPAGAMENTO is not null
        }
        error {
            errorMessage: Forma de pagamento deve ser selecionada.
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'PARCELAR'
        }
    )

    validation selecionar-boleto-para-pedidos-de-distribuidor (
        name: Selecionar Boleto para pedidos de distribuidor
        execution {
            sequence: 40
        }
        validation {
            type: itemIsNotNull
            item: P214_IDVENCIMENTO
        }
        error {
            errorMessage: Selecione um boleto para parcelar
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from classificacoespedidos cp
                where idpedido = :P214_IDPEDIDO
                and idcaracteristicapedido = 28
                and exists ( select 1
                             from vencimentospedidos vp
                             where vp.idpedido = cp.idpedido 
                             and vp.situacaovencimento = 'V'
                             and trunc(vp.datavencimento) < trunc(sysdate) )
                and v('REQUEST') = 'PARCELAR'
                ```
        }
    )

    validation valor-entrada-não-pode-ser-maior-que-o-saldo (
        name: Valor entrada não pode ser maior que o Saldo
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where to_number(:P214_VALORENTRADA       ,'999G999G999G990D00') > nvl(( select sum(v.valorpagar - v.valorpago)
                                                                                        from vencimentospedidos v
                                                                                        where v.idpedido = :P214_IDPEDIDO
                                                                                         and v.situacaovencimento = 'V' ),0)
                ```
        }
        error {
            errorMessage: O Valor da Entrada não pode ser maior que o Saldo Devedor do pedido!
        }
        serverSideCondition {
            whenButtonPressed: @parcelar
        }
    )

    validation verifica-se-valor-de-entrada-é-nulo (
        name: Verifica se valor de entrada é nulo
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P214_VALORENTRADA
        }
        error {
            errorMessage: Informe o valor de Entrada
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') = 'PARCELAR'
                  and :P214_TIPOPARCELAMENTO = 'E'
                ```
        }
    )

    process altera-a-forma-de-pagamento (
        name: Altera a Forma de Pagamento
        type: executeCode
        editableRegion: @parcelamentos-realizados
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update pagamentospedidos 
                  set idformapagamento    = :TIPOPAGAMENTO
                  where idpagamentopedido = :IDPAGAMENTOPEDIDO;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 1588760598596659810
        }
        serverSideCondition {
            executionScope: allSubmittedRows
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('SUBMIT','EMESPERA')
                  and v('REQUEST') != ('TROCAR_NEGOCIADORA')
                ```
        }
    )

    process alterar-situação (
        name: Alterar Situação
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vsituacao varchar2(1);
                  --
                begin 
                  --
                  if v('REQUEST') = 'EMESPERA' then
                    --
                    vsituacao := 'E';
                    --
                  elsif v('REQUEST') = 'VENCIDO' then
                    --
                    vsituacao := 'V';
                    --
                  end if;
                  --
                  pck_negociacoes_fav.prc_atualizasituacaoparc(pidparcelamentopedido => :P214_IDEDITAR,
                                                               pidusuario => :P0_IDUSUARIO,
                                                               psituacaonova => vsituacao);
                  --
                end;
                ```
        }
        execution {
            sequence: 60
        }
        successMessage {
            successMessage: Parcela alterada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 340160967917161216
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('EMESPERA','VENCIDO');
                ```
        }
    )

