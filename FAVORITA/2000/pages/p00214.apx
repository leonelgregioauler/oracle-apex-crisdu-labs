    button parcelar (
        buttonName: PARCELAR
        label: Efetuar Parcelamento
        layout {
            sequence: 10
            region: @parcelamento
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Confirma a forma de pagamento ?','PARCELAR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                               from parcelamentospedidos
                               where idpedido = :P214_IDPEDIDO
                                 and situacao in ('A','V','E') )
                ```
        }
    )

