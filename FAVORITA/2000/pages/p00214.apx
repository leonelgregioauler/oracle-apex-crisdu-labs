    button trocar-negociadora (
        buttonName: TROCAR_NEGOCIADORA
        label: Trocar Negociadora
        layout {
            sequence: 30
            region: @parcelamento
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util_fav.fnc_verificaacesso(28335,:P0_IDUSUARIO) = 'S'
                  and exists ( select 1 
                               from parcelamentospedidos
                               where idpedido = :P214_IDPEDIDO )
                ```
        }
    )

    dynamicAction carrega-forma-de-pagamento-e-operadora-do-cartão (
        name: Carrega Forma de Pagamento e Operadora do Cartão
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                      select distinct idformapagamento
                      into :P214_FORMAPAGAMENTO
                      from pagamentospedidos pp
                         , vencimentospedidos vp
                      where pp.idvencimentopedido = vp.idvencimentopedido 
                      and origempagamento = 'C'
                      and vp.idpedido = :P214_IDPEDIDO;
                      --
                    exception
                      when others then
                        :P214_FORMAPAGAMENTO := null;
                    end;
                    ```
                itemsToSubmit: P214_IDPEDIDO
                itemsToReturn: P214_FORMAPAGAMENTO
                showProcessing: true
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction enviar-dados-do-pagamento (
        name: Enviar Dados do Pagamento
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @cartaocredito
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    sessionStorage.removeItem('DADOSPAGAMENTO');
                    
                    var idpedido    = $('#P214_IDPEDIDO').val();
                    var qtdparcelas = $('#P214_QTDPARCELAMENTO').val();
                    var valorapagar = $('.valorapagar').val();
                    
                    
                    sessionStorage.setItem('DADOSPAGAMENTO', JSON.stringify( { 
                      idpedido:    idpedido,
                      qtdparcelas: qtdparcelas,
                      valorapagar: valorapagar,
                    }
                                                                        
                    ));
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction limpa-a-opção-baixa-perda (
        name: "Limpa a opção baixa perda "
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P214_FORMAPAGAMENTO
        }
        clientSideCondition {
            type: item!=value
            item: P214_FORMAPAGAMENTO
