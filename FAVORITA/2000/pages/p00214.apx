        }
    )

    process efetuar-parcelamento (
        name: Efetuar Parcelamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vvalorentrada         number(15,2)     := to_number(:P214_VALORENTRADA       ,'999G999G999G990D00'); 
                begin
                  --
                  pck_negociacoes_fav.prc_realizaparcelamento( pidpedido => :P214_IDPEDIDO,
                                                               pidusuario => :P0_IDUSUARIO,
                                                               ptipoparcelamento => :P214_TIPOPARCELAMENTO,
                                                               pvalorentrada => vvalorentrada,
                                                               pvecimentoentrada => :P214_VENCIMENTOENTRADA,
                                                               pqtdparcelas => :P214_QTDPARCELAMENTO,
                                                               pidcontabancaria => :P214_IDCONTABANCARIA,
                                                               pidformapagamento => :P214_FORMAPAGAMENTO,
                                                               pidvencimentopedido => :P214_IDVENCIMENTO,
                                                               pidopcaobaixaperda => :P214_OPCAOPERDA);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Parcelamento Realizado com Sucesso!
        }
        advanced {
            executionMappingIdentifier: 339705824709544437
        }
        serverSideCondition {
            type: expression
            plsqlExpression: v('REQUEST') = 'PARCELAR'
        }
    )

    process insere-histórico-do-mot-baixa-perda (
        name: Insere Histórico do mot. baixa Perda
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                vdescricao      varchar2(4000);
                             
                begin             
                    select op.nomeopcaobaixaperda|| ' - ' || op.observacao
                      into vdescricao
                    from roman.opcaobaixaporperda op
                    where op.idopcaobaixaperda = :P214_OPCAOPERDA;   
                      
                insert into historicospedidos (idhistoricopedido,
                                               idpedido,
                                               datahistorico,
                                               idusuario,
                                               descricao,
                                               imprimirnopedido,
                                               liberaedicao,
                                               liberamontagem,
                                               idopcaobaixaperda)
                values ( seq_idhistoricopedido.nextval     
                      , :P214_IDPEDIDO    
                      , sysdate
                      , :P0_IDUSUARIO             
                      , vdescricao    
                      , 'N'
                      , 'N'
                      , null
                      , :P214_OPCAOPERDA);
                            
                end;
                ```
        }
        execution {
            sequence: 90
        }
        advanced {
            executionMappingIdentifier: 890148735909367401
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P214_OPCAOPERDA
        }
    )

