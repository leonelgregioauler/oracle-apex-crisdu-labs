    pageItem P214_QTDPARCELAMENTO (
        type: selectList
        label {
            label: +
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_value
                     , return_value 
                from( select '1 Parcela' display_value
                     , 1 return_value
                from dual
                union
                select '2 Parcelas' 
                     , 2 return_value
                from dual
                union
                select '3 Parcelas' 
                     , 3 return_value
                from dual
                union
                select '4 Parcelas' 
                     , 4 return_value
                from dual
                union
                select '5 Parcelas' 
                     , 5 return_value
                from dual
                union
                select '6 Parcelas' 
                     , 6 return_value
                from dual
                union
                select '7 Parcelas' 
                     , 7 return_value
                from dual
                union
                select '8 Parcelas' 
                     , 8 return_value
                from dual
                union
                select '9 Parcelas' 
                     , 9 return_value
                from dual
                union
                select '10 Parcelas' 
                     , 10 return_value
                from dual
                union
                select '11 Parcelas' 
                     , 11 return_value
                from dual
                union
                select '12 Parcelas' 
                     , 12 return_value
                from dual)
                order by 2
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @parcelamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

