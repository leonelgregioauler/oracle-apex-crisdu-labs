            settings {
                jsCode: apex.item("P214_OPCAOPERDA").setValue()
            }
            affectedElements {
                selectionType: items
                items: P214_OPCAOPERDA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction mostra-motivo-perda (
