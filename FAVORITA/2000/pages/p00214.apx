page 214 (
    name: Efetuar Parcelamento
    title: Efetuar Parcelamento
    appearance {
        pageMode: nonModalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 900
        height: 700
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_quitar(pid)
            {
              document.getElementById("P214_IDEDITAR").value = pid;
              apex.submit('QUITAR');
            }
            
            function fnc_emespera(pid)
            {
              document.getElementById("P214_IDEDITAR").value = pid;
              apex.submit('EMESPERA');
            }
            
            function fnc_vencido(pid)
            {
              document.getElementById("P214_IDEDITAR").value = pid;
              apex.submit('VENCIDO');
            }
            
            function fnc_desfazerquitacao(pid)
            {
              document.getElementById("P214_IDEDITAR").value = pid;
              apex.submit('DESFAZERQUITACAO');
            }
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region parcelamento (
        name: Parcelamento
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region parcelamentos-realizados (
        name: Parcelamentos Realizados
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "ROWID",
                "IDPARCELAMENTOPEDIDO",
                "IDPEDIDO",
                "DATAVENCIMENTO",
                "VALORORIGINAL",
                "JUROS",
                "VALORAPAGAR",
                decode(situacao,'A','Aberto','E','Em Espera','V','Vencido','Q','Quitado')"SITUACAO",
                case 
                  when situacao in ('A','E','V') then
                    '<a href="javascript:fnc_quitar('|| IDPARCELAMENTOPEDIDO ||')" ><img src="#APP_IMAGES#ok.png"  border="0"></a>'
                  else 
                    null
                end "QUITAR",
                case 
                  when situacao in ('V','A') then
                    '<a href="javascript:fnc_emespera('|| IDPARCELAMENTOPEDIDO ||')" ><img src="#APP_IMAGES#Ampulheta.png"  border="0"></a>'
                  else 
                    null
                end "EMESPERA",
                '<a href="javascript:fnc_vencido('|| IDPARCELAMENTOPEDIDO ||')" ><img src="#APP_IMAGES#Deslike.png"  border="0"></a>' "VENCIDO",
                "COMPROVANTE",
                "DATAPAGAMENTO",
                "DATABAIXA",
                "IDCONTABANCARIAFILIAL",
                case
                  when situacao = 'Q' and pck_util_fav.fnc_verificaacesso(28336,:P0_IDUSUARIO) = 'S' then
                    '<a href="javascript:fnc_desfazerquitacao('|| IDPARCELAMENTOPEDIDO ||')" ><img src="#APP_IMAGES#Deslike.png"  border="0"></a>'
                  else
                    null
                end "DESFAZERQUITACAO",
                "TIPOPAGAMENTO",
                "IDPAGAMENTOPEDIDO",
                 ( select op.nomeopcaobaixaperda
                     from roman.opcaobaixaporperda op
                    where p.idopcaobaixaperda = op.idopcaobaixaperda) motivo_baixa_perda
                from PARCELAMENTOSPEDIDOS p
                where IDPEDIDO = :P214_IDPEDIDO 
                order by DATAVENCIMENTO 
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from parcelamentospedidos
                where idpedido = :P214_IDPEDIDO
                ```
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

