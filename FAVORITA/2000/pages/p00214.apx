    pageItem P214_IDVENCIMENTO (
        type: checkboxGroup
        label {
            label: Selecionar Boleto para Parcelar
            alignment: left
        }
        settings {
            noOfCols: 6
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trunc(datavencimento) as d
                     , idvencimentopedido    as r
                from vencimentospedidos v
                where idpedido = :P214_IDPEDIDO
                and situacaovencimento = 'V'
                and valorpagar - valorpago > 0
                --and trunc(datavencimento) < trunc(sysdate)
                and exists ( select 1 
                             from classificacoespedidos cp
                             where idpedido = v.idpedido
                             and idcaracteristicapedido = 28 ) 
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 100
            region: @parcelamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from classificacoespedidos cp
                where idpedido = :P214_IDPEDIDO
                and idcaracteristicapedido = 28
                and exists ( select 1
                             from vencimentospedidos vp
                             where vp.idpedido = cp.idpedido 
                             and vp.situacaovencimento = 'V'
                             and trunc(vp.datavencimento) < trunc(sysdate) )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P214_NEGOCIADORA (
        type: selectList
        label {
            label: Negociadora
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_value
                     , return_value
                from ( 
                       select pck_util_fav.fnc_nomeusuario(idusuarionegociacao) display_value
                            , idusuarionegociacao return_value
                       from pagamentospedidos p
                       where exists ( select 1
                                      from vencimentospedidos v
                                      where v.idvencimentopedido = p.idvencimentopedido
                                        and v.idpedido           = :P214_IDPEDIDO
                                        and v.situacaovencimento = 'V'
                                        and v.valorpago          < v.valorpagar )
                         and p.origempagamento = 'C'
                         and p.idusuarionegociacao is not null
                         and pck_util_fav.fnc_verificaacesso(28335,:P0_IDUSUARIO) = 'N'
                       union
                       select pck_util_fav.fnc_nomeusuario(idusuario) display_value
                            , idusuario return_value
                       from usuarios u
                       where u.idgerente = 80
                         and u.ativo = 'S'
                         and pck_util_fav.fnc_verificaacesso(28335,:P0_IDUSUARIO) = 'S'
                       union
                       select pck_util_fav.fnc_nomeusuario(idusuario) display_value
                            , idusuario return_value
                       from usuarios u
                       where u.idusuario = 549
                       order by 1 )
                ```
            nullDisplayValue: - Selecione a Negociadora -
        }
        layout {
            sequence: 20
            region: @parcelamento
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P214_OPCAOPERDA (
        type: selectList
        label {
            label: Motivo Baixa
            alignment: left
