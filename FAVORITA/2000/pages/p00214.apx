                  and v('REQUEST') != ('TROCAR_NEGOCIADORA')
                ```
        }
    )

    process desfazer-parcelamento (
        name: Desfazer Parcelamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vexiste   number;
                begin
                  --
                  begin
                    select distinct 1
                    into vexiste
                    from parcelamentospedidos
                    where idpedido = :P214_IDPEDIDO;
                    --
                    pck_negociacoes_fav.prc_desfazerparcelamento(pidpedido => :P214_IDPEDIDO,
                                                               pidusuario => :P0_IDUSUARIO);
                    --                                               
                  exception
                    when others then
                      --raise_application_error (-20005, :P214_IDPEDIDO);
                      null;
                  end;
                  --
                  
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Parcelamento Desfeito com Sucesso!
        }
        advanced {
            executionMappingIdentifier: 340160001206161207
        }
        serverSideCondition {
            type: request=Value
            value: DESFAZERPARCELAMENTO
        }
    )

    process desfazer-quitação (
        name: Desfazer Quitação
        type: executeCode
