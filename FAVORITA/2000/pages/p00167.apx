    region emissão-detalhado-maicon (
        name: Emissão Detalhado _MAICON
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct
                       p.idpedido 
                     , p.desctipopedido tipopedido
                     , p.edicaorevista
                     , p.filialromance
                     , p.representante
                     , p.vendedora
                     , p.idusuario
                     , p.nomeusuario
                     , p.dataemissao
                     , p.dataentrega
                     , p.datavencimento
                     , round(p.valortotal  * nvl(p.fatorconversao,1),2) valortotal
                     , round(p.valorapagar * nvl(p.fatorconversao,1),2) valorapagar
                     , round(p.valortotalcomdesconto * nvl(p.fatorconversao,1),2) valortotalcomdesconto
                     , p.situacaovencimento ||' - '||pck_pedidos_fav.fnc_situacaopagamentoped(p.idpedido) situacaoboleto
                     , p.situacaoentrega
                from classificacoespedidos cp
                   , vw_pedidos_fav_new p
                where cp.idpedido = p.idpedido(+)
                  and p.idusuario = 5495
                  and p.idpedido = 7028740
                  
                  and (:P167_ATENDENTE is null or p.idusuario = :P167_ATENDENTE)
                  
                  and trunc(p.dataemissao) between to_date(:P167_DATAINICIO,'DD/MM/RRRR') and to_date(:P167_DATAFIM,'DD/MM/RRRR')
                  
                  and :P167_TIPORELATORIO = 'D'
                  
                  and p.idsituacaoentrega >= 20000
                  
                  and ( :P167_FORMAENTREGA = 0 or exists ( select 1
                                                             from classificacoespedidos c
                                                             where c.idcaracteristicapedido = 13
                                                               and c.idvalorcaracteristica = :P167_FORMAENTREGA
                                                               and c.idpedido = p.idpedido ))
                  
                  and (:P167_IDPAIS is null or p.idpais   = :P167_IDPAIS)
                  
                  and (
                       :P167_FILTRARFAVORITA is null
                
                    or (
                           :P167_FILTRARFAVORITA = 'C'
                       and p.idfilialfavorita in (
                              select ff.idfilialfavorita
                              from filiaisfavorita ff
                              where ff.ativo = 'S'
                                and ff.tipofilial = 'C'
                       )
                    )
                
                    or (
                           :P167_FILTRARFAVORITA = 'T'
                    )
                
                    or (
                           :P167_FILTRARFAVORITA = 'S'
                       and p.idfilialfavorita in (
                              select to_number(column_value)
                              from apex_string.split(:P167_SELECTFILTROFAVORITA, ':')
                       )
                    )
                )
                
                and (
                       :P167_FILTRARROMANCE = 'T'
                
                    or (
                           :P167_FILTRARROMANCE = 'S'
                       and p.idfilialromance in (
                              select to_number(column_value)
                              from apex_string.split(:P167_SELECTFILTROROMANCE, ':')
                       )
                    )
                )
                                                                               
                  and ( :P167_TIPO = 'Z'
                       or p.tipopedido = :P167_TIPO )
                
                  and nvl(p.valortotal,0) > 0
                  
                  and ( ( :P167_CANCELADO = 'S' and p.datacancelamento is not null and p.idsituacaoentrega != 50 )
                     or ( :P167_CANCELADO = 'N' and p.datacancelamento is null ))  
                
                  and ( :P167_PEDIDOS_PONTOS = 'T' 
                       or ( :P167_PEDIDOS_PONTOS = 'S' and exists ( select 1
                                                                    from classificacoespedidos c
                                                                    where c.idcaracteristicapedido = 8
                                                                      and c.idvalorcaracteristica  = 16
                                                                      and c.idpedido               = p.idpedido ) )
                       or ( :P167_PEDIDOS_PONTOS = 'N' and not exists ( select 1
                                                                        from classificacoespedidos c
                                                                        where c.idcaracteristicapedido = 8
                                                                          and c.idvalorcaracteristica  = 16
                                                                          and c.idpedido               = p.idpedido ) ) )
                /*
                  and (:P167_CAMPANHA = 'T' or ( :P167_CAMPANHA = 'P' and exists ( select 1
                                                                                     from classificacoespedidos c
                                                                                     where c.idpedido    = p.idpedido
                                                                                       and c.idcaracteristicapedido = 74 ) )
                                            or ( :P167_CAMPANHA = 'V' and exists ( select 1
                                                                                   from classificacoespedidos c
                                                                                   where c.idpedido    = p.idpedido
                                                                                     and c.idcaracteristicapedido = 78 ) ) 
                                            or ( :P167_CAMPANHA = 'W' and exists ( select 1
                                                                                   from classificacoespedidos c
                                                                                   where c.idpedido    = p.idpedido
                                                                                     and c.idcaracteristicapedido = 94 ) ) 
                                            or ( :P167_CAMPANHA = 'B' and exists ( select 1
                                                                                   from classificacoespedidos c
                                                                                   where c.idpedido    = p.idpedido
                                                                                     and c.idcaracteristicapedido = 96 ) )
                                            or ( :P167_CAMPANHA = 'A' and exists ( select 1
                                                                                   from classificacoespedidos c
                                                                                   where c.idpedido    = p.idpedido
                                                                                     and c.idcaracteristicapedido = 97 ))
                                            or ( :P167_CAMPANHA = 'K' and exists ( select 1
                                                                                   from classificacoespedidos c
                                                                                   where c.idpedido    = p.idpedido
                                                                                     and c.idcaracteristicapedido = 111 )))
                  and ( (:P167_CANCELADO = 'S'  and  :P167_PEDIDONUMERO = 'N')
                       or (cp.idcaracteristicapedido = 11 
                          and ( :P167_PEDIDONUMERO = 'N'
                           or ( :P167_PEDIDONUMERO = 1 and cp.idvalorcaracteristica = 1 )
                           or ( :P167_PEDIDONUMERO = 2 and cp.idvalorcaracteristica = 2 )
                           or ( :P167_PEDIDONUMERO = 3 and cp.idvalorcaracteristica >= 3 ) ) ) )
                  and ( (:P167_LIMITEEXCEDENTELIBERADO = 'T') or (:P167_LIMITEEXCEDENTELIBERADO = 'S' and exists ( select 1
                                                                                                                   from classificacoespedidos c
                                                                                                                   where c.idcaracteristicapedido = 22
                                                                                                                     and c.idpedido = p.idpedido ) )
                                                              or (:P167_LIMITEEXCEDENTELIBERADO = 'N' and not exists ( select 1
                                                                                                                       from classificacoespedidos c
                                                                                                                       where c.idcaracteristicapedido = 22
                                                                                                                         and c.idpedido = p.idpedido ) ) )  
                  and ( :P167_PAGO = 'T' or (:P167_PAGO = 'S' and (p.valorapagar - p.valorpago) = 0) or (:P167_PAGO = 'N' and (p.valorapagar - p.valorpago) > 0) )                                                                                                       
                order by p.dataemissao
                
                
                */
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: <b><h4><font color="green"> Relatório só leva em consideração pedidos que possuem valor e não estão como Carrinho abandonado!</h4></b></font>
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from dual
                 where :P167_TIPORELATORIO = 'D'
                   and V('APP_USER') = 'MAICONAIMI'
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 136813852962122812
        }

