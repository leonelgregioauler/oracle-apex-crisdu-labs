    button buscar (
        buttonName: BUSCAR
        label: Buscar
        layout {
            sequence: 200
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction selecionar (
        name: Selecionar
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P167_FILTRARFAVORITA
        }
        clientSideCondition {
            type: item=value
            item: P167_FILTRARFAVORITA
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P167_SELECTFILTROFAVORITA
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P167_SELECTFILTROFAVORITA
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction selecionar-romane (
        name: Selecionar Romane
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P167_FILTRARROMANCE
        }
        clientSideCondition {
            type: item=value
            item: P167_FILTRARROMANCE
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P167_SELECTFILTROROMANCE
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P167_SELECTFILTROROMANCE
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: buscar pedidos
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 167
                items: {
                    P167_DATAINICIO: &P167_DATAINICIO.
                    P167_DATAFIM: &P167_DATAFIM.
                    P167_ATENDENTE: &P167_ATENDENTE.
                    P167_TIPORELATORIO: &P167_TIPORELATORIO.
                    P167_IDFILIALFAVORITA: &P167_IDFILIALFAVORITA.
                    P167_TIPO: &P167_TIPO.
                    P167_CANCELADO: &P167_CANCELADO.
                    P167_CAMPANHA: &P167_CAMPANHA.
                    P167_PEDIDOS_PONTOS: &P167_PEDIDOS_PONTOS.
                    P167_FORMAENTREGA: &P167_FORMAENTREGA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

)

