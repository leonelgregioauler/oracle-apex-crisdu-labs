    pageItem P167_SELECTFILTROFAVORITA (
        type: plugin/select
        label {
            label: Selecionar Filial
            alignment: left
        }
        settings {
            selectListType: multiValueSelectList
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nomefilialfavorita d
                     , f.idfilialfavorita r
                from vw_filiaisfavorita f
                where exists (
                    select 1
                    from usuariosfiliaisfavorita u
                    where u.idfilialfavorita = f.idfilialfavorita
                      and u.consultar = 'S'
                      and u.idusuario = :P0_IDUSUARIO
                )
                order by 2
                ```
        }
        layout {
            sequence: 80
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
    )

    pageItem P167_SELECTFILTROROMANCE (
        type: plugin/select
        label {
            label: "Selecionar empresa "
            alignment: left
        }
        settings {
            selectListType: multiValueSelectList
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.nome display_value
                     , w.idfilial return_value
                from roman.vw_filiais w
                where w.ativo = 'S'
                  and w.tipofilial = 'D'
                order by 1
                ```
        }
        layout {
            sequence: 100
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
    )

