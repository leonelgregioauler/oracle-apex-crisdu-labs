page 492 (
    name: Lista de Usuários
    title: Lista de Usuários
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region lista-de-usuários (
        name: Lista de Usuários
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select u.idusuario
                     , u.usuario as "Usuário"
                     , initcap(pe.nomepessoa) as "Nome"
                     , pck_util_fav.fnc_nomefilialfavorita(u.idfilialfavorita) as "Filial Fav"
                     , u.idusuariovirtualage as "ID Usuário VA"
                     , u.idvendedorvirtualage  "ID Vendedor VA"
                from usuarios u
                   , pessoas  pe
                where u.idpessoa = pe.idpessoa
                  and u.ativo = 'S'
                  and exists ( select 1
                               from filiaisfavorita f
                               where f.idfilialfavorita = u.idfilialfavorita 
                                 and f.tipofilial       = 'L' )
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 505
                items: {
                    P505_IDUSUARIO: #IDUSUARIO#
                }
                clearCache: 493
                action: resetPagination
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 103065618043915087
        }

        column "Filial Fav" (
            type: plainText
            heading {
                heading: Filial Fav
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column "ID Usuário VA" (
            type: plainText
            heading {
                heading: Id usuário va
                alignment: center
            }
            layout {
                sequence: 14
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column "ID Vendedor VA" (
            type: plainText
            heading {
                heading: Id vendedor va
                alignment: center
            }
            layout {
                sequence: 24
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column IDUSUARIO (
            type: plainText
            heading {
                heading: Idusuario
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column Nome (
            type: plainText
            heading {
                heading: Nome
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column Usuário (
            type: plainText
            heading {
                heading: Usuário
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 1030677 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn "Filial Fav" (
                sequence: 1
            )

            displayColumn "ID Usuário VA" (
                sequence: 4
            )

            displayColumn "ID Vendedor VA" (
                sequence: 5
            )

            displayColumn "Nome" (
                sequence: 2
            )

            displayColumn "Usuário" (
                sequence: 3
            )

            sort (
                column: "Filial Fav"
                sort {
                    sequence: 1
                }
            )

            sort (
                column: "Nome"
                sort {
                    sequence: 2
                }
            )

            controlBreak (
                column: "Filial Fav"
                layout {
                    sequence: 1
                }
            )

        )

    )

    dynamicAction refresh-report (
        name: Refresh report
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @lista-de-usuários
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @lista-de-usuários
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

