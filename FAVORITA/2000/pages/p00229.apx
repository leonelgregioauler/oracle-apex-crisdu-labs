page 229 (
    name: Anexar Arquivo Pagamentos Compras Transferências
    title: Anexar Arquivo Pagamentos Compras Transferências
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 65%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function deletaanexo(pid)
            {
            
              var answer = confirm("Confirma exlusão do Anexo?")
              if (answer)
                {
                  document.getElementById('P229_DELETAR').value = pid;
                  apex.submit('DELETAR');
                }
            }
            
            
            
            ```
    }

    region anexar-arquivo (
        name: Anexar Arquivo
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    region arquivos-anexados (
        name: Arquivos Anexados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.idanexopagamentocompratransf,
                       a.idpagamentocompratransf,
                       attach_data,
                       attach_mimetype,
                       attach_filename,
                       attach_last_update,
                       attach_charset,
                       round(sys.dbms_lob.getlength(attach_data)/1024,2)||' kb' file_length,
                       sys.dbms_lob.getlength(attach_data) download,
                       '<a href="javascript: deletaanexo('||a.idanexopagamentocompratransf||')"> Excluir </a>' remover
                from anexospagamentoscomprastransf a
                where a.idpagamentocompratransf = :P229_IDPAGAMENTOCOMPRATRANSF;
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from anexospagamentoscomprastransf a
                where a.idpagamentocompratransf = :P229_IDPAGAMENTOCOMPRATRANSF;
                ```
        }
