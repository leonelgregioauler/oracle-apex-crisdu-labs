    button create (
        buttonName: CREATE
        label: Anexar este arquivo!
        layout {
            sequence: 10
            region: @anexos-despesas
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 20
            region: @anexos-despesas
            slot: belowBox
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 68
                clearCache: 625
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction voltar (
        name: Voltar
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @voltar
        }

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @anexos-despesas
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    validation p625-arquivotemp (
        name: P625_ARQUIVOTEMP
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P625_ARQUIVOTEMP
        }
        error {
            errorMessage: Escolha um arquivo!
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('CREATE','UPDATE')
        }
    )

    process anexar (
        name: Anexar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  commit;
                  -- Call the procedure
                  roman.pck_anexos.blob_to_file_debitos_cliente(pidpessoa => :P625_IDPESSOA);
                  commit;
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 2120191493575473372
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process fetch-row-from-anexosdebitocliente (
        name: Fetch Row from ANEXOSDEBITOCLIENTE
        type: autoRowFetch
        source {
            tableOwner: ROMAN
            tableName: ANEXOSDEBITOCLIENTE
            pkColumn: IDANEXODEBITOCLIENTE
            pkItem: P625_IDANEXODEBITOCLIENTE
            runtimeWhereClause: :P625_IDPESSOA IS NOT NULL
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 2120192211935473372
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    --if :P625_IDANEXODESPESA is null then
                        select ROMAN.SEQ_ANEXOSDEBITOCLIENTE.nextval
                          into :P625_idanexodebitocliente
                          from sys.dual;
                    --nd if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 2120192692650473372
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-anexosdebitocliente (
        name: Process Row of ANEXOSDEBITOCLIENTE
        type: autoRowProcessing
        target {
            tableOwner: ROMAN
            tableName: ANEXOSDEBITOCLIENTE
            pkColumn: IDANEXODEBITOCLIENTE
            pkItem: P625_IDANEXODEBITOCLIENTE
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Arquivo Anexado
        }
        advanced {
            executionMappingIdentifier: 2120193011157473373
