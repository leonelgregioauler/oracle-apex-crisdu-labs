page 625 (
    name: Anexos Débito Cliente
    title: Anexos Débito Cliente
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function fnc_verimg(pid)
            {
              window.open('http://anexos.romancemoda.com.br/'+pid);
              void(0);
            }
            
            function fnc_removeanexo(pidanexo,pnomeanexo)
            {
                apex.confirm("Deseja realmente remover o anexo "+pnomeanexo+"?", {
              request:"DELETAR",
              set:{"P282_IDANEXODELETAR":pidanexo}
              });
            }
            ```
    }

    region anexos-despesas (
        name: Anexos Despesas
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    region arquivos-anexados (
        name: Arquivos Anexados
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idanexodebitocliente
                     , t.nomearquivo
                     --, t.idpessoa||t.idanexodebitocliente||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10) link
                     --, url_bucket link
                     , data
                     , ( select roman.pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario ) usuario 
                     , roman.pck_bucket.sp_abre_anexo(url_bucket) preview
                from roman.ANEXOSDEBITOCLIENTE t
                where idpessoa = :P625_IDPESSOA
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.ANEXOSDEBITOCLIENTE
                where idpessoa = :P625_IDPESSOA
                ```
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 592413329575953907
        }

        savedReport 5924795 (
            visibility: primary
