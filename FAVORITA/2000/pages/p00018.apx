        }
        serverSideCondition {
            type: never
        }
    )

    process operação-dml-em-cupons-descontos (
        name: Operação DML em Cupons Descontos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml          varchar2(1);
                  --
                  vdatainicio            date;
                  vdatafim               date;
                  vvalordesconto         number(15,2);
                  vidcompratransferencia number;
                  --
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  end if;
                  --
                  vdatainicio            := to_date(:P18_DATAINICIO,    'DD/MM/RRRR');
                  vdatafim               := to_date(:P18_DATAFIM,       'DD/MM/RRRR');
                  vvalordesconto         := to_number(:P18_VALORDESCONTO       ,'999G999G999G990D00');  
                  vidcompratransferencia := null;
                    
                  FAVORITA.PCK_COMERCIAL_FAV.PRC_CUPONSDESCONTOS( PIDCUPOMDESCONTO => :P18_IDCUPOMDESCONTO
                                                                , PNOME => :P18_NOME
                                                                , PDATAINICIO => vdatainicio  --:P18_DATAINICIO,
                                                                , PDATAFIM => vdatafim --:P18_DATAFIM,
                                                                , PVALORDESCONTO => vvalordesconto
                                                                , PTIPODESCONTO => :P18_TIPODESCONTO
                                                                , PIDFILIALROMANCE => :P18_IDFILIALROMANCE
                                                                , PIDCOMPRATRANSFERENCIA => vidcompratransferencia
                                                                , PIDUSUARIO => :P0_IDUSUARIO
                                                                , PMD5 => :P18_MD5
                                                                , POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 538277552909968186
        }
    )

    branch (
        name: Go To Page 18
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 18
                items: {
                    P18_IDCUPOMDESCONTO: &P18_IDCUPOMDESCONTO.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

)

