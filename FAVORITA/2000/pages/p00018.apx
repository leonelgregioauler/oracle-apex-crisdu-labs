    region códigos (
        name: Códigos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idcodigocupomdesconto
                     , idcupomdesconto
                     , codigo
                     , idpedido
                     , vendedora
                from vw_codigoscuponsdescontos_fav
                where idcupomdesconto = :P18_IDCUPOMDESCONTO
                  and ( (:P18_UTILIZADO = 'S' and idpedido is not null)
                     or (:P18_UTILIZADO = 'N' and idpedido is null) )
                ```
            pageItemsToSubmit: [
                P18_IDCUPOMDESCONTO
                P18_UTILIZADO
            ]
        }
        layout {
            sequence: 20
            slot: wizardBody
        }
        appearance {
