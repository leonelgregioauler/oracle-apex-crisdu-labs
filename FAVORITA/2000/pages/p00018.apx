    process consulta-cupons-descontos (
        name: Consulta Cupons Descontos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vdatainicio           date;
                  vdatafim              date;
                  vvalordesconto        number(15,2);
                  vidcompratransferencia number;
                  vidcupomdesconto       number := :P18_IDCUPOMDESCONTO;
                begin
                  --
                  vidcompratransferencia := null;
                  --
                  FAVORITA.PCK_COMERCIAL_FAV.PRC_CUPONSDESCONTOS( PIDCUPOMDESCONTO       => :P18_IDCUPOMDESCONTO
                                                                , PNOME                  => :P18_NOME
                                                                , PDATAINICIO            => vdatainicio
                                                                , PDATAFIM               => vdatafim
                                                                , PVALORDESCONTO         => vvalordesconto
                                                                , PTIPODESCONTO          => :P18_TIPODESCONTO
                                                                , PIDFILIALROMANCE       => :P18_IDFILIALROMANCE
                                                                , PIDCOMPRATRANSFERENCIA => vidcompratransferencia
                                                                , PIDUSUARIO             => :P18_IDUSUARIO
                                                                , PMD5                   => :P18_MD5
                                                                , POPERACAO_DML          => 'S');
                  --
                  :P18_DATAINICIO         := to_char(vdatainicio       ,'DD/MM/RRRR');
                  :P18_DATAFIM            := to_char(vdatafim          ,'DD/MM/RRRR');
                  :P18_VALORDESCONTO      := to_char(vvalordesconto    ,'999G999G999G990D00');
                  :P18_IDCUPOMDESCONTO    := vidcupomdesconto;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 538277943638968187
        }
    )

    process gerar-codigos (
        name: Gerar Codigos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_comercial_fav.prc_geracodigoscuponsdescontos(pidcupomdesconto => :P18_IDCUPOMDESCONTO,
                                                                   pquantidade => :P18_QUANTIDADE);
                end;
                
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Códigos gerados com sucesso!
        }
        advanced {
            executionMappingIdentifier: 538279134712968187
        }
        serverSideCondition {
            whenButtonPressed: @gerarcodigos
        }
    )

