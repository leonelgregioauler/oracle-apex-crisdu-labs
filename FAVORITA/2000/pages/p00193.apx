page 193 (
    name: Impressão Pedidos Uruguai
    title: Impressão Pedidos Uruguai
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function imprime()
            {
                tipodata       = $v("P193_TIPODATA");
                datainicio     = document.getElementById("P193_DATAINICIO").value;
                datafim        = document.getElementById("P193_DATAFIM").value;
                iddistribuidor = document.getElementById("P193_DISTRIBUIDOR").value;
                quantidade     = document.getElementById("P193_QUANTIDADE").value;
                promissoria    = $v("P193_PROMISSORIA");
                boleto         = $v("P193_BOLETO");
                idusuario      = document.getElementById("P0_IDUSUARIO").value;
                
                pjanela = window.open('f?p=&APP_ID.:201:&SESSION.::NO::P201_IDUSUARIO:'+idusuario,'page','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1280,height=1024,left=20,top=10','_blank');
                pjanela.focus();                          
            }
            
            function imprimelista()
            {
                idusuario      = document.getElementById("P0_IDUSUARIO").value;
                
                pjanela = window.open('f?p=&APP_ID.:206:&SESSION.::NO::P206_IDUSUARIO:'+idusuario,'page','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1280,height=1024,left=20,top=10','_blank');
                pjanela.focus();                          
            }
            
            function retornaSelecionado_old(nome) {
             var resultado;
             document.getElementsByName(nome).forEach(function(item){if (item.checked) resultado = item.value}); 
             return resultado;
            }
            
            function retornaSelecionado(nome) {
            var e = document.getElementById(nome);
            var resultado = e.options[e.selectedIndex].value;
                
             return resultado;
            }
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

