    pageItem P193_SESSION_IMPRIME (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_url varchar2(2000);
                    l_app number := 2000;
                    l_session number := v('APP_SESSION');
                BEGIN
                    l_url := APEX_UTIL.PREPARE_URL(
                        p_url => 'f?p=' || l_app || ':128:'||l_session||'::NO::P128_IDCOMPRATRANSFERENCIA,P128_IDDISTRIBUIDOR,P128_QUANTIDADE,P128_ETIQUETAGERADA,P128_ORDENACAO,P128_TIPO:'||:P193_IDCOMPRATRANSFERENCIA||','||:P193_DISTRIBUIDOR||','||:P193_QUANTIDADE||','||:P193_ETIQUETAGERADA||','||:P193_ORDENACAO||','||:P193_TIPO,
                        p_checksum_type => 'SESSION');
                    
                    return l_url;
                END;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
