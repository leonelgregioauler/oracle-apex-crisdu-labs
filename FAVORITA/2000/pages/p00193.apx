    process buscar-pedidos (
        name: Buscar Pedidos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vdatainicio date := to_date(:P193_DATAINICIO,'DD/MM/RRRR');
                  vdatafim date := to_date(:P193_DATAFIM,'DD/MM/RRRR');
                begin
                  --
                  pck_imprime_fav.prc_buscapedidosimpressao(pidusuario    => :P0_IDUSUARIO,
                                                            ptipodata     => :P193_TIPODATA,
                                                            pdatainicio   => vdatainicio,
                                                            pdatafim      => vdatafim,
                                                            pdistribuidor => :P193_DISTRIBUIDOR,
                                                            ppromissoria  => :P193_PROMISSORIA,
                                                            pboleto       => 2,
                                                            pquantidade   => :P193_QUANTIDADE,
                                                            pordenacao    => :P193_ORDENACAO );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Pedidos buscados com sucesso!
        }
        advanced {
            executionMappingIdentifier: 252109078269947547
        }
        serverSideCondition {
            whenButtonPressed: @buscar-pedidos
        }
    )

    branch (
        name: Go To Page 193
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 193
                items: {
                    P193_TIPODATA: &P193_TIPODATA.
                    P193_DATAINICIO: &P193_DATAINICIO.
                    P193_DATAFIM: &P193_DATAFIM.
                    P193_DISTRIBUIDOR: &P193_DISTRIBUIDOR.
                    P193_PROMISSORIA: &P193_PROMISSORIA.
                    P193_QUANTIDADE: &P193_QUANTIDADE.
                    P193_ORDENACAO: &P193_ORDENACAO.
                    P193_MOSTRAR: S
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar-pedidos
        }
    )

)

