    region pedidos-para-montar (
        name: Pedidos para Montar
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.numeropedido
                     , p.representante
                     , p.vendedora
                     , p.dataemissao
                     , p.dataentrega
                     , p.datavencimento
                     , p.valortotal
                     , p.valorapagar
                from vw_pedidos_fav p
                where exists ( select 1
                               from reimpressoespedidos r
                               where r.idpedido = p.idpedido
                                 and r.idusuario = :P0_IDUSUARIO
                                 and r.impressao = 'N' )
                  and p.ididioma = :P0_IDIDIOMA
                  and p.idfilialromance = 1041
                order by 1 
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P193_MOSTRAR
            value: S
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum pedido disponível para montar!
        }
        advanced {
            savedReportMappingIdentifier: 252107951544947536
        }

