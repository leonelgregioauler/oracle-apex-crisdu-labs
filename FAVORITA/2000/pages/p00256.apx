page 256 (
    name: Suporte ao Faturamento
    title: Suporte ao Faturamento
    appearance {
        pageTemplate: @minimal-pedido
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region impressão (
        name: "Impressão "
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_imprime_fav.prc_suporteaofaturamente(:P256_IDCOMPRATRANSFERENCIA);
                  --
                end;
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P256_IDCOMPRATRANSFERENCIA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @impressão
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

