page 219 (
    name: Impressão Rem Aliquota
    title: Impressão Rem Aliquota
    appearance {
        pageTemplate: @minimal-pedido
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region impressão (
        name: Impressão
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_imprime_fav.prc_comprastransferencias_ncm ( :P219_IDCOMPRATRANSFERENCIA , :P0_IDUSUARIO , :P219_ALIQUOTA );
                  --
                end;
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P219_ALIQUOTA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @impressão
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P219_IDCOMPRATRANSFERENCIA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @impressão
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

