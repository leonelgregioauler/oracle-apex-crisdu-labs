page 616 (
    name: Relatório Cliente Movimentação E-commerce
    title: Relatório Cliente Movimentação E-commerce
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region relatório-cliente-movimentação-e-commerce (
        name: Relatório Cliente Movimentação E-commerce
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                 select f.filialfavorita "Filial Favorita" 
                      , f.filialromance "Franquia"
                      , (select c.nomecidade
                         from catal.pessoas p
                             ,catal.cidades c
                         where p.idcidade = c.idcidade
                           and p.idpessoa = f.idpessoa) "Cidade"
                      , (select e.nome
                         from catal.pessoas p
                             ,catal.cidades c
                             ,catal.estados e
                         where p.idcidade = c.idcidade
                           and c.idestado = e.idestado
                           and p.idpessoa = f.idpessoa) "Estado"
                      , roman.pck_romance.fnc_nomerepresentante(f.idrepresentante) as "Distribuidor"
                      , f.idvendedora "ID comprador" 
                      , f.vendedora  "Nome comprador"
                      , trunc(f.dataemissao) "Data Compra"
                      , f.valortotal "Valor Venda"
                      , f.valorapagar "Valor Pedido"
                      , f.valorpago "Valor Pago"
                   from favorita.vw_pedidos_fav f
                  where f.idfilialfavorita = 8
                    and f.datacancelamento is null
                    and f.dataemissao between to_date(:P616_DATAINICIAL,'dd/mm/yyyy HH24:MI:SS') and 
                                              to_date(:P616_DATAFINAL,'dd/mm/yyyy HH24:MI:SS');
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 1505424319773472052
        }

