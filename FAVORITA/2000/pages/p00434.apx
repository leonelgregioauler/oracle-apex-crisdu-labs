page 434 (
    name: Acompanhamento de Cadastros
    title: Acompanhamento de Cadastros
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region dia-de-hoje (
        name: Dia de Hoje
        type: chart
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chartAppearance {
            orientation: horizontal
            stack: true
        }
        performance {
            lazyLoading: true
        }
        animation {
            onDataChange: none
        }
        tooltip {
            showGroupName: false
        }
        legend {
            hideAndShowBehavior: none
        }

        series dia (
            name: Dia
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT count(1) qtd
                         , nomefilialfavorita 
                    FROM roman.controlecontatossite c
                       , filiaisfavorita ff
                    where trunc(c.datacadastro) = trunc(sysdate)
                      and c.idfilialfavorita is not null
                      and c.idfilialfavorita = ff.idfilialfavorita
                      and c.origem = 'LF'
                    group by ff.nomefilialfavorita
                    ORDER BY 2 , 1
                    ```
            }
            columnMapping {
                label: NOMEFILIALFAVORITA
                value: QTD
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            minorTicks {
                show: false
            }
        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region no-mês (
        name: No Mês
        type: chart
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chartAppearance {
            orientation: horizontal
            stack: true
        }
        performance {
            lazyLoading: true
        }
        animation {
            onDataChange: none
        }
        tooltip {
            showGroupName: false
        }
        legend {
            hideAndShowBehavior: none
        }

        series mês (
            name: Mês
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT count(1) qtd
                         , nomefilialfavorita 
                    FROM roman.controlecontatossite c
                       , filiaisfavorita ff
                    where to_char(c.datacadastro,'MM/RRRR') = to_char(sysdate,'MM/RRRR')
                      and c.idfilialfavorita is not null
                      and c.idfilialfavorita = ff.idfilialfavorita
                      and c.origem = 'LF'
                    group by ff.nomefilialfavorita
                    ORDER BY 2 , 1
                    ```
            }
            columnMapping {
                label: NOMEFILIALFAVORITA
                value: QTD
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            minorTicks {
                show: false
            }
        )

    )

    region placar-de-cadastros (
        name: Placar de Cadastros
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(total.idfilialfavorita) filial
                     , total.qtd
                     , nvl(round((total.qtd/mesanterior.qtd)*100,2),0) crescimento
                     , nvl(aprovacoes.qtd,0) aprovacoes
                     , nvl(aprovadorestricao.qtd,0) aprovadorestricao
                     , nvl(encaminhado.qtd,0) encaminhados
                     , nvl(respondido.qtd,0) respondido
                     , nvl(foradearea.qtd,0) foradearea
                     , nvl(restricoes.qtd,0) restricoes
                     , nvl(debito.qtd,0) debito
                     , nvl(ativo.qtd,0) ativo
                     , nvl(utilizado.qtd,0) utilizado
                     , nvl(rejeitadodist.qtd,0) rejeitadodist
                from ( select c.idfilialfavorita 
                            , count(c.idcontrolecontatossite) qtd
                       from roman.controlecontatossite c 
                       where trunc(c.datacadastro) between to_date(:P434_DATAINICIO) and to_date(:P434_DATAFIM)  
                         and idfilialfavorita is not null
                       group by c.idfilialfavorita ) total
                   , ( select rc.idfilialfavorita 
                            , count(1) qtd
                       from roman.controlecontatossite rc
                       where rc.idfilialfavorita is not null
                         and ( :P434_idfilialfavorita is null or rc.idfilialfavorita = :P434_idfilialfavorita )
                         and trunc(rc.datacadastro) between to_date(:P434_DATAINICIO)-30 and to_date(:P434_DATAFIM)-30
                       group by rc.idfilialfavorita ) mesanterior 
                   , ( select count(1) qtd
                            , c.idfilialfavorita
                       from roman.controlecontatossite c
                       where trunc(c.datacadastro) between to_date(:P434_DATAINICIO) and to_date(:P434_DATAFIM)
                         and exists ( select 1
                                      from logroman.log_controlecontatossite lc
                                      where lc.idcontrolecontatossite = c.idcontrolecontatossite
                                        and lc.situacao               = 'C'
                                        and trunc(lc.dataalteracao) between to_date(:P434_DATAINICIO) and to_date(:P434_DATAFIM)+10 )
                       group by c.idfilialfavorita ) aprovacoes 
                   , ( select count(1) qtd
                            , c.idfilialfavorita
                       from roman.controlecontatossite c
                       where trunc(c.datacadastro) between to_date(:P434_DATAINICIO) and to_date(:P434_DATAFIM)
                         and exists ( select 1
                                      from logroman.log_controlecontatossite lc
                                      where lc.idcontrolecontatossite = c.idcontrolecontatossite
                                        and lc.situacao               = 'B'
                                        and trunc(lc.dataalteracao) between to_date(:P434_DATAINICIO) and to_date(:P434_DATAFIM)+10 )
                       group by c.idfilialfavorita ) aprovadorestricao
                   , ( select count(1) qtd
                            , c.idfilialfavorita
                       from roman.controlecontatossite c
                       where trunc(c.datacadastro) between to_date(:P434_DATAINICIO) and to_date(:P434_DATAFIM) 
                         and exists ( select 1
                                      from logroman.log_controlecontatossite lc
                                      where lc.idcontrolecontatossite = c.idcontrolecontatossite
                                        and lc.situacao               = 'E'
                                        and trunc(lc.dataalteracao) between to_date(:P434_DATAINICIO) and to_date(:P434_DATAFIM)+10)
                         and not exists ( select 1
                                          from logroman.log_controlecontatossite lcc
                                          where lcc.idcontrolecontatossite = c.idcontrolecontatossite
                                            and lcc.situacao               = 'C'
                                            and trunc(lcc.dataalteracao) between to_date(:P434_DATAINICIO) and to_date(:P434_DATAFIM)+10)
                       group by c.idfilialfavorita ) encaminhado
                   , ( select count(1) qtd
                            , c.idfilialfavorita
                       from roman.controlecontatossite c
                       where trunc(c.datacadastro) between to_date(:P434_DATAINICIO) and to_date(:P434_DATAFIM) 
                         and exists ( select 1
                                      from logroman.log_controlecontatossite lc
                                      where lc.idcontrolecontatossite = c.idcontrolecontatossite
                                        and lc.situacao               = 'N'
                                        and trunc(lc.dataalteracao) between to_date(:P434_DATAINICIO) and to_date(:P434_DATAFIM)+10 )
                       group by c.idfilialfavorita ) foradearea
                   , ( select count(1) qtd
                            , c.idfilialfavorita
                       from roman.controlecontatossite c
                       where trunc(c.datacadastro) between to_date(:P434_DATAINICIO) and to_date(:P434_DATAFIM) 
                         and exists ( select 1
                                      from logroman.log_controlecontatossite lc
                                      where lc.idcontrolecontatossite = c.idcontrolecontatossite
                                        and lc.situacao               = 'S'
                                        and trunc(lc.dataalteracao) between to_date(:P434_DATAINICIO) and to_date(:P434_DATAFIM)+10 )
                       group by c.idfilialfavorita ) restricoes
                   , ( select count(1) qtd
                            , c.idfilialfavorita
                       from roman.controlecontatossite c
                       where trunc(c.datacadastro) between to_date(:P434_DATAINICIO) and to_date(:P434_DATAFIM) 
                         and exists ( select 1
                                      from logroman.log_controlecontatossite lc
                                      where lc.idcontrolecontatossite = c.idcontrolecontatossite
                                        and lc.situacao               = 'R'
                                        and trunc(lc.dataalteracao) between to_date(:P434_DATAINICIO) and to_date(:P434_DATAFIM)+10 )
                       group by c.idfilialfavorita ) respondido 
                   , ( select count(1) qtd
                            , c.idfilialfavorita
                       from roman.controlecontatossite c
                       where trunc(c.datacadastro) between to_date(:P434_DATAINICIO) and to_date(:P434_DATAFIM) 
                         and exists ( select 1
                                      from logroman.log_controlecontatossite lc
                                      where lc.idcontrolecontatossite = c.idcontrolecontatossite
                                        and lc.situacao               = 'D'
                                        and trunc(lc.dataalteracao) between to_date(:P434_DATAINICIO) and to_date(:P434_DATAFIM)+10 )
                       group by c.idfilialfavorita ) debito
                   , ( select count(1) qtd
                            , c.idfilialfavorita
                       from roman.controlecontatossite c
                       where trunc(c.datacadastro) between to_date(:P434_DATAINICIO) and to_date(:P434_DATAFIM)
                         and exists ( select 1
                                      from logroman.log_controlecontatossite lc
                                      where lc.idcontrolecontatossite = c.idcontrolecontatossite
                                        and lc.situacao               = 'A'
                                        and trunc(lc.dataalteracao) between to_date(:P434_DATAINICIO) and to_date(:P434_DATAFIM)+10 )
                       group by c.idfilialfavorita ) ativo 
                   , ( select count(1) qtd
                            , c.idfilialfavorita
                       from roman.controlecontatossite c
                       where trunc(c.datacadastro) between to_date(:P434_DATAINICIO) and to_date(:P434_DATAFIM)
                         and exists ( select 1
                                      from logroman.log_controlecontatossite lc
                                      where lc.idcontrolecontatossite = c.idcontrolecontatossite
                                        and lc.situacao               in ('U','R')
                                        and lc.datapassadorepres      is not null
                                        and lc.idrepresentante        is not null
                                        and trunc(lc.dataalteracao) between to_date(:P434_DATAINICIO) and to_date(:P434_DATAFIM)+10 )
                       group by c.idfilialfavorita ) utilizado 
                    , ( select count(1) qtd
                            , c.idfilialfavorita
                       from roman.controlecontatossite c
                       where trunc(c.datacadastro) between to_date(:P434_DATAINICIO) and to_date(:P434_DATAFIM)
                         and exists ( select 1
                                      from logroman.log_controlecontatossite lc
                                      where lc.idcontrolecontatossite = c.idcontrolecontatossite
                                        and lc.situacao               in ('Z','X') )
                       group by c.idfilialfavorita ) rejeitadodist
                where mesanterior.idfilialfavorita(+)            = total.idfilialfavorita
                  and aprovacoes.idfilialfavorita(+)             = total.idfilialfavorita
                  and aprovadorestricao.idfilialfavorita(+)      = total.idfilialfavorita
                  and foradearea.idfilialfavorita(+)             = total.idfilialfavorita
                  and restricoes.idfilialfavorita(+)             = total.idfilialfavorita
                  and debito.idfilialfavorita(+)                 = total.idfilialfavorita
                  and encaminhado.idfilialfavorita(+)            = total.idfilialfavorita
                  and respondido.idfilialfavorita(+)             = total.idfilialfavorita
                  and ativo.idfilialfavorita(+)                  = total.idfilialfavorita
                  and utilizado.idfilialfavorita(+)              = total.idfilialfavorita
                  and rejeitadodist.idfilialfavorita(+)          = total.idfilialfavorita
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 18067226552136824
        }

