page 489 (
    name: Lista de Empresas
    title: Lista de Empresas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region lista-de-empresas (
        name: Lista de Empresas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.idempresavirtualage
                     , initcap(e.nome) as "Nome"
                     , e.cnpj as "Cnpj"
                     , e.tipo as "Tipo"
                     , f.nomefilialfavorita as "Filial Fav"
                     , e.id_pessoa_estrangeira as "Id Pesoa Estrangeira"
                     , e.limiteregua "Limite Régua ST"
                     , e.stligado "St Ligado"
                     , decode(e.versaointegracao,1,'Versão 1','Versão 2') "Versão Integração" 
                from empresasvirtualage e,
                     filiaisfavorita f
                where e.idfilialfavorita = f.idfilialfavorita(+)
                order by e.idempresavirtualage
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 490
                items: {
                    P490_IDEMPRESAVIRTUALAGE: #IDEMPRESAVIRTUALAGE#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 96969730905318690
        }

        column Cnpj (
            type: plainText
            heading {
                heading: Cnpj
                alignment: center
            }
            layout {
                sequence: 21
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column "Filial Fav" (
            type: plainText
            heading {
                heading: Filial fav
                alignment: center
            }
            layout {
                sequence: 61
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: L
            }
        )

        column IDEMPRESAVIRTUALAGE (
            type: plainText
            heading {
                heading: Id Empresa Va
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column "Id Pesoa Estrangeira" (
            type: plainText
            heading {
                heading: Id pesoa estrangeira
                alignment: center
            }
            layout {
                sequence: 51
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: K
            }
        )

        column "Limite Régua ST" (
            type: plainText
            heading {
                heading: Limite régua st
                alignment: center
            }
            layout {
                sequence: 71
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: M
            }
        )

        column Nome (
            type: plainText
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 11
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column "St Ligado" (
            type: plainText
            heading {
                heading: St ligado
                alignment: center
            }
            layout {
                sequence: 81
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: N
            }
        )

        column Tipo (
            type: plainText
            heading {
                heading: Tipo
                alignment: center
            }
            layout {
                sequence: 31
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        column "Versão Integração" (
            type: plainText
            heading {
                heading: Versão Integração
            }
            layout {
                sequence: 91
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: O
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 969746 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn "Cnpj" (
                sequence: 3
            )

            displayColumn "Filial Fav" (
                sequence: 6
            )

            displayColumn IDEMPRESAVIRTUALAGE (
                sequence: 1
            )

            displayColumn "Limite Régua ST" (
                sequence: 7
            )

            displayColumn "Nome" (
                sequence: 2
            )

            displayColumn "St Ligado" (
                sequence: 8
            )

            displayColumn "Tipo" (
                sequence: 4
            )

            displayColumn "Versão Integração" (
                sequence: 9
            )

            displayColumn "id Id Pesoa Estrangeira" (
                sequence: 5
            )

        )

    )

    region menu (
        name: Menu
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    button create (
        buttonName: CREATE
        label: Nova Empresa
        layout {
            sequence: 10
            region: @menu
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 490
                clearCache: 490
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction create-button-dialog-closed (
        name: Create Button - Dialog Closed
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @lista-de-empresas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @lista-de-empresas
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @lista-de-empresas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

