page 532 (
    name: Detalhes de Despesas das Filiais
    title: Detalhes de Despesas das Filiais
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region detalhe-de-despesas (
        name: Detalhe de Despesas
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P532_DATA (
        type: textField
        label {
            label: "Data Criação "
            alignment: left
        }
        layout {
            sequence: 40
            region: @detalhe-de-despesas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P532_IDDETALHEDESPESA
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P532_DETALHE (
        type: textarea
        label {
            label: "Detalhe "
            alignment: left
        }
        settings {
            autoHeight: true
        }
        layout {
            sequence: 10
            region: @detalhe-de-despesas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 70
            height: 5
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P532_IDDETALHEDESPESA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @detalhe-de-despesas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P532_IDFILIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @detalhe-de-despesas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P532_IDFILIALCAIXA (
        type: hidden
        layout {
            sequence: 50
            region: @detalhe-de-despesas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P532_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @detalhe-de-despesas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P532_USUARIO (
        type: textField
        label {
            label: Usuário
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 60
            region: @detalhe-de-despesas
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P532_IDDETALHEDESPESA
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    button criar (
        buttonName: CRIAR
        label: Criar
        layout {
            sequence: 40
            region: @detalhe-de-despesas
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P532_IDDETALHEDESPESA
        }
    )

    button deletar (
        buttonName: DELETAR
        label: Deletar
        layout {
            sequence: 20
            region: @detalhe-de-despesas
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P532_IDDETALHEDESPESA
        }
    )

    button salvar (
        buttonName: SALVAR
        label: Salvar
        layout {
            sequence: 30
            region: @detalhe-de-despesas
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P532_IDDETALHEDESPESA
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @detalhe-de-despesas
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 245
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process dml-select (
        name: DML Select
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                  vidfilialcaixa number := :P0_IDFILIALCAIXA;
                  vdata date := sysdate;
                begin
                  --
                  -- raise_application_error(-20001,'usuario ->'||vusuario);
                  voperacao_dml := 'S';
                  --
                  roman.PCK_ACERTOS_RMC.PRC_DETALHESDESPESASFILIAIS( PIDDETALHEDESPESA => :P532_IDDETALHEDESPESA,
                                                               PIDFILIAL => vidfilialcaixa,
                                                               PDATA => :P532_DATA,
                                                               PUSUARIO => :P532_USUARIO,
                                                               PDETALHE => :P532_DETALHE,
                                                               PMD5 => :P532_MD5,
                                                               POPERACAO_DML => voperacao_dml);
                  --
                end;
                            
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 22402043187728025
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P532_IDDETALHEDESPESA
        }
    )

    process processo-dml-em-detalhes-de-despesas (
        name: Processo DML em Detalhes de Despesas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                  vusuario varchar2(100) := v('APP_USER');
                  --vusuario varchar2(100) := 'brunob';
                  vidfilialcaixa number;
                  vdata date := sysdate;
                begin
                  --
                select f.idfilialantigo
                into vidfilialcaixa
                from favorita.filiaisfavorita f
                where f.idfilialfavorita = :P532_IDFILIALCAIXA;
                  --
                  if v('REQUEST') = 'CRIAR' then
                    --
                    voperacao_dml := 'I';
                    --
                  elsif v('REQUEST') = 'SALVAR' then
                    --
                    voperacao_dml := 'U';
                    --
                  elsif v('REQUEST') = 'DELETAR' then
                    --
                    voperacao_dml := 'D';
                    --
                  end if;
                  --
                  --raise_application_error(-20001,'usuario ->'||vusuario||' :P532_IDDETALHEDESPESA->'||:P532_IDDETALHEDESPESA||' :P532_IDFILIALCAIXA-> '||:P532_IDFILIALCAIXA||' vdata->'||vdata||' :P532_DETALHE-> '||:P532_DETALHE||' voperacao_dml->'||voperacao_dml);
                  --
                  roman.PCK_ACERTOS_RMC.PRC_DETALHESDESPESASFILIAIS( PIDDETALHEDESPESA => :P532_IDDETALHEDESPESA,
                                                               PIDFILIAL => vidfilialcaixa,
                                                               PDATA => vdata,
                                                               PUSUARIO => vusuario,
                                                               PDETALHE => :P532_DETALHE,
                                                               PMD5 => :P532_MD5,
                                                               POPERACAO_DML => voperacao_dml);
                  --
                end;
                                                               
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo realizado com sucesso!
        }
        error {
            errorMessage: #SQLERRM#
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 22427021077756501
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('CRIAR','SALVAR','DELETAR')
        }
    )

)

