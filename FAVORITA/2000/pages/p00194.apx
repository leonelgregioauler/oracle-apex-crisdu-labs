page 194 (
    name: Relatório Permissões Tipos Protocolos
    title: Relatório Permissões Tipos Protocolos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region permissões-tipos-protocolos (
        name: Permissões Tipos Protocolos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select vp.idpermissaotipoprotocolo
                     , vp.idtipoprotocolo
                     , vp.tipoprotoloco
                     , vp.idusuario
                     , vp.nomeusuario
                     , vp.criar
                     , vp.decodecriar
                     , vp.atender
                     , vp.decodeatender
                from vw_permissoestiposprot_fav  vp
                where vp.ididioma = :P0_IDIDIOMA
                  and ( :P194_IDUSUARIO is null or vp.idusuario = :P194_IDUSUARIO )
                order by nomeusuario
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhuma permissão encontrada
        }
        advanced {
            savedReportMappingIdentifier: 241461236577058133
        }

        column ATENDER (
            type: hidden
            heading {
                heading: Atender
            }
            layout {
                sequence: 80
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
            security {
                escapeSpecialChars: false
            }
        )

        column CRIAR (
            type: hidden
            heading {
                heading: Criar
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
            security {
                escapeSpecialChars: false
            }
        )

        column DECODEATENDER (
            type: plainText
            heading {
                heading: Atender
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        column DECODECRIAR (
            type: plainText
            heading {
                heading: Criar
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column IDPERMISSAOTIPOPROTOCOLO (
            type: link
            heading {
                heading: Ver/Editar
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 196
                    items: {
                        P196_IDPERMISSAOTIPOPROTOCOLO: #IDPERMISSAOTIPOPROTOCOLO#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column IDTIPOPROTOCOLO (
            type: hidden
            heading {
                heading: Idtipoprotocolo
            }
            layout {
                sequence: 20
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDUSUARIO (
            type: hidden
            heading {
                heading: Idusuario
            }
            layout {
                sequence: 40
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NOMEUSUARIO (
            type: plainText
            heading {
                heading: Usuário
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column TIPOPROTOLOCO (
            type: plainText
            heading {
                heading: Tipo Protocolo
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 2415494 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ATENDER (
                sequence: 8
            )

            displayColumn CRIAR (
                sequence: 6
            )

            displayColumn DECODEATENDER (
                sequence: 9
            )

            displayColumn DECODECRIAR (
                sequence: 7
            )

            displayColumn IDPERMISSAOTIPOPROTOCOLO (
                sequence: 1
            )

            displayColumn IDTIPOPROTOCOLO (
                sequence: 2
            )

            displayColumn IDUSUARIO (
                sequence: 4
            )

            displayColumn NOMEUSUARIO (
                sequence: 5
            )

            displayColumn TIPOPROTOLOCO (
                sequence: 3
            )

            controlBreak (
                column: NOMEUSUARIO
                layout {
                    sequence: 1
                }
            )

        )

    )

    pageItem P194_IDUSUARIO (
        type: plugin/select
        label {
            label: Usuário
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-usuarios
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--primary
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 194
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 194
                items: {
                    P194_IDUSUARIO: &P194_IDUSUARIO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

    branch (
        name: Go To Page 196
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 196
                items: {
                    P196_IDPERMISSAOTIPOPROTOCOLO:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

)

