page 554 (
    name: Abrir Fotos de Documento
    title: Abrir Fotos de Documento
    appearance {
        pageMode: nonModalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region abrir-arquivo (
        name: Abrir Arquivo
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P554_NOMEARQUIVO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @abrir-arquivo
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    process arquivo (
        name: Arquivo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  varquivo varchar2(100) := :P554_NOMEARQUIVO;
                begin
                  -- Call the procedure
                  roman.pck_anexos.prc_abreaqruivo_web(pnomearquivo => varquivo);
                end;
                
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 763198688308446042
        }
    )

)

