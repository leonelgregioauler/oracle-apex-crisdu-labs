page 112 (
    name: Cadastro Tipos Compras/Transf/Remessas
    title: Cadastro Tipos Compras/Transf/Remessas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro (
        name: Cadastro
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P112_DESCRICAO (
        type: textField
        label {
            label: Descrição
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @cadastro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P112_IDTIPOCOMPTRANSREM (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @cadastro
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P112_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @cadastro
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P112_OPERACAO_DML (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @cadastro
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 40
            region: @cadastro
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P112_IDTIPOCOMPTRANSREM
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 20
            region: @cadastro
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 111
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 10
            region: @cadastro
            slot: help
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P112_IDTIPOCOMPTRANSREM
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 30
            region: @cadastro
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P112_IDTIPOCOMPTRANSREM
        }
    )

    process consulta-tipo-ctrp (
        name: Consulta Tipo CTRP
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  #OWNER#.PCK_COMPRASTRANSF_FAV.PRC_TIPOSCOMPTRANSREM( PIDTIPOCOMPTRANSREM => :P112_IDTIPOCOMPTRANSREM,
                                                                       PDESCRICAO => :P112_DESCRICAO,
                                                                       PMD5 => :P112_MD5,
                                                                       POPERACAO_DML => 'S');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 14800057202484505
        }
    )

    process operação-dml-em-cadastro-de-tipos-de-ctrp (
        name: Operação DML em Cadastro de Tipos de CTRP
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  --
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  #OWNER#.PCK_COMPRASTRANSF_FAV.PRC_TIPOSCOMPTRANSREM( PIDTIPOCOMPTRANSREM => :P112_IDTIPOCOMPTRANSREM,
                                                                       PDESCRICAO => :P112_DESCRICAO,
                                                                       PMD5 => :P112_MD5,
                                                                       POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro Atualizado!
        }
        advanced {
            executionMappingIdentifier: 14820585044924536
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('INSERIR','ATUALIZAR','EXCLUIR')
                ```
        }
    )

    branch (
        name: go to page 111
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 111
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('ATUALIZAR','INSERIR','EXCLUIR')
                ```
        }
    )

)

