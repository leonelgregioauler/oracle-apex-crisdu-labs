    region tarefas-concluídas (
        name: Tarefas Concluídas
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idtarefa
                     , pck_util_fav.fnc_retornatipotarefa(t.idtipotarefa,:P0_IDIDIOMA) tipotarefa
                     , '<a href="javascript:window.open('''|| APEX_UTIL.PREPARE_URL(
                                                                 p_url => 'f?p=&APP_ID.:175:'||v('APP_SESSION')||'::NO::P175_TELEFONE:'||replace(replace(replace(replace(t.telefone,'(',''),')',''),'.',''),'-',''),
                                                                 p_checksum_type => 'SESSION')||''');void(0)";>'||t.telefone||'</a>' telefone
                     , t.datainclusao
                     , t.prioridade
                     , pck_util_fav.fnc_retornasituacaotarefa(t.idsituacao,:P0_IDIDIOMA) situacao
                     , t.observacao
                     , t.nomeusuario
                     , t.cliente
                     , t.datainicio
                     , t.dataconclusao
                     , t.pedidosfeitos
                     , t.historicos
                from vw_tarefas_fav t
                where t.idusuario = pck_util_fav.fnc_retornaidusuario(v('APP_USER'))
                  and t.idsituacao = 30
                  and t.ididioma = :P0_IDIDIOMA
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
