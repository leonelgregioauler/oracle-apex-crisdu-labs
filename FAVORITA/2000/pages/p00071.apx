    pageItem P71_IDTIPOTAREFABUSCAR (
        type: selectList
        label {
            label: Tipo de Tarefa a Buscar
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.descricao display_value
                 , t.idtipotarefa return_value
                from tipostarefas t
                where exists ( select 1
                               from permissoestipostarefas p
                               where p.idusuario = pck_util_fav.fnc_retornaidusuario(v('APP_USER')) 
                                 and p.idtipotarefa = t.idtipotarefa
                                 and p.buscartarefa = 'S' )
                ```
        }
        layout {
            sequence: 10
            region: @buscar-tarefa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1.5
        }
        security {
            encryptSessionState: false
        }
    )

    button buscar (
        buttonName: BUSCAR
        label: Buscar
        layout {
            sequence: 20
            region: @buscar-tarefa
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 
                from tarefas 
                where idusuario = pck_util_fav.fnc_retornaidusuario(v('APP_USER'))
                and idsituacao = 10
                ```
        }
    )

    button vincular-cliente (
        buttonName: VINCULAR_CLIENTE
        label: Vincular Cliente
        layout {
            sequence: 10
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 260
                items: {
                    P260_IDPESSOA:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                               from tarefas t
                               where t.idusuario = :P0_IDUSUARIO 
                                 and t.idpessoa is null )
                ```
        }
    )

    process buscar-tarefa (
        name: Buscar Tarefa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidusuario number;
                  vnumeropa varchar2(10);
                  --
                begin
                  --
                  vidusuario := pck_util_fav.fnc_retornaidusuario(v('APP_USER'));
                  vnumeropa := :P0_NUMEROPOSICAOATENDIMENTO;
                  --
                  Pck_Tarefas_Fav.prc_buscartarefas(pidusuario                => vidusuario,
                                                    pidtipotarefa             => :P71_IDTIPOTAREFABUSCAR,
                                                    pnumeroposicaoatendimento => vnumeropa);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 766332652287661131
        }
    )

)

