    region últimas-ligações-de-tarefas-pendentes-abertas (
        name: Últimas ligações de tarefas pendentes/abertas
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct i.numero
                     , trunc(I.data) data
                     , idtarefa tarefa
                from catal.importaemails i
                   , tarefas t
                where t.telefone = i.numero
                  and t.idusuario = pck_util_fav.fnc_retornaidusuario(v('APP_USER'))
                  and t.idsituacao in (0,10,20)
                  and data > sysdate - 1/*14400/86400*/
                  and rownum <= 10
                order by 1 desc
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        messages {
            whenNoDataFound: Nenhuma ligação localizada
        }

