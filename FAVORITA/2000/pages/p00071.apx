    region minhas-tarefas (
        name: Minhas Tarefas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idtarefa
                     , tipotarefa
                     , '<a href="javascript:window.open('''|| APEX_UTIL.PREPARE_URL(
                                                                  p_url => 'f?p=&APP_ID.:175:'||v('APP_SESSION')||'::NO::P175_TELEFONE:'||replace(replace(replace(replace(t.telefone,'(',''),')',''),'.',''),'-',''),
                                                                  p_checksum_type => 'SESSION')||''');void(0)";>'||t.telefone||'</a>' telefone
                     , t.datainclusao
                     , t.prioridade
                     , situacao
                     , t.observacao
                     , t.nomeusuario
                     , t.cliente||' - '||t.cpfcliente cliente
                     , t.datainicio
                     , t.dataconclusao
                     , maxidhistorico
                     , nomeligou
                     , idvendedoraligou
                     , case 
                        when idvendedoraligou is not null then
                --            '<a href="javascript:apex.confirm(''Deseja iniciar o pedido?'',{window.open('''|| APEX_UTIL.PREPARE_URL(
                --                                                                                                p_url => 'f?p=&APP_ID:80:'||v('APP_SESSION')||'::NO::P80_IDVENDEDORA:'||idvendedoraligou,
                --                                                                                                p_checksum_type => 'SESSION')||''')})";><img src=/i/menu/pencil16x16.gif alt="Iniciar Pedido" border=0 width=16 height=16></a>'  
                            '<a href="javascript:window.open('''|| APEX_UTIL.PREPARE_URL(
                                                                  p_url => 'f?p=&APP_ID.:80:'||v('APP_SESSION')||'::NO::P80_IDVENDEDORA:'||idvendedoraligou,
                                                                  p_checksum_type => 'SESSION')||''')";><img src=/i/menu/pencil16x16.gif alt="Iniciar Pedido" border=0 width=16 height=16></a>'  
                       else
                         '-'
                       end iniciarpedido
                     , dataespera
                     , t.pedidosfeitos
                     , historicos
                     /*case
                         when idpessoa is not null then
                           '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':85:'||v('APP_SESSION')||'::NO::P85_IDPESSOA:'||t.idpessoa ,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' 
                       else
                         '-'
                       end vercadastro*/
                     , case
                         when idpessoa is not null then 
                           t.idpessoa
                       else
                           null
                       end idpessoa
                from vw_tarefas_fav t
                where t.ididioma = :P0_IDIDIOMA
                  and t.idusuario = pck_util_fav.fnc_retornaidusuario(v('APP_USER'))
                  and t.idsituacao not in (40,30)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
