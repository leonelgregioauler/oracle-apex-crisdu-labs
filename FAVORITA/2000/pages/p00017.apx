    dynamicAction esconde-data (
        name: Esconde Data
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P17_DATA
        }
        clientSideCondition {
            type: item=value
            item: P17_DATA
            value: 0
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P17_DATAINICIO
            }
            execution {
                sequence: 10
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P17_DATAFIM
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P17_DATAINICIO
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show-2 (
