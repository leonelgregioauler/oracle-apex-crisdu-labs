page 17 (
    name: Relatório de Cupons Descontos
    title: Cupons Descontos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cupons-descontos (
        name: Cupons Descontos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.idcupomdesconto
                     , f.nome
                     , f.idfilialromance
                     , pck_util_fav.fnc_nomefilialromance(idfilialromance) filialromance
                     , f.datainicio
                     , f.datafim
                     , f.valordesconto
                     , f.qtdcodigos
                     , f.qtdcodigosutilizados
                     , f.tipodesconto
                     , f.nomeusuario
                     , IDCUPOMDESCONTO ID
                from vw_cuponsdescontos_fav f
                where (:P17_DATA = 0
                         or (:P17_DATA = 1 and f.datainicio between :P17_DATAINICIO and :P17_DATAFIM )
                         or (:P17_DATA = 2 and f.datafim between :P17_DATAINICIO and :P17_DATAFIM ))
                  and (:P17_VALIDO = 0
                         or (:P17_VALIDO = 1 and  f.datafim >= sysdate)
                         or (:P17_VALIDO = 2 and  f.datafim < sysdate))
                  and (:P17_IDUSUARIO is null or :P17_IDUSUARIO = f.idusuario) 
                  and (:P17_TROCA = 0
                         or (:P17_TROCA = 1 and exists( select 1
                                                        from favorita.codigoscuponsdescontos cp
                                                        where cp.idcupomdesconto = f.idcupomdesconto
                                                          and exists( select 1
                                                                      from favorita.pedidos p
                                                                      where p.idpedido = cp.idpedido
                                                                        and p.tipopedido = 'T'))
                                            and not exists( select 1
                                                            from favorita.codigoscuponsdescontos cp
                                                            where cp.idcupomdesconto = f.idcupomdesconto
                                                              and exists( select 1
                                                                          from favorita.pedidos p
                                                                          where p.idpedido = cp.idpedido
                                                                            and p.tipopedido != 'T')))
                         or (:P17_TROCA = 2 and exists( select 1
                                                        from favorita.codigoscuponsdescontos cp
                                                        where cp.idcupomdesconto = f.idcupomdesconto
                                                          and exists( select 1
                                                                      from favorita.pedidos p
                                                                      where p.idpedido = cp.idpedido
                                                                        and p.tipopedido != 'T')))) 
                         
                
                    
                      
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 11898275681894635
        }

