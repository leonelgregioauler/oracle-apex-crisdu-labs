page 373 (
    name: Consulta de Atendimento
    title: Consulta de Atendimento
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 40%
        height: 40%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cidade-atendida (
        name: Cidade Atendida?
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P373_ATEDIMENTO (
        type: textField
        label {
            label: É Atendida?
            alignment: left
        }
        layout {
            sequence: 30
            region: @cidade-atendida
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select nvl(listagg(w.empresa,' ') within group (order by 1),'Nenhuma Filial atende essa Cidade!') filiais
                from roman.vw_cidades_atencidas_rmc w
                where w.idcidade = :P373_IDCIDADE;
                ```
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P373_IDCIDADE (
        type: popupLov
        label {
            label: Cidade
            alignment: left
        }
        settings {
            displayAs: modalDialog
            initialFetch: autoCurrentValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nomecidade||'/'||e.sigla||' - '||p.nome display_value
                     , c.idcidade
                from roman.cidades c
                   , roman.estados e
                   , catal.paises p
                where e.idestado = c.idestado
                  and p.idpais   = e.idpais
                order by c.nomecidade
                ```
        }
        layout {
            sequence: 20
            region: @cidade-atendida
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction escolhe-a-cidade (
        name: Escolhe a Cidade
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P373_IDCIDADE
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: ATENDER
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        name: Go To Page 373
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 373
                items: {
                    P373_IDCIDADE: &P373_IDCIDADE.
                    P373_ATEDIMENTO:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: ATENDER
        }
    )

)

