page 666 (
    name: Menu Conquistou Levou
    title: Menu Conquistou Levou
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region conquistou-levou (
        name: Conquistou Levou
        type: list
        source {
            list: @conquistou-levou
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            listTemplate: @/cards
            templateOptions: [
                u-colors
                t-Cards--featured force-fa-lg
                t-Cards--displayIcons
                t-Cards--5cols
                t-Cards--animColorFill
            ]
        }
    )

)

