    button gerar-tarefas (
        buttonName: GERAR_TAREFAS
        label: Gerar Tarefas
        layout {
            sequence: 10
            region: @negociações-vencidas
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process gerar-tarefas (
        name: Gerar Tarefas
        type: executeCode
        editableRegion: @negociações-vencidas
        source {
            plsqlCode:
                ```plsql
                declare
                  vidpessoa number;
                  vexiste varchar2(1);
                  vtelefone varchar2(30);
                  vcodigoarea number;
                  vidusuario number;
                  vspc varchar2(1);
                begin
                  --
                  if :P332_ATENDENTE is null then
                    --
                    vidusuario := :IDUSUARIO;
                    --
                  else
                    --
                    vidusuario := :P332_ATENDENTE;
                    --
                  end if;
                  --
                  begin
                    --
                    select idpessoa , spc
                    into vidpessoa , vspc
                    from vendedoras
                    where idvendedora = :IDVENDEDORA;
                    --
                  exception
                    when NO_DATA_FOUND then
                      vidpessoa := null;
                      vspc := null;
                  end;
                  --
                  begin
                    --
                    select translate(t.telefone,'0123456789AaBbCcDdEeFfGgHhIiJjKkLlMmNnOoPpQqRrSsTtUuVvXxYyWwZz_-,.  Ññ~ !@#$%?&*()/??','0123456789') telefone
                    into vtelefone
                    from telefonespessoas t
                    where t.idpessoa = vidpessoa
                      and rownum = 1;
                    --
                  exception 
                    when NO_DATA_FOUND then
                      vtelefone := null;
                  end;
                  --
                  if vtelefone is not null then
                    --
                    select substr(to_number(vtelefone),0,2)
                    into vcodigoarea
                    from dual;
                    --
                  end if;
                  --
                  begin
                    --
                    select 'S'
                    into vexiste
                    from tarefas t
                    where t.idpessoa = vidpessoa
                      and t.idtipotarefa in (9,10)
                      and t.idsituacao in (0,10,20);
                  exception 
                    when others then
                      vexiste := 'N';
                  end;
                  --
                  if vexiste = 'N' then
                    --
                    if nvl(vspc,'N') = 'N' then
                      --
                      if vtelefone is not null then
                        --
                        insert into tarefas ( idtarefa            , datainclusao    , idsituacao
                                            , observacao          , idtipotarefa    , idpessoa
                                            , idgrupoatendimento  , telefone        , codigoarea 
                                            , idusuario )
                        values ( seq_idtarefa.nextval,   sysdate,  0
                               , roman.pck_romance.fnc_retornatelefones(:IDVENDEDORA) , 9  , vidpessoa
                               , 3 , vtelefone , vcodigoarea
                               , vidusuario ); 
                        --
                      end if;
                      --
                    elsif vspc = 'S' then
                      --
                      insert into tarefas ( idtarefa            , datainclusao    , idsituacao
                                          , observacao          , idtipotarefa    , idpessoa
                                          , idgrupoatendimento  , telefone        , codigoarea 
                                          , idusuario )
                      values ( seq_idtarefa.nextval,   sysdate,  0
                             , roman.pck_romance.fnc_retornatelefones(:IDVENDEDORA) , 10  , vidpessoa
                             , 3 , vtelefone , vcodigoarea
                             , vidusuario ); 
                      --
                    end if;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Tarefas geradas com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1419551546878451903
        }
        serverSideCondition {
            type: request=Value
            value: GERAR_TAREFAS
        }
    )

    branch (
        name: Go To Page 332
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 332
                items: {
                    P332_DATAINICIO: &P332_DATAINICIO.
                    P332_DATAFIM: &P332_DATAFIM.
                    P332_IDFILIALROMANCE: &P332_IDFILIALROMANCE.
                    P332_WHATSAPP: &P332_WHATSAPP.
                    P332_IDREPRESENTANTE: &P332_IDREPRESENTANTE.
                    P332_ATENDENTE: &P332_ATENDENTE.
                }
                action: resetPagination
            }
        }
    )

)

