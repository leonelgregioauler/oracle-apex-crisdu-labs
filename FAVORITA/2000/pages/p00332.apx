    pageItem P332_ATENDENTE (
        type: selectList
        label {
            label: Enviar Para
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomeusuario(usuario) display_value
                     , idusuario return_value
                from usuarios u
                where u.idgerente = 80
                  and u.ativo = 'S'
                order by 1
                ```
            nullDisplayValue: "- Sem Negociadora - "
