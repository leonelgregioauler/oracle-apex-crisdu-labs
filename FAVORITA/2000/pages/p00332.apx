page 332 (
    name: Controle de Negociações
    title: Controle de Negociações
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region negociações-vencidas (
        name: Negociações Vencidas
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 'Negociação Favorita' origem
                     , 'P'||p.idpedido nrpedido
                     , roman.pck_romance.fnc_nomevendedora(p.idvendedora) nome
                     , roman.pck_romance.fnc_cpfvendedora(p.idvendedora) cpf
                     , pp.valorapagar
                     , p.idvendedora
                     , p.idnegociadoraresponsavel idusuario
                     , pck_util_fav.fnc_nomeusuario(idnegociadoraresponsavel) nomeusuario
                     , decode(v.spc,'S','Sim','Não') enviadaspc
                     , roman.pck_romance.fnc_nomefilial(p.idfilialromance) empresa
                     , roman.pck_romance.fnc_nomerepresentante(p.idrepresentante) distribuidor
                from parcelamentospedidos pp
                   , pedidos p
                   , vendedoras v
                where trunc(pp.datavencimento) between to_date(:P332_DATAINICIO) and to_date(:P332_DATAFIM)
                  and pp.idpedido = p.idpedido
                  and v.idvendedora = p.idvendedora
                  and pp.situacao not in ('Q','E')
                  and ( :P332_IDFILIALROMANCE is null or p.idfilialromance = :P332_IDFILIALROMANCE ) 
                  and ( :P332_IDREPRESENTANTE is null or p.idrepresentante = :P332_IDREPRESENTANTE )
                  and ( :P332_WHATSAPP is null
                     or ( :P332_WHATSAPP = 'S' and 1 = 1 )
                     or (  :P332_WHATSAPP = 'N' and p.idnegociadoraresponsavel not in (267,224,3509,270) ) )
                  and not exists ( select 1
                                   from tarefas t
                                   where t.idtipotarefa in (9,10)
                                     and t.idsituacao in (0,10,20)
                                     and t.idpessoa = v.idpessoa )
                union
                select 'Negociação Romance'
                     , 'N'||n.numeronota
                     , roman.pck_romance.fnc_nomevendedora(n.idvendedora) nome
                     , roman.pck_romance.fnc_cpfvendedora(n.idvendedora) cpf
                     , pn.valorapagar
                     , n.idvendedora
                     , ( select idusuario
                         from usuarios u
                         where u.usuario = n.responsavelcobranca ) idusuario
                     , pck_util_fav.fnc_nomeusuario((select idusuario
                                                     from usuarios u
                                                     where u.usuario = n.responsavelcobranca))
                     , decode(v.spc,'S','Sim','Não') enviadaspc
                     , roman.pck_romance.fnc_nomefilial(n.idfilial) empresa
                     , roman.pck_romance.fnc_nomerepresentante(n.idrepresentante) distribuidor
                from roman.parcelamentosnotasvendas pn
                   , roman.notasvendas n
                   , vendedoras v
                where trunc(pn.datavencimento) between to_date(:P332_DATAINICIO) and to_date(:P332_DATAFIM)
                  and n.idnotavenda = pn.idnotavenda
                  and pn.situacao not in ('Q','E')
                  and v.idvendedora = n.idvendedora
                  and ( :P332_IDFILIALROMANCE is null or n.idfilial = :P332_IDFILIALROMANCE ) 
                  and ( :P332_IDREPRESENTANTE is null or n.idrepresentante = :P332_IDREPRESENTANTE )
                  and ( :P332_WHATSAPP is null 
                     or ( :P332_WHATSAPP = 'S' and 1 = 1 )
                     or ( :P332_WHATSAPP = 'N' and n.responsavelcobranca not in ('RENATAL','TATIANEA','YASMINSOUZA','KEILASOUZA') ) )
                  and not exists ( select 1
                                   from tarefas t
                                   where t.idtipotarefa in (9,10)
                                     and t.idsituacao in (0,10,20)
                                     and t.idpessoa = v.idpessoa )
                union 
                select 'Negociação Fav. Antiga' 
                     , b.numero
                     , roman.pck_romance.fnc_nomevendedora(b.idvendedora) nome
                     , roman.pck_romance.fnc_cpfvendedora(b.idvendedora) cpf 
                     , b.valorcobrado 
                     , b.idvendedora
                     , ( select idusuario
                         from usuarios u
                         where u.usuario = b.responsavelcobranca )
                     , pck_util_fav.fnc_nomeusuario((select idusuario
                                                     from usuarios u
                                                     where u.usuario = b.responsavelcobranca))
                     , decode(v.spc,'S','Sim','Não') enviadaspc
                     , roman.pck_romance.fnc_nomefilial(b.idfilial) empresa
                     , roman.pck_romance.fnc_nomerepresentante(b.idrepresentante) distribuidor
                from catal.boletos b
                   , vendedoras v
                where b.situacao in ('V','G','S','A')
                  and trunc(b.datavencimento) between to_date(:P332_DATAINICIO) and to_date(:P332_DATAFIM) 
                  and ( :P332_IDFILIALROMANCE is null or b.idfilial = :P332_IDFILIALROMANCE ) 
                  and ( :P332_IDREPRESENTANTE is null or b.idrepresentante = :P332_IDREPRESENTANTE )
                  and v.idvendedora = b.idvendedora
                  and ( :P332_WHATSAPP is null 
                     or ( :P332_WHATSAPP = 'S' and 1 = 1 )
                     or ( :P332_WHATSAPP = 'N' and b.responsavelcobranca not in ('RENATAL','TATIANEA','YASMINSOUZA','KEILASOUZA') ) )
                  and not exists ( select 1
                                   from tarefas t
                                   where t.idtipotarefa in (9,10)
                                     and t.idsituacao in (0,10,20)
                                     and t.idpessoa = v.idpessoa )
                union
                select 'Negociação Fav. Antiga Parc.' 
                     , b.numero
                     , roman.pck_romance.fnc_nomevendedora(b.idvendedora) nome
                     , roman.pck_romance.fnc_cpfvendedora(b.idvendedora) cpf 
                     , pb.valorapagar
                     , b.idvendedora
                     , ( select idusuario
                         from usuarios u
                         where u.usuario = b.responsavelcobranca )
                     , pck_util_fav.fnc_nomeusuario((select idusuario
                                                     from usuarios u
                                                     where u.usuario = b.responsavelcobranca))
                     , decode(v.spc,'S','Sim','Não') enviadaspc
                     , roman.pck_romance.fnc_nomefilial(b.idfilial) empresa
                     , roman.pck_romance.fnc_nomerepresentante(b.idrepresentante) distribuidor
                from catal.boletos b
                   , catal.parcelamentosboletos pb
                   , vendedoras v
                where pb.idboleto = b.idboleto
                  and pb.situacao in ('V','A')
                  and trunc(pb.datavencimento) between to_date(:P332_DATAINICIO) and to_date(:P332_DATAFIM)
                  and ( :P332_IDFILIALROMANCE is null or b.idfilial = :P332_IDFILIALROMANCE ) 
                  and ( :P332_IDREPRESENTANTE is null or b.idrepresentante = :P332_IDREPRESENTANTE )
                  and v.idvendedora = b.idvendedora
                  and ( :P332_WHATSAPP is null 
                     or ( :P332_WHATSAPP = 'S' and 1 = 1 )
                     or ( :P332_WHATSAPP = 'N' and b.responsavelcobranca not in ('RENATAL','TATIANEA','YASMINSOUZA','KEILASOUZA') ) )
                  and not exists ( select 1
                                   from tarefas t
                                   where t.idtipotarefa in (9,10)
                                     and t.idsituacao in (0,10,20)
                                     and t.idpessoa = v.idpessoa )
                union
                select 'Negociação Pepinos'
                     , 'PP'||pe.nrpedido NRPEDIDO
                     , ( select initcap(nomepessoa)
                         from pessoas p
                         where p.cpf = pe.cpf ) CPF
                     , pe.cpf
                     , pp.valorapagar
                     , ( select idvendedora 
                         from vendedoras v
                            , pessoas p
                         where v.idpessoa = p.idpessoa
                           and p.cpf      = pe.cpf ) 
                     , ( select idusuario
                         from usuarios u
                         where u.usuario = pe.responsavelcobranca )
                     , pck_util_fav.fnc_nomeusuario((select idusuario
                                                     from usuarios u
                                                     where u.usuario = pe.responsavelcobranca))
                     , nvl(( select 'Sim'
                             from pessoas p
                                , vendedoras v
                             where v.idpessoa = p.idpessoa
                               and p.cpf      = pe.cpf),'Não') enviadaspc
                     , roman.pck_romance.fnc_nomefilial(pe.idfilial) empresa
                     , roman.pck_romance.fnc_nomerepresentante(pe.idrepresentante) distribuidor
                from roman.parcelamentospepinosrepres pp
                   , roman.pepinosrepresentantes pe
                where pp.situacao not in ('Q','E')
                  and pe.idpepinosrepresentante = pp.idpepinorepresentante
                  and trunc(pp.datavencimento) between to_date(:P332_DATAINICIO) and to_date(:P332_DATAFIM)
                  and ( :P332_IDREPRESENTANTE is null or pe.idrepresentante = :P332_IDREPRESENTANTE )
                  and ( :P332_IDFILIALROMANCE is null or roman.pck_romance.fnc_filialrepresentante(pe.idrepresentante) = :P332_IDFILIALROMANCE )
                  and ( :P332_WHATSAPP is null 
                     or ( :P332_WHATSAPP = 'S' and 1 = 1 )
                     or ( :P332_WHATSAPP = 'N' and pe.responsavelcobranca not in ('RENATAL','TATIANEA','YASMINSOUZA','KEILASOUZA') ) )
                  and not exists ( select 1
                                   from tarefas t
                                   where t.idtipotarefa in (9,10)
                                     and t.idsituacao in (0,10,20)
                                     and exists ( select 1
                                                  from pessoas p
                                                  where p.idpessoa = t.idpessoa
                                                    and p.cpf      = pe.cpf ) )
                order by 8
                ```
        }
