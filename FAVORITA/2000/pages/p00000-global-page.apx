    pageItem P0_IDIDIOMA (
        type: hidden
        layout {
            sequence: 30
            region: @background
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vididioma number;
                begin
                  --
                  if :P0_IDPERFILATENDIMENTO is null then
                    --
                    select pck_util_fav.fnc_retornaidiomausuario
                    into vididioma
                    from dual;
                    --
                  else
                    --
                    select p.ididioma
                    into vididioma
                    from perfisatendimentos p
                    where p.idperfilatendimento = :P0_IDPERFILATENDIMENTO;
                    --
                  end if;
                  --
                  return vididioma;
                  --
                end;
                ```
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vididioma number;
                begin
                  --
                  select pck_util_fav.fnc_retornaidiomausuario 
                  into vididioma
                  from dual;
                  --
                  return(vididioma);
                  --
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P0_IDPERFILATENDIMENTO (
        type: selectList
        label {
            label: Informe o Perfil de Atendimento
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pe.descricao || ' - ' || pv.descricao||' - '||pa.ididioma display_value
                     , pa.idperfilatendimento return_value
                  from favorita.perfisatendimentos         pa
                     , favorita.perfisvendas               pv
                     , favorita.perfis                     pe
                 where pa.idperfilvenda       = pv.idperfilvenda
                   and pv.idperfil            = pe.idperfil
                   and pe.ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 150
            region: @perfil
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

