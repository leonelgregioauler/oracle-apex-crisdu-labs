    pageItem P0_ENDERECO_ADAPTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 150
            region: @background
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vambiente varchar2(1000);
                  vretorno varchar2(1000);
                begin
                  --
                  select upper(sys_context('USERENV','SERVICE_NAME') )
                  into vambiente
                  from dual;
                  --
                  --if vambiente = 'DESENV.SNPRODCRISDUPRI.VCNPRDCRISDU.ORACLEVCN.COM' then
                  if vambiente = 'DESENV' then
                    --
                    vretorno := 'https://hml.catalogofavorita.com.br/api/routes/thirdparty/';
                    --
                  --elsif vambiente = 'HML.SNPRODCRISDUPRI.VCNPRDCRISDU.ORACLEVCN.COM' then
                  elsif vambiente = 'HML' then
                    --
                    vretorno := 'https://hml.catalogofavorita.com.br/api/routes/thirdparty/';
                    --
                  --elsif vambiente = 'PRODUCAO.SNPRODCRISDUPRI.VCNPRDCRISDU.ORACLEVCN.COM' then
                  elsif vambiente = 'PRODUCAO' then
                    --
                    vretorno := 'https://www.catalogofavorita.com.br/api/routes/thirdparty/';
                    --
                  end if;
                  --
                  return vretorno;
                  --
                end;
                ```
        }
    )

