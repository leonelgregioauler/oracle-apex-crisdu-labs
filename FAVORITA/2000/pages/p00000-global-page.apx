    pageItem P0_ENDERECOWIDECOMMERCE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 140
            region: @background
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vhostname   varchar2(100);
                  vendereco   varchar2(100);
                begin
                  --
                  select upper(sys_context('USERENV','SERVICE_NAME'))
                  into vhostname
                  from dual;
                  --
                  --if vhostname = 'ORCLTST' then
                  if vhostname = 'DESENV' then
                    -- DESENVOLVIMENTO
                    select pck_util_fav.fnc_retornaparametro ( pidfilialfavorita => null,
                                                               pidfilialromance  => null,
                                                               pparametro        => 'AMBIENTESITEWIDECOMMERCEDESENV')
                    into vendereco
                    from dual;
                    --
                  --elsif vhostname = 'ORCLHMG' then
                  elsif vhostname = 'HML' then
                    -- HOMOLOGACAO
                    select pck_util_fav.fnc_retornaparametro ( pidfilialfavorita => null,
                                                               pidfilialromance  => null,
                                                               pparametro        => 'AMBIENTESITEWIDECOMMERCEHOMOLOG')
                    into vendereco
                    from dual;
                    --
                  -- PRODUCAO
                  else--if vhostname = 'orcl' then
                    --
                     select pck_util_fav.fnc_retornaparametro ( pidfilialfavorita => null,
                                                                pidfilialromance  => null,
                                                                pparametro        => 'AMBIENTESITEWIDECOMMERCE')
                    into vendereco
                    from dual;
                    --
                  end if;
                  --
                  return nvl(vendereco,vhostname);
                  --
                exception
                 when others then
                   null;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P0_ENDERECOWS (
        type: hidden
        layout {
            sequence: 90
            region: @background
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vhostname   varchar2(100);
                  venderecows varchar2(100);
                begin
                  --
                  select upper(sys_context('USERENV','SERVICE_NAME') )
                  into vhostname
                  from dual;
                  --
                  --if vhostname = 'DESENV.SNPRODCRISDUPRI.VCNPRDCRISDU.ORACLEVCN.COM' then
                  if vhostname = 'DESENV' then
                    -- DESENVOLVIMENTO
                    select valor
                    into venderecows
                    from parametros
                    where nome = 'AMBIENTEDESENV';
                    --
                  --elsif vhostname = 'HML.SNPRODCRISDUPRI.VCNPRDCRISDU.ORACLEVCN.COM' then
                  elsif vhostname = 'HML' then
                    -- HOMOLOGACAO
                    select valor
                    into venderecows
                    from parametros
                    where nome = 'AMBIENTEHOMOLOG';
                    --
                  -- PRODUCAO
                  else--if vhostname = 'orcl' then
                    select valor
                    into venderecows
                    from parametros
                    where nome = 'AMBIENTE';
                    --
                  end if;
                  --
                  return nvl(venderecows,vhostname);
                  --
                exception
                 when others then
                   null;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

