    region questionamento (
        name: Questionamento
        type: staticContent
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                               from roman.questionamentoscontroladoria q
                                  , usuarios u
                               where ( nvl(q.confirmacaoleitura,'N') = 'N'
                                     or ( confirmacaoleitura = 'S' and resposta is null ) )
                                 and u.usuario = v('APP_USER')
                                 and confirmarenvio = 'S'
                                 and ( q.idpessoa = u.idpessoa 
                                    or v('APP_USER')= 'EVERTON'
                                    or q.idfilialfavorita = u.idfilialfavorita ) )
                  and pck_util_fav.fnc_verificaacesso(59040,:P0_IDUSUARIO) = 'S'
                  and v('APP_PAGE_ID') in (439,241,245,259,272,1)
                ```
        }
    )

