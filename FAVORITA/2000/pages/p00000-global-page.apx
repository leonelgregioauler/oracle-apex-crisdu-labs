        headerAndFooter {
            headerText:
                ```html
                Informe o número da sua PA para continuar o atendimento. (Formato 1PA1, onde o primeiro número é a sua ilha e o segundo é a PA)
                
                
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where  NV ('APP_PAGE_ID') in (1,71,67)
                  and :P0_NUMEROPOSICAOATENDIMENTO is null
                  and exists ( select 1
                               from roman.gruposatendimentospa gp
                               where gp.idgrupoatendimento in ( select us.idgrupoatendimento
                                                                from roman.usuariosgruposatendimento us
                                                                where us.usuario = v('APP_USER')))
                  and pck_util_fav.fnc_verificaacesso(pidaplicacao => 28330, pidusuario => pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S'
                ```
        }
