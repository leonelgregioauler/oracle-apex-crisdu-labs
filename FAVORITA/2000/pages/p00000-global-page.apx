    pageItem P0_ENDERECO_ADAPTO_URUGUAI (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 190
            region: @background
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vambiente varchar2(1000);
                  vretorno varchar2(1000);
                begin
                  --
                  select upper(sys_context('USERENV','SERVICE_NAME') )
                  into vambiente
                  from dual;
                  --
                  if vambiente = 'DESENV' then
                    --
                    vretorno := 'https://hml.catalogofavorita.com.uy/api/routes/thirdparty/';
                    --
                  elsif vambiente = 'HML' then
                    --
                    vretorno := 'https://hml.catalogoromance.com.uy/api/routes/thirdparty/';
                    --
                  elsif vambiente = 'PRODUCAO' then
                    --
                    vretorno := 'https://loja.catalogoromance.com.uy/api/routes/thirdparty/';
                    --vretorno := 'https://catalogoromance.cl/api/routes/thirdparty/';
                    --
                  end if;
                  --
                  return vretorno;
                  --
                end;
                ```
        }
    )

    pageItem P0_ENDERECO_ORDS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 100
            region: @background
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vhostname   varchar2(100);
                  venderecows varchar2(100);
                begin
                  --
                  select upper(sys_context('USERENV','SERVICE_NAME'))
                  into vhostname
                  from dual;
                  --
                  --if vhostname = 'ORCLTST' then
                  if vhostname = 'DESENV' then
                    -- DESENVOLVIMENTO
                    select valor
                    into venderecows
                    from parametros
                    where nome = 'AMBIENTEORDSDESENV';
                    --
                  --elsif vhostname = 'ORCLHMG' then
                  elsif vhostname = 'HML' then
                    -- HOMOLOGACAO
                    select valor
                    into venderecows
                    from parametros
                    where nome = 'AMBIENTEORDSHOMOLOG';
                    --
                  -- PRODUCAO
                  else--if vhostname = 'orcl' then
                    select valor
                    into venderecows
                    from parametros
                    where nome = 'AMBIENTEORDS';
                    --
                  end if;
                  --
                  return nvl(venderecows,vhostname);
                  --
                exception
                 when others then
                   null;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P0_IDFECHAMENTO (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select '- Ver Tudo -' display_value
                     , 999999999999   return_value
                from dual
                union
                select semana||' - '|| decode(f.concluido ,'S','Concluído','Aberto') display_value
                     , idfechamento return_value
                from roman.fechamentossemanais f
                where idfilialfavorita = :P0_IDFILIALCAIXA
                order by 2 desc
                ```
        }
        cascadingLov {
            parentItems: P0_IDFILIALCAIXA
        }
        layout {
            sequence: 20
            region: @caixa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

