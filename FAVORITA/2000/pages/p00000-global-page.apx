    pageItem P0_IDFILIALCAIXA (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.nomefilialfavorita
                     , w.idfilialfavorita
                from favorita.vw_filiaisfavorita w
                where w.tipofilial in ( 'Loja' , 'Estoque' )
                  and exists ( select 1
                               from roman.fechamentossemanais ff
                               where ff.idfilialfavorita = w.idfilialfavorita )
                  and exists ( select 1
                               from usuariosfiliaisfavorita uf
                               where uf.idfilialfavorita = w.idfilialfavorita
                                 and uf.idusuario        = :P0_IDUSUARIO
                                 and uf.visualizarcaixa  = 'S' )
                
                union
                
                -- Maicon Aimi - 09/06/2025
                select w.nomefilialfavorita
                     , w.idfilialfavorita
                  from favorita.vw_filiaisfavorita w
                 where exists (select 1
                                 from roman.usuariosgruposatendimento us
                                where us.idgrupoatendimento = 0
                                  and us.usuario = v('APP_USER'))
                
                order by 1
                
                
                ```
        }
        layout {
            sequence: 10
            region: @caixa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

