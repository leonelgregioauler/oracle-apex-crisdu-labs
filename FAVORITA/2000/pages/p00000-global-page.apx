    pageItem P0_AMBIENTEWIDECOMMERCE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 130
            region: @background
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  --
                  if nvl(pck_util_fav.fnc_retornaparametro ( pidfilialfavorita => :P0_IDFILIALFAVORITA,
                                                             pidfilialromance  => null,
                                                             pparametro        => 'AMBIENTEWIDECOMMERCE'), 'N') = 'S' then
                    --
                    return 'S';
                    --
                  elsif :P0_ACESSOWIDECOMMERCE = 'S' then
                    --
                    return 'S';
                    --
                  else
                    --
                    return 'N';
                    --
                  end if;
                  --
                end;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P0_AVISO_ATRASADA (
        type: displayOnly
        label {
            alignment: left
        }
        layout {
            sequence: 20
            region: @questionamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            preText: <font color="RED">    Você possui um Questionamento pendente de leitura a mais de 7 dias! Por favor verifique a informação ou entre em contato com a Controladoria!</font>
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                               from roman.questionamentoscontroladoria q
                                  , usuarios u
                               where ( nvl(q.confirmacaoleitura,'N') = 'N'
                                     or ( confirmacaoleitura = 'S' and resposta is null ) )
                                 and u.usuario = v('APP_USER')
                                 and confirmarenvio = 'S'
                                 and trunc(sysdate) - trunc(q.datainclusao) >= 7
                                 and ( q.idfilialfavorita = u.idfilialfavorita
                                    or q.idpessoa = u.idpessoa ) )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

