    dynamicAction ajusta-modal (
        name: Ajusta Modal
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action plugin-pretius-apex-enhanced-modal-dialog (
            action: plugin/pretiusApexEnhancedModalDialog
            settings {
                animationDuration: 300
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: currentPageNotInList
                pages: 140
            }
        )

    )

    dynamicAction atualiza-traduções (
        name: Atualiza traduções
        execution {
            sequence: 40
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: currentPageNotInList
            pages: [
                67
                68
                73
                74
                71
                94
                129
                119
                130
                99
            ]
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                      -- Call the procedure
                      pck_traducoes_fav.prc_executatodos;
                    end;
                    ```
            }
            execution {
                sequence: 10
                waitForResult: false
            }
        )

    )

    dynamicAction busca-semana (
        name: Busca Semana
        execution {
            sequence: 50
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :SEMANAATUAL is null
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                      select trim(to_char(semana,'00')||'/'||to_char(ano))
                      into :SEMANAATUAL
                      from roman.semana_dias
                      where sysdate between dt_ini and dt_fim+1;
                    exception
                      when others then
                        null;
                    end;
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction esconde-menu (
        name: Esconde Menu
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $(window).on("theme42ready", function() {
                    
                       if ($("body").hasClass("js-navExpanded")) {
                    
                       $("#t_Button_navControl").click();
                    
                      }
                    
                    });
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

