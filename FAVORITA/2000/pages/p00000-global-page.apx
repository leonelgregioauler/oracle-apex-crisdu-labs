    region background (
        name: background
        type: staticContent
        source {
            htmlCode:
                ```html
                <!-- Global site tag (gtag.js) - Google Analytics -->
                <script async src="https://www.googletagmanager.com/gtag/js?id=UA-99270677-1"></script>
                <script>
                  window.dataLayer = window.dataLayer || [];
                  function gtag(){dataLayer.push(arguments);}
                  gtag('js', new Date());
                
                  gtag('config', 'UA-99270677-1');
                </script>
                
                
                ```
        }
        layout {
            sequence: 50
            slot: breadcrumbBar
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        headerAndFooter {
            headerText:
                ```html
                <script>
                    
                //onkeyPress
                function formatar_mascara(src, mascara, evt)
                {
                  var tecla;  
                  if (evt.which)
                    { tecla = evt.which }
                  else if(evt.keyCode)
                    { tecla = evt.keyCode; }
                   if( tecla != 8 )
                    {var campo = src.value.length;
                     var saida = mascara.substring(0,1);
                     var texto = mascara.substring(campo);
                     if(texto.substring(0,1) != saida) 
                      {src.value+=texto.substring(0,1);}
                    }
                }
                    
                function fnc_telefone(objeto)
                {      
                   if(objeto.value.length == 0)
                     objeto.value = '(' + objeto.value;
                
                   if(objeto.value.length == 3)
                      objeto.value = objeto.value + ')';
                
                   if(objeto.value.length == 8)
                     objeto.value = objeto.value + '.';
                }
                    
                //onblur
                function formataCPF(cpf)
                 {
                 	with (cpf)
                    {
                      if (value.search("-") == -1) {      
                   	    value = value.substr(0, 3) + '.' + 
                 	  			            value.substr(3, 3) + '.' + 
                 				              value.substr(6, 3) + '-' +
                 				              value.substr(9, 2);
                      }
                    }
                 }
                
                
                //onblur
                function formataCNPJ(cnpj)
                 {
                 	with (cnpj)
                    {
                      if (value.search("-") == -1) {      
                   	    value = value.substr(0, 2) + '.' + 
                 	  			            value.substr(2, 3) + '.' + 
                 				              value.substr(5, 3) + '/' +
                 				              value.substr(8, 4) + '-' + 
                               value.substr(12,2);
                      }
                    }
                 }
                
                 
                //onblur
                function formataCEP(cep)
                 {
                 	with (cep)
                    {     
                      if (value.search("-") == -1) {      
                   	    value = value.substr(0, 2) + '.' + 
                 	              			value.substr(2, 3) + '-' + 
                 				              value.substr(5, 3);
                      }
                    }
                 }	
                    
                //onblur
                function formataCartaoCredito(cartaoCredito)
                 {
                 	with (cartaoCredito)
                    {
                      if (value.search("-") == -1) {      
                   	    value = value.substr(0,  4) + '-' + 
                 	  			            value.substr(4,  4) + '-' + 
                 				              value.substr(8,  4) + '-' +
                 				              value.substr(12, 4);
                      }
                    }
                 }
                    
                    
                function formataMoeda(valor){
                  v = valor.value;
                  v=v.replace(/\D/g,"") // permite digitar apenas numero
                  v=v.replace(/(\d{1})(\d{14})$/,"$1.$2") // coloca ponto antes dos ultimos digitos
                  v=v.replace(/(\d{1})(\d{11})$/,"$1.$2") // coloca ponto antes dos ultimos 11 digitos
                  v=v.replace(/(\d{1})(\d{8})$/,"$1.$2") // coloca ponto antes dos ultimos 8 digitos
                  v=v.replace(/(\d{1})(\d{5})$/,"$1.$2") // coloca ponto antes dos ultimos 5 digitos
                  v=v.replace(/(\d{1})(\d{1,2})$/,"$1,$2") // coloca virgula antes dos ultimos 2 digitos
                  valor.value = v;
                }
                  
                // Formatação de Moeda para Form Tabular
                Number.prototype.formatMoney = function(c, d, t){
                  var n = this, 
                  c = isNaN(c = Math.abs(c)) ? 2 : c, 
                  d = d == undefined ? "." : d, 
                  t = t == undefined ? "," : t, 
                  s = n < 0 ? "-" : "", 
                  i = String(parseInt(n = Math.abs(Number(n) || 0).toFixed(c))), 
                  j = (j = i.length) > 3 ? j % 3 : 0;
                  return s + (j ? i.substr(0, j) + t : "") + i.substr(j).replace(/(\d{3})(?=\d)/g, "$1" + t) + (c ? d + Math.abs(n - i).toFixed(c).slice(2) : "");
                };
                
                    
                    
                //onblur
                function formataHora(hora)
                 {
                 	with (hora)
                    {
                        
                      if (value.search(":") == -1) {      
                   	    value = value.substr(0, 2) + ':' + 
                 	      			value.substr(2, 2) + ':' + 
                       			value.substr(4, 2);
                      }
                    }
                 }
                    
                function ExibeAguarde() {
                 window.aguarde = {posicao:$(document).scrollTop(),
                       $aguarde: $("<div class='exibeaguarde'>").css({"position":"absolute", 
                        "top":"0px",
                        "left":"0px",
                        "right":"0px",
                        "bottom":"0px",
                        "background":"white",
                        "text-align":"center",
                        "font-size":"20px",
                        "padding-top":"25%",
                        "cursor":"progress",
                        "z-index":10000})
                       .text("Aguarde... !")
                       .appendTo($("body"))
                      };
                
                 $(document).scrollTop(0);
                 window.aguarde.$aguarde.show();
                }
                
                function OcultaAguarde() {
                 window.aguarde.$aguarde.remove();
                 $(document).scrollTop(window.aguarde.posicao);
                }
                
                </script>
                ```
        }
    )

