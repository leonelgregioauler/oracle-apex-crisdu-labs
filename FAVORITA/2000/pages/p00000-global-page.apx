    dynamicAction notification (
        name: Notification
        execution {
            sequence: 1
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: never
        }

        action plugin-apex-notification (
            action: plugin/apexNotificationMenu
            settings {
                sqlSource:
                    ```sql
                    SELECT NOTE_ICON        AS  NOTE_ICON
                         , NOTE_ICON_COLOR  AS  NOTE_ICON_COLOR
                         , NOTE_HEADER      AS  NOTE_HEADER
                         , NOTE_TEXT        AS  NOTE_TEXT
                         , NOTE_LINK        AS  NOTE_LINK
                         , NOTE_COLOR       AS  NOTE_COLOR
                    FROM ( 
                            select NOTE_ICON        AS  NOTE_ICON
                                 , NOTE_ICON_COLOR  AS  NOTE_ICON_COLOR
                                 , NOTE_HEADER      AS  NOTE_HEADER
                                 , NOTE_TEXT        AS  NOTE_TEXT
                                 , NOTE_LINK        AS  NOTE_LINK
                                 , NOTE_COLOR       AS  NOTE_COLOR
                                 , W.idnotificacaointerna
                            from roman.vw_notificacoesinternas w
                            where w.dataleitura is null
                              and trunc(w.datanotificacao) = trunc(sysdate)
                              and ( ( w.tiponotificacao = 'P' and iddestino = pck_util_fav.fnc_idusuario(v('APP_USER')) )
                                 or ( w.tiponotificacao = 'G' and ( exists ( select 1 
                                                                             from roman.usuariosgruposatendimento u
                                                                             where u.usuario            = v('APP_USER')
                                                                               and u.idgrupoatendimento = iddestino ) 
                                                                   or w.iddestino = v('APP_ID')))
                                 or ( w.tiponotificacao = 'Z' ) )  
                            ORDER BY 7 DESC )
                    WHERE ROWNUM <= 6   
                    ```
                configjson:
                    ```javascript-browser
                    {
                       "refresh": 1,
                       "mainIcon": "fa-bell",
                       "mainIconColor": "white",
                       "mainIconBackgroundColor": "rgba(70,70,70,0.9)",
                       "mainIconBlinking": false,
                       "counterBackgroundColor": "rgb(232, 55, 55 )",
                       "counterFontColor": "white",
                       "linkTargetBlank": true
                    }
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction refresh (
        name: refresh
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P0_IDPERFILATENDIMENTO
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P0_IDIDIOMA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

