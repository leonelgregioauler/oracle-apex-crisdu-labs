page 571 (
    name: Cadastro Convênio Bancario
    title: Cadastro Convênio Bancario
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region convênio (
        name: Convênio
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P571_ATIVADO (
        type: radioGroup
        label {
            label: Ativado
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não ;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @convênio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P571_CONVENIO (
        type: textField
        label {
            label: Convênio
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 50
            region: @convênio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 20
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P571_IDBANCO (
        type: selectList
        label {
            label: Banco
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select b.nomebanco
                     , b.idbanco
                from roman.bancos b
                order by 2
                ```
        }
        layout {
            sequence: 20
            region: @convênio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P571_IDCONTABANCARIA (
        type: popupLov
        label {
            label: Conta Bancária
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.beneficiario||': '||c.agencia||'/'||c.conta display_value
                     , c.idcontabanc
                from roman.contasbancarias c
                where c.idpessoa = 16625
                  and c.idbanco = :P571_IDBANCO
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P571_IDBANCO
        }
        layout {
            sequence: 30
            region: @convênio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P571_IDCONVENIOBANCO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @convênio
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P571_IDEMPRESAEMITENTE (
        type: selectList
        label {
            label: Empresa Virtual
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.nome||' - CNPJ: '||e.cnpj d
                     , e.idempresavirtualage r
                from empresasvirtualage e
                order by e.idempresavirtualage
                ```
        }
        layout {
            sequence: 40
            region: @convênio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P571_OPERACAO_DML (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @convênio
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button criar (
        buttonName: CRIAR
        label: Criar
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNull
            item: P571_IDCONVENIOBANCO
        }
    )

    button deletar (
        buttonName: DELETAR
        label: Deletar
        layout {
            sequence: 10
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P571_IDCONVENIOBANCO
        }
    )

    button salvar (
        buttonName: SALVAR
        label: Salvar
        layout {
            sequence: 20
            region: @buttons
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P571_IDCONVENIOBANCO
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 30
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 570
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction deletar (
        name: Deletar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @deletar
        }

        action native-confirm (
            action: confirm
            settings {
                message: Deseja realmente excluir esse registro?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: DELETAR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    process consulta-em-convenios-bancos (
        name: Consulta em Convenios Bancos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vmd5 varchar2(1000);
                  --
                begin
                  --
                  PCK_CADASTROS_FAV.PRC_CONVENIOSBANCOS( PIDCONVENIOBANCO => :P571_IDCONVENIOBANCO,
                                                         PIDBANCO => :P571_IDBANCO,
                                                         PIDCONTABANCARIA => :P571_IDCONTABANCARIA,
                                                         PIDEMPRESAEMITENTE => :P571_IDEMPRESAEMITENTE,
                                                         PCONVENIO => :P571_CONVENIO,
                                                         PATIVADO => :P571_ATIVADO,
                                                         PMD5 => vmd5,
                                                         POPERACAO_DML => 'S' );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 98858894035063240
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P571_IDCONVENIOBANCO
        }
    )

    process processo-dml-em-convenios-bancos (
        name: Processo DML em Convenios Bancos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vmd5 varchar2(1000);
                  --
                begin
                  --
                  if v('REQUEST') = 'CRIAR' then
                    --
                    :P571_OPERACAO_DML := 'I';
                    --
                  elsif v('REQUEST') = 'SALVAR' then
                    --
                    :P571_OPERACAO_DML := 'U';
                    --
                  elsif v('REQUEST') = 'DELETAR' then
                    --
                    :P571_OPERACAO_DML := 'D';
                    --
                  end if;
                  --
                  PCK_CADASTROS_FAV.PRC_CONVENIOSBANCOS( PIDCONVENIOBANCO => :P571_IDCONVENIOBANCO,
                                                         PIDBANCO => :P571_IDBANCO,
                                                         PIDCONTABANCARIA => :P571_IDCONTABANCARIA,
                                                         PIDEMPRESAEMITENTE => :P571_IDEMPRESAEMITENTE,
                                                         PCONVENIO => :P571_CONVENIO,
                                                         PATIVADO => :P571_ATIVADO,
                                                         PMD5 => vmd5,
                                                         POPERACAO_DML => :P571_OPERACAO_DML );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 100331511386979366
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('DELETAR','SALVAR','CRIAR')
        }
    )

)

