    button pedidopontos (
        buttonName: PEDIDOPONTOS
        label: Pedido de Pontos
        layout {
            sequence: 50
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--primary
                t-Button--iconRight
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                (:P80_VALORDEBITOFAVORITA = 0 and pck_util_fav.fnc_retornatipofilial (pidfilialfavorita => :P0_IDFILIALFAVORITA, pidpais => :P0_IDIDIOMA) = 'L')
                                             or ( pck_util_fav.fnc_retornatipofilial (pidfilialfavorita => :P0_IDFILIALFAVORITA, pidpais => :P0_IDIDIOMA) != 'L')
                                             or ( ( select sum(pp.valorpago)
                                                      from pagamentospedidos  pp
                                                         , vencimentospedidos vp
                                                         , pedidos            p
                                                     where pp.idvencimentopedido = vp.idvencimentopedido
                                                       and vp.idpedido           = p.idpedido
                                                       and p.idvendedora         = :P80_IDVENDEDORA
                                                       and pp.idsituacao         = 40  ) = :P80_VALORDEBITOFAVORITA )
                                             or ( v('APP_USER') = 'GUILHERME' )
                ```
        }
    )

    button proximopasso (
        buttonName: PROXIMOPASSO
        label: Proximo Passo
        layout {
            sequence: 20
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
            executeValidations: false
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                (:P80_VALORDEBITOFAVORITA = 0 and pck_util_fav.fnc_retornatipofilial (pidfilialfavorita => :P0_IDFILIALFAVORITA, pidpais => :P0_IDIDIOMA) = 'L')
                                         --    or ( pck_util_fav.fnc_retornatipofilial (pidfilialfavorita => :P0_IDFILIALFAVORITA, pidpais => :P0_IDIDIOMA) != 'L')
                                             or (( select f.tipofilial
                                                   from filiaisfavorita f
                                                   where f.idfilialfavorita = :P0_IDFILIALFAVORITA ) != 'L' )
                                             or ( ( select sum(pp.valorpago)
                                                      from pagamentospedidos  pp
                                                         , vencimentospedidos vp
                                                         , pedidos            p
                                                     where pp.idvencimentopedido = vp.idvencimentopedido
                                                       and vp.idpedido           = p.idpedido
                                                       and p.idvendedora         = :P80_IDVENDEDORA
                                                       and pp.idsituacao         = 40 ) = :P80_VALORDEBITOFAVORITA )
                ```
        }
    )

    button proximopasso-l (
        buttonName: PROXIMOPASSO_L
        label: Proximo Passo (Loja)
        layout {
            sequence: 30
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
            executeValidations: false
        }
        serverSideCondition {
            type: expression
            plsqlExpression: ( v('APP_USER') in ('GUILHERME','TAMIRESBAUER') or  pck_util_fav.fnc_retornaparametro(pidfilialfavorita =>:P0_IDFILIALFAVORITA,pidfilialromance => null,pparametro => 'LOJA UTILIZANDO ADAPTO') = 'S' ) and nvl(:P80_IDPAISVENDEDORA, 1) not in (1,2,4,6)
        }
    )

    button proximopasso-r (
        buttonName: PROXIMOPASSO_R
        label: Próximo (RMC Casa)
        layout {
            sequence: 40
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
            executeValidations: false
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                /*select 1
                from liberacoesvendasdistribuidores l
                where l.idrepresentante = :P80_IDREPRESENTANTE
                   and :P80_IDVENDEDORA is not null
                   and exists ( select 1
                                  from roman.usuariosgruposatendimento g
                                     , usuarios u
                                  where g.idgrupoatendimento = 4
                                    and g.usuario = u.usuario
                                    and u.ativo = 'S'
                                    and u.idusuario = :P0_IDUSUARIO )
                   and 
                   ( (select idvalorcaracteristica 
                        from roman.classificacoesnotasvendas 
                       where idclassificacaonotavenda = ( select max(c.idclassificacaonotavenda) 
                                                            from roman.notasvendas n 
                                                               , roman.classificacoesnotasvendas c 
                                                           where n.idnotavenda = c.idnotavenda 
                                                             and c.idcaracteristicanotavenda = 52 
                                                             and n.idvendedora = :P80_IDVENDEDORA
                                                             and n.idsituacaonotavenda in (3,4)  ) ) > 3 
                     OR exists
                     ( select 1 
                       from vendedoras v
                          , representantes r
                       where v.idvendedora = :P80_IDVENDEDORA
                         and v.idpessoa = r.idpessoa
                         and r.idrepresentante = l.idrepresentante
                         and r.idrepresentante = :P80_IDREPRESENTANTE ) )
                    and :P0_IDIDIOMA = 1
                -- Segunda condição
                union
                
                select 1
                from dual 
                where exists ( select 1
                                  from parametros p
                                 where p.nome = 'ROMANCECASALOJA'
                                   and :P80_IDVENDEDORA is not null
                                   and p.valor = 'S'
                                   and p.idfilialfavorita = ( select u.idfilialfavorita
                                                                from usuarios u
                                                               where u.usuario = v('APP_USER') ) )
                  and :P0_IDIDIOMA = 1
                
                union
                
                select 1
                from dual 
                where exists ( select 1
                                  from parametros p
                                 where p.nome = 'ROMANCECASALOJA'
                                   and :P80_IDVENDEDORA is not null
                                   and p.valor = 'S'
                                   and p.idfilialromance = ( select v.idfilial
                                                             from vendedoras v
                                                             where v.idvendedora = :P80_IDVENDEDORA ) )
                   and :P0_IDIDIOMA = 1*/ select 1
                   from dual
                   where 1 = 2
                ```
        }
    )

    button renegociar-pedido (
        buttonName: RENEGOCIAR_PEDIDO
        label: Renegociar Pedido
        layout {
            sequence: 110
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: fnc_renegociarpedido();
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from roman.usuariosgruposatendimento 
                where usuario = v('APP_USER')
                and idgrupoatendimento in (4, 25)
                ```
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 60
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--iconLeft
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 67
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ajuste-de-cadastro-duplo-uruguai (
        name: Ajuste de Cadastro Duplo Uruguai
        execution {
            sequence: 60
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: item>value
            item: P80_QTDCADASTROS
            value: 1
        }
        serverSideCondition {
            type: item=value
            item: P0_IDIDIOMA
            value: 2
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                      --
                      pck_util_fav.prc_ajustecadastroduplo(pididioma => :P0_IDIDIOMA,
                                                           pidcliente => :P80_IDVENDEDORA,
                                                           pidusuario => :P0_IDUSUARIO);
                      --
                    end;
                    ```
            }
            execution {
                sequence: 10
                stopExecutionOnError: false
                waitForResult: false
            }
        )

    )

    dynamicAction carregar-item-filial-favorita-iniciar (
        name: Carregar item filial favorita iniciar
        execution {
            sequence: 80
        }
        when {
            selectionType: items
            items: P80_IDFILIALFAVORITANICIAR
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    begin
                    null;
                    end;
                    ```
                itemsToSubmit: P80_IDFILIALFAVORITANICIAR
            }
            affectedElements {
                selectionType: items
                items: P80_SHOW_DE_PREMIOS
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction inicia-pedido (
        name: Inicia Pedido
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @proximopasso
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      --
                      vidiniciaprepedido      number := :P80_IDPEDIDO;
                      vdataentrega            date;
                      vdelivery               varchar2(1);
                      vidfilialfavoritaorig   number;
                      --
                      vidfilialfavoritadestino number;
                      --
                      vidusuariodigitou number;
                      --
                    begin
                      --
                      begin
                        --
                        select valor
                        into vdelivery
                        from parametros
                        where nome = 'FLUXO_DELIVERY'
                          and idfilialfavorita = :P0_IDFILIALFAVORITA;
                        --
                      exception
                        when others then 
                          vdelivery := 'N';
                      end;
                      --
                      if vdelivery = 'S' then
                        --
                        select idfilialfavoritadestino
                        into vidfilialfavoritadestino
                        from usuarios u
                        where u.idusuario = :P0_IDUSUARIO;
                        --
                        pck_pedidos_fav.prc_iniciaprepedido ( vidiniciaprepedido
                                                            , vidfilialfavoritadestino
                                                            , :P80_IDVENDEDORA
                                                            , :P0_IDUSUARIO
                                                            , :P0_NUMEROPOSICAOATENDIMENTO
                                                            , 'P'
                                                            , vdataentrega 
                                                            , :P0_IDUSUARIO
                                                            , vidfilialfavoritaorig
                                                            , 'I' );
                        --
                      elsif pck_util.fnc_verificaacesso(28346,v('APP_USER')) != 'S' then
                        --
                        pck_pedidos_fav.prc_iniciaprepedido ( vidiniciaprepedido
                                                            , :P0_IDFILIALFAVORITA
                                                            , :P80_IDVENDEDORA
                                                            , :P0_IDUSUARIO
                                                            , :P0_NUMEROPOSICAOATENDIMENTO
                                                            , 'P'
                                                            , vdataentrega 
                                                            , vidusuariodigitou
                                                            , vidfilialfavoritaorig
                                                            , 'I' );
                        --
                      elsif pck_util.fnc_verificaacesso(28346,v('APP_USER')) = 'S' then
                        --
                        pck_pedidos_fav.prc_iniciaprepedido ( vidiniciaprepedido
                                                            , :P80_IDFILIALFAVORITANICIAR
                                                            , :P80_IDVENDEDORA
                                                            , :P0_IDUSUARIO
                                                            , :P0_NUMEROPOSICAOATENDIMENTO
                                                            , 'P'
                                                            , vdataentrega 
                                                            , vidusuariodigitou
                                                            , vidfilialfavoritaorig
                                                            , 'I' );
                        --
                      end if;
                      --
                      :P80_IDPEDIDO := vidiniciaprepedido;
                      --:P80_TIPOPEDIDO := 'P';
                      --
                      update vendedoras v
                      set v.updated_time = sysdate
                      where v.idvendedora = :P80_IDVENDEDORA;
                      --
                    end;
                    ```
                itemsToSubmit: [
                    P80_IDPEDIDO
                    P80_IDVENDEDORA
                    P0_IDFILIALFAVORITA
                    P0_IDUSUARIO
                    P0_NUMEROPOSICAOATENDIMENTO
                ]
                itemsToReturn: P80_IDPEDIDO
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                value: P
            }
            affectedElements {
                selectionType: items
                items: P80_TIPOPEDIDO
            }
            execution {
                sequence: 30
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: PROXIMOPASSO
                showProcessing: false
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

