    pageItem P80_SHOW_DE_PREMIOS (
        type: displayOnly
        label {
            label: Show de Prêmios
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 70
            region: @análise-da-consultora
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vretorno varchar2(1000);
                begin
                  --
                  select 'Pontos: '||nvl(v.pontospremios,0)||' - Categoria: '||case when trunc(v.pontospremios) > 9999 then '5 Estrelas'
                                      when trunc(v.pontospremios) between 3000 and 4999 then '2 Estrelas'
                                      when trunc(v.pontospremios) between 5000 and 9999 then '3 Estrelas'
                                 else
                                      'Nenhuma'
                                 end info 
                  into vretorno
                  from catal.vendedoras v where v.idvendedora = :P80_IDVENDEDORA;
                  --
                  return vretorno;
                  --
                exception
                  when others then
                    null;
                end;
                ```
            used: always
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

