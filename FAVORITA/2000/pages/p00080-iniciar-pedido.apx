    pageItem P80_VALORDEBITOFAVORITA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 190
            region: @análise-da-consultora
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vsaldo number;
                begin
                  --
                  select nvl(( select sum(v.saldodevedor)
                               from vw_pedidos_fav_new v
                               where idvendedora    = :P80_IDVENDEDORA
                                 and v.datacancelamento is null
                                 and exists ( select 1
                                              from vencimentospedidos vp
                                              where vp.idpedido = v.idpedido 
                                              and vp.situacaovencimento = 'V'
                                              and trunc(vp.datavencimento) < trunc(sysdate)
                                              and (vp.valorpago + nvl(( select sum(nvl(p.valorpago, 0))
                                                                        from pagamentospedidos p
                                                                        where p.idvencimentopedido = vp.idvencimentopedido
                                                                          and nvl(p.idsituacao, 0) in (40) ), 0)) < vp.valorpagar)
                                 and v.tipopedido   = 'P'
                                 and v.saldodevedor > 0)  ,0)
                       + nvl(( select sum(c.saldodevedor)
                               from vw_pedidos_old c
                               where idvendedora    = :P80_IDVENDEDORA
                                 and c.saldodevedor > 0.5 
                                 and c.idsituacao not in ( 'Q','U','K')) ,0)
                       + nvl(( select sum(t.saldodevedor)
                               from vw_pedidos_fav_new t
                               where idvendedora    = :P80_IDVENDEDORA
                                 and t.datacancelamento is null
                                 and exists ( select 1
                                              from vencimentospedidos vp
                                              where vp.idpedido = t.idpedido 
                                              and vp.situacaovencimento = 'V'
                                              and trunc(vp.datavencimento) < trunc(sysdate)
                                              and (vp.valorpago + nvl(( select sum(nvl(p.valorpago, 0))
                                                                        from pagamentospedidos p
                                                                        where p.idvencimentopedido = vp.idvencimentopedido
                                                                          and nvl(p.idsituacao, 0) in (40) ), 0)) < vp.valorpagar)
                                 and t.tipopedido   = 'T'
                                 and t.valorapagar  > 0
                                 and t.saldodevedor > 0) ,0)
                  into vsaldo
                  from dual;
                  --
                  return vsaldo;
                  --
                end;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

