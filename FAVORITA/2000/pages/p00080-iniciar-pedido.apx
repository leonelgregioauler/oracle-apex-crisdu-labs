    dynamicAction seleciona-consultora (
        name: Seleciona Consultora
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P80_IDVENDEDORA
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P80_IDVENDEDORA
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                      :P80_IDVENDEDORARENEGOCIACAO := :P80_IDVENDEDORA;
                    end;
                    ```
                itemsToSubmit: P80_IDVENDEDORA
                itemsToReturn: P80_IDVENDEDORARENEGOCIACAO
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 200
            }
        )

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P80_OBSERVACAO
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-hide-10 (
            action: hide
            affectedElements {
                selectionType: button
                button: @renegociar-pedido
            }
            execution {
                sequence: 100
                fireWhenEventResultIs: false
