    pageItem P80_IDFILIALFAVORITANICIAR (
        type: selectList
        label {
            label: Filial para Iniciar o Pedido
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) as d,
                       idfilialfavorita as r
                  from filiaisfavorita f
                where exists ( select 1
                               from usuariosfiliaisfavorita u
                               where u.idfilialfavorita = f.idfilialfavorita
                                 and u.consultar        = 'S' 
                                 and u.idusuario        = :P0_IDUSUARIO )
                  and pck_util.fnc_verificaacesso(28346,v('APP_USER')) = 'S'
                union
                select pck_util_fav.fnc_nomefilialfavorita(a.idfilialfavoritadestino) d
                     , a.idfilialfavoritadestino r
                from atendimentosestoques a
                   , usuarios u
                where a.idfilialfavoritaorigem = :P0_IDFILIALFAVORITA
                  and u.idusuario = :P0_IDUSUARIO
                  and u.idfilialfavoritadestino = a.idfilialfavoritadestino
                  and exists ( select 1
                               from filiaisfavorita ff
                               where ff.idfilialfavorita = a.idfilialfavoritadestino
                                 and ff.tipofilial = 'L' )
                  and pck_util.fnc_verificaacesso(28346,v('APP_USER')) = 'N'
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @filial-favorita-p-iniciar-o-pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                pck_util.fnc_verificaacesso(28346,v('APP_USER')) = 'S'
                or exists ( select 1
                            from parametros
                            where nome = 'FLUXO_DELIVERY'
                              and valor = 'S'
                              and idfilialfavorita = :P0_IDFILIALFAVORITA )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

