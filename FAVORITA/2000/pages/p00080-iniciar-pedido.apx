    region notas-romance (
        name: Notas Romance
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select V.idnotavenda
                     , v.distribuidor
                     , v.numeronota
                     , v.datanota
                     , v.semanadistribuicao
                     , v.semanacobranca
                     , v.regiaovenda
                     , v.situacao
                     , v.valortotalnota
                     , v.valortotalvendalqd
                     , v.valorpago
                     , v.saldo
                from  roman.vw_notasvendas_roman v
                where idvendedora = :P80_IDVENDEDORA
                  and :P80_IDVENDEDORA != 2363887
