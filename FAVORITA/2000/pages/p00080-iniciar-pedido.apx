    pageItem P80_IDVENDEDORA (
        type: popupLov
        label {
            label: Cliente
            alignment: left
        }
        settings {
            displayAs: modalDialog
            initialFetch: onUserRequest
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) ||' - '||
                         case
                            when p.cpf is not null then
                                'CPF: '||p.cpf|| '('||REGEXP_REPLACE(REGEXP_REPLACE(p.cpf,'[[:alpha:],[:space:],[:punct:]]'), '^(\d{3})(\d{3})(\d{3})(\d{2})$', '\1.\2.\3-\4')||')'||' - '||p.rg
                            else
                              'Doc. Estr.'||p.documentoestrangeiro
                            end
                              ||' - '||p.documentoestrangeiro||' Pontos: '||trim(to_char(nvl(v.pontos,0),'990D00'))
                    --  ||' - '|| roman.pck_romance.fnc_nomefilial(roman.pck_romance.fnc_filialvendedora(v.idvendedora))
                          ||'  ID: '||v.idvendedora      display_value
                     , v.idvendedora return_value
                from catal.vendedoras v
                   , catal.pessoas    p
                where v.idpessoa = p.idpessoa
                  --and (:P80_VENDHIST = 'S' or :P80_VENDHIST = 'N' and v.ativo = 'S')    
                  AND (NVL(:P80_VENDHIST, 'N') = 'S' OR (NVL(:P80_VENDHIST, 'N') = 'N' AND v.ativo = 'S'))      
                  and v.idrepresentante is not null;
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 10
            region: @análise-da-consultora
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 80
        }
        security {
            encryptSessionState: false
        }
    )

