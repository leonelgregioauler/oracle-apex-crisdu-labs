                                                         WHERE cnpj = REPLACE(REPLACE(REPLACE(fc.CNPJ,'.','' ),'/','' ),'-','' )   ) return_value
                FROM roman.FUNCIONARIOS_CRISDU fc 
                WHERE fc.CPF  = ( select cpf from pessoas where idpessoa = :P80_IDPESSOA)
