                    ```plsql
                    declare
                      --
                      vidiniciaprepedido      number := :P80_IDPEDIDO;
                      vdataentrega            date;
                      vidusuariodigitou       number;
                      --
                    begin
                      --
                      if pck_util.fnc_verificaacesso(28346,v('APP_USER')) != 'S' then
