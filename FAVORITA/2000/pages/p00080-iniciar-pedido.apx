        action seta-0-pontos-prox-categoria (
            name: Seta 0 Pontos Prox Categoria
            action: setValue
            settings {
                value: 0
            }
            affectedElements {
                selectionType: items
                items: P80_PONTOS_PROX_CATEGORIA
            }
            execution {
                sequence: 130
                fireWhenEventResultIs: false
            }
        )

        action seta-pontos-prox-categoria (
            name: Seta Pontos Prox Categoria
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select (cb.pontuacaoinicial - p.pontos)
                      from roman.configuracoescategorias cb
                         , roman.pontuacoesclubedesucesso p
                         , catal.vendedoras v
                      where cb.idcategoriaclube > p.idcategoriaclube
                        and cb.idcategoriaclube - p.idcategoriaclube = 1 
                        and cb.idclubedesucesso = p.idclubedesucesso 
                        and p.idvendedora = v.idvendedora
                        and instr(cb.franquias,v.idfilial) > 0 
                        and v.idfilial in ( select regexp_substr(cb.franquias, '[^:]+', 1, level) ID
                                                              from dual
                                                           connect by level <= regexp_count(cb.franquias, ':') + 1 )
                        
                        and p.idvendedora = :P80_idvendedora;
                    ```
                itemsToSubmit: P80_PONTOS_PROX_CATEGORIA
            }
            affectedElements {
                selectionType: items
                items: P80_PONTOS_PROX_CATEGORIA
            }
            execution {
                sequence: 220
            }
        )

    )

    validation new (
        name: New
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P80_IDFILIALFAVORITANICIAR
        }
        error {
            errorMessage: Filial favorita e obrigatória para criação do pedido
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                pck_util.fnc_verificaacesso(28346,v('APP_USER')) = 'S' 
                or exists ( select 1
                            from parametros
                            where nome = 'FLUXO_DELIVERY'
                              and valor = 'S'
                              and idfilialfavorita = :P0_IDFILIALFAVORITA )
                ```
        }
    )

    process busca-dados (
        name: Busca Dados
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vdocumento         varchar2(100);
                  vemail             varchar2(100);
                  vsenha             varchar2(100);
                  vretorno           varchar2(100);
                  vidpessoa          number;
                  vidvendedora       number;
                  vidrepresentante   number;
                  vidfilial          number;
                  vedicoesrevista    varchar2(100);
                  vqtddebitos        number(15,2);
                  vvlrlimiteped      number(15,2);
                  vvlrlimiteminimo   number(15,2);
                  vpontosdisp        number(15,2);
                  vvlrmaximoped      number(15,2);
                  vatendenteloja     varchar2(100);
                  vidfilialfavorita  number;
                  vidusuario         number;
                  vtipospagamentos   varchar2(100);
                  vtiposentregas     varchar2(100);
                  vmensagem          varchar2(100);
                  vidpedido          number;
                  vidpais            number;
                  vliberafazerpedido varchar2(100);
                  vtipopedido        varchar2(1);
                  --
                  --
                  vdescricao  varchar2(2000);
                  vsitvencimento varchar2(100);   
                  --
                  vsaldodevedor1   number(15,2);
                  vsaldodevedor2   number(15,2);
                  vsaldodevedor3   number(15,2);
                  --
                  vvalortotalped1  number(15,2);
                  vvalortotalped2  number(15,2);
                  vvalortotalped3  number(15,2);
                  --
                  vsaldo           number;
                  vtotalped        number(15,2);   
                  vsaldocompra     number(15,2);   
                  --
                  vcontador  number;
                  vnum number;
                  vconversao number;
                  --
                  vvalorlimitemaximo number;
                  vvalorlimite       number;
                  vvalorlimitepagar  number;
                  -- 
                  vvlrmaximoped_real number;
                  vtotalped_real     number;
                  vvalorlimite_real  number;
                  -- 
                  vvlrmaximoped_conv number;
                  vtotalped_conv     number;
                  vvalorlimite_conv  number;
                  vfatorconversao    number;
                  --
                  vpossuiparametro   varchar2(1);
                  vlimitecredromance number;
                  vvalorlimitefav    number;
                  vparametrodist     varchar2(1);
                  --
                begin
                  --
                  :P80_PEDIDOSCONSULTORA := pck_util_fav.fnc_quantidadepedidos ( :P80_IDVENDEDORA ); 
                  --
                  :P80_IDVENDEDORARENEGOCIACAO := :P80_IDVENDEDORA; 
                  -- 
                  select nvl(cpf, documentoestrangeiro)
                       , p.senhasite
                       , v.idfilial
                       , v.idrepresentante
                       , p.limitecredromance
                       , p.limitecredito
                  into vdocumento            
                     , vsenha
                     , vidfilial 
                     , vidrepresentante
                     , vlimitecredromance
                     , vvalorlimitefav
                  from pessoas p
                     , vendedoras v
                  where v.idpessoa     = p.idpessoa
                    and v.idvendedora  = :P80_IDVENDEDORA;
                  --
                  :P80_IDREPRESENTANTE := vidrepresentante;
                  --
                  select rf.fatorconversao
                    into vfatorconversao
                  from roman.vw_filiais rf
                  where rf.idfilial = vidfilial;
                  --
                  begin
                      --
                      select 'S'
                      into vpossuiparametro
                      from roman.cadastrosparametrosrepres c
                      where c.idfilial = vidfilial
                        and c.parametro = 'LIBERACONSULTASCORE'
                        and c.valor = 'S'; -- Tudo depende do parâmetro para seguir o processo
                      --
                    exception
                      when no_data_found then
                      vpossuiparametro := 'N'; 
                  end;
                  --
                  begin
                      --
                      select 'S'
                      into vparametrodist
                      from roman.paramcredscoredist pr
                      where pr.idrepresentante = vidrepresentante
                        and pr.nomeparametro = 'SCOREECREDITO'
                        and pr.valorparametro = 'S'; -- Tudo depende do parâmetro para seguir o processo
                      --
                    exception
                      when no_data_found then
                      vparametrodist := 'N'; 
                  end;
                  --
                  pck_controle_fav.prc_login( pdocumento         => vdocumento
                                            , pemail             => vemail
                                            , psenha             => vsenha
                                            , pretorno           => vretorno
                                            , pidpessoa          => vidpessoa
                                            , pidvendedora       => vidvendedora
                                            , pidrepresentante   => vidrepresentante
                                            , pidfilial          => vidfilial
                                            , pedicoesrevista    => vedicoesrevista
                                            , pqtddebitos        => vqtddebitos
                                            , pvlrlimiteped      => vvlrlimiteped
                                            , pvlrlimiteminimo   => vvlrlimiteminimo
                                            , ppontosdisp        => vpontosdisp
                                            , pvlrmaximoped      => vvlrmaximoped
                                            , patendenteloja     => vatendenteloja
                                            , pidfilialfavorita  => vidfilialfavorita
                                            , pidusuario         => vidusuario
                                            , ptipospagamentos   => vtipospagamentos
                                            , ptiposentregas     => vtiposentregas
                                            , pmensagem          => vmensagem
                                            , pidpedido          => vidpedido
                                            , pidpais            => vidpais
                                            , pliberafazerpedido => vliberafazerpedido);
                  --
                    :P80_IDPAISVENDEDORA := vidpais;
                  --
                  pck_controle_fav.prc_retornalimitevendedora ( pidvendedora       => vidvendedora  -- Chama a procedure retorna limite da vendedora 
                                                              , pvalorlimitemaximo => vvalorlimitemaximo
                                                              , pvalorlimite       => vvalorlimite
                                                              , pvalorlimitepagar  => vvalorlimitepagar );
                  -- 
                  begin
                    --
                    -- Verrifica parametro que identifica loja de fronteira.
                    --
                    select 1 
                    into vnum
                    from parametros
                    where idfilialfavorita = :P0_IDFILIALFAVORITA
                      and nome = 'TRABALHACOMDOCESTRANGEIRO'
                      and valor = 'S';
                    --
                  exception
                    when others then
                      null;
                  end;
                  --
                  -- Verifica Saldo devedor e total de pedidos
                  --
                  select sum(v.saldodevedor)
                       , sum(v.valortotal)
                  into vsaldodevedor1 
                     , vvalortotalped1
                  from vw_pedidos_fav_new v
                  where idvendedora    = :P80_IDVENDEDORA
                    and v.tipopedido   = 'P'
                    and v.datacancelamento is null
                    and not exists ( select 1
                                     from classificacoespedidos cp
                                     where cp.idcaracteristicapedido in (104,59)
                                       and cp.idpedido = v.idpedido )
                    and v.saldodevedor > 0;
                  --  
                  -- Verifica Saldo devedor e total de pedidos sistema antigo
                  --
                  select sum(c.valorapagar - c.valorpago)
                       , sum(c.valortotal)
                  into vsaldodevedor2
                     , vvalortotalped2
                  from vw_pedidos_old c
                  where idvendedora    = :P80_IDVENDEDORA
                    and c.saldodevedor > 0.5 
                    and c.idsituacao not in ( 'Q','U','K') ;   
                  --   
                  -- Verifica Saldo devedor e total de trocas
                  --
                  select sum(t.saldodevedor)   
                       , sum(t.valortotal)
                  into vsaldodevedor3
                     , vvalortotalped3
                  from vw_pedidos_fav_new t
                  where idvendedora    = :P80_IDVENDEDORA 
                    and t.tipopedido   = 'T'
                    and not exists ( select 1
                                     from classificacoespedidos cp
                                     where cp.idcaracteristicapedido in (104,59)
                                       and cp.idpedido = t.idpedido )
                    and t.valorapagar  > 0
                    and t.saldodevedor > 0;     
                  --
                  vsaldo       := nvl(vsaldodevedor1,0)  + nvl(vsaldodevedor2,0)  + nvl(vsaldodevedor3,0);  -- Soma o saldo devedor das três tipos de pedidos.
                  vtotalped    := nvl(vvalortotalped1,0) + nvl(vvalortotalped2,0) + nvl(vvalortotalped3,0);  -- Soma o total do pedido das três tipos de pedidos.
                  --
                  --Testa se há saldo devedor ou não e retorna a mensagem correspondente na tela.
                  --
                  if vsaldo > 0 then
                    vdescricao := '<font color="red">Saldo devedor de '||trim(to_char(vsaldo,'999G999G999G990D00'))||' (Valor de Boleto). Valor de Revista: '||trim(to_char(vtotalped,'999G999G999G999G990D00'))||'</font>';
                  else
                    vdescricao := '<font color="green"> Não há saldo devedor. </font>';
                  end if;
                  --
                  --Testa se o valor do limite é menor que zero e se for retorna zero.
                  --
                  if vvlrlimiteped < 0 then
                    vvlrlimiteped := 0;
                  end if;
                  --
                  /*select favorita.pck_controle_fav.fnc_retornalimitedisponivel(:P80_IDVENDEDORA,'D' ) disponivel
                       , favorita.pck_controle_fav.fnc_retornalimitedisponivel(:P80_IDVENDEDORA,'M' )   maximo
                       , favorita.pck_controle_fav.fnc_retornalimitedisponivel(:P80_IDVENDEDORA,'M' ) - favorita.pck_controle_fav.fnc_retornalimitedisponivel(:P80_IDVENDEDORA,'D' ) saldofav
                  into vvlrlimiteped
                     , vvlrmaximoped
                     , vvlrlimiteped
                  from dual;*/
                  --
                  vvlrmaximoped_real := vvlrmaximoped;  --Vem da prc_login
                  vtotalped_real := vtotalped;          --Vem da consulta no processo
                  vvalorlimite_real := vvalorlimite;    --Vem da prc_retornalimitevendedora
                  --
                  --Testa se o parametro esta setado com sim 
                  --
                  if nvl(vnum,0) > 0 then 
                    -- 
                    vconversao := pck_controle_fav.fnc_retornaconversaopy_v2; --Se o parâmetro for sim chama a fnc_retornaconversaopy (antiga fnc_retornaconversaopy, foi bloqueada)
                    --
                    vvlrmaximoped_real := round( vvlrmaximoped_real / vconversao , 2 ); --Calcula os valores baseados na conversão retornada da fnc_retornaconversaopy
                    vtotalped_real     := round( vtotalped_real / vconversao , 2 );
                    vvalorlimite_real  := round( vvalorlimite_real / vconversao , 2 );
                  else
                    --
                    vvlrmaximoped_conv  := round( vvlrmaximoped_real * vfatorconversao, 2 );
                    vtotalped_conv      := round( vtotalped_real * vfatorconversao , 2 );
                    vvalorlimite_conv   := round( vvalorlimite_real * vfatorconversao , 2 );
                    --
                  end if;
                  --
                  if ( vpossuiparametro = 'S' or vparametrodist = 'S') and vlimitecredromance is not null then
                
                  /*BEGIN
                    -- Defina a mensagem de erro em um item da página
                    apex_util.set_session_state('P80_MENSAGEM_ERRO', 'entrei no lugar certo.'||' - '|| vvalorlimite||' - '||vtotalped||' - '||vvalorlimite ||' - '||:P80_IDVENDEDORA||' - '||vpossuiparametro);
                  END;*/
                
                    
                  :P80_DEBITOFAVORITA  := vdescricao;
                  :P80_FAVORITALIMITEDISPONIVEL := '<font color="green"> Limite disponível </font>'||trim(to_char(vvalorlimitefav,'999G999G999G999G990D00')  )
                                                                                            ||' - '||trim(to_char(vtotalped,'999G999G999G999G990D00'))
                                                                         ||' = <font color="blue">'||trim(to_char(vvalorlimite,'999G999G999G999G990D00'))||'. </font>(Valor de Revista - Disponível)'; --Retorna valores do pais.
                                                                                                   
                
                  :P80_FAVORITALIMITEDISPONIVEL_REAL := '<font color="green"> Limite disponível </font>'||trim(to_char(vvalorlimitefav,'999G999G999G999G990D00')  )
                                                                                                 ||' - '||trim(to_char(vtotalped_real,'999G999G999G999G990D00'))
                                                                              ||' = <font color="blue">'||trim(to_char(vvalorlimite_real,'999G999G999G999G990D00'))||'. </font>(Valor de Revista - Disponível)'; --Retorna valores convertidos ponta porã
                                                                                                   
                  :P80_FAVORITALIMETECONV := '<font color="green"> Limite disponível </font>'||trim(to_char(vvalorlimitefav,'999G999G999G999G990D00')  )
                                                                                      ||' - '||trim(to_char(vtotalped_conv ,'999G999G999G999G990D00'))
                                                                   ||' = <font color="blue">'||trim(to_char(vvalorlimite_conv,'999G999G999G999G990D00'))||'. </font>(Valor de Revista - Disponível)'; --|Retorna valores convertidos demais paises.  
                  else 
                    --
                    :P80_DEBITOFAVORITA  := vdescricao;
                  :P80_FAVORITALIMITEDISPONIVEL := '<font color="green"> Limite disponível </font>'||trim(to_char(vvlrmaximoped,'999G999G999G999G990D00')  )
                                                                                            ||' - '||trim(to_char(vtotalped,'999G999G999G999G990D00'))
                                                                         ||' = <font color="blue">'||trim(to_char(vvalorlimite,'999G999G999G999G990D00'))||'. </font>(Valor de Revista - Disponível)'; --Retorna valores do pais.
                                                                                                   
                
                  :P80_FAVORITALIMITEDISPONIVEL_REAL := '<font color="green"> Limite disponível </font>'||trim(to_char(vvlrmaximoped_real,'999G999G999G999G990D00')  )
                                                                                                 ||' - '||trim(to_char(vtotalped_real,'999G999G999G999G990D00'))
                                                                              ||' = <font color="blue">'||trim(to_char(vvalorlimite_real,'999G999G999G999G990D00'))||'. </font>(Valor de Revista - Disponível)'; --Retorna valores convertidos ponta porã
                                                                                                   
                  :P80_FAVORITALIMETECONV := '<font color="green"> Limite disponível </font>'||trim(to_char(vvlrmaximoped_conv,'999G999G999G999G990D00')  )
                                                                                      ||' - '||trim(to_char(vtotalped_conv ,'999G999G999G999G990D00'))
                                                                   ||' = <font color="blue">'||trim(to_char(vvalorlimite_conv,'999G999G999G999G990D00'))||'. </font>(Valor de Revista - Disponível)'; --|Retorna valores convertidos demais paises. 
                    --
                  end if;
                  --
                  --
                  -- Maicon Aimi - 9237742 Sprint 41 - 12/08/2024
                  begin
                    if roman.pck_clubedesucesso.fnc_FilialVendedoraPossuiCampanhaAtiva(:P80_IDVENDEDORA) and :P80_IDVENDEDORA != 2363887 then 
                      
                      -- busca a categoria e carrega no campo da tela
                      select ct.nomecategoria
                        into :P80_CATEGORIA_CLUBE_ESTRELAS
                        from roman.pontuacoesclubedesucesso pp
                           , roman.categoriasclubes ct
                       where pp.idcategoriaclube = ct.idcategoriaclube
                         and pp.idpontuacaoclube = (select max(pc.idpontuacaoclube)
                                                      from catal.pessoas p
                                                         , catal.vendedoras v
                                                         , roman.pontuacoesclubedesucesso pc
                                                     where v.idpessoa = p.idpessoa
                                                       and pc.idvendedora = v.idvendedora
                                                       and v.idpessoa = (select vaux.idpessoa
                                                                           from catal.vendedoras vaux
                                                                          where vaux.idvendedora = :P80_IDVENDEDORA));
                    else
                      :P80_CATEGORIA_CLUBE_ESTRELAS := 'Não participa de campanha.';
                    end if;
                  exception
                    when others then
                      null;
                  end;
                  --
                exception
                  when others then
                    --
                    roman.prc_grava_log_debug_desenvolvedores('Processo: Busca Dados(2000 80)',SQLERRM);
                    --
                    :P80_DEBITOFAVORITA           := null;
                    :P80_FAVORITALIMITEDISPONIVEL := null; 
                    :P80_PEDIDOSCONSULTORA        := null;
                    :P80_IDVENDEDORARENEGOCIACAO  := null;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 78797211414067354
        }
    )

    process força-atualização (
        name: "Força atualização "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update vendedoras v
                  set v.updated_time = sysdate
                  where v.idvendedora = :P80_IDVENDEDORA;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Cadastro Atualizado, verifique o Adapto.
        }
        advanced {
            executionMappingIdentifier: 1804570023980586516
        }
        serverSideCondition {
            whenButtonPressed: @atualizar-limite-adapto
        }
    )

    branch (
        name: proximo passo loja
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 649
                items: {
                    P649_IDVENDEDORA: &P80_IDVENDEDORA.
                    P649_IDPEDIDO: &P80_IDPEDIDO.
                    P649_IDFILIALFAVORITA: &P80_IDFILIALFAVORITANICIAR.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: PROXIMOPASSO_L
