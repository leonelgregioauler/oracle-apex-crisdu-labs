        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from vendedoras v 
                where v.idvendedora = :P80_IDVENDEDORA
                  and v.ativo = 'S' --Bruno 30/07/2025: Controle do projeto score, tela 651(score) não pode pesquisar clientes inativas
                ```
        }
    )

    region pedidos-favorita (
        name: Pedidos Favorita
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                return q'~
                select v.idpedido     
                     , v.desctipopedido tipopedido
                     , v.edicaorevista 
                     , v.representante
                     , v.situacaoentrega
                       ||'<br>'|| v.situacaofinanceiro
                       ||'<br>'|| v.situacaocobranca situacoes
                     , v.numeropedido
                     , v.dataemissao
                     , v.dataentrega
                     , v.datadespacho
                     , v.valortotal
                     , v.valorpontoutilizado
                     , v.valortotalcomdesconto
                     , v.valorfrete
                     , v.valorapagar
                     , v.valorpago
                     , v.verificarnaconta
                     , case
                         when v.saldodevedor < 0 then
                           0
                         else
                           v.saldodevedor
                       end saldodevedor
                     , case 
                         --when pck_util_fav.fnc_retornapedidowidecommerce(v.idpedido) is null then
                         when IDPEDIDOWIDECOMMERCE is null then
                           '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||v.idpedido ,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>'
                         --when pck_util_fav.fnc_retornapedidowidecommerce(v.idpedido) is not null then
                         when IDPEDIDOWIDECOMMERCE is not null then
                           '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':415:'||v('APP_SESSION')||'::NO::P415_IDPEDIDO:'||v.idpedido ,'ESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>'
                       end  url
                     , v.situacaovencimento ||' - '||pck_pedidos_fav.fnc_situacaopagamentoped(v.idpedido) situacaoboleto
                     , v.datavencimentomenor
                     , v.idfilialfavorita
                     , v.filialfavorita
                     , nvl(( select 'Sim'
                             from favorita.classificacoespedidos cp
                             where cp.idpedido = v.idpedido
                             and cp.idcaracteristicapedido = 25 ), 'Não') situacaopedido
                     , ( select distinct 'S'
                         from vencimentospedidos vc
                         where vc.situacaovencimento = 'V'
                           and vc.valorpago < vc.valorpagar
                           and vc.idpedido = v.idpedido 
                           and vc.datavencimento < trunc(sysdate) ) em_aberto
                     -- Maicon Aimi - 17/03/2025 - 9909548 -- add a coluna idfilialfavoritaorig
                     , (select favorita.pck_util_fav.fnc_nomefilialfavorita(pp.idfilialfavoritaorig)
                          from favorita.pedidos pp
                         where pp.idpedido = v.idpedido) as "Saída"
                  from vw_pedidos_fav_new v
                 where idvendedora = :P80_IDVENDEDORA
                   and :P80_IDVENDEDORA != 2363887
                union all
                select v.idpedido     
                     , v.desctipopedido tipopedido
                     , v.edicaorevista 
                     , v.representante
                     , v.situacaoentrega
                       ||'<br>'|| v.situacaofinanceiro
                       ||'<br>'|| v.situacaocobranca situacoes
                     , v.numeropedido
                     , v.dataemissao
                     , v.dataentrega
                     , v.datadespacho
                     , v.valortotal
                     , v.valorpontoutilizado
                     , v.valortotalcomdesconto
                     , v.valorfrete
                     , v.valorapagar
                     , v.valorpago
                     , v.verificarnaconta
                     , case
                         when v.saldodevedor < 0 then
                           0
                         else
                           v.saldodevedor
                       end saldodevedor
                     , case 
                         --when pck_util_fav.fnc_retornapedidowidecommerce(v.idpedido) is null then
                         when IDPEDIDOWIDECOMMERCE is null then
                           '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||v.idpedido ,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>'
                         --when pck_util_fav.fnc_retornapedidowidecommerce(v.idpedido) is not null then
                         when IDPEDIDOWIDECOMMERCE is not null then
                           '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':415:'||v('APP_SESSION')||'::NO::P415_IDPEDIDO:'||v.idpedido ,'ESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>'
                       end  url
                     , v.situacaovencimento ||' - '||pck_pedidos_fav.fnc_situacaopagamentoped(v.idpedido) situacaoboleto
                     , v.datavencimentomenor
                     , v.idfilialfavorita
                     , v.filialfavorita
                     , nvl(( select 'Sim'
                             from favorita.classificacoespedidos cp
                             where cp.idpedido = v.idpedido
                             and cp.idcaracteristicapedido = 25 ), 'Não') situacaopedido
                     , ( select distinct 'S'
                         from vencimentospedidos vc
                         where vc.situacaovencimento = 'V'
                           and vc.valorpago < vc.valorpagar
                           and vc.idpedido = v.idpedido 
                           and vc.datavencimento < trunc(sysdate) ) em_aberto
                     -- Maicon Aimi - 17/03/2025 - 9909548 -- add a coluna idfilialfavoritaorig
                     , (select favorita.pck_util_fav.fnc_nomefilialfavorita(pp.idfilialfavoritaorig)
                          from favorita.pedidos pp
                         where pp.idpedido = v.idpedido) as "Saída"
                  from vw_pedidos_fav_new v
                 where idvendedora = :P80_IDVENDEDORA
                   and :P80_IDVENDEDORA = 2363887
                   and trunc(v.dataemissao) = trunc(sysdate)
                union all
                select t.idpedido 
                     , 'Pedido'
                     , t.edicaorevista
                     , t.representante
                     , t.situacao situacoes
                     , t.numeropedido
                     , t.dataemissao
                     , T.dataentrega
                     , T.datadespacho
                     , T.valortotal
                     , pontosutilizados valorpontoutilizado
                     , 0 valortotalcomdesconto
                     , 0 valorfrete
                     , T.valorapagar
                     , valorpago valorpago
                     , null verificarnaconta
                     , valorapagar - valorpago saldodevedor
                     , null url
                     , case  
                         when t.saldodevedor >= 0 then t.situacaoboleto
                         when t.saldodevedor < 0  then t.situacaoboleto || '(Juros)'
                       end situacaoboleto
                     , t.datavencpedido
                     , null
                     , null
                     , decode(situacao, 'Z', 'Sim', 'Não') situacaopedido
                     , null
                     -- Maicon Aimi - 17/03/2025 - 9909548 -- add a coluna idfilialfavoritaorig
                     , null as "Saída"
                  from vw_pedidos_old t
                 where idvendedora = :P80_IDVENDEDORA
                   and :P80_IDVENDEDORA != 2363887
                ~';
                ```
            pageItemsToSubmit: P80_IDVENDEDORA
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum pedido encontrado!
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 169308985010769691
        }

