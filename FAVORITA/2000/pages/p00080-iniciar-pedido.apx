    pageItem P80_AVISOLIMITEESPECIAL (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: html
        }
        layout {
            sequence: 250
            region: @análise-da-consultora
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 6
            columnSpan: 4
            labelColumnSpan: 0
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vfunc VARCHAR2(1);
                  vvendfunc VARCHAR2(1);
                begin
                  --
                  begin
                    -- Tenta buscar o ID da vendedora correspondente
                    select 'S'
                    into vfunc
                    from catal.funcionarios f
                    where f.ativo = 'S'
                      and f.idpessoa = (select v.idpessoa 
                                        from catal.vendedoras v 
                                        where v.idvendedora = :P80_IDVENDEDORA)
                      and not exists ( select 1
                                       from gerentes g
                                          , roman.vw_filiais fl
                                       where g.idgerente = fl.idgerente
                                         and g.idpessoa = f.idpessoa
                                         and fl.tipofilial = 'D'
                                         and fl.ativo = 'S');
                  
                  exception
                    -- Se não encontrar o registro, atribui N a vfunc
                    when NO_DATA_FOUND then
                        vfunc := 'N';
                  end;
                  --
                  begin
                   -- 
                   select 'S'
                   into vvendfunc
                   from catal.vendedoras v
                   where v.idvendedora = :P80_IDVENDEDORA
                     and v.ativo = 'S'
                     and exists ( select 1
                                  from roman.notasvendas nv
                                  where nv.idvendedora = v.idvendedora
                                    and nv.idsituacaonotavenda = 3 )
                     and exists ( select 1
                                  from catal.funcionarios f
                                  where f.idpessoa = v.idpessoa
                                    and f.ativo = 'S');  
                  exception
                    -- Se não encontrar o registro, atribui N a vfunc
                    when NO_DATA_FOUND then
                        vvendfunc := 'N';
                  end;
                  --
                 if vfunc = 'S' and vvendfunc = 'N' then 
                  :P80_AVISOLIMITEESPECIAL := '<font size="3" color="green"> Consultora APTA a comprar produtos Romance Casa A VISTA</font>' ;
                 elsif :P80_CATEGORIA_CLUBE_ESTRELAS in ('Não participa de campanha.', 'Nenhum', '1 Estrela', '2 Estrela') then
                  :P80_AVISOLIMITEESPECIAL := '<font size="3" color="green"> Consultora APTA a comprar produtos Romance Casa A VISTA </font>' ;
                 else
                  :P80_AVISOLIMITEESPECIAL := '<font size="3" color="green"> Consultora APTA a comprar produtos Romance Casa A PRAZO </font>' ;
                 end if;
                 
                 return :P80_AVISOLIMITEESPECIAL;
                 
                end;
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from liberacoesvendasdistribuidores l
                where l.idrepresentante = :P80_IDREPRESENTANTE
                   and :P80_IDVENDEDORA is not null
                   --
                   and ( (select idvalorcaracteristica 
                            from roman.classificacoesnotasvendas 
                           where idclassificacaonotavenda = ( select max(c.idclassificacaonotavenda) 
                                                                from roman.notasvendas n 
                                                                   , roman.classificacoesnotasvendas c 
                                                               where n.idnotavenda = c.idnotavenda 
                                                                 and c.idcaracteristicanotavenda = 52 
                                                                 and n.idvendedora = :P80_IDVENDEDORA
                                                                 and n.idsituacaonotavenda in (3,4)  ) ) > 3 
                         OR exists
                         ( select 1 
                           from vendedoras v
                              , representantes r
                           where v.idvendedora = :P80_IDVENDEDORA
                             and r.idrepresentante = l.idrepresentante
                             and v.idpessoa = r.idpessoa ) )
                union
                
                select 1
                from dual 
                where exists ( select 1
                                  from parametros p
                                 where p.nome = 'ROMANCECASALOJA'
                                   and :P80_IDVENDEDORA is not null
                                   and p.valor = 'S'
                                   and p.idfilialfavorita = ( select u.idfilialfavorita
                                                                from usuarios u
                                                               where u.usuario = v('APP_USER') ) )
                
                union
                
                select 1
                from dual 
                where exists ( select 1
                                  from parametros p
                                 where p.nome = 'ROMANCECASALOJA'
                                   and :P80_IDVENDEDORA is not null
                                   and p.valor = 'S'
                                   and p.idfilialromance = ( select v.idfilial
                                                             from vendedoras v
                                                             where v.idvendedora = :P80_IDVENDEDORA ) )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

