            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                pck_util.fnc_verificaacesso(28346,v('APP_USER')) = 'S'
                or exists ( select 1
                            from parametros
                            where nome = 'FLUXO_DELIVERY'
                              and valor = 'S'
                              and idfilialfavorita = :P0_IDFILIALFAVORITA )
                ```
        }
    )

    region fotos-de-documentos (
        name: Fotos de Documentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.tipofoto
                     , decode(f.recebida,'S','Sim','N','Não') recebida
                     , f.datadadosrecebido
                     , null verfoto
                     , '<a href="http://fotos_documentos.romancemoda.com.br/'||f.nomearquivo||'" target="_blank"> <img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif"><a>' foto
                     , nomearquivo
                from roman.fotosdocumentos f
                where f.idpessoa = :P80_IDPESSOA
                  and :P80_IDVENDEDORA != 2363887
                order by 1
                ```
            pageItemsToSubmit: P80_IDPESSOA
        }
        layout {
            sequence: 60
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhuma foto encontrada para este documento!
        }
        advanced {
            savedReportMappingIdentifier: 1674837006332081853
        }

