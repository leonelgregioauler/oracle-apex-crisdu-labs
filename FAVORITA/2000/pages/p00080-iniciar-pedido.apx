page 80 (
    name: Iniciar Pedido
    alias: INICIAR-PEDIDO
    title: Iniciar Pedido
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='Não e possivel fazer pedidos para distribuidor na loja';
            
            function fnc_renegociarpedido()
            {
            var params = [
                'height='+screen.height,
                'width='+screen.width,
                'fullscreen=yes',
                'location=yes,scrollbars=yes,status=yes'
            ].join(',');
                IDVENDEDORA     = document.getElementById('P80_IDVENDEDORARENEGOCIACAO').value;
                IDUSUARIO       = document.getElementById('P0_IDUSUARIO').value;
                
                if( IDVENDEDORA != '') 
                  {
                    vendereco = 'https://ws.catalogofavorita.com.br/executar/callcenter/renegociar?str={"IDVENDEDORA":'+IDVENDEDORA+',"IDUSUARIO":'+IDUSUARIO+'}' 
                  }  
                 
            
                vjanela = window.open(vendereco , 'SITE', params);/* 'location=yes,height=100%,width=100%,scrollbars=yes,status=yes');*/
                vjanela.focus();
                vjanela.moveTo(0,0);
                addEventListener("message", function(msg){ if (msg.data == "reload") location.reload()}, false);
                
            }
            ```
    }
    css {
        inline:
            ```css
            .img_documento {
                position: relative;
                max-width: 360px;
                width: 60%;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region análise-da-consultora (
        name: Análise da Consultora
        type: staticContent
        layout {
            sequence: 20
            slot: body
