    pageItem P80_ENDERECO (
        type: displayOnly
        label {
            label: Endereco
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 90
            region: @análise-da-consultora
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vendereco  varchar2(1000);
                begin
                  --
                  select initcap(p.enderecoprincipal||', '||p.numero||' - '||p.bairro)||' - '||roman.pck_romance.fnc_nomecidade(p.idcidade) display_value
                  into vendereco
                  from pessoas    p
                     , vendedoras v
                  where p.idpessoa    = v.idpessoa
                    and v.idvendedora = :P80_IDVENDEDORA;
                  --
                  return vendereco;
                  --
                exception
                  when others then
                    null;
                end;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

