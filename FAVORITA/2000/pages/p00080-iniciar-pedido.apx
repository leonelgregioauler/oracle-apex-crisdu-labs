    pageItem P80_VLRLIMITEPEDESPECIAL (
        type: displayOnly
        label {
            label: Limite Venda Especial
            alignment: left
        }
        layout {
            sequence: 240
            region: @análise-da-consultora
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                vVlrLimiteMax number;
                vVlrLimite    number;
                vVlrLimitePag number;
                BEGIN
                  if :P80_IDVENDEDORA is not null then 
                  vVlrLimite := 0;
                  pck_controle_fav.prc_retornalimitevendedora ( :P80_IDVENDEDORA
                                             , vVlrLimiteMax
                                             , vVlrLimite
                                             , vVlrLimitePag
                                             , 'R');
                  else vVlrLimite := 0;
                  end if;
                
                  return vVlrLimite;
                  
                END;
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from liberacoesvendasdistribuidores l
                where l.idrepresentante = :P80_IDREPRESENTANTE
                   and :P80_IDVENDEDORA is not null
                   --
                   and ( (select idvalorcaracteristica 
                            from roman.classificacoesnotasvendas 
                           where idclassificacaonotavenda = ( select max(c.idclassificacaonotavenda) 
                                                                from roman.notasvendas n 
                                                                   , roman.classificacoesnotasvendas c 
                                                               where n.idnotavenda = c.idnotavenda 
                                                                 and c.idcaracteristicanotavenda = 52 
                                                                 and n.idvendedora = :P80_IDVENDEDORA
                                                                 and n.idsituacaonotavenda in (3,4)  ) ) > 3 
                         OR exists
                         ( select 1 
                           from vendedoras v
                              , representantes r
                           where v.idvendedora = :P80_IDVENDEDORA
                             and r.idrepresentante = l.idrepresentante
                             and v.idpessoa = r.idpessoa ) )
                union
                
                select 1
                from dual 
                where exists ( select 1
                                  from parametros p
                                 where p.nome = 'ROMANCECASALOJA'
                                   and :P80_IDVENDEDORA is not null
                                   and p.valor = 'S'
                                   and p.idfilialfavorita = ( select u.idfilialfavorita
                                                                from usuarios u
                                                               where u.usuario = v('APP_USER') ) )
                
                union
                
                select 1
                from dual 
                where exists ( select 1
                                  from parametros p
                                 where p.nome = 'ROMANCECASALOJA'
                                   and :P80_IDVENDEDORA is not null
                                   and p.valor = 'S'
                                   and p.idfilialromance = ( select v.idfilial
                                                             from vendedoras v
                                                             where v.idvendedora = :P80_IDVENDEDORA ) )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

