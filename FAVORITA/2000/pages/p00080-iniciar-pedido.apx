    pageItem P80_DEBITOFAVORITA (
        type: displayOnly
        label {
            label: Favorita
            alignment: left
        }
        settings {
            format: html
            sendOnPageSubmit: false
        }
        layout {
            sequence: 180
            region: @análise-da-consultora
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vsaldo number;
                  vdescricao  varchar2(2000);
                  vsitvencimento varchar2(100);
                begin
                  --
                  select nvl(( select sum(v.saldodevedor)
                               from vw_pedidos_fav_new v
                               where idvendedora    = :P80_IDVENDEDORA
                                 and v.tipopedido   in ('P','R')
                                 and v.datacancelamento is null
                                 and v.saldodevedor > 0
                                 and not exists ( select 1
                                                  from favorita.classificacoespedidos cl
                                                  where cl.idpedido = v.idpedido
                                                    and cl.idcaracteristicapedido in (104,59)))  ,0)
                       + nvl(( select sum(c.valorapagar - c.valorpago)
                               from vw_pedidos_old c
                               where idvendedora    = :P80_IDVENDEDORA
                                 and c.saldodevedor > 0.5 
                                 and c.idsituacao not in ( 'Q','U','K') ) ,0)
                       + nvl(( select sum(t.saldodevedor)
                               from vw_pedidos_fav_new t
                               where idvendedora    = :P80_IDVENDEDORA
                                 and t.tipopedido   = 'T'
                                 and t.valorapagar  > 0
                                 and t.saldodevedor > 0
                                 and t.datacancelamento is null
                                 and not exists ( select 1
                                                  from favorita.classificacoespedidos cl
                                                  where cl.idpedido = t.idpedido
                                                    and cl.idcaracteristicapedido = 104)) ,0)
                  into vsaldo
                  from dual;
                  --
                  if vsaldo > 0 then
                    vdescricao := '<font color="red">Saldo devedor de '||trim(to_char(vsaldo,'999G999G999G990D00'))||'.</font>';
                  else
                    vdescricao := '<font color="green"> Não há saldo devedor. </font>';
                  end if;
                  --
                  return vdescricao;
                  --
                end;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P80_DEBITOROMANCE (
        type: displayOnly
        label {
            label: Romance
            alignment: left
        }
        settings {
            format: html
            sendOnPageSubmit: false
        }
        layout {
            sequence: 200
            region: @análise-da-consultora
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vsaldo number;
                  vdescricao  varchar2(2000);
                begin
                  --
                  select nvl( ( select sum(saldo)
                                from roman.vw_notasvendas_roman c
                                where idvendedora           = :P80_IDVENDEDORA
                                  and c.idsituacaonotavenda = 4 
                                  and saldo > 0
                                  and not exists ( select 1
                                         from roman.classificacoesnotasvendas cl
                                         where cl.idnotavenda = c.idnotavenda
                                           and cl.idcaracteristicanotavenda = 59)) ,0)
                  into vsaldo
                  from dual;
                  --
                  if vsaldo > 0 then
                    vdescricao := '<font color="red">Saldo devedor de '||trim(to_char(vsaldo,'999G999G999G990D00'))||'.</font>';
                  else
                    vdescricao := '<font color="green"> Não há saldo devedor. </font>';
                  end if;
                  --
                  return vdescricao;
                  --
                end;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

