    pageItem P477_FILIAIS (
        type: plugin/select
        label {
            label: Filiais
            alignment: left
        }
        settings {
            selectListType: multiValueSelectList
            width: 600
            rapidSelection: attributeValue
            dragAndDropSorting: attributeValue
            selectOnBlur: attributeValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nomefilialfavorita d,
                       f.idfilialfavorita
                from filiaisfavorita f
                where (not exists (select ff.column_value
                                  from gruposmeta g,
                                       table(pck_util_fav.fnc_array_to_table(g.filiais)) ff
                                  where ff.column_value = f.idfilialfavorita) and :P477_ID_GRUPO is null)
                or not exists (select ff.column_value
                                from gruposmeta g,
                                      table(pck_util_fav.fnc_array_to_table(g.filiais)) ff
                                where g.idgrupometa != :P477_ID_GRUPO
                                and ff.column_value = f.idfilialfavorita)
                ```
        }
        layout {
            sequence: 20
            region: @cadastro-de-grupo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

