    region lista-de-grupos (
        name: Lista de Grupos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select g.idgrupometa,
                       g.nome as "Nome",
                       (select listagg(pck_util_fav.fnc_nomefilialfavorita(fi.column_value), '; ')
                        within group (order by pck_util_fav.fnc_nomefilialfavorita(fi.column_value))
                        from table(pck_util_fav.fnc_array_to_table(g.filiais))fi) as "Filiais"
                from gruposmeta g
                ```
        }
        layout {
            sequence: 20
            parentRegion: @cadastro-de-grupo-de-meta
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P477_ID_GRUPO is null
        }
        link {
