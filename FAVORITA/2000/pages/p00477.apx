    process criar-meta (
        name: Criar Meta
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Created on 22/10/2020 by MAX.BERKEUER 
                declare 
                  --
                  vid_meta number;
                  vexist_dados number;
                  /*
                  dt_base_ini date := to_date('01/04/2021','DD/MM/RRRR');
                  dt_base_fim date := to_date('30/04/2021','DD/MM/RRRR');
                  vmeta_geral number := 4260000;
                  dt_inicial date := to_date('01/05/2021','DD/MM/RRRR');
                  dt_final date := to_date('31/05/2021','DD/MM/RRRR');
                  */
                  dt_base_ini date := to_date(:P477_DT_BASE_INI,'DD/MM/RRRR');
                  dt_base_fim date := to_date(:P477_DT_BASE_FIM,'DD/MM/RRRR');
                  vmeta_geral number := :P477_VLR_META;
                  dt_inicial date := to_date(:P477_DT_INICIAL,'DD/MM/RRRR');
                  dt_final date := to_date(:P477_DT_FINAL,'DD/MM/RRRR');
                  
                  --
                begin
                  --
                  /*Verifica se existe dados no filtro informado*/
                  select count(1)
                  into vexist_dados
                  from vw_itenspedidos_mv i
                  where i.dt_cancelamento is null
                  and i.tp_pedido = 'P'
                  and i.dt_emissao between to_date(dt_base_ini||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(dt_base_fim||' 23:59:59','DD/MM/RRRR HH24:MI:SS');
                  --
                  if vexist_dados > 0 then
                    --
                    insert into metasvendas(idmetavenda,
                                            datainicial,
                                            datafinal,
                                            valor)
                    values(seq_idmetavenda.nextval,
                                            dt_inicial,
                                            dt_final,
                                            vmeta_geral)
                    returning idmetavenda into vid_meta;
                    --
                    for c in (select round(sum(d2.valor_tot_filial)) as tot_venda
                                   , nvl(round(sum(d2.perc)),1) as percentual
                                   , sum((vmeta_geral * d2.perc)/100) as vlr_meta
                                   , d2.id_grupo
                              from (select d1.id_filial_fav
                                         , d1.valor_tot_filial
                                         , d1.total_geral
                                         , nvl(d1.perc,1) perc
                                         , ( select g.idgrupometa as grupo
                                             from gruposmeta g,
                                             table(pck_util_fav.fnc_array_to_table(g.filiais))  f
                                             where f.column_value = d1.id_filial_fav ) as id_grupo                           
                                         , sum(d1.perc) over(order by d1.perc desc) as perc_acumulado
                                    from (select d.id_filial_fav
                                               , nvl(d.valor_tot_filial,1) valor_tot_filial
                                               , sum(d.valor_tot_filial) over() as total_geral
                                               , case
                                                   when valor_tot_filial > 0 then
                                                     round((valor_tot_filial / sum(d.valor_tot_filial) over()) *100,3)
                                                   else
                                                     1
                                                  end as perc
                                          from ( select i.id_filial_fav
                                                      , sum(i.valorapagar) as valor_tot_filial
                                                 from vw_itenspedidos_mv i
                                                 where i.dt_cancelamento is null
                                                   and i.tp_pedido = 'P'
                                                   and i.dt_emissao between to_date(dt_base_ini||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(dt_base_fim||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                                                 group by id_filial_fav
                                                 order by 2 desc ) d ) d1 ) d2
                              where d2.id_grupo is not null
                              group by d2.id_grupo
                              order by d2.id_grupo desc)
                    loop
                      --
                      insert into metasgruposfiliais( idmetagrupofilial
                                                    , idgrupometa
                                                    , idfilialfav
                                                    , idmetavenda
                                                    , percentualmeta )
                      values( seq_idmetagrupofilial.nextval
                            , c.id_grupo
                            , null
                            , vid_meta
                            , c.percentual );
                      --
                      update metasgruposfiliais m
                      set m.percentualmeta = 1
                      where m.percentualmeta = 0
                        and m.idmetavenda = vid_meta;
                      --
                      commit;
                      --
                    end loop;
                    --
                  else
                    --
                    apex_error.add_error(p_message          => 'Não foi encontrado dados para o período base informado!',
                                         p_display_location => apex_error.c_inline_with_field_and_notif);
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Ação Processada!
        }
        advanced {
            executionMappingIdentifier: 84990123118575007
        }
        serverSideCondition {
            type: request=Value
            value: GERAR_METAS
        }
    )

    process deletar-meta (
        name: Deletar Meta
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Created on 23/10/2020 by MAX.BERKEUER 
                declare 
                  --
                  vexists number;
                  vid_meta_venda number;
                  --
                begin
                  --
                  delete metasgruposfiliais m
                  where m.idmetagrupofilial = :P477_ID_META_DELETAR
                  returning m.idmetavenda into vid_meta_venda;
                  --
                  select count(1)
                  into vexists
                  from metasgruposfiliais m
                  where m.idmetavenda = vid_meta_venda;
                  --
                  if vexists = 0 then
                    --
                    delete metasvendas m
                    where m.idmetavenda = vid_meta_venda;
                    --
                  end if;       
                  --
                  apex_util.set_session_state(p_name => 'P477_ID_META_DELETAR',p_value => null);  
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada!
        }
        advanced {
            executionMappingIdentifier: 84991911294575025
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR_META
        }
    )

    process dml-grupo (
        name: Dml grupo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Created on 22/10/2020 by MAX.BERKEUER 
                declare 
                  --
                  vid_grupo number := :P477_ID_GRUPO;
                  vnome varchar2(40) := :P477_NOME;
                  vfiliais varchar2(200) := :P477_FILIAIS;
                  vexist number;
                  --
                begin
                  --
                  if :REQUEST = 'SALVAR' then
                    --
                    if vid_grupo = 0 then
                      --
                      insert into gruposmeta(idgrupometa,
                                             nome,
                                             filiais)
                      values(seq_idgrupometa.nextval,
                                             vnome,
                                             vfiliais);
                      --
                    else
                      --
                      update gruposmeta g
                      set g.nome = vnome,
                          g.filiais = vfiliais
                      where g.idgrupometa = vid_grupo;
                      --
                    end if;
                    --
                    apex_util.set_session_state(p_name => 'P477_NOME',p_value => null);  
                    apex_util.set_session_state(p_name => 'P477_FILIAIS',p_value => null);  
                    apex_util.set_session_state(p_name => 'P477_ID_GRUPO',p_value => null);
                    --
                  elsif :REQUEST = 'DELETE_GRUPO' then
                    --
                    select count(1)
                    into vexist
                    from metasgruposfiliais m
                    where m.idgrupometa = vid_grupo;
                    --
                    if vexist = 0 then
                      --
                      delete gruposmeta g
                      where g.idgrupometa = vid_grupo;  
                      --
                    else
                      --
                      apex_error.add_error(p_message          => 'Grupo não pode ser removido, já foi incluído em uma meta.',
                                           p_display_location => apex_error.c_inline_with_field_and_notif);
                      --
                    end if;  
                    --
                    apex_util.set_session_state(p_name => 'P477_NOME',p_value => null);  
                    apex_util.set_session_state(p_name => 'P477_FILIAIS',p_value => null);  
                    apex_util.set_session_state(p_name => 'P477_ID_GRUPO',p_value => null);    
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Ação Processada!
        }
        advanced {
            executionMappingIdentifier: 82037637741427545
        }
    )

