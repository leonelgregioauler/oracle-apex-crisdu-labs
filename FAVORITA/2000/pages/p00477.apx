    process atualiza-vlr-complemento (
        name: Atualiza vlr complemento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Created on 26/10/2020 by MAX.BERKEUER 
                declare 
                  --
                  vvlr_cpl number := :P477_VLR_COMPLEMENTO;
                  vid_meta_grupo number := :P477_ID_META_GRUPO;
                  vvalor_meta number;
                  --
                begin
                  --
                  select (m.valor * mg.percentualmeta) /100
                  into vvalor_meta
                  from metasgruposfiliais mg,
                       gruposmeta g,
                       metasvendas m
                  where mg.idgrupometa = g.idgrupometa
                  and mg.idmetavenda = m.idmetavenda
                  and mg.idmetagrupofilial = vid_meta_grupo;
                  --
                  if vvlr_cpl < 0  then
                    --
                    if (vvlr_cpl * -1) >= vvalor_meta then
                      --
                      apex_error.add_error(p_message          => 'Desconto de meta não pode ser igual ou maior ao valor da meta!',
                                           p_display_location => apex_error.c_on_error_page);
                      --
                    else
                      --
                      update metasgruposfiliais m
                      set m.vlrcomplemento = vvlr_cpl
                      where m.idmetagrupofilial = vid_meta_grupo;    
                      --
                    end if;
                    --
                  else
                    --
                    update metasgruposfiliais m
                    set m.vlrcomplemento = vvlr_cpl
                    where m.idmetagrupofilial = vid_meta_grupo;    
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Ação Processada!
        }
        advanced {
            executionMappingIdentifier: 85013756171168627
        }
        serverSideCondition {
            type: request=Value
            value: UPDATE_VLR_COMPLEMENTO
        }
    )

