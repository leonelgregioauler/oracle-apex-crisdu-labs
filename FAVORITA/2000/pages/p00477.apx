page 477 (
    name: Metas de Vendas
    title: Metas de Vendas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_remove_meta(pid_meta) {
              apex.confirm("Deseja deletar essa meta?", {
                request:"DELETAR_META",
                set:{"P477_ID_META_DELETAR":pid_meta},
                showWait:true
                });  
            }
            ```
    }
    css {
        inline:
            ```css
            a.vermelho:link, a.vermelho:visited, a.vermelho:hover, a.vermelho:active {
              text-decoration: none;
              color: #f00
              }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region acompanhamento-de-metas (
        name: Acompanhamento de Metas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select g.idgrupometa as "Cod Grupo"
                     , mg.idmetagrupofilial
                     , g.nome as "Grupo"
                     , m.datainicial as "Dt Inicial"
                     , m.datafinal as "Dt Final"
                     , m.valor as "Vlr Geral"
                     , mg.percentualmeta as "Perc Meta"
                     , (m.valor * nvl(mg.percentualmeta,1)) /100 as "Vlr Meta"
                       --
                     , (((m.valor * nvl(mg.percentualmeta,1)) /100) + nvl(mg.vlrcomplemento,0)) as "Vlr Total Meta"
                     --
                     , sum(vi.valorapagar) as "vlr Realizado"
                     --
                     , round( sum(vi.valorapagar) / 
                              (((m.valor * nvl(mg.percentualmeta,1)) /100) + nvl(mg.vlrcomplemento,0)) * 100 ) ||'%' as "Perc Realizado" 
                     --
                     , nvl(mg.vlrcomplemento,0) as vlr_complemento
                     -- , '<a href="javascript:fnc_remove_meta('||mg.idmetagrupofilial||');" class="vermelho"><span class="fa fa-remove fa-2x" aria-hidden="true"></span></a>' as del
                     
                  from metasvendas m
                     , gruposmeta g
                     , metasgruposfiliais mg
                --     , vw_itenspedidos_mv vi
                     , (
                       select p.idpedido,
                              p.dataemissao as dt_emissao,
                              p.idfilialfavorita as id_filial_fav,
                              p.tipopedido as tp_pedido,
                              pck_util_fav.fnc_nomevendedora(p.idvendedora) as vendedora,
                              pck_util_fav.fnc_nomefilialfavorita(p.idfilialfavorita) as filial_fav,
                              pck_util_fav.fnc_nomeprodutodetalhado(i.idprodutodetalhado,1) as prod_detalhado,
                              case 
                                when p.idpais = 1 then i.valorvenda
                                else i.valorvenda * p.fatorconversao
                              end valorvenda,
                              --
                              case 
                                when p.idpais = 1 then i.valordesconto
                                else i.valordesconto * p.fatorconversao
                              end valordesconto,
                              --
                              case 
                                when p.idpais = 1 then i.valorapagar
                                else i.valorapagar * p.fatorconversao
                              end valorapagar,
                              p.datacancelamento as dt_cancelamento,
                              p.idvendedora,
                              p.idrepresentante
                         from itenspedidos i,
                              pedidos p
                        where i.idpedido = p.idpedido
                          and p.valorapagar > 0
                          and p.idsituacaoentrega >= 20000
                          and p.datacancelamento is null
                          and extract(year from p.dataemissao) >= 2020
                       ) vi
                
                 where mg.idgrupometa = g.idgrupometa
                   and mg.idmetavenda = m.idmetavenda
                   and vi.dt_emissao between to_date(m.datainicial||' 00:00:01','dd/mm/rrrr hh24:mi:ss') 
                                         and to_date(m.datafinal  ||' 23:59:59','dd/mm/rrrr hh24:mi:ss') 
                   and vi.dt_cancelamento is null
                   and vi.tp_pedido = 'P'
                   and vi.id_filial_fav in ( select f.column_value
                                                           from gruposmeta g
                                                              , table(pck_util_fav.fnc_array_to_table(g.filiais)) f
                                                           where g.idgrupometa = mg.idgrupometa
                                            ) 
                   --
                   --and m.datainicial >= add_months(m.datainicial,-3) -- Bruno informou que utilizam no máximo 2 meses de dados
                   and m.datainicial >= add_months(TRUNC(SYSDATE),-5) -- Bruno informou que utilizam no máximo 2 meses de dados
                   --
                   and not exists (select 1
                                     from classificacoespedidos c
                                    where c.idpedido = vi.idpedido
                                      and c.idcaracteristicapedido = 5 ) -- Pedidos de Pontos
                   --
                   and not exists (select 1
                                     from classificacoespedidos c
                                    where c.idpedido = vi.idpedido
                                      and c.idcaracteristicapedido = 49
                                      and c.idvalorcaracteristica in (2010,2144,2610,2696,2724,2730,2754,2824,2826,2958) )
                   group by g.idgrupometa
                          , mg.idmetagrupofilial
                          , g.nome
                          , m.datainicial 
                          , m.datafinal 
                          , m.valor
                          , mg.percentualmeta 
                          , mg.vlrcomplemento
                          
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
