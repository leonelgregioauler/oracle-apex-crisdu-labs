page 333 (
    name: Log de Clientes
    title: Log de Clientes
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region log-de-consultoras (
        name: Log de Consultoras
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select l.idlog
                     , l.dataalteracao
                     , usuarioalteracao
                     , decode(l.tipoalteracao, 'INSERT', 'Inserido'
                                             , 'UPDATE', 'Atualizado'
                                             , 'DELETE', 'Deletado') tipoalteracao
                     , l.idvendedora
                     , l.idpessoa
                     , roman.pck_romance.fnc_nomevendedora(l.idvendedora) nome
                     , decode(l.ativo, 'S', 'ATIVO'
                                     , 'N', 'INATIVO') ativo
                     , l.idrepresentante
                     , roman.pck_romance.fnc_nomerepresentante(l.idrepresentante) representante
                     , roman.pck_romance.fnc_nomeregiaovenda(l.idregiaovenda) regiaovenda
                     , l.pontos
                     , decode(l.spc,'S','Sim','Não') enviadospc
                     , l.ultimaatualizacao
                from logcatal.log_vendedoras l
                where l.idvendedora = :P333_IDVENDEDORA
                order by 1 desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado!
        }
        advanced {
            savedReportMappingIdentifier: 3592346816163729909
        }

        column ATIVO (
            type: plainText
            heading {
                heading: Ativo
                alignment: center
            }
            layout {
                sequence: 160
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: P
            }
        )

        column DATAALTERACAO (
            type: plainText
            heading {
                heading: Data Alteração
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: B
            }
        )

        column ENVIADOSPC (
            type: plainText
            heading {
                heading: Enviado ao SPC
                alignment: center
            }
            layout {
                sequence: 290
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AE
            }
        )

        column IDLOG (
            type: hidden
            heading {
                heading: IDLOG
            }
            layout {
                sequence: 10
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDPESSOA (
            type: plainText
            heading {
                heading: ID PESSOA
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column IDREPRESENTANTE (
            type: plainText
            heading {
                heading: Cód. Distribuidor
                alignment: center
            }
            layout {
                sequence: 250
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: AA
            }
        )

        column IDVENDEDORA (
            type: plainText
            heading {
                heading: ID Site
                alignment: center
            }
            layout {
                sequence: 230
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: Y
            }
        )

        column NOME (
            type: plainText
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 240
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: Z
            }
        )

        column PONTOS (
            type: plainText
            heading {
                heading: Pontos
                alignment: center
            }
            layout {
                sequence: 280
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: AD
            }
        )

        column REGIAOVENDA (
            type: plainText
            heading {
                heading: Região Venda
                alignment: center
            }
            layout {
                sequence: 270
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AC
            }
        )

        column REPRESENTANTE (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 260
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AB
            }
        )

        column TIPOALTERACAO (
            type: plainText
            heading {
                heading: Tipo Alteração
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column ULTIMAATUALIZACAO (
            type: plainText
            heading {
                heading: Ultima Atualização
                alignment: center
            }
            layout {
                sequence: 220
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: V
            }
        )

        column USUARIOALTERACAO (
            type: plainText
            heading {
                heading: Usuário que Alterou
                alignment: center
            }
            layout {
                sequence: 300
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AF
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 19020074 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ATIVO (
                sequence: 7
            )

            displayColumn DATAALTERACAO (
                sequence: 1
            )

            displayColumn ENVIADOSPC (
                sequence: 12
            )

            displayColumn IDREPRESENTANTE (
                sequence: 8
            )

            displayColumn IDVENDEDORA (
                sequence: 5
            )

            displayColumn NOME (
                sequence: 6
            )

            displayColumn PONTOS (
                sequence: 11
            )

            displayColumn REGIAOVENDA (
                sequence: 10
            )

            displayColumn REPRESENTANTE (
                sequence: 9
            )

            displayColumn TIPOALTERACAO (
                sequence: 3
            )

            displayColumn ULTIMAATUALIZACAO (
                sequence: 4
            )

            displayColumn USUARIOALTERACAO (
                sequence: 2
            )

        )

    )

    pageItem P333_IDVENDEDORA (
        type: popupLov
        label {
            label: Consultora
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' ('||p.cpf||') ['||/*Translate(To_Char(*/cpf/*/100 ,'000,000,000.00') ,',.' ,'.-')*/||']' display_value
                     , v.idvendedora return_value
                from pessoas p
                   , vendedoras v
                where v.idpessoa = p.idpessoa
                order by p.nomepessoa
                ```
            nullDisplayValue: - Selecione a Consultora -
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 333
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 333
                items: {
                    P333_IDVENDEDORA: &P333_IDVENDEDORA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

