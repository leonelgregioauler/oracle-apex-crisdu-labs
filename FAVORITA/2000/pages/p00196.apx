page 196 (
    name: Cadastro Permissões Tipos Protocolos
    title: Cadastro Permissões Tipos Protocolos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region permissão-tipo-de-protocolo (
        name: Permissão Tipo de Protocolo
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P196_ATENDER (
        type: selectList
        label {
            label: Atender
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-simnao
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @permissão-tipo-de-protocolo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P196_CRIAR (
        type: selectList
        label {
            label: Criar
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-simnao
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @permissão-tipo-de-protocolo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P196_IDPERMISSAOTIPOPROTOCOLO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @permissão-tipo-de-protocolo
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P196_IDTIPOPROTOCOLO (
        type: selectList
        label {
            label: Tipo de Protocolo
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.descricao display_value
                     , t.idtipoprotocolo return_value
                from tiposprotocolosatendimentos t
                order by 2
                ```
        }
        layout {
            sequence: 20
            region: @permissão-tipo-de-protocolo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P196_IDUSUARIO (
        type: selectList
        label {
            label: Usuário
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-usuarios
        }
        layout {
            sequence: 30
            region: @permissão-tipo-de-protocolo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P196_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @permissão-tipo-de-protocolo
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P196_OPERACAO_DML (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @permissão-tipo-de-protocolo
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 40
            region: @permissão-tipo-de-protocolo
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P196_IDPERMISSAOTIPOPROTOCOLO
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Fechar
        layout {
            sequence: 50
            region: @permissão-tipo-de-protocolo
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 194
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 60
            region: @permissão-tipo-de-protocolo
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P196_IDPERMISSAOTIPOPROTOCOLO
        }
    )

    button incluir (
        buttonName: INCLUIR
        label: Incluir
        layout {
            sequence: 30
            region: @permissão-tipo-de-protocolo
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNull
            item: P196_IDPERMISSAOTIPOPROTOCOLO
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 20
            region: @permissão-tipo-de-protocolo
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process consulta-permissão-tipos-protocolos (
        name: Consulta Permissão Tipos Protocolos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  #OWNER#.PCK_PROTOCOLOSATENDIMENTOS_FAV.PRC_PERMISSOESTIPOSPROTOCOLOS( PIDPERMISSAOTIPOPROTOCOLO => :P196_IDPERMISSAOTIPOPROTOCOLO
                                                                                      , PIDTIPOPROTOCOLO => :P196_IDTIPOPROTOCOLO
                                                                                      , PIDUSUARIO => :P196_IDUSUARIO
                                                                                      , PCRIAR => :P196_CRIAR
                                                                                      , PATENDER => :P196_ATENDER
                                                                                      , PMD5 => :P196_MD5
                                                                                      , POPERACAO_DML => 'S');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 241460113350058122
        }
    )

    process limpa-os-campos (
        name: Limpa os Campos
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 241459970289058120
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    process operação-dml-em-permissões-tipos-protocolos (
        name: Operação DML em Permissões TIpos Protocolos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  voperacao_dml varchar2(1);
                  --
                begin
                  --
                  if v('REQUEST') = 'ATUALIZAR' then
                    --
                    voperacao_dml := 'U';
                    --
                  elsif v('REQUEST') = 'INCLUIR' then
                    --
                    voperacao_dml := 'I';
                    --
                  elsif v('REQUEST') = 'EXCLUIR' then
                    --
                    voperacao_dml := 'D';
                    --
                  end if;
                  --
                  #OWNER#.PCK_PROTOCOLOSATENDIMENTOS_FAV.PRC_PERMISSOESTIPOSPROTOCOLOS( PIDPERMISSAOTIPOPROTOCOLO => :P196_IDPERMISSAOTIPOPROTOCOLO
                                                                                      , PIDTIPOPROTOCOLO => :P196_IDTIPOPROTOCOLO
                                                                                      , PIDUSUARIO => :P196_IDUSUARIO
                                                                                      , PCRIAR => :P196_CRIAR
                                                                                      , PATENDER => :P196_ATENDER
                                                                                      , PMD5 => :P196_MD5
                                                                                      , POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro Atualizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 241526109975661531
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('INCLUIR','ATUALIZAR','EXCLUIR')
                ```
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 194
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @cancel
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 196
                items: {
                    P196_IDPERMISSAOTIPOPROTOCOLO:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('EXCLUIR','INCLUIR')
                ```
        }
    )

    branch (
        execution {
            sequence: 30
        }
        behavior {
            target: {
                page: 196
                items: {
                    P196_IDPERMISSAOTIPOPROTOCOLO: &P196_IDPERMISSAOTIPOPROTOCOLO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

)

