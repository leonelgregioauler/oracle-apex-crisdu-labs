page 281 (
    name: Ultimas Ligações
    title: Ultimas Ligações
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 40%
        height: 70%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region tarefas (
        name: Tarefas
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region ultimas-ligações-call (
        name: Ultimas Ligações Call
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idemail
                     , t.numero
                     , t.data
                from (
                       select /*+ FIRST_ROWS(50) */ t.idticket idemail
                            , t.telefone numero
                            , t.dataligacao data                            
                       from catal.ticketscallcenter t
                       order by 3 desc ) t
                where rownum <= 100
                ```
        }
        layout {
            sequence: 10
            parentRegion: @tarefas
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 30
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column DATA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            sorting {
                sortable: false
            }
        )

        column IDEMAIL (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column NUMERO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Numero
                alignment: center
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

    )

    region ultimas-ligações-cobrança (
        name: Ultimas Ligações Cobrança
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idemail
                     , t.numero
                     , t.data
                from (
                       select /*+ FIRST_ROWS(50) */t.idticketcobranca idemail
                            , t.telefone numero
                            , t.dataligacao data
                          from roman.ticketscobranca t
                          where t.dataprocessado is not null
                          order by 3 desc ) t
                where rownum <= 100
                ```
        }
        layout {
            sequence: 20
            parentRegion: @tarefas
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 30
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column DATA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            sorting {
                sortable: false
            }
        )

        column IDEMAIL (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column NUMERO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Numero
                alignment: center
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

    )

)

