page 449 (
    name: Configuração de Produtos para Integração Virtual Age
    title: Configuração de Produtos para Integração Virtual Age
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region configuração-de-produtos-para-integração-virtual-age (
        name: Configuração de Produtos para Integração Virtual Age
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: select * from itenspedidosvirtualage;
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 62449736638476009
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDITEMPEDIDOVIRTUALAGE
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDPRODUTODETALHADO
                layout {
                    width: 434
                    sequence: 2
                }
            )

            displayColumn (
                column: @BRINDE
                layout {
                    width: 200
                    sequence: 3
                }
            )

            displayColumn (
                column: @TIPOBRINDE
                layout {
                    width: 200
                    sequence: 4
                }
            )

            displayColumn (
                column: @COMPREEGANHE
                layout {
                    width: 200
                    sequence: 5
                }
            )

            displayColumn (
                column: @TIPOCOMPREEGANHE
                layout {
                    width: 200
                    sequence: 6
                }
            )

            displayColumn (
                column: @FAVORITAPARIS
                layout {
                    width: 200
                    sequence: 7
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column BRINDE (
            type: selectList
            heading {
                heading: Brinde
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @lov-simnao
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                databaseColumn: BRINDE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column COMPREEGANHE (
            type: selectList
            heading {
                heading: Compre e Ganhe
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @lov-simnao
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                databaseColumn: COMPREEGANHE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column FAVORITAPARIS (
            type: selectList
            heading {
                heading: Favorita Paris
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @lov-simnao
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            source {
                databaseColumn: FAVORITAPARIS
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDITEMPEDIDOVIRTUALAGE (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDITEMPEDIDOVIRTUALAGE
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: SEQ_IDITEMPEDIDOVIRTUALAGE
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDPRODUTODETALHADO (
            type: popupLov
            heading {
                heading: Produto Detalhado
                alignment: center
            }
            settings {
                displayAs: modalDialog
            }
            lov {
                type: sharedComponent
                lov: @lov-produtosdetalhados
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IDPRODUTODETALHADO
                dataType: number
            }
            columnFilter {
                lovType: useLov
            }
        )

        column TIPOBRINDE (
            type: textField
            heading {
                heading: Tipo Brinde
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                databaseColumn: TIPOBRINDE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column TIPOCOMPREEGANHE (
            type: textField
            heading {
                heading: Tipo Compre e Ganhe
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                databaseColumn: TIPOCOMPREEGANHE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

    )

    process configuração-de-produtos-para-integração-virtual-age-save-interactive-grid-data (
        name: Configuração de Produtos para Integração Virtual Age - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @configuração-de-produtos-para-integração-virtual-age
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 62450793485476019
        }
    )

)

