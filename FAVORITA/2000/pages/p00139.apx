page 139 (
    name: Concluir Análise
    title: Concluir Análise
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region concluir-análise (
        name: Concluir Análise
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P139_IDCOMPRATRANSFERENCIA (
        type: selectList
        label {
            label: NR Remessa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select numero||' - '|| pck_util_fav.fnc_retornatipocomptransrem(c.idtipocomptransrem,:P0_IDIDIOMA)
                             ||'('||decode(identificacaointerna,'N','Normal','A','Antecipada','T','Pronta Entrega Tarde','M','Pronta Entrega Manhã')
                             ||') - '||decode(analiseconcluida,'S','Concluida','Em Analise') 
                             ||' Qtd Pedidos: '||nvl(( select count(1)
                                                       from pedidosremessasct p
                                                       where p.idcompratransferencia = c.idcompratransferencia ),0) 
                             ||' - '||roman.pck_romance.fnc_nomepostoavancado(c.idpostoavancadodestino) display_value
                 , idcompratransferencia return_value
                from comprastransferencias c
                where ( idfilialromancedestino = :P139_IDFILIALROMANCE
                     /*or exists ( select 1
                                 from atendimentosfiliaisrmc a
                                 where a.idfilialfavoritaorigem = c.idfilialfavoritadestino
                                   and a.idfilialdestino        = :P139_IDFILIALROMANCE ) */ )
                  and idsituacao in (0,3)
                  and nvl(analiseconcluida,'N') = 'N'
                --order by numero
                order by idsemanaentrega, identificacaointerna desc, idpostoavancadodestino desc
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P139_IDFILIALROMANCE
        }
        layout {
            sequence: 30
            region: @concluir-análise
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P139_IDFILIALROMANCE (
        type: selectList
        label {
            label: Filial Romance
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-filiaisromance
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @concluir-análise
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button concluir (
        buttonName: CONCLUIR
        label: Concluir Análise
        layout {
            sequence: 20
            region: @concluir-análise
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: "javascript:apex.confirm('Deseja realmente concluir a Análise?', { request:'ANALISECONCLUIDA'})"
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process concluir-analise (
        name: Concluir Analise
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_comprastransf_fav.prc_analiseconcluida( pidcompratransferencia => :P139_IDCOMPRATRANSFERENCIA
                                                            , pidusuario             => :P0_IDUSUARIO);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Análise Concluída com sucesso!
        }
        advanced {
            executionMappingIdentifier: 29167690064234201
        }
        serverSideCondition {
            type: request=Value
            value: ANALISECONCLUIDA
        }
    )

)

