page 468 (
    name: Anexos Saídas
    title: Anexos Saídas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 70%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function fnc_verimg(pid)
            {
              window.open('http://anexos.romancemoda.com.br/'+pid);
              void(0);
            }
            
            function fnc_removeanexo(pidanexo,pnomeanexo)
            {
                apex.confirm("Deseja realmente remover o anexo "+pnomeanexo+"?", {
              request:"DELETAR",
              set:{"P468_IDANEXODELETAR":pidanexo}
              });
            }
            ```
    }

    region anexos-despesas (
        name: Anexos Despesas
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    region arquivos-anexados (
        name: Arquivos Anexados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomearquivo
                  --   , '<a href="javascript: fnc_verimg('''||iddespesa||idanexodespesa||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10)||''');">Ver arquivo</a>' link
                     , idsaida||idanexosaida||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10) id
                     , dataanexo
                     , ( select roman.pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario ) usuario 
                     , '<a href="javascript: fnc_removeanexo('||idanexosaida||','''||t.nomearquivo||''');">Remover</a>' remover
                     , APEX_ITEM.CHECKBOX2(1, t.idanexosaida , NULL ) Visto
                     , url_bucket link
                from roman.anexossaidas t
                where idsaida = :P468_IDSAIDA
                order by t.dataanexo
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 852656853318589494
        }

        column DATAANEXO (
            type: plainText
            heading {
                heading: Data Anexo
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column ID (
            type: link
            heading {
                heading: Link
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            link {
                target: {
                    page: 357
                    items: {
                        P357_ARQUIVO: #ID#
                    }
                    action: resetPagination
                }
                linkText: Ver Arquivo
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column LINK (
            type: link
            heading {
                heading: Link
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            link {
                target: {
                    type: url
                    url: #LINK#
                }
                linkText: Ver Arquivo
                linkAttributes: target="_blank"
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column NOMEARQUIVO (
            type: plainText
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column REMOVER (
            type: plainText
            heading {
                heading: Remover
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
            security {
                escapeSpecialChars: false
            }
        )

        column USUARIO (
            type: plainText
            heading {
                heading: Usuário
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column VISTO (
            type: plainText
            heading {
                heading: Visto
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
            security {
                escapeSpecialChars: false
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 734605 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAANEXO (
                sequence: 2
            )

            displayColumn ID (
                sequence: 4
            )

            displayColumn NOMEARQUIVO (
                sequence: 1
            )

            displayColumn REMOVER (
                sequence: 6
            )

            displayColumn USUARIO (
                sequence: 5
            )

            displayColumn VISTO (
                sequence: 3
            )

        )

    )

    pageItem P468_ARQUIVOTEMP (
        type: fileUpload
        label {
            label: Arquivo
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
            displayDownloadLink: false
        }
        storage {
            filenameColumn: NOMEARQUIVO
        }
        layout {
            sequence: 40
            region: @anexos-despesas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: ARQUIVOTEMP
            used: always
        }
    )

    pageItem P468_DATAANEXO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @anexos-despesas
            slot: regionBody
        }
        appearance {
            formatMask: DD/MM/RRRR HH24:MI:SS
        }
        source {
            type: databaseColumn
            databaseColumn: DATAANEXO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  return sysdate;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P468_IDANEXODELETAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @anexos-despesas
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P468_IDANEXOSAIDA (
        type: hidden
        layout {
            sequence: 10
            region: @anexos-despesas
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDANEXOSAIDA
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P468_IDSAIDA (
        type: numberField
        label {
            label: ID Saida
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 20
            region: @anexos-despesas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 32
        }
        source {
            type: databaseColumn
            databaseColumn: IDSAIDA
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P468_IDUSUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @anexos-despesas
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDUSUARIO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidusuario number;
                begin
                  --
                  vidusuario := :P0_IDUSUARIO;
                  --
                  return vidusuario;
                  --
                end;
                  
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P468_NOMEARQUIVO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @anexos-despesas
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: NOMEARQUIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P468_PAGINA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 100
            region: @anexos-despesas
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Anexar este arquivo!
        layout {
            sequence: 90
            region: @anexos-despesas
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P468_IDANEXOSAIDA
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: "Voltar                    "
        layout {
            sequence: 50
            region: @anexos-despesas
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                t-Button--warning
                t-Button--iconRight
            ]
            icon: fa-filter
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation p468-arquivotemp (
        name: P468_ARQUIVOTEMP
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P468_ARQUIVOTEMP
        }
        error {
            errorMessage: Escolha um arquivo!
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('CREATE','UPDATE')
        }
    )

    process anexar (
        name: Anexar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  commit;
                  -- Call the procedure
                  roman.pck_anexos.blob_to_file_saidas(pidsaida => :P468_IDSAIDA
                                                      ,pidanexo => :P468_IDANEXOSAIDA);
                  commit;
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 73465241973062731
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process deletar (
        name: Deletar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  :P468_IDANEXOSAIDA := null;
                  roman.pck_anexos.prc_apagaanexo_saidas(pidanexosaida => :P468_IDANEXODELETAR);
                end;
                
                ```
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Anexo deletado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 73465683867062732
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    process fetch-row-from-anexossaidas (
        name: Fetch Row from ANEXOSSAIDAS
        type: autoRowFetch
        source {
            tableOwner: ROMAN
            tableName: ANEXOSSAIDAS
            pkColumn: IDANEXOSAIDA
            pkItem: P468_IDANEXOSAIDA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 73466029698062733
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P468_IDANEXOSAIDA is null then
                        select "ROMAN"."SEQ_IDANEXOSAIDA".nextval
                          into :P468_IDANEXOSAIDA
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 73466443068062733
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-anexossaidas (
        name: Process Row of ANEXOSSAIDAS
        type: autoRowProcessing
        target {
            tableOwner: ROMAN
            tableName: ANEXOSSAIDAS
            pkColumn: IDANEXOSAIDA
            pkItem: P468_IDANEXOSAIDA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Arquivo Anexado
        }
        advanced {
            executionMappingIdentifier: 73466831726062733
        }
    )

    branch (
        name: Go To Page 468
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 468
                items: {
                    P468_IDSAIDA: &P468_IDSAIDA.
                    P468_ARQUIVOTEMP:
                    P468_PAGINA: &P468_PAGINA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    branch (
        name: Go To Page 469
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 469
                items: {
                    P469_IDSAIDA: &P468_IDSAIDA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P468_PAGINA = 469 and v('REQUEST') = 'VOLTAR'
        }
    )

    branch (
        name: Go To Page 470
        execution {
            sequence: 30
        }
        behavior {
            target: {
                page: 470
                action: resetPagination
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P468_PAGINA = 470 and v('REQUEST') = 'VOLTAR'
        }
    )

    branch (
        execution {
            sequence: 40
        }
        behavior {
            target: {
                page: 468
                items: {
                    P468_IDANEXOSAIDA:
                    P468_IDSAIDA: &P468_IDSAIDA.
                    P468_ARQUIVOTEMP:
                    P468_PAGINA: &P468_PAGINA.
                    P468_IDANEXODELETAR:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

)

