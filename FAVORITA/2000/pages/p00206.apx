page 206 (
    name: Impressão Lista Montagem
    title: Impressão Lista Montagem
    appearance {
        pageTemplate: @minimal-pedido
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region impressão (
        name: Impressão
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_imprime_fav.prc_listapedidosmontar( pidusuario => :P206_IDUSUARIO
                                                        , pididioma  => :P0_IDIDIOMA );
                  --
                end;
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P206_IDUSUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @impressão
            slot: regionBody
        }
        source {
            type: item
            item: P0_IDUSUARIO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

)

