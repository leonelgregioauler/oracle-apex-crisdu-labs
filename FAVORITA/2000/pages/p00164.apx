    process valida-valor-pago-ao-atualizar (
        name: Valida Valor Pago ao Atualizar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vvalorpago number;
                begin
                  select valorpago
                  into vvalorpago
                  from pagamentospedidos
                  where idpagamentopedido = :P164_IDPAGAMENTOPEDIDO;
                  --
                  if (replace(:P164_VALORORIGINAL, '.', '')) > vvalorpago then
                    raise_application_error(-20001, 'Valor pago maior que devido. O valor devido Ã© R$ '||to_char(vvalorpago, '999G999G999G990D00')||'. Informe um valor menor ou igual.');
                  end if;
                  --
                end;
                ```
        }
