    dynamicAction calcula-juros (
        name: Calcula Juros
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P164_DATAPAGAMENTO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      vdatavencimento date;
                      vdatapagamento  date;
                      vvalorpagar     number(15,2); 
                      vvalorpago      number(15,2);
                      vsaldo          number(15,2);
                      --
                    begin
                      --
                      select vp.datavencimento
                           , vp.valorpagar
                           , vp.valorpago
                      into vdatavencimento
                         , vvalorpagar
                         , vvalorpago
                      from vencimentospedidos vp
                      where vp.idvencimentopedido = :P164_IDVENCIMENTOPEDIDO
                      and vp.situacaovencimento = 'V';
                      --
                      vdatapagamento := :P164_DATAPAGAMENTO;
                      --
                      if vdatavencimento < nvl(:P164_DATAPAGAMENTO, trunc(sysdate)) then
                        --
                        if (vvalorpagar - vvalorpago) > 0 then 
                          vsaldo := vvalorpagar - vvalorpago;
                        elsif :P164_IDPAGAMENTOPEDIDO is not null and (vvalorpagar - vvalorpago = 0) then
                          vsaldo := vvalorpagar;
                        end if;
                        --
                        :P164_VALORLIQUIDO := to_char(pck_util_fav.fnc_calculajuros( pidpedido           => :P164_IDPEDIDO,
                                                                                     pvalororiginal      => vsaldo,
                                                                                     pdatavencimentoorig => vdatavencimento,
                                                                                     pdatavencimentonovo => vdatapagamento,
                                                                                     ppercmulta          => 2,
                                                                                     ppercjuros          => 1), '999G999G999G990D00');                                                              
                        --
                        -- Incluir pagamento
                        if :P164_IDPAGAMENTOPEDIDO is null then          
                          :P164_JUROS := to_char(to_number(nvl(:P164_VALORLIQUIDO, 0), '999G999G999G990D00') - to_number(nvl(:P164_SALDODEVEDOR, 0), '999G999G999G990D00'), '999G999G999G990D00');
                        -- Editar pagamento
                        elsif :P164_IDPAGAMENTOPEDIDO is not null then
                          :P164_JUROS := to_char(to_number(nvl(:P164_VALORLIQUIDO, 0), '999G999G999G990D00') - to_number(nvl(vsaldo, 0), '999G999G999G990D00'), '999G999G999G990D00');
                        end if;
                        --
                        :P164_VALORLIQUIDO := to_char(to_number(nvl(:P164_VALORORIGINAL, 0), '999G999G999G990D00') + to_number(nvl(:P164_JUROS, 0), '999G999G999G990D00'), '999G999G999G990D00');
                        --
                      else
                        -- Incluir pagamento
                        if :P164_IDPAGAMENTOPEDIDO is null then
                          :P164_VALORLIQUIDO := :P164_SALDODEVEDOR;
                        -- Editar pagamento
                        elsif :P164_IDPAGAMENTOPEDIDO is not null then
                          :P164_VALORLIQUIDO := :P164_VALORORIGINAL;
                        end if;
                        --
                        :P164_JUROS    := to_char(0, '999G999G999G990D00');
                        --
                      end if;
                      --
                    end;
                            
                    ```
                itemsToSubmit: [
                    P164_IDVENCIMENTOPEDIDO
                    P164_DATAPAGAMENTO
                    P164_IDPEDIDO
                    P164_IDPAGAMENTOPEDIDO
                    P164_SALDODEVEDOR
                    P164_VALORORIGINAL
                    P164_JUROS
                    P164_VALORLIQUIDO
                ]
                itemsToReturn: [
                    P164_VALORLIQUIDO
                    P164_JUROS
                ]
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

