    process valida-valor-pago-ao-inserir (
        name: Valida valor pago ao Inserir
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vsaldo number;
                  vjuros number;
                  vdatavencimento date;
                  vvalorpagar number;
                  vidpedido number;
                begin
                  select saldo
                       , datavencimento 
                       , valorpagar
                       , idpedido
                  into vsaldo
                     , vdatavencimento
                     , vvalorpagar
                     , vidpedido
                  from vw_vencimentospedidos_fav
                  where idvencimentopedido = :P164_IDVENCIMENTOPEDIDO;
                  --
                  vjuros := ( pck_util_fav.fnc_calculajuros(pidpedido => vidpedido,
                                                            pvalororiginal => vvalorpagar,
                                                            pdatavencimentoorig => vdatavencimento,
                                                            pdatavencimentonovo => sysdate,
                                                            ppercmulta => 2,
                                                            ppercjuros => 1) - vvalorpagar );
                  --
                  if (replace(:P164_VALORORIGINAL, '.', '')) > vsaldo+vjuros then
                    raise_application_error(-20001, 'O saldo de pagamento é R$ '||to_char(vsaldo+vjuros, '999G999G999G990D00')||'. Informe um valor menor.');
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 1408381830787080297
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

