    dynamicAction consulta-origem-forma-pagamento-e-situação (
        name: Consulta Origem, Forma Pagamento e Situação
        execution {
            sequence: 120
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P164_IDPAGAMENTOPEDIDO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      vorigempagamento  varchar2(1);
                      vidformapagamento number;
                      vidsituacao       number;
                    begin
                      --
                      select pp.origempagamento
                           , pp.idformapagamento
                           , pp.idsituacao
                      into vorigempagamento
                         , vidformapagamento
                         , vidsituacao
                      from pagamentospedidos pp
                      where pp.idpagamentopedido = :P164_IDPAGAMENTOPEDIDO;
                      --
                      :P164_ORIGEMPAGAMENTO  := vorigempagamento;
                      :P164_IDFORMAPAGAMENTO := vidformapagamento;
                      :P164_IDSITUACAO       := vidsituacao;
                      --
                    end;
                       
                      
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

