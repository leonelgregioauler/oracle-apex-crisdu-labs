    process atualiza-idfilialorigem (
        name: Atualiza idfilialorigem
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidfilialorigem NUMBER;
                  --
                begin
                  --
                  begin
                    --
                    select u.idfilialfavorita
                    into vidfilialorigem
                    from usuarios u
                    where u.idusuario = :P0_IDUSUARIO;
                    --
                    exception
                      when others then
                        vidfilialorigem := null;
                    --
                  end;
                  --
                   update pagamentospedidos p
                     set p.idfilialorigem = vidfilialorigem
                  where p.idpagamentopedido = :P164_IDPAGAMENTOPEDIDO;
                  
                  --
                end;
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 1408383443142080298
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process atualiza-vencimento (
        name: Atualiza vencimento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  update vencimentospedidos v
                  set v.valorpago = nvl(( select sum(nvl(p.valorpago, 0))
                                      from pagamentospedidos p
                                      where p.idvencimentopedido = v.idvencimentopedido
                                      and p.idsituacao = 20 ), 0)
                  where v.idvencimentopedido = :P164_IDVENCIMENTOPEDIDO;
                end;
                ```
        }
