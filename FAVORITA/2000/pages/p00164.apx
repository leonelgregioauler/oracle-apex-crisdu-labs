    pageItem P164_IDUSUARIONEGOCIACAO (
        type: selectList
        label {
            label: Atendente da Negociação
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomeusuario(u.usuario) display_value
                     , idusuario return_value
                from usuarios u
                where u.idgerente = 80
                  and u.ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 110
            region: @informar-pagamento
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDUSUARIONEGOCIACAO
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuarios
                where usuario = v('APP_USER')
                  and idgerente = 80
                ```
        }
        security {
            encryptSessionState: false
        }
    )

