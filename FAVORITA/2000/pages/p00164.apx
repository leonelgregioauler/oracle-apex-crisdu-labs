    dynamicAction consulta-saldo-pagamento (
        name: Consulta Saldo Pagamento
        execution {
            sequence: 60
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      vsaldo number;
                      vvalorpago number;
                    begin
                      --
                      if :P164_PAGINAORIGEM = 119 then 
                        --
                        select saldo
                        into vsaldo
                        from vw_vencimentospedidos_fav
                        where idvencimentopedido = :P164_IDVENCIMENTOPEDIDO;
                        --
                        :P164_SALDODEVEDOR := to_char(vsaldo, '999G999G999G990D00');
                        --
                        :P164_VALORORIGINAL := to_char(vsaldo, '999G999G999G990D00');
                        --
                      else
                        -- 
                        select p.valorpago
                        into vvalorpago
                        from pagamentospedidos p
                           , vencimentospedidos v
                        where p.idvencimentopedido = v.idvencimentopedido
                        and p.idpagamentopedido = :P164_IDPAGAMENTOPEDIDO;
                        --
                        :P164_VALORORIGINAL := to_char(vvalorpago, '999G999G999G990D00');
                        --
                      end if;
                      --
                    end;
                    
                    ```
                itemsToSubmit: P164_IDVENCIMENTOPEDIDO
                itemsToReturn: [
                    P164_SALDODEVEDOR
                    P164_VALORORIGINAL
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

