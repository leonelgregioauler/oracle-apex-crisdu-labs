    )

    process inclui-data-baixa (
        name: Inclui Data Baixa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  situacaobd number;
                  --
                begin
                  --
                  select pp.idsituacao
                  into situacaobd
                  from favorita.pagamentospedidos pp
                  where pp.idpagamentopedido = :P164_IDPAGAMENTOPEDIDO;
                  --
                  --
                  if situacaobd != 20 and :P164_IDSITUACAO = 20 then
                    --
                    :P164_DATABAIXA := sysdate;
                  else
                    :P164_DATABAIXA := null;
                  end if;
                  --
                end;
                ```
