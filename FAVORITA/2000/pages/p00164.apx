    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P164_IDPAGAMENTOPEDIDO is null then
                        select "#OWNER#"."SEQ_IDPAGAMENTOPEDIDO".nextval
                          into :P164_IDPAGAMENTOPEDIDO
                          from sys.dual;
                    end if;
                    --
                    IF :P164_IDFORMAPAGAMENTO = 2 AND :P164_IDSITUACAO = 20 AND :P0_IDFILIALFAVORITA in (5,7,31,37) then
                      --
                      select max(idfechamento)
                      into :P164_IDFECHAMENTO
                      from roman.fechamentossemanais f
                      where f.idfilialfavorita = :P0_IDFILIALFAVORITA
                        and f.concluido = 'N';
                      --
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
