    pageItem P164_IDFORMAPAGAMENTO (
        type: selectList
        label {
            label: Forma do Pagamento
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct 
                       pp.formapagamento as d
                     , pp.idformapagamento as r
                from pagamentospedidos p 
                   , vw_perfispagamentos_fav pp
                where p.origempagamento(+)  = pp.origempagamento 
                   and p.idformapagamento(+) = pp.idformapagamento
                   and p.idsituacao(+)       = pp.idsituacaopagamentoped
                   and pck_util_fav.fnc_verificaacesso(28610,:P0_IDUSUARIO) = 'S'
                union
                select distinct 
                       pp.formapagamento as d
                     , pp.idformapagamento as r
                from pagamentospedidos p 
                   , vw_perfispagamentos_fav pp
                where p.origempagamento(+)  = pp.origempagamento 
                   and p.idformapagamento(+) = pp.idformapagamento
                   and p.idsituacao(+)       = pp.idsituacaopagamentoped
                   and pp.idgrupoatendimento = :P164_IDGRUPOATENDIMENTO
                union
                select distinct 
                       pp.formapagamento as d
                     , pp.idformapagamento as r
                from pagamentospedidos p 
                   , vw_perfispagamentos_fav pp
                where p.origempagamento(+)  = pp.origempagamento 
                   and p.idformapagamento(+) = pp.idformapagamento
                   and p.idsituacao(+)       = pp.idsituacaopagamentoped
                   and p.idpagamentopedido   = :P164_IDPAGAMENTOPEDIDO 
                
                ```
            nullDisplayValue: - Selecione a Forma de Pagamento -
        }
        cascadingLov {
            parentItems: P164_IDGRUPOATENDIMENTO
            itemsToSubmit: P164_IDGRUPOATENDIMENTO
        }
        layout {
            sequence: 70
            region: @informar-pagamento
            slot: regionBody
            alignment: left
            columnSpan: 7
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFORMAPAGAMENTO
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from perfispagamentos
                where origempagamento      = :P164_ORIGEMPAGAMENTO
                and idformapagamento       = :P164_IDFORMAPAGAMENTO
                and idsituacaopagamentoped = :P164_IDSITUACAO
                or :P164_IDPAGAMENTOPEDIDO is null
                ```
        }
        readOnly {
            type: itemIsNotNull
            item: P164_IDPAGAMENTOPEDIDO
        }
        security {
            encryptSessionState: false
        }
    )

