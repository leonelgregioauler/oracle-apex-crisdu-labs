    pageItem P164_IDCONTABANCARIA (
        type: selectList
        label {
            label: Conta Bancária
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.beneficiario||' ('||b.nomebanco||' - Ag: '||c.agencia||'- CC: '||c.conta||')' d
                     , c.idcontabanc r
                from roman.contasbancarias c
                   , roman.bancos b
                where b.idbanco = c.idbanco
                  and c.ativo = 'S'
                  and c.usosetorcobranca = 'S'
                order by 1;
                ```
            nullDisplayValue: - Selecione a Conta -
        }
        layout {
            sequence: 90
            region: @informar-pagamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDCONTABANCARIA
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from vw_perfispagamentos_fav
                where origempagamento      = :P164_ORIGEMPAGAMENTO
                and idformapagamento       = :P164_IDFORMAPAGAMENTO
                and idsituacaopagamentoped = :P164_IDSITUACAO
                or :P164_IDPAGAMENTOPEDIDO is null
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P164_IDFECHAMENTO (
