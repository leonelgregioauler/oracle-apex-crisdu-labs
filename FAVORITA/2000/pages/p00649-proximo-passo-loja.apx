page 649 (
    name: Proximo Passo Loja
    alias: PROXIMO-PASSO-LOJA
    title: Proximo Passo Loja
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }

    region botões (
        name: Botões
        type: staticContent
        layout {
            sequence: 50
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region classificação-do-pedido (
        name: Classificação do Pedido
        type: staticContent
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
    )

    region dados-do-pedido (
        name: Dados do Pedido
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
    )

    pageItem P649_CLASSIFICACAO (
        type: selectOne
        label {
            label: <b>Feito Por / Entregue Por</b>
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Consultora / Em mãos' as display_value, 'CM' as return_values
                  from dual
                union
                select 'Distribuidor / Distribuidor' as display_value, 'DD' as return_values
                  from dual
                union
                select 'Loja / Distribuidor' as display_value, 'LD' as return_values
                  from dual
                union
                select 'Loja / Delivery' as display_value, 'LDD' as return_values
                  from dual
                union
                select 'Loja / Em mãos' as display_value, 'LE' as return_values
                  from dual
                union
                select 'Distribuidor / Sem acerto' as display_value, 'DS' as return_values
                  from dual
                union
                select 'Consultora / Sem acerto' as display_value, 'CS' as return_values
                  from dual
                union
                select 'Pedido Feito Pela Consultora (Antigo)' as display_value, 'CA' as return_values
                  from dual
                union
                select 'Pedido Feito Pelo Distribuidor (Antigo)' as display_value, 'CD' as return_values
                  from dual
                union
                select 'Consultora / Delivery' as display_value, 'CY' as return_values
                  from dual
                union
                select 'Consumidor Final / Em Mãos' as display_value, 'CFM' as return_values
                  from dual
                 
                 
                 
                 --Olá, pequeno gafanhoto!!
                
                --Caso algum dos valores abaixo seja alterado ou adicionado um novo, lembre de alterar também a
                -->>>>favorita.pck_util_fav.fnc_obter_forma_entrega_pedido.
                
                
                 
                 
                
                
                
                
                ```
        }
        layout {
            sequence: 10
            region: @classificação-do-pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P649_DATAENTREGA (
        type: datePicker
        label {
            label: <b>Data de Entrega</b>
            alignment: left
        }
        layout {
            sequence: 20
            region: @dados-do-pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 20
        }
        validation {
            valueRequired: true
        }
        source {
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vdata date;
                begin
                  --
                  vdata := pck_util_fav.fnc_retornadataatendimento(:P649_IDVENDEDORA);
                  --
                  return(vdata);
                  --
                exception 
                  when others then
                    --
                    return('');
                    --
                end;
                ```
        }
    )

    pageItem P649_IDFILIALFAVORITA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @dados-do-pedido
            slot: regionBody
        }
    )

    pageItem P649_IDPEDIDO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @dados-do-pedido
            slot: regionBody
        }
    )

    pageItem P649_IDUSUARIO_PEDIDO (
        type: selectOne
        label {
            label: Atendente do Pedido
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(pe.nomepessoa) d,
                       u.idusuario r
                from usuarios u,
                     pessoas pe
                where u.idpessoa = pe.idpessoa
                and exists (select 1
                           from filiaisfavorita f
                           where f.idfilialfavorita = u.idfilialfavorita
                           and f.tipofilial = 'L')
                and u.ativo = 'S'
                and u.idfilialfavorita = :P0_IDFILIALFAVORITA
                --and u.idusuario != :P0_IDUSUARIO -- comentado no ticket 8892923
                and :P649_IDFILIALFAVORITA is null
                union
                select initcap(pe.nomepessoa) d,
                       u.idusuario r
                from usuarios u,
                     pessoas pe
                where u.idpessoa = pe.idpessoa
                and exists (select 1
                           from filiaisfavorita f
                           where f.idfilialfavorita = u.idfilialfavorita
                           and f.tipofilial = 'L')
                and u.idfilialfavorita = :P649_IDFILIALFAVORITA
                and u.idusuario != :P0_IDUSUARIO
                and u.ativo = 'S'
                and :P649_IDFILIALFAVORITA is not null
                
                ```
        }
        cascadingLov {
            parentItems: [
                P649_IDFILIALFAVORITA
                P0_IDFILIALFAVORITA
            ]
        }
        layout {
            sequence: 10
            region: @dados-do-pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        default {
            type: item
            item: P0_IDUSUARIO
        }
    )

    pageItem P649_IDVENDEDORA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @dados-do-pedido
            slot: regionBody
        }
    )

    button iniciarpedido (
        buttonName: INICIARPEDIDO
        label: Iniciar Pedido
        layout {
            sequence: 10
            region: @botões
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction dist-sem-data-de-acerto (
        name: Dist/Sem data de Acerto
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P649_CLASSIFICACAO
        }
        clientSideCondition {
            type: item=value
            item: P649_CLASSIFICACAO
            value: DS
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: to_char(trunc(sysdate),'DD/MM/RRRR')
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P649_DATAENTREGA
            }
            execution {
                sequence: 10
            }
        )

    )

    process inicia-pedido (
        name: Inicia Pedido
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  vidiniciaprepedido            number := :P649_IDPEDIDO;
                  vidpedido                     number := null;
                  vdataclassificado             date := sysdate;
                  vidfilialfavorita             number := :P0_IDFILIALFAVORITA;
                  vidfilialfavoritaorig         number := :P0_IDFILIALFAVORITA;
                  vidvendedora                  number;
                  vidusuario                    number := :P0_IDUSUARIO;
                  vnumeroposicaoatendimento     varchar2(10);
                  vtipopedido                   varchar2(1);
                  vidusuariodigitou             number := :P649_IDUSUARIO_PEDIDO;
                  vidconsumidorfinal            number;
                  --
                begin
                  --
                  begin
                    --
                    select emp.idconsumidorfinalbrasil
                    into vidconsumidorfinal
                    from empresasvirtualage emp
                       , filiaisfavorita ff
                    where ff.idfilialfavorita = vidfilialfavorita
                      and ff.idempresavirtualage = emp.idempresavirtualage;
                  exception
                    when others then
                      vidconsumidorfinal := null;
                  end;
                  --
                  pck_pedidos_fav.prc_iniciaprepedido( vidiniciaprepedido
                                                     , vidfilialfavorita
                                                     , vidvendedora
                                                     , vidusuariodigitou
                                                     , vnumeroposicaoatendimento
                                                     , vtipopedido
                                                     , :P649_DATAENTREGA
                                                     , vidusuariodigitou
                                                     , vidfilialfavoritaorig
                                                     , 'U' );
                  --
                  if :P649_CLASSIFICACAO = 'CM' then -- Consultora / Em mãos
                    --
                    null;
                    --
                  elsif :P649_CLASSIFICACAO = 'DD' then -- Distribuidor / Distribuidor
                    --
                    pck_pedidos_fav.prc_iniciapreclassificacoes ( vidiniciaprepedido
                                                                , vidpedido
                                                                , :P0_IDUSUARIO
                                                                , vdataclassificado
                                                                , 2
                                                                , null
                                                                , 'I' );  
                    --
                    pck_pedidos_fav.prc_iniciapreclassificacoes ( vidiniciaprepedido
                                                                , vidpedido
                                                                , :P0_IDUSUARIO
                                                                , vdataclassificado
                                                                , 32
                                                                , null
                                                                , 'I' );
                    --
                  elsif :P649_CLASSIFICACAO = 'LD' then -- Loja / Distribuidor
                    --
                    pck_pedidos_fav.prc_iniciapreclassificacoes ( vidiniciaprepedido
                                                                , vidpedido
                                                                , :P0_IDUSUARIO
                                                                , vdataclassificado
                                                                , 109
                                                                , null
                                                                , 'I' );  
                    --
                    pck_pedidos_fav.prc_iniciapreclassificacoes ( vidiniciaprepedido
                                                                , vidpedido
                                                                , :P0_IDUSUARIO
                                                                , vdataclassificado
                                                                , 32
                                                                , null
                                                                , 'I' );
                    --
                  elsif :P649_CLASSIFICACAO = 'LDD' then -- Loja / Delivery
                    --
                    pck_pedidos_fav.prc_iniciapreclassificacoes ( vidiniciaprepedido
                                                                , vidpedido
                                                                , :P0_IDUSUARIO
                                                                , vdataclassificado
                                                                , 109
                                                                , null
                                                                , 'I' );  
                    --
                    pck_pedidos_fav.prc_iniciapreclassificacoes ( vidiniciaprepedido
                                                                , vidpedido
                                                                , :P0_IDUSUARIO
                                                                , vdataclassificado
                                                                , 110
                                                                , null
                                                                , 'I' );
                    --
                  elsif :P649_CLASSIFICACAO = 'LE' then -- Loja / Em mãos
                    --
                    pck_pedidos_fav.prc_iniciapreclassificacoes ( vidiniciaprepedido
                                                                , vidpedido
                                                                , :P0_IDUSUARIO
                                                                , vdataclassificado
                                                                , 109
                                                                , null
                                                                , 'I' );  
                    --
                  elsif :P649_CLASSIFICACAO = 'DS' then -- Distribuidor / Sem acerto
                    --
                    pck_pedidos_fav.prc_iniciapreclassificacoes ( vidiniciaprepedido
                                                                , vidpedido
                                                                , :P0_IDUSUARIO
                                                                , vdataclassificado
                                                                , 2
                                                                , null
                                                                , 'I' );  
                    --
                    pck_pedidos_fav.prc_iniciapreclassificacoes ( vidiniciaprepedido
                                                                , vidpedido
                                                                , :P0_IDUSUARIO
                                                                , vdataclassificado
                                                                , 32
                                                                , null
                                                                , 'I' );
                    --
                    pck_pedidos_fav.prc_iniciapreclassificacoes ( vidiniciaprepedido
                                                                , vidpedido
                                                                , :P0_IDUSUARIO
                                                                , vdataclassificado
                                                                , 112
                                                                , null
                                                                , 'I' );
                    --
                  elsif :P649_CLASSIFICACAO = 'CS' then -- Consultora / Sem acerto
                    --
                    pck_pedidos_fav.prc_iniciapreclassificacoes ( vidiniciaprepedido
                                                                , vidpedido
                                                                , :P0_IDUSUARIO
                                                                , vdataclassificado
                                                                , 32
                                                                , null
                                                                , 'I' );
                    --
                    pck_pedidos_fav.prc_iniciapreclassificacoes ( vidiniciaprepedido
                                                                , vidpedido
                                                                , :P0_IDUSUARIO
                                                                , vdataclassificado
                                                                , 112
                                                                , null
                                                                , 'I' );
                    --
                  elsif :P649_CLASSIFICACAO = 'CD' then -- Pedido Feito Pelo Distribuidor (Antigo)
                    --
                    pck_pedidos_fav.prc_iniciapreclassificacoes ( vidiniciaprepedido
                                                                , vidpedido
                                                                , :P0_IDUSUARIO
                                                                , vdataclassificado
                                                                , 2
                                                                , null
                                                                , 'I' );  
                    --
                  elsif :P649_CLASSIFICACAO = 'CY' then -- Consultora / Delivery
                    --
                    pck_pedidos_fav.prc_iniciapreclassificacoes ( vidiniciaprepedido
                                                                , vidpedido
                                                                , :P0_IDUSUARIO
                                                                , vdataclassificado
                                                                , 110
                                                                , null
                                                                , 'I' );  
                    --
                  end if;
                  --
                  if vidconsumidorfinal is not null and :P649_IDVENDEDORA = 2363887 then
                    --
                    pck_pedidos_fav.prc_iniciapreclassificacoes ( vidiniciaprepedido
                                                                , vidpedido
                                                                , :P0_IDUSUARIO
                                                                , vdataclassificado
                                                                , 115
                                                                , vidconsumidorfinal
                                                                , 'I' );  
                    --
                  end if;
                  --
                  pck_pedidos_fav.prc_iniciapedido ( :P649_IDPEDIDO
                                                   , 'I'  );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Pedido Iniciado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 52599555030184329
        }
        serverSideCondition {
            type: request=Value
            value: INICIARPEDIDO
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 68
                items: {
                    P68_IDPEDIDO: &P649_IDPEDIDO.
                }
            }
        }
    )

)

