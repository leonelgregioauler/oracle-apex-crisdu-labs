        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomevendedora(idvendedora) display_value
                     , idvendedora return_value
                from vendedoras v
                where ( :P220_IDREPRESENTANTE is null or v.idrepresentante = :P220_IDREPRESENTANTE )
                order by 1
                ```
            nullDisplayValue: - Selecione a Consultora -
        }
        cascadingLov {
            parentItems: P220_IDREPRESENTANTE
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
