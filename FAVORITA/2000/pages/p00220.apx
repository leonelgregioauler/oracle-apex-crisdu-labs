page 220 (
    name: Débitos Distribuidores
    title: Débitos Distribuidores
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region débitos-distribuidores (
        name: Débitos Distribuidores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.numeropedido
                     , p.filialromance
                     , p.representante
                     , p.vendedora
                     , p.dataemissao
                     , p.dataentrega
                     , p.datavencimentomenor
                     , p.situacaoentrega
                     , p.situacaopagamento
                     , p.situacaovencimento
                     , nvl(p.valorapagar,0) valorapagar
                     , nvl(p.valorpago,0) valorpago
                from vw_pedidos_fav p
                where p.ididioma = 1
                  and ( :P220_IDFILIALROMANCE is null or p.idfilialromance = :P220_IDFILIALROMANCE )
                  and ( :P220_IDREPRESENTANTE is null or p.idrepresentante = :P220_IDREPRESENTANTE )
                  and ( :P220_IDVENDEDORA is null or p.idvendedora = :P220_IDVENDEDORA )
                  and ( :P220_DATAINICIAL is null or exists ( select 1
                                                              from vencimentospedidos v
                                                              where v.situacaovencimento = 'V'
                                                                and v.idpedido           = p.idpedido 
                                                                and v.datavencimento between to_date(:P220_DATAINICIAL,'DD/MM/RRRR') and to_date(:P220_DATAFIM,'DD/MM/RRRR') ) )
                  and ( :P220_PAGO_AO_DISTRIBUIDOR = 'N' or exists ( select 1
                                                                     from classificacoespedidos c
                                                                     where c.idpedido = p.idpedido
                                                                       and c.idcaracteristicapedido = 40 ) )
                  and ( :P220_PEDIDO_NAO_ENTREGUE = 'N' or exists  ( select 1
                                                                     from classificacoespedidos c
                                                                     where c.idpedido = p.idpedido
                                                                       and c.idcaracteristicapedido = 39 ) )
                  and ( :P220_DIST_RESPONSABILIZOU = 'N' or exists ( select 1
                                                                     from classificacoespedidos c
                                                                     where c.idpedido = p.idpedido
                                                                       and c.idcaracteristicapedido = 41 ) )                                                 
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 478268033420228440
        }

