    pageItem P220_IDFILIALROMANCE (
        type: popupLov
        label {
            label: FIlial Romance
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome display_value
                     , f.idfilial return_value
                from roman.vw_filiais f
                where f.tipofilial = 'D'
                order by 1
                ```
            nullDisplayValue: - Selecione a Filial -
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P220_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(r.idrepresentante)
                       ||' - '||decode(r.ativo,'S','Ativo','N','Inativo') display_value
                     , r.idrepresentante return_value
                from representantes r
                where ( :P220_IDFILIALROMANCE is null or r.idgerente = ( select idgerente 
                                                                         from gerentes 
                                                                         where idfilial = :P220_IDFILIALROMANCE ) )
                order by 1 
                ```
            nullDisplayValue: - Selecione o Distribuidor -
        }
        cascadingLov {
            parentItems: P220_IDFILIALROMANCE
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P220_IDVENDEDORA (
        type: popupLov
