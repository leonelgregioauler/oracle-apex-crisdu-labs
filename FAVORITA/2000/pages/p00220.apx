    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 220
                items: {
                    P220_IDFILIALROMANCE: &P220_IDFILIALROMANCE.
                    P220_IDREPRESENTANTE: &P220_IDREPRESENTANTE.
                    P220_IDVENDEDORA: &P220_IDVENDEDORA.
                    P220_PAGO_AO_DISTRIBUIDOR: &P220_PAGO_AO_DISTRIBUIDOR.
                    P220_PEDIDO_NAO_ENTREGUE: &P220_PEDIDO_NAO_ENTREGUE.
                    P220_DIST_RESPONSABILIZOU: &P220_DIST_RESPONSABILIZOU.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

