    region pedidos-cancelados-pela-análise (
        name: Pedidos Cancelados Pela Análise
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idprotocoloatendimento
                     , p.usuariosolicitou
                     , p.idusuariosolicitou
                     , p.usuarioatendeu
                     , p.idusuarioatendeu
                     , p.tipoprotocolo "Tipo Protocolo"
                     , p.idmotivoprotocolo
                     , p.observacaointerna
                     , p.justificativa
                     , p.dataprotocolo
                     , p.dataatendimento
                     , p.idpedido
                     , p.motivoprotocolo
                from favorita.vw_protocolosatendimentos_fav p
                where p.observacaointerna = 'Pedido cancelado pela Analise de Credito, verifique o pedido.'
                  and p.idtipoprotocolo = 1
                  and (:P390_IDPEDIDO is null or :P390_IDPEDIDO = p.idpedido)
                  and (:P390_IDPROTOCOLO is null or :P390_IDPROTOCOLO = p.idprotocoloatendimento) 
                  and exists ( select 1
                               from favorita.classificacoespedidos cp
                               where cp.idpedido = p.idpedido
                                 and cp.idcaracteristicapedido = 25)
                  and ((:P390_DATAINICIO is null and :P390_DATAFIM  is null )
                       or (trunc(p.dataprotocolo) between to_date(:P390_DATAINICIO,'dd/mm/rrrr') and  to_date(:P390_DATAFIM,'dd/mm/rrrr'))) 
                  and :P390_TIPO_RELATORIO = 1
                  and ( :P390_FATURADO = 0
                        or ( :P390_FATURADO = 1 and exists ( select 1
                                                             from favorita.classificacoespedidos cp
                                                             where cp.idpedido = p.idpedido
                                                               and cp.idcaracteristicapedido = 48))
                        or ( :P390_FATURADO = 2 and not exists ( select 1
                                                                 from favorita.classificacoespedidos cp
                                                                 where cp.idpedido = p.idpedido
                                                                   and cp.idcaracteristicapedido = 48)))
                  and ( :P390_CARRINHO_ABANDONADO = 0
                        or ( :P390_CARRINHO_ABANDONADO = 1 and exists ( select 1
                                                                        from favorita.pedidos cp
                                                                        where cp.idpedido = p.idpedido
                                                                          and cp.idsituacaoentrega = 50))
                        or ( :P390_CARRINHO_ABANDONADO = 2 and exists ( select 1
                                                                        from favorita.pedidos cp
                                                                        where cp.idpedido = p.idpedido
                                                                          and cp.idsituacaoentrega != 50)))
                  and ( :P390_EMISSAO is null or p.idorigem = :P390_EMISSAO )
                  -- 10037258 >
                  and ( :P390_TIPOSVENDAS = 'T'
                        or ( :P390_TIPOSVENDAS = 'A' and exists ( select 1 
                                                                from favorita.classificacoespedidos c
                                                                where c.idpedido = p.idpedido
                                                                  and c.idcaracteristicapedido = 78 ))
                        or ( :P390_TIPOSVENDAS = 'P' and exists ( select 1 
                                                                from favorita.classificacoespedidos c
                                                                where c.idpedido = p.idpedido
                                                                  and c.idcaracteristicapedido = 74 ))
                        or ( :P390_TIPOSVENDAS = 'AP' and exists ( select 1 
                                                                from favorita.classificacoespedidos c
                                                                where c.idpedido = p.idpedido
                                                                  and c.idcaracteristicapedido in (74, 78) )))
                  -- 10037258 />
                   
                
                  
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
