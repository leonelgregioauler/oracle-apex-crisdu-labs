    region pedidos-cancelados-resumidos (
        name: Pedidos Cancelados Resumidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.usuariosolicitou
                     , p.idusuariosolicitou
                     , p.usuarioatendeu
                     , p.idusuarioatendeu
                     , p.tipoprotocolo "Tipo Protocolo"
                     , p.idmotivoprotocolo
                     , f.dataemissao
                     , f.filialromance
                     , f.filialfavorita
                     , f.vendedora
                     , f.representante
                     , count(1)
                from favorita.vw_protocolosatendimentos_fav p
                   , favorita.vw_pedidos_fav f
                where p.idpedido = f.idpedido 
                  and p.idtipoprotocolo = 1
                  and f.ididioma = 1
                  and exists ( select 1
                               from favorita.classificacoespedidos cp
                               where cp.idpedido = f.idpedido
                                 and cp.idpedido = p.idpedido
                                 and f.idpedido  = p.idpedido
                                 and cp.idcaracteristicapedido = 25)
                  and (:P390_IDPEDIDO is null or :P390_IDPEDIDO = p.idpedido)
                  and (:P390_IDPROTOCOLO is null or :P390_IDPROTOCOLO = p.idprotocoloatendimento) 
                  and ((:P390_DATAINICIO is null and :P390_DATAFIM  is null )
                       or (trunc(p.dataprotocolo) between to_date(:P390_DATAINICIO,'dd/mm/rrrr') and  to_date(:P390_DATAFIM,'dd/mm/rrrr'))) 
                  and ( :P390_FATURADO = 0
                        or ( :P390_FATURADO = 1 and exists ( select 1
                                                             from favorita.classificacoespedidos cp
                                                             where cp.idpedido = f.idpedido
                                                               and cp.idpedido = p.idpedido
                                                               and f.idpedido  = p.idpedido
                                                               and cp.idcaracteristicapedido = 48))
                        or ( :P390_FATURADO = 2 and not exists ( select 1
                                                                 from favorita.classificacoespedidos cp
                                                                 where cp.idpedido = f.idpedido
                                                                   and cp.idpedido = p.idpedido
                                                                   and f.idpedido  = p.idpedido
                                                                   and cp.idcaracteristicapedido = 48)))
                  and ( :P390_CARRINHO_ABANDONADO = 0
                        or ( :P390_CARRINHO_ABANDONADO = 1 and f.idsituacaoentrega = 50)
                        or ( :P390_CARRINHO_ABANDONADO = 2 and f.idsituacaoentrega != 50))
                  and :P390_TIPO_RELATORIO = 3
                  and ( :P390_EMISSAO is null or f.idfilialfavorita = :P390_EMISSAO )
                  and ( :P390_TIPOSVENDAS = 'T'
                        or ( :P390_TIPOSVENDAS = 'A' and exists ( select 1 
                                                                from favorita.classificacoespedidos c
                                                                where c.idpedido = p.idpedido
                                                                  and c.idcaracteristicapedido = 78 ))
                        or ( :P390_TIPOSVENDAS = 'P' and exists ( select 1 
                                                                from favorita.classificacoespedidos c
                                                                where c.idpedido = p.idpedido
                                                                  and c.idcaracteristicapedido = 74 ))
                        or ( :P390_TIPOSVENDAS = 'AP' and exists ( select 1 
                                                                from favorita.classificacoespedidos c
                                                                where c.idpedido = p.idpedido
                                                                  and c.idcaracteristicapedido in (74, 78) )))
                group by p.usuariosolicitou, p.idusuariosolicitou, p.usuarioatendeu, p.idusuarioatendeu, p.tipoprotocolo, p.idmotivoprotocolo, f.dataemissao, f.filialromance, f.filialfavorita, f.vendedora, f.representante,p.numeropedido
                order by filialromance,representante,vendedora
                ```
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P390_TIPO_RELATORIO = 3
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
