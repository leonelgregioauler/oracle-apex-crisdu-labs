page 156 (
    name: Gerar Estoques
    title: Gerar Estoques
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 40%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region gerar-estoques (
        name: Gerar Estoques
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P156_BUSCADOESTOQUEABASTECEDOR (
        type: selectList
        label {
            label: Buscar do Estoque Abastecedor
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-simnao
            nullDisplayValue: - Selecione -
        }
        layout {
            sequence: 20
            region: @gerar-estoques
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P156_PERMITEVENDERNEGATIVO (
        type: selectList
        label {
            label: Permite Vender Negativo
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-simnao
            nullDisplayValue: - Selecione -
        }
        layout {
            sequence: 10
            region: @gerar-estoques
            slot: regionBody
            alignment: left
            column: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 10
            region: @gerar-estoques
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 96
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button gerarestoques (
        buttonName: GERARESTOQUES
        label: Gerar Estoques
        layout {
            sequence: 20
            region: @gerar-estoques
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-truck
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation buscaestoqueabastecedor-obrigatório (
        name: BUSCAESTOQUEABASTECEDOR obrigatório
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P156_BUSCADOESTOQUEABASTECEDOR
        }
        error {
            errorMessage: Buscar do estoque abastecedor deve ter uma informação.
            associatedItem: @P156_BUSCADOESTOQUEABASTECEDOR
        }
    )

    validation permitevendernegativo-obrigatório (
        name: PERMITEVENDERNEGATIVO obrigatório
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P156_PERMITEVENDERNEGATIVO
        }
        error {
            errorMessage: Permite vender negativo deve ter uma informação.
            associatedItem: @P156_PERMITEVENDERNEGATIVO
        }
    )

    process gerar-estoques (
        name: Gerar Estoques
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  pck_estoque_fav.prc_geraestoques ( :P156_PERMITEVENDERNEGATIVO
                                                   , :P156_BUSCADOESTOQUEABASTECEDOR );
                end;                                    
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Estoque gerado para os produtos cadastrados em todas as filiais.
        }
        advanced {
            executionMappingIdentifier: 55746786486147211
        }
        serverSideCondition {
            whenButtonPressed: @gerarestoques
        }
    )

)

