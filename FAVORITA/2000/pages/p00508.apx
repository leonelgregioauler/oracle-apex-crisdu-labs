page 508 (
    name: Cadastro de ESPECIE
    title: Cadastro de ESPECIE
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-de-especie (
        name: Cadastro de Especie
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ee.idespecie,
                       ee.tipoespecie,
                       ee.descricao
                from favorita.especie ee
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 116830578399667842
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDESPECIE
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @TIPOESPECIE
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @DESCRICAO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column DESCRICAO (
            type: textarea
            heading {
                heading: Descrição
            }
            layout {
                sequence: 60
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: DESCRICAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column IDESPECIE (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IDESPECIE
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column TIPOESPECIE (
            type: textField
            heading {
                heading: Tipo Espécie
            }
            layout {
                sequence: 50
            }
            appearance {
                width: 3
            }
            validation {
                valueRequired: true
                maxLength: 3
            }
            source {
                databaseColumn: TIPOESPECIE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

    )

    region mensagem-retorno (
        name: Mensagem Retorno
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P508_RESPOSTA
        }
    )

    pageItem P508_RESPOSTA (
        type: textField
        label {
            label: Resposta
            alignment: left
        }
        layout {
            sequence: 10
            region: @mensagem-retorno
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    process operacao-dml (
        name: OPERACAO_DML
        type: executeCode
        editableRegion: @cadastro-de-especie
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vmd5   varchar(4000);
                  vdml   varchar(2);
                  vmensagemerro varchar(4000);
                  --
                begin  
                     --
                     :P508_RESPOSTA := '';
                     --
                     case :APEX$ROW_STATUS  
                     when 'C' then
                       --
                       PCK_CADASTROS_FAV.prc_especie ( pidespecie    => :IDESPECIE
                                                     , ptipoespecie  => :TIPOESPECIE
                                                     , pdescricao    => :DESCRICAO
                                                     , pmd5          => vmd5
                                                     , poperacao_dml => 'I'
                                                     , pmensagemerro => vmensagemerro);
                       --
                     when 'U' then  
                       --
                       PCK_CADASTROS_FAV.prc_especie ( pidespecie    => :IDESPECIE
                                                     , ptipoespecie  => :TIPOESPECIE
                                                     , pdescricao    => :DESCRICAO
                                                     , pmd5          => vmd5
                                                     , poperacao_dml => 'U'
                                                     , pmensagemerro => vmensagemerro);
                       --
                     when 'D' then  
                       --
                       PCK_CADASTROS_FAV.prc_especie ( pidespecie    => :IDESPECIE
                                                     , ptipoespecie  => :TIPOESPECIE
                                                     , pdescricao    => :DESCRICAO
                                                     , pmd5          => vmd5
                                                     , poperacao_dml => 'D'
                                                     , pmensagemerro => vmensagemerro);
                       --
                     end case;  
                     --
                     :P508_RESPOSTA := vmensagemerro;
                     --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 116831367863667850
        }
    )

)

