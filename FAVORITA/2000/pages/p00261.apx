page 261 (
    name: Relatório de Depósitos da Favorita
    title: Relatório de Depósitos da Favorita
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region depósitos (
        name: Depósitos
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region depósitos-favorita (
        name: Depósitos Favorita
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.iddepositofavorita 
                     , f.idfechamento
                     , f.semana
                     , f.datadeposito
                     , f.numerocomprovante
                     , f.valordeposito
                     , f.idusuario
                     , f.nomeusuario 
                     , nvl((select count(1)
                            from roman.anexosdepositos ad
                            where ad.iddeposito = f.iddepositofavorita),0) qtdanexo
                     , nvl(f.valordeposito*ff.fatorconversao,0) valorpagoconversao
                     , 'X' origem
                from vw_depositosfavorita_fav f
                   , roman.vw_filiais ff
                   , roman.fechamentossemanais s
                where s.idfechamento = f.idfechamento
                  and s.idfilial = ff.idfilial
                  and ( :P0_IDFECHAMENTO = 999999999999 or f.idfechamento = :P0_IDFECHAMENTO )
                  and f.idfilialfavorita = :P0_IDFILIALCAIXA 
                order by 2 desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 277
                items: {
                    P277_IDDEPOSITOFAVORITA: #IDDEPOSITOFAVORITA#
                }
                action: resetPagination
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhum depósito encontrado!
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
        }
        advanced {
            savedReportMappingIdentifier: 4421491378409602191
        }
        description {
            description: alterado o atributo para 10000
        }

        column DATADEPOSITO (
            type: plainText
            heading {
                heading: Data do Depósito
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        column IDDEPOSITOFAVORITA (
            type: hidden
            heading {
                heading: Iddepositofavorita
            }
            layout {
                sequence: 10
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDFECHAMENTO (
            type: hidden
            heading {
                heading: Idfechamento
            }
            layout {
                sequence: 20
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDUSUARIO (
            type: hidden
            heading {
                heading: Idusuario
            }
            layout {
                sequence: 80
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NOMEUSUARIO (
            type: plainText
            heading {
                heading: Usuário
                alignment: center
            }
            layout {
                sequence: 90
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column NUMEROCOMPROVANTE (
            type: plainText
            heading {
                heading: Nr Comprovante
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column ORIGEM (
            type: hidden
            heading {
                heading: Origem
            }
            layout {
                sequence: 110
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: K
            }
            security {
                escapeSpecialChars: false
            }
        )

        column QTDANEXO (
            type: plainText
            heading {
                heading: QTD Anexos
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: I
            }
        )

        column SEMANA (
            type: plainText
            heading {
                heading: Semana
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column VALORDEPOSITO (
            type: plainText
            heading {
                heading: Valor Depósito
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column VALORPAGOCONVERSAO (
            type: plainText
            heading {
                heading: Valor Conversão
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: J
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 7665658 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATADEPOSITO (
                sequence: 2
            )

            displayColumn NOMEUSUARIO (
                sequence: 6
            )

            displayColumn NUMEROCOMPROVANTE (
                sequence: 3
            )

            displayColumn ORIGEM (
                sequence: 8
            )

            displayColumn QTDANEXO (
                sequence: 7
            )

            displayColumn SEMANA (
                sequence: 1
            )

            displayColumn VALORDEPOSITO (
                sequence: 4
            )

            displayColumn VALORPAGOCONVERSAO (
                sequence: 5
            )

        )

    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @depósitos
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 277
                items: {
                    P277_IDDEPOSITOFAVORITA:
                    P277_IDFECHAMENTO: &P0_IDFECHAMENTO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.fechamentossemanais f
                where f.idfechamento = :P0_IDFECHAMENTO
                  and f.concluido = 'N'
                ```
        }
    )

    button revisar-depositos (
        buttonName: REVISAR_DEPOSITOS
        label: Revisar Depósitos
        layout {
            sequence: 10
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 466
                items: {
                    P466_IDFECHAMENTO: &P0_IDFECHAMENTO.
                    P466_ORIGEMDP: X
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                :P0_IDFECHAMENTO is not null and exists ( select 1
                                                            from roman.usuariosgruposatendimento ug 
                                                            where ug.idgrupoatendimento in (0,2)
                                                              and ug.usuario = v('APP_USER') )
                ```
        }
    )

)

