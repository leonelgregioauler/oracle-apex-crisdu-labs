        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 251
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 353
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 353
                items: {
                    P353_IDFILIALFAVORITA: &P353_IDFILIALFAVORITA.
                    P353_IDPRODUTO: &P353_IDPRODUTO.
                    P353_IDPRODUTODETALHADO: &P353_IDPRODUTODETALHADO.
                    P353_IDUSUARIO: &P353_IDUSUARIO.
                    P353_IDFORNECEDOR: &P353_IDFORNECEDOR.
                }
                action: resetPagination
            }
        }
    )

)

