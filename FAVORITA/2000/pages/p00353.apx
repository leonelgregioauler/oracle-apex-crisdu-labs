page 353 (
    name: Relatório de Movimentações de Estoques de Defeitos
    title: Relatório de Movimentações de Estoques de Defeitos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region relatório-de-movimentações-de-estoque-de-defeitos (
        name: Relatório de Movimentações de Estoque de Defeitos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idmovimentoestoquedefeito
                     , idestoquedefeito
                     , idfilialfavorita
                     , filialfavorita
                     , datamovimento
                     , idusuario
                     , nomeusuario
                     , idproduto
                     , nomeproduto
                     , idprodutodetalhado
                     , nomeprodutodetalhado
                     , iditemdefeitopedido
                     , iditemcompratransferencia
                     , tipomovimentacao
                     , quantidade
                     , descricao_defeito -- 9613190 - Maicon Aimi - 10/01/2024
                from vw_movimentoestoquedefeito_fav mf
                where ididioma         = :P0_IDIDIOMA
                  and idfilialfavorita = :P353_IDFILIALFAVORITA
                  and ( :P353_IDPRODUTO is null or idproduto = :P353_IDPRODUTO )
                  and ( :P353_IDPRODUTODETALHADO is null or idprodutodetalhado = :P353_IDPRODUTODETALHADO )
                  and ( :P353_IDUSUARIO is null or idusuario = :P353_IDUSUARIO )
                  and ( :P353_IDFORNECEDOR IS NULL or exists ( select 1 
                                                              from fornecedoresprodutos f
                                                              where f.idproduto = mf.idproduto
                                                                and f.idfornecedor = :P353_IDFORNECEDOR ) )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 1450277643813875013
        }

