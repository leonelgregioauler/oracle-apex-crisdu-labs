    process integrar-produto-va (
        name: Integrar produto VA
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  v_ref      varchar2(60) := trim(:P997_REFERENCIA);
                  v_mensagem varchar2(4000);
                begin
                  if v_ref is null then
                    :P997_RETORNO := 'Informe uma referencia.';
                    return;
                  end if;
                  if instr(v_ref, ',') > 0 then
                    :P997_RETORNO := 'Informe UMA unica referencia - a integracao e feita produto a produto.';
                    return;
                  end if;
                  pck_intprodutosva_fav.prc_envia_lote(
                    p_referencias => v_ref,
                    pmensagem     => v_mensagem );
                  :P997_RETORNO := '<b>' || apex_escape.html(v_ref) || '</b>:<br>' ||
                                   replace(apex_escape.html(v_mensagem), chr(10), '<br>');
                  -- So limpa o campo quando nao houve erro nenhum
                  if instr(v_mensagem, 'Com erro: 0') > 0 then
                    :P997_REFERENCIA := null;
                  end if;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 89770000000001060
        }
        serverSideCondition {
            type: expression
            plsqlExpression: v('REQUEST') in ('INTEGRAR_VA','INTEGRAR_UM')
        }
    )

    process simular-integracao-va (
        name: Simular integracao VA
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  v_ref    varchar2(60) := trim(:P997_REFERENCIA);
                  v_msg    varchar2(4000);
                  v_ok     boolean;
                  v_saida  clob;
                  v_achou  number := 0;
                begin
                  if v_ref is null then
                    :P997_RETORNO := 'Informe uma referencia.';
                    return;
                  end if;
                  if instr(v_ref, ',') > 0 then
                    :P997_RETORNO := 'Informe UMA unica referencia - a integracao e feita produto a produto.';
                    return;
                  end if;
                  for p in ( select p.idproduto
                               from favorita.produtos p
                              where p.referencia = v_ref ) loop
                    v_achou := 1;
                    v_ok := pck_intprodutosva_fav.fnc_valida_referencia(p.idproduto, v_msg);
                    v_saida := v_saida || '<b>' || apex_escape.html(v_ref) || '</b>: ' ||
                               case when v_ok
                                 then '<span style="color:green;font-weight:bold">APTO PARA ENVIO</span>'
                                 else '<span style="color:red;font-weight:bold">BLOQUEADO</span> - ' ||
                                      apex_escape.html(v_msg)
                               end ||
                               '<br><details><summary>JSON que seria enviado</summary>' ||
                               '<pre style="white-space:pre-wrap">' ||
                               apex_escape.html(dbms_lob.substr(
                                 pck_intprodutosva_fav.fnc_json_referencia(p.idproduto), 12000, 1)) ||
                               '</pre></details>';
                  end loop;
                  if v_achou = 0 then
                    v_saida := '<b>' || apex_escape.html(v_ref) ||
                               '</b>: <span style="color:red">referencia nao encontrada</span>';
                  end if;
                  :P997_RETORNO := dbms_lob.substr(v_saida, 30000, 1);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 89770000000001050
        }
        serverSideCondition {
            type: expression
            plsqlExpression: v('REQUEST') in ('SIMULAR_VA','SIMULAR_UM')
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
