    region produtos-pendentes-de-integracao (
        name: Produtos pendentes de integracao
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.referencia,
                       upper(p.nomeproduto)                                     as nomeproduto,
                       count(pd.idprodutodetalhado)                             as qt_skus,
                       pck_intprodutosva_fav.fnc_assinatura(p.idproduto)        as assinatura,
                       ( select gv.cd_grade_va
                           from favorita.tb_grades_va gv
                          where gv.assinatura =
                                pck_intprodutosva_fav.fnc_assinatura(p.idproduto) ) as gridcode_va,
                       '<a href="javascript:void(0);" data-ref="' || p.referencia ||
                       '" onclick="simularProduto(this.dataset.ref);">Simular</a>'  as acao_simular,
                       '<a href="javascript:void(0);" data-ref="' || p.referencia ||
                       '" onclick="integrarProduto(this.dataset.ref);" style="font-weight:bold">Integrar</a>' as acao_integrar
                  from favorita.produtos p
                  join favorita.produtosdetalhados pd
                    on pd.idproduto = p.idproduto
                 where exists ( select 1
                                  from favorita.produtosdetalhados pd2
                                 where pd2.idproduto = p.idproduto
                                   and not exists ( select 1
                                                      from favorita.produtosdetalhadosvirtualage pv
                                                     where pv.idprodutodetalhado = pd2.idprodutodetalhado ) )
                   and not exists ( select 1
                                      from favorita.tb_produtos_va t
                                     where t.idproduto = p.idproduto
                                       and t.status = 'ENVIADO' )
                 group by p.idproduto, p.referencia, p.nomeproduto
                 order by p.referencia
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
