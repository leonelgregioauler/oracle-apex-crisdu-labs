page 92 (
    name: Orçamentos de Fretes
    title: Orçamentos de Fretes
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 60%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region orçamentos-de-fretes (
        name: Orçamentos de Fretes
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    region orçamentos-realizados (
        name: Orçamentos Realizados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.idorcamentofretecompratransf
                     , w.idcompratransferencia
                     , w.dataorcamento
                     , transportadora
                     , valororcamento
                     , utilizado
                     , descsomarvencimento
                     , nomeusuario
                from VW_ORCAMENTOSCOMPRASTRANSF_FAV w
                where w.idcompratransferencia = :P92_IDCOMPRATRANSFERENCIA
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from orcamentosfretecomprastransf o
                where o.idcompratransferencia = :P92_IDCOMPRATRANSFERENCIA
                ```
        }
        link {
            linkColumn: customTarget
            target: {
                page: 92
                items: {
                    P92_IDCOMPRATRANSFERENCIA: #IDCOMPRATRANSFERENCIA#
                    P92_IDORCAMENTOFRETECOMPRA: #IDORCAMENTOFRETECOMPRATRANSF#
                }
                action: resetPagination
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 13061149798899442
        }

        column DATAORCAMENTO (
            type: plainText
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        column DESCSOMARVENCIMENTO (
            type: plainText
            heading {
                heading: Somar no Vencimento?
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: J
            }
        )

        column IDCOMPRATRANSFERENCIA (
            type: hidden
            heading {
                heading: Idcompratransferencia
            }
            layout {
                sequence: 110
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: K
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDORCAMENTOFRETECOMPRATRANSF (
            type: hidden
            heading {
                heading: Idorcamentofretecompratransf
            }
            layout {
                sequence: 10
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NOMEUSUARIO (
            type: plainText
            heading {
                heading: Orçado Por
                alignment: center
            }
            layout {
                sequence: 80
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column TRANSPORTADORA (
            type: plainText
            heading {
                heading: Transportadora
                alignment: center
            }
            layout {
                sequence: 90
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        column UTILIZADO (
            type: plainText
            heading {
                heading: Utilizado
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column VALORORCAMENTO (
            type: plainText
            heading {
                heading: Valor Frete
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        savedReport 132265 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAORCAMENTO (
                sequence: 1
            )

            displayColumn DESCSOMARVENCIMENTO (
                sequence: 5
            )

            displayColumn NOMEUSUARIO (
                sequence: 6
            )

            displayColumn TRANSPORTADORA (
                sequence: 2
            )

            displayColumn UTILIZADO (
                sequence: 4
            )

            displayColumn VALORORCAMENTO (
                sequence: 3
            )

        )

    )

    pageItem P92_DATAORCAMENTO (
        type: datePickerJquery
        label {
            label: Data do Orçamento
            alignment: left
        }
        layout {
            sequence: 50
            region: @orçamentos-de-fretes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P92_IDCOMPRATRANSFERENCIA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @orçamentos-de-fretes
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P92_IDORCAMENTOFRETECOMPRA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @orçamentos-de-fretes
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P92_IDTRANSPORTADORA (
        type: selectList
        label {
            label: Transportadora
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nometransportadora(t.idtransportadora) display_value
                     , t.idtransportadora
                from transportadoras t
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @orçamentos-de-fretes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P92_IDUSUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @orçamentos-de-fretes
            slot: regionBody
        }
        source {
            type: item
            item: P0_IDUSUARIO
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P92_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @orçamentos-de-fretes
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P92_OPERACAO_DML (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @orçamentos-de-fretes
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P92_SOMARVENCIMENTO (
        type: radioGroup
        label {
            label: Somar Valor do Frente no Vencimento?
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 100
            region: @orçamentos-de-fretes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P92_UTILIZADO (
        type: checkboxGroup
        label {
            label: Utilizado
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Sim;S,Não;
            displayExtraValues: false
        }
        layout {
            sequence: 70
            region: @orçamentos-de-fretes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P92_VALORORCAMENTO (
        type: textField
        label {
            label: Valor
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 60
            region: @orçamentos-de-fretes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 6
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 50
            region: @orçamentos-de-fretes
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P92_IDORCAMENTOFRETECOMPRA
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 70
            region: @orçamentos-de-fretes
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 40
            region: @orçamentos-de-fretes
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P92_IDORCAMENTOFRETECOMPRA
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @orçamentos-de-fretes
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 60
            region: @orçamentos-de-fretes
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-reply
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @voltar
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation valida-valor-orçado (
        name: Valida Valor Orçado
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where to_number(:P92_VALORORCAMENTO) <= 0
                ```
        }
        error {
            errorMessage: Valor do Frete inválido, insira um valor correto!
        }
        serverSideCondition {
            type: never
        }
    )

    process consulta-frete (
        name: Consulta Frete
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  if :P92_IDORCAMENTOFRETECOMPRA is not null then 
                    --
                    #OWNER#.PCK_COMPRASTRANSF_FAV.PRC_ORCAMFRETEPEDCOMPRA( PIDORCAMENTOFRETECOMPRATRANSF => :P92_IDORCAMENTOFRETECOMPRA,
                                                                           PIDCOMPRATRANSFERENCIA => :P92_IDCOMPRATRANSFERENCIA,
                                                                           PIDUSUARIO => :P92_IDUSUARIO,
                                                                           PDATAORCAMENTO => :P92_DATAORCAMENTO,
                                                                           PIDTRANSPORTADORA => :P92_IDTRANSPORTADORA,
                                                                           PVALORORCAMENTO => :P92_VALORORCAMENTO,
                                                                           PUTILIZADO => :P92_UTILIZADO,
                                                                           PSOMARVENCIMENTO => :P92_SOMARVENCIMENTO,
                                                                           PMD5 => :P92_MD5,
                                                                           POPERACAO_DML => 'S');
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 13228229777409505
        }
    )

    process limpar-campos (
        name: limpar campos
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 13227997847409502
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    process operação-dml-em-orçamentos-fretes (
        name: Operação DML em Orçamentos Fretes
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --                     --
                  #OWNER#.PCK_COMPRASTRANSF_FAV.PRC_ORCAMFRETEPEDCOMPRA( PIDORCAMENTOFRETECOMPRATRANSF => :P92_IDORCAMENTOFRETECOMPRA,
                                                                         PIDCOMPRATRANSFERENCIA => :P92_IDCOMPRATRANSFERENCIA,
                                                                         PIDUSUARIO => :P92_IDUSUARIO,
                                                                         PDATAORCAMENTO => :P92_DATAORCAMENTO,
                                                                         PIDTRANSPORTADORA => :P92_IDTRANSPORTADORA,
                                                                         PVALORORCAMENTO => :P92_VALORORCAMENTO,
                                                                         PUTILIZADO => :P92_UTILIZADO,
                                                                         PSOMARVENCIMENTO => :P92_SOMARVENCIMENTO,
                                                                         PMD5 => :P92_MD5,
                                                                         POPERACAO_DML => voperacao_dml );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 13060905478899440
        }
    )

    branch (
        name: go to page 74
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 74
                items: {
                    P74_IDCOMPRATRANSFERENCIA: &P92_IDCOMPRATRANSFERENCIA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('VOLTAR','INSERIR','EXCLUIR','ATUALIZAR')
                ```
        }
    )

)

