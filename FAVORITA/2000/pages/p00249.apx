page 249 (
    name: Relatório de Históricos
    title: Relatório de Históricos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region histórico-de-pedidos (
        name: Histórico de Pedidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select h.idhistoricopedido
                     , h.idpedido
                     , p.filialromance
                     , p.representante
                     , p.vendedora
                     , h.datahistorico
                     , h.nomeusuario
                     , h.descricao
                     , h.descrimprimirnopedido 
                     , h.liberaedicao
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||p.idpedido ,'SESSION')||''',''_blank''); void(0)">'||p.idpedido||'</a>' "Ir para o Pedido"
                from vw_historicospedidos_fav h
                   , vw_pedidos_fav p
                where h.idpedido = p.idpedido
                  and p.ididioma = 1
                  and ( :P249_DATAEMISSAOINICIO is null or trunc(h.datahistorico) between to_date(:P249_DATAEMISSAOINICIO,'DD/MM/RRRR') and to_date(:P249_DATAEMISSAOFIM,'DD/MM/RRRR') )
                  and ( :P249_IDPEDIDO is null or h.idpedido = :P249_IDPEDIDO )
                  and ( :P249_OBSERVACAO is null or lower(h.descricao) like '%'||lower(:P249_OBSERVACAO)||'%' )
                  and ( :P249_DATAEMISSAOINICIO is not null
                     or :P249_DATAEMISSAOFIM is not null
                     or :P249_IDPEDIDO is not null
                     or :P249_OBSERVACAO is not null )
                order by datahistorico desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum histórico encontrado, verifique os filtros informados!
        }
        advanced {
            savedReportMappingIdentifier: 580425668915463218
        }

        column DATAHISTORICO (
            type: plainText
            heading {
                heading: Data Histórico
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: F
            }
        )

        column DESCRICAO (
            type: plainText
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 80
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column DESCRIMPRIMIRNOPEDIDO (
            type: plainText
            heading {
                heading: Imprimir no Pedido?
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        column FILIALROMANCE (
            type: plainText
            heading {
                heading: Filial
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column IDHISTORICOPEDIDO (
            type: hidden
            heading {
                heading: Idhistoricopedido
            }
            layout {
                sequence: 10
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDPEDIDO (
            type: plainText
            heading {
                heading: Nr Pedido
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column "Ir para o Pedido" (
            type: plainText
            heading {
                heading: Ir para o Pedido
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: K
            }
            security {
                escapeSpecialChars: false
            }
        )

        column LIBERAEDICAO (
            type: plainText
            heading {
                heading: Liberar Edição?
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: J
            }
        )

        column NOMEUSUARIO (
            type: plainText
            heading {
                heading: Usuário Incluiu
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column REPRESENTANTE (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column VENDEDORA (
            type: plainText
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 5804635 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAHISTORICO (
                sequence: 6
            )

            displayColumn DESCRICAO (
                sequence: 8
            )

            displayColumn DESCRIMPRIMIRNOPEDIDO (
                sequence: 9
            )

            displayColumn FILIALROMANCE (
                sequence: 3
            )

            displayColumn IDHISTORICOPEDIDO (
                sequence: 1
            )

            displayColumn IDPEDIDO (
                sequence: 2
            )

            displayColumn "Ir para o Pedido" (
                sequence: 11
            )

            displayColumn LIBERAEDICAO (
                sequence: 10
            )

            displayColumn NOMEUSUARIO (
                sequence: 7
            )

            displayColumn REPRESENTANTE (
                sequence: 4
            )

            displayColumn VENDEDORA (
                sequence: 5
            )

            controlBreak (
                column: IDPEDIDO
                layout {
                    sequence: 1
                }
            )

            controlBreak (
                column: FILIALROMANCE
                layout {
                    sequence: 2
                }
            )

            controlBreak (
                column: REPRESENTANTE
                layout {
                    sequence: 3
                }
            )

            controlBreak (
                column: VENDEDORA
                layout {
                    sequence: 4
                }
            )

        )

    )

    pageItem P249_DATAEMISSAOFIM (
        type: datePickerJquery
        label {
            label: até
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: DD/MM/RRRR
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P249_DATAEMISSAOINICIO (
        type: datePickerJquery
        label {
            label: Emissão de
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: DD/MM/RRRR
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P249_IDPEDIDO (
        type: numberField
        label {
            label: Nr Pedido
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P249_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
            height: 5
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 249
                items: {
                    P249_IDPEDIDO: &P249_IDPEDIDO.
                    P249_OBSERVACAO: &P249_OBSERVACAO.
                    P249_DATAEMISSAOINICIO: &P249_DATAEMISSAOINICIO.
                    P249_DATAEMISSAOFIM: &P249_DATAEMISSAOFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

