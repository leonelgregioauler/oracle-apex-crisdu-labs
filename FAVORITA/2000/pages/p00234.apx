page 234 (
    name: Ranking de Atendente
    title: Ranking de Atendente
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function doLoad()
            {
            setTimeout( "refresh()", 120*1000 );
            }
            
            function refresh()
            {
            window.location.href = window.location;
            }
            ```
        executeWhenPageLoads: doLoad()
    }
    security {
        pageAccessProtection: unrestricted
    }

    region new (
        name: New
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select linha
                     , nomeusuario
                     , total
                     , qtdped
                from (
                      select nomeusuario
                          , total
                          , qtdped
                          , rownum linha
                          from (
                                select p.nomeusuario
                                     , sum(p.valortotal) total
                                     , count(1) qtdped
                                from vw_pedidos_fav p
                                   , usuarios u
                                where  p.idusuario = u.idusuario
                                  and trunc(p.dataemissao) = trunc(sysdate)
                                  and u.idfilialfavorita = 1
                                  and p.ididioma = :P0_IDIDIOMA
                                group by p.nomeusuario
                          order by 2 desc
                          ) )
                where linha <= 18;
                ```
        }
        layout {
            sequence: 10
            parentRegion: @ranking-de-pedidos
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 341034923834212046
        }

        column LINHA (
            type: plainText
            heading {
                heading: #
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column NOMEUSUARIO (
            type: plainText
            heading {
                heading: Usuario
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column QTDPED (
            type: plainText
