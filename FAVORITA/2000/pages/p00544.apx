page 544 (
    name: Gerenciamento de Leads
    title: Gerenciamento de Leads
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region gerenciamento-de-leads (
        name: Gerenciamento de  Leads
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select l.nomecompleto 
                     , nvl(l.cpf,l.documentoestrangeiro) documento
                     , l.datacadastro
                     , l.datacadastrorepresentante
                     , round((l.datacadastrorepresentante - l.datacadastro), 0) total_dias
                     , decode(l.cadastrado, 'Sim', 'Sim',
                                            'Nao', 'Não') cadastrado
                     , l.nomerepresentante
                     , l.enviado_painel
                     , roman.pck_romance.fnc_nomefilial (l.idfilial) Franquia
                     , l.descricaosituacao
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':546:'||v('APP_SESSION')||'::NO::P546_IDCONTROLECONTATOSSITE:'||l.idcontrolecontatossite,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' url
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':124:'||v('APP_SESSION')||'::NO::P124_IDCONTROLECONTATOSSITE:'||l.idcontrolecontatossite,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' edicao
                     , l.situacao_cliente
                     , l.data_envio_painel
                     , l.origemdesc origem
                from ( select c.nomecompleto
                            , c.idcontrolecontatossite
                            , c.cpf
                            , c.datacadastro
                            , c.datacadastrorepresentante
                            , c.descricaosituacao
                            --, c.cadastrado
                            , case 
                                when exists (select 1
                                             from catal.pessoas p
                                             where p.cpf = c.cpf
                                               and exists( select 1
                                                           from catal.vendedoras v
                                                           where v.idpessoa = p.idpessoa)) then 'Sim'
                                else 'Não'
                              end cadastrado
                            /*, case 
                                when exists (select 1
                                             from roman.painelcontatossite p
                                             where p.idcontrolecontatossite = c.idcontrolecontatossite
                                               and p.idsituacaopainel = 2) then 'Sim'
                                else 'Não'
                              end cadastrado*/
                            , c.nomerepresentante
                            , case
                                when exists (select 1
                                             from roman.painelcontatossite p
                                             where p.idcontrolecontatossite = c.idcontrolecontatossite) then 'Sim'
                                else 'Não'
                              end enviado_painel
                            , c.idfilial
                            , Nvl((select decode(v.ativo,'S','Ativa','N','Inativa') situacao
                                 from vendedoras v
                                    , pessoas p
                                where v.idpessoa = p.idpessoa
                                  and p.cpf      = trim(replace(replace(c.cpf,'.',''),'-',''))
                               union
                               select decode(v.ativo,'S','Ativa','N','Inativa') situacao
                                 from vendedoras v
                                    , pessoas p
                                where v.idpessoa = p.idpessoa
                                  and p.documentoestrangeiro = c.documentoestrangeiro),'Não cadastrado') situacao_cliente
                            , (select max(cl.dataclassificado)
                                 from roman.classificacoessac cl
                               where cl.idcontrolecontatossite = c.idcontrolecontatossite
                                 and cl.idcaracteristicasac = 37) data_envio_painel
                            , c.documentoestrangeiro 
                            , c.origemdesc
                       from favorita.vw_controlecontatossite_fav c
                       where ( :P544_DATAINICIO is null or trunc(c.datacadastro) between to_date(:P544_DATAINICIO,'DD/MM/RRRR') and to_date(:P544_DATAFIM,'DD/MM/RRRR'))
                         and ( :P544_CPF is null or replace(replace(c.cpf,'.',''),'-','') = replace(replace(:P544_CPF,'.',''),'-','') )
                         and ( :P544_NOME is null or lower(c.nomecompleto) like '%'||lower(:P544_NOME)||'%' )
                         and ( :P544_ENVIADOAOPAINEL is null 
                             or :P544_ENVIADOAOPAINEL = 'S' and exists (select 1
                                                                        from roman.painelcontatossite p
                                                                        where p.idcontrolecontatossite = c.idcontrolecontatossite)
                             or :P544_ENVIADOAOPAINEL = 'N' and not exists (select 1
                                                                            from roman.painelcontatossite p
                                                                            where p.idcontrolecontatossite = c.idcontrolecontatossite))
                         and ( :P544_FILIAL is null or c.idfilial = :P544_FILIAL)
                         and ( :P544_NAOFILTRAR = 'S')
                         and ( :P544_SITUACAO = 'XX' or c.situacao = :P544_SITUACAO )
                         AND ( :P544_DOCESTRANGEIRO is null or c.documentoestrangeiro = :P544_DOCESTRANGEIRO ))l
                       where nvl(trunc(l.data_envio_painel),trunc(sysdate)) between nvl(:P544_DATA_ENVIO_LEADS_INICIO,nvl(trunc(l.data_envio_painel),trunc(sysdate))) and  nvl(:P544_DATA_ENVIO_LEADS_FIM,nvl(trunc(l.data_envio_painel),trunc(sysdate)))
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 32002948308984615
        }

