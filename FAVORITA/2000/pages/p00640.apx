page 640 (
    name: Telefones Bloqueados
    title: Telefones Bloqueados
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <font color="BLUE"> Estes telefones foram encontrados nos cadastros realizados pelos distribuidores.
                <br> Todos telefones desta lista, estarão bloqueados para receberem ligações e até mesmo serem usados em novos cadastros.</font>
                ```
        }
    )

    region lista-de-telefones-bloqueados (
        name: Lista de Telefones Bloqueados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idtelefonebloqueado
                     , t.data
                     , t.usuario
                     , t.telefonelimpo
                from roman.telefonesbloqueados t
                where ( :P640_TELEFONE is null or t.telefonelimpo = :P640_TELEFONE )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 3059080899347036937
        }

        column DATA (
            type: plainText
            heading {
                heading: Data Bloqueio
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: B
            }
        )

        column IDTELEFONEBLOQUEADO (
            type: link
            heading {
                heading: Ver Cadastro
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 641
                    items: {
                        P641_IDTELEFONEBLOQUEADO: #IDTELEFONEBLOQUEADO#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column TELEFONELIMPO (
            type: plainText
            heading {
                heading: Telefone
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column USUARIO (
            type: plainText
            heading {
                heading: Bloqueado Por
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 32219138 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATA (
                sequence: 2
            )

            displayColumn IDTELEFONEBLOQUEADO (
                sequence: 1
            )

            displayColumn TELEFONELIMPO (
                sequence: 4
            )

            displayColumn USUARIO (
                sequence: 3
            )

        )

    )

    pageItem P640_TELEFONE (
        type: textField
        label {
            label: Telefone (apenas numeros)
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button adicionar (
        buttonName: ADICIONAR
        label: Adicionar novo Telefone!
        layout {
            sequence: 10
            region: @lista-de-telefones-bloqueados
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 641
                items: {
                    P641_IDTELEFONEBLOQUEADO:
                }
                clearCache: 641
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button filtar (
        buttonName: FILTAR
        label: Filtar
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 640
                items: {
                    P640_TELEFONE: &P640_TELEFONE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtar
        }
    )

)

