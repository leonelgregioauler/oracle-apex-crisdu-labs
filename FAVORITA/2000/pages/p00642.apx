page 642 (
    name: Ligações Não Atendidas
    title: Ligações Não Atendidas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region ligações-não-atendidas (
        name: Ligações não Atendidas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select x.idtarefa
                     , x.idpessoa
                     , initcap(p.nomepessoa) consultora
                     , x.telefone
                     , x.dataligacao
                     , x.classificacao
                     , x.agente
                from beecobranca.vw_ligacoes_tarefas x
                   , pessoas p
                where :P642_FILTRAR = 'S'
                  and p.idpessoa = x.idpessoa
                  and ( :P642_IDTAREFA is null or x.idtarefa = :P642_IDTAREFA )
                  and x.DATALIGACAO BETWEEN TO_DATE(:P642_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') 
                                           AND TO_DATE(:P642_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado, verifique os filtros!
        }
        advanced {
            savedReportMappingIdentifier: 3072257857778250647
        }

        column AGENTE (
            type: plainText
            heading {
                heading: Agente
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column CLASSIFICACAO (
            type: plainText
            heading {
                heading: Classificação
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column CONSULTORA (
            type: plainText
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column DATALIGACAO (
            type: plainText
            heading {
                heading: Data da Ligação
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: E
            }
        )

        column IDPESSOA (
            type: plainText
            heading {
                heading: ID PESSOA
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column IDTAREFA (
            type: plainText
            heading {
                heading: Nr Tarefa
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column TELEFONE (
            type: plainText
            heading {
                heading: Telefone
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 30740580 (
            visibility: primaryDefault
            view {
                groupBy: true
                rowsPerPage: 50
            }

            displayColumn AGENTE (
                sequence: 7
            )

            displayColumn CLASSIFICACAO (
                sequence: 6
            )

            displayColumn CONSULTORA (
                sequence: 3
            )

            displayColumn DATALIGACAO (
                sequence: 5
            )

            displayColumn IDPESSOA (
                sequence: 2
            )

            displayColumn IDTAREFA (
                sequence: 1
            )

            displayColumn TELEFONE (
                sequence: 4
            )

            groupByColumn (
                column: CLASSIFICACAO
                layout {
                    sequence: 1
                }
            )

            groupByAggregate (
                heading: Total de Classificações
                aggregate {
                    function: count
                    column: IDTAREFA
                }
                appearance {
                    formatMask: 999G999G999G999G990
                }
                layout {
                    sequence: 1
                }
            )

        )

    )

    pageItem P642_DATAFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            formatMask: DD/MM/RRRR
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P642_DATAINICIO (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            formatMask: DD/MM/RRRR
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P642_FILTRAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P642_IDTAREFA (
        type: numberField
        label {
            label: Nr Tarefa
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process valores-default (
        name: Valores Default
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  :P642_DATAINICIO := trunc(SYSDATE);
                  :P642_DATAFIM := trunc(SYSDATE);
                  :P642_FILTRAR := 'S';
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 3074049174896378810
        }
        serverSideCondition {
            type: itemIsNull
            item: P642_DATAINICIO
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 642
                items: {
                    P642_DATAINICIO: &P642_DATAINICIO.
                    P642_DATAFIM: &P642_DATAFIM.
                    P642_IDTAREFA: &P642_IDTAREFA.
                    P642_FILTRAR: S
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

