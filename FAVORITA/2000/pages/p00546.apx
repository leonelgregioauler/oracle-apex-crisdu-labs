page 546 (
    name: Histórico Lead
    title: Histórico Lead
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region histórico-lead (
        name: Histórico Lead
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.datasituacao Data_motivo
                     , roman.pck_romance.fnc_nomerepresentante (p.iddistribuidor) Distribuidor
                     , roman.pck_romance.fnc_nomefilial (p.idfilial) Franquia 
                     , s.descricao situacao
                     , p.observacao motivo
                from roman.painelcontatossite p
                   , roman.situacoespainel s
                where p.idcontrolecontatossite = :P546_IDCONTROLECONTATOSSITE
                  and p.idsituacaopainel = s.idsituacaopainel
                order by 1 desc;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 40911066571091124
        }

        column DATA_MOTIVO (
            type: plainText
            heading {
                heading: Data Motivo
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: A
            }
        )

        column DISTRIBUIDOR (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column FRANQUIA (
            type: plainText
            heading {
                heading: Franquia
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column MOTIVO (
            type: plainText
            heading {
                heading: Motivo
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column SITUACAO (
            type: plainText
            heading {
                heading: Situacao
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 204678 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATA_MOTIVO (
                sequence: 1
            )

            displayColumn DISTRIBUIDOR (
                sequence: 2
            )

            displayColumn FRANQUIA (
                sequence: 3
            )

            displayColumn MOTIVO (
                sequence: 5
            )

            displayColumn SITUACAO (
                sequence: 4
            )

        )

    )

    pageItem P546_IDCONTROLECONTATOSSITE (
        type: hidden
        layout {
            sequence: 10
            region: @histórico-lead
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

