page 116 (
    name: Relatório de Pessoas
    title: Relatório de Pessoas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region relatório-de-pessoas (
        name: Relatório de Pessoas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idpessoa
                     , nomepessoa
                     , enderecoprincipal
                     , enderecosecundario
                     , cidade
                     , email
                     , cpf
                     , cnpj
                     , tipopessoa
                     , observacao
                     , numero
                     , complemento
                     , bairro
                     , cep
                     , rg
                     , datanascimento
                     , observacaocobranca
                     , documentoestrangeiro
                     , limitecredito
                     , ultimaatualizacao
                     , sexo
                     , nroconsultaspc
                     , documentosrecebidos
                     , datacadastro
                     , idfilialvendedora
                     , idfilialrepresentante
                     , roman.pck_romance.fnc_nomefilial(nvl(idfilialrepresentante,idfilialvendedora)) franquia
                     , ( select listagg(tp.telefone,'    ') within group (order by 1)
                         from telefonespessoas tp
                         where tp.idpessoa = p.idpessoa ) telefone
                     , ( select r.datainclusao
                         from catal.representantes r
                         where r.idpessoa = p.idpessoa) datainclusao
                     , ( select nvl(count(v.idnotavenda),0)
                           from roman.vw_notasvendas_roman v
                          where p.idvendedora = v.idvendedora) QtdNotasRMC
                     , nvl(( select cc.nomecategoria
                           from roman.categoriasclubes cc
                              , roman.pontuacoesclubedesucesso pcc
                              , catal.vendedoras ve
                          where cc.idcategoriaclube = pcc.idcategoriaclube
                            and pcc.idvendedora = ve.idvendedora 
                            and ve.idpessoa = p.idpessoa), 'Nenhum') "Categoria Empreendedora"
                     -- 10477817 - Maicon Aimi - 14/10/2025
                     , (select max(c.idvalorcaracteristica)
                          from roman.classificacoesnotasvendas c
                         where c.idcaracteristicanotavenda = 52
                           and c.idnotavenda in ( select n.idnotavenda
                                                    from roman.notasvendas n
                                                   where n.idvendedora = p.idvendedora)) as sacola_romance
                  from favorita.vw_pessoas_fav p
                  where(
                       ( :P116_TIPO = 'C' 
                   and (
                             ( :P116_MOSTRARTODOS = 'N'
                         and ( idrepresentante is not null and idvendedora is not null ) 
                         and (/*:P116_VENDEDORA is null or*/ idvendedora = :P116_VENDEDORA
                          or /*:P116_REPRESENTANTE is null or*/ idrepresentante = :P116_REPRESENTANTE )
                         and ( :P116_VENDEDORA is not null or :P116_REPRESENTANTE is not null )
                             )
                    or ( :P116_MOSTRARTODOS = 'S' and idrepresentante is not null and idvendedora is not null and ( :P116_IDFILIALROMANCE is null or idfilialvendedora = :P116_IDFILIALROMANCE ) ) ) )
                    --
                    or ( :P116_TIPO = 'R'
                   and ( 
                             ( :P116_MOSTRARTODOS = 'N' 
                         and ( idrepresentante is not null and idvendedora is null ) 
                         and (/*:P116_REPRESENTANTE is null or */ idrepresentante = :P116_REPRESENTANTE ) 
                             )
                    or ( :P116_MOSTRARTODOS = 'S' and idrepresentante is not null and idvendedora is null and ( :P116_IDFILIALROMANCE is null or idfilialrepresentante = :P116_IDFILIALROMANCE ) ) ) )
                    --
                    or ( :P116_TIPO = 'F'
                   and ( 
                             ( :P116_MOSTRARTODOS = 'N' 
                         and ( idfornecedor is not null )   
                         and (/*:P116_FORNECEDOR is null or */ idfornecedor = :P116_FORNECEDOR )
                             )
                    or ( :P116_MOSTRARTODOS = 'S' and idfornecedor is not null ) ) )
                    --
                    or ( :P116_TIPO = 'Z'
                   and ( 
                             ( :P116_MOSTRARTODOS = 'N'
                         and ( idfuncionario is not null )
                         and (/*:P116_FUNCIONARIO is null or */ idfuncionario = :P116_FUNCIONARIO )
                             )
                    or ( :P116_MOSTRARTODOS = 'S' and idfuncionario is not null ) ) )
                   )
                   and ( :P116_SIGLAATIVO = 'T' or siglaativo = :P116_SIGLAATIVO )
                   
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 85
                items: {
                    P85_IDPESSOA: #IDPESSOA#
                }
                action: resetPagination
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 10000
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 13876032808620939
        }

