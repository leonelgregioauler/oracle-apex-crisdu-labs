                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util.fnc_verificaacesso(21010,v('APP_USER')) = 'S'
                ```
        }
    )

    dynamicAction cliente (
        name: CLIENTE
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P116_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P116_TIPO
            value: C
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P116_FORNECEDOR
                    P116_FUNCIONARIO
                ]
            }
            execution {
                sequence: 30
            }
        )

        action native-set-value (
            action: setValue
            affectedElements {
                selectionType: items
                items: [
                    P116_FORNECEDOR
                    P116_FUNCIONARIO
                ]
            }
            execution {
                sequence: 40
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
