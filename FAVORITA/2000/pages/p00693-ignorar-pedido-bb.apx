page 693 (
    name: Ignorar pedido BB
    alias: IGNORAR-PEDIDO-BB
    title: Ignorar pedido BB
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region ignorar-pedido-bb (
        name: Ignorar pedido BB
        type: interactiveReport
        source {
            location: localDatabase
            tableName: BB_PEDIDOS_IGNORADOS
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 694
                items: {
                    P694_IDPEDIDO: \#IDPEDIDO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 1348971894206722338
        }

        column ATIVO (
            type: plainText
            heading {
                heading: Ativo
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column DATAINCLUSAO (
            type: plainText
            heading {
                heading: Datainclusao
            }
            layout {
                sequence: 4
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        column IDPEDIDO (
            type: plainText
            heading {
                heading: Idpedido
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column MOTIVO (
            type: plainText
            heading {
                heading: Motivo
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column USUARIO (
            type: plainText
            heading {
                heading: Usuario
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Ignorar pedido BB
        }

        savedReport 13489762 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ATIVO (
                sequence: 5
            )

            displayColumn DATAINCLUSAO (
                sequence: 4
            )

            displayColumn IDPEDIDO (
                sequence: 1
            )

            displayColumn MOTIVO (
                sequence: 2
            )

            displayColumn USUARIO (
                sequence: 3
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @ignorar-pedido-bb
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 694
                clearCache: 694
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @ignorar-pedido-bb
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @ignorar-pedido-bb
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

