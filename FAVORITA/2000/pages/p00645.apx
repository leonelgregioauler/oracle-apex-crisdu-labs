    region csv-remessa-pedido-2 (
        name: CSV Remessa Pedido
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select  skuvirtualage LOCAL
                      , favorita.pck_util_fav.fnc_nomeprodutodetalhado(idprodutodetalhado,favorita.pck_util_fav.fnc_retornaidiomausuario) PRODUTO
                      , quantidadetotal QUANTIDADE
                      , valorvenda  VENDA
                      , (valorvenda * quantidadetotal) VALORTOTAL
                      --, nome
                      --, valorcusto
                      , pedidos PEDIDOS
                  from ( select it.idprodutodetalhado
                              , it.idestoque
                              , it.valorcusto
                              , it.valorvenda
                              , sum(it.quantidade) quantidadetotal
                              , favorita.pck_util_fav.fnc_nomeproduto(it.idproduto,1,'N') nome
                              , nvl( ( select dep.skuvirtualage
                                       from favorita.deparaprodfavoritavirtualage dep
                                       where dep.idprodutodetalhado = it.idprodutodetalhado )
                                     , 6000000 + it.idprodutodetalhado ) skuvirtualage
                              , (listagg( it.idpedido,';') within group ( order by 1 desc)) pedidos
                         from favorita.itenspedidos it
                            , favorita.estoques     e
                         where it.idestoque       = e.idestoque
                           and e.idfilialfavorita = :P645_idfilialfavorita
                           and exists ( select 1
                                        from favorita.pedidosremessasct pr
                                        where pr.idcompratransferencia = :P645_IDCOMPRATRANSFERENCIA
                                          and pr.idpedido              = it.idpedido )
                         group by it.idprodutodetalhado
                                , it.idestoque
                                , it.valorcusto
                                , it.idproduto
                                , it.valorvenda)
                  where :P645_TIPO = 3
                   order by nome
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: item=value
            item: P645_TIPO
            value: 3
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
