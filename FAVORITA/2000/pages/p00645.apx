page 645 (
    name: CSV Remessa Pedido
    title: CSV Remessa Pedido
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region csv-remessa-pedido (
        name: CSV Remessa Pedido
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nvl( ( select dep.skuvirtualage
                                from favorita.deparaprodfavoritavirtualage dep
                               where dep.idprodutodetalhado = pd.idprodutodetalhado ), 6000000 + pd.idprodutodetalhado )||' - '||
                       favorita.pck_util_fav.fnc_nomeprodutodetalhado(itc.idprodutodetalhado,favorita.pck_util_fav.fnc_retornaidiomausuario) PRODUTO
                     , pd.codbarra COD_BARRAS
                     , itc.quantidadecomprada QTD
                     , trim(to_char(nvl(itc.quantidaderecebida, 0),'999G999G999G999G990D00')) QTD_RECEBIDA
                     , trim(to_char(nvl(itc.quantidadeavariada, 0),'999G999G999G999G990D00')) QTD_AVARIADA
                     , trim(to_char(nvl(itc.valorcusto,0),'999G999G999G999G990D00')) VALOR_CUSTO
                     , trim(to_char((nvl(itc.valorcusto,0) * nvl(itc.quantidadecomprada,0)),'999G999G999G999G990D00')) VALOR_TOTAL
                  from favorita.vw_itenscomprastransf_fav itc
                     , favorita.vw_produtosdetalhados_fav pd
                     , favorita.vw_produtos_fav p
                 where itc.idcompratransferencia = :P645_IDCOMPRATRANSFERENCIA --67342
                   and pd.idprodutodetalhado     = itc.idprodutodetalhado
                   and p.idproduto               = pd.idproduto
                   and (itc.quantidadecomprada    > 0 or itc.quantidadeavariada > 0 or itc.quantidadedevolvida > 0)
                   and itc.ididioma              = favorita.pck_util_fav.fnc_retornaidiomausuario
                   and pd.ididioma               = favorita.pck_util_fav.fnc_retornaidiomausuario
                   and p.ididioma                = favorita.pck_util_fav.fnc_retornaidiomausuario
                   and :P645_TIPO <> 3
                 order by 2,pd.ordem_grade;
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item!=value
            item: P645_TIPO
            value: 3
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            formats: [
                html
                csv
            ]
            sendAsEmail: false
        }
        advanced {
            savedReportMappingIdentifier: 3075363085308306831
        }

