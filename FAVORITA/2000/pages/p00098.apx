    region características-utilizadas (
        name: Características Utilizadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select vw.*
                     , case
                          when vw.automatico = 'N' then
                             '<a href="javascript:apex.confirm(''Deseja realmente exluir?'', { request:''EXCLUIRCARACTERISTICA'',set:{''P98_IDCLASSIFICACAOPEDIDO'':'||IDCLASSIFICACAOPEDIDO||'}})";><img src=/i/menu/pencil16x16.gif alt=Excluir Caract. border=0 width=16 height=16></a>'  
                          else
                             '-'
                          end excluir                       
                from vw_classificacoespedidos_fav vw
                where vw.idpedido = :P98_IDPEDIDO
                  and vw.ididioma = :P0_IDIDIOMA
                ```
        }
        layout {
            sequence: 25
            slot: contentBody
        }
