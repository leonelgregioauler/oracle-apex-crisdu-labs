    process adiciona-caracateristica-de-pontos-em-pedidos-de-pontos (
        name: Adiciona Caracateristica de pontos em pedidos de pontos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vmd5       varchar2(4000);
                  vdescricao varchar2(100) := 'pedido de pontos iniciado';
                  --
                  vidcaracteristica number := 5;
                  vidpedido         number;
                  --
                  vdataclassificado date;
                  --
                begin
                  --
                  pck_pedidos_fav.prc_iniciapreclassificacoes ( :P98_IDPEDIDO
                                                              , vidpedido
                                                              , :P0_IDUSUARIO
                                                              , vdataclassificado
                                                              , vidcaracteristica
                                                              , vdescricao
                                                              , 'I' );
                  --
                
                end;
                ```
        }
        execution {
            sequence: 60
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 123070433366019707
        }
        serverSideCondition {
            type: item=value
            item: P98_PEDIDOPONTOS
            value: S
        }
    )

    process consulta-as-características (
        name: Consulta as Características
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vtipofilial varchar(10);
                  --
                  cursor c1 is
                  select c.idcaracteristicapedido
                         , c.descricao
                  from caracteristicaspedidos c
                  where c.automatico = 'N'
                    and c.idcaracteristicapedido not in (74,78,106,105)
                    and not exists ( select 1                                                  
                                       from classificacoespedidos cp
                                       where cp.idcaracteristicapedido = c.idcaracteristicapedido 
                                       and cp.idpedido = :P98_IDPEDIDO )
                  UNION  
                  select c.idcaracteristicapedido
                         , c.descricao
                  from caracteristicaspedidos c
                  where c.automatico = 'N'
                    and c.idcaracteristicapedido = 74
                    and exists ( SELECT 1
                                 FROM tarefas t
                                 WHERE t.idsituacao = 10
                                   AND t.idtipotarefa in (8,47,51,68) 
                                   AND t.idusuario = :P0_IDUSUARIO)
                    and not exists ( select 1                                                  
                                     from classificacoespedidos cp
                                     where cp.idcaracteristicapedido = c.idcaracteristicapedido 
                                       and cp.idpedido = :P98_IDPEDIDO )
                  UNION  
                  select c.idcaracteristicapedido
                         , c.descricao
                  from caracteristicaspedidos c
                  where c.automatico = 'N'
                    and c.idcaracteristicapedido = 78
                    and exists ( SELECT 1
                                 FROM tarefas t
                                 WHERE t.idsituacao = 10
                                   AND t.idtipotarefa in (11,12,34,67) 
                                   AND t.idusuario = :P0_IDUSUARIO)
                    and not exists ( select 1                                                  
                                     from classificacoespedidos cp
                                     where cp.idcaracteristicapedido = c.idcaracteristicapedido 
                                       and cp.idpedido = :P98_IDPEDIDO )
                  UNION
                  select c.idcaracteristicapedido
                       , c.descricao
                  from caracteristicaspedidos c
                  where c.idcaracteristicapedido = 106
                    and exists (select 1
                                  from campanhasadimplencia a
                                 where a.idfilial = (select idfilialromance
                                                       from filiaisfavorita
                                                      where idfilialfavorita = :P0_IDFILIALFAVORITA) 
                                   and trunc(sysdate) between datainicio and datafim  )
                  order by 1 desc;					 
                  --
                  r1 c1%rowtype;
                  --          
                begin
                  --
                  delete from precaracteristicaspedidos;
                  --
                  open c1;
                  loop
                    fetch c1 into r1;
                    exit when c1%notfound;
                    --
                    select f.tipofilial
                    into vtipofilial
                    from usuarios u
                       , favorita.filiaisfavorita f
                    where u.idfilialfavorita = f.idfilialfavorita
                      and u.idusuario = :P0_IDUSUARIO;
                    --
                    if vtipofilial != 'L' and r1.idcaracteristicapedido = 73 then
                      --
                      --
                      null;
                      --
                    else
                      --
                      insert into precaracteristicaspedidos
                      values ( :P98_IDPEDIDO
                             , r1.idcaracteristicapedido
                             , r1.descricao
                             , null );
                      --
                    end if;
                  --
                  end loop;
                  close c1;
                  --
                  commit;
                  --
                end; 
                ```
        }
        execution {
            sequence: 50
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 578549318747147901
        }
    )

    process excluircaracteristica (
        name: EXCLUIRCARACTERISTICA
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  vidclassificacaopedido number := :P98_IDCLASSIFICACAOPEDIDO;
                  vidcupom               number;
                  vdataclassificacao     date := sysdate;
                  vobservacao            varchar2(1000);
                  vidcaracteristica      number;
                  videnderecoentrega     number;
                  vidusuario             number := :P0_IDUSUARIO;
                  vidpedido              number := :P98_IDPEDIDO;
                  vidvalorcaracteristica number;
                  vmd5                   VARCHAR2(1000);
                begin
                  --
                  pck_pedidos_fav.prc_classificacoespedidos( pidclassificacaopedido  => vidclassificacaopedido
                                                           , pidpedido               => vidpedido
                                                           , pdataclassificado       => vdataclassificacao
                                                           , pidusuario              => vidusuario
                                                           , pidcaracteristicapedido => vidcaracteristica
                                                           , pidvalorcaracteristica  => vidvalorcaracteristica
                                                           , pobservacao             => vobservacao
                                                           , poperacao_dml           => 'D'
                                                           , pmd5                    => vmd5); 
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 578522907175849943
        }
        serverSideCondition {
            type: request=Value
            value: EXCLUIRCARACTERISTICA
        }
    )

    process incluir-caracteristica-usuario-pedido (
        name: "Incluir Caracteristica Usuario Pedido "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidusuariopedido   number := :P98_IDUSUARIOPEDIDO;
                  vidusuarioatual    number := :P0_IDUSUARIO;
                  vidiniciaprepedido number := :P98_IDPEDIDO;
                  vdataclassificado  date := sysdate;
                  vidpedido          number := null;
                  --
                begin
                  --
                  if vidusuariopedido != vidusuarioatual then
                    --
                    pck_pedidos_fav.prc_iniciapreclassificacoes ( vidiniciaprepedido
                                                                , vidpedido
                                                                , :P0_IDUSUARIO
                                                                , vdataclassificado
                                                                , 81
                                                                , null
                                                                , 'I' );
                    --
                  end if;
                  --
                  :P98_IDPEDIDO := vidiniciaprepedido;
                  --
                end;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 890095359653824123
        }
        serverSideCondition {
            type: request=Value
            value: PROXIMO
        }
    )

    process insere-as-caracteristicas (
        name: Insere as Caracteristicas
        type: executeCode
        editableRegion: @características-pedidos
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  vidiniciaprepedido              number := :P98_IDPEDIDO;
                  vidpedido                       number := null;
                  vdataclassificado               date := sysdate;
                  --
                begin
                  --
                  if :P98_PAGINA in (68, 415) then
                    vidpedido := :P98_IDPEDIDO;
                  end if;
                  --
                  if v('REQUEST') = 'PROXIMO' then
                    --
                    pck_pedidos_fav.prc_iniciapreclassificacoes ( vidiniciaprepedido
                                                                , vidpedido
                                                                , :P0_IDUSUARIO
                                                                , vdataclassificado
                                                                , :IDCARACTERISTICAPEDIDO
                                                                , :OBSERVACAO
                                                                , 'I' );
                    --
                  end if;
                  --
                  :P98_IDPEDIDO := vidiniciaprepedido;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 578513881979682101
        }
    )

