page 23 (
    name: Relatório de Situações Entrega
    title: Situações Entrega
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region situações-entrega (
        name: Situações Entrega
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idsituacaoentrega
                     , ididioma
                     , descricaosistema
                     , textotraduzidointerno
                     , descricaosite
                     , textotraduzidoexterno
                     , codigocor
                     , reservaestoque
                     , c.idtextosistema
                     , c.idtextosite
                     , c.podeeditarpedido
                from vw_situacoesentrega_fav c
                where ididioma = :P0_IDIDIOMA
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 12826435776685404
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @TEXTOTRADUZIDOINTERNO
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @TEXTOTRADUZIDOEXTERNO
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @RESERVAESTOQUE
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @IDSITUACAOENTREGA
                layout {
                    width: 64
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDIDIOMA
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @CODIGOCOR
                layout {
                    width: 134
                    sequence: 2
                }
            )

            displayColumn (
                column: @DESCRICAOSISTEMA
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @DESCRICAOSITE
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @IDTEXTOSISTEMA
                layout {
                    width: 216
                    sequence: 5
                }
            )

            displayColumn (
                column: @IDTEXTOSITE
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @PODEEDITARPEDIDO
                layout {
                    sequence: 10
                }
            )

        )

        column CODIGOCOR (
            type: htmlExpression
            heading {
                heading: Código da Cor
                alignment: center
            }
            settings {
                htmlExpression: <font size="2" color="&CODIGOCOR.">&CODIGOCOR.</font>
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                databaseColumn: CODIGOCOR
                dataType: varchar2
            }
        )

        column DESCRICAOSISTEMA (
            type: textarea
            heading {
                heading: Descrição Sistema
            }
            layout {
                sequence: 60
            }
            validation {
                valueRequired: true
                maxLength: 200
            }
            source {
                databaseColumn: DESCRICAOSISTEMA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column DESCRICAOSITE (
            type: textarea
            heading {
                heading: Descrição Site
                alignment: center
            }
            layout {
                sequence: 80
            }
            validation {
                valueRequired: true
                maxLength: 200
            }
            source {
                databaseColumn: DESCRICAOSITE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column IDIDIOMA (
            type: hidden
            layout {
                sequence: 20
            }
            source {
                databaseColumn: IDIDIOMA
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDSITUACAOENTREGA (
            type: link
            heading {
                heading: Editar
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 24
                    items: {
                        P24_IDSITUACAOENTREGA: &IDSITUACAOENTREGA.
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                databaseColumn: IDSITUACAOENTREGA
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDTEXTOSISTEMA (
            type: link
            heading {
                heading: Tradução Sistema
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: center
            }
            link {
                target: {
                    page: 100
                    items: {
                        P100_IDTEXTOTRADUZIDO: &IDTEXTOSISTEMA.
                    }
                    action: resetPagination
                }
                linkText: <b>Visualizar / Atualizar texto traduzido</b>
                linkAttributes: class="t-Button t-Button--sucess"
            }
            source {
                databaseColumn: IDTEXTOSISTEMA
                dataType: number
            }
        )

        column IDTEXTOSITE (
            type: link
            heading {
                heading: Tradução Site
                alignment: center
            }
            layout {
                sequence: 120
                columnAlignment: center
            }
            link {
                target: {
                    page: 100
                    items: {
                        P100_IDTEXTOTRADUZIDO: &IDTEXTOSITE.
                    }
                    action: resetPagination
                }
                linkText: <b>Visualizar / Atualizar texto traduzido</b>
                linkAttributes: class="t-Button t-Button--sucess"
            }
            source {
                databaseColumn: IDTEXTOSITE
                dataType: number
            }
        )

        column PODEEDITARPEDIDO (
            type: selectList
            heading {
                heading: Pode Editar Pedido
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @lov-simnao
            }
            layout {
                sequence: 130
                columnAlignment: center
            }
            source {
                databaseColumn: PODEEDITARPEDIDO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column RESERVAESTOQUE (
            type: textField
            heading {
                heading: Reserva Estoque
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: center
            }
            validation {
                maxLength: 3
            }
            source {
                databaseColumn: RESERVAESTOQUE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column TEXTOTRADUZIDOEXTERNO (
            type: textarea
            heading {
                heading: Tradução Site
                alignment: center
            }
            layout {
                sequence: 90
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: TEXTOTRADUZIDOEXTERNO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column TEXTOTRADUZIDOINTERNO (
            type: textarea
            heading {
                heading: Tradução Sistema
                alignment: center
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: TEXTOTRADUZIDOINTERNO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @opções
            slot: top
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 24
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button novo-2 (
        buttonName: Novo
        label: Novo
        layout {
            sequence: 10
            region: @situações-entrega
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 24
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

