page 347 (
    name: Cheques Detalhados
    title: Cheques Detalhados
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 800
        height: 600
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cheques-detalhados (
        name: Cheques Detalhados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.codigo
                     , c.descricao 
                     , c.banco
                     , c.dataultimocheque
                     , c.origem
                     , c.quantidade
                from roman.chequesconsultaspc c
                where c.idconsultaspc = :P347_IDCONSULTASPC;
                
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum registro de cheque encontrado para essa consulta.
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 2437795531484210916
        }

        column BANCO (
            type: plainText
            heading {
                heading: Banco
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column CODIGO (
            type: plainText
            heading {
                heading: Código
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column DATAULTIMOCHEQUE (
            type: plainText
            heading {
                heading: Data Ultimo Cheque
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        column DESCRICAO (
            type: plainText
            heading {
                heading: Motivo
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column ORIGEM (
            type: plainText
            heading {
                heading: Origem
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column QUANTIDADE (
            type: plainText
            heading {
                heading: Quantidade
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        savedReport 24404833 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn BANCO (
                sequence: 3
            )

            displayColumn CODIGO (
                sequence: 1
            )

            displayColumn DATAULTIMOCHEQUE (
                sequence: 4
            )

            displayColumn DESCRICAO (
                sequence: 2
            )

            displayColumn ORIGEM (
                sequence: 5
            )

            displayColumn QUANTIDADE (
                sequence: 6
            )

        )

    )

    pageItem P347_IDCONSULTASPC (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @cheques-detalhados
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

