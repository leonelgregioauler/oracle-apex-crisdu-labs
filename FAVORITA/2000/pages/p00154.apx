    region aplicações-página (
        name: Aplicações (página)
        type: tabform
        source {
            sqlQuery:
                ```sql
                select idaplicacao
                     , descricao
                     , hierarquia
                     , descricao nivel_hierarquico
                     , nvl( ( select 'Já possui acesso!'
                                from roman.acessos b 
                               where b.idaplicacao = a.idaplicacao 
                                 and b.usuario = :P154_USUARIOS),'<font color="red">Não possui acesso!</font>') possuiacesso
                     , a.pagina
                     , idaplicacao id
                     , (select descricao from roman.tiposcontrolesaplicacoes tc where tc.idtiposcontroles = a.idtiposcontroles) idtiposcontroles
                     , usadonapagina
                     , observacao
                  from ( select a.idaplicacao
                              , a.descricao
                              , a.hierarquia
                              , a.pagina
                              , a.idtiposcontroles
                              , a.usadonapagina
                              , a.observacao
                           from roman.aplicacoes a 
                          where a.idsistema = 2000
                            and (a.usadonapagina = :P154_USADONAPAGINA or a.pagina = :P154_USADONAPAGINA)) a
                 order by 1
                
                ```
        }
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P154_USUARIOS is not null and :P154_USADONAPAGINA is not null
        }
        reportLayout {
            numberOfRows: 800
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: showAll
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Usuário com acesso total.
        }
        componentAdvanced {
            stripHtml: true
        }

