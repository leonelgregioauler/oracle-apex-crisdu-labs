page 154 (
    name: Controle de Acessos
    title: Controle de Acessos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region aplicações (
        name: Aplicações
        type: tabform
        source {
            sqlQuery:
                ```sql
                select idaplicacao
                      ,descricao
                      ,hierarquia
                      ,decode( hierarquia , null , '<b>'||LPAD('* ', 3 * (level - 1)) || TO_CHAR(replace(descricao,'?','a')) ||'</b>'
                                                 , DECODE(LEVEL , 2 , '<i>'||LPAD('* ', 3 * (level - 1)) || TO_CHAR(replace(descricao,'?','a'))||'</i>'
                                                                , 3 , '<i>'||LPAD('-> ', 3 * (level - 1)) || TO_CHAR(replace(descricao,'?','a'))||'</i>'
                                                                , TO_CHAR(replace(descricao,'?','a'))) ) nivel_hierarquico
                      , nvl( ( select 'Já possui acesso!'
                               from roman.acessos b 
                                where b.idaplicacao = a.idaplicacao 
                                  and b.usuario = :P154_USUARIOS),'<font color="red">Não possui acesso!</font>') possuiacesso
                      , pagina
                      , idaplicacao id
                      , (select descricao from roman.tiposcontrolesaplicacoes tc where tc.idtiposcontroles = a.idtiposcontroles) idtiposcontroles
                      , usadonapagina
                      , observacao
                  from ( select a.idaplicacao
                              , a.descricao
                              , a.hierarquia
                              , a.pagina
                              , a.idtiposcontroles
                              , a.usadonapagina
                              , a.observacao
                         from roman.aplicacoes a 
                         where a.idsistema = 2000
                         union
                         select a.idaplicacao
                              , a.descricao
                              , a.hierarquia
                              , a.pagina
                              , a.idtiposcontroles
                              , a.usadonapagina
                              , a.observacao
                         from roman.aplicacoes a 
                         where a.idsistema = 2000
                           and a.hierarquia is null
                         ORDER BY IDAPLICACAO) a
                 start with hierarquia is null
                connect by prior idaplicacao = hierarquia
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P154_USUARIOS is not null and :P154_USADONAPAGINA is null
        }
        reportLayout {
            numberOfRows: 800
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: showAll
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Usuário com acesso total.
        }
        componentAdvanced {
            stripHtml: true
        }

