    region controle (
        name: Controle
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
    )

    region copiar-acessos (
        name: Copiar Acessos
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P154_USUARIOS
        }
    )

    pageItem P154_USADONAPAGINA (
        type: textField
        label {
            label: Página
            alignment: left
        }
        layout {
            sequence: 20
            region: @controle
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P154_USUARIOS (
        type: selectOne
        label {
            label: Usuários
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct(initcap(usuario)) display_value
                     , usuario return_value 
                  from roman.usuariossistemas u 
                 where idsistema = 2000
                   and ativo = 'S'
                order by usuario;
                ```
        }
        layout {
            sequence: 10
            region: @controle
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P154_USUARIO_COPIAR (
        type: selectList
        label {
            label: Usuário que será Copiado
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct(initcap(usuario)) display_value
                     , usuario return_value 
                  from roman.usuariossistemas u 
                 where idsistema = 2000
                   and ativo = 'S'
                order by usuario;
                ```
        }
        layout {
            sequence: 10
            region: @copiar-acessos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button copiar (
        buttonName: COPIAR
        label: Copiar
        layout {
            sequence: 20
            region: @copiar-acessos
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button deletaracesso (
        buttonName: DELETARACESSO
        label: Deletar Acessos
        layout {
            sequence: 40
            region: @controle
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--danger
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button liberaracesso (
        buttonName: LIBERARACESSO
        label: Liberar Acesso
        layout {
            sequence: 30
            region: @controle
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-pencil
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction recarregar (
        name: Recarregar
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P154_USADONAPAGINA
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction recarregar-tela (
        name: Recarregar Tela
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P154_USUARIOS
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation valida-mesmo-usuario (
        name: Valida mesmo usuario
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P154_USUARIOS = :P154_USUARIO_COPIAR
                ```
        }
        error {
            errorMessage: Usuários iguais, verifique e tente novamente!
            associatedItem: @P154_USUARIO_COPIAR
        }
        serverSideCondition {
            type: request=Value
            value: COPIAR
        }
    )

    process copiar-os-acessos (
        name: Copiar os Acessos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  insert into roman.acessos ( idacesso,
                                        usuario,
                                        idaplicacao,
                                        ativo )
                  select roman.seq_idacessos.nextval
                       , :P154_USUARIOS
                       , a.idaplicacao
                       , 'S'
                  from roman.acessos a
                  where a.usuario = :P154_USUARIO_COPIAR
                    and not exists ( select 1
                                     from roman.acessos aa
                                     where aa.usuario = :P154_USUARIOS
                                       and aa.idaplicacao = a.idaplicacao )
                    and exists ( select 1
                                 from roman.aplicacoes ap
                                 where ap.idaplicacao = a.idaplicacao
                                   and ap.idsistema   = 2000 );
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Acessos Copiados.
        }
        advanced {
            executionMappingIdentifier: 2800696590858703241
        }
        serverSideCondition {
            type: request=Value
            value: COPIAR
        }
    )

    process deletar-acessos (
        name: Deletar Acessos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                vpedido number;
                begin
                 FOR i IN 1.. HTMLDB_APPLICATION.G_F01.COUNT 
                 loop
                   --
                   delete roman.acessos
                   where idaplicacao = HTMLDB_APPLICATION.G_F02(HTMLDB_APPLICATION.G_F01(i))
                     and usuario = :P154_USUARIOS;
                   --
                  END LOOP;
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Acessos removidos com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1412137498740681525
        }
        serverSideCondition {
            whenButtonPressed: @deletaracesso
        }
    )

    process liberaracesso (
        name: liberaracesso
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  vpedido number;
                begin
                  FOR i IN 1.. HTMLDB_APPLICATION.G_F01.COUNT 
                  loop
                    insert into roman.acessos (idacesso, usuario, idaplicacao, ativo)
                    values (roman.seq_idacessos.nextval, :P154_USUARIOS, HTMLDB_APPLICATION.G_F02(HTMLDB_APPLICATION.G_F01(i)), 'S');
                  END LOOP;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Acessos Liberados com sucesso!
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 30061528773885793
        }
        serverSideCondition {
            whenButtonPressed: @liberaracesso
        }
    )

    branch (
        name: Go To Page 154
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 154
            }
            saveStateBeforeBranching: true
        }
    )

    branch (
        execution {
            sequence: 11
        }
        behavior {
            target: {
                page: 154
                items: {
                    P154_USUARIOS: &P154_USUARIOS.
                    P154_USUARIO_COPIAR: &P154_USUARIO_COPIAR.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: COPIAR
        }
    )

)

