page 565 (
    name: Relatorio Diferencas Inventario - Por Filtro
    title: Relatorio Diferencas Inventario - Por Filtro
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1200
        height: 700
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region relatorio-diferencas-inventario-por-filtro (
        name: Relatorio Diferencas Inventario - Por Filtro
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(c.idfilial) Filial
                     , pck_util_fav.fnc_nomeusuario(c.idusuario) Usuario
                     , to_char(c.datacriacao,'dd/mm/rrrr') as "Criado em"
                     , to_char(c.dataencerramento,'dd/mm/rrrr') as "Encerrado em"
                     , pck_util_fav.fnc_nomeprodutodetalhado(i.idprodutodetalhado,1) Produto
                     , i.divfisicooptimus QtdDiv
                     , nvl(i.vlrCusto,0)  Custo
                     , i.divfisicooptimus * i.vlrcusto vlrDiv
                     , i.divfisicofiscal QtdDivFF
                     , i.divfisicofiscal * i.vlrcusto vlrDivFF
                  from inventarioCiclico        c
                     , itensInventarioCiclico   i
                     , tiposSituacoesInventario t
                 where c.idInventarioCiclico = i.idInventarioCiclico(+)
                   and c.idtiposituacao      = t.idtiposituacao
                   and i.divfisicooptimus != 0
                   and ( :P565_DATAINICIO is null or c.datacriacao between :P565_DATAINICIO and :P565_DATAFIM ) 
                   and ( nvl(:P565_SITUACAO,0) = 0 or c.idTipoSituacao = :P565_SITUACAO)
                   and ( :P565_IDFILIAL   is null  or c.idfilial       = :P565_IDFILIAL)
                   and ( :P565_IDUSUARIO  is null  or c.idusuario      = :P565_IDUSUARIO)
                                                            
                
                ```
            pageItemsToSubmit: [
                P565_IDFILIAL
                P565_DATAINICIO
                P565_DATAFIM
                P565_IDUSUARIO
                P565_SITUACAO
            ]
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 199799242497452398
        }

