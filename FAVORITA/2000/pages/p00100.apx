page 100 (
    name: Textos Traduzidos
    title: Textos Traduzidos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 55%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fechajanela () 
              {
                 vurl = document.getElementById("P100_SESSAO").value;
                 pjan = window.close();
                  
              }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
    )

    region textos-traduzidos (
        name: Textos Traduzidos
        type: tabform
        source {
            sqlQuery:
                ```sql
                select rowid
                     , idtextotraduzido
                     , ididioma
                     , textotraduzido
                from textostraduzidos
                where (:P100_IDTEXTOTRADUZIDO is null or idtextotraduzido = :P100_IDTEXTOTRADUZIDO)
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Não encontrou informações.
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 5
            derivedColumn: Y
            type: hidden
            layout {
                sequence: 1
            }
        )

        column IDIDIOMA (
            reportColumnQueryId: 3
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Idioma
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @lov-idiomas
            }
            layout {
                sequence: 4
            }
        )

        column IDTEXTOTRADUZIDO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 3
            }
        )

        column ROWID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column TEXTOTRADUZIDO (
            reportColumnQueryId: 4
            derivedColumn: N
            type: textField
            heading {
                heading: Texto Traduzido
                alignment: center
            }
            layout {
                sequence: 5
            }
            appearance {
                width: 100
            }
        )

    )

    pageItem P100_IDTEXTOTRADUZIDO (
        type: numberField
        label {
            label: Idtextotraduzido
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P100_SESSAO (
        type: textField
        label {
            label: Sessao
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_url varchar2(2000);
                    l_app number := 2000;
                    l_session number := v('APP_SESSION');
                BEGIN
                    l_url := APEX_UTIL.PREPARE_URL(
                        p_url => 'f?p=' || l_app || ':100:'||l_session||'::NO:::',
                        p_checksum_type => 'SESSION');
                    
                    return l_url;
                END;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 10
            region: @textos-traduzidos
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:fechajanela();
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Atualizar
        layout {
            sequence: 20
            region: @textos-traduzidos
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation ididioma-must-be-numeric (
        name: IDIDIOMA must be numeric
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @textos-traduzidos
            type: columnIsNumeric
            column: IDIDIOMA
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: IDIDIOMA
        }
        serverSideCondition {
            whenButtonPressed: @inserir
        }
    )

    validation idtextotraduzido-must-be-numeric (
        name: IDTEXTOTRADUZIDO must be numeric
        execution {
            sequence: 20
        }
        validation {
            editableRegion: @textos-traduzidos
            type: columnIsNumeric
            column: IDTEXTOTRADUZIDO
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: IDTEXTOTRADUZIDO
        }
        serverSideCondition {
            whenButtonPressed: @inserir
        }
    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @textos-traduzidos
        target {
            tableName: TEXTOSTRADUZIDOS
            pkColumn: ROWID
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: #MRD_COUNT# registro(s) excluído(s).
        }
        error {
            errorMessage: Não é possível excluir este registro pois existe outra informação associada com esta sendo utilizada no sistema.
        }
        advanced {
            executionMappingIdentifier: 6990555148931509
        }
        serverSideCondition {
            type: request=Value
            value: MULTI_ROW_DELETE
            executeCondition: once
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @textos-traduzidos
        target {
            tableName: TEXTOSTRADUZIDOS
            pkColumn: ROWID
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# registro(s) atualizado(s), #MRI_COUNT# registros(s) inserido(s).
        }
        error {
            errorMessage: Informações incorretas.
        }
        advanced {
            executionMappingIdentifier: 6990120177931509
        }
        serverSideCondition {
            whenButtonPressed: @inserir
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 100
            }
        }
        serverSideCondition {
            whenButtonPressed: @inserir
        }
    )

)

