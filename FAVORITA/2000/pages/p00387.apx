page 387 (
    name: Novo Pedágio
    title: Novo Pedágio
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region botões (
        name: Botões
        type: staticContent
        layout {
            sequence: 40
            slot: contentBody
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region novo-pedágio (
        name: Novo Pedágio
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
            column: 2
            columnSpan: 10
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--stacked
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region tipo-de-relatório (
        name: Tipo de Relatório
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
            column: 2
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNull
            item: P387_IDPEDAGIOREVISTA
        }
    )

    pageItem P387_DATAFINAL (
        type: datePickerJquery
        label {
            label: Data Final
            alignment: left
        }
        layout {
            sequence: 70
            region: @novo-pedágio
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr
            width: 10
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P387_DATAINICIAL (
        type: datePickerJquery
        label {
            label: Data Inicial
            alignment: left
        }
        layout {
            sequence: 60
            region: @novo-pedágio
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr
            width: 10
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P387_IDEDICAOREVISTA (
        type: selectList
        label {
            label: Edição da Revista
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.numeroedicao ||' - '||e.nome showvalue
                     , e.idedicaorevista retunrvalue
                  from favorita.edicoesrevistas e
                 where e.tipovenda in ('R','L')
                   and e.idpais = :P387_IDPAIS
                 order by e.numeroedicao desc
                  
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P387_IDPAIS
        }
        layout {
            sequence: 40
            region: @novo-pedágio
            slot: regionBody
            alignment: left
            columnSpan: 5
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P387_IDFILIALROMANCEPRECO (
        type: selectList
        label {
            label: Filial Base para o Preço
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                  from roman.vw_filiais f, edicoesrevistas er 
                 where f.idfilial in (select distinct idfilialromance
                                        from precosprodutos
                                       where idedicaorevista = :P387_IDEDICAOREVISTA)
                   and f.ididioma = er.idpais
                   and tipofilial in ('C', 'D','T')
                   and ativo = 'S'
                   and er.idedicaorevista = :P387_IDEDICAOREVISTA
                 order by 1 
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P387_IDEDICAOREVISTA
        }
        layout {
            sequence: 50
            region: @novo-pedágio
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P387_IDPAIS (
        type: selectList
        label {
            label: País
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pa.nome showvalue
                     , pa.idpais retunrvalue
                  from catal.paises pa
                 order by pa.nome
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 30
            region: @novo-pedágio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

