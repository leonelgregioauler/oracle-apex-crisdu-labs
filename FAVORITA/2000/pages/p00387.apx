    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 30
            region: @botões
            slot: delete
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P387_IDPEDAGIOREVISTA
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 10
            region: @botões
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--simple
                t-Button--iconRight
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P387_IDPEDAGIOREVISTA
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 20
            region: @botões
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P387_IDPEDAGIOREVISTA
        }
    )

    process consulta-pedagios-revistas (
        name: Consulta Pedagios Revistas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vdata             date;
                  vvarchar          varchar(50);
                  vdml              varchar(50):='S';
                  --
                Begin
                  --
                  pck_pedagiosrevistas_fav.prc_pedagiosrevistas ( pidpedagiorevista   => :P387_IDPEDAGIOREVISTA
                                                                , pnomepedagiorevista => :P387_NOMEPEDAGIOREVISTA
                                                                , pidpais             => :P387_IDPAIS
                                                                , pdatainicial        => :P387_DATAINICIAL
                                                                , pdatafinal          => :P387_DATAFINAL
                                                                , pidedicaorevista    => :P387_IDEDICAOREVISTA
                                                                , pidusaurio          => :P0_IDUSUARIO
                                                                , pdatacriado         => vdata
                                                                , pperinadimplencia   => :P387_PERINADIMPLENCIA
                                                                , pperimpostos        => :P387_PERIMPOSTOS
                                                                , pperoperacao        => :P387_PEROPERACAO
                                                                , pmd5                => vvarchar
                                                                , poperacao_dml       => vdml  );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1544240854845967618
        }
    )

    process criação-dos-pedagios-da-revista (
        name: Criação dos pedagios da Revista
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if v('REQUEST') = 'INSERIR' then
                    if :P387_RELATORIONOVO = 'S' then
                        pck_pedagiosrevistas_fav.prc_criapedagiorevista2 ( pidpais           => :P387_IDPAIS
                                                                         , pnomerevista      => :P387_NOMEPEDAGIOREVISTA
                                                                         , pdatainicial      => :P387_DATAINICIAL
                                                                         , pdatafinal        => :P387_DATAFINAL
                                                                         , pidedicaorevista  => :P387_IDEDICAOREVISTA
                                                                         , pidfilialromancepreco => :P387_IDFILIALROMANCEPRECO
                                                                         , pidusaurio        => :P0_IDUSUARIO
                                                                         , pperinadimplencia => :P387_PERINADIMPLENCIA
                                                                         , pperimpostos      => :P387_PERIMPOSTOS
                                                                         , pperoperacao      => :P387_PEROPERACAO
                                                                         , pididioma         => :P0_IDIDIOMA
                                                                         , pidpedagiorevista => :P387_IDPEDAGIOREVISTA);
                    else
                        pck_pedagiosrevistas_fav.prc_criapedagiorevista  ( pidpais           => :P387_IDPAIS
                                                                         , pnomerevista      => :P387_NOMEPEDAGIOREVISTA
                                                                         , pdatainicial      => :P387_DATAINICIAL
                                                                         , pdatafinal        => :P387_DATAFINAL
                                                                         , pidedicaorevista  => :P387_IDEDICAOREVISTA
                                                                         , pidusaurio        => :P0_IDUSUARIO
                                                                         , pperinadimplencia => :P387_PERINADIMPLENCIA
                                                                         , pperimpostos      => :P387_PERIMPOSTOS
                                                                         , pperoperacao      => :P387_PEROPERACAO
                                                                         , pididioma         => :P0_IDIDIOMA
                                                                         , pidpedagiorevista => :P387_IDPEDAGIOREVISTA);
                
                    end if;    
                  end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1544435726952845041
        }
        serverSideCondition {
            whenButtonPressed: @inserir
        }
    )

    process deletar-pedagio-revista (
        name: Deletar Pedagio Revista
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                  vnumber           number;
                  vdata             date;
                  vvarchar          varchar(50);
                begin
                  if v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                      pck_pedagiosrevistas_fav.prc_pedagiosrevistas ( pidpedagiorevista   => :P387_IDPEDAGIOREVISTA
                                                                    , pnomepedagiorevista => vvarchar
                                                                    , pidpais             => vnumber
                                                                    , pdatainicial        => vdata
                                                                    , pdatafinal          => vdata
                                                                    , pidedicaorevista    => vnumber
                                                                    , pidusaurio          => vnumber
                                                                    , pdatacriado         => vdata
                                                                    , pperinadimplencia   => vnumber
                                                                    , pperimpostos        => vnumber
                                                                    , pperoperacao        => vnumber
                                                                    , pmd5                => vvarchar
                                                                    , poperacao_dml       => voperacao_dml  );
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 1544240653814967616
        }
        serverSideCondition {
            whenButtonPressed: @excluir
        }
    )

    process limpar-campos (
        name: Limpar Campos
        type: clearSessionState
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 1544240734223967617
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 386
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @inserir
        }
    )

)

