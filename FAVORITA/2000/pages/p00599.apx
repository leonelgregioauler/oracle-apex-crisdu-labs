page 599 (
    name: Cadastro de Perfil
    title: Cadastro de Perfil
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }

    region cadastro-de-perfil (
        name: Cadastro de Perfil
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    region liberar-acessos (
        name: Liberar Acessos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select x.idaplicacao
                      ,x.descricao
                      ,x.hierarquia
                      ,decode( hierarquia , null , '<b>'||LPAD('* ', 3 * (level - 1)) || TO_CHAR(descricao) ||'</b>'
                                                 , DECODE(LEVEL , 2 , '<i>'||LPAD('* ', 3 * (level - 1)) || TO_CHAR(descricao)||'</i>'
                                                                , 3 , '<i>'||LPAD('-> ', 3 * (level - 1)) || TO_CHAR(descricao)||'</i>') ) nivel_hierarquico
                      , apex_item.CHECKBOX2(2,x.idaplicacao, null)CHECK1
                  from ( select a.idaplicacao
                              , a.descricao
                              , a.hierarquia
                         from roman.aplicacoes a 
                         where a.idsistema = 2000
                           and not exists ( select 1 
                                            from roman.perfilacesso p
                                            where p.idaplicacao = a.idaplicacao
                                              and p.idperfil = :P599_IDPERFIL )
                         union
                         select a.idaplicacao
                              , a.descricao
                              , a.hierarquia
                         from roman.aplicacoes a 
                         where a.idsistema = 2000
                           and a.hierarquia is null
                         ORDER BY IDAPLICACAO) x
                 start with x.hierarquia is null
                connect by prior x.idaplicacao = x.hierarquia
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P599_IDPERFIL
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 574603950906428436
        }

        column CHECK1 (
            type: plainText
            heading {
