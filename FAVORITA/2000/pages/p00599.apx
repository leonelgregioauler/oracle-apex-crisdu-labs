    process altera-perfil (
        name: Altera Perfil
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                 --
                   if v('REQUEST') = 'SAVE' then 
                    --
                     update roman.perfil p
                        set p.descricao = :P599_DESCRICAO
                      where p.idperfil = :P599_IDPERFIL;
                    --
                   end if;
                end;
                  
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Perfil Alterado com Sucesso!
        }
        advanced {
            executionMappingIdentifier: 575282013544314305
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process deletar-perfil (
        name: Deletar Perfil
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                 --
                   if v('REQUEST') = 'DELETE' then 
                    --
                     delete roman.perfilacesso pf
                      where pf.idperfil = :P599_IDPERFIL;
                     --
                     delete roman.perfil p
                      where p.idsistema = 2000
                        and p.idperfil = :P599_IDPERFIL;
                    --
                   end if;
                end;
                  
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Perfil Deletado com Sucesso!
        }
        advanced {
            executionMappingIdentifier: 575281649419314301
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process fetch-row-from-perfil (
        name: Fetch Row from PERFIL
        type: autoRowFetch
        source {
            tableOwner: ROMAN
            tableName: PERFIL
            pkColumn: IDPERFIL
            pkItem: P599_IDPERFIL
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 573072214422347806
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P599_IDPERFIL is null then
                        select roman.seq_idperfil.nextval
                          into :P599_IDPERFIL
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 573075129295347835
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process insere-perfil (
        name: Insere Perfil
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                   --
                    if v('REQUEST') = 'CREATE' then
                    --
                    insert into roman.perfil(idperfil ,descricao, idsistema)
                    values (:P599_IDPERFIL, :P599_DESCRICAO, :P599_IDSISTEMA);
                   --
                   end if;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Perfil Inserido com Sucesso!
        }
        advanced {
            executionMappingIdentifier: 575281875276314303
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process libera-acesso (
        name: libera acesso
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                vpedido number;
                begin
                 FOR i IN 1.. APEX_APPLICATION.G_F02.COUNT 
                 loop
                
                    insert into roman.perfilacesso (idperfilacesso, idperfil, idaplicacao)
                    values (roman.seq_idperfilacesso.nextval, :P599_IDPERFIL , APEX_APPLICATION.G_F02(i));
                
                  END LOOP;
                end;
                
                
                
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 573075495544347838
        }
    )

    branch (
        name: Go To Page 597
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 597
                clearCache: 597
                action: resetPagination
            }
        }
