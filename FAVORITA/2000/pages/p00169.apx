    pageItem P169_ATENDENTE (
        type: selectList
        label {
            label: Atendente
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeusuario(u.idusuario) display_value
                     , u.idusuario return_value
                from usuarios u
                where exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.usuario = u.usuario 
                                 and ug.idgrupoatendimento = :P169_IDGRUPOATENDIMENTO )
                  and exists ( select 1
                               from pedidos p
                               where p.idusuario = u.idusuario )
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P169_IDGRUPOATENDIMENTO
            itemsToSubmit: P169_ATENDENTE
