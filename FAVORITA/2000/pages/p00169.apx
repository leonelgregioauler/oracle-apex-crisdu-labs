    region vendas-de-kit-antigo-desativado (
        name: Vendas de Kit (ANTIGO - DESATIVADO)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeusuario(ped.idusuario) idusuario
                     , ped.dataemissao 
                     --
                     , sum(qtdpedido)
                     , sum(valorvenda*qtdpedido)
                     , sum(valoratendente*qtdpedido)
                from ( select p.idusuario
                            , ip.idkitvenda
                            , trunc(p.dataemissao) dataemissao	
                            , nvl(( select sum(distinct(quantidade))
                                    from itenspedidos i 
                                       , pedidos ped
                                    where i.idpedido = ped.idpedido
                                      and i.idpedido = p.idpedido
                                      and i.idkitvenda = :P169_IDKITVENDA
                                      and i.idkitvenda not in (90, 91, 92, 93)
                                      and ped.idusuario = p.idusuario ),0) qtdpedido
                            , ( select sum(distinct(pk.valorvenda))
                                from itenspedidos i
                                   , pedidos ped
                                   , itenskitsvendas ik
                                   , precositenskitsvendas pk
                                where i.idpedido        = ped.idpedido
                                  and i.idpedido        = p.idpedido
                                  and ik.idkitvenda     = i.idkitvenda
                                  and ik.iditemkitvenda = pk.iditemkitvenda
                                  and pk.idedicaorevista= p.idedicaorevista
                                  and i.idkitvenda      = :P169_IDKITVENDA
                                  and i.idkitvenda      not in (90, 91, 92, 93)
                                  and ped.idusuario     = p.idusuario ) valorvenda
                            , ( select sum(distinct(pk.valorcomissaoatendente))
                                from itenspedidos i
                                   , pedidos ped
                                   , itenskitsvendas ik
                                   , precositenskitsvendas pk
                                where i.idpedido        = ped.idpedido
                                  and i.idpedido        = p.idpedido
                                  and ik.idkitvenda     = i.idkitvenda
                                  and ik.iditemkitvenda = pk.iditemkitvenda
                                  and pk.idedicaorevista= p.idedicaorevista
                                  and i.idkitvenda = :P169_IDKITVENDA
                                  and i.idkitvenda not in (90, 91, 92, 93)
                                  and ped.idusuario     = p.idusuario) valoratendente
                       from pedidos p
                           , itenspedidos ip
                       where p.idpedido = ip.idpedido
                         and trunc(p.dataemissao) between to_date(:P169_DATAINICIO,'DD/MM/RRRR') and to_date(:P169_DATAFIM,'DD/MM/RRRR') 
                         and ( :P169_ATENDENTE is null or p.idusuario = :P169_ATENDENTE )
                         and ( :P169_IDFILIALORIGEM is null or p.idfilialfavorita = :P169_IDFILIALORIGEM )
                         and exists ( select 1 
                                      from itenspedidos i
                                      where i.idpedido = p.idpedido
                                        and i.idkitvenda = :P169_IDKITVENDA ) 
                         and (:P169_IDFILIALROMANCE is null or :P169_IDFILIALROMANCE = p.idfilialromance) ) ped
                   where ped.idkitvenda not in (90, 91, 92, 93)
                group by idusuario
                       , dataemissao
                union
                select pck_util_fav.fnc_nomeusuario(ped.idusuario) idusuario
                     , ped.dataemissao 
                     --
                     , sum(qtdpedido)
                     , sum(valorvenda*qtdpedido)
                     , sum(valoratendente*qtdpedido)
                from ( select p.idusuario
                            , ip.idkitvenda
                            , trunc(p.dataemissao) dataemissao	
                            , nvl(( select count(distinct(idkitvenda)) / 8
                                    from itenspedidos i 
                                       , pedidos ped
                                    where i.idpedido = ped.idpedido
                                      and i.idpedido = p.idpedido
                                      and i.idkitvenda = :P169_IDKITVENDA
                                      and i.idkitvenda in (90, 93)
                                      and ped.idusuario = p.idusuario ),0) qtdpedido
                            , ( select sum(sum(pk.valorvenda) * ik.quantidade) / 8
                                from itenspedidos i
                                   , pedidos ped
                                   , itenskitsvendas ik
                                   , precositenskitsvendas pk
                                where i.idpedido        = ped.idpedido
                                  and i.idpedido        = p.idpedido
                                  and ik.idkitvenda     = i.idkitvenda
                                  and ik.iditemkitvenda = pk.iditemkitvenda
                                  and pk.idedicaorevista= p.idedicaorevista
                                  and i.idkitvenda      = :P169_IDKITVENDA
                                  and i.idkitvenda      in (90, 93)
                                  and ped.idusuario     = p.idusuario
                                 group by ik.quantidade) valorvenda
                            , ( select sum(pk.valorcomissaoatendente) / 8
                                from itenspedidos i
                                   , pedidos ped
                                   , itenskitsvendas ik
                                   , precositenskitsvendas pk
                                where i.idpedido         = ped.idpedido
                                  and i.idpedido         = p.idpedido
                                  and ik.idkitvenda      = i.idkitvenda
                                  and ik.iditemkitvenda  = pk.iditemkitvenda
                                  and pk.idedicaorevista = p.idedicaorevista
                                  and i.idkitvenda       = :P169_IDKITVENDA
                                  and i.idkitvenda       in (90, 93)
                                  and ped.idusuario      = p.idusuario) valoratendente
                       from pedidos p
                           , itenspedidos ip
                       where p.idpedido = ip.idpedido
                         and trunc(p.dataemissao) between to_date(:P169_DATAINICIO,'DD/MM/RRRR') and to_date(:P169_DATAFIM,'DD/MM/RRRR') 
                         and ( :P169_ATENDENTE is null or p.idusuario = :P169_ATENDENTE )
                         and ( :P169_IDFILIALORIGEM is null or p.idfilialfavorita = :P169_IDFILIALORIGEM )
                         and exists ( select 1 
                                      from itenspedidos i
                                      where i.idpedido = p.idpedido
                                        and i.idkitvenda = :P169_IDKITVENDA ) 
                         and (:P169_IDFILIALROMANCE is null or :P169_IDFILIALROMANCE = p.idfilialromance) ) ped
                   where ped.idkitvenda in (90, 93)
                group by idusuario
                       , dataemissao
                union
                select pck_util_fav.fnc_nomeusuario(ped.idusuario) idusuario
                     , ped.dataemissao 
                     --
                     , sum(qtdpedido)
                     , sum(valorvenda*qtdpedido)
                     , sum(valoratendente*qtdpedido)
                from ( select p.idusuario
                            , ip.idkitvenda
                            , trunc(p.dataemissao) dataemissao	
                            , nvl(( select count(distinct(idkitvenda)) / 54
                                    from itenspedidos i 
                                       , pedidos ped
                                    where i.idpedido = ped.idpedido
                                      and i.idpedido = p.idpedido
                                      and i.idkitvenda = :P169_IDKITVENDA
                                      and i.idkitvenda in (91)
                                      and ped.idusuario = p.idusuario ),0) qtdpedido
                            , ( select sum(sum(pk.valorvenda) * ik.quantidade) / 54
                                from itenspedidos i
                                   , pedidos ped
                                   , itenskitsvendas ik
                                   , precositenskitsvendas pk
                                where i.idpedido        = ped.idpedido
                                  and i.idpedido        = p.idpedido
                                  and ik.idkitvenda     = i.idkitvenda
                                  and ik.iditemkitvenda = pk.iditemkitvenda
                                  and pk.idedicaorevista= p.idedicaorevista
                                  and i.idkitvenda      = :P169_IDKITVENDA
                                  and i.idkitvenda      in (91)
                                  and ped.idusuario     = p.idusuario
                                 group by ik.quantidade) valorvenda
                            , ( select sum(pk.valorcomissaoatendente) / 54
                                from itenspedidos i
                                   , pedidos ped
                                   , itenskitsvendas ik
                                   , precositenskitsvendas pk
                                where i.idpedido         = ped.idpedido
                                  and i.idpedido         = p.idpedido
                                  and ik.idkitvenda      = i.idkitvenda
                                  and ik.iditemkitvenda  = pk.iditemkitvenda
                                  and pk.idedicaorevista = p.idedicaorevista
                                  and i.idkitvenda       = :P169_IDKITVENDA
                                  and i.idkitvenda       in (91)
                                  and ped.idusuario      = p.idusuario) valoratendente
                       from pedidos p
                           , itenspedidos ip
                       where p.idpedido = ip.idpedido
                         and trunc(p.dataemissao) between to_date(:P169_DATAINICIO,'DD/MM/RRRR') and to_date(:P169_DATAFIM,'DD/MM/RRRR') 
                         and ( :P169_ATENDENTE is null or p.idusuario = :P169_ATENDENTE )
                         and ( :P169_IDFILIALORIGEM is null or p.idfilialfavorita = :P169_IDFILIALORIGEM )
                         and exists ( select 1 
                                      from itenspedidos i
                                      where i.idpedido = p.idpedido
                                        and i.idkitvenda = :P169_IDKITVENDA ) 
                         and (:P169_IDFILIALROMANCE is null or :P169_IDFILIALROMANCE = p.idfilialromance) ) ped
                   where ped.idkitvenda in (91) 
                group by idusuario
                       , dataemissao
                union 
                select pck_util_fav.fnc_nomeusuario(ped.idusuario) idusuario
                     , ped.dataemissao 
                     --
                     , sum(qtdpedido)
                     , sum(valorvenda*qtdpedido)
                     , sum(valoratendente*qtdpedido)
                from ( select p.idusuario
                            , ip.idkitvenda
                            , trunc(p.dataemissao) dataemissao	
                            , nvl(( select count(distinct(idkitvenda)) / 5
                                    from itenspedidos i 
                                       , pedidos ped
                                    where i.idpedido = ped.idpedido
                                      and i.idpedido = p.idpedido
                                      and i.idkitvenda = :P169_IDKITVENDA
                                      and i.idkitvenda in (92)
                                      and ped.idusuario = p.idusuario ),0) qtdpedido
                            , ( select sum(sum(pk.valorvenda) * ik.quantidade) / 5
                                from itenspedidos i
                                   , pedidos ped
                                   , itenskitsvendas ik
                                   , precositenskitsvendas pk
                                where i.idpedido        = ped.idpedido
                                  and i.idpedido        = p.idpedido
                                  and ik.idkitvenda     = i.idkitvenda
                                  and ik.iditemkitvenda = pk.iditemkitvenda
                                  and pk.idedicaorevista= p.idedicaorevista
                                  and i.idkitvenda      = :P169_IDKITVENDA
                                  and i.idkitvenda      in (92)
                                  and ped.idusuario     = p.idusuario
                                 group by ik.quantidade) valorvenda
                            , ( select sum(pk.valorcomissaoatendente) / 5
                                from itenspedidos i
                                   , pedidos ped
                                   , itenskitsvendas ik
                                   , precositenskitsvendas pk
                                where i.idpedido         = ped.idpedido
                                  and i.idpedido         = p.idpedido
                                  and ik.idkitvenda      = i.idkitvenda
                                  and ik.iditemkitvenda  = pk.iditemkitvenda
                                  and pk.idedicaorevista = p.idedicaorevista
                                  and i.idkitvenda       = :P169_IDKITVENDA
                                  and i.idkitvenda       in (92)
                                  and ped.idusuario      = p.idusuario) valoratendente
                       from pedidos p
                           , itenspedidos ip
                       where p.idpedido = ip.idpedido
                         and trunc(p.dataemissao) between to_date(:P169_DATAINICIO,'DD/MM/RRRR') and to_date(:P169_DATAFIM,'DD/MM/RRRR') 
                         and ( :P169_ATENDENTE is null or p.idusuario = :P169_ATENDENTE )
                         and ( :P169_IDFILIALORIGEM is null or p.idfilialfavorita = :P169_IDFILIALORIGEM )
                         and exists ( select 1 
                                      from itenspedidos i
                                      where i.idpedido = p.idpedido
                                        and i.idkitvenda = :P169_IDKITVENDA ) 
                         and (:P169_IDFILIALROMANCE is null or :P169_IDFILIALROMANCE = p.idfilialromance) ) ped
                   where ped.idkitvenda in (92) 
                group by idusuario
                       , dataemissao;
                ```
        }
