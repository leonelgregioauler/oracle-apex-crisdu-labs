    region kit-de-confecção (
        name: Kit de Confecção
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeusuario(ped.idusuario) idusuario
                     , pck_util_fav.fnc_nomerepresentante(ped.idrepresentante) as "Representante"
                     , pck_util_fav.fnc_nomefilialromance(ped.idfilialromance) as "Filial Romance"
                     , ped.numeropedido "N° Pedido"
                     , ped.dataemissao 
                     --
                     , sum(qtdpedido) qtdpedido
                     , sum(valorvenda) valorvenda
                     , sum(valorvenda_conv) valorvenda_conv
                     , sum(valorapagar) valorapagar
                     , sum(valorapagar_conv) valorapagar_conv
                     , sum(valoratendente) valoratendente
                     , sum(valoratendente_conv) valoratendente_conv
                     , datacancelamento 
                from ( select p.idusuario
                            , p.idfilialromance 
                            , ip.idkitvenda
                            , p.idrepresentante  
                            , p.idpedido
                            , trunc(p.dataemissao) dataemissao  
                            , (sum(ip.quantidade)/count(ip.iditempedido)) qtdpedido 
                            , sum(ip.valorvenda * ip.quantidade) valorvenda
                            , sum((ip.valorvenda * ip.quantidade) * p.fatorconversao) valorvenda_conv
                            , sum(ip.valorapagar * ip.quantidade) valorapagar
                            , sum((ip.valorapagar * ip.quantidade) * p.fatorconversao) valorapagar_conv
                            , sum(ip.valorcomissaoatendente) valoratendente
                            , sum((ip.valorcomissaoatendente) * p.fatorconversao) valoratendente_conv
                            , p.datacancelamento 
                            , p.numeropedido
                       from pedidos p
                           , itenspedidos ip
                       where p.idpedido = ip.idpedido
                         and trunc(p.dataemissao) between to_date(:P169_DATAINICIO,'DD/MM/RRRR') and to_date(:P169_DATAFIM,'DD/MM/RRRR')
                         and ( :P169_ATENDENTE is null or p.idusuario = :P169_ATENDENTE )
                         and ip.idkitproduto = :P169_IDKITPRODUTO
                         and ( :P169_IDFILIALORIGEM  is null or p.idfilialfavorita    = :P169_IDFILIALORIGEM )
                         and ( :P169_IDFILIALROMANCE is null or :P169_IDFILIALROMANCE = p.idfilialromance    ) 
                         and ( (:P169_PEDIDOPROSPECCAO = 'T')
                            or (:P169_PEDIDOPROSPECCAO = 'N' and not exists ( select 1
                                                                              from favorita.classificacoespedidos cp
                                                                              where cp.idpedido = p.idpedido
                                                                               and cp.idcaracteristicapedido = 74 ) )  
                            or (:P169_PEDIDOPROSPECCAO = 'S' and exists ( select 1
                                                                          from favorita.classificacoespedidos cp
                                                                          where cp.idpedido = p.idpedido
                                                                           and cp.idcaracteristicapedido = 74 ) ) )
                         and ( :P169_PEDIDOS_PAGOS = 'T'
                           or ( :P169_PEDIDOS_PAGOS = 'N' and exists ( select 1
                                                                       from vencimentospedidos v
                                                                       where v.situacaovencimento = 'V'
                                                                         and v.idpedido           = p.idpedido
                                                                         and v.valorpago         != v.valorpagar ) )
                           or ( :P169_PEDIDOS_PAGOS = 'S' and exists ( select 1
                                                                       from vencimentospedidos v
                                                                       where v.situacaovencimento = 'V'
                                                                         and v.idpedido           = p.idpedido
                                                                         and v.valorpago         >= v.valorpagar ) ) )
                         group by p.idusuario, p.idrepresentante, ip.idkitvenda, p.idpedido, p.dataemissao, datacancelamento, idfilialromance, p.numeropedido ) ped  
                group by idusuario
                       , ped.idrepresentante
                       , idfilialromance
                       , ped.numeropedido
                       , dataemissao
                       , datacancelamento;   
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P169_TIPOPRODUTO
            value: KC
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 3736780835612233
        }

