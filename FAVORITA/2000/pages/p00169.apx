    region total-kit-de-confecção (
        name: Total Kit de Confecção
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomefilialromance(ped.idfilialromance) romance
                      , favorita.pck_util_fav.fnc_nomerepresentante(ped.idrepresentante) representante
                      , favorita.pck_util_fav.fnc_nomeusuario(ped.idusuario) idusuario
                      , ped.numeropedido "N° Pedido"
                      , ped.dataemissao 
                      , qtde
                      , sum(valorvenda) vlrvenda
                      , sum(valorvenda_conv) vlrvenda_conv
                      , sum(valorapagar) valorapagar
                      , sum(valorapagar_conv) valorapagar_conv
                      , sum(valoratendente) vlratende
                      , sum(valoratendente_conv) vlratende_conv
                      , datacancelamento
                from ( select p.idrepresentante
                            , p.idusuario
                            , p.idfilialromance 
                            , p.idpedido
                            , trunc(p.dataemissao) dataemissao  
                            , count (distinct ik.iditemkitproduto) itenkit
                            , sum (sum(ip.quantidade) / count (distinct ik.iditemkitproduto) / count (distinct ik.iditemkitproduto)) over (partition by p.idrepresentante) qtde
                            , sum(ip.valorvenda * ip.quantidade) valorvenda
                            , sum((ip.valorvenda * ip.quantidade) * p.fatorconversao) valorvenda_conv
                            , sum(ip.valorapagar * ip.quantidade) valorapagar
                            , sum((ip.valorapagar * ip.quantidade) * p.fatorconversao) valorapagar_conv
                            , sum(ip.valorcomissaoatendente) valoratendente
                            , sum((ip.valorcomissaoatendente) * p.fatorconversao) valoratendente_conv
                            , p.datacancelamento 
                            , p.numeropedido
                       from favorita.pedidos p
                          , favorita.itenspedidos ip
                          , favorita.itenskitsprodutos ik
                       where p.idpedido = ip.idpedido
                         and ip.idkitproduto = ik.idkitproduto
                         and ip.idkitproduto = :P169_IDKITPRODUTO
                         and trunc(p.dataemissao) between to_date(:P169_DATAINICIO,'DD/MM/RRRR') and to_date(:P169_DATAFIM,'DD/MM/RRRR')
                         and ( :P169_ATENDENTE is null or p.idusuario = :P169_ATENDENTE )
                         and ( :P169_IDFILIALORIGEM  is null or p.idfilialfavorita    = :P169_IDFILIALORIGEM )
                         and ( :P169_IDFILIALROMANCE is null or :P169_IDFILIALROMANCE = p.idfilialromance    ) 
                         and p.datacancelamento is null
                         and ( (:P169_PEDIDOPROSPECCAO = 'T')
                            or (:P169_PEDIDOPROSPECCAO = 'N' and not exists ( select 1
                                                                              from favorita.classificacoespedidos cp
                                                                              where cp.idpedido = p.idpedido
                                                                               and cp.idcaracteristicapedido = 74 ) )  
                            or (:P169_PEDIDOPROSPECCAO = 'S' and exists ( select 1
                                                                          from favorita.classificacoespedidos cp
                                                                          where cp.idpedido = p.idpedido
                                                                           and cp.idcaracteristicapedido = 74 ) ) )
                         and ( :P169_PEDIDOS_PAGOS = 'T'
                           or ( :P169_PEDIDOS_PAGOS = 'N' and exists ( select 1
                                                                       from vencimentospedidos v
                                                                       where v.situacaovencimento = 'V'
                                                                         and v.idpedido           = p.idpedido
                                                                         and v.valorpago         != v.valorpagar ) )
                           or ( :P169_PEDIDOS_PAGOS = 'S' and exists ( select 1
                                                                       from vencimentospedidos v
                                                                       where v.situacaovencimento = 'V'
                                                                         and v.idpedido           = p.idpedido
                                                                         and v.valorpago         >= v.valorpagar ) ) )
                
                         group by p.idrepresentante ,p.idusuario, p.idfilialromance, p.idpedido, p.dataemissao, p.datacancelamento, numeropedido ) ped  
                group by ped.idrepresentante 
                       , ped.qtde  
                       , ped.itenkit 
                       , idfilialromance
                       , ped.datacancelamento 
                       , idusuario
                       , dataemissao  
                       , numeropedido
                order by 2;
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P169_TIPOPRODUTO
            value: KC
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 32982662894069136
        }

