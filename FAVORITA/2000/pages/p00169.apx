    validation valida-kit-venda (
        name: Valida Kit venda
        execution {
            sequence: 10
        }
        validation {
            language: sql
            sqlExpression:
                ```sql
                :P169_IDKITVENDA is not null or
                :P169_TIPOPRODUTO != 'K'
                ```
        }
        error {
            errorMessage: Campo Kit Venda deve ter algum valor!
            associatedItem: @P169_IDKITVENDA
        }
    )

    branch (
        name: Go To Page 169
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 169
                items: {
                    P169_ATENDENTE: &P169_ATENDENTE.
                    P169_IDFILIALORIGEM: &P169_IDFILIALORIGEM.
                    P169_TIPOPRODUTO: &P169_TIPOPRODUTO.
                    P169_PRODUTO: &P169_PRODUTO.
                    P169_IDKITVENDA: &P169_IDKITVENDA.
                    P169_TIPORELATORIO: &P169_TIPORELATORIO.
                    P169_FILTRARPRODUTOS: &P169_FILTRARPRODUTOS.
                    P169_DATAINICIO: &P169_DATAINICIO.
                    P169_DATAFIM: &P169_DATAFIM.
                    P169_PEDIDOS_PAGOS: &P169_PEDIDOS_PAGOS.
                    P169_IDKITPRODUTO: &P169_IDKITPRODUTO.
                    P169_TIPOPEDIDO: &P169_TIPOPEDIDO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

