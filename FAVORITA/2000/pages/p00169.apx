    region vendas-detalhado (
        name: Vendas Detalhado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.numeropedido
                     , p.idrepresentante
                     , p.representante
                     , p.vendedora
                     , p.cpf
                     , p.dataemissao
                     , p.dataentrega
                     , p.valortotal
                     , (p.valortotal * p.fatorconversao) valortotalconv
                     , p.valorapagar
                     , (p.valorapagar * p.fatorconversao) valorapagarconv
                     , p.nomeusuario
                     , i.quantidade
                     , i.valorapagar valoritens
                     , (i.valorapagar * p.fatorconversao) valoritensconv
                     , round(favorita.pck_util_fav.FNC_DIVISOR_ZERO(i.valorapagar,i.quantidade),2)valorpagaritem
                     , (round(favorita.pck_util_fav.FNC_DIVISOR_ZERO(i.valorapagar,i.quantidade),2) * p.fatorconversao) valorpagaritemconv
                     , p.idfilialromance
                     , p.filialromance
                     , p.idfilialfavorita
                     , p.filialfavorita
                     , i.nomeproduto
                     , i.categoria
                     , i.categoriasite   
                     , decode( p.tipopedido ,'P','Pedido','T','Troca','V','Venda Direta','R','Romance Casa') "Tipo Pedido"
                from vw_itenspedidos_fav i
                   , vw_pedidos_fav_new p
                where i.idpedido           = p.idpedido
                  and i.ididioma           = :P0_IDIDIOMA
                  and p.idsituacaoentrega  >= 20000
                  and ( :P169_TIPOPEDIDO = 'Z' or p.tipopedido = :P169_TIPOPEDIDO )
                  and not exists ( select 1
                                   from classificacoespedidos c
                                   where c.idpedido = p.idpedido
                                     and c.idcaracteristicapedido = 25 )
                  and ( :P169_PRODUTO is null or i.idprodutodetalhado = :P169_PRODUTO )
                  and ( :P169_IDFILIALORIGEM is null or p.idfilialfavorita = :P169_IDFILIALORIGEM )
                  and (( :P169_FILTRARPRODUTOS = 'S' and exists ( select 1
                                                                    from filtrosprodutos fp
                                                                    where fp.idusuario = :P0_IDUSUARIO
                                                                      and fp.idproduto = i.idproduto 
                                                                      and fp.pagina    = 169))
                      or :P169_FILTRARPRODUTOS = 'N')
                  and :P169_TIPORELATORIO = 'D'
                  and ( :P169_ATENDENTE is null or p.idusuario = :P169_ATENDENTE )
                  and (:P169_IDFILIALROMANCE is null or :P169_IDFILIALROMANCE = p.idfilialromance)
                  and p.dataemissao between to_date(:P169_DATAINICIO||' 00:00:00','DD/MM/RRRR hh24:mi:ss') and to_date(:P169_DATAFIM||' 23:59:59','DD/MM/RRRR hh24:mi:ss')
                  and ( :P169_PEDIDOS_PAGOS = 'T'
                     or ( :P169_PEDIDOS_PAGOS = 'S' and (p.valorapagar - p.valorpago) = 0 ) 
                     or ( :P169_PEDIDOS_PAGOS = 'N' and (p.valorapagar - p.valorpago) > 0 ) )
                  and ( (:P169_PEDIDOPROSPECCAO = 'T')
                     or (:P169_PEDIDOPROSPECCAO = 'N' and not exists ( select 1
                                                                       from favorita.classificacoespedidos cp
                                                                       where cp.idpedido = p.idpedido
                                                                       and cp.idcaracteristicapedido = 74 ) )  
                     or (:P169_PEDIDOPROSPECCAO = 'S' and exists ( select 1
                                                                   from favorita.classificacoespedidos cp
                                                                   where cp.idpedido = p.idpedido
                                                                   and cp.idcaracteristicapedido = 74 ) ) )
                order by p.dataemissao 
                ```
        }
