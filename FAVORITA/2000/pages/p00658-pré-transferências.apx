    process conjuntos-do-lote-save-interactive-grid-data (
        name: Conjuntos do Lote - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @conjuntos-do-lote
        execution {
            sequence: 5
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 900000000000000035
        }
        serverSideCondition {
            type: request=Value
            value: GERAR_PRE_TRANSFERENCIA
            executeCondition: once
        }
    )

    process processa-pre-transferencia (
        name: Processa Pre_Transferencia
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidpretransferencia number;
                  vidprincipal        number := null;
                  vqtd                number;
                  --
                begin
                  --
                  :P658_QTD_SUCESSO := 0;
                  :P658_QTD_FALHA   := 0;
                  --
                  select count(1)
                  into vqtd
                  from itensLotePretransferencias
                  where sessao = v('APP_SESSION');
                  --
                  if vqtd = 0 then
                    raise_application_error(-20004, 'Adicione ao menos um conjunto na grid antes de gerar.');
                  end if;
                  --
                  for c1 in ( select iditemlotepretransferencia, idcategoriasite, idcategoria,
                                     idsubcategoria, alvo
                              from itensLotePretransferencias
                              where sessao = v('APP_SESSION')
                              order by iditemlotepretransferencia )
                  loop
                    --
                    begin
                      -- Call the procedure
                      pck_comprastransf_fav.prc_gerapretransferencia_v2(pidfilialfavorita => :P658_IDFILIALFAVORITA_GERAR,
                                                                        pidusuario => :P0_IDUSUARIO,
                                                                        palvo_minimo => c1.alvo,
                                                                        pidcategoriasite => c1.idcategoriasite,
                                                                        pidcategoria => c1.idcategoria,
                                                                        pidsubcategoria => c1.idsubcategoria,
                                                                        pidpretransferencia => vidpretransferencia);
                      --
                      :P658_QTD_SUCESSO := :P658_QTD_SUCESSO + 1;
                      --
                      if vidprincipal is null then
                        -- primeira pre-transferencia gerada no lote: vira o cabecalho principal
                        vidprincipal := vidpretransferencia;
                      else
                        -- conjuntos seguintes: move os itens gerados para o cabecalho principal
                        -- e descarta o cabecalho extra, unificando tudo numa unica pre-transferencia
                        update itenspretransferencias
                        set idpretransferencia = vidprincipal
                        where idpretransferencia = vidpretransferencia;
                        --
                        delete pretransferencias
                        where idpretransferencia = vidpretransferencia;
                        --
                        -- commit explicito: a procedure acima ja commita internamente a cada
                        -- chamada, entao esse merge precisa do seu proprio commit para nao
                        -- depender do gerenciamento de transacao padrao do APEX
                        commit;
                      end if;
                      --
                      :P658_IDPRETRANSFERENCIA := vidprincipal;
                      --
                    exception
                      when others then
                        :P658_QTD_FALHA := :P658_QTD_FALHA + 1;
                        apex_debug.error('Erro ao gerar pre-transferencia (item ' || c1.iditemlotepretransferencia || '): ' || sqlerrm);
                    end;
                    --
                    -- remove do lote logo apos tentar processar (sucesso ou falha), garantindo que nunca
                    -- seja reprocessado num reenvio da pagina
                    delete itensLotePretransferencias
                    where iditemlotepretransferencia = c1.iditemlotepretransferencia;
                    --
                  end loop;
                  --
                  if :P658_QTD_FALHA = 0 then
                    apex_application.g_print_success_message := 'Pre-transferencia gerada com sucesso, unificando ' ||
                                                                :P658_QTD_SUCESSO || ' conjunto(s).';
                  else
                    apex_application.g_print_success_message := :P658_QTD_SUCESSO || ' conjunto(s) unificado(s) na pre-transferencia com sucesso. ' ||
                                                                :P658_QTD_FALHA || ' conjunto(s) falharam - ver detalhes no log de debug.';
                  end if;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 47667106187259644
        }
        serverSideCondition {
            type: request=Value
            value: GERAR_PRE_TRANSFERENCIA
        }
    )

    branch (
        name: Go To Page 659
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 659
                items: {
                    P659_IDPRETRANSFERENCIA: &P658_IDPRETRANSFERENCIA.
                }
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression: v('REQUEST') = 'GERAR_PRE_TRANSFERENCIA' and :P658_QTD_SUCESSO >= 1 and :P658_QTD_FALHA = 0
        }
    )

)

