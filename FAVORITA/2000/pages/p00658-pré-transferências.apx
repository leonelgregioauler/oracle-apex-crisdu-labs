    pageItem P658_IDFILIALFAVORITA (
        type: selectOne
        label {
            label: Filial Favorita
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nomefilialfavorita
                     , f.idfilialfavorita
                from filiaisfavorita f
                where f.ativo = 'S'
                  and f.tipofilial = 'L'
                  and exists ( select 1
                               from atendimentosestoques ae
                               where ae.idfilialfavoritadestino = f.idfilialfavorita
                                 and ae.idfilialfavoritaorigem in (2,3,4) )
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @ações-filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--xlarge
            ]
            width: 30
        }
    )

    pageItem P658_IDFILIALFAVORITA_GERAR (
        type: selectOne
        label {
            label: Filial Favorita
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nomefilialfavorita
                     , f.idfilialfavorita
                from filiaisfavorita f
                where f.ativo = 'S'
                  and f.tipofilial = 'L'
                  and exists ( select 1
                               from atendimentosestoques ae
                                  , filiaisfavorita ff
                               where ae.idfilialfavoritadestino = f.idfilialfavorita
                                 and ae.idfilialfavoritaorigem = ff.idfilialfavorita
                                 and ff.tipofilial = 'E'
                                 and ff.ativo = 'S')
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @dados-para-pré-transferência
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

