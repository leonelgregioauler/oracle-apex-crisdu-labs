    region pré-transferências (
        name: Pré-Transferências
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pr.idpretransferencia
                     , pr.data
                     , pr.idusuario
                     , pck_util_fav.fnc_nomeusuario(idusuario) usuario
                     , pr.idfilialfavoritaorigem
                     , pck_util_fav.fnc_nomefilialfavorita(idfilialfavoritaorigem) origem
                     , pr.idfilialfavoritadestino
                     , pck_util_fav.fnc_nomefilialfavorita(idfilialfavoritadestino) destino
                     , pr.alvo_minimo 
                     , pr.idcompratransferencia
                     , case
                         when pr.idcompratransferencia is not null then
                           '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':74:'||v('APP_SESSION')||'::NO::P74_IDCOMPRATRANSFERENCIA:'||pr.idcompratransferencia,'SESSION')||''',''_blank''); void(0)">'||pr.idcompratransferencia||'</a>' 
                         else
                           null
                       end ver_transferencia
                     , ( select count(1)
                         from itenspretransferencias it
                         where it.idpretransferencia = pr.idpretransferencia ) qtd_itens
                     , ( select count(1)
                         from itenspretransferencias it
                         where it.idpretransferencia = pr.idpretransferencia
                           and it.selecionado = 'S' ) qtd_itens_selecionados
                from pretransferencias pr
                where pr.versao = 2
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado!
        }
