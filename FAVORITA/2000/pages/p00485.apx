page 485 (
    name: Relatorio de Saldão p/ Epicom
    title: Relatorio de Saldão p/ Epicom
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region relatorio-de-saldão-p-epicom (
        name: Relatorio de Saldão p/ Epicom
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct(p.referencia)
                     , p.nomeproduto
                from favorita.produtos p
                where not exists( select 1
                                  from favorita.produtosdetalhados pd
                                  where pd.idproduto = p.idproduto
                                    and exists ( select 1
                                                 from favorita.produtosdetedrevistas pr 
                                                 where pd.idprodutodetalhado = pr.idprodutodetalhado
                                                   and pr.idedicaorevista = :P485_IDEDICAOREVISTA 
                                                   and exists ( select 1
                                                                    from favorita.edicoesrevistas ed
                                                                    where ed.idedicaorevista = pr.idedicaorevista
                                                                      and ed.tipovenda = 'R'
                                                                      and ed.idpais = 1)))
                   and not exists( select 1
                                  from favorita.produtosdetalhados pd
                                  where pd.idproduto = p.idproduto
                                    and exists ( select 1
                                                 from favorita.produtosdetedrevistas pr 
                                                 where pd.idprodutodetalhado = pr.idprodutodetalhado
                                                   and pr.idedicaorevista not in (63,62,56)
                                                   and pr.idedicaorevista > :P485_IDEDICAOREVISTA 
                                                   and exists ( select 1
                                                                from favorita.edicoesrevistas ed
                                                                where ed.idedicaorevista = pr.idedicaorevista
                                                                  and ed.tipovenda = 'R'
                                                                  and ed.idpais = 1)))
                   and not exists( select 1
                                  from favorita.produtosdetalhados pd
                                  where pd.idproduto = p.idproduto
                                    and exists ( select 1
                                                 from favorita.classificacoesprodutos cp
                                                 where cp.idprodutodetalhado = pd.idprodutodetalhado
                                                   and cp.idtagproduto in (24,2,1,123)))
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 5036163348411567148
        }

        column NOMEPRODUTO (
            type: plainText
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column REFERENCIA (
            type: plainText
            heading {
                heading: Referência
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 50426088 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn NOMEPRODUTO (
                sequence: 2
            )

            displayColumn REFERENCIA (
                sequence: 1
            )

        )

    )

    pageItem P485_IDEDICAOREVISTA (
        type: selectList
        label {
            label: Edição
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-edicoesrevistas
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
                t-Button--stretch
            ]
            icon: fa-filter
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

