    pageItem P68_AVISO_DOC_CHILE (
        type: displayOnly
        label {
            label: Aviso Doc Chile
            alignment: left
        }
        settings {
            format: html
        }
        layout {
            sequence: 131
            region: @aviso
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: staticValue
            staticValue: <span style="color:#D0021B; font-size:18px;"><strong>Pedido sin enlace de cobro Membrezia, revisa el documento en el registro y haga clic en <strong>Enviar a Membrezia</strong> para integrar el pedido.</span>
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM   pedidos p
                       JOIN vendedoras v  ON v.idvendedora = p.idvendedora
                       JOIN pessoas   pes ON pes.idpessoa  = v.idpessoa
                WHERE  p.idpedido = :P68_IDPEDIDO
                  AND  pes.idpais = 6
                  AND  p.datacancelamento IS NULL
                  AND  EXISTS (SELECT 1 FROM classificacoespedidos cfp
                               WHERE cfp.idpedido = p.idpedido
                                 AND cfp.idcaracteristicapedido = 8
                                 AND cfp.idvalorcaracteristica IN (55,56,57,58,59,60,61,65))
                  AND (    NOT EXISTS (SELECT 1 FROM classificacoespedidos cja
                                       WHERE cja.idpedido = p.idpedido
                                         AND cja.idcaracteristicapedido = 116
                                         AND cja.idvalorcaracteristica IS NOT NULL)
                       OR  NOT EXISTS (SELECT 1 FROM classificacoespedidos cln
                                       WHERE cln.idpedido = p.idpedido
                                         AND cln.idcaracteristicapedido = 118
                                         AND cln.observacao IS NOT NULL))
                ```
        }
    )

    pageItem P68_AVISO_DOC_PANAMA (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: html
        }
        layout {
            sequence: 130
            region: @aviso
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: staticValue
            staticValue: <span style="color:#D0021B; font-size:18px;"><strong>Documento de la consultora pendiente.</strong> Regularice el CIP (documento) y haga clic en <strong>Enviar a Membrezia</strong> para integrar el pedido.</span>
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM   pedidos p
                       JOIN vendedoras v  ON v.idvendedora = p.idvendedora
                       JOIN pessoas   pes ON pes.idpessoa  = v.idpessoa
                WHERE  p.idpedido = :P68_IDPEDIDO
                  AND  pes.idpais = 13
                  AND  p.datacancelamento IS NULL
                  AND (pes.documentoestrangeiro_orig IS NULL
                       OR TRIM(pes.documentoestrangeiro_orig) IS NULL)
                  AND  EXISTS (SELECT 1 FROM classificacoespedidos cfp
                               WHERE cfp.idpedido = p.idpedido
                                 AND cfp.idcaracteristicapedido = 8
                                 AND cfp.idvalorcaracteristica IN (55,56,57,58,59,60,61,65))
                  AND  NOT EXISTS (SELECT 1 FROM classificacoespedidos cja
                               WHERE cja.idpedido = p.idpedido
                                 AND cja.idcaracteristicapedido = 116)
                ```
        }
    )

