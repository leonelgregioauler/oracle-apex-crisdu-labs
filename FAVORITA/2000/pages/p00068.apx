    button re-integracao-producao (
        buttonName: RE_INTEGRACAO_PRODUCAO
        label: ReIntegrar Pedido
        layout {
            sequence: 220
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--success
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-exchange
        }
        behavior {
            action: definedByDynamicAction
            executeValidations: false
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vhostname       varchar2(100);
                  vacessoliberado varchar2(1);
                  vintegrado      varchar2(1);
                begin
                  --
                  select upper(sys_context('USERENV','SERVER_HOST')) 
                  into vhostname
                  from dual;
                  --
                  select pck_util_fav.fnc_verificaacesso (28333, :P0_IDUSUARIO) acessoliberado
                  into vacessoliberado
                  from dual;
                  --
                  begin
                    --
                    select 'S'
                    into vintegrado
                    from classificacoespedidos c
                    where c.idpedido = :P68_IDPEDIDO
                      and c.idcaracteristicapedido = 43
                      and substr(nvl(c.observacao,'Sucesso'),1,4) in ('Erro','Suce')  ;
                    --
                  exception
                    when others then
                      vintegrado := 'N';
                  end;
                  --
                  -- HOMOLOGAÇÃO
                  if vhostname = 'SRVBD02' then
                    return false;
                  -- PRODUÇÃO
                  elsif vacessoliberado = 'S' and vintegrado = 'S' then
                    return true;
                  end if;
                  --
                end;
                ```
        }
    )

