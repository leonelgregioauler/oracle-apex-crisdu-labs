    button desfazer-pap (
        buttonName: DESFAZER_PAP
        label: Desfazer PAP
        layout {
            sequence: 250
            region: @setor-de-cobrança
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--warning
                t-Button--simple
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                
                  -- Escopo para criação de veriável e cursor
                  vIDUltimoEnvioPAP     number;
                  vIDUltimaRetiradaPAP  number;
                  
                begin
                  
                  -- Busca ultimo envio ao PAP.
                  begin
                    select nvl(max(c.idclassificacaopedido),0) id
                      into vIDUltimoEnvioPAP
                      from favorita.classificacoespedidos c
                     where c.idcaracteristicapedido = 98
                       and c.idpedido = :P68_NUMEROPEDIDO;
                  exception
                    when others then
                      vIDUltimoEnvioPAP := 0;
                  end;
                
                  -- Busca ultima retirada do PAP.
                  begin
                    select nvl(max(c.idclassificacaopedido),0) id
                      into vIDUltimaRetiradaPAP
                      from favorita.classificacoespedidos c
                     where c.idcaracteristicapedido = 99
                       and c.idpedido = :P68_NUMEROPEDIDO;
                  exception
                    when others then
                      vIDUltimaRetiradaPAP := 0;
                  end;
                
                  -- Verifica se libera o botão de remover PAP
                  if vIDUltimoEnvioPAP = 0 then
                    return false; -- Cai aqui quando nunca foi enviado ao PAP, etão não necessita desfazer o envio
                    
                  elsif vIDUltimoEnvioPAP < vIDUltimaRetiradaPAP then
                    return false; -- Cai aqui quando a ultima retirada do PAP é maior que o envio, não necessita desfazer envio
                  
                  else
                    return true; -- Possui envio ao PAP ativo, então permite desfazer
                    
                  end if;
                
                end;
                ```
        }
    )

