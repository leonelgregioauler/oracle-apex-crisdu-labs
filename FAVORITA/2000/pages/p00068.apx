    pageItem P68_SESSION_HISTORICO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 500
            region: @pedido
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_url varchar2(2000);
                    l_app number := 2000;
                    l_session number := v('APP_SESSION');
                BEGIN
                    l_url := APEX_UTIL.PREPARE_URL(
                        p_url => 'f?p=' || l_app || ':80:'||l_session||'::NO::P80_IDVENDEDORA:'||:P68_IDVENDEDORA,
                        p_checksum_type => 'SESSION');
                    
                    return l_url;
                END;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

