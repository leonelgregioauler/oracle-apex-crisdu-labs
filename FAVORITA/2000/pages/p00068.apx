                EDICAOBLOQUEADA = document.getElementById('P68_EDICAOBLOQUEADA').value;
                IDSITAUCAOENTREGA = document.getElementById('P68_IDSITUACAOENTREGA').value;
                //vlrlimite = vlimite.replace(",",".");
                
                if ( TROCA != 'N' )
                  {
                      TROCA = true;
                  }
                if( IDREPRESENTANTE != '') 
                {
                    //vendereco = venderecows+'"IDPEDIDO":'+IDPEDIDO+',"IDUSUARIO":'+IDUSUARIO+',"IDREPRESENTANTE":'+IDREPRESENTANTE+',"LIMITE_DESTE_PEDIDO":'+vlrlimite+'}'
                    //vendereco = venderecows+'"IDPEDIDO":'+IDPEDIDO+',"IDUSUARIO":'+IDUSUARIO+',"IDREPRESENTANTE":'+IDREPRESENTANTE+',"EH_TROCA_PONTA_PORAN":'+TROCA+'}'
                    vendereco = venderecows+'"IDPEDIDO":'+IDPEDIDO+',"IDUSUARIO":'+IDUSUARIO+',"IDREPRESENTANTE":'+IDREPRESENTANTE+'}'
                }  
                else
                {
                    //vendereco = venderecows+'"IDPEDIDO":'+IDPEDIDO+',"IDUSUARIO":'+IDUSUARIO+',"LIMITE_DESTE_PEDIDO":'+vlrlimite+'}'
                    //vendereco = venderecows+'"IDPEDIDO":'+IDPEDIDO+',"IDUSUARIO":'+IDUSUARIO+',"EH_TROCA_PONTA_PORAN":'+TROCA+'}'
                    vendereco = venderecows+'"IDPEDIDO":'+IDPEDIDO+',"IDUSUARIO":'+IDUSUARIO+'}'
                }  
            
                vjanela = window.open(vendereco , 'SITE', params);/* 'location=yes,height=100%,width=100%,scrollbars=yes,status=yes');*/
                vjanela.focus();
                vjanela.moveTo(0,0);
                addEventListener("message", function(msg){ if (msg.data == "reload") location.reload()}, false);
                
            }
            
            function fnc_editapedido_adapto()
            {
            var params = [
                'height='+screen.height,
                'width='+screen.width,
                'fullscreen=yes',
                'location=yes,scrollbars=yes,status=yes'
            ].join(',');
                IDREPRESENTANTE = document.getElementById('P68_FEITOPORREPRESENTANTE').value;
                IDPEDIDO        = document.getElementById('P68_IDPEDIDO').value;
                IDUSUARIO       = document.getElementById('P68_IDUSUARIO').value;
                TROCA           = document.getElementById('P68_TROCA_PONTA_PORA').value;
                venderecows     = document.getElementById('P0_ENDERECOWS').value;
                //vlimite         = document.getElementById('P68_LIMITECONSULTORA').value;
                
                TIPOPEDIDO      = document.getElementById('P68_TIPOPEDIDOTEST').value;
                IDFILIALFAVORITA = document.getElementById('P68_IDFILIALFAVORITA').value;
                ENDERECO_ADAPTO_CHILE = document.getElementById('P0_ENDERECO_ADAPTO_CHILE').value;
                ENDERECO_ADAPTO_RMCCASA = document.getElementById('P0_ENDERECO_ADAPTO_RMCCASA').value;
                ENDERECO_ADAPTO = document.getElementById('P0_ENDERECO_ADAPTO').value;
                ENCODE_COMPLETO = document.getElementById('P68_ENCODE_ADAPTO_CHILE').value;
                EDICAOBLOQUEADA = document.getElementById('P68_EDICAOBLOQUEADA').value;
                IDSITAUCAOENTREGA = document.getElementById('P68_IDSITUACAOENTREGA').value;
                IDPAIS            = document.getElementById('P0_IDIDIOMA').value;
                ENDERECO_ADAPTO_PARAGUAI = document.getElementById('P0_ENDERECO_ADAPTO_PARAGUAI').value;
                ENDERECO_ADAPTO_URUGUAI = document.getElementById('P0_ENDERECO_ADAPTO_URUGUAI').value;
                //vlrlimite = vlimite.replace(",",".");
                
                if ( TROCA != 'N' )
                  {
                      TROCA = true;
                  }
                  
                if (TIPOPEDIDO == 'R') {
                    vendereco = ENDERECO_ADAPTO_RMCCASA + ENCODE_COMPLETO;
                } else {
                    if (IDPAIS == 6) {
                        vendereco = ENDERECO_ADAPTO_CHILE + ENCODE_COMPLETO;
                    } else if (IDPAIS == 4) {
                        vendereco = ENDERECO_ADAPTO_PARAGUAI + ENCODE_COMPLETO;
                    } else if (IDPAIS == 2) {
                        vendereco = ENDERECO_ADAPTO_URUGUAI + ENCODE_COMPLETO;
                    } else {
                        vendereco = ENDERECO_ADAPTO + ENCODE_COMPLETO;
                    }
                }
            
                vjanela = window.open(vendereco , 'SITE', params);/* 'location=yes,height=100%,width=100%,scrollbars=yes,status=yes');*/
                vjanela.focus();
                vjanela.moveTo(0,0);
                addEventListener("message", function(msg){ if (msg.data == "reload") location.reload()}, false);
                
            }
            
            function fnc_editapedido_old()
            {
            
                alert("old")
            var params = [
                'height='+screen.height,
                'width='+screen.width,
                'fullscreen=yes' // only works in IE, but here for completeness
            ].join(',');
                IDREPRESENTANTE = document.getElementById('P68_FEITOPORREPRESENTANTE').value;
                IDPEDIDO        = document.getElementById('P68_IDPEDIDO').value;
                IDUSUARIO       = document.getElementById('P0_IDUSUARIO').value;
                vlimite         = document.getElementById('P68_LIMITECONSULTORA').value;
                
                if( IDREPRESENTANTE != '') 
                  {
                    vendereco = 'https://ws.catalogofavorita.com.br/executar/callcenter/iniciar?str={"IDPEDIDO":'+IDPEDIDO+',"IDUSUARIO":'+IDUSUARIO+',"IDREPRESENTANTE":'+IDREPRESENTANTE+',"LIMITE_DESTE_PEDIDO":'+vlimite+'}'
                  }  
                else
                  {
                    vendereco = 'https://ws.catalogofavorita.com.br/executar/callcenter/iniciar?str={"IDPEDIDO":'+IDPEDIDO+',"IDUSUARIO":'+IDUSUARIO+',"LIMITE_DESTE_PEDIDO":'+vlimite+'}'
                  }  
                vjanela = window.open(vendereco , 'SITE', params);/* 'location=yes,height=100%,width=100%,scrollbars=yes,status=yes');*/
                vjanela.focus();
                vjanela.moveTo(0,0);
                addEventListener("message", function(msg){ if (msg.data == "reload") location.reload()}, false);
                
            }
            
            function imprimirpedido() 
              {
                  vurl = document.getElementById("P68_SESSION_IMPRIMIR").value;
                  pjan = window.open(vurl,'page','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1280,height=1024,left=20,top=10','_blank'); void(0);
                  pjan.focus();
              }
            
            function imprimirrecibo() 
              {
                  vurl = document.getElementById("P68_SESSION_RECIBO").value;
                  pjan = window.open(vurl,'page','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1280,height=1024,left=20,top=10','_blank'); void(0);
                  pjan.focus();
              }
            
            function verhistorico() 
              {
                  vurl = document.getElementById("P68_SESSION_HISTORICO").value;
                  pjan = window.open(vurl,'_blank'); void(0);
                  pjan.focus();
              }
            
            function fnc_avisofalta(pid)
            {
              $(".avisodefalta").hide();
                
               setInterval(function() {
                 $(".avisodefalta").show();
               }, 8000);
               
               apex.message.confirm('Confirma o aviso de falta deste produto?', function(simnao) {
                 if (simnao) {
                   document.getElementById("P68_IDITEMEDITAR").value = pid;
                   apex.submit('AVISOFALTA');
                 } 
                 else {
                    $(".avisodefalta").show();
                 }
                 
               });
            }
            
            function fnc_avisofaltazeraestoque(pid)
            {
              $(".avisodefalta").hide();
                
               setInterval(function() {
                 $(".avisodefalta").show();
               }, 8000);
               
               apex.message.confirm('Confirma o aviso de falta deste produto e quer mesmo ZERAR o disponivel desse produto?', function(simnao) {
                 if (simnao) {
                   document.getElementById("P68_IDITEMEDITAR").value = pid;
                   apex.submit('AVISOFALTAZERAESTOQUE');
                 } 
                 else {
                    $(".avisodefalta").show();
                 }
                 
               });
            }
            
            function AtivarIntegracaoVirtualAgeHML(callback_resultado) {
              IDPEDIDO = document.getElementById('P68_IDPEDIDO').value;
              IDUSUARIO = document.getElementById('P0_IDUSUARIO').value;
              //IDUSUARIO = document.getElementById('3906').value;
              CFOP = document.getElementById('P68_CFOP').value;
              MENSAGEMRETORNO = document.getElementById('P68_MENSAGEMRETORNO').value;
            
              //alert(IDPEDIDO,IDUSUARIO,CFOP,MENSAGEMRETORNO)
                
              if (CFOP == "") {
                apex.message.alert(MENSAGEMRETORNO);
              }
             
              winwidth  = 770;  // largura da nova janela
              winheight = 450;  // altura da nova janela 
              winleft   = 200;  // (nao alterar)
              wintop    = 200;  // (nao alterar)
            
              if(parseInt(navigator.appVersion)>=4) 
              {
                winleft = (screen.width / 2) - (winwidth / 2);  // centro da janela direita para esquerda
                wintop = (screen.height / 2) - (winheight / 2); // centro da janela cima para baixo
              }
             
              var iframe = $("<iframe>");
              window.evento = window.addEventListener("message", function(dados) {
              window.removeEventListener("message", window.evento, true);
              console.log("dados recebidos do filho!");
              console.log(dados);
              dados = JSON.parse(dados.data);
            
              //alert(JSON.stringify(dados))
            
              if (typeof(dados.ERRO) != "undefined") {
                vendereco = document.getElementById("P68_SESSION_INTEGRAR").value;
                vjanela = window.open(vendereco, '_blank', 'top=' + wintop + ',left=' + winleft + ',height=' + winheight + ',width=' + winwidth); 
                vjanela.focus();
              }
            
              if (typeof(callback_resultado) != "undefined") {
               callback_resultado(dados);
              }
              
              $("body").remove(iframe);
              }, true);
              $("body").append(iframe);
              iframe.attr("src", 'https://minhafavorita.com.br/ws_hmg/executar/integracao_va/executar?str={"IDPEDIDO":"' + IDPEDIDO + '","SISTEMA":true,"IDUSUARIO":' + IDUSUARIO + '}');
            }
            
            function AtivarIntegracaoVirtualAgePRD(callback_resultado) {
              IDPEDIDO = document.getElementById('P68_IDPEDIDO').value;
              IDUSUARIO = document.getElementById('P0_IDUSUARIO').value;
              CFOP = document.getElementById('P68_CFOP').value;
              MENSAGEMRETORNO = document.getElementById('P68_MENSAGEMRETORNO').value;
                
              if (CFOP == "") {
                apex.message.alert(MENSAGEMRETORNO);
              }
             
              winwidth  = 770;  // largura da nova janela
              winheight = 450;  // altura da nova janela 
              winleft   = 200;  // (nao alterar)
              wintop    = 200;  // (nao alterar)
            
              if(parseInt(navigator.appVersion)>=4) 
              {
                winleft = (screen.width / 2) - (winwidth / 2);  // centro da janela direita para esquerda
                wintop = (screen.height / 2) - (winheight / 2); // centro da janela cima para baixo
              }
             
              var iframe = $("<iframe>");
              window.evento = window.addEventListener("message", function(dados) {
              window.removeEventListener("message", window.evento, true);
              console.log("dados recebidos do filho!");
              console.log(dados);
              dados = JSON.parse(dados.data);
            
              if (typeof(dados.ERRO) != "undefined") {
                vendereco = document.getElementById("P68_SESSION_INTEGRAR").value;
                vjanela = window.open(vendereco, '_blank', 'top=' + wintop + ',left=' + winleft + ',height=' + winheight + ',width=' + winwidth); 
                vjanela.focus();
              }
            
              if (typeof(callback_resultado) != "undefined") {
               callback_resultado(dados);
              }
              
              $("body").remove(iframe);
              }, true);
              $("body").append(iframe);
              iframe.attr("src", 'https://ws.minhafavorita.com.br/executar/integracao_va/executar?str={"IDPEDIDO":"' + IDPEDIDO + '","SISTEMA":true,"IDUSUARIO":' + IDUSUARIO + '}');
            }
            
            function ExibeAguarde() {
             window.aguarde = {posicao:$(document).scrollTop(),
                   $aguarde: $("<div>").css({"position":"absolute", 
                    "top":"0px",
                    "left":"0px",
                    "right":"0px",
                    "bottom":"0px",
                    "background":"white",
                    "text-align":"center",
                    "font-size":"20px",
                    "padding-top":"25%",
                    "cursor":"progress",
                    "z-index":10000})
                   .text("Aguarde... Pedido está sendo Integrado!")
                   .appendTo($("body"))
                  };
            
             $(document).scrollTop(0);
             window.aguarde.$aguarde.show();
            }
            
            function OcultaAguarde() {
             window.aguarde.$aguarde.remove();
             $(document).scrollTop(window.aguarde.posicao);
            
            }
            ```
    }
