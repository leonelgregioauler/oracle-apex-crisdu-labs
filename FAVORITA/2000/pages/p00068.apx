    process atualiza-situação-cobrança (
        name: Atualiza situação cobrança
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidsituacaocobranca number;
                  vidcaracteristica number;
                  vidvalor number;
                  vidclassificacao number;
                  vdata date := sysdate;
                  vobservacao varchar2(1000);
                  vmd5 varchar2(1000);
                begin
                  --
                  if v('REQUEST') = 'ENVIAR_SPC' then
                    vidsituacaocobranca := 400;
                    vidcaracteristica := 44;
                  elsif  v('REQUEST') = 'ENVIAR_DOCUMENTACAO' then
                    vidsituacaocobranca := 500;
                    vidcaracteristica := 45;
                  elsif  v('REQUEST') = 'INCOBRAVEL' then
                    vidsituacaocobranca := 600;
                    vidcaracteristica := 46;
                  end if;
                  --
                  if vidsituacaocobranca = 400 then
                    --
                    update vendedoras v
                    set spc = 'S'
                    where v.idvendedora = :P68_IDVENDEDORA;
                    --
                  end if;
                  -- Call the procedure
                  pck_movimentarpedidos_fav.prc_atualizasituacaocobranca(pidpedido => :P68_IDPEDIDO,
                                                                         pidsituacao => vidsituacaocobranca,
                                                                         pidusuario => :P0_IDUSUARIO);
                  --
                  pck_pedidos_fav.prc_classificacoespedidos(pidclassificacaopedido => vidclassificacao,
                                                            pidpedido => :P68_IDPEDIDO,
                                                            pdataclassificado => vdata,
                                                            pidusuario => :P0_IDUSUARIO,
                                                            pidcaracteristicapedido => vidcaracteristica,
                                                            pidvalorcaracteristica => vidvalor,
                                                            pobservacao => vobservacao,
                                                            poperacao_dml => 'I',
                                                            pmd5 => vmd5);
                  --
                end;
                
                ```
        }
        execution {
            sequence: 230
        }
        successMessage {
            successMessage: Situação Cobrança atualizada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 574154132569641036
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('ENVIAR_SPC','ENVIAR_DOCUMENTACAO','INCOBRAVEL') 
                ```
        }
    )

    process atualizar-pedido (
        name: Atualizar Pedido
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vdataemissao            date;
                  vdataentrega            date;
                  vdatadespacho           date;
                  vdatacancelamento       date;
                  vvalortotal             number;
                  vvalorpontoutilizado    number;
                  vvalordesconto          number;
                  vvalortotalcomdesconto  number;
                  vvalorfrete             number;
                  vvalorapagar            number :=0 ;
                  vqtditens               number;
                  vtipopedido             varchar2(1) := 'P';
                  --
                  vidformapagamento   number;
                  vidformaentrega     number;
                  --  
                  vidpedido   number := :P68_IDPEDIDO;
                  vidusuario  number := :P0_IDUSUARIO;
                  --
                  vidclassificacaopedido  number := 0;
                  vdataclassificado       date := sysdate;
                  vidcaracteristicapedido number := 56;
                  vidvalorcaracteristica  number;
                  vobservacao             varchar2(1000);
                  --
                begin
                  --
                  vdataemissao      := to_date(:P68_DATAEMISSAO     ,'DD/MM/RRRR HH24:MI:SS');
                  vdataentrega      := to_date(:P68_DATAENTREGA     ,'DD/MM/RRRR');
                  vdatadespacho     := to_date(:P68_DATADESPACHO    ,'DD/MM/RRRR HH24:MI:SS');
                  vdatacancelamento := to_date(:P68_DATACANCELAMENTO,'DD/MM/RRRR HH24:MI:SS');
                  --
                  vvalortotal             := to_number(:P68_VALORTOTAL            ,'999G999G999G990D00');   
                  vvalorpontoutilizado    := to_number(:P68_VALORPONTOUTILIZADO   ,'999G999G999G990D00');
                  vvalordesconto          := to_number(:P68_VALORDESCONTO         ,'999G999G999G990D00');
                  --
                  vvalortotalcomdesconto  := to_number(:P68_VALORTOTALCOMDESCONTO ,'999G999G999G990D00');
                  --
                  -- ZERAR FRETE
                  --
                  --if v('REQUEST') = 'ZERARFRETE' then
                  --  vvalorfrete := 0;
                  --else
                    vvalorfrete             := to_number(:P68_VALORFRETE            ,'999G999G999G990D00');
                  --end if;
                  --
                  --EMESPERA
                  --
                  if v('REQUEST') = 'EMESPERA' then
                    :P68_EMESPERA := 'S';
                  elsif v('REQUEST') = 'EMATENDIMENTO' then
                    :P68_EMESPERA := 'N';
                  end if;
                  --
                  --vvalorapagar            := 0;--to_number(:P68_VALORAPAGAR           ,'999G999G999G990D00');
                  --
                  if v('REQUEST') = 'ZERARFRETE' then
                    pck_pedidos_fav.prc_classificacoespedidos(pidclassificacaopedido => vidclassificacaopedido,
                                                              pidpedido => :P68_IDPEDIDO,
                                                              pdataclassificado => vdataclassificado,
                                                              pidusuario => :P0_IDUSUARIO,
                                                              pidcaracteristicapedido => vidcaracteristicapedido,
                                                              pidvalorcaracteristica => vidvalorcaracteristica,
                                                              pobservacao => vobservacao,
                                                              poperacao_dml => 'I',
                                                              pmd5 => :P68_MD5);
                  end if;
                  --
                  pck_pedidos_fav.prc_pedidos( pidpedido                 => :P68_IDPEDIDO
                                             , pidedicaorevista          => :P68_IDEDICAOREVISTA
                                             , pidsituacaoentrega        => :P68_IDSITUACAOENTREGA
                                             , pidsituacaofinanceiro     => :P68_IDSITUACAOFINANCEIRO
                                             , pidsituacaocobranca       => :P68_IDSITUACAOCOBRANCA
                                             , pidfilialromance          => :P68_IDFILIALROMANCE
                                             , pidfilialfavorita         => :P68_IDFILIALFAVORITA
                                             , pidgerente                => :P68_IDGERENTE
                                             , pidrepresentante          => :P68_IDREPRESENTANTE
                                             , pidvendedora              => :P68_IDVENDEDORA
                                             , pidusuario                => :P68_IDUSUARIO
                                             , pnumeropedido             => :P68_NUMEROPEDIDO
                                             , pdataemissao              => vdataemissao     --:P68_DATAEMISSAO
                                             , pdataentrega              => vdataentrega     --:P68_DATAENTREGA
                                             , pdatadespacho             => vdatadespacho    --:P68_DATADESPACHO
                                             , pdatacancelamento         => vdatacancelamento--:P68_DATACANCELAMENTO
                                             , pnumeroposicaoatendimento => :P68_NUMEROPOSICAOATENDIMENTO
                                             , pidpedidooriginal         => :P68_IDPEDIDOORIGINAL
                                             , prastreiotransporte       => :P68_VASTREIOTRANSPORTE
                                             , pvalortotal               => vvalortotal            --:P68_VALORTOTAL
                                             , pvalorpontoutilizado      => vvalorpontoutilizado   --:P68_VALORPONTOUTILIZADO
                                             , pvalordesconto            => vvalordesconto         --:P68_VALORDESCONTO
                                             , pvalortotalcomdesconto    => vvalortotalcomdesconto --:P68_VALORTOTALCOMDESCONTO
                                             , pvalorfrete               => vvalorfrete            --:P68_VALORFRETE
                                             , pvalorapagar              => vvalorapagar           --:P68_VALORAPAGAR
                                             , pemespera                 => :P68_EMESPERA
                                             , pedicaobloqueada          => :P68_EDICAOBLOQUEADA
                                             , ptipopedido               => vtipopedido 
                                             , pidnegociadoraresponsavel => :P68_IDNEGOCIADORARESPONSAVEL
                                             , pmd5                      => :P68_MD5
                                             , poperacao_dml             => 'U');
                  --
                  pck_pedidos_fav.prc_calculapedido( pidpedido      => vidpedido
                                                   , pvalortotal    => vvalortotal
                                                   , pvalorpontos   => vvalorpontoutilizado
                                                   , pvalorfrete    => vvalorfrete
                                                   , pvalordesconto => vvalordesconto
                                                   , pvalorapagar   => vvalorapagar
                                                   , pqtditens      => vqtditens);
                  --
                  select idvalorcaracteristica
                  into vidformaentrega
                  from classificacoespedidos
                  where idpedido               = vidpedido
                    and idcaracteristicapedido = 13;-- entrega
                  --
                  select idvalorcaracteristica
                  into vidformapagamento
                  from classificacoespedidos
                  where idpedido               = vidpedido
                    and idcaracteristicapedido = 8;
                  --
                  pck_pedidos_fav.prc_gerafinanceiropedido( pidpedido         => vidpedido
                                                          , pidusuario        => vidusuario
                                                          , pidformapagamento => vidformapagamento
                                                          , pidformaentrega   => vidformaentrega
                                                          , pvalorapagar      => vvalorapagar
                                                          , pqtdparcelas      => null
                                                          , penviooperadora   => null
                                                          , pretornooperadora => null
                                                          , pdatavencimento   => null);
                  --
                end;
                ```
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Atualizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 572602572621663644
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SALVARPEDIDO,ZERARFRETE,EMESPERA,EMATENDIMENTO
        }
    )

    process caracterisiticas-cobrança (
        name: Caracterisiticas Cobrança
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  vidcaracteristica number;
                  vidclassificacao  number;
                  vidvalor          number;
                  vobservacao       varchar2(1000);
                  vmd5              varchar2(1000);
                  vidpedido         number := :P68_IDPEDIDO;
