    process confirmar-cod-rastreio (
        name: Confirmar Cod Rastreio
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidcaracteristica number := 52;
                  vidvalor number;
                  vidclassificacao number;
                  vdata date := sysdate;
                  vobservacao varchar2(1000) := :P68_CODIGO_RASTREIO;
                  vmd5 varchar2(1000);
                  vexiste varchar2(1);
                begin
                  --
                  begin
                    select 'S' 
                         , c.idclassificacaopedido
                    into vexiste
                       , vidclassificacao
                    from classificacoespedidos c
                    where c.idpedido = :P68_IDPEDIDO
                      and c.idcaracteristicapedido = 52;
                  exception
                    when others then
                      vexiste := 'N';
                  end;
                  --
                  if vexiste = 'S' then
                    --
                    pck_pedidos_fav.prc_classificacoespedidos(pidclassificacaopedido => vidclassificacao,
                                                              pidpedido => :P68_IDPEDIDO,
                                                              pdataclassificado => vdata,
                                                              pidusuario => :P0_IDUSUARIO,
                                                              pidcaracteristicapedido => vidcaracteristica,
                                                              pidvalorcaracteristica => vidvalor,
                                                              pobservacao => vobservacao,
                                                              poperacao_dml => 'D',
                                                              pmd5 => vmd5);
                    --
                    vidclassificacao := null;
                    --
                    pck_pedidos_fav.prc_classificacoespedidos(pidclassificacaopedido => vidclassificacao,
                                                              pidpedido => :P68_IDPEDIDO,
                                                              pdataclassificado => vdata,
                                                              pidusuario => :P0_IDUSUARIO,
                                                              pidcaracteristicapedido => vidcaracteristica,
                                                              pidvalorcaracteristica => vidvalor,
                                                              pobservacao => vobservacao,
                                                              poperacao_dml => 'I',
                                                              pmd5 => vmd5);
                    --
                  else
                    --
                    pck_pedidos_fav.prc_classificacoespedidos(pidclassificacaopedido => vidclassificacao,
                                                              pidpedido => :P68_IDPEDIDO,
                                                              pdataclassificado => vdata,
                                                              pidusuario => :P0_IDUSUARIO,
                                                              pidcaracteristicapedido => vidcaracteristica,
                                                              pidvalorcaracteristica => vidvalor,
                                                              pobservacao => vobservacao,
                                                              poperacao_dml => 'I',
                                                              pmd5 => vmd5);
                    --
                  end if;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 280
        }
        successMessage {
            successMessage: Código de Rastreio informado com Sucesso!
        }
        advanced {
            executionMappingIdentifier: 785087214263776232
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMAR_RASTREIO
        }
    )

    process controla-fluxo-de-pedidos-do-estoque (
        name: Controla fluxo de pedidos do estoque
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Created on 02/08/2020 by MAX.BERKEUER 
                declare 
                  --
                  vid_pedido number := :P68_IDPEDIDO;
                  vtipo_filial char(1);
                  --
                begin
                  --
                  select f.tipofilial
                  into vtipo_filial
                  from filiaisfavorita f
                  where f.idfilialfavorita = :P68_IDFILIALFAVORITA;
                  --
                  /*Quando filial estoque, pula a situação do pedido*/
                  --
                  if vtipo_filial = 'E' then
                    --
                    if :REQUEST = 'FATURAMENTO_CONFIRMAR' then
                      --
                      update pedidos ps
                      set ps.idsituacaofinanceiro = 35000
                      where ps.idpedido = vid_pedido;  
                      --
                    elsif :REQUEST = 'CONFIRMAR_ENTREGA' then
                      --
                      update pedidos ps
                      set ps.idsituacaoentrega = 60000
                      where ps.idpedido = vid_pedido;  
                      --
                    end if;
                    --
                  end if;
                  --
                end;
                ```
        }
