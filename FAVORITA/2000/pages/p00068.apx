            encryptSessionState: false
        }
    )

    pageItem P68_AVISO_TAREFA_ANALISE (
        type: displayOnly
        label {
            alignment: left
        }
        layout {
            sequence: 10
            region: @pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            preText: <font color="GREEN"><b>Este pedido possui uma tarefa de Análise de Crédito!</b></font>
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P68_IDSITUACAOENTREGA = 20000
                  and exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.usuario = v('APP_USER')
                                 and ug.idgrupoatendimento = 9 )
                  and exists ( select 1
                               from tarefas t
                                  , vendedoras v
                               where t.idpessoa = v.idpessoa
                                 and t.idtipotarefa = 29
                                 and t.idsituacao = 0
                                 and v.idvendedora = :P68_IDVENDEDORA )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

