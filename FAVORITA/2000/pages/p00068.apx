    }
    security {
        pageAccessProtection: unrestricted
        browserCache: false
    }

    region adicionar-brinde (
        name: Adicionar Brinde
        type: staticContent
        layout {
            sequence: 30
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                --:P68_VERSAOPEDIDOS = 2 and :P68_IDSITUACAOENTREGA <= 20000 and :P68_EDICAOBLOQUEADA = 'N' 
                ((  :P0_IDFILIALFAVORITA = 1 and :P68_IDSITUACAOENTREGA <= 30000 ) and :P0_IDUSUARIO not in (797,5497,325,5284,5772,387,1157) ) or v('APP_USER') in ('GUILHERME','DIEGOPIECHO')
                ```
        }
    )

    region altera-forma-entrega (
        name: Altera Forma Entrega
        type: staticContent
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-size600x400
            ]
        }
        advanced {
            htmlDomId: ALTERAFORMAENTREGA
            regionDisplaySelector: true
        }
    )

    region aviso (
        name: Aviso
        type: staticContent
        layout {
            sequence: 50
            slot: breadcrumbBar
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 40
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item!=value
            item: P68_CANCELADO
            value: S
        }
    )

    region brinde-call-center (
        name: Brinde Call Center
        type: staticContent
        layout {
            sequence: 100
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-size600x400
            ]
        }
        advanced {
            htmlDomId: BRINDE_CALLCENTER
        }
    )

    region características (
        name: Características
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.idclassificacaopedido
                     , w.dataclassificado as "Data"
                     , w.usuario as "Usuário"
                     , w.caracteristica as "Caracteristica"
                     , w.descricao as "Decrição"
                     , w.observacao as "Observação"
                from vw_classificacoespedidos_fav w
                where idpedido = :P68_IDPEDIDO
                and ididioma = :P0_IDIDIOMA
                order by w.idclassificacaopedido
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM DUAL
                WHERE :P68_IDSITUACAOENTREGA >= 20000
                ```
        }
        reportLayout {
            numberOfRows: 10000
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--horizontalBorders
            ]
            showNullValuesAs: -
        }
        pagination {
            type: showAll
        }

        column Caracteristica (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Caracteristica
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

        column Data (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Data
            }
            layout {
                sequence: 2
            }
            appearance {
                formatMask: dd/mm/rrrr hh24:mi:ss
            }
            sorting {
                sortable: false
            }
        )

        column Decrição (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Decrição
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
        )

        column IDCLASSIFICACAOPEDIDO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column Observação (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Observação
            }
            layout {
                sequence: 6
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column Usuário (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Usuário
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

    )

    region confirmar-cancelamento (
        name: Confirmar Cancelamento
        type: staticContent
        layout {
            sequence: 10
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-size480x320
