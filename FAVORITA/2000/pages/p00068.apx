    pageItem P68_VALORATUALIZADOPARAHOJE (
        type: textField
        label {
            label: Valor Atualizado P/ Hoje
            alignment: left
        }
        layout {
            sequence: 600
            region: @pedido
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                /*select to_char(sum(pck_util_fav.fnc_calculajuros(pvalororiginal      => v.valorpagar- v.valorpago,
                                                             pdatavencimentoorig => v.datavencimento,
                                                             pdatavencimentonovo => trunc(sysdate),
                                                             ppercmulta          => 2,
                                                             ppercjuros          => 1)),'999G999G9999G999G990D00') valor
                from vencimentospedidos v
                where idpedido = :P68_IDPEDIDO
                  and v.situacaovencimento = 'V'
                  and exists ( SELECT 1
                               FROM DUAL
                               WHERE :P68_IDSITUACAOENTREGA >= 20000
                                 AND NOT EXISTS ( SELECT 1
                                                  FROM CLASSIFICACOESPEDIDOS C
                                                  WHERE C.IDPEDIDO = :P68_IDPEDIDO
                                                    AND C.IDCARACTERISTICAPEDIDO = 25 ) )*/
                                                    
                /*select to_char(pck_util.fnc_calculajuros(pvalororiginal      => p.saldodevedor,
                                                 pdatavencimentoorig => p.datavencimentomenor,
                                                 pdatavencimentonovo => sysdate,
                                                 ppercmulta          => 2,
                                                 ppercjuros          => 1),'999G999G9999G999G990D00') valoratualizado
                from favorita.vw_pedidos_fav p 
                where p.idpedido = :P68_IDPEDIDO
                  and p.ididioma = :P0_IDIDIOMA*/
                  
                --Osiel - 28/06/2024 - Ticket 8918171
                select to_char(favorita.pck_util_fav.fnc_calculajurosporvencimento( pidpedido   => p.idpedido,
                                                                                    ppercmulta  => 2,
                                                                                    ppercjuros  => 1),'999G999G9999G999G990D00') valoratualizado
                from favorita.vw_pedidos_fav p 
                where p.idpedido = :P68_IDPEDIDO
                  and p.ididioma = :P0_IDIDIOMA
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from pedidos p
                where exists ( select 1
                               from vencimentospedidos v
                               where v.idpedido = p.idpedido
                                 and v.situacaovencimento = 'V'
                                 and v.valorpagar > 0
                                 and v.datavencimento < trunc(sysdate)
                                 and v.valorpago < v.valorpagar )
                  and p.idpedido = :P68_IDPEDIDO
                ```
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P68_VALORDEBITOFAVORITA (
        type: displayOnly
        label {
            label: Valor Débito Favorita
            alignment: left
        }
        layout {
            sequence: 640
            region: @pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vsaldo number;
                begin
                  --
                  select nvl(( select sum(v.saldodevedor)
                               from vw_pedidos_fav_new v
                               where idvendedora    = :P68_IDVENDEDORA
                                 and exists ( select 1
                                              from vencimentospedidos vp
                                              where vp.idpedido = v.idpedido 
                                              and vp.situacaovencimento = 'V'
                                              and trunc(vp.datavencimento) < trunc(sysdate)
                                              and (vp.valorpago + nvl(( select sum(nvl(p.valorpago, 0))
                                                                        from pagamentospedidos p
                                                                        where p.idvencimentopedido = vp.idvencimentopedido
                                                                          and nvl(p.idsituacao, 0) in (40) ), 0)) < vp.valorpagar)
                                 and v.tipopedido   = 'P'
                                 and not exists ( select 1 
                                                  from favorita.classificacoespedidos cp
                                                  where cp.idpedido = v.idpedido
                                                    and cp.idcaracteristicapedido = 25)
                                 and v.saldodevedor > 0)  ,0)
                       + nvl(( select sum(c.saldodevedor)
                               from vw_pedidos_old c
                               where idvendedora    = :P68_IDVENDEDORA
                                 and c.saldodevedor > 0.5 
                                 and c.idsituacao not in ( 'Q','U','K')) ,0)
                       + nvl(( select sum(t.saldodevedor)
                               from vw_pedidos_fav_new t
                               where idvendedora    = :P68_IDVENDEDORA
                                 and exists ( select 1
                                              from vencimentospedidos vp
                                              where vp.idpedido = t.idpedido 
                                              and vp.situacaovencimento = 'V'
                                              and trunc(vp.datavencimento) < trunc(sysdate)
                                              and (vp.valorpago + nvl(( select sum(nvl(p.valorpago, 0))
                                                                        from pagamentospedidos p
                                                                        where p.idvencimentopedido = vp.idvencimentopedido
                                                                          and nvl(p.idsituacao, 0) in (40) ), 0)) < vp.valorpagar)
                                 and t.tipopedido   = 'T'
                                 and t.valorapagar  > 0
                                 and t.saldodevedor > 0) ,0)
                  into vsaldo
                  from dual;
                  --
                  return vsaldo;
                  --
                end;
                ```
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vsaldo number;
                begin
                  --
                  select nvl(( select sum(v.saldodevedor)
                               from vw_pedidos_fav_new v
                               where idvendedora    = :P68_IDVENDEDORA
                                 and exists ( select 1
                                              from vencimentospedidos vp
                                              where vp.idpedido = v.idpedido 
                                              and vp.situacaovencimento = 'V'
                                              and trunc(vp.datavencimento) < trunc(sysdate)
                                              and (vp.valorpago + nvl(( select sum(nvl(p.valorpago, 0))
                                                                        from pagamentospedidos p
                                                                        where p.idvencimentopedido = vp.idvencimentopedido
                                                                          and nvl(p.idsituacao, 0) in (40) ), 0)) < vp.valorpagar)
                                 and v.tipopedido   = 'P'
                                 and not exists ( select 1 
                                                  from favorita.classificacoespedidos cp
                                                  where cp.idpedido = v.idpedido
                                                    and cp.idcaracteristicapedido = 25)
                                 and v.saldodevedor > 0)  ,0)
                       + nvl(( select sum(c.saldodevedor)
                               from vw_pedidos_old c
                               where idvendedora    = :P68_IDVENDEDORA
                                 and c.saldodevedor > 0.5 
                                 and c.idsituacao not in ( 'Q','U','K')) ,0)
                       + nvl(( select sum(t.saldodevedor)
                               from vw_pedidos_fav_new t
                               where idvendedora    = :P68_IDVENDEDORA
                                 and exists ( select 1
                                              from vencimentospedidos vp
                                              where vp.idpedido = t.idpedido 
                                              and vp.situacaovencimento = 'V'
                                              and trunc(vp.datavencimento) < trunc(sysdate)
                                              and (vp.valorpago + nvl(( select sum(nvl(p.valorpago, 0))
                                                                        from pagamentospedidos p
                                                                        where p.idvencimentopedido = vp.idvencimentopedido
                                                                          and nvl(p.idsituacao, 0) in (40) ), 0)) < vp.valorpagar)
                                 and t.tipopedido   = 'T'
                                 and t.valorapagar  > 0
                                 and t.saldodevedor > 0) ,0)
                  into vsaldo
                  from dual;
                  --
                  return vsaldo;
                  --
                end;
                ```
        }
    )

