    button analise-credito-aprovar (
        buttonName: ANALISE_CREDITO_APROVAR
        label: Aprovar Pedido
        layout {
            sequence: 40
            region: @movimentação-interna
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-check
        }
        behavior {
            action: redirectUrl
            targetUrl: "javascript:apex.confirm('Deseja realmente aprovar?', { request:'APROVARPEDIDO'})"
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where ( exists ( select 1
                                 from classificacoespedidos c
                                 where c.idcaracteristicapedido = 13
                                   and c.idvalorcaracteristica  in (2,6,7)
                                   and c.idpedido               = :P68_IDPEDIDO ) 
                        or :P68_TIPOPEDIDO = 'V' )
                   and :P68_IDSITUACAOENTREGA = 20000
                   and pck_util.fnc_verificaacesso(58060,v('APP_USER')) = 'S'
                ```
        }
    )

    button analise-credito-aprovar-remessa (
        buttonName: ANALISE_CREDITO_APROVAR_REMESSA
        label: Aprovar Pedido
        layout {
            sequence: 50
            region: @movimentação-interna
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-check
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 331
                items: {
                    P331_IDPEDIDO: &P68_IDPEDIDO.
                    P331_IDFILIALROMANCE: &P68_IDFILIALROMANCE.
                    P331_IDPOSTOAVANCADO: &P68_IDPOSTOAVANCADO.
                    P331_IDCOMPRATRANSFERENCIA:
                    P331_DATAEMISSAOREMESSA:
                    P331_ORIGEM: 68
                }
                clearCache: [
                    68
                    331
                ]
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where ( exists ( select 1
                                 from classificacoespedidos c
                                 where c.idcaracteristicapedido = 19
                                   and c.idvalorcaracteristica  in (2,3)
                                   and c.idpedido               = :P68_IDPEDIDO 
                                   and ( select c.idvalorcaracteristica
                                         from classificacoespedidos c
                                         where c.idcaracteristicapedido = 13
                                           and c.idpedido               = :P68_IDPEDIDO ) != 6)
                     or exists ( select 1
                                 from classificacoespedidos c
                                 where c.idcaracteristicapedido = 13
                                   and c.idvalorcaracteristica  in (4,5)
                                   and c.idpedido               = :P68_IDPEDIDO ) ) 
                  and :P68_IDSITUACAOENTREGA = 20000
                  
                  /*and not exists ( select 1
                                   from roman.vw_filiais
                                   where ididioma = 2 
                                   and idfilial = :P68_IDFILIALROMANCE )*/  
                  and pck_util.fnc_verificaacesso(58060,v('APP_USER')) = 'S'
                ```
        }
    )

