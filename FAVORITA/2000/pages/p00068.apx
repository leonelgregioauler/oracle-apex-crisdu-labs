    pageItem P68_IDUSUARIORESPONSAVELCOB (
        type: selectList
        label {
            label: Responsável Cobrança
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select pck_util_fav.fnc_nomeusuario(u.idusuario) nome
                     , idusuario 
                from catal.usuarios u
                where u.idgerente = 80
                  and u.ativo = 'S'
                  and exists ( select 1
                               from roman.usuariosgruposatendimento g
                               where g.usuario = u.usuario
                                 and g.idgrupoatendimento = 3)
                order by 1
                ```
        }
        layout {
            sequence: 40
            region: @pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidusuario number;
                begin
                  --
                  select idusuarioresponsavelcobranca
                  into vidusuario
                  from pedidos p
                  where p.idpedido = :P68_IDPEDIDO;
                  --
                  return vidusuario;
                  --
                exception
                  when others then
                    return null;
                end;
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where exists ( select 1
                               from pedidos
                               where idpedido = :P68_IDPEDIDO
                                 and idusuarioresponsavelcobranca is not null )
                ```
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from usuarios
                where idusuario = :P0_IDUSUARIO
                  and idgerente not in (80,180)
                ```
        }
        security {
            encryptSessionState: false
        }
    )

