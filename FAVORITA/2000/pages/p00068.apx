            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  vtroca varchar2(1) := 'N';
                  --
                begin
                  --
                  select 'true'
                  into vtroca
                  from pedidos p
                  where p.tipopedido = 'T'
                    and p.idfilialfavorita = 109
                    and p.idpedido = :P68_IDPEDIDO;
                  --
                  return vtroca;
                  --
                exception
                  when others then
                    return 'false';
                end;
                ```
        }
