    process integrar-pedidos-adapto (
        name: Integrar pedidos adapto
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vpedidoadaptoloja varchar2(1);
                  vmensagem varchar2(4000);
                begin
                  --
                  select case
                           when idpedidoadapto is not null and 
                                  tipofilial = 'L' 
                           then 'S'
                           else 'N'
                         end pedidoadaptoloja
                    into vpedidoadaptoloja
                    from ( select p.idpedidoadapto   
                                , ( select f.tipofilial
                                      from filiaisfavorita f
                                     where f.idfilialfavorita = :P68_IDFILIALFAVORITA ) tipofilial
                             from pedidos p
                            where p.idpedido = :P68_IDPEDIDO ) t;
                  --
                  if vpedidoadaptoloja = 'S' then
                  
                    --raise_application_error(-20001,'Botao em fase de teste!');
                
                    roman.pck_integracao_ecommerceva.prc_processa_pedidos(pidpedido => :P68_IDPEDIDO,
                                                                          pmensagem => vmensagem);
                    --
                    commit;
                    --
                    :P68_MENS_INTEG := nvl(vmensagem,'Pedido Integrado com sucesso!!');
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 510
        }
        successMessage {
            successMessage: &P68_MENS_INTEG.
        }
