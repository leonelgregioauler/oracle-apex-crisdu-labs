    dynamicAction abre-site (
        name: Abre site
        execution {
            sequence: 10
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: item=value
            item: P68_EDICAOBLOQUEADA
            value: N
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                 from dual
                 where :P68_VERSAOPEDIDOS = 1
                ```
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: fnc_editapedido();
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction abre-site-adapto (
        name: Abre site adapto
        execution {
            sequence: 20
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: item=value
            item: P68_EDICAOBLOQUEADA
            value: N
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P68_VERSAOPEDIDOS = 2
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: fnc_editapedido_adapto();
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction alterafe (
        name: AlteraFE
        execution {
            sequence: 150
        }
        when {
            event: click
            selectionType: button
            button: @alterar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: ALTERAFORMAENTREGA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction atualiza-dte (
        name: Atualiza_DTE
        execution {
            sequence: 250
        }
        when {
            selectionType: items
            items: P68_TIPODTE
        }

        action native-confirm (
            action: confirm
            settings {
                message: Confirma alterar Tipo de Facturación?
                style: warning
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      --
                      v_existe     number;
                      v_idclassif  number;
                      v_data       date := sysdate;
                      v_idusuario  number := :P0_IDUSUARIO;
                      v_caract     number := 121;
                      v_observacao varchar2(100) := 'Tipo Facturación DTEMITE';
                      v_varnull    varchar2(1000);
                      v_dml        varchar2(1) := 'I';
                      --
                    begin
                      --
                      if :P68_IDPAIS = 6 then
                        --
                        begin
                          select idclassificacaopedido, 'U'
                            into v_idclassif
                               , v_dml
                            from classificacoespedidos
                           where idpedido = :P68_IDPEDIDO
                             and idcaracteristicapedido = v_caract;
                        exception
                          when others then null;
                        end;
                        --
                        favorita.pck_pedidos_fav.prc_classificacoespedidos(pidclassificacaopedido  => v_idclassif,
                                                                           pidpedido               => :P68_IDPEDIDO,
                                                                           pdataclassificado       => v_data,
                                                                           pidusuario              => v_idusuario,
                                                                           pidcaracteristicapedido => v_caract,
                                                                           pidvalorcaracteristica  => :P68_TIPODTE,
                                                                           pobservacao             => v_observacao,
