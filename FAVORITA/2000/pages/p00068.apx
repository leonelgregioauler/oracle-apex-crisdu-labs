    pageItem P68_CFOP (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @características
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vcfop   number;
                begin
                  --
                  select idvalorcaracteristica 
                  into vcfop
                  from classificacoespedidos 
                  where idcaracteristicapedido = 49
                  and idpedido = :P68_IDPEDIDO;
                  --
                  return vcfop;
                  --
                exception
                  when others then 
                    null;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

