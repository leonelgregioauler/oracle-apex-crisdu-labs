    button editar-taxa-delivery (
        buttonName: EDITAR_TAXA_DELIVERY
        label: Editar Taxa Delivery
        layout {
            sequence: 90
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 624
                items: {
                    P624_IDPEDIDO: &P68_IDPEDIDO.
                    P624_PAGINA_CHAMOU: 68
                }
                clearCache: 624
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select p.idpedido
                  from favorita.pedidos p
                 where p.idpedido = :P68_IDPEDIDO
                   and p.valorapagar >= (select nvl(valor,0)
                                           from favorita.parametros pp
                                          where pp.nome = 'TAXADELIVERYLOJAFAVORITA'
                                            and pp.idfilialfavorita = p.idfilialfavorita)
                   and exists( select 1
                                 from favorita.classificacoespedidos cc
                                where cc.idcaracteristicapedido in (110,13)
                                  and cc.idpedido = p.idpedido)
                   and exists (select 1
                                 from roman.aplicacoes ap
                                    , roman.acessos ac
                                where ap.descricao = 'ADM Tabela de Preços Delivery'
                                  and ac.idaplicacao = ap.idaplicacao
                                  and ac.ativo = 'S'
                                  and ac.usuario = v('APP_USER'));
                ```
        }
    )

