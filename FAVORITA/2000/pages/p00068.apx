    process pula-situação-para-pedidos-do-estoque (
        name: Pula situação para pedidos do estoque
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Created on 02/08/2020 by MAX.BERKEUER 
                declare 
                  --
                  vid_pedido number := :P68_IDPEDIDO;
                  vsit_entrega number;
                  vsit_financeiro number;
                  vtipo_filial char(1);
                  vidpais number;
                  vdelivery varchar2(1);
                  vtipo_pedido varchar2(1);
                  --
                begin
                  --
                  begin
                  select p.idsituacaoentrega,
                         p.idsituacaofinanceiro,
                         fl.tipofilial,
                         p.idpais,
                         p.tipopedido
                  into vsit_entrega,
                       vsit_financeiro,
                       vtipo_filial,
                       vidpais,
                       vtipo_pedido
                  from pedidos p,
                       filiaisfavorita fl
                  where p.idfilialfavorita = fl.idfilialfavorita 
                    and p.idpedido = vid_pedido;
                     exception
                    when no_data_found then
                      null;
                    end;
                  --
                  begin
                    --
                    select 'S'
                    into vdelivery
                    from classificacoespedidos cp
                       , usuarios u
                    where cp.idcaracteristicapedido = 81
                      and cp.idpedido               = :P68_IDPEDIDO
                      and u.idusuario               = cp.idusuario
                      and u.usuario like '%DELIVERY%';
                    --
                  exception
                    when no_data_found then
                      vdelivery := 'N';
                  end;
                  --
                  /*Quando filial estoque, pula a situação do pedido*/
                  --
                  if vdelivery = 'N' then
                    --
                      if vtipo_filial = 'E' and vsit_entrega = 20000 and vsit_financeiro = 20000 and vidpais = 1 and vtipo_pedido != 'R' then
                        --
                        update pedidos ps
                        set ps.idsituacaoentrega = 55000,
                            ps.idsituacaofinanceiro = 40000
                        where ps.idpedido = vid_pedido;  
                        --
                      end if;
                      --
                      if vtipo_filial = 'E' and vsit_financeiro = 36000 and vsit_entrega = 60000 then
                        --
                        update pedidos ps
                        set ps.idsituacaofinanceiro = 35000
                        where ps.idpedido = vid_pedido;  
                        --
                      end if;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 62638336273605922
        }
    )

