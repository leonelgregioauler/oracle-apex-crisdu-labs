    process aprovar-pedido-informando-remessa (
        name: Aprovar Pedido informando Remessa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidtipo number;
                begin
                  --
                  pck_virtualage_fav.prc_operacao_fiscal(id_pedido => :P68_IDPEDIDO);
                  --
                  select idvalorcaracteristica
                  into vidtipo
                  from classificacoespedidos
                  where idpedido = :P68_IDPEDIDO
                    and idcaracteristicapedido = 19;
                  --
                  if vidtipo = 3 then
                    --
                    pck_movimentarpedidos_fav.prc_aprovaranalisepedido(pidpedido => :P68_IDPEDIDO,
                                                                       pidusuario => :P0_IDUSUARIO);
                    --
                    pck_comprastransf_fav.prc_processomanualpedidos( pidcompratransferencia => :P68_IDCOMPRATRANSFERENCIA,
                                                                     ptipoprocesso          => 'A',
                                                                     pnumeropedido          => :P68_NUMEROPEDIDO,
                                                                     pidusuario             => :P0_IDUSUARIO );
                    --
                  elsif vidtipo = 2 then
                    --
                    pck_comprastransf_fav.prc_buscaitensremessa(pidcompratransferencia => :P68_IDCOMPRATRANSFERENCIA,
                                                                pidpedido  => :P68_IDPEDIDO,
                                                                pidusuario => :P0_IDUSUARIO);
                    --
                    -- atualiza situações entrega e financeiro
                    pck_movimentarpedidos_fav.prc_atz_entrega_financ_auto( pidpedido  => :P68_IDPEDIDO
                                                                         , pidusuario => :P0_IDUSUARIO );
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 60
        }
        successMessage {
            successMessage: Pedido Aprovado!
        }
        advanced {
            executionMappingIdentifier: 572603329072663645
        }
        serverSideCondition {
            type: never
        }
    )

