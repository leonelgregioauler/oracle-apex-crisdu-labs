            region: @pedido
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<a href="'||pck_integracaototalexpress.fnc_link_traking(pidpedido => :P68_IDPEDIDO)||'" target="_blank">Rastrear Pedido</a>'as link
                from dual
                ```
            used: always
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                exists (select 1
                        from classificacoespedidos c
                        where c.idcaracteristicapedido = 13
                        and c.idvalorcaracteristica = 5
                        and c.idpedido = :P68_IDPEDIDO)
                and pck_integracaototalexpress.fnc_link_traking(pidpedido => :P68_IDPEDIDO) is not null
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P68_RASTREIOTRANSPORTE (
        type: textField
        label {
            label: Rastreio Transporte
            alignment: left
        }
        settings {
            subtype: url
            trimSpaces: none
        }
        layout {
            sequence: 350
            region: @pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select favorita.pck_integracaototalexpress.fnc_link_traking(p.idpedido) retorno
                    from favorita.pedidos p
                    where p.idpedido = :P68_IDPEDIDO
                      and exists ( select 1
                                   from favorita.classificacoespedidos cp
                                   where cp.idpedido = p.idpedido
                                     and cp.idcaracteristicapedido = 13
                                     and cp.idvalorcaracteristica = 5);
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

