    button integracao-prodadapto (
        buttonName: INTEGRACAO_PRODADAPTO
        label: Integrar Pedido Adapto
        layout {
            sequence: 270
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--success
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-exchange
        }
        behavior {
            action: definedByDynamicAction
            executeValidations: false
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vhostname       varchar2(100);
                  vacessoliberado varchar2(1);
                  vintegrado      varchar2(1);
                  vpedidoadapto   number;
                  vidempresavirtual number;
                begin
                  --
                  select idempresavirtualage, idpedidoadapto
                  into vidempresavirtual, vpedidoadapto
                  from pedidos p
                  where p.idpedido = :P68_IDPEDIDO;
                  --
                  select upper(sys_context('USERENV','SERVER_HOST')) 
                  into vhostname
                  from dual;
                  --
                  /*select pck_util_fav.fnc_verificaacesso (28333, :P0_IDUSUARIO) acessoliberado
                  into vacessoliberado
                  from dual;*/
                  vacessoliberado := 'S';
                  --
                  begin
                    --
                    select 'S'
                    into vintegrado
                    from classificacoespedidos c
                    where c.idpedido = :P68_IDPEDIDO
                      and c.idcaracteristicapedido = 43;
                    --
                  exception
                    when others then
                      vintegrado := 'N';
                  end;
                  --
                  if vacessoliberado = 'S' and vintegrado = 'N' and nvl(vpedidoadapto,0) > 0 then
                    return true;
                  else
                    return false;
                  end if;
                  --
                end;
                ```
        }
    )

    button integracao-producao (
        buttonName: INTEGRACAO_PRODUCAO
        label: Integrar Pedido V1
        layout {
            sequence: 210
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--success
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-exchange
        }
        behavior {
            action: redirectUrl
            targetUrl: "javascript: AtivarIntegracaoVirtualAgePRD(function(x){console.log(x)})"
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vhostname       varchar2(100);
                  vacessoliberado varchar2(1);
                  vintegrado      varchar2(1);
                  vpedidoadapto     number;
                  vidempresavirtual number;
                begin
                  --
                  select idempresavirtualage, idpedidoadapto
                  into vidempresavirtual, vpedidoadapto
                  from pedidos p
                  where p.idpedido = :P68_IDPEDIDO;
                  --
                  select upper(sys_context('USERENV','SERVER_HOST')) 
                  into vhostname
                  from dual;
                  --
                  select pck_util_fav.fnc_verificaacesso (28333, :P0_IDUSUARIO) acessoliberado
                  into vacessoliberado
                  from dual;
                  --
                  begin
                    --
                    select 'S'
                    into vintegrado
                    from classificacoespedidos c
                    where c.idpedido = :P68_IDPEDIDO
                      and c.idcaracteristicapedido = 43;
                    --
                  exception
                    when others then
                      vintegrado := 'N';
                  end;
                  --
                  -- HOMOLOGAÇÃO
                  if vhostname = 'SRVBD02' then
                    return false;
                  -- PRODUÇÃO
                  elsif vacessoliberado = 'S' and vintegrado = 'N' /*and nvl(vpedidoadapto,0) = 0 */ then
                    return true;
                  end if;
                  --
                end;
                ```
        }
    )

