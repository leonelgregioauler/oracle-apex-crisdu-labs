    process remove-tarefa-análise-de-crédito (
        name: Remove Tarefa Análise de Crédito
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidtarefa number;
                begin
                  --
                  select idtarefa 
                  into vidtarefa
                  from tarefas t
                     , vendedoras v
                  where t.idpessoa = v.idpessoa
                    and t.idtipotarefa = 29
                    and t.idsituacao = 0
                    and v.idvendedora = :P68_IDVENDEDORA;
                  --
                  delete historicostarefas h
                  where h.idtarefa = vidtarefa;
                  --
                  delete tarefas t
                  where t.idtarefa = vidtarefa;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 360
        }
        successMessage {
            successMessage: Tarefa removida com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1514640253639713526
        }
        serverSideCondition {
            type: request=Value
            value: REMOVER_TAREFA
        }
    )

    process remover-caracterisiticas-cobrança (
