    process gera-aviso-de-falta-do-produto-e-zerar-estoque (
        name: Gera aviso de falta do Produto e zerar estoque
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  insert into favorita.teste values('testepagina',:P68_IDITEMEDITAR,:P68_IDPEDIDO,:P0_IDUSUARIO,'');
                  --
                  pck_movimentarpedidos_fav.prc_zeraestoquedisponivel( piditempedido => :P68_IDITEMEDITAR
                                                                     , pidpedido     => :P68_IDPEDIDO
