    process envio-para-cobrança-terceirizada (
        name: Envio para Cobrança Terceirizada
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidclassificacaopedido  number;
                  vidpedido               number := :P68_IDPEDIDO;
                  vdataclassificado       date := sysdate;
                  vidusuario              number := :P0_IDUSUARIO;
                  vidcaracteristicapedido number := 77;
                  vidvalorcaracteristica  number;
                  vobservacao             varchar2(1000);
                  vmd5                    varchar2(1000);
                  --
                begin
                  --
                  insert into historicospedidos ( idhistoricopedido
                                                , idpedido
                                                , datahistorico
                                                , idusuario
                                                , descricao
                                                , imprimirnopedido
                                                , liberaedicao
                                                , liberamontagem )
                  select seq_idhistoricopedido.nextval
                       , :P68_IDPEDIDO
                       , cc.dataclassificado
                       , cc.idusuario
                       , 'Desfeito o envio do pedido para a cobrança terceirizada'
                       , 'N'
                       , 'N'
                       , 'N'
                  from classificacoespedidos cc
                  where cc.idpedido = :P68_IDPEDIDO
                    and cc.idcaracteristicapedido = 88;
                  --
                  delete classificacoespedidos cp
                  where cp.idcaracteristicapedido = 88
                    and cp.idpedido = :P68_IDPEDIDO;
                  --
                  pck_pedidos_fav.prc_classificacoespedidos( pidclassificacaopedido  => vidclassificacaopedido,
                                                             pidpedido               => vidpedido,
                                                             pdataclassificado       => vdataclassificado,
                                                             pidusuario              => vidusuario,
                                                             pidcaracteristicapedido => vidcaracteristicapedido,
                                                             pidvalorcaracteristica  => vidvalorcaracteristica,
                                                             pobservacao             => vobservacao,
                                                             poperacao_dml           => 'I',
                                                             pmd5                    => vmd5);
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 420
        }
        successMessage {
            successMessage: Envio realizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 7275360853554523
        }
        serverSideCondition {
            type: request=Value
            value: ENVIO_COBTERC
        }
    )

    process envio-prevenção-gera-tarefa-pap (
        name: Envio Prevenção/Gera tarefa PAP
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidclassificacaopedido  number;
                  vidpedido               number := :P68_IDPEDIDO;
                  vdataclassificado       date := sysdate;
                  vidusuario              number := :P0_IDUSUARIO;
                  vidcaracteristicapedido number := 98;
                  vidvalorcaracteristica  number;
                  vobservacao             varchar2(1000) := 'Enviada Para Prevenção';
                  vmd5                    varchar2(1000);
                  vexiste                 varchar2(1);
                  vtelefone               varchar2(30);
                  --
                begin
                  -- Maicon Aimi - 28/06/2024 - 9163005
                  -- ajuste para permitir inserir mais de uma vez a classificação de envio ao PAP.
                  begin
                      select count(1) + 1
                        into vidvalorcaracteristica
                        from favorita.classificacoespedidos c
                       where c.idpedido               = :P68_IDPEDIDO
                         and c.idcaracteristicapedido = 98;
                  exception
                    when others then
                      vidvalorcaracteristica := 1;
                  end;
                
                  --
                  pck_pedidos_fav.prc_classificacoespedidos( pidclassificacaopedido  => vidclassificacaopedido,
                                                             pidpedido               => vidpedido,
                                                             pdataclassificado       => vdataclassificado,
                                                             pidusuario              => vidusuario,
                                                             pidcaracteristicapedido => vidcaracteristicapedido,
                                                             pidvalorcaracteristica  => vidvalorcaracteristica,
                                                             pobservacao             => vobservacao,
                                                             poperacao_dml           => 'I',
                                                             pmd5                    => vmd5);
                  --
                  begin
                    --
                    select translate(t.telefone,'0123456789AaBbCcDdEeFfGgHhIiJjKkLlMmNnOoPpQqRrSsTtUuVvXxYyWwZz_-,.  !@#$%?&*()/??','0123456789') telefone
                    into vtelefone
                    from telefonespessoas t
                    where t.idpessoa = :P68_IDPESSOA
                      and rownum = 1;
                    --
                  exception 
                    when NO_DATA_FOUND then
                      vtelefone := null;
                  end;
                  --
                  begin
                      --
                      select 'S'
                      into vexiste
                      from favorita.tarefas t
                      where t.idpessoa = :P68_IDPESSOA
                        and t.idtipotarefa = 69
                        and t.idsituacao in (0,10,20)
                        and t.idgrupoatendimento = 73;
                    exception 
                      when others then
                        vexiste := 'N';
                  end;
                    --
                    if vexiste = 'N' then
                      --
                      insert into favorita.tarefas ( idtarefa            , datainclusao    , idsituacao
                                                   , observacao          , idtipotarefa    , idpessoa
                                                   , idgrupoatendimento  , telefone        , idusuario
                                                   , idcanalatendimento )
                      values ( favorita.seq_idtarefa.nextval ,   sysdate ,  0
                             , pck_util.fnc_retornatelefones(:P68_IDPESSOA) , 69  , :P68_IDPESSOA
                             , 73 , vtelefone , :P0_IDUSUARIO, 4 ); 
                      --
                    end if;
                    --
                end;
                ```
        }
        execution {
            sequence: 430
        }
        successMessage {
            successMessage: Envio realizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 32981802848069128
        }
        serverSideCondition {
            whenButtonPressed: @enviar-pap
        }
    )

    process fetch-row (
        name: Fetch Row
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vdataemissao            date;
                  vdataentrega            date;
                  vdatadespacho           date;
                  vdatacancelamento       date;
                  vvalortotal             number;
                  vvalorpontoutilizado    number;
                  vvalordesconto          number;
                  vvalortotalcomdesconto  number;
                  vvalorfrete             number;
                  vvalorapagar            number;
                  --
                  vdocumento         varchar2(100);
                  vemail             varchar2(100);
                  vsenha             varchar2(100);
                  vretorno           varchar2(100);
                  vidpessoa          number;
                  vidvendedora       number;
                  vidrepresentante   number;
                  vidfilial          number;
                  vedicoesrevista    varchar2(100);
                  vqtddebitos        number(15,2);
                  vvlrlimiteped      number(15,2);
                  vvlrlimiteminimo   number(15,2);
                  vpontosdisp        number(15,2);
                  vvlrmaximoped      number(15,2);
                  vatendenteloja     varchar2(100);
                  vidfilialfavorita  number;
                  vidusuario         number;
                  vtipospagamentos   varchar2(100);
                  vtiposentregas     varchar2(100);
                  vmensagem          varchar2(100);
                  vidpedido          number;
                  vidpais            number;
                  vliberafazerpedido varchar2(100);
                  vdescontoextra     number;
                  vvalorpendente     number;
                  vexiste            number;
                  vparcelas          number;
                  vidformapagto      number;
                  vtotaldescontoADL  number;
                  vADLaplicado       varchar2(1);
                  vpedidorepres      varchar2(1); -- Pedido de representante: Sim | Não
                  vpedidoadaptoloja  varchar2(1);
                  vtipofilial        varchar2(1);
                  vtipodte           number;
                  vidpessoarep       number;
                  --
                begin
                  --
                if v('APP_USER') = 'MAICONAIMI' then
                roman.prc_grava_log_debug_desenvolvedores('iaushdfioauhsdfiuoahsduif','1');-- log maicon <>
                end if;
                  pck_pedidos_fav.prc_pedidos( pidpedido                 => :P68_IDPEDIDO
                                             , pidedicaorevista          => :P68_IDEDICAOREVISTA
                                             , pidsituacaoentrega        => :P68_IDSITUACAOENTREGA
                                             , pidsituacaofinanceiro     => :P68_IDSITUACAOFINANCEIRO
                                             , pidsituacaocobranca       => :P68_IDSITUACAOCOBRANCA
                                             , pidfilialromance          => :P68_IDFILIALROMANCE
                                             , pidfilialfavorita         => :P68_IDFILIALFAVORITA
                                             , pidgerente                => :P68_IDGERENTE
                                             , pidrepresentante          => :P68_IDREPRESENTANTE
                                             , pidvendedora              => :P68_IDVENDEDORA
                                             , pidusuario                => :P68_IDUSUARIO
                                             , pnumeropedido             => :P68_NUMEROPEDIDO
                                             , pdataemissao              => vdataemissao     --:P68_DATAEMISSAO
                                             , pdataentrega              => vdataentrega     --:P68_DATAENTREGA
                                             , pdatadespacho             => vdatadespacho    --:P68_DATADESPACHO
                                             , pdatacancelamento         => vdatacancelamento--:P68_DATACANCELAMENTO
                                             , pnumeroposicaoatendimento => :P68_NUMEROPOSICAOATENDIMENTO
                                             , pidpedidooriginal         => :P68_IDPEDIDOORIGINAL
                                             , prastreiotransporte       => :P68_RASTREIOTRANSPORTE
                                             , pvalortotal               => vvalortotal            --:P68_VALORTOTAL
                                             , pvalorpontoutilizado      => vvalorpontoutilizado   --:P68_VALORPONTOUTILIZADO
                                             , pvalordesconto            => vvalordesconto         --:P68_VALORDESCONTO
                                             , pvalortotalcomdesconto    => vvalortotalcomdesconto --:P68_VALORTOTALCOMDESCONTO
                                             , pvalorfrete               => vvalorfrete            --:P68_VALORFRETE
                                             , pvalorapagar              => vvalorapagar           --:P68_VALORAPAGAR
                                             , pemespera                 => :P68_EMESPERA
                                             , pedicaobloqueada          => :P68_EDICAOBLOQUEADA
                                             , ptipopedido               => :P68_TIPOPEDIDO
                                             , pidnegociadoraresponsavel => :P68_IDNEGOCIADORARESPONSAVEL
                                             , pmd5                      => :P68_MD5
                                             , poperacao_dml             => 'S');
                  --
                if v('APP_USER') = 'MAICONAIMI' then
                roman.prc_grava_log_debug_desenvolvedores('iaushdfioauhsdfiuoahsduif','2');-- log maicon <>
                end if;
                  begin
                    select idpais
                      into :P68_IDPAIS
                      from pedidos p
                     where p.idpedido = :P68_IDPEDIDO;
                  exception
                    when others then null;
                  end;
                if v('APP_USER') = 'MAICONAIMI' then
                roman.prc_grava_log_debug_desenvolvedores('iaushdfioauhsdfiuoahsduif','2.1');-- log maicon <>
                end if;
                  --
                  -- Veririca tipo DTE para pedidos do Chile
                  if :P68_IDPAIS = 6 then
                    --
                    begin
                      select idvalorcaracteristica
                        into vtipodte
                        from classificacoespedidos
                       where idpedido = :P68_IDPEDIDO
                         and idcaracteristicapedido = 121;
                    exception
                      when no_data_found then 
                        select idpessoa
                          into vidpessoarep
                          from representantes 
                         where idrepresentante = :P68_IDREPRESENTANTE;
                    end;
                if v('APP_USER') = 'MAICONAIMI' then
                roman.prc_grava_log_debug_desenvolvedores('iaushdfioauhsdfiuoahsduif','2.2');-- log maicon <>
                end if;
                    --
                    --raise_application_error(-20001, 'vidpessoarep='||vidpessoarep||'  P68_IDPESSOA '||:P68_IDPESSOA);
                    --
                    if nvl(vtipodte,0) = 0 then
                      if :P68_IDPESSOA = vidpessoarep and vidpessoarep != 2631020 then
                        :P68_TIPODTE := 33;
                      else
                        :P68_TIPODTE := 39;
                      end if;
                    else
                      :P68_TIPODTE := vtipodte;
                    end if;
                    --
                    
                  end if;
                if v('APP_USER') = 'MAICONAIMI' then
                roman.prc_grava_log_debug_desenvolvedores('iaushdfioauhsdfiuoahsduif','3');-- log maicon <>
                end if;
                  --
                  :P68_IDSITUACAOENTREGA_EDITAR := :P68_IDSITUACAOENTREGA;
                  -- busca valor pendente - Este trecho estava no source do item. Foi colocado aqui para melhor organizacao
                  begin
                    select case
                             when sum(v.valorpagar - (v.valorpago + nvl(v.valordesconto,0))) < 0 then
                               0
                             else
                               sum(v.valorpagar - (v.valorpago + nvl(v.valordesconto,0))) 
                           end pendente
                      into vvalorpendente
                      from vencimentospedidos v
                     where idpedido = :P68_IDPEDIDO
                       and v.situacaovencimento in ('V')
                       and exists ( select 1
                                      from pedidos p
                                     where p.idpedido = v.idpedido 
                                       and ( p.tipopedido = 'P' or
                                             p.tipopedido = 'T' or
                                             p.tipopedido = 'F' or
                                             p.tipopedido = 'R' or
                                             p.tipopedido = 'V' and
                                             p.valorapagar > 0 ) )  ;
                  exception 
                    when NO_DATA_FOUND then null;
                  end;
                  --
                  begin
                    select case
                             when idpedidoadapto is not null and tipofilial = 'L' and idformapagamento in (24) then
                               'N'
                             when idpedidoadapto is not null and tipofilial = 'L' and idformapagamento in (2,1007) then
                               'S'
                             when idpedidoadapto is not null and tipofilial = 'C' and idformapagamento in (1007) then
                               'S'
                             else
                               'N'
                           end pedidoadaptoloja
                    into vpedidoadaptoloja
                    from ( select p.idpedidoadapto   
                                , ( select f.tipofilial
                                   from filiaisfavorita f
                                   where f.idfilialfavorita = :P68_IDFILIALFAVORITA ) tipofilial
                                , ( select cp.idvalorcaracteristica
                                    from classificacoespedidos cp
                                    where cp.idpedido = p.idpedido
                                      and cp.idcaracteristicapedido = 8 ) idformapagamento
                           from pedidos p
                           where p.idpedido = :P68_IDPEDIDO ) t;
                  exception
                    when others then
                      vpedidoadaptoloja := 'N';
                  end;
                  --
                  vADLaplicado := 'N';
                  begin
                    select 'S'
                      into vADLaplicado
                      from itenspedidos i
                         , pedidos p
                     where p.idpedido = :P68_IDPEDIDO
                       and p.idpedido = i.idpedido
                       and i.perccomissaoconsultora = 30
                       and p.idpedidoadapto is not null;
                  exception
                    when others then null;
                  end;
                  --
                  --
                  /*vpedidorepres := 'N';
                  begin
                    select 'S'
                      into vpedidorepres
                      from dual
                     where (select idpessoa
                              from vendedoras
                             where idvendedora = (select idvendedora 
                                                    from pedidos 
                                                   where idpedido = :P68_IDPEDIDO))
                           =
                           (select idpessoa
                              from representantes
                             where idrepresentante = (select idrepresentante 
                                                        from pedidos 
                                                       where idpedido = :P68_IDPEDIDO)) ;
                  exception
                    when others then null;
                  end;*/
                  -- Verifica se faz parte de campanha de adimplencia
                  :P68_LABEL_VALORTOTAL    := 'Valor Sugerido de Venda';
                  :P68_LABEL_VLRTOTCOMDESC := 'Valor do Documento';
                  --
                  vdescontoextra := 0;
                  begin
                    select idvalorcaracteristica
                      into vdescontoextra 
                      from classificacoespedidos
                       where idpedido = :P68_IDPEDIDO
                         and idcaracteristicapedido = 106;
                  exception
                   when others then vdescontoextra := 0;
                  end;
                  vtotaldescontoADL := vdescontoextra;
                  --
                  -- busca quantidade de parcelas
                  begin
                    select count(*)
                      into vparcelas
                      from vencimentospedidos
                     where idpedido = :P68_IDPEDIDO
                       and situacaovencimento = 'V';
                  exception
                    when others then null;
                  end;
                  --
                  begin
                    select idvalorcaracteristica
                      into vidformapagto
                      from classificacoespedidos
                     where idpedido = :P68_IDPEDIDO
                       and idcaracteristicapedido = 8;
                  exception
                      when others then null;
                  end;
                  --
                  if vidformapagto = 24 and vADLaplicado = 'S' then
                    --
                    vADLaplicado := 'N';
                    vdescontoextra := 0;
                    --
                  end if;
                  --
                  --
                  -- Para pedidos do Virtual Age que tenham as formas de pagamento abaixo, o desconto extra ja foi aplicado 
                  -- então não deve aplicar novamente.
                /*  begin
                    select 1
                      into vexiste
                      from pedidos pe
                         , vencimentospedidos ve
                         , pagamentospedidos pp
                     where pe.idpedido           = ve.idpedido
                       and ve.idvencimentopedido = pp.idvencimentopedido
                       and ve.situacaovencimento = 'V'
                       and pp.idformapagamento   in (2,21,22,23,24)
                       and pe.datacancelamento   is null
                       and pe.idpedido           = :P68_IDPEDIDO;
                  exception
                   when others then null;
                  end;*/
                  --
                  -- Quando o pedido for do Call-Center e o pagamento via cartão de crédito em 1 ou 2x daí o desconto já foi aplicado
                  -- e caso tenha sido em 3x ou mais, não tem direito ao desconto.
                /*  begin
                    select 1
                      into vexiste
                      from pedidos pe
                         , vencimentospedidos ve
                         , pagamentospedidos pp
                     where pe.idpedido           = ve.idpedido
                       and ve.idvencimentopedido = pp.idvencimentopedido
                       and ve.situacaovencimento = 'V'
                       and pp.idformapagamento = 3
                       and pp.nrparcelas in (1,2,3,4,5,6) 
                       and pe.datacancelamento   is null
                       and pe.idpedido           = :P68_IDPEDIDO;
                  exception
                    when others then null;
                  end;*/
                  --
                  if vpedidoadaptoloja = 'S' then
                    --
                    vdescontoextra := 0;
                    --
                  end if;
                  --
                  if vADLaplicado = 'S' then
                    vvalortotalcomdesconto := vvalortotalcomdesconto + vdescontoextra;
                  end if;
                  --
                  if nvl(vexiste,0) = 1 then
                    vdescontoextra := 0;
                  end if;
                  --
                  if vidformapagto in (1,26,27,34,36,37,43) then -- boletos
                    begin
                      --
                      select count(1) * (vdescontoextra / vparcelas),
                             1
                        into vdescontoextra,
                             vexiste
                        from favorita.vencimentospedidos v
                       where v.idpedido = :P68_IDPEDIDO
                         and v.valorpago = 0 
                         and v.situacaovencimento = 'V'
                         and vADLaplicado = 'N';
                    exception
                      when others then null;
                    end;
                  end if;
                  --
                  /*if vexiste = 1 then
                    --vvalordesconto := vvalordesconto - vdescontoextra;
                    --vvalortotalcomdesconto := vvalortotalcomdesconto + vdescontoextra;
                    vvalorapagar := vvalorapagar + vdescontoextra;
                  end if;*/
                  
                  --
                  if vidformapagto != 24 then
                    --
                    vvalorapagar           := vvalorapagar           - nvl(vdescontoextra,0);
                    --
                  else
                    --
                    vvalorapagar           := vvalorapagar           + nvl(vtotaldescontoADL,0);
                    --
                  end if;
                  --
                  if vvalorapagar < 0 then
                    vvalorapagar := 0;
                  end if;
                  --
                  if vvalorpendente > 0 then
                    vvalorpendente         := vvalorpendente         - nvl(vdescontoextra,0); 
                  elsif vvalorpendente < 0 then
                    vvalorpendente := 0;
                  end if;
                  --
                  :P68_DATAEMISSAO      := to_char(vdataemissao     ,'DD/MM/RRRR HH24:MI:SS');
                  :P68_DATAENTREGA      := to_char(vdataentrega     ,'DD/MM/RRRR');
                  :P68_DATADESPACHO     := to_char(vdatadespacho    ,'DD/MM/RRRR HH24:MI:SS');
                  :P68_DATACANCELAMENTO := to_char(vdatacancelamento,'DD/MM/RRRR HH24:MI:SS');
                  --
                  :P68_VALORTOTAL             := to_char(vvalortotal            ,'999G999G999G990D00');   
                  :P68_VALORPONTOUTILIZADO    := to_char(vvalorpontoutilizado   ,'999G999G999G990D00');
                  :P68_VALORDESCONTO          := to_char(vvalordesconto         ,'999G999G999G990D00');
                  :P68_VALORTOTALCOMDESCONTO  := to_char(vvalortotalcomdesconto ,'999G999G999G990D00');
                  :P68_VALORFRETE             := to_char(vvalorfrete            ,'999G999G999G990D00');
                  :P68_VALORAPAGAR            := to_char(vvalorapagar           ,'999G999G999G990D00');
                  --:P68_VALORDESCONTOEXTRA     := to_char(vdescontoextra         ,'999G999G999G990D00');
                  :P68_VALORDESCONTOEXTRA     := to_char(vtotaldescontoADL      ,'999G999G999G990D00');
                  :P68_VALORPENDENTE          := to_char(vvalorpendente         ,'999G999G999G990D00');
                  --
                  -- buscar limite da consultora
                  --
                  begin
                  --
                  select nvl(cpf, documentoestrangeiro)
                       , p.senhasite 
                       , p.idpessoa
                  into vdocumento            
                     , vsenha      
                     , :P68_IDPESSOA
                  from pessoas p
                     , vendedoras v
                  where v.idpessoa     = p.idpessoa
                    and v.idvendedora  = :P68_IDVENDEDORA;
                  --
                  exception
                      when NO_DATA_FOUND then null;
                    end;
                  --
                  pck_controle_fav.prc_login( pdocumento         => vdocumento
                                            , pemail             => vemail
                                            , psenha             => vsenha
                                            , pretorno           => vretorno
                                            , pidpessoa          => vidpessoa
                                            , pidvendedora       => vidvendedora
                                            , pidrepresentante   => vidrepresentante
                                            , pidfilial          => vidfilial
                                            , pedicoesrevista    => vedicoesrevista
                                            , pqtddebitos        => vqtddebitos
                                            , pvlrlimiteped      => :P68_LIMITECONSULTORA --vvlrlimiteped
                                            , pvlrlimiteminimo   => vvlrlimiteminimo
                                            , ppontosdisp        => vpontosdisp
                                            , pvlrmaximoped      => vvlrmaximoped
                                            , patendenteloja     => vatendenteloja
                                            , pidfilialfavorita  => vidfilialfavorita
                                            , pidusuario         => vidusuario
                                            , ptipospagamentos   => vtipospagamentos
                                            , ptiposentregas     => vtiposentregas
                                            , pmensagem          => vmensagem
                                            , pidpedido          => vidpedido
                                            , pidpais            => vidpais
                                            , pliberafazerpedido => vliberafazerpedido);
                  --
                  begin
                    --
                    select nvl(sum(itp.valorvenda * itp.quantidade),0)
                    into :P68_VALORTOTALINDISPONIVEL
                    from favorita.itensindisponiveispedidos itp
                    where itp.idpedido = :P68_IDPEDIDO;
                    --
                  exception
                    when NO_DATA_FOUND then 
                      :P68_VALORTOTALINDISPONIVEL := 0;
                  end;
                  --
                  begin
                    select 'S'
                    into :P68_CANCELADO
                    from classificacoespedidos c
                    where c.idcaracteristicapedido = 25
                      and c.idpedido = :P68_IDPEDIDO;
                    --
                    :P68_EDICAOBLOQUEADA := 'S';
                    --
                  exception
                    when NO_DATA_FOUND then
                      :P68_CANCELADO := 'N';
                  end;
                  --
                  begin
                    select t.nome,
                           to_char(p.taxadelivery, 'FM999G999G999D90') taxadelivery
                      into :P68_TABELA_DELIVERY,
                           :P68_TAXA_DELIVERY
                      from pedidos p,
                           tabelaprecosdelivery t
                     where p.idtabeladelivery = t.idtabelaprecosdelivery
                       and p.idpedido = :P68_IDPEDIDO;
                  exception
                    when NO_DATA_FOUND then
                      :P68_TABELA_DELIVERY := '0,00';
                      :P68_TAXA_DELIVERY := '0,00';
                  end;
                  --
                  --null;
                if v('APP_USER') = 'MAICONAIMI' then
                roman.prc_grava_log_debug_desenvolvedores('iaushdfioauhsdfiuoahsduif','final');-- log maicon <>
                end if;
                end;
                
                ```
        }
        execution {
            sequence: 20
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 572605782016663646
        }
    )

    process gera-aviso-de-falta-do-produto (
