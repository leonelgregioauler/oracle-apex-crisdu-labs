    region históricos-tarefas (
        name: Históricos Tarefas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ht.idhistoricotarefa
                     , ht.idtarefa
                     , ht.datainicio
                     , ht.datafim
                     , ht.observacao
                     , ht.idsituacao
                     , ht.situacaotarefa
                     , ht.idusuario
                     , ht.nomeusuario
                     , ht.numeroposicaoatendimento
                from tarefas t
                   , vw_historicostarefas_fav ht
                where t.idtarefa = ht.idtarefa
                and t.idpedido = :P68_IDPEDIDO
                and ht.ididioma = :P0_IDIDIOMA;
                ```
        }
        layout {
