    button enviar-membrezia-cl (
        buttonName: ENVIAR_MEMBREZIA_CL
        label: Enviar Membrezia
        layout {
            sequence: 410
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--iconLeft
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM   pedidos p
                       JOIN vendedoras v  ON v.idvendedora = p.idvendedora
                       JOIN pessoas   pes ON pes.idpessoa  = v.idpessoa
                WHERE  p.idpedido = :P68_IDPEDIDO
                  AND  pes.idpais in (6,13)
                  AND  p.datacancelamento IS NULL
                  AND  EXISTS (SELECT 1 FROM classificacoespedidos cfp
                               WHERE cfp.idpedido = p.idpedido
                                 AND cfp.idcaracteristicapedido = 8
                                 AND cfp.idvalorcaracteristica IN (55,56,57,58,59,60,61,65))
                  AND  NOT EXISTS (SELECT 1 FROM classificacoespedidos cja
                               WHERE cja.idpedido = p.idpedido
                                 AND cja.idcaracteristicapedido = 116)
                ```
        }
    )

    button enviar-membrezia-pa (
        buttonName: ENVIAR_MEMBREZIA_PA
