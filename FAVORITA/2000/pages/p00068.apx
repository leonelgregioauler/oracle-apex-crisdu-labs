    pageItem P68_CPF_BASE64 (
        type: displayOnly
        label {
            label: Base64
            alignment: left
        }
        layout {
            sequence: 620
            region: @pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vpagamentos varchar2(100);
                  ventregas   varchar2(100);
                  vbase64     varchar2(100);
                begin
                  --
                  pck_controle_fav.prc_retornaaudicencias(pidpedido         => :P68_IDPEDIDO,
                                                          pformaspagamentos => vpagamentos,
                                                          pformasentregas   => ventregas );
                  --
                  select roman.fnc_encode_base64(pp.cpf||';2;'||:P68_IDPEDIDO||';'||ventregas||';'||vpagamentos) cpf
                  into vbase64
                  from pessoas pp
                   , vendedoras v
                  where v.idpessoa = pp.idpessoa 
                    and v.idvendedora = :P68_IDVENDEDORA;
                  --
                  return vbase64;
                  --
                end;
                ```
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vpagamentos varchar2(100);
                  ventregas   varchar2(100);
                  vbase64     varchar2(100);
                begin
                  --
                  pck_controle_fav.prc_retornaaudicencias(pidpedido         => :P68_IDPEDIDO,
                                                          pformaspagamentos => vpagamentos,
                                                          pformasentregas   => ventregas );
                  --
                  select roman.fnc_encode_base64(pp.cpf||';2;'||:P68_IDPEDIDO||';'||ventregas||';'||vpagamentos) cpf
                  into vbase64
                  from pessoas pp
                   , vendedoras v
                  where v.idpessoa = pp.idpessoa 
                    and v.idvendedora = :P68_IDVENDEDORA;
                  --
                  return vbase64;
                  --
                end;
                ```
        }
        serverSideCondition {
            type: never
        }
    )

