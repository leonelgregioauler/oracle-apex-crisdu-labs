    region itens-do-pedido (
        name: Itens do Pedido
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select iditempedido
                     , idpedido
                     , idproduto
                     , idestoque
                     , idprodutodetalhado
                     , idcompreeganhe
                     , idbrinde
                     , idvendalimitada
                     , idpromocaodivulgacao
                     , idkitvenda
                     , iditemkitvenda
                     , ididioma
                     , idfilialfavorita
                     , nomeproduto
                     , nomeprodutodetalhado
                     , quantidade
                     , valorvenda
                     , valorcusto
                     , valordesconto
                     , valorapagar
                     , perccomissaogerente
                     , valorcomissaogerente
                     , perccomissaodistribuidor
                     , valorcomissaodistribuidor
                     , perccomissaoconsultora
                     , valorcomissaoconsultora
                     , valorcomissaoatendente
                     , estoquefavorita
                     , iditempedidogeroubrinde
                     , (quantidade * valorvenda) - valorapagar TotalDesconto
                     , '<a href="javascript:fnc_avisofalta('|| iditempedido ||')" ><img src="/i/menu/pencil16x16.gif"  border="0"></a>' avisofalta
                     , '<a href="javascript:fnc_avisofaltazeraestoque('|| iditempedido ||')" ><img src="/i/menu/pencil16x16.gif"  border="0"></a>' avisofaltazeraestoque
                     , dimensoes
                from vw_itenspedidos_fav
                where idpedido = :P68_IDPEDIDO
                 and ididioma = :P0_IDIDIOMA
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM DUAL
                WHERE :P68_IDSITUACAOENTREGA >= 20000
                ```
        }
