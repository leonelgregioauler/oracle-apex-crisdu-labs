    button transacao-homologacao (
        buttonName: TRANSACAO_HOMOLOGACAO
        label: Integrar Transação HMG
        layout {
            sequence: 10
            region: @transação-de-venda
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
