    pageItem P68_ENCODE_ADAPTO_CHILE (
        type: displayOnly
        label {
            label: Encode
            alignment: left
        }
        layout {
            sequence: 650
            region: @pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vpagamentos varchar2(100);
                  ventregas   varchar2(100);
                  vbase64     varchar2(4000);  -- era 100: hash do Express e maior
                  vtipofilial varchar2(1);
                  vidpais     number;
                  vexpress    varchar2(1) := 'N';
                  vidcd       number;
                begin
                  --
                  select f.tipofilial
                       , f.idpais
                  into vtipofilial
                     , vidpais
                  from filiaisfavorita f
                  where f.idfilialfavorita = :P68_IDFILIALFAVORITA;
                  --
                  -- procedure criada solta em produção para os testes do chile nao impactar operação
                  --
                  pck_controle_fav.prc_retornaaudicencias(pidpedido         => :P68_IDPEDIDO,
                                                          pformaspagamentos => vpagamentos,
                                                          pformasentregas   => ventregas );
                  --
                  if vpagamentos is null then
                    --
                    vpagamentos := '2,24,1007';
                    --
                  end if;
                  --
                  -- PEDIDO EXPRESS BELEM (origem 5)
                  -- identifica pelo usuario logado ou pelo usuario que criou o pedido
                  --
                  if nvl(:P68_TIPOPEDIDO,'P') <> 'R' then
                    begin
                      select 'S', u.idfilialfavorita  -- 6 = Estoque Belem (CD)
                      into vexpress, vidcd
                      from pedidos p
                         , usuarios u
                      where p.idpedido = :P68_IDPEDIDO
                        and u.usuario in ('DELIVERYCASTANHEIRA','DELIVERYPATIO')
                        and ( u.idusuario = p.idusuario or u.usuario = upper(:APP_USER) )
                        and rownum = 1;
                    exception
                      when no_data_found then
                        vexpress := 'N';
                    end;
                  end if;
                  --
                  if vexpress = 'S' then
                    --
                    select roman.fnc_encode_base64(nvl(pp.cpf,documentoestrangeiro)||';5;'||:P68_IDPEDIDO||';'||ventregas||';'||vpagamentos||';;;;;'||vidcd) cpf
                    into vbase64
                    from pessoas pp
                       , vendedoras v
                    where v.idpessoa    = pp.idpessoa
                      and v.idvendedora = :P68_IDVENDEDORA;
                    --
                  elsif vtipofilial = 'C' then
                    --
                    select roman.fnc_encode_base64(nvl(pp.cpf,documentoestrangeiro)||';2;'||:P68_IDPEDIDO||';'||ventregas||';'||vpagamentos) cpf
                    into vbase64
                    from pessoas pp
                     , vendedoras v
                    where v.idpessoa = pp.idpessoa
                      and v.idvendedora = :P68_IDVENDEDORA;
                    --
                  elsif vtipofilial = 'L' and vidpais = 1 then
                    --
                    if :P68_VALORDEBITOFAVORITA > 0 then
                      vpagamentos := '2,24,1007';
                    end if;
                    --
                    select roman.fnc_encode_base64(nvl(pp.cpf,documentoestrangeiro)||';3;'||:P68_IDPEDIDO||';'||ventregas||';'||vpagamentos||';'||:P68_IDFILIALFAVORITA) cpf
                    into vbase64
                    from pessoas pp
                     , vendedoras v
                    where v.idpessoa = pp.idpessoa
                      and v.idvendedora = :P68_IDVENDEDORA;
                    --
                  elsif vtipofilial = 'L' and vidpais in (4,2,6) then
                    --
                    select roman.fnc_encode_base64(nvl(pp.cpf,documentoestrangeiro)||';3;'||:P68_IDPEDIDO||';'||ventregas||';'||vpagamentos||';'||:P68_IDFILIALFAVORITA) cpf
                    into vbase64
                    from pessoas pp
                     , vendedoras v
                    where v.idpessoa = pp.idpessoa
                      and v.idvendedora = :P68_IDVENDEDORA;
                    --
                  elsif vtipofilial = 'E' and :P68_TIPOPEDIDO = 'R' then -- pedido romance casa feito em loja, saindo pelo CD
                    --
                    if ventregas = '' then
                      --
                      ventregas := '1';
                      --
                    end if;
                    --
                    select roman.fnc_encode_base64(nvl(pp.cpf,documentoestrangeiro)||';2;'||:P68_IDPEDIDO||';'||ventregas||';'||vpagamentos) cpf
                    into vbase64
                    from pessoas pp
                     , vendedoras v
                    where v.idpessoa = pp.idpessoa
                      and v.idvendedora = :P68_IDVENDEDORA;
                    --
                  else
                    --
                    select roman.fnc_encode_base64(nvl(pp.cpf,documentoestrangeiro)||';3;'||:P68_IDPEDIDO||';'||ventregas||';'||vpagamentos) cpf
                    into vbase64
                    from pessoas pp
                     , vendedoras v
                    where v.idpessoa = pp.idpessoa
                      and v.idvendedora = :P68_IDVENDEDORA;
                    --
                  end if;
                  --
                  return vbase64;
                  --
                end;
                ```
            used: always
        }
    )

