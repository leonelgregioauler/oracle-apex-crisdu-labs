            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vvencimentos varchar2(2000);
                begin
                  --
                  select listagg(to_char(v.datavencimento,'DD/MM/RRRR'),' - ') within group (order by 1)
                  into vvencimentos
                  from vencimentospedidos v
                  where v.idpedido = :P68_IDPEDIDO
                    and v.situacaovencimento = 'V';
                  --
                  if vvencimentos = '' then
                    --
                    vvencimentos := 'Não há Vencimentos!';
                    --
                  end if;
                  --
                  return vvencimentos;
                  --
                end;
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P68_VERSAOPEDIDOS (
        type: displayOnly
        label {
            label: Versao
            alignment: left
        }
        layout {
            sequence: 690
            region: @pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vlibera varchar2(1);
                  vparametro varchar2(100);
                  vpedidopontos varchar2(1);
                begin
                  --
                  begin
                    --
                    select 'S'
                    into vpedidopontos
                    from classificacoespedidos cp
                    where cp.idpedido = :P68_IDPEDIDO
                      and cp.idcaracteristicapedido = 5;
                    --
                  exception
                    when others then
                      vpedidopontos := 'N';
                  end;
                  --
                  select  pck_util_fav.fnc_retornaparametro(pidfilialfavorita =>:P0_IDFILIALFAVORITA,pidfilialromance => null,pparametro => 'LOJA UTILIZANDO ADAPTO') 
                  into vparametro
                  from dual;
                  --
                  if :P68_IDFILIALFAVORITA = 1  and vpedidopontos = 'N' /*and :P0_IDUSUARIO in (5495,463,280,783,280,8077,5280,797,5497,325,5284,5772,387,486,7178,8108,7618,8426,8196,7988,7419,6767,5833,9189)*/ then
                    --
                    vlibera := 'S';
                    --
                  elsif :P68_TIPOPEDIDO = 'R' then
                    --
                    vlibera := 'S';
                    --
                  elsif vpedidopontos = 'S' then
                    --
                    vlibera := 'N';
                    --
                  elsif :P68_IDFILIALFAVORITA = 38 and :P0_IDUSUARIO in (1157,463, 8430,3906,8280,5728,6739,6265,41,715) then
                    --
                    vlibera := 'S';
                    --
                  elsif :P68_IDFILIALFAVORITA in (5,90) and :P0_IDUSUARIO in (5437,7963,627,7953,5737,8677,463) then
                    --
                    vlibera := 'S';
                    --
                  elsif vparametro = 'S' then
                    --
                    vlibera := 'S';
                    --
                  else
                    vlibera := 'N';
                  end if;
                  --
                  if vlibera = 'S' then
                    return 2;
                  else 
                    return 1;
                  end if;
                  --
                end;
                ```
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vlibera varchar2(1);
                  vparametro varchar2(100);
                  vpedidopontos varchar2(1);
                begin
                  --
                  begin
                    --
                    select 'S'
                    into vpedidopontos
                    from classificacoespedidos cp
                    where cp.idpedido = :P68_IDPEDIDO
                      and cp.idcaracteristicapedido = 5;
                    --
                  exception
                    when others then
                      vpedidopontos := 'N';
                  end;
                  --
                  select  pck_util_fav.fnc_retornaparametro(pidfilialfavorita =>:P0_IDFILIALFAVORITA,pidfilialromance => null,pparametro => 'LOJA UTILIZANDO ADAPTO') 
                  into vparametro
                  from dual;
                  --
                  if :P68_IDFILIALFAVORITA = 1  and vpedidopontos = 'N' /*and :P0_IDUSUARIO in (5495,463,280,783,280,8077,5280,797,5497,325,5284,5772,387,486,7178,8108,7618,8426,8196,7988,7419,6767,5833,9189)*/ then
                    --
                    vlibera := 'S';
                    --
                  elsif :P68_TIPOPEDIDO = 'R' then
                    --
                    vlibera := 'S';
                    --
                  elsif vpedidopontos = 'S' then
                    --
                    vlibera := 'N';
                    --
                  elsif :P68_IDFILIALFAVORITA = 38 and :P0_IDUSUARIO in (1157,463, 8430,3906,8280,5728,6739,6265,41,715) then
                    --
                    vlibera := 'S';
                    --
                  elsif :P68_IDFILIALFAVORITA in (5,90) and :P0_IDUSUARIO in (5437,7963,627,7953,5737,8677,463) then
                    --
                    vlibera := 'S';
                    --
                  elsif vparametro = 'S' then
                    --
                    vlibera := 'S';
                    --
                  else
                    vlibera := 'N';
                  end if;
                  --
                  if vlibera = 'S' then
                    return 2;
                  else 
                    return 1;
                  end if;
                  --
                end;
                ```
        }
    )

