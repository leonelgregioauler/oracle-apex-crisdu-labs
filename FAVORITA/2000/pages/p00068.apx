    pageItem P68_AVISO_LIMITEMINIMO (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 80
            region: @aviso
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<font color="green"><h3>O valor mínimo deste pedido é '||trim(to_char( (p.valor) * nvl((round( 1 / f.fatorconversao, 2) ), 1),'999G999G999G999G990D00'))||'.</h3></font>' aviso
                from roman.vw_filiais f
                   , parametros p
                where f.idfilial(+) = p.idfilialromance
                  and p.idfilialromance = :P68_IDFILIALROMANCE
                  and p.nome = 'VALORMINIMOPEDIDO';
                ```
            used: always
        }
        serverSideCondition {
            type: item!=value
            item: P68_EDICAOBLOQUEADA
            value: S
