    process confirma-entrega-do-pedido-na-loja (
        name: Confirma Entrega do Pedido na Loja
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  check_negativo EXCEPTION;
                  PRAGMA EXCEPTION_INIT(check_negativo, -02290);
                  --
                  rqtd number;
                  --
                begin
                  --
                  pck_movimentarpedidos_fav.prc_confirmaentregapedido(pidpedido => :P68_IDPEDIDO,
                                                                      pidusuario => :P0_IDUSUARIO );
                  --
                exception
                  when check_negativo then
                    -- quando estourar o erro do ORA-02290: restrição de verificação (FAVORITA.CHK_ESTOQUES_NEGATIVO) violada
                    --
                    -- insere na tabela que controlara quando for recebido uma transferencia nova para dar baixa nos itens pednetes que forem possiveis
                    --
                    for ritens in ( select i.iditempedido
                                         , i.quantidade
                                         , i.idestoque
                                    from favorita.itenspedidos i
                                    where i.idpedido = :P68_IDPEDIDO
                                      and not exists ( select 1
                                                       from favorita.controleestoques c
                                                       where c.iditempedido = i.iditempedido) ) 
                    loop
                      --
                      if favorita.pck_estoque_fav.fnc_estoquedisponivel(ritens.idestoque) > 0 then
                        --
                        rqtd := ritens.quantidade * -1;
                        --
                        pck_estoque_fav.prc_movimentosestoques(pidestoque          => ritens.idestoque,
                                                               pidfilialfavorita   => null,
                                                               pidusuario          => :P0_IDUSUARIO,
                                                               pidprodutodetalhado => null,
                                                               piditempedido       => ritens.iditempedido,
                                                               piditemcompratransf => null,
                                                               pquantidade         => rqtd,
                                                               pmotivo             => null);
                        --
                      elsif favorita.pck_estoque_fav.fnc_estoquedisponivel(ritens.idestoque) <= 0 then
                        --
                        insert into itempendenteintvirtual
                        values ( ritens.iditempedido
                               , ritens.quantidade
                               , sysdate
                               , null);
                        --
                      end if;
                      --
                    end loop;
                    --
                end;
                ```
        }
        execution {
            sequence: 160
        }
        successMessage {
            successMessage: Pedido entregue com sucesso!
        }
        advanced {
            executionMappingIdentifier: 572605318036663646
        }
