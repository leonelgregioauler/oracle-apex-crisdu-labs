    pageItem P68_IDPOSTOAVANCADO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 520
            region: @pedido
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select idpostoavancado
                from representantes r
                where r.idrepresentante = :P68_IDREPRESENTANTE
                  and :P68_IDFILIALROMANCE not in ( 320 , 122 , 124 , 401 , 1070 , 120 )
                ```
            used: always
        }
        default {
            type: expression
            plsqlExpression: null
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P68_IDPRODUTODETALHADO (
        type: popupLov
        label {
            label: Brinde
            alignment: left
        }
        settings {
            initialFetch: onUserRequest
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT produto||' - '||REPLACE(substr(produto,0,instr(produto,' ')),'.','') ||' Estoque:'||disponivel 
                produto
                     , idprodutodetalhado
                FROM (     
                        select pck_util_fav.fnc_nomeprodutodetalhado(pd.idprodutodetalhado,1) produto
                             , pck_estoque_fav.fnc_estoquedisponivel(idestoque) disponivel
                             , pd.idprodutodetalhado 
                        from produtosdetalhados pd
                           , estoques e
                           , pedidos p
                        where pd.ativo = 'S'
                          and e.idprodutodetalhado = pd.idprodutodetalhado
                          and p.idpedido = :P68_IDPEDIDO
                          and p.idfilialfavoritaestoque = e.idfilialfavorita  
                        order by 1                 )
                where disponivel > 0
                ```
        }
        cascadingLov {
            parentItems: P68_IDPEDIDO
        }
        layout {
            sequence: 10
            region: @brinde-call-center
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
    )

