                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--iconLeft
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM   pedidos p
                       JOIN vendedoras v  ON v.idvendedora = p.idvendedora
                       JOIN pessoas   pes ON pes.idpessoa  = v.idpessoa
                WHERE  p.idpedido = :P68_IDPEDIDO
                  AND  pes.idpais = 13
                  AND  p.datacancelamento IS NULL
                  AND  pes.documentoestrangeiro_orig IS NOT NULL
                  AND  TRIM(pes.documentoestrangeiro_orig) IS NOT NULL
                  AND  EXISTS (SELECT 1 FROM classificacoespedidos cfp
                               WHERE cfp.idpedido = p.idpedido
                                 AND cfp.idcaracteristicapedido = 8
                                 AND cfp.idvalorcaracteristica IN (55,56,57,58,59,60,61,65))
                  AND  NOT EXISTS (SELECT 1 FROM classificacoespedidos cja
                               WHERE cja.idpedido = p.idpedido
                                 AND cja.idcaracteristicapedido = 116)
                ```
        }
    )

    button enviar-pap (
        buttonName: ENVIAR_PAP
        label: Enviar PAP
        layout {
            sequence: 240
            region: @setor-de-cobrança
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--warning
                t-Button--simple
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                
                  -- Escopo para criação de veriável e cursor
                  vIDUltimoEnvioPAP     number;
                  vIDUltimaRetiradaPAP  number;
                  
                begin
                  
                  -- Busca ultimo envio ao PAP.
                  begin
                    select nvl(max(c.idclassificacaopedido),0) id
                      into vIDUltimoEnvioPAP
                      from favorita.classificacoespedidos c
                     where c.idcaracteristicapedido = 98
                       and c.idpedido = :P68_NUMEROPEDIDO;
                  exception
                    when others then
                      vIDUltimoEnvioPAP := 0;
                  end;
                
                  -- Busca ultima retirada do PAP.
                  begin
                    select nvl(max(c.idclassificacaopedido),0) id
                      into vIDUltimaRetiradaPAP
                      from favorita.classificacoespedidos c
                     where c.idcaracteristicapedido = 99
                       and c.idpedido = :P68_NUMEROPEDIDO;
                  exception
                    when others then
                      vIDUltimaRetiradaPAP := 0;
                  end;
                
                  -- Verifica se libera o botão de envio ao PAP
                  if vIDUltimoEnvioPAP = 0 then
                    return true; -- Cai aqui quando nunca foi enviado ao PAP.
                    
                  elsif vIDUltimoEnvioPAP < vIDUltimaRetiradaPAP then
                    return true; -- Cai aqui quando foi retirado do PAP, então permite novo envio.
                  
                  else
                    return false; -- Cai aqui quando possui envio ao PAP ativo, não permitindo novo envio.
                    
                  end if;
                
                end;
                ```
        }
    )

