                where to_number(:P68_VALORFRETE,'999G999G999G990D00') > 0
                  and ( pck_util_fav.fnc_verificagrupoatendimento(4,pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'N' 
                     or pck_util_fav.fnc_verificagrupoatendimento(25,pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S' )
                ```
        }
    )

