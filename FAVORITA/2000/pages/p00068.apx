    region itens-indisponíveis-do-pedido (
        name: Itens indisponíveis do Pedido
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select iditempedido
                     , idpedido
                     , idproduto
                     , idestoque
                     , idprodutodetalhado
                     , idcompreeganhe
                     , idbrinde
                     , idvendalimitada
                     , idpromocaodivulgacao
                     , idkitvenda
                     , iditemkitvenda
                     , ididioma
                     , idfilialfavorita
                     , nomeproduto
                     , nomeprodutodetalhado
                     , quantidade
                     , valorvenda
                     , valortotalvenda
                     , valorcusto
                     , valordesconto
                     , valorapagar
                     , perccomissaogerente
                     , valorcomissaogerente
                     , perccomissaodistribuidor
                     , valorcomissaodistribuidor
                     , perccomissaoconsultora
                     , valorcomissaoconsultora
                     , valorcomissaoatendente
                     , favorita.pck_util_fav.fnc_nomefilialfavorita(favorita.pck_util_fav.fnc_retornaidfilialfavusuario(idusuario)) filialfez
                from vw_itensindisppedidos_fav
                where idpedido = :P68_IDPEDIDO
                  and ididioma = :P0_IDIDIOMA
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM DUAL
                WHERE :P68_IDSITUACAOENTREGA >= 20000
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        enableUsersTo {
            download: false
        }
        advanced {
            savedReportMappingIdentifier: 1832626663552473432
        }

