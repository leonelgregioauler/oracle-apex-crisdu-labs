                begin
                  --
                  if v('REQUEST') = 'DESFAZER_ENVIAR_SPC' then
                    vidcaracteristica := 44;
                  elsif  v('REQUEST') = 'DESFAZER_ENVIAR_DOCUMENTACAO' then
                    vidcaracteristica := 45;
                  elsif  v('REQUEST') = 'DESFAZER_INCOBRAVEL' then
                    vidcaracteristica := 46;
                  end if;
                  --
                  vidsituacaocobranca := 50;
                  --
                  --
                  if v('REQUEST') = 'DESFAZER_ENVIAR_SPC' then
                    --
                    update vendedoras v
                    set spc = 'N'
                    where v.idvendedora = :P68_IDVENDEDORA;
                    --
                  end if;
                  --
                  -- Call the procedure
                  pck_movimentarpedidos_fav.prc_atualizasituacaocobranca(pidpedido => :P68_IDPEDIDO,
                                                                         pidsituacao => vidsituacaocobranca,
                                                                         pidusuario => :P0_IDUSUARIO);
                  --
                  select idclassificacaopedido
                  into vidclassificacao
                  from classificacoespedidos c
                  where c.idpedido = :P68_IDPEDIDO
                    and c.idcaracteristicapedido = vidcaracteristica;
                  --
                  pck_pedidos_fav.prc_classificacoespedidos(pidclassificacaopedido => vidclassificacao,
                                                            pidpedido => :P68_IDPEDIDO,
                                                            pdataclassificado => vdata,
                                                            pidusuario => :P0_IDUSUARIO,
                                                            pidcaracteristicapedido => vidcaracteristica,
                                                            pidvalorcaracteristica => vidvalor,
                                                            pobservacao => vobservacao,
                                                            poperacao_dml => 'D',
                                                            pmd5 => vmd5);
                  --
                end;
                
                ```
