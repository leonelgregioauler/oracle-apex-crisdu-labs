    dynamicAction consulta-dados-da-entrega-correio (
        name: Consulta Dados da Entrega Correio
        execution {
            sequence: 90
        }
        when {
            event: focusout
            selectionType: items
            items: P68_CEPDESTINO
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    //var request = new XMLHttpRequest();
                    //request.open("GET", "http://ws.correios.com.br/calculador/CalcPrecoPrazo.aspx?sCepOrigem=70002900&sCepDestino=04547000&nVlPeso=1&nVlComprimento=20&nVlAltura=20&nVlLargura=20&nCdServico=04510&nVlDiametro=0&StrRetorno=xml", false);
                    //request.send();
                    //var xml = request.responseXML;
                    //var codigo = xml.getElementsByTagName("Codigo");
                    
                    vcepdestino    = $("#P68_CEPDESTINO")[0].value;
                    vpeso          = $("#P68_PESO")[0].value;
                    vprofundidade  = $("#P68_PROFUNDIDADE")[0].value;
                    vlargura       = $("#P68_LARGURA")[0].value;
                    valtura        = $("#P68_ALTURA")[0].value;
                    
                    vpeso          = parseFloat(vpeso);
                    vprofundidade  = parseFloat(vprofundidade);
                    vlargura       = parseFloat(vlargura);
                    valtura        = parseFloat(valtura);
                    
                    var dadosfrete = 'https://ws.catalogofavorita.com.br/executar/correios/calcular_frete?str={"CEP_ORIGEM":"95650000", "CEP_DESTINO":" '+vcepdestino+' ", "PESO_KG":'+vpeso+', "COMPRIMENTO_CM":'+vprofundidade+', "LARGURA_CM":'+vlargura+', "ALTURA_CM":'+valtura+'}'
                    var endereco   = 'https://viacep.com.br/ws/'+vcepdestino+'/json';
                    
                    function consultaFrete (data) {
                        
                       $("#P68_VALOR").val(data.valor);
                    
                      }
                      
                      $.getJSON(dadosfrete).done(consultaFrete);
                    
                    function consultaEndereco (data) {
                        
                       $("#P68_ENDERECO").val(data.logradouro + ', ' + data.bairro + ' - ' + data.localidade);
                    
                      }
                    
                      $.getJSON(endereco).done(consultaEndereco);
                    
                    
                    
                    
                    
                    
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction desativado-incluir-nova-cobrança-frete-e-novo-endereço (
        name: DESATIVADO Incluir nova cobrança frete e novo endereço
        execution {
            sequence: 100
        }
        when {
            event: click
            selectionType: button
            button: @atualizar
        }
        serverSideCondition {
            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                      --
                      update classificacoespedidos cp
                      set cp.observacao = 'Nova cobrança de frete no valor de: '||:P68_VALOR
                      where cp.idpedido = :P68_IDPEDIDO
                      and cp.idcaracteristicapedido = 13;
                      --
                      update classificacoespedidos cp
                      set cp.observacao = 'Novo endereço de entrega: '||:P68_ENDERECO
                      where cp.idpedido = :P68_IDPEDIDO
                      and cp.idcaracteristicapedido = 7;
                      --
                      update pedidos
                      set valorfrete = valorfrete + to_number(replace(:P68_VALOR, '.', ','))
                      where idpedido = :P68_IDPEDIDO;
                      --
                      commit;
                      --
                    end;
                    ```
                itemsToSubmit: [
                    P68_VALOR
                    P68_ENDERECO
                    P68_IDPEDIDO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction executa-integração-transação-hmg-prod (
        name: Executa Integração Transação HMG / PROD
        execution {
            sequence: 120
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .transacao
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      vretorno            varchar2(200);
                      --
                      vempresa            number;
                      vnumerotransacao    number;
                      vdescricaoerro      varchar2(200);
                    begin
                      --
                      pck_integracao_fav_virtualage.prc_cadastrarpessoa( pidpessoa  => :P68_IDPESSOA,
                                                                         pidpedido  => :P68_IDPEDIDO,
                                                                         pidusuario => :P0_IDUSUARIO,
                                                                         pretorno   => vretorno );
                      --
                      pck_integracao_fav_virtualage.prc_incluirtransacao( pidpedido        => :P68_IDPEDIDO,
                                                                          pidusuario       => :P0_IDUSUARIO,
                                                                          pempresa         => vempresa,
                                                                          pnumerotransacao => vnumerotransacao,
                                                                          pdescricaoerro   => vdescricaoerro );
                      --
                    end;
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: javascript: ExibeAguarde();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    javascript: OcultaAguarde();
                    
                    winwidth  = 770;  // largura da nova janela
                    winheight = 450;  // altura da nova janela 
                    winleft   = 200;  // (nao alterar)
                    wintop    = 200;  // (nao alterar)
                    
                    vendereco = document.getElementById("P68_SESSION_INTEGRAR").value;
                    vjanela = window.open(vendereco, '_blank', 'top=' + wintop + ',left=' + winleft + ',height=' + winheight + ',width=' + winwidth); 
                    vjanela.focus();
                    ```
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

