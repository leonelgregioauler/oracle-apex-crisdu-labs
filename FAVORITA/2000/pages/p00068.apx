    process envia-para-o-membrezia-chile (
        name: Envia para o membrezia Chile
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  v_idpais   NUMBER;
                  v_cancel   pedidos.datacancelamento%TYPE;
                  v_ja116    NUMBER := 0;
                BEGIN
                  -- dados do pedido: pais da vendedora e cancelamento
                  BEGIN
                    SELECT pes.idpais, p.datacancelamento
                      INTO v_idpais, v_cancel
                      FROM pedidos p
                      JOIN vendedoras v ON v.idvendedora = p.idvendedora
                      JOIN pessoas   pes ON pes.idpessoa  = v.idpessoa
                     WHERE p.idpedido = :P68_IDPEDIDO;
                  EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                      apex_error.add_error(
                        p_message => 'Pedido no encontrado.',
                        p_display_location => apex_error.c_inline_in_notification);
                      RETURN;
                  END;
                
                  -- trava: pedido cancelado
                  IF v_cancel IS NOT NULL THEN
                    apex_error.add_error(
                      p_message => 'Pedido cancelado. No se integra a Membrezia.',
                      p_display_location => apex_error.c_inline_in_notification);
                    RETURN;
                  END IF;
                
                  -- trava: so Chile
                  IF v_idpais <> 6 THEN
                    apex_error.add_error(
                      p_message => 'Pedido no es de Chile.',
                      p_display_location => apex_error.c_inline_in_notification);
                    RETURN;
                  END IF;
                
                  -- trava: nao duplicar (ja tem Integracao Membrezia = classificacao 116)
                  SELECT COUNT(1) INTO v_ja116
                    FROM classificacoespedidos cp
                   WHERE cp.idpedido = :P68_IDPEDIDO
                     AND cp.idcaracteristicapedido = 116;
                  IF v_ja116 > 0 THEN
                    apex_error.add_error(
                      p_message => 'Pedido ya integrado a Membrezia.',
                      p_display_location => apex_error.c_inline_in_notification);
                    RETURN;
                  END IF;
                
                  -- integra (mesma proc usada na entrada do pedido do Chile)
                  pck_integracao_adapto.prc_integramembrezia(:P68_IDPEDIDO);
                
                  -- confere se gravou a 116 (sucesso real)
                  SELECT COUNT(1) INTO v_ja116
                    FROM classificacoespedidos cp
                   WHERE cp.idpedido = :P68_IDPEDIDO
                     AND cp.idcaracteristicapedido = 116;
                
                  IF v_ja116 = 0 THEN
                    apex_error.add_error(
                      p_message => 'Membrezia no confirmo la suscripcion. Revise el pedido.',
                      p_display_location => apex_error.c_inline_in_notification);
                  END IF;
                END;
                ```
        }
        execution {
            sequence: 550
        }
        successMessage {
            successMessage: Pedido enviado a Membrezia.
        }
        advanced {
            executionMappingIdentifier: 1357833702599716426
        }
        serverSideCondition {
            whenButtonPressed: @enviar-membrezia-cl
        }
    )

    process envia-para-o-membrezia-panamá (
        name: Envia para o membrezia Panamá
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  v_idpais   NUMBER;
                  v_doc      pessoas.documentoestrangeiro_orig%TYPE;
                  v_cancel   pedidos.datacancelamento%TYPE;
                  v_ja116    NUMBER := 0;
                BEGIN
                  -- dados do pedido: pais da vendedora, documento e cancelamento
                  BEGIN
                    SELECT pes.idpais, pes.documentoestrangeiro_orig, p.datacancelamento
                      INTO v_idpais, v_doc, v_cancel
                      FROM pedidos p
                      JOIN vendedoras v ON v.idvendedora = p.idvendedora
                      JOIN pessoas   pes ON pes.idpessoa  = v.idpessoa
                     WHERE p.idpedido = :P68_IDPEDIDO;
                  EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                      apex_error.add_error(
                        p_message => 'Pedido no encontrado.',
                        p_display_location => apex_error.c_inline_in_notification);
                      RETURN;
                  END;
                
                  -- trava: pedido cancelado
                  IF v_cancel IS NOT NULL THEN
                    apex_error.add_error(
                      p_message => 'Pedido cancelado. No se integra a Membrezia.',
                      p_display_location => apex_error.c_inline_in_notification);
                    RETURN;
                  END IF;
                
                  -- trava: so Panama
                  IF v_idpais <> 13 THEN
                    apex_error.add_error(
                      p_message => 'Pedido no es de Panama.',
                      p_display_location => apex_error.c_inline_in_notification);
                    RETURN;
                  END IF;
                
                  -- trava: nao duplicar (ja tem subscription = classificacao 116)
                  SELECT COUNT(1) INTO v_ja116
                    FROM classificacoespedidos
                   WHERE idpedido = :P68_IDPEDIDO
                     AND idcaracteristicapedido = 116;
                  IF v_ja116 > 0 THEN
                    apex_error.add_error(
                      p_message => 'Pedido ya integrado a Membrezia.',
                      p_display_location => apex_error.c_inline_in_notification);
                    RETURN;
                  END IF;
                
                  -- trava: precisa ter documento
                  IF v_doc IS NULL OR TRIM(v_doc) IS NULL THEN
                    apex_error.add_error(
                      p_message => 'Regularice el documento (CIP) de la consultora antes de enviar.',
                      p_display_location => apex_error.c_inline_in_notification);
                    RETURN;
                  END IF;
                
                  -- tudo ok: integra
                  pck_integracao_membrezia.prc_integramembrezia_pa(:P68_IDPEDIDO);
                
                  -- confere se gravou o 116 (sucesso real)
                  SELECT COUNT(1) INTO v_ja116
                    FROM classificacoespedidos
                   WHERE idpedido = :P68_IDPEDIDO
                     AND idcaracteristicapedido = 116;
                
                  IF v_ja116 = 0 THEN
                    apex_error.add_error(
                      p_message => 'Membrezia no confirmo la suscripcion. Revise el pedido.',
                      p_display_location => apex_error.c_inline_in_notification);
                  END IF;
                END;
                ```
        }
        execution {
            sequence: 540
        }
        advanced {
            executionMappingIdentifier: 1311574492186587304
        }
        serverSideCondition {
            whenButtonPressed: @enviar-membrezia-pa
        }
    )

