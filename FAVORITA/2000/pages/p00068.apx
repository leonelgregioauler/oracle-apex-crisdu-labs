    process imprimir-etiqueta-correio (
        name: Imprimir Etiqueta Correio
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidpedido          number        := :P68_IDPEDIDO;
                  vnomepessoa        varchar2(100) := :P68_NOMEPESSOA;
                  venderecoentrega   varchar2(100) := :P68_ENDERECOENTREGACORREIO;
                  vnumeroentrega     varchar2(100) := :P68_NUMEROENTREGACORREIO;
                  vbairroentrega     varchar2(100) := :P68_BAIRROENTREGACORREIO;
                  vcepentrega        varchar2(100) := :P68_CEPENTREGACORREIO;
                  vidcidadeentrega   number        := :P68_CIDADEENTREGACORREIO;
                  --
                  videnderecoentrega number;
                  vidpessoa          number        := :P68_IDPESSOA;
                  --
                  vmd5   varchar2(4000);
                  vdml   varchar2(2):= 'I';
                  --
                  vvchar varchar2(4000);
                  --
                begin
                  --
                  favorita.pck_cadastros_fav.prc_enderecosentrega(pidenderecoentrega => videnderecoentrega,
                                                                  pidpessoa          => vidpessoa,
                                                                  prua               => :P68_ENDERECOENTREGACORREIO,
                                                                  pnumero            => :P68_NUMEROENTREGACORREIO,
                                                                  pcomplemento       => vvchar,
                                                                  pbairro            => :P68_BAIRROENTREGACORREIO,
                                                                  pcep               => :P68_CEPENTREGACORREIO,
                                                                  pidcidade          => :P68_CIDADEENTREGACORREIO,
                                                                  pobservacao        => vvchar,
                                                                  preferencia        => vvchar,
                                                                  pzona              => vvchar,
                                                                  pmd5               => vmd5,
                                                                  poperacao_dml      => vdml);
                  --
                  update favorita.classificacoespedidos cp
                   set cp.idvalorcaracteristica = videnderecoentrega
                  where cp.idpedido = :P68_IDPEDIDO
                    and cp.idcaracteristicapedido = 7;
                  --
                  pck_etiquetas.prc_gera_etiqueta_correio( pidpedido           => vidpedido
                                                         , pnomepessoa         => vnomepessoa
                                                         , penderecoentrega    => venderecoentrega
                                                         , pnumeroentrega      => vnumeroentrega
                                                         , pbairroentrega      => vbairroentrega
                                                         , pcepentrega         => vcepentrega
                                                         , pidcidadeentrega    => vidcidadeentrega
                                                         , pautomatico         => 'N' );
                   --
                end;
                ```
        }
