page 404 (
    name: Selecionar Compras
    title: Selecionar Compras
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 70%
        height: 85%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region new (
        name: New
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region new-2 (
        name: New
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region selecionar-compras (
        name: Selecionar Compras
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select case 
                         when not exists ( select 1 
                                           from comprastransferencias 
                                           where idnotafiscal = :P404_IDNOTAFISCAL ) then
                           '<a href="javascript:apex.confirm(''Confirma o vínculo da nota com este pedido de compra ? '', 
                             { request:''CONFIRMARVINCULO'', set:{''P404_IDCOMPRATRANSFERENCIA'':'||idcompratransferencia||' }} )";><img src="#APP_IMAGES#ok.png"  border="0"></a>' 
                       end vincular
                     , idcompratransferencia
                     , nomefornecedor
                     , filialfavoritadestino
                     , numero
                     , situacao
                     , notafiscal
                     , dataemissao
                from vw_comprastransferencias_fav ct
                where idtipocomptransrem = 0
                and idsituacao not in (-1, 40)
                and ididioma = 1
                and filialfavoritadestino is not null
                
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 1560616072046690814
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
                rowsPerPage: 5
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @NUMERO
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @IDCOMPRATRANSFERENCIA
                layout {
                    show: false
                    sequence: 1
                }
            )

            displayColumn (
                column: @FILIALFAVORITADESTINO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @SITUACAO
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @NOTAFISCAL
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @DATAEMISSAO
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @VINCULAR
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @NOMEFORNECEDOR
                layout {
                    sequence: 7
                }
            )

            filter (
                column: @NOMEFORNECEDOR
                operator: contains
                value: Sim Ind.
            )

        )

        column DATAEMISSAO (
            type: datePickerJquery
            heading {
                heading: Data Emissão
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: DATAEMISSAO
                dataType: date
            }
        )

        column FILIALFAVORITADESTINO (
            type: textarea
            heading {
                heading: Filial Favorita Destino
                alignment: center
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: FILIALFAVORITADESTINO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column IDCOMPRATRANSFERENCIA (
            type: numberField
            heading {
                heading: Idcompratransferencia
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDCOMPRATRANSFERENCIA
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column NOMEFORNECEDOR (
            type: textarea
            heading {
                heading: Fornecedor
                alignment: center
            }
            layout {
                sequence: 30
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: NOMEFORNECEDOR
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
        )

        column NOTAFISCAL (
            type: textarea
            heading {
                heading: Nota Fiscal
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: NOTAFISCAL
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column NUMERO (
            type: numberField
            heading {
                heading: Número
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: NUMERO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column SITUACAO (
            type: textarea
            heading {
                heading: Situação
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: SITUACAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column VINCULAR (
            type: displayOnly
            heading {
                heading: Vincular
                alignment: center
            }
            settings {
                format: html
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                databaseColumn: VINCULAR
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

    )

    pageItem P404_IDCOMPRATRANSFERENCIA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @new
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P404_IDFORNECEDOR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @new
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P404_IDNOTAFISCAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @new
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P404_NOTAFISCAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @new
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 10
            region: @new-2
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 397
                items: {
                    P397_NUMEROCOMPRAVINCULADA: &P404_IDCOMPRATRANSFERENCIA.
                    P397_ORIGEM: 404
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

