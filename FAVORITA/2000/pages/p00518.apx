page 518 (
    name: Relatorio de Itens a Movimentar de Pedidos do Virtual
    title: Relatorio de Itens a Movimentar de Pedidos do Virtual
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region relatorio-de-itens-a-movimentar-de-pedidos-do-virtual (
        name: Relatorio de Itens a Movimentar de Pedidos do Virtual
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomefilialfavorita(p.idfilialfavorita) FilialFavorita
                     , p.idpedido 
                     , favorita.pck_util_fav.fnc_nomeprodutodetalhado(i.idprodutodetalhado,1) NomeProduto
                     , ip.quantidade
                     , ip.datainserido
                     , ip.dataconfirmado
                from favorita.itempendenteintvirtual ip
                   , favorita.itenspedidos i
                   , favorita.pedidos p
                where ip.iditempedido = i.iditempedido
                  and i.idpedido = p.idpedido
                  and (:P518_IDFILIALFAVORITA is null or :P518_IDFILIALFAVORITA = p.idfilialfavorita)
                  and (:P518_IDPRODUTODETALHADO is null or :P518_IDPRODUTODETALHADO = i.idprodutodetalhado)
                  and (( :P518_TIPODATA = 'A' and ip.dataconfirmado between to_date(:P518_DATAINICIAL||' 00:00:00','dd/mm/rrrr hh24:mi:ss') and to_date(:P518_DATAFINAL||' 23:59:59','dd/mm/rrrr hh24:mi:ss'))
                       or ( :P518_TIPODATA = 'E' and ip.datainserido between to_date(:P518_DATAINICIAL||' 00:00:00','dd/mm/rrrr hh24:mi:ss') and to_date(:P518_DATAFINAL||' 23:59:59','dd/mm/rrrr hh24:mi:ss')));
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 10215780014921024
        }

        column DATACONFIRMADO (
            type: plainText
            heading {
                heading: Data Ajuste
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: F
            }
        )

        column DATAINSERIDO (
            type: plainText
            heading {
                heading: Data Erro
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: E
            }
        )

        column FILIALFAVORITA (
            type: plainText
            heading {
                heading: Filial Favorita
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column IDPEDIDO (
            type: plainText
            heading {
                heading: Pedido
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column NOMEPRODUTO (
            type: plainText
            heading {
                heading: Nome Produto
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column QUANTIDADE (
            type: plainText
            heading {
                heading: Quantidade
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 127649 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATACONFIRMADO (
                sequence: 6
            )

            displayColumn DATAINSERIDO (
                sequence: 5
            )

            displayColumn FILIALFAVORITA (
                sequence: 1
            )

            displayColumn IDPEDIDO (
                sequence: 2
            )

            displayColumn NOMEPRODUTO (
                sequence: 3
            )

            displayColumn QUANTIDADE (
                sequence: 4
            )

        )

    )

    pageItem P518_DATAFINAL (
        type: datePickerJquery
        label {
            label: Data Final
            alignment: left
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P518_DATAINICIAL (
        type: datePickerJquery
        label {
            label: Data Inicial
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P518_IDFILIALFAVORITA (
        type: plugin/select
        label {
            label: Filial Favorita
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-filiaisfavorita
            displayExtraValues: false
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P518_IDPRODUTODETALHADO (
        type: plugin/select
        label {
            label: Produtos
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomeprodutodetalhado(pd.idprodutodetalhado,:P0_IDIDIOMA) returnvalue
                     , pd.idprodutodetalhado showvalue
                from favorita.produtosdetalhados pd
                ```
            displayExtraValues: false
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P518_TIPODATA (
        type: radioGroup
        label {
            label: Tipo de Data
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Data Erro;E,Data Ajuste;A
            displayExtraValues: false
            nullDisplayValue: - Não Filtrar - (Data Obrigatório)
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconRight
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

