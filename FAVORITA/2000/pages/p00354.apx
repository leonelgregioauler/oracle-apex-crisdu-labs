page 354 (
    name: Relatório de Pedidos a ser Entregues
    title: Relatório de Pedidos a ser Entregues
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region relatorio-de-pedidos-não-entregues (
        name: Relatorio de Pedidos não Entregues
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select fv.idpedido
                     , fv.nomeusuario
                     , fv.dataemissao
                from favorita.vw_pedidos_fav_new /*vw_pedidos_fav*/ fv
                where fv.idpais         = :P0_IDIDIOMA
                  and fv.idfilialfavorita = :P354_IDFILIALFAVORITA
                  and fv.idsituacaoentrega = 55000
                  and :P354_TIPORELATORIO = 2
                  and (:P354_IDUSUARIOATENDEU is null or fv.idusuario = :P354_IDUSUARIOATENDEU)
                  and (fv.dataemissao between :P354_DATAINICIO and :P354_DATAFIM or (:P354_DATAINICIO is null and :P354_DATAFIM is null) )
                  and fv.pedidocancelado = 'Não'
                --
                union
                -- Query para consulta da TI(0) e Controladoria(2) T15911957
                select fv.idpedido
                     , fv.nomeusuario
                     , fv.dataemissao
                from favorita.vw_pedidos_fav_new /*vw_pedidos_fav*/ fv
                where fv.idfilialfavorita = :P354_IDFILIALFAVORITA
                  and fv.idsituacaoentrega = 55000
                  and :P354_TIPORELATORIO = 2
                  --and (:P354_IDUSUARIOATENDEU is null or fv.idusuario = :P354_IDUSUARIOATENDEU)
                  and (fv.dataemissao between :P354_DATAINICIO and :P354_DATAFIM or (:P354_DATAINICIO is null and :P354_DATAFIM is null) )
                  and fv.pedidocancelado = 'Não'
                  and (favorita.pck_util_fav.fnc_verificagrupoatendimento(0, pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S' or 
                       favorita.pck_util_fav.fnc_verificagrupoatendimento(2, pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S')
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P354_TIPORELATORIO = 2
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1536972991654109416
        }

        column DATAEMISSAO (
            type: plainText
            heading {
                heading: Data Emissão
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column IDPEDIDO (
            type: link
            heading {
                heading: Nr Pedido
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 68
                    items: {
                        P68_IDPEDIDO: #IDPEDIDO#
                    }
                    action: resetPagination
                }
                linkText: #IDPEDIDO#
                linkAttributes: target="_blank"
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column NOMEUSUARIO (
            type: plainText
            heading {
                heading: Usuário
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 15369982 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAEMISSAO (
                sequence: 3
            )

            displayColumn IDPEDIDO (
                sequence: 1
            )

            displayColumn NOMEUSUARIO (
                sequence: 2
            )

        )

    )

    region relatorio-de-pedidos-não-entregues-2 (
        name: Relatorio de Pedidos não Entregues
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select fv.nomeusuario
                     , count(fv.nomeusuario)
                from favorita.vw_pedidos_fav_new /*vw_pedidos_fav*/ fv
                where fv.idpais           = :P0_IDIDIOMA
                  and fv.idfilialfavorita = :P354_IDFILIALFAVORITA
                  and fv.idsituacaoentrega = 55000
                  and :P354_TIPORELATORIO = 1
                  and (:P354_IDUSUARIOATENDEU is null or fv.idusuario = :P354_IDUSUARIOATENDEU)
                  and (fv.dataemissao between :P354_DATAINICIO and :P354_DATAFIM or (:P354_DATAINICIO is null and :P354_DATAFIM is null) )
                  and fv.pedidocancelado = 'Não'
                group by fv.nomeusuario
                --
                union
                -- Query para consulta da TI(0) e Controladoria(2) T15911957
                select fv.nomeusuario
                     , count(fv.nomeusuario)
                from favorita.vw_pedidos_fav_new /*vw_pedidos_fav*/ fv
                where fv.idfilialfavorita = :P354_IDFILIALFAVORITA
                  and fv.idsituacaoentrega = 55000
                  and :P354_TIPORELATORIO = 1
                  --and (:P354_IDUSUARIOATENDEU is null or fv.idusuario = :P354_IDUSUARIOATENDEU)
                  and (fv.dataemissao between :P354_DATAINICIO and :P354_DATAFIM or (:P354_DATAINICIO is null and :P354_DATAFIM is null) )
                  and fv.pedidocancelado = 'Não'
                  and (favorita.pck_util_fav.fnc_verificagrupoatendimento(0, pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S' or 
                       favorita.pck_util_fav.fnc_verificagrupoatendimento(2, pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S')
                group by fv.nomeusuario
                
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P354_TIPORELATORIO = 1
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1536974499770109431
        }

        column "COUNT(FV.NOMEUSUARIO)" (
            type: plainText
            heading {
                heading: Qtd Pedidos
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column NOMEUSUARIO (
            type: plainText
            heading {
                heading: "Usuário "
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 15418594 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn "COUNT(FV.NOMEUSUARIO)" (
                sequence: 2
            )

            displayColumn NOMEUSUARIO (
                sequence: 1
            )

        )

    )

    pageItem P354_DATAFIM (
        type: datePickerJquery
        label {
            label: Data Final
            alignment: left
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P354_DATAINICIO (
        type: datePickerJquery
        label {
            label: Data Inicial
            alignment: left
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P354_IDFILIALFAVORITA (
        type: selectList
        label {
            label: "Filial "
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.nomefilialfavorita
                     , w.idfilialfavorita
                from vw_filiaisfavorita w
                where w.tipofilial in ( 'Loja' , 'Estoque' )
                  and exists ( select 1
                               from roman.fechamentossemanais ff
                               where ff.idfilialfavorita = w.idfilialfavorita )
                  and exists ( select 1
                               from usuariosfiliaisfavorita uf
                               where uf.idfilialfavorita = w.idfilialfavorita
                                 and uf.idusuario        = :P0_IDUSUARIO
                                 and uf.visualizarcaixa  = 'S' )
                order by w.nomefilialfavorita
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P354_IDUSUARIOATENDEU (
        type: selectList
        label {
            label: Usuario
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeusuario(u.idusuario) display_value
                     , u.idusuario return_value
                from usuarios u
                where exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.usuario = u.usuario 
                                 and ug.idgrupoatendimento in ( select ga.idgrupoatendimento
                                                                from roman.usuariosgruposatendimento ga
                                                                where ga.usuario = ( select usuario
                                                                                     from usuarios
                                                                                     where idusuario = :P0_IDUSUARIO ) ) )
                order by 1
                ```
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P354_TIPORELATORIO (
        type: radioGroup
        label {
            label: Relatório
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Resumido;1,Detalhado;2
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconRight
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

