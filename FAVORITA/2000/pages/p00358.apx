    region mensagens-para-você (
        name: Mensagens para você
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.idmensageminterna,
                       m.idgrupoatendimento,
                       m.datainclusao
                      -- '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':316:'||v('APP_SESSION')||'::NO::P316_IDMENSAGEMINTERNA:'||m.idmensageminterna ,'SESSION')||''',''_blank''); void(0)">'||m.mensagem||'</a>' mensagem,
                     , m.mensagem
                     , m.idcompratransferencia,
                       m.idusuarioleitura,
                       m.dataleitura,
                       m.idusuario
                from favorita.mensagensinternas m
                where m.idusuario = :P0_IDUSUARIO
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
