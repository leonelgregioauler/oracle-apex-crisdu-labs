page 358 (
    name: Mensagens
    title: Mensagens
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region mensagens-do-grupo (
        name: Mensagens do Grupo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.idmensageminterna,
                       m.idgrupoatendimento,
                       m.datainclusao,
                       m.mensagem,
                       m.idcompratransferencia,
                       m.idusuarioleitura,
                       m.dataleitura,
                       m.idusuario
                from favorita.mensagensinternas m
                where exists ( select distinct 1
                               from roman.usuariosgruposatendimento f
                               where m.idgrupoatendimento = f.idgrupoatendimento
                                 and f.usuario = v('APP_USER'))
                  and m.idusuario is null
                order by m.datainclusao desc
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1441651678765675119
        }

        column DATAINCLUSAO (
            type: plainText
            heading {
                heading: Data Envio
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column DATALEITURA (
            type: plainText
            heading {
                heading: Dataleitura
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: G
            }
        )

