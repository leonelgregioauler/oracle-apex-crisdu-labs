    region operações-padrões-detalhado (
        name: Operações Padrões Detalhado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select o.idoperacaopadrao,
                       tp.nome as "Operação",
                       pck_util_fav.fnc_nome_empresa_virtualage(emp.column_value) as "Empresa",
                       pck_util_fav.fnc_nome_empresa_virtualage(emp_dest.column_value) as "Empresa Destino",
                       pck_util_fav.fnc_retornanomeestado(es.column_value) as "Estado",
                       o.codigooperacao as "cod operação",
                       decode(o.presencial,'S','Sim','N','Não') as "Presencial",
                       decode(o.origem,'C','Call Center','E','Ecommerce') as "Origem",
                       o.ordem as "Ordem"
                from operacoespadroes o,
                     tiposoperacoesfiscais tp,
                     table(pck_util_fav.fnc_array_to_table(nvl(o.estados,0))) es,
                     table (pck_util_fav.fnc_array_to_table(o.empresasvirtualage)) emp,
                     table (pck_util_fav.fnc_array_to_table(nvl(o.empresadestino,0))) emp_dest
                where o.idtipooperacaofiscal = tp.idtipooperacaofiscal
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 461
                items: {
                    P461_IDOPERACAOPADRAO: #IDOPERACAOPADRAO#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 52157967780764023
        }

