    region operações-padrões-resumido (
        name: Operações Padrões Resumido
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select o.idoperacaopadrao,
                       --
                       (select listagg(ev.idempresavirtualage||' - '||initcap(ev.nome),'<br>')
                       within group (order by o.empresasvirtualage)
                       from table(pck_util_fav.fnc_array_to_table(o.empresasvirtualage)) emp,
                            empresasvirtualage ev
                       where emp.column_value = ev.idempresavirtualage) as "Empresas",
                       --
                       (select listagg(pck_util_fav.fnc_retornanomeestado(es.column_value),'<br>')
                       within group (order by es.column_value)
                       from table(pck_util_fav.fnc_array_to_table(o.estados))es) as "Estados",
                       --
                       (select listagg(ev.idempresavirtualage||' - '||initcap(ev.nome),'<br>')
                       within group (order by o.empresasvirtualage)
                       from table(pck_util_fav.fnc_array_to_table(o.empresadestino)) emp,
                            empresasvirtualage ev
                       where emp.column_value = ev.idempresavirtualage) as "Empresas Destino",
                       --
                       o.codigooperacao as "Cod Operação",
                       decode(o.presencial,'S','Sim','N','Não') as "Presencial",
                       initcap(tp.nome) as "Tipo Operação",
                       decode(o.origem,'C','Call Center','E','Ecommerce') as "Origem",
                       o.ordem as "Ordem"
                       --
                from operacoespadroes o,
                     tiposoperacoesfiscais tp
                where o.idtipooperacaofiscal = tp.idtipooperacaofiscal
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 461
                items: {
                    P461_IDOPERACAOPADRAO: #IDOPERACAOPADRAO#
                }
                clearCache: 461
                action: resetPagination
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 54670023601721704
        }

