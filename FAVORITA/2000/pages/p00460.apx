page 460 (
    name: Lista de operações Padrões
    title: Lista de operações Padrões
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-de-operações-fiscais (
        name: Cadastro de Operações Fiscais
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select op.idopercaofiscal,
                       op.codigo as "Código",
                       t.nome as "Tipo",
                       op.descricao as "Descrição"
                from operacoesfiscais op,
                     tiposoperacoesfiscais t
                where op.idtipo = t.idtipooperacaofiscal
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 491
                items: {
                    P491_IDOPERCAOFISCAL: #IDOPERCAOFISCAL#
                }
                action: resetPagination
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 103011817502295812
        }

