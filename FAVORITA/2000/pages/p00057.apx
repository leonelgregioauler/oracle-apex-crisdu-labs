page 57 (
    name: Cadastro de Características Pedidos
    title: Características Pedidos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region características-pedidos (
        name: Características Pedidos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idcaracteristicapedido
                     , descricao
                     , idtexto
                     , automatico
                from caracteristicaspedidos 
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 3337730384323452
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDCARACTERISTICAPEDIDO
                layout {
                    show: false
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDTEXTO
                layout {
                    width: 300
                    sequence: 3
                }
            )

            displayColumn (
                column: @DESCRICAO
                layout {
                    width: 300
                    sequence: 2
                }
            )

            displayColumn (
                column: @AUTOMATICO
                layout {
                    width: 150
                    sequence: 4
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column AUTOMATICO (
            type: selectList
            heading {
                heading: Automático
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @lov-simnao
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                databaseColumn: AUTOMATICO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column DESCRICAO (
            type: textarea
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: DESCRICAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column IDCARACTERISTICAPEDIDO (
            type: displayOnly
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDCARACTERISTICAPEDIDO
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: SEQ_IDCARACTERISTICAPEDIDO
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDTEXTO (
            type: link
            heading {
                heading: Tradução
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            link {
                target: {
                    page: 100
                    items: {
                        P100_IDTEXTOTRADUZIDO: &IDTEXTO.
                    }
                    action: resetPagination
                }
                linkText: <font color="black"><b>Visualizar / Atualizar texto traduzido</b></font>
            }
            source {
                databaseColumn: IDTEXTO
                dataType: number
            }
        )

    )

    validation automatico-obrigatório (
        name: AUTOMATICO obrigatório
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @características-pedidos
            type: columnIsNotNull
            column: AUTOMATICO
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ter um valor.
            associatedColumn: AUTOMATICO
        }
    )

    validation descricao-obrigatório (
        name: DESCRICAO obrigatório
        execution {
            sequence: 20
        }
        validation {
            editableRegion: @características-pedidos
            type: columnIsNotNull
            column: DESCRICAO
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ter um valor.
            associatedColumn: DESCRICAO
        }
    )

    validation descricao-unique (
        name: DESCRICAO unique
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @características-pedidos
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vdescricao varchar2(100);
                begin
                  select descricao
                  into vdescricao
                  from caracteristicaspedidos
                  where upper(descricao) = upper(:DESCRICAO);
                  --
                  if vdescricao is not null then
                    return 'Existe um cadastro no sistema com estas informações. Não são permitidas informações repetidas para este cadastro.';
                  end if;
                  --
                exception
                  when no_data_found then
                    return '';
                end;
                ```
        }
        error {
            associatedColumn: DESCRICAO
        }
    )

    process save-interactive-grid-data (
        name: " - Save Interactive Grid Data"
        type: interactiveGridAutoRowProcessing
        editableRegion: @características-pedidos
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 3340709845323455
        }
    )

)

