page 482 (
    name: Ganho Consultora na Loja
    title: Ganho Consultora na Loja
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region ganho-consultora-na-loja (
        name: Ganho Consultora na Loja
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.referencia,
                       a.produto,
                       a.valorvenda,
                       a.perconsultora,
                       a.perdistribuidor,
                       a.pergerentefunc,
                       a.venda_consultora,
                       a.venda_distribuidor,
                       a.venda_gerfunc,
                       a.ganho_consultora,
                       a.ganho_distribuidor,
                       a.ganho_gerfunc,
                       v.valorpontos
                from favorita.vw_ganho_revista_loja_fav a
                   , favorita.vw_produtos_fav v 
                where a.referencia = v.referencia
                  and ( :P482_IDPRODUTODETALHADO is null or 
                        v.idproduto = (select idproduto
                                       from produtosdetalhados
                                      where idprodutodetalhado = :P482_IDPRODUTODETALHADO) ) 
                                      
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 90936076172732710
        }

        column GANHO_CONSULTORA (
            type: plainText
            heading {
                heading: Ganho Consultora
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: J
            }
        )

        column GANHO_DISTRIBUIDOR (
            type: plainText
            heading {
                heading: Ganho Distribuidor
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: K
            }
        )

        column GANHO_GERFUNC (
            type: plainText
            heading {
                heading: Ganho Ger/Func
                alignment: center
            }
            layout {
                sequence: 120
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: L
            }
        )

        column PERCONSULTORA (
            type: plainText
            heading {
                heading: %Consultora
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column PERDISTRIBUIDOR (
            type: plainText
            heading {
                heading: %Distribuidor
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column PERGERENTEFUNC (
            type: plainText
            heading {
                heading: %Gerente/Func
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column PRODUTO (
            type: plainText
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column REFERENCIA (
            type: plainText
            heading {
                heading: Referência
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column VALORPONTOS (
            type: plainText
            heading {
                heading: Valor Pontos
                alignment: center
            }
            layout {
                sequence: 130
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: M
            }
        )

        column VALORVENDA (
            type: plainText
            heading {
                heading: Valor Venda
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        column VENDA_CONSULTORA (
            type: plainText
            heading {
                heading: Venda Consultora
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column VENDA_DISTRIBUIDOR (
            type: plainText
            heading {
                heading: Venda Distribuidor
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column VENDA_GERFUNC (
            type: plainText
            heading {
                heading: Venda Ger/Func
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: I
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 911248 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn GANHO_CONSULTORA (
                sequence: 6
            )

            displayColumn PERCONSULTORA (
                sequence: 4
            )

            displayColumn PRODUTO (
                sequence: 2
            )

            displayColumn REFERENCIA (
                sequence: 1
            )

            displayColumn VALORPONTOS (
                sequence: 7
            )

            displayColumn VALORVENDA (
                sequence: 3
            )

            displayColumn VENDA_CONSULTORA (
                sequence: 5
            )

        )

    )

    pageItem P482_IDPRODUTODETALHADO (
        type: plugin/select
        label {
            label: Produto
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomeprodutodetalhado(pd.idprodutodetalhado , 1) showvalue
                     , pd.idprodutodetalhado retunrvalue
                from favorita.produtosdetalhados pd
                ```
            displayExtraValues: false
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction atualiza (
        name: Atualiza
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P482_IDPRODUTODETALHADO
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

