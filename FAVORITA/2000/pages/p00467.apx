page 467 (
    name: Entrega Pedido Delivery
    title: Entrega Pedido Delivery
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region buttons-container (
        name: Buttons Container
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region entrega-pedido (
        name: Entrega Pedido
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P467_CODIGO_BARRAS (
        type: numberField
        label {
            label: Codigo Barras
            alignment: left
        }
        settings {
            numberAlignment: center
            virtualKeyboard: text
        }
        layout {
            sequence: 10
            region: @entrega-pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--xlarge
            ]
            width: 30
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P467_ID_REMESSA (
        type: hidden
        layout {
            sequence: 20
            region: @entrega-pedido
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button cancelar (
        buttonName: CANCELAR
        label: Voltar
        layout {
            sequence: 10
            region: @buttons-container
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction close-dialog (
        name: Close dialog
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @cancelar
        }

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction entrega-pedido (
        name: Entrega pedido
        execution {
            sequence: 10
        }
        when {
            event: keypress
            selectionType: items
            items: P467_CODIGO_BARRAS
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: event.keyCode == 13
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: ENTREGAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation valida-entrega-de-pedido (
        name: Valida entrega de pedido
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                -- Created on 15/09/2020 by MAX.BERKEUER 
                declare 
                  --
                  vid_pedido number := substr(:P467_CODIGO_BARRAS,9,7);
                  vid_remessa number := :P467_ID_REMESSA;
                  vexist number;
                  --
                begin
                  --
                  select count(1)
                  into vexist
                  from pedidosremessasct pr
                  where pr.idpedido = vid_pedido
                  and pr.idcompratransferencia = vid_remessa;
                  --
                  if vexist <= 0 then
                    --
                    return 'Pedido não pertence para esta remessa!';
                    --
                  end if;
                  --
                  vexist := null;
                  --
                  select count(1)
                  into vexist
                  from classificacoespedidos c
                  where c.idpedido = vid_pedido 
                  and c.idcaracteristicapedido = 25;
                  --
                  if vexist > 0 then
                    --
                    return 'Pedido está cancelado!';
                    --
                  end if;  
                  --
                end;
                ```
        }
        error {
            associatedItem: @P467_CODIGO_BARRAS
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P467_CODIGO_BARRAS is not null
        }
    )

    process entrega-pedido (
        name: Entrega pedido
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Created on 15/09/2020 by MAX.BERKEUER 
                declare 
                  --
                  vid_pedido number := substr(:P467_CODIGO_BARRAS,9,7);
                  --
                begin
                  --
                  update pedidos pd
                  set pd.idsituacaoentrega = 60000
                  where pd.idpedido = vid_pedido;  
                  --
                  apex_util.set_session_state(p_name => 'P467_CODIGO_BARRAS',p_value => null);  
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 73319086437730050
        }
        serverSideCondition {
            type: request=Value
            value: ENTREGAR
        }
    )

    branch (
        name: Go to page 467
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 467
                items: {
                    P467_ID_REMESSA: &P467_ID_REMESSA.
                    P467_CODIGO_BARRAS:
                }
                action: resetPagination
            }
        }
    )

)

