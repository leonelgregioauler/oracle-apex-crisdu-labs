    process operação-dml-em-virada-de-catalogo (
        name: Operação DML em Virada de Catalogo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml     varchar2(1);
                  vData             date := trunc(sysdate) ;
                  vDataInicio       date;
                  vDataFim          date;
                  --
                begin
                
                  IF v('REQUEST')    = 'INCLUIR' THEN
                  
                    voperacao_dml := 'I';
                    :P548_IDUSUARIOINCLUSAO := :P0_IDUSUARIO;
                    :P548_DATAINCLUSAO      := SYSDATE;
                    
                  ELSIF v('REQUEST') = 'SALVAR' THEN
                  
                    voperacao_dml := 'U';
                    
                  ELSIF v('REQUEST') = 'DELETE' THEN
                    
                    voperacao_dml := 'D';
                    BEGIN
                      DELETE FROM itensviradadecatalogo
                       WHERE idviradadecatalogo = :P548_IDVIRADADECATALOGO;
                    EXCEPTION
                      WHEN OTHERS THEN
                        raise_application_error(-20001,'Falha no processo de exclusão dos itens da virada: '||sqlerrm);
                    END;
                    --
                    BEGIN
                      UPDATE execucoes_comandos
                         SET excluido = 'S'
                       WHERE origem = 'VIRADA DE CATALOGO '||trim(:P548_IDVIRADADECATALOGO);
                    EXCEPTION
                      WHEN no_data_found THEN
                        null;
                      WHEN others THEN
                        raise_application_error(-20001,'Falha no processo de exclusão dos itens da virada: '||sqlerrm);
                    END;
                    --
                  END IF;
                  
                  --
                  begin
                    
                    pck_cadastros_fav.prc_viradadecatalogo(pidviradadecatalogo   => :P548_IDVIRADADECATALOGO,
                                                           pnome                 => :P548_NOME,
                                                           pdatainicial          => :P548_DATAVALIDADEINI,
                                                           pdatafinal            => :P548_DATAVALIDADEFIM,
                                                           pidedicaorevori       => :P548_IDEDICAOREVISTAORIGEM,
                                                           pidedicaorevdest      => :P548_IDEDICAOREVISTADESTINO,
                                                           pidpais               => :P548_IDPAIS,
                                                           plinkcatalogo         => :P548_LINKCATALOGO,
                                                           pidusuarioinclusao    => :P548_IDUSUARIOINCLUSAO,
                                                           pdatainclusao         => :P548_DATAINCLUSAO,
                                                           pidusuariomp          => :P548_IDUSUARIOMORTEPROG,
                                                           pdatamp               => :P548_DATAMORTEPROG,
                                                           pidusuarioajustaitens => :P548_IDUSUARIOAJUSTEITENS,
                                                           pdataajustaitens      => :P548_DATAAJUSTEITENS,
                                                           pidusuarioajustamp    => :P548_IDUSUARIOITENSMORTEPROG,
                                                           pdataajustamp         => :P548_DATAITENSMORTEPROG,
                                                           petapa                => :P548_ETAPA,
                                                           pmd5                  => :P548_MD5,
                                                           poperacao_dml         => voperacao_dml);
                
                  exception
                   when others then
                     raise_application_error(-20001,'Erro na chamada pck_cadastros_fav '||sqlerrm);
                  end;
                
                end;
                ```
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 32410790181546224
        }
    )

