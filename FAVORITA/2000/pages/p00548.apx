    button cancel (
        buttonName: CANCEL
        label: Cancelar / Voltar
        layout {
            sequence: 10
            region: @virada-de-catalogo
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 547
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button copiaritens (
        buttonName: COPIARITENS
        label: Incluir Itens
        layout {
            sequence: 50
            region: @virada-de-catalogo
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
            databaseAction: insert
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 from dual 
                where :P548_ETAPA = 0 
                  and :P548_IDVIRADADECATALOGO IS NOT NULL
                ```
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 20
            region: @virada-de-catalogo
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                  from viradasdecatalogo
                where idviradadecatalogo = :P548_IDVIRADADECATALOGO
                  and etapa <= 4
                ```
        }
    )

    button incluir (
        buttonName: INCLUIR
        label: Incluir
        layout {
            sequence: 40
            region: @virada-de-catalogo
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P548_IDVIRADADECATALOGO
        }
    )

    button salvar (
        buttonName: SALVAR
        label: Salvar
        layout {
            sequence: 30
            region: @virada-de-catalogo
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                  from viradasdecatalogo
                where idviradadecatalogo = :P548_IDVIRADADECATALOGO
                  and etapa < 2
                ```
        }
    )

    dynamicAction buscapais (
        name: BuscaPais
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P548_IDEDICAOREVISTAORIGEM
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select idpais
                      from edicoesrevistas
                     where idedicaorevista = :P548_IDEDICAOREVISTAORIGEM
                    ```
                itemsToSubmit: P548_IDEDICAOREVISTAORIGEM
            }
            affectedElements {
                selectionType: items
                items: P548_IDPAIS
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction confirma (
        name: Confirma
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @copiaritens
        }

        action native-confirm (
            action: confirm
            settings {
                message: Confirma inclusão dos itens da revista?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: COPIARITENS
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 30
            eventScope: dynamic
        }
        when {
            selectionType: items
            items: P548_IDEDICAOREVISTADESTINO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    
                    SELECT datainicial, 
                           datafinal
                      INTO :P548_DATAVALIDADEINI
                         , :P548_DATAVALIDADEFIM
                      FROM edicoesrevistas
                     WHERE idedicaorevista = :P548_IDEDICAOREVISTADESTINO;
                     
                     EXCEPTION
                      WHEN OTHERS THEN NULL;
                    
                    END;
                    ```
                itemsToSubmit: P548_IDEDICAOREVISTADESTINO
                itemsToReturn: [
                    P548_DATAVALIDADEINI
                    P548_DATAVALIDADEFIM
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process buscadados (
        name: BuscaDados
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                  pck_cadastros_fav.prc_viradadecatalogo(pidviradadecatalogo   => :P548_IDVIRADADECATALOGO,
                                                         pnome                 => :P548_NOME,
                                                         pdatainicial          => :P548_DATAVALIDADEINI,
                                                         pdatafinal            => :P548_DATAVALIDADEFIM,
                                                         pidedicaorevori       => :P548_IDEDICAOREVISTAORIGEM,
                                                         pidedicaorevdest      => :P548_IDEDICAOREVISTADESTINO,
                                                         pidpais               => :P548_IDPAIS,
                                                         plinkcatalogo         => :P548_LINKCATALOGO,
                                                         pidusuarioinclusao    => :P548_IDUSUARIOINCLUSAO,
                                                         pdatainclusao         => :P548_DATAINCLUSAO,
                                                         pidusuariomp          => :P548_IDUSUARIOMORTEPROG,
                                                         pdatamp               => :P548_DATAMORTEPROG,
                                                         pidusuarioajustaitens => :P548_IDUSUARIOAJUSTEITENS,
                                                         pdataajustaitens      => :P548_DATAAJUSTEITENS,
                                                         pidusuarioajustamp    => :P548_IDUSUARIOITENSMORTEPROG,
                                                         pdataajustamp         => :P548_DATAITENSMORTEPROG,
                                                         petapa                => :P548_ETAPA,
                                                         pmd5                  => :P548_MD5,
                                                         poperacao_dml         => 'S');
                
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 23443716599909547
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P548_IDVIRADADECATALOGO
        }
    )

    process incluir-itens (
        name: Incluir_Itens
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                
                 vid_item              number;
                 vMP                   varchar2(1) := 'N';
                 vidusuario            number;
                 vdata                 date;
                 vnome                 varchar2(200);
                 vdatainicial          date;
                 vdatafinal            date;
                 videdicaorevori       number;
                 videdicaorevdest      number;
                 vidpais               number;
                 vlinkcatalogo         varchar2(100);
                 vidusuarioinclusao    number;
                 vdatainclusao         date;
                 vidusuarioMP          number;
                 vdataMP               date;
                 vidusuarioajustaitens number;
                 vdataajustaitens      date;
                 vidusuarioajustaMP    number;
                 vdataajustaMP         date;
                 vetapa                number;
                 vmd5                  varchar2(4000);
                 vidprod               number;
                 vidfilial             number;
                 vpontos               number;
                begin
                
                
                  vetapa  := 1;
                
                  for r1 in (
                               select nome
                                    , datavalidadeini
                                    , datavalidadefim
                                    , idedicaorevistaorigem
                                    , idedicaorevistadestino
                                    , idpais
                                    , linkcatalogo
                                    , decode(idpais,2,1041,
                                                    4,1111,
                                             100) idfilial
                                 from viradasdecatalogo
                                where idviradadecatalogo = :P548_IDVIRADADECATALOGO
                    ) loop
                  
                    vnome                 := r1.nome;
                    videdicaorevori       := r1.idedicaorevistaorigem;
                    videdicaorevdest      := r1.idedicaorevistadestino;
                    vidpais               := r1.idpais;
                    vlinkcatalogo         := r1.linkcatalogo;
                    vidfilial             := r1.idfilial;
                    
                    begin
                      select datainicial,  datafinal
                        into vdatainicial, vdatafinal
                        from edicoesrevistas
                       where idedicaorevista = r1.idedicaorevistaorigem;
                    exception
                      when no_data_found then
                        raise_application_error(-20001,'Data inicial e final não localizada na edição anterior informada na virada!');
                      when others then 
                        raise_application_error(-20001,'Erro não previsto na inclusao dos itens da virada de catálogo! ' || sqlerrm);
                    end;
                    
                    UPDATE viradasdecatalogo
                       SET etapa = vetapa
                     WHERE idviradadecatalogo = :P548_IDVIRADADECATALOGO;
                     
                 /*   pck_cadastros_fav.prc_viradadecatalogo(pidviradadecatalogo   => :P548_IDVIRADADECATALOGO,
                                                           pnome                 => vnome,
                                                           pdatainicial          => vdatainicial,
                                                           pdatafinal            => vdatafinal,
                                                           pidedicaorevori       => videdicaorevori,
                                                           pidedicaorevdest      => videdicaorevdest,
                                                           pidpais               => vidpais,
                                                           plinkcatalogo         => vlinkcatalogo,
                                                           pidusuarioinclusao    => vidusuarioinclusao,
                                                           pdatainclusao         => vdatainclusao,
                                                           pidusuariomp          => vidusuarioMP,
                                                           pdatamp               => vdataMP,
                                                           pidusuarioajustaitens => vidusuarioajustaitens,
                                                           pdataajustaitens      => vdataajustaitens,
                                                           pidusuarioajustamp    => vidusuarioajustamp,
                                                           pdataajustamp         => vdataajustamp,
                                                           petapa                => vetapa,
                                                           pmd5                  => vmd5,
                                                           poperacao_dml         => 'U'); */
                  
                
                  end loop;
                  --
                  vidprod := 0;
                  --
                  FOR c1 IN ( SELECT d.idprodutodetalhado
                                   , r.valorvenda
                                   , r.valorcusto
                                   , r.perccomissaoconsultora
                                   , r.perccomissaodistribuidor
                                   , r.perccomissaogerente
                                   , p.valorpontos 
                                   , (select idtagproduto
                                        from classificacoesprodutos
                                       where idprodutodetalhado = d.idprodutodetalhado
                                         and idclassificacaoproduto = (select max(idclassificacaoproduto)
                                                                         from classificacoesprodutos
                                                                        where idprodutodetalhado = d.idprodutodetalhado)) idtagproduto
                                   , r.idprecoproduto
                                   , r.idfilialromance
                                   , xx.idcategoria
                                   , xx.indicador
                                   , xx.qtdvend
                                   --
                                   , CASE  
                                          WHEN xx.idcategoria in (546, 542, 399) then round(r.valorvenda*0.6)
                                          WHEN xx.indicador between 1 AND 2  then round(r.valorvenda*1.3)
                                          WHEN xx.indicador between 3 AND 5  then round(r.valorvenda)
                                          WHEN xx.indicador between 6 AND 10 then round(r.valorvenda*0.8)
                                          ELSE round(r.valorvenda*0.6)
                                     END pontosNovo
                
                                FROM produtosdetedrevistas  d
                                   , precosprodutos         r
                                   , produtos               p
                                   , produtosdetalhados     a
                                   , filiaisedicoesrevistas f
                                   --
                                   , ( SELECT idcategoria, nome, idproduto, qtdvend,
                                              NTILE(20) OVER (PARTITION by idcategoria ORDER BY qtdvend DESC) indicador  -- cria um "rank" e divide em 20 niveis caso tenha, senão cria pela qtde de registros localizados
                                         FROM (
                                               SELECT c.idcategoria, c.nome, p.idproduto --w.idprodutodetalhado
                                                    , SUM(w.quantidadevendida) qtdvend
                                                 FROM vw_itensvenda_dia_fav_mv  w
                                                    , produtosdetalhados        d
                                                    , produtos                  p
                                                    , categorias                c
                                                    , produtosdetedrevistas     i --- DEVE FICAR NESTE SELECT INTERNO E TB NO EXTERNO PARA CALCULAR CORRETAMENTE O NTILE(20)
                                                WHERE w.idprodutodetalhado = d.idprodutodetalhado 
                                                  AND d.idproduto          = p.idproduto
                                                  AND p.idcategoria        = c.idcategoria
                                                  AND i.idprodutodetalhado = w.idprodutodetalhado
                                                  AND i.idedicaorevista    = videdicaorevori
                                                  AND w.dataemissao between to_date(to_char(vdatainicial,'dd/mm/rrrr') ||' 00:00:00','DD/MM/RRRR HH24:MI:SS')
                                                                        and to_date(to_char(vdatafinal,  'dd/mm/rrrr') ||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                                                GROUP BY c.idcategoria
                                                       , c.nome
                                                       , p.idproduto
                                                       --, w.idprodutodetalhado
                                               ) 
                                     ) xx
                                   --
                                WHERE d.idedicaorevista    = videdicaorevori -- origem
                                  AND r.idedicaorevista    = d.idedicaorevista
                                  AND d.idprodutodetalhado = r.idprodutodetalhado
                                  AND d.idprodutodetalhado = r.idprodutodetalhado
                                  AND d.idprodutodetalhado = a.idprodutodetalhado
                                  AND a.idproduto          = p.idproduto
                                  AND f.idedicaorevista    = d.idedicaorevista
                                  AND r.idfilialromance    = f.idfilial
                                  AND r.idfilialromance    = vidfilial -- para inclusão utilizar filial padrão. 
                                  --AND a.idprodutodetalhado = xx.idprodutodetalhado(+)
                                  AND a.idproduto = xx.idproduto(+)
                
                              UNION ALL  -- seleciona itens ja inclusos na revista destino(lancamentos), cuja pontuacao é CURVA A
                
                              SELECT d.idprodutodetalhado
                                   , 0 valorvenda
                                   , 0 valorcusto
                                   , 0 perccomissaoconsultora
                                   , 0 perccomissaodistribuidor
                                   , 0 perccomissaogerente
                                   , 0 valorpontos 
                                   , (select idtagproduto
                                        from classificacoesprodutos
                                       where idprodutodetalhado = d.idprodutodetalhado
                                         and idclassificacaoproduto = (select max(idclassificacaoproduto)
                                                                         from classificacoesprodutos
                                                                        where idprodutodetalhado = d.idprodutodetalhado)) idtagproduto
                                   , null idprecoproduto
                                   , f.idfilial idfilialromance
                                   , p.idcategoria
                                   , 0 indicador
                                   , 0 qtdvend
                                   , 0 pontosNovo
                
                                FROM produtosdetedrevistas  d
                                   , produtos               p
                                   , produtosdetalhados     a
                                   , filiaisedicoesrevistas f
                
                               WHERE d.idedicaorevista     = videdicaorevdest
                                 AND d.idprodutodetalhado  = a.idprodutodetalhado
                                 AND a.idproduto           = p.idproduto
                                 AND f.idedicaorevista     = d.idedicaorevista
                                 AND f.idfilial            = vidfilial -- para inclusão utilizar filial padrão.  
                
                            order by 1, 12 desc
                             
                    ) loop
                      
                      if vidprod = c1.idprodutodetalhado and c1.indicador = 0 then 
                         vidprod := 0;
                      else
                        vpontos := c1.pontosNovo;
                        if vidpais <> 1 then
                          vpontos:= 0;
                        end if;
                        pck_cadastros_fav.prc_itensviradadecatalogo( piditemviradadecatalogo => vid_item,
                                                                     pidviradadecatalogo     => :P548_IDVIRADADECATALOGO,
                                                                     pidprodutodetalhado     => c1.idprodutodetalhado,
                                                                     pidprecoproduto         => c1.idprecoproduto,
                                                                     pvalorvenda             => c1.valorvenda,
                                                                     pvalorcusto             => c1.valorcusto,
                                                                     pmorteprogramada        => vMP,
                                                                     pperccomissaoven        => c1.perccomissaoconsultora,
                                                                     pperccomissaodis        => c1.perccomissaodistribuidor,
                                                                     pperccomissaoger        => c1.perccomissaogerente,
                                                                     ppontosproduto          => c1.valorpontos,
                                                                     pidtagproduto           => c1.idtagproduto,
                                                                     pidfilialromance        => c1.idfilialromance,
                                                                     pidcategoria            => c1.idcategoria,
                                                                     pindicador              => c1.indicador,
                                                                     ppontuacaonova          => c1.pontosNovo,
                                                                     pqtdevendida            => c1.qtdvend,
                                                                     pmd5                    => :P548_MD5,
                                                                     poperacao_dml           => 'I');
                      end if;
                      
                      vidprod := c1.idprodutodetalhado;
                
                  end loop;
                  --
                
                  commit;
                
                  apex_application.g_print_success_message := --'<span style=”color : yellow “>Parabéns!! Itens inclusos com sucesso! </span>';
                                                              'Parabéns!! Itens inclusos com sucesso!' ;
                
                  exception
                   when others then
                      apex_error.add_error (
                        p_message          => 'Ocorreu erro durante a inclusão dos itens. Código do erro: '||SQLERRM,
                        p_display_location => apex_error.c_inline_in_notification );
                    
                end;
                
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 32458400517818303
        }
        serverSideCondition {
            whenButtonPressed: @copiaritens
        }
    )

