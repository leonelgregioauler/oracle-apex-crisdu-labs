page 548 (
    name: Virada de Catalogo
    title: Virada de Catalogo
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='Confirma Exclusão da Virada?';
    }
    css {
        inline: ".t-Region-body { background-color: Beige !important;}"
    }
    advanced {
        reloadOnSubmit: always
    }

    region virada-de-catalogo (
        name: VIRADA DE CATALOGO
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P548_DATAAJUSTEITENS (
        type: hidden
        layout {
            sequence: 160
            region: @virada-de-catalogo
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

