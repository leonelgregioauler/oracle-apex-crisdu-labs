    pageItem P548_ETAPA (
        type: displayOnly
        label {
            label: Etapa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Sem Itens' d, 0 r from dual
                union
                select 'Virada de Catalogo Iniciada' d, 1 r from dual
                union
                select 'Definicao do Itens de MP' d, 2 r from dual
                union
                select 'Ajuste de Itens da Virada' d, 3 r from dual
                union
                select 'Ajuste de Itens da MP' d, 4 r from dual
                
                ```
        }
        layout {
            sequence: 200
            region: @virada-de-catalogo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: 0
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P548_IDEDICAOREVISTADESTINO (
        type: popupLov
        label {
            label: Edição Revista Destino
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome || ' - '|| to_char(datainicial,'dd/mm/rrrr') || ' a '||to_char(datafinal,'dd/mm/rrrr') d
                     , idedicaorevista r
                  from edicoesrevistas
                 where  idpais = (select idpais 
                                    from edicoesrevistas 
                                   where idedicaorevista = :P548_IDEDICAOREVISTAORIGEM)
                   and idedicaorevista > :P548_IDEDICAOREVISTAORIGEM
                 order by 1
                ```
            nullDisplayValue: "- Selecione Revista Destino - "
        }
        cascadingLov {
            parentItems: P548_IDEDICAOREVISTAORIGEM
        }
        layout {
            sequence: 60
            region: @virada-de-catalogo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P548_IDEDICAOREVISTAORIGEM (
        type: popupLov
        label {
            label: Edição Revista Origem
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome || ' - '|| to_char(datainicial,'dd/mm/rrrr') || ' a '||to_char(datafinal,'dd/mm/rrrr') d
                     , idedicaorevista r
                  from edicoesrevistas
                 --where idpais = :P0_IDIDIOMA
                 order by 1
                ```
        }
        layout {
            sequence: 50
            region: @virada-de-catalogo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        security {
            encryptSessionState: false
        }
    )

