page 305 (
    name: Cadastro de Categoria Clube
    title: Cadastro de Categoria Clube
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 30%
        height: 40%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG_23"';
    }

    region cadastro-de-categoria-clube (
        name: Cadastro de Categoria Clube
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P305_IDCATEGORIACLUBE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @cadastro-de-categoria-clube
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P305_MD5 (
        type: hidden
        layout {
            sequence: 50
            region: @cadastro-de-categoria-clube
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P305_NOMECATEGORIA (
        type: textField
        label {
            label: Nome
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @cadastro-de-categoria-clube
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P305_PONTUACAOMAXIMA (
        type: textField
        label {
            label: Pontuação Máxima
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @cadastro-de-categoria-clube
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 5
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P305_PONTUACAOMINIMA (
        type: textField
        label {
            label: Pontuação Mínima
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @cadastro-de-categoria-clube
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 5
        }
        security {
            encryptSessionState: false
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 40
            region: @cadastro-de-categoria-clube
            slot: belowBox
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P305_IDCATEGORIACLUBE
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 10
            region: @cadastro-de-categoria-clube
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P305_IDCATEGORIACLUBE
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Cadastrar
        layout {
            sequence: 20
            region: @cadastro-de-categoria-clube
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P305_IDCATEGORIACLUBE
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 30
            region: @cadastro-de-categoria-clube
            slot: belowBox
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 304
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process consulta (
        name: Consulta
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  PCK_CLUBEPONTOS_FAV.PRC_CATEGORIASCLUBE( PIDCATEGORIACLUBE => :P305_IDCATEGORIACLUBE,
                                                           PNOMECATEGORIA => :P305_NOMECATEGORIA,
                                                           PPONTUACAOMINIMA => :P305_PONTUACAOMINIMA,
                                                           PPONTUACAOMAXIMA => :P305_PONTUACAOMAXIMA,
                                                           PMD5 => :P305_MD5,
                                                           POPERACAO_DML => 'S' );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 1401981123543047323
        }
    )

    process processo-dml-em-categorias-clube (
        name: Processo DML em Categorias Clube
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  --
                  if v('REQUEST') = 'SUBMIT' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'SAVE' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'DELETE' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  PCK_CLUBEPONTOS_FAV.PRC_CATEGORIASCLUBE( PIDCATEGORIACLUBE => :P305_IDCATEGORIACLUBE,
                                                           PNOMECATEGORIA => :P305_NOMECATEGORIA,
                                                           PPONTUACAOMINIMA => :P305_PONTUACAOMINIMA,
                                                           PPONTUACAOMAXIMA => :P305_PONTUACAOMAXIMA,
                                                           PMD5 => :P305_MD5,
                                                           POPERACAO_DML => voperacao_dml );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo executado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1402183297902518583
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 304
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 305
                items: {
                    P305_IDCATEGORIACLUBE: &P305_IDCATEGORIACLUBE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    branch (
        execution {
            sequence: 30
        }
        behavior {
            target: {
                page: 305
                items: {
                    P305_IDCATEGORIACLUBE:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

)

