page 247 (
    name: Notas da Cliente
    title: Notas da Cliente
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region notas-da-cliente (
        name: Notas da Cliente
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(n.idfilial) "Filial"
                 , roman.pck_romance.fnc_nomerepresentante(n.idrepresentante) "Distribuidor"
                 , n.numeronota
                 , n.dataretorno
                 , n.valortotalvendalqd
                 , n.valorpago
                 , n.saldo
                 , n.valorcomissao
                from roman.notasvendas n
                where n.idvendedora = :P247_IDVENDEDORA
                order by n.dataretorno desc
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 579053144633166222
        }

        column DATARETORNO (
            type: plainText
            heading {
                heading: Data de Retorno
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        column Distribuidor (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column Filial (
            type: plainText
            heading {
                heading: Filial
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column NUMERONOTA (
            type: plainText
            heading {
                heading: Nr Nota
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column SALDO (
            type: plainText
            heading {
                heading: Saldo
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: FML999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column VALORCOMISSAO (
            type: plainText
            heading {
                heading: Valor Comissão
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: FML999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column VALORPAGO (
            type: plainText
            heading {
                heading: Valor Pago
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: FML999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column VALORTOTALVENDALQD (
            type: plainText
            heading {
                heading: Valor Total
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: FML999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        savedReport 5803902 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATARETORNO (
                sequence: 4
            )

            displayColumn "Distribuidor" (
                sequence: 2
            )

            displayColumn "Filial" (
                sequence: 1
            )

            displayColumn NUMERONOTA (
                sequence: 3
            )

            displayColumn SALDO (
                sequence: 7
            )

            displayColumn VALORCOMISSAO (
                sequence: 8
            )

            displayColumn VALORPAGO (
                sequence: 6
            )

            displayColumn VALORTOTALVENDALQD (
                sequence: 5
            )

        )

    )

    pageItem P247_IDVENDEDORA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @notas-da-cliente
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

