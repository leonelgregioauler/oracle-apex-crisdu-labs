    region itens-que-sairam-do-catálogo (
        name: Itens que Sairam do Catálogo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.idestoque
                     , e.filialfavorita
                     , e.referenciaproduto
                     , e.produtodetalhadosref
                     , pck_estoque_fav.fnc_estoquedisponivel(e.idestoque) quantidade
                     , e.qtdestoqueminimo
                     , e.valorcusto
                     , e.quantidade * e.valorcusto custototal
                     , e.fornecedor
                from favorita.vw_estoques_fav e
                where e.ididioma = :P0_IDIDIOMA
                  and e.tipofilial = 'E'
                  and e.idprodutodetalhado in ( select p1.idprodutodetalhado
                                                from favorita.produtosdetedrevistas p1
                                                where p1.idedicaorevista = :P394_IDREVISTA_ANTIGO
                                                minus
                                                select p2.idprodutodetalhado
                                                from favorita.produtosdetedrevistas p2
                                                where p2.idedicaorevista = :P394_IDREVISTA_ATUAL)
                  and ( :P394_IDFILIALVORITA is null 
                       or   e.idfilialfavorita = :P394_IDFILIALVORITA)
                  and ( :P394_IDFORNECEDOR is null
                       or e.idfornecedor = :P394_IDFORNECEDOR)
                order by 2,4 
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1548007615069482637
        }

