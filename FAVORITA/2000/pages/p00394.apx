    validation tipo-obrigatório (
        name: Tipo Obrigatório
        execution {
            sequence: 10
        }
        validation {
            language: sql
            sqlExpression: :P394_TIPO is not null;
        }
        error {
            errorMessage: Tipo deve ser selecionado.
            associatedItem: @P394_TIPO
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'CRIAR';
        }
    )

    process cria-repasse-transferência (
        name: Cria Repasse  / Transferência
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vididioma                number := :P0_IDIDIOMA;
                  vidusuario               number := :P0_IDUSUARIO;
                  videdicaoantigo          number := :P394_IDREVISTA_ANTIGO;
                  videdicaonovo            number := :P394_IDREVISTA_ATUAL;
                  vidfilialfavorita        number := :P394_IDFILIALVORITA;
                  vidfilialfavoritadestino number := :P394_IDFILIALFAVORITADESTINO;
                  vidfilialromancedestino  number := :P394_IDFILIALROMANCEDESTINO;
                  vidfilialromance         number := :P394_IDFILIALROMANCE;
                  vidfornecedor            number := :P394_IDFORNECEDOR;
                  vidtipo                  number := :P394_TIPO;
                  vidcompratransferencia   number;
                  --
                begin
                  --
                  :P394_IDCOMPRATRANSFERENCIA := null;
                  --
                  pck_comprastransf_fav.prc_repassetransferenciafilial (pididioma                => vididioma,
                                                                        pidusuario               => vidusuario,
                                                                        pidedicaorevistaantigo   => videdicaoantigo,
                                                                        pidedicaorevistanovo     => videdicaonovo,
                                                                        pidfilialfavoritaorigem  => vidfilialfavorita,
                                                                        pidfilialfavoritadestino => vidfilialfavoritadestino,
                                                                        pidfilialromancedestino  => vidfilialromancedestino,
                                                                        pidfornecedor            => vidfornecedor,
                                                                        pidtipo                  => vidtipo,
                                                                        pidcompratransferencia   => vidcompratransferencia);
                  --
                  :P394_IDCOMPRATRANSFERENCIA := vidcompratransferencia;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 27195584099696808
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'CRIAR';
        }
    )

)

