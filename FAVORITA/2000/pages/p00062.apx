page 62 (
    name: Cadastro de Formas Pagamentos
    title: Formas Pagamentos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region formas-pagamentos (
        name: Formas Pagamentos
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P62_DESCRICAO (
        type: textField
        label {
            label: Forma de Pagamento
            alignment: left
        }
        layout {
            sequence: 20
            region: @formas-pagamentos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P62_IDFORMAPAGAMENTO (
        type: hidden
        layout {
            sequence: 10
            region: @formas-pagamentos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P62_MD5 (
        type: hidden
        layout {
            sequence: 30
            region: @formas-pagamentos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P62_OPERACAO_DML (
        type: hidden
        layout {
            sequence: 40
            region: @formas-pagamentos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P62_TIPOPEDIDO (
        type: selectList
        label {
            label: Tipo de Pedido
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Todos;T,Pedido Normal;P,Romance Casa;R
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @formas-pagamentos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P62_VALORFINAL (
        type: numberField
        label {
            label: Até valor
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 70
            region: @formas-pagamentos
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P62_VALORINICIAL (
        type: numberField
        label {
            label: Valor De
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 60
            region: @formas-pagamentos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 50
            region: @formas-pagamentos
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P62_IDFORMAPAGAMENTO
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 40
            region: @formas-pagamentos
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P62_IDFORMAPAGAMENTO
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 30
            region: @formas-pagamentos
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 61
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 20
            region: @formas-pagamentos
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P62_IDFORMAPAGAMENTO
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @formas-pagamentos
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P62_IDFORMAPAGAMENTO
        }
    )

    validation descricao-obrigatório (
        name: DESCRICAO obrigatório
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P62_DESCRICAO
        }
        error {
            errorMessage: Descrição deve ter um valor.
            associatedItem: @P62_DESCRICAO
        }
    )

    process consulta-formas-pagamentos (
        name: Consulta Formas Pagamentos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                #OWNER#.PCK_CADASTROS_FAV.PRC_FORMASPAGAMENTOS (
                  PIDFORMAPAGAMENTO => :P62_IDFORMAPAGAMENTO,
                  PDESCRICAO => :P62_DESCRICAO,
                  PTIPOPEDIDO => :P62_TIPOPEDIDO,
                  PVALORINICIAL => :P62_VALORINICIAL,
                  PVALORFINAL => :P62_VALORFINAL,
                  PMD5 => :P62_MD5,
                  POPERACAO_DML => 'S');
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 3162750402449245
        }
    )

    process limpar-campos-ao-sair (
        name: Limpar Campos ao Sair
        type: clearSessionState
        execution {
            sequence: 10
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 3420528895300504
        }
    )

    process limpar-campos-para-adicionar (
        name: Limpar Campos para Adicionar
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 3420648277300505
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    process operação-dml-em-formas-pagamentos (
        name: Operação DML em Formas Pagamentos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  #OWNER#.PCK_CADASTROS_FAV.PRC_FORMASPAGAMENTOS (
                    PIDFORMAPAGAMENTO => :P62_IDFORMAPAGAMENTO,
                    PDESCRICAO => :P62_DESCRICAO,
                    PTIPOPEDIDO => :P62_TIPOPEDIDO,
                    PVALORINICIAL => :P62_VALORINICIAL,
                    PVALORFINAL => :P62_VALORFINAL,
                    PMD5 => :P62_MD5,
                    POPERACAO_DML => voperacao_dml);
                  --
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 3416886246199780
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 62
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

)

