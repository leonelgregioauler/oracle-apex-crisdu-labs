page 146 (
    name: Despachar Pedidos
    title: Despachar Pedidos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region despachar-pedidos (
        name: Despachar Pedidos
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region ultimos-pedidos-despachados (
        name: Ultimos Pedidos Despachados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.numeropedido
                     , p.idvendedora
                     , p.filialromance
                from vw_pedidos_fav p
                where p.ididioma = :P0_IDIDIOMA
                  and exists ( select 1 
                               from classificacoespedidos c
                               where c.idcaracteristicapedido = 20
                                 and c.idpedido               = p.idpedido
                                 and c.idusuario              = :P0_IDUSUARIO
                                 and trunc(c.dataclassificado)= trunc(sysdate))
                  and rownum <= 5
                order by idpedido desc
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 6
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column FILIALROMANCE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Filial Romance
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column IDVENDEDORA (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: IDVENDEDORA
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column NUMEROPEDIDO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Nr Pedido
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P146_NUMEROPEDIDO (
        type: textField
        label {
            label: Pedido
            alignment: left
        }
        layout {
            sequence: 10
            region: @despachar-pedidos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P146_NUMEROPEDIDO
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: DESPACHAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction set-focus-numeropedido (
        name: set focus numeropedido
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P146_NUMEROPEDIDO
            }
            execution {
                sequence: 10
            }
        )

    )

    process despachar (
        name: DESPACHAR
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                  -- alterado para já enviar o IDPEDIDO
                  pck_movimentarpedidos_fav.prc_despacharpedidos(pnumeropedido => :P146_NUMEROPEDIDO,
                                                                 pidusuario    => :P0_IDUSUARIO);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Pedido Despachado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 29535884237026526
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 146
                items: {
                    P146_NUMEROPEDIDO:
                }
                action: resetPagination
            }
        }
    )

)

