    region new (
        name: New
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct favorita.pck_util_fav.fnc_nomeprodutodetalhado(pd.idprodutodetalhado,1) "Produto Detalhado"
                --     , pr.referencia || ' - ' || favorita.pck_util_fav.fnc_nomeproduto ( pr.idproduto,1,'N') "Ref + Prod"
                     , favorita.pck_util_fav.fnc_siglagrade(pd.idgrade,1) "Grade"
                     , favorita.pck_util_fav.fnc_nomecor (pd.idcor,1) "Cor"
                     , favorita.pck_util_fav.fnc_nomecaracteristica (pd.idcaracteristica,1) "Característica"
                     , pp.valorcusto               "Custo"
                     , pp.valorvenda               "Venda"
                     , pp.perccomissaogerente      "%Gestor"
                     , pp.perccomissaodistribuidor "%Dist."
                     , pp.perccomissaoconsultora   "%Cons."
                     , round((pp.valorvenda - (pp.valorvenda*(pp.perccomissaoconsultora/100))) 
                          - ((pp.valorvenda - (pp.valorvenda*(pp.perccomissaoconsultora/100))) * (pp.perccomissaodistribuidor / 100 )) 
                          - ((pp.valorvenda - (pp.valorvenda*(pp.perccomissaoconsultora/100))) * (pp.perccomissaogerente / 100 )) 
                          - ((pp.valorvenda - (pp.valorvenda*(pp.perccomissaoconsultora/100))) * (select to_number(valor)/100
                                                                                                  from favorita.parametros
                                                                                                  where nome = 'MCUPERCENTUALINADIMPLENCIA'))
                          - ((pp.valorvenda - (pp.valorvenda*(pp.perccomissaoconsultora/100))) * (select to_number(valor)/100
                                                                                                  from favorita.parametros
                                                                                                  where nome = 'MCUPERCENTUALIMPOSTOS')) 
                          - ((pp.valorvenda - (pp.valorvenda*(pp.perccomissaoconsultora/100))) * (select to_number(valor)/100
                                                                                                  from favorita.parametros
                                                                                                  where nome = 'MCUPERCENTUALOPERACAO'))
                        - pp.valorcusto,2 ) "MCU"
                     --
                     --, round(pp.valorvenda / pp.valorcusto,2) "Markup"
                     , case when pp.valorcusto > 0 then round(pp.valorvenda / pp.valorcusto,2) else 0 end "Markup"
                     --
                     , case
                         when (pp.valorvenda - (pp.valorvenda*(pp.perccomissaoconsultora/100))) <> 0 then
                           round(((pp.valorvenda - (pp.valorvenda*(pp.perccomissaoconsultora/100))) 
                              - ((pp.valorvenda - (pp.valorvenda*(pp.perccomissaoconsultora/100))) * ((pp.perccomissaogerente + pp.perccomissaodistribuidor) / 100 )) 
                              - ((pp.valorvenda - (pp.valorvenda*(pp.perccomissaoconsultora/100))) * (select to_number(valor)/100
                                                                                                      from favorita.parametros
                                                                                                      where nome = 'MCUPERCENTUALINADIMPLENCIA'))
                              - ((pp.valorvenda - (pp.valorvenda*(pp.perccomissaoconsultora/100))) * (select to_number(valor)/100
                                                                                                      from favorita.parametros
                                                                                                      where nome = 'MCUPERCENTUALIMPOSTOS')) 
                              - ((pp.valorvenda - (pp.valorvenda*(pp.perccomissaoconsultora/100))) * (select to_number(valor)/100
                                                                                                  from favorita.parametros
                                                                                                  where nome = 'MCUPERCENTUALOPERACAO')) - pp.valorcusto)
                            / (pp.valorvenda - (pp.valorvenda*(pp.perccomissaoconsultora/100)) ) * 100,2) 
                       else 0
                       end "Lucro %"
                     --
                     , (select nome from edicoesrevistas where idedicaorevista = pp.idedicaorevista) "Revista"
                     , ct.nome "Categoria"
                  from favorita.produtosdetalhados pd
                     , favorita.produtos           pr
                     , favorita.precosprodutos     pp
                     , favorita.categorias         ct
                     , favorita.categoriassite     cs
                 where pp.idprodutodetalhado = pd.idprodutodetalhado
                   and pd.idproduto          = pr.idproduto
                   and pr.idcategoria        = ct.idcategoria
                   and ct.idcategoriasite    = cs.idcategoriasite
                   and (:P614_IDEDICAOREVISTA is null or pp.idedicaorevista = :P614_IDEDICAOREVISTA)
                   and (:P614_IDFILIAL is null        or pp.idfilialromance = :P614_IDFILIAL)
                   and (:P614_IDPRODUTO is null       or pr.idproduto       = :P614_IDPRODUTO)
                   and (:P614_IDCATEGORIA is null     or ct.idcategoria     = :P614_IDCATEGORIA)
                   and (:P614_IDEDICAOREVISTA is not null or
                        :P614_IDFILIAL        is not null or
                        :P614_IDPRODUTO       is not null or
                        :P614_IDCATEGORIA     is not null )
                ```
            pageItemsToSubmit: [
                P614_IDEDICAOREVISTA
                P614_IDFILIAL
                P614_IDCATEGORIA
                P614_IDPRODUTO
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
