    region relatório-mcu (
        name: Relatório MCU
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idproduto
                     , valorvenda "Valor Venda"
                     , sum(quantidade) quantidade
                     , sum(valorrevista) "Valor Revista"
                     , sum(valorcomissaoconsultora) "Desconto Empreend."
                     , sum(valorcomissaodistribuidor) "Desconto Distrib."
                     , sum(valorcomissaogerente) "Desconto Gestor"
                     , round(((sum(quantidade)*valorvenda) - sum(valorcomissaoconsultora) ) * 15 /100 ,2 )  Inadimplencia
                     , round(((sum(quantidade)*valorvenda) - sum(valorcomissaoconsultora) ) * 18 /100 ,2 )  Impostos
                     , round(((sum(quantidade)*valorvenda) - sum(valorcomissaoconsultora) ) * 5.5 /100 ,2 )  CustoOperacao
                     --
                     , round( ((sum(quantidade)*valorvenda) - sum(valorcomissaoconsultora) ) - 
                              sum(valorcomissaodistribuidor) -
                              sum(valorcomissaogerente) -
                              (((sum(quantidade)*valorvenda) - sum(valorcomissaoconsultora)) * 15 /100 ) - --inadimplencia
                              (((sum(quantidade)*valorvenda) - sum(valorcomissaoconsultora)) * 18 /100 ) - --impostos
                              (((sum(quantidade)*valorvenda) - sum(valorcomissaoconsultora)) * 5.5 /100 ) ,2 ) --CustoOperacao
                        ValorMCU
                  from (
                        select it.idproduto
                             --, pe.idpedido
                             , it.valorvenda * pe.fatorconversao valorvenda
                             , it.quantidade
                             , it.quantidade * it.valorvenda * pe.fatorconversao valorRevista
                             , it.valorcomissaoconsultora    * pe.fatorconversao valorcomissaoconsultora
                             , it.valorcomissaodistribuidor  * pe.fatorconversao valorcomissaodistribuidor
                             , it.valorcomissaogerente       * pe.fatorconversao valorcomissaogerente
                             , ((it.quantidade*it.valorvenda*pe.fatorconversao) - (it.valorcomissaoconsultora*pe.fatorconversao ) * 15 /100 )  Inadimplencia
                             , ((it.quantidade*it.valorvenda*pe.fatorconversao) - (it.valorcomissaoconsultora*pe.fatorconversao ) * 18 /100 )  Impostos
                             , ((it.quantidade*it.valorvenda*pe.fatorconversao) - (it.valorcomissaoconsultora*pe.fatorconversao ) * 5.5 /100 ) CustoOperacao
                             --
                          from itenspedidos it
                             , pedidos      pe
                             , produtos     pr
                         where pe.idpedido = it.idpedido
                           and it.idproduto = pr.idproduto
                           and trunc(pe.dataemissao) between :P614_DATAINICIO and :P614_DATAFIM
                           and (:P614_IDFILIAL is null    or pe.idfilialfavorita = :P614_IDFILIAL)
                           and (:P614_IDPRODUTO is null   or pr.idproduto = :P614_IDPRODUTO)
                           and (:P614_IDCATEGORIA is null or pr.idcategoria = :P614_IDCATEGORIA)
                      )
                group by idproduto
                     , valorvenda
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            showNullValuesAs: -
        }
