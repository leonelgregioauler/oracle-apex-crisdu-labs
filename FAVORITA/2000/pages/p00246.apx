    process gerar-tarefas-de-prospecção-manaus (
        name: Gerar Tarefas de Prospecção Manaus
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidtarefa             number;
                  vdatainclusao         date          := sysdate;
                  vidsituacao           number        := 0;
                  vobservacao           varchar2(500);
                  vidusuario            number        := :P246_IDUSUARIO;
                  vidtipotarefa         number        := 8;
                  vidpessoa             number;
                  vidgrupoatendimento   number        := 4;
                  vtelefone             varchar2(30);
                  vidpais               number;
                  vidvendedora          number;  
                  --
                  vnumber               number;
                  vvarchar              varchar2(5);
                  vdata                 date;
                  vexiste               varchar2(1);
                  --
                begin
                  --
                  if APEX_APPLICATION.G_F02.COUNT > 0 then 
                  --
                    FOR i in 1..APEX_APPLICATION.G_F02.COUNT 
                    LOOP
                      --
                      vidvendedora := to_number(APEX_APPLICATION.G_F02(i));
                    --
                    select idpessoa
                      into vidpessoa
                      from vendedoras
                     where idvendedora = vidvendedora;
                    --
                    select idpais
                    into vidpais
                    from pessoas 
                    where idpessoa = vidpessoa;
                    --
                   vobservacao := roman.pck_romance.fnc_retornatelefones(vidvendedora);
                    --
                    begin
                      --
                      select telefone
                        into vtelefone
                        from telefonespessoas t
                       where t.idpessoa = vidpessoa
                         and rownum = 1;
                      --
                    exception 
                      when NO_DATA_FOUND then
                        vtelefone := null;
                    end;
                    --
                    if vidpais = 1 then
                      --
                      vidtipotarefa := 68;
                      vidgrupoatendimento := 4;
                      --
                    end if;
                    --
                    pck_tarefas_fav.prc_tarefas ( pidtarefa                 => vidtarefa,
                                                  pidtipotarefa             => vidtipotarefa,
                                                  pidticketcallcenter       => vnumber,
                                                  ptelefone                 => vtelefone,
                                                  pdatainclusao             => vdatainclusao,
                                                  pprioridade               => vnumber,
                                                  pidsituacao               => vidsituacao,
                                                  pobservacao               => vobservacao,
                                                  pidusuario                => vidusuario,
                                                  pidpessoa                 => vidpessoa,
                                                  pidgrupoatendimento       => vidgrupoatendimento,
                                                  pdatainicio               => vdata,
                                                  pdataconclusao            => vdata,
                                                  pnumeroposicaoatendimento => vvarchar,
                                                  pidpedido                 => vnumber,
                                                  pcodigoarea               => vnumber,
                                                  pidpais                   => vidpais,
                                                  pmd5                      => vvarchar,
                                                  poperacao_dml             => 'I' );
                    --
                    end loop;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Tarefa(s) Gerada(s) com Sucesso!
        }
        advanced {
            executionMappingIdentifier: 567106945256146601
        }
        serverSideCondition {
            whenButtonPressed: @gerar-tarefas
            type: item=value
            item: P246_TIPORELATORIO
            value: A
        }
    )

    process gerar-tarefas-de-venda-ativa (
        name: Gerar Tarefas de Venda Ativa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidtarefa             number;
                  vdatainclusao         date          := sysdate;
                  vidsituacao           number        := 50;
                  vobservacao           varchar2(500);
                  vidusuario            number := :P246_IDUSUARIO;
                  vidtipotarefa         number;
                  vidpessoa             number;
                  vidgrupoatendimento   number        := 4;
                  vtelefone             varchar2(30);
                  vidpais               number;
                  vidvendedora          number;
                  --
                  vnumber               number;
                  vvarchar              varchar2(5);
                  vdata                 date;
                  vexiste               varchar2(1);
                  --
                begin
                  --
                  if APEX_APPLICATION.G_F02.COUNT > 0 then 
                  --
                    FOR i in 1..APEX_APPLICATION.G_F02.COUNT 
                    LOOP
                      --
                      vidvendedora := to_number(APEX_APPLICATION.G_F02(i));
                    --
                    select idpessoa
                    into vidpessoa
                    from vendedoras
                    where idvendedora = vidvendedora;
                    --
                    select idpais
                    into vidpais
                    from pessoas 
                    where idpessoa = vidpessoa;
                    --
                    vobservacao := roman.pck_romance.fnc_retornatelefones(vidvendedora);
                    --
                    if vidpais = 1 then
                      vidtipotarefa := 11; -- Venda Ativa
                      vidgrupoatendimento := 4;
                    elsif vidpais = 2 then
                      vidtipotarefa := 12; -- Venda Ativa uruguay
                      vidgrupoatendimento := 33;
                    elsif vidpais =  4 then
                      vidtipotarefa := 34; -- Venda Ativa Paraguay
                      vidgrupoatendimento := 34;
                    end if;
                    --
                    begin
                      --
                      select telefone
                      into vtelefone
                      from telefonespessoas t
                      where t.idpessoa = vidpessoa
                        and rownum = 1;
                      --
                    exception 
                      when NO_DATA_FOUND then
                        vtelefone := null;
                    end;
                    --
                    if vidusuario is null then
                      --
                      vidsituacao := 0;
                      --
                    else
                      --
                      vidsituacao := 50;
                      --
                    end if;
                    --
                    pck_tarefas_fav.prc_tarefas ( pidtarefa                 => vidtarefa,
                                                  pidtipotarefa             => vidtipotarefa,
                                                  pidticketcallcenter       => vnumber,
                                                  ptelefone                 => vtelefone,
                                                  pdatainclusao             => vdatainclusao,
                                                  pprioridade               => vnumber,
                                                  pidsituacao               => vidsituacao,
                                                  pobservacao               => vobservacao,
                                                  pidusuario                => vidusuario,
                                                  pidpessoa                 => vidpessoa,
                                                  pidgrupoatendimento       => vidgrupoatendimento,
                                                  pdatainicio               => vdata,
                                                  pdataconclusao            => vdata,
                                                  pnumeroposicaoatendimento => vvarchar,
                                                  pidpedido                 => vnumber,
                                                  pcodigoarea               => vnumber,
                                                  pidpais                   => vidpais,
                                                  pmd5                      => vvarchar,
                                                  poperacao_dml             => 'I' );
                    --
                    end loop;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Tarefa(s) Gerada(s) com Sucesso!
        }
        advanced {
            executionMappingIdentifier: 566972234738033534
        }
        serverSideCondition {
            whenButtonPressed: @gerar-tarefas
            type: item=value
            item: P246_TIPORELATORIO
            value: V
        }
    )

