    pageItem P246_IDREPRESENTANTE (
        type: selectOne
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select /*+ rule*/ roman.pck_romance.fnc_nomerepresentante(r.idrepresentante)
                                 ||' - '||p.cpf 
                                 ||' - '|| roman.pck_romance.fnc_nomefilial(roman.pck_romance.fnc_filialgerente(r.idgerente)) display_value
                     , r.idrepresentante return_value
                from catal.representantes r
                   , catal.pessoas p
                where p.idpessoa = r.idpessoa
                  and ( :P246_IDFILIALROMANCE is null or r.idgerente = ( select idgerente 
                                                                         from gerentes g
                                                                         where g.idfilial = :P246_IDFILIALROMANCE ) )
                order by 1;
                ```
        }
        cascadingLov {
            parentItems: P246_IDFILIALROMANCE
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P246_IDUSUARIO (
        type: selectOne
        label {
            label: Atendente Responsável
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' ('||( select p.nome from catal.paises p where p.idpais = u.ididioma)||')' display_value
                     , u.idusuario return_value
                from usuarios u
                   , pessoas p
                where u.idpessoa = p.idpessoa
                  and u.ativo    = 'S'
                  and exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.idgrupoatendimento in (4,33,34)
                                 and ug.usuario            = u.usuario )
                order by 1
                ```
        }
        layout {
            sequence: 150
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

