    region relação-de-clientes-venda-ativa (
        name: Relação de Clientes Venda Ativa
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select /*+ FIRST_ROWS(50) */ p.vendedora cliente
                     , to_char(sum(p.valorpago),'999G999G999G999G990D00') totalpago
                     , to_char((sum(p.valorpago)/count(1)),'999G999G999G999G990D00') media
                     , to_char(sum(p.saldodevedor),'999G999G999G999G990D00') saldodevedor
                     , null gerartarefa
                     , p.idvendedora
                     , count(idpedido) qtdpedidos
                     , v.idpessoa vercadastro
                     , pck_util_fav.fnc_retornadataatendimento(p.idvendedora) dataretorno
                     , null vertarefa
                     , v.idpessoa
                     , p.cpf
                     --, roman.pck_romance.fnc_retornatelefones(p.idvendedora) telefones
                  , (select listagg(distinct(telefone),' / ') within group (order by 1) 
                      from catal.telefonespessoas t
                     where t.idpessoa = v.idpessoa) telefones
                     , apex_item.CHECKBOX2(2,p.idvendedora, null)CHECK1
                from vw_pedidos_fav p
                   , vendedoras v
                where p.ididioma           = 1
                  and v.idvendedora        = p.idvendedora
                  and v.ativo              = 'S'
                  and :P246_TIPORELATORIO  = 'V'
                  and ( select sum(n.saldo)
                        from roman.notasvendas n
                        where n.idvendedora = v.idvendedora
                          and n.idsituacaonotavenda = 4 ) = 0
                  and ( :P246_DATAINICIO is null 
                       or exists ( select 1
                                   from roman.notasvendas nv
                                   where nv.idvendedora = v.idvendedora
                                     and nv.idsituacaonotavenda = 3
                                     and trunc(nv.dataretorno) between to_date(:P246_DATAINICIO) and to_date(:P246_DATAFIM) ) )
                  and ( :P246_DEBITO is null or ( :P246_DEBITO = 'S' and (select sum(pf.saldodevedor)
                                                                          from vw_pedidos_fav pf
                                                                          where pf.ididioma = 1
                                                                            and pf.idvendedora = p.idvendedora) > 0 )
                                             or ( :P246_DEBITO = 'N' and nvl((select sum(pf.saldodevedor)
                                                                              from vw_pedidos_fav pf
                                                                              where pf.ididioma = 1
                                                                                and pf.idvendedora = p.idvendedora),0) = 0 ) )
                  and ( :P246_TAREFA is null or ( :P246_TAREFA = 'S' and exists ( select 1
                                                                                  from tarefas t
                                                                                  where t.idpessoa = v.idpessoa
                                                                                    and t.idtipotarefa IN (11,12,34) ) )
                                             or ( :P246_TAREFA = 'N' and not exists ( select 1
                                                                                      from tarefas t
                                                                                      where t.idpessoa = v.idpessoa 
                                                                                        and t.idtipotarefa IN (11,12,34) ) ) )
                  and p.idfilialromance    = :P246_IDFILIALROMANCE
                  and ( :P246_IDREPRESENTANTE is null or p.idrepresentante    = :P246_IDREPRESENTANTE )
                  and ( :P246_IDCIDADE is null or exists ( select 1
                                                           from pessoas p
                                                           where p.idpessoa = v.idpessoa
                                                             and p.idcidade = :P246_IDCIDADE ) )
                  and p.codpedidocancelado = 'N'
                  and not exists ( select 1
                                   from tarefas t
                                   where t.idtipotarefa IN (11,12,34)
                                     and t.idsituacao in (0,10)
                                     and t.idpessoa = v.idpessoa )
                  and trunc(sysdate) - ( select max(trunc(dataemissao))
                                         from vw_pedidos_fav pp
                                         where pp.idvendedora = p.idvendedora
                                           and pp.ididioma    = 1
                                           and pp.codpedidocancelado = 'N' ) >= ( select valor
                                                                                  from parametros pr
                                                                                  where pr.nome = 'QTDDIASPARAVENDAATIVA' )
                  and ( :P246_REDESPACHOTOTAL = 0 or ( exists( select 1
                                                               from catal.pessoas cp
                                                               where cp.idpessoa = v.idpessoa
                                                                 and exists ( select *
                                                                              from favorita.totalexpressinfo t
                                                                              where to_number(nvl(regexp_replace(cp.cep, '[^0-9]', ''),'0')) between t.cepinicial and t.cepfinal)) and :P246_REDESPACHOTOTAL= 1)
                                                  or not ( exists( select 1
                                                                   from catal.pessoas cp
                                                                   where cp.idpessoa = v.idpessoa
                                                                     and exists ( select *
                                                                                  from favorita.totalexpressinfo t
                                                                                  where to_number(nvl(regexp_replace(cp.cep, '[^0-9]', ''),'0')) between t.cepinicial and t.cepfinal)) and :P246_REDESPACHOTOTAL= 2) )
                group by p.vendedora, v.idpessoa , p.idvendedora, p.cpf
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
