    region relação-de-clientes-prospecção-2 (
        name: Relação de Clientes Prospecção
        type: tabform
        source {
            sqlQuery:
                ```sql
                select /*+ FIRST_ROWS(50) */ roman.pck_romance.fnc_nomevendedora(n.idvendedora) cliente
                 , to_char(sum(n.valorpago),'999G999G999G999G990D00') totalpago
                 , to_char((sum(n.valorpago)/count(1)),'999G999G999G999G990D00') media
                 , null gerartarefa
                 , null vernotas
                 , n.idvendedora
                 , ( select count(1)
                     from roman.notasvendas nv
                     where nv.idvendedora = n.idvendedora ) qtdnotas
                 , v.idpessoa vercadastro
                 , pck_util_fav.fnc_retornadataatendimento(n.idvendedora) dataretorno
                 , roman.pck_romance.fnc_cpfvendedora(n.idvendedora) cpf
                 , roman.pck_romance.fnc_retornatelefones(n.idvendedora) telefones
                from roman.notasvendas n
                 , vendedoras v
                where v.idvendedora = n.idvendedora
                  and v.ativo = 'S'
                  and n.idsituacaonotavenda = 3
                  and :P246_TIPORELATORIO = 'P'
                  and exists ( select 1
                               from roman.notasvendas n
                               where n.idsituacaonotavenda = 3
                                 and n.idvendedora = v.idvendedora
                                 and trunc(n.datanota) > trunc(sysdate - 100)) 
                  and ( :P246_DEBITO is null or ( :P246_DEBITO = 'S' and ( select sum(n.saldo)
                                                                           from roman.notasvendas n
                                                                           where n.idvendedora = v.idvendedora
                                                                             and n.idsituacaonotavenda = 4 ) > 0 )
                                             or ( :P246_DEBITO = 'N' and ( select sum(n.saldo)
                                                                           from roman.notasvendas n
                                                                           where n.idvendedora = v.idvendedora
                                                                             and n.idsituacaonotavenda = 4 ) = 0 ) )
                  and ( :P246_DATAINICIO is null 
                       or trunc(n.dataretorno) between to_date(:P246_DATAINICIO) and to_date(:P246_DATAFIM) )
                  and not exists ( select 1
                                   from pedidos p
                                   where p.idvendedora = n.idvendedora )
                  and not exists ( select 1
                                   from catal.pedidos p
                                   where p.idvendedora = n.idvendedora ) 
                  and not exists ( select 1
                                   from catal.funcionarios ff
                                   where ff.idpessoa = v.idpessoa )
                  and n.idfilial = :P246_IDFILIALROMANCE
                  and ( :P246_IDREPRESENTANTE is null or n.idrepresentante = :P246_IDREPRESENTANTE )
                  and ( :P246_IDCIDADE is null or exists ( select 1
                                                           from pessoas p
                                                           where p.idpessoa = v.idpessoa
                                                             and p.idcidade = :P246_IDCIDADE ) )
                  and not exists (select 1
                                   from tarefas t
                                   where t.idpessoa = v.idpessoa
                                     and (( t.idtipotarefa = 8 and t.idpais  = 1) or ( t.idtipotarefa = 47 and t.idpais  = 2) or ( t.idtipotarefa = 51 and t.idpais  = 4))
                                     and (t.idsituacao in (0,10,20,50)
                                       or (t.idsituacao = 30 and trunc(sysdate) - trunc(nvl(t.dataconclusao,t.datainclusao)) < 30)))
                 /*
                  and not exists ( select 1
                                     from tarefas t
                                     where t.idtipotarefa = 8
                                       and t.idsituacao in (0,10,20)
                                       and t.idpessoa = v.idpessoa 
                                        or exists ( select 1
                                                    from tarefas t
                                                    where t.idtipotarefa = 8
                                                      and t.idsituacao in (30)
                                                      and t.idpessoa = v.idpessoa
                                                      and trunc(sysdate) - trunc(t.dataconclusao) < 90))
                  */
                  having (:P246_MEDIAINI is null or  (sum(n.valorpago)/count(1)) between to_char(:P246_MEDIAINI,'999G999G999G999G990D00') 
                                                                                     and to_char(:P246_MEDIAFIM,'999G999G999G999G990D00'))
                  
                  and ( :P246_QTDNOTAS is null or ((( select count(1)
                                                      from roman.notasvendas nv
                                                      where nv.idvendedora = n.idvendedora ) = :P246_QTDNOTAS and :P246_TIPOQTD = 0)
                                                   or (( select count(1)
                                                        from roman.notasvendas nv
                                                        where nv.idvendedora = n.idvendedora ) > :P246_QTDNOTAS and :P246_TIPOQTD = 1)
                                                   or (( select count(1)
                                                        from roman.notasvendas nv
                                                        where nv.idvendedora = n.idvendedora ) < :P246_QTDNOTAS and :P246_TIPOQTD = 2)))
                  and ( :P246_REDESPACHOTOTAL = 0 or ( exists( select 1
                                                               from catal.pessoas cp
                                                               where cp.idpessoa = v.idpessoa
                                                                 and exists ( select *
                                                                              from favorita.totalexpressinfo t
                                                                              where to_number(nvl(regexp_replace(cp.cep, '[^0-9]', ''),'0')) between t.cepinicial and t.cepfinal)) and :P246_REDESPACHOTOTAL= 1)
                                                  or not ( exists( select 1
                                                                   from catal.pessoas cp
                                                                   where cp.idpessoa = v.idpessoa
                                                                     and exists ( select *
                                                                                  from favorita.totalexpressinfo t
                                                                                  where to_number(nvl(regexp_replace(cp.cep, '[^0-9]', ''),'0')) between t.cepinicial and t.cepfinal)) and :P246_REDESPACHOTOTAL= 2) )
                group by n.idvendedora, v.idpessoa
                order by 1 
                  
                ```
        }
