            templateOptions: [
                #DEFAULT#
                js-dialog-size600x400
            ]
        }
        advanced {
            htmlDomId: TAREFA
            regionDisplaySelector: true
        }
    )

    region alterar-data-de-entrega-e-data-de-vencimento (
        name: Alterar Data de Entrega e Data de Vencimento
        type: staticContent
