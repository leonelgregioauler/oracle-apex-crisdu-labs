        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $(".valortotal").each(function(idx) {
                        
                      var numeropedido = document.getElementsByClassName( "numeropedido" )[idx].innerHTML;
                      var valortotal   = document.getElementsByClassName( "valortotal" )[idx].innerHTML;
                       
                      idx = idx + 1;
                      valortotal = valortotal.replace(".", "");
                      valortotal = valortotal.replace(",", ".");
                      valortotal = parseFloat(valortotal);
                        
                      if ( numeropedido == 1 && valortotal > 287.50 ) {
                        $(this).closest('td').addClass( "vermelho" );
                          
                      } else if ( numeropedido == 2 && valortotal > 402.50 ) {
                        $(this).closest('td').addClass( "vermelho" );
                          
                      } else if ( numeropedido == 3 && valortotal > 600 ) {
                        $(this).closest('td').addClass( "vermelho" );
                    
                      } 
                       
                        
                    });
                        
                    ```
            }
            execution {
                sequence: 10
            }
        )

