    dynamicAction filial-e-posto-avançado (
        name: Filial e Posto Avançado
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P360_TIPOFILIAL
        }
        clientSideCondition {
            type: item=value
            item: P360_TIPOFILIAL
            value: FP
        }

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P360_IDPOSTOAVANCADO
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction selecionar-data (
        name: Selecionar data
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P360_DATA
        }
        clientSideCondition {
            type: item!=value
            item: P360_DATA
            value: N
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P360_DATAINI
                    P360_DATAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P360_DATAINI
            }
            execution {
                sequence: 20
            }
        )

        action native-set-value (
            action: setValue
            affectedElements {
                selectionType: items
                items: [
                    P360_DATAINI
                    P360_DATAFIM
                ]
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P360_DATAINI
                    P360_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction setar-apenas-1-parcela-para-consultora (
        name: Setar apenas 1 parcela para consultora
        execution {
            sequence: 60
        }
        when {
            event: click
            selectionType: region
            region: @alterar-data-de-entrega-e-data-de-vencimento
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                not exists ( select 1
                             from classificacoespedidos 
                             where idpedido = :P360_IDPEDIDO
                             and idcaracteristicapedido = 28 );
                ```
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: items
                items: P360_QUANTIDADEPARCELAS_DISTR
            }
            execution {
                sequence: 20
            }
        )

        action native-set-value (
            action: setValue
            settings {
                value: 1
            }
            affectedElements {
                selectionType: items
                items: P360_QUANTIDADEPARCELAS_DISTR
            }
            execution {
                sequence: 10
            }
        )

    )

