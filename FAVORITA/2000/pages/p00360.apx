    region confirmar-cancelamento (
        name: Confirmar Cancelamento
        type: staticContent
        layout {
            sequence: 20
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-size480x320
            ]
        }
        advanced {
            htmlDomId: CANCELAMENTOANALISE
            regionDisplaySelector: true
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region legenda (
        name: Legenda
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                <table>                                                      
                <tbody>  
                    
                <tr>                                                         
                <td style="background-color:red; width: 30px;"></td>
                <td style="padding-left: 8px;">Valor acima do limite por quantidade de pedidos</td>      
                </tr>
                    
                <tr>    
                <td style="background-color:yellow; width: 30px;"></td>
                <td style="padding-left: 8px;">Mais que um pedido no período</td>    
                </tr>
                
                <tr>
                <td style="background-color:coral; width: 30px;"></td>
                <td style="padding-left: 8px;">Saldo vencido maior que zero</td>    
                </tr>
                    
                <tr>
                <td style="background-color:orange; width: 30px;"></td>
                <td style="padding-left: 8px;">Valor pago = Valor a pagar / Valor a pagar = 0</td>    
                </tr>                                                        
                    
                </table>      
                ```
        }
    )

    pageItem P360_ATENDENTE (
        type: selectList
        label {
            label: Atendente
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeusuario(u.idusuario) display_value
                     , u.idusuario return_value
                from usuarios u
                where exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.usuario = u.usuario 
                                 and ug.idgrupoatendimento = 4 )
                  and u.ativo = 'S'                 
                order by 1
                ```
            nullDisplayValue: - Sem Atendente -
        }
        layout {
            sequence: 100
            region: @abrir-tarefa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

