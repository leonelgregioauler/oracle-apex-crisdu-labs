            language: sql
            sqlExpression: v('REQUEST') = 'FILTRAR' and :P360_DATA = 'N'
        }
    )

    process alterar-datas-de-entrega-e-vencimento (
        name: Alterar Datas de Entrega e Vencimento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vnumbernull        number;
                  vdataentrega       date := to_date(:P360_DATAENTREGA,    'dd/mm/rrrr');
                  vtipoprorrogação   varchar2(1) := 'E'; -- Altera a data de entrega e a data de vencimento, 14 dias após
                  --
                begin
                  --       
                  pck_protocolosatendimentos_fav.prc_realizaprorrogacao( pidprotocoloatendimento  => vnumbernull,
                                                                         pdataprorrogacao         => vdataentrega,
                                                                         pidpedido                => :P360_IDPEDIDO,
                                                                         pidusuario               => :P0_IDUSUARIO,
                                                                         ptipoprorrogacao         => vtipoprorrogação,
                                                                         pqtdparcelas             => :P360_QUANTIDADEPARCELAS_DISTR);
                  --
                end;
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 1526199051818622742
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'ALTERARDATAS'
        }
    )

    process confirmar-abertura-de-tarefa (
        name: Confirmar Abertura de Tarefa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidhistorico               number;
                  vidpedido                  number           := :P360_IDPEDIDO;
                  vdata                      date             := sysdate;
                  vidusuario                 number           := :P0_IDUSUARIO;
                  vhistorico                 varchar2(4000)   := :P360_OBSERVACAOTAREFA;
                  vvarchar                   varchar2(1)      := null;
                  vmd5                       varchar2(50);
                begin
                  --
                  pck_tarefas_fav.prc_gerartarefasanalisecall ( :P360_IDPEDIDO
                                                              , :P360_ATENDENTE );
                  --                                            
                  pck_pedidos_fav.prc_historicospedidos( pidhistoricopedido => vidhistorico,
                                                         pidpedido          => vidpedido,
                                                         pdatahistorico     => vdata,
                                                         pidusuario         => vidusuario,
                                                         pdescricao         => vhistorico,
                                                         pimprimirnopedido  => vvarchar,
                                                         pliberaedicao      => vvarchar,
                                                         pmd5               => vmd5,
                                                         poperacao_dml      => 'I' );
                  --                                        
                end;                                            
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 1526198665464622741
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMAR_TAREFA
        }
    )

    process confirmar-cancelamento-da-analise (
        name: Confirmar Cancelamento da Analise
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidhistorico               number;
                  vidpedido                  number           := :P360_IDPEDIDO;
                  vdata                      date             := sysdate;
                  vidusuario                 number           := :P0_IDUSUARIO;
                  vhistorico                 varchar2(4000)   := :P360_OBSERVACAO;
                  vvarchar                   varchar2(1)      := null;
                  vmd5                       varchar2(50);
                begin
                  --
                  pck_pedidos_fav.prc_historicospedidos( pidhistoricopedido => vidhistorico,
                                                         pidpedido          => vidpedido,
                                                         pdatahistorico     => vdata,
                                                         pidusuario         => vidusuario,
                                                         pdescricao         => vhistorico,
                                                         pimprimirnopedido  => vvarchar,
                                                         pliberaedicao      => vvarchar,
                                                         pmd5               => vmd5,
                                                         poperacao_dml      => 'I' );
                  --                                         
                  pck_movimentarpedidos_fav.prc_cancelarpedidoviaanalise( pidpedido          => :P360_IDPEDIDO,
                                                                          pidusuario         => :P0_IDUSUARIO,
                                                                          pidjustificativa   => :P360_IDJUSTIFICATIVA );
                  --                                        
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Cancelamento realizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1526198243892622741
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMAR_CANCELAMENTO
        }
    )

    process reprocessar-itens-kits-sem-estoque (
        name: "Reprocessar itens / kits sem estoque "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  pck_pedidos_fav.prc_atlzitenskitsindisponiveis ( :P360_IDPEDIDO, :P0_IDUSUARIO );
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 1526197855315622741
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'REPROCESSARITENS'
        }
    )

    branch (
        name: Go To Page 360
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 360
                items: {
                    P360_IDPEDIDO: &P360_IDPEDIDO.
                    P360_TIPOFILIAL: &P360_TIPOFILIAL.
                    P360_IDFILIALROMANCE: &P360_IDFILIALROMANCE.
                    P360_IDFILIALFAVORITA: &P360_IDFILIALFAVORITA.
                    P360_IDPOSTOAVANCADO: &P360_IDPOSTOAVANCADO.
                    P360_DATA: &P360_DATA.
                    P360_DATAINI: &P360_DATAINI.
                    P360_DATAFIM: &P360_DATAFIM.
                    P360_ATIVA: &P360_ATIVA.
                    P360_PEDIDOFUNCIONARIO: &P360_PEDIDOFUNCIONARIO.
                    P360_PEDIDO: &P360_PEDIDO.
                }
            }
        }
    )

)

