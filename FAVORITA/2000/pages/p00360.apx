            ]
        }
        advanced {
            htmlDomId: DATAS
            regionDisplaySelector: true
        }
    )

    region análise-de-pedidos (
        name: Análise de Pedidos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idpedido
                     , idvendedora
                     , nomevendedora
                     , idpessoarep
                     , nomedistribuidor
                     , idfilialfavorita
                     , nomefilialorigem
                     , idfilialromance
                     , nomefilial
                     , idpostoavancado
                     , nomepostoavancado
                     , numeropedido
                     , valortotal
                     , ( select count(1)
                         from favorita.pedidos pp
                         where f.idvendedora = pp.idvendedora
                           and pp.tipopedido not in ('V')
                           and pp.idsituacaoentrega > 10000
                           and trunc(pp.dataentrega) between to_date(:P360_DATAINI,'dd/mm/rrrr') and to_date(:P360_DATAFIM,'dd/mm/rrrr')
                           and not exists( select 1
                                           from favorita.classificacoespedidos cp
                                           where cp.idpedido = pp.idpedido
                                            and cp.idcaracteristicapedido = 25)) contapedido 
                     , valorpagar
                     , valorpago
                     , dataemissao
                     , dataentrega
                     , '<a href="javascript:fnc_alterardatas('||idpedido||');"><img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil-alt.png" class="apex-edit-pencil-alt" border="0"></a>' alterardatas
                     --, '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':119:'||v('APP_SESSION')||'::NO::P119_IDPEDIDO:'||idpedido ,'SESSION')||''',''_blank''); ">'||saldovencido||'</a>' saldovencido
                     , saldovencido
                     , '' verpagamentos
                     , '' verhistoricos
                     , ativa
                     , case 
                         when indisponivel > 0 then
                           '<a href="javascript:apex.confirm(''Confirma a inclusão de itens indisponíveis avulsos ou de kits no pedido ?''
                            , { request:''REPROCESSARITENS''
                            , set:{''P360_IDPEDIDO'':'||idpedido||' } } );"><img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil-alt.png" class="apex-edit-pencil-alt" border="0"></a>' 
                         else
                           null
                       end indisponivel
                     , null aprovar
                     , '<a href="javascript:fnc_cancelarPedido('||idpedido||');"><img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil-alt.png" class="apex-edit-pencil-alt" border="0"></a>' cancelarpedido
                     , case 
                         when exists ( select 1
                                       from tarefas t
                                       where t.idpedido = f.idpedido ) then
                           'Tarefa criada'
                         else
                           '<a href="javascript:fnc_abrirTarefa('||idpedido||');"><img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil-alt.png" class="apex-edit-pencil-alt" border="0"></a>'       
                       end abrirtarefa
                     , usuario
                     , situacaopedidocorreio    
                     , cancelado
                     /*Forma entrega*/
                     , (select fg.descricao
                       from classificacoespedidos cf,
                            formasentregas fg
                       where cf.idcaracteristicapedido = 13
                       and cf.idvalorcaracteristica = fg.idformaentrega
                       and cf.idpedido = f.idpedido) as "Forma Entrega"
                     , edicaorevista
                     , tipopedido
                     , f.formapagamento
                     -- Maicon Aimi - 12/03/2025 - 9909548 (Criado nova coluna Saída)
                     , favorita.pck_util_fav.fnc_nomefilialfavorita(f.idfilialfavoritaorig) as "Saída"
                from vw_pedidosanalise_fav f
                where ( :P360_IDFILIALFAVORITA is null or f.idfilialfavorita = :P360_IDFILIALFAVORITA )
                  and ( ( :P360_TIPOFILIAL = 'FP' and (f.idfilialromance = :P360_IDFILIALROMANCE or :P360_IDFILIALROMANCE is null) and ( :P360_IDPOSTOAVANCADO is null or f.idpostoavancado = :P360_IDPOSTOAVANCADO ) ) 
                     or ( :P360_TIPOFILIAL = 'F'  and (:P360_IDFILIALROMANCE is null or f.idfilialromance = :P360_IDFILIALROMANCE) and f.idpostoavancado is null ))
                       
                  and ( (:P360_PEDIDO is null and :P360_DATA = 'T') or f.idpedido = :P360_PEDIDO )
                  and ( :P360_ATIVA = 'T' or f.ativa = :P360_ATIVA )
                  
                  and ( :P360_PEDIDOFUNCIONARIO = 'T' or f.pedidofuncionario = :P360_PEDIDOFUNCIONARIO )
                  
                  and ( :P360_DATA = 'N' or (:P360_DATA = 'T' and f.dataentrega between to_date(:P360_DATAINI||' 00:00:00','dd/mm/rrrr hh24:mi:ss') and to_date(:P360_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss') ) )
                  
                  /*Filtra a forma de entrega*/
                  and ((select cf.idvalorcaracteristica
                      from classificacoespedidos cf
                      where cf.idcaracteristicapedido = 13
                      and cf.idpedido = f.idpedido) = :P360_FORMA_ENTREGA or :P360_FORMA_ENTREGA is null)
                    
                  and ( :P360_CANCELADO = 1 
                        or (:P360_CANCELADO = 2 and exists ( select 1
                                                             from favorita.classificacoespedidos cp
                                                             where cp.idpedido = f.idpedido
                                                               and cp.idcaracteristicapedido = 25) )
                        or  (:P360_CANCELADO = 3 and not exists ( select 1
                                                                  from favorita.classificacoespedidos cp
                                                                  where cp.idpedido = f.idpedido
                                                                    and cp.idcaracteristicapedido = 25) ))
                  
                ```
        }
