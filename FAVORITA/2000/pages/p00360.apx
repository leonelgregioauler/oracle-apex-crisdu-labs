    pageItem P360_IDFILIALROMANCE (
        type: selectList
        label {
            label: Filial Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome exibicao
                     , f.idfilial retorno
                from roman.vw_filiais f
                where f.tipofilial in ('D','C')
                  and f.ativo = 'S'
                union
                select f.nome exibicao
                     , f.idfilial retorno
                from roman.vw_filiais f
                where f.idfilial = 200
                  and f.ativo = 'S'
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
