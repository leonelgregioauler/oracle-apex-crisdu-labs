    validation data-final-obrigatória (
        name: Data Final Obrigatória
        execution {
            sequence: 20
        }
        validation {
            language: sql
            sqlExpression: :P360_DATAFIM is not null
        }
        error {
            errorMessage: Data final deve ser informada.
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'FILTRAR' and :P360_DATA = 'T'
        }
    )

    validation data-inicial-obrigatória (
        name: Data Inicial obrigatória
        execution {
            sequence: 10
        }
        validation {
            language: sql
            sqlExpression: :P360_DATAINI is not null
        }
        error {
            errorMessage: Data inicial deve ser informada.
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'FILTRAR' and :P360_DATA = 'T'
        }
    )

    validation pedido-obrigatório (
        name: Pedido Obrigatório
        execution {
            sequence: 30
        }
        validation {
            language: sql
            sqlExpression: :P360_PEDIDO is not null
        }
        error {
            errorMessage: Pedido deve ser informado
        }
        serverSideCondition {
