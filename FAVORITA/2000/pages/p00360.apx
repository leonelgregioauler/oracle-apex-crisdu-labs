page 360 (
    name: Análise de Pedidos
    title: Análise de Pedidos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG_23"';
            
            function fnc_cancelarPedido(pidpedido) {
              document.getElementById("P360_IDPEDIDO").value = pidpedido;
              openModal('CANCELAMENTOANALISE');
            }
            
            
            function fnc_abrirTarefa(pidpedido) {
              document.getElementById("P360_IDPEDIDO").value = pidpedido;
              openModal('TAREFA');
            }
            
            function fnc_alterardatas(pidpedido) {
              document.getElementById("P360_IDPEDIDO").value = pidpedido;
              document.getElementById("P360_DATAENTREGA").value = null;
              openModal('DATAS');
            }
            ```
    }
    htmlHeader {
