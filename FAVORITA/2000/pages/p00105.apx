page 105 (
    name: Relatório de Situações Promissórias
    title: Relatório de Situações Promissórias
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region relatório-de-situações-promissórias (
        name: Relatório de Situações Promissórias
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idsituacaopromis
                     , descricao
                     , descricaotraduzida
                     , idtexto
                from vw_situacoespromissorias_fav
                where ididioma = :P0_IDIDIOMA;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        messages {
            whenNoDataFound: Não encontrou informações.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 14647657282117715
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDSITUACAOPROMIS
                layout {
                    width: 66
                    sequence: 1
                }
            )

            displayColumn (
                column: @DESCRICAO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @DESCRICAOTRADUZIDA
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @IDTEXTO
                layout {
                    sequence: 5
                }
            )

        )

        column DESCRICAO (
            type: textarea
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 30
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: DESCRICAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column DESCRICAOTRADUZIDA (
            type: textarea
            heading {
                heading: Descrição Traduzida
                alignment: center
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: DESCRICAOTRADUZIDA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column IDSITUACAOPROMIS (
            type: link
            heading {
                heading: Editar
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            link {
                target: {
                    page: 106
                    items: {
                        P106_IDSITUACAOPROMIS: &IDSITUACAOPROMIS.
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                databaseColumn: IDSITUACAOPROMIS
                dataType: number
            }
        )

        column IDTEXTO (
            type: link
            heading {
                heading: Tradução
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            link {
                target: {
                    page: 100
                    items: {
                        P100_IDTEXTOTRADUZIDO: &IDTEXTO.
                    }
                    action: resetPagination
                }
                linkText: <b>Visualizar / Atualizar texto traduzido</b>
                linkAttributes: class="t-Button t-Button--sucess"
            }
            source {
                databaseColumn: IDTEXTO
                dataType: number
            }
        )

    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 106
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

