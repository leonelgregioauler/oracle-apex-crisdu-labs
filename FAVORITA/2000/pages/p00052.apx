    pageItem P52_IDPRODUTODETALHADO (
        type: plugin/select
        label {
            label: Skus
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeprodutodetalhado(idprodutodetalhado, :P0_IDIDIOMA) as d
                     , idprodutodetalhado as r
                   from produtosdetalhados
                where idproduto = :P52_IDPRODUTO
                 order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Todos -
        }
        cascadingLov {
            parentItems: P52_IDPRODUTO
            itemsToSubmit: P52_IDPRODUTODETALHADO
        }
        layout {
            sequence: 50
            region: @opções
