    dynamicAction recarrega-relatório (
        name: Recarrega relatório
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P52_IDPRODUTO
                P52_IDEDICAOREVISTA
                P52_IDFILIALROMANCE
            ]
