    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG_25"';
            
            function fnc_gerarpreco() 
              { 
                  SKU = document.getElementById('P52_REFENCIA').value;
                  if (SKU){
                      vurl = 'https://minhafavorita.com.br/ws/executar/virtual_age/gerar_arquivos?ref='+SKU;
                  }else{
                      vurl = 'https://minhafavorita.com.br/ws/executar/virtual_age/gerar_arquivos';
                  }
                  
                  pjan = window.open(vurl,'page','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1280,height=1024,left=20,top=10','_blank'); void(0);
                  pjan.focus();
              }
            
            function fnc_gerarpreco_adl() 
              { 
                  SKU = document.getElementById('P52_REFENCIA').value;
                  if (SKU){
                      vurl = 'https://minhafavorita.com.br/ws/executar/virtual_age/gerar_arquivos_adl?ref='+SKU;
                  }else{
                      vurl = 'https://minhafavorita.com.br/ws/executar/virtual_age/gerar_arquivos_adl';
                  }
                  
                  pjan = window.open(vurl,'page','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1280,height=1024,left=20,top=10','_blank'); void(0);
                  pjan.focus();
              }
            ```
    }
