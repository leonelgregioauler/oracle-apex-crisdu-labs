    pageItem P52_IDFORNECEDOR (
        type: plugin/select
        label {
            label: Fornecedor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct cp.nomepessoa select_value
                     , cd.idfornecedor return_value
                from catal.fornecedores   cd
                   , catal.pessoas        cp
                   , fornecedoresprodutos fr
                where cd.idpessoa     = cp.idpessoa
                  and cd.idfornecedor = fr.idfornecedor 
                order by 1
                ```
        }
        layout {
            sequence: 70
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

