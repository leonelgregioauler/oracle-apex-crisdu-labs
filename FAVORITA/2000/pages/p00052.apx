    region preços-produtos (
        name: Preços Produtos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idprecoproduto
                     , p.idedicaorevista
                     , pck_util_fav.fnc_edicaorevista(idedicaorevista) edicaorevista
                     , p.idprodutodetalhado
                     , pck_util_fav.fnc_nomeprodutodetalhado(p.idprodutodetalhado,:P0_IDIDIOMA) nomeprodutodetalhado
                     , p.idfilialromance
                     , roman.pck_romance.fnc_nomefilial(idfilialromance) filialromance
                     , p.valorcusto
                     , p.valorvenda
                     , ( select idproduto
                         from produtosdetalhados pp
                         where pp.idprodutodetalhado = p.idprodutodetalhado ) idproduto
                     , p.perccomissaogerente
                     , p.perccomissaodistribuidor
                     , p.perccomissaoconsultora
                     , p.valorcomissaoatendente
                     , p.created_time
                     , p.updated_time
                from precosprodutos p
                where (:P52_IDPRODUTO is null or idprodutodetalhado in ( select pd.idprodutodetalhado 
                                                                         from produtosdetalhados pd 
                                                                         where pd.idproduto = :P52_IDPRODUTO ) )
                  AND (:P52_IDFILIALROMANCE IS NULL or IDFILIALROMANCE = :P52_IDFILIALROMANCE)
                  and ( p.idprodutodetalhado = :P52_IDPRODUTODETALHADO or :P52_IDPRODUTODETALHADO is null)
                  and idedicaorevista = :P52_IDEDICAOREVISTA
                  AND (:P52_IDFORNECEDOR is null or exists ( select 1
                                                             from favorita.produtosdetalhados pp
                                                             where pp.idprodutodetalhado = p.idprodutodetalhado
                                                               and exists ( select 1
                                                                            from favorita.produtos ppp
                                                                               , favorita.fornecedoresprodutos fp 
                                                                            where ppp.idproduto = fp.idproduto
                                                                              and ppp.idproduto = pp.idproduto
                                                                              and fp.idproduto = pp.idproduto
                                                                              and fp.idfornecedor = :P52_IDFORNECEDOR)))
                ```
            pageItemsToSubmit: [
                P52_IDPRODUTO
                P52_IDEDICAOREVISTA
                P52_IDFILIALROMANCE
            ]
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
            newColumn: false
        }
