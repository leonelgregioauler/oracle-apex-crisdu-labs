        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-money
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 298
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                (exists ( select 1
                            from roman.usuariosgruposatendimento ug
                           where ug.idgrupoatendimento = 0
                             and ug.usuario            = v('APP_USER')))
                or ( favorita.pck_util_fav.fnc_verificaacesso(345, pidusuario => favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))) = 'S')
                ```
        }
    )

