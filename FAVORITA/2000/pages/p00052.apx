            sequence: 10
        }
        validation {
            language: sql
            sqlExpression: :P52_IDPRODUTO is not null
        }
        error {
            errorMessage: Deve ser informado o produto para fazer a sincronização dos preços com as edições de lojas
        }
        serverSideCondition {
            type: expression
