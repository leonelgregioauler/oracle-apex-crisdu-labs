    pageItem P623_FILIAL_FAVORITA (
        type: selectList
        label {
            label: Filial Favorita
            alignment: left
        }
        lov {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                 
                select f.nomefilialfavorita as display_value,
                       f.idfilialfavorita   as return_value
                  from favorita.filiaisfavorita f
                 where f.ativo = 'S'
                   and f.tipofilial = 'L'
                 order by f.nomefilialfavorita;
                ```
            displayExtraValues: false
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

