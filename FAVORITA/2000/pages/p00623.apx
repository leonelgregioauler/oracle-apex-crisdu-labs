    region span-style-color-white-taxa-delivery-detalhado-span (
        name: <span style="color: white;">Taxa Delivery Detalhado</span>
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpedido,
                       t.nome Tabela_delivery,
                       round(p.valorapagar,2) valorapagar,
                       round(p.taxadelivery,2) taxadelivery,
                       favorita.pck_util_fav.fnc_nomefilialfavorita(p.idfilialfavorita) Filial_favorita
                  from favorita.pedidos p,
                       favorita.tabelaprecosdelivery t
                 where t.idtabelaprecosdelivery = p.idtabeladelivery
                   and p.dataemissao >= to_date(:P623_DATA_INICIAL||' 00:00:00','DD/MM/RRRR HH24:MI:SS')
                   and p.dataemissao <= to_date(:P623_DATA_FINAL||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                   and (:P623_FILIAL_FAVORITA is null or p.idfilialfavorita = :P623_FILIAL_FAVORITA)
                   and p.taxadelivery is not null
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P623_TIPO_RELATORIO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 2119553603930297711
        }

        column FILIAL_FAVORITA (
            type: plainText
            heading {
                heading: Filial Favorita
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: J
            }
        )

