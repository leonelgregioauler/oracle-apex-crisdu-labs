    region span-style-color-white-taxa-delivery-resumido-span (
        name: <span style="color: white;">Taxa Delivery Resumido</span>
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.nome as Tabela_delivery,
                       count(1) as Quantidade,
                       round(sum(p.valorapagar),2) as valor_a_pagar,
                       round(sum(nvl(p.taxadelivery,0)),2) as taxa_delivery,
                       favorita.pck_util_fav.fnc_nomefilialfavorita(p.idfilialfavorita) as filial_favorita
                  from pedidos p,
                       favorita.tabelaprecosdelivery t
                 where p.dataemissao >= to_date(:P623_DATA_INICIAL||' 00:00:00','DD/MM/RRRR HH24:MI:SS')
                   and p.dataemissao <= to_date(:P623_DATA_FINAL||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                   and (:P623_FILIAL_FAVORITA is null or p.idfilialfavorita = :P623_FILIAL_FAVORITA)
                   and p.taxadelivery is not null
                   and p.idtabeladelivery = t.idtabelaprecosdelivery
                 group by t.nome,favorita.pck_util_fav.fnc_nomefilialfavorita(p.idfilialfavorita);
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
