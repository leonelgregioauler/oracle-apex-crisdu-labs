page 519 (
    name: Promoções Datas Parcelamento
    title: Promoções Datas Parcelamento
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region promoções-datas-parcelamento (
        name: Promoções Datas Parcelamento
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpromocaodatasparcelamento
                     , p.nome
                     , ( select listagg(pck_util_fav.fnc_nomefilialromance(f.idfilial),',') within group ( order by 1)
                         from catal.filiais f
                         where f.idfilial in ( select column_value
                                               from table (pck_util_fav.fnc_array_to_table(p.idfiliaisromance)))) idfiliaisromance
                     , ( select listagg(f.nomefilialfavorita,',') within group ( order by 1)
                         from favorita.filiaisfavorita f
                         where f.idfilialfavorita in ( select column_value
                                                       from table (pck_util_fav.fnc_array_to_table(p.idfiliaisfavorita)))) idfiliaisfavorita
                     , p.datainicial
                     , p.datafinal
                     , p.valorinicial
                     , p.valorfinal
                     , ( select fp.descricao
                         from favorita.formaspagamentos fp
                         where fp.idformapagamento =  p.idformapagamento) idformapagamento
                     , p.prazovencimento
                     , p.numeroparcelas
                     , ( select pp.nome
                         from catal.paises pp
                         where pp.idpais = p.idpais ) Pais
                from promocoesdatasparcelamento p
                where ( :P519_DATAS = 'N'
                      or (:P519_DATAS = 'I' and p.datainicial between :P519_DATAINICIO and :P519_DATAFIM )
                      or (:P519_DATAS = 'F' and p.datafinal between :P519_DATAINICIO and :P519_DATAFIM )
                      or (:P519_DATAS = 'V' and sysdate between p.datainicial and p.datafinal ))
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }

        column DATAFINAL (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Data Final
                alignment: center
            }
            layout {
                sequence: 6
            }
        )

        column DATAINICIAL (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Data Inicial
                alignment: center
            }
            layout {
                sequence: 5
            }
        )

        column IDFILIAISFAVORITA (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Filiais Favorita
                alignment: center
            }
            layout {
                sequence: 4
            }
        )

        column IDFILIAISROMANCE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Filiais Romance
                alignment: center
            }
            layout {
                sequence: 3
            }
        )

        column IDFORMAPAGAMENTO (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Forma Pagamento
                alignment: center
            }
            layout {
                sequence: 9
            }
        )

        column IDPROMOCAODATASPARCELAMENTO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: Alterar
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            link {
                target: {
                    page: 520
                    items: {
                        P520_IDPROMOCAODATASPARCELAM: #IDPROMOCAODATASPARCELAMENTO#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
        )

        column NOME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Nome da promoção
                alignment: center
            }
            layout {
                sequence: 2
            }
        )

        column NUMEROPARCELAS (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: Numero Parcelas
                alignment: center
            }
            layout {
                sequence: 11
                columnAlignment: center
            }
        )

        column PAIS (
            reportColumnQueryId: 12
            derivedColumn: N
            heading {
                heading: Pais
                alignment: center
            }
            layout {
                sequence: 12
            }
        )

        column PRAZOVENCIMENTO (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Prazo Vencimento
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
        )

        column VALORFINAL (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Valor Final
                alignment: center
            }
            layout {
                sequence: 8
                columnAlignment: center
            }
        )

        column VALORINICIAL (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Valor Inicial
                alignment: center
            }
            layout {
                sequence: 7
                columnAlignment: center
            }
        )

    )

    pageItem P519_DATAFIM (
        type: datePickerJquery
        label {
            label: Data Fim
            alignment: left
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P519_DATAINICIO (
        type: datePickerJquery
        label {
            label: Data Inicio
            alignment: left
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P519_DATAS (
        type: radioGroup
        label {
            label: Datas
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Valido em;V,Data Inicial;I,Não Filtrar;N,Data Final;F
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconRight
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconRight
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 520
                items: {
                    P520_DATAFINAL:
                    P520_DATAINICIAL:
                    P520_IDFILIAISFAVORITA:
                    P520_IDFILIAISROMANCE:
                    P520_IDFORMAPAGAMENTO:
                    P520_IDPAIS:
                    P520_IDPROMOCAODATASPARCELAM:
                    P520_MENSAGEM:
                    P520_NOME:
                    P520_NUMEROPARCELAS:
                    P520_PRAZOVENCIMENTO:
                    P520_VALORFINAL:
                    P520_VALORINICIAL:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction esconder-datas (
        name: Esconder Datas
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P519_DATAS
        }
        clientSideCondition {
            type: item=value
            item: P519_DATAS
            value: N
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P519_DATAINICIO
                    P519_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction mostrar-datas-f (
        name: Mostrar Datas F
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P519_DATAS
        }
        clientSideCondition {
            type: item=value
            item: P519_DATAS
            value: F
        }

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P519_DATAINICIO
                    P519_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction mostrar-datas-i (
        name: Mostrar Datas I
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P519_DATAS
        }
        clientSideCondition {
            type: item=value
            item: P519_DATAS
            value: I
        }

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P519_DATAINICIO
                    P519_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction mostrar-datas-v (
        name: Mostrar Datas V
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P519_DATAS
        }
        clientSideCondition {
            type: item=value
            item: P519_DATAS
            value: V
        }

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P519_DATAINICIO
                    P519_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

)

