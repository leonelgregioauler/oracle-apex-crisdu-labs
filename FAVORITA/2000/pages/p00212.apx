page 212 (
    name: Condições Pagamentos
    title: Condições Pagamentos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 45%
        height: 60%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region condições-pagamentos (
        name: Condições Pagamentos
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P212_DESCONTO (
        type: numberField
        label {
            label: % Desconto
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 60
            region: @condições-pagamentos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G990D00
            width: 28
        }
        advanced {
            customAttributes: onkeyup="formataMoeda(this);"
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P212_IDCONDICAOPAGAMENTO (
        type: hidden
        layout {
            sequence: 10
            region: @condições-pagamentos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P212_IDFILIALROMANCE (
        type: selectList
        label {
            label: Distribuidora Parceira
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-filiaisromance
            nullDisplayValue: " - Selecione a Distribuidora -"
        }
        layout {
            sequence: 70
            region: @condições-pagamentos
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P212_IDFORMAPAGAMENTO (
        type: selectList
        label {
            label: Forma de Pagamento
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-formaspagamentos
            nullDisplayValue: - Selecione a Forma de Pagamento -
        }
        layout {
            sequence: 30
            region: @condições-pagamentos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P212_MD5 (
        type: hidden
        layout {
            sequence: 90
            region: @condições-pagamentos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P212_OPERACAO_DML (
        type: hidden
        layout {
            sequence: 100
            region: @condições-pagamentos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P212_QTDPARCELA (
        type: numberField
        label {
            label: Quantidade de Parcelas
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 40
            region: @condições-pagamentos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 28
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P212_VARIACAODIAS (
        type: numberField
        label {
            label: Variação de Dias
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 50
            region: @condições-pagamentos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 28
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 50
            region: @condições-pagamentos
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P212_IDCONDICAOPAGAMENTO
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 40
            region: @condições-pagamentos
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P212_IDCONDICAOPAGAMENTO
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 30
            region: @condições-pagamentos
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 211
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 20
            region: @condições-pagamentos
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P212_IDCONDICAOPAGAMENTO
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @condições-pagamentos
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P212_IDCONDICAOPAGAMENTO
        }
    )

    validation desconto-maior-ou-igual-a-0-e-menor-ou-igual-a (
        name: DESCONTO maior ou igual a 0 e menor ou igual a 100
        execution {
            sequence: 70
        }
        validation {
            plsqlExpression: :P212_DESCONTO between 0 and 100
        }
        error {
            errorMessage: Desconto deve ser maior ou igual a zero (0) e no máximo cem (100)
        }
    )

    validation desconto-obrigatório (
        name: DESCONTO obrigatório
        execution {
            sequence: 60
        }
        validation {
            type: itemIsNotNull
            item: P212_DESCONTO
        }
        error {
            errorMessage: Desconto deve ser informado.
        }
    )

    validation idfilialromance-obrigatório (
        name: IDFILIALROMANCE obrigatório
        execution {
            sequence: 120
        }
        validation {
            type: itemIsNotNull
            item: P212_IDFILIALROMANCE
        }
        error {
            errorMessage: Distribuidora Parceira deve ser informada.
        }
    )

    validation idformapagamento-obrigatório (
        name: IDFORMAPAGAMENTO obrigatório
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P212_IDFORMAPAGAMENTO
        }
        error {
            errorMessage: Forma de Pagamento deve ser informada.
        }
    )

    validation qtdparcela-inteiro (
        name: QTDPARCELA inteiro
        execution {
            sequence: 80
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  verro varchar2(1000);
                begin
                  if instr(:P212_QTDPARCELA, ',') > 0 or
                     instr(:P212_QTDPARCELA,'.') > 0 then
                    --
                    return 'Quantidade de parcelas deve ser um número inteiro';
                    --
                  else
                    null;
                  end if;
                end;
                ```
        }
        error {
            associatedItem: @P212_QTDPARCELA
        }
    )

    validation qtdparcela-maior-que (
        name: QTDPARCELA  maior que 0
        execution {
            sequence: 90
        }
        validation {
            plsqlExpression: :P212_QTDPARCELA > 0
        }
        error {
            errorMessage: Quantidade de Parcelas deve ser maior que zero (0)
            associatedItem: @P212_QTDPARCELA
        }
        serverSideCondition {
            type: expression
            plsqlExpression: instr(:P212_QTDPARCELA, '.') = 0
        }
    )

    validation qtdparcela-obrigatório (
        name: QTDPARCELA obrigatório
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P212_QTDPARCELA
        }
        error {
            errorMessage: Quantidade de Parcelas deve ser informada.
        }
    )

    validation variacaodias-inteiro (
        name: VARIACAODIAS inteiro
        execution {
            sequence: 100
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  verro varchar2(1000);
                begin
                  if instr(:P212_VARIACAODIAS, ',') > 0 or
                     instr(:P212_VARIACAODIAS,'.') > 0 then
                    --
                    return 'Variação de dias deve ser um número inteiro';
                    --
                  else
                    null;
                  end if;
                end;
                ```
        }
        error {
            associatedItem: @P212_VARIACAODIAS
        }
    )

    validation variacaodias-maior-que-zero (
        name: VARIACAODIAS maior que zero
        execution {
            sequence: 110
        }
        validation {
            plsqlExpression: :P212_VARIACAODIAS > 0
        }
        error {
            errorMessage: Variação de dias deve ser maior que zero (0)
            associatedItem: @P212_VARIACAODIAS
        }
        serverSideCondition {
            type: expression
            plsqlExpression: instr(:P212_VARIACAODIAS, '.') = 0
        }
    )

    validation variacaodias-obrigatório (
        name: VARIACAODIAS obrigatório
        execution {
            sequence: 40
        }
        validation {
            type: itemIsNotNull
            item: P212_VARIACAODIAS
        }
        error {
            errorMessage: Variação Dias deve ser informado.
        }
    )

    process consulta-condições-pagamentos (
        name: Consulta Condições Pagamentos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                begin
                  --
                  #OWNER#.PCK_COMERCIAL_FAV.PRC_CONDICOESPAGAMENTOS (
                    PIDCONDICAOPAGAMENTO  => :P212_IDCONDICAOPAGAMENTO,
                    PIDFORMAPAGAMENTO     => :P212_IDFORMAPAGAMENTO,
                    PQTDPARCELA           => :P212_QTDPARCELA,
                    PVARIACAODIAS         => :P212_VARIACAODIAS, 
                    PDESCONTO             => :P212_DESCONTO,
                    PIDFILIALROMANCE      => :P212_IDFILIALROMANCE,
                    PMD5                  => :P212_MD5,
                    POPERACAO_DML         => 'S');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 477534886093034295
        }
    )

    process limpar-campos-ao-sair (
        name: Limpar Campos ao Sair
        type: clearSessionState
        execution {
            sequence: 10
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 477535225781034295
        }
    )

    process limpar-campos-para-adicionar (
        name: Limpar Campos para Adicionar
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 477534451142034294
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    process operação-dml-em-condições-pagamentos (
        name: Operação DML em Condições Pagamentos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                  --
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  #OWNER#.PCK_COMERCIAL_FAV.PRC_CONDICOESPAGAMENTOS (
                    PIDCONDICAOPAGAMENTO  => :P212_IDCONDICAOPAGAMENTO,
                    PIDFORMAPAGAMENTO     => :P212_IDFORMAPAGAMENTO,
                    PQTDPARCELA           => :P212_QTDPARCELA,
                    PVARIACAODIAS         => :P212_VARIACAODIAS, 
                    PDESCONTO             => :P212_DESCONTO,
                    PIDFILIALROMANCE      => :P212_IDFILIALROMANCE,
                    PMD5                  => :P212_MD5,
                    POPERACAO_DML         => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 477535683771034295
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 212
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

)

