page 369 (
    name: Rastreamento de Pedidos
    title: Rastreamento de Pedidos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region rastrear-pedidos (
        name: Rastrear Pedidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pf.idpedido 
                     , pf.edicaorevista
                     , pf.filialromance
                     , pf.representante
                     , pf.vendedora
                     , pf.situacaoentregainterno situacaoentrega
                     , pf.valortotal
                     , pf.valorapagar
                     , pf.dataemissao
                     , pf.datavencimento
                     , count( distinct it.iditempedido ) qtd
                from vw_pedidos_fav pf
                   , itenspedidos it
                where pf.ididioma = :P0_IDIDIOMA
                  and it.idpedido = pf.idpedido
                  and pf.idfilialromance = :P369_IDFILIALROMANCE
                  and :P369_LIBERADO = 'S'
                  and ( :P369_IDSITUACAOENTREGA is null or pf.idsituacaoentrega = :P369_IDSITUACAOENTREGA )
                  and not exists ( select 1
                                   from classificacoespedidos cp
                                   where cp.idcaracteristicapedido = 25 
                                     and cp.idpedido               = pf.idpedido )
                  and it.idprodutodetalhado in ( select ft.idprodutodetalhado
                                                 from filtrosprodutos ft
                                                 where ft.idusuario = :P0_IDUSUARIO
                                                   and ft.pagina    = 369 )
                  having count(1) = ( select count(1)
                                      from filtrosprodutos ft
                                      where ft.idusuario = :P0_IDUSUARIO
                                        and ft.pagina    = 369 )
                group by pf.idpedido 
                       , pf.edicaorevista
                       , pf.filialromance
                       , pf.representante
                       , pf.vendedora
                       , pf.situacaoentregainterno 
                       , pf.valortotal
                       , pf.valorapagar
                       , pf.dataemissao
                       , pf.datavencimento
                order by 1 desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum pedido encontrado, verifique os filtros.
        }
        advanced {
            savedReportMappingIdentifier: 1514551808542093237
        }

        column DATAEMISSAO (
            type: plainText
            heading {
                heading: Data de Emissão
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: I
            }
        )

        column DATAVENCIMENTO (
            type: plainText
            heading {
                heading: Vencimento
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: J
            }
        )

        column EDICAOREVISTA (
            type: plainText
            heading {
                heading: Edição de Revista
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column FILIALROMANCE (
            type: plainText
            heading {
                heading: Empresa Romance
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column IDPEDIDO (
            type: link
            heading {
                heading: Nr Pedido
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 68
                    items: {
                        P68_IDPEDIDO: #IDPEDIDO#
                    }
                    action: resetPagination
                }
                linkText: #IDPEDIDO#
                linkAttributes: target="_blank"
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column QTD (
            type: plainText
            heading {
                heading: Qtd
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: K
            }
        )

        column REPRESENTANTE (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column SITUACAOENTREGA (
            type: plainText
            heading {
                heading: Sit. de Entrega
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column VALORAPAGAR (
            type: plainText
            heading {
                heading: Valor a Pagar
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column VALORTOTAL (
            type: plainText
            heading {
                heading: Valor Total
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column VENDEDORA (
            type: plainText
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 15146344 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAEMISSAO (
                sequence: 8
            )

            displayColumn DATAVENCIMENTO (
                sequence: 9
            )

            displayColumn EDICAOREVISTA (
                sequence: 2
            )

            displayColumn IDPEDIDO (
                sequence: 1
            )

            displayColumn QTD (
                sequence: 10
            )

            displayColumn REPRESENTANTE (
                sequence: 3
            )

            displayColumn SITUACAOENTREGA (
                sequence: 5
            )

            displayColumn VALORAPAGAR (
                sequence: 7
            )

            displayColumn VALORTOTAL (
                sequence: 6
            )

            displayColumn VENDEDORA (
                sequence: 4
            )

        )

    )

    pageItem P369_IDFILIALROMANCE (
        type: selectList
        label {
            label: Empresa Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idfilial
                from roman.vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                order by 1
                ```
            nullDisplayValue: - Selecione a Empresa -
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P369_IDSITUACAOENTREGA (
        type: selectList
        label {
            label: Situação Entrega
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.descricaosistema
                     , s.idsituacaoentrega
                from favorita.situacoesentrega s
                where s.idsituacaoentrega not in ( -1 , 50 )
                order by 2 
                ```
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P369_LIBERADO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @rastrear-pedidos
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar-produtos (
        buttonName: FILTRAR_PRODUTOS
        label: Filtrar Produtos
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 172
                items: {
                    P172_PAGINA: 369
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button rastrear (
        buttonName: RASTREAR
        label: Rastrear
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction bloqueia-filtro (
        name: Bloqueia Filtro
        execution {
            sequence: 10
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: itemIsNull
            item: P369_LIBERADO
        }

        action native-set-value (
            action: setValue
            settings {
                value: N
            }
            affectedElements {
                selectionType: items
                items: P369_LIBERADO
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: Go To Page 369
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 369
                items: {
                    P369_IDFILIALROMANCE: &P369_IDFILIALROMANCE.
                    P369_LIBERADO: S
                    P369_IDSITUACAOENTREGA: &P369_IDSITUACAOENTREGA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @rastrear
        }
    )

)

