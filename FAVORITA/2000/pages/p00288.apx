page 288 (
    name: Cadastro Datas Remessas Pedidos
    title: Cadastro Datas Remessas Pedidos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-datas-remessas-pedidos (
        name: Cadastro Datas Remessas Pedidos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select iddataremessapedido,
                       datainiciopedido,
                       datalimitepedido,
                       dataretorno,
                       observacao
                  from datasremessaspedidos
                  where ( :P288_TIPODATA = 'N' )
                     or ( :P288_TIPODATA = 'L' and trunc(datalimitepedido) between to_date(:P288_DATAINICIO,'dd/mm/rrrr') and to_date(:P288_DATAFIM,'dd/mm/rrrr') )
                     or ( :P288_TIPODATA = 'R' and trunc(dataretorno)      between to_date(:P288_DATAINICIO,'dd/mm/rrrr') and to_date(:P288_DATAFIM,'dd/mm/rrrr') )
                ```
            pageItemsToSubmit: P288_TIPODATA
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 3539739255647419178
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @DATAINICIOPEDIDO
                layout {
                    width: 200
                    sequence: 2
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDDATAREMESSAPEDIDO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @DATALIMITEPEDIDO
                layout {
                    width: 200
                    sequence: 3
                }
            )

            displayColumn (
                column: @DATARETORNO
                layout {
                    width: 200
                    sequence: 4
                }
            )

            displayColumn (
                column: @OBSERVACAO
                layout {
                    width: 400
                    sequence: 5
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column DATAINICIOPEDIDO (
            type: datePickerJquery
            heading {
                heading: Data Início para Pedidos
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                databaseColumn: DATAINICIOPEDIDO
                dataType: date
            }
        )

        column DATALIMITEPEDIDO (
            type: datePickerJquery
            heading {
                heading: Data Limite para Pedidos
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                databaseColumn: DATALIMITEPEDIDO
                dataType: date
            }
        )

        column DATARETORNO (
            type: datePickerJquery
            heading {
                heading: Data Retorno do Distribuidor
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                databaseColumn: DATARETORNO
                dataType: date
            }
        )

        column IDDATAREMESSAPEDIDO (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDDATAREMESSAPEDIDO
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: seq_iddataremessapedido
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column OBSERVACAO (
            type: textarea
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: OBSERVACAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

    )

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P288_DATAFIM (
        type: datePickerJquery
        label {
            label: Data Fim
            alignment: left
        }
        layout {
            sequence: 30
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P288_DATAINICIO (
        type: datePickerJquery
        label {
            label: Data Inicial
            alignment: left
        }
        layout {
            sequence: 20
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P288_TIPODATA (
        type: radioGroup
        label {
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Não Filtrar;N,- Limite Pedidos;L,- Retorno;R
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    button filtro (
        buttonName: FILTRO
        label: Filtrar
        layout {
            sequence: 40
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-filter
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 50
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-reply
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 287
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process save-interactive-grid-data (
        name: " - Save Interactive Grid Data"
        type: interactiveGridAutoRowProcessing
        editableRegion: @cadastro-datas-remessas-pedidos
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1375247570150539572
        }
    )

)

