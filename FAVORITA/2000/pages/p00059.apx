page 59 (
    name: Relatório de Permissões Tipos Tarefas
    title: Permissões Tipos Tarefas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region permissões-tipos-tarefas (
        name: Permissões Tipos Tarefas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idpermissaotipotarefa
                     , idusuario
                     , nomepessoa
                     , idtipotarefa
                     , tipotarefa
                     , buscartarefa
                     , incluirtarefa
                from vw_permissoestipostarefas_fav
                where ididioma     = :P0_IDIDIOMA 
                  and (:P59_TIPOSTAREFAS is null or idtipotarefa = :P59_TIPOSTAREFAS)
                  and (:P59_IDUSUARIO is null or idusuario = :P59_IDUSUARIO)
                ```
            pageItemsToSubmit: [
                P59_TIPOSTAREFAS
                P59_IDUSUARIO
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 13163882462082939
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDPERMISSAOTIPOTAREFA
                layout {
                    width: 53
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDUSUARIO
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDTIPOTAREFA
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @BUSCARTAREFA
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @INCLUIRTAREFA
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @NOMEPESSOA
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @TIPOTAREFA
                layout {
                    show: false
                    sequence: 4
                }
            )

            sort (
                column: @NOMEPESSOA
                sort {
                    nulls: last
                    sequence: 1
                }
            )

            controlBreak (
                column: @TIPOTAREFA
                layout {
                    sequence: 1
                }
            )

        )

        column BUSCARTAREFA (
            type: selectList
            heading {
                heading: Buscar Tarefa
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @lov-simnao
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: BUSCARTAREFA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDPERMISSAOTIPOTAREFA (
            type: link
            heading {
                heading: Editar
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 60
                    items: {
                        P60_IDPERMISSAOTIPOTAREFA: &IDPERMISSAOTIPOTAREFA.
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                databaseColumn: IDPERMISSAOTIPOTAREFA
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column IDTIPOTAREFA (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IDTIPOTAREFA
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDUSUARIO (
            type: hidden
            layout {
                sequence: 20
            }
            source {
                databaseColumn: IDUSUARIO
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column INCLUIRTAREFA (
            type: selectList
            heading {
                heading: Incluir Tarefa
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @lov-simnao
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: INCLUIRTAREFA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column NOMEPESSOA (
            type: textarea
            heading {
                heading: Nome Pessoa
                alignment: center
            }
            layout {
                sequence: 30
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: NOMEPESSOA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
        )

        column TIPOTAREFA (
            type: textarea
            heading {
                heading: Tipo Tarefa
                alignment: center
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: TIPOTAREFA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
        )

    )

    pageItem P59_IDUSUARIO (
        type: selectList
        label {
            label: Usuário
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-usuarios
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 20
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P59_TIPOSTAREFAS (
        type: selectList
        label {
            label: Tipos Tarefas
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-tipostarefas
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @opções
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 60
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button novo-2 (
        buttonName: Novo
        label: Novo
        layout {
            sequence: 10
            region: @permissões-tipos-tarefas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 60
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction tipos-tarefas (
        name: Tipos Tarefas
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P59_TIPOSTAREFAS
                P59_IDUSUARIO
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @permissões-tipos-tarefas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

