page 580 (
    name: Status Ordens Compras
    title: Status Ordens Compras
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    css {
        inline:
            ```css
            .no-parent-padding {
                padding: 8px;
                margin: -12px -12px;
            }
            
            .yellow-background {
                background-clip: content-box;
                box-shadow: inset 0 0 0 12px yellow;
                background-color: yellow;
            }
            
            .lime-background {
                background-clip: content-box;
                box-shadow: inset 0 0 0 12px lime;
                background-color: lime;
            }
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region compras-transferências (
        name: Compras / Transferências
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select --listagg(idcompratransferencia,',') compras
                       idcompratransferencia
                  from comprastransferencias c
                 where idordemcompra = :P580_IDORDEMCOMPRA
                ```
            pageItemsToSubmit: P580_IDORDEMCOMPRA
        }
        layout {
            sequence: 20
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                js-modal
                js-draggable
                js-resizable
                js-dialog-size600x400
            ]
        }
        advanced {
            htmlDomId: ComprasTransferencias
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }

        column IDCOMPRATRANSFERENCIA (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Idcompratransferencia
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region status-ordens-compras (
        name: Status Ordens Compras
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select oc.dataemissao, oc.datafechamento, oc.idordemcompra, oc.idusuarioemissao
                     , oc.tipooc "Tipo OC"
                     , oc.idfornecedor
                     , case when oc.idsituacaooc = 1 then '<div class="yellow-background no-parent-padding">'|| ' - ' ||'</div>' 
                            else null end as "Ordem de Compra Iniciada"
                     --
                     , case when oc.idsituacaooc = 2 then '<div class="yellow-background no-parent-padding">'|| ' - ' ||'</div>'
                            else null end as "Ordem de Compra em Andamento"
                     --
                     , case when oc.idsituacaooc = 3 then '<div class="yellow-background no-parent-padding">'|| ' - ' ||'</div>'
                            else null end as "Ordem Compra Gerada"
                     --
                     , case when oc.idsituacaooc = 4 then '<div class="yellow-background no-parent-padding">'|| nvl(to_char(oc.percrecebido,'999D00'),0) ||'%' ||'</div>'
                            else null end as "O.C com pedido gerado"
                     --
                     , case when oc.idsituacaooc = 5 then '<div class="yellow-background no-parent-padding">'|| nvl(to_char(oc.percrecebido,'999D00'),0) ||'%' ||'</div>'
                            else null end as "Ordem de Compra Parcial"
                     --
                     , case when oc.idsituacaooc = 6 then '<div class="lime-background no-parent-padding">'|| nvl(to_char(oc.percrecebido,'999D00'),0) ||'%' ||'</div>'
                            else null end as "Ordem de Compra Completa"
                     --
                     , NULL "Ver CT"
                  from ordenscompras oc
                 where :P580_DATAINICIAL IS NULL or 
                       oc.dataemissao between to_date(:P580_DATAINICIAL || ' 00:00:00','dd/mm/rrrr hh24:mi:ss') 
                                          and to_date(:P580_DATAFINAL   || ' 23:59:59','dd/mm/rrrr hh24:mi:ss') 
                order by oc.idordemcompra desc
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 501574420550075941
        }

