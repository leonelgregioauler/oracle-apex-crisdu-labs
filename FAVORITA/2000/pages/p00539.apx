page 539 (
    name: teste VPD
    title: teste VPD
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function imprimeboleto(vidpedido,vidvendedora)
            {   
              vurl = 'https://boleto.romancemoda.com.br/boleto_bb_favorita_novo.php?cod1='+vidpedido+'&cod2='+vidvendedora;
              pjan = window.open(vurl,'boleto','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1024,height=1000,left=20,top=10','_blank'); 
              pjan.focus();
            }
            
            function fnc_gerartarefa(pid)
            {
              document.getElementById("P119_IDEDITAR").value = pid;
              apex.submit('GERARTAREFA');
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region new (
        name: New
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                  execute immediate :p539_comando;
                end;
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
    )

    region new-2 (
        name: New
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  p_where varchar2(5000);
                begin
                
                  if :P539_DATAINI IS NOT NULL THEN
                     p_where := ' AND ' || 'datavencimento between '|| '''' || v('P539_DATAINI')||'''' ||
                                ' AND ' || '''' || v('P539_DATAINI')||'''' ;
                  end if;
                  if :P539_FILIALFAV IS NOT NULL  THEN
                     p_where := p_where || ' AND ' || 'idfilialfavorita = '|| v('P539_FILIALFAV');
                  end if;
                  if :P539_FILIALROM IS NOT NULL  THEN
                     p_where := p_where || ' AND ' || 'idfilialromance = '|| v('P539_FILIALROM');
                  end if;
                  if :P539_IDREP IS NOT NULL  THEN
                     p_where := p_where || ' AND ' || 'idrepresentante = '|| v('P539_IDREP');
                  end if;
                  if :P539_IDVEND IS NOT NULL  THEN
                     p_where := p_where || ' AND ' || 'idvendedora = '|| v('P539_IDVEND');
                  end if;
                  
                
                  p_where :=  'select v.* ' 
                                 || ' ,case when (select 1 
                                                    from pagamentospedidos pg
                                                   where pg.idvencimentopedido = v.idvencimentopedido
                                                     and pg.idformapagamento   = 1
                                                     and rownum = 1 ) = 1 then ' 
                                 || ' '' <a href=javascript:imprimeboleto(''||v.idpedido||'',''||v.idvendedora||'');><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>'''
                                 || ' else ''-'' end urlboleto '
                
                                 || ' ,case 
                                       when v.saldo > 0 and :P539_DATAATUALIZADO > v.datavencimento then
                                         pck_util_fav.fnc_calculajuros(pidpedido           => v.idpedido,
                                                                       pvalororiginal      => v.saldo,
                                                                       pdatavencimentoorig => v.datavencimento, 
                                                                       pdatavencimentonovo => to_date(:P539_DATAATUALIZADO,''DD/MM/RRRR''),
                                                                       ppercjuros          => 2,
                                                                       ppercmulta          => 1)
                                       when v.saldo > 0 and trunc(sysdate) > v.datavencimento then
                                         pck_util_fav.fnc_calculajuros(pidpedido           => v.idpedido,
                                                                       pvalororiginal      => v.saldo,
                                                                       pdatavencimentoorig => v.datavencimento,
                                                                       pdatavencimentonovo => to_date(:P539_DATAATUALIZADO,''DD/MM/RRRR''),
                                                                       ppercmulta          => 2,
                                                                       ppercjuros          => 1)         
                                     else
                                         v.saldo
                                     end valoratualizado '
                                     
                                 || ', case 
                                     when v.datavencimento < trunc(sysdate) and not exists ( select 1
                                                                                             from tarefas t
                                                                                             where t.idpedido = v.idpedido
                                                                                               and t.idtipotarefa = 4 
                                                                                               and t.idsituacao in (0,10,20,40) ) then '
                                 || ' '' <a href="javascript:fnc_gerartarefa(''|| v.idpedido ||'')" ><img src="#APP_IMAGES#ok.png"  border="0"></a>'''
                                 || '  else '
                                 || ' '' <font color="red">Tarefa já Gerada ''||(select idtarefa from tarefas t
                                                                                  where t.idpedido = v.idpedido
                                                                                    and t.idtipotarefa = 4
                                                                                    and t.idsituacao = 0)|| ''</font>'' '
                                 || ' end tarefacobranca2 '
                
                                 || 'from  VWFA_APP2000_P119_REL001 v where 1=1'  
                  
                                 ||p_where; 
                  
                
                  return p_where;
                
                  
                end;
                ```
        }
