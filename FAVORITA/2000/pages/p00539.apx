    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                      p_where varchar2(5000);
                    begin
                    
                      if :P539_DATAINI IS NOT NULL THEN
                         p_where := ' AND ' || 'datavencimento between '|| '''' || v('P539_DATAINI')||'''' ||
                                    ' AND ' || '''' || v('P539_DATAINI')||'''' ;
                      end if;
                      if :P539_FILIALFAV IS NOT NULL  THEN
                         p_where := p_where || ' AND ' || 'idfilialfavorita = '|| v('P539_FILIALFAV');
                      end if;
                      if :P539_FILIALROM IS NOT NULL  THEN
                         p_where := p_where || ' AND ' || 'idfilialromance = '|| v('P539_FILIALROM');
                      end if;
                      if :P539_IDREP IS NOT NULL  THEN
                         p_where := p_where || ' AND ' || 'idrepresentante = '|| v('P539_IDREP');
                      end if;
                      if :P539_IDVEND IS NOT NULL  THEN
                         p_where := p_where || ' AND ' || 'idvendedora = '|| v('P539_IDVEND');
                      end if;
                      
                    
                      p_where :=  'select v.* ' 
                                     || ' ,case when (select 1 
                                                        from pagamentospedidos pg
                                                       where pg.idvencimentopedido = v.idvencimentopedido
                                                         and pg.idformapagamento   = 1
                                                         and rownum = 1 ) = 1 then ' 
                                     || ' '' <a href=javascript:imprimeboleto(''||v.idpedido||'',''||v.idvendedora||'');><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>'''
                                     || ' else ''-'' end urlboleto '
                    
                                     || ' ,case 
                                           when v.saldo > 0 and :P539_DATAATUALIZADO > v.datavencimento then
                                             pck_util_fav.fnc_calculajuros(pvalororiginal      => v.saldo,
                                                                           pdatavencimentoorig => v.datavencimento, 
                                                                           pdatavencimentonovo => to_date(:P539_DATAATUALIZADO,''DD/MM/RRRR''),
                                                                           ppercjuros          => 2,
                                                                           ppercmulta          => 1)
                                           when v.saldo > 0 and trunc(sysdate) > v.datavencimento then
                                             pck_util_fav.fnc_calculajuros(pvalororiginal      => v.saldo,
                                                                           pdatavencimentoorig => v.datavencimento,
                                                                           pdatavencimentonovo => to_date(:P539_DATAATUALIZADO,''DD/MM/RRRR''),
                                                                           ppercmulta          => 2,
                                                                           ppercjuros          => 1)         
                                         else
                                             v.saldo
                                         end valoratualizado '
                                         
                                     || ', case 
                                         when v.datavencimento < trunc(sysdate) and not exists ( select 1
                                                                                                 from tarefas t
                                                                                                 where t.idpedido = v.idpedido
                                                                                                   and t.idtipotarefa = 4 
                                                                                                   and t.idsituacao in (0,10,20,40) ) then '
                                     || ' '' <a href="javascript:fnc_gerartarefa(''|| v.idpedido ||'')" ><img src="#APP_IMAGES#ok.png"  border="0"></a>'''
                                     || '  else '
                                     || ' '' <font color="red">Tarefa já Gerada ''||(select idtarefa from tarefas t
                                                                                      where t.idpedido = v.idpedido
                                                                                        and t.idtipotarefa = 4
                                                                                        and t.idsituacao = 0)|| ''</font>'' '
                                     || ' end tarefacobranca2 '
                    
                                     || 'from  VWFA_APP2000_P119_REL001 v where 1=1'  
                      
                                     ||p_where; 
                      
                    
                      return p_where;
                    
                      
                    end;
                    ```
            }
            affectedElements {
                selectionType: items
                items: P539_WHERE
            }
            execution {
                sequence: 10
            }
        )

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    validation validafiltros (
        name: ValidaFiltros
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1 FROM DUAL 
                 WHERE :P539_DATAINI    IS NULL AND 
                       :P539_DATAFIM    IS NULL AND 
                       :P539_FILIALFAV  IS NULL AND 
                       :P539_FILIALROM  IS NULL AND 
                       :P539_IDREP      IS NULL AND 
                       :P539_IDVEND     IS NULL;
                ```
        }
        error {
            errorMessage: Informe ao menos um campo para filtro!!
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

    branch (
        name: VaiPara 539
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 539
                items: {
                    P539_DATAINI: &P539_DATAINI.
                    P539_DATAFIM: &P539_DATAFIM.
                    P539_FILIALFAV: &P539_FILIALFAV.
                    P539_FILIALROM: &P539_FILIALROM.
                    P539_IDREP: &P539_IDREP.
                    P539_IDVEND: &P539_IDVEND.
                    P539_FILTRAR: S
                }
                action: resetPagination
            }
        }
    )

)

