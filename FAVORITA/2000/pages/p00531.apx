page 531 (
    name: Concede Brinde
    title: Brinde Recebido
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region brindes (
        name: Brindes
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select *
                  from brindesrepresentantes
                 where idrepresentante = :P531_IDREPRESENTANTE
                   and idsemana        = :P531_IDSEMANA
                ```
            pageItemsToSubmit: [
                P531_IDREPRESENTANTE
                P531_IDSEMANA
            ]
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }

        column DATARECEBIDO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Datarecebido
                alignment: center
            }
            layout {
                sequence: 4
            }
            appearance {
                formatMask: DD/MM/YYYY HH24:MI:SS
            }
        )

        column IDBRINDEREPRESENTANTE (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column IDREPRESENTANTE (
            reportColumnQueryId: 2
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Representante
            }
            lov {
                type: sharedComponent
                lov: @lov-representantes
            }
            layout {
                sequence: 2
            }
        )

        column IDSEMANA (
            reportColumnQueryId: 3
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Semana
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select semanacompleta d
                         , idsemana r
                      from semana_dias s
                      --where idsemana >= (select idsemana-10 from semana_dias where trunc(sysdate) between dt_ini and dt_fim )
                      order by 2
                    ```
            }
            layout {
                sequence: 3
            }
        )

        column IDUSUARIO (
            reportColumnQueryId: 5
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Usuário Cedente
            }
            lov {
                type: sharedComponent
                lov: @lov-usuarios
            }
            layout {
                sequence: 5
            }
        )

    )

    pageItem P531_CONFIRMA (
        type: hidden
        layout {
            sequence: 30
            region: @brindes
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P531_IDREPRESENTANTE (
        type: hidden
        layout {
            sequence: 10
            region: @brindes
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P531_IDSEMANA (
        type: hidden
        layout {
            sequence: 20
            region: @brindes
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction atualiza (
        name: Atualiza
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @brindes
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction confirma (
        name: Confirma
        execution {
            sequence: 20
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: item=value
            item: P531_CONFIRMA
            value: S
        }

        action native-confirm (
            action: confirm
            settings {
                message: Confirma conceder brinde ao distribuidor?
            }
            execution {
                sequence: 10
            }
        )

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 30
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    
                      insert into brindesrepresentantes (idbrinderepresentante, idrepresentante, idsemana, datarecebido, idusuario)
                                                 values (seq_idbrinderepresentante.nextval,
                                                         :P531_IDREPRESENTANTE,
                                                         :P531_IDSEMANA,
                                                         sysdate,
                                                         :P0_IDUSUARIO);
                    
                    end;
                    ```
            }
            execution {
                sequence: 20
            }
        )

    )

)

