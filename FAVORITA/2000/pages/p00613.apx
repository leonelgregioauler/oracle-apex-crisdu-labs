    region grafico-do-painel-de-leads (
        name: Grafico do Painel de Leads
        type: chart
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: pie
        }
        chartLayout {
            height: 400
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        legend {
            hideAndShowBehavior: none
        }

        series new (
            name: New
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    /*select 'Enviados' situacao
                         , count(sac.idcontrolecontatossite) qtd
                    from roman.controlecontatossite sac
                    where sac.situacao in ('E','C','B')
                      --and ( :P613_IDFILIAL is null or sac.idfilial = :P613_IDFILIAL )
                      and (:P613_IDFILIAL is null OR ( sac.idfilial in (select regexp_substr(:P613_IDFILIAL, '[^:]+', 1, level) 
                                                          from dual
                                                          connect by level <= regexp_count(:P613_IDFILIAL, ':') + 1)))
                      and exists ( select 1
                                  from roman.classificacoessac cc
                                  where cc.idcontrolecontatossite = sac.idcontrolecontatossite
                                    and cc.idcaracteristicasac    = 37 )
                     and exists ( select 1
                                  from roman.painelcontatossite pn
                                  where pn.idcontrolecontatossite = sac.idcontrolecontatossite
                                    and pn.idsituacaopainel = 0
                                    and ( :P613_DATAINI is null or trunc(pn.datasituacao) between to_date(:P613_DATAINI,'dd/mm/rrrr') and to_date(:P613_DATAFIM,'dd/mm/rrrr')))
                      and :P613_FILTRAR = 'S'*/
                    select 'Excluídos' situacao
                         , count(sac.idcontrolecontatossite) total
                    from roman.controlecontatossite sac
                    where (:P613_IDFILIAL is null OR ( sac.idfilial in (select regexp_substr(:P613_IDFILIAL, '[^:]+', 1, level) 
                                                                        from dual
                                                                        connect by level <= regexp_count(:P613_IDFILIAL, ':') + 1)))
                      and exists ( select 1
                                   from roman.classificacoessac cc
                                   where cc.idcontrolecontatossite = sac.idcontrolecontatossite
                                     and cc.idcaracteristicasac    = 37 )
                      and exists ( select 1
                                   from roman.classificacoessac cc
                                   where cc.idcontrolecontatossite = sac.idcontrolecontatossite
                                     and cc.idcaracteristicasac = 38 ) --Concluido Restricao de Credito
                      and exists ( select 1
                                   from roman.painelcontatossite pn
                                   where pn.idcontrolecontatossite = sac.idcontrolecontatossite
                                     and pn.idsituacaopainel = 0
                                     and ( :P613_DATAINI is null or trunc(pn.datasituacao) between to_date( :P613_DATAINI,'dd/mm/rrrr') and to_date( :P613_DATAFIM,'dd/mm/rrrr')))
                       and :P613_FILTRAR = 'S'
                    
                    union all
                    
                    select 'Aguardando Atendimento' situacao
                         , count(sac.idcontrolecontatossite) qtd
                    from roman.controlecontatossite sac
                    where sac.situacao in ('E','C','B')
                      --and ( :P613_IDFILIAL is null or sac.idfilial = :P613_IDFILIAL )
                      and (:P613_IDFILIAL is null OR ( sac.idfilial in (select regexp_substr(:P613_IDFILIAL, '[^:]+', 1, level) 
                                                          from dual
                                                          connect by level <= regexp_count(:P613_IDFILIAL, ':') + 1)))
                      and sac.idrepresentante is null
                      and exists ( select 1
                                   from roman.classificacoessac cc
                                   where cc.idcontrolecontatossite = sac.idcontrolecontatossite
                                     and cc.idcaracteristicasac    = 37 )
                      and not exists ( select 1
                                       from roman.classificacoessac cc
                                       where cc.idcontrolecontatossite = sac.idcontrolecontatossite
                                         and cc.idcaracteristicasac = 38 ) --Concluido Restricao de Credito
                      and exists ( select 1
                                   from roman.painelcontatossite pn
                                   where pn.idcontrolecontatossite = sac.idcontrolecontatossite
                                     and pn.idsituacaopainel = 0
                                     and ( :P613_DATAINI is null or trunc(pn.datasituacao) between to_date(:P613_DATAINI,'dd/mm/rrrr') and to_date(:P613_DATAFIM,'dd/mm/rrrr')))
                      and :P613_FILTRAR = 'S'
                                     
                    union all                 
                                     
                    select 'Concluídos com Sacola' situacao
                         , count(sac.idcontrolecontatossite) qtd
                    from roman.controlecontatossite sac
                    where sac.situacao in ('U')
                      --and ( :P613_IDFILIAL is null or sac.idfilial = :P613_IDFILIAL )
                      and (:P613_IDFILIAL is null OR ( sac.idfilial in (select regexp_substr(:P613_IDFILIAL, '[^:]+', 1, level) 
                                                          from dual
                                                          connect by level <= regexp_count(:P613_IDFILIAL, ':') + 1)))
                      and exists ( select 1
                                   from roman.classificacoessac cc
                                   where cc.idcontrolecontatossite = sac.idcontrolecontatossite
                                     and cc.idcaracteristicasac    = 37 )
                      and exists ( select 1
                                   from roman.painelcontatossite pn
                                   where pn.idcontrolecontatossite = sac.idcontrolecontatossite
                                     and pn.idsituacaopainel = 0
                                     and ( :P613_DATAINI is null or trunc(pn.datasituacao) between to_date(:P613_DATAINI,'dd/mm/rrrr') and to_date(:P613_DATAFIM,'dd/mm/rrrr')))
                      and exists ( select 1
                                   from roman.painelcontatossite pn
                                   where pn.idsubsituacao = 1
                                     and pn.idcontrolecontatossite = sac.idcontrolecontatossite )
                      and :P613_FILTRAR = 'S'
                                     
                    union all
                    
                    select 'Concluídos sem Sacola' situacao
                         , count(sac.idcontrolecontatossite) qtd
                    from roman.controlecontatossite sac
                    where sac.situacao in ('U')
                      --and ( :P613_IDFILIAL is null or sac.idfilial = :P613_IDFILIAL )
                      and (:P613_IDFILIAL is null OR ( sac.idfilial in (select regexp_substr(:P613_IDFILIAL, '[^:]+', 1, level) 
                                                          from dual
                                                          connect by level <= regexp_count(:P613_IDFILIAL, ':') + 1)))
                      and exists ( select 1
                                   from roman.classificacoessac cc
                                   where cc.idcontrolecontatossite = sac.idcontrolecontatossite
                                     and cc.idcaracteristicasac    = 37 )
                      and exists ( select 1
                                   from roman.painelcontatossite pn
                                   where pn.idcontrolecontatossite = sac.idcontrolecontatossite
                                     and pn.idsituacaopainel = 0
                                     and ( :P613_DATAINI is null or trunc(pn.datasituacao) between to_date(:P613_DATAINI,'dd/mm/rrrr') and to_date(:P613_DATAFIM,'dd/mm/rrrr')))
                      and exists ( select 1
                                   from roman.painelcontatossite pn
                                   where pn.idsubsituacao = 2
                                     and pn.idcontrolecontatossite = sac.idcontrolecontatossite )
                      and :P613_FILTRAR = 'S'
                    ```
            }
            columnMapping {
                label: SITUACAO
                value: TOTAL
            }
        )

    )

