                where (:P613_IDFILIAL = -1 OR ( sac.idfilial in (select regexp_substr(:P613_IDFILIAL, '[^:]+', 1, level) 
                                                                    from dual
                                                                    connect by level <= regexp_count(:P613_IDFILIAL, ':') + 1)))
                  and exists ( select 1
                               from roman.classificacoessac cc
                               where cc.idcontrolecontatossite = sac.idcontrolecontatossite
                                 and cc.idcaracteristicasac    = 37 )
                  and exists ( select 1
                               from roman.classificacoessac cc
                               where cc.idcontrolecontatossite = sac.idcontrolecontatossite
                                 and cc.idcaracteristicasac = 38 ) --Concluido Restricao de Credito
                  and exists ( select 1
                               from roman.painelcontatossite pn
                               where pn.idcontrolecontatossite = sac.idcontrolecontatossite
                                 and pn.idsituacaopainel = 0
                                 and ( :P613_DATAINI is null or trunc(pn.datasituacao) between to_date( :P613_DATAINI,'dd/mm/rrrr') and to_date( :P613_DATAFIM,'dd/mm/rrrr')))
                                  and :P613_FILTRAR = 'S'
                ```
        }
        layout {
            sequence: 60
            parentRegion: @placar-de-leads
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        settings {
            labelColumn: SITUACAO
            valueColumn: TOTAL
        }
    )

    region excluídos-franquia (
        name: Excluídos - Franquia
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select xx.qtd_enviados
                     , xx.nomefranquia
                     , round((xx.qtd_enviados / xx.total)* 100,2)percentual
                     , roman.pck_romance.fnc_nomecidade(xx.idcidade) cidade
                from ( select count(sac.idcontrolecontatossite) qtd_enviados
                            , roman.pck_romance.fnc_nomefilial(sac.idfilial) nomefranquia
                            , x.total
                            , sac.idcidade
                       from roman.controlecontatossite sac
                          , ( select count(sac.idcontrolecontatossite) total
                              from roman.controlecontatossite sac
                              where --sac.situacao in ('E','C','B')
                               --and ( :P613_IDFILIAL is null or sac.idfilial = :P613_IDFILIAL)
                                (:P613_IDFILIAL = -1 OR ( sac.idfilial in (select regexp_substr(:P613_IDFILIAL, '[^:]+', 1, level) 
                                                      from dual
                                                      connect by level <= regexp_count(:P613_IDFILIAL, ':') + 1)))
                               and exists ( select 1
                                            from roman.classificacoessac cc
                                            where cc.idcontrolecontatossite = sac.idcontrolecontatossite
                                              and cc.idcaracteristicasac    = 37 )
                               and exists ( select 1
                                            from roman.classificacoessac cc
                                            where cc.idcontrolecontatossite = sac.idcontrolecontatossite
                                              and cc.idcaracteristicasac = 38 ) --Concluido Restricao de Credito
                               and exists ( select 1
                                            from roman.painelcontatossite pn
                                            where pn.idcontrolecontatossite = sac.idcontrolecontatossite
                                              and pn.idsituacaopainel = 0
                                              and ( :P613_DATAINI is null or trunc(pn.datasituacao) between to_date( :P613_DATAINI,'dd/mm/rrrr') and to_date( :P613_DATAFIM,'dd/mm/rrrr')))) x
                       where --sac.situacao in ('E','C','B')
                         --and ( :P613_IDFILIAL is null or sac.idfilial = :P613_IDFILIAL)
                          (:P613_IDFILIAL = -1 OR ( sac.idfilial in (select regexp_substr(:P613_IDFILIAL, '[^:]+', 1, level) 
                                                      from dual
                                                      connect by level <= regexp_count(:P613_IDFILIAL, ':') + 1)))
                         and exists ( select 1
                                      from roman.classificacoessac cc
                                      where cc.idcontrolecontatossite = sac.idcontrolecontatossite
                                        and cc.idcaracteristicasac = 37 ) --Liberado ao painel
                         and exists ( select 1
                                      from roman.classificacoessac cc
                                      where cc.idcontrolecontatossite = sac.idcontrolecontatossite
                                        and cc.idcaracteristicasac = 38 ) --Concluido Restricao de Credito
                         and exists ( select 1
                                      from roman.painelcontatossite pn
                                      where pn.idcontrolecontatossite = sac.idcontrolecontatossite
                                        and pn.idsituacaopainel = 0
                                        and ( :P613_DATAINI is null or trunc(pn.datasituacao) between to_date( :P613_DATAINI,'dd/mm/rrrr') and to_date( :P613_DATAFIM,'dd/mm/rrrr')))
                        group by sac.idfilial
                               , sac.idcidade
                               , x.total ) xx
                where :P613_FILTRAR = 'S'
                ```
        }
        layout {
            sequence: 160
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P613_TIPO
            value: X
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1504063423796861903
        }

        column CIDADE (
            type: plainText
