    region concluídos-com-sacola (
        name: Concluídos com Sacola
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select 'Concluídos com Sacola' situacao
                     , count(sac.idcontrolecontatossite) qtd
                from roman.controlecontatossite sac
                where sac.situacao in ('U')
                  --and ( :P613_IDFILIAL is null or sac.idfilial = :P613_IDFILIAL)
                  and (:P613_IDFILIAL = -1 OR ( sac.idfilial in (select regexp_substr(:P613_IDFILIAL, '[^:]+', 1, level) 
                                                      from dual
                                                      connect by level <= regexp_count(:P613_IDFILIAL, ':') + 1)))
                  and exists ( select 1
                               from roman.classificacoessac cc
                               where cc.idcontrolecontatossite = sac.idcontrolecontatossite
                                 and cc.idcaracteristicasac    = 37 )
                  and exists ( select 1
                               from roman.painelcontatossite pn
                               where pn.idcontrolecontatossite = sac.idcontrolecontatossite
                                 and pn.idsituacaopainel = 0
                                 and ( :P613_DATAINI is null or trunc(pn.datasituacao) between to_date(:P613_DATAINI,'dd/mm/rrrr') and to_date(:P613_DATAFIM,'dd/mm/rrrr')))
                  and exists ( select 1
                               from roman.painelcontatossite pn
                               where pn.idsubsituacao = 1
                                 and pn.idcontrolecontatossite = sac.idcontrolecontatossite )
                  and :P613_FILTRAR = 'S'
                ```
        }
        layout {
            sequence: 30
            parentRegion: @placar-de-leads
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        settings {
            labelColumn: SITUACAO
            valueColumn: QTD
        }
    )

    region concluídos-com-sacola-distribuidor (
        name: Concluídos com Sacola - Distribuidor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select count(sac.idcontrolecontatossite) qtd_enviados
                     , roman.pck_romance.fnc_nomefilial(sac.idfilial) nomefranquia
                     , nvl(roman.pck_romance.fnc_nomerepresentante(sac.idrepresentante),'Disponivel para Selecionar!') nomedist
                     , ( count(sac.idcontrolecontatossite) / x.total)*100 percentual
                from roman.controlecontatossite sac
                   , ( select count(sac.idcontrolecontatossite) total
                       from roman.controlecontatossite sac
                       where sac.situacao in ('U')
                         --and ( :P613_IDFILIAL is null or sac.idfilial = :P613_IDFILIAL)
                         and (:P613_IDFILIAL = -1  OR ( sac.idfilial in (select regexp_substr(:P613_IDFILIAL, '[^:]+', 1, level) 
                                                      from dual
                                                      connect by level <= regexp_count(:P613_IDFILIAL, ':') + 1)))
                         and exists ( select 1
                                      from roman.classificacoessac cc
                                      where cc.idcontrolecontatossite = sac.idcontrolecontatossite
                                        and cc.idcaracteristicasac    = 37 )
                         and exists ( select 1
                                      from roman.painelcontatossite pn
                                      where pn.idcontrolecontatossite = sac.idcontrolecontatossite
                                        and pn.idsituacaopainel = 0
                                        and ( :P613_DATAINI is null or trunc(pn.datasituacao) between to_date( :P613_DATAINI,'dd/mm/rrrr') and to_date( :P613_DATAFIM,'dd/mm/rrrr')))
                         and exists ( select 1
                                      from roman.painelcontatossite pn
                                      where pn.idsubsituacao = 1
                                        and pn.idcontrolecontatossite = sac.idcontrolecontatossite )) x
                where sac.situacao in ('U')
                  --and (:P613_IDFILIAL is null or sac.idfilial = :P613_IDFILIAL)
                  and (:P613_IDFILIAL = -1 OR ( sac.idfilial in (select regexp_substr(:P613_IDFILIAL, '[^:]+', 1, level) 
                                                      from dual
                                                      connect by level <= regexp_count(:P613_IDFILIAL, ':') + 1)))
                  and exists ( select 1
                               from roman.classificacoessac cc
                               where cc.idcontrolecontatossite = sac.idcontrolecontatossite
                                 and cc.idcaracteristicasac    = 37 )
                  and exists ( select 1
                               from roman.painelcontatossite pn
                               where pn.idcontrolecontatossite = sac.idcontrolecontatossite
                                 and pn.idsituacaopainel = 0
                                 and (:P613_DATAINI is null or trunc(pn.datasituacao) between to_date( :P613_DATAINI,'dd/mm/rrrr') and to_date( :P613_DATAFIM,'dd/mm/rrrr')))
                  and exists ( select 1
                               from roman.painelcontatossite pn
                               where pn.idsubsituacao = 1
                                 and pn.idcontrolecontatossite = sac.idcontrolecontatossite )
                  and :P613_FILTRAR = 'S'
                group by sac.idfilial
                       , sac.idrepresentante
                       , x.total
                ```
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P613_TIPO
            value: C
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
