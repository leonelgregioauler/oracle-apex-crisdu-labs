    region aguardando-atendimento-qtd-dias (
        name: Aguardando Atendimento - Qtd Dias
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select count( xx.idcontrolecontatossite) qtd_leads
                     , xx.dias  
                     , xx.ordem
                     , ( count( xx.idcontrolecontatossite) / xx.total )*100 percentual 
                from ( select x.idcontrolecontatossite,
                              case
                                when x.diasaberto between 0 and 4 then 
                                  '1 a 4 dias'
                                when x.diasaberto between 5 and 9 then 
                                  '5 a 9 dias'                  
                                when x.diasaberto between 10 and 14 then 
                                  '10 a 14 dias'
                                when x.diasaberto between 15 and 19 then 
                                  '15 a 19 dias'
                                when x.diasaberto between 20 and 24 then 
                                  '20 a 24 dias'
                                when x.diasaberto between 25 and 29 then 
                                  '25 a 29 dias'
                                else
                                  'Acima de 30 dias'
                                end dias, 
                              case
                                when x.diasaberto between 0 and 4 then 
                                  '1'
                                when x.diasaberto between 5 and 9 then 
                                  '2'                  
                                when x.diasaberto between 10 and 14 then 
                                  '3'
                                when x.diasaberto between 15 and 19 then 
                                  '4'
                                when x.diasaberto between 20 and 24 then 
                                  '5'
                                when x.diasaberto between 25 and 29 then 
                                  '6'
                                else
                                  '7'
                                end ordem, 
                              x.total
                        from (select sac.idcontrolecontatossite 
                                   , round(( sysdate - ( select max(pn.datasituacao)
                                                         from roman.painelcontatossite pn
                                                         where pn.idcontrolecontatossite = sac.idcontrolecontatossite
                                                           and pn.idsituacaopainel = 0)),0) diasaberto
                                   , y.total
                              from roman.controlecontatossite sac
                                 , ( select count( sac.idcontrolecontatossite) total
                                     from roman.controlecontatossite sac
                                     where sac.situacao in ('E','C','B')
                                       --and ( :P613_IDFILIAL is null or sac.idfilial = :P613_IDFILIAL)
                                       and (:P613_IDFILIAL = -1 OR ( sac.idfilial in (select regexp_substr(:P613_IDFILIAL, '[^:]+', 1, level) 
                                                      from dual
                                                      connect by level <= regexp_count(:P613_IDFILIAL, ':') + 1)))
                                       and sac.idrepresentante is null
                                       and exists ( select 1
                                                    from roman.classificacoessac cc
                                                    where cc.idcontrolecontatossite = sac.idcontrolecontatossite
                                                      and cc.idcaracteristicasac    = 37 )
                                       and not exists ( select 1
                                                        from roman.classificacoessac cc
                                                        where cc.idcontrolecontatossite = sac.idcontrolecontatossite
                                                          and cc.idcaracteristicasac = 38 ) --Concluido Restricao de Credito
                                       and exists ( select 1
                                                    from roman.painelcontatossite pn
                                                    where pn.idcontrolecontatossite = sac.idcontrolecontatossite
                                                      and pn.idsituacaopainel = 0
                                                      and ( :P613_DATAINI is null or trunc(pn.datasituacao) between to_date( :P613_DATAINI,'dd/mm/rrrr') and to_date( :P613_DATAFIM,'dd/mm/rrrr')))) y
                              where sac.situacao in ('E','C','B')
                                --and ( :P613_IDFILIAL is null or sac.idfilial = :P613_IDFILIAL)
                                and (:P613_IDFILIAL = -1 OR ( sac.idfilial in (select regexp_substr(:P613_IDFILIAL, '[^:]+', 1, level) 
                                                      from dual
                                                      connect by level <= regexp_count(:P613_IDFILIAL, ':') + 1)))
                                and sac.idrepresentante is null
                                and exists ( select 1
                                             from roman.classificacoessac cc
                                             where cc.idcontrolecontatossite = sac.idcontrolecontatossite
                                               and cc.idcaracteristicasac    = 37 )
                                and not exists ( select 1
                                                 from roman.classificacoessac cc
                                                 where cc.idcontrolecontatossite = sac.idcontrolecontatossite
                                                   and cc.idcaracteristicasac = 38 ) --Concluido Restricao de Credito
                                and exists ( select 1
                                             from roman.painelcontatossite pn
                                             where pn.idcontrolecontatossite = sac.idcontrolecontatossite
                                               and pn.idsituacaopainel = 0
                                               and ( :P613_DATAINI is null or trunc(pn.datasituacao) between to_date( :P613_DATAINI,'dd/mm/rrrr') and to_date( :P613_DATAFIM,'dd/mm/rrrr'))))x ) xx
                where :P613_FILTRAR = 'S'
                group by xx.dias
                       , xx.ordem
                       , xx.total
                order by 3
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P613_TIPO
            value: A
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1503565192892382617
        }

