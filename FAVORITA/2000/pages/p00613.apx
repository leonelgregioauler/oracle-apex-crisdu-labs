        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(idrepresentante) display_value
                     , idrepresentante return_value
                from catal.representantes r
                where r.ativo = 'S'
                  and r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P613_IDFILIAL )
                order by 1
                ```
            nullDisplayValue: - Todos -
        }
        cascadingLov {
            parentItems: P613_IDFILIAL
