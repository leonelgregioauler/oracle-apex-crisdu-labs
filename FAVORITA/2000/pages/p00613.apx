    pageItem P613_IDFILIAL (
        type: plugin/select
        label {
            label: Franquia
            alignment: left
        }
        settings {
            selectListType: multiValueSelectList
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from roman.vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                /*  and (      :P0_IDFILIAL is null 
                        or ( :P0_IDFILIAL = 1135 and f.idfilial in (1089,1090,1106,1132,124,122,320,221,1070,1072,1071,1082,1083 ) )
                        or ( :P0_IDFILIAL != 1135 and f.idfilial  = :P0_IDFILIAL)  )*/
                  and catal.pck_util.fnc_verificaacesso(52611,v('APP_USER')) = 'N'
                  and exists ( select 1
                               from roman.usuariosfiliais uf
                               where uf.idfilial = f.idfilial
                                 and uf.usuario = v('APP_USER') )
                
                union all
                
                select '- Todas -' as nome,
                       -1 as idfilial
                 from dual
                where (:P0_IDFILIAL = 1135
                   or catal.pck_util.fnc_verificaacesso(52611,v('APP_USER')) = 'S')
                order by 1;
                ```
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

