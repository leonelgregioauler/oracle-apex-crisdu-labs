    region concluídos-sem-sacola-detalhado (
        name: Concluídos sem Sacola - Detalhado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idcontrolecontatossite                                     as "ID Lead"
                     , c.idfilial                                                   as "ID Filial"
                     , roman.pck_romance.fnc_nomefilial( c.idfilial)                as "Franquia"
                     , c.idfilial                                                   as "ID Representante"
                     , roman.pck_romance.fnc_nomerepresentante ( c.idrepresentante) as "Distribuidor"
                     , 'Outro'                                                      as "Motivo"
                     , replace(p.motivorep,'null','')                               as "Observação Representante"
                  from roman.controlecontatossite c
                     , roman.painelcontatossite   p
                 where p.idcontrolecontatossite = c.idcontrolecontatossite
                   and p.idsubsituacao = 2
                   and p.idmotivopainellead = 0
                   and c.situacao = 'U'
                   and ( :P613_DATAINI is null or trunc(p.datasituacao) between to_date( :P613_DATAINI,'dd/mm/rrrr') and to_date( :P613_DATAFIM,'dd/mm/rrrr'))
                   and ( :P613_IDFILIAL = -1 or ( c.idfilial in (select regexp_substr(:P613_IDFILIAL, '[^:]+', 1, level) 
                                                                   from dual
                                                                connect by level <= regexp_count(:P613_IDFILIAL, ':') + 1)))
                   and exists ( select 1
                                  from roman.classificacoessac cc
                                 where cc.idcontrolecontatossite = c.idcontrolecontatossite
                                   and cc.idcaracteristicasac    = 37 );
                
                ```
        }
        layout {
            sequence: 150
            slot: body
        }
