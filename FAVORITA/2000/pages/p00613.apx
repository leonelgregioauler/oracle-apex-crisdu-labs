    region concluídos-sem-sacola-motivos (
        name: Concluídos sem Sacola - Motivos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nvl(x.motivo,'Outro') motivo
                     , count(distinct(sac.idcontrolecontatossite)) qtd
                     , (count(sac.idcontrolecontatossite) / xy.total)*100 percentual
                from ( select ( select mt.motivo
                                from roman.motivospainelleads mt
                                where mt.idmotivopainelleads = pa.idmotivopainellead ) motivo
                            , max(pa.idpainelcontatossite) idpainelcontatossite
                            , pa.idcontrolecontatossite
                       from roman.painelcontatossite pa
                       where pa.idsituacaopainel = 2
                         and pa.idsubsituacao = 2
                       group by pa.idmotivopainellead, pa.idcontrolecontatossite ) x
                    , roman.controlecontatossite sac
                    , ( select count(sac.idcontrolecontatossite) total
                        from roman.controlecontatossite sac
                        where sac.situacao in ('U')
                          --and ( :P613_IDFILIAL is null or sac.idfilial = :P613_IDFILIAL)
                          and (:P613_IDFILIAL = -1 OR ( sac.idfilial in (select regexp_substr(:P613_IDFILIAL, '[^:]+', 1, level) 
                                                      from dual
                                                      connect by level <= regexp_count(:P613_IDFILIAL, ':') + 1)))
                          --and sac.idrepresentante is null
                          and exists ( select 1
                                       from roman.classificacoessac cc
                                       where cc.idcontrolecontatossite = sac.idcontrolecontatossite
                                         and cc.idcaracteristicasac    = 37 )
                          and exists ( select 1
                                       from roman.painelcontatossite pn
                                       where pn.idcontrolecontatossite = sac.idcontrolecontatossite
                                         and pn.idsituacaopainel = 0
                                         and ( :P613_DATAINI is null or trunc(pn.datasituacao) between to_date( :P613_DATAINI,'dd/mm/rrrr') and to_date( :P613_DATAFIM,'dd/mm/rrrr')))
                          and exists ( select 1
                                       from roman.painelcontatossite pn
                                       where pn.idsubsituacao = 2
                                         and pn.idcontrolecontatossite = sac.idcontrolecontatossite )) xy
                where sac.idcontrolecontatossite = x.idcontrolecontatossite
                  and sac.situacao in ('U')
                  --and ( :P613_IDFILIAL is null or sac.idfilial = :P613_IDFILIAL)
                  and (:P613_IDFILIAL = -1 OR ( sac.idfilial in (select regexp_substr(:P613_IDFILIAL, '[^:]+', 1, level) 
                                                      from dual
                                                      connect by level <= regexp_count(:P613_IDFILIAL, ':') + 1)))
                  --and sac.idrepresentante is null
                  and exists ( select 1
                               from roman.classificacoessac cc
                               where cc.idcontrolecontatossite = sac.idcontrolecontatossite
                                 and cc.idcaracteristicasac    = 37 )
                  and exists ( select 1
                               from roman.painelcontatossite pn
                               where pn.idcontrolecontatossite = sac.idcontrolecontatossite
                                 and pn.idsituacaopainel = 0
                                 and ( :P613_DATAINI is null or trunc(pn.datasituacao) between to_date( :P613_DATAINI,'dd/mm/rrrr') and to_date( :P613_DATAFIM,'dd/mm/rrrr')))
                  and exists ( select 1
                               from roman.painelcontatossite pn
                               where pn.idsubsituacao = 2
                                 and pn.idcontrolecontatossite = sac.idcontrolecontatossite )
                  and :P613_FILTRAR = 'S'
                group by x.motivo
                       , xy.total
                ```
        }
        layout {
            sequence: 140
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
