    branch (
        name: Go To Page 371
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 371
                items: {
                    P371_IDFILIALROMANCE: &P371_IDFILIALROMANCE.
                    P371_CODIGORASTREIO: &P371_CODIGORASTREIO.
                    P371_TIPOENVIO: &P371_TIPOENVIO.
                    P371_TIPORELATORIO: &P371_TIPORELATORIO.
                    P371_TIPODATA: &P371_TIPODATA.
                    P371_DATAINICIO: &P371_DATAINICIO.
                    P371_DATAFIM: &P371_DATAFIM.
                    P371_FRETECOBRADO: &P371_FRETECOBRADO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
