    region relação-de-pedidos-resumido (
        name: Relação de Pedidos Resumido
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(pf.idfilialromance) empresa
                     , count( distinct pf.idpedido ) quantidade
                     , sum(pf.valorfrete) totalfrete
                from vw_pedidos_fav pf
                where pf.ididioma = :P0_IDIDIOMA
                  and ( :P371_FRETECOBRADO = 'A' 
                       or ( :P371_FRETECOBRADO = 'N' and not exists ( select 1
                                                                      from classificacoespedidos c
                                                                      where c.idcaracteristicapedido = 56
                                                                        and c.idpedido               = pf.idpedido ) )
                       or ( :P371_FRETECOBRADO = 'S' and exists ( select 1
                                                                  from classificacoespedidos c
                                                                  where c.idcaracteristicapedido = 56
                                                                    and c.idpedido               = pf.idpedido ) ) )
                  and ( :P371_CODIGORASTREIO is null or exists ( select 1
                                                                 from classificacoespedidos c
                                                                 where c.idcaracteristicapedido     = 52
                                                                   and c.idpedido                   = pf.idpedido
                                                                   and replace(c.observacao,' ','') = replace(:P371_CODIGORASTREIO,' ','') ) )
                  and ( :P371_TIPODATA is null 
                     or ( :P371_TIPODATA = 'E' and trunc(pf.dataemissao) between to_date(:P371_DATAINICIO) and to_date(:P371_DATAFIM) )
                     or ( :P371_TIPODATA = 'D' and exists ( select 1
                                                            from classificacoespedidos cp
                                                            where cp.idpedido = pf.idpedido
                                                              and cp.idcaracteristicapedido = 20
                                                              and trunc(cp.dataclassificado) between to_date(:P371_DATAINICIO) and to_date(:P371_DATAFIM) ) ) )
                  and ( :P371_TIPOENVIO = 'A'
                     or ( :P371_TIPOENVIO = 'N' and exists ( select 1
                                                             from classificacoespedidos cp
                                                             where cp.idpedido = pf.idpedido
                                                               and cp.idcaracteristicapedido = 52 ) )
                     or ( :P371_TIPOENVIO = 'I' and exists ( select 1
                                                             from classificacoespedidos cp
                                                             where cp.idpedido = pf.idpedido
                                                               and cp.idcaracteristicapedido = 54 ) ) )
                group by pf.idfilialromance
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
