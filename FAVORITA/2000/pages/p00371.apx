page 371 (
    name: Controle de Correio
    title: Controle de Correio
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region relação-de-pedidos-detalhado (
        name: Relação de Pedidos Detalhado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pf.idpedido
                     , pf.edicaorevista
                     , pf.filialromance
                     , pf.representante
                     , pf.vendedora
                     , pf.dataemissao
                     , pf.dataentrega
                     , pf.valortotal
                     , pf.valorapagar
                     , pf.valorpago
                     , pf.valorfrete
                     , ( select listagg(h.datahistorico||' - '||h.descricao,' ') within group (order by 1)
                         from historicospedidos h
                         where h.idpedido = pf.idpedido ) historicos
                     , nvl(( select 'Sim'
                             from dual 
                             where exists ( select 1
                                            from classificacoespedidos c
                                            where c.idcaracteristicapedido = 56
                                              and c.idpedido               = pf.idpedido )),'Não') frete
                     , nvl(( select observacao
                             from classificacoespedidos c
                             where c.idcaracteristicapedido = 52
                               and c.idpedido               = pf.idpedido ),'Sem Código Rastreio') codigorastreio
                from vw_pedidos_fav pf
                where pf.ididioma = :P0_IDIDIOMA
                  and ( :P371_IDFILIALROMANCE is null or pf.idfilialromance = :P371_IDFILIALROMANCE )
                  and ( :P371_TIPORELATORIO = 'D' )
                  and ( :P371_FRETECOBRADO = 'A' 
                       or ( :P371_FRETECOBRADO = 'N' and not exists ( select 1
                                                                      from classificacoespedidos c
                                                                      where c.idcaracteristicapedido = 56
                                                                        and c.idpedido               = pf.idpedido ) )
                       or ( :P371_FRETECOBRADO = 'S' and exists ( select 1
                                                                  from classificacoespedidos c
                                                                  where c.idcaracteristicapedido = 56
                                                                    and c.idpedido               = pf.idpedido ) ) )
                  and ( :P371_CODIGORASTREIO is null or exists ( select 1
                                                                 from classificacoespedidos c
                                                                 where c.idcaracteristicapedido     = 52
                                                                   and c.idpedido                   = pf.idpedido
                                                                   and replace(c.observacao,' ','') = replace(:P371_CODIGORASTREIO,' ','') ) )
                  and ( :P371_TIPODATA is null 
                     or ( :P371_TIPODATA = 'E' and trunc(pf.dataemissao) between to_date(:P371_DATAINICIO) and to_date(:P371_DATAFIM) )
                     or ( :P371_TIPODATA = 'D' and exists ( select 1
                                                            from classificacoespedidos cp
                                                            where cp.idpedido = pf.idpedido
                                                              and cp.idcaracteristicapedido = 20
                                                              and trunc(cp.dataclassificado) between to_date(:P371_DATAINICIO) and to_date(:P371_DATAFIM) ) ) )
                  and ( :P371_TIPOENVIO = 'A'
                     or ( :P371_TIPOENVIO = 'N' and exists ( select 1
                                                             from classificacoespedidos cp
                                                             where cp.idpedido = pf.idpedido
                                                               and cp.idcaracteristicapedido = 52 ) )
                     or ( :P371_TIPOENVIO = 'I' and exists ( select 1
                                                             from classificacoespedidos cp
                                                             where cp.idpedido = pf.idpedido
                                                               and cp.idcaracteristicapedido = 54 ) ) )
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P371_TIPORELATORIO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum pedido encontrado, verifique os filtros!
        }
        advanced {
            savedReportMappingIdentifier: 1519806896640093102
        }

