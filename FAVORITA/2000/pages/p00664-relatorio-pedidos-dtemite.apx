page 664 (
    name: Relatorio Pedidos DTEMITE
    alias: RELATORIO-PEDIDOS-DTEMITE
    title: Relatorio Pedidos DTEMITE
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }

    region relatorio-pedidos-dtemite (
        name: Relatorio Pedidos DTEMITE
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select folio, fchemis, pdfdtemite as URL_PDF
                       --'<a href="' || pdfdtemite || '" target="_blank">' ||
                       --'Clique para Visualizar PDF do DTEMITE' ||
                       --'</a>' as URL_PDF
                  from roman.pedidos_dtemite
                 where idpedido = :P664_IDPEDIDO
                 order by 1
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 1790927947070308381
        }

        column FCHEMIS (
            type: plainText
            heading {
                heading: Emissão
            }
            layout {
                sequence: 2
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: B
            }
        )

        column FOLIO (
            type: plainText
            heading {
                heading: Folio
                alignment: end
            }
            layout {
                sequence: 1
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column URL_PDF (
            type: plainText
            heading {
                heading: Url Pdf
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
            security {
                escapeSpecialChars: false
            }
        )

        savedReport 17909735 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn FCHEMIS (
                sequence: 2
            )

            displayColumn FOLIO (
                sequence: 1
            )

            displayColumn URL_PDF (
                sequence: 3
            )

        )

    )

    pageItem P664_IDPEDIDO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            slot: contentBody
        }
    )

)

