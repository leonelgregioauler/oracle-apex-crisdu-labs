page 325 (
    name: Cartão de Crédito
    title: Cartão de Crédito
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 80%
        height: 80%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cartão-crédito (
        name: Cartão Crédito
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
    )

    pageItem P325_BANDEIRA (
        type: selectList
        label {
            label: Bandeira
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Mastercard;MASTERCARD,Visa;VISA,Hipercard;HIPERCARD,Hiper;HIPER,Elo;ELO,Diners;DINERS,JCB;JCB,Credz;CREDZ,Amex;AMEX,Cabal;CABAL,Sorocred;SOROCRED,Credsystem;CREDSYSTEM,Banescard;BANESCARD
            displayExtraValues: false
            nullDisplayValue: - Selecione a Bandeira -
        }
        layout {
            sequence: 60
            region: @cartão-crédito
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 5
            columnAttributes: bandeira
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--xlarge
            ]
            height: 1
        }
        default {
            type: static
            staticValue: MASTER
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P325_CODIGOSEGURANCA (
        type: textField
        label {
            label: Código Segurança
            alignment: left
        }
        layout {
            sequence: 90
            region: @cartão-crédito
            slot: regionBody
            alignment: left
            columnSpan: 5
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--xlarge
            ]
            width: 30
        }
        validation {
            maxLength: 3
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P325_CPFTITULAR (
        type: textField
        label {
            label: CPF Titular
            alignment: left
        }
        layout {
            sequence: 100
            region: @cartão-crédito
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 5
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--xlarge
            ]
            width: 30
        }
        validation {
            maxLength: 14
        }
        advanced {
            customAttributes: "onkeyPress=\"javascript:{formatar_mascara(this, '###.###.###-##',event); }\" ; onblur=\"javascript:{formataCPF (this); }\" ;"
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P325_IDPAGAMENTOPEDIDO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 120
            region: @cartão-crédito
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P325_IDPEDIDO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @cartão-crédito
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P325_IDVENCIMENTOPEDIDO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 110
            region: @cartão-crédito
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P325_NOMEOPERADORACARTAO (
        type: displayOnly
        label {
            label: Operadora Cartão
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 50
            region: @cartão-crédito
            slot: regionBody
            alignment: left
            columnSpan: 5
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--xlarge
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P325_NUMEROCARTAO (
        type: textField
        label {
            label: Número Cartão
            alignment: left
        }
        layout {
            sequence: 70
            region: @cartão-crédito
            slot: regionBody
            alignment: left
            columnSpan: 5
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--xlarge
            ]
            width: 30
        }
        validation {
            maxLength: 19
        }
        advanced {
            cssClasses: numerocartao
            customAttributes: "onkeyPress=\"javascript:{formatar_mascara(this, '####-####-####-####',event); }\"; onblur=\"javascript:{formataCartaoCredito(this); }\" ;"
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P325_OPERADORACARTAO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @cartão-crédito
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P325_ORIGEM (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 130
            region: @cartão-crédito
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P325_QTDPARCELAMENTO (
        type: selectList
        label {
            label: +
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_value
                     , return_value 
                from( select '1 Parcela' display_value
                     , 1 return_value
                from dual
                union
                select '2 Parcelas' 
                     , 2 return_value
                from dual
                union
                select '3 Parcelas' 
                     , 3 return_value
                from dual
                union
                select '4 Parcelas' 
                     , 4 return_value
                from dual
                union
                select '5 Parcelas' 
                     , 5 return_value
                from dual
                union
                select '6 Parcelas' 
                     , 6 return_value
                from dual
                union
                select '7 Parcelas' 
                     , 7 return_value
                from dual
                union
                select '8 Parcelas' 
                     , 8 return_value
                from dual
                union
                select '9 Parcelas' 
                     , 9 return_value
                from dual
                union
                select '10 Parcelas' 
                     , 10 return_value
                from dual
                union
                select '11 Parcelas' 
                     , 11 return_value
                from dual
                union
                select '12 Parcelas' 
                     , 12 return_value
                from dual)
                order by 2
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @cartão-crédito
            slot: regionBody
            alignment: left
            columnSpan: 5
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--xlarge
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P325_VALIDADECARTAO (
        type: datePickerJquery
        label {
            label: Validade
            alignment: left
        }
        layout {
            sequence: 80
            region: @cartão-crédito
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 5
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--xlarge
            ]
            formatMask: MM/RRRR
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P325_VALORAPAGAR (
        type: numberField
        label {
            label: Valor a Pagar
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 20
            region: @cartão-crédito
            slot: regionBody
            alignment: left
            columnSpan: 5
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--xlarge
            ]
            width: 30
        }
        advanced {
            customAttributes: onkeyup="formataMoeda(this);"
        }
        security {
            encryptSessionState: false
        }
    )

    button cartaocredito (
        buttonName: CARTAOCREDITO
        label: Enviar Dados Cartão
        layout {
            sequence: 20
            region: @cartão-crédito
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-credit-card
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @cartão-crédito
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-reply
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction carrega-forma-de-pagamento-e-operadora-do-cartão (
        name: Carrega Forma de Pagamento e Operadora do Cartão
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      --
                      vidpedidovirtualage     number;
                      --
                    begin
                      --
                      select idpedidovirtualage
                      into vidpedidovirtualage
                      from pedidos 
                      where idpedido = :P325_IDPEDIDO;
                      --
                      if vidpedidovirtualage is null then 
                        :P325_OPERADORACARTAO := 1; 
                        :P325_NOMEOPERADORACARTAO := 'Cielo';
                      elsif vidpedidovirtualage is not null then
                        :P325_OPERADORACARTAO := 0;
                        :P325_NOMEOPERADORACARTAO := 'Rede Card';
                      end if;
                      --
                      :P325_BANDEIRA     := null;
                      :P325_NUMEROCARTAO := null;
                      :P325_VALIDADECARTAO := null;
                      :P325_CODIGOSEGURANCA := null;
                      :P325_CPFTITULAR := null;
                      --
                    end;
                    ```
                itemsToSubmit: P325_IDPEDIDO
                itemsToReturn: [
                    P325_OPERADORACARTAO
                    P325_NOMEOPERADORACARTAO
                    P325_BANDEIRA
                    P325_NUMEROCARTAO
                    P325_VALIDADECARTAO
                    P325_CODIGOSEGURANCA
                    P325_CPFTITULAR
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var dadospagamento = JSON.parse(sessionStorage.getItem('DADOSPAGAMENTO'));
                    
                    $('#P325_IDPEDIDO')[0].value        = dadospagamento.idpedido;
                    $('#P325_QTDPARCELAMENTO')[0].value = dadospagamento.qtdparcelas;
                    $('#P325_VALORAPAGAR')[0].value     = dadospagamento.valorapagar.trim();
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction desabilita-autocomplete (
        name: Desabilita Autocomplete
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $('.numerocartao').attr('autocomplete','off');
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction desabilita-cartão-para-cielo (
        name: Desabilita Cartão para Cielo
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P325_NUMEROCARTAO
        }
        clientSideCondition {
            type: item=value
            item: P325_OPERADORACARTAO
            value: 1
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: button
                button: @cartaocredito
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction enviar-dados-do-cartão-de-crédito (
        name: Enviar Dados do Cartão de Crédito
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cartaocredito
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    function onCartaoCreditoDone (data) {  
                      //console.log("Dados: " + data.STATUS);
                      //console.log("Dados: " + data.PARAMS.CPF_TITULAR);
                      //console.log("Dados: " + data.RESULTADO.STATUS);
                      //console.log("Dados: " + data.RESULTADO.sucesso);
                      //console.log("Dados: " + data.RESULTADO.cardResponse.returnMessage);
                      //console.log("Dados: " + data.RESULTADO.cardResponse.nsu);
                      //console.log(data.PARAMS);
                        
                      var mensagemretorno;
                      
                      if (data.RESULTADO.cardResponse.returnCode == 00) {
                        mensagemretorno = 'Transação Autorizada.';  
                      } else if (data.RESULTADO.cardResponse.returnCode == 42) {
                        mensagemretorno = 'Pedido já processado.'; 
                      } else if (data.RESULTADO.cardResponse.returnCode == 80) {
                        mensagemretorno = 'Não autorizada. Saldo insuficiente.';  
                      } else {
                        mensagemretorno = 'Erro na transação, ' + ' número: ' + data.RESULTADO.cardResponse.returnCode + ' Verificar tabela.';  
                      }
                        
                      $('.exibeaguarde').append('<br /><br /><button class="t-Button-label" onclick="javascript: OcultaAguarde();">'+mensagemretorno+'</button>');
                      
                    }
                    
                    var endereco             = $("#P0_ENDERECOWS_CARTAOCREDITO").val();                
                    var idpedido             = $("#P325_IDPEDIDO").val();
                    var operadoracartao      = $("#P325_OPERADORACARTAO").val();
                    var bandeira             = $("#P325_BANDEIRA").val();
                    var numerocartao         = $("#P325_NUMEROCARTAO").val();
                    var validadecartao       = $("#P325_VALIDADECARTAO").val();
                    var codigoseguranca      = $("#P325_CODIGOSEGURANCA").val();
                    var cpftitular           = $("#P325_CPFTITULAR").val();
                    var valorapagar          = $("#P325_VALORAPAGAR").val().replace(",", ".");
                    var numeroparcelas       = $("#P325_QTDPARCELAMENTO").val();
                    var idusuario            = $("#P0_IDUSUARIO").val();
                    
                    /*
                    console.log(idpedido);
                    console.log(operadoracartao);
                    console.log(bandeira);
                    console.log(numerocartao);
                    console.log(validadecartao);
                    console.log(codigoseguranca);
                    console.log(cpftitular);
                    console.log(valorapagar);
                    console.log(numeroparcelas);
                    console.log(idusuario);
                    */
                    
                    var servico = endereco + "lancar_valor_cartao?IDPEDIDO="+idpedido+"&OPERADORACARTAO="+operadoracartao+"&BANDEIRA="+bandeira+"&NUMERO_CARTAO="+numerocartao+"&VALIDADE_CARTAO="+validadecartao+"&CODIGO_SEGURANCA="+codigoseguranca+"&CPF_TITULAR="+cpftitular+"&VALOR_TOTAL="+valorapagar+"&NUMERO_PARCELAS="+numeroparcelas+"&IDUSUARIO="+idusuario;
                    
                    ExibeAguarde();
                        
                    $.getJSON(servico).done(onCartaoCreditoDone);
                    
                       
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    branch (
        name: GoTo Page 214
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 214
                items: {
                    P214_IDPEDIDO: &P325_IDPEDIDO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'VOLTAR' and :P325_ORIGEM = 214
        }
    )

    branch (
        name: GoTo Page 321
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 321
                items: {
                    P321_IDPEDIDO: &P325_IDPEDIDO.
                    P321_IDVENCIMENTOPEDIDO: &P325_IDVENCIMENTOPEDIDO.
                    P321_IDPAGAMENTOPEDIDO: &P325_IDPAGAMENTOPEDIDO.
                    P321_PAGINAORIGEM: 325
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'VOLTAR' and :P325_ORIGEM = 321
        }
    )

    branch (
        name: GoTo Page 322
        execution {
            sequence: 30
        }
        behavior {
            target: {
                page: 322
                items: {
                    P322_IDPEDIDO: &P325_IDPEDIDO.
                    P322_IDVENCIMENTOPEDIDO: &P325_IDVENCIMENTOPEDIDO.
                    P322_IDPAGAMENTOPEDIDO: &P325_IDPAGAMENTOPEDIDO.
                    P322_PAGINAORIGEM: 325
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'VOLTAR' and :P325_ORIGEM = 322
        }
    )

)

