    region itens-de-uso-e-consumo (
        name: Itens de Uso e Consumo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.iditemcompratransferencia
                     , i.idcompratransferencia
                     , pck_util_fav.fnc_nomeprodutodetalhado(i.idprodutodetalhado, :P0_IDIDIOMA) "Produto Detalhado"
                     , ( select e.quantidade
                         from estoques e
                         where e.idprodutodetalhado = i.idprodutodetalhado
                           and e.idfilialfavorita = ( select c.idfilialfavoritaorigem
                                                      from comprastransferencias c
                                                      where c.idcompratransferencia = i.idcompratransferencia ) ) as "Qtd Est Origem"
                     , i.idestoquefilorigem                                      
                     , pck_estoque_fav.fnc_estoquedisponivel(i.idestoquefilorigem) "Qtd Est Dispo Origem"
                     , ( select e.quantidade
                         from estoques e
                         where e.idprodutodetalhado = i.idprodutodetalhado
                           and e.idfilialfavorita = ( select c.idfilialfavoritadestino
                                                      from comprastransferencias c
                                                      where c.idcompratransferencia = i.idcompratransferencia ) ) "Qtd Est Destino"
                   , i.valorcusto as "Vlr Custo"
                   , quantidadecomprada  as "Qtd Comprada"
                   , quantidadecomprada  as "Qtd Comprada LINK"
                   , i.quantidadecomprada * i.valorcusto "Total Item"
                   , i.observacao as "Observação"
                   , i.idprodutodetalhado
                   , i.quantidaderecebida as "Qtd Recebida" 
                   , i.quantidadeavariada as "Qtd Avariada"
                   , i.observacaoavaria as "Obs Avaria"
                   , '<a href="javascript:fnc_remove_pedido('||i.iditemcompratransferencia||');" class="vermelho"><span class="fa fa-remove fa-2x" aria-hidden="true"></span></a>' as del
                from itenscomprastransferencias i
                where i.idcompratransferencia = :P465_IDCOMPRATRANSFERENCIA
                order by i.iditemcompratransferencia
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 5140691850577861922
        }

