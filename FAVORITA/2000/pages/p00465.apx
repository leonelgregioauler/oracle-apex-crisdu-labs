    process anexa-nfe (
        name: Anexa NFe
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vid_remessa number := :P465_IDCOMPRATRANSFERENCIA;
                  vexists number;
                  --
                begin
                  --
                  for c in (select ar.name,
                                   ar.filename,
                                   ar.mime_type,
                                   ar.created_on,
                                   ar.blob_content
                            from apex_application_temp_files ar
                            order by 1)
                  loop
                    --
                        insert into anexoscomprastransferencias(idanexocompratransferencia,
                                                                idcompratransferencia,
                                                                attach_data,
                                                                attach_mimetype,
                                                                attach_filename,
                                                                attach_last_update,
                                                                attach_charset)
                        values(seq_idanexocompratransferencia.nextval,
                                                                vid_remessa,
                                                                c.blob_content,
                                                                c.mime_type,
                                                                c.filename,
                                                                c.created_on,
                                                                null);      
                     --
                  end loop;
                  --
                  delete
                  from apex_application_temp_files;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Ação Processada!
        }
        advanced {
            executionMappingIdentifier: 71296668775974050
        }
        serverSideCondition {
            type: request=Value
            value: ANEXAR_NFE
        }
    )

