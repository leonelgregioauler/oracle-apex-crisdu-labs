page 465 (
    name: Remessas de Uso e Consumo
    title: Remessas de Uso e Consumo
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_remove_pedido(pid_pedido) {
              apex.confirm("Deseja remover o item da remessa?", {
                request:"REMOVER_ITEM",
                set:{"P465_ID_ITEM_REMOVER":pid_pedido},
                showWait:true
                });  
            }
            
            function fnc_remove_nfe(pid_nfe_anexada) {
              apex.confirm("Deseja remover NF-e da remessa?", {
                request:"REMOVER_NFE",
                set:{"P465_ID_NFE_ANEXADA_REMOVER":pid_nfe_anexada},
                showWait:true
                });  
            }
            
            function imprimecompra() 
              {
                  vurl = document.getElementById("P465_URL_IMPRESSAO").value;
                  pjan = window.open(vurl,'page','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1280,height=1024,left=20,top=10','_blank'); void(0);
                  pjan.focus();
              }
            
            function imprimeRT() 
              {
                  vurl = document.getElementById("P465_SESSION_IMPRIMERT").value;
                  pjan = window.open(vurl,'page','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1280,height=1024,left=20,top=10','_blank'); void(0);
                  pjan.focus();
              }
            ```
    }
    css {
        inline:
            ```css
            a.vermelho:link, a.vermelho:visited, a.vermelho:hover, a.vermelho:active {
              text-decoration: none;
              color: #f00
              }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

