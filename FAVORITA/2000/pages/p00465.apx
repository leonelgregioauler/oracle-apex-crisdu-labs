        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                -- Created on 28/08/2020 by MAX.BERKEUER 
                declare 
                  --
                  vsituacao varchar2(30);
                  --
                begin
                  --
                  select st.descricao
                  into vsituacao
                  from situacoescomprastransferencias st
                  where st.idsituacaocompratransf = pck_comprastransf_fav_v2.fnc_proxima_situacao(:P465_IDTIPOCOMPTRANSREM,:P465_IDSITUACAO);
                  --
                  return vsituacao;
                  --
                exception
                  when no_data_found then
                    return 'Fluxo Finalizado';  
                end;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

