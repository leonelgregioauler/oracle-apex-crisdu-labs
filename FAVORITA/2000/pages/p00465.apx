    process próximo-passo (
        name: Próximo passo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vmsg_erro varchar(500);
                  vstatus boolean;
                  --
                begin
                  --
                  pck_comprastransf_fav_v2.prc_proximo_passo_compratransf(pidcompratransferencia => :P465_IDCOMPRATRANSFERENCIA,
                                                                          pstatus => vstatus,
                                                                          pmsg_erro => vmsg_erro);
                  --
                  if vstatus = false then
                    --
                    apex_error.add_error(p_message          => vmsg_erro,
                                         p_display_location => apex_error.c_inline_with_field_and_notif);
                    --
                  end if;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Ação Processada!
        }
        advanced {
            executionMappingIdentifier: 71294149909974025
        }
        serverSideCondition {
            type: request=Value
            value: PROXIMOPASSO
        }
    )

