            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_url varchar2(2000);
                    l_app number := 2000;
                    l_session number := v('APP_SESSION');
                BEGIN
                    l_url := APEX_UTIL.PREPARE_URL(
                        p_url => 'f?p=' || l_app || ':529:'||l_session||'::NO::P529_IDCOMPRATRANSFERENCIA:'||:P465_IDCOMPRATRANSFERENCIA,
                        p_checksum_type => 'SESSION');
                    
                    return l_url;
                END;
                ```
