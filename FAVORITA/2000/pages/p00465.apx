    region classificações (
        name: Classificações
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.dataclassificado as "Dt Classificação"
                     , c.nomeusuario as "Usuário"
                     , c.nomecaracteristica as "Característica"
                     , c.descricao as "Descrição"
                     , c.observacao as "Observação"
                from vw_classificacoescompras_fav c
                where c.idcompratransferencia = :P465_IDCOMPRATRANSFERENCIA
                  and c.ididioma = 1
                order by c.idclassificacaocompratransf
                ```
