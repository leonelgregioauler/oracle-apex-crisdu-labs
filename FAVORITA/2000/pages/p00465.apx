    region nota-fiscal (
        name: Nota Fiscal
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ar.idanexocompratransferencia,
                       ar.attach_filename as "Nome Arq",
                       sys.dbms_lob.getlength(ar.attach_data) as "Arquivo",
                       /*pck_util_fav.fnc_blob_para_xmltype(ar.attach_data) as file_xml,
                       replace(extractvalue(pck_util_fav.fnc_blob_para_xmltype(ar.attach_data),'nfeProc/NFe/infNFe/@Id',a.xmlns),'NFe') as "Chave",
                       extractvalue(pck_util_fav.fnc_blob_para_xmltype(ar.attach_data), 'nfeProc/NFe/infNFe/ide/serie', a.xmlns) as "Série",
                       extractvalue(pck_util_fav.fnc_blob_para_xmltype(ar.attach_data), 'nfeProc/NFe/infNFe/ide/nNF', a.xmlns) as "Número",
                       initcap(extractvalue(pck_util_fav.fnc_blob_para_xmltype(ar.attach_data),'nfeProc/NFe/infNFe/emit/xNome',a.xmlns)) as "Nome Emitente",
                       initcap(extractvalue(pck_util_fav.fnc_blob_para_xmltype(ar.attach_data),'nfeProc/NFe/infNFe/dest/xNome',a.xmlns)) as "Nome Destinatário",*/
                       '<a href="javascript:fnc_remove_nfe('||ar.idanexocompratransferencia||');" class="vermelho"><span class="fa fa-remove fa-2x" aria-hidden="true"></span></a>' as del       
                from anexoscomprastransferencias ar/*,
                     (select 'xmlns="http://www.portalfiscal.inf.br/nfe"' as xmlns
                     from dual) a*/
                where ar.idcompratransferencia = :P465_IDCOMPRATRANSFERENCIA
                order by 1
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
