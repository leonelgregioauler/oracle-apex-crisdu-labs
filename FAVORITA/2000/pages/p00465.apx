    pageItem P465_IDTIPOCOMPTRANSREM (
        type: selectList
        label {
            label: Tipo Remessa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select Initcap(t.descricao) d,
                       t.idtipocomptransrem r
