    region inadimplencia-por-canal-de-venda-resumido (
        name: Inadimplencia por Canal de Venda - Resumido
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with pago_em_dia as (
                    select ff.tipofilial,
                           sum(GREATEST(pp.valorpago, 0) * p_sub.fatorconversao) as valor_pago_em_dia
                      from favorita.pedidos p_sub,
                           favorita.vencimentospedidos v_sub,
                           favorita.pagamentospedidos pp,
                           favorita.filiaisfavorita ff,
                           ( select p.idpedido
                                  , p.idnotavenda
                                  , cc.idvalorcaracteristica
                               from favorita.pedidos p
                                  , roman.notasvendas n
                                  , roman.classificacoesnotasvendas cc
                              where :P605_SACOLA is not null -- (Maicon)Fiz essa manha para não pesar no relatório!
                                and n.idnotavenda = p.idnotavenda
                                and cc.idclassificacaonotavenda = (select max(c.idclassificacaonotavenda)
                                                                     from roman.classificacoesnotasvendas c
                                                                    where c.idnotavenda = n.idnotavenda
                                                                      and c.idcaracteristicanotavenda = 52)) sacola_do_dianho
                     where v_sub.idpedido = p_sub.idpedido
                       and p_sub.datacancelamento is null
                       -- FILTRO ATIVOS/INATIVOS
                       and (:P605_SIT_REPRE is null
                       or :P605_SIT_REPRE = 'T'
                            or (:P605_SIT_REPRE = 'A' and exists (select 1 from catal.representantes r
                                                                     where r.idrepresentante = p_sub.idrepresentante
                                                                       and r.ativo = 'S'))
                            or (:P605_SIT_REPRE = 'I' and exists (select 1 from catal.representantes r
                                                                     where r.idrepresentante = p_sub.idrepresentante
                                                                       and r.ativo = 'N')))
                       and sacola_do_dianho.idpedido(+) = p_sub.idpedido
                       and pp.idvencimentopedido = v_sub.idvencimentopedido
                       and ff.idfilialfavorita = p_sub.idfilialfavorita
                       and v_sub.situacaovencimento = 'V'
                       and pp.idsituacao != -1
                       and trunc(pp.datapagamento) <= trunc(v_sub.datavencimento)
                       -- filtros de tela
                       and (    (:P605_SACOLA is null)                                                 -- não filtra por sacola
                             or (:P605_SACOLA = 1 and sacola_do_dianho.idvalorcaracteristica = 1)      -- somente 1ª sacola
                             or (:P605_SACOLA = 2 and sacola_do_dianho.idvalorcaracteristica = 2)      -- somente 2ª sacola
                             or (:P605_SACOLA = 3 and sacola_do_dianho.idvalorcaracteristica = 3)      -- somente 3ª sacola
                             or (:P605_SACOLA = 4 and sacola_do_dianho.idvalorcaracteristica > 3)      -- todos a partir da 4ª sacola
                             or (:P605_SACOLA = 5 and sacola_do_dianho.idvalorcaracteristica is null)) -- sem sacola
                       and trunc(v_sub.datavencimento) between to_date(:P605_DATAINICIO, 'DD/MM/YYYY') and to_date(:P605_DATAFIM, 'DD/MM/YYYY')
                       and (:P605_TIPOPEDIDO is null or p_sub.tipopedido = :P605_TIPOPEDIDO)
                       and (:P605_FILTRARROMANCE is null or p_sub.idfilialromance in (select fil.idfilialromance
                                                                                        from favorita.filtrosempresasromance fil
                                                                                       where fil.idusuario = :P0_IDUSUARIO))
                       and (   (:P605_CAMPANHA is null)
                            or (:P605_CAMPANHA = 'P' and exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                   where cp.idpedido = p_sub.idpedido
                                                                     and cp.idcaracteristicapedido = 74))
                            or (:P605_CAMPANHA = 'V' and exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                   where cp.idpedido = p_sub.idpedido
                                                                     and cp.idcaracteristicapedido = 78))
                            or (:P605_CAMPANHA = 'W' and exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                   where cp.idpedido = p_sub.idpedido
                                                                     and cp.idcaracteristicapedido = 94))
                            or (:P605_CAMPANHA = 'B' and exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                   where cp.idpedido = p_sub.idpedido
                                                                     and cp.idcaracteristicapedido = 96))
                            or (:P605_CAMPANHA = 'A' and exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                   where cp.idpedido = p_sub.idpedido
                                                                     and cp.idcaracteristicapedido = 97)))
                     group by ff.tipofilial
                ),
                atraso_ate_21 as (
                    select ff.tipofilial,
                           sum((v_sub.valorpagar - v_sub.valorpago) * p_sub.fatorconversao) as valor_atrasado_ate_21
                      from favorita.pedidos p_sub,
                           favorita.vencimentospedidos v_sub,
                           favorita.filiaisfavorita ff,
                           ( select p.idpedido
                                  , p.idnotavenda
                                  , cc.idvalorcaracteristica
                               from favorita.pedidos p
                                  , roman.notasvendas n
                                  , roman.classificacoesnotasvendas cc
                              where :P605_SACOLA is not null -- (Maicon)Fiz essa manha para não pesar no relatório!
                                and n.idnotavenda = p.idnotavenda
                                and cc.idclassificacaonotavenda = (select max(c.idclassificacaonotavenda)
                                                                     from roman.classificacoesnotasvendas c
                                                                    where c.idnotavenda = n.idnotavenda
                                                                      and c.idcaracteristicanotavenda = 52)) sacola_do_dianho
                     where v_sub.idpedido = p_sub.idpedido
                       and p_sub.datacancelamento is null
                       -- FILTRO ATIVOS/INATIVOS
                       and (:P605_SIT_REPRE is null
                       or :P605_SIT_REPRE = 'T'
                            or (:P605_SIT_REPRE = 'A' and exists (select 1 from catal.representantes r
                                                                     where r.idrepresentante = p_sub.idrepresentante
                                                                       and r.ativo = 'S'))
                            or (:P605_SIT_REPRE = 'I' and exists (select 1 from catal.representantes r
                                                                     where r.idrepresentante = p_sub.idrepresentante
                                                                       and r.ativo = 'N')))
                       and sacola_do_dianho.idpedido(+) = p_sub.idpedido
                       and ff.idfilialfavorita = p_sub.idfilialfavorita
                       and nvl(v_sub.valorpagar, 0) > 0
                       and v_sub.valorpagar > v_sub.valorpago
                       and v_sub.situacaovencimento = 'V'
                       and trunc(sysdate) - v_sub.datavencimento between 1 and 21
                       -- filtros de tela
                       and (    (:P605_SACOLA is null)                                                 -- não filtra por sacola
                             or (:P605_SACOLA = 1 and sacola_do_dianho.idvalorcaracteristica = 1)      -- somente 1ª sacola
                             or (:P605_SACOLA = 2 and sacola_do_dianho.idvalorcaracteristica = 2)      -- somente 2ª sacola
                             or (:P605_SACOLA = 3 and sacola_do_dianho.idvalorcaracteristica = 3)      -- somente 3ª sacola
                             or (:P605_SACOLA = 4 and sacola_do_dianho.idvalorcaracteristica > 3)      -- todos a partir da 4ª sacola
                             or (:P605_SACOLA = 5 and sacola_do_dianho.idvalorcaracteristica is null)) -- sem sacola
                       and trunc(v_sub.datavencimento) between to_date(:P605_DATAINICIO, 'DD/MM/YYYY') and to_date(:P605_DATAFIM, 'DD/MM/YYYY')
                       and (:P605_TIPOPEDIDO is null or p_sub.tipopedido = :P605_TIPOPEDIDO)
                       and (:P605_FILTRARROMANCE is null or p_sub.idfilialromance in (select fil.idfilialromance
                                                                                        from favorita.filtrosempresasromance fil
                                                                                       where fil.idusuario = :P0_IDUSUARIO))
                       and (   (:P605_CAMPANHA is null)
                            or (:P605_CAMPANHA = 'P' and exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                   where cp.idpedido = p_sub.idpedido
                                                                     and cp.idcaracteristicapedido = 74))
                            or (:P605_CAMPANHA = 'V' and exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                   where cp.idpedido = p_sub.idpedido
                                                                     and cp.idcaracteristicapedido = 78))
                            or (:P605_CAMPANHA = 'W' and exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                   where cp.idpedido = p_sub.idpedido
                                                                     and cp.idcaracteristicapedido = 94))
                            or (:P605_CAMPANHA = 'B' and exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                   where cp.idpedido = p_sub.idpedido
                                                                     and cp.idcaracteristicapedido = 96))
                            or (:P605_CAMPANHA = 'A' and exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                   where cp.idpedido = p_sub.idpedido
                                                                     and cp.idcaracteristicapedido = 97)))
                     group by ff.tipofilial
                ),
                atraso_22_48 as (
                    select ff.tipofilial,
                           sum((v_sub.valorpagar - v_sub.valorpago) * p_sub.fatorconversao) as valor_atrasado_22_48
                      from favorita.pedidos p_sub,
                           favorita.vencimentospedidos v_sub,
                           favorita.filiaisfavorita ff,
                           ( select p.idpedido
                                  , p.idnotavenda
                                  , cc.idvalorcaracteristica
                               from favorita.pedidos p
                                  , roman.notasvendas n
                                  , roman.classificacoesnotasvendas cc
                              where :P605_SACOLA is not null -- (Maicon)Fiz essa manha para não pesar no relatório!
                                and n.idnotavenda = p.idnotavenda
                                and cc.idclassificacaonotavenda = (select max(c.idclassificacaonotavenda)
                                                                     from roman.classificacoesnotasvendas c
                                                                    where c.idnotavenda = n.idnotavenda
                                                                      and c.idcaracteristicanotavenda = 52)) sacola_do_dianho
                     where v_sub.idpedido = p_sub.idpedido
                       and p_sub.datacancelamento is null
                       -- FILTRO ATIVOS/INATIVOS
                       and (:P605_SIT_REPRE is null
                       or :P605_SIT_REPRE = 'T'
                            or (:P605_SIT_REPRE = 'A' and exists (select 1 from catal.representantes r
                                                                     where r.idrepresentante = p_sub.idrepresentante
                                                                       and r.ativo = 'S'))
                            or (:P605_SIT_REPRE = 'I' and exists (select 1 from catal.representantes r
                                                                     where r.idrepresentante = p_sub.idrepresentante
                                                                       and r.ativo = 'N')))
                       and sacola_do_dianho.idpedido(+) = p_sub.idpedido
                       and ff.idfilialfavorita = p_sub.idfilialfavorita
                       and nvl(v_sub.valorpagar, 0) > 0
                       and v_sub.valorpagar > v_sub.valorpago
                       and v_sub.situacaovencimento = 'V'
                       and trunc(sysdate) - v_sub.datavencimento between 22 and 48
                       -- filtros de tela
                       and (    (:P605_SACOLA is null)                                                 -- não filtra por sacola
                             or (:P605_SACOLA = 1 and sacola_do_dianho.idvalorcaracteristica = 1)      -- somente 1ª sacola
                             or (:P605_SACOLA = 2 and sacola_do_dianho.idvalorcaracteristica = 2)      -- somente 2ª sacola
                             or (:P605_SACOLA = 3 and sacola_do_dianho.idvalorcaracteristica = 3)      -- somente 3ª sacola
                             or (:P605_SACOLA = 4 and sacola_do_dianho.idvalorcaracteristica > 3)      -- todos a partir da 4ª sacola
                             or (:P605_SACOLA = 5 and sacola_do_dianho.idvalorcaracteristica is null)) -- sem sacola
                       and trunc(v_sub.datavencimento) between to_date(:P605_DATAINICIO, 'DD/MM/YYYY') and to_date(:P605_DATAFIM, 'DD/MM/YYYY')
                       and (:P605_TIPOPEDIDO is null or p_sub.tipopedido = :P605_TIPOPEDIDO)
                       and (:P605_FILTRARROMANCE is null or p_sub.idfilialromance in (select fil.idfilialromance
                                                                                        from favorita.filtrosempresasromance fil
                                                                                       where fil.idusuario = :P0_IDUSUARIO))
                       and (   (:P605_CAMPANHA is null)
                            or (:P605_CAMPANHA = 'P' and exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                   where cp.idpedido = p_sub.idpedido
                                                                     and cp.idcaracteristicapedido = 74))
                            or (:P605_CAMPANHA = 'V' and exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                   where cp.idpedido = p_sub.idpedido
                                                                     and cp.idcaracteristicapedido = 78))
                            or (:P605_CAMPANHA = 'W' and exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                   where cp.idpedido = p_sub.idpedido
                                                                     and cp.idcaracteristicapedido = 94))
                            or (:P605_CAMPANHA = 'B' and exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                   where cp.idpedido = p_sub.idpedido
                                                                     and cp.idcaracteristicapedido = 96))
                            or (:P605_CAMPANHA = 'A' and exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                   where cp.idpedido = p_sub.idpedido
                                                                     and cp.idcaracteristicapedido = 97)))
                     group by ff.tipofilial
                ),
                atraso_mais_48 as (
                    select ff.tipofilial,
                           sum((v_sub.valorpagar - v_sub.valorpago) * p_sub.fatorconversao) as valor_atrasado_mais_48
                      from favorita.pedidos p_sub,
                           favorita.vencimentospedidos v_sub,
                           favorita.filiaisfavorita ff,
                           ( select p.idpedido
                                  , p.idnotavenda
                                  , cc.idvalorcaracteristica
                               from favorita.pedidos p
                                  , roman.notasvendas n
                                  , roman.classificacoesnotasvendas cc
                              where :P605_SACOLA is not null -- (Maicon)Fiz essa manha para não pesar no relatório!
                                and n.idnotavenda = p.idnotavenda
                                and cc.idclassificacaonotavenda = (select max(c.idclassificacaonotavenda)
                                                                     from roman.classificacoesnotasvendas c
                                                                    where c.idnotavenda = n.idnotavenda
                                                                      and c.idcaracteristicanotavenda = 52)) sacola_do_dianho
                     where v_sub.idpedido = p_sub.idpedido
                       and p_sub.datacancelamento is null
                       -- FILTRO ATIVOS/INATIVOS
                       and (:P605_SIT_REPRE is null
                       or :P605_SIT_REPRE = 'T'
                            or (:P605_SIT_REPRE = 'A' and exists (select 1 from catal.representantes r
                                                                     where r.idrepresentante = p_sub.idrepresentante
                                                                       and r.ativo = 'S'))
                            or (:P605_SIT_REPRE = 'I' and exists (select 1 from catal.representantes r
                                                                     where r.idrepresentante = p_sub.idrepresentante
                                                                       and r.ativo = 'N')))
                       and sacola_do_dianho.idpedido(+) = p_sub.idpedido
                       and ff.idfilialfavorita = p_sub.idfilialfavorita
                       and nvl(v_sub.valorpagar, 0) > 0
                       and v_sub.valorpagar > v_sub.valorpago
                       and v_sub.situacaovencimento = 'V'
                       and trunc(sysdate) - v_sub.datavencimento > 48
                       -- filtros de tela
                       and (    (:P605_SACOLA is null)                                                 -- não filtra por sacola
                             or (:P605_SACOLA = 1 and sacola_do_dianho.idvalorcaracteristica = 1)      -- somente 1ª sacola
                             or (:P605_SACOLA = 2 and sacola_do_dianho.idvalorcaracteristica = 2)      -- somente 2ª sacola
                             or (:P605_SACOLA = 3 and sacola_do_dianho.idvalorcaracteristica = 3)      -- somente 3ª sacola
                             or (:P605_SACOLA = 4 and sacola_do_dianho.idvalorcaracteristica > 3)      -- todos a partir da 4ª sacola
                             or (:P605_SACOLA = 5 and sacola_do_dianho.idvalorcaracteristica is null)) -- sem sacola
                       and trunc(v_sub.datavencimento) between to_date(:P605_DATAINICIO, 'DD/MM/YYYY') and to_date(:P605_DATAFIM, 'DD/MM/YYYY')
                       and (:P605_TIPOPEDIDO is null or p_sub.tipopedido = :P605_TIPOPEDIDO)
                       and (:P605_FILTRARROMANCE is null or p_sub.idfilialromance in (select fil.idfilialromance
                                                                                        from favorita.filtrosempresasromance fil
                                                                                       where fil.idusuario = :P0_IDUSUARIO))
                       and (   (:P605_CAMPANHA is null)
                            or (:P605_CAMPANHA = 'P' and exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                   where cp.idpedido = p_sub.idpedido
                                                                     and cp.idcaracteristicapedido = 74))
                            or (:P605_CAMPANHA = 'V' and exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                   where cp.idpedido = p_sub.idpedido
                                                                     and cp.idcaracteristicapedido = 78))
                            or (:P605_CAMPANHA = 'W' and exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                   where cp.idpedido = p_sub.idpedido
                                                                     and cp.idcaracteristicapedido = 94))
                            or (:P605_CAMPANHA = 'B' and exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                   where cp.idpedido = p_sub.idpedido
                                                                     and cp.idcaracteristicapedido = 96))
                            or (:P605_CAMPANHA = 'A' and exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                   where cp.idpedido = p_sub.idpedido
                                                                     and cp.idcaracteristicapedido = 97)))
                     group by ff.tipofilial
                )
                select /* canal de vendas */
                       decode(f.tipofilial, 'C', 'Call Center', 'F', 'Favorita', 'E', 'Estoque', 'L', 'Loja', 'S', 'Site', 'V', 'Venda Direta') as "Canal Venda"
                     
                     /* quantidade de vencimentos */
                     , count(*) as "Qtd Venc."
                     
                     /* total a pagar */
                     , sum(v.valorpagar * p.fatorconversao) as "Total a Pagar"
                     
                     /* total pago */
                     , sum(v.valorpago * p.fatorconversao) as "Total Pago"
                     , nvl((sum(v.valorpago  * p.fatorconversao) * 100) / nullif(sum(v.valorpagar * p.fatorconversao),0),0) as "% Total Pago"
                     
                     /* valor pago em dia */
                     , nvl(ped.valor_pago_em_dia,0) as "Valor Pago Em Dia"
                     , nvl((ped.valor_pago_em_dia *100) / nullif(sum(v.valorpagar * p.fatorconversao),0),0) as "% Valor Pago Em Dia"
                     
                     /* em atraso até 21 dias */
                     , nvl(a21.valor_atrasado_ate_21,0) as "Atrasado Até 21 Dias"
                     , nvl((a21.valor_atrasado_ate_21 * 100) / nullif(sum(v.valorpagar * p.fatorconversao),0),0) as "% Atrasado Até 21 Dias"
                     
                     /* em atraso entre 22 e 48 dias */
                     , nvl(a48.valor_atrasado_22_48,0) as "Atrasado Entre 22 e 48 Dias"
                     , nvl((a48.valor_atrasado_22_48 * 100) / nullif(sum(v.valorpagar * p.fatorconversao),0),0) as "% Atrasado Entre 22 e 48 Dias"  
                        
                     /* em atraso a mais de 48 dias */
                     , nvl(a49.valor_atrasado_mais_48,0) as "Atrasado a Mais de 48 Dias"
                     , nvl((a49.valor_atrasado_mais_48 * 100) / nullif(sum(v.valorpagar * p.fatorconversao),0),0) as "% Atrasado a Mais de 48 Dias"  
                          
                  from favorita.pedidos p,
                       favorita.vencimentospedidos v,
                       favorita.filiaisfavorita f,
                       pago_em_dia ped,
                       atraso_ate_21 a21,
                       atraso_22_48 a48,
                       atraso_mais_48 a49,
                       ( select p.idpedido
                              , p.idnotavenda
                              , cc.idvalorcaracteristica
                           from favorita.pedidos p
                              , roman.notasvendas n
                              , roman.classificacoesnotasvendas cc
                          where :P605_SACOLA is not null -- (Maicon)Fiz essa manha para não pesar no relatório!
                            and n.idnotavenda = p.idnotavenda
                            and cc.idclassificacaonotavenda = (select max(c.idclassificacaonotavenda)
                                                                 from roman.classificacoesnotasvendas c
                                                                where c.idnotavenda = n.idnotavenda
                                                                  and c.idcaracteristicanotavenda = 52)) sacola_do_dianho
                 where v.idpedido = p.idpedido
                   and p.datacancelamento is null
                   -- FILTRO ATIVOS/INATIVOS
                   and (:P605_SIT_REPRE is null
                       or :P605_SIT_REPRE = 'T'
                        or (:P605_SIT_REPRE = 'A' and exists (select 1 from catal.representantes r
                                                                 where r.idrepresentante = p.idrepresentante
                                                                   and r.ativo = 'S'))
                        or (:P605_SIT_REPRE = 'I' and exists (select 1 from catal.representantes r
                                                                 where r.idrepresentante = p.idrepresentante
                                                                   and r.ativo = 'N')))
                   and sacola_do_dianho.idpedido(+) = p.idpedido
                   and f.idfilialfavorita = p.idfilialfavorita
                   and ped.tipofilial(+) = f.tipofilial
                   and a21.tipofilial(+) = f.tipofilial
                   and a48.tipofilial(+) = f.tipofilial
                   and a49.tipofilial(+) = f.tipofilial
                   and nvl(v.valorpagar, 0) > 0
                   and v.situacaovencimento = 'V'
                   -- filtros de tela
                   and (    (:P605_SACOLA is null)                                                 -- não filtra por sacola
                         or (:P605_SACOLA = 1 and sacola_do_dianho.idvalorcaracteristica = 1)      -- somente 1ª sacola
                         or (:P605_SACOLA = 2 and sacola_do_dianho.idvalorcaracteristica = 2)      -- somente 2ª sacola
                         or (:P605_SACOLA = 3 and sacola_do_dianho.idvalorcaracteristica = 3)      -- somente 3ª sacola
                         or (:P605_SACOLA = 4 and sacola_do_dianho.idvalorcaracteristica > 3)      -- todos a partir da 4ª sacola
                         or (:P605_SACOLA = 5 and sacola_do_dianho.idvalorcaracteristica is null)) -- sem sacola
                   and trunc(v.datavencimento) between to_date(:P605_DATAINICIO, 'DD/MM/YYYY') and to_date(:P605_DATAFIM, 'DD/MM/YYYY')
                   and (:P605_TIPOPEDIDO is null or p.tipopedido = :P605_TIPOPEDIDO)
                   and (:P605_FILTRARROMANCE is null or p.idfilialromance in (select fil.idfilialromance
                                                                                from favorita.filtrosempresasromance fil
                                                                               where fil.idusuario = :P0_IDUSUARIO))
                   and (   (:P605_CAMPANHA is null)
                        or (:P605_CAMPANHA = 'P' and exists ( select 1
                                                                from favorita.classificacoespedidos cp
                                                               where cp.idpedido = p.idpedido
                                                                 and cp.idcaracteristicapedido = 74))
                        or (:P605_CAMPANHA = 'V' and exists ( select 1
                                                                from favorita.classificacoespedidos cp
                                                               where cp.idpedido = p.idpedido
                                                                 and cp.idcaracteristicapedido = 78))
                        or (:P605_CAMPANHA = 'W' and exists ( select 1
                                                                from favorita.classificacoespedidos cp
                                                               where cp.idpedido = p.idpedido
                                                                 and cp.idcaracteristicapedido = 94))
                        or (:P605_CAMPANHA = 'B' and exists ( select 1
                                                                from favorita.classificacoespedidos cp
                                                               where cp.idpedido = p.idpedido
                                                                 and cp.idcaracteristicapedido = 96))
                        or (:P605_CAMPANHA = 'A' and exists ( select 1
                                                                from favorita.classificacoespedidos cp
                                                               where cp.idpedido = p.idpedido
                                                                 and cp.idcaracteristicapedido = 97)))
                 group by f.tipofilial, ped.valor_pago_em_dia, a21.valor_atrasado_ate_21, a48.valor_atrasado_22_48, a49.valor_atrasado_mais_48
                 order by 1
                ```
        }
