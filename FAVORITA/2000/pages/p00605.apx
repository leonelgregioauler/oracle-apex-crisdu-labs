    region inadimplência-por-empresa (
        name: Inadimplência por Empresa
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with 
                -- #CTE 1
                pago_em_dia as (
                    select p.idfilialromance,
                           p.idrepresentante,
                           sum(GREATEST(pp.valorpago, 0) * p.fatorconversao) as valor_pago_em_dia
                      from favorita.pedidos p,
                           favorita.vencimentospedidos v,
                           favorita.pagamentospedidos pp,
                           ( select p.idpedido
                                  , p.idnotavenda
                                  , cc.idvalorcaracteristica
                               from favorita.pedidos p
                                  , roman.notasvendas n
                                  , roman.classificacoesnotasvendas cc
                              where :P605_SACOLA is not null -- (Maicon)Fiz essa manha para não pesar no relatório!
                                and n.idnotavenda = p.idnotavenda
                                and cc.idclassificacaonotavenda = (select max(c.idclassificacaonotavenda)
                                                                     from roman.classificacoesnotasvendas c
                                                                    where c.idnotavenda = n.idnotavenda
                                                                      and c.idcaracteristicanotavenda = 52)) sacola_do_dianho
                     where v.idpedido = p.idpedido
                       and p.datacancelamento is null
                       and sacola_do_dianho.idpedido(+) = p.idpedido
                       and pp.idvencimentopedido = v.idvencimentopedido
                       and v.situacaovencimento = 'V'
                       and trunc(v.datavencimento) >= trunc(pp.datapagamento)
                       and pp.idsituacao != -1
                       -- Filtros de tela
                       and (    (:P605_SACOLA is null)                                                 -- não filtra por sacola
                             or (:P605_SACOLA = 1 and sacola_do_dianho.idvalorcaracteristica = 1)      -- somente 1ª sacola
                             or (:P605_SACOLA = 2 and sacola_do_dianho.idvalorcaracteristica = 2)      -- somente 2ª sacola
                             or (:P605_SACOLA = 3 and sacola_do_dianho.idvalorcaracteristica = 3)      -- somente 3ª sacola
                             or (:P605_SACOLA = 4 and sacola_do_dianho.idvalorcaracteristica > 3)      -- todos a partir da 4ª sacola
                             or (:P605_SACOLA = 5 and sacola_do_dianho.idvalorcaracteristica is null)) -- sem sacola
                       and trunc(v.datavencimento) between to_date(:P605_DATAINICIO, 'DD/MM/YYYY') and to_date(:P605_DATAFIM, 'DD/MM/YYYY')
                       and (:P605_TIPOPEDIDO is null or p.tipopedido = :P605_TIPOPEDIDO)
                       and (:P605_FILTRARROMANCE is null or p.idfilialromance in ( select fil.idfilialromance
                                                                                     from favorita.filtrosempresasromance fil
                                                                                    where fil.idusuario = :P0_IDUSUARIO))
                       and (   (:P605_CAMPANHA is null)
                            or (:P605_CAMPANHA = 'P' and exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                   where cp.idpedido = p.idpedido
                                                                     and cp.idcaracteristicapedido = 74))
                            or (:P605_CAMPANHA = 'V' and exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                   where cp.idpedido = p.idpedido
                                                                     and cp.idcaracteristicapedido = 78))
                            or (:P605_CAMPANHA = 'W' and exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                   where cp.idpedido = p.idpedido
                                                                     and cp.idcaracteristicapedido = 94))
                            or (:P605_CAMPANHA = 'B' and exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                   where cp.idpedido = p.idpedido
                                                                     and cp.idcaracteristicapedido = 96))
                            or (:P605_CAMPANHA = 'A' and exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                   where cp.idpedido = p.idpedido
                                                                     and cp.idcaracteristicapedido = 97)))
                     group by p.idfilialromance, p.idrepresentante
                ),
                -- #CTE 2
                valores_em_atraso as (
                    select 
                        p.idfilialromance,
                        p.idrepresentante,
                        case 
                            when (trunc(sysdate) - trunc(v.datavencimento)) between 1 and 21 then 'ATRASO_1_21'
                            when (trunc(sysdate) - trunc(v.datavencimento)) between 22 and 48 then 'ATRASO_22_48'
                            when (trunc(sysdate) - trunc(v.datavencimento)) >= 49 then 'ATRASO_49_MAIS'
                        end as faixa_atraso,
                        sum((v.valorpagar - v.valorpago)*p.fatorconversao) as valor
                      from favorita.pedidos p,
                           favorita.vencimentospedidos v,
                           ( select p.idpedido
                                  , p.idnotavenda
                                  , cc.idvalorcaracteristica
                               from favorita.pedidos p
                                  , roman.notasvendas n
                                  , roman.classificacoesnotasvendas cc
                              where :P605_SACOLA is not null -- (Maicon)Fiz essa manha para não pesar no relatório!
                                and n.idnotavenda = p.idnotavenda
                                and cc.idclassificacaonotavenda = (select max(c.idclassificacaonotavenda)
                                                                     from roman.classificacoesnotasvendas c
                                                                    where c.idnotavenda = n.idnotavenda
                                                                      and c.idcaracteristicanotavenda = 52)) sacola_do_dianho
                     where v.idpedido = p.idpedido
                       and p.datacancelamento is null
                       and sacola_do_dianho.idpedido(+) = p.idpedido
                       and v.situacaovencimento = 'V'
                       and v.valorpagar > v.valorpago
                       and (trunc(sysdate) - trunc(v.datavencimento)) >= 1
                       -- Filtros de tela
                       and (    (:P605_SACOLA is null)                                                 -- não filtra por sacola
                             or (:P605_SACOLA = 1 and sacola_do_dianho.idvalorcaracteristica = 1)      -- somente 1ª sacola
                             or (:P605_SACOLA = 2 and sacola_do_dianho.idvalorcaracteristica = 2)      -- somente 2ª sacola
                             or (:P605_SACOLA = 3 and sacola_do_dianho.idvalorcaracteristica = 3)      -- somente 3ª sacola
                             or (:P605_SACOLA = 4 and sacola_do_dianho.idvalorcaracteristica > 3)      -- todos a partir da 4ª sacola
                             or (:P605_SACOLA = 5 and sacola_do_dianho.idvalorcaracteristica is null)) -- sem sacola
                       and trunc(v.datavencimento) between to_date(:P605_DATAINICIO, 'DD/MM/YYYY') and to_date(:P605_DATAFIM, 'DD/MM/YYYY')
                       and (:P605_TIPOPEDIDO is null or p.tipopedido = :P605_TIPOPEDIDO)
                       and (:P605_FILTRARROMANCE is null or p.idfilialromance in (select fil.idfilialromance
                                                                                    from favorita.filtrosempresasromance fil
                                                                                   where fil.idusuario = :P0_IDUSUARIO))
                       and (   (:P605_CAMPANHA is null)
                            or (:P605_CAMPANHA = 'P' and exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                   where cp.idpedido = p.idpedido
                                                                     and cp.idcaracteristicapedido = 74))
                            or (:P605_CAMPANHA = 'V' and exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                   where cp.idpedido = p.idpedido
                                                                     and cp.idcaracteristicapedido = 78))
                            or (:P605_CAMPANHA = 'W' and exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                   where cp.idpedido = p.idpedido
                                                                     and cp.idcaracteristicapedido = 94))
                            or (:P605_CAMPANHA = 'B' and exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                   where cp.idpedido = p.idpedido
                                                                     and cp.idcaracteristicapedido = 96))
                            or (:P605_CAMPANHA = 'A' and exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                   where cp.idpedido = p.idpedido
                                                                     and cp.idcaracteristicapedido = 97)))
                     group by p.idfilialromance, p.idrepresentante, 
                              case 
                                  when (trunc(sysdate) - trunc(v.datavencimento)) between 1 and 21 then 'ATRASO_1_21'
                                  when (trunc(sysdate) - trunc(v.datavencimento)) between 22 and 48 then 'ATRASO_22_48'
                                  when (trunc(sysdate) - trunc(v.datavencimento)) >= 49 then 'ATRASO_49_MAIS'
                              end
                ),
                -- #CTE 3
                agregado_atraso as (
                    select 
                        idfilialromance,
                        idrepresentante,
                        sum(case when faixa_atraso = 'ATRASO_1_21' then valor else 0 end) as valor_atrasado_entre_1_e_21,
                        sum(case when faixa_atraso = 'ATRASO_22_48' then valor else 0 end) as valor_atrasado_entre_22_e_48,
                        sum(case when faixa_atraso = 'ATRASO_49_MAIS' then valor else 0 end) as valor_atrasado_a_mais_de_48_dias
                      from valores_em_atraso
                     group by idfilialromance, idrepresentante
                )
                -- #CTE 4 (para uso da query dos subtotais)
                , pago_em_dia_filial as (
                    select
                        idfilialromance,
                        sum(valor_pago_em_dia) as total_pago_em_dia
                    from pago_em_dia
                    group by idfilialromance
                )
                
                -- #CTE 5 (para uso da query dos subtotais)
                , agregado_atraso_filial as (
                    select
                        idfilialromance,
                        sum(valor_atrasado_entre_1_e_21) as total_atrasado_1_21,
                        sum(valor_atrasado_entre_22_e_48) as total_atrasado_22_48,
                        sum(valor_atrasado_a_mais_de_48_dias) as total_atrasado_49_mais
                    from agregado_atraso
                    group by idfilialromance
                )
                
                -- Query Oficial
                select
                    p.idfilialromance as "ID Filial",
                    favorita.pck_util_fav.fnc_nomefilialromance(p.idfilialromance) as "Filial Romance",
                    favorita.pck_util_fav.fnc_nomerepresentante(p.idrepresentante) as "Distribuidor",
                    p.idrepresentante as "ID Distribuidor",
                    count(v.idvencimentopedido) as "Qtd. Venc.",
                    sum(v.valorpagar * p.fatorconversao) as "Total a Pagar",
                    
                    sum(v.valorpago * p.fatorconversao) as "Total Pago",
                    round(((sum(v.valorpago * p.fatorconversao) * 100) / sum(v.valorpagar * p.fatorconversao)),2) as "% Total Pago",
                    
                    nvl(pag.valor_pago_em_dia, 0) as "Total Pago Em Dia",
                    round(((nvl(pag.valor_pago_em_dia, 0) * 100) / sum(v.valorpagar * p.fatorconversao)),2) as "% Total Pago Em Dia",
                    
                    nvl(atr.valor_atrasado_entre_1_e_21, 0) as "Vencido Até 21 Dias",
                    round(((nvl(atr.valor_atrasado_entre_1_e_21, 0) * 100) / sum(v.valorpagar * p.fatorconversao)),2) as "% Vencido Até 21 Dias",
                
                    nvl(atr.valor_atrasado_entre_22_e_48, 0) as "Vencido Entre 22 a 48 Dias",
                    round(((nvl(atr.valor_atrasado_entre_22_e_48, 0) * 100) / sum(v.valorpagar * p.fatorconversao)),2) as "% Vencido Entre 22 a 48 Dias",
                
                    nvl(atr.valor_atrasado_a_mais_de_48_dias, 0) as "Vencido a Mais de 48 Dias",
                    round(((nvl(atr.valor_atrasado_a_mais_de_48_dias, 0) * 100) / sum(v.valorpagar * p.fatorconversao)),2) as "% Vencido a Mais de 48 Dias",
                
                    1 as ordem -- <<< Essa é a coluna auxiliar de ordenação
                from favorita.pedidos p,
                     favorita.vencimentospedidos v,
                     pago_em_dia pag,
                     agregado_atraso atr,
                     ( select p.idpedido
                            , p.idnotavenda
                            , cc.idvalorcaracteristica
                         from favorita.pedidos p
                            , roman.notasvendas n
                            , roman.classificacoesnotasvendas cc
                        where :P605_SACOLA is not null -- (Maicon)Fiz essa manha para não pesar no relatório!
                          and n.idnotavenda = p.idnotavenda
                          and cc.idclassificacaonotavenda = (select max(c.idclassificacaonotavenda)
                                                               from roman.classificacoesnotasvendas c
                                                              where c.idnotavenda = n.idnotavenda
                                                                and c.idcaracteristicanotavenda = 52)) sacola_do_dianho
                where v.idpedido = p.idpedido
                  and sacola_do_dianho.idpedido(+) = p.idpedido
                  and pag.idfilialromance(+) = p.idfilialromance 
                  and pag.idrepresentante(+) = p.idrepresentante
                  and atr.idfilialromance(+) = p.idfilialromance
                  and atr.idrepresentante(+) = p.idrepresentante
                  and v.situacaovencimento = 'V'
                  and p.datacancelamento is null
                  and v.valorpagar > 0
                  -- FILTRO ATIVOS/INATIVOS
                  and (:P605_SIT_REPRE is null
                       or :P605_SIT_REPRE = 'T'
                       or (:P605_SIT_REPRE = 'A' and exists (select 1 from catal.representantes r
                                                                where r.idrepresentante = p.idrepresentante
                                                                  and r.ativo = 'S'))
                       or (:P605_SIT_REPRE = 'I' and exists (select 1 from catal.representantes r
                                                                where r.idrepresentante = p.idrepresentante
                                                                  and r.ativo = 'N')))
                  -- Filtros de tela
                  and (    (:P605_SACOLA is null)                                                 -- não filtra por sacola
                        or (:P605_SACOLA = 1 and sacola_do_dianho.idvalorcaracteristica = 1)      -- somente 1ª sacola
                        or (:P605_SACOLA = 2 and sacola_do_dianho.idvalorcaracteristica = 2)      -- somente 2ª sacola
                        or (:P605_SACOLA = 3 and sacola_do_dianho.idvalorcaracteristica = 3)      -- somente 3ª sacola
                        or (:P605_SACOLA = 4 and sacola_do_dianho.idvalorcaracteristica > 3)      -- todos a partir da 4ª sacola
                        or (:P605_SACOLA = 5 and sacola_do_dianho.idvalorcaracteristica is null)) -- sem sacola
                  and trunc(v.datavencimento) between to_date(:P605_DATAINICIO, 'DD/MM/YYYY') and to_date(:P605_DATAFIM, 'DD/MM/YYYY')
                  and (:P605_TIPOPEDIDO is null or p.tipopedido = :P605_TIPOPEDIDO)
                  and (:P605_FILTRARROMANCE is null or p.idfilialromance in ( select fil.idfilialromance
                                                                                from favorita.filtrosempresasromance fil
                                                                               where fil.idusuario = :P0_IDUSUARIO))
                  and (   (:P605_CAMPANHA is null)
                       or (:P605_CAMPANHA = 'P' and exists ( select 1
                                                               from favorita.classificacoespedidos cp
                                                              where cp.idpedido = p.idpedido
                                                                and cp.idcaracteristicapedido = 74))
                       or (:P605_CAMPANHA = 'V' and exists ( select 1
                                                               from favorita.classificacoespedidos cp
                                                              where cp.idpedido = p.idpedido
                                                                and cp.idcaracteristicapedido = 78))
                       or (:P605_CAMPANHA = 'W' and exists ( select 1
                                                               from favorita.classificacoespedidos cp
                                                              where cp.idpedido = p.idpedido
                                                                and cp.idcaracteristicapedido = 94))
                       or (:P605_CAMPANHA = 'B' and exists ( select 1
                                                               from favorita.classificacoespedidos cp
                                                              where cp.idpedido = p.idpedido
                                                                and cp.idcaracteristicapedido = 96))
                       or (:P605_CAMPANHA = 'A' and exists ( select 1
                                                               from favorita.classificacoespedidos cp
                                                              where cp.idpedido = p.idpedido
                                                                and cp.idcaracteristicapedido = 97)))
                group by
                    p.idfilialromance,
                    p.idrepresentante,
                    pag.valor_pago_em_dia,
                    atr.valor_atrasado_entre_1_e_21,
                    atr.valor_atrasado_entre_22_e_48,
                    atr.valor_atrasado_a_mais_de_48_dias
                
                union all
                -- Sub Totais por Filial
                select
                    p.idfilialromance as "ID Filial",
                    favorita.pck_util_fav.fnc_nomefilialromance(p.idfilialromance) as "Filial Romance",
                    'Sub Total' as "Distribuidor",
                    null as "ID Distribuidor",
                    count(distinct v.idvencimentopedido) as "Qtd. Venc.",
                    sum(v.valorpagar * p.fatorconversao) as "Total a Pagar",
                    sum(v.valorpago * p.fatorconversao) as "Total Pago",
                    round(((sum(v.valorpago * p.fatorconversao) * 100) / nullif(sum(v.valorpagar * p.fatorconversao),0)),2) as "% Total Pago",
                    
                    nvl(pf.total_pago_em_dia, 0) as "Total Pago Em Dia",
                    round(((nvl(pf.total_pago_em_dia,0) * 100) / nullif(sum(v.valorpagar * p.fatorconversao),0)),2) as "% Total Pago Em Dia",
                    
                    nvl(af.total_atrasado_1_21, 0) as "Vencido Até 21 Dias",
                    round(((nvl(af.total_atrasado_1_21,0) * 100) / nullif(sum(v.valorpagar * p.fatorconversao),0)),2) as "% Vencido Até 21 Dias",
                
                    nvl(af.total_atrasado_22_48, 0) as "Vencido Entre 22 a 48 Dias",
                    round(((nvl(af.total_atrasado_22_48,0) * 100) / nullif(sum(v.valorpagar * p.fatorconversao),0)),2) as "% Vencido Entre 22 a 48 Dias",
                
                    nvl(af.total_atrasado_49_mais, 0) as "Vencido a Mais de 48 Dias",
                    round(((nvl(af.total_atrasado_49_mais,0) * 100) / nullif(sum(v.valorpagar * p.fatorconversao),0)),2) as "% Vencido a Mais de 48 Dias",
                
                    2 as ordem
                from favorita.pedidos p,
                     favorita.vencimentospedidos v,
                     pago_em_dia_filial pf,
                     agregado_atraso_filial af,
                     ( select p.idpedido
                            , p.idnotavenda
                            , cc.idvalorcaracteristica
                         from favorita.pedidos p,
                              roman.notasvendas n,
                              roman.classificacoesnotasvendas cc
                        where :P605_SACOLA is not null
                          and n.idnotavenda = p.idnotavenda
                          and cc.idclassificacaonotavenda = (select max(c.idclassificacaonotavenda)
                                                               from roman.classificacoesnotasvendas c
                                                              where c.idnotavenda = n.idnotavenda
                                                                and c.idcaracteristicanotavenda = 52)) sacola_do_dianho
                where v.idpedido = p.idpedido
                  and sacola_do_dianho.idpedido(+) = p.idpedido
                  and pf.idfilialromance(+) = p.idfilialromance
                  and af.idfilialromance(+) = p.idfilialromance
                  and v.situacaovencimento = 'V'
                  and v.valorpagar > 0
                  and p.datacancelamento is null
                  -- FILTRO ATIVOS/INATIVOS
                  and (:P605_SIT_REPRE is null
                       or :P605_SIT_REPRE = 'T'
                       or (:P605_SIT_REPRE = 'A' and exists (select 1 from catal.representantes r
                                                                where r.idrepresentante = p.idrepresentante
                                                                  and r.ativo = 'S'))
                       or (:P605_SIT_REPRE = 'I' and exists (select 1 from catal.representantes r
                                                                where r.idrepresentante = p.idrepresentante
                                                                  and r.ativo = 'N')))
                  -- Filtros de tela
                  and (    (:P605_SACOLA is null)
                        or (:P605_SACOLA = 1 and sacola_do_dianho.idvalorcaracteristica = 1)
                        or (:P605_SACOLA = 2 and sacola_do_dianho.idvalorcaracteristica = 2)
                        or (:P605_SACOLA = 3 and sacola_do_dianho.idvalorcaracteristica = 3)
                        or (:P605_SACOLA = 4 and sacola_do_dianho.idvalorcaracteristica > 3)
                        or (:P605_SACOLA = 5 and sacola_do_dianho.idvalorcaracteristica is null))
                  and trunc(v.datavencimento) between to_date(:P605_DATAINICIO, 'DD/MM/YYYY') and to_date(:P605_DATAFIM, 'DD/MM/YYYY')
                  and (:P605_TIPOPEDIDO is null or p.tipopedido = :P605_TIPOPEDIDO)
                  and (:P605_FILTRARROMANCE is null or p.idfilialromance in ( select fil.idfilialromance
                                                                                from favorita.filtrosempresasromance fil
                                                                               where fil.idusuario = :P0_IDUSUARIO))
                  and (   (:P605_CAMPANHA is null)
                       or (:P605_CAMPANHA = 'P' and exists ( select 1
                                                               from favorita.classificacoespedidos cp
                                                              where cp.idpedido = p.idpedido
                                                                and cp.idcaracteristicapedido = 74))
                       or (:P605_CAMPANHA = 'V' and exists ( select 1
                                                               from favorita.classificacoespedidos cp
                                                              where cp.idpedido = p.idpedido
                                                                and cp.idcaracteristicapedido = 78))
                       or (:P605_CAMPANHA = 'W' and exists ( select 1
                                                               from favorita.classificacoespedidos cp
                                                              where cp.idpedido = p.idpedido
                                                                and cp.idcaracteristicapedido = 94))
                       or (:P605_CAMPANHA = 'B' and exists ( select 1
                                                               from favorita.classificacoespedidos cp
                                                              where cp.idpedido = p.idpedido
                                                                and cp.idcaracteristicapedido = 96))
                       or (:P605_CAMPANHA = 'A' and exists ( select 1
                                                               from favorita.classificacoespedidos cp
                                                              where cp.idpedido = p.idpedido
                                                                and cp.idcaracteristicapedido = 97)))
                group by p.idfilialromance,
                         pf.total_pago_em_dia,
                         af.total_atrasado_1_21,
                         af.total_atrasado_22_48,
                         af.total_atrasado_49_mais
                order by 1, ordem, 2;
                ```
        }
