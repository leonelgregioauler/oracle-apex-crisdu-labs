page 104 (
    name: Cadastro de Fluxogramas e Situações Fluxogramas Pedidos
    title: Fluxogramas Pedidos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region fluxogramas-pedidos (
        name: Fluxogramas Pedidos
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    region situações-fluxogramas-pedidos (
        name: Situações Fluxogramas Pedidos
        type: tabform
        source {
            sqlQuery:
                ```sql
                select idsituacaofluxogramapedido
                     , idfluxogramapedido
                     , idsituacao
                     , ordem
                from situacoesfluxogramaspedidos
                where idfluxogramapedido = :P104_IDFLUXOGRAMAPEDIDO;
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
                t-Form--xlarge
                t-Form--stretchInputs
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P104_IDFLUXOGRAMAPEDIDO
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column CHECK$01 (
            reportColumnQueryId: 5
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: &nbsp;
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
        )

        column IDFLUXOGRAMAPEDIDO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 3
            }
            default {
                type: item
                item: P104_IDFLUXOGRAMAPEDIDO
            }
        )

        column IDSITUACAO (
            reportColumnQueryId: 3
            derivedColumn: N
            type: selectList
            heading {
                heading: Situações
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @lov-situacoesfluxograma
                nullDisplayValue: - Selecione uma situação -
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
            advanced {
                cellWidth: 800
            }
        )

        column IDSITUACAOFLUXOGRAMAPEDIDO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDSITFLUXOGRAMAPED
            }
        )

        column ORDEM (
            reportColumnQueryId: 4
            derivedColumn: N
            type: textField
            heading {
                heading: Ordem
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
        )

    )

    pageItem P104_DESCRICAO (
        type: textField
        label {
            label: Descrição
            alignment: left
        }
        layout {
            sequence: 30
            region: @fluxogramas-pedidos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P104_IDFLUXOGRAMAPEDIDO (
        type: hidden
        layout {
            sequence: 10
            region: @fluxogramas-pedidos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P104_IDTIPOCOMPTRANSREM (
        type: selectList
        label {
            label: Tipo de C/T/R/P
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_retornatipocomptransrem(t.idtipocomptransrem,:P0_IDIDIOMA) display_value
                 , t.idtipocomptransrem return_value
                from tiposcomptransrem t
                order by 1 desc
                ```
        }
        layout {
            sequence: 50
            region: @fluxogramas-pedidos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P104_MD5 (
        type: hidden
        layout {
            sequence: 60
            region: @fluxogramas-pedidos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P104_NOME (
        type: textField
        label {
            label: Nome
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @fluxogramas-pedidos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P104_OPERACAO_DML (
        type: hidden
        layout {
            sequence: 70
            region: @fluxogramas-pedidos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P104_TIPOSITUACAO (
        type: selectList
        label {
            label: Tipo de Situação
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-tipossituacoesfluxograma
            nullDisplayValue: - Selecione um tipo de Situação -
        }
        layout {
            sequence: 40
            region: @fluxogramas-pedidos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button adicionarlinha (
        buttonName: ADICIONARLINHA
        label: Adicionar Linha
        layout {
            sequence: 20
            region: @situações-fluxogramas-pedidos
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.widget.tabular.addRow();
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 40
            region: @fluxogramas-pedidos
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P104_IDFLUXOGRAMAPEDIDO
        }
    )

    button excluirlinha (
        buttonName: EXCLUIRLINHA
        label: Excluir
        layout {
            sequence: 10
            region: @situações-fluxogramas-pedidos
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIRLINHA');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from situacoesfluxogramaspedidos
                where idfluxogramapedido = :P104_IDFLUXOGRAMAPEDIDO;
                ```
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 20
            region: @fluxogramas-pedidos
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P104_IDFLUXOGRAMAPEDIDO
        }
    )

    button inseriratualizar (
        buttonName: INSERIRATUALIZAR
        label: Inserir / Atualizar
        layout {
            sequence: 30
            region: @situações-fluxogramas-pedidos
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @fluxogramas-pedidos
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P104_IDFLUXOGRAMAPEDIDO
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 30
            region: @fluxogramas-pedidos
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-reply
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 103
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation idsituacao-numérico (
        name: IDSITUACAO numérico
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @situações-fluxogramas-pedidos
            type: columnIsNumeric
            column: IDSITUACAO
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ser numérico.
            associatedColumn: IDSITUACAO
        }
    )

    validation nome-obrigatório (
        name: NOME obrigatório
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P104_NOME
        }
        error {
            errorMessage: Nome deve ter um valor.
            associatedItem: @P104_NOME
        }
    )

    validation ordem-numérico (
        name: ORDEM numérico
        execution {
            sequence: 20
        }
        validation {
            editableRegion: @situações-fluxogramas-pedidos
            type: columnIsNumeric
            column: ORDEM
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ser numérico.
            associatedColumn: ORDEM
        }
    )

    validation ordem-obrigatório (
        name: ORDEM obrigatório
        execution {
            sequence: 60
        }
        validation {
            editableRegion: @situações-fluxogramas-pedidos
            type: columnIsNotNull
            column: ORDEM
            alwaysExecute: true
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ter um valor.
            associatedColumn: ORDEM
        }
    )

    validation situacao-obrigatório (
        name: SITUACAO obrigatório
        execution {
            sequence: 50
        }
        validation {
            editableRegion: @situações-fluxogramas-pedidos
            type: columnIsNotNull
            column: IDSITUACAO
            alwaysExecute: true
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ter um valor.
            associatedColumn: IDSITUACAO
        }
    )

    validation tiposituacao-obrigatório (
        name: TIPOSITUACAO obrigatório
        execution {
            sequence: 40
        }
        validation {
            type: itemIsNotNull
            item: P104_TIPOSITUACAO
        }
        error {
            errorMessage: Tipo de Situação deve ter um valor.
            associatedItem: @P104_TIPOSITUACAO
        }
    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @situações-fluxogramas-pedidos
        target {
            tableName: SITUACOESFLUXOGRAMASPEDIDOS
            pkColumn: IDSITUACAOFLUXOGRAMAPEDIDO
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: #MRD_COUNT# registro(s) excluído(s).
        }
        error {
            errorMessage: Não é possível excluir este registro pois existe outra informação associada com esta sendo utilizada no sistema.
        }
        advanced {
            executionMappingIdentifier: 14552939271925014
        }
        serverSideCondition {
            whenButtonPressed: @excluirlinha
            type: request=Value
            value: EXCLUIRLINHA
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @situações-fluxogramas-pedidos
        target {
            tableName: SITUACOESFLUXOGRAMASPEDIDOS
            pkColumn: IDSITUACAOFLUXOGRAMAPEDIDO
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: #MRU_COUNT# registro(s) atualizado(s), #MRI_COUNT# registro(s) inserido(s).
        }
        error {
            errorMessage: Informações incorretas.
        }
        advanced {
            executionMappingIdentifier: 14552816381925013
        }
        serverSideCondition {
            whenButtonPressed: @inseriratualizar
            type: request=Value
            value: INSERIRATUALIZAR
        }
    )

    process consulta-fluxogramas-pedidos (
        name: Consulta Fluxogramas Pedidos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                #OWNER#.PCK_CADASTROS_FAV.PRC_FLUXOGRAMASPEDIDOS (
                  PIDFLUXOGRAMAPEDIDO => :P104_IDFLUXOGRAMAPEDIDO,
                  PNOME => :P104_NOME,
                  PDESCRICAO => :P104_DESCRICAO,
                  PTIPOSITUACAO => :P104_TIPOSITUACAO,
                  pidtipocomptransrem => :P104_IDTIPOCOMPTRANSREM,
                  PMD5 => :P104_MD5,
                  POPERACAO_DML => 'S');
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 14117479504015320
        }
    )

    process limpar-campos-ao-sair (
        name: Limpar Campos ao Sair
        type: clearSessionState
        execution {
            sequence: 10
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 14117524067015321
        }
    )

    process limpar-campos-para-adicionar (
        name: Limpar Campos para Adicionar
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 14117836179015324
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    process operação-dml-em-fluxogramas-pedidos (
        name: Operação DML em Fluxogramas Pedidos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  #OWNER#.PCK_CADASTROS_FAV.PRC_FLUXOGRAMASPEDIDOS(
                    PIDFLUXOGRAMAPEDIDO => :P104_IDFLUXOGRAMAPEDIDO,
                    PNOME => :P104_NOME,
                    PDESCRICAO => :P104_DESCRICAO,
                    PTIPOSITUACAO => :P104_TIPOSITUACAO,
                    pidtipocomptransrem => :P104_IDTIPOCOMPTRANSREM,
                    PMD5 => :P104_MD5,
                    POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 14455083957916450
        }
    )

    branch (
        name: Go To Page 104
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 104
            }
        }
    )

)

