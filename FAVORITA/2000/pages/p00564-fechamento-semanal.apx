page 564 (
    name: Fechamento Semanal
    alias: FECHAMENTO-SEMANAL
    title: Fechamento Semanal
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }

    region aviso-valores-congelados (
        name: Aviso Valores Congelados
        type: staticContent
        layout {
            sequence: 60
            slot: fullWidthContent
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region concluir (
        name: Concluir
        type: staticContent
        layout {
            sequence: 50
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region fechamento (
        name: Fechamento
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region limite-gaveta (
        name: Limite Gaveta
        type: staticContent
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region observações-da-controladoria (
        name: Observações da Controladoria
        type: staticContent
        layout {
            sequence: 40
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P564_CONCLUIDO (
        type: textField
        label {
            label: Concluido
            alignment: left
        }
        layout {
            sequence: 50
            region: @fechamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P564_FATORCONVERSAO (
        type: textField
        label {
            label: Fatorconversao
            alignment: left
        }
        layout {
            sequence: 30
            region: @fechamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P564_IDFILIALFAVORITA (
        type: textField
        label {
            label: Idfilialfavorita
            alignment: left
        }
        layout {
            sequence: 20
            region: @fechamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P564_MSG (
        type: textField
        label {
            label: Msg
            alignment: left
        }
        layout {
            sequence: 10
            region: @fechamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P564_SALDOANTERIORGAVETA (
        type: textField
        label {
            label: Saldoanteriorgaveta
            alignment: left
        }
        layout {
            sequence: 60
            region: @fechamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P564_SEMANA (
        type: textField
        label {
            label: Semana
            alignment: left
        }
        layout {
            sequence: 40
            region: @fechamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P564_SEPARA00 (
        type: textField
        label {
            label: Separa00
            alignment: left
        }
        layout {
            sequence: 70
            region: @fechamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P564_VALOR_CONGELADO (
        type: displayOnly
        label {
            alignment: left
        }
        layout {
            sequence: 10
            region: @aviso-valores-congelados
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<font color=blue><h3>Fechamento anterior finalizado com R$ '||trim(to_char(f.valorsaldoanteriorcongelado,'999G999G999G999G999G999G990D00'))||' no dia '||to_char(f.datasaldoanteriorcongelado,'DD/MM/RRRR HH24:MI:SS')||'</font></h3>' display
                from fechamentossemanais f
                where f.idsemana = ( select ff.idsemana
                                     from fechamentossemanais ff
                                     where ff.idfechamento = :P564_IDFECHAMENTO
                                       and ff.idfilialfavorita = :P0_IDFILIALCAIXA ) -1
                  and f.valorsaldoanteriorcongelado is not null
                  and f.idfilialfavorita = :P0_IDFILIALCAIXA
                ```
        }
    )

)

