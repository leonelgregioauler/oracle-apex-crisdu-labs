                flex-wrap:wrap;
            
                gap:20px 24px;
            
                margin-right:20px;
            
            }
            
            .bb-donut-card{
            
                display:flex;
                flex-direction:column;
            
                align-items:center;
            
                transition:transform .18s ease,
                           filter .18s ease;
            
            }
            
            .bb-donut-card:hover{
            
                transform:translateY(-2px);
            
            }
            
            .bb-donut{
            
                width:110px;
                height:110px;
            
                border-radius:50%;
                border:2px solid #f1f5f9;
            
                background:#e5e7eb;
            
                display:flex;
                align-items:center;
                justify-content:center;
            
                 box-shadow:
                    0 6px 14px rgba(0,0,0,0.08),
                    inset 0 2px 4px rgba(255,255,255,0.7);
            
                transition:
                    transform .25s ease,
                    box-shadow .25s ease;
            
            }
            
            .bb-donut-card:hover .bb-donut{
            
                transform:scale(1.04);
            
                box-shadow:
                    0 10px 20px rgba(0,0,0,0.12),
                    inset 0 2px 4px rgba(255,255,255,0.8);
            
            }
            
            .bb-donut-card:hover .bb-donut-inner{
            
                box-shadow:
                    0 8px 16px rgba(0,0,0,0.12),
                    inset 0 1px 2px rgba(255,255,255,0.9);
            
            }
            
            .bb-donut::after{
            
                content:"";
                position:absolute;
            
                width:110px;
                height:110px;
            
                border-radius:50%;
            
                background:radial-gradient(
                    circle at 30% 25%,
                    rgba(255,255,255,0.35),
                    transparent 60%
                );
            
                pointer-events:none;
            
            }
            
            .bb-donut-inner{
            
                width:72px;
                height:72px;
            
                background:white;
            
                border-radius:50%;
            
                display:flex;
                flex-direction:column;
            
                align-items:center;
                justify-content:center;
            
                box-shadow:
                    0 6px 12px rgba(0,0,0,0.10),
                    inset 0 1px 2px rgba(255,255,255,0.8);
            
            }
            
            .bb-donut-value{
            
