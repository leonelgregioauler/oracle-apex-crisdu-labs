            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P692_RECEBIMENTO_ERRO (
        type: hidden
        layout {
            sequence: 150
            slot: body
        }
    )

    pageItem P692_RECEBIMENTO_OK (
        type: hidden
        layout {
            sequence: 140
            slot: body
        }
    )

    pageItem P692_STATUS (
        type: popupLov
        label {
            label: Status
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display, ret from (
                select 'Processado' display, 'PROCESSADO' ret from dual
                union all
                select 'Erro' display, 'ERRO' ret from dual
                )
                ```
            nullDisplayValue: Todos
        }
        layout {
            sequence: 95
            slot: body
            alignment: left
            startNewRow: false
            columnSpan: 2
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P692_TOTAL_ERRO (
        type: hidden
        layout {
            sequence: 225
            slot: body
        }
    )

    pageItem P692_TOTAL_OK (
        type: hidden
        layout {
            sequence: 215
            slot: body
        }
    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P692_OPERACAO
                P692_STATUS
                P692_DATA_INICIAL
                P692_DATA_FINAL
                P692_COMPRATRANSFERENCIA
            ]
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process busca-totais (
        name: Busca Totais
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                    v_login_ok       NUMBER := 0;
                    v_login_erro     NUMBER := 0;
                
                    v_consulta_ok    NUMBER := 0;
                    v_consulta_erro  NUMBER := 0;
                
                    v_receb_ok       NUMBER := 0;
                    v_receb_erro     NUMBER := 0;
                
                    v_descarga_compra_ok    NUMBER := 0;
                    v_descarga_compra_erro  NUMBER := 0;
                
                    v_descarga_transf_ok    NUMBER := 0;
                    v_descarga_transf_erro  NUMBER := 0;
                
                    v_mov_ok         NUMBER := 0;
                    v_mov_erro       NUMBER := 0;
                
                BEGIN
                
                    FOR r IN (
                        SELECT
                            operacao,
                            status_processamento,
                            COUNT(*) qtd
                        FROM favorita.rfid_log_integracao
                        WHERE (dt_requisicao >= :P692_DATA_INICIAL OR :P692_DATA_INICIAL IS NULL)
                        GROUP BY operacao, status_processamento
                    )
                    LOOP
                
                        IF r.operacao = 'LOGIN' THEN
                
                            IF r.status_processamento = 'ERRO' THEN
                                v_login_erro := v_login_erro + r.qtd;
                            ELSE
                                v_login_ok := v_login_ok + r.qtd;
                            END IF;
                
                        ELSIF r.operacao IN ('CONSULTA_PRODUTO',
                                          'CONSULTA_COMPRATRANSFERENCIA','COMPRATRANSFERENCIA_LIBERADAS') THEN
                
                            IF r.status_processamento = 'ERRO' THEN
                                v_consulta_erro := v_consulta_erro + r.qtd;
                            ELSE
                                v_consulta_ok := v_consulta_ok + r.qtd;
                            END IF;
                
                        ELSIF r.operacao = 'PROCESSA_RECEBIMENTO' THEN
                
                            IF r.status_processamento = 'ERRO' THEN
                                v_receb_erro := v_receb_erro + r.qtd;
                            ELSE
                                v_receb_ok := v_receb_ok + r.qtd;
                            END IF;
                
                        ELSIF r.operacao = 'DESCARREGA_RFID_COMPRA' THEN
                
                            IF r.status_processamento = 'ERRO' THEN
                                v_descarga_compra_erro := v_descarga_compra_erro + r.qtd;
                            ELSE
                                v_descarga_compra_ok := v_descarga_compra_ok + r.qtd;
                            END IF;
                
                        ELSIF r.operacao = 'DESCARREGA_RFID_TRANSFERENCIA' THEN
                
                            IF r.status_processamento = 'ERRO' THEN
                                v_descarga_transf_erro := v_descarga_transf_erro + r.qtd;
                            ELSE
                                v_descarga_transf_ok := v_descarga_transf_ok + r.qtd;
                            END IF;
                
                        ELSIF r.operacao = 'MOVIMENTA_ESTOQUE' THEN
                
                            IF r.status_processamento = 'ERRO' THEN
                                v_mov_erro := v_mov_erro + r.qtd;
                            ELSE
                                v_mov_ok := v_mov_ok + r.qtd;
                            END IF;
                
                        END IF;
                
                    END LOOP;
                
                    :P692_LOGIN_OK   := v_login_ok;
                    :P692_LOGIN_ERRO := v_login_erro;
                
                    :P692_CONSULTA_OK   := v_consulta_ok;
                    :P692_CONSULTA_ERRO := v_consulta_erro;
                
                    :P692_RECEBIMENTO_OK   := v_receb_ok;
                    :P692_RECEBIMENTO_ERRO := v_receb_erro;
                
                    :P692_DESCARGA_OK   := v_descarga_compra_ok;
                    :P692_DESCARGA_ERRO := v_descarga_compra_erro;
                
                    :P692_DESCARGA_TRANSF_OK   := v_descarga_transf_ok;
                    :P692_DESCARGA_TRANSF_ERRO := v_descarga_transf_erro;
                
                    :P692_MOV_OK   := v_mov_ok;
                    :P692_MOV_ERRO := v_mov_erro;
                
                    :P692_TOTAL_OK :=
                        v_login_ok + v_consulta_ok + v_receb_ok + v_descarga_compra_ok + v_descarga_transf_ok + v_mov_ok;
                
                    :P692_TOTAL_ERRO :=
                        v_login_erro + v_consulta_erro + v_receb_erro + v_descarga_compra_erro + v_descarga_transf_erro + v_mov_erro;
                
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 2624709430934599321
        }
    )

)

