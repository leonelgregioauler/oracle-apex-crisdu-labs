    region log-integração-rfid (
        name: Log - Integração RFID
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    CASE 
                        WHEN l.status_processamento <> 'PROCESSADO' THEN 
                            '<span class="fa fa-times-circle status-erro"></span>'
                        ELSE
                            '<span class="fa fa-check-circle status-ok"></span>'
                    END AS status_icon,
                    l.*
                FROM favorita.rfid_log_integracao l
                WHERE (:P692_OPERACAO IS NULL OR l.operacao = :P692_OPERACAO)
                  AND (:P692_STATUS IS NULL OR l.status_processamento = :P692_STATUS)
                  AND (:P692_DATA_INICIAL IS NULL OR TRUNC(l.dt_requisicao) BETWEEN :P692_DATA_INICIAL AND :P692_DATA_FINAL)
                  AND (:P692_COMPRATRANSFERENCIA IS NULL OR l.idcompratransferencia = :P692_COMPRATRANSFERENCIA)
                ORDER BY l.id_log DESC
                ```
        }
        layout {
            sequence: 110
            slot: body
            rowCssClasses: #RESP_STATUS#
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
