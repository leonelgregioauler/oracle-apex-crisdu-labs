        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idprecoitemkitvenda
                     , iditemkitvenda
                     , idedicaorevista
                     , valorvendaoriginal
                     , valorvenda
                     , perccomissaogerente     
                     , perccomissaodistribuidor
                     , perccomissaoconsultora  
                     , valorcomissaoatendente  
                from precositenskitsvendas
                where iditemkitvenda = :P145_IDITEMKITVENDA;
                ```
        }
