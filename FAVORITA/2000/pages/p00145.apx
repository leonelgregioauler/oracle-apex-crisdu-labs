    validation valida-existe-ediçao (
        name: Valida Existe Ediçao
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @cadastro-preços-itens-kit-edição-revista
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  vexist number;
                  --
                begin  
                     case :APEX$ROW_STATUS  
                     when 'C' then
                       --
                       select count(1)
                       into vexist
                       from favorita.precositenskitsvendas pr
                          , favorita.itenskitsvendas i
                       where pr.iditemkitvenda = i.iditemkitvenda
                         and pr.idedicaorevista = :IDEDICAOREVISTA
                         and pr.iditemkitvenda = :IDITEMKITVENDA;
                       --
                       if vexist > 0 then
                         --
                         return 'Já existe preço para essa edição!';
                         --
                       end if;
                       --
                     when 'U' then  
                         null;
                     when 'D' then  
                         null;
                     end case;  
                end;
                ```
        }
    )

    process ajusta-preco (
        name: Ajusta Preco
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vvalorvenda               number;
                  vperccomissaoconsultora   number;
                  vperccomissaodistribuidor number;
                  vperccomissaogerente      number;
                  --
                begin
                  --
                  for rprec in ( select pik.valorvendaoriginal,
                                        pik.perccomissaogerente,
                                        pik.perccomissaodistribuidor,
                                        pik.perccomissaoconsultora,
                                        pik.valorcomissaoatendente,
                                        pik.idedicaorevista,
                                        i.idprodutodetalhado,
                                        1 idpais
                                 from favorita.precositenskitsvendas pik
                                    , favorita.itenskitsvendas i
                                 where pik.iditemkitvenda = i.iditemkitvenda 
                                   and i.iditemkitvenda = :P145_IDITEMKITVENDA)
                  loop
                    --
                    select a.a.valorvenda
                     , a.a.perccomissaoconsultora
                     , a.a.perccomissaodistribuidor
                     , a.a.perccomissaogerente
                    into 
                       vvalorvenda
                     , vperccomissaoconsultora
                     , vperccomissaodistribuidor
                     , vperccomissaogerente
                    from(
                    select favorita.pck_integracao_fav_widecomm.fnc_buscavalorcomdesconto( pidedicaorevista    => rprec.idedicaorevista
                                                                                         , pidprodutodetalhado => rprec.idprodutodetalhado
                                                                                         , pidpais             => rprec.idpais) a
                    from dual)a;
                    --
                    update precositenskitsvendas pik
                      set pik.valorvendaoriginal       = vvalorvenda
                        , pik.perccomissaoconsultora   = vperccomissaoconsultora
                        , pik.perccomissaodistribuidor = vperccomissaodistribuidor
                        , pik.perccomissaogerente      = vperccomissaogerente
                    where pik.iditemkitvenda = :P145_IDITEMKITVENDA
                      and pik.idedicaorevista = rprec.idedicaorevista;
                    --
                    commit;
                    --
                  end loop;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 113382025042208710
        }
    )

