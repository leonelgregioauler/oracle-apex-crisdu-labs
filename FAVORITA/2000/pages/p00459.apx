page 459 (
    name: Impressão Pré Lista de Postagem - PLP Detalhada
    title: Impressão Pré Lista de Postagem - PLP Detalhada
    appearance {
        pageTemplate: @imprimir
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region impressão-pré-lista-de-postagem-detalhada (
        name: Impressão Pré Lista de Postagem Detalhada
        type: plSqlDynamicContent
        source {
            plsqlCode: pck_correios_fav.prc_imprimeplpdetalhada (:P459_IDPRELISTAPOSTAGEM);
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P459_IDPRELISTAPOSTAGEM (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @impressão-pré-lista-de-postagem-detalhada
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

