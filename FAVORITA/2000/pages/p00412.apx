page 412 (
    name: Dados Operadora Cartão Crédito
    title: Dados Operadora Cartão Crédito
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/wizard-modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 80%
        height: 60%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region dados-envio-operadora-cartão-crédito (
        name: Dados Envio Operadora Cartão Crédito
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select valortotal
                	 , quantidadeparcelas
                from pagamentospedidos pp
                   , xmltable ( '/json'
                                 passing apex_json.to_xmltype(pp.enviooperadora)
                                 columns
                                   valortotal            varchar2(20)    path 'valorTotal'
                                 , quantidadeparcelas    number          path 'qtdParcelas' )
                where pp.idpagamentopedido = :P412_IDPAGAMENTOPEDIDO
                and pp.retornooperadora is not null;
                ```
        }
        layout {
            sequence: 10
            slot: wizardBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            showTotalCount: false
        }
        toolbar {
            show: false
        }
        enableUsersTo {
            download: false
        }
        advanced {
            savedReportMappingIdentifier: 1585462957689128103
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @VALORTOTAL
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @QUANTIDADEPARCELAS
                layout {
                    sequence: 2
                }
            )

        )

        column QUANTIDADEPARCELAS (
            type: numberField
            heading {
                heading: Quantidade Parcelas
                alignment: center
            }
            settings {
                numberAlignment: center
                virtualKeyboard: text
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                databaseColumn: QUANTIDADEPARCELAS
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column VALORTOTAL (
            type: textField
            heading {
                heading: Valor Total
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            validation {
                maxLength: 20
            }
            source {
                databaseColumn: VALORTOTAL
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

    )

    region dados-retorno-operadora-cartão-crédito (
        name: Dados Retorno Operadora Cartão Crédito
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select status
                     , erro
                     --, sucesso
                     --, codigoautorizacao
                     --, codigoretorno 
                     , idpedido   
                     --, cardbin
                     , datahora
                     --, last4
                     , valor / 100 valor
                     --, tid
                     --, installments
                     , mensagemretorno
                     , nsu
                from pagamentospedidos pp
                    , xmltable ( '/json'
                                passing apex_json.to_xmltype(pp.retornooperadora)
                                columns
                                  status                  number       path 'STATUS'
                                , erro                    number       path 'ERRO'
                                , sucesso                 varchar2(10) path 'sucesso'
                                , codigoautorizacao       varchar2(10) path 'cardResponse/authorizationCode'
                                , codigoretorno           number       path 'cardResponse/returnCode' 
                                , idpedido                number       path 'cardResponse/reference' 
                                , cardbin                 number       path 'cardResponse/cardBin'
                                , datahora                varchar2(50) path 'cardResponse/dateTime'
                                , last4                   number       path 'cardResponse/last4'
                                , valor                   number       path 'cardResponse/amount' 
                                , tid                     number       path 'cardResponse/tid'
                                , installments            number       path 'cardResponse/installments'
                                , mensagemretorno         varchar2(50) path 'cardResponse/returnMessage'
                                , nsu                     number       path 'cardResponse/nsu')
                where pp.idpagamentopedido = :P412_IDPAGAMENTOPEDIDO
                and pp.retornooperadora is not null;
                ```
        }
        layout {
            sequence: 20
            slot: wizardBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            showTotalCount: false
        }
        toolbar {
            show: false
        }
        enableUsersTo {
            download: false
        }
        advanced {
            savedReportMappingIdentifier: 1585374110217564041
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @STATUS
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @ERRO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDPEDIDO
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @DATAHORA
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @MENSAGEMRETORNO
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @NSU
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @VALOR
                layout {
                    sequence: 3
                }
            )

        )

        column DATAHORA (
            type: textField
            heading {
                heading: Data Hora Transação
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            validation {
                maxLength: 50
            }
            source {
                databaseColumn: DATAHORA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ERRO (
            type: numberField
            heading {
                heading: Erro
                alignment: center
            }
            settings {
                numberAlignment: center
                virtualKeyboard: text
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                databaseColumn: ERRO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column IDPEDIDO (
            type: numberField
            heading {
                heading: Pedido
                alignment: center
            }
            settings {
                numberAlignment: center
                virtualKeyboard: text
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                databaseColumn: IDPEDIDO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column MENSAGEMRETORNO (
            type: textField
            heading {
                heading: Mensagem Retorno
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            validation {
                maxLength: 50
            }
            source {
                databaseColumn: MENSAGEMRETORNO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column NSU (
            type: numberField
            heading {
                heading: NSU
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                databaseColumn: NSU
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column STATUS (
            type: numberField
            heading {
                heading: Status
                alignment: center
            }
            settings {
                numberAlignment: center
                virtualKeyboard: text
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                databaseColumn: STATUS
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column VALOR (
            type: numberField
            heading {
                heading: Valor
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                databaseColumn: VALOR
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

    )

    pageItem P412_IDPAGAMENTOPEDIDO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @dados-retorno-operadora-cartão-crédito
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

