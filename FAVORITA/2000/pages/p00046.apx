page 46 (
    name: Relatório de Estoques
    title: Estoques
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region estoque-detalhado (
        name: Estoque Detalhado
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idestoque
                     , filialfavorita
                     , produto
                     , produtodetalhado
                     , quantidade
                     , quantidadereservada
                     , quantidadereservadacgd
                     , quantidade  - quantidadereservada quantidadedisponivel
                     , permitevendernegativo
                     , buscardoestoqueabastecedor
                     , qtdestoqueminimo
                     , valorcusto
                     , quantidade * nvl(valorcusto,1) totalcusto
                from vw_estoques_fav e
                where (:P46_IDFILIALFAVORITA   is not null or :P46_IDPRODUTO is not null or :P46_IDPRODUTODETALHADO is not null or :P46_IDFORNECEDOR  is not null )
                  and (:P46_IDFILIALFAVORITA   is null     or idfilialfavorita        = :P46_IDFILIALFAVORITA)
                  and (:P46_IDPRODUTO          is null     or idproduto               = :P46_IDPRODUTO)
                  and (:P46_IDPRODUTODETALHADO is null     or idprodutodetalhado      = :P46_IDPRODUTODETALHADO)
                  and (:P46_IDFORNECEDOR       is null     or exists ( select 1 
                                                                       from fornecedoresprodutos f
                                                                       where f.idfornecedor = :P46_IDFORNECEDOR
                                                                         and f.idproduto    = e.idproduto ))
                  and ididioma = :P0_IDIDIOMA
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: page
        }
        messages {
            whenNoDataFound: Informe a filial, produto, produto detalhado ou o fornecedor.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 11922502660031017
        }

