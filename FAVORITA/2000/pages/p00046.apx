    region estoque-resumo-produto (
        name: Estoque Resumo - Produto
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select produto
                     , sum(quantidade) quantidade
                     , sum(quantidadereservada) quantidadereservada
                     , sum(quantidadereservadacgd) quantidadereservadacgd
                     , sum(quantidade  - quantidadereservada) quantidadedisponivel
                     , sum(qtdestoqueminimo) qtdestoqueminimo
                     , sum(valorcusto) valorcusto
                     , sum(quantidade * nvl(valorcusto,1)) totalcusto
                from vw_estoques_fav e
                where (:P46_IDPRODUTO is not null or :P46_IDFORNECEDOR  is not null )
                  and (:P46_IDPRODUTO          is null     or idproduto               = :P46_IDPRODUTO)
                  and (:P46_IDFORNECEDOR       is null     or exists ( select 1 
                                                                       from fornecedoresprodutos f
                                                                       where f.idfornecedor = :P46_IDFORNECEDOR
                                                                         and f.idproduto    = e.idproduto ))
                  and ididioma = :P0_IDIDIOMA
                  group by produto;
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
