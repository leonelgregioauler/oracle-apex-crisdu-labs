                heading: Estoque
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 20
                columnAlignment: center
                group: @quantidades
            }
            source {
                databaseColumn: QUANTIDADE
                dataType: number
            }
        )

        column QUANTIDADEDISPONIVEL (
            type: numberField
            heading {
                heading: Disponível
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 50
                columnAlignment: center
                group: @quantidades
            }
            source {
                databaseColumn: QUANTIDADEDISPONIVEL
                dataType: number
            }
        )

        column QUANTIDADERESERVADA (
