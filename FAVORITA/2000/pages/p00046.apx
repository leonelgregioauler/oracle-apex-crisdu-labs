        )

        column TOTALCUSTO (
            type: numberField
            heading {
                heading: Custo Total
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
            source {
                databaseColumn: TOTALCUSTO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1
                    from dual
                    where pck_util_fav.fnc_verificaacesso(32005,:P0_IDUSUARIO) = 'S'
                    ```
            }
        )

        column VALORCUSTO (
            type: numberField
            heading {
                heading: Custo
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
            source {
                databaseColumn: VALORCUSTO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1
                    from dual
                    where pck_util_fav.fnc_verificaacesso(32005,:P0_IDUSUARIO) = 'S'
                    ```
            }
        )

    )

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P46_IDFILIALFAVORITA (
        type: plugin/select
        label {
            label: Filial Favorita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) display_value
                     , idfilialfavorita   return_value
                from filiaisfavorita f
                where  exists ( select 1
                               from usuariosfiliaisfavorita u
                               where u.idfilialfavorita = f.idfilialfavorita
                                 and u.consultar = 'S'
                                 and u.idusuario = :P0_IDUSUARIO )
                order by 1
                ```
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P46_IDFORNECEDOR (
        type: plugin/select
        label {
            label: Fornecedor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nomepessoa display_value
                     , f.idfornecedor return_value
                from pessoas p
                   , fornecedores f
                where p.idpessoa = f.idpessoa
                  and f.ativo    = 'S'
                  and exists ( select 1 
                               from fornecedoresprodutos fp
                               where fp.idfornecedor = f.idfornecedor  )
                order by 1 
                ```
        }
        layout {
            sequence: 50
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P46_IDPRODUTO (
        type: plugin/select
        label {
            label: "Produto "
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-produtos
        }
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P46_IDPRODUTODETALHADO (
        type: plugin/select
        label {
            label: Produto Detalhado
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeprodutodetalhado(idprodutodetalhado, :P0_IDIDIOMA) as d
                     , idprodutodetalhado as r
                  from produtosdetalhados
                 where idproduto = :P46_IDPRODUTO
                 order by 1
                ```
        }
        cascadingLov {
            parentItems: P46_IDPRODUTO
        }
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 60
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-filter
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button movimentar-estoque (
        buttonName: MOVIMENTAR_ESTOQUE
        label: Movimentar Produto
        layout {
            sequence: 70
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-dropbox
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 88
                items: {
                    P88_IDFILIALFAVORITA: &P46_IDFILIALFAVORITA.
                    P88_IDPRODUTODETALHADO: &P46_IDPRODUTODETALHADO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button novo (
        buttonName: Novo
        label: Novo
        layout {
            sequence: 10
            region: @estoque-detalhado
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 47
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction filtrar (
        name: Filtrar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        name: Filtrar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 46
                items: {
                    P46_IDFILIALFAVORITA: &P46_IDFILIALFAVORITA.
                    P46_IDPRODUTODETALHADO: &P46_IDPRODUTODETALHADO.
                    P46_IDFORNECEDOR: &P46_IDFORNECEDOR.
                    P46_IDPRODUTO: &P46_IDPRODUTO.
                }
                action: resetPagination
            }
        }
    )

)

