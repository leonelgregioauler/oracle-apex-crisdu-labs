page 160 (
    name: Anexar Arquivo
    title: Anexar Arquivo
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 70%
        height: 80%
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region anexar-arquivo (
        name: Anexar Arquivo
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: <font color="green">Você pode anexar mais de um arquivo.</font>
            footerText: <font color="red" size="5"> ===========>>> Após selecionar o arquivo, clique em anexar.</font>
        }
        settings {
            outputAs: text
        }
    )

    region anexos (
        name: Anexos
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDANEXOEVENTO,
                       IDCHAMADO,/*
                       ATTACH_DATA,
                       ATTACH_MIMETYPE,*/
                       ATTACH_FILENAME/*,
                       ATTACH_LAST_UPDATE,
                       ATTACH_CHARSET*/
                  from ROMAN.ANEXOSEVENTOS
                WHERE IDCHAMADO = :P160_IDCHAMADO
                ```
        }
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1 
                FROM ROMAN.ANEXOSEVENTOS
                WHERE IDCHAMADO = :P160_IDCHAMADO
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: no data found
        }
        componentAdvanced {
            stripHtml: true
        }

        column ATTACH_FILENAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Arquivo
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

        column IDANEXOEVENTO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column IDCHAMADO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

    )

    region new (
        name: New
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    region registrar-evento (
        name: Registrar Evento
        type: list
        source {
            list: @registrar-evento
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

    pageItem P160_ATTACH_CHARSET (
        type: hidden
        layout {
            sequence: 70
            region: @anexar-arquivo
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ATTACH_CHARSET
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P160_ATTACH_DATA (
        type: fileUpload
        label {
            label: Arquivo
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
        }
        storage {
            mimeTypeColumn: ATTACH_MIMETYPE
            filenameColumn: ATTACH_FILENAME
            charSetColumn: ATTACH_CHARSET
            bobLastUpdatedColumn: ATTACH_LAST_UPDATE
        }
        layout {
            sequence: 30
            region: @anexar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: ATTACH_DATA
            used: always
        }
    )

    pageItem P160_ATTACH_FILENAME (
        type: hidden
        layout {
            sequence: 50
            region: @anexar-arquivo
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ATTACH_FILENAME
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P160_ATTACH_LAST_UPDATE (
        type: hidden
        layout {
            sequence: 60
            region: @anexar-arquivo
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ATTACH_LAST_UPDATE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P160_ATTACH_MIMETYPE (
        type: hidden
        layout {
            sequence: 40
            region: @anexar-arquivo
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ATTACH_MIMETYPE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P160_IDANEXOEVENTO (
        type: hidden
        layout {
            sequence: 10
            region: @anexar-arquivo
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDANEXOEVENTO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P160_IDCHAMADO (
        type: hidden
        layout {
            sequence: 20
            region: @anexar-arquivo
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDCHAMADO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Anexar
        layout {
            sequence: 10
            region: @new
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P160_IDANEXOEVENTO
        }
    )

    button finalizar (
        buttonName: FINALIZAR
        label: Finalizar
        layout {
            sequence: 20
            region: @new
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 162
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process fetch-row-from-anexoseventos (
        name: Fetch Row from ANEXOSEVENTOS
        type: autoRowFetch
        source {
            tableOwner: ROMAN
            tableName: ANEXOSEVENTOS
            pkColumn: IDANEXOEVENTO
            pkItem: P160_IDANEXOEVENTO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 30196462378618673
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P160_IDANEXOEVENTO is null then
                        select "ROMAN"."SEQ_IDANEXOEVENTO".nextval
                          into :P160_IDANEXOEVENTO
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 30196884598618673
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-anexoseventos (
        name: Process Row of ANEXOSEVENTOS
        type: autoRowProcessing
        target {
            tableOwner: ROMAN
            tableName: ANEXOSEVENTOS
            pkColumn: IDANEXOEVENTO
            pkItem: P160_IDANEXOEVENTO
            supportedOperations: [
                insert
                update
            ]
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 30197203538618674
        }
    )

    branch (
        name: Go To page 162
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 162
                items: {
                    P162_IDCHAMADO: &P160_IDCHAMADO.
                    P160_IDANEXOEVENTO:
                }
                action: resetPagination
                successMessage: false
            }
        }
        serverSideCondition {
            type: request=Value
            value: FINALIZAR
        }
    )

    branch (
        name: Go To page 160
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 160
                items: {
                    P160_IDCHAMADO: &P160_IDCHAMADO.
                    P160_IDANEXOEVENTO:
                }
                action: resetPagination
                successMessage: false
            }
        }
        serverSideCondition {
            type: request=Value
            value: CREATE
        }
    )

)

