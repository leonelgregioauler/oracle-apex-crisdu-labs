page 578 (
    name: Atualizar Base Compras
    title: Atualizar Base Compras
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region parâmetros (
        name: Parâmetros
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P578_IDEDICAOREVISTA (
        type: hidden
        layout {
            sequence: 80
            region: @parâmetros
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P578_IDFILIALABASTECER (
        type: selectList
        label {
            label: Filial Abastecer
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomefilialfavorita display_value
                     , idfilialfavorita   return_value
                  from favorita.filiaisfavorita f
                 where f.tipofilial in ('E')
                   and idpais = :P578_IDPAIS
                   and ativo = 'S'
                 order by 1
                ```
        }
        cascadingLov {
            parentItems: P578_IDPAIS
            itemsToSubmit: P578_IDPAIS
        }
        layout {
            sequence: 20
            region: @parâmetros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P578_IDFORNECEDOR (
        type: hidden
        layout {
            sequence: 30
            region: @parâmetros
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P578_IDORDEMCOMPRA (
        type: hidden
        layout {
            sequence: 60
            region: @parâmetros
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P578_IDPAIS (
        type: selectList
        label {
            label: País
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome, idpais
                  from roman.paises
                 where idpais in (
                                  select idpais
                                    from edicoesrevistas
                                   where sysdate between datainicial and datafinal
                                     and tipovenda = 'R')
                 order by 1
                ```
        }
        layout {
            sequence: 10
            region: @parâmetros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P578_KITVENDAS (
        type: hidden
        layout {
            sequence: 40
            region: @parâmetros
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P578_MORTEPROG (
        type: hidden
        layout {
            sequence: 50
            region: @parâmetros
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P578_QTDCICLOS (
        type: hidden
        layout {
            sequence: 70
            region: @parâmetros
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 10
            region: @parâmetros
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    button grade (
        buttonName: GRADE
        label: Montar Grade
        layout {
            sequence: 20
            region: @parâmetros
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process atualizatmp (
        name: AtualizaTMP
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                --
                V_IDFILIALT2 varchar2(100);
                V_IDFILIALT3 varchar2(100);
                V_IDFILIALT4 varchar2(100);
                --
                V_ED1 varchar2(100);
                V_ED2 varchar2(100);
                V_ED3 varchar2(100);
                V_EDFINAL varchar2(100);
                --
                V_IDFILT2 number;
                V_IDFILT3 number;
                V_IDFILT4 number;
                --
                begin
                 
                /* pck_bi_fav.prc_rel_analise_compras (:P578_IDPAIS,
                                                     :P578_IDFILIALABASTECER,
                                                     :P578_IDFORNECEDOR,
                                                     :P578_MORTEPROG, 
                                                     :P578_KITVENDAS,
                                                     :APP_USER,
                                                     --
                                                     V_IDFILIALT2, V_IDFILIALT3, V_IDFILIALT4, 
                                                     V_ED1, V_ED2, V_ED3, V_EDFINAL,
                                                     V_IDFILT2, V_IDFILT3, V_IDFILT4); */
                 null;
                
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 99999531974077823
        }
    )

    branch (
        name: Chama579
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 579
                items: {
                    P579_IDORDEMCOMPRA: &P578_IDORDEMCOMPRA.
                    P579_QTDCICLOS: &P578_QTDCICLOS.
                    P579_IDEDICAOREVISTA: &P578_IDEDICAOREVISTA.
                    P579_IDFORNECEDOR: &P578_IDFORNECEDOR.
                    P579_IDFILIALFAVORITA: &P578_IDFILIALABASTECER.
                    P579_IDPAIS: &P578_IDPAIS.
                }
                action: resetPagination
            }
        }
    )

)

