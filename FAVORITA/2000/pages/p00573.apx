page 573 (
    name: Relatório Ordens Compras
    title: Relatório Ordens Compras
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region report (
        name: Report 1
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select O.IDORDEMCOMPRA
                     , O.DATAEMISSAO
                     , O.TIPOOC
                     , O.IDFORNECEDOR
                     , O.IDUSUARIOEMISSAO
                     , O.IDSITUACAOOC
                     , O.IDEDICAOREVISTA
                     , TO_CHAR(O.DATAFECHAMENTO,'DD/MM/RRRR HH24:MI:SS') DATAFECHAMENTO
                     , (select descricao from situacoesordenscompras where idsituacaoOC = O.IDSITUACAOOC) situacao
                     , null verCT
                  from ORDENSCOMPRAS O
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 576
                items: {
                    P576_IDORDEMCOMPRA: #IDORDEMCOMPRA#
                }
                clearCache: 576
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum registro localizado!
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 101899559949889619
        }

        column DATAEMISSAO (
            type: plainText
            heading {
                heading: Data Emissão
            }
            layout {
                sequence: 11
            }
            appearance {
                formatMask: dd/mm/rrrr hh24:mi:ss
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: I
            }
        )

        column DATAFECHAMENTO (
            type: plainText
            heading {
                heading: Data Fechamento
            }
            layout {
                sequence: 91
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: R
            }
        )

        column IDEDICAOREVISTA (
            type: plainTextBasedOnLov
            heading {
                heading: Revista
            }
            lov {
                lov: @lov-edicoesrevistas
            }
            layout {
                sequence: 71
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: P
            }
        )

        column IDFORNECEDOR (
            type: plainTextBasedOnLov
            heading {
                heading: Fornecedor
            }
            lov {
                lov: @lov-fornecedores
            }
            layout {
                sequence: 51
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: M
            }
        )

        column IDORDEMCOMPRA (
            type: plainText
            heading {
                heading: Nr. Ordem Compra
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column IDSITUACAOOC (
            type: hidden
            heading {
                heading: Idsituacaooc
            }
            layout {
                sequence: 81
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: Q
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDUSUARIOEMISSAO (
            type: plainTextBasedOnLov
            heading {
                heading: Emitente
            }
            lov {
                lov: @lov-usuarios
            }
            layout {
                sequence: 61
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: O
            }
        )

        column SITUACAO (
            type: plainText
            heading {
                heading: Situação
            }
            layout {
                sequence: 41
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: L
            }
        )

        column TIPOOC (
            type: plainText
            heading {
                heading: TipoOC
            }
            layout {
                sequence: 21
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: J
            }
        )

        column VERCT (
            type: link
            heading {
                heading: Verct
            }
            layout {
                sequence: 101
            }
            link {
                target: {
                    page: 611
                    items: {
                        P611_IDORDEMCOMPRA: #IDORDEMCOMPRA#
                    }
                    clearCache: 611
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-view.png" class="apex-edit-view" alt="">
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: S
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 1019087 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAEMISSAO (
                sequence: 2
            )

            displayColumn DATAFECHAMENTO (
                sequence: 8
            )

            displayColumn IDEDICAOREVISTA (
                sequence: 6
            )

            displayColumn IDFORNECEDOR (
                sequence: 5
            )

            displayColumn IDORDEMCOMPRA (
                sequence: 1
            )

            displayColumn IDSITUACAOOC (
                sequence: 7
            )

            displayColumn SITUACAO (
                sequence: 4
            )

            displayColumn TIPOOC (
                sequence: 3
            )

            displayColumn VERCT (
                sequence: 9
            )

            sort (
                column: DATAEMISSAO
                sort {
                    direction: desc
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Nova Ordem de Compra
        layout {
            sequence: 30
            region: @report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 576
                clearCache: 576
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

