page 211 (
    name: Condições Pagamentos
    title: Condições Pagamentos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region condições-pagamentos (
        name: Condições Pagamentos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idcondicaopagamento
                     , idformapagamento
                     , formapagamento
                     , qtdparcela
                     , variacaodias
                     , desconto
                     , idparceira
                     , parceira
                from vw_condicoespagamentos_fav;
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 1972183470578083255
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDCONDICAOPAGAMENTO
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDFORMAPAGAMENTO
                layout {
                    show: false
                    sequence: 1
                }
            )

            displayColumn (
                column: @QTDPARCELA
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @VARIACAODIAS
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @DESCONTO
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @FORMAPAGAMENTO
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDPARCEIRA
                layout {
                    show: false
                    sequence: 6
                }
            )

            displayColumn (
                column: @PARCEIRA
                layout {
                    sequence: 7
                }
            )

        )

        column DESCONTO (
            type: numberField
            heading {
                heading: % Desconto
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: DESCONTO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column FORMAPAGAMENTO (
            type: textarea
            heading {
                heading: Forma Pagamento
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: FORMAPAGAMENTO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column IDCONDICAOPAGAMENTO (
            type: numberField
            heading {
                heading: Editar
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            link {
                target: {
                    page: 212
                    items: {
                        P212_IDCONDICAOPAGAMENTO: &IDCONDICAOPAGAMENTO.
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                databaseColumn: IDCONDICAOPAGAMENTO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column IDFORMAPAGAMENTO (
            type: numberField
            heading {
                heading: Idformapagamento
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDFORMAPAGAMENTO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column IDPARCEIRA (
            type: numberField
            heading {
                heading: Idparceira
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            source {
                databaseColumn: IDPARCEIRA
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column PARCEIRA (
            type: textarea
            heading {
                heading: Distribuidora Parceira
                alignment: center
            }
            layout {
                sequence: 120
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: PARCEIRA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column QTDPARCELA (
            type: numberField
            heading {
                heading: Quantidade Parcelas
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: QTDPARCELA
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column VARIACAODIAS (
            type: numberField
            heading {
                heading: Variação Dias
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: VARIACAODIAS
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

    )

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 40
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @opções
            slot: top
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 212
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

