    process consulta-controle-sac (
        name: Consulta Controle SAC
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vcpf                varchar2(15);
                  vcep                varchar2(20);
                  vdatacadastro       date;
                  vdatanascimento     date;
                  vidpessoa           number;
                  vidvendedora        number;
                begin
                  --
                  
                  PCK_SAC_FAV.PRC_CONTROLECONTATOSSITE( PIDCONTROLECONTATOSSITE => :P626_IDCONTROLECONTATOSSITE,
                                                        PNOMECOMPLETO => :P626_NOMECOMPLETO,
                                                        PCPF => vcpf,
                                                        PDATANASCIMENTO => vdatanascimento,
                                                        PRUA => :P626_RUA,
                                                        PNR => :P626_NR,
                                                        PCOMPLEMENTO => :P626_COMPLEMENTO,
                                                        PBAIRRO => :P626_BAIRRO,
                                                        PIDCIDADE => :P626_IDCIDADE,
                                                        PCEP => vcep,
                                                        PFONE => :P626_FONE,
                                                        PFONE2 => :P626_FONE2,
                                                        PEMAIL => :P626_EMAIL,
                                                        PMSN => :P626_MSN,
                                                        PMENSAGEM => :P626_MENSAGEM,
                                                        POBSERVACAO => :P626_OBSERVACAO,
                                                        PSITUACAO => :P626_SITUACAO,
                                                        PDATACADASTRO => vdatacadastro,
                                                        PIDFILIAL => :P626_IDFILIAL,
                                                        PIDREPRESENTANTE => :P626_IDREPRESENTANTE,
                                                        PDATALIBERADOFILIAL => :P626_DATALIBERADOFILIAL,
                                                        PDATAPASSADOREPRES => :P626_DATAPASSADOREPRES,
                                                        POBSERVACAOFILIAL => :P626_OBSERVACAOFILIAL,
                                                        PORIGEM => :P626_ORIGEM,
                                                        PTIPO => :P626_TIPO,
                                                        PIDFILIALORIG => :P626_IDFILIALORIG,
                                                        PIDREPRESENTANTEORIG => :P626_IDREPRESENTANTEORIG,
                                                        PIDVENDEDORAORIG => :P626_IDVENDEDORAORIG,
                                                        PCADASTRADO => :P626_CADASTRADO,
                                                        PTIPOSOLICITACAO => :P626_TIPOSOLICITACAOMANUAL,
                                                        PCIDADE => :P626_CIDADEMANUAL,
                                                        PINADIMPLENTE => :P626_INADIMPLENTE,
                                                        PNROCONSULTASPC => :P626_NROCONSULTASPC,
                                                        PUSUARIOCADASTROU => :P626_USUARIOCADASTROU,
                                                        PCADASTROSISTEMA => :P626_CADASTROSISTEMA,
                                                        PIDFILIALFAVORITA => :P626_IDFILIALFAVORITA,
                                                        PIDUSUARIO => :P626_IDUSUARIO,
                                                        PDOCUMENTOESTRANGEIRO => :P626_DOCUMENTOESTRANGEIRO2,
                                                        PHORAATENDIMENTO => :P626_HORARIOATENDIMENTO,
                                                        PMD5             => :P626_MD5,
                                                        POPERACAO_DML    => 'S',
                                                        PTIPOPROTOCOLO   => :P626_TIPOPROTOCOLO,
                                                        PIDSETOR         => :P626_IDSETOR,
                                                        PSUBTIPOSOL      => :P626_SUBTIPO,
                                                        PIDPAIS          => :P626_IDPAIS,
                                                        PNUMEROPROCESSO  => :P626_NUMEROPROCESSO);
                  --
                  :P626_CPF               := REGEXP_REPLACE(vcpf,  '^(\d{3})(\d{3})(\d{3})(\d{2})$', '\1.\2.\3-\4');
                  :P626_CEP               := REGEXP_REPLACE(vcep,  '^(\d{2})(\d{3})(\d{3})$', '\1.\2-\3');
                  :P626_DATACADASTRO      := to_char(vdatacadastro,'DD/MM/RRRR HH24:MI:SS');
                  :P626_DATANASCIMENTO    := to_char(vdatanascimento,'DD/MM/RRRR');
                  --
                  :P626_IDTESTE := :P626_IDCONTROLECONTATOSSITE;
                  
                  begin
                    --
                    select idpessoa
                    into vidpessoa
                    from pessoas p
                    where p.cpf = replace(replace(replace(vcpf,'.',''),'-',''),' ','');
                    --
                  exception
                    when others then 
                      vidpessoa := null;
                  end;
                  --
                  if vidpessoa is not null then
                    --
                    begin
                      --
                      select idvendedora
                      into vidvendedora
                      from vendedoras v
                      where v.idpessoa = vidpessoa;
                      --
                    exception
                      when others then
                        vidvendedora := null;
                    end;
                    --
                  end if;
                  --
                  :P626_IDPESSOA := vidpessoa;
                  :P626_IDVENDEDORA := vidvendedora;
                  --
                  -- Maicon Aimi - 08/08/2024 - 9076848
                  -- ajustado para carregar o país e cidade com base na tabela -> CONTATO CONTROLE SITE
                  begin
                    select est.idpais
                         , cid.idcidade
                      into :P626_IDPAIS
                         , :P626_IDCIDADE
                      from roman.controlecontatossite c
                         , catal.cidades cid
                         , roman.estados est
                     where cid.idcidade = c.idcidade
                       and est.idestado = cid.idestado
                       and c.idcontrolecontatossite = :P626_IDCONTROLECONTATOSSITE;
                  exception
                    when others then
                      :P626_IDPAIS   := null;
                      :P626_IDCIDADE := null;
                  end;
                
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 2431702114634874563
        }
    )

    process deletar-tarefa (
        name: Deletar Tarefa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidtipotarefa        number;
                  vidticketcallcenter  number;
                  vtelefone            varchar2(20);
                  vdatainclusao        date;
                  vprioridade          number;
                  vidsituacao          number;
                  vobservacao          varchar2(100);
                  vidusuario           number;
                  vidpessoa            number;
                  vidgrupoatendimento  number;
                  vdatainicio          date;
                  vdataconclusao       date;
                  vnumeroposicaoatendimento varchar2(10);
                  vidpedido            number;
                  vcodigoarea          number;
                  vmd5                 varchar2(1000);
                  --
                  vidcaracteristicasac number;
                  --
                begin
                  --
                  select idtipotarefa
                  into vidtipotarefa
                  from tarefas t
                  where t.idtarefa = :P626_IDEDITAR;
                  --
                  if vidtipotarefa = 23 then
                    --
                    vidcaracteristicasac := 21;
                    --
                  elsif vidtipotarefa = 10 then
                    --
                    vidcaracteristicasac := 23;
                    --
                  elsif vidtipotarefa = 15 then
                    --
                    vidcaracteristicasac := 22;
                    --
                  end if;
                  --
                  delete roman.classificacoessac c
                  where c.idcontrolecontatossite = :P626_IDCONTROLECONTATOSSITE
                    and c.idcaracteristicasac = vidcaracteristicasac;
                  --
                  pck_tarefas_fav.prc_tarefas(pidtarefa => :P626_IDEDITAR,
                                              pidtipotarefa => vidtipotarefa,
                                              pidticketcallcenter => vidticketcallcenter,
                                              ptelefone => vtelefone,
                                              pdatainclusao => vdatainclusao,
                                              pprioridade => vprioridade,
                                              pidsituacao => vidsituacao,
                                              pobservacao => vobservacao,
                                              pidusuario => vidusuario,
                                              pidpessoa => vidpessoa,
                                              pidgrupoatendimento => vidgrupoatendimento,
                                              pdatainicio => vdatainicio,
                                              pdataconclusao => vdataconclusao,
                                              pnumeroposicaoatendimento => vnumeroposicaoatendimento,
                                              pidpedido => vidpedido,
                                              pcodigoarea => vcodigoarea,
                                              pmd5 => vmd5,
                                              poperacao_dml => 'D');
                  --
                end;
                ```
        }
        execution {
            sequence: 70
        }
        successMessage {
            successMessage: Tarefa Excluída com sucesso!
        }
        advanced {
            executionMappingIdentifier: 2431705366646874561
        }
        serverSideCondition {
            type: request=Value
            value: EXCLUIR_TAREFA
        }
    )

    process envia-indicação-para-o-painel (
        name: Envia indicação para o Painel
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidclassificacaosac number;
                  vidcaracteristicasac number := 37;
                  vdataclassificado date := sysdate;
                  vidusuario number;
                  vidvalorclassificacao number;
                  vobservacao varchar2(1000);
                  vmd5 varchar2(1000);
                  --
                  vidcontrolecontatossite number := :P626_IDCONTROLECONTATOSSITE;
                  vidfilial number := :P626_IDFILIAL;
                  
                begin
                  --
                  select idusuario
                  into vidusuario 
                  from usuarios 
                  where usuario = v('APP_USER');
                  --
                  roman.pck_cadastros_rmc.prc_classificacoessac(pidclassificacaosac     => vidclassificacaosac,
                                                          pidcontrolecontatossite => :P626_IDCONTROLECONTATOSSITE,
                                                          pidcaracteristicasac    => vidcaracteristicasac,
                                                          pdataclassificado       => vdataclassificado,
                                                          pidusuario              => vidusuario,
                                                          pidvalorclassificacao   => vidvalorclassificacao,
                                                          pobservacao             => vobservacao,
                                                          pmd5                    => vmd5,
                                                          poperacao_dml           => 'I');
                  --
                  insert into roman.painelcontatossite (idpainelcontatossite,
                                                        idcontrolecontatossite,
                                                        idsituacaopainel,
                                                        datasituacao,
                                                        iddistribuidor,
                                                        idfilial,
                                                        observacao)
                  values  ( roman.seq_painelcontatossite.nextval
                         , vidcontrolecontatossite
                         , 0
                         , sysdate
                         , null
                         , vidfilial
                         , null);
                end;
                ```
        }
        execution {
            sequence: 80
        }
        successMessage {
            successMessage: Indicação disponibilizada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 2431701723917874564
        }
        serverSideCondition {
            type: request=Value
            value: ENVIAR_PAINEL
        }
    )

    process gerar-tarefa-de-contato-lead (
        name: Gerar Tarefa de Contato Lead
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vtipotarefa number;
                  videstado   number;
                  vidusuario  number;
                  --
                begin
                  --
                  begin
                    select c.idestado
                    into videstado
                    from roman.cidades c
                    where c.idcidade = :P626_IDCIDADE;
                  exception
                    when others then
                      videstado := 0;
                  end;
                  --
                  if v('REQUEST') = 'GERAR_TARAFA_ANL' then
                    --
                    vtipotarefa := 36;
                    vidusuario := :P626_IDUSUARIO_RECEBER;
                    --
                    /*if videstado = 43 then
                      vtipotarefa := 36;
                      vidusuario := :P626_IDUSUARIO_RECEBER;
                    else
                      vtipotarefa := 23;
                      vidusuario := :P626_IDUSUARIO_RECEBER;
                    end if;*/
                    --
                  elsif v('REQUEST') = 'GERARTAREFACOB' then
                    vtipotarefa := 10;
                    vidusuario := :P0_IDUSUARIO;
                  elsif v('REQUEST') = 'GERARTAREFAPOS' then
                    vtipotarefa := 15;
                    vidusuario := :P0_IDUSUARIO;
                  end if;
                  --
                  pck_sac_fav.prc_gerartarefaatendimento( pidcontrolecontatossite => :P626_IDCONTROLECONTATOSSITE
                                                        , pidtipotarefa => vtipotarefa 
                                                        , pidusuario => vidusuario );
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Tarefa Criada com Sucesso!
        }
        advanced {
            executionMappingIdentifier: 2431706587392874560
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('GERARTAREFACOB','GERAR_TARAFA_ANL','GERARTAREFAPOS')
                ```
        }
    )

