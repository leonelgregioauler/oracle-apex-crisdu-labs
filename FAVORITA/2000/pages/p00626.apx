            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                Select 1
                from dual
                where :P626_SITUACAO in ('P','S')
                union
                select 1
                from usuarios u
                where not exists ( select 1
                                   from favorita.filiaisfavorita ff
                                   where ff.idfilialfavorita = u.idfilialfavorita
                                     and ff.tipofilial       = 'L' )
                  and u.usuario = v('APP_USER')
                ```
        }
    )

    region tarefas-da-cliente (
        name: Tarefas da Cliente
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idtarefa
                     , t.datainclusao
                     , t.situacao
                     , t.datainicio
                     , t.dataconclusao
                     , t.observacao
                     , t.nomeusuario
                     , t.historicos
                     , case
                         when t.idsituacao = 0 then
                           '<a href="javascript:apex.confirm(''Confirmar a exclusão desta Tarefa ? '', 
                             { request:''EXCLUIR_TAREFA'', set:{''P626_IDEDITAR'':'||t.idtarefa||' }  } )";><img src="#APP_IMAGES#baixa.png" border="0"></a>'
                         else
                           'Tarefa não pode ser Excluída!'
                       end excluir
                from vw_tarefas_fav t
                where ( exists ( select 1
                                 from roman.classificacoessac c
                                 where c.idcontrolecontatossite = :P626_IDCONTROLECONTATOSSITE
                                   and c.idvalorclassificacao = t.idtarefa )
                    or ( t.observacao like '%'||:P626_CPF||'%'
                     or t.observacao like '%'||replace(replace(:P626_CPF,'.',''),'-','')||'%' ) )
                order by 1 desc
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from vw_tarefas_fav t
                where exists ( select 1
                               from roman.classificacoessac c
                               where c.idcontrolecontatossite = :P626_IDCONTROLECONTATOSSITE
                                 and c.idvalorclassificacao = t.idtarefa )
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

