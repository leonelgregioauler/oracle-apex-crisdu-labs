    pageItem P626_ULTIMAEMPRESA (
        type: hidden
        layout {
            sequence: 450
            region: @não-mostrar-novas-alteracoes-do-sac
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select nvl(roman.pck_romance.fnc_nomefilial(p.idfilialromance),'Cidade não atendida por nenhuma Empresa!') filial
                from pedidos p
                where p.idpedido = ( select max(idpedido)
                                     from pedidos pd
                                     where pd.datacancelamento is null
                                       and exists ( select 1
                                                    from vendedoras v
                                                       , pessoas pp
                                                    where v.idvendedora = pd.idvendedora
                                                      and v.idpessoa    = pp.idpessoa 
                                                      and pp.idcidade   = ( select idcidade
                                                                            from roman.controlecontatossite c
                                                                            where c.idcontrolecontatossite = :P626_IDCONTROLECONTATOSSITE ) ) );
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

