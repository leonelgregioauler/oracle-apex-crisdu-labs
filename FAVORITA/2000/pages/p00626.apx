    dynamicAction busca-informações-do-cep (
        name: Busca Informações do CEP
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P626_CEP
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P626_CEP
        }
        serverSideCondition {
            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                      vendereco varchar2(50);
                      vbairro   varchar2(50);
                      vidcidade number;
                      vcidade   varchar2(20);
                    begin
                      --
                      select c.bairro
                           , c.endereco
                           , c.cidade
                      into vbairro
                         , vendereco
                         , vcidade
                      from roman.vw_logradouro_por_cep c
                      where c.cep = trim(replace(replace(:P626_CEP,'.',''),'-',''))
                        and rownum = 1;
                      --
                      :P626_BAIRRO   := vbairro;
                      :P626_RUA      := vendereco;
                      --
                    end;
                    ```
                itemsToSubmit: [
                    P626_CEP
                    P626_RUA
                    P626_BAIRRO
                ]
                itemsToReturn: [
                    P626_RUA
                    P626_BAIRRO
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction buscadados (
        name: BuscaDados
        execution {
            sequence: 65
        }
        when {
            selectionType: items
            items: P626_CPF
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    
                    select p.nomepessoa
                         , (select telefonelimpo
                              from catal.telefonespessoas
                             where idtelefonepessoa = (select max(idtelefonepessoa)
                                                         from catal.telefonespessoas
                                                        where idpessoa = p.idpessoa) ) telefone
                         , p.email
                         , p.datanascimento
                         , p.enderecoprincipal
                         , p.numero
                         , p.bairro
                         , p.idcidade
                         , p.cep
                         --
                         , (select idrepresentante
                              from vendedoras 
                             where idpessoa = p.idpessoa) representante
                         --
                         , (select idfilial
                              from vendedoras
                             where idpessoa = p.idpessoa) filial
                         , p.idpais
                      INTO
                       :P626_NOMECOMPLETO,
                       :P626_FONE,
                       :P626_EMAIL,
                       :P626_DATANASCIMENTO,
                       :P626_RUA,
                       :P626_NR,
                       :P626_BAIRRO,
                       :P626_IDCIDADE,
                       :P626_CEP,
                       :P626_IDREPRESENTANTE,
                       :P626_IDFILIAL,
                       :P626_IDPAIS
                      from catal.pessoas p
                         , catal.cidades c
                         , catal.estados e
                     where p.idcidade = c.idcidade(+)
                       and c.idestado = e.idestado(+)
                       and p.cpf = REGEXP_REPLACE (:P626_CPF,'[^0-9A-Za-z]', '') ;
                    
                    
                    exception
                     when others then 
                       raise_application_error(-20001,'Nenhum registro localizado para o CPF '||:P626_CPF);
                    
                    end;
                    
                    ```
                itemsToSubmit: P626_CPF
                itemsToReturn: [
                    P626_NOMECOMPLETO
                    P626_FONE
                    P626_EMAIL
                    P626_DATANASCIMENTO
                    P626_RUA
                    P626_NR
                    P626_BAIRRO
                    P626_IDCIDADE
                    P626_CEP
                    P626_IDREPRESENTANTE
                    P626_IDFILIAL
                    P626_IDPAIS
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction buscadados-2 (
        name: BuscaDados2
        execution {
            sequence: 100
        }
        when {
            selectionType: items
            items: P626_DOCUMENTOESTRANGEIRO2
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    
                    select p.nomepessoa
                         , (select telefonelimpo
                              from catal.telefonespessoas
                             where idtelefonepessoa = (select max(idtelefonepessoa)
                                                         from catal.telefonespessoas
                                                        where idpessoa = p.idpessoa) ) telefone
                         , p.email
                         , p.datanascimento
                         , p.enderecoprincipal
                         , p.numero
                         , p.bairro
                         , p.idcidade
                         , p.cep
                         --
                         , (select idrepresentante
                              from vendedoras 
                             where idpessoa = p.idpessoa) representante
                         --
                         , (select idfilial
                              from vendedoras
                             where idpessoa = p.idpessoa) filial
                         , p.idpais
                      INTO
                       :P626_NOMECOMPLETO,
                       :P626_FONE,
                       :P626_EMAIL,
                       :P626_DATANASCIMENTO,
                       :P626_RUA,
                       :P626_NR,
                       :P626_BAIRRO,
                       :P626_IDCIDADE,
                       :P626_CEP,
                       :P626_IDREPRESENTANTE,
                       :P626_IDFILIAL,
                       :P626_IDPAIS
                      from catal.pessoas p
                         , catal.cidades c
                         , catal.estados e
                     where p.idcidade = c.idcidade(+)
                       and c.idestado = e.idestado(+)
                       and p.DOCUMENTOESTRANGEIRO = :P626_DOCUMENTOESTRANGEIRO2;
                    
                    exception
                     when others then 
                       raise_application_error(-20001,'Nenhum registro localizado para o Doc. Estrangeiro '||:P626_DOCUMENTOESTRANGEIRO2);
                    
                    end;
                    
                    ```
                itemsToSubmit: P626_DOCUMENTOESTRANGEIRO2
                itemsToReturn: [
                    P626_NOMECOMPLETO
                    P626_FONE
                    P626_EMAIL
                    P626_DATANASCIMENTO
                    P626_RUA
                    P626_NR
                    P626_BAIRRO
                    P626_IDCIDADE
                    P626_CEP
                    P626_IDREPRESENTANTE
                    P626_IDFILIAL
                    P626_IDPAIS
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

