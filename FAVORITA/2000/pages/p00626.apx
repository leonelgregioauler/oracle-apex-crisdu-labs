    pageItem P626_CPFINVALIDO (
        type: displayOnly
        label {
            label: Cpfinvalido
            alignment: left
        }
        layout {
            sequence: 20
            region: @avisos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            preText: <h4 align="center" style="color:red;"> O CPF '||:P626_CPF ||' é inválido. Solicite o número correto.</h4>
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                if :P626_CPF is not null then
                  --
                  if not pck_util_fav.fnc_validacpfcnpj(:P626_CPF) and :P626_IDCONTROLECONTATOSSITE is not null AND :P626_DOCUMENTOESTRANGEIRO IS NULL then
                    return true;
                  else 
                    return false;
                  end if;
                  --
                end if;
                ```
        }
    )

    pageItem P626_CPF_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 590
            region: @itensocultos
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  v_input VARCHAR2(2000) := replace(replace(:P626_CPF,'.',''),'-','');
                  hexkey VARCHAR2(32) := NULL;
                  vmd5 varchar2(300);
                BEGIN
                  --
                  hexkey := roman.md5(v_input);
                  --
                  select lower(hexkey) md5
                  into vmd5
                  from dual;
                  --
                  return vmd5;
                  --
                exception
                  when others then
                    return null;
                END;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

