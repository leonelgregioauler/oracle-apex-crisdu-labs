    pageItem P626_AVISO_CODIGO_LIBERACAO (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: html
        }
        layout {
            sequence: 60
            region: @controle-sac-dados-pessoais
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            preText:
                ```html
                <font color="Blue"><h3>
                    Existe um código de liberação ativo para este CPF! 
                    </h3></font>
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.historicosconsultasdoc h
                where replace(replace(replace(h.documento,'.',''),'-',''),' ','') = replace(replace(replace(:P626_CPF,'.',''),'-',''),' ','')
                  and ( trunc(sysdate) - trunc(h.dataconsulta) ) <= 5
                  and h.liberado = 'S'
                  and not exists ( select 1
                                   from roman.controlecontatossite c
                                   where c.idcontrolecontatossite = :P626_IDCONTROLECONTATOSSITE
                                     and codigoliberacao = h.codigoliberacao )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

