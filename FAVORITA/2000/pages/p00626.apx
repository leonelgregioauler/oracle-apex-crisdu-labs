        }
    )

    region classificações (
        name: Classificações
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.idclassificacaosac
                     , w.dataclassificado
                     , w.usuario
                     , w.caracteristica
                     , w.observacao
                from roman.vw_classificacoessac w
                where w.idcontrolecontatossite = :P626_IDCONTROLECONTATOSSITE  
                order by w.dataclassificado desc 
                ```
        }
        layout {
            sequence: 130
            slot: body
        }
