    pageItem P626_ORIGEM (
        type: selectList
        label {
            label: Origem
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select o.origem
                     , o.idorigemsac
                from roman.origemsac o
                where not exists ( select 1
                                   from usuarios u
                                   where exists ( select 1
                                                  from favorita.filiaisfavorita ff
                                                  where ff.idfilialfavorita = u.idfilialfavorita
                                                    and ff.tipofilial       = 'L' )
                                     and u.usuario = v('APP_USER') )
                union
                select o.origem
                     , o.idorigemsac
                from roman.origemsac o
                where exists ( select 1
                               from usuarios u
                               where exists ( select 1
                                              from favorita.filiaisfavorita ff
                                              where ff.idfilialfavorita = u.idfilialfavorita
                                                and ff.tipofilial       = 'L' )
                                 and u.usuario = v('APP_USER') )
                   and o.idorigemsac = 'LF'
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 110
            region: @controle-sac-dados-pessoais
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

