    pageItem P626_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROMAN.pck_romance.fnc_nomerepresentante(idrepresentante) DISPLAY_VALUE
                     , idrepresentante RETURN_VALUE
                from representantes r
                where (:P626_IDFILIAL is null or
                    ( :P626_IDFILIAL is not null and idgerente in ( select idgerente from gerentes where idfilial = :P626_IDFILIAL) ) or
                    ( :P626_IDFILIAL is not null and r.idpostoavancado = (select 1
                                                                          from roman.postoavancado p
                                                                          where p.idpostoavancado = r.idpostoavancado )))
                  and r.ativo = 'S' 
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P626_IDFILIAL
        }
        layout {
            sequence: 110
            region: @dados-do-cadastro
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuarios u
                where u.idfilialfavorita is null
                  and u.usuario = v('APP_USER')
                union
                select 1
                from roman.usuariosgruposatendimento ug
                where ug.usuario = v('APP_USER')
                  and ug.idgrupoatendimento in (48,22)
                ```
        }
        security {
            encryptSessionState: false
        }
    )

