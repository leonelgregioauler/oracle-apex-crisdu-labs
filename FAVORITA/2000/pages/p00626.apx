page 626 (
    name: Controle SAC
    title: Controle SAC
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_excluir(pid)
            {
              document.getElementById("P626_IDEDITAR").value = pid;
              apex.submit('EXCLUIR_TAREFA');
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region avisos (
        name: Avisos
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
