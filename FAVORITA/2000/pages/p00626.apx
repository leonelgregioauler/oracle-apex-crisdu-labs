    pageItem P626_IDFILIAL (
        type: selectList
        label {
            label: Indicar Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from roman.vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                union
                select f.nome
                     , f.idfilial
                from roman.vw_filiais f
                where f.idfilial in (1117,1140,1175,360,1222) 
                
                union        
                select listagg(a.nome || ' - ' || coalesce(roman.pck_romance.fnc_nomefilial(a.idfilial), ' '), '; ')
                        within group ( order by a.nome ) nome
                    ,  a.idpostoavancado 
                  from roman.postoavancado a
                group by a.idpostoavancado 
                ```
        }
        layout {
            sequence: 120
            region: @controle-sac-dados-pessoais
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuarios u
                where exists ( select 1
                               from favorita.filiaisfavorita ff
                               where ff.idfilialfavorita = u.idfilialfavorita
                                 and ff.tipofilial       = 'L' )
                  and u.usuario = v('APP_USER')
                ```
        }
        security {
            encryptSessionState: false
        }
    )

