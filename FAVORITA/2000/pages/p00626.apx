    pageItem P626_SITUACAOCLIENTE (
        type: hidden
        layout {
            sequence: 290
            region: @não-mostrar-novas-alteracoes-do-sac
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vsituacao varchar2(100);
                begin
                  --
                  begin 
                    --
                    select decode(v.ativo,'S','Ativa','N','Inativa') situacao
                    into vsituacao
                    from vendedoras v
                       , pessoas p
                       , roman.controlecontatossite c
                    where v.idpessoa = p.idpessoa
                      and p.cpf      = trim(replace(replace(c.cpf,'.',''),'-',''))
                      and c.idcontrolecontatossite = :P626_IDCONTROLECONTATOSSITE;
                    --
                  exception
                    when others then
                      vsituacao := 'Não Cadastrado!';
                  end;
                  --
                  return vsituacao;
                  --
                end;
                ```
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P626_IDCONTROLECONTATOSSITE
        }
        security {
            encryptSessionState: false
        }
    )

