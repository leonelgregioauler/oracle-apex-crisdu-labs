    pageItem P626_DEBITO_FAVORITA (
        type: hidden
        layout {
            sequence: 340
            region: @não-mostrar-novas-alteracoes-do-sac
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select nvl(( select sum(v.saldodevedor)
                             from vw_pedidos_fav v
                             where idvendedora    = :P626_IDVENDEDORA
                               and ididioma       = :P0_IDIDIOMA
                               and v.tipopedido   = 'P'
                               and v.saldodevedor > 0)  ,0)
                     + nvl(( select sum(nvl(b.valornegociado,valororiginal))
                             from catal.boletos b
                             where idvendedora    = :P626_IDVENDEDORA
                               and b.situacao in ('V','G','S','M','K','E','A') ) ,0)
                     + nvl(( select sum(t.saldodevedor)
                             from vw_pedidos_fav t
                             where idvendedora    = :P626_IDVENDEDORA
                               and ididioma       = 1
                               and t.tipopedido   = 'T'
                               and t.valorapagar  > 0
                               and t.saldodevedor > 0) ,0) debito
                from dual
                ```
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P626_IDVENDEDORA
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P626_DEBITO_ROMANCE (
        type: hidden
        layout {
            sequence: 330
            region: @não-mostrar-novas-alteracoes-do-sac
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select nvl(sum( (select sum(saldo)
                             from roman.notasvendas n
                             where n.idvendedora = :P626_IDVENDEDORA
                               and n.idsituacaonotavenda = 4
                               and n.saldo               > 0 ) ) ,0)
                     + nvl(sum(( select sum(p.valorpago)
                               from roman.pepinosrepresentantes p
                               where p.cpf = replace(replace(replace(:P626_CPF,'.',''),'-',''),' ','')
                                 and p.valorsaldo > 0)),0) debito
                from dual
                ```
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P626_IDVENDEDORA
        }
        security {
            encryptSessionState: false
        }
    )

