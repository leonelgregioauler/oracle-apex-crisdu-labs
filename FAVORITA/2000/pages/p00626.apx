    button consultar-spc (
        buttonName: CONSULTAR_SPC
        label: Consultar SPC
        layout {
            sequence: 30
            region: @opções-2
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: "javascript: ConsultarSPC(document.getElementById('P626_CPF').value,document.getElementById('P626_CPF_MD5').value,200,document.getElementById('P0_USUARIO').value,function(dados){window.location.reload()});"
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P626_IDCONTROLECONTATOSSITE is not null
                  and :P626_CPF is not null
                  and ( not exists ( select 1
                                     from roman.consultaspc c
                                     where c.cpf = replace(replace(replace(:P626_CPF,'.',''),'-',''),' ','') )
                       
                        or not exists ( select 1
                                        from roman.vw_consultaspc_rmc c
                                        where c.cpf = replace(replace(replace(:P626_CPF,'.',''),'-',''),' ','') ) 
                      )
                ```
        }
    )

