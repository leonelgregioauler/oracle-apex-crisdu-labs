    process atualiza-situações (
        name: Atualiza Situações
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1) := 'U';
                  vsituacao varchar2(1);
                  vdatacadastro date;
                begin
                  --
                  vdatacadastro := to_date(:P626_DATACADASTRO,'DD/MM/RRRR HH24:MI:SS');
                  --
                  if v('REQUEST') = 'PENDENTE' then
                    vsituacao := 'P';
                  elsif v('REQUEST') = 'APROVADO' then
                    vsituacao := 'C';
                  elsif v('REQUEST') = 'ENCAMINHADO' then
                    vsituacao := 'E';
                  elsif v('REQUEST') = 'POSSUI_DEBITO' then
                    vsituacao := 'D';
                  elsif v('REQUEST') = 'RESTRICAO' then
                    vsituacao := 'S';
                  elsif v('REQUEST') = 'RESPONDIDO' then
                    vsituacao := 'R';
                  elsif v('REQUEST') = 'REGIAO_NAO_ATENDIDA' then
                    vsituacao := 'N';
                  elsif v('REQUEST') = 'ATIVO' then
                    vsituacao := 'A';
                  elsif v('REQUEST') = 'INATIVO' then
                    vsituacao := 'I';
                  elsif v('REQUEST') = 'APROVADO_RESTRICAO' then
                    vsituacao := 'B';
                  elsif v('REQUEST') = 'CONCLUIDO' then
                    vsituacao := 'G';
                  elsif v('REQUEST') = 'DEBITO_TERCEIRIZADA' then
                    vsituacao := 'J';
                  elsif v('REQUEST') = 'CADASTRO_DUPLO' then
                    vsituacao := 'K';
                  elsif v('REQUEST') = 'LOJA' then
                    vsituacao := 'L';
                  elsif v('REQUEST') = 'VINCULO_DEBITO' then
                    vsituacao := 'V';
                  elsif v('REQUEST') = 'INCOMPLETO' then
                    vsituacao := 'H';
                  elsif v('REQUEST') = 'CANCELAR' then
                    vsituacao := 'W';
                  end if;
                  --
                  PCK_SAC_FAV.PRC_CONTROLECONTATOSSITE( PIDCONTROLECONTATOSSITE => :P626_IDCONTROLECONTATOSSITE,
                                                        PNOMECOMPLETO => :P626_NOMECOMPLETO,
                                                        PCPF => :P626_CPF,
                                                        PDATANASCIMENTO => :P626_DATANASCIMENTO,
                                                        PRUA => :P626_RUA,
                                                        PNR => :P626_NR,
                                                        PCOMPLEMENTO => :P626_COMPLEMENTO,
                                                        PBAIRRO => :P626_BAIRRO,
                                                        PIDCIDADE => :P626_IDCIDADE,
                                                        PCEP => :P626_CEP,
                                                        PFONE => :P626_FONE,
                                                        PFONE2 => :P626_FONE2,
                                                        PEMAIL => :P626_EMAIL,
                                                        PMSN => :P626_MSN,
                                                        PMENSAGEM => :P626_MENSAGEM,
                                                        POBSERVACAO => :P626_OBSERVACAO,
                                                        PSITUACAO => vsituacao,
                                                        PDATACADASTRO => vdatacadastro,
                                                        PIDFILIAL => :P626_IDFILIAL,
                                                        PIDREPRESENTANTE => :P626_IDREPRESENTANTE,
                                                        PDATALIBERADOFILIAL => :P626_DATALIBERADOFILIAL,
                                                        PDATAPASSADOREPRES => :P626_DATAPASSADOREPRES,
                                                        POBSERVACAOFILIAL => :P626_OBSERVACAOFILIAL,
                                                        PORIGEM => :P626_ORIGEM,
                                                        PTIPO => :P626_TIPO,
                                                        PIDFILIALORIG => :P626_IDFILIALORIG,
                                                        PIDREPRESENTANTEORIG => :P626_IDREPRESENTANTEORIG,
                                                        PIDVENDEDORAORIG => :P626_IDVENDEDORAORIG,
                                                        PCADASTRADO => :P626_CADASTRADO,
                                                        PTIPOSOLICITACAO => :P626_TIPOSOLICITACAOMANUAL,
                                                        PCIDADE => :P626_CIDADEMANUAL,
                                                        PINADIMPLENTE => :P626_INADIMPLENTE,
                                                        PNROCONSULTASPC => :P626_NROCONSULTASPC,
                                                        PUSUARIOCADASTROU => :P626_USUARIOCADASTROU,
                                                        PCADASTROSISTEMA => :P626_CADASTROSISTEMA,
                                                        PIDFILIALFAVORITA => :P626_IDFILIALFAVORITA,
                                                        PIDUSUARIO => :P0_IDUSUARIO,
                                                        PDOCUMENTOESTRANGEIRO => :P626_DOCUMENTOESTRANGEIRO,
                                                        PMD5             => :P626_MD5,
                                                        POPERACAO_DML    => voperacao_dml,
                                                        PTIPOPROTOCOLO   => :P626_TIPOPROTOCOLO,
                                                        PIDSETOR         => :P626_IDSETOR,
                                                        PSUBTIPOSOL      => :P626_SUBTIPO,
                                                        PIDPAIS          => :P626_idpais,
                                                        PNUMEROPROCESSO  => :P626_NUMEROPROCESSO);
                  --
                  
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Cadastro atualizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 2431704137608874562
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('APROVADO','ATIVO','ENCAMINHADO','POSSUI_DEBITO','RESTRICAO','REGIAO_NAO_ATENDIDA','RESPONDIDO','APROVADO_RESTRICAO','INATIVO','PENDENTE','CONCLUIDO','DEBITO_TERCEIRIZADA','CADASTRO_DUPLO','LOJA','VINCULO_DEBITO','INCOMPLETO','CANCELAR')
        }
