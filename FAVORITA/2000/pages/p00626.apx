    validation cadastrado-obrigatório (
        name: CADASTRADO obrigatório
        execution {
            sequence: 70
        }
        validation {
            type: itemIsNotZero
            item: P626_CADASTRADO
        }
        error {
            errorMessage: #LABEL# deve ter algum valor.
            associatedItem: @P626_CADASTRADO
        }
        serverSideCondition {
            type: request=Value
            value: INSERIR
        }
    )

    validation datanascimento-obrigatório (
        name: DATANASCIMENTO obrigatório
        execution {
            sequence: 40
        }
        validation {
            type: itemIsNotNull
            item: P626_DATANASCIMENTO
        }
        error {
            errorMessage: Data de Nascimento deve ter uma data válida.
            associatedItem: @P626_DATANASCIMENTO
        }
        serverSideCondition {
            type: request=Value
            value: INSERIR
        }
    )

    validation fone1-fone2-ou-email-obrigatórios (
        name: FONE1, FONE2 ou EMAIL obrigatórios
        execution {
            sequence: 30
        }
        validation {
            plsqlExpression: (:P626_FONE is not null) OR (:P626_FONE2 is not null) or (:P626_EMAIL is not null)
        }
        error {
            errorMessage: Fone 1, Fone 2 ou E-mail devem ser informados.
            displayLocation: inlineInNotification
            associatedItem: @P626_EMAIL
        }
        serverSideCondition {
            type: request=Value
            value: INSERIR
        }
    )

    validation nome-obrigatório (
        name: NOME obrigatório
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P626_NOMECOMPLETO
        }
        error {
            errorMessage: Nome deve ter um valor.
            associatedItem: @P626_NOMECOMPLETO
        }
        serverSideCondition {
            type: request=Value
            value: INSERIR
        }
    )

    validation origem-obrigatório (
        name: ORIGEM obrigatório
        execution {
            sequence: 90
        }
        validation {
            type: itemIsNotNull
            item: P626_ORIGEM
        }
        error {
            errorMessage: Origem deve ter um valor.
            associatedItem: @P626_ORIGEM
