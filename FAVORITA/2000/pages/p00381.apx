    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P381_DOCUMENTO (
        type: textField
        label {
            label: Documento
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction busca-dados-relatório (
        name: Busca Dados Relatório
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P381_DOCUMENTO
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P381_DOCUMENTO
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @controle-de-alterações-em-históricos-de-consulta
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

