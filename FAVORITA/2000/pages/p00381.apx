page 381 (
    name: Controle de Alterações em Históricos de Consulta
    title: Controle de Alterações em Históricos de Consulta
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region controle-de-alterações-em-históricos-de-consulta (
        name: Controle de Alterações em Históricos de Consulta
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select h.idlog
                     , h.usuarioalteracao "Alterado Por"
                     , h.alteracao
                     , h.dataalteracao
                     , h.idhistoricoconsultadoc "Protocolo"
                     , h.dataconsulta
                     , h.documento
                     , h.descliberado "Liberado"
                     , h.codigoliberacao
                     , h.nroconsultaspc "Nr Consulta"
                     , h.representante
                     , h.semana
                     , h.usuario "Consultado Por"
                     , h.filial
                     , h.representante_novo
                     , h.observacao
                from roman.vw_log_historicosconsultasdoc h
                where replace(replace(replace(h.documento,'.',''),'-',''),' ','') = replace(replace(replace(:P381_DOCUMENTO,'.',''),'-',''),' ','')
                order by 1 desc
                ```
            pageItemsToSubmit: P381_DOCUMENTO
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado. Verifique o Documento.
        }
        advanced {
            savedReportMappingIdentifier: 3089811607772784606
        }

        column ALTERACAO (
            type: plainText
            heading {
                heading: Tipo
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column "Alterado Por" (
            type: plainText
