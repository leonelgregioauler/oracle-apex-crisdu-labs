page 287 (
    name: Datas de Remessas de Pedidos
    title: Datas de Remessas de Pedidos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastros (
        name: Cadastros
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @opções
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    region datas-de-remessas-de-pedidos (
        name: Datas de Remessas de Pedidos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDDATAREGIAO
                     , IDREGIAO
                     , DIASEMANALIMITEPEDIDOS
                     , PRAZOENTREGA
                     , DATAENTREGA
                     , FAZERATEMEIODIA
                     , DATAENTREGA - PRAZOENTREGA ATE
                from DATASREGIOES
                 where idregiao = :P287_IDREGIAO
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 7566594257293511122
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @ATE
                layout {
                    frozen: true
                    width: 153
                    sequence: 5
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDDATAREGIAO
                layout {
                    frozen: true
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDREGIAO
                layout {
                    frozen: true
                    width: 221
                    sequence: 2
                }
            )

            displayColumn (
                column: @DIASEMANALIMITEPEDIDOS
                layout {
                    frozen: true
                    width: 242
                    sequence: 3
                }
            )

            displayColumn (
                column: @PRAZOENTREGA
                layout {
                    frozen: true
                    width: 230
                    sequence: 4
                }
            )

            displayColumn (
                column: @DATAENTREGA
                layout {
                    frozen: true
                    sequence: 6
                }
            )

            displayColumn (
                column: @FAZERATEMEIODIA
                layout {
                    width: 329
                    sequence: 7
                }
            )

            sort (
                column: @DATAENTREGA
                sort {
                    nulls: last
                    sequence: 1
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column ATE (
            type: datePickerJquery
            heading {
                heading: Passar Até
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                databaseColumn: ATE
                dataType: date
                queryOnly: true
            }
            readOnly {
                type: always
            }
        )

        column DATAENTREGA (
            type: datePickerJquery
            heading {
                heading: Data de Entrega
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                databaseColumn: DATAENTREGA
                dataType: date
            }
        )

        column DIASEMANALIMITEPEDIDOS (
            type: selectList
            heading {
                heading: Limite para efetuar pedidos
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(dia) as d
                         , dia as r
                    from ( select 'SEGUNDA-FEIRA' dia
                                , 1  ordem
                           from dual
                           union
                           select 'TERÇA-FEIRA' 
                                , 2  ordem
                           from dual
                           union
                           select 'QUARTA-FEIRA' 
                                , 3  ordem
                           from dual
                           union
                           select 'QUINTA-FEIRA' 
                                , 4  ordem
                           from dual
                           union
                           select 'SEXTA-FEIRA' 
                                , 5  ordem
                           from dual
                           union
                           select 'SÁBADO' 
                                , 6  ordem
                           from dual
                           union
                           select 'DOMINGO'
                                , 7  ordem
                           from dual)
                    order by   ordem
                    ```
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: DIASEMANALIMITEPEDIDOS
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column FAZERATEMEIODIA (
            type: selectList
            heading {
                heading: Fazer Até Meio-Dia
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC:Sim;S
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                databaseColumn: FAZERATEMEIODIA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDDATAREGIAO (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDDATAREGIAO
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: seq_iddataregiao
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDREGIAO (
            type: selectList
            heading {
                heading: Região
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nomeregiao as d
                         , idregiao   as r
                    from regioes
                    ```
                nullDisplayValue: - Selecione uma Região -
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IDREGIAO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
            enableUsersTo {
                sort: false
            }
            readOnly {
                type: always
            }
        )

        column PRAZOENTREGA (
            type: numberField
            heading {
                heading: Prazo de Entrega
                alignment: center
            }
            settings {
                numberAlignment: center
                virtualKeyboard: text
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                databaseColumn: PRAZOENTREGA
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

    )

    region opções (
        name: Opções
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                  cursor c1 is
                  select distinct
                         r.idregiao
                       , r.nomeregiao
                       , substr(dr.cor, 10, length(dr.cor) -9) cor
                  from vw_datasremessaspedidos_fav dr 
                     , regioes r
                  where dr.idregiao(+) = r.idregiao;
                  --
                  r1 c1%rowtype;
                  --
                begin
                  -- 
                  htp.p('<p> Legenda das Regiões </p>');
                  --
                  open c1;
                  loop
                    fetch c1 into r1;
                    exit when c1%notfound;
                    
                    htp.p('<table>                                                                      ');
                    htp.p('<tbody>                                                                      ');
                    htp.p('<tr>                                                                         ');
                    htp.p('<td style="background-color:'||r1.cor||'; width: 30px;"></td>                ');
                    htp.p('<td style="padding-left: 8px;">'||r1.nomeregiao||'</td>                      ');
                    htp.p('</tr>                                                                        ');
                    htp.p('</table>                                                                     ');
                    --
                  end loop;
                  close c1;
                  --
                end;
                ```
        }
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P287_DIASEMANALIMITEPEDIDOS (
        type: selectList
        label {
            label: Dia Semana Limite
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(dia) as d
                     , dia as r
                from ( select 'SEGUNDA-FEIRA' dia
                            , 1  ordem
                       from dual
                       union
                       select 'TERÇA-FEIRA' 
                            , 2  ordem
                       from dual
                       union
                       select 'QUARTA-FEIRA' 
                            , 3  ordem
                       from dual
                       union
                       select 'QUINTA-FEIRA' 
                            , 4  ordem
                       from dual
                       union
                       select 'SEXTA-FEIRA' 
                            , 5  ordem
                       from dual
                       union
                       select 'SÁBADO' 
                            , 6  ordem
                       from dual
                       union
                       select 'DOMINGO'
                            , 7  ordem
                       from dual)
                order by   ordem
                ```
        }
        layout {
            sequence: 20
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P287_FAZERATEMEIODIA (
        type: checkboxGroup
        label {
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Fazer até meio-dia;S
            displayExtraValues: false
        }
        layout {
            sequence: 50
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P287_GERARATE (
        type: datePickerJquery
        label {
            label: Gerar Até
            alignment: left
        }
        layout {
            sequence: 40
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P287_IDREGIAO (
        type: selectList
        label {
            label: Regiões
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct 
                       r.nomeregiao as d,
                       r.idregiao as r
                  from regioes r
                     , regioesfiliais rf
                 where r.idregiao = rf.idregiao
                 order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione -
        }
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P287_PRAZOENTREGA (
        type: numberField
        label {
            label: Prazo Entrega
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 30
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    button gerar (
        buttonName: GERAR
        label: Gerar
        layout {
            sequence: 60
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button regioes (
        buttonName: REGIOES
        label: Regiões
        layout {
            sequence: 20
            region: @cadastros
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 290
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button regioesfiliais (
        buttonName: REGIOESFILIAIS
        label: Vincular Região à Filial
        layout {
            sequence: 30
            region: @cadastros
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 291
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction filtrar-e-atualizar (
        name: Filtrar e Atualizar
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P287_IDREGIAO
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation dia-semana-limite-obrigatório (
        name: Dia Semana Limite Obrigatório
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P287_DIASEMANALIMITEPEDIDOS
        }
        error {
            errorMessage: Dia da semana deve ser informado
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'GERAR'
        }
    )

    validation gera-até-obrigatório (
        name: Gera Até Obrigatório
        execution {
            sequence: 40
        }
        validation {
            type: itemIsNotNull
            item: P287_GERARATE
        }
        error {
            errorMessage: Data deve ser informada
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'GERAR'
        }
    )

    validation prazo-de-entrega-obrigatório (
        name: Prazo de Entrega Obrigatório
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P287_PRAZOENTREGA
        }
        error {
            errorMessage: Prazo de Entrega deve ser informado
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'GERAR'
        }
    )

    validation região-obrigatória (
        name: Região Obrigatória
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P287_IDREGIAO
        }
        error {
            errorMessage: Região deve ser informada
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'GERAR'
        }
    )

    process gera-datas-limites-e-datas-entrega (
        name: Gera Datas Limites e Datas Entrega
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  if v('REQUEST') = 'GERAR' then
                    --
                    pck_pedidos_fav.prc_geradataslimiteentregaped ( :P287_IDREGIAO
                                                                  , :P287_DIASEMANALIMITEPEDIDOS
                                                                  , :P287_PRAZOENTREGA 
                                                                  , :P287_GERARATE
                                                                  , :P287_FAZERATEMEIODIA );
                    --
                  end if;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Datas Geradas com Sucesso!
        }
        advanced {
            executionMappingIdentifier: 1526166399578439653
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'GERAR'
        }
    )

    process save-interactive-grid-data (
        name: " - Save Interactive Grid Data"
        type: interactiveGridAutoRowProcessing
        editableRegion: @datas-de-remessas-de-pedidos
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1526160558337439647
        }
    )

)

