page 171 (
    name: Distribuidoras
    title: Distribuidoras
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region distribuidoras (
        name: Distribuidoras
        type: list
        source {
            list: @relatorios-distribuidoras
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            listTemplate: @/cards
            templateOptions: [
                #DEFAULT#
                t-Cards--featured force-fa-lg
                t-Cards--displayIcons
                t-Cards--5cols
                u-colors
                t-Cards--animColorFill
            ]
        }
    )

)

