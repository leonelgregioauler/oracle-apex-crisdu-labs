page 476 (
    name: Falhas de Integração Total Express
    title: Falhas de Integração Total Express
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region desc-total-exp (
        name: Desc Total exp
        type: staticContent
        source {
            htmlCode: Pedidos que tiveram erro de integração, ou não foram entregados com a remessa sendo despachada.
        }
        layout {
            sequence: 10
            parentRegion: @integração-total-express
            slot: subRegions
        }
        appearance {
            template: @/alert
            templateOptions: [
                #DEFAULT#
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--warning
            ]
        }
    )

    region falhas-de-integração-total-express (
        name: Falhas de Integração Total Express
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idcompratransferencia as "Nr Remessa",
                       c.dataembarque as "Dt Embarque",
                       p.idpedido as "Pedido",
                       p.dataemissao as "Dt Emissão",
                       pr.descretornototalexp "Retorno Total exp",
                       pck_util_fav.fnc_link_pedido(pid_pedido => pr.idpedido, pnova_guia => 'S') as link_ped,
                       --apex_util.prepare_url('f?p=&APP_ID.:464:&SESSION.::NO::P464_IDCOMPRATRANSFERENCIA:'||c.idcompratransferencia),
                       'javascript:window.open("'||apex_util.prepare_url('f?p=&APP_ID.:464:&SESSION.::NO::P464_IDCOMPRATRANSFERENCIA:'||c.idcompratransferencia)||'","_blank");' as link_rem
                from pedidosremessasct pr,
                     comprastransferencias c,
                     pedidos p
                where pr.idcompratransferencia = c.idcompratransferencia
                and pr.idpedido = p.idpedido 
                and c.idtipocomptransrem = 8
                and p.datacancelamento is null
                and not exists (select 1
                               from eventosentregaspedidos ev
                               where ev.idpedido = p.idpedido)
                and c.dataembarque <= sysdate -2
                ```
        }
        layout {
            sequence: 20
            parentRegion: @integração-total-express
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 5027707225515882783
        }

        column "Dt Embarque" (
            type: plainText
            heading {
                heading: Dt embarque
            }
            layout {
                sequence: 20
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: G
            }
        )

        column "Dt Emissão" (
            type: plainText
            heading {
                heading: Dt Emissão
            }
            layout {
                sequence: 40
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: B
            }
        )

        column LINK_PED (
            type: hidden
            heading {
                heading: Link ped
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
            security {
                escapeSpecialChars: false
            }
        )

        column LINK_REM (
            type: hidden
            heading {
                heading: Link rem
            }
            layout {
                sequence: 70
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: J
            }
            security {
                escapeSpecialChars: false
            }
        )

        column "Nr Remessa" (
            type: link
            heading {
                heading: Nr Remessa
            }
            layout {
                sequence: 10
            }
            link {
                target: {
                    type: url
                    url: #LINK_REM#
                }
                linkText: #Nr Remessa#
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        column Pedido (
            type: link
            heading {
                heading: Pedido
            }
            layout {
                sequence: 30
            }
            link {
                target: {
                    type: url
                    url: #LINK_PED#
                }
                linkText: #Pedido#
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column "Retorno Total exp" (
            type: plainText
            heading {
                heading: Retorno Total Exp
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 50277105 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn "Dt Embarque" (
                sequence: 5
            )

            displayColumn "Dt Emissão" (
                sequence: 2
            )

            displayColumn LINK_PED (
                sequence: 6
            )

            displayColumn LINK_REM (
                sequence: 7
            )

            displayColumn "Nr Remessa" (
                sequence: 3
            )

            displayColumn "Pedido" (
                sequence: 1
            )

            displayColumn "Retorno Total exp" (
                sequence: 4
            )

        )

    )

    region integração-total-express (
        name: Integração Total Express
        type: staticContent
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from pedidosremessasct pr,
                     comprastransferencias c,
                     pedidos p
                where pr.idcompratransferencia = c.idcompratransferencia
                and pr.idpedido = p.idpedido 
                and c.idtipocomptransrem = 8
                and p.datacancelamento is null
                and not exists (select 1
                               from eventosentregaspedidos ev
                               where ev.idpedido = p.idpedido)
                and c.dataembarque <= sysdate -2
                ```
        }
    )

)

