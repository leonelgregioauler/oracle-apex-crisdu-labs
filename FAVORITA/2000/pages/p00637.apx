page 637 (
    name: Conferência Descarga Picking
    title: Conferência Descarga Picking
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 800
        height: 700
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region itens-inventário (
        name: Itens Inventário
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select favorita.pck_util_fav.fnc_nomecategoria(p.idcategoria,f.idpais)
                         from favorita.produtos p
                         where p.idproduto = pd.idproduto) categoria
                     , nvl( ( select skuVirtualAge
                              from deparaprodfavoritavirtualage xx
                              where xx.idprodutodetalhado = pd.idprodutodetalhado), 6000000 + pd.idprodutodetalhado  ) SKU
                     , favorita.pck_util_fav.fnc_nomeprodutodetalhado(pd.idprodutodetalhado,f.idpais) produto
                     , pd.idprodutodetalhado
                     , ip.qtdfisicacontada
                from favorita.itensinventariopicking ip
                   , favorita.inventariospicking ivp
                   , favorita.inventariociclico ivc
                   , favorita.itensinventariociclico itc 
                   , favorita.filiaisfavorita f
                   , favorita.produtosdetalhados pd
                where ivp.idinventariopicking     = ip.idinventariopicking
                  and ivp.idinventariociclico     = ivc.idinventariociclico
                  and ip.iditensinventariociclico = itc.iditensinventariociclico
                  and f.idfilialfavorita          = ivc.idfilial
                  and pd.idprodutodetalhado       = itc.idprodutodetalhado
                  and ivc.idinventariociclico   = :P637_IDINVENTARIOCICLICO
                  and ivp.idinventariopicking  = :P637_FILTRODESCARGAS
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }

        column CATEGORIA (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Categoria
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column IDPRODUTODETALHADO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Id Produto Detalhado
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
        )

        column PRODUTO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 4
            }
        )

        column QTDFISICACONTADA (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Qtd Física Contada
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
        )

        column SKU (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: SKU
                alignment: center
            }
            layout {
                sequence: 2
            }
        )

    )

    pageItem P637_DATACARGA (
        type: displayOnly
        label {
            label: "Data Carga: "
            alignment: left
        }
        settings {
            format: htmlUnsafe
            sendOnPageSubmit: false
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr HH24:MI:SS
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select to_char((ip.datacarga),'DD/MM/YYYY HH24:MI:SS') 
                from favorita.inventariospicking ip
                where ip.idinventariopicking = :P637_FILTRODESCARGAS
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P637_DATACRIACAO (
        type: displayOnly
        label {
            label: Data Criação:
            alignment: left
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select i.datacriacao 
                  from favorita.inventariociclico i
                  where i.idinventariociclico = :P637_IDINVENTARIOCICLICO
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P637_DATADESCARGA (
        type: displayOnly
        label {
            label: Data Descarga:
            alignment: left
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr HH24:MI:SS
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select to_char((ip.datadescarga),'DD/MM/YYYY HH24:MI:SS') 
                from favorita.inventariospicking ip
                where ip.idinventariopicking = :P637_FILTRODESCARGAS
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P637_FILIAL (
        type: selectList
        label {
            label: Filial:
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nomefilialfavorita display_value
                     , f.idfilialfavorita return_value
                from favorita.filiaisfavorita f
                where f.idfilialfavorita = :P637_FILIAL
                ```
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P637_FILTRODESCARGAS (
        type: selectList
        label {
            label: Filtro Descargas Picking
            alignment: left
        }
        settings {
            pageActionOnSelection: submitPage
            executeValidations: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Lista Picking: ' || ip.idinventariopicking || ' - ' || 'Descarga: ' ||  favorita.pck_util_fav.fnc_nomeusuario(ip.idusuariodescarga) display
                     , ip.idinventariopicking return
                from favorita.inventariospicking ip 
                where ip.idinventariociclico = :P637_IDINVENTARIOCICLICO
                  and ip.idfilial = :P637_FILIAL
                order by ip.idinventariopicking desc
                ```
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P637_IDINVENTARIOCICLICO (
        type: hidden
        layout {
            sequence: 100
            region: @filtros
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P637_TIPOINVENTARIO (
        type: selectList
        label {
            label: Inventário Favorita:
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select decode(ic.tipoinventario, 'C','Cíclico','G','Geral')  display_value
                     , ic.tipoinventario return_value
                from favorita.inventariociclico ic
                where ic.tipoinventario = :P637_TIPOINVENTARIO
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P637_USUARIOCARGA (
        type: displayOnly
        label {
            label: Usuário Carga:
            alignment: left
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomeusuario(ip.idusuariocarga)
                from favorita.inventariospicking ip
                where ip.idinventariopicking = :P637_FILTRODESCARGAS
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P637_USUARIOCRIACAO (
        type: selectList
        label {
            label: Usuário Criação:
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select u.usuario display_value
                     , u.idusuario return_value
                from catal.usuarios u 
                where u.idusuario = :P637_USUARIOCRIACAO
                ```
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P637_USUARIODESCARGA (
        type: displayOnly
        label {
            label: Usuário Descarga:
            alignment: left
        }
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomeusuario(ip.idusuariodescarga)
                from favorita.inventariospicking ip
                where ip.idinventariopicking = :P637_FILTRODESCARGAS
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button voltar (
        buttonName: Voltar
        label: Voltar
        layout {
            sequence: 110
            region: @filtros
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 526
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 526
                items: {
                    P526_IDINVENTARIOCICLICO: &P637_IDINVENTARIOCICLICO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @voltar
        }
    )

)

