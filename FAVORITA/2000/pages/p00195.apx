page 195 (
    name: Cadastro de Produtos Prateleiras
    title: Cadastro de Produtos Prateleiras
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG_23"';
    }
    security {
        authentication: public
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region produtos-por-prateleira (
        name: Produtos por Prateleira
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.produtodetalhado
                from vw_produtosprateleirasest_fav f
                where f.ididioma = 1
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P195_REFERENCIA
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 31481671393575111
        }

        column PRODUTODETALHADO (
            type: plainText
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 316394 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn PRODUTODETALHADO (
                sequence: 1
            )

        )

    )

    region selecione-o-corredor-e-prateleira (
        name: Selecione o Corredor e Prateleira
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P195_IDCORREDORESTOQUE (
        type: selectList
        label {
            label: Corredor
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-corredoresestoquesfilial
        }
        layout {
            sequence: 10
            region: @selecione-o-corredor-e-prateleira
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P195_IDPRATELEIRAESTOQUE (
        type: selectList
        label {
            label: Prateleira
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select descricao as d,
                       idprateleiraestoque as r
                  from prateleirasestoques
                where idcorredorestoque = :P195_IDCORREDORESTOQUE
                ```
        }
        cascadingLov {
            parentItems: P195_IDCORREDORESTOQUE
        }
        layout {
            sequence: 20
            region: @selecione-o-corredor-e-prateleira
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P195_REFERENCIA (
        type: popupLov
        label {
            label: Referência
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.referencia||' - '||initcap(p.nomeproduto) display_value
                     , p.idproduto return_value
                from produtos p
                order by p.nomeproduto
                ```
        }
        layout {
            sequence: 30
            region: @selecione-o-corredor-e-prateleira
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 10
            region: @selecione-o-corredor-e-prateleira
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 44
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button incluir (
        buttonName: INCLUIR
        label: Incluir
        layout {
            sequence: 20
            region: @selecione-o-corredor-e-prateleira
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process cadastra-produtos-prateleira (
        name: Cadastra Produtos Prateleira
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_estoque_fav.prc_prodprateleirareferencia(pidprateleiraestoque => :P195_IDPRATELEIRAESTOQUE,
                                                               pidproduto           => :P195_REFERENCIA);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Produtos Cadastrados!
        }
        advanced {
            executionMappingIdentifier: 31481149966575106
        }
    )

    branch (
        name: iniciar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 195
                items: {
                    P195_IDCORREDORESTOQUE: &P195_IDCORREDORESTOQUE.
                    P195_IDPRATELEIRAESTOQUE: &P195_IDPRATELEIRAESTOQUE.
                    P195_REFERENCIA: &P195_REFERENCIA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @incluir
        }
    )

)

