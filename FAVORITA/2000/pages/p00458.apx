page 458 (
    name: Impressão Pré Lista de Postagem - PLP - Resumida
    title: Impressão Pré Lista de Postagem - PLP - Resumida
    appearance {
        pageTemplate: @imprimir
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region impressão-pré-lista-de-postagem-resumida (
        name: Impressão Pré Lista de Postagem Resumida
        type: plSqlDynamicContent
        source {
            plsqlCode: pck_correios_fav.prc_imprimeplpresumida (:P458_IDPRELISTAPOSTAGEM);
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P458_IDPRELISTAPOSTAGEM (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @impressão-pré-lista-de-postagem-resumida
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

