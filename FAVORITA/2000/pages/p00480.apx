page 480 (
    name: Impressão de Pedidos Igrejinha Express
    title: Impressão de Pedidos Igrejinha Express
    appearance {
        pageTemplate: @minimal-pedido
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region new (
        name: New
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  vid_idioma number   := 1;
                  vid_usuario number  := pck_util_fav.fnc_retornaidusuario(:APP_USER);
                  vboleto number      := 1;
                  vpromissoria number := 1;
                  --
                  vvarcharresposta varchar2(4000);
                  vbool            boolean;
                  --
                begin
                  --
                  for c in ( select to_number(c001)  idpedido
                               from apex_collections
                              where collection_name = 'COL_PEDEXPRESSIMPRIME_'||v('APP_USER')
                  )
                  loop
                    --
                    /*imprime as etiquetas*/
                    /*pck_etiquetas.prc_imprimeetiquetaspedido(pidpedido => c.idpedido,
                                                            pididioma => vid_idioma,
                                                            pidusuario => vid_usuario);*/
                    pck_etiquetas.prc_etiquetas_usuario ( pidpedido       => c.idpedido
                                                        , pidusuario      => vid_usuario
                                                        , ptiposetiquetas => 'VA'
                                                        , pretorno        => vvarcharresposta
                                                        , psucesso        => vbool);
                    --
                    /*Imprime o pedido*/                                            
                    pck_imprime_fav.prc_pedidos(pidpedido    => c.idpedido,
                                                ppromissoria => vpromissoria,
                                                pboleto      => vboleto,
                                                pididioma    => vid_idioma,
                                                pidusuario   => vid_usuario);
                    --
                    pck_movimentarpedidos_fav.prc_atz_situacaoentrega_auto(pidpedido => c.idpedido,
                                                                          pidusuario => vid_usuario);
                    --
                  end loop;
                  --
                  commit;
                  --
                end;
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: request=Value
            value: IMPRIMIR
        }
    )

    pageItem P480_IDPEDIDO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @new
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

