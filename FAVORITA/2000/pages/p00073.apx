    pageItem P73_IDPOSTOAVANCADODESTINO (
        type: selectList
        label {
            label: Posto Avançado
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomepostoavancado(p.idpostoavancado) display_value
                     , p.idpostoavancado
                from roman.postoavancado p
                where :P73_IDFILIALROMANCEDESTINO is null or p.idfilial = :P73_IDFILIALROMANCEDESTINO
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 120
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
