page 73 (
    name: Relatório de Compras e Transferências
    title: Compras, Transferências e Remessas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region compras-transferências-e-remessas (
        name: Compras, Transferências e Remessas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idcompratransferencia
                     , c.idfornecedor
                     , c.nomefornecedor
                     , c.idfilialfavoritaorigem
                     , c.filialfavoritaorigem
                     , c.idfilialfavoritadestino
                     , c.filialfavoritadestino
                     , c.idfilialromancedestino
                     , c.filialromancedestino
                     , c.idpostoavancadodestino
                     , c.postoavancadodestino
                     , c.numero
                     , c.situacao
                     , c.notafiscal
                     , c.dataemissao
                     , c.datarecebimento
                     , c.desctipo
                     , c.valortotalcompra
                     , c.valortotalrecebido
                     , c.semana
                     , c.volume
                     , c.dataprevisaoentrega 
                     , c.descidentificacao
                     , c.transportadora
                     , c.datadespacho
                     , c.observacao
                    /* , trunc(c.dataprevisaoentrega) - 
                       (select trunc(dataclassificado)
                          from vw_classificacoescompras_fav
                         where idcompratransferencia = c.idcompratransferencia
                           and ididioma = 1
                           and idcaracteristicacomptransf = 4)    diasEntrega */
                     --           
                     , nvl((select trunc(dataclassificado)
                          from favorita.vw_classificacoescompras_fav
                         where idcompratransferencia = c.idcompratransferencia
                           and ididioma = 1
                           and IDCLASSIFICACAOCOMPRATRANSF = (select max(IDCLASSIFICACAOCOMPRATRANSF) 
                                                             from classificacoescomprastransf z
                                                              where z.idcompratransferencia = c.idcompratransferencia
                                                                and idcaracteristicacomptransf = 6)
                           and idcaracteristicacomptransf = 6),trunc(sysdate)) - 
                        (select trunc(dataclassificado)
                          from favorita.vw_classificacoescompras_fav
                         where idcompratransferencia = c.idcompratransferencia
                           and ididioma = 1
                           and idcaracteristicacomptransf = 4) diasEntrega
                     --
                     ,  case when c.dataprevisaoentrega < trunc(sysdate) and c.idsituacao = 20 and c.idTipoCompTransRem in (0,1)
                                then 'R' -- Red (Vencidos)
                            when c.dataprevisaoentrega >= trunc(sysdate) and c.idsituacao = 20 and c.idTipoCompTransRem in (0,1)
                                then 'G' -- Green (A Vencer)
                            when c.idsituacao = 3 -- Aguardando Montagem de Volumes
                                and exists ( select 1
                                               from favorita.classificacoescomprastransf lib
                                              where lib.idcompratransferencia = c.idcompratransferencia
                                                and lib.idcaracteristicacomptransf = 24 ) -- Liberado para Separação
                                then 'L' -- nova cor: remessa já liberada/em separação
                            else
                                'N' -- Normal
                        end "Cor"
                     , c.cubagem
                     , c.peso
                     , (trunc(sysdate) - trunc(c.dataemissao)) diferenca_dias
                     , case when (select count(*) --Quantidade Recebida Em Loja Menor Que Enviada Pelo Estoque.
                                    from favorita.classificacoescomprastransf y
                                   where y.idcompratransferencia = c.idcompratransferencia
                                     and y.idcaracteristicacomptransf = 29) > 0 then 'Sim' else 'Não' end divergencia
                     , (select sum(nvl(i.quantidadecomprada,0)) from itenscomprastransferencias i where i.idcompratransferencia = c.idcompratransferencia) qtd_itens
                     , nvl(( select sum(i.quantidaderecebida)
                               from favorita.itenscomprastransferencias i
                              where i.idcompratransferencia = c.idcompratransferencia ), 0) quantidaderecebida --T14245927 
                     , (select count(*) from itenscomprastransferencias i where i.idcompratransferencia = c.idcompratransferencia) qtd_skus
                          , CASE
                        WHEN EXISTS (
                            SELECT 1
                              FROM classificacoescomprastransf cct
                             WHERE cct.idcompratransferencia = c.idcompratransferencia
                               AND cct.idcaracteristicacomptransf = 31
                        )
                        AND (
                            SELECT ct.idtipocomptransrem
                              FROM comprastransferencias ct
                             WHERE ct.idcompratransferencia = c.idcompratransferencia
                        ) IN (0, 1)
                        THEN 'SIM'
                        ELSE 'NÃO'
                    END AS "RFID"
                from vw_comprastransferencias_fav c
                where ( :P73_TIPODATA = 'T' or ( :P73_TIPODATA = 'E' and c.dataemissao          between to_date(:P73_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss') and to_date(:P73_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss') )
                                            or ( :P73_TIPODATA = 'R' and c.datarecebimento      between to_date(:P73_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss') and to_date(:P73_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss') )
                                            or ( :P73_TIPODATA = 'Q' and c.dataembarque         between to_date(:P73_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss') and to_date(:P73_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss') )
                                            or ( :P73_TIPODATA = 'P' and c.dataprevisaoentrega  between to_date(:P73_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss') and to_date(:P73_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss') ) )
                  and ( :P73_TIPOMOVTO is null or c.idtipocomptransrem = :P73_TIPOMOVTO )
                  and ( :P73_IDFORNECEDOR is null or c.idfornecedor = :P73_IDFORNECEDOR ) 
                  and ( :P73_IDFILIALFAVORITAORIGEM is null or c.idfilialfavoritaorigem = :P73_IDFILIALFAVORITAORIGEM )
                  and ( :P73_IDFILIALFAVORITADESTINO is null or c.idfilialfavoritadestino = :P73_IDFILIALFAVORITADESTINO ) 
                  and ( :P73_IDFILIALROMANCEDESTINO is null or c.idfilialromancedestino = :P73_IDFILIALROMANCEDESTINO ) 
                  and ( :P73_IDPOSTOAVANCADODESTINO is null or c.idpostoavancadodestino = :P73_IDPOSTOAVANCADODESTINO )
                  and ( :P73_SITUACAO is null or c.idsituacao = :P73_SITUACAO )
                  and ( :P73_NUMERO is null or c.numero = :P73_NUMERO )
                  and ( :P73_NOTAFISCAL is null or c.notafiscal = :P73_NOTAFISCAL )
                  and c.ididioma = :P0_IDIDIOMA
                  and exists ( select 1
                               from permissoestiposctrp p
                               where p.idusuario = :P0_IDUSUARIO
                                 and p.idtipocomptransrem = c.idtipocomptransrem
                                 and p.visualizar = 'S' )
                  and ( pck_util_fav.fnc_verificaacesso(28401,:P0_IDUSUARIO) = 'S' 
                     or c.idfilialfavoritadestino = :P0_IDFILIALFAVORITA
                     or c.idfilialfavoritaorigem = :P0_IDFILIALFAVORITA
                     or exists ( select 1
                                 from atendimentosfiliaisrmc a
                                 where a.idfilialfavoritaorigem = :P0_IDFILIALFAVORITA
                                   and a.idfilialdestino = c.idfilialromancedestino ) )
                and c.idtipocomptransrem not in (8,9,10)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
