            alignment: left
        }
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from roman.usuariosgruposatendimento u
                 where u.idgrupoatendimento = 0
                   and u.usuario = v('APP_USER');
                ```
        }
    )

