    pageItem P73_SITUACAO (
        type: selectList
        label {
            label: Situação
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_retornasitcompratransf(s.idsituacaocompratransf,:P0_IDIDIOMA) display_value
                 , s.idsituacaocompratransf return_value
                from situacoescomprastransferencias s
                order by idsituacaocompratransf
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P73_TIPODATA (
        type: radioGroup
        label {
            alignment: left
        }
        settings {
            noOfCols: 5
        }
        lov {
            type: staticValues
            staticValues: STATIC:Emissão;E,Recebimento;R,Embarque;Q,Entrega;P
            displayExtraValues: false
            nullDisplayValue: Não Filtrar
            nullReturnValue: T
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: T
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P73_TIPOMOVTO (
        type: selectList
        label {
            label: Tipo
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_retornatipocomptransrem(t.idtipocomptransrem,:P0_IDIDIOMA) display_value
                  , t.idtipocomptransrem return_value
                from tiposcomptransrem t
                where exists ( select 1
                               from permissoestiposctrp p
                               where p.idtipocomptransrem = t.idtipocomptransrem
                                 and p.visualizar = 'S' 
                                 and p.idusuario = :P0_IDUSUARIO )
                and t.idtipocomptransrem not in (8,9,10)
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button btn-filtrar (
        buttonName: BTN_FILTRAR
        label: Filtrar
        layout {
            sequence: 10
            region: @filtros
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-filter
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: openModal('FILTROS');
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 74
                items: {
                    P74_IDCOMPRATRANSFERENCIA:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button vai-compra-transf (
        buttonName: VAI_COMPRA_TRANSF
        label: Let's Go Comp! Transf! (T.I)
        layout {
            sequence: 50
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from roman.usuariosgruposatendimento u
                 where u.idgrupoatendimento = 0
                   and u.usuario = v('APP_USER');
                ```
        }
    )

    branch (
        name: Filtrar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 73
                items: {
                    P73_TIPODATA: &P73_TIPODATA.
                    P73_DATAINICIO: &P73_DATAINICIO.
                    P73_DATAFIM: &P73_DATAFIM.
                    P73_TIPOMOVTO: &P73_TIPOMOVTO.
                    P73_IDFORNECEDOR: &P73_IDFORNECEDOR.
                    P73_IDFILIALFAVORITAORIGEM: &P73_IDFILIALFAVORITAORIGEM.
                    P73_IDFILIALFAVORITADESTINO: &P73_IDFILIALFAVORITADESTINO.
                    P73_SITUACAO: &P73_SITUACAO.
                    P73_NUMERO: &P73_NUMERO.
                    P73_NOTAFISCAL: &P73_NOTAFISCAL.
                    P73_IDFILIALROMANCEDESTINO: &P73_IDFILIALROMANCEDESTINO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @btn-filtrar
        }
    )

    branch (
        name: Go To 74 (T.I)
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 74
                items: {
                    P74_IDCOMPRATRANSFERENCIA: &P73_IDCOMPRATRANSFERENCIA_TI.
                }
            }
        }
    )

)

