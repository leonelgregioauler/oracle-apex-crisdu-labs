                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: csv
            sendAsEmail: false
            filename: remessas
        }
        advanced {
            savedReportMappingIdentifier: 7832373511228235
        }

