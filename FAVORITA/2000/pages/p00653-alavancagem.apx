page 653 (
    name: Alavancagem
    alias: ALAVANCAGEM
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1200
        height: 800
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            /*$('#P653_ATRIBUIDO').on('focus', function() {
                // Impede a edição do campo
                $(this).blur();
                // Alerta o usuário
                alert('Você não pode editar este campo diretamente.');
            });*/
            
            $('#P653_ALAVANCAGEM').on('focus', function() {
                // Impede a edição do campo
                $(this).blur();
                // Alerta o usuário
                alert('Você não pode editar este campo diretamente.');
            });
            
            $('#P653_LIMITE_ATUAL').on('focus', function() {
                // Impede a edição do campo
                $(this).blur();
                // Alerta o usuário
                alert('Você não pode editar este campo diretamente.');
            });
            
            // Função para formatar o número como moeda (com separador de milhar e vírgula para decimal)
            function formatarNumero(valor) {
                // Remove qualquer caractere não numérico, mas mantém apenas os números
                valor = valor.replace(/\D/g, '');
            
                // Converte o valor em número, dividindo por 100 para tratar como centavos
                var numeroFormatado = (parseInt(valor) / 100).toFixed(2).replace('.', ',');
            
                // Aplica a formatação de separação de milhar
                numeroFormatado = numeroFormatado.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
            
                // Retorna o valor formatado como moeda
                return numeroFormatado;
            }
            
            // Aplicar a máscara enquanto digita
            $('#P653_SOLICITADO').on('input', function() {
                var valorDigitado = $(this).val(); // Obtém o valor digitado
                var valorFormatado = formatarNumero(valorDigitado); // Formata o valor
                $(this).val(valorFormatado); // Aplica o valor formatado ao campo
            });
            
            // Aplicar a máscara enquanto digita
            $('#P653_ALAVANCAGEM').on('input', function() {
                var valorDigitado = $(this).val(); // Obtém o valor digitado
                var valorFormatado = formatarNumero(valorDigitado); // Formata o valor
                $(this).val(valorFormatado); // Aplica o valor formatado ao campo
            });
            
            // Forçar a atualização visual do campo P653_ATRIBUIDO com o valor formatado
            $('#P653_SOLICITADO').on('change', function() {
                var solicitado = $v('P653_SOLICITADO');
                var valorFormatado = formatarNumero(solicitado);
                $s('P653_ATRIBUIDO', valorFormatado); // Define o valor no item atribuído
                apex.item('P653_ATRIBUIDO').setValue(valorFormatado, null, true); // Força atualização visual
                $('#P653_ATRIBUIDO').css('color', 'red'); // Altera a cor do valor para vermelho
            });
            ```
    }

    region alavancagem (
