    dynamicAction alavancagem-para-atribuído (
        name: Alavancagem  para Atribuído
        execution {
            sequence: 20
        }
        when {
            event: keyup
            selectionType: items
            items: P653_ATRIBUIDO
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    // Função para formatar o número como moeda brasileira
                    function formatarNumero(valor) {
                        return valor
                            .toLocaleString('pt-BR', { // Formata o número de acordo com o padrão brasileiro
                                minimumFractionDigits: 2, // Exige 2 casas decimais
                                maximumFractionDigits: 2  // Limita a 2 casas decimais
                            });
                    }
                    
                    // Obtém os valores dos campos
                    var limiteAtual = parseFloat(
                        $v('P653_LIMITE_ATUAL').replace(/\./g, '').replace(',', '.')
                    ) || 0;
                    
                    var atribuido = parseFloat(
                        $v('P653_ATRIBUIDO').replace(/\./g, '').replace(',', '.')
                    ) || 0;
                    
                    // Calcula o valor atribuído somando limiteAtual e alavancagem
                    var atribuido = atribuido - limiteAtual;
                    
                    // Formata o valor atribuído como moeda brasileira
                    var atribuidoFormatado = formatarNumero(atribuido);
                    
                    // Atualiza o campo P653_ATRIBUIDO com o valor formatado
                    $s('P653_ALAVANCAGEM', atribuidoFormatado);
                    
                    // Força a atualização visual do campo, mesmo que esteja Read Only
                    apex.item('P653_ALAVANCAGEM').setValue(atribuidoFormatado, null, true);
                    
                    ```
            }
            affectedElements {
                selectionType: items
                items: P653_ATRIBUIDO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction solicitado-para-atribuído (
        name: Solicitado para Atribuído
        execution {
            sequence: 10
        }
        when {
            event: keyup
            selectionType: items
            items: P653_SOLICITADO
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var solicitado = $v('P653_SOLICITADO'); // Obtém o valor do item solicitado
                    
                    // Função para formatar o número como moeda (com separador de milhar e vírgula para decimal)
                    function formatarNumero(valor) {
                        // Remove qualquer caractere não numérico, mas mantém o ponto e a vírgula
                        valor = valor.replace(/\D/g, '');
                    
                        // Converte o valor em número, dividido por 100 para tratar como centavos
                        var numeroFormatado = (parseInt(valor) / 100).toFixed(2).replace('.', ',');
                    
                        // Aplica a formatação de separação de milhar
                        numeroFormatado = numeroFormatado.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
                    
                        // Retorna o valor formatado como moeda
                        return numeroFormatado;
                    }
                    
                    // Formata o valor de "solicitado"
                    var valorFormatado = formatarNumero(solicitado);
                    
                    // Define o valor no item P653_ATRIBUIDO
                    $s('P653_ATRIBUIDO', valorFormatado);
                    
                    // Força a atualização visual, mesmo se o item for Read Only
                    apex.item('P653_ATRIBUIDO').setValue(valorFormatado, null, true);
                    
                    // Altera a cor do valor para vermelho
                    $('#P653_ATRIBUIDO').css('color', 'red');
                    
                    ```
            }
            affectedElements {
                selectionType: items
                items: P653_ATRIBUIDO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    // Função para formatar o número como moeda brasileira
                    function formatarNumero(valor) {
                        return valor
                            .toLocaleString('pt-BR', { // Formata o número de acordo com o padrão brasileiro
                                minimumFractionDigits: 2, // Exige 2 casas decimais
                                maximumFractionDigits: 2  // Limita a 2 casas decimais
                            });
                    }
                    
                    // Obtém o valor atual do limite (P653_LIMITE_ATUAL)
                    // Remove pontos e vírgulas para interpretar corretamente como número
                    var limiteAtual = parseFloat(
                        $v('P653_LIMITE_ATUAL').replace(/\./g, '').replace(',', '.')
                    ) || 0;
                    
                    // Obtém o valor solicitado (P653_SOLICITADO)
                    // Também remove formatação e converte para número
                    var solicitado = parseFloat(
                        $v('P653_SOLICITADO').replace(/\./g, '').replace(',', '.')
                    ) || 0;
                    
                    // Calcula a diferença entre o valor solicitado e o limite atual
                    var alavancagem = solicitado - limiteAtual;
                    
                    // Formata o resultado como moeda brasileira
                    var alavancagemFormatada = formatarNumero(alavancagem);
                    
                    // Atualiza o campo P653_ALAVANCAGEM com o valor formatado
                    $s('P653_ALAVANCAGEM', alavancagemFormatada);
                    
                    // Força a atualização visual do campo P653_ALAVANCAGEM no caso de estar como "Read Only"
                    apex.item('P653_ALAVANCAGEM').setValue(alavancagemFormatada, null, true);
                    
                    ```
            }
            affectedElements {
                selectionType: items
                items: P653_ALAVANCAGEM
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                   :P653_TESTELIMITE := TO_NUMBER(:P653_TESTELIMITE,'999G999G999G999G990D00');
                EXCEPTION
                   WHEN VALUE_ERROR THEN
                      :P653_TESTELIMITE := NULL; -- Se der erro de conversão, define como NULL
                END;
                
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 760368478989877402
        }
    )

    process processa-dados (
        name: Processa dados
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vescolha varchar2(1);
                  vlimiteatual number;
                  vsolicitado number;
                  vatribuido number;
                  valavancagem number;
                  vidscorehistperformance number;  -- NOVO T15086912
                begin
                  -- Definindo o valor de vescolha com base no parâmetro REQUEST
                  if v('REQUEST') = 'NEGADO' then
                    vescolha := 'N';
                  elsif v('REQUEST') = 'ATRIBUIDO' then
                    vescolha := 'S';
                  end if;
                
                  -- Tratamento e conversão dos valores recebidos para números
                  -- Para cada variável, primeiro fazemos o REPLACE e depois convertemos para NUMBER
                  vlimiteatual := TO_NUMBER(REPLACE(REPLACE(:P653_LIMITE_ATUAL, '.', ''), ',', '.'), '9999999990.00');
                  vsolicitado   := TO_NUMBER(REPLACE(REPLACE(:P653_SOLICITADO, '.', ''), ',', '.'), '9999999990.00');
                  vatribuido    := TO_NUMBER(REPLACE(REPLACE(:P653_ATRIBUIDO, '.', ''), ',', '.'), '9999999990.00');
                  valavancagem  := TO_NUMBER(REPLACE(REPLACE(:P653_ALAVANCAGEM, '.', ''), ',', '.'), '9999999990.00');
                
                  -- NOVO: busca o snapshot de performance mais recente do documento --T15086912
                  select max(hp.idscorehistperformance)
                  into vidscorehistperformance
                  from roman.scorehistoricosperformance hp
                  where hp.cpf = :P653_DOCUMENTO
                    and hp.dataconsulta = ( select max(hp2.dataconsulta)
                                             from roman.scorehistoricosperformance hp2
                                             where hp2.cpf = :P653_DOCUMENTO );
                
                  -- Chamada da procedure passando as variáveis já convertidas
                  favorita.pck_analise_credito_score.prc_alavancagem( plimiteatual   => vlimiteatual,
                                                                      psolicitado    => vsolicitado,
                                                                      patribuido     => vatribuido,
                                                                      palavancagem   => valavancagem,
                                                                      psolicitadopor => :P653_SOLICITADOPOR,
                                                                      ptipo          => :P653_TIPO,
                                                                      pidvendedora   => :P653_IDVENDEDORA,
                                                                      pusuario       => v('APP_USER'),
                                                                      pescolha       => vescolha,
                                                                      porigem        => 'A', --'A'= Alavancagem
                                                                      pidscorehistperformance => vidscorehistperformance,  -- NOVO
                                                                      pdocumento     => :P653_DOCUMENTO);
                  /*if vescolha = 'S' then -- Tratamento para somente alterar o limite caso seja atribuido
                
                  update catal.pessoas ps
                  set ps.limitecredito = 0 --vatribuido
                  where ps.idpessoa = ( select v.idpessoa
                                        from vendedoras v
                                        where v.idvendedora = :P653_IDVENDEDORA );
                  end if;*/
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Alavancagem realizada com Sucesso!
        }
        advanced {
            executionMappingIdentifier: 374496508580413431
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: NEGADO,ATRIBUIDO
        }
    )

)

