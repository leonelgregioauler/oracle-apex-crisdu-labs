page 271 (
    name: Primeiro Acesso
    title: Primeiro Acesso
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        authentication: public
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region meu-primeiro-acesso (
        name: Meu Primeiro Acesso
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/login
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
            ]
            icon: fa-info-circle
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P271_IDUSUARIO (
        type: numberField
        label {
            label: ID do seu usuário
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 20
            region: @meu-primeiro-acesso
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Aqui você deve informar o ID que você anotou no aviso do sistema antigo!
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P271_NOVASENHA (
        type: password
        label {
            label: Nova Senha
            alignment: left
        }
        layout {
            sequence: 30
            region: @meu-primeiro-acesso
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Aqui você informa a sua nova senha. Com letras e números!
        }
        sessionState {
            storage: request
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P271_USUARIO (
        type: textField
        label {
            label: Usuário
            alignment: left
        }
        layout {
            sequence: 10
            region: @meu-primeiro-acesso
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Coloque aqui o seu nome de usuário.
        }
        security {
            encryptSessionState: false
        }
    )

    button trocarsenha (
        buttonName: TROCARSENHA
        label: Trocar Senha
        layout {
            sequence: 40
            region: @meu-primeiro-acesso
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation verifica-acesso (
        name: Verifica Acesso
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuarios
                where usuario = upper(:P271_USUARIO)
                  and idusuario = :P271_IDUSUARIO
                ```
        }
        error {
            errorMessage: Usuário/ID incorreto!
            associatedItem: @P271_IDUSUARIO
        }
    )

    process alterar-senha (
        name: Alterar Senha
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                 vpossui varchar2(1);
                  vexiste  varchar2(1);
                begin
                  Begin
                    --
                    select 'S'
                    into vexiste
                    from all_users a
                    where a.username = upper(:P271_USUARIO);
                    --
                    execute immediate 'alter user '||upper(:P271_USUARIO)||' identified by "'||:P271_NOVASENHA||'"';
                    --
                  exception
                    when others then
                       execute immediate 'create user '||upper(:P271_USUARIO)||' identified by "'||:P271_NOVASENHA||'"';
                  end;
                
                  begin
                    --
                    select 'S'
                    into vpossui
                    from dual
                    where exists (select 1
                                  from usuariossistemas 
                                  where usuario = upper(:P271_USUARIO) 
                                    and idsistema = 2000);
                  exception
                    when others then
                      vpossui := 'N';
                  end;
                  --
                  if vpossui = 'N' then
                    --
                    begin
                        insert into usuariossistemas (idusuariosistema,idsistema,usuario,ativo)
                        values (seq_idusuariossistema.nextval, 2000, upper(:P271_USUARIO), 'S');
                    exception
                      when others then
                        null;
                    end;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Senha alterada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 778986253257760028
        }
    )

    branch (
        name: Fazer login
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 101
                action: resetPagination
            }
        }
    )

)

