    region preços-cadastrados (
        name: Preços Cadastrados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select filialromance 
                     , valorcusto
                     , valorvenda
                     , w.perccomissaogerente
                     , w.perccomissaodistribuidor
                     , w.perccomissaoconsultora
                     , w.valorcomissaoatendente
                from vw_precosprodutos_fav w
                where idedicaorevista    = :P254_IDEDICAOREVISTA
                  and idprodutodetalhado = :P254_IDPRODUTODETALHADO
                  and ididioma           = :P0_IDIDIOMA
                ```
            pageItemsToSubmit: [
                P254_IDPRODUTODETALHADO
                P254_IDEDICAOREVISTA
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Não há preço cadastrado para esse produto.
        }
        advanced {
            savedReportMappingIdentifier: 580601291297132624
        }

