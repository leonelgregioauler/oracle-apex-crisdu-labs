    pageItem P254_IDEDICAOREVISTA (
        type: selectList
        label {
            label: Edição Revista
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-edicoesrevistas
            nullDisplayValue: - Selecione a Revista -
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P254_IDPRODUTODETALHADO (
        type: popupLov
        label {
            label: Produto Detalhado
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sharedComponent
            lov: @lov-produtosdetalhados
            nullDisplayValue: - Selecione o Produto Detalhado -
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 80
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P254_NAEDICAO (
        type: numberField
        label {
            label: Cadastrado na Edição
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P254_IDEDICAOREVISTA
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    begin
                      --
                      select nvl('Sim','Não')
                      into :P254_NAEDICAO
                      from favorita.produtosdetedrevistas pd
                      where pd.idprodutodetalhado = :P254_IDPRODUTODETALHADO
                        and pd.idedicaorevista = :P254_IDEDICAOREVISTA;
                      --
                    exception
                      when others then
                      :P254_NAEDICAO := 'Não';
                    end;
                    ```
            }
            affectedElements {
                selectionType: items
                items: P254_NAEDICAO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction onchange (
        name: onChange
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P254_IDPRODUTODETALHADO
                P254_IDEDICAOREVISTA
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @preços-cadastrados
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @kit-vendas
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh-3 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @promoções
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh-4 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @estoque-atual
            }
            execution {
