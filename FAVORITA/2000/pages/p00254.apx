    region promoções (
        name: Promoções
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nome
                     , p.datainicial||'<br>' ||p.datafinal periodo
                     , roman.pck_romance.fnc_nomefilial( p.idfilialromance) distribuidora
                     , p.valororiginal
                     , p.valorvenda
                     , p.perccomissaogerente
                     , p.perccomissaodistribuidor
                     , p.perccomissaoconsultora
                     , p.valorcomissaoatendente     
                from promocoesdivulgacoes p
                   , vw_produtosdetalhados_fav vp
                where p.idprodutodetalhado = vp.idprodutodetalhado
                  and p.idprodutodetalhado = :P254_IDPRODUTODETALHADO
                  and trunc(sysdate) between datainicial and datafinal
                  and vp.ididioma = :P0_IDIDIOMA
                ```
        }
        layout {
            sequence: 50
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        messages {
            whenNoDataFound: Não há promoções para este produto.
        }
