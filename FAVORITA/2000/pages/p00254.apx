    region kit-vendas (
        name: Kit Vendas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select k.referencia
                     , k.descricao
                     , i.valorvendaoriginal
                     , i.valorvenda
                     , i.perccomissaogerente
                     , i.perccomissaodistribuidor
                     , i.perccomissaoconsultora
                     , i.valorcomissaoatendente
                from vw_itenskitsvendas_fav  i
                   , vw_kitsvendas_fav  k
                where k.idkitvenda       = i.idkitvenda
                  and k.idedicaorevista  = i.idedicaorevista
                  and i.idedicaorevista    = :P254_IDEDICAOREVISTA
                  and i.idprodutodetalhado = :P254_IDPRODUTODETALHADO
                  and ididioma           = :P0_IDIDIOMA
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
