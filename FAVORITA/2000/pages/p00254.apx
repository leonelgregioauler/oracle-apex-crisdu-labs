page 254 (
    name: Análise de Preços de Produto
    title: Análise de Preços de Produto
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region estoque-atual (
        name: Estoque Atual
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select filialfavorita
                     , produto
                     , quantidade
                     , quantidadereservada
                     , quantidadereservadacgd
                     , quantidade  - quantidadereservada quantidadedisponivel
                     , permitevendernegativo
                     , buscardoestoqueabastecedor
                     , qtdestoqueminimo
                     , valorcusto
                     , quantidade * nvl(valorcusto,1) totalcusto
                from vw_estoques_fav e  
                where ( e.idprodutodetalhado = :P254_IDPRODUTODETALHADO )
                  and ididioma = :P0_IDIDIOMA
                ```
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        messages {
            whenNoDataFound: Não encontrou informações.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 2605188885891768540
        }

