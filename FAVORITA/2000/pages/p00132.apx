    pageItem P132_CPF_ETIQUETA (
        type: textField
        label {
            label: CPF
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @passo-2-com-etiqueta
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 12
        }
        validation {
            maxLength: 12
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select cpf
                from pessoas p
                   , vendedoras v
                   , pedidos pp
                where v.idpessoa = p.idpessoa
                  and pp.idpedido = :P132_IDPEDIDO_ETIQUETA
                  and pp.idvendedora = v.idvendedora
                  and :P132_CODBARRASPEDIDO is not null
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P0_IDIDIOMA = 1
                  and :P132_CODBARRASPEDIDO is not null
                ```
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

