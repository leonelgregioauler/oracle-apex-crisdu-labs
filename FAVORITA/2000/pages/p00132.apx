    dynamicAction define-tipo-de-documento-ci (
        name: Define tipo de documento (CI)
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P132_TIPODOCUMENTO
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: $("#P132_TIPODOCUMENTO").val() == 'CI'
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: items
                items: P132_CPF
            }
            execution {
                sequence: 30
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: items
                items: P132_DOCESTRANGEIRO
            }
            execution {
                sequence: 10
            }
        )

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P132_DOCESTRANGEIRO
            }
            execution {
                sequence: 40
            }
        )

        action native-set-value (
            action: setValue
            affectedElements {
                selectionType: items
                items: P132_CPF
            }
            execution {
                sequence: 20
            }
        )

    )

