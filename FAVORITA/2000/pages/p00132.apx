page 132 (
    name: 2a Etapa - (132)
    title: Segunda Etapa - (132)
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region novo-protocolo-de-atendimento (
        name: Novo Protocolo de Atendimento
        type: list
        source {
            list: @novo-protocolo-de-atendimento
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

    region passo-2-com-etiqueta (
        name: Passo 2 Com Etiqueta - (132)
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P132_ETIQUETA = 'S'
                  and :P132_IDTIPOPROTOCOLO = 1
                ```
        }
    )

    region passo-2-protocolos (
        name: Passo 2 Protocolos - (132)
        type: staticContent
        layout {
