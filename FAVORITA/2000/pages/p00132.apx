    process busca-pedido-após-bipado (
        name: Busca Pedido após Bipado
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vcodbarraspedido varchar2(100) := :P132_CODBARRASPEDIDO;
                  --
                  vidpedidofolha   number;
                  --
                  vexiste          varchar2(1);
                  vcontrole        number := 0;
                  --
                begin
                  --
                  <<PEDIDOFOLHA>>
                  select substr(vcodbarraspedido,2,length(vcodbarraspedido)-3)
                  into vidpedidofolha
                  from dual;
                  --
                  GOTO CONSULTAPEDIDO;
                  --
                  <<PEDIDOETIQUETA>>
                  select substr(vcodbarraspedido,2,length(vcodbarraspedido)-5)
                  into vidpedidofolha
                  from dual;
                  --
                  <<CONSULTAPEDIDO>>
                  begin
                    --
                    select 'S'
                    into vexiste
                    from pedidos p
                    where p.idpedido = vidpedidofolha
                      and p.datacancelamento is null;
                    --
                  exception
                    when NO_DATA_FOUND then
                      if vcontrole = 0 then
                        vexiste := 'N';
                        vcontrole := 1;
                        GOTO PEDIDOETIQUETA;
                      else
                        vexiste := 'N';
                      end if;
                  end;
                  --
                  if vexiste = 'S' then
                    --
                    :P132_IDPEDIDO := vidpedidofolha;
                    --
                    :P132_IDPEDIDO_ETIQUETA := vidpedidofolha;
                    --
                  else
                    --
                    apex_error.add_error ( p_message          => 'Pedido não localizado, verifique novamente!'
                                         , p_display_location => apex_error.c_inline_with_field );
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Pedido Encontrado!
        }
        error {
            errorMessage: Pedido Não Localizado!
        }
        advanced {
            executionMappingIdentifier: 1414246205329133322
        }
        serverSideCondition {
            type: request=Value
            value: BIPARPEDIDO
        }
    )

    process inicia-pedido-paris (
        name: Inicia Pedido Paris
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  
                  vidpedido                 number;
                  videdicaorevista          number;
                  vidsituacaoentrega        number;
                  vidsituacaofinanceiro     number;
                  vidsituacaocobranca       number;
                  vidfilialromance          number;
                  vidfilialfavorita         number := :P0_IDFILIALFAVORITA;
                  vidgerente                number;
                  vidrepresentante          number;
                  vidvendedora              number := :P132_IDVENDEDORA;
                  vidusuario                number := :P0_IDUSUARIO;
                  vnumeropedido             varchar2(100);
                  vdataemissao              date;
                  vdataentrega              date;
                  vdatadespacho             date;
                  vdatacancelamento         date;
                  vnumeroposicaoatendimento varchar2(100) := :P0_NUMEROPOSICAOATENDIMENTO;
                  vidpedidooriginal         number;
                  vrastreiotransporte       varchar2(100);
                  vvalortotal               number;
                  vvalorpontoutilizado      number;
                  vvalordesconto            number;
                  vvalortotalcomdesconto    number;
                  vvalorfrete               number;
                  vvalorapagar              number;
                  vtipopedido               varchar2(1) := 'F';
                  vidnegociadoraresponsavel number;
                  vemespera                 varchar2(1);
                  vedicaobloqueada          varchar2(1);
                  --
                  vidprotocoloatendimento number;
                  vdataprotocolo          date := sysdate;
                  vidfilial               number := vidfilialromance;
                  vsituacao               varchar2(1) := 'P';
                  vjustificativa          varchar2(2000);
                  vdataatendimento        date;
                  vobservacaointerna      varchar2(2000);
                  vidmotivoprotocolo      number :=12;
                  vcpf                    varchar2(11):=:P132_CPF;
                  vidtipoprotocolo        number:=:P132_IDTIPOPROTOCOLO;
                  vidusuarioatendeu       number;
                  vnumerocomprovante      varchar2(30);
                  vvalordepositado        number;
                  vdataprorrogacao        date;
                  vdatapagamento          date;
                  vcontapagamento         varchar2(30);
                  vmd5                    varchar2(2000);
                  vdocestrangeiro         varchar2(11):=:P132_DOCESTRANGEIRO;
                  --
                  nulo                    number:=null;
                  data                    number;
                  --
                  vvarnull                varchar2(1);
                  vnumnull                number;
                  vdatenull               date;
                  --
                begin
                  --
                  select idfilial
                  into vidfilialromance
                  from gerentes
                  where idgerente = ( select idgerente
                                      from usuarios
                                      where idusuario = :P0_IDUSUARIO);
                  --
                  select ff.idfilialfavorita
                  into vidfilialfavorita
                  from favorita.filiaisfavorita ff
                  where ff.idfilialromance = vidfilialromance
                    and ff.tipofilial = 'F';
                  --
                  vobservacaointerna:='Favorita Paris';
                  --
                  pck_pedidos_fav.prc_pedidos( pidpedido                 => vidpedido
                                             , pidedicaorevista          => videdicaorevista
                                             , pidsituacaoentrega        => vidsituacaoentrega
                                             , pidsituacaofinanceiro     => vidsituacaofinanceiro
                                             , pidsituacaocobranca       => vidsituacaocobranca
                                             , pidfilialromance          => vidfilialromance
                                             , pidfilialfavorita         => vidfilialfavorita
                                             , pidgerente                => vidgerente
                                             , pidrepresentante          => vidrepresentante
                                             , pidvendedora              => vidvendedora
                                             , pidusuario                => vidusuario
                                             , pnumeropedido             => vnumeropedido
                                             , pdataemissao              => vdataemissao
                                             , pdataentrega              => vdataentrega
                                             , pdatadespacho             => vdatadespacho
                                             , pdatacancelamento         => vdatacancelamento
                                             , pnumeroposicaoatendimento => vnumeroposicaoatendimento
                                             , pidpedidooriginal         => vidpedidooriginal
                                             , prastreiotransporte       => vrastreiotransporte
                                             , pvalortotal               => vvalortotal
                                             , pvalorpontoutilizado      => vvalorpontoutilizado
                                             , pvalordesconto            => vvalordesconto
                                             , pvalortotalcomdesconto    => vvalortotalcomdesconto
                                             , pvalorfrete               => vvalorfrete
                                             , pvalorapagar              => vvalorapagar
                                             , pemespera                 => vemespera
                                             , pedicaobloqueada          => vedicaobloqueada
                                             , ptipopedido               => vtipopedido
                                             , pidnegociadoraresponsavel => vidnegociadoraresponsavel
                                             , pmd5                      => vmd5
                                             , poperacao_dml             => 'I' ) ;
                  --
                  :P132_IDPEDIDO := vidpedido;
                  --
                  pck_protocolosatendimentos_fav.prc_protocolosatendimentos( pidprotocoloatendimento   => vidprotocoloatendimento
                                                                           , pidfilial                 => vidfilial
                                                                           , pidusuariosolicitou       => :P0_IDUSUARIO
                                                                           , pdataprotocolo            => VDATAPROTOCOLO
                                                                           , pidpedido                 => vidpedido
                                                                           , psituacao                 => vsituacao
                                                                           , pjustificativa            => vjustificativa
                                                                           , pdataatendimento          => vdataatendimento
                                                                           , pobservacaointerna        => vobservacaointerna
                                                                           , pidmotivoprotocolo        => vidmotivoprotocolo
                                                                           , pcpf                      => vcpf
                                                                           , pidtipoprotocolo          => vidtipoprotocolo
                                                                           , pidusuarioatendeu         => vidusuarioatendeu
                                                                           , pnumerocomprovante        => vnumerocomprovante
                                                                           , pvalordepositado          => vvalordepositado
                                                                           , pdataprorrogacao          => vdataprorrogacao
                                                                           , pdatapagamento            => vdatapagamento
                                                                           , pcontapagamento           => vdatapagamento
                                                                           , pdocestrangeiro           => vdocestrangeiro
                                                                           , pidrepresentante          => vidrepresentante
                                                                           , pparcelamentocomentrada   => vvarnull
                                                                           , pdatavencimentoentrada    => vdatenull
                                                                           , pvalorentradaparcelamento => vnumnull
                                                                           , pquantidadeparcelas       => vnumnull
                                                                           , pdiasprazoparcelas        => vnumnull
                                                                           , pmd5                      => vmd5
                                                                           , poperacao_dml             => 'I'   );
                  --
                  :P133_IDPROTOCOLOATENDIMENTO := vidprotocoloatendimento;
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 1548186168969138306
        }
        serverSideCondition {
            type: item=value
            item: P132_IDTIPOPROTOCOLO
            value: 13
        }
    )

