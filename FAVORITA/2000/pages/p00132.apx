            errorMessage: Não é possível continuar sem informar o pedido!
        }
        serverSideCondition {
            type: request=Value
            value: PROXIMO_PASSO
        }
    )

    validation valida-numero-de-pedido (
        name: Valida Numero de Pedido
        execution {
            sequence: 20
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from pedidos p
                where numeropedido like '%'||:P132_NUMEROPEDIDO
                  and exists (select 1
                              from vendedoras v
                              where v.idvendedora = p.idvendedora
                                and v.idpessoa = ( select idpessoa
                                                   from pessoas pp
                                                   where ( pp.documentoestrangeiro = :P132_DOCESTRANGEIRO  
                                                           or pp.cpf = :P132_CPF) ) )
                ```
        }
        error {
            errorMessage: Número de Pedido não existe ou não pertence ao cliente informado!
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P132_IDTIPOPROTOCOLO not in (5,10,13)
                  and :P132_ETIQUETA = 'N'
                  and :P0_IDIDIOMA = 1
                  and v('REQUEST') != 'BIPAR_CODIGO'
                ```
        }
    )

