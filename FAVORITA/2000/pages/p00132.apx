    pageItem P132_IDVENDEDORA (
        type: selectList
        label {
            label: Cliente
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' ('||roman.pck_romance.fnc_nomerepresentante(v.idrepresentante)||')' display_value
                     , v.idvendedora return_value
                from pessoas p
                   , vendedoras v
                where v.idpessoa = p.idpessoa
                  and ( ( /*:P132_CPF           is not null and*/ p.cpf = :P132_CPF )
                     or (/*:P132_DOCESTRANGEIRO is not null and*/ p.documentoestrangeiro = :P132_DOCESTRANGEIRO ) )
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: [
                P132_CPF
                P132_DOCESTRANGEIRO
            ]
            parentRequired: false
        }
        layout {
            sequence: 110
            region: @passo-2-protocolos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P132_IDVENDEDORA_ETIQUETA (
        type: selectList
        label {
