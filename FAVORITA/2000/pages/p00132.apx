    validation valida-se-existe-promissoria-recebida-ao-prorrogar (
        name: Valida se existe Promissoria recebida ao Prorrogar
        execution {
            sequence: 80
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  teste number;
                  --
                begin
                  --
                  select 1
                  into teste
                  from pedidos p
                  where numeropedido like '%'||:P132_NUMEROPEDIDO
                    and exists ( select 1
                                 from classificacoespedidos c
                                 where c.idpedido = p.idpedido
                                   and c.idcaracteristicapedido = 15 )
                    and (pck_util_fav.fnc_verificaacesso(28306,:P0_IDUSUARIO)='N' 
                         or (pck_util_fav.fnc_verificaacesso(28306,:P0_IDUSUARIO)='S' and :P132_IDTIPOPROTOCOLO not in (2,8)));
                  --
                  return 'Não é possível prorrogar o boleto deste pedido, promissória e pedido entregues!';
                  --
                  exception
                    when others then
                      null;
                end;
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual 
                where v('REQUEST') = 'PROXIMO'
                  and :P132_IDTIPOPROTOCOLO in (2,8)
                  and pck_util_fav.fnc_verificaacesso(28708,:P0_IDUSUARIO) = 'N'
                ```
        }
