    validation valida-situação-grupo-atendimento-para-cancelar-pedidos (
        name: Valida Situação / Grupo Atendimento para Cancelar Pedidos
        execution {
            sequence: 110
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vexiste number;
                begin
                  --
                  -- Permissão para Atendentes do Call Center
                  begin
                    select 1
                    into vexiste
                    from pedidos
                    where idpedido = :P132_NUMEROPEDIDO 
                    and idsituacaoentrega in (10000, 20000);
                  exception
                    when others then
                      return 'Pedido não pode ser cancelado. Usuário ' || v('USER') || ' sem permissão para cancelar pedido com situação entrega EM ANDAMENTO ou AGUARDANDO ANÁLISE';
                  end;
                  --
                end;
                ```
            alwaysExecute: true
        }
        error {
            displayLocation: inlineInNotification
            associatedItem: @P132_NUMEROPEDIDO
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from dual
                 where v('REQUEST') = 'PROXIMO'
                   and pck_util_fav.fnc_verificagrupoatendimento (4,  :P0_IDUSUARIO) = 'S'
                   and pck_util_fav.fnc_verificagrupoatendimento (25, :P0_IDUSUARIO) = 'N'
                   and :P132_IDTIPOPROTOCOLO = 1
                   and not exists (select 1
                                     from roman.acessos a
                                    where a.idaplicacao = 28711 -- --8922234 - comentado em 15/04/2024Libera usuário para cancelar pedidos com situação entrega EM ANDAMENTO ou AGUARDANDO ANÁLISE.
                                      and a.usuario = v('USER')
                                      and a.ativo   = 'S');
                ```
        }
    )

