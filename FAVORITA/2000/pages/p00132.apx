    pageItem P132_IDREPRESENTANTE (
        type: plugin/select
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(r.idrepresentante) display_value
                     , r.idrepresentante return_value
                from representantes r
                where r.ativo = 'S'
                  and ( :P132_IDFILIALROMANCE is null or r.idgerente in ( select idgerente 
                                                                          from gerentes g
                                                                          where g.idfilial = :P132_IDFILIALROMANCE ) )
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P132_IDFILIALROMANCE
        }
        layout {
            sequence: 130
            region: @passo-2-protocolos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
