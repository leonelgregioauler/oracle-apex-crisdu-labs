            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where ( :P132_ETIQUETA = 'N'
                   or :P132_IDTIPOPROTOCOLO != 1 )
                ```
        }
        settings {
            outputAs: text
        }
    )

