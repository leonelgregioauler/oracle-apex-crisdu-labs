    dynamicAction consulta-tipo-de-documento (
        name: Consulta Tipo de Documento
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P132_NUMEROPEDIDO
        }
        clientSideCondition {
            type: itemIsNotInList
            item: P132_IDTIPOPROTOCOLO
            list: [
                5
                13
            ]
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      vtipodocumento     varchar2(5);
                    begin
                      --
                      :P132_TIPODOCUMENTO := null;
                      --
                      begin
                        --
                        select case
                                 when p.documentoestrangeiro is not null then
                                   'CI'
                                 when p.cpf is not null then
                                   'CPF'
                               end tipodocumento
                        into vtipodocumento
                          from pessoas p
                             , vendedoras v
                             , pedidos ped
                          where v.idvendedora = ped.idvendedora
                            and p.idpessoa = v.idpessoa
                            and ped.idpedido =  :P132_NUMEROPEDIDO;
                        --
                      exception
                        when others then 
                          vtipodocumento := null;
                      end;
                      --
                      :P132_TIPODOCUMENTO := vtipodocumento;
                      --
                    end;
                    ```
                itemsToSubmit: P132_NUMEROPEDIDO
                itemsToReturn: P132_TIPODOCUMENTO
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction consulta-tipo-de-documento-venda-direta (
        name: Consulta Tipo de Documento Venda Direta
        execution {
            sequence: 80
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: itemIsInList
            item: P132_IDTIPOPROTOCOLO
            list: [
                5
                13
            ]
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      vtipodocumento     varchar2(5);
                    begin
                      --
                      :P132_TIPODOCUMENTO := null;
                      --
                      begin
                        --
                        select case
                                 when u.ididioma != 1 then
                                   'CI'
                                 when u.ididioma = 1 then
                                   'CPF'
                               end tipodocumento
                        into vtipodocumento
                        from usuarios u
                    where u.idusuario = :P0_IDUSUARIO;
                        --
                      exception
                        when others then 
                          vtipodocumento := null;
                      end;
                      --
                      :P132_TIPODOCUMENTO := vtipodocumento;
                      --
                    end;
                    ```
                itemsToSubmit: P132_NUMEROPEDIDO
                itemsToReturn: P132_TIPODOCUMENTO
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

