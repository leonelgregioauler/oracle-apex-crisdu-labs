    pageItem P132_IDPEDIDO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @passo-2-protocolos
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select idpedido
                from pedidos p
                where p.numeropedido like '%'||TRIM(:P132_NUMEROPEDIDO)
                  and idvendedora = ( select idvendedora
                                      from vendedoras v
                                      where v.idpessoa = ( select idpessoa
                                                           from pessoas p
                                                           where cpf = replace(replace( :P132_CPF,'.',''),'-','') ) )
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

