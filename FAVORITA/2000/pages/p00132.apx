        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' ('||roman.pck_romance.fnc_nomerepresentante(v.idrepresentante)||')' display_value
                     , v.idvendedora return_value
                from pessoas p
                   , vendedoras v
                where v.idpessoa = p.idpessoa
                  and ( ( :P132_CPF_ETIQUETA            is not null and p.cpf = :P132_CPF_ETIQUETA )
                     or ( :P132_DOCESTRANGEIRO_ETIQUETA is not null and p.documentoestrangeiro = :P132_DOCESTRANGEIRO_ETIQUETA ) )
                ```
