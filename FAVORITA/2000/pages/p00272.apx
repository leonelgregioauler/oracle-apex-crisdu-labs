    region observações-da-controladoria (
        name: Observações da Controladoria
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.datacorrecao
                     , c.motivo
                     , roman.pck_romance.fnc_nomeusuario(c.usuario) usuario
                from roman.CORRECOESFECHAMENTOSSEMANAIS c
                where c.idfechamento = :P272_IDFECHAMENTO
                order by 1
                ```
        }
        layout {
            sequence: 60
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select distinct 1
                from roman.CORRECOESFECHAMENTOSSEMANAIS c
                where c.idfechamento = :P272_IDFECHAMENTO
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
