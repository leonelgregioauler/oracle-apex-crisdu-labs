            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(to_char(s.semana,'00')||'/'||to_char(s.ano))||' ('||dt_ini||' a '||dt_fim||')'
                     , trim(to_char(s.semana,'00')||'/'||to_char(s.ano))
                from semana_dias s
                where trim(to_char(s.semana,'00')||'/'||to_char(s.ano)) = :P272_SEMANA
