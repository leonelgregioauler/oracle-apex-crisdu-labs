    pageItem P272_SUBTOTALGAVETA (
        type: hidden
        layout {
            sequence: 490
            region: @fechamento-semanal
            slot: regionBody
        }
        appearance {
            formatMask: 999G999G999G999G990D00
        }
        source {
            type: databaseColumn
            databaseColumn: SUBTOTALGAVETA
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  vvalor varchar2(30);
                  --
                begin
                  --
                  select TO_CHAR(
                to_number(nvl(:P69_SALDOANTERIORGAVETA,0),'999G999G999G990D00')
                +to_number(nvl(:P69_SUBTOTAL01,0),'999G999G999G990D00')
                -to_number(nvl(:P69_SUBTOTAL02,0),'999G999G999G990D00')
                -to_number(nvl(:P69_SUBTOTAL03,0),'999G999G999G990D00')
                -to_number(nvl(:P69_SUBTOTAL04,0),'999G999G999G990D00')
                        ,'999G999G999G990D00')
                  into vvalor
                  from dual;
                  --
                  return vvalor;
                  --
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

