    pageItem P272_ASSINATURA (
        type: textField
        label {
            label: Assinatura
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 435
            region: @concluir
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 15
        }
        validation {
            maxLength: 4000
        }
        source {
            used: always
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select distinct 1
                from roman.despesas dc
                where dc.idfechamento = :P272_IDFECHAMENTO
                  and dc.idmovimentotogeral is null
                  and not exists ( select ad.iddespesa
                                   from roman.anexosdespesas ad
                                   where ad.iddespesa = dc.iddespesa)
                ```
        }
        security {
            encryptSessionState: false
        }
    )

