    pageItem P272_TOTALCHQSEMFUNDORECEBIDOS (
        type: hidden
        layout {
            sequence: 190
            region: @fechamento-semanal
            slot: regionBody
        }
        appearance {
            formatMask: 999G999G999G999G990D00
        }
        source {
            type: databaseColumn
            databaseColumn: TOTALCHQSEMFUNDORECEBIDOS
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  vvalor number(15,2);
                  --
                begin
                  --
                    select SUM(cp.valor)
                    into vvalor 
                    from roman.cheques2pgto cp
                       , roman.cheques2     c
                       , representantes r
                       , gerentes g
                    where cp.idcheque = c.idcheque
                      and c.semfundo  = 'S'
                      and c.Idrepresentante = r.idrepresentante
                      and r.idgerente       = g.idgerente
                      and g.idfilial        = :P69_IDFILIAL
                      and to_char(cp.datapgto,'IW/RRRR') = :P69_SEMANA;
                  --
                  return replace(to_char(NVL(vvalor,0),'999G999G999G990D00'),' ','') ;
                  --
                exception
                  when others then
                    return replace(to_char(0,'999G999G999G990D00'),' ','') ;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

