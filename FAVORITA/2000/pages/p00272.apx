    pageItem P272_TOTALPENDENTEENTREGA (
        type: numberField
        label {
            label: Pedidos Pendentes de Entrega
            alignment: left
        }
        layout {
            sequence: 370
            region: @fechamento-semanal
            slot: regionBody
            alignment: left
            columnAttributes: onclick="javascript:listapendenteentrega()"
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select count(1)
                from favorita.vw_pedidos_fav_new fv
                where fv.idfilialfavorita = :P272_IDFILIALFAVORITA
                  and fv.pedidocancelado = 'Não'
                  and fv.idsituacaoentrega = 55000
                ```
            used: always
        }
        readOnly {
            type: always
        }
    )

    pageItem P272_TOTALPENDENTEINTEGRAR (
        type: numberField
        label {
            label: Pedidos para Integrar
            alignment: left
        }
        layout {
            sequence: 520
            region: @fechamento-semanal
            slot: regionBody
            alignment: left
            columnAttributes: onclick="javascript:listaintegrar()"
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select count(1)
                from pedidos p
                where p.idfilialfavorita = :P272_IDFILIALFAVORITA
                  and p.idpedidovirtualage is null
                  and p.idsituacaoentrega >= 55000
                  and p.datacancelamento is null
                  and p.idtransacaovirtualage is null
                  and exists ( select 1
                               from filiaisfavorita ff
                               where ff.idfilialfavorita = p.idfilialfavorita
                                 and ff.tipofilial       = 'L' )
                  --and trunc(p.dataemissao) >= to_date('10/08/2020','DD/MM/RRRR')
                  and trunc(p.dataemissao) >= to_date('11/01/2024','DD/MM/RRRR') -- ajuste realizado pelo ticket 8601761 no dia 24/01/2024 --BRUNOB
                  and not exists ( select 1
                                   from classificacoespedidos cp
                                   where cp.idcaracteristicapedido = 43
                                     and cp.idpedido               = p.idpedido )
                  and not exists ( select 1
                                   from vendedoras v
                                      , pessoas pp
                                   where v.idvendedora = p.idvendedora
                                     and v.idpessoa    = pp.idpessoa
                                     and pp.idpais     = 1
                                     and pp.cpf        is null
                                     and pp.documentoestrangeiro is not null )
                  and not exists ( select 1
                                   from classificacoespedidos cp
                                   where cp.idcaracteristicapedido = 73
                                     and cp.idpedido               = p.idpedido )
                  and not exists ( select 1
                                   from classificacoespedidos cp
                                   where cp.idcaracteristicapedido = 8
                                     and cp.idvalorcaracteristica in (11,29)
                                     and cp.idpedido               = p.idpedido )
                ```
            used: always
        }
        readOnly {
            type: always
        }
    )

