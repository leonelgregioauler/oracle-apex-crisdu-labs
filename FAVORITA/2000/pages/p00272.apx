    process busca-fechamento-diário-aberto (
        name: busca fechamento diário aberto
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidfechamentodiario number;
                  vidfechamento       number;
                  vdatafechamento     date;
                  vsaldo              number;
                  vdataencerramento   date;
                  vidusuario          number;
                  vmd5                varchar2(1000);
                  --
                begin
                  --
                  select f.idfechamentodiario
                  into vidfechamentodiario
                  from roman.fechamentosdiarios f
                  where f.idfechamento = :P272_IDFECHAMENTO
                    and f.dataencerramento is null
                    and f.datafechamentodiario = ( select min(ff.datafechamentodiario)
                                                   from roman.fechamentosdiarios ff
                                                   where ff.idfechamento = f.idfechamento
                                                     and ff.dataencerramento is null );
                  --
                  pck_fechamentos_fav.prc_fechamentosdiarios(pidfechamentodiario => vidfechamentodiario,
                                                             pidfechamento => vidfechamento,
                                                             pdatafechamentodiario => vdatafechamento,
                                                             psaldo => vsaldo,
                                                             pdataencerramento => vdataencerramento,
                                                             pidusuario => vidusuario,
                                                             pmd5 => vmd5,
                                                             poperacao_dml => 'S');
                  --
                 -- :P272_IDFECHAMENTODIARIO := vidfechamentodiario;
                 -- :P272_DATAFECHAMENTODIARIO := to_char(vdatafechamento,'DD/MM/RRRR');
                 -- :P272_SALDO_DIARIO := to_number(vsaldo);
                  --
                end;
                ```
        }
        execution {
            sequence: 64
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1373290770909315229
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.fechamentosdiarios f
                where f.idfechamento = :P272_IDFECHAMENTO
                  and f.dataencerramento is null
                ```
        }
    )

    process confirma-fechamento (
        name: confirma fechamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidgerente  number;
                  vmensagem   varchar2(100) := null;
                begin
                  --
                  if upper(TRIM(:P272_ASSINATURA)) = v('APP_USER') then
                    --
                    pck_fechamentos_fav.prc_concluifechamento( pidfechamento =>:P272_IDFECHAMENTO
                                                             , pmensagem     => vmensagem);
                    --
                    if vmensagem is not null then
                      --
                      raise_application_error(-20001,vmensagem);
                      --
                    end if;
                    --
                  elsif upper(TRIM(:P272_ASSINATURA)) != v('APP_USER') then
                    --
                    raise_application_error(-20001,'Assinatura incorreta, fechamento não concluído.');
                    --
                    :P272_CONCLUIDO := 'N';
                    --
                  else
                    :P272_CONCLUIDO := 'N';
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Fechamento Atualizado!
        }
        advanced {
            executionMappingIdentifier: 1373287970251315227
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMAR
        }
    )

    process confirma-fechamento-diário (
        name: confirma fechamento diário
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidgerente  number;
                begin
                  --
                  begin
                    select idgerente
                    into vidgerente
                    from gerentes
                    where idpessoa = ( select idpessoa
                                       from usuarios
                                       where usuario = v('APP_USER')); 
                  exception 
                    when others then
                      null;
                  end;
                  --
                  if upper(TRIM(:P272_ASSINATURA)) = v('APP_USER') 
                    and ( roman.pck_romance.fnc_filialusuario(v('APP_USER')) = :P0_IDFILIALCAIXA ) 
                      or ( v('APP_USER') = 'GUILHERME' ) then
                    --
                    pck_fechamentos_fav.prc_confirmafechamento(pidfechamentodiario => :P272_IDFECHAMENTODIARIO,
                                                               pidfechamento => :P272_IDFECHAMENTO,
                                                               pidusuario => :P0_IDUSUARIO);
                    --
                  end if;
                  --
                exception
                  when others then
                    null;
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Fechamento Diário Concluído!
        }
        advanced {
            executionMappingIdentifier: 1373291140049315230
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMAR_DIARIO
        }
    )

