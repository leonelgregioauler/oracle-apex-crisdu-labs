page 272 (
    name: Fechamento Semanal
    title: Fechamento Semanal
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function listapagamentos() 
            {
              pidfechamento = document.getElementById('P272_IDFECHAMENTO').value;
              pjanela = window.open('f?p=&APP_ID.:294:&SESSION.::NO:294:P294_IDFECHAMENTO:'+pidfechamento,'popup','toolbar=yes,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=800,height=800,screenX=50,screenY =100');
              pjanela.focus();
            }
            
            function listapendenteentrega() 
            {
              pidfilialfavorita = document.getElementById('P272_IDFILIALFAVORITA').value;
              pjanela = window.open('f?p=&APP_ID.:354:&SESSION.::NO:354:P354_IDFILIALFAVORITA:'+pidfilialfavorita);
            }
            
            function listaintegrar() 
            {
              pidfilialfavorita = document.getElementById('P272_IDFILIALFAVORITA').value;
              pidfechamento     = document.getElementById('P272_IDFECHAMENTO').value;
                
              pjanela = window.open('f?p=&APP_ID.:463:&SESSION.::NO:463:P463_IDFILIALFAVORITA,P463_IDFECHAMENTO:'+pidfilialfavorita+','+pidfechamento);
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region aviso-valores-congelados (
        name: Aviso Valores Congelados
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentossemanais f
                where f.idsemana = ( select ff.idsemana
                                     from fechamentossemanais ff
                                     where ff.idfechamento = :P272_IDFECHAMENTO) -1
                  and f.valorsaldoanteriorcongelado is not null
                  and f.idfilialfavorita = :P0_IDFILIALCAIXA
                ```
        }
    )

