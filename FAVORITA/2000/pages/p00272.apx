    pageItem P272_SUBTOTAL01 (
        type: hidden
        layout {
            sequence: 230
            region: @fechamento-semanal
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select replace(TO_CHAR(
                 nvl(to_number(NVL(:P272_TOTALCOBRANCA,0),'999G999G999G999G999G999G999G999G990D00'),0)
                + nvl(to_number(NVL(:P272_TOTALVENDASDIRETAS,0),'999G999G999G999G999G999G999G999G990D00'),0)
                + nvl(to_number(NVL(:P272_TOTALCHQSEMFUNDORECEBIDOS,0),'999G999G999G999G999G999G999G999G990D00'),0)
                + nvl(to_number(NVL(:P272_TOTALBOLETOSFAVORITA,0),'999G999G999G999G999G999G999G999G990D00'),0)
                + nvl(to_number(NVL(:P272_ENTRADASDIV,0),'999G999G999G999G999G999G999G999G990D00'),0)
                + nvl(to_number(NVL(:P272_TOTALRESGATE,0),'999G999G999G999G999G999G999G999G990D00'),0)
                ,'999G999G999G999G999G999G999G999G990D00'),' ','') P272_SUBTOTAL01
                FROM DUAL
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

