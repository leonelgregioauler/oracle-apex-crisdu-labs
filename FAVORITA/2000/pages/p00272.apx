    pageItem P272_LIMITEGAVETA (
        type: numberField
        label {
            label: Limite disponível para Gaveta (BR)
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 10
            region: @limite-de-gaveta
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G999G990D99
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select to_char(p.valor,'999G999G999G999G999G990D99') valor
                from favorita.parametros p
                where p.nome = 'LIMITEMAXIMOCAIXA'
                  and p.idfilialfavorita = :P272_IDFILIALFAVORITA;
                ```
            used: always
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from catal.usuarios u
                where u.usuario = v('APP_USER')
                  and u.idgerente != 257
                  and u.ididioma != 1
                
                ```
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P272_LIMITEGAVETA_CONVERTIDO (
        type: numberField
        label {
            label: Limite disponível para Gaveta  (EX)
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 20
            region: @limite-de-gaveta
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G999G990D99
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select nvl(to_char(round((p.valor/f.fatorconversao),2),'999G999G999G999G999G990D99'),0) valor
                from favorita.parametros p
                   , roman.vw_filiais f
                   , roman.fechamentossemanais ff
                where f.idfilial = ff.idfilial
                  and ff.idfilialfavorita = p.idfilialfavorita
                  and p.nome = 'LIMITEMAXIMOCAIXA'
                  and p.idfilialfavorita = :P0_IDFILIALCAIXA;
                ```
            used: always
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from catal.usuarios u
                where u.usuario = v('APP_USER')
                  and u.idgerente != 257
                  and u.ididioma not in (2,4)
                
                ```
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P272_MENSAGEM (
        type: displayOnly
