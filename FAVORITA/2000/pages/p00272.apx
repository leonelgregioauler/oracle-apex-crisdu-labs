        }
        source {
            type: staticValue
            staticValue:
                ```
                Para confirmar a conclusão do fechamento, escreva o seu usuário no campo abaixo e clique no botão "Confirmar".
                Após a confirmação, não será mais possível alterar qualquer informação referente ao mesmo.
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where ( select count(1)
                        from roman.fechamentosdiarios f
                        where f.idfechamento = :P272_IDFECHAMENTO 
                          and f.dataencerramento is not null ) = 6
                ```
        }
        security {
            encryptSessionState: false
        }
    )

