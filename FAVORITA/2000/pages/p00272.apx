    pageItem P272_VALOR_CONGELADO (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: html
        }
        layout {
            sequence: 10
            region: @aviso-valores-congelados
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<font color=blue><h3>Fechamento anterior finalizado com R$ '||trim(to_char(f.valorsaldoanteriorcongelado,'999G999G999G999G999G999G990D00'))||' no dia '||to_char(f.datasaldoanteriorcongelado,'DD/MM/RRRR HH24:MI:SS')||'</font></h3>' display
                from fechamentossemanais f
                where f.idsemana = ( select ff.idsemana
                                     from fechamentossemanais ff
                                     where ff.idfechamento = :P272_IDFECHAMENTO
                                       and ff.idfilialfavorita = :P0_IDFILIALCAIXA ) -1
                  and f.valorsaldoanteriorcongelado is not null
                  and f.idfilialfavorita = :P0_IDFILIALCAIXA
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button alterar (
        buttonName: ALTERAR
        label: Salvar
        layout {
            sequence: 340
            region: @fechamento-semanal
            slot: regionBody
            startNewRow: false
            column: 10
            columnSpan: 3
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentossemanais f
                where nvl(f.concluido,'N') = 'N'
                  and f.idfechamento       = :P272_IDFECHAMENTO
                  and f.idfilial           = (select ff.idfilialromance
                                                from favorita.filiaisfavorita ff
                                               where f.idfilial = ff.idfilialromance
                                                 and ff.idfilialfavorita =  :P0_IDFILIALFAVORITA)
                union
                select 1
                from dual
                where :P272_IDFECHAMENTO IS NOT NULL
                  and pck_util.fnc_verificaacesso(pidaplicacao => 2309, pusuario => v('APP_USER') ) = 'S'
                ```
        }
    )

