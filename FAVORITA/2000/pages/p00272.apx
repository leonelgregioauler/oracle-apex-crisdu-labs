    validation p272-assinatura (
        name: P272_ASSINATURA
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P272_ASSINATURA != v('APP_USER')
                ```
            alwaysExecute: true
        }
        error {
            errorMessage: Assinatura incorreta, fechamento não concluído.
            associatedItem: @P272_ASSINATURA
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P272_ASSINATURA is not null and v('REQUSET') = 'CONFIRMAR'
        }
    )

    validation val-p272-observacao-min-length (
        name: VAL_P272_OBSERVACAO_MIN_LENGTH
        execution {
            sequence: 70
        }
        validation {
            plsqlExpression: nvl(length(regexp_replace(:P272_OBSERVACAO, '\s', '')), 0) >= 10
            alwaysExecute: true
        }
        error {
            errorMessage: O campo Observação deve conter no mínimo 10 caracteres.
            associatedItem: @P272_OBSERVACAO
        }
    )

    validation valida-anexos-de-depositos (
        name: Valida Anexos de Depositos
        execution {
            sequence: 50
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.depositosfavorita d
                where idfechamento = :P272_IDFECHAMENTO
                  and not exists ( select 1
                                   from roman.anexosdepositos a
                                   where a.iddeposito = d.iddepositofavorita )
                ```
            alwaysExecute: true
        }
        error {
            errorMessage: Existem depósitos lançados sem anexo vinculado! Verifique e anexe os comprovantes antes de encerrar a semana.
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') = 'CONFIRMAR'
                  and :P272_ASSINATURA is not null
                ```
        }
    )

    validation valida-anexos-de-despesas (
        name: Valida Anexos de DEspesas
