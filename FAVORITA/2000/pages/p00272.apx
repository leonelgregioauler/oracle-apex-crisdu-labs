    process insere-novo-2 (
        name: insere novo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vsemana     varchar2(50);
                  verro       varchar2(500);
                  vidfilial   number := :P272_IDFILIAL;
                  vusuario    varchar2(20) :=  v('APP_USER');
                  --
                begin
                  --
                  IF roman.pck_romance.fnc_filialusuario (pusuario => vusuario ) = :P272_IDFILIAL then
                    --
                    begin
                      select TRIM(roman.pck_romance.fnc_retornasemanafechamento(psemanatela => null,  pusuario => trim(vusuario)))
                      into vsemana
                      from dual
                      where not exists ( select 1 
                                         from roman.fechamentossemanais f
                                         where f.semana = TRIM(roman.pck_romance.fnc_retornasemanafechamento(psemanatela => null,  pusuario => trim(vusuario)))
                                           and f.idfilial = vidfilial);
                    exception
                      when others then
                        verro := sqlerrm;
                        vsemana := null;
                    end;
                    --
                    if vsemana is not null and length(vsemana) > 5 then
                      insert into roman.fechamentossemanais ( idfechamento , idfilial , semana )
                      values ( roman.seq_idfechamentosemanal.nextval, vidfilial, vsemana);
                    end if;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 1373290387188315229
        }
    )

