    validation valida-pedidos-entregues (
        name: Valida Pedidos Entregues
        execution {
            sequence: 60
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from favorita.pedidos p
                where p.idsituacaoentrega = 55000
                  and p.idfilialfavorita = :P272_IDFILIALFAVORITA
                  and not exists ( select 1
                                   from favorita.classificacoespedidos cp
                                   where cp.idpedido = p.idpedido
                                     and cp.idcaracteristicapedido = 25)
                  and ( select 1
                        from favorita.parametros pa
                        where pa.idfilialfavorita = :P272_IDFILIALFAVORITA
                          and pa.nome = 'CAIXAOBRIGAENTREGA'
                          and pa.valor = 'S') = 1
                ```
        }
        error {
            errorMessage: Ainda existem pedidos sem ser entregues, favor verificar!
        }
        serverSideCondition {
            whenButtonPressed: @confirmar
        }
        comments {
            comments: Ainda existem pedidos sem ser entregues, favor verificar!
        }
    )

