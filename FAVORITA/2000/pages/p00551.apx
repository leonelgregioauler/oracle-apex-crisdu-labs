page 551 (
    name: Ajustar itens Morte Programada
    title: Ajustar itens Morte Programada
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region definir-itens-de-morte-programada (
        name: Definir Itens de Morte Programada
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDITEMVIRADADECATALOGO
                     , IDVIRADADECATALOGO
                     , IDPRODUTODETALHADO
                     , VALORVENDA
                     , MORTEPROGRAMADA
                     , PERCCOMISSAOVEN
                     , PONTOSPRODUTO
                     , IDTAGPRODUTO
                     , IDPRECOPRODUTO
                     , PERCCOMISSAODIS
                     , PERCCOMISSAOGER
                     , VALORCUSTO
                --     , PERCCOMISDISLOJA
                  from ITENSVIRADADECATALOGO
                 where IDVIRADADECATALOGO = :P551_IDVIRADADECATALOGO
                   and morteprogramada = 'S'
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
            ]
            addRowIfEmpty: false
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 97816325303522233
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDITEMVIRADADECATALOGO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDVIRADADECATALOGO
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDPRODUTODETALHADO
                layout {
                    width: 308
                    sequence: 3
                }
            )

            displayColumn (
                column: @VALORVENDA
                layout {
                    width: 121
                    sequence: 4
                }
            )

            displayColumn (
                column: @MORTEPROGRAMADA
                layout {
                    show: false
                    width: 103
                    sequence: 5
                }
            )

            displayColumn (
                column: @PERCCOMISSAOVEN
                layout {
                    width: 90
                    sequence: 7
                }
            )

            displayColumn (
                column: @PONTOSPRODUTO
                layout {
                    width: 97
                    sequence: 13
                }
            )

            displayColumn (
                column: @IDTAGPRODUTO
                layout {
                    width: 418
                    sequence: 12
                }
            )

            displayColumn (
                column: @IDPRECOPRODUTO
                layout {
                    sequence: 11
                }
            )

            displayColumn (
                column: @PERCCOMISSAODIS
                layout {
                    width: 95
                    sequence: 8
                }
            )

            displayColumn (
                column: @PERCCOMISSAOGER
                layout {
                    width: 87
                    sequence: 10
                }
            )

            displayColumn (
                column: @VALORCUSTO
                layout {
                    width: 135
                    sequence: 6
                }
            )

            sort (
                column: @IDPRODUTODETALHADO
                sort {
                    nulls: last
                    sequence: 1
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column IDITEMVIRADADECATALOGO (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDITEMVIRADADECATALOGO
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDPRECOPRODUTO (
            type: hidden
            layout {
                sequence: 110
            }
            source {
                databaseColumn: IDPRECOPRODUTO
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDPRODUTODETALHADO (
            type: displayOnly
            heading {
                heading: Produto
            }
            settings {
                basedOn: lov
            }
            lov {
                type: sharedComponent
                lov: @lov-produtosdetalhados
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: IDPRODUTODETALHADO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDTAGPRODUTO (
            type: selectList
            heading {
                heading: Tag do Produto
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select distinct t.nome display_value
                         , t.idtagproduto return_value
                      from tagsprodutos t
                    --     , classificacoesprodutos c
                    -- where t.idtagproduto = c.idtagproduto
                    
                    ```
            }
            layout {
                sequence: 100
            }
            source {
                databaseColumn: IDTAGPRODUTO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column IDVIRADADECATALOGO (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IDVIRADADECATALOGO
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column MORTEPROGRAMADA (
            type: displayOnly
            heading {
                heading: MP
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: MORTEPROGRAMADA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column PERCCOMISSAODIS (
            type: numberField
            heading {
                heading: %Com.DIS
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 120
            }
            appearance {
                formatMask: 90D00
                width: 5
            }
            validation {
                maxLength: 5
            }
            source {
                databaseColumn: PERCCOMISSAODIS
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column PERCCOMISSAOGER (
            type: numberField
            heading {
                heading: %Com.GER
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 130
            }
            appearance {
                formatMask: 90D00
                width: 5
            }
            validation {
                maxLength: 5
            }
            source {
                databaseColumn: PERCCOMISSAOGER
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column PERCCOMISSAOVEN (
            type: numberField
            heading {
                heading: %Com.EMP
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 80
            }
            appearance {
                formatMask: 90D00
                width: 5
            }
            validation {
                maxLength: 5
            }
            source {
                databaseColumn: PERCCOMISSAOVEN
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column PONTOSPRODUTO (
            type: numberField
            heading {
                heading: Pontuação
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                databaseColumn: PONTOSPRODUTO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column VALORCUSTO (
            type: hidden
            layout {
                sequence: 140
            }
            source {
                databaseColumn: VALORCUSTO
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column VALORVENDA (
            type: numberField
            heading {
                heading: Valor Venda
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                databaseColumn: VALORVENDA
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

    )

    pageItem P551_IDVIRADADECATALOGO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @definir-itens-de-morte-programada
            slot: regionBody
        }
        default {
            type: static
            staticValue: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button processar (
        buttonName: Processar
        label: Processar Itens e Enviar para Revistas
        layout {
            sequence: 20
            region: @definir-itens-de-morte-programada
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button voltar (
        buttonName: Voltar
        label: Voltar
        layout {
            sequence: 10
            region: @definir-itens-de-morte-programada
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction confirma (
        name: Confirma
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @processar
        }

        action native-confirm (
            action: confirm
            settings {
                message: Confirma envir itens de morte programada para revistas Loja e Geral ?
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: CONFIRMA
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction limpacomdis (
        name: LimpaComDis
        execution {
            sequence: 40
        }
        when {
            event: focusin
            selectionType: columns
            interactiveGrid: @definir-itens-de-morte-programada
            columns: PERCCOMISSAODIS
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: columns
                columns: PERCCOMISSAODIS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction limpacomger (
        name: LimpaComGer
        execution {
            sequence: 50
        }
        when {
            event: focusin
            selectionType: columns
            interactiveGrid: @definir-itens-de-morte-programada
            columns: PERCCOMISSAOGER
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: columns
                columns: PERCCOMISSAOGER
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction limpacomven (
        name: LimpaComVen
        execution {
            sequence: 30
        }
        when {
            event: focusin
            selectionType: columns
            interactiveGrid: @definir-itens-de-morte-programada
            columns: PERCCOMISSAOVEN
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: columns
                columns: PERCCOMISSAOVEN
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process gravaritens-mp (
        name: GravarItens_MP
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                 vnome                 varchar2(200);
                 vdatainicial          date;
                 vdatafinal            date;
                 videdicaorevori       number;
                 videdicaorevdest      number;
                 vidpais               number;
                 vlinkcatalogo         varchar2(100);
                 vidusuarioinclusao    number;
                 vdatainclusao         date;
                 vidusuarioMP          number;
                 vdataMP               date;
                 vidusuarioajustaitens number;
                 vdataajustaitens      date;
                 vidusuarioajustaMP    number;
                 vdataajustaMP         date;
                 vetapa                number;
                 vmd5                  varchar2(4000);
                 v_idtag               number;
                 vidfilial             number;
                 
                 v_erro1               exception;
                 v_erro2               exception;
                 v_erro3               exception;
                 
                 cursor c1 is 
                 select nome
                      , datavalidadeini
                      , datavalidadefim
                      , idedicaorevistaorigem
                      , idedicaorevistadestino
                      , idpais
                      , linkcatalogo
                      , etapa
                      , decode(idpais,2,1041,
                                      4,1111,
                               100) idfilial
                   from viradasdecatalogo
                  where idviradadecatalogo = :P551_IDVIRADADECATALOGO;
                 r1 c1%rowtype;
                
                 
                BEGIN
                
                  vidusuarioajustaitens := :P0_IDUSUARIO;
                  vdataajustaitens      := SYSDATE;
                  vetapa                := 4;
                  
                  open c1;
                  fetch c1 into r1;
                  close c1;
                  
                  if r1.idedicaorevistadestino is not null then
                  
                    vnome                 := r1.nome;
                    vdatainicial          := r1.datavalidadeini;
                    vdatafinal            := r1.datavalidadefim;
                    videdicaorevori       := r1.idedicaorevistaorigem;
                    videdicaorevdest      := r1.idedicaorevistadestino;
                    vidpais               := r1.idpais;
                    vlinkcatalogo         := r1.linkcatalogo;
                    vidfilial             := r1.idfilial;
                    
                    pck_cadastros_fav.prc_viradadecatalogo(pidviradadecatalogo   => :P551_IDVIRADADECATALOGO,
                                                           pnome                 => vnome,
                                                           pdatainicial          => vdatainicial,
                                                           pdatafinal            => vdatafinal,
                                                           pidedicaorevori       => videdicaorevori,
                                                           pidedicaorevdest      => videdicaorevdest,
                                                           pidpais               => vidpais,
                                                           plinkcatalogo         => vlinkcatalogo,
                                                           pidusuarioinclusao    => vidusuarioinclusao,
                                                           pdatainclusao         => vdatainclusao,
                                                           pidusuariomp          => vidusuarioMP,
                                                           pdatamp               => vdataMP,
                                                           pidusuarioajustaitens => vidusuarioajustaitens,
                                                           pdataajustaitens      => vdataajustaitens,
                                                           pidusuarioajustamp    => vidusuarioajustamp,
                                                           pdataajustamp         => vdataajustamp,
                                                           petapa                => vetapa,
                                                           pmd5                  => vmd5,
                                                           poperacao_dml         => 'U');
                
                    begin
                    
                      INSERT INTO EXECUCOES_COMANDOS (IDCOMANDO, ORIGEM, DATAPROGRAMADO, COMANDO)
                        SELECT seq_idcomando.nextval
                             , 'VIRADA DE CATALOGO '||:P551_IDVIRADADECATALOGO
                             , r1.datavalidadeini
                             , 'INSERT INTO PRODUTOSDESCONTINUADOSPAIS ( idprodutosdescontinuadospais, idedicaorevista, idprodutodetalhado, idpais) '||
                               ' VALUES ( seq_idprodutodetedrevista.nextval, ' || videdicaorevdest || ',' || i.idprodutodetalhado || ',' || nvl(vidpais,1) || ')'
                          FROM itensviradadecatalogo i
                         WHERE i.idviradadecatalogo = :P551_IDVIRADADECATALOGO
                           AND i.morteprogramada = 'S'
                           AND (i.idtagproduto is null or i.idtagproduto not in (183) ) 
                           AND NOT EXISTS (select 1 
                                             from produtosdescontinuadospais
                                            where idprodutodetalhado = i.idprodutodetalhado
                                              and idpais = nvl(vidpais,1) ); 
                    
                    exception
                      when others then
                       raise v_erro1;
                    end;
                
                    -- Inclui Itens para revista destino (loja)
                    begin
                      INSERT INTO EXECUCOES_COMANDOS (IDCOMANDO, ORIGEM, DATAPROGRAMADO, COMANDO)
                        SELECT seq_idcomando.nextval
                             , 'VIRADA DE CATALOGO '||:P551_IDVIRADADECATALOGO
                             , r1.datavalidadeini
                             , 'INSERT INTO PRODUTOSDETEDREVISTAS ( idprodutodetedrevista, idedicaorevista, idprodutodetalhado) '||
                               ' VALUES (seq_idprodutodetedrevista.nextval, ' || 56 || ',' || i.idprodutodetalhado || ')'
                             --
                          FROM itensviradadecatalogo i
                         WHERE i.idviradadecatalogo = :P551_IDVIRADADECATALOGO
                           AND i.morteprogramada = 'S' 
                           AND (i.idtagproduto is null or i.idtagproduto not in (183) ) 
                           AND not exists (select 1
                                             from produtosdetedrevistas
                                            where idedicaorevista = 56
                                              and idprodutodetalhado = i.idprodutodetalhado);
                                                     
                    exception
                      when no_data_found then
                        null;
                      when others then
                       raise v_erro2;
                    end;
                    --
                    -- Atualiza precos para revista destino (loja)
                    begin
                    -- 
                      begin
                        INSERT INTO EXECUCOES_COMANDOS (IDCOMANDO, ORIGEM, DATAPROGRAMADO, COMANDO)
                        SELECT seq_idcomando.nextval
                             , 'VIRADA DE CATALOGO '||:P551_IDVIRADADECATALOGO
                             , r1.datavalidadeini
                             , 'UPDATE PRECOSPRODUTOS '       ||
                               'SET '                         ||
                               ' VALORCUSTO = '               || replace(nvl(i.valorcusto,0),',','.')      || ',' ||
                               ' VALORVENDA = '               || replace(nvl(i.valorvenda,0),',','.')      || ',' ||
                               ' PERCCOMISSAOGERENTE = '      || replace(nvl(i.perccomissaoger,0),',','.') || ',' ||
                               ' PERCCOMISSAODISTRIBUIDOR = ' || replace(nvl(i.perccomissaodis,0),',','.') || ',' ||
                               ' PERCCOMISSAOCONSULTORA = '   || replace(nvl(i.perccomissaoven,0),',','.') || 
                               ' WHERE IDPRECOPRODUTO = '     || p.idprecoproduto 
                          FROM viradasdecatalogo      v
                             , itensviradadecatalogo  i
                             , filiaisedicoesrevistas f
                             , precosprodutos         p
                         WHERE v.idviradadecatalogo = :P551_IDVIRADADECATALOGO
                           AND v.idviradadecatalogo = i.idviradadecatalogo
                           AND f.idedicaorevista    = v.idedicaorevistadestino
                           AND p.idedicaorevista    = 56
                           AND p.idprodutodetalhado = i.idprodutodetalhado
                           AND p.idfilialromance    = f.idfilial
                           --AND f.idfilial           = vidfilial -- comentado pois precisa atualizar para todas as filiais
                           AND i.morteprogramada    = 'S'
                           AND ( i.idtagproduto is null or i.idtagproduto in (63, 184) ); -- Marcelo pediu para atualizar precos dos produtos com a Tag Lucre Mais e Repasse RMC
                        
                      exception
                        when no_data_found then
                          null;
                        when others then
                          raise_application_error (-20001,'Erro na atualização dos produtos da revista Edicao Geral Loja(56)' || sqlerrm);
                      end; 
                      
                      INSERT INTO EXECUCOES_COMANDOS (IDCOMANDO, ORIGEM, DATAPROGRAMADO, COMANDO)
                      SELECT seq_idcomando.nextval
                             , 'VIRADA DE CATALOGO '||:P551_IDVIRADADECATALOGO
                             , r1.datavalidadeini
                             , 'INSERT INTO PRECOSPRODUTOS ( idprecoproduto, idedicaorevista, idprodutodetalhado, idfilialromance, valorcusto, ' ||
                               ' valorvenda, perccomissaogerente, perccomissaodistribuidor, perccomissaoconsultora) '||
                               ' VALUES ( seq_idprecoproduto.nextval, ' ||  56  || ',' ||  i.idprodutodetalhado || ',' ||  f.idfilial || ',' ||
                              replace(nvl(i.valorcusto,0),',','.')      || ',' ||
                              replace(nvl(i.valorvenda,0),',','.')      || ',' ||
                              replace(nvl(i.perccomissaoger,0),',','.') || ',' ||
                              replace(nvl(i.perccomissaodis,0),',','.') || ',' ||
                              replace(nvl(i.perccomissaoven,0),',','.') || ')' 
                           FROM viradasdecatalogo      v
                              , itensviradadecatalogo  i
                              , filiaisedicoesrevistas f
                          WHERE v.idviradadecatalogo = :P551_IDVIRADADECATALOGO
                            AND v.idviradadecatalogo = i.idviradadecatalogo
                            AND f.idedicaorevista    = v.idedicaorevistadestino
                            --AND f.idfilial           = vidfilial -- comentado pois precisa atualizar todas as filiais
                            AND i.morteprogramada    = 'S' 
                            AND (i.idtagproduto is null or i.idtagproduto in (63,184) ) 
                            AND not exists (select 1
                                              from precosprodutos
                                             where idedicaorevista    = 56
                                               and idprodutodetalhado = i.idprodutodetalhado
                                               and idfilialromance    = f.idfilial) ; 
                
                    exception
                      when others then
                       raise v_erro2;
                    end;
                                 
                    --
                    -- inclui itens para revista destino (Edicao geral) 
                    begin
                
                      begin
                      
                        INSERT INTO EXECUCOES_COMANDOS (IDCOMANDO, ORIGEM, DATAPROGRAMADO, COMANDO)
                        SELECT seq_idcomando.nextval
                             , 'VIRADA DE CATALOGO '||:P551_IDVIRADADECATALOGO
                             , r1.datavalidadeini
                             , 'UPDATE PRECOSPRODUTOS ' ||
                               ' SET ' ||
                               ' VALORCUSTO = ' || replace(nvl(i.valorcusto,0),',','.')                    || ',' ||
                               ' VALORVENDA = ' || replace(nvl(i.valorvenda,0),',','.')                    || ',' ||
                               ' PERCCOMISSAOGERENTE = '  || replace(nvl(i.perccomissaoger,0),',','.')     || ',' ||
                               ' PERCCOMISSAODISTRIBUIDOR = ' || replace(nvl(i.perccomissaodis,0),',','.') || ',' ||
                               ' PERCCOMISSAOCONSULTORA = '  || replace(nvl(i.perccomissaoven,0),',','.')  || 
                               ' WHERE IDPRECOPRODUTO = ' || p.idprecoproduto 
                          FROM viradasdecatalogo      v
                             , itensviradadecatalogo  i
                             , filiaisedicoesrevistas f
                             , precosprodutos         p
                         WHERE v.idviradadecatalogo = :P551_IDVIRADADECATALOGO
                           AND v.idviradadecatalogo = i.idviradadecatalogo
                           AND f.idedicaorevista    = v.idedicaorevistadestino
                           AND p.idedicaorevista    = 62
                           AND p.idprodutodetalhado = i.idprodutodetalhado
                           AND p.idfilialromance    = f.idfilial
                           --AND f.idfilial           = vidfilial -- comentado pois precisa atualizar todas as filiais
                           AND i.morteprogramada    = 'S'
                           AND ( i.idtagproduto is null or i.idtagproduto in (63) ); -- Marcelo pediu para atualizar todos os produtos que tenham a Tag Lucre Mais
                
                      exception
                        when no_data_found then
                          null;
                        when others then
                          raise_application_error (-20001,'Erro na atualização dos produtos da revista Edicao Geral Brasil(62)');
                      end;
                
                      INSERT INTO EXECUCOES_COMANDOS (IDCOMANDO, ORIGEM, DATAPROGRAMADO, COMANDO)
                        SELECT seq_idcomando.nextval
                             , 'VIRADA DE CATALOGO '||:P551_IDVIRADADECATALOGO
                             , r1.datavalidadeini
                             , 'INSERT INTO PRODUTOSDETEDREVISTAS ( idprodutodetedrevista, idedicaorevista, idprodutodetalhado) '||
                               ' VALUES ( seq_idprodutodetedrevista.nextval, ' || 62 || ',' || i.idprodutodetalhado || ')'
                             --
                          FROM itensviradadecatalogo i
                         WHERE i.idviradadecatalogo = :P551_IDVIRADADECATALOGO
                           AND i.morteprogramada = 'S'  
                           AND (i.idtagproduto is null or i.idtagproduto not in (183) ) 
                           AND not exists (select 1
                                             from produtosdetedrevistas
                                            where idedicaorevista = 62
                                              and idprodutodetalhado = i.idprodutodetalhado);
                                                  
                    exception
                      when dup_val_on_index then
                       raise_application_error(-20001,'chave unica duplicada. '||sqlerrm);
                      when others then
                       raise v_erro3;
                    end;
                    --
                    begin
                      
                      INSERT INTO EXECUCOES_COMANDOS (IDCOMANDO, ORIGEM, DATAPROGRAMADO, COMANDO)
                        SELECT seq_idcomando.nextval
                             , 'VIRADA DE CATALOGO '||:P551_IDVIRADADECATALOGO
                             , r1.datavalidadeini
                             , 'INSERT INTO PRECOSPRODUTOS ( idprecoproduto, idedicaorevista, idprodutodetalhado, idfilialromance, valorcusto, ' ||
                               ' valorvenda, perccomissaogerente, perccomissaodistribuidor, perccomissaoconsultora) '||
                               ' VALUES ( seq_idprecoproduto.nextval, ' ||   62   || ',' ||  i.idprodutodetalhado || ',' ||  f.idfilial || ',' ||
                              replace(nvl(i.valorcusto,0),',','.') || ',' ||
                              replace(nvl(i.valorvenda,0),',','.') || ',' ||
                              replace(nvl(i.perccomissaoger,0),',','.') || ',' ||
                              replace(nvl(i.perccomissaodis,0),',','.') || ',' ||
                              replace(nvl(i.perccomissaoven,0),',','.') || ')' 
                            FROM viradasdecatalogo      v
                               , itensviradadecatalogo  i
                               , filiaisedicoesrevistas f
                           WHERE v.idviradadecatalogo = :P551_IDVIRADADECATALOGO
                             AND v.idviradadecatalogo = i.idviradadecatalogo
                             AND f.idedicaorevista    = v.idedicaorevistadestino
                             --AND f.idfilial           = vidfilial  -- comentado pois precisa atualizar todas as filiais
                             AND i.morteprogramada    = 'S' 
                             AND (i.idtagproduto is null or i.idtagproduto in (63) ) 
                             AND not exists (select 1
                                               from precosprodutos
                                              where idedicaorevista    = 62
                                                and idprodutodetalhado = i.idprodutodetalhado
                                                and idfilialromance    = f.idfilial); 
                
                    exception
                      when others then
                       raise v_erro3;
                    end;
                    --
                
                    -- Insere tags de produtos caso nao existam
                    INSERT INTO execucoes_comandos (idcomando, origem, dataprogramado, comando)
                      select seq_idcomando.nextval,
                             'VIRADA DE CATALOGO '||:P551_IDVIRADADECATALOGO,
                             vdatainicial,
                             'INSERT INTO CLASSIFICACOESPRODUTOS ( idclassificacaoproduto, idprodutodetalhado, idtagproduto ) ' ||
                               'VALUES (' ||
                               'seq_idclassificacaoproduto.nextval'  || ',' ||
                               i.idprodutodetalhado                  || ',' ||
                               i.idtagproduto                        || ')' 
                             --
                        from viradasdecatalogo      v
                           , itensviradadecatalogo  i
                       where v.idviradadecatalogo = :P551_IDVIRADADECATALOGO
                         and v.idviradadecatalogo = i.idviradadecatalogo
                         and i.morteprogramada = 'S' 
                         and i.idtagproduto is not null
                         and not exists (select 1
                                           from classificacoesprodutos
                                          where idtagproduto = i.idtagproduto
                                            and idprodutodetalhado = i.idprodutodetalhado);
                                              
                    --
                    -- Atualiza pontos de produtos
                    for c2 in ( select i.pontosproduto
                                     , i.idprodutodetalhado
                                  from viradasdecatalogo v
                                     , itensviradadecatalogo i
                                 where v.idviradadecatalogo = :P551_IDVIRADADECATALOGO
                                   and v.idviradadecatalogo = i.idviradadecatalogo
                                   and i.morteprogramada = 'S' ) loop
                
                        INSERT INTO EXECUCOES_COMANDOS (IDCOMANDO, ORIGEM, DATAPROGRAMADO, COMANDO)
                        VALUES (seq_idcomando.nextval
                             , 'VIRADA DE CATALOGO '||:P551_IDVIRADADECATALOGO
                             , r1.datavalidadeini
                             , 'UPDATE PRODUTOS ' ||
                               ' SET ' ||
                               ' VALORPONTOS = ' || replace(c2.pontosproduto,',','.') || 
                               ' WHERE IDPRODUTO = (select idproduto from produtosdetalhados ' || 
                                                    ' where idprodutodetalhado = ' || c2.idprodutodetalhado || ')');
                        --
                    end loop;
                  
                  commit;
                  
                  apex_application.g_print_success_message := '<span style=”color : yellow “>Parabéns!! Itens atualizados com sucesso! </span>';
                  
                  else
                  
                    apex_error.add_error
                                   (p_message               => 'Revista não localizada!',
                                    p_display_location      => apex_error.c_inline_in_notification );
                    
                  end if;
                
                  exception
                  
                    when v_erro1 then
                      apex_error.add_error (
                        p_message          => 'Falha na inclusão dos itens descontinuados! '||SQLERRM,
                        p_display_location => apex_error.c_inline_in_notification );
                    when v_erro2 then
                      apex_error.add_error (
                        p_message          => 'Falha na inclusão dos precos de produtos! '||SQLERRM,
                        p_display_location => apex_error.c_inline_in_notification );
                    when v_erro3 then
                      apex_error.add_error (
                        p_message          => 'Falha na inclusão dos precos de produtos! '||SQLERRM,
                        p_display_location => apex_error.c_inline_in_notification );
                
                
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 32651483518269389
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMA
        }
    )

