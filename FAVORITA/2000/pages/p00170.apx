                layout {
                    sequence: 1
                }
            )

            controlBreak (
                column: DATAMONTAGEM
                layout {
                    sequence: 2
                }
            )

        )

    )

    region montagem-resumida (
        name: Montagem Resumida
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select count(1) qtd
                     , pck_util_fav.fnc_nomeusuario(c.idusuario) usuario
                from vw_classificacoespedidos_fav c
                where c.idcaracteristicapedido = 18
                  and :P170_TIPORELATORIO      = 'R'
                  and c.ididioma               = :P0_IDIDIOMA
                  and ( c.idfilialfavorita     = :P170_IDFILIALFAVORITA )
                  and ( :P170_USUARIO is null or c.idusuario = :P170_USUARIO )
                  and trunc(c.dataclassificado) between to_date(:P170_DATAINICIO,'DD/MM/RRRR') and to_date(:P170_DATAFIM,'DD/MM/RRRR')
                group by c.idusuario
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P170_TIPORELATORIO
            value: R
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado!
        }
        advanced {
            savedReportMappingIdentifier: 117716466648033146
        }

        column QTD (
            type: plainText
            heading {
                heading: Qtd Pedidos
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column USUARIO (
            type: plainText
            heading {
                heading: Usuário
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 589938 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn IDDATA (
                sequence: 2
            )

            displayColumn QTD (
                sequence: 1
            )

            displayColumn USUARIO (
                sequence: 3
            )

            sort (
                column: USUARIO
                sort {
                    sequence: 1
                }
            )

            sort (
                column: SUM(I.QUANTIDADE)
                sort {
                    direction: desc
                    sequence: 2
                }
            )

            aggregate (
                column: QTD
            )

        )

    )

    pageItem P170_DATAFIM (
        type: datePickerJquery
        label {
            label: até
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: DD/MM/RRRR
            width: 10
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P170_DATAINICIO (
        type: datePickerJquery
        label {
            label: Emissão de
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: DD/MM/RRRR
            width: 10
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P170_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Estoque Favorita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nomefilialfavorita display_value
                     , f.idfilialfavorita return_value
                from vw_filiaisfavorita f
                where f.tipofilial = 'Estoque'
                  and exists ( select 1
                               from usuariosfiliaisfavorita u
                               where u.idfilialfavorita = f.idfilialfavorita
                                 and u.idusuario        = :P0_IDUSUARIO )
                order by 1
                ```
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P170_TIPORELATORIO (
        type: radioGroup
        label {
            label: Relatório
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Detalhado;D,Resumido;R
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P170_USUARIO (
        type: selectList
        label {
            label: Usuário
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeusuario(u.idusuario) display_value
                     , u.idusuario return_value
                from usuarios u
                where exists ( select 1
                               from movimentosestoques me
                               where me.idusuario      = u.idusuario
                               and me.idfilialfavorita = :P0_IDFILIALFAVORITA
                               and me.idfilialfavorita = :P170_IDFILIALFAVORITA
                               and me.idfilialfavorita = u.idfilialfavorita )
                order by 1
                ```
        }
        cascadingLov {
            parentItems: [
                P170_IDFILIALFAVORITA
                P0_IDFILIALFAVORITA
            ]
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 170
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 170
                items: {
                    P170_DATAINICIO: &P170_DATAINICIO.
                    P170_DATAFIM: &P170_DATAFIM.
                    P170_TIPORELATORIO: &P170_TIPORELATORIO.
                    P170_USUARIO: &P170_USUARIO.
                    P170_IDFILIALFAVORITA: &P170_IDFILIALFAVORITA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

