page 170 (
    name: Controle de Pedidos Montados
    title: Controle de Pedidos Montados
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region montagem-detalhado (
        name: Montagem Detalhado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.numeropedido
                     , p.representante
                     , p.vendedora
                     , p.dataemissao
                     , p.dataentrega
                     , p.valortotal
                     , p.valorapagar
                     , cp.usuario
                     , trunc(cp.dataclassificado) datamontagem
                from vw_pedidos_fav p
                   , vw_classificacoespedidos_fav cp
                where cp.idpedido         = p.idpedido
                  and cp.idcaracteristicapedido = 18
                  and :P170_TIPORELATORIO = 'D'
                  and p.ididioma          = :P0_IDIDIOMA
                  and cp.ididioma         = :P0_IDIDIOMA
                  and ( cp.idfilialfavorita = :P170_IDFILIALFAVORITA )
                  and ( :P170_USUARIO is null or cp.idusuario = :P170_USUARIO )
                  and trunc(cp.dataclassificado) between to_date(:P170_DATAINICIO,'DD/MM/RRRR') and to_date(:P170_DATAFIM,'DD/MM/RRRR')
                order by 8,9
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P170_TIPORELATORIO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado!
        }
        advanced {
            savedReportMappingIdentifier: 117714766333033129
        }

        column DATAEMISSAO (
            type: plainText
            heading {
                heading: Emissão
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        column DATAENTREGA (
            type: plainText
            heading {
                heading: Entrega
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: E
            }
        )

