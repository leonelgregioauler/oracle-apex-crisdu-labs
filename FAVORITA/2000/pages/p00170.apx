        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 589911 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100000
            }

            displayColumn DATAEMISSAO (
                sequence: 4
            )

            displayColumn DATAENTREGA (
                sequence: 5
            )

            displayColumn DATAMONTAGEM (
                sequence: 10
            )

            displayColumn NOMEQUANTIDADE (
                sequence: 8
            )

            displayColumn NUMEROPEDIDO (
                sequence: 1
            )

            displayColumn REPRESENTANTE (
                sequence: 2
            )

            displayColumn USUARIO (
                sequence: 9
            )

            displayColumn VALORAPAGAR (
                sequence: 7
            )

            displayColumn VALORTOTAL (
                sequence: 6
            )

            displayColumn VENDEDORA (
                sequence: 3
            )

            aggregate (
                function: count
                column: NUMEROPEDIDO
            )

            controlBreak (
