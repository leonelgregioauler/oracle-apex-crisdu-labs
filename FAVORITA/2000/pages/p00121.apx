page 121 (
    name: Cadastro de Telefones Bloqueados
    title: Cadastro de Telefones Bloqueados
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-de-telefones-bloqueados (
        name: Cadastro de Telefones Bloqueados
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P121_DESCRICAO (
        type: textField
        label {
            label: Descrição
            alignment: left
        }
        layout {
            sequence: 40
            region: @cadastro-de-telefones-bloqueados
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P121_IDOPERADORATEL (
        type: selectList
        label {
            label: Operadora
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-operadorastelefonia
            nullDisplayValue: " - Selecione a operadora - "
        }
        layout {
            sequence: 20
            region: @cadastro-de-telefones-bloqueados
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P121_IDTELEFONEBLOQUEADO (
        type: hidden
        layout {
            sequence: 10
            region: @cadastro-de-telefones-bloqueados
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P121_MD5 (
        type: hidden
        layout {
            sequence: 50
            region: @cadastro-de-telefones-bloqueados
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P121_OPERACAO_DML (
        type: hidden
        layout {
            sequence: 60
            region: @cadastro-de-telefones-bloqueados
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P121_TELEFONE (
        type: textField
        label {
            label: Telefone
            alignment: left
        }
        layout {
            sequence: 30
            region: @cadastro-de-telefones-bloqueados
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            customAttributes: input type="text" onkeypress="fnc_telefone(this);"
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 50
            region: @cadastro-de-telefones-bloqueados
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P121_IDTELEFONEBLOQUEADO
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 40
            region: @cadastro-de-telefones-bloqueados
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P121_IDTELEFONEBLOQUEADO
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 30
            region: @cadastro-de-telefones-bloqueados
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 120
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 20
            region: @cadastro-de-telefones-bloqueados
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P121_IDTELEFONEBLOQUEADO
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @cadastro-de-telefones-bloqueados
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P121_IDTELEFONEBLOQUEADO
        }
    )

    validation telefone-obrigatório (
        name: TELEFONE obrigatório
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P121_TELEFONE
        }
        error {
            errorMessage: Telefone deve ter um valor.
            associatedItem: @P121_TELEFONE
        }
    )

    process consulta-telefones-bloqueados (
        name: Consulta Telefones Bloqueados
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                #OWNER#.PCK_CADASTROS_FAV.PRC_TELEFONESBLOQUEADOS (
                  PIDTELEFONEBLOQUEADO => :P121_IDTELEFONEBLOQUEADO,
                  PIDOPERADORATEL => :P121_IDOPERADORATEL,
                  PTELEFONE => :P121_TELEFONE,
                  PDESCRICAO => :P121_DESCRICAO,
                  PMD5 => :P121_MD5,
                  POPERACAO_DML => 'S');
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 15384345813747215
        }
    )

    process limpar-campos-ao-sair (
        name: Limpar Campos ao Sair
        type: clearSessionState
        execution {
            sequence: 10
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 15385346779747225
        }
    )

    process limpar-campos-para-adicionar (
        name: Limpar Campos para Adicionar
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 15385406165747226
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    process operação-dml-em-telefones-bloqueados (
        name: Operação DML em Telefones Bloqueados
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  #OWNER#.PCK_CADASTROS_FAV.PRC_TELEFONESBLOQUEADOS (
                    PIDTELEFONEBLOQUEADO => :P121_IDTELEFONEBLOQUEADO,
                    PIDOPERADORATEL => :P121_IDOPERADORATEL,
                    PTELEFONE => :P121_TELEFONE,
                    PDESCRICAO => :P121_DESCRICAO,
                    PMD5 => :P121_MD5,
                    POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 15497045598458386
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 121
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

)

