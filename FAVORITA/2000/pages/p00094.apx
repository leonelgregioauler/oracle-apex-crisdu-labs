    process consulta-tarefa (
        name: Consulta Tarefa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  if :P94_IDTAREFA is not null then
                    --
                    pck_tarefas_fav.prc_tarefas(pidtarefa           => :P94_IDTAREFA,
                                                pidtipotarefa       => :P94_IDTIPOTAREFA,
                                                pidticketcallcenter => :P94_IDTICKETCALLCENTER,
                                                ptelefone           => :P94_TELEFONE,
                                                pdatainclusao       => :P94_DATAINCLUSAO,
                                                pprioridade         => :P94_PRIORIDADE,
                                                pidsituacao         => :P94_IDSITUACAO,
                                                pobservacao         => :P94_OBSERVACAO,
                                                pidusuario          => :P94_IDUSUARIO,
                                                pidpessoa           => :P94_IDPESSOA,
                                                pidgrupoatendimento => :P94_IDGRUPOATENDIMENTO,
                                                pdatainicio         => :P94_DATAINICIO,
                                                pdataconclusao      => :P94_DATACONCLUSAO,
                                                pnumeroposicaoatendimento  => :P94_NUMEROPOSICAOATENDIMENTO,
                                                pidpedido           => :P94_IDPEDIDO,
                                                pcodigoarea         => :P94_CODIGOAREA,
                                                pmd5                => :P94_MD5,
                                                poperacao_dml       => 'S');
                    --
                  end if;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 6734840448363544
        }
    )

    process operação-dml-em-lista-de-tarefas (
        name: Operação DML em Lista de Tarefas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --                     --
                  #OWNER#.pck_tarefas_fav.prc_tarefas(pidtarefa           => :P94_IDTAREFA,
                                                      pidtipotarefa       => :P94_IDTIPOTAREFA,
                                                      pidticketcallcenter => :P94_IDTICKETCALLCENTER,
                                                      ptelefone           => :P94_TELEFONE,
                                                      pdatainclusao       => :P94_DATAINCLUSAO,
                                                      pprioridade         => :P94_PRIORIDADE,
                                                      pidsituacao         => :P94_IDSITUACAO,
                                                      pobservacao         => :P94_OBSERVACAO,
