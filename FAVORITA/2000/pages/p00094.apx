    button gearartarefas (
        buttonName: GEARARTAREFAS
        label: Gerar Tarefas
        layout {
            sequence: 20
            region: @acessos
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 97
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util_fav.fnc_verificaacesso(36010,:P0_IDUSUARIO) = 'S'
                  and exists ( select 1
                               from usuarios u
                               where idusuario = :P0_IDUSUARIO
                                 and idgerente = 80 )
                ```
        }
    )

