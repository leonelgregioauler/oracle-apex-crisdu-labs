    region lista-de-tarefas (
        name: Lista de Tarefas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select /*+ FIRST_ROWS(50) */t.idtarefa 
                     , t.tipotarefa
                     , case length(t.telefone)
                         when 12 then
                           substr(t.telefone,2)
                         when 13 then
                           substr(t.telefone,3)
                         else
                           t.telefone
                       end as telefone
                     , t.datainclusao
                     , t.prioridade
                     , t.situacao
                     , t.observacao
                     , t.nomeusuario
                     , t.cliente||' - '||t.cpfcliente cliente
                     , t.datainicio
                     , t.dataconclusao
                     , t.idtarefa historicostarefa
                     , t.numeroposicaoatendimento
                     , t.tempo 
                     , t.qtdpedidos
                from vw_tarefas_fav t
                where ( :P94_DATAINI is null or ( :P94_TIPODATA = 'I' and trunc(t.datainclusao ) between to_date(:P94_DATAINI,'dd/mm/rrrr') and to_date(:P94_DATAFIM,'dd/mm/rrrr') )
                                             or ( :P94_TIPODATA = 'E' and trunc(t.datainicio   ) between to_date(:P94_DATAINI,'dd/mm/rrrr') and to_date(:P94_DATAFIM,'dd/mm/rrrr') )
                                             or ( :P94_TIPODATA = 'C' and trunc(t.dataconclusao) between to_date(:P94_DATAINI,'dd/mm/rrrr') and to_date(:P94_DATAFIM,'dd/mm/rrrr') ) )
                  and ( :P94_NRTAREFA is null or t.idtarefa = :P94_NRTAREFA )
                  AND ( :P94_TELEFONEF is null or t.telefone like '%'||:P94_TELEFONEF||'%')
                  and ( :P94_OBSERVACAOF is null or lower(t.observacao) like  '%'||lower(:P94_OBSERVACAOF)||'%' )
                  and ( :P94_TIPOTAREFA is null or t.IDtipotarefa = :P94_TIPOTAREFA )
                  and ( :P94_SITUACAOTAREFA is null or t.idsituacao = :P94_SITUACAOTAREFA )
                  and :P94_FILTRAR = 2
                  and t.idgrupoatendimento in ( select idgrupoatendimento 
                                                from roman.usuariosgruposatendimento u
                                                where u.usuario = v('APP_USER'))
                                                 
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 72
                items: {
                    P72_IDTAREFA: #IDTAREFA#
                }
                action: resetPagination
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhuma Tarefa Encontrada.
        }
        advanced {
            savedReportMappingIdentifier: 6733260065363528
        }

