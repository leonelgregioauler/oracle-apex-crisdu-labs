    region itens-sempermissao (
        name: Itens_semPermissao
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.iditensinventariociclico
                     , i.idinventariociclico 
                     , i.idestoque
                     , i.qtdFisicaContada
                     , i.qtdEmTransito
                     , i.qtdVirtualAge
                     , i.vlrCusto
                     , i.divFisicoOptimus
                     , i.divFisicoFiscal
                     , i.divOptimusFiscal
                     , i.skuVirtualAge
                     , i.vlraPagar 
                     , i.qtdOptimusFisico
                     , i.idprodutodetalhado
                from itensInventarioCiclico i
                   , estoques               e
