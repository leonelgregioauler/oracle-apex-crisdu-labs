    dynamicAction setasku (
        name: SetaSKU
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P526_IDESTOQUE
        }

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P526_QTDFISICACONTADA
            }
            execution {
                sequence: 20
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT skuVirtualAge
                      FROM deparaprodfavoritavirtualage xx
                     WHERE xx.idprodutodetalhado = (select idprodutodetalhado 
                                                      from estoques e
                                                     where e.idFilialFavorita = :P526_IDFILIAL
                                                       and e.idEstoque = :P526_IDESTOQUE)
                    ```
                itemsToSubmit: P526_IDESTOQUE
            }
            affectedElements {
                selectionType: items
                items: P526_SKUVIRTUALAGE
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction setfocus (
        name: SetFocus2
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P526_QTDFISICACONTADA
