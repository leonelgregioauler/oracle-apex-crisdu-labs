    process finalizarcontagem (
        name: FinalizarContagem
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                
                videdicaoRevista favorita.edicoesrevistas.idedicaorevista%type;
                vidpais   favorita.filiaisfavorita.idpais%type;
                vdata     date   := sysdate;
                vSituacao number := 3; -- Aguardando Estoque
                begin
                
                  begin
                      select f.idpais
                        into vidpais
                       from favorita.filiaisfavorita f
                      where f.idfilialfavorita = :P526_IDFILIAL;
                  exception
                    when no_data_found then
                      vidpais := null;
                  end;
                  --
                  begin
                      select max(idedicaorevista)
                        into videdicaoRevista
                       from favorita.edicoesrevistas
                      where trunc(sysdate) between datainicial and datafinal
                        and idpais = vidpais;
                  exception
                    when no_data_found then
                      vidEdicaoRevista := null;
                  end;
                  --
                
                  FAVORITA.PCK_CADASTROS_FAV.PRC_INVENTARIOCICLICO ( PIDINVENTARIOCICLICO  => :P526_IDINVENTARIOCICLICO
                                                                   , PSITUACAO             => vSituacao
                                                                   , PIDFILIAL             => :P526_IDFILIAL
                                                                   , PIDUSUARIO            => :P0_IDUSUARIO
                                                                   , PDATACRIACAO          => :P526_DATACRIACAO
                                                                   , PDATAENCERRAMENTO     => vdata
                                                                   , PIDUSUARIOENCERRA     => :P0_IDUSUARIO
                                                                   , PTIPOINVENTARIO       => :P526_TIPOINVENTARIO
                                                                   , PMD5                  => :P526_MD5
                                                                   , POPERACAO_DML         => 'U');
                
                   --
                   -- So para Inventario Geral: item nunca contado (nao bipado, nao digitado)
                   -- e tratado como contagem fisica = 0, por decisao de negocio.
                   if :P526_TIPOINVENTARIO = 'G' then
                     --
                     update favorita.itensInventarioCiclico ic
                        set ic.qtdFisicaContada = 0
                      where ic.idInventarioCiclico = :P526_IDINVENTARIOCICLICO
                        and ic.qtdFisicaContada is null;
                     --
                   end if;
                   --
                
                   update itensInventarioCiclico ic
                     set qtdOptimusFisico = (select e.quantidade
                                               from favorita.estoques e
                                              where e.idfilialfavorita   = :P526_IDFILIAL
                                                and e.idprodutodetalhado = ic.idProdutoDetalhado)
                       , vlrapagar = pck_integracao_fav_widecomm.fnc_buscavalorcomdesconto (vidEdicaoRevista,
                                                                                            ic.idProdutoDetalhado,
                                                                                            vidpais,
                                                                                            ic.idEstoque).valorVenda
                       , vlrcusto = pck_integracao_fav_widecomm.fnc_buscavalorcomdesconto (vidEdicaoRevista,
                                                                                            ic.idProdutoDetalhado,
                                                                                            vidpais,
                                                                                            ic.idEstoque).valorCusto
                       --
                       , qtdEmTransito = favorita.pck_estoque_fav.fnc_estoquetransito(ic.idEstoque)
                       --
                       , divFisicoOptimus =  ic.qtdFisicaContada
                                            + favorita.pck_estoque_fav.fnc_estoquetransito(ic.idEstoque)
                                            - (select e.quantidade
                                                from favorita.estoques e
                                               where e.idfilialfavorita   = :P526_IDFILIAL
                                                 and e.idprodutodetalhado = ic.idProdutoDetalhado)
                       , divFisicoFiscal  = qtdFisicaContada - qtdVirtualAge
                
                       , divOptimusFiscal = qtdVirtualAge    - (select e.quantidade
                                                                  from favorita.estoques e
                                                                 where e.idfilialfavorita   = :P526_IDFILIAL
                                                                   and e.idprodutodetalhado = ic.idProdutoDetalhado)
                
                   where idInventarioCiclico = :P526_IDINVENTARIOCICLICO;
                   --
                   apex_application.g_print_success_message := 'Contagem Finalizada com sucesso! ';
                
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 12945683245554404
        }
        serverSideCondition {
            whenButtonPressed: @finalizarcont
        }
    )

