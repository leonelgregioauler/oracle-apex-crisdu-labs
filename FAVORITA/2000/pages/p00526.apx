page 526 (
    name: Cadastro de Inventarios
    title: Cadastro de Inventarios
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region histórico-de-situações (
        name: Histórico de Situações
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.datasituacao,
                       s.idUsuario,
                       t1.descricao "idTipoSituacaoAnt",
                       t2.descricao "idTipoSituacaoNova"
                  from situacoesInventarioCiclico s
                  ,    tipossituacoesinventario   t1
                  ,    tipossituacoesinventario   t2
                  where s.idInventarioCiclico = :P526_IDINVENTARIOCICLICO
                    and s.idTipoSituacaoAnt   = t1.idTipoSituacao
                    and s.idTipoSituacaoNova  = t2.idTipoSituacao
                  order by s.datasituacao desc
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 20001233140949133
        }

