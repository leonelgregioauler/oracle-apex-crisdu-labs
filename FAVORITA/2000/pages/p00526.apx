    pageItem P526_IDFILIAL (
        type: selectList
        label {
            label: Filial do Inventário
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) || ' - ' || idfilialfavorita as d,
                       idfilialfavorita as r 
                  from filiaisfavorita f
                where exists ( select 1
                               from usuariosfiliaisfavorita u
                               where u.idfilialfavorita = f.idfilialfavorita
                                 and u.consultar        = 'S' 
                                 and u.idusuario        = :P526_IDUSUARIO/*(SELECT IDUSUARIO
                                                             FROM USUARIOS
                                                            WHERE USUARIO = :P526_USUARIO)*/ )
                 order by 1
                ```
        }
        layout {
            sequence: 40
            region: @inventario
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from inventarioCiclico      c
                     , itensInventarioCiclico i
                 where c.idInventarioCiclico = i.idInventarioCiclico
                   and c.idInventarioCiclico = :P526_IDINVENTARIOCICLICO
                ```
        }
        security {
            encryptSessionState: false
        }
    )

