    region inventario (
        name: Inventario
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    region itens-compermissao (
        name: Itens_comPermissao
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                     select i.iditensinventariociclico
                     , i.idinventariociclico
                     , i.idestoque
                     , i.qtdFisicaContada
                     , i.qtdEmTransito
                     , i.qtdVirtualAge
                     , i.vlrCusto vlrCustoUnitario
                     , i.vlrCusto * nvl(i.divFisicoOptimus,0) vlrCusto
                     , i.divFisicoOptimus
                     , case when exists ( select 1 from favorita.movimentosestoques m
                                          where m.iditensinventariociclico = i.iditensinventariociclico )
                            then 'Ajustado'
                            else 'Pendente'
                       end situacaoajuste
                     , i.divFisicoFiscal
                     , i.divOptimusFiscal
                     , i.skuVirtualAge
                     , i.vlraPagar * nvl(i.divFisicoOptimus,0) vlraPagar
                     , i.qtdOptimusFisico
                     , i.idprodutodetalhado
                     , cs.nomecategoria categoriasite --T16776292
                     , c.nome           categoria --T16776292
                     , sc.nome          subcategoria --T16776292
                  from itensInventarioCiclico i
                  join estoques               e   on e.idestoque            = i.idestoque
                  join inventariociclico      ic  on ic.idinventariociclico = i.idinventariociclico
                  left join produtosdetalhados pd on pd.idprodutodetalhado  = i.idprodutodetalhado
                                                 and ic.tipoinventario      = 'G'
                  left join produtos           p  on p.idproduto            = pd.idproduto
                  left join categorias         c  on c.idcategoria          = p.idcategoria
                  left join categoriassite     cs on cs.idcategoriasite     = c.idcategoriasite
                  left join subcategorias      sc on sc.idsubcategoria      = p.idsubcategoria
                 where i.idInventarioCiclico = :p526_idInventarioCiclico
                
                /*select i.iditensinventariociclico
                     , i.idinventariociclico
                     , i.idestoque
                     , i.qtdFisicaContada
                     , i.qtdEmTransito
                     , i.qtdVirtualAge
                     , i.vlrCusto vlrCustoUnitario
                     , i.vlrCusto * nvl(i.divFisicoOptimus,0) vlrCusto
                     , i.divFisicoOptimus
                     , case when exists ( select 1 from favorita.movimentosestoques m
                                          where m.iditensinventariociclico = i.iditensinventariociclico )
                            then 'Ajustado'
                            else 'Pendente'
                       end situacaoajuste
                     , i.divFisicoFiscal
                     , i.divOptimusFiscal
                     , i.skuVirtualAge
                     , i.vlraPagar * nvl(i.divFisicoOptimus,0) vlraPagar
                     , i.qtdOptimusFisico
                     , i.idprodutodetalhado
                from itensInventarioCiclico i, estoques e
                where i.idInventarioCiclico = :p526_idInventarioCiclico
                  and i.idestoque = e.idestoque*/
                ```
            pageItemsToSubmit: P526_IDINVENTARIOCICLICO
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: PAG_527_ITENS
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from roman.aplicacoes p
                     , roman.acessos    a
                 where p.idsistema = 2000
                   and p.idaplicacao = 34254
                   and p.idAplicacao = a.idAplicacao
                   and ( a.ativo = 'S' and a.usuario = :P0_USUARIO or
                        :P526_IDSITUACAO = 2 )
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 50000
        }
        advanced {
            savedReportMappingIdentifier: 18052144409859526
        }

