    process operação-dml-em-inventarios (
        name: Operação DML em Inventarios
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml     varchar2(1);
                  vData             date := sysdate; --trunc(sysdate) ;
                  --
                begin
                
                  if v('REQUEST')    = 'INSERIR' then
                  
                    voperacao_dml := 'I';
                    
                  elsif v('REQUEST') = 'ATUALIZAR' then
                  
                    voperacao_dml := 'U';
                    
                  elsif v('REQUEST') = 'EXCLUIR' then
                  
                    voperacao_dml := 'D';
                    
                  end if;
                  --
                 --RAISE_APPLICATION_ERROR(-20001,'REQUEST='||v('REQUEST'));
                 
                 --Colocar um if para definir o tipo d inventario cicilico chama esta prc geral chama a outra prc que vou criar.
                 
                  FAVORITA.PCK_CADASTROS_FAV.PRC_INVENTARIOCICLICO ( PIDINVENTARIOCICLICO  => :P526_IDINVENTARIOCICLICO
                                                                   , PSITUACAO             => :P526_IDSITUACAO
                                                                   , PIDFILIAL             => :P526_IDFILIAL
                                                                   , PIDUSUARIO            => :P0_IDUSUARIO --:P526_IDUSUARIO
                                                                   , PDATACRIACAO          => vData   --:P525_DATACRIACAO
                                                                   , PDATAENCERRAMENTO     => :P526_DATAENCERRAMENTO
                                                                   , PIDUSUARIOENCERRA     => :P0_IDUSUARIO --:P526_IDUSUARIOENCERRA
                                                                   , PTIPOINVENTARIO       => :P526_TIPOINVENTARIO
                                                                   , PMD5                  => :P526_MD5
                                                                   , POPERACAO_DML         => voperacao_dml);
                  --
                
                
                
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 12487757486221317
        }
        serverSideCondition {
            whenButtonPressed: @inserir
        }
    )

