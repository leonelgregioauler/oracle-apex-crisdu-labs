    dynamicAction confirmaatualizacao (
        name: ConfirmaAtualizacao
        execution {
            sequence: 150
        }
        when {
            event: click
            selectionType: button
            button: @atualizasaldos
        }

        action native-confirm (
            action: confirm
            settings {
                message: Confirma Atualizar Saldos do Inventário?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: ATUALIZASALDOS
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

