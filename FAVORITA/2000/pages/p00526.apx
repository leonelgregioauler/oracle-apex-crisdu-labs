            }
            layout {
                sequence: 60
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1
                      from roman.aplicacoes p
                         , roman.acessos    a
                     where p.idsistema = 2000
                       and p.idaplicacao = 34254
                       and p.idAplicacao = a.idAplicacao
                       and a.ativo = 'S'
                       and a.usuario = :P0_USUARIO
                    ```
            }
            security {
                escapeSpecialChars: false
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 127933 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn IDPRODUTODETALHADO (
                sequence: 2
            )

            displayColumn QTDFISICACONTADA (
                sequence: 3
            )

            displayColumn QTDVIRTUALAGE (
                sequence: 4
            )

            displayColumn SKUVIRTUALAGE (
                sequence: 1
            )

        )

    )

    pageItem P526_DATACRIACAO (
        type: displayOnly
        label {
            label: Data Criação
            alignment: left
        }
        layout {
            sequence: 60
            region: @inventario
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
        }
