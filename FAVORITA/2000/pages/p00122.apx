page 122 (
    name: Cadastro de Motivos de Protocolos
    title: Motivos de Protocolos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region motivos-de-protocolos (
        name: Motivos de Protocolos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idmotivoprotocolo
                     , descricao
                     , idtipoprotocolo
                     , aparecercall
                     , aparecerfilial
                     , idtexto
                     , descricaosite
                from motivosprotocolos
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 15941560361831088
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDMOTIVOPROTOCOLO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @DESCRICAO
                layout {
                    width: 700
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDTEXTO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @IDTIPOPROTOCOLO
                layout {
                    width: 200
                    sequence: 5
                }
            )

            displayColumn (
                column: @APARECERCALL
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @APARECERFILIAL
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @DESCRICAOSITE
                layout {
                    sequence: 4
                }
            )

        )

        column APARECERCALL (
            type: selectList
            heading {
                heading: Aparecer Call Center
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @lov-simnao
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                databaseColumn: APARECERCALL
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column APARECERFILIAL (
            type: selectList
            heading {
                heading: Aparecer Filial
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @lov-simnao
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                databaseColumn: APARECERFILIAL
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column DESCRICAO (
            type: textarea
            heading {
                heading: Descrição
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
                maxLength: 1000
            }
            source {
                databaseColumn: DESCRICAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
        )

        column DESCRICAOSITE (
            type: textarea
            heading {
                heading: Descrição Site
            }
            layout {
                sequence: 90
            }
            source {
                databaseColumn: DESCRICAOSITE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column IDMOTIVOPROTOCOLO (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDMOTIVOPROTOCOLO
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: SEQ_IDMOTIVOPROTOCOLO
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDTEXTO (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: IDTEXTO
                dataType: number
                queryOnly: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDTIPOPROTOCOLO (
            type: selectList
            heading {
                heading: Tipo Protocolo
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select descricao as d,
                           idtipoprotocolo as r
                      from tiposprotocolosatendimentos
                     order by 1
                    ```
                nullDisplayValue: "- Selecione - "
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: IDTIPOPROTOCOLO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

    )

    validation descricao-obrigatório (
        name: DESCRICAO obrigatório
        execution {
            sequence: 20
        }
        validation {
            editableRegion: @motivos-de-protocolos
            type: columnIsNotNull
            column: DESCRICAO
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ter um valor.
            associatedColumn: DESCRICAO
        }
    )

    validation descricaoprotocolo-unique (
        name: DESCRICAOPROTOCOLO unique
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @motivos-de-protocolos
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vdescricao varchar2(1000);
                begin
                  RAISE_APPLICATION_ERROR(-20006 , :IDMOTIVOPROTOCOLO);
                  select descricao
                  into vdescricao
                  from motivosprotocolos
                  where upper(descricao) = upper(:DESCRICAO)
                  and idmotivoprotocolo != :IDMOTIVOPROTOCOLO
                  and idtipoprotocolo = :IDTIPOPROTOCOLO;
                  --
                  if vdescricao is not null then
                    return 'Existe um cadastro no sistema com estas informações. Não são permitidas informações repetidas para este cadastro.';
                  end if;
                  --
                exception
                  when no_data_found then
                    return '';
                end;
                ```
        }
        error {
            associatedColumn: DESCRICAO
        }
        serverSideCondition {
            executionScope: allSubmittedRows
            type: never
        }
    )

    process save-interactive-grid-data (
        name: " - Save Interactive Grid Data"
        type: interactiveGridAutoRowProcessing
        editableRegion: @motivos-de-protocolos
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 15945137445831092
        }
    )

)

