page 510 (
    name: Cadastro CST Origem
    title: Cadastro CST Origem
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-origem-cst (
        name: Cadastro Origem CST
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ee.idcstorigem
                     , ee.descricao
                from favorita.CSTORIGEM ee
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 116886597653991425
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDCSTORIGEM
                layout {
                    width: 359
                    sequence: 2
                }
            )

            displayColumn (
                column: @DESCRICAO
                layout {
                    width: 849
                    sequence: 3
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column DESCRICAO (
            type: textarea
            heading {
                heading: Descrição
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: DESCRICAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column IDCSTORIGEM (
            type: numberField
            heading {
                heading: Código CST Origem
                alignment: center
            }
            settings {
                numberAlignment: center
                virtualKeyboard: text
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDCSTORIGEM
                dataType: number
                primaryKey: true
            }
            columnFilter {
                lovType: none
            }
        )

    )

    region mensagem-retorno (
        name: Mensagem Retorno
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNullAndNotZero
            item: P510_RESPOSTA
        }
    )

    pageItem P510_RESPOSTA (
        type: textField
        label {
            label: Resposta
            alignment: left
        }
        layout {
            sequence: 10
            region: @mensagem-retorno
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    process cadastro-origem-cst-save-interactive-grid-data (
        name: Cadastro Origem CST - Save Interactive Grid Data
        type: executeCode
        editableRegion: @cadastro-origem-cst
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vmd5   varchar(4000);
                  vdml   varchar(2);
                  vmensagemerro varchar(4000);
                  --
                begin  
                     --
                     :P510_RESPOSTA := '';
                     --
                     case :APEX$ROW_STATUS  
                     when 'C' then
                       --
                       PCK_CADASTROS_FAV.prc_cstorigem ( pidcstorigem  => :IDCSTORIGEM
                                                       , pdescricao    => :DESCRICAO
                                                       , pmd5          => vmd5
                                                       , poperacao_dml => 'I'
                                                       , pmensagemerro => vmensagemerro);
                       --
                     when 'U' then  
                       --
                       PCK_CADASTROS_FAV.prc_cstorigem ( pidcstorigem  => :IDCSTORIGEM
                                                       , pdescricao    => :DESCRICAO
                                                       , pmd5          => vmd5
                                                       , poperacao_dml => 'U'
                                                       , pmensagemerro => vmensagemerro);
                       --
                     when 'D' then  
                       --
                       PCK_CADASTROS_FAV.prc_cstorigem ( pidcstorigem  => :IDCSTORIGEM
                                                       , pdescricao    => :DESCRICAO
                                                       , pmd5          => vmd5
                                                       , poperacao_dml => 'D'
                                                       , pmensagemerro => vmensagemerro);
                       --
                     end case;  
                     --
                     :P510_RESPOSTA := vmensagemerro;
                     --
                     exception
                       when others then
                         --
                         :P510_RESPOSTA := vmensagemerro;
                         --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 116887527579991435
        }
    )

)

