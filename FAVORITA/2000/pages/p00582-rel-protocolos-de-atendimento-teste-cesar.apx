    dynamicAction esconde-campos (
        name: Esconde Campos
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P582_TIPODATA
        }
        clientSideCondition {
            type: item=value
            item: P582_TIPODATA
            value: -1
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P582_DATAINI
                    P582_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P582_DATAINI
                    P582_DATAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    dynamicAction refreh (
        name: Refreh
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P582_TIPOPROTOCOLO
        }
    )

    process iniciaprotocolo (
        name: INICIAPROTOCOLO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidprotocoloatendimento number;
                  VIDFILIAL number;
                  VIDUSUARIOSOLICITOU number := :P0_IDUSUARIO;
                  VDATAPROTOCOLO date := sysdate;
                  VIDPEDIDO number;
                  VSITUACAO varchar2(1);
                  VJUSTIFICATIVA varchar2(2000);
                  VDATAATENDIMENTO date;
                  VOBSERVACAOINTERNA varchar2(2000);
                  VIDMOTIVOPROTOCOLO number;
                  VCPF varchar2(11);
                  VIDTIPOPROTOCOLO number;
                  VIDUSUARIOATENDEU number;
                  VNUMEROCOMPROVANTE varchar2(30);
                  VVALORDEPOSITADO number;
                  VDATAPRORROGACAO date;
                  VDATAPAGAMENTO date;
                  VCONTAPAGAMENTO varchar2(30);
                  VMD5 varchar2(2000);
                  --
                begin
                  --
                  #OWNER#.PCK_PROTOCOLOSATENDIMENTOS_FAV.PRC_PROTOCOLOSATENDIMENTOS( PIDPROTOCOLOATENDIMENTO => vidprotocoloatendimento,
                                                                                     PIDFILIAL => VIDFILIAL,
                                                                                     PIDUSUARIOSOLICITOU => VIDUSUARIOSOLICITOU,
                                                                                     PDATAPROTOCOLO => VDATAPROTOCOLO,
                                                                                     PIDPEDIDO => VIDPEDIDO,
                                                                                     PSITUACAO => VSITUACAO,
                                                                                     PJUSTIFICATIVA => VJUSTIFICATIVA,
                                                                                     PDATAATENDIMENTO => VDATAATENDIMENTO,
                                                                                     POBSERVACAOINTERNA => VOBSERVACAOINTERNA,
                                                                                     PIDMOTIVOPROTOCOLO => VIDMOTIVOPROTOCOLO,
                                                                                     PCPF => VCPF,
                                                                                     PIDTIPOPROTOCOLO => VIDTIPOPROTOCOLO,
                                                                                     PIDUSUARIOATENDEU => VIDUSUARIOATENDEU,
                                                                                     PNUMEROCOMPROVANTE => VNUMEROCOMPROVANTE,
                                                                                     PVALORDEPOSITADO => VVALORDEPOSITADO,
                                                                                     PDATAPRORROGACAO => VDATAPRORROGACAO,
                                                                                     PDATAPAGAMENTO => VDATAPAGAMENTO,
                                                                                     PCONTAPAGAMENTO => VCONTAPAGAMENTO,
                                                                                     PMD5 => VMD5,
                                                                                     POPERACAO_DML => 'I');
                  --
                  :P582_IDPROTOCOLOATENDIMENTO := vidprotocoloatendimento;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1596832307013782854
        }
        serverSideCondition {
            whenButtonPressed: @novo
            type: never
        }
    )

    branch (
        name: proximo passo
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 131
                items: {
                    P131_IDPROTOCOLOATENDIMENTO: &P582_IDPROTOCOLOATENDIMENTO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: PROXIMOPASSO
        }
    )

    branch (
        name: go to page 129
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 582
                items: {
                    P582_TIPO: &P582_TIPO.
                    P582_IDPEDIDO: &P582_IDPEDIDO.
                    P582_PROTOCOLO: &P582_PROTOCOLO.
                    P582_SITUACAO: &P582_SITUACAO.
                    P582_TIPOPROTOCOLO: &P582_TIPOPROTOCOLO.
                    P582_TIPODATA: &P582_TIPODATA.
                    P582_DATAINI: &P582_DATAINI.
                    P582_DATAFIM: &P582_DATAFIM.
                    P582_INTEGRADO: &P582_INTEGRADO.
                    P582_NRDOCUMENTO: &P582_NRDOCUMENTO.
                    P582_FILTRAR: S
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

