    region protocolos-de-atendimento (
        name: Protocolos de Atendimento
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  v_sql          clob;
                  v_acesso28706  varchar2(10);
                  v_acesso28707  varchar2(10);
                begin
                  -- ==================================================================
                  -- SELECT base (partes fixas, sem filtros opcionais)
                  -- ==================================================================
                  v_sql := q'[
                select p.idprotocoloatendimento
                     , p.idfilial
                     , roman.pck_romance.fnc_nomefilial(p.idfilial) nomefilial
                     , p.idusuariosolicitou
                     , pck_util_fav.fnc_nomeusuario(p.idusuariosolicitou) usuariosolicitou
                     , p.dataprotocolo
                     , p.idpedido
                     , p.numeropedido
                     , p.situacao
                     , decode(p.situacao,'P','Pendente','C','Concluído','R','Rejeitado') descsituacao
                     , p.justificativa
                     , p.dataatendimento
                     , p.observacaointerna
                     , p.idmotivoprotocolo
                     , pck_util_fav.fnc_retornamotivoprotocolo(p.idmotivoprotocolo, :P0_IDIDIOMA) motivoprotocolo
                     , p.cpf
                     , p.idtipoprotocolo
                     , pck_util_fav.fnc_retornatipoprotocolo(p.idtipoprotocolo, :P0_IDIDIOMA) tipoprotocolo
                     , p.idusuarioatendeu
                     , pck_util_fav.fnc_nomeusuario(p.idusuarioatendeu) usuarioatendeu
                     , p.numerocomprovante
                     , p.valordepositado
                     , p.dataprorrogacao
                     , p.datapagamento
                     , p.contapagamento
                     , p.idprotocoloatendimento idprotocolo
                     , p.vendedora
                     , p.representante
                     , p.situacaovencimento
                     , p.situacaopagamento
                     , p.liberadoatendimento
                     , p.valorapagar
                     , p.dataemissao
                     , p.origem
                  from vw_protocolosatendimentos_fav p
                     , usuarios u
                 where p.idusuariosolicitou = u.idusuario
                   and exists ( select 1
                                  from permissoestiposprotocolos pp
                                 where pp.idtipoprotocolo = p.idtipoprotocolo
                                   and pp.idusuario       = :P0_IDUSUARIO
                                   and pp.criar           = 'S' )]';
                
                  -- ==================================================================
                  -- Botão "Filtrar": sem ele, retorna a estrutura sem linhas
                  -- ==================================================================
                  if nvl(:P582_FILTRAR, 'N') <> 'S' then
                    v_sql := v_sql || chr(10) || '   and 1 = 0'
                                   || chr(10) || ' order by 1 desc';
                    return v_sql;
                  end if;
                
                  -- ==================================================================
                  -- Filtros simples: só entram se o item estiver informado
                  -- ==================================================================
                  if :P582_IDPEDIDO is not null then
                    v_sql := v_sql || chr(10) || '   and p.idpedido = :P582_IDPEDIDO';
                  end if;
                
                  if :P582_PROTOCOLO is not null then
                    v_sql := v_sql || chr(10) || '   and p.idprotocoloatendimento = :P582_PROTOCOLO';
                  end if;
                
                  if :P582_IDFILIALROMANCE is not null then
                    v_sql := v_sql || chr(10) || '   and p.idfilial = :P582_IDFILIALROMANCE';
                  end if;
                
                  if :P582_SITUACAO is not null then
                    v_sql := v_sql || chr(10) || '   and p.situacao = :P582_SITUACAO';
                  end if;
                
                  if :P582_TIPO is not null then
                    v_sql := v_sql || chr(10) || '   and p.idtipoprotocolo = :P582_TIPO';
                  end if;
                
                  if :P582_NUMEROCOMPROVANTE is not null then
                    v_sql := v_sql || chr(10) || '   and p.numerocomprovante = :P582_NUMEROCOMPROVANTE';
                  end if;
                
                  if :P582_IDFILIALFAVORITA is not null then
                    v_sql := v_sql || chr(10) || '   and u.idfilialfavorita = :P582_IDFILIALFAVORITA';
                  end if;
                
                  if :P582_INTEGRADO is not null then
                    v_sql := v_sql || chr(10) || q'[   and exists ( select 1
                                  from pedidos pe
                                 where pe.idpedido = p.idpedido )]';
                  end if;
                
                  if :P582_NRDOCUMENTO is not null then
                    v_sql := v_sql || chr(10) || q'[   and exists ( select 1
                                  from vw_boletos_fav b
                                 where b.numero   = :P582_NRDOCUMENTO
                                   and b.idpedido = p.idpedido )]';
                  end if;
                
                  if :P582_IDPEDIDOGERADO is not null then
                    v_sql := v_sql || chr(10) || q'[   and exists ( select 1
                                  from favorita.itenspedidostrocados itr
                                 where itr.idpedidogerado = :P582_IDPEDIDOGERADO
                                   and itr.idpedido       = p.idpedido )]';
                  end if;
                
                  -- ==================================================================
                  -- Filtro de data: só a coluna escolhida entra no SQL
                  -- (sem trunc na coluna para permitir uso de índice)
                  -- ==================================================================
                  case :P582_TIPODATA
                    when 'T' then
                      null;
                    when 'C' then
                      v_sql := v_sql || chr(10) || q'[   and p.dataprotocolo   >= to_date(:P582_DATAINI,'DD/MM/RRRR')
                   and p.dataprotocolo   <  to_date(:P582_DATAFIM,'DD/MM/RRRR') + 1]';
                    when 'A' then
                      v_sql := v_sql || chr(10) || q'[   and p.dataatendimento >= to_date(:P582_DATAINI,'DD/MM/RRRR')
                   and p.dataatendimento <  to_date(:P582_DATAFIM,'DD/MM/RRRR') + 1]';
                    when 'E' then
                      v_sql := v_sql || chr(10) || q'[   and p.dataemissao     >= to_date(:P582_DATAINI,'DD/MM/RRRR')
                   and p.dataemissao     <  to_date(:P582_DATAFIM,'DD/MM/RRRR') + 1]';
                    else
                      v_sql := v_sql || chr(10) || '   and 1 = 0';
                  end case;
                
                  -- ==================================================================
                  -- Acesso 28706: sem acesso, restringe à filial do usuário
                  -- ==================================================================
                  v_acesso28706 := pck_util_fav.fnc_verificaacesso(28706, :P0_IDUSUARIO);
                
                  if nvl(v_acesso28706, 'N') <> 'S' then
                    v_sql := v_sql || chr(10) || q'[   and p.idfilial = ( select roman.pck_romance.fnc_filialusuario(:APP_USER) from dual )]';
                  end if;
                
                  -- ==================================================================
                  -- Acesso 28707
                  --   Bloco tipo de protocolo -> acesso = 'S' ou nulo
                  --   Bloco atendimentos RMC  -> acesso = 'N' ou nulo
                  -- ==================================================================
                  v_acesso28707 := pck_util_fav.fnc_verificaacesso(28707, :P0_IDUSUARIO);
                
                  if v_acesso28707 is null or v_acesso28707 = 'S' then
                
                    case :P582_TIPOPROTOCOLO
                      when 'R' then
                        v_sql := v_sql || chr(10) || q'[   and exists ( select 1
                                  from roman.vw_filiais f
                                 where f.idfilial   = p.idfilial
                                   and f.tipofilial = 'D' )
                   and (    not exists ( select 1
                                           from roman.usuariosgruposatendimento ug
                                          where ug.usuario = u.usuario )
                         or u.idfilialfavorita not in (1, 2) )]';
                      when 'F' then
                        v_sql := v_sql || chr(10) || q'[   and u.idfilialfavorita in (1, 2)
                   and exists ( select 1
                                  from roman.usuariosgruposatendimento ug
                                 where ug.usuario = u.usuario
                                   and pck_util_fav.fnc_verificagrupoatendimento(ug.idgrupoatendimento, :P0_IDUSUARIO) = 'S' )]';
                      when 'T' then
                        null;
                      else
                        v_sql := v_sql || chr(10) || '   and 1 = 0';
                    end case;
                
                  end if;
                  --
                  if v_acesso28707 is null or v_acesso28707 = 'N' then
                    v_sql := v_sql || chr(10) || q'[   and exists ( select 1
                                  from favorita.atendimentosfiliaisrmc ate
                                 where ate.idfilialdestino        = p.idfilial
                                   and ate.idfilialfavoritaorigem = ( select favorita.pck_util_fav.fnc_retornaidfilialfavusuario(:P0_IDUSUARIO) from dual ) )]';
                  end if;
                  --
                  if v_acesso28707 not in ('S', 'N') then
                    v_sql := v_sql || chr(10) || '   and 1 = 0';
                  end if;
                  --
                  v_sql := v_sql || chr(10) || ' order by 1 desc';
                
                  insert into favorita.testeclob (testeid, testeclob)
                        values (300,v_sql);
                  --
                  return v_sql;
                
                end;
                ```
            pageItemsToSubmit: P582_TIPOPROTOCOLO
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
