page 56 (
    name: Cadastro de Atendimentos Filiais Romance
    title: Atendimentos Filiais Romance
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region atendimentos-filiais-romance (
        name: Atendimentos Filiais Romance
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idatendimentoestoquermc
                     , idfilialfavoritaorigem
                     , idfilialdestino
                     , principal
                from atendimentosfiliaisrmc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        messages {
            whenNoDataFound: Não encontrou informações.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 3329846929248347
        }

        savedReport 365168 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDATENDIMENTOESTOQUERMC
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDFILIALFAVORITAORIGEM
                layout {
                    show: false
                    sequence: 3
                }
            )

            displayColumn (
                column: @IDFILIALDESTINO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @PRINCIPAL
                layout {
                    sequence: 4
                }
            )

            controlBreak (
                column: @IDFILIALFAVORITAORIGEM
                sort {
                    nulls: last
                }
                layout {
                    sequence: 5
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column IDATENDIMENTOESTOQUERMC (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDATENDIMENTOESTOQUERMC
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: seq_idatendimentoestoquermc
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDFILIALDESTINO (
            type: selectList
            heading {
                heading: Filiais Romance Destino
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @lov-filiaisromance
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDFILIALDESTINO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDFILIALFAVORITAORIGEM (
            type: selectList
            heading {
                heading: Filiais Favorita Origem
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) as d,
                           idfilialfavorita as r
                      from filiaisfavorita f
                    where exists ( select 1
                                   from usuariosfiliaisfavorita u
                                      , usuarios uu
                                   where u.idfilialfavorita = f.idfilialfavorita
                                     and u.consultar        = 'S' 
                                     and u.idusuario        = u.idusuario
                                     and uu.usuario         = v('APP_USER') )
                     order by 1
                    ```
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDFILIALFAVORITAORIGEM
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column PRINCIPAL (
            type: selectList
            heading {
                heading: Principal
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC:Sim;S,Não;N
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                databaseColumn: PRINCIPAL
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

    )

    region informação (
        name: Informação:
        type: staticContent
        source {
            htmlCode: Para inserir um novo registro, remova o agrupamento por "Filial Favorita Origem", realize o cadastro e, em seguida, adicione novamente o agrupamento.
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    validation filialorigemdestino-unique (
        name: FILIALORIGEMDESTINO unique
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @atendimentos-filiais-romance
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidfilialfavoritaorigem number;
                  vidfilialdestino number;
                  vprincipal varchar2(10);
                begin
                  select idfilialfavoritaorigem
                       , idfilialdestino
                       , principal
                  into vidfilialfavoritaorigem
                     , vidfilialdestino
                     , vprincipal
                  from atendimentosfiliaisrmc
                  where idfilialfavoritaorigem = :IDFILIALFAVORITAORIGEM
                  and idfilialdestino = :IDFILIALDESTINO;
                  --
                  if vidfilialfavoritaorigem is not null and vidfilialdestino is not null then
                    return 'Existe um cadastro no sistema com estas informações. Não são permitidas informações repetidas para este cadastro.';
                  end if;
                  --
                exception
                  when no_data_found then
                    return '';
                end;
                ```
        }
        error {
            associatedColumn: IDFILIALDESTINO
        }
        serverSideCondition {
            type: never
        }
    )

    validation idfilialdestino-obrigatório (
        name: IDFILIALDESTINO obrigatório
        execution {
            sequence: 20
        }
        validation {
            editableRegion: @atendimentos-filiais-romance
            type: columnIsNotNull
            column: IDFILIALDESTINO
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ter um valor.
            associatedColumn: IDFILIALDESTINO
        }
    )

    validation idfilialfavoritaorigem-obrigatório (
        name: IDFILIALFAVORITAORIGEM obrigatório
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @atendimentos-filiais-romance
            type: columnIsNotNull
            column: IDFILIALFAVORITAORIGEM
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ter um valor.
            associatedColumn: IDFILIALFAVORITAORIGEM
        }
    )

    process save-interactive-grid-data (
        name: " - Save Interactive Grid Data"
        type: interactiveGridAutoRowProcessing
        editableRegion: @atendimentos-filiais-romance
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 3333422785248349
        }
    )

)

