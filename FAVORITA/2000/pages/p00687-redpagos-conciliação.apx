    region legend (
        name: Legend
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="rp-legenda">
                
                  <div class="rp-legenda-card rp-legenda-card--danger">
                    <span class="rp-legenda-badge">CONCILIACAO_SEM_BAIXA</span>
                    <p class="rp-legenda-title">Cobrança sem baixa no sistema</p>
                    <p class="rp-legenda-desc">
                      Redpagos enviou no lote informando que cobrou o cliente,
                      mas o boleto <strong>não consta como quitado</strong> no sistema.
                      Requer investigação imediata.
                    </p>
                  </div>
                
                  <div class="rp-legenda-card rp-legenda-card--warning">
                    <span class="rp-legenda-badge">BAIXA_SEM_CONCILIACAO</span>
                    <p class="rp-legenda-title">Baixa sem registro na conciliação</p>
                    <p class="rp-legenda-desc">
                      Sistema registrou confirmação de pagamento aplicada,
                      mas <strong>nenhum item correspondente</strong> foi recebido
                      no lote de conciliação da Redpagos.
                    </p>
                  </div>
                
                  <div class="rp-legenda-card rp-legenda-card--info">
                    <span class="rp-legenda-badge">DIVERGENCIA_VALOR</span>
                    <p class="rp-legenda-title">Divergência de valor</p>
                    <p class="rp-legenda-desc">
                      Pagamento encontrado nos dois lados, porém o
                      <strong>valor cobrado pela Redpagos difere</strong>
                      do valor registrado no sistema.
                    </p>
                  </div>
                
                </div>
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region log-redpago (
        name: Log - Redpago
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select *
                  from vw_redpago_divergencias l
                 where (:P687_DOCUMENTO is null 
                        or l.documento = :P687_DOCUMENTO)
                   and (:P687_DATA_INICIAL is null 
                        or (   trunc(l.data_referencia) between :P687_DATA_INICIAL and :P687_DATA_FINAL
                           or  trunc(l.dt_recebimento) between :P687_DATA_INICIAL and :P687_DATA_FINAL
                           )
                      )
                
                ```
        }
        layout {
            sequence: 100
            slot: body
            rowCssClasses: #RESP_STATUS#
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
