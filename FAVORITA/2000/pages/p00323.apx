page 323 (
    name: Relatório Reduzido Fiscal
    title: Relatório Reduzido Fiscal
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 80%
        height: 80%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region relatório-reduzido-fiscal (
        name: Relatório Reduzido Fiscal
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select referencia
                         from produtos p
                         where p.idproduto = e.idproduto ) referencia
                     ,  nvl(( select dp.skuvirtualage
                         from deparaprodfavoritavirtualage dp
                         where dp.idprodutodetalhado = e.idprodutodetalhado ), (6000000 + idprodutodetalhado)) reduzido
                     , ( select p.nomeproduto
                         from produtos p
                         where p.idproduto = e.idproduto ) descricao
                     , quantidade
                     , quantidadereservada
                     , quantidade  - quantidadereservada quantidadedisponivel
                from vw_estoques_fav e
                where ididioma = 1
                  and idfilialfavorita = :P323_IDFILIALFAVORITA
                order by reduzido
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
            startNewRow: false
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado.
        }
        download {
            filename: reduzido
        }
        advanced {
            savedReportMappingIdentifier: 4519821691272517768
        }

        column DESCRICAO (
            type: plainText
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column QUANTIDADE (
            type: plainText
            heading {
                heading: Quantidade Fisico
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column QUANTIDADEDISPONIVEL (
            type: plainText
            heading {
                heading: Quantidade Disponivel
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column QUANTIDADERESERVADA (
            type: plainText
            heading {
                heading: Quantidade Reservado
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column REDUZIDO (
            type: plainText
            heading {
                heading: Reduzido
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column REFERENCIA (
            type: plainText
            heading {
                heading: Referência
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 14170871 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DESCRICAO (
                sequence: 3
            )

            displayColumn QUANTIDADE (
                sequence: 4
            )

            displayColumn QUANTIDADEDISPONIVEL (
                sequence: 6
            )

            displayColumn QUANTIDADERESERVADA (
                sequence: 5
            )

            displayColumn REDUZIDO (
                sequence: 2
            )

            displayColumn REFERENCIA (
                sequence: 1
            )

        )

    )

    pageItem P323_IDFILIALFAVORITA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @relatório-reduzido-fiscal
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

