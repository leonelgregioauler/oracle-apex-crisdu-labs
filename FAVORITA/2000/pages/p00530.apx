page 530 (
    name: Brindes Promocao Lojas
    title: Brindes Promocao Lojas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region brindes-promocao-lojas (
        name: Brindes Promocao Lojas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idrepresentante, representante
                     , datarecebido
                     , idusuario
                     , qtdPed
                     , brinde
                     , idsemanaemissao
                     , filialromance
                     , case when datarecebido is null then 'N'
                            else
                              'S'
                        end recebido
                     --
                     , case when datarecebido is NOT null then 'N'
                            else
                              'S'
                        end a_receber
                  from ( 
                        select p.idrepresentante,  p.representante, p.idsemanaemissao
                             , max(b.datarecebido) datarecebido
                             , max(b.idusuario)  idusuario
                             , count(distinct p.idvendedora) qtdPed
                             , null Brinde
                             , p.filialromance
                          from vw_pedidos_fav  p
                             , filiaisfavorita f
                             , brindesrepresentantes b
                         where p.idsemanaemissao = :P530_IDSEMANA  --827
                           and (:P530_IDDISTRIBUIDOR is null or p.idrepresentante = :P530_IDDISTRIBUIDOR) -- 50367
                           and p.idfilialfavorita = f.idfilialfavorita
                           and ( p.idfilialromance = :P530_IDFILIALROMANCE or :P530_IDFILIALROMANCE is null)
                           and ( p.idfilialfavorita = :P530_IDFILIALFAVORITA or :P530_IDFILIALFAVORITA is null)
                           and f.tipofilial = 'L'
                           and p.tipopedido not in ('T')
                           and p.valorpago >= p.valorapagar
                           and p.idrepresentante = b.idrepresentante(+)
                           and p.idsemanaemissao = b.idsemana(+)
                           group by p.idrepresentante,  p.representante, p.idsemanaemissao, filialromance
                         having count(distinct p.idvendedora) >= (select nvl(valor,1) from parametros where nome = 'QTDCONSULTORASPROMO')
                         )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 22333772047373307
        }

        column A_RECEBER (
            type: hidden
            heading {
                heading: A Receber
            }
            layout {
                sequence: 100
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: L
            }
            security {
                escapeSpecialChars: false
            }
        )

        column BRINDE (
            type: link
            heading {
                heading: Brinde
            }
            layout {
                sequence: 70
            }
            link {
                target: {
                    page: 531
                    items: {
                        P531_CONFIRMA: #A_RECEBER#
                        P531_IDREPRESENTANTE: #IDREPRESENTANTE#
                        P531_IDSEMANA: #IDSEMANAEMISSAO#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        column DATARECEBIDO (
            type: plainText
            heading {
                heading: Data Recebido
            }
            layout {
                sequence: 50
            }
            appearance {
                formatMask: DD/MM/YYYY HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: E
            }
        )

        column FILIALROMANCE (
            type: plainText
            heading {
                heading: Filial Romance
                alignment: center
            }
            layout {
                sequence: 110
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: N
            }
        )

        column IDREPRESENTANTE (
            type: hidden
            heading {
                heading: Idrepresentante
            }
            layout {
                sequence: 10
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDSEMANAEMISSAO (
            type: hidden
            heading {
                heading: Idsemanaemissao
            }
            layout {
                sequence: 90
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: K
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDUSUARIO (
            type: plainTextBasedOnLov
            heading {
                heading: Usuário
            }
            lov {
                lov: @lov-usuarios
            }
            layout {
                sequence: 60
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column QTDPED (
            type: plainText
            heading {
                heading: Qtde Pedidos
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column RECEBIDO (
            type: plainText
            heading {
                heading: Recebido
            }
            layout {
                sequence: 80
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: J
            }
        )

        column REPRESENTANTE (
            type: plainText
            heading {
                heading: Representante
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 223542 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn BRINDE (
                sequence: 3
            )

            displayColumn DATARECEBIDO (
                sequence: 5
            )

            displayColumn FILIALROMANCE (
                sequence: 6
            )

            displayColumn QTDPED (
                sequence: 2
            )

            displayColumn RECEBIDO (
                sequence: 4
            )

            displayColumn REPRESENTANTE (
                sequence: 1
            )

            sort (
                column: QTDPED
                sort {
                    direction: desc
                    sequence: 1
                }
            )

        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 30
            slot: body
            startNewRow: false
            column: 11
            columnSpan: 2
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    region valor-do-brinde (
        name: Valor do Brinde
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P530_FILTRO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
        }
        default {
            type: static
            staticValue: 0
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P530_IDDISTRIBUIDOR (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(r.idrepresentante)
                                 ||' - '||p.cpf 
                                 ||' - '|| roman.pck_romance.fnc_nomefilial(roman.pck_romance.fnc_filialgerente(r.idgerente)) display_value
                     , r.idrepresentante return_value
                from catal.representantes r
                   , catal.pessoas p
                   , catal.gerentes g
                where p.idpessoa = r.idpessoa
                  and r.idgerente = g.idgerente
                  and g.idfilial = :P530_IDFILIALROMANCE
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: " - Todos -"
        }
        cascadingLov {
            parentItems: P530_IDFILIALROMANCE
            itemsToSubmit: P530_IDDISTRIBUIDOR
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P530_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Filial Favorita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nomefilialfavorita showvalue
                     , f.idfilialfavorita  returnvalue
                from favorita.filiaisfavorita f
                where f.tipofilial = 'L';
                ```
            displayExtraValues: false
            nullDisplayValue: " - Todos -"
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P530_IDFILIALROMANCE (
        type: selectList
        label {
            label: Filial Romance
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-filiaisromance
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P530_IDSEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select semanacompleta d
                     , idsemana r
                  from semana_dias s
                  where idsemana >= (select idsemana-10 from semana_dias where trunc(sysdate) between dt_ini and dt_fim )
                   or idsemana = 827 -- somente durante testes
                  order by 2
                  
                ```
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P530_VALORBRINDE (
        type: textField
        label {
            label: Valor do Brinde
            alignment: left
        }
        layout {
            sequence: 10
            region: @valor-do-brinde
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select p.valor
                from favorita.parametros p
                where p.nome = 'VLRCONSULTORASPROMO';
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction filtrar (
        name: Filtrar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action native-set-value (
            action: setValue
            settings {
                value: 1
            }
            affectedElements {
                selectionType: items
                items: P530_FILTRO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @brindes-promocao-lojas
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @brindes-promocao-lojas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

