    region balanço-de-catálogos (
        name: Balanço de Catálogos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(t.idrepresentante) distribuidor
                     , sum(t.qtdrecebido) qtdrecebido
                     , sum(t.qtddistribuido) qtddistribuido
                     , sum(t.qtdrecebido - qtddistribuido) saldo
                from (
                       select r.idrepresentante
                            , nvl( ( select sum(( nvl(qtd_dist_pp ,0)
                                            + nvl(qtd_dist_p ,0)
                                            + nvl(qtd_dist_m ,0)
                                            + nvl(qtd_dist_g ,0)
                                            + nvl(qtd_dist_gg,0)
                                            + nvl(qtd_dist_egg,0)
                                            + nvl(qtd_dist_exgg,0)
                                            + nvl(qtd_dist_u,0) ))
                                     from roman.itenscargarepresentante ic
                                     where ic.idestoquefil = :P428_IDESTOQUEFIL
                                       and exists ( select 1
                                                    from roman.cargasrepresentantes c
                                                    where c.idcargarepresentante = ic.idcargarepresentante
                                                      and c.idrepresentante      = r.idrepresentante
                                                      and c.situacao             = 3 -- concluida
                                                      and c.idsemana             = s.idsemana ) )  ,0) qtdrecebido
                             , nvl( ( select sum(it.quantidade)
                                      from roman.itensnotavenda it
                                      where it.idestoquefil = :P428_IDESTOQUEFIL
                                        and exists ( select 1
                                                     from roman.notasvendas nv
                                                     where nv.idnotavenda          = it.idnotavenda
                                                       and nv.idsemanadistribuicao = s.idsemana
                                                       and nv.idsituacaonotavenda  in (3,4)
                                                       and nv.idrepresentante      = r.idrepresentante ) ) ,0) qtddistribuido
                       from semana_dias s
                          , representantes r
                       where r.idgerente = ( select idgerente
                                             from gerentes g
                                             where g.idfilial = :P428_IDFILIALROMANCE )
                         and s.idsemana between :P428_IDSEMANA_INI and :P428_IDSEMANA_FIM 
                         and ( :P428_IDREPRESENTANTE is null or r.idrepresentante = :P428_IDREPRESENTANTE )
                         and :P428_IDESTOQUEFIL is not null
                         and :P428_TIPO_PESQUISA = 'E' ) t
                group by idrepresentante
                order by 1
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P428_TIPO_PESQUISA
            value: E
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado! Verifique os filtros!
        }
        advanced {
            savedReportMappingIdentifier: 5938622690829431
        }

        column DISTRIBUIDOR (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column QTDDISTRIBUIDO (
            type: plainText
            heading {
                heading: Qtd Distribuido
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        column QTDRECEBIDO (
            type: plainText
            heading {
                heading: Qtd Recebido
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column SALDO (
            type: plainText
            heading {
                heading: Saldo
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 59831 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100000
            }

            displayColumn DISTRIBUIDOR (
                sequence: 1
            )

            displayColumn QTDDISTRIBUIDO (
                sequence: 3
            )

            displayColumn QTDRECEBIDO (
                sequence: 2
            )

            displayColumn SALDO (
                sequence: 4
            )

            aggregate (
                column: QTDRECEBIDO
            )

            aggregate (
                column: QTDDISTRIBUIDO
            )

            aggregate (
                column: SALDO
            )

        )

    )

    region balanço-de-catálogos-geral (
        name: Balanço de Catálogos Geral
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(t.idfilial) empresa
                     , nvl( ( select sum( nvl(itf.qtd_pp_chegou,0)
                                        + nvl(itf.qtd_p_chegou,0)
                                        + nvl(itf.qtd_m_chegou,0)
                                        + nvl(itf.qtd_g_chegou,0)
                                        + nvl(itf.qtd_gg_chegou,0)
                                        + nvl(itf.qtd_egg_chegou,0)
                                        + nvl(itf.qtd_exgg_chegou,0)
                                        + nvl(itf.qtd_u_chegou,0) )
                              from roman.itemnf itf
                              where itf.idproduto = :P428_IDPRODUTO
                                and exists ( select 1
                                             from roman.notasfiscais nf
                                             where nf.idnotafiscal = itf.idnotafiscal
                                               and nf.situacaofilial = 'R'
                                               and nf.idfilialdestino = t.idfilial ) ), 0) qtdcomprado
                     , sum(t.qtdrecebido) qtdrecebido
                     , sum(t.qtddistribuido) qtddistribuido
                     , sum(t.qtdrecebido - qtddistribuido) saldo
                     , '|' s1
                from (
                       select e.idfilial
                            , nvl( ( select sum(( nvl(qtd_dist_pp ,0)
                                            + nvl(qtd_dist_p ,0)
                                            + nvl(qtd_dist_m ,0)
                                            + nvl(qtd_dist_g ,0)
                                            + nvl(qtd_dist_gg,0)
                                            + nvl(qtd_dist_egg,0)
                                            + nvl(qtd_dist_exgg,0)
                                            + nvl(qtd_dist_u,0) ))
                                     from roman.itenscargarepresentante ic
                                     where ic.idestoquefil = e.idestoquefilial
                                       and exists ( select 1
                                                    from roman.cargasrepresentantes c
                                                    where c.idcargarepresentante = ic.idcargarepresentante
                                                      and c.idfilial             = e.idfilial
                                                      and c.situacao             = 3 -- concluida
                                                      and c.idsemana             = s.idsemana ) ) ,0) qtdrecebido
                             , nvl( ( select sum(it.quantidade)
                                      from roman.itensnotavenda it
                                      where it.idestoquefil = e.idestoquefilial
                                        and exists ( select 1
                                                     from roman.notasvendas nv
                                                     where nv.idnotavenda          = it.idnotavenda
                                                       and nv.idsemanadistribuicao = s.idsemana
                                                       and nv.idsituacaonotavenda  in (3,4)
                                                       and nv.idfilial             = e.idfilial) ) ,0) qtddistribuido
                       from semana_dias s
                          , roman.estoquefilial e
                       where s.idsemana between :P428_IDSEMANA_INI and :P428_IDSEMANA_FIM
                         and e.idproduto = :P428_IDPRODUTO
                         and exists ( select 1
                                      from roman.vw_filiais f
                                      where f.ativo = 'S'
                                        and f.tipofilial = 'D'
                                        and f.idgrupo != 5
                                        and f.idfilial = e.idfilial )
                         and :P428_TIPO_PESQUISA = 'G' ) t
                group by idfilial
                order by 1
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P428_TIPO_PESQUISA
            value: G
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 5939104091829436
