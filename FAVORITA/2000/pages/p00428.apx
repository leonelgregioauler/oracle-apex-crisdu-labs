    pageItem P428_IDESTOQUEFIL (
        type: selectList
        label {
            label: Catálogo
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomeproduto(e.idproduto) d
                     , e.idestoquefilial r
                from roman.estoquefilial e
                where e.idfilial = :P428_IDFILIALROMANCE
                  and exists ( select 1
                               from roman.produtos p
                               where p.idproduto   = e.idproduto
                                 and p.idcategoria = 142 )
                order by e.idestoquefilial
                ```
            nullDisplayValue: - Selecione o Catálogo -
        }
        cascadingLov {
            parentItems: P428_IDFILIALROMANCE
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P428_IDFILIALROMANCE (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idfilial
                from roman.vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                  and f.idgrupo != 5
                  and exists ( select 1
                               from roman.notasvendas nv
                               where nv.idfilial = f.idfilial )
                ```
            nullDisplayValue: - Selecione a Empresa -
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P428_IDPRODUTO (
        type: selectList
        label {
            label: Catálogo
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.codigosisdist||' - '||p.nomeproduto d
                     , p.idproduto r
                from roman.produtos p
                where p.idcategoria = 142
                  and p.ativo       = 'S'
                ```
            nullDisplayValue: - Selecione o Catálogo -
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P428_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(r.idrepresentante)||' ('||decode(ativo,'S','Ativo','N','Inativo')||')' d
                     , idrepresentante r
                from representantes r
                where r.idgerente = ( select idgerente
                                      from gerentes g
                                      where g.idfilial = :P428_IDFILIAL )
                order by 1;
                ```
            nullDisplayValue: - Todos -
        }
        cascadingLov {
            parentItems: P428_IDFILIALROMANCE
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P428_IDSEMANA_FIM (
        type: selectList
        label {
            label: Até
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(s.semana,'00')||'/'||s.ano d
                     , idsemana r
                from semana_dias s
                where idsemana between pck_util.fnc_idsemanadata(sysdate)-30 and pck_util.fnc_idsemanadata(sysdate)
                order by s.idsemana desc
                ```
            nullDisplayValue: - Selecione a Semana -
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

