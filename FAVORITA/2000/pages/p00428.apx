                selectionType: items
                items: P428_IDPRODUTO
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 428
                items: {
                    P428_IDSEMANA_INI: &P428_IDSEMANA_INI.
                    P428_IDSEMANA_FIM: &P428_IDSEMANA_FIM.
                    P428_TIPO_PESQUISA: &P428_TIPO_PESQUISA.
                    P428_IDFILIALROMANCE: &P428_IDFILIALROMANCE.
                    P428_IDREPRESENTANTE: &P428_IDREPRESENTANTE.
                    P428_IDESTOQUEFIL: &P428_IDESTOQUEFIL.
                    P428_IDPRODUTO: &P428_IDPRODUTO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

