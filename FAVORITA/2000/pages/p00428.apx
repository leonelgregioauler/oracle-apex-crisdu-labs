    dynamicAction tipo-de-pesquisa (
        name: Tipo de Pesquisa
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P428_TIPO_PESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P428_TIPO_PESQUISA
            value: E
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P428_IDFILIALROMANCE
                    P428_IDESTOQUEFIL
                    P428_IDREPRESENTANTE
                ]
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P428_IDPRODUTO
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P428_IDFILIALROMANCE
                    P428_IDESTOQUEFIL
                    P428_IDREPRESENTANTE
                ]
            }
