page 620 (
    name: Relatório de Tabela Preço Delivery
    title: Tabela Preço Delivery
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region span-style-color-white-tabela-preço-delivery-span (
        name: <span style="color: white;">Tabela Preço Delivery</span>
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idtabelaprecosdelivery,
                       t.idfilialfavorita,
                       initcap(lower(t.nome)) nome,
                       'R$ ' || to_char(t.valor,'FM999G999G999D90') valor,
                       t.ativo,
                       to_char(t.datacadastro,'DD/MM/RRRR') datacadastro,
                       to_char(t.datainativacao,'DD/MM/RRRR') datainativacao,
                       pck_util_fav.fnc_nomefilialfavorita(t.idfilialfavorita ) filialfavorita
                  from favorita.tabelaprecosdelivery t 
                 where (:P620_FILIALFAVORITA = -1 or t.idfilialfavorita = :P620_FILIALFAVORITA)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 2119206166330747505
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @VALOR
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @ATIVO
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @IDTABELAPRECOSDELIVERY
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDFILIALFAVORITA
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @DATACADASTRO
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @DATAINATIVACAO
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @NOME
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @FILIALFAVORITA
                layout {
                    sequence: 1
                }
            )

        )

        column ATIVO (
            type: selectList
            heading {
                heading: Ativo
            }
            lov {
                type: staticValues
                staticValues: STATIC:Sim;S,Não;N
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ATIVO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column DATACADASTRO (
            type: displayOnly
            heading {
                heading: Data Cadastro
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: DATACADASTRO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column DATAINATIVACAO (
            type: displayOnly
            heading {
                heading: Data Inativação
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: DATAINATIVACAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column FILIALFAVORITA (
            type: textarea
            heading {
                heading: Filial Favorita
            }
            layout {
                sequence: 90
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: FILIALFAVORITA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column IDFILIALFAVORITA (
            type: hidden
            layout {
                sequence: 50
            }
            source {
                databaseColumn: IDFILIALFAVORITA
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDTABELAPRECOSDELIVERY (
            type: link
            heading {
                heading: Editar
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            accessibility {
                valueIdentifiesRow: true
            }
            link {
                target: {
                    page: 621
                    items: {
                        P621_IDTABELAPRECOSDELIVERY: &IDTABELAPRECOSDELIVERY.
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                databaseColumn: IDTABELAPRECOSDELIVERY
                dataType: number
                queryOnly: true
                primaryKey: true
            }
        )

        column NOME (
            type: textarea
            heading {
                heading: Nome
            }
            layout {
                sequence: 80
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: NOME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column VALOR (
            type: numberField
            heading {
                heading: Valor
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            validation {
                maxLength: 18
            }
            source {
                databaseColumn: VALOR
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
        )

    )

    pageItem P620_FILIALFAVORITA (
        type: selectList
        label {
            label: Filial Favorita
            alignment: left
        }
        settings {
            pageActionOnSelection: submitPage
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nomefilialfavorita as display_value,
                       f.idfilialfavorita   as return_value
                  from favorita.filiaisfavorita f
                 where f.tipofilial = 'L'
                   and f.ativo = 'S'
                   and ( exists (select *
                                   from roman.aplicacoes ap
                                      , roman.acessos ac
                                  where ap.descricao = 'ADM Tabela de Preços Delivery'
                                    and ac.idaplicacao = ap.idaplicacao
                                    and ac.ativo = 'S'
                                    and ac.usuario = v('APP_USER')) or :P0_IDFILIALFAVORITA = f.idfilialfavorita)
                
                union all
                
                select '- Todas -' as display_value,
                       -1          as return_value
                  from dual
                 where exists (select *
                                 from roman.aplicacoes ap
                                    , roman.acessos ac
                                where ap.descricao = 'ADM Tabela de Preços Delivery'
                                  and ac.idaplicacao = ap.idaplicacao
                                  and ac.ativo = 'S'
                                  and ac.usuario = v('APP_USER'))
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-filter
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 621
                items: {
                    P621_ATIVO: S
                    P621_FILIALFAVORITA: &P620_FILIALFAVORITA.
                    P621_NOME:
                    P621_VALOR:
                    P621_IDTABELAPRECOSDELIVERY:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item!=value
            item: P620_FILIALFAVORITA
            value: -1
        }
    )

)

