    validation nota-fiscal-não-selecionada-grava-pedido-selecionado (
        name: Nota Fiscal Não Selecionada/Grava Pedido Selecionado
        execution {
            sequence: 10
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                begin
                    -- Verifica se existe ao menos uma nota selecionada
                    if APEX_APPLICATION.G_F02.COUNT > 0 then 
                        return true;
                    else
                        return false;
                    end if;
                end;
                ```
        }
        error {
            errorMessage: Atenção: selecione ao menos uma nota na grade para continuar com a impressão.
        }
        serverSideCondition {
            whenButtonPressed: @imprimir
        }
    )

    process imprimir-grava-pedidos-selecionados-para-imprimir (
        name: (IMPRIMIR) Grava Pedidos Selecionados Para Imprimir
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                    -- Remove todos os pedidos da lista de impressão do usuário atual
                    delete from favorita.pedidos_selecionados_p584 where usuario = v('APP_USER');
                    
                    -- Insere os pedidos selecionados na tabela auxiliar para posterior impressão (página 2000.618)
                	for i IN 1..APEX_APPLICATION.G_F02.COUNT loop
                		-- Grava na tabela auxiliar os pedidos para depois imprimir na página 2000.618
                		insert into favorita.pedidos_selecionados_p584 values(APEX_APPLICATION.G_F02(i),v('APP_USER'));
                
                	end loop;
                
                    -- Confirma as alterações
                    commit;
                
                -- Tratamento de erro para captura de exceções na rotina
                -- Em caso de erro, exibe mensagem amigável e o código do erro
                exception
                    when others then
                        apex_error.add_error(
                            p_message => 'Ops! Ocorreu um erro no processo Grava Pedidos Selecionados Para Imprimir. Erro: ' || SQLERRM || ' - Código: ' || SQLCODE,
                            p_display_location => apex_error.c_inline_in_notification
                        );
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1073807574194132416
        }
        serverSideCondition {
            whenButtonPressed: @imprimir
        }
    )

    branch (
        name: GoTo 618
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 618
            }
        }
        serverSideCondition {
            whenButtonPressed: @imprimir
        }
    )

)

