    region imprime-direto-remessa-de-pedido-saldo (
        name: Imprime Direto Remessa de Pedido Saldo 60
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                    -- variáveis de controle 
                    l_mime_type        varchar2(100);
                    l_filename         varchar2(255);
                    l_blob             blob;
                    v_chave_nfe        varchar2(100);
                    v_numero_nfe       number;
                    v_emp_virtualAge   number;
                    
                begin
                    -- Seta a variável que controla a região aviso nota não encontrada
                    :P584_MOSTRA_AVISO := 'N';
                
                   begin
                        select a.invoice_code, a.access_key
                          into v_numero_nfe, v_chave_nfe
                          from favorita.tb_invoices_api a
                         where a.orderid_so = :P74_IDCOMPRATRANSFERENCIA
                           and rownum = 1;
                    exception
                        when others then
                            -- #1.1 - chave ainda não disponivel, então busca a empresa virtualAGE
                            select ff.idempresavirtualage
                              into v_emp_virtualAge
                              from favorita.filiaisfavorita ff
                             where ff.idfilialfavorita = :P74_IDFILIALFAVORITAORIGEM;
                
                            -- #1.2 - Chama a rotina criada pelo Gui(gerente), para guardar a chave nfe
                            favorita.pck_integracaogeral_fav.prc_buscatransferencias_va(pidempresava => v_emp_virtualAge,
                                                                                        pdatabase => trunc(sysdate));
                
                            -- #1.3 - Tenta pela 2ª vez: verifica se a chave da nota fiscal já está disponível
                            select a.invoice_code, a.access_key
                              into v_numero_nfe, v_chave_nfe
                              from favorita.tb_invoices_api a
                             where a.orderid_so = :P74_IDCOMPRATRANSFERENCIA;
                    end;
                
                    -- #2 - Busca o PDF da danf da nota fiscal na tabela dos pdfs.    
                    begin
                        select 'application/pdf',
                               'danfe.pdf',
                               a.attach_data
                          into l_mime_type,
                               l_filename,
                               l_blob
                          from favorita.tb_invoices_api_danf_pdf a
                         where a.access_key = v_chave_nfe
                           and a.status_erro is null
                           and rownum = 1;
                    exception
                        when others then
                            
                            -- #2.1 - tem a chave mas ainda não fez dowload do PDF da nota
                            begin
                                -- Chama a pck para baixar o PDF para a tabela favorita.tb_invoices_api_danf_pdf
                                favorita.pck_integracaogeral_fav.prc_busca_pdf_nota_fiscal_va(v_chave_nfe);
                
                                select 'application/pdf',
                                       'danfe.pdf',
                                       a.attach_data
                                  into l_mime_type,
                                       l_filename,
                                       l_blob
                                  from favorita.tb_invoices_api_danf_pdf a
                                 where a.access_key = v_chave_nfe
                                   and a.status_erro is null
                                   and rownum = 1;
                            exception
                                when others then
                                    return;
                            end;
                    end;
                    
                    -- #4 - imprime o arquivo blob
                    sys.htp.init;
                    owa_util.mime_header(l_mime_type, false);
                    htp.p('Content-Length: ' || dbms_lob.getlength(l_blob));
                    htp.p('Content-Disposition: inline; filename="' || l_filename || '"');
                    owa_util.http_header_close;
                    wpg_docload.download_file(l_blob);
                    apex_application.stop_apex_engine;
                
                -- tratamento de erros
                exception
                    when others then
                        -- Se deu erro, é por que não encontrou a nota então Seta a variável que controla a região aviso nota não encontrada
                        :P584_MOSTRA_AVISO := 'S';
                        --:P584_MSG1 := 'Nota fiscal não localizada na base de dados!';
                        --:P584_MSG2 := 'Será necessário fazer o reprocessamento do envio da nota pelo VA.';
                end;
                ```
        }
        layout {
            sequence: 40
            slot: contentBody
        }
        headerAndFooter {
            headerText:
                ```html
                <div style="font-family: Arial, sans-serif; font-size: 20px; color: #81bb5f; text-align: center; padding: 10px; border: 1px solid #81bb5f; background-color: #f5fbf1;">
                  <br>
                  <strong>Atenção!</strong>
                  <br><br>
                  Ocorreu um erro ao imprimir o pdf da nota fiscal de remessa tipo saldo 60.
                  <br><br><br>
                </div>
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                -- aqui verifica se é remessa saldo 60
                select 1 
                  from dual
                 where favorita.pck_util_fav.fnc_identifica_remessa_saldo_60(:P584_IDCOMPRATRANSFERENCIA) = 'SALDO_60';
                ```
        }
    )

    region lista-de-impressao (
        name: LISTA_DE_IMPRESSAO
        title: Pedido(s) para impressão
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- P584_IMPRESSAO_POR: 1 (Maior Nota Remessa)
                select pr.volume         as valume
                     , pp.idpedido       as id_pedido
                     , pp.numeropedido   as numero_pedido
                     , nf.numero         as numero_nota_fiscal
                     , nf.valortotalnota as valor_total_nota
                     , favorita.pck_util_fav.fnc_nomevendedora(pp.idvendedora)         as nome_consultora
                     , favorita.pck_util_fav.fnc_nomerepresentante(pp.idrepresentante) as nome_distribuidor
                     , apex_item.CHECKBOX2(2,pp.idpedido, null)                        as check_1
                  from favorita.pedidosremessasct pr
                     , favorita.pedidos pp
                     , crisdu.notasfiscais nf
                 where pp.idpedido = pr.idpedido
                   and nf.idpedidofavorita(+) = pp.idpedido
                   and pr.idcompratransferencia = :P584_IDCOMPRATRANSFERENCIA
                       -- P584_IMPRESSAO_POR: 1 (Maior Nota Remessa)
                   and :P584_IMPRESSAO_POR = 1
                       -- busca a maior nota da remessa
                   and nf.idnotafiscal = ( select n.idnotafiscal
                                             from crisdu.notasfiscais n
                                            where n.idpedidofavorita in (select p.idpedido
                                                                           from favorita.pedidosremessasct p
                                                                          where p.idcompratransferencia = :P584_IDCOMPRATRANSFERENCIA)
                                           order by n.valortotalnota desc
                                           fetch first 1 rows only)
                 
                 union
                
                -- P584_IMPRESSAO_POR: 2 (Maior Nota volume)
                select aux.volume
                     , aux.id_pedido
                     , aux.numero_pedido
                     , aux.numero_nota_fiscal
                     , aux.valor_total_nota
                     , aux.nome_consultora
                     , aux.nome_distribuidor
                     , aux.check_1
                  from (  select pr.volume         as volume
                               , pp.idpedido       as id_pedido
                               , pp.numeropedido   as numero_pedido
                               , nf.numero         as numero_nota_fiscal
                               , nf.valortotalnota as valor_total_nota
                               , favorita.pck_util_fav.fnc_nomevendedora(pp.idvendedora)         as nome_consultora
                               , favorita.pck_util_fav.fnc_nomerepresentante(pp.idrepresentante) as nome_distribuidor
                               , apex_item.CHECKBOX2(2,pp.idpedido, null)                        as check_1
                               , row_number() over (partition by pr.volume order by nf.valortotalnota desc nulls last) as rn
                            from favorita.pedidosremessasct pr
                               , favorita.pedidos pp
                               , crisdu.notasfiscais nf
                           where pp.idpedido = pr.idpedido
                             and nf.idpedidofavorita(+) = pp.idpedido
                             and pr.idcompratransferencia = :P584_IDCOMPRATRANSFERENCIA) aux
                 where aux.rn = 1
                       -- P584_IMPRESSAO_POR: 2 (Maior Nota por volume)
                   and :P584_IMPRESSAO_POR = 2
                       -- filtro por um volume ou todos
                   and ( :P584_VOLUME is null or aux.volume = :P584_VOLUME )
                 
                union
                
                -- P584_IMPRESSAO_POR: 3 (Valume)
                select pr.volume         as valume
                     , pp.idpedido       as id_pedido
                     , pp.numeropedido   as numero_pedido
                     , nf.numero         as numero_nota_fiscal
                     , nf.valortotalnota as valor_total_nota
                     , favorita.pck_util_fav.fnc_nomevendedora(pp.idvendedora)         as nome_consultora
                     , favorita.pck_util_fav.fnc_nomerepresentante(pp.idrepresentante) as nome_distribuidor
                     , apex_item.CHECKBOX2(2,pp.idpedido, null)                        as check_1
                  from favorita.pedidosremessasct pr
                     , favorita.pedidos pp
                     , crisdu.notasfiscais nf
                 where pp.idpedido = pr.idpedido
                   and nf.idpedidofavorita(+) = pp.idpedido
                   and pr.idcompratransferencia = :P584_IDCOMPRATRANSFERENCIA
                       -- P584_IMPRESSAO_POR: 3 (Volume)
                   and :P584_IMPRESSAO_POR = 3
                       -- filtra por um volume ou todos
                   and ( :P584_VOLUME is null or pr.volume = :P584_VOLUME)
                
                 order by 1;
                ```
        }
