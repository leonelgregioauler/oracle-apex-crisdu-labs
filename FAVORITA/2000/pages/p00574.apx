        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                exists ( select 1
                         from pagamentospedidos pp
                         where  pp.idvencimentopedido = :P574_IDVENCIMENTOPEDIDO
                           and pp.idformapagamento = 24
                           and pp.idsituacao = 10
                           and pp.idcontroleurl is not null )
                and :P574_IDPAGAMENTOPEDIDO is not null
                ```
        }
    )

    pageItem P574_CHAVEPIX (
        type: textarea
        label {
            label: Chave Pix
            alignment: left
        }
        layout {
            sequence: 30
            region: @válido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
            height: 5
        }
        advanced {
            customAttributes: readonly
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vchavepix varchar2(1000);
                begin
                  --
                  select chavepix
                  into vchavepix
                  from pagamentospedidos pp
                  where pp.idformapagamento = 24
                    and pp.idsituacao = 10
                    and pp.idvencimentopedido = :P574_IDVENCIMENTOPEDIDO
                    and pp.idpagamentopedido = :P574_IDPAGAMENTOPEDIDO;
                  --
                  return vchavepix;
                  --
                exception
                  when others then
                    return 'Chave Pix não encontrada!';
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

