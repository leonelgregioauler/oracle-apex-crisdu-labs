        }
        serverSideCondition {
            whenButtonPressed: @enviar-sms
        }
    )

    process alimenta-valor (
        name: Alimenta Valor
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vvalor number;
                begin
                  --
                  if :P574_TIPO_ACORDO = 'N' then
                    --
                    select round(pck_util_fav.fnc_calculajuros(pidpedido           => v.idpedido,
                                                               pvalororiginal      => (v.valorpagar - v.valorpago),
                                                               pdatavencimentoorig => v.datavencimento,
                                                               pdatavencimentonovo => trunc(sysdate),
                                                               ppercmulta          => 2,
                                                               ppercjuros          => 1),2) valor
                    into vvalor
                    from vencimentospedidos v
                    where v.idvencimentopedido = :P574_IDVENCIMENTOPEDIDO;
                    --
                  elsif :P574_TIPO_ACORDO = 'S' then
                    --
                    select (v.valorpagar - v.valorpago)
                    into vvalor
                    from vencimentospedidos v
                    where v.idvencimentopedido = :P574_IDVENCIMENTOPEDIDO;
                    --
                  end if;
                  --
                  :P574_VALOR_ATUAL := vvalor;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 102430990141581206
        }
    )

    process busca-chave-pix (
        name: Busca Chave PIX
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  vchavepix varchar2(1000);
                  --
                begin
                  --
                  begin
                    --
                    select chavepix
                    into vchavepix
                    from pagamentospedidos pp
                    where pp.idformapagamento = 24
                      and pp.idsituacao = 10
                      and pp.idvencimentopedido = :P574_IDVENCIMENTOPEDIDO
                      and pp.idpagamentopedido = :P574_IDPAGAMENTOPEDIDO;
                    --
                  exception
                    when others then
                      --
                      vchavepix := null; 
                      --
                   end;
                   --
                  :P574_CHAVEPIX := vchavepix;
                  --
                end;
                ```
        }
        execution {
            sequence: 30
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 102432746169581224
        }
    )

    process busca-pagamento-pedido-com-pix (
        name: Busca Pagamento pedido  com PIX
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  vidpagamento number;
                  --
                begin
                  --
                  select max(pp.idpagamentopedido)
                  into vidpagamento
                  from pagamentospedidos pp
                  where pp.idvencimentopedido = :P574_IDVENCIMENTOPEDIDO
                    and pp.idsituacao = 10
                    and pp.idformapagamento = 24
                    and pp.chavepix is not null
                    and pp.idcontroleurl is not null;
                  --
                  :P574_IDPAGAMENTOPEDIDO := vidpagamento;
                  --
                exception
                  when others then
                    :P574_IDPAGAMENTOPEDIDO := null;
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 102433775989581234
        }
    )

