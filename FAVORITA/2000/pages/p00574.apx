    dynamicAction gerar-pix (
        name: Gerar Pix
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @gerar-chave
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      --
                      vidpagamentopedido number;
                      --
                    begin
                      -- Call the procedure
                      pck_pedidos_fav.prc_gerapagamentoviapix(pidvencimentopedido => :P574_IDVENCIMENTOPEDIDO,
                                                              pvalor_atual => :P574_VALOR_ATUAL,
                                                              pidusuario => :P0_IDUSUARIO,
                                                              pidpagamento => vidpagamentopedido);
                      --
                      :P574_IDPAGAMENTOPEDIDO := vidpagamentopedido;
                      --
                    end;
                    
                    ```
                itemsToReturn: P574_IDPAGAMENTOPEDIDO
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: javascript: window.geraChavePix();
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

