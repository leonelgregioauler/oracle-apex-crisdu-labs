page 574 (
    name: Controle PIX Boleto
    title: Controle PIX Boleto
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function geraChavePix_POST() {
                var idPagamento = parseInt(document.getElementById('P574_IDPAGAMENTOPEDIDO').value || 0);
                var valor = parseFloat(document.getElementById('P574_VALOR_ATUAL').value.replace(",", "."));
                
                var json = {
                    idpagamentopedido: idPagamento,
                    valor: valor
                }
            
                console.log(JSON.stringify(json));
            
                fetch("https://debitos.romance.com.br/ws_dev/pix/gerar", {
                    method: "POST",
                    mode: "cors",
                    cache: "no-cache",
                    credentials: "same-origin",
                    headers: {
                        Accept: "application/json",
                        "Content-Type": "application/json; charset=UTF-8",
                    },
                    redirect: "follow",
                    referrerPolicy: "no-referrer",
                    body: JSON.stringify(json)
                }).then(function() {
                    alert("Chamada efetuada com sucesso!")
                    window.location.reload(); 
                });
            };
            
            function geraChavePix() {
                $("#BT_GERARPIX").attr("disabled", true);
                
                var idPagamento = parseInt(document.getElementById('P574_IDPAGAMENTOPEDIDO').value || 0);
                var valor = parseFloat(document.getElementById('P574_VALOR_ATUAL').value.replace(",", "."));
                
                
                fetch("https://debitos.romance.com.br/ws/pix/gerar" + "?idpagamentopedido=" + idPagamento + "&valor=" + valor);
                document.getElementById("P574_IDPAGAMENTOPEDIDO").value = idPagamento;
                
                setTimeout( function(){
                    window.location.reload(); 
                }, 3000);
                
            }
            
            window.geraChavePix = geraChavePix;
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region não-valido (
        name: Não Valido
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <font color = "RED"><h3>
                    Pedido possui boleto na Carteira Nova, não é possível gerar PIX via Integração.
                    </h3> </font>
                ```
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                exists ( select 1
                         from pagamentospedidos pp
                            , controlearquivosbanco ca
                         where ca.idpagamentopedido = pp.idpagamentopedido
                           and pp.idvencimentopedido = :P574_IDVENCIMENTOPEDIDO
                           and pp.idsituacao = 10
                           and nvl(ca.idconveniobanco,0) != 0 )
                ```
        }
    )

    region opção (
        name: Opção
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                exists ( select 1
                             from pagamentospedidos pp
                             where pp.idvencimentopedido = :P574_IDVENCIMENTOPEDIDO
                               and pp.chavepix is null )
                and exists ( select 1
                             from pagamentospedidos pp
                                , controlearquivosbanco ca
                             where ca.idpagamentopedido = pp.idpagamentopedido
                               and pp.idvencimentopedido = :P574_IDVENCIMENTOPEDIDO
                               and nvl(ca.idconveniobanco,0) = 0 )
                and :P574_IDPAGAMENTOPEDIDO is null
                and exists ( select 1
                             from vencimentospedidos vp
                             where vp.idvencimentopedido = :P574_IDVENCIMENTOPEDIDO
                               and vp.valorpago < vp.valorpagar )
                ```
        }
    )

    region pago (
        name: Pago
        type: staticContent
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
