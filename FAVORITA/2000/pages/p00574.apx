            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <font color = "BLUE"><h3>
                    Vencimento liquidado!
                    </h3> </font>
                ```
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                exists ( select 1
                         from vencimentospedidos vp
                         where vp.idvencimentopedido = :P574_IDVENCIMENTOPEDIDO
                           and vp.valorpago >= vp.valorpagar )
                ```
        }
    )

    region válido (
        name: Válido
        type: staticContent
        layout {
            sequence: 50
