page 474 (
    name: Lista de feriados
    title: Lista de feriados
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region report (
        name: Report 1
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.idferiado,
                       f.dataferiado as "Dt Feriado",
                       initcap(f.diasemana) as "Dia Semana",
                       f.descricao as "Descrição"
                from feriados f
                order by f.dataferiado desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 475
                items: {
                    P475_IDFERIADO: #IDFERIADO#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 82188705006746438
        }

        column Descrição (
            type: plainText
            heading {
                heading: Descrição
            }
            layout {
                sequence: 31
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column "Dia Semana" (
            type: plainText
            heading {
                heading: Dia semana
            }
            layout {
                sequence: 21
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column "Dt Feriado" (
            type: plainText
            heading {
                heading: Dt feriado
            }
            layout {
                sequence: 11
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: E
            }
        )

        column IDFERIADO (
            type: plainText
            heading {
                heading: Código
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 821930 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn "Descrição" (
                sequence: 4
            )

            displayColumn "Dia Semana" (
                sequence: 3
            )

            displayColumn "Dt Feriado" (
                sequence: 2
            )

            displayColumn IDFERIADO (
                sequence: 1
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Novo Feriado
        layout {
            sequence: 30
            region: @report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 475
                clearCache: 475
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction create-button-dialog-closed (
        name: Create Button - Dialog Closed
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @report
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

