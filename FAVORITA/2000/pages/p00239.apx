page 239 (
    name: Relatório de Estoques Defeitos
    title: Relatório de Estoques Defeitos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region estoques-de-defeitos (
        name: Estoques de Defeitos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.idestoquedefeito
                     , e.idfilialfavorita
                     , e.filialfavorita
                     , e.idprodutodetalhado
                     , e.descricao defeito
                     , e.produtodetalhado
                     , e.quantidade
                     , decode(e.origemdefeito,'E','Estoque','D','Distribuidor','T','Transportadora','F','Fornecedor') origem
                from vw_estoquesdefeitos_fav e
                where iddefeito not in (8)
                  and (:P239_IDFILIALFAVORITA   is not null or :P239_IDPRODUTODETALHADO is not null)
                  and (:P239_IDFILIALFAVORITA   is null     or idfilialfavorita        = :P239_IDFILIALFAVORITA)
                  and (:P239_IDPRODUTODETALHADO is null     or idprodutodetalhado      = :P239_IDPRODUTODETALHADO)
                  and (:P239_IDDEFEITO          is null     or iddefeito               = :P239_IDDEFEITO)
                  and (:P239_IDPRODUTO          is null     or exists ( select 1
                                                                        from produtosdetalhados p
                                                                        where p.idprodutodetalhado = e.idprodutodetalhado
                                                                          and p.idproduto          = :P239_IDPRODUTO ))
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum Estoque de Defeito encontrado, verifique os filtros!
        }
        advanced {
            savedReportMappingIdentifier: 766875249597274947
        }

        column DEFEITO (
            type: plainText
            heading {
                heading: Defeito
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column FILIALFAVORITA (
            type: plainText
            heading {
                heading: Filial
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column IDESTOQUEDEFEITO (
            type: hidden
            heading {
                heading: Idestoquedefeito
            }
            layout {
                sequence: 10
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDFILIALFAVORITA (
            type: hidden
            heading {
                heading: Idfilialfavorita
            }
            layout {
                sequence: 20
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDPRODUTODETALHADO (
            type: hidden
            heading {
                heading: Idprodutodetalhado
            }
            layout {
                sequence: 40
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
            security {
                escapeSpecialChars: false
            }
        )

        column ORIGEM (
            type: plainText
            heading {
                heading: Origem do Defeito
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column PRODUTODETALHADO (
            type: plainText
            heading {
                heading: Produto Detalhado
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column QUANTIDADE (
            type: plainText
            heading {
                heading: Quantidade
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 7669802 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DEFEITO (
                sequence: 4
            )

            displayColumn FILIALFAVORITA (
                sequence: 1
            )

            displayColumn ORIGEM (
                sequence: 5
            )

            displayColumn PRODUTODETALHADO (
                sequence: 2
            )

            displayColumn QUANTIDADE (
                sequence: 3
            )

        )

    )

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P239_IDDEFEITO (
        type: plugin/select
        label {
            label: Defeito
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select descricao
                     , iddefeito
                from defeitos d
                where aparecer = 'S'
                order by 1 
                ```
        }
        layout {
            sequence: 50
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P239_IDFILIALFAVORITA (
        type: plugin/select
        label {
            label: Filial Favorita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) display_value
                     , idfilialfavorita   return_value
                from filiaisfavorita f
                where  exists ( select 1
                               from usuariosfiliaisfavorita u
                               where u.idfilialfavorita = f.idfilialfavorita
                                 and u.consultar = 'S'
                                 and u.idusuario = :P0_IDUSUARIO )
                order by 1
                ```
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P239_IDPRODUTO (
        type: plugin/select
        label {
            label: "Produto "
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-produtos
        }
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P239_IDPRODUTODETALHADO (
        type: plugin/select
        label {
            label: Produto Detalhado
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-produtosdetalhados
        }
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 60
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-filter
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button movimentar-estoque (
        buttonName: MOVIMENTAR_ESTOQUE
        label: Movimentar Produto
        layout {
            sequence: 70
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-dropbox
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 251
                items: {
                    P251_IDPRODUTODETALHADO: &P239_IDPRODUTODETALHADO.
                    P251_IDFILIALFAVORITA: &P239_IDFILIALFAVORITA.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Filtrar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 239
                items: {
                    P239_IDFILIALFAVORITA: &P239_IDFILIALFAVORITA.
                    P239_IDPRODUTODETALHADO: &P239_IDPRODUTODETALHADO.
                    P239_IDPRODUTO: &P239_IDPRODUTO.
                    P239_IDDEFEITO: &P239_IDDEFEITO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') = 'FILTRAR'
                ```
        }
    )

)

