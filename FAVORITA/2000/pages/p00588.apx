page 588 (
    name: Relatorio de Remessas de Pedidos
    title: Relatorio de Remessas de Pedidos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region report (
        name: Report 1
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select "IDREMESSA", 
                "DESCRICAO",
                "IDUSUARIO",
                "DATAABERTURA",
                "DATAFECHAMENTO",
                "IDFILIALFAVORITA",
                decode(tiporemessa,'D','Diária','Semanal') "TIPOREMESSA",
                "IDUSUARIOFECHAMENTO"
                from "#OWNER#"."REMESSAS" 
                  
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 589
                items: {
                    P589_IDREMESSA: #IDREMESSA#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 565594374220315363
        }

        column DATAABERTURA (
            type: plainText
            heading {
                heading: Abertura
            }
            layout {
                sequence: 4
            }
            appearance {
                formatMask: DD/MM/YYYY HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        column DATAFECHAMENTO (
            type: plainText
            heading {
                heading: Fechamento
            }
            layout {
                sequence: 5
            }
            appearance {
                formatMask: DD/MM/YYYY HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: E
            }
        )

        column DESCRICAO (
            type: plainText
            heading {
                heading: Descrição
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column IDFILIALFAVORITA (
            type: plainTextBasedOnLov
            heading {
                heading: Filial Favorita
            }
            lov {
                lov: @lov-filiaisfavorita
            }
            layout {
                sequence: 6
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column IDREMESSA (
            type: hidden
            heading {
                heading: Idremessa
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDUSUARIO (
            type: plainTextBasedOnLov
            heading {
                heading: Emitente
            }
            lov {
                lov: @lov-usuarios
            }
            layout {
                sequence: 3
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        column IDUSUARIOFECHAMENTO (
            type: plainTextBasedOnLov
            heading {
                heading: Usuario Fechamento
            }
            lov {
                lov: @lov-usuarios
            }
            layout {
                sequence: 8
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column TIPOREMESSA (
            type: plainText
            heading {
                heading: Tipo Remessa
            }
            layout {
                sequence: 7
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 5656182 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAABERTURA (
                sequence: 4
            )

            displayColumn DATAFECHAMENTO (
                sequence: 5
            )

            displayColumn DESCRICAO (
                sequence: 2
            )

            displayColumn IDFILIALFAVORITA (
                sequence: 6
            )

            displayColumn IDREMESSA (
                sequence: 1
            )

            displayColumn IDUSUARIO (
                sequence: 3
            )

            displayColumn IDUSUARIOFECHAMENTO (
                sequence: 8
            )

            displayColumn TIPOREMESSA (
                sequence: 7
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Nova Remessa
        layout {
            sequence: 30
            region: @report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 589
                clearCache: 589
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

