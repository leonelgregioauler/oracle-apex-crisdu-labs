    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region resumo (
        name: Resumo
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select 'Tarefas Aguardando Atendimento' label
                     , count(1) qtd
                from tarefas t 
                where t.idsituacao = 0
                  and t.idtipotarefa = 21
                  and t.idgrupoatendimento = 3
                  and exists ( select 1
                               from tarefasdetalhadas tt
                               where tt.idtarefa = t.idtarefa )
                union all
                select 'Tarefas Registradas Hoje' label
                     , count(1) qtd
                from tarefas t 
                where t.idtipotarefa = 21
                  and trunc(t.datainserida) = trunc(sysdate)
                  and t.idgrupoatendimento = 3
                  and exists ( select 1
                               from tarefasdetalhadas tt
                               where tt.idtarefa = t.idtarefa )
                union all
                select 'Tarefas Atendidas Hoje' label
                     , count(1) qtd
                from tarefas t 
                where t.idtipotarefa = 21
                  and trunc(t.dataconclusao) = trunc(sysdate)
                  and t.idgrupoatendimento = 3
                  and t.idsituacao = 30
                  and exists ( select 1
                               from tarefasdetalhadas tt
                               where tt.idtarefa = t.idtarefa )
                
                ```
        }
        layout {
            sequence: 10
            parentRegion: @tarefas-especiais
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            labelColumn: LABEL
            valueColumn: QTD
        }
    )

    region tarefas-especiais (
        name: Tarefas Especiais
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P543_DATAFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            formatMask: DD/MM/RRRR
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P543_DATAINICIO (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            formatMask: DD/MM/RRRR
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P543_FILTRAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P543_IDUSUARIO (
        type: selectList
        label {
            label: Atendente
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nomepessoa) nome
                     , u.idusuario id
                from usuarios u
                   , pessoas p
                where u.ativo = 'S'
                  and p.idpessoa = u.idpessoa
                  and exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.idgrupoatendimento = 3
                                 and ug.usuario = u.usuario )
                order by 1
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P543_LIMITE (
        type: displayOnly
        label {
            label: Limite diário de registros de Tarefas
            alignment: left
        }
        layout {
            sequence: 10
            region: @ações
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select valor
                    from roman.parametros 
                    where nome = 'LIMITETAREFASESPECIAIS'
                      and idfilial = 360;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P543_TIPODATA (
        type: radioGroup
        label {
            label: Pesquisar Por
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Inclusão;I,Conclusão;C
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        default {
            type: static
            staticValue: I
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button gerar-tarefas (
        buttonName: GERAR_TAREFAS
        label: Gerar Tarefas
        layout {
            sequence: 20
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction gera-novas-tarefas (
        name: Gera novas Tarefas
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @gerar-tarefas
        }

        action native-confirm (
            action: confirm
            settings {
                message: Deseja realmente registrar mais tarefas?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: GERAR_TAREFA
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    process alimenta-datas (
        name: Alimenta Datas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  :P543_DATAINICIO := trunc(sysdate);
                  :P543_DATAFIM := trunc(sysdate);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 31978026094133473
        }
        serverSideCondition {
            type: itemIsNull
            item: P543_DATAINICIO
        }
    )

    process gerar-novas-tarefas (
        name: Gerar Novas Tarefas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  roman.pck_cobranca.prc_tarefasespeciais;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Tarefas Geradas Com sucesso!
        }
        advanced {
            executionMappingIdentifier: 763197186973446027
        }
        serverSideCondition {
            type: request=Value
            value: GERAR_TAREFA
        }
    )

    branch (
        name: Go To Page 543
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 543
                items: {
                    P543_TIPODATA: &P543_TIPODATA.
                    P543_DATAINICIO: &P543_DATAINICIO.
                    P543_DATAFIM: &P543_DATAFIM.
                    P543_IDUSUARIO: &P543_IDUSUARIO.
                    P543_FILTRAR: S
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

