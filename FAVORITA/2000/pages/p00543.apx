page 543 (
    name: Mapeamento de Tarefas
    title: Mapeamento de Tarefas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region acompanhamento-das-tarefas (
        name: Acompanhamento das Tarefas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idtarefa
                     , t.tipotarefa
                     , t.telefone
                     , t.datainclusao
                     , t.datainserida
                     , t.dataconclusao
                     , t.situacao
                     , t.observacao
                     , t.nomeusuario
                     , t.cpfcliente
                     , t.cliente
                     , ( select listagg( td.origem||' - '||td.numero||' ('||td.saldo||' / at.: '||round(td.saldoatualizado,2)||') DT: '||td.dataemissao||' - VENC: '||td.data, '; ') within group ( order by data )
                         from favorita.tarefasdetalhadas td
                         where td.idtarefa = t.idtarefa ) detalhe
                from vw_tarefas_fav t
                where t.ididioma = 1
                  and t.idtipotarefa = 21
                  and ( :P543_TIPODATA is null
                      or ( :P543_TIPODATA = 'I' and t.datainserida between to_date(:P543_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P543_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') )
                      or ( :P543_TIPODATA = 'C' and t.dataconclusao between to_date(:P543_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P543_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') ) )
                  and ( :P543_IDUSUARIO is null or t.idusuario = :P543_IDUSUARIO )
                  and :P543_FILTRAR = 'S'
                ```
        }
        layout {
            sequence: 20
            parentRegion: @tarefas-especiais
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado, verifique os filtros utilizados.
        }
        advanced {
            savedReportMappingIdentifier: 63569878688150939
        }

