page 162 (
    name: Finalizar Evento
    title: Finalizar Evento
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 70%
        height: 80%
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region new (
        name: New
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region new-2 (
        name: New
        type: staticContent
        source {
            htmlCode:
                ```html
                <h2 align="middle">Obrigado por registrar o Evento!</h2>
                <h2 align="middle"><br>Vamos atender o mais breve possível.</h2>
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region registrar-evento (
        name: Registrar Evento
        type: list
        source {
            list: @registrar-evento
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

    button finalizar (
        buttonName: FINALIZAR
        label: Finalizar
        layout {
            sequence: 10
            region: @new
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process close (
        name: Close
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 13875242489620931
        }
    )

)

