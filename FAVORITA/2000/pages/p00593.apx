page 593 (
    name: Relatorio  Pedidos SubRemessa
    title: Relatorio  Pedidos SubRemessa
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 80%
        height: 60%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_entrega_pedido(pid_pedido) {
              apex.confirm("Deseja marcar esse pedido como entregue?", {
                request:"ENTREGAR_PEDIDO",
                set:{"P479_ID_PEDIDO_ENTREGAR":pid_pedido},
                showWait:true
                });  
            }
            ```
        executeWhenPageLoads: //$("#R85014125112168631_control_panel").hide();
    }
    css {
        inline:
            ```css
            a.vermelho:link, a.vermelho:visited, a.vermelho:hover, a.vermelho:active {
              text-decoration: none;
              color: #3BAA2C
              }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region lista-de-pedidos (
        name: Lista de Pedidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpedido
                     , pck_util_fav.fnc_nomerepresentante( p.idrepresentante ) "Distribuidor"
                     , pck_util_fav.fnc_nomevendedora( p.idvendedora ) "Empreendedora"
                     , p.idvendedora
                     , p.idrepresentante
                     , p.dataemissao as "Dt Emissão"
                     --
                     , (select descricaosistema 
                          from situacoesentrega
                         where idsituacaoentrega = p.idsituacaoentrega) "Sit Entrega"
                       --
                     , CASE WHEN p.idsubremessa IS NOT NULL THEN
                         APEX_ITEM.CHECKBOX2(1, p.idpedido , 'CHECKED' ) 
                       ELSE
                         APEX_ITEM.CHECKBOX2(1, p.idpedido , NULL ) 
                       END Incluir
                     --
                     , p.idsubremessa
                       --
                  from pedidos p
                 where p.datacancelamento is null
                   and p.idsubremessa is null
                   --and (p.idsubremessa is null or p.idsubremessa = :P593_IDSUBREMESSA)
                   and p.idsituacaoentrega in (30000,55000) 
                   and exists (select 1
                                 from classificacoespedidos c
                                where c.idcaracteristicapedido = 13
                                  and c.idvalorcaracteristica in (6,7)
                                  and c.idpedido = p.idpedido)
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 566697736147380507
        }

