    button incluir-pedidos (
        buttonName: INCLUIR_PEDIDOS
        label: Incluir Pedidos
        layout {
            sequence: 10
            region: @lista-de-pedidos
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconRight
            ]
            icon: fa-print
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction confirma-incluir (
        name: Confirma_Incluir
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @incluir-pedidos
        }

        action native-confirm (
            action: confirm
            settings {
                message: Confirma incluir pedidos marcados na sub-remessa?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: INCLUIR_PEDIDOS
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    process atualizapedidos (
        name: AtualizaPedidos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vid_pedido number;
                begin
                
                  if APEX_APPLICATION.G_F01.COUNT > 0 then
                    --
                    FOR i in 1..APEX_APPLICATION.G_F01.COUNT 
                    LOOP
                      --
                      vid_pedido := to_number(APEX_APPLICATION.G_F01(i));
                      update pedidos 
                         set idsubremessa = :P593_IDSUBREMESSA
                       where idpedido = vid_pedido;
                    END LOOP;
                  else
                    raise_application_error(-20001,'Selecione ao menos um pedido para impressão!');
                  end if;
                
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 566698932945380519
        }
        serverSideCondition {
            type: request=Value
            value: INCLUIR_PEDIDOS
        }
    )

    branch (
        name: Volta_591
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 591
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @incluir-pedidos
        }
    )

)

