page 213 (
    name: Cadastro de Cliente
    title: Cadastro de Cliente
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-de-consultora (
        name: Cadastro de Consultora
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region distribuidores-que-já-atenderam-a-consultora (
        name: Distribuidores que já atenderam a Consultora
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct(nvl(roman.pck_romance.fnc_nomerepresentante(lv.idrepresentante)||' - '||lv.idrepresentante,'Sem Distribuidores Antigos')) "Distribuidor"
                from roman.notasvendas lv
                where lv.idvendedora = :P213_IDVENDEDORA
                union
                select distinct(nvl(roman.pck_romance.fnc_nomerepresentante(lv.idrepresentanteatende)||' - '||lv.idrepresentanteatende,'Sem Distribuidores Antigos')) "Distribuidor"
                from roman.notasvendas lv
                where lv.idvendedora = :P213_IDVENDEDORA;
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column Distribuidor (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

    )

    pageItem P213_ATIVO (
        type: selectList
        label {
            label: Ativo
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Sim;S,Não;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @cadastro-de-consultora
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P213_COMISSAO (
        type: hidden
        layout {
            sequence: 80
            region: @cadastro-de-consultora
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P213_IDPESSOA (
        type: hidden
        layout {
            sequence: 40
            region: @cadastro-de-consultora
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P213_IDREGIAOVENDA (
        type: hidden
        layout {
            sequence: 70
            region: @cadastro-de-consultora
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P213_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sharedComponent
            lov: @lov-representantes
        }
        layout {
            sequence: 20
            region: @cadastro-de-consultora
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P213_IDVENDEDORA (
        type: displayOnly
        label {
            label: ID Cliente
            alignment: left
        }
        layout {
            sequence: 10
            region: @cadastro-de-consultora
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P213_MD5 (
        type: hidden
        layout {
            sequence: 110
            region: @cadastro-de-consultora
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P213_OBSERVACAO (
        type: textarea
        label {
            label: Observacao
            alignment: left
        }
        layout {
            sequence: 50
            region: @cadastro-de-consultora
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            height: 5
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P213_OPERACAO_DML (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 120
            region: @cadastro-de-consultora
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P213_PONTOS (
        type: hidden
        layout {
            sequence: 60
            region: @cadastro-de-consultora
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P213_SPC (
        type: hidden
        layout {
            sequence: 90
            region: @cadastro-de-consultora
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P213_ULTIMAATUALIZACAO (
        type: hidden
        layout {
            sequence: 100
            region: @cadastro-de-consultora
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Aplicar Alterações
        layout {
            sequence: 30
            region: @cadastro-de-consultora
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P213_IDVENDEDORA
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 10
            region: @cadastro-de-consultora
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P213_IDVENDEDORA
        }
    )

    button voltar (
        buttonName: Voltar
        label: Voltar
        layout {
            sequence: 20
            region: @cadastro-de-consultora
            slot: bottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-reply
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process carregavalores (
        name: CarregaValores
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  PCK_CADASTROS_FAV.PRC_VENDEDORAS( PIDVENDEDORA       => :P213_IDVENDEDORA
                                                  , PIDPESSOA          => :P213_IDPESSOA
                                                  , PATIVO             => :P213_ATIVO
                                                  , POBSERVACAO        => :P213_OBSERVACAO
                                                  , PIDREPRESENTANTE   => :P213_IDREPRESENTANTE
                                                  , PPONTOS            => :P213_PONTOS
                                                  , PIDREGIAOVENDA     => :P213_IDREGIAOVENDA
                                                  , PCOMISSAO          => :P213_COMISSAO
                                                  , PSPC               => :P213_SPC
                                                  , PULTIMAATUALIZACAO => :P213_ULTIMAATUALIZACAO
                                                  , PMD5               => :P213_MD5
                                                  , POPERACAO_DML      => 'S');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 339987165619633901
        }
    )

    process operacao-dml (
        name: OPERACAO_DML
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                --
                 voperacao_dml varchar2(1);
                --
                begin
                voperacao_dml := :P213_OPERACAO_DML; 
                
                 if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  PCK_CADASTROS_FAV.PRC_VENDEDORAS( PIDVENDEDORA       => :P213_IDVENDEDORA
                                                  , PIDPESSOA          => :P213_IDPESSOA
                                                  , PATIVO             => :P213_ATIVO
                                                  , POBSERVACAO        => :P213_OBSERVACAO
                                                  , PIDREPRESENTANTE   => :P213_IDREPRESENTANTE
                                                  , PPONTOS            => :P213_PONTOS
                                                  , PIDREGIAOVENDA     => :P213_IDREGIAOVENDA
                                                  , PCOMISSAO          => :P213_COMISSAO
                                                  , PSPC               => :P213_SPC
                                                  , PULTIMAATUALIZACAO => :P213_ULTIMAATUALIZACAO
                                                  , PMD5               => :P213_MD5
                                                  , POPERACAO_DML      => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Cadastrado/Atualizado com sucesso
        }
        error {
            errorMessage: Erro ao cadastrar/atualizar
        }
        advanced {
            executionMappingIdentifier: 339977687655576048
        }
        serverSideCondition {
            type: request!=Value
            value: Voltar
        }
    )

    branch (
        name: Go To Page 213
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 213
                items: {
                    P213_IDVENDEDORA: &P213_IDVENDEDORA.
                    P213_IDPESSOA: &P213_IDPESSOA.
                }
                action: resetPagination
            }
        }
    )

    branch (
        name: Go To Page 85
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 85
                items: {
                    P85_IDPESSOA: &P213_IDPESSOA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @voltar
        }
    )

)

