page 631 (
    name: REMOVE ACESSOS USUARIO
    title: Usuários da Aplicação
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region parametros (
        name: Parametros
        type: staticContent
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: 1 = 2
        }
    )

    region usuários (
        name: Usuários
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select APEX_ITEM.CHECKBOX2(1, b.usuario , NULL )  deletar
                      ,b.usuario
                      ,b.ativo
                      ,(select count(*)
                         from roman.aplicacoes ap
                            , roman.acessos ac
                        where ap.idaplicacao = ac.idaplicacao
                          and ap.hierarquia  = a.idaplicacao
                          and ac.usuario     = b.usuario) acessos_cascata
                  from roman.acessos b
                     , roman.aplicacoes a
                 where b.idaplicacao = a.idaplicacao
                   and b.idaplicacao = :P631_IDAPLICACAO
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 2433862012221291624
        }

        column ACESSOS_CASCATA (
            type: plainText
            heading {
                heading: Acessos Cascata
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
            help {
                helpText:
                    ```html
                    Acessos Cascata são acessos filhos do acesso que esta sendo deletado.
                    Exemplo: Menus com suas telas filhas.
                    ```
            }
        )

        column ATIVO (
            type: plainText
            heading {
                heading: Ativo
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column DELETAR (
            type: plainText
            heading {
                heading: Deletar
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column USUARIO (
            type: plainText
            heading {
                heading: Usuario
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        savedReport 24338933 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACESSOS_CASCATA (
                sequence: 4
            )

            displayColumn ATIVO (
                sequence: 3
            )

            displayColumn DELETAR (
                sequence: 1
            )

            displayColumn USUARIO (
                sequence: 2
            )

        )

    )

    pageItem P631_IDAPLICACAO (
        type: textField
        label {
            label: Idaplicacao
            alignment: left
        }
        layout {
            sequence: 10
            region: @parametros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button deletar (
        buttonName: DELETAR
        label: Deletar
        layout {
            sequence: 20
            region: @usuários
            slot: regionBody
            startNewRow: false
            column: 11
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @usuários
            slot: regionBody
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 630
                clearCache: 631
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction valida-acessos-cascata (
        name: Valida Acessos Cascata
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @deletar
        }

        action native-alert (
            action: alert
            settings {
                message: Atenção! Antes de continuar, verifique a coluna &quot;ACESSOS CASCATA&quot;, é a quantidade de acessos que também serão deletados, são acessos filhos, como sub telas ao deletar acesso ao Menu, por exemplo.
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-confirm (
            action: confirm
            settings {
                message: Você realmente deseja excluir o acesso?
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: DELETAR
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    process deletar-acesso-usuario (
        name: Deletar Acesso Usuario
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  v_verifica varchar2(50);
                begin
                --
                 FOR i IN 1..APEX_APPLICATION.G_F01.COUNT
                 loop
                   --
                   delete roman.acessos
                    where usuario = APEX_APPLICATION.G_F01(i)
                      and idaplicacao = :P631_IDAPLICACAO;
                   --
                   delete roman.acessos a
                    where a.usuario = APEX_APPLICATION.G_F01(i)
                      and a.idaplicacao in (select ap.idaplicacao
                                              from roman.aplicacoes ap
                                             where ap.hierarquia = :P631_IDAPLICACAO );
                   --
                   v_verifica := APEX_APPLICATION.G_F01(i);
                   --
                  END LOOP;
                  --
                  if v_verifica is null then
                  raise_application_error(-20001,'Selecione um ou mais usuários.');
                  else
                  commit;
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 2433861358705291617
        }
        serverSideCondition {
            whenButtonPressed: @deletar
        }
    )

)

