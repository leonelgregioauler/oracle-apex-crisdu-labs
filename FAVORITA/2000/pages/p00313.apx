    pageItem P313_DATAFIM (
        type: textField
        label {
            label: até
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            formatMask: DD/MM/RRRR
            width: 15
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P313_DATAINICIO (
        type: textField
        label {
            label: Movimentação de
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            formatMask: DD/MM/RRRR
            width: 15
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P313_IDFILIALROMANCE (
        type: selectList
        label {
            label: Filial
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome d
                     , f.idfilial r
                from roman.vw_filiais f
                where f.tipofilial = 'D'
                  and f.ativo = 'S'
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P313_IDVENDEDORA (
        type: popupLov
        label {
            label: Consultora
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' ('||nvl(p.cpf,p.documentoestrangeiro)||')' display_value
                     , v.idvendedora
                from vendedoras v
                   , pessoas p
                where p.idpessoa = v.idpessoa
                  and ( :P313_IDFILIALROMANCE is null 
                       or roman.pck_romance.fnc_filialvendedora(v.idvendedora) = :P313_IDFILIALROMANCE )
                  and v.ativo = 'S'
                order by 1
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P313_IDFILIALROMANCE
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 313
                items: {
                    P313_DATAINICIO: &P313_DATAINICIO.
                    P313_DATAFIM: &P313_DATAFIM.
                    P313_IDFILIALROMANCE: &P313_IDFILIALROMANCE.
                    P313_IDVENDEDORA: &P313_IDVENDEDORA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

