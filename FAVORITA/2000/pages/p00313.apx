page 313 (
    name: Históricos de Movimentações
    title: Históricos de Movimentações
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region históricos-de-movimentações (
        name: Históricos de Movimentações
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.idmovimentopontosclube  
                     , m.idvendedora
                     , m.vendedora
                     , m.datamovimento
                     , m.descricao
                     , m.pontos
                     , m.datavencimento
                     , m.idpedido
                     , m.idpagamentopedido
                     , m.idresgate
                     , m.resgate
                     , m.idcategoriaclube
                     , m.categoria
                     , m.idcartaoclube
                     , m.cartaoclube
                from vw_movimentospontosclube_fav m 
                where ( :P313_DATAINICIO is null or trunc(m.datamovimento) between to_date(:P313_DATAINICIO,'DD/MM/RRRR') and to_date(:P313_DATAFIM,'DD/MM/RRRR') )
                  and ( :P313_IDFILIALROMANCE is null or m.idfilialromance = :P313_IDFILIALROMANCE )
                  and ( :P313_IDVENDEDORA is null or m.idvendedora = :P313_IDFILIALROMANCE )
                order by 4 desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado!
        }
        advanced {
            savedReportMappingIdentifier: 1403139566372262606
        }

