page 163 (
    name: Cadastro Horário de Acesso
    title: Cadastro Horário de Acesso
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region horários-de-acesso (
        name: Horários de Acesso
        type: tabform
        source {
            sqlQuery:
                ```sql
                select idhorarioacesso
                     , idusuario
                     , horainicio
                     , horafim
                     , dia
                     , case 
                         when dia = 'SEGUNDA-FEIRA' then 1
                         when dia = 'TERÇA-FEIRA'   then 2
                         when dia = 'QUARTA-FEIRA'  then 3
                         when dia = 'QUINTA-FEIRA'  then 4
                         when dia = 'SEXTA-FEIRA'   then 5
                         when dia = 'SÁBADO'        then 6
                         when dia = 'DOMINGO'       then 7
                      end dia_semana
                     , idsistema
                from catal.horariosacesso
                where idusuario = :P163_USUARIOS
                  and idsistema = 2000
                  order by dia_semana
                ```
        }
        layout {
            sequence: 15
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P163_USUARIOS
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column CHECK$01 (
            reportColumnQueryId: 8
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: &nbsp;
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
        )

        column DIA (
            reportColumnQueryId: 5
            derivedColumn: N
            type: selectList
            heading {
                heading: Dia
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(dia) display_value
                         , dia return_value
                    from ( select 'SEGUNDA-FEIRA' dia
                                , 1  ordem
                           from dual
                           union
                           select 'TERÇA-FEIRA' 
                                , 2  ordem
                           from dual
                           union
                           select 'QUARTA-FEIRA' 
                                , 3  ordem
                           from dual
                           union
                           select 'QUINTA-FEIRA' 
                                , 4  ordem
                           from dual
                           union
                           select 'SEXTA-FEIRA' 
                                , 5  ordem
                           from dual
                           union
                           select 'SÁBADO' 
                                , 6  ordem
                           from dual
                           union
                           select 'DOMINGO'
                                , 7  ordem
                           from dual)
                    order by   ordem
                    ```
                nullDisplayValue: - Selecione um dia -
            }
            layout {
                sequence: 6
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column DIA_SEMANA (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                alignment: center
            }
            layout {
                sequence: 7
            }
            sorting {
                sortable: false
            }
            serverSideCondition {
                type: never
            }
        )

        column HORAFIM (
            reportColumnQueryId: 4
            derivedColumn: N
            type: textField
            heading {
                heading: Até
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
            appearance {
                width: 8
            }
            sorting {
                sortable: false
            }
            advanced {
                customAttributes: "onkeyPress=\"javascript:{formatar_mascara(this, '##:##:##',event); }\"; onblur=\"javascript:{formataHora(this); }\" ;"
            }
        )

        column HORAINICIO (
            reportColumnQueryId: 3
            derivedColumn: N
            type: textField
            heading {
                heading: De
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
            appearance {
                width: 8
            }
            sorting {
                sortable: false
            }
            advanced {
                customAttributes: "onkeyPress=\"javascript:{formatar_mascara(this, '##:##:##',event); }\"; onblur=\"javascript:{formataHora(this); }\" ;"
            }
        )

        column IDHORARIOACESSO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDHORARIOSACESSO
            }
            sorting {
                sortable: false
            }
        )

        column IDSISTEMA (
            reportColumnQueryId: 7
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 8
            }
            default {
                type: plsqlExpression
                plsqlExpression: to_number(:P163_IDSISTEMA)
            }
            sorting {
                sortable: false
            }
        )

        column IDUSUARIO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 3
            }
            default {
                type: plsqlExpression
                plsqlExpression: to_number(:P163_USUARIOS)
            }
            sorting {
                sortable: false
            }
        )

    )

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
    )

    pageItem P163_IDSISTEMA (
        type: hidden
        layout {
            sequence: 20
            region: @opções
            slot: regionBody
        }
        default {
            type: static
            staticValue: 2000
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P163_USUARIOS (
        type: selectList
        label {
            label: Usuários
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select u.usuario
                     , u.idusuario
                from usuarios u
                   , pessoas  p
                where u.idpessoa = p.idpessoa
                and u.ativo = 'S'
                and exists ( select 1 from usuariossistemas us where us.usuario = u.usuario and idsistema = 2000)
                order by 1 
                ```
        }
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button adicionarlinha (
        buttonName: ADICIONARLINHA
        label: Adicionar Linha
        layout {
            sequence: 10
            region: @horários-de-acesso
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:addRow();
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 30
            region: @horários-de-acesso
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIR');
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inseriratualizar (
        buttonName: INSERIRATUALIZAR
        label: Inserir / Atualizar
        layout {
            sequence: 20
            region: @horários-de-acesso
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation dia-obrigatório (
        name: DIA obrigatório
        execution {
            sequence: 40
        }
        validation {
            editableRegion: @horários-de-acesso
            type: columnIsNotNull
            column: DIA
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ter um valor.
            associatedColumn: DIA
        }
    )

    validation horafim-obrigatório (
        name: HORAFIM obrigatório
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @horários-de-acesso
            type: columnIsNotNull
            column: HORAFIM
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ter um valor.
            associatedColumn: HORAFIM
        }
    )

    validation horainicio-obrigatório (
        name: HORAINICIO obrigatório
        execution {
            sequence: 20
        }
        validation {
            editableRegion: @horários-de-acesso
            type: columnIsNotNull
            column: HORAINICIO
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ter um valor.
            associatedColumn: HORAINICIO
        }
    )

    validation usuario-numérico (
        name: USUARIO numérico
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @horários-de-acesso
            type: columnIsNumeric
            column: IDUSUARIO
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ser numérico.
            associatedColumn: IDUSUARIO
        }
    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @horários-de-acesso
        target {
            tableOwner: CATAL
            tableName: HORARIOSACESSO
            pkColumn: IDHORARIOACESSO
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: #MRD_COUNT# registro(s) excluído(s).
        }
        advanced {
            executionMappingIdentifier: 786875671448037532
        }
        serverSideCondition {
            whenButtonPressed: @excluir
            type: request=Value
            value: EXCLUIR
            executeCondition: once
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @horários-de-acesso
        target {
            tableOwner: CATAL
            tableName: HORARIOSACESSO
            pkColumn: IDHORARIOACESSO
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# registro(s) atualizado(s), #MRI_COUNT# registro(s) inserido(s).
        }
        advanced {
            executionMappingIdentifier: 786875299580037532
        }
        serverSideCondition {
            whenButtonPressed: @inseriratualizar
            executionScope: allSubmittedRows
            type: request=Value
            value: INSERIRATUALIZAR
        }
    )

    branch (
        name: Go To Page 163
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 163
            }
            saveStateBeforeBranching: true
        }
    )

    branch (
        name: Go To Page 163
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 163
            }
            saveStateBeforeBranching: true
        }
    )

)

