page 158 (
    name: "Cadastro de Histórico "
    title: "Cadastro de Histórico "
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 60%
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
        executeWhenPageLoads:
            ```javascript-browser
            self.focus();
            opener.location.reload();
            self.focus();
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region histórico (
        name: Histórico
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P158_DATAFIM (
        type: datePickerJquery
        label {
            label: Data Término
            alignment: left
        }
        layout {
            sequence: 40
            region: @histórico
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr hh24:mi:ss
            width: 15
        }
        validation {
            maxLength: 4000
        }
        source {
            type: databaseColumn
            databaseColumn: DATAFIM
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P158_DATAHISTORICO (
        type: datePickerJquery
        label {
            label: Data Início
            alignment: left
        }
        layout {
            sequence: 30
            region: @histórico
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr hh24:mi:ss
            width: 15
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: DATAHISTORICO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  return to_char(sysdate, 'dd/mm/rrrr hh24:mi:ss');
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P158_DESCRICAO (
        type: textarea
        label {
            label: Descrição
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 60
            region: @histórico
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 80
            height: 15
        }
        validation {
            maxLength: 4000
        }
        source {
            type: databaseColumn
            databaseColumn: DESCRICAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P158_EMAIL (
        type: hidden
        layout {
            sequence: 70
            region: @histórico
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: EMAIL
            used: always
        }
        default {
            type: static
            staticValue: S
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P158_IDCHAMADO (
        type: numberField
        label {
            label: Nº de Chamado
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 20
            region: @histórico
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 5
        }
        validation {
            maxLength: 255
        }
        advanced {
            customAttributes: readonly
        }
        source {
            type: databaseColumn
            databaseColumn: IDCHAMADO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                BEGIN
                RETURN :P5_IDCHAMADO;
                END
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P158_IDHISTORICOCHAMADO (
        type: hidden
        layout {
            sequence: 1
            region: @histórico
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDHISTORICOCHAMADO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P158_USUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @histórico
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: USUARIO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                return v('APP_USER');
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Fechar
        layout {
            sequence: 20
            region: @histórico
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 5
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 50
            region: @histórico
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: never
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 30
            region: @histórico
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P158_IDHISTORICOCHAMADO
        }
    )

    button reabrir (
        buttonName: REABRIR
        label: Salvar e Reabrir Ticket
        layout {
            sequence: 10
            region: @histórico
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P158_IDHISTORICOCHAMADO
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 40
            region: @histórico
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P158_IDHISTORICOCHAMADO
        }
    )

    validation p158-datahistorico (
        name: P158_DATAHISTORICO
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P158_DATAHISTORICO
        }
        error {
            errorMessage: #LABEL# deve ser informado.
            associatedItem: @P158_DATAHISTORICO
        }
    )

    validation p158-descricao (
        name: P158_DESCRICAO
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P158_DESCRICAO
        }
        error {
            errorMessage: #LABEL# deve ser preenchido.
            displayLocation: inlineWithField
            associatedItem: @P158_DESCRICAO
        }
    )

    process close-window (
        name: Close Window
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 30173970587547579
        }
        serverSideCondition {
            type: never
        }
    )

    process fetch-row-from-historicochamados (
        name: Fetch Row from HISTORICOCHAMADOS
        type: autoRowFetch
        source {
            tableName: HISTORICOCHAMADOS
            pkColumn: IDHISTORICOCHAMADO
            pkItem: P158_IDHISTORICOCHAMADO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Não é possível extrair a linha.
        }
        advanced {
            executionMappingIdentifier: 30174361526547579
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P158_IDHISTORICOCHAMADO
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select roman.SEQ_IDHISTORICOCHAMADO.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P158_IDHISTORICOCHAMADO := get_pk; 
                
                  begin
                      catal.pck_util.prc_enviaemail( ppara => 'ti@romancemoda.com.br'
                                                   , passunto => 'ti@romancemoda.com.br'
                                                   , ptexto => 'Olá!'||chr(10)||chr(10)||
                                                              'O usuário '||roman.pck_romance.fnc_nomeusuario(v('APP_USER'))||' inclui um histórico no chamado '||:P158_IDCHAMADO ||'!'||chr(10)||chr(10)||
                                                              :P158_DESCRICAO||chr(10)||chr(10)|| 
                                                              'Mensagem enviada automaticamente.' );
                  exception
                    when others then
                      null;
                  end;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Não é possível obter valor de item de chave primária.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 30174758587547579
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where V('REQUEST') in ('CREATE','REABRIR')
                ```
        }
    )

    process process-row-of-historicochamados (
        name: Process Row of HISTORICOCHAMADOS
        type: autoRowProcessing
        target {
            tableOwner: ROMAN
            tableName: HISTORICOCHAMADOS
            pkColumn: IDHISTORICOCHAMADO
            pkItem: P158_IDHISTORICOCHAMADO
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada.
        }
        error {
            errorMessage: Não é possível processar a linha da tabela HISTORICOCHAMADOS.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 30173191812547578
        }
    )

    process reabrir (
        name: Reabrir
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  --
                  vidnotificacaointerna   number;
                  vtiponotificacao        varchar2(1)    := 'G';  
                  viddestino              number    := 0;  --Grupo ti
                  vtitulont                 varchar2(1000) := 'Aviso de Monitoramento';
                  vdescricaont              varchar2(4000) ;
                  vurl                    varchar2(1000);
                  vdataenviado            date;
                  vtype                   varchar2(1000) := 'DANGER';
                  vscreenposition         varchar2(1000) := 'TOPLEFT';     
                  vshownew                varchar2(1000) := 'TOP';
                  vdisplayduration        varchar2(1000);
                  vremovemethod           varchar2(1000); 
                  vusuario                varchar2(1000);
                  --
                begin
                  --
                  update roman.chamados c
                  set c.idsituacao = 0
                    , DATAATENDIDO = null
                    , PERCCONCLUIDO = 0
                    , idsituacaokanban = 600
                  where c.idchamado = :P158_IDCHAMADO
                  RETURNING IDGRUPOATENDIMENTO
                          , c.titulo
                          , c.descricao
                          , c.usuario
                  INTO viddestino
                     , vtitulont
                     , vdescricaont
                     , vusuario;
                  --
                  vtitulont    := roman.pck_romance.fnc_nomeusuario(vusuario)||' reabriu evento '||:P158_IDCHAMADO;
                  vdescricaont := :P158_DESCRICAO||' <br><br> '||vdescricaont;
                  --
                  ROMAN.pck_ti.PRC_NOTIFICACOESINTERNAS( pidnotificacaointerna  => vidnotificacaointerna
                                                       , ptiponotificacao       => vtiponotificacao
                                                       , piddestino             => viddestino
                                                       , ptitulo                => vtitulont
                                                       , pdescricao             => vdescricaont
                                                       , purl                   => vurl
                                                       , pdataenviado           => vdataenviado
                                                       , ptype                  => vtype
                                                       , pscreenposition        => vscreenposition
                                                       , pshownew               => vshownew
                                                       , pdisplayduration       => vdisplayduration
                                                       , premovemethod          => vremovemethod
                                                       , poperacao_dml          => 'I');
                  /*catal.pck_util.prc_enviaemail(ppara => 'ti@romancemoda.com.br',
                                                passunto => '[Informativo] Evento '||:P158_IDCHAMADO ||' reaberto.',
                                                ptexto => 'Olá!'||chr(10)||chr(10)||
                                                          'O evento nrº '||:P158_IDCHAMADO||' foi reaberto!'||chr(10)||chr(10)||
                                                          :P158_DESCRICAO||chr(10)||chr(10)||
                                                          'Atenciosamente,'||chr(10)||        
                                                          'TI - Romance Moda' );*/
                  --
                  insert into roman.historicochamados (idhistoricochamado, idchamado, datahistorico, descricao, email, usuario, datafim,situacao)
                  values ( roman.seq_idhistoricochamado.nextval, :P157_IDCHAMADO, sysdate, 'Ticket reaberto.','N',v('APP_USER'),sysdate,'R');
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 1097791177635345702
        }
        serverSideCondition {
            whenButtonPressed: @reabrir
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 30173553384547579
        }
        serverSideCondition {
            type: never
        }
    )

    branch (
        name: Go To Page 157
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 157
                successMessage: false
            }
            saveStateBeforeBranching: true
        }
        comments {
            comments: Created 04-AGO-2011 10:22 by ROMAN
        }
    )

)

