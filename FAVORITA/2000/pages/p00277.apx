            whenButtonPressed: @atualizar
        }
    )

    branch (
        name: Go To Page 277
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 277
                items: {
                    P277_IDDEPOSITOFAVORITA: &P277_IDDEPOSITOFAVORITA.
                    P277_IDFECHAMENTO: &P277_IDFECHAMENTO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @inserir
        }
    )

)

