    button anexar-documentos (
        buttonName: ANEXAR_DOCUMENTOS
        label: Anexar Documentos
        layout {
            sequence: 10
            region: @depósito-da-favorita
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 283
                items: {
                    P283_IDDEPOSITO: &P277_IDDEPOSITOFAVORITA.
                    P283_IDANEXODELETAR:
                    P283_IDANEXODEPOSITO:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P277_IDDEPOSITOFAVORITA is not null
                  and exists ( select 1 
                               from roman.fechamentossemanais f
                               where f.idfechamento = :P0_IDFECHAMENTO
                                 and f.concluido = 'N' )
                ```
        }
    )

