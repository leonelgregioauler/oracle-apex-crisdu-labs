    validation valida-valor-de-deposito (
        name: Valida Valor de Deposito
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where to_number(:P277_VALORDEPOSITO,'999G999G999G999G990D00') = 0
                ```
        }
        error {
            errorMessage: Valor do depósito não pode ser zerado!
        }
    )

    process busca-depósito (
        name: Busca Depósito
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE    
                  vvalordeposito number;
                begin
                  -- Call the procedure
                  pck_fechamentos_fav.prc_depositosfavorita(piddepositofavorita => :p277_iddepositofavorita,
                                                            pidfechamento => :p277_idfechamento,
                                                            pdatadeposito => :p277_datadeposito,
                                                            pnumerocomprovante => :p277_numerocomprovante,
                                                            pvalordeposito => vvalordeposito,
                                                            pidusuario => :p277_idusuario,
                                                            pmd5 => :p277_md5,
                                                            poperacao_dml => 'S');
                  --
                  :P277_VALORDEPOSITO := to_char(vvalordeposito,'999G999G999G999G990D00');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 1373310343261400220
        }
    )

    process processo-dml-em-depósitos-favorita (
        name: Processo DML em Depósitos Favorita
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  voperacao_dml varchar2(1);
                  vvalordeposito number;
                  --
                begin
                  --
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  vvalordeposito := to_number(:P277_VALORDEPOSITO,'999G999G999G999G990D00');
                  --
                  #OWNER#.PCK_FECHAMENTOS_FAV.PRC_DEPOSITOSFAVORITA( PIDDEPOSITOFAVORITA => :P277_IDDEPOSITOFAVORITA,
                                                                     PIDFECHAMENTO => :P277_IDFECHAMENTO,
                                                                     PDATADEPOSITO => :P277_DATADEPOSITO,
                                                                     PNUMEROCOMPROVANTE => :P277_NUMEROCOMPROVANTE,
                                                                     PVALORDEPOSITO => vvalordeposito,
                                                                     PIDUSUARIO => :P277_IDUSUARIO,
                                                                     PMD5 => :P277_MD5,
                                                                     POPERACAO_DML => voperacao_dml );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo realizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1373310717981400220
        }
    )

    branch (
        name: Go To Page 277
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 277
                items: {
