    region pedidos-retirados-2 (
        name: Pedidos Retirados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select count(1)
                     , roman.pck_romance.fnc_nomerepresentante(p.idrepresentante) representante
                     , sum(p.valortotal) valortotal
                     , sum(p.valorapagar) valorapagar
                from vw_pedidos_fav p
                where p.ididioma = 1
                  and p.idfilialfavorita = :P0_IDFILIALFAVORITA
                  and :P185_TIPORELATORIO = 'R'
                  and trunc(p.dataemissao) between to_date(:P185_DATAINICIO,'DD/MM/RRRR') and to_date(:P185_DATAFIM,'DD/MM/RRRR')
                  and ( :P185_IDREPRESENTANTE is null or p.idrepresentante = :P185_IDREPRESENTANTE )
                  and exists ( select 1
                               from classificacoespedidos c
                               where c.idpedido = p.idpedido
                                 and ( c.idcaracteristicapedido = 2
                                    or c.idcaracteristicapedido = 32 ) )
                group by p.idrepresentante
                order by 2
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P185_TIPORELATORIO
            value: R
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
