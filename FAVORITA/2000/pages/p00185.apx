page 185 (
    name: Pedidos Retirados
    title: Pedidos Retirados
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pedidos-retirados (
        name: Pedidos Retirados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.numeropedido
                     , p.representante
                     , p.vendedora
                     , p.dataemissao
                     , p.dataentrega
                     , p.datavencimento
                     , p.valortotal
                     , p.valorapagar
                     , p.situacaoentrega
                     , p.situacaofinanceiro
                from vw_pedidos_fav p
                where p.ididioma = 1
                  and p.idfilialfavorita = :P0_IDFILIALFAVORITA
                  and trunc(p.dataemissao) between to_date(:P185_DATAINICIO,'DD/MM/RRRR') and to_date(:P185_DATAFIM,'DD/MM/RRRR')
                  and ( :P185_IDREPRESENTANTE is null or p.idrepresentante = :P185_IDREPRESENTANTE )
                  and exists ( select 1
                               from classificacoespedidos c
                               where c.idpedido = p.idpedido
                                 and ( c.idcaracteristicapedido = 2
                                    or c.idcaracteristicapedido = 32 ) )
                order by dataemissao 
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P185_TIPORELATORIO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Verifique os filtros informados!
        }
        advanced {
            savedReportMappingIdentifier: 241592316178768628
        }

