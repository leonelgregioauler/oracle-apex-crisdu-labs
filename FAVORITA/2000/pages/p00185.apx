        }
    )

    pageItem P185_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(r.idrepresentante) display_value
                     , r.idrepresentante return_value
                from representantes r
                where r.idgerente = ( select idgerente from usuarios where usuario = v('APP_USER') )
                  and r.ativo = 'S'
                order by 1
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P185_TIPORELATORIO (
        type: radioGroup
        label {
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Resumido;R,Detalhado;D
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        source {
            used: always
        }
        default {
            type: static
            staticValue: R
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 185
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 185
                items: {
                    P185_DATAINICIO: &P185_DATAINICIO.
                    P185_DATAFIM: &P185_DATAFIM.
                    P185_IDREPRESENTANTE: &P185_IDREPRESENTANTE.
                    P185_TIPORELATORIO: &P185_TIPORELATORIO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

