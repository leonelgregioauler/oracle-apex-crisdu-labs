    process retirar-o-item-do-pedido-e-atualizar (
        name: "Retirar o Item do Pedido e Atualizar "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_movimentarpedidos_fav.prc_retiraitemeatualizaped(piditempedido => :P224_IDEDITAR,
                                                                       pidusuario => :P0_IDUSUARIO);
                end;
                ```
