    region reservado-nos-pedidos (
        name: Reservado nos Pedidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||idpedido ,'SESSION')||''',''_blank''); void(0)">'||numeropedido||'</a>' numeropedido
                     , filialromance
                     , representante
                     , vendedora
                     , situacaoentregainterno
                     , nomeproduto
                     , quantidade
                     , formapagamento
                     , '<a href=javascript:irparapedido('||idpedido||');><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' irpedido
                     , case 
                        when formapagamento = 'Boleto' and idsituacaocobranca < 32000 and idpedidowidecommerce is null then
                          '<a href="javascript:apex.confirm(''Confirma a retirada do produto '||nomeproduto||' de '||quantidade||' unidade(s)?'', { request:''REMOVER'',set:{''P224_IDEDITAR'':'|| iditempedido ||'}})";><img src="#APP_IMAGES#Deslike.png"  border="0"></a>' 
                        else
                          'Não é possivel retirar'
                       end remover
                 from(
                select p.idpedido
                     , p.numeropedido
                     , favorita.pck_util_fav.fnc_nomefilialromance( p.idfilialromance ) filialromance
                     , favorita.pck_util_fav.fnc_nomerepresentante( p.idrepresentante ) representante
                     , favorita.pck_util_fav.fnc_nomevendedora( p.idvendedora ) vendedora
                     , favorita.pck_util_fav.fnc_nomeproduto( i.idproduto , :P0_IDIDIOMA, 'S') nomeproduto
                     , i.quantidade
                     , p.idsituacaocobranca
                     , p.idpedidowidecommerce
                     , i.iditempedido 
                     , ( select favorita.pck_util_fav.fnc_formapagamento(c.idvalorcaracteristica)
                           from favorita.classificacoespedidos c
                          where c.idpedido = p.idpedido
                            and c.idcaracteristicapedido = 8 ) formapagamento
                     , case
                         when p.idsituacaoentrega not in (50) then
                           favorita.pck_util_fav.fnc_situacaoentrega( p.idsituacaoentrega
                                                                    , 'I'
                                                                    , :P0_IDIDIOMA )
                         when ( select count(1)
                                from favorita.itenspedidos ip
                                   , favorita.classificacoespedidos cp
                                where ip.idpedido = cp.idpedido
                                and cp.idcaracteristicapedido in (8, 13)
                                and ip.idpedido = p.idpedido ) > 0 then favorita.pck_util_fav.fnc_situacaoentrega( p.idsituacaoentrega
                                                                                                          , 'I'
                                                                                                          , :P0_IDIDIOMA)||' não finalizado.'
                         when ( select count(1)
                                from favorita.itenspedidos ip
                                where ip.idpedido = p.idpedido ) > 0 then favorita.pck_util_fav.fnc_situacaoentrega( p.idsituacaoentrega
                                                                                                          , 'I'
                                                                                                          , :P0_IDIDIOMA)||' com itens.'
                         when ( select count(1)
                                from favorita.itenspedidos ip
                                where ip.idpedido = p.idpedido ) = 0 then favorita.pck_util_fav.fnc_situacaoentrega( p.idsituacaoentrega
                                                                                                          , 'I'
                                                                                                          , :P0_IDIDIOMA)||' sem itens.'
                       end situacaoentregainterno
                from favorita.itenspedidos i
                   , favorita.pedidos p
                where p.idpedido = i.idpedido
                  and i.idestoque = :P224_IDESTOQUE
                  and exists ( select 1
                               from favorita.situacoesentrega s
                               where s.idsituacaoentrega = p.idsituacaoentrega
                                 and s.reservaestoque    = 'S' )
                  and not exists ( select 1
                                   from favorita.classificacoespedidos c
                                   where c.idpedido = p.idpedido
                                     and c.idcaracteristicapedido = 25 )
                  and p.datacancelamento  is null
                  and p.dataemissao >= to_date('01/01/2024 00:00:00','DD/MM/RRRR HH24:MI:SS')
                  and (nvl(:P224_TRANSITO,'N') = 'N' or nvl(:P224_TRANSITO,'N') = 'S' and p.idsituacaoentrega in (50000,55000))
                  and (nvl(:P224_RESERVADO,'N') = 'N' or nvl(:P224_RESERVADO,'N') = 'S' and p.idsituacaoentrega in (10000,20000, 30000, 31000, 35000))
                order by 2
                )
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
