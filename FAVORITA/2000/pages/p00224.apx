    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function irparapedido(idpedido){
                
                var session =  &APP_SESSION.
                console.log(session);
                vurl = 'http://186.193.170.2:8585/apex/f?p=2000:68:'+session+'::NO::P68_IDPEDIDO:'+idpedido;
                pjan = window.open(vurl,'_blank'); void(0);
                pjan.focus();
                
            }
            
            function fnc_removeritem(pid)
            {
              document.getElementById("P224_IDEDITAR").value = pid;
              apex.submit('REMOVER');
            }
            ```
