    region reservado-nas-transferências (
        name: Reservado nas Transferências
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':74:'||v('APP_SESSION')||'::NO::P74_IDCOMPRATRANSFERENCIA:'||c.idcompratransferencia ,'SESSION')||''',''_blank''); void(0)">'||c.numero||'</a>' numero
                     , favorita.pck_util_fav.fnc_retornatipocomptransrem(c.idtipocomptransrem,:P0_IDIDIOMA) desctipo
                     , favorita.pck_util_fav.fnc_nomefilialfavorita(c.idfilialfavoritaorigem) filialfavoritaorigem
                     , favorita.pck_util_fav.fnc_nomefilialfavorita(c.idfilialfavoritadestino) filialfavoritadestino
                     , favorita.pck_util_fav.fnc_retornasitcompratransf(c.idsituacao,:P0_IDIDIOMA) situacao
                     , favorita.pck_util_fav.fnc_nomeprodutodetalhado( ic.idprodutodetalhado , :P0_IDIDIOMA) nomeprodutodetalhado
                     , case 
                         when ic.quantidadecomprada = 0 then
                           ic.quantidadedevolvida
                       else
                         ic.quantidadecomprada
                       end quantidadecomprada
                from favorita.comprastransferencias c
                   , favorita.itenscomprastransferencias ic
                where c.idcompratransferencia = ic.idcompratransferencia
                  and ic.idestoquefilorigem   = :P224_IDESTOQUE
                  and ( exists ( select 1
                                 from favorita.situacoescomprastransferencias sc
                                 where sc.idsituacaocompratransf = c.idsituacao
                                   and sc.estoquereservado       = 'S' )
                  and not exists ( select 1
                                   from favorita.movimentosestoques m
                                   where m.iditemcompratransf = ic.iditemcompratransferencia
                                   and m.idestoque            = ic.idestoquefildestino ) )
                  and (nvl(:P224_TRANSITO,'N') = 'N' or nvl(:P224_TRANSITO,'N') = 'S' and c.idsituacao in (20,30))
                  and (nvl(:P224_RESERVADO,'N') = 'N' or nvl(:P224_RESERVADO,'N') = 'S' and c.idsituacao in (0,3,5,7))
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
