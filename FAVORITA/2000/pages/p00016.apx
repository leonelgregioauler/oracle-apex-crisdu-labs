page 16 (
    name: Cadastro de Filiais Favorita
    title: Filiais Favorita
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        height: 580
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filiais-favorita (
        name: Filiais Favorita
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P16_ATIVO (
        type: radioGroup
        label {
            label: Situação
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-situacao
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @filiais-favorita
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: S
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P16_CEP (
        type: textField
        label {
            label: CEP
            alignment: left
        }
        layout {
            sequence: 50
            region: @filiais-favorita
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            customAttributes: "onkeyPress=\"javascript:{formatar_mascara(this, '##.###-###',event); }\"; onblur=\"javascript:{formataCEP(this); }\" ;"
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P16_DATA_INAUGURACAO (
        type: datePicker
        label {
            label: Dt. Inauguração
            alignment: left
        }
        layout {
            sequence: 150
            region: @filiais-favorita
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 30
        }
        help {
            helpText: Informe quando a loja foi inaugurada. Use o formato DD/MM/AAAA. Este dado é importante para histórico comercial e relatórios.
        }
    )

    pageItem P16_IDEMPRESAVIRTUALAGE (
        type: selectList
        label {
            label: Empresa Virtual
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'ID: '||e.idempresavirtualage||' - '||e.nome||' CNPJ: '||e.cnpj d
                     , e.idempresavirtualage r
                from empresasvirtualage e
                order by 2
                ```
        }
        layout {
            sequence: 110
            region: @filiais-favorita
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P16_IDFILIALANTIGO (
        type: hidden
        layout {
            sequence: 80
            region: @filiais-favorita
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P16_IDFILIALFAVORITA (
        type: hidden
        layout {
            sequence: 10
            region: @filiais-favorita
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P16_IDFILIALROMANCE (
        type: hidden
        layout {
            sequence: 30
            region: @filiais-favorita
            slot: regionBody
        }
        default {
            type: static
            staticValue: 200
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P16_IDGERENTE (
        type: selectList
        label {
            label: Gerente
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' - '||roman.pck_romance.fnc_nomefilial(g.idfilial) gerente
                     , g.idgerente
                from gerentes g 
                   , pessoas p
                where p.idpessoa = g.idpessoa
                  and g.ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 120
            region: @filiais-favorita
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P16_IDPAIS (
        type: selectList
        label {
            label: País
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome as d
                     , idpais as r
                from catal.paises
                ```
            nullDisplayValue: - Selecione o País -
        }
        layout {
            sequence: 70
            region: @filiais-favorita
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P16_IDREGIONALFAVORITA (
        type: selectList
        label {
            label: Regional
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.descricaoregionalfavorita display_value,
                       f.idregionalfavorita return_value
                  from favorita.regionaislojasfavorita f
                 order by f.descricaoregionalfavorita;
                ```
        }
        layout {
            sequence: 140
            region: @filiais-favorita
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P16_MD5 (
        type: hidden
        layout {
            sequence: 90
            region: @filiais-favorita
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P16_METRAGEM_EXPOSICAO_LOJA (
        type: textField
        label {
            label: Metragem Exposição Loja
            alignment: left
        }
        layout {
            sequence: 170
            region: @filiais-favorita
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P16_METRAGEM_TOTAL_LOJA (
        type: textField
        label {
            label: Metragem Total Loja
            alignment: left
        }
        layout {
            sequence: 160
            region: @filiais-favorita
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P16_NOMEFILIALFAVORITA (
        type: textField
        label {
            label: Filial Favorita
            alignment: left
        }
        layout {
            sequence: 20
            region: @filiais-favorita
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P16_OPERACAO_DML (
        type: hidden
        layout {
            sequence: 100
            region: @filiais-favorita
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P16_TIPOFILIAL (
        type: selectList
        label {
            label: Tipo Filial
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-tipofilial
            nullDisplayValue: " - Selecione o Tipo Filial - "
        }
        layout {
            sequence: 60
            region: @filiais-favorita
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P16_TIPOLOJA (
        type: selectList
        label {
            label: Tipo da Loja
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Tradicional;T,Express;E,Upgrade;U
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 130
            region: @filiais-favorita
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 60
            region: @filiais-favorita
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P16_IDFILIALFAVORITA
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 50
            region: @filiais-favorita
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P16_IDFILIALFAVORITA
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 40
            region: @filiais-favorita
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 15
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 30
            region: @filiais-favorita
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P16_IDFILIALFAVORITA
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 20
            region: @filiais-favorita
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P16_IDFILIALFAVORITA
        }
    )

    validation cep-válido (
        name: CEP válido
        execution {
            sequence: 20
        }
        validation {
            type: itemMatchesRegexp
            item: P16_CEP
            regexp: "\\d{2}.\\d{3}-\\d{3}"
        }
        error {
            errorMessage: CEP inválido. Informe um CEP válido no formato: 00.000-000
            associatedItem: @P16_CEP
        }
    )

    validation filialfavorita-obrigatório (
        name: FILIALFAVORITA obrigatório
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P16_NOMEFILIALFAVORITA
        }
        error {
            errorMessage: Filial Favorita deve ter um valor.
            associatedItem: @P16_NOMEFILIALFAVORITA
        }
    )

    validation pais-obrigatório (
        name: PAIS obrigatório
        execution {
            sequence: 40
        }
        validation {
            type: itemIsNotNull
            item: P16_IDPAIS
        }
        error {
            errorMessage: País deve ter um valor.
        }
    )

    validation tipofilial-obrigatório (
        name: TIPOFILIAL obrigatório
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P16_TIPOFILIAL
        }
        error {
            errorMessage: Tipo Filial deve ter um valor.
            associatedItem: @P16_TIPOFILIAL
        }
    )

    process consulta-filiais-favorita (
        name: Consulta Filiais Favorita
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                #OWNER#.PCK_CADASTROS_FAV.PRC_FILIAISFAVORITA (
                  PIDFILIALFAVORITA => :P16_IDFILIALFAVORITA,
                  PNOMEFILIALFAVORITA => :P16_NOMEFILIALFAVORITA,
                  PIDFILIALROMANCE => :P16_IDFILIALROMANCE,
                  PATIVO => :P16_ATIVO,
                  PIDFILIALANTIGO => :P16_IDFILIALANTIGO,
                  PCEP => :P16_CEP,
                  PTIPOFILIAL => :P16_TIPOFILIAL,
                  PIDPAIS => :P16_IDPAIS,
                  PIDEMPRESAVIRTUALAGE => :P16_IDEMPRESAVIRTUALAGE,
                  PIDGERENTE => :P16_IDGERENTE,
                  PTIPOLOJA => :P16_TIPOLOJA,
                  PMD5 => :P16_MD5,
                  POPERACAO_DML => 'S',
                  PIDREGIONALFAVORITA => :P16_IDREGIONALFAVORITA,
                  PDATA_INAUGURACAO => :P16_DATA_INAUGURACAO,
                  PMETRAGEM_TOTAL_LOJA => :P16_METRAGEM_TOTAL_LOJA,
                  PMETRAGEM_EXPOSICAO_LOJA => :P16_METRAGEM_EXPOSICAO_LOJA  );
                  
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 3154840458485028
        }
    )

    process limpar-campos-ao-sair (
        name: Limpar Campos ao Sair
        type: clearSessionState
        execution {
            sequence: 10
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 3155950305485039
        }
    )

    process limpar-campos-para-adicionar (
        name: Limpar Campos para Adicionar
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 3156052062485040
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    process operação-dml-em-filiais-favorita (
        name: Operação DML em Filiais Favorita
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  #OWNER#.PCK_CADASTROS_FAV.PRC_FILIAISFAVORITA (
                    PIDFILIALFAVORITA => :P16_IDFILIALFAVORITA,
                    PNOMEFILIALFAVORITA => :P16_NOMEFILIALFAVORITA,
                    PIDFILIALROMANCE => :P16_IDFILIALROMANCE,
                    PATIVO => :P16_ATIVO,
                    PIDFILIALANTIGO => :P16_IDFILIALANTIGO,
                    PCEP => :P16_CEP,
                    PTIPOFILIAL => :P16_TIPOFILIAL,
                    PIDPAIS => :P16_IDPAIS,
                    PIDEMPRESAVIRTUALAGE => :P16_IDEMPRESAVIRTUALAGE,
                    PIDGERENTE => :P16_IDGERENTE,
                    PTIPOLOJA => :P16_TIPOLOJA,
                    PMD5 => :P16_MD5,
                    POPERACAO_DML => voperacao_dml,
                    PIDREGIONALFAVORITA => :P16_IDREGIONALFAVORITA,
                    PDATA_INAUGURACAO => :P16_DATA_INAUGURACAO,
                    PMETRAGEM_TOTAL_LOJA => :P16_METRAGEM_TOTAL_LOJA,
                    PMETRAGEM_EXPOSICAO_LOJA => :P16_METRAGEM_EXPOSICAO_LOJA  );
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 3195453057251580
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 16
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

)

