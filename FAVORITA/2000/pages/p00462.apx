    region lista-de-itens (
        name: Lista de Itens
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.iditempedido,
                       i.idprodutodetalhado,
                       pck_util_fav.fnc_nomeprodutodetalhado(i.idprodutodetalhado,1) as nome,
                       i.quantidade,
                       i.quantidade * valorvenda as vlr_tot_venda,
                       i.valordesconto,
                       i.valorapagar,       
                       i.valorcomissaoconsultora,
                       i.valorcomissaogerente,
                       i.valorcomissaodistribuidor,
                      -- '<a href="javascript:fnc_altera_qtd('||i.iditempedido||');"><span aria-hidden="true" class="fa fa-exchange fa-2x"></span></a>' as ALTERAR_QTD,
                       '<a href="javascript:fnc_remove_item('||i.iditempedido||');" class="vermelho"><span class="fa fa-remove fa-2x" aria-hidden="true"></span></a>' as deletar_item
                       /*i.perccomissaogerente,
                       i.perccomissaodistribuidor,
                       i.perccomissaoconsultora,
                       i.valorcusto*/
                from itenspedidos i
                where i.idpedido = :P462_IDPEDIDO
                order by i.iditempedido
                ```
        }
        layout {
            sequence: 30
            parentRegion: @ajustar-valor-do-pedido
            slot: subRegions
        }
