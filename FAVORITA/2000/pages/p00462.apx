            type: sqlQuery
            sqlQuery:
                ```sql
                select c.numero||' - '||'Origem = '||pck_util_fav.fnc_nomefilialfavorita(c.idfilialfavoritaorigem)||' / Destino = '||roman.pck_romance.fnc_nomefilial(c.idfilialromancedestino) d
                     , c.idcompratransferencia
                from comprastransferencias c
                where c.idcompratransferencia = :P462_IDREMESSA
