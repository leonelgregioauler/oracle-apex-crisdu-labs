    pageItem P462_COMPRECONAEDICAO (
        type: textField
        label {
            label: Preço na Edição
            alignment: left
        }
        layout {
            sequence: 40
            region: @produtos-epicom
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select distinct nvl('Sim','N') 
                from favorita.precosprodutos pdr  
                   , favorita.produtos p
                   , favorita.produtosdetalhados pd
                where p.idproduto = pd.idproduto
                  and pd.idprodutodetalhado = pdr.idprodutodetalhado
                  and pdr.idfilialromance = 100
                  and pdr.idedicaorevista = :P462_IDEDICAO
                  and p.referencia = :P462_REFERENCIAS;
                ```
            used: always
        }
        default {
            type: static
            staticValue: Não
        }
        security {
            encryptSessionState: false
        }
    )

