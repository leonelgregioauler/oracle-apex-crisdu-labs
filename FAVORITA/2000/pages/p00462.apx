    process alterar-empresa-virtual (
        name: Alterar empresa virtual
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update favorita.pedidos p
                   set p.idempresavirtualage = :P462_IDEMPRESAVIRTUALAGE 
                     , p.idpedidovirtualage = null
                     , p.mensagemintegracao = null
                  where p.idpedido = :P462_IDPEDIDO;
                  --
                end;
                ```
        }
        execution {
            sequence: 190
        }
        advanced {
            executionMappingIdentifier: 5393993385652515924
        }
        serverSideCondition {
            type: request=Value
            value: ALTERAR_EMPRESA_VIRTUAL
        }
    )

    process alterar-qtd-indisponível (
        name: Alterar Qtd indisponível
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                Begin
                  --
                  update favorita.itensindisponiveispedidos i
                  set i.quantidade = :P462_QUANTIDADE
                  where i.iditempedido = :P462_INDISPONIVEL_ALTERAR;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 180
        }
        successMessage {
            successMessage: Alterado com Sucesso
        }
        error {
            errorMessage: Erro ao alterar quantidade
        }
        advanced {
            executionMappingIdentifier: 5129027076621166424
        }
        serverSideCondition {
            type: request=Value
            value: ALTERAR_INDISPONIVEL
        }
    )

    process atualiza-preço (
        name: Atualiza preço
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Created on 03/06/2020 by MAX.BERKEUER 
                declare 
                  --
                  vid_pedido number := :P462_IDPEDIDO;
                  vid_item_pedido number := :P462_IDITEMPEDIDO;
                  --
                  v_valorvenda number;
                  v_valorcusto number;
                  v_perccomissaogerente number;
                  v_perccomissaodistribuidor number;
                  v_perccomissaoconsultora number;
                  --
                  v_tot_item number;
                  v_valor_comi_consultora number;
                  v_valor_comi_gere number;
                  v_valor_comi_distri number;
                  v_desconto number;
                  v_valorapagar number;
                  vid_filial_romance number;
                  vid_edicao_revista number;
                  --
                  vcount number := 0;
                  --
                begin
                  --
                  select p.idfilialromance,
                         p.idedicaorevista
                  into vid_filial_romance,
                       vid_edicao_revista
                  from pedidos p
                  where p.idpedido = vid_pedido;
                  --
                  for c in (select *
                           from itenspedidos i
                           where i.idpedido = vid_pedido
                           and i.iditempedido = vid_item_pedido)
                  loop
                    --
                    select p.valorvenda,
                           p.valorcusto,
                           p.perccomissaogerente,
                           p.perccomissaodistribuidor,
                           p.perccomissaoconsultora
                    into v_valorvenda,
                         v_valorcusto,
                         v_perccomissaogerente,
                         v_perccomissaodistribuidor,
                         v_perccomissaoconsultora
                    from precosprodutos p
                    where p.idfilialromance = vid_filial_romance
                    and p.idedicaorevista = vid_edicao_revista
                    and p.idprodutodetalhado = c.idprodutodetalhado;
                    --
                    v_tot_item := c.quantidade * c.valorvenda;
                    v_valor_comi_consultora := (v_tot_item * v_perccomissaoconsultora ) /100;
                    v_valor_comi_gere := ((v_tot_item - v_valor_comi_consultora) * v_perccomissaogerente) /100;
                    v_valor_comi_distri := ((v_tot_item - v_valor_comi_consultora) * v_perccomissaodistribuidor) /100;
                    v_desconto := v_valor_comi_consultora;
                    v_valorapagar := v_tot_item - v_valor_comi_consultora;
                    --
                    update itenspedidos i
                    set i.valorvenda = v_valorvenda,
                        i.valorcusto = v_valorcusto,
                        i.perccomissaogerente = v_perccomissaogerente,
                        i.perccomissaodistribuidor = v_perccomissaodistribuidor,
                        i.perccomissaoconsultora  = v_perccomissaoconsultora,
                        i.valorcomissaoconsultora = v_valor_comi_consultora,
                        i.valorcomissaogerente = v_valor_comi_gere,
                        i.valorcomissaodistribuidor = v_valor_comi_distri,
                        i.valordesconto = v_desconto,
                        i.valordescontovirtualage = v_desconto,
                        i.valorapagar = v_valorapagar
                    where i.iditempedido = c.iditempedido;
                    --
                    vcount := vcount + 1;
                    --
                  end loop;
                  --
                  apex_application.g_print_success_message := 'Nr registros afetados - '||vcount;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 62640140724605940
        }
        serverSideCondition {
            type: request=Value
            value: ATUALIZAR_PRECO
        }
    )

