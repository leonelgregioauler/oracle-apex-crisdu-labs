    process prorrogar-pedido (
        name: Prorrogar Pedido
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidvencimentopedido     number := :P462_VENCIMENTOS;
                  vidsituacao             number;
                  vvalorpago              number; -- valor
                  vdatavencimentonova     date := :P462_DATA_PEDIDO;   -- data nova recebida da tela
                  vidvencimentopedidonovo number; -- variavel que guarda o idvencimento novo que sera gerado
                  --  
                  vidformapagamento       number;
                  vidsituacaopagamento    number;
                  vdatapagamento          date;
                  vorigempagamento        varchar2(5);
                  vnumeroboleto           number;
                  vcpf                    number;
                  vidvendedora            number;
                  vlinkboleto             varchar2(4000);
                  vidpagamentopedido      number;
                  vidcontrolearquivobanco number;
                  vsituacaoarq            varchar2(1);
                  vatualizasit            number;
                  vdataclassificado       date;
                  vclobnull               clob;
                  vidpagamentonegociacao  number := null;
                  vidconveniobanco        number;
                  --
                  vnumnull            number;
                  vmd5                varchar2(4000);
                  vdatenull           date;
                  --
                begin
                  --
                  for rvenc in ( select v.*
                                 from vencimentospedidos v
                                 where v.idvencimentopedido = vidvencimentopedido
                                   and v.situacaovencimento = 'V')
                  --
                  loop
                    --
                    select p.idvendedora
                    into vidvendedora
                    from favorita.pedidos p
                    where p.idpedido = rvenc.idpedido;
                    --
                    -- cancela o vencimento escolhido
                    --
                    update vencimentospedidos vp
                    set vp.situacaovencimento = 'C'
                    where idvencimentopedido = rvenc.idvencimentopedido;
                    --
                    -- cancela todos os pagamentos ligados ao vencimento escolhido 
                    --
                    for rpgto in ( select *
                                   from pagamentospedidos p
                                   where p.idvencimentopedido = rvenc.idvencimentopedido )
                    --
                    loop
                      --
                      -- cancela o pagamentos pendentes
                      --
                      vidsituacao         := -1;-- cancelado
                      --
                      pck_pedidos_fav.prc_pagamentospedidos( pidpagamentopedido   => rpgto.idpagamentopedido
                                                           , pidvencimentopedido  => rvenc.idvencimentopedido
                                                           , pidformapagamento    => rpgto.idformapagamento
                                                           , pdatapagamento       => rpgto.datapagamento
                                                           , pvalorpago           => rpgto.valorpago
                                                           , porigempagamento     => rpgto.origempagamento
                                                           , pnumeroboleto        => rpgto.numeroboleto
                                                           , pidsituacao          => vidsituacao
                                                           , ptaxa                => vnumnull
                                                           , pjuros               => vnumnull
                                                           , pacrescimo           => vnumnull
                                                           , pdesconto            => vnumnull
                                                           , pvalorliquido        => vnumnull
                                                           , pnumerocomprovante   => vnumnull
                                                           , pidcontabancaria     => vnumnull
                                                           , pobservacao          => vnumnull
                                                           , pidusuariopagamento  => vnumnull
                                                           , pidusuarionegociacao => vnumnull
                                                           , penviooperadora      => null
                                                           , pretornooperadora    => null
                                                           , poperacao_dml        => 'U'
                                                           , pmd5                 => vmd5 );
                      --
                      vnumnull  := null;
                      vdatenull := null;
                      --
                      --
                      /*pck_integracao_fav.prc_controlearquivosbanco( pidcontrolearquivobanco => vnumnull
                                                                  , pidpagamentopedido      => rpgto.idpagamentopedido
                                                                  , psituacaobanco          => vnumnull
                                                                  , patualizacaositbanco    => vnumnull
                                                                  , pdataprocessado         => vdatenull
                                                                  , poperacao_dml           => 'I'
                                                                  , pmd5                    => vmd5
                                                                  , pidpagamentocomptransf  => vnumnull);*/
                      --
                      --
                      -- encerra loop de pagamentos sendo cancelados
                      --
                    end loop;
                    --
                    vvalorpago := 0;
                    --
                    vnumnull   := null;
                    --
                    -- gera o novo vencimento 
                    --
                    pck_pedidos_fav.prc_vencimentospedidos( pidvencimentopedido  => vidvencimentopedidonovo
                                                          , pidpedido            => rvenc.idpedido
                                                          , pdatavencimento      => vdatavencimentonova
                                                          , pvalorpagar          => rvenc.valorpagar
                                                          , pvalorpago           => vvalorpago
                                                          , poperacao_dml        => 'I'
                                                          , pmd5                 => vmd5 );
                    --
                    -- ja que e pagamento em boleto, gera o vencimento
                    -- e previsao de pagamento
                    --
                    vidsituacaopagamento := 10;
                    vdatapagamento       := null;
                    vvalorpago           := 0;
                    vorigempagamento     := 'S';
                    --
                    -- gera o numero do boleto
                    --
                    select seq_numeroboleto.nextval
                    into vnumeroboleto
                    from dual;
                    --
                    -- gera link do boleto
                    --
                    begin
                      --
                      vcpf := roman.pck_romance.fnc_cpfvendedora(vidvendedora);
                      --
                      vlinkboleto := 'https://www63.bb.com.br/portalbb/boleto/boletos/hc21e,802,3322,10343.bbx?nrSacado=%(CPF)s&nrNossoNumero=%(NN)s';
                      --
                      vlinkboleto := replace(vlinkboleto,'%(CPF)',vcpf);
                      vlinkboleto := replace(vlinkboleto,'%(NN)',vnumeroboleto);
                      --
                    exception
                      when others then
                        vlinkboleto := null;
                    end;
                    --
                    -- se for pagamento so não quitados
                    -- 
                    vidsituacaopagamento := 10;
                    vdatapagamento       := null;
                    vvalorpago           := 0;
                    vorigempagamento     := 'S';
                    vidformapagamento    := 1;
                    --
                    pck_pedidos_fav.prc_pagamentospedidos( pidpagamentopedido   => vidpagamentopedido
                                                         , pidvencimentopedido  => vidvencimentopedidonovo
                                                         , pidformapagamento    => vidformapagamento
                                                         , pdatapagamento       => vdatapagamento
                                                         , pvalorpago           => vvalorpago
                                                         , porigempagamento     => vorigempagamento
                                                         , pnumeroboleto        => vnumeroboleto
                                                         , pidsituacao          => vidsituacaopagamento
                                                         , ptaxa                => vnumnull
                                                         , pjuros               => vnumnull
                                                         , pacrescimo           => vnumnull
                                                         , pdesconto            => vnumnull
                                                         , pvalorliquido        => vnumnull
                                                         , pnumerocomprovante   => vnumnull
                                                         , pidcontabancaria     => vnumnull
                                                         , pobservacao          => vnumnull
                                                         , pidusuariopagamento  => vnumnull
                                                         , pidusuarionegociacao => vnumnull
                                                         , penviooperadora      => vclobnull
                                                         , pretornooperadora    => vclobnull
                                                         , plinkboleto          => vlinkboleto
                                                         , poperacao_dml        => 'I'
                                                         , pmd5                 => vmd5  );
                    --
                    -- alterado para gerar em todos os casos pelo evento  2186629
                    --
                    vidcontrolearquivobanco := null;
                    vsituacaoarq            := 'A';
                    vatualizasit            := 1;
                    vdataclassificado       := sysdate;
                    --
                    /*pck_integracao_fav.prc_controlearquivosbanco(pidcontrolearquivobanco => vidcontrolearquivobanco,
                                                                 pidpagamentopedido      => vidpagamentopedido,
                                                                 psituacaobanco          => vsituacaoarq,
                                                                 patualizacaositbanco    => vatualizasit,
                                                                 pdataprocessado         => vdataclassificado, 
                                                                 pidpagamentonegociacao  => vidpagamentonegociacao,
                                                                 pidconveniobanco        => vidconveniobanco, 
                                                                 poperacao_dml           => 'I',
                                                                 pmd5                    => vmd5,
                                                                 pidpagamentocomptransf  => vnumnull );*/
                    --
                  end loop;
                  --
                end;
                ```
        }
        execution {
            sequence: 200
        }
        advanced {
            executionMappingIdentifier: 5885332447964271017
        }
        serverSideCondition {
            type: request=Value
            value: PRORROGAR_PEDIDO
        }
    )

    process recalcular (
        name: Recalcular
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Created on 03/06/2020 by MAX.BERKEUER 
                declare 
                  --
                  vid_pedido number := :P462_IDPEDIDO;
                  vid_item_pedido number := :P462_IDITEMPEDIDO;
                  --
                  v_valorvenda number;
                  v_valorcusto number;
                  v_perccomissaogerente number;
                  v_perccomissaodistribuidor number;
                  v_perccomissaoconsultora number;
                  --
                  v_tot_item number;
                  v_valor_comi_consultora number;
                  v_valor_comi_gere number;
                  v_valor_comi_distri number;
                  v_desconto number;
                  v_valorapagar number;
                  vid_filial_romance number;
                  vid_edicao_revista number;
                  --
                  vcount number := 0;
                  --
                begin
                  --
                  select p.idfilialromance,
                         p.idedicaorevista
                  into vid_filial_romance,
                       vid_edicao_revista
                  from pedidos p
                  where p.idpedido = vid_pedido;
                  --
                  for c in (select *
                           from itenspedidos i
                           where i.idpedido = vid_pedido
                           and i.iditempedido = vid_item_pedido)
                  loop
                    --
                    v_valorvenda := nvl(:P462_VALORVENDA,c.valorvenda);
                    v_valorcusto := c.valorcusto;
                    v_perccomissaogerente := c.perccomissaogerente;
                    v_perccomissaodistribuidor := c.perccomissaodistribuidor; 
                    v_perccomissaoconsultora := c.perccomissaoconsultora;
                    --
                    v_tot_item := c.quantidade * c.valorvenda;
                    v_valor_comi_consultora := (v_tot_item * v_perccomissaoconsultora ) /100;
                    v_valor_comi_gere := ((v_tot_item - v_valor_comi_consultora) * v_perccomissaogerente) /100;
                    v_valor_comi_distri := ((v_tot_item - v_valor_comi_consultora) * v_perccomissaodistribuidor) /100;
                    v_desconto := v_valor_comi_consultora;
                    v_valorapagar := v_tot_item - v_valor_comi_consultora;
                    --
                    update itenspedidos i
                    set i.valorvenda = v_valorvenda,
                        i.valorcusto = v_valorcusto,
                        i.perccomissaogerente = v_perccomissaogerente,
                        i.perccomissaodistribuidor = v_perccomissaodistribuidor,
                        i.perccomissaoconsultora  = v_perccomissaoconsultora,
                        i.valorcomissaoconsultora = v_valor_comi_consultora,
                        i.valorcomissaogerente = v_valor_comi_gere,
                        i.valorcomissaodistribuidor = v_valor_comi_distri,
                        i.valordesconto = v_desconto,
                        i.valordescontovirtualage = v_desconto,
                        i.valorapagar = v_valorapagar
                    where i.iditempedido = c.iditempedido;
                    --
                    vcount := vcount + 1;
                    --
                  end loop;
                  --
                  apex_application.g_print_success_message := 'Nr registros afetados - '||vcount;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 62640977087605948
        }
        serverSideCondition {
            type: request=Value
            value: RECALCULAR
        }
    )

    process reintegrar-pedidos-novo (
        name: Reintegrar Pedidos Novo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Created on 06/03/2023 by GUILHERME.DREHMER 
                declare 
                  -- Local variables here
                  i integer;
                begin
                  -- Test statements here
                  for i in ( select *
                             from pedidos p
                             where exists ( select 1
                                            from favorita.pedidosremessasct pp
                                            where pp.idpedido = p.idpedido
                                              and pp.idcompratransferencia = :P462_IDREMESSA ) )
                  loop
                    --
                    delete classificacoespedidos cp
                    where cp.idpedido = i.idpedido
                      and cp.idcaracteristicapedido = 43;
                    --
                    update pedidos p
                    set p.idpedidovirtualage = null
                      , p.dataintegracao = null
                      , p.mensagemintegracao = null
                      , p.idempresavirtualage = :P462_IDEMPRESA_NOVA
                    where p.idpedido = i.idpedido;
                    --
                    commit;
                    --
                  end loop;
                end;
                ```
        }
        execution {
            sequence: 210
        }
        successMessage {
            successMessage: Pedidos Enviados para a Fila de Integração!
        }
        advanced {
            executionMappingIdentifier: 144354295672122419
        }
        serverSideCondition {
            type: request=Value
            value: REINTEGRAR_PEDIDOS
        }
    )

    process reintegrar-pedidos-remessas (
        name: Reintegrar pedidos/remessas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Created on 22/09/2020 by MAX.BERKEUER 
                declare 
                  --
                  vstring_rem varchar2(1000) := :P462_CODIGOS;
                  vtipo number := :P462_TP_REINTEGRAR;
                  --
                begin
                  --
                  for cc in (select a.column_value as id_remessa_pedido
                            from table(pck_util_fav.fnc_array_to_table(vstring_rem)) a)
                  loop
                    --
                    if vtipo = 1 then /*Reintegra pedidos*/
                      --
                      for c in (select p.idpedido
                               from pedidos p
                               where p.idpedido = cc.id_remessa_pedido)
                      loop
                        --
                        pck_virtualage_fav.prc_operacao_fiscal(c.idpedido);
                        --
                        /*Remove a característica de integrado com virtual age dos pedidos de uma remessa especifica*/
                        delete from favorita.classificacoespedidos cpe
                        where cpe.idpedido = c.idpedido
                        and cpe.idcaracteristicapedido = 43;
                        --
                        update favorita.pedidos ped
                        set ped.idpedidovirtualage = null
                          , ped.mensagemintegracao = null
                        where ped.idpedido = c.idpedido;
                        --
                      end loop;      
                      --
                    elsif vtipo = 2 then  /*Reintegra remessas*/
                      --
                      for c in (select p.idpedido
                               from pedidosremessasct p
                               where p.idcompratransferencia = cc.id_remessa_pedido)
                      loop
                        --
                        pck_virtualage_fav.prc_operacao_fiscal(c.idpedido);
                        --
                        /*Remove a característica de integrado com virtual age dos pedidos de uma remessa especifica*/
                        delete from favorita.classificacoespedidos cpe
                        where cpe.idpedido = c.idpedido
                        and cpe.idcaracteristicapedido = 43;
                        --
                        update favorita.pedidos ped
                        set ped.idpedidovirtualage = null
                          , ped.mensagemintegracao = null
                        where ped.idpedido = c.idpedido;
                        --
                      end loop;
                      --
                    end if;
                    --
                  end loop;
                  --
                  apex_util.set_session_state(p_name => 'P462_CODIGOS',p_value => null);
                  apex_util.set_session_state(p_name => 'P462_TP_REINTEGRAR',p_value => null);  
                  --
                end;
                
                ```
        }
        execution {
            sequence: 100
        }
        successMessage {
            successMessage: Ação Processada!
        }
        advanced {
            executionMappingIdentifier: 4708247135063221716
        }
        serverSideCondition {
            type: request=Value
            value: REINTEGRAR
        }
    )

