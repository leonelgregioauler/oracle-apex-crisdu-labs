page 462 (
    name: Manutenções Gerais
    title: Manutenções Gerais
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG_24"';
            
            function fnc_remove_indisponivel(pid_itempedido) {
              apex.confirm("Deseja remover esse item indisponivel? Não é possivel desfazer o processo.", {
                request:"REMOVER_INDISPONIVEL",
                set:{"P462_ID_INDISPONIVEL_REMOVER":pid_itempedido},
                showWait:true
                });  
            }
            
            function fnc_remove_item(pid_itempedido) {
              apex.confirm("Deseja remover esse item? Não é possivel desfazer o processo.", {
                request:"REMOVER_ITEM",
                set:{"P462_ID_ITEM_REMOVER":pid_itempedido},
                showWait:true
                });  
            }
            
            function fnc_altera_qtd(pid_itempedido) {
              apex.confirm("Deseja remover esse item indisponivel? Não é possivel desfazer o processo.", {
                request:"ALTERAR_INDISPONIVEL",
                set:{"P462_INDISPONIVEL_ALTERAR":pid_itempedido},
                showWait:true
                });  
            }
            
            
            ```
    }

