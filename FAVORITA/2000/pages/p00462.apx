    region remessas-filtradas (
        name: Remessas Filtradas
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idcompratransferencia as "idremessa",
                       c.numero as "Número",
                       pck_util_fav.fnc_nomefilialromance(c.idfilialromancedestino) as "Destino",
                       decode(c.identificacaointerna,'N','Normal','A','Antecipada') as "Tipo",
                       roman.pck_romance.fnc_nomepostoavancado(c.idpostoavancadodestino) as "Posto Avaçado"
                from comprastransferencias c
                where c.idcompratransferencia in (select column_value
                                                 from table(pck_util_fav.fnc_array_to_table(:P462_CODIGOS)))
                order by c.idcompratransferencia
                                                 
                                                 
                
                ```
            pageItemsToSubmit: P462_CODIGOS
        }
        layout {
            sequence: 10
