    pageItem P462_QTD_PEDIDOS_INTEGRADOS (
        type: numberField
        label {
            label: QTD Pedidos Integrados
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 50
            region: @manutenção-de-remessas
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select count(1)
                from pedidosremessasct p
                where p.idcompratransferencia = :P462_IDREMESSA
                  and exists ( select 1
                               from classificacoespedidos cp
                               where cp.idcaracteristicapedido = 43
                                 and cp.idpedido = p.idpedido )
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

