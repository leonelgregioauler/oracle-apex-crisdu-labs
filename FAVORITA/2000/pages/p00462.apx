                select 'Pagar - '||p.valorpagar||' Vencimento - '||p.datavencimento showvalue
                     , p.idvencimentopedido returnvalue
                from favorita.vencimentospedidos p
                where p.idpedido = :P462_IDPEDIDOPRORROGAR
                  and p.situacaovencimento = 'V'
                  and not exists ( select 1
                                   from favorita.pagamentospedidos pg
                                   where pg.idvencimentopedido = p.idvencimentopedido
                                     and pg.idsituacao = 20);
