    process gerar-financeiro (
        name: Gerar financeiro
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vid_pedido number := :P462_IDPEDIDO;
                  vvlor_total number;
                  vvalor_frete number := nvl(:P462_VLR_FRETE,0);
                  vvalor_desconto number := 0;
                  vvalor_desconto_promo number := 0;
                  vaavlor_pagar number;
                  --
                  valordescontocupom number;
                  --
                  vidusuario number := :P0_IDUSUARIO; /*usuário que vai gerar o parcelamento*/  
                  vid_forma_entrega number;
                  vid_forma_pagamento number;
                  vdata_emissao date;
                  vqtdparcelas number := :P462_NR_PARCELAS; /*Número de parcelas*/
                  l_json CLOB;
                  --
                begin
                  --
                  select sum((i.quantidade * valorvenda)) as vlr_total,
                         sum(i.valorapagar) as valor_pagar
                  into vvlor_total,
                       vaavlor_pagar
                  from itenspedidos i
                  where i.idpedido = vid_pedido;  
                  --
                  select nvl(sum(cc.valordesconto),0)
                  into valordescontocupom 
                  from favorita.cuponsdescontos cc
                      , favorita.classificacoespedidos cl
                      , favorita.codigoscuponsdescontos cp
                  where cp.idcupomdesconto = cc.idcupomdesconto
                    and cp.idcodigocupomdesconto = cl.idvalorcaracteristica
                    and cp.idpedido = vid_pedido
                    and cl.idcaracteristicapedido = 4
                    and cl.idpedido = vid_pedido;
                  --
                  vaavlor_pagar := vaavlor_pagar - valordescontocupom;
                  --
                  pck_integracao_fav_widecomm.prc_calculapedido(pidpedido => vid_pedido,
                                                                pvalortotal => vvlor_total,
                                                                pvalorfrete => vvalor_frete,
                                                                pvalordesconto => vvalor_desconto,
                                                                pvalordescontopromocional => vvalor_desconto_promo,
                                                                pvalorapagar =>vaavlor_pagar);
                  --
                  update favorita.pedidos p
                  set p.valorapagar = vaavlor_pagar
                  where p.idpedido = vid_pedido;
                  --
                  commit;
                  --
                  /*Busca a forma de entrega*/
                  select cl.idvalorcaracteristica
                  into vid_forma_entrega
                  from classificacoespedidos cl
                  where cl.idcaracteristicapedido = 13
                  and cl.idpedido = vid_pedido;
                  --
                  /*Busca a forma de pagamento*/
                  select cl.idvalorcaracteristica
                  into vid_forma_pagamento
                  from classificacoespedidos cl
                  where cl.idcaracteristicapedido = 8
                  and cl.idpedido = vid_pedido;
                  --
                  select trunc(pr.dataentrega + 14)
                  into vdata_emissao
                  from pedidos pr
                  where pr.idpedido = vid_pedido;
                  --
                  if vid_forma_pagamento = 17 then
                    --
                    vid_forma_pagamento := 1;
                    --
                  end if;
                  --
                  begin
                    --
                    /*gera o financeiro*/
                    favorita.pck_pedidos_fav.prc_gerafinanceiropedido(pidpedido => vid_pedido,
                                                                      pidusuario => vidusuario,
                                                                      pidformapagamento => vid_forma_pagamento,
                                                                      pidformaentrega => vid_forma_entrega,
                                                                      pvalorapagar => vaavlor_pagar+vvalor_frete,
                                                                      pqtdparcelas => vqtdparcelas,
                                                                      penviooperadora => null,
                                                                      pretornooperadora => null,
                                                                      pdatavencimento => vdata_emissao,
                                                                      pcomentrada => null,
                                                                      pdatavencimentoentrada => null,
                                                                      pvalorentrada => null,
                                                                      pdiasprazoparcelas => null);
                    --
                  end;  
                  --
                  --processa boletos novos para Brasil
                      FOR r IN (
                        SELECT 
                            t.idpagamentopedido
                        FROM vw_vencimentospedidos_fav v
                        JOIN vw_pagamentospedidos_fav t
                          ON v.idvencimentopedido = t.idvencimentopedido
                        JOIN pedidos p on v.idpedido = p.idpedido
                        WHERE v.idpedido           = :P462_IDPEDIDO
                          AND t.ididioma           = :P0_IDIDIOMA
                          AND p.idpais = 1
                          and v.CODSITUACAOVENCIMENTO = 'V'
                    )
                    LOOP
                
                        BEGIN
                
                            pck_integracao_bb_v2.prc_registra_boleto(
                                p_idpagamentopedido => r.idpagamentopedido,
                                r_json              => l_json
                            );
                
                        EXCEPTION
                            WHEN OTHERS THEN
                
                                DBMS_OUTPUT.PUT_LINE(
                                    'Erro ao reprocessar boleto ' ||
                                    r.idpagamentopedido || ' - ' || SQLERRM
                                );
                
                        END;
                
                    END LOOP;
                
                  --
                end;
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 4708246569981221710
        }
        serverSideCondition {
            type: request=Value
            value: FINANCEIRO
        }
    )

