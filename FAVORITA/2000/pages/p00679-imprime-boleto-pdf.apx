page 679 (
    name: Imprime Boleto PDF
    alias: IMPRIME-BOLETO-PDF
    title: Imprime Boleto PDF
    appearance {
        pageMode: nonModalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1300
    }
    css {
        inline:
            ```css
            /* CENTRALIZAÇÃO DA TELA */
            
            .bb-page-center{
            
                min-height:100vh;
            
                display:flex;
                align-items:center;
                justify-content:center;
            
                padding:40px;
            
                background:linear-gradient(
                    135deg,
                    #f8fafc 0%,
                    #eef2f7 100%
                );
            
            }
            
            
            /* CARD */
            
            .bb-alert-card{
            
                width:100%;
                max-width:460px;
            
                padding:42px 36px;
            
                border-radius:24px;
            
                background:white;
            
                display:flex;
                flex-direction:column;
                align-items:center;
            
                text-align:center;
            
                gap:14px;
            
                border:1px solid #e2e8f0;
            
                box-shadow:
                    0 20px 50px rgba(15,23,42,0.08),
                    0 4px 14px rgba(15,23,42,0.05);
            
            }
            
            
            /* ÍCONE */
            
            .bb-alert-icon{
            
                width:70px;
                height:70px;
            
                border-radius:18px;
            
                display:flex;
                align-items:center;
                justify-content:center;
            
                background:linear-gradient(
                    135deg,
                    rgba(249,115,22,0.12),
                    rgba(239,68,68,0.12)
                );
            
            }
            
            .bb-alert-icon svg{
            
                width:34px;
                height:34px;
            
                fill:#ef4444;
            
            }
            
            
            /* TITULO */
            
            .bb-alert-title{
            
                font-size:20px;
                font-weight:700;
            
                color:#991b1b;
            
            }
            
            
            /* TEXTO */
            
            .bb-alert-text{
            
                font-size:16px;
                font-weight:500;
            
                color:#334155;
            
            }
            
            
            /* TEXTO SUPORTE */
            
            .bb-alert-support{
            
                font-size:14px;
            
                color:#64748b;
            
                margin-top:6px;
            
            }
            
            
            /* BOTÃO */
            
            .bb-btn-support{
            
                margin-top:10px;
            
                padding:10px 20px;
            
                border-radius:10px;
            
                font-size:14px;
                font-weight:600;
            
                color:white;
            
                background:linear-gradient(
                    135deg,
                    #4b79d8,
                    #8a4df0
                );
            
                text-decoration:none;
            
                transition:all .2s ease;
            
            }
            
            .bb-btn-support:hover{
            
                transform:translateY(-2px);
            
                box-shadow:0 8px 18px rgba(79,70,229,0.25);
            
            }
            
            .bb-alert-wait{
            
                font-size:14px;
            
                color:#64748b;
            
                margin-top:6px;
            
            }
            
            .bb-alert-actions{
            
                display:flex;
            
                gap:10px;
            
                margin-top:18px;
            
            }
            
            .bb-btn-retry{
            
                padding:10px 18px;
            
                border-radius:10px;
            
                border:none;
            
                font-weight:600;
            
                color:white;
            
                background:linear-gradient(
                    135deg,
                    #4b79d8,
                    #8a4df0
                );
            
                cursor:pointer;
            
                transition:all .2s ease;
            
            }
            
            .bb-btn-retry:hover{
            
                transform:translateY(-2px);
            
                box-shadow:0 6px 16px rgba(79,70,229,0.3);
            
            }
            
            .bb-btn-exit{
            
                padding:10px 18px;
            
                border-radius:10px;
            
                border:1px solid #e2e8f0;
            
                background:white;
            
                font-weight:600;
            
                color:#475569;
            
                cursor:pointer;
            
                transition:all .2s ease;
            
            }
            
            .bb-btn-exit:hover{
            
                background:#f1f5f9;
            
            }
            ```
    }

    region erro (
        name: Erro
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="bb-page-center">
                
                    <div class="bb-alert-card">
                
                        <div class="bb-alert-icon">
                            <svg viewBox="0 0 24 24">
                                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 
                                10-4.48 10-10S17.52 2 12 2zm0 14.2a1.3 1.3 0 1 1 0 2.6 
                                1.3 1.3 0 0 1 0-2.6zm1-3.2a1 1 0 0 1-2 0V7.8a1 1 0 0 1 
                                2 0V13z"/>
                            </svg>
                        </div>
                
                        <div class="bb-alert-title">
                            Atenção
                        </div>
                
                        <div class="bb-alert-text">
                            Boleto não encontrado.
                        </div>
                
                        <div class="bb-alert-wait">
                            Aguarde <span id="bb-seconds">15</span> segundos para tentar novamente.
                        </div>
                
                        <div class="bb-alert-support">
                            Caso o problema persista, entre em contato com o suporte.
                        </div>
                
                        <div class="bb-alert-actions">
                
                            <button class="bb-btn-exit" onclick="window.close()">
                                Sair
                            </button>
                
                        </div>
                
                    </div>
                
                </div>
                ```
        }
        layout {
            sequence: 50
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: item=value
            item: P679_ERRO
            value: S
        }
    )

    pageItem P679_ERRO (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
    )

    pageItem P679_IDPAGAMENTOPEDIDO (
        type: hidden
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    process gerar-boleto-pdf (
        name: GERAR_BOLETO_PDF
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_blob blob;
                begin
                    select boleto_pdf 
                      into l_blob
                      from pagamentospedidos
                     where idpagamentopedido = :P679_IDPAGAMENTOPEDIDO;
                
                    IF l_blob IS  NULL THEN
                       :P679_ERRO := 'S';
                       RETURN;
                    END IF;
                
                    sys.htp.init;
                    sys.owa_util.mime_header('application/pdf', false);
                    sys.htp.p('Content-Length: ' || dbms_lob.getlength(l_blob));
                    sys.htp.p('Content-Disposition: inline; filename="boleto.pdf"');
                    sys.owa_util.http_header_close;
                    sys.wpg_docload.download_file(l_blob);
                    apex_application.stop_apex_engine;
                
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 40408198284723002
        }
    )

)

