    validation verifica-pagamento-na-cobrança (
        name: Verifica pagamento na Cobrança
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @incluir-pagamentos-pedidos-por-consultora
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where ( exists ( select 1
                                 from parcelamentospedidos p
                                 where p.idpedido = ( select idpedido
                                                      from vencimentospedidos v
                                                      where v.idvencimentopedido = :IDVENCIMENTOPEDIDO ) )
                			     or exists ( select 1
                                             from pedidos ped
                                             where ped.idpedido = :IDPEDIDO
                                             and ped.idnegociadoraresponsavel is not null )
                                 or exists ( select 1
                                             from classificacoespedidos c
                                             where c.idcaracteristicapedido = 44
                                               and c.idpedido = ( select idpedido
                                                                  from vencimentospedidos v
                                                                  where v.idvencimentopedido = :IDVENCIMENTOPEDIDO ) ) )
                                 and exists ( select 1
                                              from roman.usuariosgruposatendimento u
                                              where u.usuario = ( select usuario
                                                                  from usuarios uu
                                                                  where uu.idusuario = :P0_IDUSUARIO ) 
                                              and u.idgrupoatendimento != 3 )
                ```
        }
        error {
            errorMessage: Não é possível incluir um pagamento, pois já existe uma negociação com o setor de cobrança. Favor entrar em contato com o setor de Cobrança.
        }
    )

    process consulta-pagamentos-protocolos (
        name: Consulta Pagamentos Protocolos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vnumbernull              number        := null;
                  vvarnull                 varchar2(1)   := null;
                  vdatenull                date          := null;
                  vclob                    clob          := null;
                  --
                  vdatapagamento           date;
                  vvalordepositado         number(15,2);
                  vvalorutilizado          number(15,2);
                  vvalorrestante           number(15,2);
                  vmd5                     varchar2(50);
                  --
                begin
                  --
                  pck_pedidos_fav.prc_pagamentosprotocolos ( pidpagamentoprotocolo      => vnumbernull
                                                           , pidvencimentoprotocolo     => vnumbernull
                                                           , pidpedido                  => vnumbernull
                                                           , pidprotocoloatendimento    => :P335_IDPROTOCOLOATENDIMENTO
                                                           , pidformapagamento          => :P335_IDFORMAPAGAMENTO
                                                           , pdatapagamento             => vdatapagamento
                                                           , pvalorpago                 => vnumbernull
                                                           , porigempagamento           => vvarnull
                                                           , pidsituacao                => vnumbernull
                                                           , ptaxa                      => vnumbernull
                                                           , pjuros                     => vnumbernull
                                                           , pacrescimo                 => vnumbernull
                                                           , pdesconto                  => vnumbernull
                                                           , pvalorliquido              => vnumbernull
                                                           , pvalordepositado           => vvalordepositado
                                                           , pvalorutilizado            => vvalorutilizado
                                                           , pvalorrestante             => vvalorrestante
                                                           , pnumerocomprovante         => :P335_NUMEROCOMPROVANTE
                                                           , pidcontabancaria           => :P335_CONTAPAGAMENTO
                                                           , pobservacao                => :P335_JUSTIFICATIVA
                                                           , pidusuariopagamento        => vnumbernull
                                                           , pdatainclusaopagamento     => vdatenull
                                                           , pmd5                       => vmd5
                                                           , poperacao_dml              => 'S' );
                  --
                  :P335_DATAPAGAMENTO   := to_char(vdatapagamento       ,'DD/MM/RRRR');
                  --
                  :P335_VALORDEPOSITADO := to_char(vvalordepositado, '999G999G999G990D00');
                  :P335_VALORUTILIZADO  := to_char(vvalorutilizado,  '999G999G999G990D00');
                  :P335_VALORRESTANTE   := to_char(vvalorrestante,   '999G999G999G990D00');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1422469397030394728
        }
    )

    process exclui-pagamento (
        name: Exclui Pagamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vnumbernull              number        := null;
                  vvarnull                 varchar2(1)   := null;
                  vdatenull                date          := null;
                  vclob                    clob          := null;
                  --
                  vidpagamentoprotocolo    number;
                  voperacao_dml            varchar2(1);
                  vmd5                     varchar2(50);
                  --
                begin
                  -- 
                  if v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                    vidpagamentoprotocolo := :P335_IDPAGAMENTOPROTOCOLO;
                    --
                  pck_pedidos_fav.prc_pagamentosprotocolos ( pidpagamentoprotocolo      => vidpagamentoprotocolo
                                                           , pidvencimentoprotocolo     => vnumbernull
                                                           , pidpedido                  => vnumbernull
                                                           , pidprotocoloatendimento    => vnumbernull
                                                           , pidformapagamento          => vnumbernull
                                                           , pdatapagamento             => vdatenull
                                                           , pvalorpago                 => vnumbernull
                                                           , porigempagamento           => vvarnull
                                                           , pidsituacao                => vnumbernull
                                                           , ptaxa                      => vnumbernull
                                                           , pjuros                     => vnumbernull
                                                           , pacrescimo                 => vnumbernull
                                                           , pdesconto                  => vnumbernull
                                                           , pvalorliquido              => vnumbernull
                                                           , pvalordepositado           => vnumbernull
                                                           , pvalorutilizado            => vnumbernull
                                                           , pvalorrestante             => vnumbernull
                                                           , pnumerocomprovante         => vnumbernull
                                                           , pidcontabancaria           => vnumbernull
                                                           , pobservacao                => vvarnull
                                                           , pidusuariopagamento        => vnumbernull
                                                           , pdatainclusaopagamento     => vdatenull
                                                           , pmd5                       => vmd5
                                                           , poperacao_dml              => voperacao_dml );
                  --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Pagamento excluído com sucesso
        }
        advanced {
            executionMappingIdentifier: 1422466694683394701
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where v('REQUEST') = 'EXCLUIR'
                ```
        }
    )

    process finaliza-e-inclui-pgtos-e-inicia-atendimento (
        name: Finaliza e Inclui Pgtos e Inicia Atendimento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vnumbernull              number        := null;
                  vvarnull                 varchar2(1)   := null;
                  vclob                    clob          := null;
                  --
                  voperacao_dml            varchar2(1)   := 'I';
                  vmd5                     varchar2(50);
                  --
                begin
                  --
                  for i in ( select *
                             from pagamentosprotocolos
                             where idprotocoloatendimento = :P335_IDPROTOCOLOATENDIMENTO
                             and datainclusaopagamento is null ) 
                  loop
                    --
                    pck_pedidos_fav.prc_pagamentospedidos ( pidpagamentopedido   => vnumbernull,
                                                            pidvencimentopedido  => i.idvencimentoprotocolo,
                                                            pidformapagamento    => i.idformapagamento,
                                                            pdatapagamento       => i.datapagamento,
                                                            pvalorpago           => i.valorpago,
                                                            porigempagamento     => i.origempagamento,
                                                            pnumeroboleto        => vvarnull,
                                                            pidsituacao          => i.idsituacao,
                                                            ptaxa                => i.taxa,
                                                            pjuros               => i.juros,
                                                            pacrescimo           => i.acrescimo,
                                                            pdesconto            => i.desconto,
                                                            pvalorliquido        => i.valorliquido,
                                                            pnumerocomprovante   => i.numerocomprovante,
                                                            pidcontabancaria     => i.idcontabancaria,
                                                            pobservacao          => :P335_JUSTIFICATIVA,
                                                            pidusuariopagamento  => i.idusuariopagamento,
                                                            pidusuarionegociacao => vnumbernull,
                                                            penviooperadora      => vclob,
                                                            pretornooperadora    => vclob,
                                                            poperacao_dml        => voperacao_dml,
                                                            pmd5                 => vmd5 );
                    --
                    update pagamentosprotocolos
                    set datainclusaopagamento  = trunc(sysdate)
                    where idpagamentoprotocolo = i.idpagamentoprotocolo;
                    --
                    commit;
                    --
                  end loop;
                  --
                  pck_protocolosatendimentos_fav.prc_iniciaatendimento( pidprotocoloatendimento => :P335_IDPROTOCOLOATENDIMENTO,
                                                                        pidusuario              => :P0_IDUSUARIO);
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Pagamentos foram incluídos aos pedidos
        }
        advanced {
            executionMappingIdentifier: 1422468595360394720
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') ='FINALIZAR'
                ```
        }
    )

    process incluir-pagamento (
        name: Incluir Pagamento
        type: executeCode
        editableRegion: @incluir-pagamentos-pedidos-por-consultora
        source {
            plsqlCode:
                ```plsql
                 declare
                  --
                  vdatenull              date          := null;
                  vidpagamentoprotocolo  number;
                  vdatapagamento         date;
                  vidformapagamento      number        := :P335_IDFORMAPAGAMENTO;
                  vorigempagamento       varchar2(1)   := 'V';  -- Call Center Vendas
                  vidsituacaopagamento   number        := 40;
                  vvalororiginal         number(15,2)  := to_number(nvl(:VALORORIGINAL, 0),        '999G999G999G990D00');
                  vtaxa                  number(15,2)  := 0;
