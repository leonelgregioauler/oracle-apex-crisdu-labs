    dynamicAction calcula-valor-recebido (
        name: Calcula Valor Recebido
        execution {
            sequence: 20
        }
        when {
            selectionType: region
            region: @incluir-pagamentos-pedidos-por-consultora
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression:
                ```javascript-browser
                $('input[name=f08]').each(function(idx) {
                  if ($(this).val() != 0 ) {
                      var valororiginal = document.getElementById( "f08_0001" );
                      //var valororiginal = document.getElementById( "f09_0001" );
                      //var valororiginal = document.getElementById( "f10_0001" );
                      
                      idx = idx + 1;
                      
                      var saldodevedor=$('input[id=f08_000' + idx + ']').val();
                      var juros=$('input[id=f09_000' + idx + ']').val();
                      var acrescimo=$('input[id=f10_000' + idx + ']').val();
                      var desconto=$('input[id=f11_000' + idx + ']').val();
                      var valorrecebido=$('input[id=f12_000' + idx + ']').val();
                      
                      var saldodevedor = saldodevedor.replace(".", "");
                      saldodevedor = saldodevedor.replace(",", ".");
                      saldodevedor = parseFloat(saldodevedor);
                      
                      var juros = parseFloat(juros.replace(",", "."));
                      var acrescimo = parseFloat(acrescimo.replace(",", "."));
                      var desconto = parseFloat(desconto.replace(",", "."));
                      
                      var valorrecebido = valorrecebido.replace(".", "");
                      valorrecebido = valorrecebido.replace(",", ".");
                      valorrecebido = parseFloat(valorrecebido);
                      
                      //var total = (saldodevedor - desconto + juros + acrescimo).toFixed(2);
                      var total = (saldodevedor - desconto + juros + acrescimo);
                      
                      console.log( "saldo devedor: " + saldodevedor +  " - total: "     + total );
                      //console.log( "jur: " + juros        +  " - bruto: "     + total );
                      //console.log( "acr: " + acrescimo    +  " - bruto: "     + total );
                      //console.log( "des: " + desconto     +  " - desconto: "  + total );
                      //console.log( " - total: "     + total.formatMoney(2, ",", ".") );
                      
                      //total = total.replace(/(\d{1})(\d{14})$/,"$1.$2") // coloca ponto antes dos ultimos digitos
                      //total = total.replace(/(\d{1})(\d{11})$/,"$1.$2") // coloca ponto antes dos ultimos 11 digitos
                      //total = total.replace(/(\d{1})(\d{8})$/,"$1.$2") // coloca ponto antes dos ultimos 8 digitos
                      //total = total.replace(/(\d{1})(\d{5})$/,"$1.$2") // coloca ponto antes dos ultimos 5 digitos
                      //total = total.replace(/(\d{1})(\d{1,2})$/,"$1,$2") // coloca virgula antes dos ultimos 2 digitos
                      
                      $('input[id=f12_000' + idx + ']').val(total.formatMoney(2, ",", ".")).index();
                         
                }  
                
                });
                ```
        }

        action native-alert (
            action: alert
            settings {
                message: 6
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

