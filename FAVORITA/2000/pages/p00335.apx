    region pagamentos-inclusos (
        name: Pagamentos Inclusos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select case
                         when pp.datainclusaopagamento is null then
                           '<a href="javascript:apex.confirm(''Confirmar a exclusão do pagamento ? '', 
                               { request:''EXCLUIR'', set:{''P335_IDPAGAMENTOPROTOCOLO'':'||pp.idpagamentoprotocolo||' }  } )";><img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" border="0"></a>' 
                         else  
                           '' 
                       end excluir
                     , pp.idpagamentoprotocolo
                     , pp.idvencimentoprotocolo
                     , pp.idpedido
                     , pp.nomeconsultora
                     , pp.cpfconsultora
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION') ||'::NO::P68_IDPEDIDO:' ||pp.idpedido ,'SESSION')||''',''_blank''); void(0)">'||pp.idpedido||'</a>' pedido
                     , pp.idformapagamento
                     , pp.formapagamento
                     , pp.datapagamento
                     , pp.valorpago
                     , pp.origempagamento
                     , pp.descorigempagamento
                     , pp.idsituacao
                     , pp.situacaopagamento
                     , pp.taxa
                     , pp.juros
                     , pp.acrescimo
                     , pp.desconto
                     , pp.valorliquido
                     , pp.numerocomprovante
                     , pp.idcontabancaria
                     , pp.observacao
                     , pp.idusuariopagamento
                     , pp.nomeusuario
                     , pp.datainclusaopagamento
                from vw_pagamentosprotocolos_fav pp
                where pp.idprotocoloatendimento = :P335_IDPROTOCOLOATENDIMENTO 
                and pp.ididioma = :P0_IDIDIOMA
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
