    region incluir-pagamentos-pedidos-por-consultora (
        name: Incluir Pagamentos Pedidos por Consultora
        type: tabform
        source {
            sqlQuery:
                ```sql
                select vp.idvencimentopedido
                     , vp.idpedido
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION') ||'::NO::P68_IDPEDIDO:' ||vp.idpedido ,'SESSION')||''',''_blank''); void(0)">'||vp.idpedido||'</a>'||
                       '<br>'||
                       nvl((select 'Em Negociação'
                            from dual
                            where ( exists ( select 1
                                             from parcelamentospedidos p
                                             where p.idpedido = ( select idpedido
                                                                  from vencimentospedidos v
                                                                  where v.idvencimentopedido = vp.idvencimentopedido ) )
                                 or exists ( select 1
                                             from pedidos ped
                                             where ped.idpedido = vp.idpedido
                                               and ped.idnegociadoraresponsavel is not null )
                                 or exists ( select 1
                                             from classificacoespedidos c
                                             where c.idcaracteristicapedido = 44
                                               and c.idpedido = ( select idpedido
                                                                  from vencimentospedidos v
                                                                  where v.idvencimentopedido = vp.idvencimentopedido ) ) )
                                and exists ( select 1
                                             from roman.usuariosgruposatendimento u
                                             where u.usuario = ( select usuario
                                                                 from usuarios uu
                                                                 where uu.idusuario = :P0_IDUSUARIO ) 
                                             and u.idgrupoatendimento != 3 ) ), 'Sem Negociação') pedido
                     , vp.datavencimento
                     , vp.valorpagar
                     , vp.idvencimentopedido verpagamentos
                     , vp.idpedido verhistoricos
                     , vp.saldo
                     , vp.idtarefa
                     , vp.situacaovencimento
                     , vp.semana
                     , vp.saldo valororiginal
                     , case 
                         when vp.saldo > 0 and :P335_DATAPAGAMENTO > vp.datavencimento then
                           to_char(pck_util_fav.fnc_calculajuros(pidpedido           => vp.idpedido,
                                                                 pvalororiginal      => vp.saldo,
                                                                 pdatavencimentoorig => vp.datavencimento,
                                                                 pdatavencimentonovo => to_date(:P335_DATAPAGAMENTO,'DD/MM/RRRR'),
                                                                 ppercmulta          => 2,
                                                                 ppercjuros          => 1) - vp.saldo, 'FM990D00') 
                       else 
                         '0,00'
                       end juros
                     , '0,00' acrescimo
                     , '0,00' desconto
                     , case 
                         when vp.saldo > 0 and to_date(:P335_DATAPAGAMENTO, 'DD/MM/RRRR') > vp.datavencimento then
                           pck_util_fav.fnc_calculajuros(pidpedido           => vp.idpedido,
                                                         pvalororiginal      => vp.saldo,
                                                         pdatavencimentoorig => vp.datavencimento,
                                                         pdatavencimentonovo => to_date(:P335_DATAPAGAMENTO,'DD/MM/RRRR'),
                                                         ppercmulta          => 2,
                                                         ppercjuros          => 1)
                       else
                        vp.saldo
                       end valoratualizado
                     , nvl((select 'Sim'
                            from dual
                            where ( exists ( select 1
                                             from parcelamentospedidos p
                                             where p.idpedido = ( select idpedido
                                                                  from vencimentospedidos v
                                                                  where v.idvencimentopedido = vp.idvencimentopedido ) )
                                 or exists ( select 1
                                             from pedidos ped
                                             where ped.idpedido = vp.idpedido
                                               and ped.idnegociadoraresponsavel is not null )
                                 or exists ( select 1
                                             from classificacoespedidos c
                                             where c.idcaracteristicapedido = 44
                                               and c.idpedido = ( select idpedido
                                                                  from vencimentospedidos v
                                                                  where v.idvencimentopedido = vp.idvencimentopedido ) ) )
                                and exists ( select 1
                                             from roman.usuariosgruposatendimento u
                                             where u.usuario = ( select usuario
                                                                 from usuarios uu
                                                                 where uu.idusuario = :P0_IDUSUARIO ) 
                                             and u.idgrupoatendimento != 3 ) ), 'Não') negociacao
                from vw_vencimentospedidos_fav vp
                where vp.idvendedora = :P335_IDVENDEDORA
                  and vp.codsituacaovencimento = 'V'
                  and vp.idvencimentopedido not in ( select pp.idvencimentoprotocolo
                                                     from pagamentosprotocolos pp
                                                     where pp.idvencimentoprotocolo = vp.idvencimentopedido
                                                     and pp.idprotocoloatendimento  = :P335_IDPROTOCOLOATENDIMENTO )
                  order by vp.datavencimento desc                                     
                ```
        }
