page 335 (
    name: Vencimentos Pedidos por Consultora
    title: Vencimentos Pedidos por Consultora
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG_28"';
    }
    htmlHeader {
        htmlHeader:
            ```html
            <style>
            
            .valor-depositado, .valor-utilizado, .valor-restante {
                font-size: 18px !important;
            }
            
            .valor-depositado {
              color: green !important;
            }
                
            .valor-utilizado {
              color: blue !important;
            }
             
            .valor-restante {
              color: red !important;
            }
                
            .valores {
              text-align: right;
              padding-right: 120px !important;
            }
                
            .valororiginal, .desconto, .valorliquido, .juros, .acrescimo, .valorrecebido {
              text-align: right;
            }
                
            
            
            </style>
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

