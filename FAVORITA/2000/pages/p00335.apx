                ```sql
                select initcap(p.nomepessoa) ||' - '||
                         case
                            when p.cpf is not null then
                                'CPF: '||p.cpf ||' - '||p.rg
                            else
                              'Doc. Estr.'||p.documentoestrangeiro
                            end
                                ||' - '||p.documentoestrangeiro||' Pontos: '||trim(to_char(nvl(v.pontos,0),'990D00'))
                    --  ||' - '|| roman.pck_romance.fnc_nomefilial(roman.pck_romance.fnc_filialvendedora(v.idvendedora))
