page 140 (
    name: Confirmar Volume Remessa
    title: Confirmar Volume Remessa
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
    }
    security {
        pageAccessProtection: unrestricted
    }

    region lista-de-volumes-da-remessa-para-t-i (
        name: Lista de Volumes da Remessa (Para T.I)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.idvolumepedidoremessa as "ID Volume Pedido Remessa"
                     , v.idcompratransferencia as "ID Compra Transferência"
                     , v.volume as "Volume"
                     , v.peso as "Peso"
                     , decode(v.recebido, 'S', 'Sim', 'Não') as "Já Foi Recedido?"
                  from favorita.volumespedidosremessas v
                 where v.idcompratransferencia = :P140_IDCOMPRATRANSFERENCIA --inserido o page item, pois tinha um id fixo
                 order by 1
                ```
        }
        layout {
            sequence: 10
            parentRegion: @volumes-da-remessa
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from roman.usuariosgruposatendimento u
                 where u.idgrupoatendimento = 0
                   and u.usuario = v('APP_USER');
                ```
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1322044009853561111
        }

        column "ID Compra Transferência" (
            type: plainText
            heading {
                heading: Id Compra Transferência
                alignment: end
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column "ID Volume Pedido Remessa" (
            type: plainText
            heading {
                heading: Id Volume Pedido Remessa
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column "Já Foi Recedido?" (
            type: plainText
            heading {
                heading: Já Foi Recedido?
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column Peso (
            type: plainText
            heading {
                heading: Peso
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column Volume (
            type: plainText
            heading {
                heading: Volume
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 15641140 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn "ID Compra Transferência" (
                sequence: 2
            )

            displayColumn "ID Volume Pedido Remessa" (
                sequence: 1
            )

            displayColumn "Já Foi Recedido?" (
                sequence: 5
            )

            displayColumn "Peso" (
                sequence: 4
            )

            displayColumn "Volume" (
                sequence: 3
            )

        )

    )

    region volumes-da-remessa (
        name: Volumes da Remessa
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P140_IDCOMPRATRANSFERENCIA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @volumes-da-remessa
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P140_NOTAFISCAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @volumes-da-remessa
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P140_QTDVOLUMES (
        type: textField
        label {
            label: Volumes p/ Bipar
            alignment: left
        }
        layout {
            sequence: 40
            region: @volumes-da-remessa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select count(1)
                from volumespedidosremessas v
                where v.idcompratransferencia = :P140_IDCOMPRATRANSFERENCIA
                  and nvl(v.recebido,'N') = 'N'
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P140_VOLUME (
        type: textField
        label {
            label: Volume
            alignment: left
        }
        settings {
            submitWhenEnterPressed: true
        }
        layout {
            sequence: 10
            region: @volumes-da-remessa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 10
            region: @volumes-da-remessa
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 87
                items: {
                    P87_IDCOMPRATRANSFERENCIA: &P140_IDCOMPRATRANSFERENCIA.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button proximopasso (
        buttonName: PROXIMOPASSO
        label: Finalizar Recebimento
        layout {
            sequence: 10
            region: @volumes-da-remessa
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from volumespedidosremessas v
                where v.idcompratransferencia = :P140_IDCOMPRATRANSFERENCIA
                  and recebido = 'S'
                  and exists ( select 1
                               from comprastransferencias c
                               where c.idcompratransferencia = v.idcompratransferencia
                                 and c.idtipocomptransrem in (2,3))
                ```
        }
    )

    dynamicAction confirma-volume-remessa (
        name: Confirma Volume Remessa
        execution {
            sequence: 1
        }
        when {
            selectionType: items
            items: P140_VOLUME
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P140_VOLUME
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: CONFIRMAVOLUME
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    process confirma-volume (
        name: Confirma Volume
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    -- Chamada da Procedure Confirma Volume Recebido
                    favorita.pck_comprastransf_fav.prc_confirmavolumerecebido(:P140_IDCOMPRATRANSFERENCIA,:P140_VOLUME,:P0_IDUSUARIO);
                
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 29167982487234204
        }
        serverSideCondition {
            type: request!=Value
            value: PROXIMOPASSO
        }
    )

    process finaliza-recebimento (
        name: finaliza recebimento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_comprastransf_fav.prc_finalizarecebimentovolumes(pidcompratransferencia => :P140_IDCOMPRATRANSFERENCIA,
                                                                       pidusuario => :P0_IDUSUARIO);
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Volumes Recebidos com sucesso!
        }
        advanced {
            executionMappingIdentifier: 29822911258565502
        }
        serverSideCondition {
            whenButtonPressed: @proximopasso
        }
    )

    branch (
        name: Go To Page 78
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 78
                items: {
                    P78_IDCOMPRATRANSFERENCIA: &P140_IDCOMPRATRANSFERENCIA.
                    P78_NUMEROPEDIDO:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @proximopasso
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from comprastransferencias
                where idtipocomptransrem = 3
                  and idcompratransferencia = :P140_IDCOMPRATRANSFERENCIA
                ```
        }
    )

    branch (
        name: Go To Page 87
        execution {
            sequence: 30
        }
        behavior {
            target: {
                page: 87
                items: {
                    P87_IDCOMPRATRANSFERENCIA: &P140_IDCOMPRATRANSFERENCIA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') = 'PROXIMOPASSO'
                  and exists ( select 1
                               from comprastransferencias 
                               where idtipocomptransrem = 2
                                 and idcompratransferencia = :P140_IDCOMPRATRANSFERENCIA )
                ```
        }
    )

)

