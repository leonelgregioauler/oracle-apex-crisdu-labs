page 89 (
    name: Logout
    title: Logout
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    dynamicAction logout (
        name: Logout
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                      -- Call the procedure
                      pck_controle_fav.prc_registraexpediente(pidsistema => 2000,
                                                          pprocesso => 'O');
                    end;
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: LOGOUT
            }
            execution {
                sequence: 20
            }
        )

    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
    )

)

