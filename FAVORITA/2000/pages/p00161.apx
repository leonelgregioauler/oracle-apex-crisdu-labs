    button cancel (
        buttonName: CANCEL
        label: Fechar
        layout {
            sequence: 20
            region: @buttons
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Próximo Passo
        layout {
            sequence: 10
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P161_IDCHAMADO is null
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P161_IDGRUPOATENDIMENTO
        }
        clientSideCondition {
            type: item=value
            item: P161_IDGRUPOATENDIMENTO
            value: 2
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P161_OBSERVACAOORCAMENTO
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P161_OBSERVACAOORCAMENTO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction valida-grupo (
        name: Valida Grupo
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P161_IDGRUPOATENDIMENTO
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: ESCOLHA_DESTINO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation valida-descrição (
        name: Valida Descrição
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P161_DESCRICAO
        }
        error {
            errorMessage: Por favor, informe alguma descrição para nós.
        }
        serverSideCondition {
            type: request!=Value
            value: ESCOLHA_DESTINO
        }
    )

    validation valida-telefone (
        name: Valida telefone
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P161_TELEFONECONTATO
        }
        error {
            errorMessage: Por favor, informe seu telefone.
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P161_IDGRUPOATENDIMENTO in ('0','116', '2')  AND :REQUEST != 'ESCOLHA_DESTINO'
        }
    )

    process fetch-row-from-chamados (
        name: Fetch Row from CHAMADOS
        type: autoRowFetch
        source {
            tableOwner: ROMAN
            tableName: CHAMADOS
            pkColumn: IDCHAMADO
            pkItem: P161_IDCHAMADO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 30223891321529087
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P161_IDCHAMADO is null then
                        select "ROMAN"."SEQ_IDCHAMADO".nextval
                          into :P161_IDCHAMADO
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 30224220917529087
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-chamados (
        name: Process Row of CHAMADOS
        type: autoRowProcessing
        target {
            tableOwner: ROMAN
            tableName: CHAMADOS
            pkColumn: IDCHAMADO
            pkItem: P161_IDCHAMADO
            supportedOperations: insert
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 30224650943529087
        }
    )

    branch (
        name: redireciona
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 160
                items: {
                    P160_IDCHAMADO: &P161_IDCHAMADO.
                    P160_IDANEXOEVENTO:
                }
                action: resetPagination
                successMessage: false
            }
        }
        serverSideCondition {
            type: request!=Value
            value: ESCOLHA_DESTINO
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 161
                items: {
                    P161_IDGRUPOATENDIMENTO: &P161_IDGRUPOATENDIMENTO.
                    P161_DESTINO: &P161_IDGRUPOATENDIMENTO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: ESCOLHA_DESTINO
        }
    )

)

