    )

    pageItem P161_IDGRUPOATENDIMENTO (
        type: selectList
        label {
            label: Solicitar para
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select g.descricao  display_value
                     , g.idgrupoatendimento return_value
                from roman.gruposatendimento g
                where g.ativo = 'S'
                  and g.idsistema = 2500
                  and g.idgrupoatendimento not in (116) --Ajuste ticket 16938684
                order by 1
                ```
            nullDisplayValue: - Selecione o Grupo de Atendimento -
        }
        layout {
            sequence: 50
            region: @novo-evento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDGRUPOATENDIMENTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

