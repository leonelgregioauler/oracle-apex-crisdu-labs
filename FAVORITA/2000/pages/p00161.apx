        layout {
            sequence: 70
            region: @novo-evento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 80
            height: 14
            valuePlaceholder: O que você precisa?
        }
        validation {
            maxLength: 3000
        }
        source {
            type: databaseColumn
            databaseColumn: DESCRICAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

