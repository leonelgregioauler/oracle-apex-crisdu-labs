page 577 (
    name: Compras Colaboradores
    title: Compras Colaboradores
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region compras-colaboradores (
        name: Compras Colaboradores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.unidade
                     , p.matricula
                    -- , pf.numeropedido
                     , p.nomepessoa
                     --, pf.dataemissao
                   --  , pf.datavencimento
                     , pf.valorapagar 
                from catal.pessoas p 
                   , favorita.vw_pedidos_fav pf
                where pf.idpessoa = p.idpessoa
                  and pf.valorapagar > 0
                  and pf.valorpago < pf.valorapagar
                  and exists ( select 1
                               from catal.funcionarios f
                               where f.idpessoa = p.idpessoa 
                                 and f.ativo = 'S')
                  and :P577_FILTRAR = 'S'
                  and (pf.datavencimentomenor is null or trunc(pf.datavencimentomenor) between to_date(:P577_DATAINICIO,'dd/mm/rrrr') and to_date(:P577_DATAFIM,'dd/mm/rrrr'))
                  and ( :P577_unidade is null or p.unidade = :P577_unidade )
                order by 4
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhum pedido encontrado, verifique os filtros!
        }
        advanced {
            savedReportMappingIdentifier: 163590422828676703
        }

        column MATRICULA (
            type: plainText
            heading {
                heading: Matricula
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column NOMEPESSOA (
            type: plainText
            heading {
                heading: Colaborador
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column UNIDADE (
            type: plainText
            heading {
                heading: Unidade
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column VALORAPAGAR (
            type: plainText
            heading {
                heading: Valor A Pagar
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 1023616 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn MATRICULA (
                sequence: 2
            )

            displayColumn NOMEPESSOA (
                sequence: 3
            )

            displayColumn UNIDADE (
                sequence: 1
            )

            displayColumn VALORAPAGAR (
                sequence: 4
            )

        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P577_DATAFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            formatMask: DD/MM/RRRR
            width: 30
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P577_DATAINICIO (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            formatMask: DD/MM/RRRR
            width: 30
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P577_FILTRAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P577_UNIDADE (
        type: textField
        label {
            label: Unidade
            alignment: left
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 577
                items: {
                    P577_DATAINICIO: &P577_DATAINICIO.
                    P577_DATAFIM: &P577_DATAFIM.
                    P577_UNIDADE: &P577_UNIDADE.
                    P577_FILTRAR: S
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

