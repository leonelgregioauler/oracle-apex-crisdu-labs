                  --raise_application_error(-20001,':P661_IDPAGAMENTOPEDIDO: '||:P661_IDPAGAMENTOPEDIDO);
                  --
                  pck_pedidos_fav.prc_cancelapromessapgto(pidpagamentopedido => nvl(:P661_IDPAGAMENTOPEDIDO,:P661_IDPAGTO_NEW),
                                                          pidusuario => :P0_IDUSUARIO);
                end;
                
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Pagamento Cancelado!
