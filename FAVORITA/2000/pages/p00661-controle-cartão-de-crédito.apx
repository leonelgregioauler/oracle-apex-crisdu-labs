page 661 (
    name: Controle Cartão de Crédito
    alias: CONTROLE-CARTÃO-DE-CRÉDITO
    title: Controle Cartão de Crédito
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region não-valido (
        name: Não Valido
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <font color = "RED"><h3>
                    Pedido possui boleto na Carteira Nova, não é possível gerar Link de pagamento via Integração.
                    </h3> </font>
                ```
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                exists ( select 1
                         from pagamentospedidos pp
                            , controlearquivosbanco ca
                         where ca.idpagamentopedido = pp.idpagamentopedido
                           and pp.idvencimentopedido = :P661_IDVENCIMENTOPEDIDO
                           and pp.idsituacao = 10
                           and nvl(ca.idconveniobanco,0) != 0 )
                ```
        }
    )

    region opção (
