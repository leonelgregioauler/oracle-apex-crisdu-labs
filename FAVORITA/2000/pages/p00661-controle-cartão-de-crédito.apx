    pageItem P661_LINK (
        type: textarea
        label {
            label: Link Pagamento
            alignment: left
        }
        layout {
            sequence: 30
            region: @válido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
            height: 5
        }
        advanced {
            customAttributes: readonly
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vlink varchar2(1000);
                begin
                  --
                  select linkcartaocredito
                  into vlink
                  from pagamentospedidos pp
                  where pp.idformapagamento = 1007 -- Link de Pagamento Cartao
                    and pp.idsituacao = 10
                    and pp.idvencimentopedido = :P661_IDVENCIMENTOPEDIDO
                    and pp.idpagamentopedido = :P661_IDPAGAMENTOPEDIDO;
                  --
                  return vlink;
                  --
                exception
                  when others then
                    return 'Link de Pagamento não encontrado!';
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

