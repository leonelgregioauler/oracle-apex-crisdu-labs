    process alimenta-valor (
        name: Alimenta Valor
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vvalor number;
                begin
                  --
                  if nvl(:P661_TIPO_ACORDO,'N') = 'N' then
                    --
                    select round(pck_util_fav.fnc_calculajuros(pidpedido           => v.idpedido,
                                                               pvalororiginal      => (v.valorpagar - v.valorpago),
                                                               pdatavencimentoorig => v.datavencimento,
                                                               pdatavencimentonovo => trunc(sysdate),
                                                               ppercmulta          => 2,
                                                               ppercjuros          => 1),2) valor
                    into vvalor
                    from vencimentospedidos v
                    where v.idvencimentopedido = :P661_IDVENCIMENTOPEDIDO;
                    --
                  elsif nvl(:P661_TIPO_ACORDO,'N') = 'S' then
                    --
                    select (v.valorpagar - v.valorpago)
                    into vvalor
                    from vencimentospedidos v
                    where v.idvencimentopedido = :P661_IDVENCIMENTOPEDIDO;
                    --
                  end if;
                  --
                  :P661_VALOR_ATUAL := vvalor;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1320983520217397831
        }
    )

    process busca-pagamento-pedido-com-link (
        name: Busca Pagamento pedido  com link
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  vidpagamento number;
                  vurl varchar2(1000) := null;
                  --
                begin
                  --
                  :P661_LINK := null;
                  :P661_TELEFONE := null;
                  --
                  select max(pp.idpagamentopedido)
                  into vidpagamento
                  from pagamentospedidos pp
                  where pp.idvencimentopedido = :P661_IDVENCIMENTOPEDIDO
                    and pp.idsituacao = 10
                    and pp.idformapagamento = 1007 -- link cartao de credito
                    and pp.chavepix is null
                    and pp.linkcartaocredito is not null
                    and pp.idcontroleurl is not null;
                  --
                  :P661_IDPAGAMENTOPEDIDO := vidpagamento;
                  :P661_idpagto_new := vidpagamento;
                  --
                  if vidpagamento is not null then
                    --
                    begin
                      --
                      select c.url_encurtada
                        into vurl
                        from pagamentospedidos pp
                           , roman.controleurl c
                        where pp.idcontroleurl      = c.idcontroleurl
                          and pp.idpagamentopedido  = vidpagamento;
                      --
                      :P661_LINK := vurl;
                      --
                      exception
                        when others then
                        :P661_LINK := 'Link de Pagamento não encontrado!';
                      --
                    end;
                  end if;
                  --
                exception
                  when others then
                    :P661_IDPAGAMENTOPEDIDO := null;
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1320985184948397832
        }
    )

    process cancela-link (
        name: Cancela Link
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
