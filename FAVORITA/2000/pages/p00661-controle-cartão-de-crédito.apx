    dynamicAction gerar-link (
        name: Gerar Link
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @gerar-link
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      --
                      vidpagamentopedido number;
                      --
                    begin
                      -- Call the procedure
                      --
                      pck_pedidos_fav.prc_gerapagamentoviapix(pidvencimentopedido => :P661_IDVENCIMENTOPEDIDO,
                                                              pvalor_atual => :P661_VALOR_ATUAL,
                                                              pidusuario => :P0_IDUSUARIO,
                                                              pidpagamento => vidpagamentopedido,
                                                              pidformapagamento => 1007);
                      --
                      :P661_IDPAGAMENTOPEDIDO := vidpagamentopedido;
                      :P661_IDPAGTO_NEW       := vidpagamentopedido;
                      --
                    end;
                    
                    ```
                itemsToReturn: P661_IDPAGAMENTOPEDIDO
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action set-link (
            name: Set Link
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                      vurl varchar2(1000) := null;
                    begin
                      --
                      select c.url_encurtada
                        into vurl
                        from pagamentospedidos pp
                           , roman.controleurl c
                       where pp.idcontroleurl      = c.idcontroleurl
                         and pp.idpagamentopedido  = :P661_IDPAGAMENTOPEDIDO;
                      --
                      return vurl;
                      --
                    exception
                      when others then
                        :P661_LINK := 'Link de Pagamento não encontrado!';
                    end;
                    ```
                itemsToSubmit: P661_LINK
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P661_LINK
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

