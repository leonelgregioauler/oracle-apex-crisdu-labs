    pageItem P661_VALOR_ATUAL (
        type: textField
        label {
            label: Valor Atual
            alignment: left
        }
        layout {
            sequence: 40
            region: @opção
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select round(pck_util_fav.fnc_calculajuros(pidpedido           => v.idpedido,
                                                            pvalororiginal      => (v.valorpagar - v.valorpago),
                                                     pdatavencimentoorig => v.datavencimento,
                                                     pdatavencimentonovo => trunc(sysdate),
                                                     ppercmulta          => 2,
                                                     ppercjuros          => 1),2) valor
                from vencimentospedidos v
                where :P661_TIPO_ACORDO	 = 'N'
                  and v.idvencimentopedido = :P661_IDVENCIMENTOPEDIDO
                union
                select (v.valorpagar - v.valorpago)
                from vencimentospedidos v
                where :P661_TIPO_ACORDO	 = 'S'
                  and v.idvencimentopedido = :P661_IDVENCIMENTOPEDIDO
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

