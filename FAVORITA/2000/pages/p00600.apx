page 600 (
    name: Acessos do Perfil
    title: Acessos do Perfil
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region acessos-do-perfil (
        name: Acessos do Perfil
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idaplicacao
                      ,descricao
                      ,hierarquia
                      ,decode( hierarquia , null , '<b>'||LPAD('* ', 3 * (level - 1)) || TO_CHAR(descricao) ||'</b>'
                                                 , DECODE(LEVEL , 2 , '<i>'||LPAD('* ', 3 * (level - 1)) || TO_CHAR(descricao)||'</i>'
                                                                , 3 , '<i>'||LPAD('-> ', 3 * (level - 1)) || TO_CHAR(descricao)||'</i>') ) nivel_hierarquico
                      , apex_item.CHECKBOX2(2,idaplicacao, null)CHECK1
                  from ( select a.idaplicacao
                              , a.descricao
                              , a.hierarquia
                         from roman.aplicacoes a 
                         where a.idsistema = 2000
                           and exists ( select 1 
                                        from roman.perfilacesso p
                                        where p.idaplicacao = a.idaplicacao
                                          and p.idperfil = :P600_IDPERFIL )
                        /* union
                         select a.idaplicacao
                              , a.descricao
                              , a.hierarquia
                         from roman.aplicacoes a 
                         where a.idsistema = 2000
                           and a.hierarquia is null
                         ORDER BY IDAPLICACAO*/
                       )
                 start with hierarquia is null
                connect by prior idaplicacao = hierarquia
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 574604669992428443
        }

        column CHECK1 (
            type: plainText
            heading {
                heading: Remover
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
            enableUsersTo {
                hide: false
                sort: false
                filter: false
                highlight: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
                pivot: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column DESCRICAO (
            type: hidden
            heading {
                heading: Descricao
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
            security {
                escapeSpecialChars: false
            }
        )

        column HIERARQUIA (
            type: hidden
            heading {
                heading: Hierarquia
            }
            layout {
                sequence: 30
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDAPLICACAO (
            type: hidden
            heading {
                heading: Idaplicacao
            }
            layout {
                sequence: 10
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NIVEL_HIERARQUICO (
            type: plainText
            heading {
                heading: Acessos
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
            enableUsersTo {
                hide: false
                sort: false
                filter: false
                highlight: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
                pivot: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        savedReport 5748761 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100000
            }

            displayColumn CHECK1 (
                sequence: 1
            )

            displayColumn NIVEL_HIERARQUICO (
                sequence: 2
            )

        )

    )

    region cadastro-de-perfil (
        name: Cadastro de Perfil
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
    )

    pageItem P600_DESCRICAO (
        type: textField
        label {
            label: <b>Descrição</b>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @cadastro-de-perfil
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 250
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P600_IDPERFIL (
        type: hidden
        layout {
            sequence: 10
            region: @cadastro-de-perfil
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button delete (
        buttonName: DELETE
        label: Remover Acessos
        layout {
            sequence: 10
            region: @cadastro-de-perfil
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 20
            region: @cadastro-de-perfil
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 599
                items: {
                    P599_IDPERFIL: &P600_IDPERFIL.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process deletar-acessos (
        name: Deletar acessos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                vpedido number;
                begin
                 FOR i IN 1..APEX_APPLICATION.G_F02.COUNT 
                 loop
                    --
                    delete roman.perfilacesso
                    where idperfil = :P600_IDPERFIL
                      and idaplicacao = APEX_APPLICATION.G_F02(i);
                    --
                  END LOOP;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Acessos Removidos com Sucesso!
        }
        advanced {
            executionMappingIdentifier: 573074822931347832
        }
    )

    branch (
        name: Go To Page 600
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 600
            }
        }
    )

)

