page 203 (
    name: Promissórias Atualizadas
    title: Promissórias Atualizadas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region promissórias-atualizadas (
        name: Promissórias Atualizadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.numeropedido
                     , v.representante
                     , v.vendedora
                     , v.cpf
                     , v.filialromance
                     , v.dataemissao
                     , v.dataentrega
                     , v.datavencimento
                     , v.dataclassificado
                     , v.usuario
                     , v.recuperarpromissoria
                     , v.valorapagar
                     , v.valorpago
                     , nvl(v.saldodevedor,0) saldodevedor
                     , v.telefones
                from VW_ATUALIZACAOPROMISSORIAS_FAV v
                where trunc(v.dataclassificado) between to_date(:P203_DATAINICIO,'DD/MM/RRRR') and to_date(:P203_DATAFIM,'DD/MM/RRRR') 
                  and ( :P203_RECUPERARPROMISSORIA is null or ( :P203_RECUPERARPROMISSORIA = 'S' and exists ( select 1
                                                                                                              from classificacoespedidos c
                                                                                                              where c.idpedido = v.idpedido
                                                                                                                and c.idcaracteristicapedido = 17 ) )
                                                           or ( :P203_RECUPERARPROMISSORIA = 'N' and not exists ( select 1
                                                                                                                  from classificacoespedidos c
                                                                                                                  where c.idpedido = v.idpedido
                                                                                                                    and c.idcaracteristicapedido = 17 ) ) )
                  and ( :P203_IDSITUACAOPROMISSORIA is null or v.idcaracteristicapedido = 16 
                                                           and v.idvalorcaracteristica = :P203_IDSITUACAOPROMISSORIA )
                  and ( :P203_ATENDENTE is null or v.idusuario = :P203_ATENDENTE )
                  and ( :P203_IDFILIALROMANCE is null or v.idfilialromance = :P203_IDFILIALROMANCE )
                  and ( :P203_IDREPRESENTANTE is null or v.idrepresentante = :P203_IDREPRESENTANTE )
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Dados não encontrados.
        }
        advanced {
            savedReportMappingIdentifier: 253143721806796830
        }

