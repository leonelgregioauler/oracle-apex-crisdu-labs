page 621 (
    name: Cadastro Tabela Preço Delivery
    title: Cadastro Tabela Preço Delivery
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 500
        height: 550
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region tabela-preço-delivery (
        name: Tabela Preço Delivery
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
    )

    pageItem P621_ATIVO (
        type: radioGroup
        label {
            label: Ativo
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC:Não;N,Sim;S
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @tabela-preço-delivery
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: S
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P621_DATACADASTRO (
        type: displayOnly
        label {
            label: Data Cadastro
            alignment: left
        }
        layout {
            sequence: 80
            region: @tabela-preço-delivery
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P621_DATAINATIVACAO (
        type: displayOnly
        label {
            label: Data Inativação
            alignment: left
        }
        layout {
            sequence: 90
            region: @tabela-preço-delivery
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P621_FILIALFAVORITA (
        type: selectList
        label {
            label: Filial Favorita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nomefilialfavorita as display_value,
                       f.idfilialfavorita   as return_value
                  from favorita.filiaisfavorita f
                 where f.tipofilial = 'L'
                   and f.ativo = 'S';
                ```
        }
        layout {
            sequence: 40
            region: @tabela-preço-delivery
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P621_IDTABELAPRECOSDELIVERY (
        type: hidden
        layout {
            sequence: 10
            region: @tabela-preço-delivery
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P621_NOME (
        type: textField
        label {
            label: Descrição
            alignment: left
        }
        layout {
            sequence: 50
            region: @tabela-preço-delivery
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P621_VALOR (
        type: textField
        label {
            label: Valor R$
            alignment: left
        }
        layout {
            sequence: 60
            region: @tabela-preço-delivery
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: FML999G999G999G999G990D00
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 120
            region: @tabela-preço-delivery
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 130
            region: @tabela-preço-delivery
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 620
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process atualiza-grava-registro (
        name: Atualiza_grava_registro
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    vValor number := 0;
                begin
                
                    vValor := replace (:P621_VALOR,'R$','');
                
                    update favorita.tabelaprecosdelivery
                       set nome = :P621_NOME,
                           valor = vValor,
                           ativo = :P621_ATIVO,
                           datainativacao = DECODE(:P621_ATIVO, 'S', null, trunc(sysdate))
                     where idtabelaprecosdelivery = :P621_IDTABELAPRECOSDELIVERY
                       and idfilialfavorita       = :P621_FILIALFAVORITA;
                
                    if sql%rowcount = 0 then
                        insert into favorita.tabelaprecosdelivery(idfilialfavorita, nome, valor, ativo, datacadastro)
                        values  (:P621_FILIALFAVORITA,
                                 :P621_NOME,
                                 :P621_VALOR,
                                 :P621_ATIVO,
                                 trunc(sysdate));
                    end if;
                    
                    commit;
                          
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro atualizado/salvo  com sucesso.
        }
        advanced {
            executionMappingIdentifier: 2119208741943747531
        }
    )

    process carrega-valor (
        name: Carrega valor
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                    if :P621_IDTABELAPRECOSDELIVERY is not null then
                        select t.idfilialfavorita,
                               t.ativo,
                               t.nome,
                               t.valor,
                               t.datacadastro,
                               t.datainativacao
                          into :P621_FILIALFAVORITA,
                               :P621_ATIVO,
                               :P621_NOME,
                               :P621_VALOR,
                               :P621_DATACADASTRO,
                               :P621_DATAINATIVACAO
                          from favorita.tabelaprecosdelivery t
                         where t.idtabelaprecosdelivery = :P621_IDTABELAPRECOSDELIVERY;
                         
                    else
                      :P621_VALOR := 0;
                    end if;   
                
                exception 
                  when others then
                      :P621_VALOR := 0; 
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 2119980894189969530
        }
    )

)

