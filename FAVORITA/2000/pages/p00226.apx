page 226 (
    name: Vencimentos Compras Transferências
    title: Vencimentos Compras Transferências
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function imprimeboleto(vidpedido,vidvendedora)
            {   
              vurl = 'http://boletos.romancemoda.com.br:7777/boleto/boleto_bb_favorita_novo.php?cod1='+vidpedido+'&cod2='+vidvendedora;
              pjan = window.open(vurl,'boleto','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1024,height=1000,left=20,top=10','_blank'); 
              pjan.focus();
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region vencimentos-compras-transferências (
        name: Vencimentos Compras Transferências
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select vc.idvencimentocompratransf  
                     , vc.idcompratransferencia
                     , ct.numero numeroremessa
                     , vc.datavencimento
                     , vc.valorpagar
                     , vc.valorpago
                     , vc.saldo
                     , vc.verificarnaconta
                     , vc.situacaovencimentodescricao
                     , vc.idfilialfavoritaorigem
                     , vc.filialfavoritaorigem
                     , vc.idfilialfavoritadestino
                     , vc.filialfavoritadestino
                     , vc.idfilialromancedestino
                     , vc.filialromancedestino
                from comprastransferencias ct
                   , vw_vencimentoscompratransf_fav vc
                where ct.idcompratransferencia = vc.idcompratransferencia 
                and ( :P226_DATAINI is null or vc.datavencimento between to_date(:P226_DATAINI,'DD/MM/RRRR') and to_date(:P226_DATAFIM,'DD/MM/RRRR') )
                and ( :P226_SITUACAO is null or vc.situacaovencimento = :P226_SITUACAO )
                and ( (:P226_FILIALROMANCE is null 
                        or vc.idfilialromancedestino = :P226_FILIALROMANCE )
                        or vc.idfilialromancedestino = roman.pck_romance.fnc_filialusuario(v('APP_USER'))  )
                and ( :P226_REMESSA is null or ct.numero = :P226_REMESSA )
                  and ( :P226_NRBOLETO is null or exists ( select 1
                                                           from pagamentoscomprastransf pc
                                                           where pc.idvencimentocompratransf = vc.idvencimentocompratransf
                                                             and pc.idformapagamento   = 1
                                                             and pc.numeroboleto like '%'||:P226_NRBOLETO||'%' ) )        
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum Vencimento encontrado
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 50
        }
        advanced {
            savedReportMappingIdentifier: 1310376797169740672
        }

