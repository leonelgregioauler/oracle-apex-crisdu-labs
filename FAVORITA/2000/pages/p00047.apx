page 47 (
    name: Cadastro Estoques
    title: Estoques
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 50%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region estoques (
        name: Estoques
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P47_BUSCARDOESTOQUEABASTECEDOR (
        type: radioGroup
        label {
            label: Buscar do estoque abastecedor?
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: sharedComponent
            lov: @lov-simnao
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @estoques
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: S
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P47_IDESTOQUE (
        type: hidden
        layout {
            sequence: 10
            region: @estoques
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P47_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Filial Favorita
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-filiaisfavorita
        }
        layout {
            sequence: 20
            region: @estoques
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P47_IDPRODUTODETALHADO (
        type: popupLov
        label {
            label: Produto Detalhado
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sharedComponent
            lov: @lov-produtosdetalhados
        }
        layout {
            sequence: 30
            region: @estoques
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 70
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P47_MD5 (
        type: hidden
        layout {
            sequence: 80
            region: @estoques
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P47_OPERACAO_DML (
        type: hidden
        layout {
            sequence: 90
            region: @estoques
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P47_PERMITEVENDERNEGATIVO (
        type: radioGroup
        label {
            label: Vender estoque negativo ?
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: sharedComponent
            lov: @lov-simnao
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @estoques
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: S
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P47_QTDESTOQUEMINIMO (
        type: numberField
        label {
            label: Estoque Mínimo
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 50
            region: @estoques
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P47_QUANTIDADE (
        type: numberField
        label {
            label: Quantidade
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 40
            region: @estoques
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 50
            region: @estoques
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P47_IDESTOQUE
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 30
            region: @estoques
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 46
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation idfilialfavorita-obrigatório (
        name: IDFILIALFAVORITA obrigatório
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P47_IDFILIALFAVORITA
        }
        error {
            errorMessage: Filial Favorita deve ser informado.
            associatedItem: @P47_IDFILIALFAVORITA
        }
    )

    validation idprodutodetalhado-obrigarório (
        name: IDPRODUTODETALHADO obrigarório
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P47_IDPRODUTODETALHADO
        }
        error {
            errorMessage: Produto Detalhado deve ser informado.
            associatedItem: @P47_IDPRODUTODETALHADO
        }
    )

    validation qtdestoqueminimo-inteiro (
        name: QTDESTOQUEMINIMO inteiro
        execution {
            sequence: 40
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  verro varchar2(1000);
                begin
                  if instr(:P47_QTDESTOQUEMINIMO, ',') > 0 or
                     instr(:P47_QTDESTOQUEMINIMO,'.') > 0 then
                    --
                    return 'Estoque mínimo deve ser um número inteiro';
                    --
                  else
                    null;
                  end if;
                end;
                ```
        }
        error {
            associatedItem: @P47_QTDESTOQUEMINIMO
        }
    )

    validation qtdestoqueminimo-maior-que (
        name: QTDESTOQUEMINIMO maior que 0
        execution {
            sequence: 50
        }
        validation {
            plsqlExpression: :P47_QTDESTOQUEMINIMO > 0
        }
        error {
            errorMessage: "Estoque mínimo deve ser maior que zero (0) "
            associatedItem: @P47_QTDESTOQUEMINIMO
        }
        serverSideCondition {
            type: expression
            plsqlExpression: instr(:P47_QTDESTOQUEMINIMO, '.') = 0
        }
    )

    validation quantidade-obrigatório (
        name: QUANTIDADE obrigatório
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P47_QUANTIDADE
        }
        error {
            errorMessage: Quantidade deve ser informado.
            associatedItem: @P47_QUANTIDADE
        }
    )

    process consulta-estoque (
        name: Consulta Estoque
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  #OWNER#.PCK_ESTOQUE_FAV.PRC_ESTOQUES ( PIDESTOQUE => :P47_IDESTOQUE,
                                                         PIDFILIALFAVORITA => :P47_IDFILIALFAVORITA,
                                                         PIDPRODUTODETALHADO => :P47_IDPRODUTODETALHADO,
                                                         PQUANTIDADE => :P47_QUANTIDADE,
                                                         PPERMITEVENDERNEGATIVO => :P47_PERMITEVENDERNEGATIVO,
                                                         PBUSCARDOESTOQUEABASTECEDOR => :P47_BUSCARDOESTOQUEABASTECEDOR,
                                                         PQTDESTOQUEMINIMO => :P47_QTDESTOQUEMINIMO,
                                                         PMD5 => :P47_MD5,
                                                         POPERACAO_DML => 'S');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 3013263505146428
        }
    )

    process limpar-campos-ao-sair (
        name: Limpar Campos ao Sair
        type: clearSessionState
        execution {
            sequence: 10
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 3014462411146440
        }
    )

    process limpar-campos-para-adicionar (
        name: Limpar Campos para Adicionar
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 3014583572146441
        }
    )

    process operação-dml-em-estoques (
        name: Operação DML em Estoques
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  #OWNER#.PCK_ESTOQUE_FAV.PRC_ESTOQUES (
                    PIDESTOQUE => :P47_IDESTOQUE,
                    PIDFILIALFAVORITA => :P47_IDFILIALFAVORITA,
                    PIDPRODUTODETALHADO => :P47_IDPRODUTODETALHADO,
                    PQUANTIDADE => :P47_QUANTIDADE,
                    PPERMITEVENDERNEGATIVO => :P47_PERMITEVENDERNEGATIVO,
                    PBUSCARDOESTOQUEABASTECEDOR => :P47_BUSCARDOESTOQUEABASTECEDOR,
                    PQTDESTOQUEMINIMO => :P47_QTDESTOQUEMINIMO,
                    PMD5 => :P47_MD5,
                    POPERACAO_DML => voperacao_dml);
                  --
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 3105224902503303
        }
    )

    branch (
        name: Go To Page 47
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 47
                items: {
                    P47_IDESTOQUE: &P47_IDESTOQUE.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

)

