page 65 (
    name: Relatório de Kits Vendas
    title: Kits Vendas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region kits-vendas (
        name: Kits Vendas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idkitvenda
                     , referencia
                     , descricao
                     , pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) filialfavorita
                     , ( select listagg(pck_util_fav.fnc_nomefilialromance(f.idfilial),',') within group ( order by 1)
                         from catal.filiais f
                         where f.idfilial in ( select column_value
                                               from table (pck_util_fav.fnc_array_to_table(replace(k.filiaisromance,',',':'))) ) ) filiaisromance
                     , ( select pck_util_fav.fnc_nomecategoriasite( pidcategoriasite => cc.idcategoriasite
                                                                  , pididioma    => 1)
                        ||' - '||pck_util_fav.fnc_nomecategoria( pidcategoria => cc.idcategoria
                                                               , pididioma => 1)
                         from categorias cc
                         where cc.idcategoria = k.idcategoria ) categoriasite
                     , decode(k.habilitarpara, 'T', 'Distribuidor e Consultora'
                                             , 'D', 'Distribuidor'
                                             , 'C', 'Consultora') habilitarparadescricao
                     , decode(k.kitcampanha,'S','Sim','Não') kitcampanha
                     , datainicial
                     , datafinal
                from kitsvendas k
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 13532617241975302
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDKITVENDA
                layout {
                    width: 74
                    sequence: 0
                }
            )

            displayColumn (
                column: @REFERENCIA
                layout {
                    width: 197
                    sequence: 1
                }
            )

            displayColumn (
                column: @DESCRICAO
                layout {
                    width: 300
                    sequence: 2
                }
            )

            displayColumn (
                column: @DATAINICIAL
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @DATAFINAL
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @FILIAISROMANCE
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @KITCAMPANHA
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @CATEGORIASITE
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @HABILITARPARADESCRICAO
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @FILIALFAVORITA
                layout {
                    sequence: 4
                }
            )

        )

        column CATEGORIASITE (
            type: textarea
            heading {
                heading: Categoria
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: CATEGORIASITE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column DATAFINAL (
            type: datePickerJquery
            heading {
                heading: Data Final
                alignment: center
            }
            layout {
                sequence: 120
                columnAlignment: center
            }
            source {
                databaseColumn: DATAFINAL
                dataType: date
            }
        )

        column DATAINICIAL (
            type: datePickerJquery
            heading {
                heading: Data Inicial
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: center
            }
