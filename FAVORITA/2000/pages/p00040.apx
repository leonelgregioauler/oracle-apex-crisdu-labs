page 40 (
    name: Administração
    title: Administração
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region administração (
        name: Administração
        type: list
        source {
            list: @administração
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            listTemplate: @/cards
            templateOptions: [
                t-Cards--featured force-fa-lg
                t-Cards--displayIcons
                t-Cards--3cols
                u-colors
                t-Cards--animColorFill
            ]
        }
    )

)

