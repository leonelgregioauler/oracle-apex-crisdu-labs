page 1 (
    name: Início
    title: Início
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            .t-PageBody--login .t-Body {
            background: url('#APP_IMAGES#Call-Center_compact.jpg' );
            background-size: 100% auto;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
        browserCache: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region aviso (
        name: Aviso
        type: staticContent
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                Devido a situação atual, a partir de <b>segunda-feira (23/03/2020)</b> a T.I trabalhará em formato Home Office.<br>
                Caso necessite suporte, nos chame no <b>WhatsApp</b> que ajudamos você.<br>
                Contatos:<br><br>
                
                - 51 9 82810011 (Suporte Romance)<br>
                - 51 9 80423097 (Suporte Minha Sacola)<br>
                - 51 9 91801384 (Suporte Favorita - Somente para Lojas e Call Center) <br>
                - 51 9 81018384 (Suporte Infra/Equipamentos)<br><br>
                
                Aqui vão algumas dicas: <br><br>
                
                <b>- Lave com frequência as mãos.</b><br>
                <b>- Evite aglomerações.</b><br>
                <b>- Fique atento aos sintomas.</b>
                ```
        }
        serverSideCondition {
            type: never
        }
    )

    region início (
        name: Início
        type: list
        source {
            list: @menu-de-navegação
        }
        layout {
            sequence: 41
            slot: body-1
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            listTemplate: @/cards
            templateOptions: [
                #DEFAULT#
                t-Cards--featured force-fa-lg
                t-Cards--displayIcons
                t-Cards--3cols
                u-colors
                t-Cards--animColorFill
            ]
        }
    )

    region meta-call-center (
        name: Meta Call Center
        type: staticContent
        layout {
            sequence: 21
            slot: breadcrumbBar
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where ( to_char(sysdate,'HH24:MI:SS') between ('13:00:00') and ('17:00:00')
                     or to_char(sysdate,'HH24:MI:SS') between ('09:00:00') and ('11:30:00')
                     or to_char(sysdate,'HH24:MI:SS') between ('18:00:00') and ('19:30:00') )
                  and exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.idgrupoatendimento in (4,33,34)
                                 and ug.usuario            = v('APP_USER') )
                  and exists ( select 1
                               from metascobrancas m
                                  , usuarios u
                               where m.idgrupoatendimento in (4,33,34)
                                 and trunc(sysdate) between to_date(m.datainicio,'DD/MM/RRRR') and to_date(m.datafim,'DD/MM/RRRR')
                                 and u.idusuario          = m.idusuario
                                 and u.usuario            = v('APP_USER') )
                ```
        }
    )

    region meta-cobrança (
        name: Meta Cobrança
        type: staticContent
        layout {
            sequence: 11
            slot: breadcrumbBar
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where ( to_char(sysdate,'HH24:MI:SS') between ('16:30:00') and ('18:20:00')
                     or to_char(sysdate,'HH24:MI:SS') between ('07:50:00') and ('09:00:00') )
                  and exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.idgrupoatendimento in (3,54,55)
                                 and ug.usuario            = v('APP_USER') )
                ```
        }
    )

    region produtividade-documentadoras (
        name: Produtividade Documentadoras
        type: staticContent
        layout {
            sequence: 31
            slot: breadcrumbBar
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                               from roman.usuariosgruposatendimento u
                               where u.idgrupoatendimento = 35
                                 and u.usuario            = v('APP_USER') )
                ```
        }
    )

    pageItem P1_AVISOMETA (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 10
            region: @meta-cobrança
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vretorno varchar2(1000);
                  vidusuario number;
                begin
                  --
                  select idusuario
                  into vidusuario
                  from usuarios 
                  where usuario = v('APP_USER');
                  --
                  vretorno := pck_util_fav.fnc_retornamensagemmetacob(pidusuario => vidusuario);
                  --
                  return vretorno;
                  --
                exception
                  when others then
                    return ' ';
                end;
                ```
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vretorno varchar2(1000);
                  vidusuario number;
                begin
                  --
                  select idusuario
                  into vidusuario
                  from usuarios 
                  where usuario = v('APP_USER');
                  --
                  vretorno := pck_util_fav.fnc_retornamensagemmetacob(pidusuario => vidusuario);
                  --
                  return vretorno;
                  --
                exception
                  when others then
                    return ' ';
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P1_AVISOMETA_1 (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 10
            region: @produtividade-documentadoras
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<font color="GREEN"><h2>Promissórias atualizadas da Favorita '||nvl(favorita.qtd,0)||' e da Romance '||nvl(romance.qtd,0)||'. Total '||nvl((romance.qtd+favorita.qtd),0)||' da meta de 10 mil.</h2></font>' d
                from dual
                   , ( select count(1) qtd
                       from roman.classificacoesnotasvendas cn
                       where cn.idcaracteristicanotavenda = 4
                         and to_char(cn.dataclassificado,'MM/RRRR') = to_char(sysdate,'MM/RRRR')
                         and exists ( select 1
                                      from usuarios u
                                         , roman.usuariosgruposatendimento ug
                                      where u.usuario = ug.usuario
                                        and u.idusuario = cn.idusuario
                                        and u.usuario = v('APP_USER')
                                        and ug.idgrupoatendimento = 35 ) ) romance
                   , ( select count(1) qtd
                       from classificacoespedidos cp
                       where cp.idcaracteristicapedido = 71
                         and to_char(cp.dataclassificado,'MM/RRRR') = to_char(sysdate,'MM/RRRR')
                         and exists ( select 1
                                      from usuarios u
                                         , roman.usuariosgruposatendimento ug
                                      where u.usuario = ug.usuario
                                        and u.idusuario = cp.idusuario
                                        and u.usuario = v('APP_USER')
                                        and ug.idgrupoatendimento = 35 ) ) favorita
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

