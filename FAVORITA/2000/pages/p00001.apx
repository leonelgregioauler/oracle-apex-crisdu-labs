    process setaperfil (
        name: SetaPerfil
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                  insert into usuariosperfisatendimentos (idusuarioperfilatend,
                                                          idusuario,
                                                          idperfilatendimento,
                                                          datahoralogin)
                   values (seq_idusuarioperfilatend.nextval,
                           :P0_IDUSUARIO,
                           :P0_IDPERFILATENDIMENTO,
                           SYSDATE);
                END;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 99932866088114018
        }
        serverSideCondition {
            whenButtonPressed: @/p0-salvarperfil
        }
    )

)

