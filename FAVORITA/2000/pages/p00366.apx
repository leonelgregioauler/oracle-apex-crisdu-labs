page 366 (
    name: Boletos Pendentes de Registro
    title: Boletos Pendentes de Registro
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 60%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region boletos-pendentes-de-registro (
        name: Boletos Pendentes de Registro
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idpedido
                     , t.numeroboleto
                     , t.dataemissao
                     , t.datainclusaoboleto
                     , t.valorpagar
                     , nvl(t.cpf,( select p.documentoestrangeiro
                                   from pessoas p
                                      , vendedoras v
                                   where p.idpessoa = v.idpessoa
                                     and v.idvendedora = t.idvendedora )) documento
                     , t.nomepessoa
                     , t.enderecoprincipal
                     , t.bairro
                     , t.nomecidade||'/'||t.sigla cidade
                     , t.CEP
                from vw_integracaoregboletos_fav_ws t
                where dataprocessado is null
                  and codsituacaovencimento = 'V' 
                  and trunc(datavencimento) >= trunc(sysdate)
                order by 1 
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        advanced {
            savedReportMappingIdentifier: 1511232944737380536
        }

