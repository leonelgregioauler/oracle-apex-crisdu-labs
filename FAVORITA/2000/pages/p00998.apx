    pageItem P998_IDUSUARIO (
        type: plugin/select
        label {
            label: Usuáro
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeusuario(u.idusuario) display_value
                     , u.idusuario return_value
                from usuarios u
                where exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.usuario = u.usuario 
                                 and ug.idgrupoatendimento in ( select uu.idgrupoatendimento
                                                                from roman.usuariosgruposatendimento uu
                                                                where uu.usuario = v('APP_USER') ) ) 
                 or pck_util_fav.fnc_verificaacesso(58305,:P0_IDUSUARIO) = 'S'                                                
                order by 1
                ```
            nullDisplayValue: - Selecione o Usuário -
        }
        layout {
            sequence: 80
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 100
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--primary
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
