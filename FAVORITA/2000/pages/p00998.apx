    button novo (
        buttonName: NOVO
        label: Movimentar Estoque
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 88
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process alimenta-filtro-de-data (
        name: Alimenta Filtro de Data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  select trunc(sysdate)-30
                  into :P998_DATAINICIO
                  from dual;
                  --
                  select trunc(sysdate)
                  into :P998_DATAFIM
                  from dual;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 707725495821848786
        }
        serverSideCondition {
            type: itemIsNull
            item: P998_DATAINICIO
        }
    )

    branch (
        name: Go To Page 84
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 998
                items: {
                    P998_IDFILIALFAVORITA: &P998_IDFILIALFAVORITA.
                    P998_IDPRODUTO: &P998_IDPRODUTO.
                    P998_IDPRODUTODETALHADO: &P998_IDPRODUTODETALHADO.
                    P998_IDUSUARIO: &P998_IDUSUARIO.
                    P998_IDFORNECEDOR: &P998_IDFORNECEDOR.
                    P998_DATAINICIO: &P998_DATAINICIO.
                    P998_DATAFIM: &P998_DATAFIM.
                    P998_FILTRAR: S
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

