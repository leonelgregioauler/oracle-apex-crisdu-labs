    region cadastro-de-produtos-detalhados-vários (
        name: Cadastro de Produtos Detalhados / Vários
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pd.idprodutodetalhado
                     , pd.idproduto
                     , pd.idcaracteristica
                     , pd.idcor
                     , pd.idgrade
                     , pd.idcodigobarra
                     , ( select codean
                         from codigosbarras cb
                         where cb.idcodigobarra = pd.idcodigobarra ) codean
                     , null Gerenciar
                     , 'Editar' Morte
                    , pd.ativo
                    , pd.idncm
                    , pd.idespecie
                    , pd.idcstorigem
                    , pd.idcest
                    , pd.idtipodeitemsped
                from produtosdetalhados pd
                where pd.idproduto = :P188_IDPRODUTO;
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 11338748659722092011
        }

