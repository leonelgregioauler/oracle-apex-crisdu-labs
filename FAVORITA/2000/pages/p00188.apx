    process cadastro-de-produtos-detalhados-vários-save-interactive-grid-data (
        name: Cadastro de Produtos Detalhados / Vários - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @cadastro-de-produtos-detalhados-vários
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 5772804720601435079
        }
    )

    process criar-cod-barra (
        name: Criar Cod Barra
        type: executeCode
        editableRegion: @cadastro-de-produtos-detalhados-vários
        source {
            plsqlCode:
                ```plsql
                declare
                  vcodigoean number;
                  vidcodigobarra number;
                  vidusuario number;
                  vmensagem varchar2(4000);
                begin
                  --
                  select u.idusuario
                  into vidusuario
                  from usuarios u
                  where u.usuario = v('APP_USER');
                  --
                  pck_cadastros_fav.prc_codigosbarras_produtdet( pidprodutodetalhado => :idprodutodetalhado
                                                               , pidcodigobarra      => vidcodigobarra
                                                               , pcodigoean          => vcodigoean
                                                               , pidusuario          => vidusuario
                                                               , poperacao_dml       => 'I'
                                                               , msgerro             => vmensagem);
                  --
                  if vmensagem = 'Sucesso' then
                    --
                    apex_application.g_print_success_message := 'Codigo de barras gerado com sucesso';
                    --
                  else
                    --
                    apex_error.add_error(p_message          => 'Erro ao gerar o codigo de barras - '||vmensagem,
                                         p_display_location => apex_error.c_inline_with_field_and_notif);
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 5885333273788271025
        }
        serverSideCondition {
            type: request=Value
            value: GERARCODIGO
        }
    )

    branch (
        name: GoTo Page 188
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 188
                items: {
                    P188_IDPRODUTO: &P188_IDPRODUTO.
                }
                action: resetPagination
            }
        }
    )

)

