page 426 (
    name: Controle de Distribuidores
    title: Controle de Distribuidores
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region distribuidores (
        name: Distribuidores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(r.idrepresentante) distribuidor
                     , idrepresentante codigo
                     , decode(ativo,'S','Ativo','N','Inativo') ativo
                     , nvl(( select decode(pr.valor,'S','Sim','N','Não')
                             from roman.parametrosrepresentantes pr
                             where pr.idrepresentante = r.idrepresentante
                               and pr.parametro       = 'SPC_ATIVACONSULTATABLET' ),'Não') consultaliberada
                     , nvl(( select sum(rg.limiteconsultaspc)
                             from roman.regioesrepresentantes rg
                             where rg.idrepresentante = r.idrepresentante ),0) qtdconsultas
                     , nvl(( select count(rg.idsemana)
                             from roman.regioesrepresentantes rg
                             where rg.idrepresentante = r.idrepresentante ),0) qtdsemanas
                from representantes r
                where r.idgerente = ( select idgerente 
                                      from gerentes g
                                      where g.idfilial = :P426_IDFILIALROMANCE )
                order by 1
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: "Nenhuma Informação encontrada! "
        }
        advanced {
            savedReportMappingIdentifier: 5758951374529838
        }

        column ATIVO (
            type: plainText
            heading {
                heading: Ativo
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column CODIGO (
            type: link
            heading {
                heading: Ver/ Editar
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            link {
                target: {
                    page: 427
                    items: {
                        P427_IDREPRESENTANTE: #CODIGO#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column CONSULTALIBERADA (
            type: plainText
            heading {
                heading: Conulta Liberada?
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column DISTRIBUIDOR (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column QTDCONSULTAS (
            type: plainText
            heading {
                heading: Qtd de Consultas?
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column QTDSEMANAS (
            type: plainText
            heading {
                heading: Qtd de Semanas para Atender
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 58549 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ATIVO (
                sequence: 3
            )

            displayColumn CODIGO (
                sequence: 1
            )

            displayColumn CONSULTALIBERADA (
                sequence: 4
            )

            displayColumn DISTRIBUIDOR (
                sequence: 2
            )

            displayColumn QTDCONSULTAS (
                sequence: 5
            )

            displayColumn QTDSEMANAS (
                sequence: 6
            )

            filter ir-condition (
                column: ATIVO
                value: Ativo
            )

        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P426_IDFILIALROMANCE (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from roman.vw_filiais f
                where f.ativo = 'S'
                  and f.idgrupo != 5
                  and f.tipofilial = 'D'
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button buscar (
        buttonName: BUSCAR
        label: Buscar
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 426
                items: {
                    P426_IDFILIALROMANCE: &P426_IDFILIALROMANCE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

)

