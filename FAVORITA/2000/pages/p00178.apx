page 178 (
    name: Situações
    title: Situações
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region situações (
        name: Situações
        type: list
        source {
            list: @situações
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: Situações
            regionDisplaySelector: true
        }
        componentAppearance {
            listTemplate: @/cards
            templateOptions: [
                t-Cards--featured force-fa-lg
                t-Cards--displayIcons
                t-Cards--5cols
                u-colors
                t-Cards--animColorFill
            ]
        }
    )

)

