page 431 (
    name: Atendimento de Distribuidores
    title: Atendimento de Distribuidores
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 50%
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region distribuidores-que-atendem (
        name: Distribuidores que Atendem
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(r.idrepresentante) distribuidor
                     , ( select pck_util.fnc_semanaid(min(rg.idsemana))
                         from roman.regioesrepresentantes rg
                         where rg.idrepresentante = r.idrepresentante ) semanaatendimento
                     , rg.semana
                     , roman.pck_romance.fnc_nomeregiaovenda(rg.idregiaovenda) regiao
                     , ( select count(v.idvendedora)
                         from vendedoras v
                            , pessoas p
                         where v.idrepresentante = r.idrepresentante
                           and v.idregiaovenda    = rg.idregiaovenda
                           and p.idpessoa        = v.idpessoa
                           and ( :P431_PESQUISAR_POR is null
                            or ( :P431_PESQUISAR_POR = 'C' and p.idcidade = :P431_IDCIDADE )
                            or ( :P431_PESQUISAR_POR = 'B' and upper(p.bairro) like '%'||upper(:P431_BAIRRO)||'%' )
                            or ( :P431_PESQUISAR_POR = 'A' and ( p.idcidade = :P431_IDCIDADE and upper(p.bairro) like '%'||upper(:P431_BAIRRO)||'%' ) ) )
                           and exists ( select 1
                                        from roman.notasvendas nv
                                        where nv.idvendedora = v.idvendedora
                                          and nv.idsituacaonotavenda = 3 ) ) qtdconsultoras
                from representantes r
                   , roman.regioesrepresentantes rg
                where rg.idrepresentante = r.idrepresentante
                  and exists ( select 1
                               from roman.notasvendas nv
                                  , vendedoras v
                                  , pessoas p
                               where nv.idfilial            = :P431_IDFILIAL
                                 and p.idpessoa             = v.idvendedora
                                 and nv.idvendedora         = v.idvendedora
                                 and ( :P431_PESQUISAR_POR is null
                                  or ( :P431_PESQUISAR_POR = 'C' and p.idcidade = :P431_IDCIDADE )
                                  or ( :P431_PESQUISAR_POR = 'B' and upper(p.bairro) like '%'||upper(:P431_BAIRRO)||'%' )
                                  or ( :P431_PESQUISAR_POR = 'A' and ( p.idcidade = :P431_IDCIDADE and upper(p.bairro) like '%'||upper(:P431_BAIRRO)||'%' ) ) )
                                 and nv.idsituacaonotavenda = 3
                                 and nv.idrepresentante     = r.idrepresentante )
                order by rg.idsemana
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 3281773890730651349
        }

        column DISTRIBUIDOR (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column QTDCONSULTORAS (
            type: plainText
            heading {
                heading: Qtd Consultoras
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column REGIAO (
            type: plainText
            heading {
                heading: Setor
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column SEMANA (
            type: plainText
            heading {
                heading: Semana que será Atendido
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column SEMANAATENDIMENTO (
            type: plainText
            heading {
                heading: "Semana Atual "
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 40645381 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DISTRIBUIDOR (
                sequence: 1
            )

            displayColumn QTDCONSULTORAS (
                sequence: 4
            )

            displayColumn REGIAO (
                sequence: 3
            )

            displayColumn SEMANA (
                sequence: 2
            )

            displayColumn SEMANAATENDIMENTO (
                sequence: 5
            )

            filter ir-condition (
                column: QTDCONSULTORAS
                operator: >
                value: 0
            )

        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P431_BAIRRO (
        type: textField
        label {
            label: Bairro
            alignment: left
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P431_IDCIDADE (
        type: selectList
        label {
            label: Cidade
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(c.nomecidade) display_value
                     , c.idcidade return_value
                from roman.cidades c 
                   , roman.filiaisregioesvenda f
                where f.idestado = c.idestado
                  and f.idfilial = :P431_IDFILIAL
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P431_IDFILIAL
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P431_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idfilial
                from roman.vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                  and f.idgrupo != 5
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P431_PESQUISAR_POR (
        type: radioGroup
        label {
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Cidades;C,Bairros;B,Ambos;A
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: B
        }
        security {
            encryptSessionState: false
        }
    )

    button buscar (
        buttonName: BUSCAR
        label: Buscar
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ambos (
        name: Ambos
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P431_PESQUISAR_POR
        }
        clientSideCondition {
            type: item=value
            item: P431_PESQUISAR_POR
            value: A
        }

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P431_IDCIDADE
                    P431_BAIRRO
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction mostra-bairro (
        name: Mostra Bairro
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P431_PESQUISAR_POR
        }
        clientSideCondition {
            type: item=value
            item: P431_PESQUISAR_POR
            value: B
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P431_IDCIDADE
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P431_BAIRRO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction mostra-cidade (
        name: Mostra Cidade
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P431_PESQUISAR_POR
        }
        clientSideCondition {
            type: item=value
            item: P431_PESQUISAR_POR
            value: C
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P431_BAIRRO
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P431_IDCIDADE
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: Go To Page 431
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 431
                items: {
                    P431_IDFILIAL: &P431_IDFILIAL.
                    P431_BAIRRO: &P431_BAIRRO.
                    P431_IDCIDADE: &P431_IDCIDADE.
                    P431_PESQUISAR_POR: &P431_PESQUISAR_POR.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

)

