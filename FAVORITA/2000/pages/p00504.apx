    region datas-integrações-pessoas (
        name: Datas Integrações Pessoas
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select 'Última Integração com Sucesso'  descricao
                     , to_char(max(pp.dataintegracao),'dd/mm/rrrr hh24:mi:ss') data
                from pessoas pp
                where situacaointegracao = 'I'
                union
                select 'Última Integração com Erro'  descricao
                     , to_char(max(pp.dataintegracao),'dd/mm/rrrr hh24:mi:ss') data
                from pessoas pp
                where situacaointegracao in ( 'E','Z')
                union
                select 'Mais antigo da fila'  descricao
                     , to_char(min(pp.dataintegracao),'dd/mm/rrrr hh24:mi:ss') data
                from pessoas pp
                where situacaointegracao is null
                  and pp.cpf is not null or pp.documentoestrangeiro is not null
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: DESCRICAO
            valueColumn: DATA
        }
    )

    region informações-do-produto (
        name: Informações do Produto
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.referencia
                     , p.nomeproduto
                     , p.situacaointegracao situacaointegracaopai
                     , p.dataintegracao dataintegracaopai
                     , favorita.pck_util_fav.fnc_nomecaracteristica(pd.idcaracteristica,1) caracteristica
                     , favorita.pck_util_fav.fnc_nomecor(pd.idcor,1) cor
                     , favorita.pck_util_fav.fnc_siglagrade(pd.idgrade,1) grade
                     , pd.situacaointegracao
                     , pd.dataintegracao
                     , favorita.pck_util_fav.fnc_edicaorevista(pr.idedicaorevista) Edição
                     , pr.valorvenda
                from favorita.produtos p
                   , favorita.produtosdetalhados pd
                   , favorita.precosprodutos pr
                where p.idproduto = pd.idproduto
                  and pd.idprodutodetalhado = pr.idprodutodetalhado
                  and pr.idfilialromance = 100 
                  and pr.idedicaorevista = :P504_IDEDICAO
                  and p.referencia = :P504_REFERENCIAS;
                ```
        }
        layout {
            sequence: 10
            parentRegion: @produtos
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum produto encontrado, verifique os filtros.
        }
        advanced {
            savedReportMappingIdentifier: 107918727586857203
        }

