    process coloca-produto-unico-na-fila (
        name: Coloca Produto Unico na Fila
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update favorita.produtos p
                     set p.situacaointegracao = null
                       , p.dataintegracao = null
                  where p.referencia = :P504_REFERENCIAS; 
                
                
                  update favorita.produtosdetalhados p
                     set p.situacaointegracao = null
                       , p.dataintegracao = null
                  where exists ( select 1
                                 from favorita.produtos pp
                                 where pp.idproduto = p.idproduto
                                   and pp.referencia = :P504_REFERENCIAS
                    and p.ativo = 'S'
                  );
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Fila atualizada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 107920125410857217
        }
        serverSideCondition {
            type: request=Value
            value: COLOCAR_NA_FILA
        }
    )

    process coloca-produtos-na-fila (
        name: Coloca Produtos na FIla
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vcount number := 0;
                  --
                begin
                  --
                  for prod in ( select *
                                from produtos p
                                where p.dataintegracao is not null
                                  and p.liberarvenda = 'S' )
                  loop
                    --
                    update produtos p
                    set p.dataintegracao = null
                      , p.situacaointegracao = null
                      , p.mensagemintegracao = null
                    where p.idproduto = prod.idproduto;
                    --
                    update produtosdetalhados pd
                    set pd.dataintegracao = null
                      , pd.situacaointegracao = null
                      , pd.mensagemintegracao = null
                    where pd.idproduto = prod.idproduto
                      and pd.ativo = 'S';
                    --
                    update atualizaestoqueswide e
                    set e.dataintegracao = null
                      , e.situacaointegracao = null
                      , e.mensagemintegracao = null
                    where e.idprodutodetalhado in ( select pd.idprodutodetalhado
                                                    from produtosdetalhados pd
                                                    where pd.idproduto = prod.idproduto );
                    --
                    if vcount = 100 then
                      commit;
                      vcount := 1;
                    else
                      vcount := vcount + 1;
                    end if;
                    --
                  end loop;
                  --
                  commit;
                  --
                end;
                  
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Produtos colocados na fila para Integração!
        }
        advanced {
            executionMappingIdentifier: 105266570217959333
        }
        serverSideCondition {
            whenButtonPressed: @integra-produtos
        }
    )

    process integrar-pessoa (
        name: Integrar Pessoa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  if :P504_IDPESSOA is null and :P504_CPF is not null then
                    --
                    select p.idpessoa
                    into :P462_IDPESSOA
                    from catal.pessoas p
                    where p.cpf = :P504_CPF;
                    --
                  end if;
                  --
                  favorita.pck_integracao_epicom.prc_enviapessoas_epicom(pidpessoa => :P504_IDPESSOA );
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Fila atualizada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 107920746553857223
        }
        serverSideCondition {
            type: request=Value
            value: ENVIAR_EPICOM
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 504
                items: {
                    P504_REFERENCIAS: &P504_REFERENCIAS.
                    P504_NAEDICAO: &P504_NAEDICAO.
                    P504_IDEDICAO: &P504_IDEDICAO.
                    P504_COMPRECONAEDICAO: &P504_COMPRECONAEDICAO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar-produto
        }
    )

)

