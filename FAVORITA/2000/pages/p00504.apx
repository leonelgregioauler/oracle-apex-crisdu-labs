        layout {
            sequence: 20
            region: @produtos
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select distinct nvl('Sim','N') 
                from favorita.produtosdetedrevistas pdr  
                   , favorita.produtos p
                   , favorita.produtosdetalhados pd
                where p.idproduto = pd.idproduto
                  and pd.idprodutodetalhado = pdr.idprodutodetalhado
                  and pdr.idedicaorevista = :P504_IDEDICAO
                  and p.referencia = :P504_REFERENCIAS;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

