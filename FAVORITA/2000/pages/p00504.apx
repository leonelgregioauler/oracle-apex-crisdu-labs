            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region monitoramento-de-estoque (
        name: Monitoramento de Estoque
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select tipo
                     , qtd
                from ( select 'Estoques Integrados' tipo
                            , count(1) qtd
                            , 1 ordem
                       from atualizaestoqueswide e
                       where e.situacaointegracao = 'I'
                         and e.idprodutodetalhadowidecomm is not null
                         and e.idfilialfavorita not in (75,30,9)
                         and exists ( select 1
                                      from filiaisfavorita ff
                                      where ff.idfilialfavorita = e.idfilialfavorita
                                      and ff.tipofilial = 'E' )
                         and not exists ( select 1
                                          from favorita.classificacoesprodutos cp
                                          where cp.idprodutodetalhado = e.idprodutodetalhado
                                            and cp.idtagproduto = 2)
                       union
                       select 'Estoques Integrados Com Erro' tipo
                            , count(1) qtd
                            , 2 ordem
                       from atualizaestoqueswide e
                       where e.situacaointegracao = 'E'
                         and e.idprodutodetalhadowidecomm is not null
                         and e.idfilialfavorita not in (75,30,9)
                         and exists ( select 1
                                      from filiaisfavorita ff
                                      where ff.idfilialfavorita = e.idfilialfavorita
                                      and ff.tipofilial = 'E' )
                         and not exists ( select 1
                                          from favorita.classificacoesprodutos cp
                                          where cp.idprodutodetalhado = e.idprodutodetalhado
                                            and cp.idtagproduto = 2)
                       union
                       select 'Estoques P/ Integrar' tipo
                            , count(1) qtd
                            , 3 ordem
                       from atualizaestoqueswide e
                       where e.situacaointegracao is null
                         and e.idprodutodetalhadowidecomm is not null
                         and e.idfilialfavorita not in (75,30,9)
                         and exists ( select 1
                                      from filiaisfavorita ff
                                      where ff.idfilialfavorita = e.idfilialfavorita
                                      and ff.tipofilial = 'E' )
                         and not exists ( select 1
                                          from favorita.classificacoesprodutos cp
                                          where cp.idprodutodetalhado = e.idprodutodetalhado
                                            and cp.idtagproduto = 2)  ) d
                order by ordem
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: TIPO
            valueColumn: QTD
        }
    )

    region monitoramento-de-pessoas (
        name: Monitoramento de Pessoas
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select decode(situacaointegracao , 'I' , 'Integrado com Sucesso'
                                                 , 'E' , 'Erro ao Integrar'
                                                 , 'F' , 'Aguardando Integração'
                                                 , 'Z' , 'Resultado Retornado em Branco'
                                                 , 'W' , 'Integração em Andamento'
                                                 , null, 'Novos para integrar'
                                                 , 'Desconhecido') descricao
                     , to_char(count(1))  qtd
                     , 1 
                from pessoas 
                where dataintegracao > trunc(sysdate)
                  and situacaointegracao    = 'I'
                  and ( cpf is not null or documentoestrangeiro is not null)
                group by situacaointegracao
                union
                select 'Integração em Andamento' display_value
                     , to_char(count(1)) return_value
                     , 2
                from dba_jobs a
                where what like 'begin favorita.pck_integracao_epicom.prc_enviapessoas_epico%'
                union
                select 'Tempo para concluir' display_value
                     , pck_util.fnc_tempodecorrido( (max( a.NEXT_DATE)-sysdate ),'M') ultimo
                     , 3
                from dba_jobs a
                where what like 'begin favorita.pck_integracao_epicom.prc_enviapessoas_epico%'
                union
                select 'Novos para Integrar' descricao
                     , to_char(count(1))  qtd
                     , 4
                from pessoas  p
                where situacaointegracao     is null  
                  and ( cpf is not null or documentoestrangeiro is not null)
                  and idpais             = 1   
                  and p.ultimaatualizacao >= sysdate -42
                  and p.idpessoasitefavorita is null
                  and exists ( select 1
                               from vendedoras v
                               where v.idpessoa = p.idpessoa
                                 and v.ativo = 'S')  
                union
                select 'Atualizações para Integrar' descricao
                     , to_char(count(1))  qtd
                     , 5
                from (
                        select nomepessoa
                             , cpf
                             , ultimaatualizacao
                             , dataintegracao
                        from pessoas  p
                        where situacaointegracao     is null  
                          and ( cpf is not null or documentoestrangeiro is not null)
                          and idpais             = 1   
                          and p.ultimaatualizacao >= sysdate -42
                          and exists ( select 1 
                                       from vendedoras v 
                                       where v.idpessoa = p.idpessoa    )
                        union
                        select nomepessoa
                             , cpf
                             , ultimaatualizacao
                             , dataintegracao
                        from catal.pessoas p
                        where situacaointegracao     is null  
                          and ( cpf is not null or documentoestrangeiro is not null)
                          and idpais             = 1   
                          and p.ultimaatualizacao >= sysdate -42
                          and p.dataintegracao < ( select v.ultimaatualizacao
                                                   from catal.vendedoras v
                                                   where v.idpessoa = p.idpessoa ) )
                union
                select 'Erro ao Integrar' descricao
                     , to_char(count(1))  qtd
                     , 6
                from pessoas P
                where situacaointegracao    in ('Z', 'E' )
                  and ( cpf is not null or documentoestrangeiro is not null)      
                        AND EXISTS ( SELECT 1 FROM VENDEDORAS V WHERE V.IDPESSOA = P.IDPESSOA)
                  and idpais                = 1 
                order by 3
                ```
        }
        layout {
            sequence: 50
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: DESCRICAO
            valueColumn: QTD
        }
    )

    region monitoramento-de-produtos (
        name: Monitoramento de Produtos
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select d.tipo
                     , d.qtd
                from ( select 'Produtos p/ Integrar' tipo
                            , count(1) qtd
                            , 1 ordem
                       from produtos p
                       where situacaointegracao is null
                         and p.liberarvenda = 'S'
                         and exists ( select 1
                                      from favorita.produtosdetalhados pd
                                      where pd.idproduto = p.idproduto
                                        and pd.situacaointegracao is null
                                        and not exists ( select 1
                                                         from favorita.classificacoesprodutos cp
                                                         where cp.idprodutodetalhado = pd.idprodutodetalhado
                                                           and cp.idtagproduto in (24,123)))
                         and exists ( select 1
                                      from favorita.precosprodutos pp
                                         , favorita.produtosdetalhados pd
                                      where pp.idprodutodetalhado = pd.idprodutodetalhado
                                        and pd.idproduto = p.idproduto
                                        and exists ( select 1
                                                     from favorita.produtosdetedrevistas pr
                                                     where pr.idprodutodetalhado = pp.idprodutodetalhado
                                                       and pr.idedicaorevista = pp.idedicaorevista))
                       union
                       select 'Prod. Detal. p/ Integrar'
                            , count(1)
                            , 2 ordem
                       from produtosdetalhados ppd
                       where situacaointegracao is null
                         and not exists ( select 1
                                          from favorita.classificacoesprodutos cp
                                          where cp.idprodutodetalhado = ppd.idprodutodetalhado
                                            and cp.idtagproduto in (24,123))
                         and exists ( select 1
                                      from favorita.produtos p
                                      where p.idproduto = ppd.idproduto
                                        and p.situacaointegracao is null
                                        and p.liberarvenda = 'S')
                         and exists ( select 1
                                      from favorita.precosprodutos pp
                                      where pp.idprodutodetalhado = ppd.idprodutodetalhado
                                        and exists ( select 1
                                                     from favorita.produtosdetedrevistas pr
                                                     where pr.idprodutodetalhado = pp.idprodutodetalhado
                                                       and pr.idedicaorevista = pp.idedicaorevista)) ) d
                order by d.ordem
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: TIPO
            valueColumn: QTD
        }
    )

