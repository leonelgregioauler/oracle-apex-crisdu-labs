    region cadastros-pessoas-com-erro-de-integração (
        name: Cadastros Pessoas com erro de Integração
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                 select pw.idpessoa,
                        pw.nomepessoa,
                        pw.cpf,
                        pw.dataintegracao,
                        pw.mensagemintegracao,
                        decode(situacaointegracao , 'I' , 'Integrado com Sucesso'
                                                 , 'E' , 'Erro ao Integrar'
                                                 , 'F' , 'Aguardando Integração'
                                                 , 'Z' , 'Resultado Retornado em Branco'
                                                 , 'W' , 'Integração em Andamento'
                                                 , null, 'Novos para integrar'
                                                 , 'Desconhecido') descricao,
                        pw.ultimaatualizacao
                from pessoas Pw
                where situacaointegracao    in ('Z', 'E' )
                  and ( cpf is not null or documentoestrangeiro is not null)      
                        AND EXISTS ( SELECT 1 FROM VENDEDORAS V WHERE V.IDPESSOA = Pw.IDPESSOA)
                  and idpais                = 1 
                ```
        }
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 105266916216959337
        }

