page 317 (
    name: Liberação de Encerramento de Fechamentos
    title: Liberação de Encerramento de Fechamentos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region liberação-de-encerramento-de-fechamentos (
        name: Liberação de Encerramento de Fechamentos
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P317_DATACORRECAO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @liberação-de-encerramento-de-fechamentos
            slot: regionBody
        }
        appearance {
            formatMask: DD/MM/RRRR HH24:MI:SS
        }
        source {
            type: databaseColumn
            databaseColumn: DATACORRECAO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  return sysdate;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P317_IDCORRECAOFECHAMENTOSEMAN (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @liberação-de-encerramento-de-fechamentos
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDCORRECAOFECHAMENTOSEMANAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P317_IDFECHAMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @liberação-de-encerramento-de-fechamentos
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFECHAMENTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P317_MOTIVO (
        type: textarea
        label {
            label: Motivo
            alignment: left
        }
        settings {
            autoHeight: true
            charCounter: true
        }
        layout {
            sequence: 10
            region: @liberação-de-encerramento-de-fechamentos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            height: 5
        }
        validation {
            maxLength: 4000
        }
        source {
            type: databaseColumn
            databaseColumn: MOTIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P317_USUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @liberação-de-encerramento-de-fechamentos
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: USUARIO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  return v('APP_USER');
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    button criar (
        buttonName: CRIAR
        label: Criar
        layout {
            sequence: 20
            region: @liberação-de-encerramento-de-fechamentos
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 10
            region: @liberação-de-encerramento-de-fechamentos
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
    )

    process fetch-row-from-correcoesfechamentossemanais (
        name: Fetch Row from CORRECOESFECHAMENTOSSEMANAIS
        type: autoRowProcessing
        target {
            tableOwner: ROMAN
            tableName: CORRECOESFECHAMENTOSSEMANAIS
            pkColumn: IDCORRECAOFECHAMENTOSEMANAL
            pkItem: P317_IDCORRECAOFECHAMENTOSEMAN
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1500647343283625808
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P317_IDCORRECAOFECHAMENTOSEMAN is null then
                        select ROMAN.SEQ_IDCORRECAOFECHAMENTO.nextval
                        into :P317_IDCORRECAOFECHAMENTOSEMAN
                        from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1500646670330625801
        }
        serverSideCondition {
            whenButtonPressed: @criar
        }
    )

    process libera-conclusão-da-semana (
        name: Libera conclusão da Semana
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update fechamentossemanais f
                  set f.liberarconclusao = 'S'
                  where f.idfechamento = :P317_IDFECHAMENTO;
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Liberação realizada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1500647081335625805
        }
        serverSideCondition {
            whenButtonPressed: @criar
        }
    )

    process new (
        name: New
        type: autoRowProcessing
        target {
            tableOwner: ROMAN
            tableName: CORRECOESFECHAMENTOSSEMANAIS
            pkColumn: IDCORRECAOFECHAMENTOSEMANAL
            pkItem: P317_IDCORRECAOFECHAMENTOSEMAN
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 1500646985804625804
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 272
                action: resetPagination
            }
        }
    )

)

