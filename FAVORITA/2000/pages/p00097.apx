page 97 (
    name: Gerar Tarefas
    title: Gerar Tarefas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region gerar-tarefas (
        name: Gerar Tarefas
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P97_DATAFIM (
        type: datePickerJquery
        label {
            label: até
            alignment: left
        }
        layout {
            sequence: 50
            region: @gerar-tarefas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P97_DATAINI (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 40
            region: @gerar-tarefas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P97_IDFILIAL (
        type: selectList
        label {
            label: Filial
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select (select initcap(nvl(apelido,nomepessoa))
                        from pessoas 
                        where idpessoa = f.idpessoa )|| CASE when v('APP_USER') in ('EVERTON','GUILHERME','LUIZV') then
                                                                    ' - '||f.idfilial
                                                                    end display_value
                     , f.idfilial return_value
                from filiais f
                where f.tipofilial = 'D'
                  and f.ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 60
            region: @gerar-tarefas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P97_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(pidrepresentante => r.idrepresentante)||' ('||r.idrepresentante||')' || decode(r.ativo,'S','','Inativo') display_value
                     , r.idrepresentante return_value
                from representantes r
                where idgerente in ( select idgerente
                                     from gerentes
                                     where idfilial = :P97_IDFILIAL)
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P97_IDFILIAL
        }
        layout {
            sequence: 70
            region: @gerar-tarefas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P97_SEMANAFIM (
        type: textField
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 30
            region: @gerar-tarefas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        validation {
            maxLength: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P97_SEMANAINI (
        type: textField
        label {
            label: Semana
            alignment: left
        }
        layout {
            sequence: 20
            region: @gerar-tarefas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        validation {
            maxLength: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P97_SISTEMA (
        type: radioGroup
        label {
            label: Sistema
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Romance;R,Favorita;F
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @gerar-tarefas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: R
        }
        security {
            encryptSessionState: false
        }
    )

    button gerar (
        buttonName: GERAR
        label: Gerar Tarefas
        layout {
            sequence: 20
            region: @gerar-tarefas
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @gerar-tarefas
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-undo
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 94
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction tipo-sistema (
        name: Tipo Sistema
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P97_SISTEMA
        }
        clientSideCondition {
            type: item=value
            item: P97_SISTEMA
            value: R
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P97_SEMANAINI
                    P97_SEMANAFIM
                ]
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P97_DATAINI
                    P97_DATAFIM
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P97_SEMANAINI
                    P97_SEMANAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P97_DATAINI
                    P97_DATAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    process gerar-tarefas (
        name: Gerar Tarefas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  PCK_TAREFAS_FAV.prc_gerartarefascobranca ( psistema    => :P97_SISTEMA
                                                           , psemanaini  => :P97_SEMANAINI
                                                           , psemanafim  => :P97_SEMANAFIM
                                                           , pdatainicio => :P97_DATAINI
                                                           , pdatafim    => :P97_DATAFIM
                                                           , pidfilial   => :P97_IDFILIAL
                                                           , pidrepres   => :P97_IDREPRESENTANTE );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 13231394952409536
        }
        serverSideCondition {
            whenButtonPressed: @gerar
        }
    )

)

