page 595 (
    name: Lista de Pedidos
    title: Lista de Pedidos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    css {
        inline: "@page { size: landscape; }"
    }
    security {
        pageAccessProtection: unrestricted
    }

    region lista-pedidos (
        name: Lista Pedidos
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                    cursor cped (i_idrep in number) is
                      select p.idrepresentante
                           , p.representante
                           , p.idvendedora
                           , p.vendedora
                           , p.valorapagar
                           , p.numeropedido
                           , to_date(p.dataemissao,'DD/MM/RRRR') dataemissao
                           , to_date(p.dataentrega,'DD/MM/RRRR') dataentrega
                           --
                           , (select to_char(dataclassificado,'dd/mm/rrrr hh24:mi:ss')
                                from classificacoespedidos
                               where idcaracteristicapedido = 103
                                 and idpedido = p.idpedido) entreguedistribuidor
                           --
                        from vw_pedidos_fav p
                       where p.ididioma = 1 --pididioma
                         and p.idrepresentante = i_idrep
                         and idpedido in ( SELECT C001
                                             FROM APEX_COLLECTIONS
                                            WHERE COLLECTION_NAME =  'COL_IMPRIMEREL_'||v('APP_USER') );
                    --
                    rped  cped%rowtype;
                    --
                    vcount number;
                begin
                    --
                  for c1 in (select distinct idrepresentante idrep
                               from pedidos 
                              where idpedido in ( SELECT C001
                                                    FROM APEX_COLLECTIONS
                                                   WHERE COLLECTION_NAME =  'COL_IMPRIMEREL_'||v('APP_USER')  ) )
                  loop
                    
                    htp.p('<html>');
                    htp.p('<head>');
                    htp.p('</head>');
                    htp.p('<body>');
                    htp.p('<style type="text/css">');
                    htp.p('P.QuebraAqui {page-break-before: always}');
                    --
                    htp.p('<!--');
                    htp.p('
                          table {
                                  border: 1 px solid black;
                                  position:none;
                                  padding: 0 px 0 px 0 px;
                                  width:100%;
                                font-size: 10pt;
                               }
                          td {
                               border: 1 px solid black;
                               line-height:150%;
                            }');
                    htp.p('-->');
                    htp.p('</style>');
                    htp.p('<table border=1>');
                    --
                    htp.p('  <tr>');
                    htp.p('    <td align="center"> LISTA DE PEDIDOS PARA SEREM ENTREGUES </td>');
                    htp.p('  </tr>');
                    --
                    htp.p('<table border=1>');
                    htp.p('  <tr>');
                    htp.p('    <td align="left" width="10%"><b>Nr Pedido</b> </td>');
                    htp.p('    <td align="left" width="25%"><b>Distribuidor</b></td>');
                    htp.p('    <td align="left" width="25%"><b>Cliente</b></td>');
                    htp.p('    <td align="left" width="10%"> <b>Emissão</b></td>');
                    htp.p('    <td align="left" width="10%"> <b>Entrega</b></td>');
                    htp.p('    <td align="center" width="10%"> <b>Valor</b> </td>');
                    htp.p('    <td align="center" width="10%"> <b>Entregue Dist.</b></td>');
                    htp.p('  </tr>');
                    --
                    OPEN cped (c1.idrep);
                    LOOP
                      --
                      htp.p('<table border=1>');
                      --
                      FETCH cped INTO rped;
                      EXIT WHEN cped%NOTFOUND;
                      --
                      htp.p('<tr>');
                      htp.p('  <td width="10%">'||rped.numeropedido||'</td>');
                      htp.p('  <td width="25%">'||rped.representante||'</td>');
                      htp.p('  <td width="25%">'||rped.vendedora||'</td>');
                      htp.p('  <td align="left" width="10%">'||rped.dataemissao||'</td>');
                      htp.p('  <td align="left" width="10%">'||rped.dataentrega||'</td>');
                      htp.p('  <td align="right" width="10%">'||trim(to_char(rped.valorapagar,'999G999G999G990D00'))||'</td>');
                      htp.p('  <td align="center" width="10%">'||rped.entreguedistribuidor||'</td>');
                      htp.p('</tr>');
                      htp.p('</table>');
                      
                    END LOOP;
                      htp.p('<br>');
                      htp.p('<br>');
                      htp.p('<br>');
                      htp.p('<br>');
                      --
                      htp.p('<hr size="10" width="50%" align="center" noshade>');
                      htp.p('<p align="center"> Confirmo o recebimento dos pedidos acima informados </p>');
                      htp.p('<br>');
                      htp.p('<br>');
                
                    CLOSE cped; 
                    
                  end loop;
                  
                end;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    button imprimir (
        buttonName: IMPRIMIR
        label: Imprimir
        layout {
            sequence: 10
            region: @lista-pedidos
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-print
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @imprimir
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    //// Collapse Left Navigation Bar If It Was Expanded ////
                    var navCollapsed = 0;
                    if ($("body").hasClass("js-navExpanded")) {
                        $("#t_Button_navControl").click();
                        navCollapsed = 1;
                    };
                    setTimeout(3000);
                    
                    //////// Hide ////////
                    
                    //Hide Navigation Bar List
                    $("#t_Header").hide();
                    
                    //Hide Navigation Menu
                    $("#t_Body_nav").hide();
                    
                    //Hide Breadcrumb
                    $("#t_Body_title").hide();
                    
                    //Hide Content Offset
                    $("#t_Body_content_offset").hide();
                    
                    //Hide Report Column Edit Link
                    $(".apex-edit-page").hide();
                    
                    //Hide Report Download Links
                    $(".t-Report-links").hide();
                    
                    //Hide Buttons
                    $(".t-Button").hide();
                    
                    //Hide Footer
                    $(".t-Footer").hide();
                    
                    
                    //////// Browser Print ////////
                    window.print();
                    
                    
                    //////// Show ////////
                    
                    //Show Navigation Bar List
                    $("#t_Header").show();
                    
                    //Show Navigation Menu
                    $("#t_Body_nav").show();
                    
                    //Show Breadcrumb
                    $("#t_Body_title").show();
                    
                    //Show Content Offset
                    $("#t_Body_content_offset").show();
                    
                    //Show Report Column Edit Link
                    $(".apex-edit-page").show();
                    
                    //Show Report Download Links
                    $(".t-Report-links").show();
                    
                    //Show Buttons
                    $(".t-Button").show();
                    
                    //Show Footer
                    $(".t-Footer").show();
                    
                    
                    //// Expand Left Navigation Bar If It Was Colapsed ////
                    if ( navCollapsed == 1 ) {
                        $("#t_Button_navControl").click();
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

