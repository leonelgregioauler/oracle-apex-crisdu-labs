page 24 (
    name: Cadastro de Situações Entrega
    title: Situações Entrega
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region situações-entrega (
        name: Situações Entrega
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P24_CODIGOCOR (
        type: colorPicker
        label {
            label: Código da Cor
            alignment: left
        }
        layout {
            sequence: 50
            region: @situações-entrega
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: " - Selecione a Cor - "
        }
    )

    pageItem P24_DESCRICAOSISTEMA (
        type: textField
        label {
            label: Descrição do Sistema
            alignment: left
        }
        layout {
            sequence: 20
            region: @situações-entrega
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P24_DESCRICAOSITE (
        type: textField
        label {
            label: Descrição do Site
            alignment: left
        }
        layout {
            sequence: 30
            region: @situações-entrega
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P24_IDSITUACAOENTREGA (
        type: hidden
        layout {
            sequence: 10
            region: @situações-entrega
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P24_IDTEXTOSISTEMA (
        type: hidden
        layout {
            sequence: 70
            region: @situações-entrega
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P24_IDTEXTOSITE (
        type: hidden
        layout {
            sequence: 80
            region: @situações-entrega
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P24_MD5 (
        type: hidden
        layout {
            sequence: 90
            region: @situações-entrega
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P24_OPERACAO_DML (
        type: hidden
        layout {
            sequence: 100
            region: @situações-entrega
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P24_PODEEDITARPEDIDO (
        type: radioGroup
        label {
            label: Pode Editar Pedido
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-simnao
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @situações-entrega
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: staticValue
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P24_RESERVAESTOQUE (
        type: radioGroup
        label {
            label: Reserva Estoque
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-simnao
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @situações-entrega
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: S
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 50
            region: @situações-entrega
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P24_IDSITUACAOENTREGA
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 40
            region: @situações-entrega
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P24_IDSITUACAOENTREGA
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 30
            region: @situações-entrega
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 23
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 20
            region: @situações-entrega
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P24_IDSITUACAOENTREGA
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @situações-entrega
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P24_IDSITUACAOENTREGA
        }
    )

    validation descricaosistema-obrigatório (
        name: DESCRICAOSISTEMA obrigatório
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P24_DESCRICAOSISTEMA
            alwaysExecute: true
        }
        error {
            errorMessage: Descrição do sistema deve ter um valor.
            associatedItem: @P24_DESCRICAOSISTEMA
        }
    )

    validation descricaosite-obrigatório (
        name: DESCRICAOSITE obrigatório
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P24_DESCRICAOSITE
            alwaysExecute: true
        }
        error {
            errorMessage: Descrição do site deve ter um valor.
            associatedItem: @P24_DESCRICAOSITE
        }
    )

    process consulta-situações-entrega (
        name: Consulta Situações Entrega
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                #OWNER#.PCK_CADASTROSSITUACOES_FAV.PRC_SITUACOESENTREGA (
                  PIDSITUACAOENTREGA => :P24_IDSITUACAOENTREGA,
                  PDESCRICAOSISTEMA => :P24_DESCRICAOSISTEMA,
                  PDESCRICAOSITE => :P24_DESCRICAOSITE,
                  PRESERVAESTOQUE => :P24_RESERVAESTOQUE,
                  PCODIGOCOR => :P24_CODIGOCOR,
                  PPODEEDITARPEDIDO => :P24_PODEEDITARPEDIDO,
                  PMD5 => :P24_MD5,
                  POPERACAO_DML => 'S');
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 3315008262101022
        }
    )

    process limpar-campos-ao-sair (
        name: Limpar Campos ao Sair
        type: clearSessionState
        execution {
            sequence: 10
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 3315943923101031
        }
    )

    process limpar-campos-para-adicionar (
        name: Limpar Campos para Adicionar
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 3316050716101032
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    process operação-dml-em-situações-entrega (
        name: Operação DML em Situações Entrega
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  #OWNER#.PCK_CADASTROSSITUACOES_FAV.PRC_SITUACOESENTREGA (
                    PIDSITUACAOENTREGA => :P24_IDSITUACAOENTREGA,
                    PDESCRICAOSISTEMA => :P24_DESCRICAOSISTEMA,
                    PDESCRICAOSITE => :P24_DESCRICAOSITE,
                    PRESERVAESTOQUE => :P24_RESERVAESTOQUE,
                    PCODIGOCOR => :P24_CODIGOCOR,
                    PPODEEDITARPEDIDO => :P24_PODEEDITARPEDIDO,
                    PMD5 => :P24_MD5,
                    POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 3338251133302571
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 24
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

)

