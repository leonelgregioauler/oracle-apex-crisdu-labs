page 210 (
    name: Cadastro de Código de Barras
    title: Cadastro de Código de Barras
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-de-código-de-barra (
        name: Cadastro de Código de Barra
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P210_CODIGODEBARRA (
        type: textField
        label {
            label: Codigo de barra
            alignment: left
        }
        layout {
            sequence: 30
            region: @cadastro-de-código-de-barra
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P210_FECHATELA (
        type: hidden
        layout {
            sequence: 40
            region: @cadastro-de-código-de-barra
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P210_IDCODIGODEBARRA (
        type: hidden
        layout {
            sequence: 20
            region: @cadastro-de-código-de-barra
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P210_IDPRODUTO (
        type: hidden
        layout {
            sequence: 50
            region: @cadastro-de-código-de-barra
            slot: regionBody
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                --
                vidproduto number;
                --
                Begin
                
                select p.idproduto
                into vidproduto
                from produtosdetalhados p
                where p.idprodutodetalhado = :P210_IDPRODUTODETALHADO;
                
                return vidproduto;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P210_IDPRODUTODETALHADO (
        type: hidden
        layout {
            sequence: 10
            region: @cadastro-de-código-de-barra
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button salvar (
        buttonName: Salvar
        label: Salvar
        layout {
            sequence: 10
            region: @cadastro-de-código-de-barra
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: Voltar
        label: Voltar
        layout {
            sequence: 20
            region: @cadastro-de-código-de-barra
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-reply
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 188
                items: {
                    P188_IDPRODUTO: &P210_IDPRODUTO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation enumerico (
        name: Enumerico
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNumeric
            item: P210_CODIGODEBARRA
        }
        error {
            errorMessage: Código deve ser numérico.
        }
    )

    validation jatemcodigo (
        name: JaTemCodigo
        execution {
            sequence: 30
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from produtosdetalhados pp
                where pp.idprodutodetalhado = :P210_IDPRODUTODETALHADO
                  and pp.idcodigobarra is not null
                ```
            alwaysExecute: true
        }
        error {
            errorMessage: Produto já possui código de barra.
        }
        serverSideCondition {
            type: itemIsNumeric
            item: P210_CODIGODEBARRA
        }
    )

    validation vazio (
        name: Vazio
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P210_CODIGODEBARRA
        }
        error {
            errorMessage: Informe o código de barra.
        }
        serverSideCondition {
            type: itemIsNumeric
            item: P210_CODIGODEBARRA
        }
    )

    process informacodigo (
        name: INFORMACODIGO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  pidprodutodetalhado number;
                  pverifica           number;
                  pcodigodebarra      number;
                  pvcodigodebarra     number;
                
                  --
                begin
                  -- 
                  pidprodutodetalhado := :P210_IDPRODUTODETALHADO;
                  pcodigodebarra      := :P210_CODIGODEBARRA;
                  pverifica := null;
                
                  --
                  pverifica := pck_cadastros_fav.fnc_retornacodigodebarras ( vidprodutodetalhado => pidprodutodetalhado );
                  --
                  pck_cadastros_fav.prc_cadcodbarrasfornecedor ( vidprodutodetalhado => pidprodutodetalhado
                                                               , vcodigodebarra      => pcodigodebarra);
                  :P210_FECHATELA:= 1;
                  --
                
                  /*exception
                  when TOO_MANY_ROWS then
                  raise_application_error (-20556, 'Codigo de barra duplicado, entre em contato com a ti');*/
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Cadastrado com Sucesso
        }
        advanced {
            executionMappingIdentifier: 577475524717882582
        }
    )

    branch (
        name: Redireciona para 188
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 188
                items: {
                    P188_IDPRODUTO: &P210_IDPRODUTO.
                }
            }
        }
    )

)

