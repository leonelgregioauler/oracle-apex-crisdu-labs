    region definir-itens-de-revista-e-morte-programada (
        name: Definir Itens de Revista e Morte Programada
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT iv.iditemviradadecatalogo
                     , iv.idviradadecatalogo
                     , iv.idprodutodetalhado
                     , iv.valorvenda
                     , iv.morteprogramada
                     
                    /* , CASE 
                         WHEN iv.morteprogramada = 'S' then
                           APEX_ITEM.CHECKBOX2(1, iv.morteprogramada , 'CHECKED' ) 
                         ELSE
                           APEX_ITEM.CHECKBOX2(1, iv.morteprogramada , NULL ) 
                       END "MP_3" */
                       
                     , iv.perccomissaoven
                     , iv.pontosproduto
                     , iv.idtagproduto
                     , iv.idprecoproduto
                     , iv.perccomissaodis
                     , iv.perccomissaoger
                     , iv.valorcusto
                     , iv.idfilialromance
                     , iv.idcategoria
                     , iv.indicador
                     , iv.pontuacaonova
                     , iv.qtdevendida
                   --  , iv.tipodestino
                  FROM itensviradadecatalogo iv
                 WHERE iv.idviradadecatalogo = :P549_IDVIRADADECATALOGO
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        performance {
            lazyLoading: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        messages {
            whenNoDataFound: Nenhum item localizado!
        }
