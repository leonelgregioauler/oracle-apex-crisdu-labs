    process gravaritens-mp (
        name: GravarItens_MP
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                 vnome                 varchar2(200);
                 vdatainicial          date;
                 vdatafinal            date;
                 videdicaorevori       number;
                 videdicaorevdest      number;
                 vidpais               number;
                 vlinkcatalogo         varchar2(100);
                 vidusuarioinclusao    number;
                 vdatainclusao         date;
                 vidusuarioMP          number;
                 vdataMP               date;
                 vidusuarioajustaitens number;
                 vdataajustaitens      date;
                 vidusuarioajustaMP    number;
                 vdataajustaMP         date;
                 vetapa                number;
                 vmd5                  varchar2(4000);
                 
                 
                BEGIN
                
                  vidusuarioajustamp := :P0_IDUSUARIO;
                  vdataajustamp      := SYSDATE;
                  vetapa       := 2;
                
                  for r1 in (
                               select nome
                                    , datavalidadeini
                                    , datavalidadefim
                                    , idedicaorevistaorigem
                                    , idedicaorevistadestino
                                    , idpais
                                    , linkcatalogo
                                 from viradasdecatalogo
                                where idviradadecatalogo = :P549_IDVIRADADECATALOGO
                  ) loop
                  
                    vnome                 := r1.nome;
                    vdatainicial          := r1.datavalidadeini;
                    vdatafinal            := r1.datavalidadefim;
                    videdicaorevori       := r1.idedicaorevistaorigem;
                    videdicaorevdest      := r1.idedicaorevistadestino;
                    vidpais               := r1.idpais;
                    vlinkcatalogo         := r1.linkcatalogo;
                
                    pck_cadastros_fav.prc_viradadecatalogo(pidviradadecatalogo   => :P549_IDVIRADADECATALOGO,
                                                           pnome                 => vnome,
                                                           pdatainicial          => vdatainicial,
                                                           pdatafinal            => vdatafinal,
                                                           pidedicaorevori       => videdicaorevori,
                                                           pidedicaorevdest      => videdicaorevdest,
                                                           pidpais               => vidpais,
                                                           plinkcatalogo         => vlinkcatalogo,
                                                           pidusuarioinclusao    => vidusuarioinclusao,
                                                           pdatainclusao         => vdatainclusao,
                                                           pidusuariomp          => vidusuarioMP,
                                                           pdatamp               => vdataMP,
                                                           pidusuarioajustaitens => vidusuarioajustaitens,
                                                           pdataajustaitens      => vdataajustaitens,
                                                           pidusuarioajustamp    => vidusuarioajustamp,
                                                           pdataajustamp         => vdataajustamp,
                                                           petapa                => vetapa,
                                                           pmd5                  => vmd5,
                                                           poperacao_dml         => 'U');
                  
                
                  end loop;
                  
                  -- seta tag para "Lucre Mais" para os itens que foram definidos como Morte Programada.
                  begin
                    update itensviradadecatalogo
                       set perccomissaoven = 0
                         , perccomissaodis = 15
                         , perccomissaoger = 2
                         , idtagproduto = 63
                     where idviradadecatalogo = :P549_IDVIRADADECATALOGO
                       and morteprogramada    =  'S';
                  exception
                    when others then null;
                  end;
                     
                  commit;
                
                  apex_application.g_print_success_message := '<span style=”color : yellow “>Parabéns!! Itens atualizados com sucesso! </span>';
                  
                  exception
                   when others then
                      apex_error.add_error (
                        p_message          => 'Ocorreu erro durante a inclusão dos itens. Código do erro: '||SQLERRM,
                        p_display_location => apex_error.c_inline_in_notification );
                        
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 32459605396818315
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMA
        }
    )

