    region produtos-não-movimentados (
        name: Produtos não Movimentados
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                /*DECLARE
                  p_where VARCHAR2(4000);
                  p_where2 VARCHAR2(4000);
                  p_retorno varchar2(4000);
                BEGIN
                
                  IF :P610_DATASEMMOVINI IS NOT NULL THEN
                    p_where := ' AND ef.idestoque NOT IN (SELECT DISTINCT m.idestoque '
                               || 'FROM favorita.movimentosestoques m '
                               || 'WHERE m.datamovimento BETWEEN '|| '''' || v('P610_DATASEMMOVINI')||'''' 
                               || ' AND ' || '''' || v('P610_DATASEMMOVFIM')||'''';
                  END IF;
                
                  IF :P610_IDFILIAL IS NOT NULL THEN
                    p_where := p_where || ' AND m.idfilialfavorita = ' || v('P610_IDFILIAL') ;
                    p_where2 := ' AND ef.idfilialfavorita = ' || v('P610_IDFILIAL') ;
                  END IF;
                
                  IF :P610_IDPRODUTO IS NOT NULL THEN
                    p_where := p_where || ' AND m.idproduto = ' || v('P610_IDPRODUTO') ;
                    p_where2 := p_where2 || ' AND ef.idproduto = ' || v('P610_IDPRODUTO') ;
                  END IF;
                
                  IF :P610_IDPRODUTODETALHADO IS NOT NULL THEN
                    p_where := p_where || ' AND m.idprodutodetalhado = ' || v('P610_IDPRODUTODETALHADO')  ;
                    p_where2 := p_where2 || ' AND ef.idprodutodetalhado = ' || v('P610_IDPRODUTODETALHADO') ;
                  END IF;
                  
                  IF :P610_IDCATEGORIA IS NOT NULL THEN
                    p_where := p_where || ' AND EXISTS (SELECT 1 '
                               || 'FROM favorita.produtos p '
                               || 'WHERE p.idproduto = m.idproduto '
                               || 'AND p.idcategoria = ' || v('P610_IDCATEGORIA') || ')';
                               
                    p_where2 := p_where2 || ' AND EXISTS (SELECT 1 '
                               || 'FROM favorita.produtos p '
                               || 'WHERE p.idproduto = ef.idproduto '
                               || 'AND p.idcategoria = ' || v('P610_IDCATEGORIA') || ')';
                  END IF;
                
                  IF :P610_IDFORNECEDOR IS NOT NULL THEN
                    p_where := p_where || ' AND m.idproduto IN '
                               || '(SELECT idproduto '
                               || 'FROM fornecedoresprodutos '
                               || 'WHERE idproduto = m.idproduto '
                               || 'AND idfornecedor = ' || v('P610_IDFORNECEDOR')||')';
                               
                    p_where2 := p_where2 || ' AND ef.idproduto IN '
                               || '(SELECT idproduto '
                               || 'FROM fornecedoresprodutos '
                               || 'WHERE idproduto = ef.idproduto '
                               || 'AND idfornecedor = ' || v('P610_IDFORNECEDOR')||')';
                  END IF;
                
                  IF :P610_IDEDICAOREVISTA IS NOT NULL THEN
                    p_where := p_where || ' AND m.idprodutodetalhado IN '
                               || '(SELECT idprodutodetalhado '
                               || 'FROM produtosdetedrevistas '
                               || 'WHERE idedicaorevista = ' || v('P610_IDEDICAOREVISTA') || ')';
                  END IF;
                  
                  IF :P610_IDUSUARIO IS NOT NULL THEN
                    p_where := p_where || ' AND m.idusuario = ' || v('P610_IDUSUARIO')  ;
                  END IF;
                
                  IF :P610_IDFILIAL IS NOT NULL OR 
                     :P610_IDPRODUTO IS NOT NULL OR
                     :P610_IDPRODUTODETALHADO IS NOT NULL OR
                     :P610_IDCATEGORIA IS NOT NULL OR
                     :P610_IDFORNECEDOR IS NOT NULL OR 
                     :P610_IDEDICAOREVISTA IS NOT NULL OR
                     :P610_IDUSUARIO IS NOT NULL THEN
                    p_where := p_where || ' )' ;
                  END IF;
                  
                  p_retorno := 'SELECT ef.idprodutodetalhado id
                           , pck_util_fav.fnc_nomeproduto(ef.idproduto,ef.ididioma,''S'') nomeprod
                           , pck_util_fav.fnc_nomeprodutodetalhado(ef.idprodutodetalhado,ef.ididioma) nomeproddet
                           , pck_util_fav.fnc_nomefilialfavorita(ef.idfilialfavorita) filial 
                           , ef.valorcusto
                           , ef.quantidade * NVL(ef.valorcusto, 1) totalcusto
                           , ef.quantidade
                           , ef.quantidade - ef.quantidadereservada quantidadedisponivel
                           , ef.quantidadereservada
                           , NVL(ef.quantidadecomprada, 0) quantidadecomprada
                           , NVL( (SELECT dep.skuvirtualage
                                     FROM favorita.deparaprodfavoritavirtualage dep
                                    WHERE dep.idprodutodetalhado = ef.idprodutodetalhado), 6000000 + ef.idprodutodetalhado) sku_virtual
                           , ef.ativo
                           , m.tipomovimentacao
                           , m.datamovimento
                           , m.quantidade qtd_mov
                           , m.nomeusuario
                        FROM vw_estoques_fav ef
                           , (SELECT mt.*
                                FROM favorita.vw_movimentosestoques_fav mt
                               WHERE mt.idmovimentoestoque = (SELECT MAX(idmovimentoestoque)
                                                                FROM movimentosestoques m
                                                               WHERE m.idestoque = mt.idestoque
                                                                 AND m.idfilialfavorita = :P610_IDFILIAL)
                                 AND mt.idfilialfavorita = :P610_IDFILIAL
                                 AND mt.ididioma = 1) m
                       WHERE ef.idprodutodetalhado = m.idprodutodetalhado(+) 
                         and :P610_FILTRAR = ''S''
                         and ef.ididioma = 1 '
                     || p_where || p_where2;
                       
                  RETURN p_retorno ;
                
                END;*/
                
                DECLARE
                  p_where VARCHAR2(4000);
                  p_where2 VARCHAR2(4000);
                  p_retorno varchar2(4000);
                BEGIN
                
                  -- Construindo as cláusulas WHERE
                  p_where := '';
                  p_where2 := '';
                
                  IF :P610_DATASEMMOVINI IS NOT NULL THEN
                    p_where := ' AND NOT EXISTS (SELECT 1 '
                               || 'FROM favorita.movimentosestoques m '
                               || 'WHERE m.idestoque = ef.idestoque '
                               || 'AND m.datamovimento BETWEEN :P610_DATASEMMOVINI AND :P610_DATASEMMOVFIM)';
                  END IF;
                
                  IF :P610_IDFILIAL IS NOT NULL THEN
                    p_where := p_where || ' AND m.idfilialfavorita = :P610_IDFILIAL';
                    p_where2 := ' AND ef.idfilialfavorita = :P610_IDFILIAL';
                  END IF;
                
                  IF :P610_IDPRODUTO IS NOT NULL THEN
                    p_where := p_where || ' AND m.idproduto = :P610_IDPRODUTO';
                    p_where2 := p_where2 || ' AND ef.idproduto = :P610_IDPRODUTO';
                  END IF;
                
                  IF :P610_IDPRODUTODETALHADO IS NOT NULL THEN
                    p_where := p_where || ' AND m.idprodutodetalhado = :P610_IDPRODUTODETALHADO';
                    p_where2 := p_where2 || ' AND ef.idprodutodetalhado = :P610_IDPRODUTODETALHADO';
                  END IF;
                
                  IF :P610_IDCATEGORIA IS NOT NULL THEN
                    p_where := p_where || ' AND EXISTS (SELECT 1 '
                               || 'FROM favorita.produtos p '
                               || 'WHERE p.idproduto = m.idproduto '
                               || 'AND p.idcategoria = :P610_IDCATEGORIA)';
                               
                    p_where2 := p_where2 || ' AND EXISTS (SELECT 1 '
                               || 'FROM favorita.produtos p '
                               || 'WHERE p.idproduto = ef.idproduto '
                               || 'AND p.idcategoria = :P610_IDCATEGORIA)';
                  END IF;
                
                  IF :P610_IDFORNECEDOR IS NOT NULL THEN
                    p_where := p_where || ' AND m.idproduto IN '
                               || '(SELECT idproduto '
                               || 'FROM fornecedoresprodutos '
                               || 'WHERE idproduto = m.idproduto '
                               || 'AND idfornecedor = :P610_IDFORNECEDOR)';
                               
                    p_where2 := p_where2 || ' AND ef.idproduto IN '
                               || '(SELECT idproduto '
                               || 'FROM fornecedoresprodutos '
                               || 'WHERE idproduto = ef.idproduto '
                               || 'AND idfornecedor = :P610_IDFORNECEDOR)';
                  END IF;
                
                  IF :P610_IDEDICAOREVISTA IS NOT NULL THEN
                    p_where := p_where || ' AND m.idprodutodetalhado IN '
                               || '(SELECT idprodutodetalhado '
                               || 'FROM produtosdetedrevistas '
                               || 'WHERE idedicaorevista = :P610_IDEDICAOREVISTA)';
                  END IF;
                  
                  IF :P610_IDUSUARIO IS NOT NULL THEN
                    p_where := p_where || ' AND m.idusuario = :P610_IDUSUARIO';
                  END IF;
                
                  -- Montando a consulta
                  p_retorno := 'SELECT ef.idprodutodetalhado id
                           , pck_util_fav.fnc_nomeproduto(ef.idproduto,ef.ididioma,''S'') nomeprod
                           , pck_util_fav.fnc_nomeprodutodetalhado(ef.idprodutodetalhado,ef.ididioma) nomeproddet
                           , pck_util_fav.fnc_nomefilialfavorita(ef.idfilialfavorita) filial 
                           , ef.valorcusto
                           , ef.quantidade * NVL(ef.valorcusto, 1) totalcusto
                           , ef.quantidade
                           , ef.quantidade - ef.quantidadereservada quantidadedisponivel
                           , ef.quantidadereservada
                           , NVL(ef.quantidadecomprada, 0) quantidadecomprada
                           , NVL( (SELECT dep.skuvirtualage
                                     FROM favorita.deparaprodfavoritavirtualage dep
                                    WHERE dep.idprodutodetalhado = ef.idprodutodetalhado), 6000000 + ef.idprodutodetalhado) sku_virtual
                           , ef.ativo
                           , m.tipomovimentacao
                           , m.datamovimento
                           , m.quantidade qtd_mov
                           , m.nomeusuario
                        FROM vw_estoques_fav ef
                           LEFT JOIN (
                               SELECT mt.*
                                FROM favorita.vw_movimentosestoques_fav mt
                               WHERE mt.idmovimentoestoque = (
                                            SELECT MAX(idmovimentoestoque)
                                            FROM movimentosestoques m
                                            WHERE m.idestoque = mt.idestoque
                                              AND m.idfilialfavorita = :P610_IDFILIAL)
                                 AND mt.idfilialfavorita = :P610_IDFILIAL
                                 AND mt.ididioma = 1) m ON ef.idprodutodetalhado = m.idprodutodetalhado
                       WHERE :P610_FILTRAR = ''S''
                         and ef.ididioma = 1 '
                     || p_where || p_where2;
                       
                  RETURN p_retorno ;
                
                END;
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
