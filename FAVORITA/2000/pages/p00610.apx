        }
    )

    pageItem P610_IDPRODUTODETALHADO (
        type: plugin/select
        label {
            label: Produto Detalhado
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomeprodutodetalhado(pd.idprodutodetalhado, :P0_IDIDIOMA) as d
                     , pd.idprodutodetalhado as r
                from favorita.produtosdetalhados pd
                order by 1
                ```
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P610_IDUSUARIO (
        type: plugin/select
        label {
            label: Usuário
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomeusuario(u.idusuario) display_value
                     , u.idusuario return_value
                from catal.usuarios u
                where exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.usuario = u.usuario 
                                 and ug.idgrupoatendimento in ( select uu.idgrupoatendimento
                                                                from roman.usuariosgruposatendimento uu
                                                                where uu.usuario = v('APP_USER') ) ) 
                 or favorita.pck_util_fav.fnc_verificaacesso(58305,:P0_IDUSUARIO) = 'S'                                                
                order by 1
                ```
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 10
            region: @filtros
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 610
                items: {
                    P610_FILTRAR: S
                }
                action: resetPagination
            }
        }
    )

)

