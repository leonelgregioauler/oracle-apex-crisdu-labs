page 670 (
    name: Relatório Brindes Por Guia
    title: Relatório Brindes Por Guia
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region brindes-por-cupom (
        name: Brindes  Por Cupom
        title: Brindes Por Guia de Envio
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select (select bd.nomebrinde
                        from roman.brindesclub bd 
                        where bd.idbrindeclube = it.idbrindeclube ) brinde
                     , ( select clc.nomeclassif
                         from roman.conquistoulevouclassificacoes clc
                         where clc.idclassificacao = it.idclassificacao) classificação 
                     , ( select cc.nomecaracteristica
                         from roman.conquistoulevoucaracteristicas cc
                         where cc.idcaracteristica = it.idcaracteristica) caracteristica
                     , count(it.idbrindeclube) qtd
                     , it.idbrindeclube
                     , favorita.pck_util_fav.fnc_nomefilialfavorita(gb.idfilial) loja 
                     , ( select cp.nomecampanha
                         from roman.campanhasconquistoulevou cp 
                         where cp.idconquistoulevou = gb.idconquistoulevou) campanha
                     , gb.idguiaentregabrinde
                     , gb.nronotafiscal nota
                     , gb.dataenvio
                from roman.guiasentregasbrindes gb
                   , roman.guiasentregascupons gc
                   , roman.itensconqlevcupons it
                where gb.idguiaentregabrinde = :P670_IDGUIAENVIO
                  and gb.idguiaentregabrinde = gc.idguiaentregabrinde 
                  and it.idconquistoulevoucupom = gc.idconquistoulevoucupom 
                  group by it.idbrindeclube,it.idclassificacao,it.idcaracteristica,gb.idfilial,gb.idconquistoulevou, gb.idguiaentregabrinde , gb.nronotafiscal, gb.dataenvio
                order by 1,2,3
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1804407751892602418
        }

