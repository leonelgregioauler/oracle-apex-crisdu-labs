page 83 (
    name: Cadastro de Situações Comp/Transf e Rem
    title: Cadastro de Situações Comp/Transf e Rem
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region situações-comp-transf-remessas (
        name: Situações Comp/Transf/Remessas
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P83_DESCRICAO (
        type: textField
        label {
            label: Descrição
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @situações-comp-transf-remessas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P83_ESTOQUEPREVISTO (
        type: radioGroup
        label {
            label: Estoque Previsto
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @situações-comp-transf-remessas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P83_ESTOQUERESERVADO (
        type: radioGroup
        label {
            label: Estoque Reservado
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @situações-comp-transf-remessas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P83_IDSITUACAOCOMP (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @situações-comp-transf-remessas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P83_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @situações-comp-transf-remessas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P83_OPERACAO_DML (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @situações-comp-transf-remessas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 40
            region: @situações-comp-transf-remessas
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P83_IDSITUACAOCOMP
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 20
            region: @situações-comp-transf-remessas
            slot: help
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P83_IDSITUACAOCOMP
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 50
            region: @situações-comp-transf-remessas
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-reply
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 79
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 30
            region: @situações-comp-transf-remessas
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P83_IDSITUACAOCOMP
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @situações-comp-transf-remessas
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process consulta-sit (
        name: Consulta Sit
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                #OWNER#.PCK_CADASTROSSITUACOES_FAV.PRC_SITUACOESCOMPTRANSREM( PIDSITUACAOCOMP => :P83_IDSITUACAOCOMP,
                                                                                PDESCRICAO => :P83_DESCRICAO,
                                                                                PESTOQUERESERVADO => :P83_ESTOQUERESERVADO,
                                                                                PESTOQUEPREVISTO => :P83_ESTOQUEPREVISTO,
                                                                                PMD5 => :P83_MD5,
                                                                                POPERACAO_DML => 'S' );
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 14803651909484541
        }
    )

    process limpa-campos (
        name: limpa campos
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 14803766973484542
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    process processo-dml-em-situações-comp-transf-rem (
        name: Processo DML em Situações Comp/Transf/Rem
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  voperacao_dml varchar2(1);
                  --
                begin
                  --
                  if v('REQUEST') = 'INSERIR' then
                    --
                    voperacao_dml := 'I';
                    --
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    --
                    voperacao_dml := 'U';
                    --
                  elsif v('REQUEST') = 'EXCLUIR' then
                    --
                    voperacao_dml := 'D';
                    --
                  end if;
                  --
                  #OWNER#.PCK_CADASTROSSITUACOES_FAV.PRC_SITUACOESCOMPTRANSREM( PIDSITUACAOCOMP => :P83_IDSITUACAOCOMP,
                                                                                PDESCRICAO => :P83_DESCRICAO,
                                                                                PESTOQUERESERVADO => :P83_ESTOQUERESERVADO,
                                                                                PESTOQUEPREVISTO => :P83_ESTOQUEPREVISTO,
                                                                                PMD5 => :P83_MD5,
                                                                                POPERACAO_DML => voperacao_dml );
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro Atualizado!
        }
        advanced {
            executionMappingIdentifier: 15005187793157787
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('INSERIR','ATUALIZAR','EXCLUIR');
                ```
        }
    )

    branch (
        name: go to page 83
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 83
                items: {
                    P83_IDSITUACAOCOMP: &P83_IDSITUACAOCOMP.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('ATUALIZAR','INSERIR')
                ```
        }
    )

    branch (
        name: go to page 83
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 83
                items: {
                    P83_IDSITUACAOCOMP:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @excluir
        }
    )

)

