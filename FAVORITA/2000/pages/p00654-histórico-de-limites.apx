page 654 (
    name: Histórico de Limites
    alias: HISTÓRICO-DE-LIMITES
    title: Histórico de Limites
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region histórico-de-limites (
        name: HIstórico de Limites
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select x.*
                     , case
                          when x.situacao = 'S' then 'Em Aberto'
                          when x.situacao = 'N' then 'Pago'
                        end situacaopedido
                from (
                select a.dataalavancagem
                     , p.nomepessoa
                     , v.idfilial
                     , roman.pck_romance.fnc_nomefilial(v.idfilial) nomefranquia
                     , p.idpais
                     , NVL(p.cpf, p.documentoestrangeiro) AS documento
                     , NVL(TRUNC(MONTHS_BETWEEN(SYSDATE, p.datanascimento) / 12), 0) idade
                     , roman.pck_romance.fnc_nomerepresentante(v.idrepresentante) AS nomerep
                     , a.limiteatual
                     , a.limitesolicitado
                     , a.limiteatribuido
                     , NVL(TO_CHAR(ROUND(a.percalavancagem)), '0') || '%' AS percalavancagem
                     , a.usuarioalavancagem
                     , CASE
                           WHEN a.solicitadopor = 'F' THEN 'Favorita'
                           WHEN a.solicitadopor = 'C' THEN 'Call Center'
                           WHEN a.solicitadopor = 'L' THEN 'Loja'
                        END AS solicitadopor
                     , CASE
                           WHEN a.tipo = 'F' THEN 'Favorita'
                           WHEN a.tipo = 'C' THEN 'Romance Casa'
                       END AS tipo
                     , CASE
                           WHEN a.identificacao = '1' THEN 'Atualizado'
                           WHEN a.identificacao = '2' THEN 'Atribuído'
                           WHEN a.identificacao = '3' THEN 'Parcial'
                           WHEN a.identificacao = '4' THEN 'Negado'
                           WHEN a.identificacao = '5' THEN 'Acerto'
                           WHEN a.identificacao = '6' THEN 'Pagamento Pedido'
                       END AS identificacao
                     , a.identificacao ididentificacao
                     , nvl(hp.categorizacao,'Sem Categorização') categorizacao
                     , TO_CHAR(hp.adlfavorita) AS adlfavorita
                     , TO_CHAR(hp.mediadiaspagamento) AS mediadiaspagamento
                     , TO_CHAR(hp.scorefavorita) AS scorefavorita
                     , TO_CHAR(hp.scoremercado) AS scoremercado
                     , '<a href="javascript:window.open(''' || APEX_UTIL.PREPARE_URL('f?p=2000:655:' || v('APP_SESSION') || '::NO::P655_IDCONSULTASPC:' || ( select max(cp.idconsultaspc)
                                                                                                                                                             from roman.consultaspc cp
                                                                                                                                                             where cp.dataconsulta = hp.dataconsulta
                                                                                                                                                               and cp.cpf = p.cpf ), 'SESSION') || ''',''_blank''); void(0)">' || TO_CHAR(hp.qtdrestritivo) || '</a>' AS qtdrestritivo
                     , TO_CHAR(hp.valorrestritivo) AS valorrestritivo
                     , TO_CHAR(hp.ticketfavmediaped) AS ticketfavmediape
                     , TO_CHAR(hp.ticketrmcacertos) AS ticketrmcacertos
                     , ( select w.idpedido
                         from favorita.vw_pedidos_fav_new w
                         where w.idvendedora = v.idvendedora
                           and w.datacancelamento is null
                           and w.idsituacaoentrega >= 20000 ---15086912
                           and not exists ( select 1
                                            from favorita.classificacoespedidos cp
                                            where cp.idpedido = w.idpedido
                                              and cp.idcaracteristicapedido = 5 )
                           and trunc(w.dataemissao) >= trunc(a.dataalavancagem) --15086912
                           and ( :P654_PEDIDONUMERO = 'N'
                             or exists ( select 1
                                         from favorita.classificacoespedidos cp
                                         where cp.idpedido = w.idpedido
                                           and cp.idcaracteristicapedido = 11
                                           and ( ( :P654_PEDIDONUMERO = 1 and cp.idvalorcaracteristica = 1 )
                                              or ( :P654_PEDIDONUMERO = 2 and cp.idvalorcaracteristica = 2 )
                                              or ( :P654_PEDIDONUMERO = 3 and cp.idvalorcaracteristica >= 3 ) ) ) )
                         order by w.dataemissao, w.idpedido
                         fetch first 1 row only ) pedido
                     , ( select w.valortotal
                         from favorita.vw_pedidos_fav_new w
                         where w.idvendedora = v.idvendedora
                           and w.datacancelamento is null
                           and w.idsituacaoentrega not in (-1, 50)
                           and not exists ( select 1
                                            from favorita.classificacoespedidos cp
                                            where cp.idpedido = w.idpedido
                                              and cp.idcaracteristicapedido = 5 )
                           and trunc(w.dataemissao) >= trunc(a.dataalavancagem) --15086912
                           and ( :P654_PEDIDONUMERO = 'N'
                             or exists ( select 1
                                         from favorita.classificacoespedidos cp
                                         where cp.idpedido = w.idpedido
                                           and cp.idcaracteristicapedido = 11
                                           and ( ( :P654_PEDIDONUMERO = 1 and cp.idvalorcaracteristica = 1 )
                                              or ( :P654_PEDIDONUMERO = 2 and cp.idvalorcaracteristica = 2 )
                                              or ( :P654_PEDIDONUMERO = 3 and cp.idvalorcaracteristica >= 3 ) ) ) )
                         order by w.dataemissao, w.idpedido
                         fetch first 1 row only ) valortotal
                     , ( select w.valorapagar
                         from favorita.vw_pedidos_fav_new w
                         where w.idvendedora = v.idvendedora
                           and w.datacancelamento is null
                           and w.idsituacaoentrega not in (-1, 50)
                           and not exists ( select 1
                                            from favorita.classificacoespedidos cp
                                            where cp.idpedido = w.idpedido
                                              and cp.idcaracteristicapedido = 5 )
                           and trunc(w.dataemissao) >= trunc(a.dataalavancagem) --15086912
                           and ( :P654_PEDIDONUMERO = 'N'
                             or exists ( select 1
                                         from favorita.classificacoespedidos cp
                                         where cp.idpedido = w.idpedido
                                           and cp.idcaracteristicapedido = 11
                                           and ( ( :P654_PEDIDONUMERO = 1 and cp.idvalorcaracteristica = 1 )
                                              or ( :P654_PEDIDONUMERO = 2 and cp.idvalorcaracteristica = 2 )
                                              or ( :P654_PEDIDONUMERO = 3 and cp.idvalorcaracteristica >= 3 ) ) ) )
                         order by w.dataemissao, w.idpedido
                         fetch first 1 row only ) valorapagar
                     , ( select w.nomeusuario
                         from favorita.vw_pedidos_fav_new w
                         where w.idvendedora = v.idvendedora
                           and w.datacancelamento is null
                           and w.idsituacaoentrega not in (-1, 50)
                           and not exists ( select 1
                                            from favorita.classificacoespedidos cp
                                            where cp.idpedido = w.idpedido
                                              and cp.idcaracteristicapedido = 5 )
                           and trunc(w.dataemissao) >= trunc(a.dataalavancagem) --15086912
                           and ( :P654_PEDIDONUMERO = 'N'
                             or exists ( select 1
                                         from favorita.classificacoespedidos cp
                                         where cp.idpedido = w.idpedido
                                           and cp.idcaracteristicapedido = 11
                                           and ( ( :P654_PEDIDONUMERO = 1 and cp.idvalorcaracteristica = 1 )
                                              or ( :P654_PEDIDONUMERO = 2 and cp.idvalorcaracteristica = 2 )
                                              or ( :P654_PEDIDONUMERO = 3 and cp.idvalorcaracteristica >= 3 ) ) ) )
                         order by w.dataemissao, w.idpedido
                         fetch first 1 row only ) nomeusuario
                     , ( select w.devedor
                         from favorita.vw_pedidos_fav_new w
                         where w.idvendedora = v.idvendedora
                            and w.datacancelamento is null
                            and w.idsituacaoentrega not in (-1, 50)
                            and not exists ( select 1
                                             from favorita.classificacoespedidos cp
                                             where cp.idpedido = w.idpedido
                                               and cp.idcaracteristicapedido = 5 )
                            and trunc(w.dataemissao) >= trunc(a.dataalavancagem) --15086912
                            and ( :P654_PEDIDONUMERO = 'N'
                             or exists ( select 1
                                         from favorita.classificacoespedidos cp
                                         where cp.idpedido = w.idpedido
                                           and cp.idcaracteristicapedido = 11
                                           and ( ( :P654_PEDIDONUMERO = 1 and cp.idvalorcaracteristica = 1 )
                                              or ( :P654_PEDIDONUMERO = 2 and cp.idvalorcaracteristica = 2 )
                                              or ( :P654_PEDIDONUMERO = 3 and cp.idvalorcaracteristica >= 3 ) ) ) )
                         order by w.dataemissao, w.idpedido
                         fetch first 1 row only ) situacao  
                     , ( select LISTAGG(vc.datavencimento, ', ') WITHIN GROUP (ORDER BY vc.datavencimento)
                         from favorita.vencimentospedidos vc
                         where vc.idpedido = ( select w.idpedido
                                               from favorita.vw_pedidos_fav_new w
                                               where w.idvendedora = v.idvendedora
                                                 and w.datacancelamento is null
                                                 and w.idsituacaoentrega not in (-1, 50)
                                                 and not exists ( select 1
                                                                  from favorita.classificacoespedidos cp
                                                                  where cp.idpedido = w.idpedido
                                                                    and cp.idcaracteristicapedido = 5 )
                                                 and trunc(w.dataemissao) >= trunc(a.dataalavancagem) --15086912
                                                 and ( :P654_PEDIDONUMERO = 'N'
                                                   or exists ( select 1
                                                               from favorita.classificacoespedidos cp
                                                               where cp.idpedido = w.idpedido
                                                                 and cp.idcaracteristicapedido = 11
                                                                 and ( ( :P654_PEDIDONUMERO = 1 and cp.idvalorcaracteristica = 1 )
                                                                    or ( :P654_PEDIDONUMERO = 2 and cp.idvalorcaracteristica = 2 )
                                                                    or ( :P654_PEDIDONUMERO = 3 and cp.idvalorcaracteristica >= 3 ) ) ) )
                                               order by w.dataemissao, w.idpedido
                                               fetch first 1 row only )) vencimentos
                     , a.idscorehistalavancagem
                from roman.scorehistoricosalavancagem a
                   , roman.scorehistoricosperformance hp
                   , catal.vendedoras v
                   , catal.pessoas p
                where a.idscorehistperformance = hp.idscorehistperformance
                  and a.idvendedora = v.idvendedora
                  and p.idpessoa = v.idpessoa
                
                union all
                
                select a.dataalavancagem
                     , p.nomepessoa
                     , v.idfilial
                     , roman.pck_romance.fnc_nomefilial(v.idfilial) nomefranquia
                     , p.idpais
                     , NVL(p.cpf, p.documentoestrangeiro) AS documento
                     , NVL(TRUNC(MONTHS_BETWEEN(SYSDATE, p.datanascimento) / 12), 0) idade
                     , roman.pck_romance.fnc_nomerepresentante(v.idrepresentante) AS nomerep
                     , a.limiteatual
                     , a.limitesolicitado
                     , a.limiteatribuido
                     , NVL(TO_CHAR(ROUND(a.percalavancagem)), '0') || '%' AS percalavancagem
                     , a.usuarioalavancagem
                     , CASE
                           WHEN a.solicitadopor = 'F' THEN 'Favorita'
                           WHEN a.solicitadopor = 'C' THEN 'Call Center'
                           WHEN a.solicitadopor = 'L' THEN 'Loja'
                        END AS solicitadopor
                     , CASE
                           WHEN a.tipo = 'F' THEN 'Favorita'
                           WHEN a.tipo = 'C' THEN 'Romance Casa'
                       END AS tipo
                     , CASE
                           WHEN a.identificacao = '1' THEN 'Atualizado'
                           WHEN a.identificacao = '2' THEN 'Atribuído'
                           WHEN a.identificacao = '3' THEN 'Parcial'
                           WHEN a.identificacao = '4' THEN 'Negado'
                           WHEN a.identificacao = '5' THEN 'Acerto'
                           WHEN a.identificacao = '6' THEN 'Pagamento Pedido'
                       END AS identificacao
                     , a.identificacao ididentificacao
                     , 'Sem Categorização' AS categorizacao
                     , TO_CHAR(0) AS adlfavorita
                     , TO_CHAR(0) AS mediadiaspagamento
                     , TO_CHAR(0) AS scorefavorita
                     , TO_CHAR(0) AS scoremercado
                     , TO_CHAR(0) AS qtdrestritivo
                     , TO_CHAR(0) AS valorrestritivo
                     , TO_CHAR(0) AS ticketfavmediaped
                     , TO_CHAR(0) AS ticketrmcacertos
                     , ( select w.idpedido
                         from favorita.vw_pedidos_fav_new w
                         where w.idvendedora = v.idvendedora
                           and w.datacancelamento is null
                           and w.idsituacaoentrega not in (-1, 50)
                           and not exists ( select 1
                                            from favorita.classificacoespedidos cp
                                            where cp.idpedido = w.idpedido
                                              and cp.idcaracteristicapedido = 5 )
                           and trunc(w.dataemissao) >= trunc(a.dataalavancagem) --15086912
                           and ( :P654_PEDIDONUMERO = 'N'
                             or exists ( select 1
                                         from favorita.classificacoespedidos cp
                                         where cp.idpedido = w.idpedido
                                           and cp.idcaracteristicapedido = 11
                                           and ( ( :P654_PEDIDONUMERO = 1 and cp.idvalorcaracteristica = 1 )
                                              or ( :P654_PEDIDONUMERO = 2 and cp.idvalorcaracteristica = 2 )
                                              or ( :P654_PEDIDONUMERO = 3 and cp.idvalorcaracteristica >= 3 ) ) ) )
                         order by w.dataemissao, w.idpedido
                         fetch first 1 row only ) pedido
                     , ( select w.valortotal
                         from favorita.vw_pedidos_fav_new w
                         where w.idvendedora = v.idvendedora
                           and w.datacancelamento is null
                           and w.idsituacaoentrega not in (-1, 50)
                           and not exists ( select 1
                                            from favorita.classificacoespedidos cp
                                            where cp.idpedido = w.idpedido
                                              and cp.idcaracteristicapedido = 5 )
                           and trunc(w.dataemissao) >= trunc(a.dataalavancagem) --15086912
                           and ( :P654_PEDIDONUMERO = 'N'
                             or exists ( select 1
                                         from favorita.classificacoespedidos cp
                                         where cp.idpedido = w.idpedido
                                           and cp.idcaracteristicapedido = 11
                                           and ( ( :P654_PEDIDONUMERO = 1 and cp.idvalorcaracteristica = 1 )
                                              or ( :P654_PEDIDONUMERO = 2 and cp.idvalorcaracteristica = 2 )
                                              or ( :P654_PEDIDONUMERO = 3 and cp.idvalorcaracteristica >= 3 ) ) ) )
                         order by w.dataemissao, w.idpedido
                         fetch first 1 row only ) valortotal
                     , ( select w.valorapagar
                         from favorita.vw_pedidos_fav_new w
                         where w.idvendedora = v.idvendedora
                           and w.datacancelamento is null
                           and w.idsituacaoentrega not in (-1, 50)
                           and not exists ( select 1
                                            from favorita.classificacoespedidos cp
                                            where cp.idpedido = w.idpedido
                                              and cp.idcaracteristicapedido = 5 )
                           and trunc(w.dataemissao) >= trunc(a.dataalavancagem) --15086912
                           and ( :P654_PEDIDONUMERO = 'N'
                             or exists ( select 1
                                         from favorita.classificacoespedidos cp
                                         where cp.idpedido = w.idpedido
                                           and cp.idcaracteristicapedido = 11
                                           and ( ( :P654_PEDIDONUMERO = 1 and cp.idvalorcaracteristica = 1 )
                                              or ( :P654_PEDIDONUMERO = 2 and cp.idvalorcaracteristica = 2 )
                                              or ( :P654_PEDIDONUMERO = 3 and cp.idvalorcaracteristica >= 3 ) ) ) )
                         order by w.dataemissao, w.idpedido
                         fetch first 1 row only ) valorapagar
                     , ( select w.nomeusuario
                         from favorita.vw_pedidos_fav_new w
                         where w.idvendedora = v.idvendedora
                           and w.datacancelamento is null
                           and w.idsituacaoentrega not in (-1, 50)
                           and not exists ( select 1
                                            from favorita.classificacoespedidos cp
                                            where cp.idpedido = w.idpedido
                                              and cp.idcaracteristicapedido = 5 )
                           and trunc(w.dataemissao) >= trunc(a.dataalavancagem) --15086912
                           and ( :P654_PEDIDONUMERO = 'N'
                             or exists ( select 1
                                         from favorita.classificacoespedidos cp
                                         where cp.idpedido = w.idpedido
                                           and cp.idcaracteristicapedido = 11
                                           and ( ( :P654_PEDIDONUMERO = 1 and cp.idvalorcaracteristica = 1 )
                                              or ( :P654_PEDIDONUMERO = 2 and cp.idvalorcaracteristica = 2 )
                                              or ( :P654_PEDIDONUMERO = 3 and cp.idvalorcaracteristica >= 3 ) ) ) )
                         order by w.dataemissao, w.idpedido
                         fetch first 1 row only ) nomeusuario
                     , ( select w.devedor 
                         from favorita.vw_pedidos_fav_new w
                         where w.idvendedora = v.idvendedora
                           and w.datacancelamento is null
                           and w.idsituacaoentrega not in (-1, 50)
                           and not exists ( select 1
                                            from favorita.classificacoespedidos cp
                                            where cp.idpedido = w.idpedido
                                              and cp.idcaracteristicapedido = 5 )
                           and trunc(w.dataemissao) >= trunc(a.dataalavancagem) --15086912
                           and ( :P654_PEDIDONUMERO = 'N'
                             or exists ( select 1
                                         from favorita.classificacoespedidos cp
                                         where cp.idpedido = w.idpedido
                                           and cp.idcaracteristicapedido = 11
                                           and ( ( :P654_PEDIDONUMERO = 1 and cp.idvalorcaracteristica = 1 )
                                              or ( :P654_PEDIDONUMERO = 2 and cp.idvalorcaracteristica = 2 )
                                              or ( :P654_PEDIDONUMERO = 3 and cp.idvalorcaracteristica >= 3 ) ) ) )
                         order by w.dataemissao, w.idpedido
                         fetch first 1 row only ) situacao
                     , ( select LISTAGG(vc.datavencimento, ', ') WITHIN GROUP (ORDER BY vc.datavencimento)
                         from favorita.vencimentospedidos vc
                         where vc.idpedido = ( select w.idpedido
                                               from favorita.vw_pedidos_fav_new w
                                               where w.idvendedora = v.idvendedora
                                                 and w.datacancelamento is null
                                                 and w.idsituacaoentrega not in (-1, 50)
                                                 and not exists ( select 1
                                                                  from favorita.classificacoespedidos cp
                                                                  where cp.idpedido = w.idpedido
                                                                    and cp.idcaracteristicapedido = 5 )
                                                 and trunc(w.dataemissao) >= trunc(a.dataalavancagem) --15086912
                                                 and ( :P654_PEDIDONUMERO = 'N'
                                                   or exists ( select 1
                                                               from favorita.classificacoespedidos cp
                                                               where cp.idpedido = w.idpedido
                                                                 and cp.idcaracteristicapedido = 11
                                                                 and ( ( :P654_PEDIDONUMERO = 1 and cp.idvalorcaracteristica = 1 )
                                                                    or ( :P654_PEDIDONUMERO = 2 and cp.idvalorcaracteristica = 2 )
                                                                    or ( :P654_PEDIDONUMERO = 3 and cp.idvalorcaracteristica >= 3 ) ) ) )
                                               order by w.dataemissao, w.idpedido
                                               fetch first 1 row only )) vencimentos
                     , a.idscorehistalavancagem
                from roman.scorehistoricosalavancagem a
                   , catal.vendedoras v
                   , catal.pessoas p
                where a.idvendedora = v.idvendedora
                  and p.idpessoa = v.idpessoa
                  and not exists ( select 1
                                   from roman.scorehistoricosperformance hp
                                   where hp.idscorehistperformance = a.idscorehistperformance ) ) x
                where ( :P654_DE is null or trunc(x.dataalavancagem) between :P654_DE and :P654_ATE )
                  and ( :P654_PAIS = -1 or x.idpais = :P654_PAIS )
                  and ( :P654_FRANQUIA is null or x.idfilial = :P654_FRANQUIA ) 
                  and ( :P654_IDENTIFICACAO is null and x.ididentificacao not in (5,6) or x.ididentificacao = :P654_IDENTIFICACAO)
                  and ( :P654_VALORMAIOR is null or :P654_VALORMAIOR = 'S' and x.valortotal > x.limiteatribuido or :P654_VALORMAIOR = 'N' and x.valortotal < x.limiteatribuido )
                  and ( :P654_ATENDENTE is null or x.usuarioalavancagem = :P654_ATENDENTE )
                  and :P654_FILTRAR = 'S'
                order by 1 desc;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 375200837754518202
        }

        column ADLFAVORITA (
            type: plainText
            heading {
