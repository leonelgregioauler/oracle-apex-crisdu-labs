    branch (
        name: Go To Page 654
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 654
                items: {
                    P654_FILTRAR: S
                    P654_FRANQUIA: &P654_FRANQUIA.
                }
            }
        }
