    pageItem P654_ATE (
        type: datePicker
        label {
            label: Até:
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--xlarge
            ]
            formatMask: dd/mm/rrrr
            width: 30
        }
    )

    pageItem P654_ATENDENTE (
        type: selectList
        label {
            label: Atendente
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ug.usuario display_value
                     , ug.usuario return_value
                from roman.usuariosgruposatendimento ug
                where ug.idgrupoatendimento = 9 --Analise de credito favorita
                ```
        }
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--xlarge
            ]
            height: 1
        }
    )

    pageItem P654_DE (
        type: datePicker
        label {
            label: De:
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--xlarge
            ]
            formatMask: dd/mm/rrrr
            width: 30
        }
    )

    pageItem P654_FILTRAR (
        type: hidden
        layout {
            sequence: 10
            region: @histórico-de-limites
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
    )

    pageItem P654_FRANQUIA (
        type: selectList
        label {
            label: Franquia:
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select fl.nome
                     , fl.idfilial
                from roman.vw_filiais fl
                where (:P654_PAIS = -1 or fl.ididioma = :P654_PAIS)
                  and fl.tipofilial = 'D'
                  and fl.ativo = 'S'
                ```
            nullDisplayValue: - Todas -
        }
        cascadingLov {
            parentItems: P654_PAIS
            itemsToSubmit: P654_FRANQUIA
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--xlarge
            ]
            height: 1
        }
        source {
            used: always
        }
    )

    pageItem P654_IDENTIFICACAO (
        type: radioGroup
        label {
            label: Identificação:
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Atualizado;1,Atribuído;2,Parcial;3,Negado;4
            nullDisplayValue: Todos
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--xlarge
            ]
        }
    )

    pageItem P654_PAIS (
        type: selectList
        label {
            label: País:
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nome
                     , p.idpais
                from catal.paises p
                where exists ( select 1
                               from roman.vw_filiais f
                               where f.ididioma = p.idpais
                                 and f.ativo = 'S' )
                union 
                select '- Todas - '
                     , -1
                from catal.paises p
                where exists ( select 1
                               from roman.vw_filiais f
                               where f.ididioma = p.idpais
                                 and f.ativo = 'S' )
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--xlarge
            ]
            height: 1
        }
    )

    pageItem P654_PEDIDONUMERO (
        type: radioGroup
