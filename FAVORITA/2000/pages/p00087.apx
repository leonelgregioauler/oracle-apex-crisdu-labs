    region pedidos-da-remessa (
        name: Pedidos da Remessa
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.numeropedido
                     , p.vendedora
                     , p.representante
                     , p.valortotal
                     , p.valorapagar
                     , p.situacaoentregainterno
                     , p.situacaofinanceirointerno
                     , p.dataentrega
                     , ( select volume
                         from pedidosremessasct pr
                         where pr.idpedido = p.idpedido 
                           and pr.idcompratransferencia = :P87_IDCOMPRATRANSFERENCIA ) volume
                from vw_pedidos_fav p
                where exists ( select 1
                               from pedidosremessasct pr
                               where pr.idpedido = p.idpedido 
                                 and pr.idcompratransferencia = :P87_IDCOMPRATRANSFERENCIA )
                  and ididioma = :P0_IDIDIOMA
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P87_IDCOMPRATRANSFERENCIA is not null
                  and exists ( select 1 
                               from pedidosremessasct p
                               where p.idcompratransferencia = :P87_IDCOMPRATRANSFERENCIA )
                  and exists ( select 1
                               from comprastransferencias c
                               where c.idcompratransferencia = :P87_IDCOMPRATRANSFERENCIA
                                 and c.idtipocomptransrem = 3 )
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 2833528550807746215
        }

