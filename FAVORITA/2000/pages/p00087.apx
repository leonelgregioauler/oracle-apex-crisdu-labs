    process atualiza-itens-na-compra-transferencia (
        name: Atualiza Itens na Compra / Transferencia
        type: executeCode
        editableRegion: @confirmar-produtos
        source {
            plsqlCode:
                ```plsql
                declare
                  vnumber                           number;
                  viditemcompratransferencia        number           := :IDITEMCOMPRATRANSFERENCIA;
                  vidcompratransferencia            number           := :IDCOMPRATRANSFERENCIA;
                  vidprodutodetalhado               number           := :IDPRODUTODETALHADO;
                  vquantidadecomprada               number           := :QUANTIDADECOMPRADA;
                  vquantidaderecebida               number           := :QUANTIDADERECEBIDA;
                  vquantidadeavariada               number           := :QUANTIDADEAVARIADA;
                  vquantidaderecebidaadicional      number           := :QUANTIDADERECEBIDAADICIONAL;
                  vobservacao                       varchar2(2000)   := :OBSERVACAO;
                  vobservcaoavaria                  varchar2(2000)   := :OBSERVACAOAVARIA;
                  voperacao_dml                     varchar2(1)      := 'U';
                  vmd5                              varchar2(50);
                begin
                  --
                  -- botão ATUALIZAITEM foi desativado - Leonel Gregio Auler - Automatização do Recebimento
                  --
                  if vquantidadecomprada >= nvl(vquantidaderecebida,0) then
                    pck_comprastransf_fav.prc_itenscomprastransferencias (  piditemcompratransferencia   => viditemcompratransferencia,
                                                                            pidcompratransferencia       => vidcompratransferencia,
                                                                            pidprodutodetalhado          => vidprodutodetalhado,
                                                                            pquantidadecomprada          => vquantidadecomprada,
                                                                            pquantidaderecebida          => vquantidaderecebida,
                                                                            pquantidadeavariada          => vquantidadeavariada,
                                                                            pquantidaderecebidaadicional => vquantidaderecebidaadicional,
                                                                            pobservacao                  => vobservacao,
                                                                            pobservacaoavaria            => vobservcaoavaria,
                                                                            pmd5                         => vmd5,
                                                                            poperacao_dml                => voperacao_dml,
                                                                            pidestoquefilorigem          => vnumber,
                                                                            pidestoquefildestino         => vnumber,
                                                                            pvalorcusto                  => vnumber,
                                                                            pprocautoloja                => vnumber );
                  else
                    :QUANTIDADERECEBIDA := null;
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 1410257270999770591
        }
        serverSideCondition {
            executionScope: allSubmittedRows
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'ATUALIZAITEM'
        }
    )

