                  --
                  Select distinct 1
                  into teste
                  from itenscomprastransferencias i
                  where i.idcompratransferencia = :P87_IDCOMPRATRANSFERENCIA
                    and i.quantidaderecebida - round(i.quantidaderecebida) != 0;
                  --
                  return  'Só e possível receber números inteiros, favor corrija qualquer valor com ponto ou virgula.';
                  --
                  exception
                    when no_data_found then
                      null;
                end;
