    process confirmar-recebimento-compra-transferencia (
        name: Confirmar Recebimento Compra/Transferencia
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                    v_SituacaoDivergencia varchar2(10);
                    v_TipoCompraTransfRemessa number;
                    v_idguiaconqlevou number;
                begin
                
                    -- Pega o tipo da compraTransfRemessa
                    select c.idtipocomptransrem
                      into v_TipoCompraTransfRemessa
                      from favorita.comprastransferencias c
                     where c.idcompratransferencia = :P87_IDCOMPRATRANSFERENCIA;
                
                    -- Verifica se é Transferência, se for 1(transferencia) dai faz a validação para verificar se existe divergencia.
                    if v_TipoCompraTransfRemessa in (1,12) then
                        /* Verifica se existe divergência entre quantidade comprada e recebida, se existe e ainda não foi gravada as divergências, então 
                        registra na tabela favorita.divergenciascomprastransferencias*/
                        begin
                            for vReg in ( select *
                                            from favorita.itenscomprastransferencias i
                                           where i.idcompratransferencia = :P87_IDCOMPRATRANSFERENCIA
                                             and i.quantidadecomprada > i.quantidaderecebida
                                             and not exists ( select 1
                                                                from favorita.divergenciascomprastransferencias d
                                                               where d.iditemcompratransferencia = i.iditemcompratransferencia))
                            loop
                                insert into favorita.divergenciascomprastransferencias (idcompratransferencia,iditemcompratransferencia, situacaodivergencia) 
                                                                                values (vReg.idcompratransferencia,vReg.iditemcompratransferencia, 'E');
                                commit;
                            end loop;
                        exception
                            when others then
                                apex_error.add_error( p_message => 'Ocorreu um erro ao tentar gravar as divergências entre quantidade comprada e recebida' || SQLERRM
                           				    , p_display_location => apex_error.c_inline_in_notification); 
                            return;
                        end;
                
                        /* Verifica se existe Divergência em análise pelo estoque*/
                        begin
                            select 'Em Análise'
                              into v_SituacaoDivergencia
                              from favorita.itenscomprastransferencias i
                             where i.quantidadecomprada > i.quantidaderecebida
                               and i.idcompratransferencia = :P87_IDCOMPRATRANSFERENCIA
                               -- Indica que a divergência está em análise pelo time do estoque
                               and exists (select 1
                                             from favorita.divergenciascomprastransferencias d
                                            where d.iditemcompratransferencia = i.iditemcompratransferencia
                                              and d.situacaodivergencia = 'E')
                               and rownum = 1;
                
                            /* Avisa que existe produto com quantidade comprada comdivergência da quantidade recebida*/
                            apex_error.add_error( p_message => 'Existe produto(s) com divergência entre a quantidade recebida e a comprada! com situação Em Análise Estoque'
                       				    , p_display_location => apex_error.c_inline_in_notification);
                            return;
                        exception
                            when others then
                                null;
                        end;
                
                        /* Verifica se existe Divergência em Recusada pelo Estoque*/
                        begin
                            select 'Recusada'
                              into v_SituacaoDivergencia
                              from favorita.itenscomprastransferencias i
                             where i.quantidadecomprada > i.quantidaderecebida
                               and i.idcompratransferencia = :P87_IDCOMPRATRANSFERENCIA
                               -- Indica que existe divergência foi recusada pelo estoque
                               and exists (select 1
                                             from favorita.divergenciascomprastransferencias d
                                            where d.iditemcompratransferencia = i.iditemcompratransferencia
                                              and d.situacaodivergencia = 'R')
                               and rownum = 1;
                
                            /* Avisa que existe produto com quantidade comprada comdivergência da quantidade recebida*/
                            apex_error.add_error( p_message => 'Existe produto(s) com divergência entre a quantidade recebida e a comprada! com situação Recusado pelo Estoque, Loja deve Verificar a quantidade.'
                       				    , p_display_location => apex_error.c_inline_in_notification);
                            return;
                        exception
                            when others then
                                null;
                        end;
                        
                    end if;
                
                    /* efetiva o recebimento da compra transferência*/
                    favorita.pck_comprastransf_fav.prc_confirmarecebimento( pidcompratransferencia => :P87_IDCOMPRATRANSFERENCIA
                                                                          , pidusuario => :P0_IDUSUARIO
                                                                          , psucesso => :P87_SUCESSO);
                
                    -- RN17 - Conquistou Levou: tipo 12 = Transferencia Brinde. Resolve a guia CL vinculada
                    -- a esta remessa (itens TIPOPRODUTO=E via saldo recebido, e TIPOPRODUTO=C via ITENSFALTANTES).
                    if v_TipoCompraTransfRemessa = 12 then
                        begin
                            select geb.idguiaentregabrinde
                              into v_idguiaconqlevou
                              from roman.guiasentregasbrindes geb
                             where geb.idremessafavorita = :P87_IDCOMPRATRANSFERENCIA;
                            --
                            roman.pck_conquistoulevou.pr_receber_automatico(p_idguiaentregabrinde => v_idguiaconqlevou);
                        exception
                            when no_data_found then
                                null; -- remessa nao vinculada a guia de brindes Conquistou Levou
                        end;
                    end if;
                
                
                /* Tratamento de erro geral da rotina*/
                exception
                    when others then
                        apex_error.add_error( p_message => 'Ops! Ocorreu um erro na na rotina Confirmar Recebimento Compra/Transferencia, contate o suporte.' || SQLERRM
                   				    , p_display_location => apex_error.c_inline_in_notification); 
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Confirmação realizada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1410259243127770594
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMAR
        }
    )

    process descarregarfid (
        name: DescarregaRFID
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE 
                    v_existeRecebimento NUMBER;
                    v_sucesso           VARCHAR2(1);
                    v_mensagem          VARCHAR2(4000);
                
                BEGIN 
                    SELECT COUNT(*)
                      INTO v_existeRecebimento
                      FROM favorita.rfid_recebimentos r
                     WHERE r.idcompratransferencia = :P87_IDCOMPRATRANSFERENCIA
                       AND r.processado = 'N';
                
                     IF v_existeRecebimento = 0 THEN
                        APEX_ERROR.ADD_ERROR(
                            p_message          => 'Nenhum retorno não processado disponível para a remessa.',
                            p_display_location => apex_error.c_inline_in_notification
                        );
                        RETURN;
                     END IF;
                
                    favorita.pck_rfid.prc_descarrega_rfid(
                      p_idcompratransferencia => :P87_IDCOMPRATRANSFERENCIA,
                      p_usuario               => :P0_IDUSUARIO,
                      p_sucesso               => v_sucesso,
                      p_mensagem              => v_mensagem
                   );
                
                   IF v_sucesso <> 'S' THEN
                      APEX_ERROR.ADD_ERROR(
                         p_message          => v_mensagem,
                         p_display_location => apex_error.c_inline_in_notification
                      );
                      RETURN;
                   END IF;
                   
                   APEX_APPLICATION.G_PRINT_SUCCESS_MESSAGE := v_mensagem;
                
                END;
                ```
        }
        execution {
            sequence: 100
        }
        error {
            errorMessage: Erro no processo de descarregar RFID.
        }
        advanced {
            executionMappingIdentifier: 45126800658625427
        }
        serverSideCondition {
            type: request=Value
            value: DESCARREGAR_RFID
        }
    )

