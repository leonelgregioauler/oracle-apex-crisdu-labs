    pageItem P87_AVISO_DIVERGENCIA_REPROVADA (
        type: displayOnly
        label {
            label: Atenção:
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 90
            region: @recebimento-compra-transferência-remessa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: staticValue
            staticValue: <font color="red"> Esta remessa possui divergência reprovada pelo estoque e aguarda sua confirmação! </font>
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from favorita.comprastransferencias c
                where idcompratransferencia = :P87_IDCOMPRATRANSFERENCIA
                and idsituacao = 30
                and exists ( select 1
                             from favorita.divergenciascomprastransferencias dc
                             where dc.idcompratransferencia = c.idcompratransferencia 
                             and dc.situacaodivergencia in ('R') )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P87_IDCOMPRATRANSFERENCIA (
        type: popupLov
        label {
            label: Selecione
            alignment: left
        }
        settings {
            displayAs: modalDialog
            initialFetch: onUserRequest
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_retornatipocomptransrem(c.idtipocomptransrem,:P0_IDIDIOMA)||' '||
                       c.numero||' - NF: '||
                       c.notafiscal||' - Situação: '||
                       pck_util_fav.fnc_retornasitcompratransf(c.idsituacao, :P0_IDIDIOMA) display_value
                     , c.idcompratransferencia return_value
                from comprastransferencias c
                where ( c.idtipocomptransrem in (0,1,12) and c.idsituacao in ( 20,30 )
                     or c.idtipocomptransrem in (2,3) and c.idsituacao in ( 20,30,40 ) )
                  and ( c.idfilialfavoritadestino = pck_util_fav.fnc_retornaidfilialfavusuario(:P0_IDUSUARIO)
                       or c.idfilialromancedestino = ( select idfilial
                                                       from gerentes
                                                       where idgerente = ( select idgerente
                                                                           from usuarios
                                                                           where idusuario = :P0_IDUSUARIO ) )
                       or v('APP_USER') = 'GUILHERME'
                       or v('APP_USER') = 'EVERTON'
                       or v('APP_USER') = 'PATRICIA'
                       or v('APP_USER') = 'PABLODEUNER'
                       or v('APP_USER') = 'JESSICABERNARDO'
                       or v('APP_USER') = 'TAMIRESBAUER'
                       or v('APP_USER') = 'ALEXANDREB'
                       or v('APP_USER') = 'BRUNATIMM'
                       or v('APP_USER') = 'BRUNOB'
                       or v('APP_USER') = 'OSIELF'
                       or v('APP_USER') = 'DIEGOPIECHO'
                       or v('APP_USER') = 'PABLOFORTI'
                       or v('APP_USER') = 'GUSTAVOCARVALHO'
                       or v('APP_USER') = 'MAICONAIMI'
                       or v('APP_USER') = 'EDUARDAZOTTI'
                       or v('APP_USER') = 'KETELINSILVA' 
                       or v('APP_USER') = 'PAULINENAUMANN'
                       or v('APP_USER') = 'LEONELG'
                       or v('APP_USER') = 'GRACIELEWATHIER' --T13094932
                       or v('APP_USER') = 'PEDROHENRIQUE'
                       or v('APP_USER') = 'JOAOLUCAS'
                       or v('APP_USER') = 'FERNANDALIMA'
                       or v('APP_USER') = 'KEROLAYNESANTOS'
                       or v('APP_USER') = 'SANNYBELISARIO'
                       or v('APP_USER') = 'CAMILABARTH'
                       or v('APP_USER') = 'MURILOPALMA'
                       or v('APP_USER') = 'GREGORYSILVA' )
                /*union
                select pck_util_fav.fnc_retornatipocomptransrem(c.idtipocomptransrem,:P0_IDIDIOMA)||' '||
                       c.numero||' - NF: '||
                       c.notafiscal||' - Situação: '||
                       pck_util_fav.fnc_retornasitcompratransf(c.idsituacao, :P0_IDIDIOMA) display_value
                     , c.idcompratransferencia return_value
                from comprastransferencias c
                where  v('APP_USER') = 'DIEGOPIECHO'
                  and c.idcompratransferencia = 81665*/
                 order by c.idcompratransferencia desc
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione a Compra/Rem/Transf -
        }
        cascadingLov {
            parentItems: P0_IDUSUARIO
        }
        layout {
            sequence: 20
            region: @recebimento-compra-transferência-remessa
            slot: regionBody
            alignment: left
