    region relatório-situação-divergência (
        name: Relatório Situação Divergência
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomeprodutodetalhadosref(i.idprodutodetalhado, nvl(:P0_IDIDIOMA,1)) as "Produto"
                     , decode(d.situacaodivergencia, 'A', 'Aprovado', 'R', 'Recusado', 'Em Análise') as "Situação"
                  from favorita.divergenciascomprastransferencias d
                     , favorita.itenscomprastransferencias        i
                 where i.iditemcompratransferencia = d.iditemcompratransferencia
                   and d.idcompratransferencia = :P87_IDCOMPRATRANSFERENCIA;
                ```
        }
        layout {
            sequence: 10
            parentRegion: @situação-divergência
            slot: subRegions
