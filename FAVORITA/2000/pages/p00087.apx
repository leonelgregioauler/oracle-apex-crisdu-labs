    dynamicAction busca-compra-remessa-transf (
        name: Busca Compra/Remessa/Transf
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P87_IDCOMPRATRANSFERENCIA
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                        select ff.idempresavirtualage
                             , ct.notafiscal
                             , null
                             , null
                             , ct.idtipocomptransrem
                             , ff.idpais
                        into :P87_IDEMPRESAVIRTUALAGE
                           , :P87_NOTAFISCAL
                           , :P87_NOTAFISCALDEVOLUCAO
                           , :P87_RESPOSTA
                           , :P87_IDTIPOCOMPTRANSREM
                           , :P87_IDPAIS
                        from favorita.comprastransferencias ct
                           , favorita.filiaisfavorita ff 
                        where ct.idfilialfavoritadestino = ff.idfilialfavorita 
                        and ct.idcompratransferencia = :P87_IDCOMPRATRANSFERENCIA;
                    exception
                        when others then
                            null;
                    end;
                    ```
                itemsToSubmit: P87_IDCOMPRATRANSFERENCIA
                itemsToReturn: [
                    P87_IDEMPRESAVIRTUALAGE
                    P87_NOTAFISCAL
                    P87_NOTAFISCALDEVOLUCAO
                    P87_RESPOSTA
                    P87_IDTIPOCOMPTRANSREM
                    P87_IDPAIS
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: BUSCAR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction confirma (
        name: Confirma
        execution {
            sequence: 90
        }
        when {
            event: click
            selectionType: button
