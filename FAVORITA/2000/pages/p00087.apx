    dynamicAction valida-quantidades-informadas (
        name: Valida Quantidades Informadas
        execution {
            sequence: 50
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $(document).on("change", ".tratarblur", function() {
                          
                      //$(this).attr("id");
                      var objeto = $(this);
                    
                      var $linha = $(this).parents("tr");
                    
                      var produto             = $linha.find("input[id*=f04]").val();
                      var quantidadecomprada  = $linha.find("input[id*=f05]").val();
                      var quantidaderecebida  = $linha.find("input[id*=f06]").val();
                      var quantidadeavariada  = $linha.find("input[id*=f07]").val();
                      var quantidadeadicional = $linha.find("input[id*=f08]").val();
                      
                      quantidadecomprada  = parseInt(quantidadecomprada);
                      quantidaderecebida  = parseInt(quantidaderecebida);
                      quantidadeavariada  = parseInt(quantidadeavariada);
                      quantidadeadicional = parseInt(quantidadeadicional);
                    
                      quantidaderecebida  = !quantidaderecebida ? 0 : quantidaderecebida 
                      quantidadeavariada  = !quantidadeavariada ? 0 : quantidadeavariada
                      quantidadeadicional = !quantidadeadicional ? 0 : quantidadeadicional
                    
                      if ( quantidadecomprada >= 0 && quantidaderecebida >= 0 && quantidadeadicional >= 0 )  {  
                        /*  
                        if ( quantidadecomprada !== ( quantidaderecebida + quantidadeavariada ) ) { 
                          $(this).css("border-color", "red");
                        } else {
                           $(this).css("border-color", "#d9d9d9");
                        } */
                    
                        /*
                        if ( quantidadecomprada > ( quantidaderecebida + quantidadeavariada + quantidadeadicional ) ) {
                          $(this).css("background-color", "#FFEDCC");    
                        }*/ 
                    
                        if ( (quantidaderecebida + quantidadeavariada) > quantidadecomprada ) {
                          alert("Foram compradas somente " + quantidadecomprada  + " do produto " + produto + ". Informe a quantidade adicional no campo Qtd Recebida Adicional" );
                        } 
                    
                        if (quantidaderecebida > 0 || quantidadeavariada > 0) {
                          if ((quantidaderecebida + quantidadeavariada) < quantidadecomprada) {
                            alert("Foram compradas somente " + quantidadecomprada + " do produto " + produto + ". A quantidade recebida mais a avaria devem resultar neste valor");
                          }
                        }
                      }
                    });
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction valida-se-já-fez-o-recebimento (
        name: Valida se Já fez o recebimento
        execution {
            sequence: 60
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $(document).on("click", ".tratarblur", function() {
                          
                      var objeto = $(this);
                    
                      var $linha = $(this).parents("tr");
                    
                      var iditemcompratransf       = $linha.find("input[id*=f01]").val();
                      
                      var ambiente                 = document.getElementById("P0_ENDERECO_ORDS").value;
                      var consultamovimentacaoitem = 'favorita/2000/consultamovimentacaoitem/';
                      var enderecoORDS = ambiente + consultamovimentacaoitem + iditemcompratransf;
                    
                      function onMovimentacaoItemDone(data) {
                        if(data.items.length > 0) {
                          $(objeto).attr("readonly", true);
                        } else {
                          $(objeto).attr("readonly", false);
                        }
                      }
                      $.getJSON(enderecoORDS).done(onMovimentacaoItemDone);
                    
                    });
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

