    process receber-remessa (
        name: Receber Remessa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                  for c1 in (select pe.idpedido
                               from pedidos pe, pedidosremessasct pr, comprastransferencias ct
                              where pe.idpedido = pr.idpedido
                                and pr.idcompratransferencia = ct.idcompratransferencia
                                and pr.idcompratransferencia = :P87_IDCOMPRATRANSFERENCIA
                                /*and pe.idsituacaoentrega = 40000*/ ) loop
                                
                    -- ALTERA OS PEDIDOS DA REMESSA DE “Em Trânsito para distribuidora Romance” PARA “Em Rota de Entrega”
                    pck_movimentarpedidos_fav.prc_atualizasituacaoentrega (c1.idpedido,
                                                                           50000,
                                                                           :P0_IDUSUARIO) ;
                    
                    update comprastransferencias 
                       set idsituacao = 40
                     where idcompratransferencia = :P87_IDCOMPRATRANSFERENCIA;
                     
                  end loop;--
                
                end;
                ```
        }
        execution {
            sequence: 70
        }
        successMessage {
            successMessage: Remessa atualizada com sucesso!
        }
        error {
            errorMessage: Erro no processo de atualização da remessa. Verifique se os pedidos estão na situação "Em Trânsito para distribuidora Romance"
        }
        advanced {
            executionMappingIdentifier: 1987890033614936760
        }
        serverSideCondition {
            type: request=Value
            value: RECEBERREMESSA
        }
    )

