page 87 (
    name: Recebimento de Compras
    title: Recebimento de Compras
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function  buscanotafiscal(event)
            { 
              var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
            console.log (tecla);
              if (tecla==13)
                {
            		apex.submit('BUSCAR');
                }
            }
            
            function imprimecompra() 
              {
                  vurl = document.getElementById("P87_SESSION_IMPRIME").value;
                  pjan = window.open(vurl,'page','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1280,height=1024,left=20,top=10','_blank'); void(0);
                  pjan.focus();
              }
            
            
            ```
    }
    css {
        inline:
            ```css
            /* Aumenta a largura da coluna da direita */
            :root {
                --ut-body-actions-width: 15rem;
            }
            
            .t-Region-buttons-right {
                display: flex !important;
                align-items: center;
            }
            
            #DESCARREGAR_RFID {
                background-color: #1578d4;
                color: #ffffff;
                border-radius: 4px;
            }
            
            #DESCARREGAR_RFID:hover {
                background-color: #145DA0;
            }
            
            #SALVAR {
                border-radius: 4px;
            }
            
            #DIVIRGENCIA {
                border-radius: 4px;
            }
            ```
    }
    htmlHeader {
        htmlHeader:
            ```html
            <script 
              src="https://ajax.googleapis.com/ajax/libs/jquery/2.1.1/jquery.min.js">
            </script>
            
            <style>
                
                .vermelho input[type=text], .vermelho textarea  {
                    color:red;
                }
            
                .observacao {
                    border-radius: 10px;
                }   
            
            </style>
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region aviso (
        name: Aviso
        type: staticContent
        source {
            htmlCode:
                ```html
                <h2 style="text-align: center; color: #333;">Informações da Nota Fiscal</h2>
                <div style="display: flex; justify-content: center; background-color: #f9f9f9; border: 2px solid #ddd; padding: 10px;">
                    <div style="flex: 0.8; padding: 10px 20px; position: relative; border-right: 2px solid #ddd; text-align:center;">
                        <label style="font-weight: bold; display: block; color: #555;">Nota Fiscal:
                            <span id="notaFiscal" style="color: #222; font-size: large;">&P87_NOTAFISCAL.</span>
                        </label>
                    </div>
                    <div style="flex: 0.8; padding: 10px 20px; position: relative; border-right: 2px solid #ddd; text-align:center;">
                        <label style="font-weight: bold; display: block; color: #555;">Nota Fiscal Devolução:
                            <span id="notaFiscalDevolucao" style="color: #222; font-size: large;">&P87_NOTAFISCALDEVOLUCAO.</span>
                        </label>
                    </div>
                    <div style="flex: 1.4; padding: 10px 20px; position: relative;">
                        <label style="font-weight: bold; display: block; color: #555;">Resultado:
                            <span id="resposta" style="color: #222; font-size: large;">&P87_RESPOSTA.</span>
                        </label>
                    </div>
                </div>
                
                ```
        }
        layout {
            sequence: 10
            parentRegion: @recebimento-compra-transferência-remessa
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
                margin-top-lg
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P87_IDCOMPRATRANSFERENCIA is not null
                  and exists ( select 1
                               from comprastransferencias c
                               where c.idcompratransferencia = :P87_IDCOMPRATRANSFERENCIA
                                 and c.idtipocomptransrem in (0,1,2) )
                ```
        }
    )

    region confirmar-produtos (
        name: Confirmar Produtos
        type: tabform
        source {
            sqlQuery:
                ```sql
                select itc.iditemcompratransferencia
                     , itc.idcompratransferencia
                     , itc.idprodutodetalhado
                     , itc.quantidadecomprada
                     , itc.quantidaderecebida
                     , itc.quantidaderecebida quantidaderecebidaintegracao 
                     , itc.quantidadeavariada
                     , itc.quantidaderecebidaadicional
                     , itc.observacao
                     , itc.observacaoavaria
                     , itc.idestoquefilorigem
                     , itc.idestoquefildestino
                     , 6000000 + itc.idprodutodetalhado skuvirtutualage
                from itenscomprastransferencias itc
                where itc.idcompratransferencia = :P87_IDCOMPRATRANSFERENCIA
                  and itc.quantidadecomprada > 0;
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
            cssClasses: itens
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <div style="text-align: center; font-size: 20px; color: red;">Atenção! Não será salvo QTD RECEBIDA maior que a QTD COMPRADA!</div>
                <br>
                <br>
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P87_IDCOMPRATRANSFERENCIA is not null
                  and exists ( select 1
                               from comprastransferencias c
                               where c.idcompratransferencia = :P87_IDCOMPRATRANSFERENCIA
                                 and c.idtipocomptransrem in (0,1,2,12) ) -- 12 Proj. Conquistou levou v2
                ```
        }
