                                                                     , pidnotadevolucao         => :P87_NOTAFISCALDEVOLUCAO
                                                                     , pretornooutput           => true
                                                                     , perro                    => l_erro
                                                                     , presposta                => l_resposta);
                
                    :P87_RESPOSTA := l_resposta;
                    
                end;
