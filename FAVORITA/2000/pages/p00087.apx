    dynamicAction destacar-produtos-não-recebidos (
        name: Destacar produtos não recebidos
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $('input[name=f06]').each(function(idx) {
                          
                      idx = idx + 1;
                        
                      if (idx < 10) {
                        var quantidaderecebida  = document.getElementById( "f06_000" + idx ).value; 
                        var quantidadeavariada  = document.getElementById( "f07_000" + idx ).value; 
                        var quantidadeadicional = document.getElementById( "f08_000" + idx ).value;
                          
                      } else if (idx >= 10 && idx < 100) {
                         var quantidaderecebida  = document.getElementById( "f06_00" + idx ).value;
                         var quantidadeavariada  = document.getElementById( "f07_00" + idx ).value;
