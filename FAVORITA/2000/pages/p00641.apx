page 641 (
    name: Manutenção em Telefone Bloqueado
    title: Manutenção em Telefone Bloqueado
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='Você deseja realmente remover este telefone?';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region manutenção (
        name: Manutenção
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P641_DATA (
        type: datePickerJquery
        label {
            label: Data
            alignment: left
        }
        layout {
            sequence: 20
            region: @manutenção
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: DATA
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P641_IDTELEFONEBLOQUEADO
        }
        readOnly {
            type: itemIsNotNull
            item: P641_IDTELEFONEBLOQUEADO
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P641_IDTELEFONEBLOQUEADO (
        type: hidden
        layout {
            sequence: 10
            region: @manutenção
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDTELEFONEBLOQUEADO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P641_TELEFONE (
        type: hidden
        layout {
            sequence: 40
            region: @manutenção
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: TELEFONE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P641_TELEFONELIMPO (
        type: textField
        label {
            label: Telefone(Apenas Numero)
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 50
            region: @manutenção
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            type: databaseColumn
            databaseColumn: TELEFONELIMPO
            used: always
        }
        readOnly {
            type: itemIsNotNull
            item: P641_IDTELEFONEBLOQUEADO
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P641_USUARIO (
        type: textarea
        label {
            label: Usuario
            alignment: left
        }
        layout {
            sequence: 30
            region: @manutenção
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 100
        }
        source {
            type: databaseColumn
            databaseColumn: USUARIO
            used: always
        }
        default {
            type: expression
            plsqlExpression: v('APP_USER')
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P641_IDTELEFONEBLOQUEADO
        }
        readOnly {
            type: itemIsNotNull
            item: P641_IDTELEFONEBLOQUEADO
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 640
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P641_IDTELEFONEBLOQUEADO
        }
    )

    button delete (
        buttonName: DELETE
        label: Remover Telefone
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P641_IDTELEFONEBLOQUEADO
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process fetch-row-from-telefonesbloqueados (
        name: Fetch Row from TELEFONESBLOQUEADOS
        type: autoRowFetch
        source {
            tableOwner: ROMAN
            tableName: TELEFONESBLOQUEADOS
            pkColumn: IDTELEFONEBLOQUEADO
            pkItem: P641_IDTELEFONEBLOQUEADO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 3221968249470407798
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P641_IDTELEFONEBLOQUEADO is null then
                        select "ROMAN"."SEQ_IDTELEFONEBLOQUEADO".nextval
                          into :P641_IDTELEFONEBLOQUEADO
                          from sys.dual;
                      :P641_DATA := sysdate;
                      :P641_USUARIO := v('APPUSER');
                      :P641_TELEFONE := :P641_TELEFONELIMPO;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 3221968635954407798
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-telefonesbloqueados (
        name: Process Row of TELEFONESBLOQUEADOS
        type: autoRowProcessing
        target {
            tableOwner: ROMAN
            tableName: TELEFONESBLOQUEADOS
            pkColumn: IDTELEFONEBLOQUEADO
            pkItem: P641_IDTELEFONEBLOQUEADO
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 3221969071082407797
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 3221969462376407797
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

)

