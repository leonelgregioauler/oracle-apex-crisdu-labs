page 150 (
    name: Usuarios Filiais Favorita
    title: Usuarios Filiais Favorita
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region usuários (
        name: Usuários
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region usuários-filiais-favorita (
        name: Usuários Filiais Favorita
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select uf.idusuariofilialfavorita
                     , uf.idusuario
                     , uf.idfilialfavorita
                     , uf.consultar
                     , uf.movimentar
                     , uf.visualizarcaixa
                     , uf.ENCERRARCAIXA
                     , uf.dadostableau
                from usuariosfiliaisfavorita uf
                where uf.idusuario = :P150_USUARIO
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 30988053346680811
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDUSUARIOFILIALFAVORITA
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDUSUARIO
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDFILIALFAVORITA
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @CONSULTAR
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @MOVIMENTAR
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @ROWID
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @VISUALIZARCAIXA
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @ENCERRARCAIXA
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @DADOSTABLEAU
                layout {
                    sequence: 9
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column CONSULTAR (
            type: selectList
            heading {
                heading: Consultar
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC:Sim;S,Não;N
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                databaseColumn: CONSULTAR
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column DADOSTABLEAU (
            type: selectList
            heading {
                heading: Ver Dados no Tableau
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC:Sim;S,Não;N
            }
            layout {
                sequence: 110
                columnAlignment: center
            }
            source {
                databaseColumn: DADOSTABLEAU
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column ENCERRARCAIXA (
            type: selectList
            heading {
                heading: Encerrar Caixa
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC:Sim;S,Não;N
            }
            layout {
                sequence: 100
                columnAlignment: center
            }
            source {
                databaseColumn: ENCERRARCAIXA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDFILIALFAVORITA (
            type: selectList
            heading {
                heading: Filial Favorita
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) as d,
                           idfilialfavorita as r
                      from filiaisfavorita f
                     order by 1
                    ```
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                databaseColumn: IDFILIALFAVORITA
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDUSUARIO (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: IDUSUARIO
                dataType: number
            }
            default {
                type: item
                item: P150_USUARIO
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDUSUARIOFILIALFAVORITA (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IDUSUARIOFILIALFAVORITA
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: SEQ_IDUSUARIOFILIALFAVORITA
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column MOVIMENTAR (
            type: selectList
            heading {
                heading: Movimentar
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC:Sim;S,Não;N
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                databaseColumn: MOVIMENTAR
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column ROWID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ROWID
                dataType: rowid
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column VISUALIZARCAIXA (
            type: selectList
            heading {
                heading: Visualizar/Alterar Caixa
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC:Sim;S,Não;N
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            source {
                databaseColumn: VISUALIZARCAIXA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

    )

    pageItem P150_USUARIO (
        type: plugin/select
        label {
            label: Usuário
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select pck_util_fav.fnc_nomeusuario(u.idusuario) display_value
                     , u.idusuario return_value
                from usuarios u
                where u.ativo = 'S'
                  and exists ( select 1
                               from usuariossistemas uu
                               where uu.usuario = u.usuario 
                                 and uu.idsistema = 2000 )
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @usuários
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction recarregar (
        name: Recarregar
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P150_USUARIO
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process usuários-filiais-favorita-save-interactive-grid-data (
        name: Usuários Filiais Favorita - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @usuários-filiais-favorita
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 30988988613680820
        }
    )

    branch (
        name: filtra
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 150
                items: {
                    P150_USUARIO: &P150_USUARIO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: FILTRA
        }
    )

)

