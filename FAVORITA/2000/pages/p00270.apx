            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: P
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P270_PA (
        type: selectList
        label {
            label: P.A.
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.codigo
                  , p.codigo
                from posicoesatendimentos p
                order by p.codigo
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 160
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P270_PEDIDOSCANCELADOS (
        type: selectList
        label {
            label: Pedidoscancelados
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Sim;1,Não;2
            displayExtraValues: false
            nullDisplayValue: " - Todos -"
            nullReturnValue: 0
        }
        layout {
            sequence: 240
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P270_PROMISSORIARECEBIDA (
        type: checkboxGroup
        label {
            label: "Prom. Recebida "
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2: ;S
        }
        layout {
            sequence: 260
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P270_REMESSA (
        type: selectList
        label {
            label: Remessa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.numero||' - '||pck_util_fav.fnc_retornasitcompratransf(c.idsituacao,1)
                               ||' - '||roman.pck_romance.fnc_nomepostoavancado(c.idpostoavancadodestino)display_value
                 , c.idcompratransferencia return_value
                from comprastransferencias c
                where c.idfilialromancedestino = :P270_IDFILIALROMANCE
                  and :P270_IDPOSTOAVACADO is null or c.idpostoavancadodestino = :P270_IDPOSTOAVANCADO
                order by numero
                ```
            nullDisplayValue: "- Todas - "
        }
        cascadingLov {
            parentItems: P270_IDFILIALROMANCE
        }
        layout {
            sequence: 150
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P270_TIPOPEDIDO (
        type: selectList
        label {
            label: Tipo
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Pedido;P,Troca;T,Venda Direta;V
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 120
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P270_VLRTOTAL (
        type: numberField
        label {
            label: Valor Total
            alignment: left
