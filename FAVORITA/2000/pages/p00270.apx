page 270 (
    name: Pedidos ADM
    title: Pedidos ADM
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-size720x480
            ]
        }
        advanced {
            htmlDomId: FILTRO
            regionDisplaySelector: true
        }
    )

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pedidos (
        name: Pedidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpedido
                     , p.idedicaorevista
                     , p.edicaorevista
                     , p.idfilialfavorita
                     , p.filialfavorita
                     , p.idfilialromance
                     , p.filialromance
                     , p.idgerente
                     , p.gerente
                     , p.idrepresentante
                     , p.representante
                     , p.idvendedora
                     , p.vendedora
                     , p.cpf
                     , p.idusuario
                     , p.nomeusuario
                     , p.idsituacaoentrega
                     , p.situacaoentrega
                     , p.idsituacaocobranca 
                     , p.situacaocobranca
                     , p.idsituacaofinanceiro
                     , p.situacaofinanceiro
                     , p.numeropedido
                     , trunc(p.dataemissao) dataemissao
                     , trunc(p.dataentrega) dataentrega
                     , trunc(p.datadespacho) datadespacho
                     , trunc(p.datacancelamento) datacancelamento
                     , p.numeroposicaoatendimento
                     , p.idpedidooriginal
                     , p.rastreiotransporte
                     , p.valortotalcusto
                     , p.valortotal
                     , p.valorpontoutilizado
                     , p.valordesconto
                     , p.valortotalcomdesconto
                     , p.valorfrete
                     , p.valorapagar
                     , p.observacoessite
                     , p.idtarefa
                     , p.situacaoentregainterno
                     , p.situacaocobrancainterno
                     , p.situacaofinanceirointerno
                     , p.emespera
                     , p.datavencimento
                     , p.saldodevedor
                     , p.saldodevedorromance
                     , p.regiaocliente
                     , p.situacaocliente
                     , p.pedidocancelado
                     , decode(p.tipopedido,'P','Pedido'
                                          ,'T','Troca'
                                          ,'V','Venda Direta' ) tipopedido
                     , p.valorpago
                     , p.comissaodistribpaga
                     , p.comissaogerentepaga
                     , p.situacaopagamento
                     , nvl2( ( select 1
                               from favorita.classificacoespedidos c
                               where c.idpedido = p.idpedido
                               and c.idcaracteristicapedido = 2),'Sim','Não' ) PedidoDistribuidor
                     , ( select cpf
                         from pessoas pp
                         where pp.idpessoa = p.idpessoa ) cpfsemformatacao
                     , ( select datanascimento
                         from pessoas pp
                         where pp.idpessoa = p.idpessoa ) datanascimento
                     , ( select c.idvalorcaracteristica
                         from classificacoespedidos c
                         where c.idclassificacaopedido = ( select max(cc.idclassificacaopedido)
                                                           from classificacoespedidos cc
                                                           where cc.idpedido = p.idpedido
                                                             and cc.idcaracteristicapedido = 11 ) ) nrpedidos  
                     , nvl(( select 'Sim'
                       from dual
                       where exists ( select 1
                                            from catal.gerentes ccg
                                            where ccg.idgerente = p.idgerente
                                              and exists ( select 1
                                       from catal.vendedoras ccv
                                       where ccv.idvendedora = p.idvendedora
                                         and ccv.idpessoa = ccg.idpessoa))),'Não') PedidoGerente
                     , nvl(( select 'Sim'
                             from dual
                             where exists ( select 1
                                            from catal.representantes rep
                                            where rep.idrepresentante = p.idrepresentante
                                              and exists ( select 1
                                                           from catal.vendedoras ccv
                                                           where ccv.idvendedora = p.idvendedora
                                                             and ccv.idpessoa = rep.idpessoa))),'Não') PedidoRep
                     ,( select to_char(vp.datavencimento, 'MONTH')
                        from favorita.vencimentospedidos vp
                        where vp.idpedido = p.idpedido
                          and vp.situacaovencimento = 'V'
                          and rownum = 1) Vencmes
                     , extract(month from p.dataemissao)||'/'||extract(year from p.dataemissao) MesEmissao
                     , extract(month from p.dataentrega)||'/'||extract(year from p.dataentrega) MesEntrega
                     , extract(month from p.datadespacho)||'/'||extract(year from p.datadespacho) MesDespacho
                     , extract(month from p.datacancelamento)||'/'||extract(year from p.datacancelamento) MesCancelamento
                     ,( select s.semana ||'/'|| s.ano 
                         from semana_dias s
                         where trunc(p.dataemissao) between (s.dt_ini) and (s.dt_fim)) semanaemissao
                from vw_pedidos_fav p
                where p.ididioma  = :P0_IDIDIOMA
                  and p.idsituacaoentrega >= 20000
                  and ( :P270_PEDIDOSCANCELADOS = 0 
                      or ( :P270_PEDIDOSCANCELADOS = 1 and exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                    where cp.idpedido = p.idpedido
                                                                      and cp.idcaracteristicapedido = 25))
                      or ( :P270_PEDIDOSCANCELADOS = 2 and not exists ( select 1
                                                                        from favorita.classificacoespedidos cp
                                                                        where cp.idpedido = p.idpedido
                                                                          and cp.idcaracteristicapedido = 25)))
                  and :P270_OPCAO = 'P'
                  and ( :P270_DATA = 'N' or ( :P270_DATA = 'E' and trunc(p.dataemissao) between to_date(:P270_DATAINI,'dd/mm/rrrr') and to_date(:P270_DATAFIM,'dd/mm/rrrr') )
                                        or ( :P270_DATA = 'T' and trunc(p.dataentrega) between to_date(:P270_DATAINI,'dd/mm/rrrr') and to_date(:P270_DATAFIM,'dd/mm/rrrr') )
                                        or ( :P270_DATA = 'V' and exists ( select 1
                                                                          from vencimentospedidos vp
                                                                          where vp.idpedido = p.idpedido
                                                                            and vp.situacaovencimento = 'V'
                                                                            and trunc(vp.datavencimento) between to_date(:P270_DATAINI,'dd/mm/rrrr') and to_date(:P270_DATAFIM,'dd/mm/rrrr') ) ) )
                  and (:P270_IDFILIALROMANCE is null or p.idfilialromance = :P270_IDFILIALROMANCE )
                  and (:P270_IDFILIALFAVORITA is null or p.idfilialfavorita = :P270_IDFILIALFAVORITA )
                  and (:P270_IDREPRESENTANTE is null or p.idrepresentante = :P270_IDREPRESENTANTE )
                  and (:P270_IDVENDEDORA is null or p.idvendedora = :P270_IDVENDEDORA ) 
                  and (:P270_NRPEDIDO is null or p.numeropedido like '%'||trim(:P270_NRPEDIDO)||'%' )
                  and (:P270_ENVIARCORREIO is null or p.valorfrete > 0 )
                  and (:P270_FILTROAPLICADO is not null)
                  and (:P270_REMESSA is null or exists ( select 1
                                                        from pedidosremessasct pr
                                                        where pr.idpedido = p.idpedido
                                                          and pr.idcompratransferencia = :P270_REMESSA ))
                  and (:P270_IDPOSTOAVANCADO is null or ( exists ( select 1 from representantes r where r.idrepresentante = p.idrepresentante and r.idpostoavancado = :P270_IDPOSTOAVANCADO) ) )
                  and (:P270_IDTAREFA is null or p.idtarefa = :P270_IDTAREFA)
                  and (:P270_VLRTOTAL is null or p.valorapagar between :P270_VLRTOTAL - 10 and :P270_VLRTOTAL + 10)
                  and (:P270_TIPOPEDIDO is null or p.tipopedido = :P270_TIPOPEDIDO )
                  and (:P270_PA is null or p.numeroposicaoatendimento = :P270_PA )
                  and (:P270_EMESPERA is null or p.emespera = 'Sim')
                  and (:P270_PEDIDOCANCELADO is null or p.pedidocancelado = 'Sim')
                  and (:P270_FUNCIONARIO is null or p.pedidofuncionario = 'Sim')
                  and (:P270_ATENDENTE is null or p.idusuario = :P270_ATENDENTE )
                  and (:P270_IDGERENTE is null or exists ( select 1
                                                          from vendedoras v
                                                          where v.idvendedora = p.idvendedora
                                                            and v.idpessoa    = ( select idpessoa 
                                                                                  from catal.funcionarios f
                                                                                  where f.idgerente = :P270_IDGERENTE
                                                                                    and f.idpessoa  = v.idpessoa ) ) )
                  and (:P270_PROMISSORIARECEBIDA is null or exists ( select 1
                                                                    from classificacoespedidos c
                                                                    where c.idpedido = p.idpedido
                                                                      and c.idcaracteristicapedido = 15 ))
                  and (:P270_IDSITUACAOPROMISSORIA is null or exists ( select 1
                                                                      from classificacoespedidos c
                                                                      where c.idpedido = p.idpedido
                                                                        and c.idcaracteristicapedido = 16
                                                                        and c.idvalorcaracteristica = :P270_IDSITUACAOPROMISSORIA ))
                union
                select p.idpedido
                     , null idedicaorevista
                     , null edicaorevista
                     , null idfilialfavorita
                     , null filialfavorita
                     , p.idfilial idfilialromance
                     , p.filial filialromance
                     , null idgerente
                     , p.gerente
                     , p.idrepresentante 
                     , p.representante
                     , p.idvendedora
                     , p.consultora vendedora
                     , catal.pck_romance.fnc_cpfvendedora(p.idvendedora) cpf
                     , null idusuario
                     , null nomeusuario
                     , null idsituacaoentrega
                     , null situacaoentrega
                     , null idsituacaocobranca
                     , null situacaocobranca
                     , null idsituacaofinanceiro
                     , null situacaofinanceiro
                     , p.numeropedido
                     , trunc(p.dataemissao)  dataemissao
                     , trunc(p.dataentrega)  dataentrega
                     , trunc(p.datadespacho) datadespacho
                     , null datacancelamento
                     , null numeroposicaoatendimento
                     , null idpedidooriginal
                     , null rastreiotransporte
                     , null valortotalcusto
                     , p.valortotal
                     , null valorpontoutilizado
                     , null valordesconto
                     , null valortotalcomdesconto
                     , p.valorfrete
                     , p.valorapagar
                     , null observacoessite
                     , null idtarefa
                     , null situacaoentregainterno
                     , null situacaocobrancainterno
                     , null situacaofinanceirointerno
                     , null emespera
                     , to_char(p.datavencpedido, 'DD/MM/RRRR') datavencimento 
                     , null saldodevedor
                     , null saldodevedorromance
                     , null regiaocliente
                     , null situacaocliente
                     , null pedidocancelado
                     , decode(p.tipo, 'P','Pedido'
                                    , 'R','Retirada de Pontos'
                                    , 'B','Brinde'
                                    , 'T','Troca') tipopedido
                     , null valorpago
                     , null comissaodistribpaga
                     , null comissaogerentepaga
                     , null situacaopagamento
                     , null PedidoDistribuidor
                     , null cpfsemformatacao
                     , null datanascimento
                     , null nrpedidos
                     , nvl(( select 'Sim'
                              from dual
                              where exists ( select 1
                                             from catal.gerentes ccg
                                             where ccg.idgerente = p.idgerente
                                               and exists ( select 1
                                                            from catal.vendedoras ccv
                                                            where ccv.idvendedora = p.idvendedora
                                                              and ccv.idpessoa = ccg.idpessoa))),'Não') PedidoGerente
                     , nvl(( select 'Sim'
                             from dual
                             where exists ( select 1
                                            from catal.representantes rep
                                            where rep.idrepresentante = cp.idrepresentante
                                              and exists ( select 1
                                                           from catal.vendedoras ccv
                                                           where ccv.idvendedora = cp.idvendedora
                                                             and ccv.idpessoa = rep.idpessoa))),'Não') PedidoRep
                     
                     , null Vencmes 
                     , extract(month from p.dataemissao)||'/'||extract(year from p.dataemissao) MesEmissao
                     , extract(month from p.dataentrega)||'/'||extract(year from p.dataentrega) MesEntrega
                     , extract(month from p.datadespacho)||'/'||extract(year from p.datadespacho) MesDespacho
                     , null MesCancelamento  
                     ,( select s.semana ||'/'|| s.ano 
                         from semana_dias s
                         where trunc(p.dataemissao) between (s.dt_ini) and (s.dt_fim)) semanaemissao
                from vw_pedidos_old    p
                   , catal.pedidos cp
                where p.idpedido = cp.idpedido
                and p.idsituacao != 'Z'
                and cp.controlecancelado is null
                and :P270_OPCAO = 'P'
                and (:P270_DATA = 'N' or ( :P270_DATA = 'E' and trunc(p.dataemissao)    between to_date(:P270_DATAINI,'dd/mm/rrrr') and to_date(:P270_DATAFIM,'dd/mm/rrrr') )
                                      or ( :P270_DATA = 'T' and trunc(p.dataentrega)    between to_date(:P270_DATAINI,'dd/mm/rrrr') and to_date(:P270_DATAFIM,'dd/mm/rrrr') ) 
                                      or ( :P270_DATA = 'V' and trunc(p.datavencpedido) between to_date(:P270_DATAINI,'dd/mm/rrrr') and to_date(:P270_DATAFIM,'dd/mm/rrrr') ) )
                  and (:P270_IDFILIALROMANCE is null or p.idfilial = :P270_IDFILIALROMANCE )
                  and (:P270_IDFILIALFAVORITA is null)
                  and (:P270_IDREPRESENTANTE is null or p.idrepresentante = :P270_IDREPRESENTANTE )
                  and (:P270_IDVENDEDORA is null or p.idvendedora = :P270_IDVENDEDORA ) 
                  and (:P270_NRPEDIDO is null or p.idpedido like '%'||trim(:P270_NRPEDIDO)||'%' )
                  and (:P270_ENVIARCORREIO is null or p.valorfrete > 0 )
                  and (:P270_FILTROAPLICADO is not null)   
                  and (:P270_IDPOSTOAVANCADO is null or ( exists ( select 1 from representantes r where r.idrepresentante = p.idrepresentante and r.idpostoavancado = :P270_IDPOSTOAVANCADO) ) )
                  and (:P270_IDTAREFA is null or cp.idtarefa = :P270_IDTAREFA)
                  and (:P270_TIPOPEDIDO is null or p.tipo = :P270_TIPOPEDIDO )
                  and (:P270_PA is null or cp.numeropa = :P270_PA )
                  and (:P270_IDGERENTE is null or exists ( select 1
                                                          from vendedoras v
                                                          where v.idvendedora = p.idvendedora
                                                            and v.idpessoa    = ( select idpessoa 
                                                                                  from catal.funcionarios f
                                                                                  where f.idgerente = :P270_IDGERENTE
                                                                                    and f.idpessoa  = v.idpessoa ) ) )
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P270_OPCAO
            value: P
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
        }
        advanced {
            savedReportMappingIdentifier: 2345222117450175665
        }

