        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 210
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
