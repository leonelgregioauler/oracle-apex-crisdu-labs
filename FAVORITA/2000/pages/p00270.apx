            sequence: 170
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 30
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

    button bt-filtrar (
        buttonName: BT_FILTRAR
        label: Filtrar
        layout {
            sequence: 40
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: openModal('FILTRO');
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 10
            region: @filtros
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-filter
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button novopedido (
        buttonName: NOVOPEDIDO_1
        label: Novo Pedido
        layout {
            sequence: 20
            region: @filtros
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 80
                items: {
                    P80_IDVENDEDORA:
                    P80_IDPEDIDO:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P0_NUMEROPOSICAOATENDIMENTO
        }
    )

    dynamicAction abre-filtro (
        name: Abre Filtro
        execution {
            sequence: 20
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P270_FILTROAPLICADO is null
                  and :P0_NUMEROPOSICAOATENDIMENTO is not null
                ```
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: javascript: openModal('FILTRO');
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction selecionar-data (
        name: Selecionar data
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P270_DATA
        }
        clientSideCondition {
            type: item!=value
            item: P270_DATA
            value: N
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P270_DATAINI
                    P270_DATAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P270_DATAINI
            }
            execution {
                sequence: 20
            }
        )

        action native-set-value (
            action: setValue
            affectedElements {
                selectionType: items
                items: [
                    P270_DATAINI
                    P270_DATAFIM
                ]
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P270_DATAINI
                    P270_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: Filtrar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 270
                items: {
                    P270_DATA: &P270_DATA.
                    P270_DATAINI: &P270_DATAINI.
                    P270_DATAFIM: &P270_DATAFIM.
                    P270_IDFILIALROMANCE: &P270_IDFILIALROMANCE.
                    P270_IDPOSTOAVANCADO: &P270_IDPOSTOAVANCADO.
                    P270_IDREPRESENTANTE: &P270_IDREPRESENTANTE.
                    P270_IDVENDEDORA: &P270_IDVENDEDORA.
                    P270_NRPEDIDO: &P270_NRPEDIDO.
                    P270_NRPROTOCOLO: &P270_NRPROTOCOLO.
                    P270_REMESSA: &P270_REMESSA.
                    P270_VOLUME: &P270_VOLUME.
                    P270_IDTAREFA: &P270_IDTAREFA.
                    P270_VLRTOTAL: &P270_VLRTOTAL.
                    P270_ENVIARCORREIO: &P270_ENVIARCORREIO.
                    P270_IDFILIALFAVORITA: &P270_IDFILIALFAVORITA.
                    P270_FILTROAPLICADO: S
                    P270_TIPOPEDIDO: &P270_TIPOPEDIDO.
                    P270_PA: &P270_PA.
                    P270_FUNCIONARIO: &P270_FUNCIONARIO.
                    P270_PROMISSORIARECEBIDA: &P270_PROMISSORIARECEBIDA.
                    P270_IDSITUACAOPROMISSORIA: &P270_IDSITUACAOPROMISSORIA.
                    P270_IDGERENTE: &P270_IDGERENTE.
                    P270_ATENDENTE: &P270_ATENDENTE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

