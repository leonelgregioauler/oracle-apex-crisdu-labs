    region vencimentos-de-pedidos (
        name: Vencimentos de Pedidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.IDVENCIMENTOPEDIDO
                     , v.idpedido
                     , v.datavencimento
                     , p.vendedora
                     , v.valorpagar
                     , v.valorpago
                     , v.saldo
                     , v.idtarefa
                     , v.situacaovencimento
                     , v.codsituacaovencimento
                     , null efetuarpagamento
                from vw_vencimentospedidos_fav v
                   , vw_pedidos_fav            p
                where p.idpedido = v.idpedido
                  and p.ididioma = :P0_IDIDIOMA
                  and :P270_OPCAO = 'V'
                  and ( :P270_DTINI is null  or ( :P270_DATA = 'E' and trunc(p.dataemissao) between to_date(:P270_DATAINI,'dd/mm/rrrr') and to_date(:P270_DATAFIM,'dd/mm/rrrr') )
                                            or ( :P270_DATA = 'T' and trunc(p.dataentrega) between to_date(:P270_DATAINI,'dd/mm/rrrr') and to_date(:P270_DATAFIM,'dd/mm/rrrr') )
                                            or ( :P270_DATA = 'V' and exists ( select 1
                                                                              from vencimentospedidos vp
                                                                              where vp.idpedido = p.idpedido
                                                                                and vp.datavencimento between to_date(:P270_DATAINI,'dd/mm/rrrr') and to_date(:P270_DATAFIM,'dd/mm/rrrr') ) ) )
                  and (:P270_IDFILIALROMANCE is null or p.idfilialromance = :P270_IDFILIALROMANCE )
                  and (:P270_IDFILIALFAVORITA is null or p.idfilialfavorita = :P270_IDFILIALFAVORITA )
                  and (:P270_IDREPRESENTANTE is null or p.idrepresentante = :P270_IDREPRESENTANTE )
                  and (:P270_IDVENDEDORA is null or p.idvendedora = :P270_IDVENDEDORA ) 
                  and (:P270_NRPEDIDO is null or p.numeropedido like '%'||trim(:P270_NRPEDIDO)||'%' )
                  and (:P270_ENVIARCORREIO is null or p.valorfrete > 0 )
                  and (:P270_FILTROAPLICADO is not null)
                 -- and (:P270_REMESSA is null or p.remessa = :P270_REMESSA)
                 -- and (:P270_VOLUME is null or p.volume = :P270_VOLUME)
                  and (:P270_IDPOSTOAVANCADO is null or ( exists ( select 1 from representantes r where r.idrepresentante = p.idrepresentante and r.idpostoavancado = :P270_IDPOSTOAVANCADO) ) )
                  and (:P270_IDTAREFA is null or p.idtarefa = :P270_IDTAREFA)
                  and (:P270_VLRTOTAL is null or p.valorapagar between :P270_VLRTOTAL - 10 and :P270_VLRTOTAL + 10)
                  and (:P270_TIPOPEDIDO is null or p.tipopedido = :P270_TIPOPEDIDO )
                  /*AND ( :P270_DATAINI is not null
                      or :P270_IDFILIALROMANCE is not null 
                      or :P270_IDREPRESENTANTE is not null 
                      or :P270_IDVENDEDORA is not null
                      or :P270_NRPEDIDO is not null
                      or :P270_NRPROTOCOLO is not null 
                      or :P270_IDTAREFA is not null 
                      or :P270_IDPOSTOAVANCADO is not null
                    --  or :P270_REMESSA is not null
                    --  or :P270_VOLUME is not null
                      or :P270_ORIGEM is not null
                      or :P270_VLRTOTAL is not null)*/
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P270_OPCAO
            value: V
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 2376007709645237527
        }

