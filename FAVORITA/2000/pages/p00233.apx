page 233 (
    name: Logs de Itens do Pedido
    title: Logs de Itens do Pedido
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region log-de-itens-do-pedido (
        name: Log de Itens do Pedido
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select it.idlog
                     , it.idpedido
                     , it.usuarioalteracao
                     , it.desctipoalteracao
                     , it.dataalteracao
                     , it.nomeprodutodetalhado
                     , it.quantidade
                     , it.valorvenda
                     , it.valortotalvenda
                     , it.valorcusto
                     , it.valordesconto
                     , it.valorapagar
                     , it.perccomissaogerente
                     , it.valorcomissaogerente
                     , it.perccomissaodistribuidor
                     , it.valorcomissaodistribuidor
                     , it.perccomissaoconsultora
                     , it.valorcomissaoconsultora
                     , it.valorcomissaoatendente
                from favorita.vw_log_itenspedidos_fav it
                where it.ididioma = 1
                  and it.idpedido = :P233_IDPEDIDO
                order by it.iditempedido , it.dataalteracao desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1690175453317009878
        }

        column DATAALTERACAO (
            type: plainText
            heading {
                heading: Data Alteração
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

