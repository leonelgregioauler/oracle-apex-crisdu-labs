        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 5727591 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAALTERACAO (
                sequence: 4
            )

            displayColumn DESCTIPOALTERACAO (
                sequence: 3
            )

            displayColumn IDLOG (
                sequence: 19
            )

            displayColumn IDPEDIDO (
                sequence: 1
            )

            displayColumn NOMEPRODUTODETALHADO (
                sequence: 5
            )

            displayColumn PERCCOMISSAOCONSULTORA (
                sequence: 16
            )

            displayColumn PERCCOMISSAODISTRIBUIDOR (
                sequence: 14
            )

            displayColumn PERCCOMISSAOGERENTE (
                sequence: 12
            )

            displayColumn QUANTIDADE (
                sequence: 6
            )

            displayColumn USUARIOALTERACAO (
                sequence: 2
            )

            displayColumn VALORAPAGAR (
                sequence: 11
            )

            displayColumn VALORCOMISSAOATENDENTE (
