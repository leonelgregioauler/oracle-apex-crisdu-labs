page 148 (
    name: Impressão Lista de Pedidos Conferência
    title: Impressão Lista de Pedidos Conferência
    appearance {
        pageTemplate: @minimal-pedido
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region impressão-pedidos (
        name: Impressão Pedidos
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin 
                  --
                  pck_imprime_fav.prc_listapedidosremessa(pidcompratransferencia => :P148_IDCOMPRATRANSFERENCIA,
                                                          pidusuario => :P0_IDUSUARIO,
                                                          pididioma => :P0_IDIDIOMA);
                  --
                end;
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P148_IDCOMPRATRANSFERENCIA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @impressão-pedidos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

