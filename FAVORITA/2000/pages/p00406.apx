page 406 (
    name: Pedidos p/ Faturar Favorita Paris
    title: Pedidos p/ Faturar Favorita Paris
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pedidos-favorita-paris (
        name: Pedidos Favorita Paris
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpedido 
                     , case 
                         when p.idpedidovirtualage is null then
                           'Não'
                         else 'Sim'
                       end Integrado        
                     , p.idpedidovirtualage 
                     , nvl(( select 'Sim'
                             from favorita.classificacoespedidos cp
                             where cp.idpedido = p.idpedido
                               and cp.idcaracteristicapedido = 48
                               and cp.idvalorcaracteristica not in (1)),'Não') Faturado
                     , p.filialfavorita
                from favorita.vw_pedidos_fav p
                where exists ( select 1
                               from favorita.filiaisfavorita f
                               where p.idfilialfavorita = f.idfilialfavorita 
                                 and f.tipofilial = 'F')
                  and p.idsituacaoentrega > 20000       
                  and not exists ( select 1
                                   from favorita.classificacoespedidos cp
                                   where cp.idpedido = p.idpedido
                                     and cp.idcaracteristicapedido = 25)
                  and (:P406_IDFILIALFAVORITA is null or p.idfilialfavorita = :P406_IDFILIALFAVORITA)
                  and (:P406_FATURADO = 0
                       or (:P406_FATURADO = 1 and p.idpedidovirtualage is not null)
                       or (:P406_FATURADO = 2 and p.idpedidovirtualage is null))
                  and ( (:P406_DATAINICIAL is null and :P406_DATAFINAL is null)
                       or (trunc(p.dataemissao) between to_date(:P406_DATAINICIAL,'dd/mm/rrrr') and to_date(:P406_DATAFINAL,'dd/mm/rrrr')))
                  and (:P406_INTEGRADO = 0 
                       or (:P406_INTEGRADO = 1 and exists ( select 1
                                                            from favorita.classificacoespedidos cp
                                                            where cp.idpedido = p.idpedido
                                                              and cp.idcaracteristicapedido = 48
                                                              and cp.idvalorcaracteristica not in (1)))
                       or (:P406_INTEGRADO = 2 and not exists ( select 1
                                                                from favorita.classificacoespedidos cp
                                                                where cp.idpedido = p.idpedido
                                                                  and cp.idcaracteristicapedido = 48
                                                                  and cp.idvalorcaracteristica not in (1))))
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1548186809989138313
        }

        column FATURADO (
            type: plainText
            heading {
                heading: Faturado
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column FILIALFAVORITA (
            type: plainText
            heading {
                heading: Filial
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column IDPEDIDO (
            type: link
            heading {
                heading: Pedidos
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 68
                    items: {
                        P68_IDPEDIDO: #IDPEDIDO#
                    }
                    action: resetPagination
                }
                linkText: #IDPEDIDO#
                linkAttributes: target=”_blank”
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column IDPEDIDOVIRTUALAGE (
            type: plainText
            heading {
                heading: Numero Pedido Virtual
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column INTEGRADO (
            type: plainText
            heading {
                heading: Integrado
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 15607855 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn FATURADO (
                sequence: 4
            )

            displayColumn FILIALFAVORITA (
                sequence: 5
            )

            displayColumn IDPEDIDO (
                sequence: 1
            )

            displayColumn IDPEDIDOVIRTUALAGE (
                sequence: 3
            )

            displayColumn INTEGRADO (
                sequence: 2
            )

        )

    )

    pageItem P406_DATAFINAL (
        type: datePickerJquery
        label {
            label: Data Emissão Final
            alignment: left
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P406_DATAINICIAL (
        type: datePickerJquery
        label {
            label: Data Emissão Inicial
            alignment: left
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P406_FATURADO (
        type: selectList
        label {
            label: Faturado
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:- Todos -;0,Sim;1,Não;2
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        source {
            type: staticValue
            staticValue: 0
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P406_IDFILIALFAVORITA (
        type: selectList
        label {
            label: "Filial "
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nomefilialfavorita showvalue
                     , f.idfilialfavorita   returnvalue
                from favorita.filiaisfavorita f
                where f.tipofilial = 'F'
                ```
            displayExtraValues: false
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P406_INTEGRADO (
        type: selectList
        label {
            label: Integrado
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:- Todos -;0,Sim;1,Não;2
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        source {
            type: staticValue
            staticValue: 0
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
                t-Button--stretch
            ]
            icon: fa-filter
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

