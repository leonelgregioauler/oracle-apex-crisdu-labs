            encryptSessionState: false
        }
    )

    pageItem P374_DATAINICIO (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: DD/MM/RRRR
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P374_GRUPO (
        type: selectList
        label {
            label: Grupo
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select g.descricao
                     , g.idgrupoatendimento
                from roman.gruposatendimento g
                where g.idgrupoatendimento in (3,4,33,34,54,55)
                order by 2
                ```
            nullDisplayValue: - Selecione um Grupo -
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P374_IDGRUPO (
        type: selectList
        label {
            label: Grupo
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Cobrança;3,Call Center;4
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @renovar-metas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P374_IDMES (
        type: selectList
        label {
            label: "Mês "
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select mes 
                     , numero
                from roman.meses
                order by numero
                ```
        }
        layout {
            sequence: 20
            region: @renovar-metas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P374_IDMESCOPIA (
        type: selectList
        label {
            label: Para
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select mes 
                     , numero
                from roman.meses
                order by numero
                ```
        }
        layout {
            sequence: 30
            region: @renovar-metas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P374_IDUSUARIO (
        type: selectList
        label {
            label: Usuário
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeusuario(u.idusuario) display_value
                     , u.idusuario return_value
                from usuarios u
                where u.ativo = 'S'
                  and exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ( :P374_GRUPO is null or ug.idgrupoatendimento = :P374_GRUPO )
                                 and ug.usuario            = u.usuario )
                order by 1
                ```
            nullDisplayValue: - Selecione -
        }
        cascadingLov {
            parentItems: P374_GRUPO
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button nova-meta (
        buttonName: NOVA_META
        label: Nova Meta
        layout {
            sequence: 10
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--primary
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 375
                items: {
                    P375_IDMETACOBRANCA:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button renovar (
        buttonName: RENOVAR
        label: Renovar
        layout {
            sequence: 10
            region: @renovar-metas
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button renovar-meta (
        buttonName: RENOVAR_META
        label: Renovar Meta
        layout {
            sequence: 20
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: openModal('RENOVAR');
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process busca-periodo-de-campanha (
        name: Busca Periodo de Campanha
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vde date;
                  vate date;
                  --
                begin
                  --
                  select de
                       , ate
                  into vde
                     , vate
                  from roman.vw_periodo_metas w 
                  where w.data = trunc(sysdate);
                  --
                  :P374_DATAINICIO := to_date(vde,'DD/MM/RRRR');
                  :P374_DATAFIM := to_date(vate,'DD/MM/RRRR');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 5370335188388931009
        }
        serverSideCondition {
            type: itemIsNull
            item: P374_DATAINICIO
        }
    )

    process renovar-metas (
        name: Renovar Metas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_util_fav.prc_renovametascobranca ( pidmesorigem  => :P374_IDMES
                                                       , pidmesdestino => :P374_IDMESCOPIA
                                                       , pidgrupo      => :P374_IDGRUPO );
                  -- 
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Metas Renovadas com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1522883200069937337
        }
        serverSideCondition {
            type: request=Value
            value: RENOVAR
        }
    )

    branch (
        name: Go To Page 374
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 374
                items: {
                    P374_IDUSUARIO: &P374_IDUSUARIO.
                    P374_DATAFIM: &P374_DATAFIM.
                    P374_DATAINICIO: &P374_DATAINICIO.
                    P374_GRUPO: &P374_GRUPO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

