page 374 (
    name: Metas da Cobrança/Call Center
    title: Metas da Cobrança/Call Center
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 30
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region metas-da-cobrança-call-center (
        name: Metas da Cobrança/Call Center
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.idmetacobranca
                     , m.valormeta
                     , m.idusuario
                     , m.usuario
                     , m.datainicio
                     , m.datafim
                from vw_metascobrancas_fav m
                where ( :P374_DATAINICIO is null 
                     or trunc(m.datainicio) = to_date(:P374_DATAINICIO)
                     and trunc(m.datafim) = to_date(:P374_DATAFIM) )
                  and ( :P374_IDUSUARIO is null or m.idusuario = :P374_IDUSUARIO )
                  and exists ( select 1
                               from roman.usuariosgruposatendimento ug
                                  , usuarios u
                               where ug.idgrupoatendimento = :P374_GRUPO
                                 and ug.usuario  = u.usuario 
                                 and u.idusuario = m.idusuario )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado. Verifique os filtros!
        }
        advanced {
            savedReportMappingIdentifier: 1522881090027937315
        }

        column DATAFIM (
            type: plainText
            heading {
                heading: Data Fim
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: F
            }
        )

        column DATAINICIO (
            type: plainText
            heading {
                heading: Data Início
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: E
            }
        )

        column IDMETACOBRANCA (
            type: link
            heading {
                heading: Ver/Editar
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 375
                    items: {
                        P375_IDMETACOBRANCA: #IDMETACOBRANCA#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column IDUSUARIO (
            type: hidden
            heading {
                heading: Idusuario
            }
            layout {
                sequence: 40
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
            security {
                escapeSpecialChars: false
            }
        )

        column USUARIO (
            type: plainText
            heading {
                heading: Usuário
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column VALORMETA (
            type: plainText
            heading {
                heading: Meta
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 15229250 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAFIM (
                sequence: 5
            )

            displayColumn DATAINICIO (
                sequence: 4
            )

            displayColumn IDMETACOBRANCA (
                sequence: 1
            )

            displayColumn USUARIO (
                sequence: 2
            )

            displayColumn VALORMETA (
                sequence: 3
            )

            sort (
                column: USUARIO
                sort {
                    sequence: 1
                }
            )

            sort (
                column: DATAINICIO
                sort {
                    sequence: 2
                }
            )

        )

    )

