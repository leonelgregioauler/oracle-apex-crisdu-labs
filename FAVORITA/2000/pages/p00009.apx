page 9 (
    name: Relatório de Categorias
    title: Categorias
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region categorias (
        name: Categorias
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idcategoria
                     , c.nome
                     , c.referencia
                     , c.descrativo
                     , c.idcategoriasite
                     , cc.textotraduzido descrsite
                     , c.idtexto
                from vw_categorias_fav c
                   , vw_categoriassite_fav cc
                where c.idcategoriasite = cc.idcategoriasite (+)
                  and c.ididioma        = cc.ididioma (+)
                  and c.ididioma        = :P0_IDIDIOMA
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 7686051942972742
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDCATEGORIA
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @REFERENCIA
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @DESCRATIVO
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @IDCATEGORIASITE
                layout {
                    show: false
                    sequence: 5
                }
            )

            displayColumn (
                column: @DESCRSITE
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @IDTEXTO
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @NOME
                layout {
                    sequence: 2
                }
            )

        )

        column DESCRATIVO (
            type: textField
            heading {
                heading: Ativo
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 3
            }
            source {
                databaseColumn: DESCRATIVO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column DESCRSITE (
            type: textarea
            heading {
                heading: Categoria Site
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: DESCRSITE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column IDCATEGORIA (
            type: link
            heading {
                heading: Editar
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 10
                    items: {
                        P10_IDCATEGORIA: &IDCATEGORIA.
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                databaseColumn: IDCATEGORIA
                dataType: number
            }
        )

        column IDCATEGORIASITE (
            type: numberField
            heading {
                heading: Idcategoriasite
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                databaseColumn: IDCATEGORIASITE
                dataType: number
            }
        )

        column IDTEXTO (
            type: numberField
            heading {
                heading: Tradução
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            link {
                target: {
                    page: 100
                    items: {
                        P100_IDTEXTOTRADUZIDO: &IDTEXTO.
                    }
                    action: resetPagination
                }
                linkText: <b>Visualizar / Atualizar texto traduzido</b>
                linkAttributes: class="t-Button t-Button--sucess"
            }
            source {
                databaseColumn: IDTEXTO
                dataType: number
            }
        )

        column NOME (
            type: textarea
            heading {
                heading: Nome
            }
            layout {
                sequence: 80
            }
            validation {
                valueRequired: true
                maxLength: 100
            }
            source {
                databaseColumn: NOME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column REFERENCIA (
            type: textarea
            heading {
                heading: Referência
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: REFERENCIA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

    )

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    button novo (
        buttonName: Novo
        label: Novo
        layout {
            sequence: 10
            region: @categorias
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button novo-2 (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10
                items: {
                    P10_IDCATEGORIA: &P10_IDCATEGORIA.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

