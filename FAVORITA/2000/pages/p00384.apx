page 384 (
    name: Envio de SMS Boleto
    title: Envio de SMS Boleto
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region enviar-sms (
        name: Enviar SMS
        type: staticContent
        source {
            htmlCode: <script type="text/javascript" src="https://websocket.romancemoda.com.br/favorita_boleto.js"></script>
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P384_CONSULTORA (
        type: textField
        label {
            label: Consultora
            alignment: left
        }
        layout {
            sequence: 50
            region: @enviar-sms
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P384_IDPEDIDO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @enviar-sms
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P384_LINHADIGITAVEL (
        type: displayOnly
        label {
            label: Código de Barras
            alignment: left
        }
        layout {
            sequence: 40
            region: @enviar-sms
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: item=value
            item: P384_TIPO_SMS
            value: B
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P384_TELEFONE (
        type: textField
        label {
            label: Telefone
            alignment: left
        }
        layout {
            sequence: 60
            region: @enviar-sms
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 20
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P384_TEXTO_SMS (
        type: displayOnly
        label {
            label: Mensagem
            alignment: left
        }
        layout {
            sequence: 30
            region: @enviar-sms
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select case substr(REGEXP_REPLACE(pg.linhadigitavel,'[[:alpha:],[:space:],[:punct:]]'),12,7) 
                             when '2846474' then 'Conta p/ deposito:AG 3414-2 CC 17668-0 Benef.:FAVORITA SUL COMERCIO DE CONFECCOES LTDA.Informar comprovante no 0800 643 0408.Ligacao gratuita'
                             when '3550636' then 'Conta p/ deposito:AG 3414-2 CC 17668-0 Benef.:FAVORITA SUL COMERCIO DE CONFECCOES LTDA.Informar comprovante no 0800 643 0408.Ligacao gratuita'
                             when '3550401' then 'Conta p/ deposito:AG 3414-2 CC 17667-2 Benef.:FAVORITA COMERCIO DE CONFECCOES LTDA.Informar comprovante no 0800 643 0408.Ligacao gratuita'
                        end Conta
                    from favorita.pedidos p
                       , favorita.pagamentospedidos pg
                       , favorita.vencimentospedidos v
                    where p.idpedido = v.idpedido 
                      and v.idvencimentopedido = pg.idvencimentopedido
                      and p.idpedido = :P384_IDPEDIDO
                      and v.situacaovencimento  = 'V'
                      and pg.idformapagamento   = 1
                      and pg.linhadigitavel is not null ;
                ```
        }
        serverSideCondition {
            type: item=value
            item: P384_TIPO_SMS
            value: D
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P384_TIPO_SMS (
        type: radioGroup
        label {
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Boleto;B,Depósito;D
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @enviar-sms
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: B
        }
        security {
            encryptSessionState: false
        }
    )

    button buscar-linha (
        buttonName: BUSCAR_LINHA
        label: Buscar Linha Digitável
        layout {
            sequence: 10
            region: @enviar-sms
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: "javascript: CarregarLinhaDigitavel(document.getElementById('P384_IDPEDIDO').value , function(dados){window.location.reload()});"
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P384_LINHADIGITAVEl = 'Boleto não encontrado!'
                  and :P384_TIPO_SMS = 'B'
                ```
        }
    )

    button enviar (
        buttonName: ENVIAR
        label: Enviar SMS
        layout {
            sequence: 20
            region: @enviar-sms
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from pagamentospedidos pg
                  , vencimentospedidos v
                where v.idpedido = :P384_IDPEDIDO
                 and pg.idvencimentopedido = v.idvencimentopedido
                 and v.situacaovencimento  = 'V'
                 and pg.idformapagamento   in  (1,26)
                 and pg.linhadigitavel is not null
                 and trunc(datavencimento) - trunc(sysdate) between -30 and 30
                 and :P384_TIPO_SMS = 'B'
                ```
        }
    )

    button enviar-sms (
        buttonName: ENVIAR_SMS
        label: Enviar SMS
        layout {
            sequence: 30
            region: @enviar-sms
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P384_TIPO_SMS
            value: D
        }
    )

    dynamicAction refresh-pagina (
        name: Refresh Pagina
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P384_TIPO_SMS
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: ATUALIZAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction tipo-de-envio (
        name: Tipo de Envio
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P384_TIPO_SMS
        }
        clientSideCondition {
            type: item=value
            item: P384_TIPO_SMS
            value: B
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P384_LINHADIGITAVEL
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P384_TEXTO_SMS
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P384_LINHADIGITAVEL
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P384_TEXTO_SMS
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    validation valida-telefone (
        name: Valida Telefone
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P384_TELEFONE
        }
        error {
            errorMessage: Telefone precisa ser informado!
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('ENVIAR','ENVIAR_SMS')
                ```
        }
    )

    process busca-informações (
        name: Busca Informações
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vconsultora varchar2(1000);
                  vlinhadigitavel varchar2(1000);
                  --
                begin
                  --
                  select roman.pck_romance.fnc_nomevendedora(idvendedora)
                       , nvl(( select linhadigitavel
                               from pagamentospedidos pg
                                  , vencimentospedidos v
                               where v.idpedido = p.idpedido
                                 and pg.idvencimentopedido = v.idvencimentopedido
                                 and v.situacaovencimento  = 'V'
                                 and pg.idformapagamento   in (1,26)
                                 and pg.linhadigitavel is not null
                                 and trunc(datavencimento) - trunc(sysdate) between -30 and 30 ),'Boleto não encontrado!')
                  into vconsultora
                     , vlinhadigitavel
                  from pedidos p
                  where p.idpedido = :P384_IDPEDIDO;
                  --
                  :P384_CONSULTORA := vconsultora;
                  :P384_LINHADIGITAVEL := vlinhadigitavel;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1541744461030207649
        }
    )

    process envia-sms-depósito (
        name: Envia SMS Depósito
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_pedidos_fav.prc_enviasmsdeposito(pidpedido => :P384_IDPEDIDO,
                                                       ptelefone => :P384_TELEFONE);
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: SMS enviado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 3323756425466041725
        }
        serverSideCondition {
            type: request=Value
            value: ENVIAR_SMS
        }
    )

    process envia-sms-do-boleto (
        name: Envia SMS do Boleto
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_pedidos_fav.prc_envialinhadigitavelsms(pidpedido => :P384_IDPEDIDO,
                                                             ptelefone => :P384_TELEFONE);
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Sms Enviado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1544164544853594502
        }
        serverSideCondition {
            type: request=Value
            value: ENVIAR
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 384
                items: {
                    P384_TIPO_SMS: &P384_TIPO_SMS.
                    P384_IDPEDIDO: &P384_IDPEDIDO.
                    P384_CONSULTORA: &P384_CONSULTORA.
                    P384_TELEFONE:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: ATUALIZAR
        }
    )

)

