    pageItem P481_IDUSUARIO (
        type: selectList
        label {
            label: Usuario
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select u.usuario showvalue
                     , u.idusuario returnvalue
                from usuarios u
                where u.ativo = 'S'
                  and exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.usuario = u.usuario
                                 and ug.idgrupoatendimento = 9)
                ```
        }
