    region relatório-de-produção-da-análise-de-credito-resumido (
        name: Relatório de Produção da Análise de Credito Resumido
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select Usuario
                     , count(1) QtdPedidos
                     , Aprovado
                     , sum(valor_spc) Soma_Valor_SPC
                     , sum(qtd_spc) Soma_QTD_SPC
                     , (sum(Ciclos)||'/'||sum(Recorrencia)) Ciclos_Recorrencia
                     , sum(valortotal) Soma_Valor_Total
                     , sum(valorapagar) Soma_Valor_Pagar
                     , round(avg(nvl(idadespc,0)),2) Media_Idade
                     , round(avg(nvl(TicketMedio8Meses,0)),2) Media_Ticket_8_Meses
                     , FilialRomance
                     , FilialFavorita
                     , listagg(Motivo,';') within group (order by 1 desc) Motivo
                from 
                (
                -- #1 - traz pedidos NÃO APROVAOS, EXTERIOR
                select pd.idpedido Numero_Pedido
                     , 'Não' Aprovado
                     , favorita.pck_util_fav.fnc_nomeusuario(pa.idusuarioatendeu) Usuario
                     , null valor_spc
                     , null qtd_spc
                     , null idadespc
                     , ( select count(1)
                         from favorita.pedidos p
                         where p.idvendedora = pd.idvendedora
                           and p.datacancelamento is null) Ciclos
                     , ( select count(1)
                         from favorita.pedidos p
                         where p.idvendedora = pd.idvendedora
                           and p.datacancelamento is null
                           and exists ( select 1 
                                        from favorita.vencimentospedidos vp
                                        where vp.idpedido = p.idpedido
                                          and vp.valorpago >= vp.valorpagar)) Recorrencia
                     , (pd.valortotal * pd.fatorconversao) valortotal
                     , (pd.valorapagar * pd.fatorconversao) valorapagar
                     , ( select round(avg(pp.valortotal * pp.valortotal),2) 
                         from favorita.pedidos pp
                         where pp.idvendedora = pd.idvendedora
                           and pp.datacancelamento is null
                           and trunc(pp.dataemissao) > (sysdate - 240)) TicketMedio8Meses
                     , favorita.pck_util_fav.fnc_nomefilialromance(pd.idfilialromance) FilialRomance
                     , favorita.pck_util_fav.fnc_nomefilialfavorita(pd.idfilialfavorita) FilialFavorita
                     , pa.justificativa Motivo
                from favorita.pedidos pd
                   , favorita.protocolosatendimentos pa
                   , favorita.filiaisfavorita ff
                where pd.idpedido = pa.idpedido
                  and pd.datacancelamento is not null
                  and pa.idtipoprotocolo = 1
                  and pa.idmotivoprotocolo = 15
                  and ff.idfilialfavorita = pd.idfilialfavorita
                  and (:P481_APROVADO = 'T' or :P481_APROVADO = 'N' )
                  and (:P481_IDUSUARIO = pa.idusuarioatendeu  or :P481_IDUSUARIO is null)
                  and pa.dataprotocolo between to_date(:P481_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P481_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                  and exists (select 1-- exists pra pegar somente pedidos de fora do brasil
                                from catal.filiais ff,
                                     catal.pessoas pp
                               where pp.idpessoa = ff.idpessoa
                                 and ff.idfilial = pd.idfilialromance
                                 and pp.idpais > 1)
                  and (:P481_PEDIDOS_BRASIL = 'A' or :P481_PEDIDOS_BRASIL = 'E' and ff.idpais > 1)  
                
                union all
                
                -- #2 - traz pedidos APROVAOS, EXTERIOR
                select pd.idpedido      Numero_Pedido
                     , 'Sim' Aprovado
                     , favorita.pck_util_fav.fnc_nomeusuario(cp.idusuario) Usuario 
                     , null valor_spc
                     , null qtd_spc
                     , null idadespc
                     , ( select count(1)
                         from favorita.pedidos p
                         where p.idvendedora = pd.idvendedora
                           and p.datacancelamento is null) Ciclos
                     , ( select count(1)
                         from favorita.pedidos p
                         where p.idvendedora = pd.idvendedora
                           and p.datacancelamento is null
                           and exists ( select 1 
                                        from favorita.vencimentospedidos vp
                                        where vp.idpedido = p.idpedido
                                          and vp.valorpago >= vp.valorpagar)) Recorrencia
                     , (pd.valortotal * pd.fatorconversao) valortotal
                     , (pd.valorapagar * pd.fatorconversao) valorapagar
                     , ( select round(avg(pp.valortotal * pp.fatorconversao),2) 
                         from favorita.pedidos pp
                         where pp.idvendedora = pd.idvendedora
                           and pp.datacancelamento is null
                           and trunc(pp.dataemissao) > (sysdate - 240)) TicketMedio8Meses
                     , favorita.pck_util_fav.fnc_nomefilialromance(pd.idfilialromance) FilialRomance
                     , favorita.pck_util_fav.fnc_nomefilialfavorita(pd.idfilialfavorita) FilialFavorita
                     , '' Motivo
                from favorita.pedidos pd
                   , favorita.classificacoespedidos cp
                   , favorita.filiaisfavorita ff
                where cp.idpedido = pd.idpedido
                  and cp.idcaracteristicapedido = 86
                  and :P481_TIPO = 'R'
                  and ff.idfilialfavorita = pd.idfilialfavorita
                  and (:P481_APROVADO = 'T' or :P481_APROVADO = 'S' )
                  and cp.dataclassificado between to_date(:P481_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P481_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                  and (:P481_IDUSUARIO = cp.idusuario or :P481_IDUSUARIO is null)
                  and exists (select 1-- exists pra pegar somente pedidos de fora do brasil
                                from catal.filiais ff,
                                     catal.pessoas pp
                               where pp.idpessoa = ff.idpessoa
                                 and ff.idfilial = pd.idfilialromance
                                 and pp.idpais > 1)
                  and (:P481_PEDIDOS_BRASIL = 'A' or :P481_PEDIDOS_BRASIL = 'E' and ff.idpais > 1)  
                
                union all
                
                -- #3 - traz pedidos APROVAOS, BRASIL 
                select pd.idpedido      Numero_Pedido
                     , 'Sim' Aprovado
                     , favorita.pck_util_fav.fnc_nomeusuario(cp.idusuario) Usuario 
                     , spc.valor_spc
                     , spc.qtd_spc
                     , spc.idade idadespc
                     , ( select count(1)
                         from favorita.pedidos p
                         where p.idvendedora = pd.idvendedora
                           and p.datacancelamento is null) Ciclos
                     , ( select count(1)
                         from favorita.pedidos p
                         where p.idvendedora = pd.idvendedora
                           and p.datacancelamento is null
                           and exists ( select 1 
                                        from favorita.vencimentospedidos vp
                                        where vp.idpedido = p.idpedido
                                          and vp.valorpago >= vp.valorpagar)) Recorrencia
                     , pd.valortotal
                     , pd.valorapagar
                     , ( select round(avg(pp.valortotal),2) 
                         from favorita.pedidos pp
                         where pp.idvendedora = pd.idvendedora
                           and pp.datacancelamento is null
                           and trunc(pp.dataemissao) > (sysdate - 240)) TicketMedio8Meses
                     , favorita.pck_util_fav.fnc_nomefilialromance(pd.idfilialromance) FilialRomance
                     , favorita.pck_util_fav.fnc_nomefilialfavorita(pd.idfilialfavorita) FilialFavorita
                     , '' Motivo
                from favorita.pedidos pd
                   , favorita.classificacoespedidos cp,
                   (select sp.spc_valortotal as valor_spc,
                           sp.spc_quantidade as qtd_spc,
                           v.idvendedora,
                           row_number() over (partition by sp.cpf order by sp.dataconsulta desc) as nr
                           , p.idade
                           , p.cpf
                    from roman.consultaspc sp,
                         catal.vendedoras v,
                         catal.pessoas p
                    where sp.cpf = p.cpf
                    and p.idpessoa = v.idpessoa
                    order by sp.dataconsulta desc) spc
                  , favorita.filiaisfavorita ff
                where cp.idpedido = pd.idpedido
                  and :P481_TIPO = 'R'
                  and (:P481_APROVADO = 'T' or :P481_APROVADO = 'S' )
                  and cp.idcaracteristicapedido = 86
                  and spc.idvendedora = pd.idvendedora
                  and spc.nr = 1
                  and ff.idfilialfavorita = pd.idfilialfavorita
                  and cp.dataclassificado between to_date(:P481_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P481_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                  and (:P481_IDUSUARIO = cp.idusuario or :P481_IDUSUARIO is null)
                  and (:P481_PEDIDOS_BRASIL = 'A' or :P481_PEDIDOS_BRASIL = 'B' and ff.idpais = 1)  
                  
                union all 
                
                -- #4 - traz pedidos NÃO APROVAOS, BRASIL 
                select pd.idpedido Numero_Pedido
                     , 'Não' Aprovado
                     , favorita.pck_util_fav.fnc_nomeusuario(pa.idusuarioatendeu) Usuari
                     , spc.valor_spc
                     , spc.qtd_spc
                     , spc.idade idadespc
                     , ( select count(1)
                         from favorita.pedidos p
                         where p.idvendedora = pd.idvendedora
                           and p.datacancelamento is null) Ciclos
                     , ( select count(1)
                         from favorita.pedidos p
                         where p.idvendedora = pd.idvendedora
                           and p.datacancelamento is null
                           and exists ( select 1 
                                        from favorita.vencimentospedidos vp
                                        where vp.idpedido = p.idpedido
                                          and vp.valorpago >= vp.valorpagar)) Recorrencia
                     , pd.valortotal    
                     , pd.valorapagar
                     , ( select round(avg(pp.valortotal),2) 
                         from favorita.pedidos pp
                         where pp.idvendedora = pd.idvendedora
                           and pp.datacancelamento is null
                           and trunc(pp.dataemissao) > (sysdate - 240)) TicketMedio8Meses
                     , favorita.pck_util_fav.fnc_nomefilialromance(pd.idfilialromance) FilialRomance
                     , favorita.pck_util_fav.fnc_nomefilialfavorita(pd.idfilialfavorita) FilialFavorita
                     , pa.justificativa Motivo
                from favorita.pedidos pd
                   , favorita.protocolosatendimentos pa
                   ,(select sp.spc_valortotal as valor_spc,
                           sp.spc_quantidade as qtd_spc,
                           v.idvendedora,
                           row_number() over (partition by sp.cpf order by sp.dataconsulta desc) as nr
                           , p.idade
                           , p.cpf
                    from roman.consultaspc sp,
                         catal.vendedoras v,
                         catal.pessoas p
                    where sp.cpf = p.cpf
                    and p.idpessoa = v.idpessoa
                    order by sp.dataconsulta desc) spc
                    , favorita.filiaisfavorita ff
                where pd.idpedido = pa.idpedido
                  and (:P481_APROVADO = 'T' or :P481_APROVADO = 'N' )
                  and pd.datacancelamento is not null
                  and pa.idtipoprotocolo = 1
                  and pa.idmotivoprotocolo = 15
                  and spc.idvendedora = pd.idvendedora
                  and spc.nr = 1
                  and ff.idfilialfavorita = pd.idfilialfavorita
                  and (:P481_IDUSUARIO = pa.idusuarioatendeu  or :P481_IDUSUARIO is null)
                  and pa.dataprotocolo between to_date(:P481_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P481_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                  and (:P481_PEDIDOS_BRASIL = 'A' or :P481_PEDIDOS_BRASIL = 'B' and ff.idpais = 1)  
                )
                where :P481_TIPO = 'R'
                group by usuario, Aprovado, FilialRomance, FilialFavorita, Motivo
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
