page 516 (
    name: Cadastro de Precos de Kits de Produtos
    title: Cadastro de Precos de Kits de Produtos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 80%
        height: 50%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-de-preços-de-kitsprodutos (
        name: Cadastro de Preços de KitsProdutos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pk.idprecoitemkitproduto
                     , pk.iditemkitproduto
                     , pk.idedicaorevista
                     , pk.valorvendaoriginal
                     , pk.valorvenda
                     , pk.perccomissaogerente
                     , pk.perccomissaodistribuidor
                     , pk.perccomissaoconsultora
                     , pk.valorcomissaoatendente
                from favorita.PRECOSITENSKITSPRODUTOS pk
                where pk.iditemkitproduto = :P516_IDITEMKITPRODUTO;
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 119697595911230450
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDPRECOITEMKITPRODUTO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDITEMKITPRODUTO
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDEDICAOREVISTA
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @VALORVENDAORIGINAL
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @VALORVENDA
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @PERCCOMISSAOGERENTE
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @PERCCOMISSAODISTRIBUIDOR
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @PERCCOMISSAOCONSULTORA
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @VALORCOMISSAOATENDENTE
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column IDEDICAOREVISTA (
            type: selectList
            heading {
                heading: Edição
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select e.nome showvalue
                         , e.idedicaorevista returnvalue
                    from favorita.edicoesrevistas e
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: IDEDICAOREVISTA
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDITEMKITPRODUTO (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IDITEMKITPRODUTO
                dataType: number
            }
            default {
                type: item
                item: P516_IDITEMKITPRODUTO
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDPRECOITEMKITPRODUTO (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDPRECOITEMKITPRODUTO
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column PERCCOMISSAOCONSULTORA (
            type: numberField
            heading {
                heading: % Consultora
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 100
                columnAlignment: center
            }
            source {
                databaseColumn: PERCCOMISSAOCONSULTORA
                dataType: number
            }
            columnFilter {
                lovType: none
            }
            readOnly {
                type: always
            }
        )

        column PERCCOMISSAODISTRIBUIDOR (
            type: numberField
            heading {
                heading: % Distribuidor
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            source {
                databaseColumn: PERCCOMISSAODISTRIBUIDOR
                dataType: number
            }
            columnFilter {
                lovType: none
            }
            readOnly {
                type: always
            }
        )

        column PERCCOMISSAOGERENTE (
            type: numberField
            heading {
                heading: % Gerente
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                databaseColumn: PERCCOMISSAOGERENTE
                dataType: number
            }
            columnFilter {
                lovType: none
            }
            readOnly {
                type: always
            }
        )

        column VALORCOMISSAOATENDENTE (
            type: numberField
            heading {
                heading: Comissão Atendente
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 110
                columnAlignment: center
            }
            source {
                databaseColumn: VALORCOMISSAOATENDENTE
                dataType: number
            }
            columnFilter {
                lovType: none
            }
            readOnly {
                type: always
            }
        )

        column VALORVENDA (
            type: numberField
            heading {
                heading: Valor Venda
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                databaseColumn: VALORVENDA
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column VALORVENDAORIGINAL (
            type: numberField
            heading {
                heading: Valor Original
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                databaseColumn: VALORVENDAORIGINAL
                dataType: number
            }
            columnFilter {
                lovType: none
            }
            readOnly {
                type: always
            }
        )

    )

    region produto-kit (
        name: Produto Kit
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P516_IDITEMKITPRODUTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @cadastro-de-preços-de-kitsprodutos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P516_IDKITPRODUTO (
        type: selectList
        label {
            label: Kit Produto
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select k.referencia||' - '||k.descricao showvalue 
                     , k.idkitproduto returnvalue
                from favorita.kitsprodutos k
                where k.idkitproduto = :P516_IDKITPRODUTO;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @produto-kit
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P516_IDPRODUTO (
        type: selectList
        label {
            label: Produto
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.referencia||' - '||p.nomeproduto
                     , p.idproduto
                from favorita.produtos p
                where p.idproduto = :P516_IDPRODUTO;
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @produto-kit
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    validation valor-venda-maior-zero (
        name: Valor venda Maior Zero
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @cadastro-de-preços-de-kitsprodutos
            language: sql
            sqlExpression: :VALORVENDA > 0
        }
        error {
            errorMessage: Valor de Venda Precisa ser Maior que zero
        }
    )

    process cadastro-de-preços-de-kitsprodutos-save-interactive-grid-data (
        name: Cadastro de Preços de KitsProdutos - Save Interactive Grid Data
        type: executeCode
        editableRegion: @cadastro-de-preços-de-kitsprodutos
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vmd5              varchar2(4000);
                  vmensagem         varchar2(4000);
                  --
                begin  
                     case :APEX$ROW_STATUS  
                     when 'C' then
                       --
                       favorita.PCK_CADASTROS_FAV.prc_precositenskitsprodutos ( pidprecoitemkitproduto    => :idprecoitemkitproduto
                                                                              , piditemkitproduto         => :iditemkitproduto
                                                                              , pidedicaorevista          => :idedicaorevista
                                                                              , pvalorvendaoriginal       => :valorvendaoriginal
                                                                              , pvalorvenda               => :valorvenda
                                                                              , pperccomissaogerente      => :perccomissaogerente
                                                                              , pperccomissaodistribuidor => :perccomissaodistribuidor
                                                                              , pperccomissaoconsultora   => :perccomissaoconsultora
                                                                              , pvalorcomissaoatendente   => :valorcomissaoatendente
                                                                              , pmensagem                 => vmensagem
                                                                              , pmd5                      => vmd5
                                                                              , poperacao_dml             => 'I' );
                       --
                       apex_util.set_session_state('P515_ALERTA_MENSAGEM', vmensagem);
                       --
                     when 'U' then  
                       --
                       favorita.PCK_CADASTROS_FAV.prc_precositenskitsprodutos ( pidprecoitemkitproduto    => :idprecoitemkitproduto
                                                                              , piditemkitproduto         => :iditemkitproduto
                                                                              , pidedicaorevista          => :idedicaorevista
                                                                              , pvalorvendaoriginal       => :valorvendaoriginal
                                                                              , pvalorvenda               => :valorvenda
                                                                              , pperccomissaogerente      => :perccomissaogerente
                                                                              , pperccomissaodistribuidor => :perccomissaodistribuidor
                                                                              , pperccomissaoconsultora   => :perccomissaoconsultora
                                                                              , pvalorcomissaoatendente   => :valorcomissaoatendente
                                                                              , pmensagem                 => vmensagem
                                                                              , pmd5                      => vmd5
                                                                              , poperacao_dml             => 'U' );
                       --
                       apex_util.set_session_state('P515_ALERTA_MENSAGEM', vmensagem);
                       --
                     when 'D' then  
                       --
                       favorita.PCK_CADASTROS_FAV.prc_precositenskitsprodutos ( pidprecoitemkitproduto    => :idprecoitemkitproduto
                                                                              , piditemkitproduto         => :iditemkitproduto
                                                                              , pidedicaorevista          => :idedicaorevista
                                                                              , pvalorvendaoriginal       => :valorvendaoriginal
                                                                              , pvalorvenda               => :valorvenda
                                                                              , pperccomissaogerente      => :perccomissaogerente
                                                                              , pperccomissaodistribuidor => :perccomissaodistribuidor
                                                                              , pperccomissaoconsultora   => :perccomissaoconsultora
                                                                              , pvalorcomissaoatendente   => :valorcomissaoatendente
                                                                              , pmensagem                 => vmensagem
                                                                              , pmd5                      => vmd5
                                                                              , poperacao_dml             => 'D' );
                       --
                       apex_util.set_session_state('P515_ALERTA_MENSAGEM', vmensagem);
                       --
                     end case;  
                exception
                  when others then
                    apex_util.set_session_state('P515_ALERTA_MENSAGEM', 'Erro ao execultar processo'||DBMS_UTILITY.FORMAT_ERROR_BACKTRACE||' - '||sqlerrm);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 119763754882013314
        }
    )

)

