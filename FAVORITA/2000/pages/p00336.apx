page 336 (
    name: Imprimir Lista Negociadora
    title: Imprimir Lista Negociadora
    appearance {
        pageTemplate: @minimal-pedido
        templateOptions: #DEFAULT#
    }
    security {
        authentication: public
        pageAccessProtection: unrestricted
    }

    region impressão-lista-negociadora (
        name: Impressão Lista Negociadora
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_imprime_fav.prc_imprimenegociacoes(pidusuario => :P336_IDUSUARIO);
                  --
                  delete reimpressoesnegociacoes 
                  where idusuario = :P336_IDUSUARIO;
                  --
                end;
                
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P336_IDUSUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @impressão-lista-negociadora
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

