page 8 (
    name: Cadastro de Produtos e Fornecedores Produtos
    title: Cadastro de Produtos e Fornecedores Produtos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 80%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
        executeWhenPageLoads:
            ```javascript-browser
            window.proximoUrl = $('#PROXIMO').attr('data-link');
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region fornecedores (
        name: Fornecedores
        type: tabform
        source {
            sqlQuery:
                ```sql
                select idfornecedorproduto
                     , idproduto
                     , idfornecedor
                from fornecedoresprodutos
                where idproduto = :P8_IDPRODUTO;
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P8_IDPRODUTO
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: " - Selecione o Fornecedor - "
        }
        pagination {
            type: setPaginationSelectList
        }

        column CHECK$01 (
            reportColumnQueryId: 4
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
        )

        column IDFORNECEDOR (
            reportColumnQueryId: 3
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Fornecedor
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @lov-fornecedores
                nullDisplayValue: "- Selecione o Fornecedor - "
            }
            layout {
                sequence: 4
            }
            appearance {
                width: 150
            }
        )

        column IDFORNECEDORPRODUTO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDFORNECEDORPRODUTO
            }
        )

        column IDPRODUTO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 3
            }
            default {
                type: item
                item: P8_IDPRODUTO
            }
        )

    )

    region novo-produto (
        name: Novo Produto
        type: list
        source {
            list: @novo-produto
