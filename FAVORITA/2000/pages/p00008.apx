    validation produtofornecedor-unique (
        name: PRODUTOFORNECEDOR unique
        execution {
            sequence: 120
        }
        validation {
            editableRegion: @fornecedores
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidproduto number;
                  vidfornecedor number;
                begin
                  select idproduto
                       , idfornecedor
                  into vidproduto
                     , vidfornecedor
                  from fornecedoresprodutos
                  where idproduto = :IDPRODUTO
                  and idfornecedor = :IDFORNECEDOR;
                  --
                  if vidproduto is not null and vidfornecedor is not null then
                    return 'Existe um cadastro no sistema com estas informações. Não são permitidas informações repetidas para este cadastro.';
                  end if;
                  --
                exception
                  when no_data_found then
                    return '';
                end;
                ```
        }
        error {
            associatedColumn: IDFORNECEDOR
        }
        serverSideCondition {
            whenButtonPressed: @inseriratualizar
        }
    )

