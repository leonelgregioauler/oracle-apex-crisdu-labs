    process consulta-produtos (
        name: Consulta Produtos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vdataliberadovenda date;
                begin
                  --
                  favorita.PCK_CADASTROS_FAV.PRC_PRODUTOS( PIDPRODUTO             => :P8_IDPRODUTO
                                                         , PNOMEPRODUTO           => :P8_NOMEPRODUTO
                                                         , PREFERENCIA            => :P8_REFERENCIA
                                                         , PDESCRICAOSITE         => :P8_DESCRICAOSITE
                                                         , PPESO                  => :P8_PESO
                                                         , PALTURA                => :P8_ALTURA
                                                         , PLARGURA               => :P8_LARGURA
                                                         , PPROFUNDIDADE          => :P8_PROFUNDIDADE
                                                         , PIDCATEGORIA           => :P8_IDCATEGORIA
                                                         , PIDCLASSIFICACAOFISCAL => :P8_IDCLASSIFICACAOFISCAL
                                                         , PLIBERARVENDA          => :P8_LIBERARVENDA
                                                         , PSOPESQUISA            => :P8_SOPESQUISA
                                                         , PVALORPONTOS           => :P8_VALOR_PONTOS
                                                         , PIDSUBCATEGORIA        => :P8_IDSUBCATEGORIA
                                                         , PIDPRODUTOROMANCE      => :P8_IDPRODUTOROMANCE
                                                         , PDATALIBERADOVENDA     => vdataliberadovenda
                                                         , PMD5                   => :P8_MD5
                                                         , POPERACAO_DML          => 'S');
                  --
                  begin
                    --
                  select idcategoriasite
                  into :P8_IDCATEGORIASITE
                  from favorita.categorias
                  where idcategoria = :P8_IDCATEGORIA;
                    --
                  exception
                    when others then
                      :P8_IDCATEGORIA := null;
                  end;
                  --
                  :P8_DATALIBERADOVENDA := to_char(vdataliberadovenda,'DD/MM/RRRR');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 766464151006262813
        }
    )

    process criar-referência-fornecedor (
        name: Criar Referência Fornecedor
        type: executeCode
        editableRegion: @fornecedores
        source {
            plsqlCode:
                ```plsql
                -- Created on 05/11/2020 by MAX.BERKEUER 
                declare
                  --
                  vreferenciafornecedor varchar2(100) := null;
                  --
                begin
                  --
                  select f.referencia
                  into vreferenciafornecedor
                  from fornecedores f
                  where f.idfornecedor = :IDFORNECEDOR;
                  --
                  --dbms_output.put_line(vreferenciafornecedor);
                  --
                  if vreferenciafornecedor is not null then
                    --
                    if length(vreferenciafornecedor) = 2 then
                      --
                      :P8_REFERENCIA := to_char(vreferenciafornecedor, 'FM00')||'.'||:P8_REFERENCIA;
                      --dbms_output.put_line('Mascara='||to_char(vreferenciafornecedor, 'FM00'));
                      --
                    elsif length(vreferenciafornecedor) = 3 then
                      --
                      :P8_REFERENCIA := to_char(vreferenciafornecedor, 'FM000')||'.'||:P8_REFERENCIA;
                      --dbms_output.put_line('Mascara='||to_char(vreferenciafornecedor, 'FM000'));
                      --
                    else
                      --
                      apex_error.add_error(p_message          => 'Erro ao compor a referência, entre em contato com o administrador do sistema.',
                                           p_display_location => apex_error.c_inline_with_field_and_notif);
                      --
                    end if;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 766457972824262799
        }
        serverSideCondition {
            whenButtonPressed: @inseriratualizar
            executionScope: allSubmittedRows
            type: expression
            plsqlExpression: instr (:P8_REFERENCIA, '.', 1, 2) = 0
        }
    )

