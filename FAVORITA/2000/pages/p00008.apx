    dynamicAction criar-referência-categoria (
        name: Criar Referência Categoria
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P8_IDCATEGORIA
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                      vreferenciaproduto varchar2(100);
                    begin
                      --
                      select c.referenciacategoria||'.'||to_char(p.referenciaproduto, 'FM0000')
                      into vreferenciaproduto
                        from ( select nvl(cc.referencia, '00') referenciacategoria
                               from categorias cc
                               where cc.idcategoria = :P8_IDCATEGORIA ) c
                           , ( select max(to_number(nvl(substr(substr(pp.referencia, instr(pp.referencia,'.')+1, 10), instr(substr(pp.referencia,instr(pp.referencia,'.')+1, 10), '.')+1, 8),0))+1) referenciaproduto
                               from produtos pp
                               where pp.idcategoria = :P8_IDCATEGORIA ) p;
                       --
                       :P8_REFERENCIA := vreferenciaproduto;
                       --
                    end;
                    ```
                itemsToSubmit: P8_IDCATEGORIA
                itemsToReturn: P8_REFERENCIA
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P8_IDCATEGORIASITE
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.server.process('VERIFICAR_CATEGORIA', {
                        pageItems: '#P8_IDCATEGORIASITE'
                    }, {
                        success: function(data) {
                            if (data.inativa === 'S') {
                                apex.message.clearErrors();
                                apex.message.showErrors([{
                                    type:     'error',
                                    location: ['page', 'inline'],
                                    pageItem: 'P8_IDCATEGORIASITE',
                                    message:  'A categoria selecionada está inativa. Selecione uma categoria ativa.',
                                    unsafe:   false
                                }]);
                                $('#PROXIMO')
                                    .removeAttr('data-link')
                                    .removeAttr('href')
                                    .css({ 'pointer-events': 'none', 'opacity': '0.5' });
                            } else {
                                apex.message.clearErrors();
                                $('#PROXIMO')
                                    .attr('data-link', window.proximoUrl)
                                    .css({ 'pointer-events': '', 'opacity': '' });
                            }
                        }
                    });
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation altura-numérico (
        name: ALTURA numérico
        execution {
            sequence: 70
        }
        validation {
            type: itemIsNumeric
            item: P8_ALTURA
            alwaysExecute: true
        }
        error {
            errorMessage: Altura deve ser numérico.
            associatedItem: @P8_ALTURA
        }
    )

