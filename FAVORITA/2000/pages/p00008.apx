    process operação-dml-em-produtos (
        name: Operação DML em Produtos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                  vdataliberadovenda date := to_date(:P8_DATALIBERADOVENDA,'DD/MM/RRRR');
                begin
                  --
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'INSERIRATUALIZAR' then 
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  favorita.PCK_CADASTROS_FAV.PRC_PRODUTOS( PIDPRODUTO             => :P8_IDPRODUTO
                                                         , PNOMEPRODUTO           => :P8_NOMEPRODUTO
                                                         , PREFERENCIA            => :P8_REFERENCIA
                                                         , PDESCRICAOSITE         => :P8_DESCRICAOSITE
                                                         , PPESO                  => :P8_PESO
                                                         , PALTURA                => :P8_ALTURA
                                                         , PLARGURA               => :P8_LARGURA
                                                         , PPROFUNDIDADE          => :P8_PROFUNDIDADE
                                                         , PIDCATEGORIA           => :P8_IDCATEGORIA
                                                         , PIDCLASSIFICACAOFISCAL => :P8_IDCLASSIFICACAOFISCAL
                                                         , PLIBERARVENDA          => :P8_LIBERARVENDA
                                                         , PSOPESQUISA            => :P8_SOPESQUISA
                                                         , PVALORPONTOS           => :P8_VALOR_PONTOS
                                                         , PIDSUBCATEGORIA        => :P8_IDSUBCATEGORIA
                                                         , PIDPRODUTOROMANCE      => :P8_IDPRODUTOROMANCE
                                                         , PDATALIBERADOVENDA   => vdataliberadovenda
                                                         , PMD5                   => :P8_MD5
                                                         , POPERACAO_DML          => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 766465393375262813
        }
    )

    process verificar-categoria (
        name: VERIFICAR_CATEGORIA
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_count NUMBER;
                BEGIN
                    SELECT COUNT(*) INTO l_count
                      FROM favorita.categoriassite c
                     WHERE c.idcategoriasite = :P8_IDCATEGORIASITE
                       AND c.ativo <> 'S';
                
                    APEX_JSON.OPEN_OBJECT;
                    APEX_JSON.WRITE('inativa', CASE WHEN l_count > 0 THEN 'S' ELSE 'N' END);
                    APEX_JSON.CLOSE_OBJECT;
                END;
                
                ```
        }
        execution {
            sequence: 60
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 964211215508235316
        }
        serverSideCondition {
            whenButtonPressed: @proximo
        }
    )

