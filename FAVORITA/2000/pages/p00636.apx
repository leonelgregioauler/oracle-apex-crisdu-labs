page 636 (
    name: Anexos Entradas
    title: Anexos Entradas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 70%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function fnc_verimg(pid)
            {
              window.open('http://anexos.romancemoda.com.br/'+pid);
              void(0);
            }
            
            function fnc_removeanexo(pidanexo,pnomeanexo)
            {
                apex.confirm("Deseja realmente remover o anexo "+pnomeanexo+"?", {
              request:"DELETAR",
              set:{"P636_IDANEXODELETAR":pidanexo}
              });
            }
            ```
    }

    region anexos-despesas (
        name: Anexos Despesas
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    region arquivos-anexados (
        name: Arquivos Anexados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomearquivo
                  --   , '<a href="javascript: fnc_verimg('''||identrada||idanexoentrada||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10)||''');">Ver arquivo</a>' link
                     --, identrada||idanexoentrada||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10) id
                    -- , t.identrada||t.idanexoentrada||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10) link
                     , roman.pck_bucket.sp_abre_anexo(url_bucket) preview
                     , dataanexo
                     , ( select roman.pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario ) usuario 
                     , '<a href="javascript: fnc_removeanexo('||idanexoentrada||','''||t.nomearquivo||''');">Remover</a>' remover
                from roman.anexosentradas t
                where identrada = :P636_IDENTRADA
                order by t.dataanexo
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 3288461836296647375
        }

        column DATAANEXO (
            type: plainText
            heading {
                heading: Data Anexo
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column NOMEARQUIVO (
            type: plainText
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column PREVIEW (
            type: plainText
            heading {
                heading: Anexo
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
            security {
                escapeSpecialChars: false
            }
        )

        column REMOVER (
            type: plainText
            heading {
                heading: Remover
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
            security {
                escapeSpecialChars: false
            }
        )

        column USUARIO (
            type: plainText
            heading {
                heading: Usuário
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 24358076 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAANEXO (
                sequence: 2
            )

            displayColumn NOMEARQUIVO (
                sequence: 1
            )

            displayColumn PREVIEW (
                sequence: 3
            )

            displayColumn REMOVER (
                sequence: 5
            )

            displayColumn USUARIO (
                sequence: 4
            )

        )

    )

    pageItem P636_ARQUIVOTEMP (
        type: fileUpload
        label {
            label: Arquivo
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
            displayDownloadLink: false
        }
        storage {
            filenameColumn: NOMEARQUIVO
        }
        layout {
            sequence: 40
            region: @anexos-despesas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: ARQUIVOTEMP
            used: always
        }
    )

    pageItem P636_DATAANEXO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @anexos-despesas
            slot: regionBody
        }
        appearance {
            formatMask: DD/MM/RRRR HH24:MI:SS
        }
        source {
            type: databaseColumn
            databaseColumn: DATAANEXO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  return to_date(sysdate,'dd/mm/rrrr hh24:mi:ss');
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P636_IDANEXODELETAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @anexos-despesas
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P636_IDANEXOENTRADA (
        type: hidden
        layout {
            sequence: 10
            region: @anexos-despesas
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDANEXOENTRADA
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P636_IDENTRADA (
        type: numberField
        label {
            label: ID Entrada
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 20
            region: @anexos-despesas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 32
        }
        source {
            type: databaseColumn
            databaseColumn: IDENTRADA
            used: always
        }
        readOnly {
            type: always
        }
        security {
