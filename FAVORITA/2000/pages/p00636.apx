            valueProtected: false
        }
        layout {
            sequence: 70
            region: @anexos-despesas
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDUSUARIO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidusuario number;
                begin
                  --
                  vidusuario := :P0_IDUSUARIO;
                  --
                  return vidusuario;
                  --
                end;
                  
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P636_NOMEARQUIVO (
        type: hidden
