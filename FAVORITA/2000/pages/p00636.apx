            valueProtected: false
        }
        layout {
            sequence: 30
            region: @anexos-despesas
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: NOMEARQUIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P636_PAGINA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 100
            region: @anexos-despesas
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Anexar este arquivo!
        layout {
            sequence: 90
            region: @anexos-despesas
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P636_IDANEXOENTRADA
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: "Voltar                    "
        layout {
            sequence: 50
            region: @anexos-despesas
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                t-Button--warning
                t-Button--iconRight
            ]
            icon: fa-filter
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 635
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation p636-arquivotemp (
        name: P636_ARQUIVOTEMP
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P636_ARQUIVOTEMP
        }
        error {
            errorMessage: Escolha um arquivo!
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('CREATE','UPDATE')
        }
    )

    process anexar (
        name: Anexar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  commit;
                  -- Call the procedure
                  roman.pck_anexos.blob_to_file_entradas(pidentrada => :P636_IDENTRADA
                                                        ,pidanexo => :P636_IDANEXOENTRADA);
                  commit;
                  --
                  --:P636_IDANEXOENTRADA := null;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 2435812774568057862
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process deletar (
        name: Deletar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  :P636_IDANEXOENTRADA := null;
                  roman.pck_anexos.prc_apagaanexo_entradas(pidanexoentrada => :P636_IDANEXODELETAR);
                end;
                
                ```
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Anexo deletado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 2435813196248057862
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    process fetch-row-from-anexosentradas (
        name: Fetch Row from ANEXOSENTRADAS
        type: autoRowFetch
        source {
            tableOwner: ROMAN
            tableName: ANEXOSENTRADAS
            pkColumn: IDANEXOENTRADA
            pkItem: P636_IDANEXOENTRADA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 2435813502869057862
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P636_IDANEXOENTRADA is null then
                        select "ROMAN"."SEQ_IDANEXOENTRADA".nextval
                          into :P636_IDANEXOENTRADA
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 2435813973463057861
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-anexosentradas (
        name: Process Row of ANEXOSENTRADAS
        type: autoRowProcessing
        target {
            tableOwner: ROMAN
            tableName: ANEXOSENTRADAS
            pkColumn: IDANEXOENTRADA
            pkItem: P636_IDANEXOENTRADA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Arquivo Anexado
        }
        advanced {
            executionMappingIdentifier: 2435814328155057861
        }
    )

    branch (
        name: Go to 636 Create
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 636
                items: {
                    P636_IDENTRADA: &P636_IDENTRADA.
                }
                clearCache: 636
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    branch (
        name: Go to 636 Delete
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 636
                items: {
                    P636_IDENTRADA: &P636_IDENTRADA.
                }
                clearCache: 636
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

)

