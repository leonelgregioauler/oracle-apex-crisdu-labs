page 450 (
    name: Impressão de Notas Fiscais
    title: Impressão de Notas Fiscais
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region new (
        name: New
        type: staticContent
        source {
            htmlCode: Selecione os filtros para gerar a impressão das DANFEs
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P450_IDCOMPRATRANSFERENCIA (
        type: popupLov
        label {
            label: Remessa
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.desctipo||' '||c.numero||' - NF: '||c.notafiscal||' - Situação: '||c.situacao display_value
                     , c.idcompratransferencia return_value
                from vw_comprastransferencias_fav c
                where c.ididioma = 1
                  and c.idtipocomptransrem in (3) 
                  and ( c.idfilialfavoritadestino = pck_util_fav.fnc_retornaidfilialfavusuario(:P0_IDUSUARIO)
                       or c.idfilialromancedestino = ( select idfilial
                                                       from gerentes
                                                       where idgerente = ( select idgerente
                                                                           from usuarios
                                                                           where idusuario = :P0_IDUSUARIO ) ) 
                  and exists ( select 1
                               from pedidosremessasct pr
                                  , pedidos p
                               where pr.idpedido = p.idpedido
                               and pr.idcompratransferencia = c.idcompratransferencia
                               and p.idrepresentante = :P450_IDREPRESENTANTE ) )
                order by c.idcompratransferencia desc
                ```
        }
        cascadingLov {
            parentItems: [
                P450_IDREPRESENTANTE
                P0_IDUSUARIO
            ]
            itemsToSubmit: [
                P450_IDREPRESENTANTE
                P0_IDUSUARIO
            ]
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P450_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(idrepresentante) display_value
                     , idrepresentante return_value
                from representantes r
                where r.idgerente = ( select idgerente
                                      from usuarios u
                                      where u.idusuario = :P0_IDUSUARIO )
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Todos -
        }
        cascadingLov {
            parentItems: P0_IDUSUARIO
            itemsToSubmit: P0_IDUSUARIO
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    button imprimir (
        buttonName: IMPRIMIR
        label: Imprimir
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation distribuidor-obrigatório (
        name: Distribuidor obrigatório
        execution {
            sequence: 10
        }
        validation {
            language: sql
            sqlExpression: :P450_IDREPRESENTANTE is not null
        }
        error {
            errorMessage: Informe o distribuidor
            associatedItem: @P450_IDREPRESENTANTE
        }
    )

    validation remessa-obrigatória (
        name: Remessa Obrigatória
        execution {
            sequence: 20
        }
        validation {
            language: sql
            sqlExpression: :P450_IDCOMPRATRANSFERENCIA is not null
        }
        error {
            errorMessage: Informe a remessa
            associatedItem: @P450_IDCOMPRATRANSFERENCIA
        }
    )

    branch (
        name: Go To Page 451
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 451
                items: {
                    P451_IDREPRESENTANTE: &P450_IDREPRESENTANTE.
                    P451_IDCOMPRATRANSFERENCIA: &P450_IDCOMPRATRANSFERENCIA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @imprimir
        }
    )

)

