    dynamicAction sel-fav (
        name: Sel_Fav
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P572_FILTRARFAVORITA
        }
        clientSideCondition {
            type: item=value
            item: P572_FILTRARFAVORITA
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: button
                button: @filiaisfavorita
            }
            execution {
                sequence: 10
