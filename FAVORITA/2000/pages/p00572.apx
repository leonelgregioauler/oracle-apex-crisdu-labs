    region pedidos-e-notas-caract (
        name: Pedidos e Notas Caract. 91
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                
                  p_where  varchar2(32767);
                  p_where2 varchar2(32767);
                  p_where3 varchar2(32767);
                  
                begin
                
                  if :P572_TIPODATA = 'V' and :P572_DATAINI IS NOT NULL THEN
                     p_where := ' AND ' || 'trunc(vp.datavencimento) between '|| '''' || v('P572_DATAINI')  ||'''' ||
                                ' AND ' || '''' || v('P572_DATAFIM') ||'''' ;
                  end if;
                  --
                  if :P572_TIPODATA = 'E' and :P572_DATAINI IS NOT NULL THEN
                     p_where := ' AND ' || 'trunc(pe.dataemissao) between '|| '''' || v('P572_DATAINI') ||'''' ||
                                ' AND ' || '''' || v('P572_DATAFIM') ||'''' ;
                  end if;
                  --
                  if :P572_TIPODATA = 'N' and :P572_DATAINI IS NOT NULL THEN
                     p_where := ' AND ' || 'trunc(cf.dataclassificado) between '|| '''' || v('P572_DATAINI') ||'''' ||
                                ' AND ' || '''' || v('P572_DATAFIM') ||'''' ;
                  end if;
                  --
                  if :P572_CIDADE IS NOT NULL  THEN
                     p_where := p_where || ' AND ' || 'ps.idcidade = '|| v('P572_CIDADE') ;
                  end if;
                  --
                  if :P572_IDREPRES IS NOT NULL  THEN
                     p_where := p_where || ' AND ' || 'pe.idrepresentante = '|| v('P572_IDREPRES');
                  end if;
                  --
                  if :P572_IDVENDEDORA IS NOT NULL  THEN
                     p_where := p_where || ' AND ' || 'pe.idvendedora = '|| v('P572_IDVENDEDORA');
                  end if;
                  --
                  if :P572_FILTRARFAVORITA != 'T' THEN
                     p_where := p_where || ' AND ' || 'pe.idfilialfavorita in ( select IDFILIALFAVORITA
                                                                                  from FILTROSFILIAIS
                                                                                 where idusuario = '|| v('P0_IDUSUARIO') ||' ) ' ;
                  end if;
                  --
                  if :P572_FILTRARROMANCE != 'T' THEN
                     p_where := p_where || ' AND ' || 'pe.idfilialromance in ( select IDFILIALROMANCE
                                                                                 from FILTROSEMPRESASROMANCE
                                                                                where idusuario = '|| v('P0_IDUSUARIO') ||' ) ' ;
                  end if;
                
                  p_where2 := 'select pe.dataemissao, pe.idpedido, ve.idvendedora, ps.nomepessoa, ps.cpf, 
                                      vp.situacaovencimento, vp.valorpagar, vp.datavencimento, pe.idrepresentante,
                                      pe.idfilialromance, pe.idfilialfavorita, cf.dataclassificado "Emissão NF", 
                                      nvl(cf.observacao,''NF AINDA NAO ATUALIZADA'') "Chave NF",
                                      cf.idvalorcaracteristica "Nota Fiscal",
                                      pe.idempresavirtualage "Emp.VA",
                                      --
                                      case 
                                        when (nvl(vp.valorpagar,0) - nvl(( select sum(nvl(p.valorpago, 0))
                                                                             from pagamentospedidos p
                                                                            where p.idvencimentopedido = vp.idvencimentopedido
                                                                              and p.idsituacao = 20 ), 0) ) > 0 and
                                              trunc(sysdate) > trunc(vp.datavencimento) then 
                                              --
                                              
                                              pck_util_fav.fnc_calculajuros(pidpedido           => pe.idpedido,
                                                                            pvalororiginal      => (nvl(vp.valorpagar,0) - nvl(( select sum(nvl(p.valorpago, 0))
                                                                                                                                   from pagamentospedidos p
                                                                                                                                  where p.idvencimentopedido = vp.idvencimentopedido
                                                                                                                                    and p.idsituacao = 20 ), 0) )  ,
                                                                            pdatavencimentoorig => vp.datavencimento,
                                                                            pdatavencimentonovo => trunc(sysdate),
                                                                            ppercmulta          => 2,
                                                                            ppercjuros          => 1)
                                        --
                                        when (nvl(vp.valorpagar,0) - nvl(( select sum(nvl(p.valorpago, 0))
                                                                             from pagamentospedidos p
                                                                            where p.idvencimentopedido = vp.idvencimentopedido
                                                                              and p.idsituacao = 20 ), 0) ) > 0 and 
                                             trunc(sysdate) > vp.datavencimento then  
                                             --
                                             pck_util_fav.fnc_calculajuros (pidpedido           => pe.idpedido,
                                                                            pvalororiginal      =>  (nvl(vp.valorpagar,0) - nvl(( select sum(nvl(p.valorpago, 0))
                                                                                                                                  from pagamentospedidos p
                                                                                                                                 where p.idvencimentopedido = vp.idvencimentopedido
                                                                                                                                   and p.idsituacao = 20 ), 0) ),
                                                                           pdatavencimentoorig => vp.datavencimento,
                                                                           pdatavencimentonovo => trunc(sysdate) ,
                                                                           ppercmulta          => 2,
                                                                           ppercjuros          => 1)         
                                      else 
                                          nvl(vp.valorpagar,0) - nvl( (select sum(nvl(p.valorpago, 0))
                                                                          from pagamentospedidos p
                                                                         where p.idvencimentopedido = vp.idvencimentopedido
                                                                           and p.idsituacao = 20 ), 0) 
                                      end valoratualizado , ';
                                      --
                  p_where3 :=  'case
                                         when pe.idsituacaocobranca = 600 then
                                              vp.situacaovencimento||'' (Incobrável)''
                                         when vp.datavencimento >= trunc(sysdate) and 
                                              --vp.saldo = 0 then
                                              (nvl(vp.valorpagar,0) - nvl(( select sum(nvl(p.valorpago, 0))
                                                                             from pagamentospedidos p
                                                                            where p.idvencimentopedido = vp.idvencimentopedido
                                                                              and p.idsituacao = 20 ), 0) ) = 0 then
                                              vp.situacaovencimento||'' (Quitado)''
                                         --
                                         when vp.datavencimento >= trunc(sysdate) then
                                              vp.situacaovencimento||'' (Aberto)''
                                         when vp.datavencimento < trunc(sysdate) and 
                                              --vp.saldo > 0 then
                                              (nvl(vp.valorpagar,0) - nvl(( select sum(nvl(valorpago, 0))
                                                                             from pagamentospedidos 
                                                                            where idvencimentopedido = vp.idvencimentopedido
                                                                              and idsituacao = 20 ), 0) ) > 0 then
                                              vp.situacaovencimento||'' (Vencido)''
                                              --
                                         when vp.datavencimento < trunc(sysdate) and
                                              --and vp.saldo = 0 then
                                              (nvl(vp.valorpagar,0) - nvl(( select sum(nvl(valorpago, 0))
                                                                             from pagamentospedidos 
                                                                            where idvencimentopedido = vp.idvencimentopedido
                                                                              and idsituacao = 20 ), 0) ) = 0 then
                                              vp.situacaovencimento||'' (Quitado)''
                                       end situacaodovencimento 
                                 from pedidos    pe
                                    , vendedoras ve
                                    , pessoas    ps
                                    , vencimentospedidos    vp
                                    , (select idpedido, dataclassificado, observacao, idvalorcaracteristica 
                                         from classificacoespedidos
                                        where idcaracteristicapedido = 91) cf
                                where pe.idvendedora = ve.idvendedora
                                  and ve.idpessoa    = ps.idpessoa
                                  and pe.idpedido    = vp.idpedido
                                  and vp.situacaovencimento = ''V''  
                                  and pe.idpedido = cf.idpedido(+)
                                  and :P572_GERAR = 1 '||
                                  CHR(10) ;
                
                  --return p_where2 || CHR(10) || p_where3 || CHR(10) || p_where; 
                  return p_where2 || chr(10) || p_where3 || chr(10) || nvl(p_where, '');
                
                
                end;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
