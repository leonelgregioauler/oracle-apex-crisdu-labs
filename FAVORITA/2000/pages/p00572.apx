    pageItem P572_IDVENDEDORA (
        type: selectList
        label {
            label: Cliente
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)  display_value
                     , v.idvendedora          return_value
                from catal.vendedoras v
                   , catal.pessoas    p
                where v.idpessoa = p.idpessoa
                  and v.ativo    = 'S'
                  and v.idrepresentante = :P572_IDREPRES
                order by 1
                
                ```
            displayExtraValues: false
            nullDisplayValue: " - Todos -"
        }
        cascadingLov {
            parentItems: P572_IDREPRES
            itemsToSubmit: P572_IDREPRES
        }
        layout {
