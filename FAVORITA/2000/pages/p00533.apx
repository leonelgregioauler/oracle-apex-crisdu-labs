            formatMask: DD/MM/RRRR
            width: 10
        }
        validation {
            valueRequired: true
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                BEGIN
                  RETURN trunc(sysdate);
                end;
                ```
