    branch (
        name: Filtrar pedidos
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 533
                items: {
                    P533_DE: &P533_DE.
                    P533_ATE: &P533_ATE.
                    P533_IDFILIALFAVORITA: &P533_IDFILIALFAVORITA.
                    P533_ORIGEMPEDIDO: &P533_ORIGEMPEDIDO.
