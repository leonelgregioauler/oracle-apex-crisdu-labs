page 533 (
    name: Grafico de Pedidos por Hora Loja
    title: Grafico de Pedidos por Hora Loja
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function doLoad()
            {
            setTimeout( "submit()", 60*1000 );
            }
            
            function submit()
            {
              apex.submit('SUBMIT');
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region gráfico-de-pedidos-por-hora (
        name: Gráfico de Pedidos por Hora
        type: chart
        source {
            pageItemsToSubmit: [
                P533_DE
                P533_ATE
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: lineWithArea
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            cursor: false
        }
        animation {
            onDataChange: slideToLeft
        }
        legend {
            position: top
            hideAndShowBehavior: none
        }

        series quantidade-de-pedidos (
            name: Quantidade de Pedidos
            execution {
                sequence: 20
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select h.hora
                         , o.nome          nome
                         , o.quantidade    quantidade
                         , o.valorotal     valorotal                 
                         , o.mediavalorotal         mediavalorotal
                    from roman.horas h
                       , (  select 'Quantidade' nome
                                 , to_number(to_char(p.dataemissao,'HH24')) hora
                                 , count(1) quantidade
                                 , sum(p.valorapagar*p.fatorconversao) valorotal 
                                 , avg(p.valorapagar*p.fatorconversao) mediavalorotal 
                            from vw_pedidos_fav p
                            where dataemissao between to_date(:P533_DE||' 00:00:00' ,'dd/mm/rrrr hh24:mi:ss' ) and to_date(:P533_ATE||' 23:59:59' ,'dd/mm/rrrr hh24:mi:ss')
                              and ( p.idfilialfavorita = :P533_IDFILIALFAVORITA or :P533_IDFILIALFAVORITA is null)
                              and p.idsituacaoentrega  >= 20000
                              and p.tipopedido = 'P' 
                              and exists (select 1
                                          from favorita.filiaisfavorita f
                                          where f.idfilialfavorita = p.idfilialfavorita
                                            and f.tipofilial = 'L') 
                              and ( :P533_ORIGEMPEDIDO is null
                                 or :P533_ORIGEMPEDIDO = 'C' and not exists ( select 1
                                                                              from favorita.classificacoespedidos cp
                                                                              where cp.idcaracteristicapedido  = 2
                                                                                and cp.idpedido = p.idpedido ) 
                                 or :P533_ORIGEMPEDIDO = 'D' and exists ( select 1
                                                                          from favorita.classificacoespedidos cp
                                                                          where cp.idcaracteristicapedido  = 2
                                                                            and cp.idpedido = p.idpedido )) 
                            group by  to_number(to_char(p.dataemissao,'HH24')) ) o
                    where h.hora  = o.hora(+)
                    order by 1
                    ```
                pageItemsToSubmit: [
                    P533_DE
                    P533_ATE
                ]
            }
            columnMapping {
                label: HORA
                value: QUANTIDADE
                customColumn: NOME
            }
            appearance {
                color: #2B61CC
            }
            marker {
                show: true
                shape: circle
            }
            label {
                show: true
            }
        )

        axis x (
            name: x
            title: Hora
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Pedidos
            value {
                format: decimal
            }
            minorTicks {
                show: false
            }
        )

    )

    region pedidos-por-hora (
        name: "Pedidos por Hora "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select *
                from (
                select h.hora
                     , o.nome nome
                     , o.quantidade quantidade
                     , o.valorotal  valorotal                 
                     , o.mediavalorotal mediavalorotal
                from roman.horas h
                   , (  select p.filialfavorita nome
                             , to_number(to_char(p.dataemissao,'HH24')) hora
                             , count(1) quantidade
                             , sum(p.valorapagar*p.fatorconversao) valorotal 
                             , avg(p.valorapagar*p.fatorconversao) mediavalorotal 
                        from vw_pedidos_fav p
                        where dataemissao between to_date(:P533_DE||' 00:00:00' ,'dd/mm/rrrr hh24:mi:ss' ) and to_date(:P533_ATE||' 23:59:59' ,'dd/mm/rrrr hh24:mi:ss')
                          and ( p.idfilialfavorita = :P533_IDFILIALFAVORITA or :P533_IDFILIALFAVORITA is null)
                          and p.idsituacaoentrega  >= 20000
                          and p.tipopedido = 'P'
                          and exists (select 1
                                      from favorita.filiaisfavorita f
                                      where f.idfilialfavorita = p.idfilialfavorita
                                        and f.tipofilial = 'L') 
                          and ( :P533_ORIGEMPEDIDO is null
                             or :P533_ORIGEMPEDIDO = 'C' and not exists ( select 1
                                                                          from favorita.classificacoespedidos cp
                                                                          where cp.idcaracteristicapedido  = 2
                                                                            and cp.idpedido = p.idpedido ) 
                             or :P533_ORIGEMPEDIDO = 'D' and exists ( select 1
                                                                      from favorita.classificacoespedidos cp
                                                                      where cp.idcaracteristicapedido  = 2
                                                                        and cp.idpedido = p.idpedido )) 
                        group by  to_number(to_char(p.dataemissao,'HH24')), p.filialfavorita ) o
                where h.hora  = o.hora(+)
                order by 1
                    )
                where quantidade > 0
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 30582312063601039
        }

