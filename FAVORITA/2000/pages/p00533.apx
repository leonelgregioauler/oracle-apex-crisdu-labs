    pageItem P533_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Filial Favorita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct favorita.pck_util_fav.fnc_nomefilialfavorita(u.idfilialfavorita) showvalue
                     , u.idfilialfavorita returnvalue
                from favorita.usuariosfiliaisfavorita u
                where ( u.idfilialfavorita = :P0_idfilialfavorita 
                      or :P0_idusuario = u.idusuario)
                  and exists ( select 1
                               from favorita.filiaisfavorita f
                               where f.idfilialfavorita = u.idfilialfavorita
                                 and f.tipofilial = 'L')
                
                ```
            displayExtraValues: false
            nullDisplayValue: "- Todas - "
        }
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        source {
            type: staticValue
            staticValue: 0
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P533_ORIGEMPEDIDO (
        type: radioGroup
