    region integração-para-faturamento-paraguay-2 (
        name: Integração para Faturamento Paraguay
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.*
                     , (Select favorita.pck_util_fav.fnc_nomefilialfavorita(p.idfilialfavorita) 
                        from favorita.pedidos p
                        where p.idpedido = f.idpedido) FilialFavorita
                  from vw_faturamentopedidospry_fav f
                  where ( idfilialromance = :P345_IDFILIALROMANCE )
                   and  ( :P345_IDCOMPRATRANSFERENCIA is null or idcompratransferencia = :P345_IDCOMPRATRANSFERENCIA )
                   and tipo = 'R'
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P345_TIPO = 'R'
        }
        componentAppearance {
            showNullValuesAs: -
        }
        messages {
            whenNoDataFound: Este pedido não possui itens.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 1585363319442554703
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDCOMPRATRANSFERENCIA
                layout {
                    show: false
                    sequence: 5
                }
            )

