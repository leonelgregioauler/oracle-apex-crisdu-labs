page 345 (
    name: Integração para Faturamento Paraguay
    title: Integração para Faturamento Paraguay
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    htmlHeader {
        htmlHeader:
            ```html
            <style>
                .u-tE {
                  font-weight: bold;    
                }
                
                .u-tC {
                   font-weight: bold;
                   font-size: large;
                   color: red;
                }
                
                .a-GV-cell {
                  border-color: #b39d9d !important;
                }
                
                .possuicomissao, .cargamais {
                  font-weight: normal;
                  font-size: inherit;
                }
                
            
            </style>
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region integração-para-faturamento-paraguay (
        name: Integração para Faturamento Paraguay
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.*
                     , (Select favorita.pck_util_fav.fnc_nomefilialfavorita(p.idfilialfavorita) 
                        from favorita.pedidos p
                        where p.idpedido = f.idpedido) FilialFavorita
                  from vw_faturamentopedidospry_fav f
                  where ( idfilialromance = :P345_IDFILIALROMANCE )
                   and  ( idrepresentante = :P345_IDREPRESENTANTE )
                   and  ( idsemana        = :P345_SEMANA )
                   and  ( :P345_IDPEDIDO is null or idpedido = :P345_IDPEDIDO )
                   and tipo = 'P'
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P345_TIPO = 'P'
        }
        componentAppearance {
            showNullValuesAs: -
        }
        messages {
            whenNoDataFound: Este pedido não possui itens.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 1456936623327704806
        }

