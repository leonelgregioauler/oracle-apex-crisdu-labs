    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P345_IDCOMPRATRANSFERENCIA (
        type: popupLov
        label {
            label: Repasse
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Numero: '||c.numero||
                       ' - Origem: '||pck_util_fav.fnc_nomefilialfavorita(c.idfilialfavoritaorigem)||
                       ' - Situação: '||c.situacao    as d
                     , c.idcompratransferencia        as r
                from vw_comprastransferencias_fav c
                where c.idfilialromancedestino = :P345_IDFILIALROMANCE
                and c.ididioma = :P0_IDIDIOMA;
                ```
        }
        cascadingLov {
            parentItems: P345_IDFILIALROMANCE
        }
        layout {
            sequence: 60
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P345_IDFILIALROMANCE (
        type: popupLov
        label {
            label: Filial Romance
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome as d,
                       idfilial as r
                  from roman.vw_filiais
                 where ididioma = 4 
                 and ativo = 'S'
                 order by 1
                ```
            nullDisplayValue: "- Selecione a Filial - "
        }
        layout {
            sequence: 20
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P345_IDPEDIDO (
        type: textField
        label {
            label: Pedido
            alignment: left
        }
        layout {
            sequence: 50
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P345_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select /*+ rule*/ roman.pck_romance.fnc_nomerepresentante(r.idrepresentante)
                                 ||' - '||p.cpf 
                                 ||' - '|| roman.pck_romance.fnc_nomefilial(roman.pck_romance.fnc_filialgerente(r.idgerente)) display_value
                     , r.idrepresentante return_value
                from catal.representantes r
                   , catal.pessoas p
                where p.idpessoa = r.idpessoa
                and r.idgerente = ( select idgerente
                                    from roman.vw_filiais
                                    where ididioma = 4
                                    and idfilial = :P345_IDFILIALROMANCE ) 
                and exists ( select 1
                             from pedidos p
                             where p.idrepresentante = r.idrepresentante )                    
                ```
            nullDisplayValue: - Selecione o Distribuidor -
        }
        cascadingLov {
            parentItems: P345_IDFILIALROMANCE
        }
        layout {
            sequence: 30
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P345_SEMANA (
        type: popupLov
        label {
            label: Semana
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct 
                       semana||'/'||ano as d
                     , idsemana as r
                from semana_dias s
                   , pedidos p
                where s.idsemana = p.idsemanaemissao
                and p.idrepresentante = :P345_IDREPRESENTANTE
                ```
            nullDisplayValue: - Selecione a Semana -
        }
        cascadingLov {
            parentItems: P345_IDREPRESENTANTE
        }
        layout {
            sequence: 40
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P345_TIPO (
        type: radioGroup
        label {
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Pedidos;P,Repasse;R,Remessas;C
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        default {
            type: static
            staticValue: P
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 70
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
            icon: fa-filter
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction limpar-campos-ao-selecionar-distribuidor (
        name: Limpar Campos ao selecionar Distribuidor
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P345_IDREPRESENTANTE
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: items
                items: [
                    P345_SEMANA
                    P345_IDPEDIDO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction limpar-campos-ao-selecionar-filial (
        name: Limpar Campos ao selecionar Filial
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P345_IDFILIALROMANCE
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: items
                items: [
                    P345_IDREPRESENTANTE
                    P345_SEMANA
                    P345_IDPEDIDO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction limpar-campos-ao-selecionar-semana (
        name: Limpar Campos ao selecionar Semana
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P345_SEMANA
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: items
                items: P345_IDPEDIDO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction tipo-pedidos-remessas (
        name: Tipo Pedidos / Remessas
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P345_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P345_TIPO
            value: P
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P345_IDCOMPRATRANSFERENCIA
            }
            execution {
                sequence: 20
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P345_IDREPRESENTANTE
                    P345_SEMANA
                    P345_IDPEDIDO
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P345_IDREPRESENTANTE
                    P345_SEMANA
                    P345_IDPEDIDO
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P345_IDCOMPRATRANSFERENCIA
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

    )

    validation distribuidor-obrigatório (
        name: Distribuidor obrigatório
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P345_IDREPRESENTANTE
        }
        error {
            errorMessage: Distribuidor deve ser informado.
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P345_TIPO = 'P'
        }
    )

    validation filial-romance-obrigatória (
        name: Filial Romance obrigatória
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P345_IDFILIALROMANCE
        }
        error {
            errorMessage: Filial Romance deve ser informada.
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P345_TIPO = 'P'
        }
    )

    validation semana-obrigatória (
        name: Semana obrigatória
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P345_SEMANA
        }
        error {
            errorMessage: Semana deve ser informada.
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P345_TIPO = 'P'
        }
    )

)

