page 513 (
    name: Historico Itens Compra/Transf
    title: Historico Itens Compra/Transf
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region histórico-itens-compra-transf (
        name: Histórico Itens Compra/Transf
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ic.idlog,
                       ic.usuarioalteracao,
                       case 
                         when ic.tipoalteracao = 'INSERT' then
                           'Criado'
                         when ic.tipoalteracao = 'UPDATE' then
                           'Atualizado'
                         when ic.tipoalteracao = 'DELETE' then
                           'Excluido'
                         end tipoalteracao,
                       ic.dataalteracao,
                       favorita.pck_util_fav.fnc_nomeprodutodetalhado(ic.idprodutodetalhado,1) nome,
                       ic.valorcusto,
                       ic.quantidadecomprada,
                       ic.quantidaderecebida,
                       ic.quantidadeavariada,
                       ic.observacao,
                       ic.observacaoavaria,
                       ic.quantidadedevolvida,
                       ic.quantidaderecebidaadicional
                from logfavorita.log_itenscomprastransferen ic
                where ic.idcompratransferencia = :P513_IDCOMPRATRANSFER
                  and ic.quantidadecomprada > 0
                  and ( :P513_IDPRODUTODETALHADO is null or :P513_IDPRODUTODETALHADO = ic.idprodutodetalhado) 
                order by 1 desc;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 5825871353187197537
        }

        column DATAALTERACAO (
            type: plainText
            heading {
                heading: Data Alteração
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: dd/mm/rrrr hh24:mi:ss
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        column IDLOG (
            type: hidden
            heading {
                heading: Idlog
            }
            layout {
                sequence: 10
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NOME (
            type: plainText
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column OBSERVACAO (
            type: plainText
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 100
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: J
            }
        )

        column OBSERVACAOAVARIA (
            type: plainText
            heading {
                heading: Observação Avaria
                alignment: center
            }
            layout {
                sequence: 110
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: K
            }
        )

        column QUANTIDADEAVARIADA (
            type: plainText
            heading {
                heading: Quantidade Avariada
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: I
            }
        )

        column QUANTIDADECOMPRADA (
            type: plainText
            heading {
                heading: Quantidade Comprada
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column QUANTIDADEDEVOLVIDA (
            type: plainText
            heading {
                heading: Quantidade Devolvida
                alignment: center
            }
            layout {
                sequence: 120
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: L
            }
        )

        column QUANTIDADERECEBIDA (
            type: plainText
            heading {
                heading: Quantidade Recebida
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column QUANTIDADERECEBIDAADICIONAL (
            type: plainText
            heading {
                heading: Quantidade Recebida Adicional
                alignment: center
            }
            layout {
                sequence: 130
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: M
            }
        )

        column TIPOALTERACAO (
            type: plainText
            heading {
                heading: Tipo Alteração
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column USUARIOALTERACAO (
            type: plainText
            heading {
                heading: Usuario Alterou
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column VALORCUSTO (
            type: plainText
            heading {
                heading: Valor Custo
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 58853523 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAALTERACAO (
                sequence: 4
            )

            displayColumn IDLOG (
                sequence: 1
            )

            displayColumn NOME (
                sequence: 5
            )

            displayColumn OBSERVACAO (
                sequence: 10
            )

            displayColumn OBSERVACAOAVARIA (
                sequence: 11
            )

            displayColumn QUANTIDADEAVARIADA (
                sequence: 9
            )

            displayColumn QUANTIDADECOMPRADA (
                sequence: 7
            )

            displayColumn QUANTIDADEDEVOLVIDA (
                sequence: 12
            )

            displayColumn QUANTIDADERECEBIDA (
                sequence: 8
            )

            displayColumn QUANTIDADERECEBIDAADICIONAL (
                sequence: 13
            )

            displayColumn TIPOALTERACAO (
                sequence: 3
            )

            displayColumn USUARIOALTERACAO (
                sequence: 2
            )

            displayColumn VALORCUSTO (
                sequence: 6
            )

        )

    )

    pageItem P513_IDCOMPRATRANSFER (
        type: hidden
        layout {
            sequence: 10
            region: @histórico-itens-compra-transf
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P513_IDPRODUTODETALHADO (
        type: plugin/select
        label {
            label: Produto
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct favorita.pck_util_fav.fnc_nomeprodutodetalhado(ic.idprodutodetalhado,1) showvalue
                     , ic.idprodutodetalhado returnvalue
                from logfavorita.log_itenscomprastransferen ic
                where ic.idcompratransferencia = :P513_IDCOMPRATRANSFER
                order by 1 desc;
                ```
            displayExtraValues: false
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--xlarge
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--primary
                t-Button--iconRight
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--iconRight
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 74
                items: {
                    P74_IDCOMPRATRANSFERENCIA: &P513_IDCOMPRATRANSFER.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

