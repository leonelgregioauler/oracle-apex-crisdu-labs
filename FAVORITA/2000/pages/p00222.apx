page 222 (
    name: Vencimentos Detalhados
    title: Vencimentos Detalhados
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 60%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function imprimeboleto()
            {
              var IDCOMPRA = document.getElementById("P222_IDCOMPRATRANSFERENCIA").value;
              var IDFILIAL = document.getElementById("P222_IDFILIALROMANCE").value;
                
              /*vurl = 'https://boleto.romancemoda.com.br/boleto_bb_favorita_remessas.php?cod1='+IDCOMPRA+'&cod2='+IDFILIAL;*/
              vurl = document.getElementById('P0_URLBOLETOBASE').value+'?cod1='+IDCOMPRA+'&cod2='+IDFILIAL;
              pjan = window.open(vurl,'boleto','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1024,height=1000,left=20,top=10','_blank'); 
              pjan.focus();
            }
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region vencimentos-detalhados (
        name: Vencimentos Detalhados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pc.idpagamentocompratransf
                     , pc.idvencimentocompratransf
                     , pc.idformapagamento
                     , pc.formapagamento
                     , pc.descorigempagamento "Origem"
                     , pc.numeroboleto
                     , vc.datavencimento
                     , vc.valorpagar
                     , vc.valorpago
                     , vc.situacaovencimentodescricao
                     , case 
                         when pc.idformapagamento = 5 then
                           --'<a href="http://boletos.romancemoda.com.br:7777/boleto/boleto_bb_favorita_novo.php?cod1='||v.idpedido||'&cod2='||v.idvendedora||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' 
                           '<a href=javascript:imprimeboleto();><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' 
                         else
                          '-'
                       end url
                from vw_vencimentoscompratransf_fav vc
                   , vw_pagamentoscomprastransf_fav pc
                where vc.idvencimentocompratransf = pc.idvencimentocompratransf
                  and pc.ididioma                 = 1
                  and vc.idcompratransferencia    = :P222_IDCOMPRATRANSFERENCIA
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1295791759844457561
        }

