        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 4776159 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAVENCIMENTO (
                sequence: 7
            )

            displayColumn FORMAPAGAMENTO (
                sequence: 4
            )

            displayColumn IDFORMAPAGAMENTO (
                sequence: 3
            )

            displayColumn IDPAGAMENTOCOMPRATRANSF (
                sequence: 1
            )

            displayColumn IDVENCIMENTOCOMPRATRANSF (
