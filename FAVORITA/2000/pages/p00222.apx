                    sequence: 3
                }
            )

        )

    )

    pageItem P222_IDCOMPRATRANSFERENCIA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @vencimentos-detalhados
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P222_IDFILIALROMANCE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @vencimentos-detalhados
            slot: regionBody
        }
        source {
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vidfilial number;
                begin
                  --
                  select c.idfilialromancedestino
                  into vidfilial 
                  from comprastransferencias c
                  where c.idcompratransferencia = :P222_IDCOMPRATRANSFERENCIA;
                  --
                  return vidfilial;
                  --
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

)

