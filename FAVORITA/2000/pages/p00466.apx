page 466 (
    name: Revisão de Depósitos
    title: Revisão de Depósitos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG_23"';
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region revisão-de-depósitos (
        name: Revisão de Depósitos
        type: tabform
        source {
            sqlQuery:
                ```sql
                select D.IDDEPOSITOFAVORITA
                     , IDDEPOSITOFAVORITA IDDESPESA_DISPLAY
                     , D.DATADEPOSITO
                     , D.NUMEROCOMPROVANTE
                     , D.VALORDEPOSITO
                     , EMMAOS
                     , OBSERVACAOCONTROLE
                     , null anexos
                     , ( select count(1)
                         from roman.anexosdepositos dd
                         where dd.iddeposito = d.iddepositofavorita ) qtdanexos
                     , null questionamento
                     , replace(replace(replace(D.NUMEROCOMPROVANTE||' - '||VALORDEPOSITO,',','.') ,'+',''),'-','.')  questionar 
                     , ( select nvl(d.valordeposito*ff.fatorconversao,0) valorpagoconversao
                         from  roman.fechamentossemanais f
                             , roman.vw_filiais ff
                         where ff.idfilial = f.idfilial
                           and d.idfechamento = f.idfechamento) valorpagoconversao
                from roman.depositosfavorita d
                where idfechamento = :P466_IDFECHAMENTO
                ```
        }
        layout {
            sequence: 15
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhuma despesa encontrada!
        }
        breakFormatting {
            breakColumns: col1
        }
        componentAdvanced {
            stripHtml: true
        }

        column ANEXOS (
            reportColumnQueryId: 8
            derivedColumn: N
            type: link
            heading {
                heading: Anexos
                alignment: center
            }
            layout {
                sequence: 12
                columnAlignment: center
            }
            link {
                target: {
                    page: 277
                    items: {
                        P277_IDDEPOSITOFAVORITA: #IDDESPESA_DISPLAY#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-view.png" class="apex-edit-view" alt="">
            }
            sorting {
                sortable: false
            }
        )

        column CHECK$01 (
            reportColumnQueryId: 13
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
            }
            serverSideCondition {
                type: never
            }
        )

        column DATADEPOSITO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Data do Depósito
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
        )

        column EMMAOS (
            reportColumnQueryId: 6
            derivedColumn: N
            type: simpleCheckbox
            heading {
                heading: Em Mãos
                alignment: center
            }
            lov {
                checkboxValues: S
            }
            layout {
                sequence: 9
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column IDDEPOSITOFAVORITA (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingTrigger
            }
        )

        column IDDESPESA_DISPLAY (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: ID
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column NUMEROCOMPROVANTE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Comprovante
                alignment: center
            }
            layout {
                sequence: 5
            }
        )

        column OBSERVACAOCONTROLE (
            reportColumnQueryId: 7
            derivedColumn: N
            type: textField
            heading {
                heading: Obs Revisão
                alignment: center
            }
            layout {
                sequence: 10
            }
            appearance {
                width: 40
            }
            sorting {
                sortable: false
            }
        )

        column QTDANEXOS (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Anexos
                alignment: center
            }
            layout {
                sequence: 11
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column QUESTIONAMENTO (
            reportColumnQueryId: 10
            derivedColumn: N
            type: link
            heading {
                heading: Questionar
                alignment: center
            }
            layout {
                sequence: 8
                columnAlignment: center
            }
            link {
                target: {
                    page: 440
                    items: {
                        P440_IDFECHAMENTO: &P0_IDFECHAMENTO.
                        P440_DESTINO: E
                        P440_IDFILIALFAVORITA: &P0_IDFILIALCAIXA.
                        P440_IDQUESTIONAMENTO:
                        P440_QUESTIONAMENTO: #QUESTIONAR#
                        P440_PAGINA: 438
                        P440_ORIGEM: &P466_ORIGEMDP.
                    }
                    action: resetPagination
                }
                linkText: <img src="#APP_IMAGES#quest1.png" alt="">
            }
            sorting {
                sortable: false
            }
        )

        column QUESTIONAR (
            reportColumnQueryId: 11
            derivedColumn: N
            type: hidden
            layout {
                sequence: 13
            }
        )

        column VALORDEPOSITO (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Valor
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
        )

        column VALORPAGOCONVERSAO (
            reportColumnQueryId: 12
            derivedColumn: N
            heading {
                heading: Valor Conversão
                alignment: center
            }
            layout {
                sequence: 7
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
        )

    )

    pageItem P466_IDFECHAMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @revisão-de-depósitos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P466_ORIGEMDP (
        type: hidden
        layout {
            sequence: 20
            region: @revisão-de-depósitos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button add (
        buttonName: ADD
        label: Add
        layout {
            sequence: 40
            region: @revisão-de-depósitos
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.widget.tabular.addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @revisão-de-depósitos
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 261
                items: {
                    P466_IDFECHAMENTO: &P0_IDFECHAMENTO.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button multi-row-delete (
        buttonName: MULTI_ROW_DELETE
        label: Delete
        layout {
            sequence: 20
            region: @revisão-de-depósitos
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'MULTI_ROW_DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Salvar
        layout {
            sequence: 30
            region: @revisão-de-depósitos
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @revisão-de-depósitos
        target {
            tableOwner: ROMAN
            tableName: DEPOSITOSFAVORITA
            pkColumn: IDDEPOSITOFAVORITA
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# row(s) updated, #MRI_COUNT# row(s) inserted.
        }
        advanced {
            executionMappingIdentifier: 69251130157963689
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 466
            }
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

)

