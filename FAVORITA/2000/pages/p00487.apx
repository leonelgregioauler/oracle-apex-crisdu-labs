page 487 (
    name: Gerar Tarefas Cobrança Preventiva
    title: Gerar Tarefas Cobrança Preventiva
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pedidos-para-preventivas (
        name: Pedidos para Preventivas
        type: tabform
        source {
            sqlQuery:
                ```sql
                select p.idpedido
                     , p.representante
                     , p.vendedora
                     , p.cpf
                     , p.dataemissao
                     , p.datavencimento
                     , p.valortotal
                     , p.valorapagar
                     , p.valorpago
                     , p.saldodevedor
                     , p.idvendedora
                     , p.idpessoa
                     , p.numeropedido
                     , ( select max(t.datainclusao)
                         from tarefas t
                         where t.idtipotarefa in (49,58)
                           and t.idpessoa = pp.idpessoa ) ultimatarefa
                from vw_pedidos_fav p
                   , catal.pessoas pp
                where pp.idpessoa = p.idpessoa
                  and exists ( select 1
                               from vencimentospedidos vp
                               where vp.idpedido = p.idpedido
                                 and vp.situacaovencimento = 'V'
                                 and vp.valorpago < vp.valorpagar
                                 and vp.datavencimento between to_date(:P487_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P487_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') )
                  and (:P487_IDFILIALROMANCE is null 
                    and exists ( select 1
                                 from roman.vw_filiais f
                                 where f.tipofilial = 'D'
                                   and f.ativo = 'S'
                                   and f.idgrupo != 5
                                   and f.idfilial = p.idfilialromance
                                   and exists ( select 1
                                                from favorita.pedidos p
                                                where p.idfilialromance = f.idfilial ))
                      or p.idfilialromance = :P487_IDFILIALROMANCE)
                  and ( :P487_IDREPRESENTANTE is null or p.idrepresentante = :P487_IDREPRESENTANTE )
                  and ( :P487_SEXO is null or :P487_SEXO = upper(pp.sexo))
                  and ( :P487_FAIXAVALOR is null
                      or (:P487_FAIXAVALOR = 1 and p.valorapagar between 0.01 and 129.99) 
                      or (:P487_FAIXAVALOR = 2 and p.valorapagar between 130.00 and 299.99) 
                      or (:P487_FAIXAVALOR = 3 and p.valorapagar between 300.00 and 599.99) 
                      or (:P487_FAIXAVALOR = 4 and p.valorapagar between 600.00 and 799.99) 
                      or (:P487_FAIXAVALOR = 5 and p.valorapagar between 800.00 and 99999.99))  
                  and ( :P487_FAIXAIDADE is null
                      or (:P487_FAIXAIDADE = 1 and pp.idade between 18 and 23) 
                      or (:P487_FAIXAIDADE = 2 and pp.idade between 24 and 29) 
                      or (:P487_FAIXAIDADE = 3 and pp.idade between 30 and 35) 
                      or (:P487_FAIXAIDADE = 4 and pp.idade between 36 and 41) 
                      or (:P487_FAIXAIDADE = 5 and pp.idade between 42 and 47) 
                      or (:P487_FAIXAIDADE = 6 and pp.idade between 48 and 53) 
                      or (:P487_FAIXAIDADE = 7 and pp.idade between 54 and 59) 
                      or (:P487_FAIXAIDADE = 8 and pp.idade between 60 and 160) )
                  and ( :P487_PEDIDOANTERIOREMDIA is null
                      or (:P487_PEDIDOANTERIOREMDIA = 'S' and ( select sum(vp.valorpagar - ( select sum(pg.valorpago)
                                                                                             from favorita.pagamentospedidos pg
                                                                                             where pg.idvencimentopedido = vp.idvencimentopedido
                                                                                               and pg.idsituacao = 20
                                                                                               and pg.datapagamento <= vp.datavencimento) )
                                                                from favorita.vencimentospedidos vp
                                                                where vp.idpedido = ( select max(pe.idpedido)
                                                                                                from favorita.pedidos pe
                                                                                                where pe.idpedido < p.idpedido
                                                                                                  and pe.idvendedora = p.idvendedora
                                                                                                  and pe.datacancelamento is null)) <= 0 )
                      or (:P487_PEDIDOANTERIOREMDIA = 'N' and ( select sum(vp.valorpagar - ( select sum(pg.valorpago)
                                                                                         from favorita.pagamentospedidos pg
                                                                                         where pg.idvencimentopedido = vp.idvencimentopedido
                                                                                           and pg.idsituacao = 20
                                                                                           and pg.datapagamento <= vp.datavencimento) )
                                                                from favorita.vencimentospedidos vp
                                                                where vp.idpedido = ( select max(pe.idpedido)
                                                                                                from favorita.pedidos pe
                                                                                                where pe.idpedido < p.idpedido
                                                                                                  and pe.idvendedora = p.idvendedora
                                                                                                  and pe.datacancelamento is null)) > 0 ))
                  and ( :P487_PEDIDOANTERIORSPC is null
                      or (:P487_PEDIDOANTERIORSPC = 'S' and ( select spp.spc_quantidade
                                                              from roman.consultaspc spp    
                                                              where spp.idconsultaspc = ( select max(sp.idconsultaspc)
                                                                                          from roman.consultaspc sp,
                                                                                               catal.vendedoras v,
                                                                                               catal.pessoas p
                                                                                          where sp.cpf = p.cpf
                                                                                            and p.idpessoa = v.idpessoa
                                                                                            and v.idvendedora = p.idvendedora)) >=1 )
                      or (:P487_PEDIDOANTERIORSPC = 'N' and ( select spp.spc_quantidade
                                                              from roman.consultaspc spp    
                                                              where spp.idconsultaspc = ( select max(sp.idconsultaspc)
                                                                                          from roman.consultaspc sp,
                                                                                               catal.vendedoras v,
                                                                                               catal.pessoas p
                                                                                          where sp.cpf = p.cpf
                                                                                            and p.idpessoa = v.idpessoa
                                                                                            and v.idvendedora = p.idvendedora )) <=0 ))
                  and p.saldodevedor > 0 
                  and ( ( :P487_RECONTATO is null and not exists ( select 1
                                                                   from tarefas t
                                                                   where t.idtipotarefa in (49,58)
                                                                     and t.idpessoa     = p.idpessoa
                                                                     and t.idsituacao   in (0,10,20,30) ) )
                      or ( :P487_RECONTATO = 'S' and exists ( select 1
                                                              from tarefas t
                                                              where t.idtipotarefa = 49
                                                                and t.idpessoa     = p.idpessoa
                                                                and trunc(t.datainclusao) < trunc(sysdate-15)
                                                                and t.idsituacao   in (0,10,20,30) )
                                                 and not exists ( select 1
                                                                  from tarefas t
                                                                  where t.idtipotarefa in (49,58)
                                                                    and t.idpessoa     = p.idpessoa
                                                                    and trunc(t.datainclusao) >= trunc(sysdate-15)
                                                                    and t.idsituacao   in (0,10,20,30) ) ) )
                order by p.datavencimentomenor desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <font color="red"><h3>
                    Verificar com a Carol antes de gerar novas tarefas! As preventivas foram solicitadas para serem retiradas dos atendimentos!
                    </h3> </font>
                ```
        }
        reportLayout {
            numberOfRows: 10000
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        messages {
            whenNoDataFound: Nenhum pedido encontrado, verifique os filtros!
        }

