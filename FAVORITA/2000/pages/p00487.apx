                       from dual
                       union
                       select '130,00 - 299,99' as FAIXAIDADE,
                              2  as CODIGOFAIXA
                       from dual
                       union
                       select '300,00 - 599,99' as FAIXAIDADE,
                              3  as CODIGOFAIXA
                       from dual
                       union
                       select '600,00 - 799,99' as FAIXAIDADE,
                              4  as CODIGOFAIXA
                       from dual
                       union
                       select '800,00 - 99.999,99' as FAIXAIDADE,
                              5  as CODIGOFAIXA
                       from dual)
                ```
