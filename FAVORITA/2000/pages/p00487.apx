    process gera-tarefa-de-pedidos-vencidos (
        name: Gera Tarefa de Pedidos Vencidos
        type: executeCode
        editableRegion: @pedidos-para-preventivas
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidusuario    number := :P487_IDUSUARIO; 
                  vidpessoa     number := null;
                  vtelefone     varchar2(100) := null;
                  vcodigoarea   number;
                  vexiste       varchar(1) := 'N';
                  vidtipotarefa number;
                  --
                begin
                  --
                  vidpessoa := :IDPESSOA;
                  --
                  if :P487_TIPO = 'N' then
                    --
                    vidtipotarefa := 49;
                    --
                  else
                    --
                    vidtipotarefa := 58;
                    --
                  end if;
                  --
                  if :P487_RECONTATO is null then
                    --
                    begin
                      select 'S'
                      into vexiste
                      from tarefas t
                      where t.idpessoa = vidpessoa
                        and t.idtipotarefa = 49
                        and t.idsituacao in (0,10,20,30);
                    exception
                      when others then
                        vexiste := 'N';
                    end;
                    --
                  else
                    --
                    vexiste := 'N';
                    --
                  end if;
                  --
                  begin
                    --
                    select substr(translate(t.telefone,'0123456789AaBbCcDdEeFfGgHhIiJjKkLlMmNnOoPpQqRrSsTtUuVvXxYyWwZz_-,.  Ññ~ !@#$%?&*()/??','0123456789'),0,100 )telefone
                    into vtelefone
                    from tarefas t
                       , pedidos p
                    where p.idpedido = :IDPEDIDO
                      and p.idtarefa = t.idtarefa
                      -- só utiliza o telefone se o idpessoa da tarefa for o mesmo do pedido
                      and t.idpessoa = vidpessoa
                      -- -------------------------------------------------------------------
                      ;
                    --
                  exception
                    when others then
                      --
                      for i in ( select substr(translate(t.telefone,'0123456789AaBbCcDdEeFfGgHhIiJjKkLlMmNnOoPpQqRrSsTtUuVvXxYyWwZz_-,.  Ññ~ !@#$%?&*()/??','0123456789'),0,100 )telefone
                                 from ROMAN.telefonespessoas t
                                 where t.idpessoa = vidpessoa
                                 order by t.ultimaatualizacao desc )
                      loop
                        --
                        vtelefone := i.telefone;
                        exit;
                        --
                      end loop;
                    --
                  end;
                  --
                  if vtelefone is not null and vexiste = 'N' then
                    --
                    insert into favorita.tarefas ( idtarefa            , datainclusao    , idsituacao
                                                 , observacao          , idtipotarefa    , idpessoa
                                                 , idgrupoatendimento  , telefone        , idusuario
                                                 , idpedido )
                    values ( favorita.seq_idtarefa.nextval,   sysdate,  0
                           , substr(roman.pck_romance.fnc_retornatelefones(:IDVENDEDORA),0,100) , vidtipotarefa  , vidpessoa
                           , 4 , vtelefone , vidusuario
                           , :IDPEDIDO ); 
                    --
                  end if;
                  --
                  exception when others then
                  raise_application_error(-20001,sqlerrm);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Tarefas geradas com sucesso!
        }
        advanced {
            executionMappingIdentifier: 96949732242650548
        }
        serverSideCondition {
            type: request=Value
            value: GERAR_TAREFAS
        }
    )

    branch (
        name: Buscar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 487
                items: {
                    P487_IDFILIALROMANCE: &P487_IDFILIALROMANCE.
                    P487_IDREPRESENTANTE: &P487_IDREPRESENTANTE.
