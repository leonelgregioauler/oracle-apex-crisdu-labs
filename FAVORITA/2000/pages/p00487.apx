    pageItem P487_FAIXAIDADE (
        type: plugin/select
        label {
            label: Faixa de Idade
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select FAIXAIDADE as showvalue
                     , CODIGOFAIXA as returnvalue
                from ( select '18 a 23' as FAIXAIDADE,
                              1  as CODIGOFAIXA
                       from dual
                       union
                       select '24 a 29' as FAIXAIDADE,
                              2  as CODIGOFAIXA
                       from dual
                       union
                       select '30 a 35' as FAIXAIDADE,
                              3  as CODIGOFAIXA
                       from dual
                       union
                       select '36 a 41' as FAIXAIDADE,
                              4  as CODIGOFAIXA
                       from dual
                       union
                       select '42 a 47' as FAIXAIDADE,
                              5  as CODIGOFAIXA
                       from dual
                       union
                       select '48 a 53' as FAIXAIDADE,
                              6  as CODIGOFAIXA
                       from dual
                       union
                       select '54 a 59' as FAIXAIDADE,
                              7  as CODIGOFAIXA
                       from dual
                       union
                       select '60 a 99' as FAIXAIDADE,
                              8  as CODIGOFAIXA
                       from dual)
                ```
            displayExtraValues: false
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        security {
            encryptSessionState: false
        }
    )

