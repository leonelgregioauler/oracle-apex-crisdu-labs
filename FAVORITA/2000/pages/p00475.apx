page 475 (
    name: Cadastro de Feriado
    title: Cadastro de Feriado
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG_24"';
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region form-on-feriados (
        name: Form on FERIADOS
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P475_DATAFERIADO (
        type: datePickerJquery
        label {
            label: Data Feriado
            alignment: left
        }
        layout {
            sequence: 20
            region: @form-on-feriados
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: DATAFERIADO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P475_DESCRICAO (
        type: textarea
        label {
            label: Descrição
            alignment: left
        }
        layout {
            sequence: 40
            region: @form-on-feriados
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            type: databaseColumn
            databaseColumn: DESCRICAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P475_DIASEMANA (
        type: selectList
        label {
            label: Dia Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(to_char(to_date(:P475_DATAFERIADO,'DD/MM/RRRR'),'DAY')) d,
                       initcap(to_char(to_date(:P475_DATAFERIADO,'DD/MM/RRRR'),'DAY')) r
                from dual
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P475_DATAFERIADO
        }
        layout {
            sequence: 30
            region: @form-on-feriados
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: DIASEMANA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P475_IDFERIADO (
        type: hidden
        layout {
            sequence: 10
            region: @form-on-feriados
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFERIADO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Salvar
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P475_IDFERIADO
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Você gostaria de executar esta ação de exclusão?','DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P475_IDFERIADO
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar Alterações
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P475_IDFERIADO
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation valida-campo-de-data (
        name: Valida campo de data
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from feriados f
                where f.dataferiado = :P475_DATAFERIADO
                ```
        }
        error {
            errorMessage: Já existe um feriado com a data informada!
            associatedItem: @P475_DATAFERIADO
        }
        serverSideCondition {
            type: requestIsNotContainedInValue
            value: DELETE
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 82187678719746427
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process fetch-row-from-feriados (
        name: Fetch Row from FERIADOS
        type: autoRowFetch
        source {
            tableName: FERIADOS
            pkColumn: IDFERIADO
            pkItem: P475_IDFERIADO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 82186431338746421
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  if :P475_IDFERIADO is null then
                    --
                    select seq_idferiado.nextval
                    into :P475_IDFERIADO
                    from dual;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 82033984515427508
        }
    )

    process process-row-of-feriados (
        name: Process Row of FERIADOS
        type: autoRowProcessing
        target {
            tableName: FERIADOS
            pkColumn: IDFERIADO
            pkItem: P475_IDFERIADO
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 82186813485746424
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 82187244116746426
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

)

