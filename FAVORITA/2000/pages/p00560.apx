page 560 (
    name: Relatorio de Perfis de Venda
    title: Relatorio de Perfis de Venda
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region report (
        name: Report 1
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.IDPERFILVENDA, v.IDPERFIL, v.DESCRICAO "Perfil Venda", p.descricao Perfil, perccomissao "% Comissão"
                  from PERFISVENDAS v
                     , perfis       p
                 where v.idperfil = p.idperfil
                 order by p.descricao, 
                          v.descricao
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 561
                items: {
                    P561_IDPERFILVENDA: #IDPERFILVENDA#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 99869057812774978
        }

        column "% Comissão" (
            type: plainText
            heading {
                heading: % Comissão
                alignment: end
            }
            layout {
                sequence: 32
                columnAlignment: end
            }
            appearance {
                formatMask: 99d00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column IDPERFIL (
            type: hidden
            heading {
                heading: Idperfil
            }
            layout {
                sequence: 2
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDPERFILVENDA (
            type: hidden
            heading {
                heading: Idperfilvenda
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column PERFIL (
            type: plainText
            heading {
                heading: Perfil
            }
            layout {
                sequence: 12
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column "Perfil Venda" (
            type: plainText
            heading {
                heading: Perfil Venda
            }
            layout {
                sequence: 22
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 998926 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn "% Comissão" (
                sequence: 5
            )

            displayColumn IDPERFIL (
                sequence: 2
            )

            displayColumn IDPERFILVENDA (
                sequence: 1
            )

            displayColumn PERFIL (
                sequence: 4
            )

            displayColumn "Perfil Venda" (
                sequence: 3
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Novo Perfil Venda
        layout {
            sequence: 30
            region: @report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 561
                clearCache: 561
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

