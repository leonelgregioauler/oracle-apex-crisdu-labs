page 7 (
    name: Relatório de Produtos
    title: Produtos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region produtos (
        name: Produtos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.idproduto
                     , v.idproduto idprod
                     , v.ididioma
                     , v.referencia
                     , v.nomeproduto
                     , v.descricaosite
                     , v.peso
                     , v.altura
                     , v.largura
                     , v.profundidade
                     , v.idcategoria
                     , v.categoria--||' ('||v.idcategoria||')' categoria
                     , v.idcategoriasite
                     , v.nomecategoriasite
                     , v.classificacaofiscal 
                     , v.idtextonome
                     , v.idtextodescricao
                     , v.valorpontos
                     , ( select listagg(roman.pck_romance.fnc_nomepessoa(f.idpessoa),',') within group (order by 1)
                         from fornecedoresprodutos fp
                            , fornecedores f
                         where fp.idfornecedor = f.idfornecedor(+)
                         and fp.idproduto(+) = v.idproduto ) nomefornecedor
                from vw_produtos_fav v
                where v.ididioma   = :P0_IDIDIOMA;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        performance {
            lazyLoading: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 7683995602972721
        }

        savedReport 10319819 (
            visibility: primary
            view {
                default: grid
                rowsPerPage: 100
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @CATEGORIA
                layout {
                    width: 136.3542
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDPRODUTO
