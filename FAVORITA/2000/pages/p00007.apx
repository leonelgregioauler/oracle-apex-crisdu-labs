                layout {
                    width: 179
                    sequence: 5
                }
            )

            displayColumn (
                column: @NOMEFORNECEDOR
                layout {
                    sequence: 15
                }
            )

            displayColumn (
                column: @IDTEXTONOME
                layout {
                    sequence: 16
                }
