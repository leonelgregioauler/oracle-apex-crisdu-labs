page 421 (
    name: Monitoramento de SMS
    title: Monitoramento de SMS
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region controle-de-mensagens (
        name: Controle de Mensagens
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.telefone
                     , m.mensagem
                     , m.datainclusao
                     , m.dataenvio
                     , m.retorno
                     , case
                         when substr(m.retorno,37,3) = '000' then
                           'SMS Enviado com Sucesso'
                         when substr(m.retorno,37,3) = '013' then
                           'Numero incompleto ou com problema'
                         when retorno is null then
                           'SMS na fila de envio'
                         when entregue = 'S' then
                           'SMS Entregue'
                         when instr(retorno,'OK') > 0 then
                           'OK'
                         else
                           '-'
                       end resultado
                     , ( select p.processo
                         from roman.processossistemas p
                         where p.idprocessosistema = m.idprocessosistema ) processo
                     , cc.nome "Centro De Custo"
                from roman.mensagenssms m
                   , roman.processossistemas ps
                   , roman.centrodecustos cc
                where ps.idcentrodecusto = cc.idcentrodecusto
                  and ps.idprocessosistema = m.idprocessosistema
                  and ididioma = 1
                  and trunc(m.datainclusao) between to_date(:P421_DATAINICIO) and to_date(:P421_DATAFIM)
                  and ( :P421_IDPROCESSO  is null or m.idprocessosistema = :P421_IDPROCESSO)
                  and ( :P421_CENTROCUSTO is null or cc.idcentrodecusto = :P421_CENTROCUSTO)
                  and ( :P421_IDPESSOA    is null or m.idpessoa = :P421_IDPESSOA )
                order by 3 desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 300000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado, verifique os filtros e tente novamente!
        }
        advanced {
            savedReportMappingIdentifier: 1600166104957817833
        }

