    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region quantidades-por-setor (
        name: Quantidades Por Setor
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select cc.nome Setor, to_char(count(m.mensagem),'999G999G999G999G990') QtdPorSetor
                 from roman.processossistemas ps
                    , roman.centrodecustos cc
                    , roman.mensagenssms m
                where ps.idprocessosistema = m.idprocessosistema
                  and ps.idcentrodecusto = cc.idcentrodecusto
                  and trunc(m.datainclusao) between to_date(:P421_DATAINICIO,'dd/mm/yyyy') and to_date(:P421_DATAFIM,'dd/mm/yyyy')
                  and ( :P421_IDPROCESSO is null or m.idprocessosistema = :P421_IDPROCESSO )
                  and ( :P421_IDPESSOA is null or m.idpessoa = :P421_IDPESSOA )
                  and ( :P421_CENTROCUSTO is null or cc.idcentrodecusto = :P421_CENTROCUSTO)
                group by cc.nome
                having count(m.mensagem) > 0
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: SETOR
            valueColumn: QTDPORSETOR
        }
    )

    pageItem P421_CENTROCUSTO (
        type: selectList
        label {
            label: Centro de Custo
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct cc.nome            display_value,
                                cc.idcentrodecusto id_value
                  from roman.processossistemas ps
                     , roman.centrodecustos cc
                 where ps.idcentrodecusto = cc.idcentrodecusto;
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P421_DATAFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
