page 634 (
    name: Históricos SAC
    title: Históricos SAC
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 40%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG_24"';
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region históricos-sac (
        name: Históricos SAC
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P634_DATAHISTORICO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @históricos-sac
            slot: regionBody
        }
        appearance {
            formatMask: DD/MM/YYYY HH24:MI:SS
        }
        source {
            type: databaseColumn
            databaseColumn: DATAHISTORICO
            used: always
        }
        default {
            type: expression
            plsqlExpression: to_char(systimestamp,'dd/mm/rrrr hh24:mi:ss')
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P634_IDCONTROLECONTATOSSITE (
        type: displayOnly
        label {
            label: Protocolo
            alignment: left
        }
        layout {
            sequence: 20
            region: @históricos-sac
            slot: regionBody
            alignment: left
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: IDCONTROLECONTATOSSITE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P634_IDHISTORICOATENDIMENTOSAC (
        type: hidden
        layout {
            sequence: 10
            region: @históricos-sac
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDHISTORICOATENDIMENTOSAC
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P634_IDUSUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @históricos-sac
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDUSUARIO
            used: always
        }
        default {
            type: expression
            plsqlExpression: :P0_IDUSUARIO
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P634_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        layout {
            sequence: 50
            region: @históricos-sac
            slot: regionBody
            alignment: left
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 150
            height: 7
        }
        validation {
            maxLength: 1000
        }
        source {
            type: databaseColumn
            databaseColumn: OBSERVACAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Incluir
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P634_IDHISTORICOATENDIMENTOSAC
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar Alterações
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P634_IDHISTORICOATENDIMENTOSAC
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 2979039568527361430
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process fetch-row-from-historicosatendimentossac (
        name: Fetch Row from HISTORICOSATENDIMENTOSSAC
        type: autoRowFetch
        source {
            tableOwner: ROMAN
            tableName: HISTORICOSATENDIMENTOSSAC
            pkColumn: IDHISTORICOATENDIMENTOSAC
            pkItem: P634_IDHISTORICOATENDIMENTOSAC
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 2979037981784361431
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P634_IDHISTORICOATENDIMENTOSAC is null then
                        select "ROMAN"."SEQ_IDHISTATENDSAC".nextval
                          into :P634_IDHISTORICOATENDIMENTOSAC
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 2979038347210361431
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-historicosatendimentossac (
        name: Process Row of HISTORICOSATENDIMENTOSSAC
        type: autoRowProcessing
        target {
            tableOwner: ROMAN
            tableName: HISTORICOSATENDIMENTOSSAC
            pkColumn: IDHISTORICOATENDIMENTOSAC
            pkItem: P634_IDHISTORICOATENDIMENTOSAC
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 2979038764644361431
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 2979039125936361430
        }
    )

    branch (
        name: Volta para 626
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 626
                items: {
                    P626_IDCONTROLECONTATOSSITE: &P634_IDCONTROLECONTATOSSITE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,CREATE
        }
    )

)

