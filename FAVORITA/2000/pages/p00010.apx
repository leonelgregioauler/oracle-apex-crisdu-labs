page 10 (
    name: Cadastro de Categorias
    title: Categorias
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region categorias (
        name: Categorias
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P10_ATIVO (
        type: radioGroup
        label {
            label: Situação
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-situacao
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @categorias
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: S
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P10_DESCRICAO (
        type: textField
        label {
            label: Descrição
            alignment: left
        }
        layout {
            sequence: 50
            region: @categorias
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P10_IDCATEGORIA (
        type: hidden
        layout {
            sequence: 10
            region: @categorias
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P10_IDCATEGORIASITE (
        type: selectList
        label {
            label: Categoria Site
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-categoriassite
            nullDisplayValue: " - Selecione a Categoria Site - "
        }
        layout {
            sequence: 70
            region: @categorias
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P10_IDTEXTO (
        type: hidden
        layout {
            sequence: 80
            region: @categorias
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P10_MD5 (
        type: hidden
        layout {
            sequence: 90
            region: @categorias
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P10_NOME (
        type: textField
        label {
            label: Nome
            alignment: left
        }
        layout {
            sequence: 30
            region: @categorias
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P10_OPERACAO_DML (
        type: hidden
        layout {
            sequence: 100
            region: @categorias
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P10_REFERENCIA (
        type: textField
        label {
            label: Referência
            alignment: left
        }
        layout {
            sequence: 40
            region: @categorias
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 50
            region: @categorias
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P10_IDCATEGORIA
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 40
            region: @categorias
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P10_IDCATEGORIA
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 30
            region: @categorias
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 9
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 20
            region: @categorias
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P10_IDCATEGORIA
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @categorias
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P10_IDCATEGORIA
        }
    )

    validation nome-obrigatório (
        name: NOME obrigatório
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P10_NOME
            alwaysExecute: true
        }
        error {
            errorMessage: Nome deve ter um valor.
            associatedItem: @P10_NOME
        }
    )

    validation referencia-obrigatório (
        name: REFERENCIA obrigatório
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P10_REFERENCIA
        }
        error {
            errorMessage: Referência deve ter um valor.
            associatedItem: @P10_REFERENCIA
        }
    )

    process consulta-categorias (
        name: Consulta Categorias
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                #OWNER#.PCK_CADASTROS_FAV.PRC_CATEGORIAS(
                  PIDCATEGORIA => :P10_IDCATEGORIA,
                  PIDCATEGORIASITE => :P10_IDCATEGORIASITE,
                  PNOME => :P10_NOME,
                  PREFERENCIA => :P10_REFERENCIA,
                  PDESCRICAO => :P10_DESCRICAO,
                  PATIVO => :P10_ATIVO,
                  PMD5 => :P10_MD5,
                  POPERACAO_DML => 'S');
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 3152649017485006
        }
    )

    process limpar-campos-ao-sair (
        name: Limpar Campos ao Sair
        type: clearSessionState
        execution {
            sequence: 10
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 3153151614485011
        }
    )

    process limpar-campos-para-adicionar (
        name: Limpar Campos para Adicionar
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 3153234682485012
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    process operação-dml-em-categorias (
        name: Operação DML em Categorias
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  #OWNER#.PCK_CADASTROS_FAV.PRC_CATEGORIAS(
                    PIDCATEGORIA => :P10_IDCATEGORIA,
                    PIDCATEGORIASITE => :P10_IDCATEGORIASITE,
                    PNOME => :P10_NOME,
                    PREFERENCIA => :P10_REFERENCIA,
                    PDESCRICAO => :P10_DESCRICAO,
                    PATIVO => :P10_ATIVO,
                    PMD5 => :P10_MD5,
                    POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 3150952382361833
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 10
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

)

