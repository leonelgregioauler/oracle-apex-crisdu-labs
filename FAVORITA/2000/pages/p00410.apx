    dynamicAction carregar-id-anexo-do-item-para-incluir-anexo (
        name: Carregar ID anexo do item para incluir anexo
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: items
            items: P410_ATTACH_DATA
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: :P410_IDITEMDOCUMENTACAOANEXO := :P410_IDITEMDOCUMENTACAO;
                itemsToSubmit: P410_IDITEMDOCUMENTACAO
                itemsToReturn: P410_IDITEMDOCUMENTACAOANEXO
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process consulta-em-itens-documentação-favorita (
        name: Consulta em Itens Documentação Favorita
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  if :P410_IDITEMDOCUMENTACAO is not null then
                    --
                    pck_cadastros_fav.prc_itensdocumentacao( piditemdocumentacao 		    => :P410_IDITEMDOCUMENTACAO
                                                           , piddocumentacao 			    => :P410_IDDOCUMENTACAO
                                                           , ptituloitemdocumentacao 	    => :P410_TITULOITEMDOCUMENTACAO
                                                           , pdescricaoitemdocumentacao     => :P410_DESCRICAOITEMDOCUMENTACAO
                                                           , pdatainclusao 				    => :P410_DATAINCLUSAO
                                                           , pdataatualizacao 			    => :P410_DATAATUALIZACAO
                                                           , pmd5 						    => :P410_MD5
                                                           , poperacao_dml 				    => 'S' );
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1585209646365512023
        }
    )

    process consultar-anexo (
        name: Consultar anexo
        type: autoRowFetch
        source {
            tableName: ANEXOSITENSDOCUMENTACAO
            pkColumn: IDANEXOITEMDOCUMENTACAO
            pkItem: P410_IDANEXOITEMDOCUMENTACAO
        }
        execution {
            sequence: 20
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1585212017102512025
        }
    )

    process deletar-anexo (
        name: Deletar Anexo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  delete anexositensdocumentacao
                  where idanexoitemdocumentacao = :P410_IDANEXOITEMDELETAR; 
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 1585212466796512025
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'EXCLUIRANEXO'
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                  select seq_idanexoitemdocumentacao.nextval
                  into :P410_IDANEXOITEMDOCUMENTACAO
                  from dual;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1585211677446512024
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: V('REQUEST') = 'ANEXAR'
        }
    )

    process limpar-campos-ao-sair (
        name: Limpar Campos ao Sair
        type: clearSessionState
        execution {
            sequence: 10
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 1585210436138512024
        }
    )

    process operação-dml-em-itens-documentação (
        name: Operação DML em Itens Documentação
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  pck_cadastros_fav.prc_itensdocumentacao( piditemdocumentacao 		    => :P410_IDITEMDOCUMENTACAO
                      								     , piddocumentacao 			    => :P410_IDDOCUMENTACAO
                									     , ptituloitemdocumentacao 	    => :P410_TITULOITEMDOCUMENTACAO
                									     , pdescricaoitemdocumentacao   => :P410_DESCRICAOITEMDOCUMENTACAO
                									     , pdatainclusao 				=> :P410_DATAINCLUSAO
                									     , pdataatualizacao 			=> :P410_DATAATUALIZACAO
                									     , pmd5 						=> :P410_MD5
                									     , poperacao_dml 				=> voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 1585210833005512024
        }
    )

    process salvar-anexo (
        name: Salvar Anexo
        type: autoRowProcessing
        target {
            tableName: ANEXOSITENSDOCUMENTACAO
            pkColumn: IDANEXOITEMDOCUMENTACAO
            pkItem: P410_IDANEXOITEMDOCUMENTACAO
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Anexo incluído com sucesso.
        }
        error {
            errorMessage: Erro ao incluir anexo.
        }
        advanced {
            executionMappingIdentifier: 1585211299858512024
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: V('REQUEST') = 'ANEXAR'
        }
    )

    branch (
        name: Go To Page 410
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 410
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'ATUALIZAR'
        }
    )

)

