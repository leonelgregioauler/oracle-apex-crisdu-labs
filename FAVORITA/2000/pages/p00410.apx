page 410 (
    name: Itens Documentação Favorita
    title: Itens Documentação Favorita
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 90%
        height: 90%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function deletaanexo(pid)
            {
            
              document.getElementById('P410_IDANEXOITEMDELETAR').value = pid;
              
              apex.confirm("Confirma exlusão do Anexo?", 'EXCLUIRANEXO');
              
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region anexo (
        name: Anexo
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @itens-documentação-favorita
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
    )

    region anexos (
        name: Anexos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ad.idanexoitemdocumentacao
                     , ad.iditemdocumentacao
                     , ad.attach_data
                     , ad.attach_mimetype
                     , ad.attach_filename
                     , ad.attach_last_update
                     , ad.attach_charset
                     , round(sys.dbms_lob.getlength(attach_data)/1024,2)||' kb' file_length
                     , sys.dbms_lob.getlength(attach_data) download
                     , '<a href="javascript: deletaanexo('||ad.idanexoitemdocumentacao||')"> Excluir </a>' remover
                from anexositensdocumentacao ad
                where iditemdocumentacao = :P410_IDITEMDOCUMENTACAO;
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 4746995079153207423
        }

