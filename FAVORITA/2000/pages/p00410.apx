    button anexar (
        buttonName: ANEXAR
        label: Anexar
        layout {
            sequence: 10
            region: @anexo
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-paperclip
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from permissoesdocumentacaofavorita pd
                where pd.idusuario      = :P0_IDUSUARIO
                and pd.permissaototal   = 'S'
                and :P410_IDITEMDOCUMENTACAO is not null
                ```
        }
    )

