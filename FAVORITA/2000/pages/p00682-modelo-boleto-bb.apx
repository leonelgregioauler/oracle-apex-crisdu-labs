page 682 (
    name: Modelo Boleto BB
    alias: MODELO-BOLETO-BB
    title: Modelo Boleto BB
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    navigationMenu {
        overrideUserInterfaceLevel: true
    }
    javaScript {
        fileUrls: [
            #APP_FILES#JsBarcode.all.min.js
            #APP_FILES#qrcode.js
        ]
    }
    css {
        inline:
            ```css
            @page {
              size: A4;
              margin: 8mm;
            }
            
            * {
              box-sizing: border-box; /* CORRIGE ESTOURO DE LARGURA */
            }
            
            body {
              background: #ffffff;
              margin: 0;
              font-family: Arial,Helvetica, sans-serif;
              font-size: 9px;
            }
            
            .bb-container {
              width: 190mm;
              margin: 0 auto;
            }
            
            /* ================= VIA ================= */
            
            .bb-via {
              margin-bottom: 8mm;
              position: relative;
            }
            
            .bb-recibo-label {
              position: absolute;
              right: 0;
              top: -12px;
              font-size: 8px;
            }
            
            /* ================= TOPO ================= */
            
            .bb-topo {
              display: flex;
              align-items: center;
              border-bottom: 0.7mm solid #0033A0;
              padding: 4px 0;
              font-size: small;
              }
            
            .bb-top-left {
              display: flex;
              align-items: center;
              padding-right: 10px;
              margin-right: 10px;
            }
            
            .bb-logo {
              height: 22px;
            }
            
            .bb-codigo {
              font-weight: bold;
              color: #002981;
              margin-left: 8px;
              padding: 0 6px;
              border-left: .5mm solid #0033A0;
              border-right:.5mm solid #0033A0;
            }
            
            .bb-linha {
              font-weight: bold;
              color: #002981;
              margin-left: auto;
              letter-spacing: 1px;
              white-space: nowrap;
            }
            
            /* ================= CORPO ================= */
            
            .bb-body {
              padding: 3mm 0;
            }
            
            .bb-row {
              display: flex;
              width: 100%;
              border-bottom: 0.3mm solid #000;
            }
            
            .bb-col {
              padding: 4px 6px;
              border-left: 4px solid #FFCC00;
              font-size: 8px;
              overflow: hidden;
              white-space: nowrap;
              text-overflow: ellipsis;
              display: flex;          
              flex-direction: column;   
            }
            
            /* Permite quebra somente quando necessário */
            .bb-col.w100,
            .bb-col.w75,
            .bb-col.w70,
            .bb-col.w65 {
              white-space: normal;
            }
            
            /* ================= LABEL / VALUE ================= */
            
            .bb-label {
              font-size: 7px;
              text-transform: uppercase;
              color: #0033A0;   /* AZUL OFICIAL BB */
              font-weight: 600;
            }
            
            .bb-value {
              font-weight: bold;
              margin-top: auto;
              color: #000;
            }
            
            .bb-value-right {
              font-weight: bold;
              margin-top: auto;
              text-align: right;
              color: #000;   /* TEXTO PRETO */
            }
            
            /* ================= LARGURAS FIXAS CONTROLADAS ================= */
            /* SOMAM 100% CORRETAMENTE */
            
            .w100 { width: 100%; }
            .w75  { width: 75%; }
            .w70  { width: 70%; }
            .w65  { width: 65%; }
            .w30  { width: 30%; }
            .w25  { width: 25%; }
            .w20  { width: 20%; }
            .w15  { width: 15%; }
            .w10  { width: 10%; }
            .w5   { width: 5%; }
            
            /* ================= CORTE ================= */
            
            .bb-cut-line {
              border-top: 0.2mm dashed #0033A0;
              margin-top: 2px;
              margin-bottom: 12px;
            }
            
            .bb-cut-line1 {
              border-top: 0.2mm dashed #0033A0;
              margin-top: 20px;
              margin-bottom: 12px;
            }
            
            .bb-cut-text {
              color: #0033A0;
              font-size: 7px;
              margin-bottom: 0mm;
            }
            
            /* ================= RODAPÉ ================= */
            
            .bb-auth {
              text-align: right;
              margin-top: 2mm;
              font-size: 8px;
            }
            
            /* ================= AJUSTE DE MICRO COLUNAS ================= */
            
            /* Evita estouro nas colunas pequenas */
            .w5, .w10 {
              font-size: 7px;
            }
            
            /* Ajusta colunas técnicas para caber texto */
            .bb-row .w15,
            .bb-row .w20 {
              min-width: 0;
            }
            
            /* ================= REMOVE HEADER APEX ================= */
            
            .t-Header,
            .t-Footer {
              display: none !important;
            }
            
            /* ===== VIA 1 BLOCO TÉCNICO SUPERIOR CORRIGIDO ===== */
            
            .bb-row-via1-top {
              display: flex;
            }
            
            /* larguras fixas em mm iguais ao modelo real */
            
            .col-benef {
              width: 92mm;
            }
            
            .col-agencia {
              width: 32mm;
            }
            
            .col-especie { width: 14mm; text-align: left; }
            .col-quantidade { width: 16mm; text-align: left; }
            
            .col-nosso-numero {
              width: 36mm;
            }
            
            /* remove ellipsis e corte para este bloco */
            .bb-row-via1-top .bb-col {
              white-space: normal;
              overflow: visible;
              text-overflow: unset;
            }
            
            /* fonte menor para caber exatamente como original */
            .col-especie .bb-label,
            .col-quantidade .bb-label,
            .col-nosso-numero .bb-label {
              font-size: 6.5px;
            }
            
            .col-especie .bb-value,
            .col-quantidade .bb-value,
            .col-nosso-numero .bb-value {
              font-size: 8px;
            }
            
            /* ===== BLOCO PIX (alinhado ao grid da VIA 2) ===== */
            
            .bb-row-pix-area{
              display: flex;
              align-items: flex-start;
            }
            
            /* INSTRUÇÕES: ocupa exatamente 70% do formulário (como no modelo) */
            .col-instrucoes{
              width: 55%;
              padding: 6px;
              border-left: 4px solid #FFCC00;
              min-height: 135px;
              font-size: 8px;
              text-align:start;
            }
            
            /* divisor amarelo fino */
            .col-divisor-amarelo{
              width: 1mm;
              background: #FFCC00;
              min-height: 135px;
            }
            
            /* QR + valores juntos ocupam os 30% finais (lado direito alinhado) */
            .col-qrcode{
              width: 25%;
              padding: 6px 4px;
              display: flex;
              flex-direction: column;
              align-items: center;
              justify-content: center;
            
              overflow: hidden;     /* impede o QR de sair */
            }
            
            #qrcodeCanvas{
              display: flex;
              align-items: center;
              justify-content: center;
              width: 100%;
              max-width: 110px;     /* tamanho real desejado */
              height: auto;
            }
            
            /* força o canvas ou img gerado pelo QRCode */
            #qrcodeCanvas canvas,
            #qrcodeCanvas img{
              max-width: 100%;
              height: auto;
              display: block;
            }
            
            .pix-text{
              font-size: 8px;
              margin-top: 4px;
              font-weight: bold;
              color: #000;
            }
            
            /* coluna de valores ocupa os mesmos 15% finais e encosta no lado direito */
            .col-valores{
              width: 15%;
              font-size: 7px;
            }
            
            .amarelo{
              background: #f3f0c5;
            }
            
            .linha-total{
              background: #f3f0c5;
              font-weight: bold;
            }
            
            /* ===== BARCODE (proporção padrão BB) ===== */
            
            .bb-barcode-wrapper{
              margin-top: 0mm;        /* no seu estava muito alto */
              padding-left: 2mm;      /* aproxima da esquerda como no original */
              text-align: left;
            }
            
            /* O SVG precisa ter dimensões fixas para impressão */
            #barcode{
              width: 110mm;           /* no modelo real ocupa mais horizontal */
              height: 22mm;           /* mais baixo (igual ao original) */
              display: block;
            }
            
            /* Linha numérica do código de barras (ficando colada nas barras) */
            .bb-codbar{
              margin-top: -5mm;       /* aproxima do barcode (no seu estava -28px exagerado) */
              padding-left: 1mm;
              letter-spacing: 1.6px;  /* menos espaçado */
              font-size: 8px;
              color: #000;
              font-weight: normal;
            }
            
            /* ===== VIA 2: "bloco direito" igual ao modelo (Nosso número / Valor doc) ===== */
            :root{
              --bb-right-col: 47.5mm; /* mesma coluna de Vencimento/Agência */
            }
            
            .bb-v2-split{
              display: flex;
              width: 100%;
            }
            
            /* esquerda ocupa o restante */
            .bb-v2-left{
              display: flex;
              width: calc(100% - var(--bb-right-col));
            }
            
            /* direita é fixa e alinhada ao vencimento/agência */
            .bb-v2-right{
              width: var(--bb-right-col);
            }
            
            /* larguras da esquerda (em mm) para ficar igual ao BB */
            .g-data-doc   { width: 26mm; }
            .g-num-doc    { width: 40mm; }
            .g-esp-doc    { width: 20mm; }
            .g-aceite     { width: 14mm; }
            .g-data-proc  { width: calc(100% - (26mm + 40mm + 20mm + 14mm)); }
            
            /* linha 4 esquerda */
            .g-uso-banco    { width: 26mm; }
            .g-carteira     { width: 36mm; }
            .g-especie      { width: 20mm; }
            .g-quantidade   { width: 20mm; }
            .g-xvalor       { width: calc(100% - (26mm + 36mm + 20mm + 20mm)); }
            
            /* alinhamento à direita só dos valores do bloco direito */
            .bb-right{
              text-align: right;
              display: block;
              width: 100%;
            }
            /* VALORES: ocupa TODO o espaço restante até a borda direita */
            .col-valores{
              flex: 1;              /* <-- ESSENCIAL: ocupa o resto */
              min-width: 0;
              font-size: 7px;
              display: flex;
              flex-direction: column;
            }
            
            /* cada linha vai até o final */
            .linha-valor{
              width: 100%;
              border-bottom: 0.3mm solid #000;
              padding: 6px;
              border-left: 4px solid #FFCC00;
              display: flex;
              align-items: center;
              justify-content: flex-start;
              color: #000;
            }
            
            .linha-valor2{
              width: 100%;
              border-bottom: 0.3mm solid #000;
              padding: 9px;
              border-left: 4px solid #FFCC00;
              color: #0033A0;
              display: block; /* opcional, mas deixa explícito */
            }
            
            /* última linha com fundo */
            .linha-total{
              background: #f3f0c5;
              font-weight: bold;
              border-bottom: none;
            }
            ```
    }
    security {
        authentication: public
        deepLinking: false
        pageAccessProtection: unrestricted
    }

    region boleto (
        name: Boleto
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="bb-container">
                  <!-- CORTE SUPERIOR -->
                  <div class="bb-cut-text">Corte na linha pontilhada</div>
                  <div class="bb-cut-line"></div>
                  
                  <!-- ================= VIA 1 - RECIBO DO PAGADOR ================= -->
                  <div class="bb-via">
                    <div class="bb-recibo-label">Recibo do Pagador</div>
                    <div class="bb-topo">
                      <div class="bb-top-left">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/f/fb/Banco_do_Brasil_logo.svg/1280px-Banco_do_Brasil_logo.svg.png"
                             class="bb-logo" />
                        <div class="bb-codigo">001-9</div>
                      </div>
                      <div class="bb-linha" id="linhaFormatada1"></div>
                    </div>
                    <div class="bb-body">
                      <!-- BENEFICIÁRIO -->
                      <div class="bb-row bb-row-via1-top">
                        <div class="bb-col col-benef">
                            <div class="bb-label">Nome do Beneficiário/CNPJ/CPF</div>
                            <div class="bb-value"></div>
                        </div>
                        <div class="bb-col col-agencia">
                            <div class="bb-label">Agência / Código do Beneficiário</div>
                            <div class="bb-value-right"><br></div>
                        </div>
                        <div class="bb-col col-especie">
                            <div class="bb-label">Espécie</div>
                            <div class="bb-value-right"><br></div>
                        </div>
                        <div class="bb-col col-quantidade">
                            <div class="bb-label">Quantidade</div>
                            <div class="bb-value"> </div>
                        </div>
                        <div class="bb-col col-nosso-numero">
                            <div class="bb-label">Nosso número</div>
                            <div class="bb-value-right"></div>
                        </div>
                      </div>
                      
                      <!-- ENDEREÇO -->
                      <div class="bb-row">
                        <div class="bb-col w100">
                          <div class="bb-label">Endereço</div>
                          <div class="bb-value"><br></div>
                        </div>
                      </div>
                      
                      <!-- BLOCO DOCUMENTO -->
                      <div class="bb-row">
                        <div class="bb-col w20">
                          <div class="bb-label">Número do documento</div>
                          <div class="bb-value-right"></div>
                        </div>
                        <div class="bb-col w15">
                          <div class="bb-label">Contrato</div>
                          <div class="bb-value-right"></div>
                        </div>
                        <div class="bb-col w20">
                          <div class="bb-label">CPF/CNPJ</div>
                          <div class="bb-value-right"></div>
                        </div>
                        <div class="bb-col w15">
                          <div class="bb-label">Vencimento</div>
                          <div class="bb-value-right"></div>
                        </div>
                        <div class="bb-col w30">
                          <div class="bb-label">Valor documento</div>
                          <div class="bb-value-right"><br> </div>
                        </div>
                      </div>
                      
                      <!-- DESCONTOS -->
                      <div class="bb-row">
                        <div class="bb-col w20"><div class="bb-label">(-) Desconto / Abatimento</div><br></div>
                        <div class="bb-col w20"><div class="bb-label">(+) Outras deduções</div></div>
                        <div class="bb-col w20"><div class="bb-label">(+) Mora / Multa</div></div>
                        <div class="bb-col w20"><div class="bb-label">(+) Outros acréscimos</div></div>
                        <div class="bb-col w20 amarelo"><div class="bb-label">(=) Valor cobrado</div></div>
                      </div>
                      
                      <!-- PAGADOR -->
                      <div class="bb-row">
                        <div class="bb-col w100">
                          <div class="bb-label">Nome do Pagador</div>
                          <div class="bb-value"><br></div>
                        </div>
                      </div>
                    </div>
                  </div>
                
                  <!-- CORTE -->
                  <div class="bb-cut-text">Corte na linha pontilhada</div>
                  <div class="bb-cut-line"></div>
                
                  <!-- ================= VIA 2 - FICHA DE COMPENSAÇÃO ================= -->
                  <div class="bb-via">
                    <div class="bb-topo">
                      <div class="bb-top-left">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/f/fb/Banco_do_Brasil_logo.svg/1280px-Banco_do_Brasil_logo.svg.png"
                            class="bb-logo" />
                        <div class="bb-codigo">001-9</div>
                      </div>
                      <div class="bb-linha" id="linhaFormatada2"></div>
                    </div>
                    <div class="bb-body">
                      <!-- LINHA 1 -->
                      <div class="bb-row">
                        <div class="bb-col w75">
                          <div class="bb-label">Local de pagamento</div>
                          <div class="bb-value">QUALQUER BANCO ATÉ O VENCIMENTO</div>
                        </div>
                        <div class="bb-col w25 amarelo">
                          <div class="bb-label">Vencimento</div>
                          <div class="bb-value-right"></div>
                        </div>
                      </div>
                      
                      <!-- LINHA 2 -->
                      <div class="bb-row">
                        <div class="bb-col w75">
                          <div class="bb-label">Nome do Beneficiário/CNPJ/CPF</div>
                          <div class="bb-value"><br></div>
                        </div>
                        <div class="bb-col w25">
                          <div class="bb-label">Agência/Código Beneficiário</div>
                          <div class="bb-value-right"><br></div>
                        </div>
                      </div>
                      
                      <!-- LINHA 3 (técnica) -->
                      <div class="bb-row bb-v2-split">
                        <div class="bb-v2-left">
                          <div class="bb-col g-data-doc">
                            <div class="bb-label">Data do documento</div>
                            <div class="bb-value-right"></div>
                          </div>
                          <div class="bb-col g-num-doc">
                            <div class="bb-label">Nº do documento</div>
                            <div class="bb-value-right"></div>
                          </div>
                          <div class="bb-col g-esp-doc">
                            <div class="bb-label">Espécie doc.</div>
                            <div class="bb-value-right">DM</div>
                          </div>
                          <div class="bb-col g-aceite">
                            <div class="bb-label">Aceite</div>
                            <div class="bb-value-right">N</div>
                          </div>
                          <div class="bb-col g-data-proc">
                            <div class="bb-label">Data process.</div>
                            <div class="bb-value-right"></div>
                          </div>
                        </div>
                        <div class="bb-v2-right">
                          <div class="bb-col w100">
                            <div class="bb-label">Nosso número</div>
                            <div class="bb-value bb-right"></div>
                          </div>
                        </div>
                      </div>
                      
                      <!-- LINHA 4 -->
                      <div class="bb-row bb-v2-split">
                        <div class="bb-v2-left">
                          <div class="bb-col g-uso-banco amarelo">
                            <div class="bb-label">Uso do banco</div>
                            <div class="bb-value">&nbsp;</div>
                          </div>
                          <div class="bb-col g-carteira">
                            <div class="bb-label">Carteira</div>
                            <div class="bb-value-right"></div>
                          </div>
                          <div class="bb-col g-especie">
                            <div class="bb-label">Espécie</div>
                            <div class="bb-value-right"><br></div>
                          </div>
                          <div class="bb-col g-quantidade">
                            <div class="bb-label">Quantidade</div>
                            <div class="bb-value">&nbsp;</div>
                          </div>
                          <div class="bb-col g-xvalor">
                            <div class="bb-label">x Valor</div>
                            <div class="bb-value">&nbsp;</div>
                          </div>
                        </div>
                        <div class="bb-v2-right">
                          <div class="bb-col w100">
                            <div class="bb-label">(=) Valor documento</div>
                            <div class="bb-value bb-right"><br> </div>
                          </div>
                        </div>
                      </div>
                      
                      <!-- BLOCO INSTRUÇÕES + PIX + VALORES (mantendo estrutura visual) -->
                      <div class="bb-row bb-row-pix-area">
                        <div class="bb-col col-instrucoes">
                          <div class="bb-label">Instruções (Texto de responsabilidade do beneficiário)</div>
                          <div class="bb-value">
                            <br><br><br><br><br><br><br><br><br><br>
                          </div>
                        </div>
                        <div class="col-divisor-amarelo"></div>
                        <div class="col-qrcode">
                          <div id="qrcodeCanvas1"></div>
                          <div class="pix-text">Pague com PIX</div>
                        </div>
                        <div class="col-valores">
                          <div><div class="linha-valor2">(-) Desconto / Abatimento</div></div>
                          <div class="linha-valor2">(+) Outras deduções</div>
                          <div class="linha-valor2">(+) Mora / Multa</div>
                          <div class="linha-valor2">(+) Outros acréscimos</div>
                          <div class="linha-valor2 linha-total">(=) Valor cobrado</div>
                        </div>
                      </div>
                      
                      <!-- PAGADOR FINAL -->
                      <div class="bb-row">
                        <div class="bb-col w100">
                          <div class="bb-label">Nome do Pagador/CPF/Endereço</div>
                          <div class="bb-value">
                            <br><br><br>
                          </div>
                        </div>
                      </div>
                      
                      <div class="bb-row">
                        <div class="bb-col w70">
                          <div class="bb-label">Pagador/Avalista</div>
                          <br>
                        </div>
                        <div class="bb-col w30">
                          <div class="bb-label">Cód. baixa</div>
                        </div>
                      </div>
                      
                      <!-- BARCODE (mantendo wrapper para layout) -->
                      <div class="bb-barcode-wrapper">
                        <!-- svg removido, mas div mantida para preservar altura/espaçamento -->
                      </div>
                      
                      <div class="bb-auth">
                        Autenticação mecânica - Ficha de Compensação
                      </div>
                    </div>
                    <div class="bb-cut-line1"></div>
                  </div>
                </div>
                ```
        }
        layout {
            sequence: 270
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
