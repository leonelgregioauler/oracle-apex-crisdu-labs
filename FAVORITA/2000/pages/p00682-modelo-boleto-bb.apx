    process buscadadosboleto (
        name: BuscaDadosBoleto
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  l_ld_raw   VARCHAR2(200);
                  l_ld       VARCHAR2(60);
                BEGIN
                  SELECT 
                       bol.cliente
                     , bol.valorcobrado
                     , bol.datavencimento
                     , bol.dataemissao
                     , bol.numerodoc as nossonumero
                     , bol.numero as numero_documento
                     , bol.convenio as contrato
                     , bol.linhadigitavel
                     , dad.cpf_cnpj as cnpj_beneficiario
                     , dad.endereco_beneficiario
                     , dad.conta
                     , dad.agencia
                     , dad.carteira
                     , dad.variacao_carteira
                     , dad.identificacao as beneficiario
                     , dad.cidade_uf as cidade_estado_beneficiario
                     , bol.endereco || ' - ' || bol.endereco2
                  INTO 
                       :P682_PAGADOR
                     , :P682_VALOR
                     , :P682_VENCIMENTO
                     , :P682_EMISSAO
                     , :P682_NOSSO_NUMERO
                     , :P682_NUMERODOC
                     , :P682_CONVENIO
                     , :P682_LINHA_DIGITAVEL
                     , :P682_CNPJBENEF
                     , :P682_ENDERECOBENEF
                     , :P682_CONTA
                     , :P682_AGENCIA
                     , :P682_CARTEIRA
                     , :P682_VARIACAOCARTEIRA
                     , :P682_BENEFICIARIO
                     , :P682_CIDADE_UF_BENEF
                     , :P682_ENDERECO
                  FROM favorita.vw_boletos_fav bol
                  JOIN favorita.conveniosdados dad 
                    ON bol.convenio = dad.codigo_convenio
                  WHERE (
                        :P682_IDPEDIDO IS NOT NULL
                        AND bol.idpedido = :P682_IDPEDIDO
                        AND bol.idvendedora = :P682_IDVENDEDORA
                      )
                   OR (
                        :P682_IDPEDIDO IS NULL
                        AND numerodoc = '37441450000061583'
                      )
                   order by bol.datavencimento desc
                   fetch first 1 rows only;
                
                  /* ========= Monta COD_BARRA (44) a partir da LINHA DIGITÁVEL ========= */
                  l_ld_raw := :P682_LINHA_DIGITAVEL;
                
                  -- remove pontos, espaços, etc (fica só número)
                  l_ld := REGEXP_REPLACE(NVL(l_ld_raw, ''), '[^0-9]', '');
                
                  IF LENGTH(l_ld) = 47 THEN
                    -- boleto bancário (FEBRABAN 47 -> 44)
                    :P682_COD_BARRA :=
                         SUBSTR(l_ld, 1, 4)          -- banco + moeda
                      || SUBSTR(l_ld, 33, 1)         -- DV geral (posição 33 da linha digitável)
                      || SUBSTR(l_ld, 34, 14)        -- fator vencimento + valor (pos 34-47)
                      || SUBSTR(l_ld, 5, 5)          -- campo livre parte 1 (sem DV do campo 1)
                      || SUBSTR(l_ld, 11, 10)        -- campo livre parte 2 (sem DV do campo 2)
                      || SUBSTR(l_ld, 22, 10);       -- campo livre parte 3 (sem DV do campo 3)
                
                  ELSIF LENGTH(l_ld) = 44 THEN
                    -- já veio como código de barras
                    :P682_COD_BARRA := l_ld;
                
                  ELSE
                    -- formato inesperado (47 é o esperado pro boleto bancário)
                    :P682_COD_BARRA := NULL;
                  END IF;
                
                  :P682_QR_EMV := '00020101021226920014br.gov.bcb.pix2570qrcodepix-h.bb.com.br/pix/v2/cobv/4e4b37bd-2987-4f9e-8340-e7920f028d53520400005303986540576.485802BR5919PADARIA PESSOA ROSA6008BRASILIA62070503***63044D3B';
                
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 40417135986744522
        }
        serverSideCondition {
            type: item=value
            item: 1
            value: 2
        }
    )

)

