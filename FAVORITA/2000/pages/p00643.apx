    region ligações-detalhadas (
        name: Ligações Detalhadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT distinct l.DATA_LIGACAO DATA
                     , l.HORA_LIGACAO "HORÁRIO"
                     , l.OPERADOR
                     , tl.TEMPO "TEMPO LOGADO"
                     , tp.TEMPO PAUSAS
                     , l.REGIAO "REGIÃO"
                     , l.TIPO_TAREFA "TIPO DE TAREFA"
                     , tml.TEMPO_LIGACOES "TEMPO TOTAL TAREFA"
                --     , tm.TEMPO_LIGACOES "TEMPO TOTAL TAREFA"
                     , l.IDTAREFA "NR TAREFA"
                     , l.NOME
                     , l.CPF
                     , l.TELEFONE
                     , l.FINALIZACAO "FINALIZAÇÃO"
                     , tm.VLR_PROMESSAS "R$ TOTAL PROMESSA"
                     , tm.QTD_EFETIVO "CONTATOS EFETIVOS"
                     , CASE
                         WHEN tm.QTD_EFETIVO > 0 THEN ROUND((tm.QTD_PROMESSAS / tm.QTD_EFETIVO) * 100,2)
                         ELSE 0
                       END "%CONVERSÃO"
                FROM (  SELECT TRUNC(lpf.DATA_LIGACAO) DATA_LIGACAO
                              , TO_CHAR(lpf.DATA_LIGACAO,'HH24:MI') HORA_LIGACAO
                              , lpf.COD_USUARIO
                              , lpf.COD_PROSPECT
                              , pes.NOME OPERADOR
                              , de.REGIAO_GEOGRAFICA REGIAO
                              , po.COLUNA_20 TIPO_TAREFA
                              , PO.COLUNA_19 IDTAREFA 
                              , p.NOME
                              , p.CPF
                              , lpf.DDD||lpf.FONE TELEFONE
                              , css.NOME FINALIZACAO
                          FROM  BEECOBRANCA.LOG_PROSPECTS_FONES lpf
                              , BEECOBRANCA.PROSPECTS_ORIGINAL po
                              , BEECOBRANCA.PROSPECTS p
                              , BEEADMIN.USUARIOS u
                              , BEEPEOPLE.VW_PESSOAS pes
                              , BEEDIALER.CONTROLE_STATUS_SISTEMAS CSS
                              , (SELECT de.DDD
                                      , MIN(REGIAO_GEOGRAFICA) REGIAO_GEOGRAFICA 
                                 FROM   BEEDIALER.DDDS_ESTADOS de 
                                 GROUP BY de.DDD) de
                          WHERE  lpf.DATA_LIGACAO BETWEEN TO_DATE(:P643_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') 
                                                      AND TO_DATE(:P643_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                            AND  lpf.COD_CAMPANHA = po.COD_CAMPANHA 
                            AND  lpf.COD_PROSPECT = po.CODIGO
                            AND  po.COD_CAMPANHA  = p.COD_CAMPANHA 
                            AND  po.CODIGO        = p.CODIGO
                            AND  lpf.COD_USUARIO  = u.CODIGO
                            AND  u.COD_PESSOA     = pes.CODIGO 
                            AND  u.EMPRESA        = pes.EMPRESA
                            AND  lpf.COD_STATUS   = css.CODIGO
                            AND  lpf.DDD          = de.DDD) l    
                    ,(  SELECT u.CODIGO COD_USUARIO
                             , cf.DATA
                             , BEEADMIN.RETORNA_SEGUNDOS_EM_HORAS(SUM((NVL(cf.DATA_SAIDA_EFETIVA,cf.DATA_SAIDA_PREVISTA) - cf.DATA_ENTRADA_EFETIVA) * 86400)) TEMPO
                        FROM   BEEPEOPLE.CONTROLE_FREQUENCIA cf
                             , BEEADMIN.USUARIOS u
                        WHERE  cf.DATA BETWEEN TO_DATE(:P643_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') 
                                           AND TO_DATE(:P643_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                          AND cf.DATA_ENTRADA_EFETIVA IS NOT NULL
                          AND cf.COD_PESSOA = u.COD_PESSOA 
                          AND cf.EMPRESA = u.EMPRESA
                        GROUP BY u.CODIGO
                               , cf.DATA) tl
                   ,(   SELECT cu.COD_USUARIO
                             , TRUNC(cu.DATA_INICIO) DATA
                             , BEEADMIN.RETORNA_SEGUNDOS_EM_HORAS(SUM((cu.DATA_TERMINO - cu.DATA_INICIO) * 86400)) TEMPO
                         FROM  BEEPEOPLE.COMPROMISSOS_USUARIOS cu
                         WHERE cu.DATA_INICIO BETWEEN TO_DATE(:P643_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') 
                                                  AND TO_DATE(:P643_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                           AND cu.DATA_TERMINO IS NOT NULL
                          GROUP BY cu.COD_USUARIO
                                 , TRUNC(cu.DATA_INICIO)) tp 
                   ,(   SELECT x.DATA_LIGACAO
                             , x.COD_USUARIO
                             , x.QTD QTD_PROMESSAS
                             , x.VALOR VLR_PROMESSAS
                             , ( SELECT COUNT(1)
                                 FROM   BEECOBRANCA.LOG_PROSPECTS_FONES lpf
                                      , BEEDIALER.CONTROLE_STATUS_SISTEMAS css
                                 WHERE  lpf.COD_USUARIO = x.COD_USUARIO
                                   AND  lpf.COD_STATUS = css.CODIGO
                                   AND  lpf.DATA_LIGACAO BETWEEN x.DATA_LIGACAO AND x.DATA_LIGACAO + 1 - (1/86400)
                                   AND  css.EFETIVO = 1) QTD_EFETIVO
                             , ( SELECT BEEADMIN.RETORNA_SEGUNDOS_EM_HORAS(SUM(lpf.TEMPO_LIGACAO)) TEMPO
                                 FROM   BEECOBRANCA.LOG_PROSPECTS_FONES lpf
                                 WHERE  lpf.COD_USUARIO = x.COD_USUARIO
                                   AND  lpf.DATA_LIGACAO BETWEEN x.DATA_LIGACAO AND x.DATA_LIGACAO + 1 - (1/86400)) TEMPO_LIGACOES
                        FROM ( SELECT TRUNC(p.DATA_ULTIMO_RESGATE) DATA_LIGACAO
                                    , p.COD_USUARIO
                                    , COUNT(DISTINCT po.COLUNA_19) QTD
                                    , SUM(cp.VALOR) VALOR
                                FROM  BEECOBRANCA.PROSPECTS p
                                    , BEECOBRANCA.PROSPECTS_ORIGINAL po
                                    , BEECOBRANCA.CLIENTES_PRODUTOS cp
                                    , BEEDIALER.CONTROLE_STATUS_SISTEMAS CSS
                                WHERE po.COD_CAMPANHA = p.COD_CAMPANHA 
                                  AND po.CODIGO       = p.CODIGO
                                  AND cp.COD_CAMPANHA = po.COD_CAMPANHA 
                                  AND cp.COD_PROSPECT = po.CODIGO
                                  AND p.COD_STATUS    = css.CODIGO
                                  AND css.CONVERSAO_PRE+css.CONVERSAO_AUDITADA > 0
                                  AND p.DATA_ULTIMO_RESGATE BETWEEN TO_DATE(:P643_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') 
                                                                AND TO_DATE(:P643_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                                GROUP BY TRUNC(p.DATA_ULTIMO_RESGATE)
                                       , p.COD_USUARIO ) x
                                       ) tm
                   --
                   ,(   SELECT x.DATA_LIGACAO
                             , x.COD_USUARIO
                             , x.COD_PROSPECT
                             , ( SELECT BEEADMIN.RETORNA_SEGUNDOS_EM_HORAS(SUM(lpf.TEMPO_LIGACAO)) TEMPO
                                 FROM   BEECOBRANCA.LOG_PROSPECTS_FONES lpf
                                 WHERE  lpf.COD_USUARIO  = x.COD_USUARIO
                                 AND    lpf.Cod_Prospect = x.COD_PROSPECT
                                   AND  lpf.DATA_LIGACAO BETWEEN x.DATA_LIGACAO AND x.DATA_LIGACAO + 1 - (1/86400)) TEMPO_LIGACOES
                        FROM ( SELECT TRUNC(p.DATA_ULTIMO_RESGATE) DATA_LIGACAO
                                    , p.COD_USUARIO
                                    , po.CODIGO COD_PROSPECT
                                FROM  BEECOBRANCA.PROSPECTS p
                                    , BEECOBRANCA.PROSPECTS_ORIGINAL po
                                    , BEECOBRANCA.CLIENTES_PRODUTOS cp
                                    , BEEDIALER.CONTROLE_STATUS_SISTEMAS CSS
                                WHERE po.COD_CAMPANHA = p.COD_CAMPANHA 
                                  AND po.CODIGO       = p.CODIGO
                                  AND cp.COD_CAMPANHA = po.COD_CAMPANHA 
                                  AND cp.COD_PROSPECT = po.CODIGO
                                  AND p.COD_STATUS    = css.CODIGO
                                  AND css.CONVERSAO_PRE+css.CONVERSAO_AUDITADA > 0
                                  AND p.DATA_ULTIMO_RESGATE BETWEEN TO_DATE(:P643_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') 
                                                                AND TO_DATE(:P643_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                                 ) x
                                       ) tml
                   --                       
                WHERE l.COD_USUARIO   = tl.COD_USUARIO (+)
                  AND l.DATA_LIGACAO  = tl.DATA (+) 
                  AND l.COD_USUARIO   = tp.COD_USUARIO (+)
                  AND l.DATA_LIGACAO  = tp.DATA (+)
                  AND l.DATA_LIGACAO  = tm.DATA_LIGACAO (+)  
                  AND l.COD_USUARIO   = tm.COD_USUARIO  (+)
                  AND l.DATA_LIGACAO  = tml.DATA_LIGACAO (+)  
                  AND l.COD_USUARIO   = tml.COD_USUARIO  (+)
                  AND l.COD_PROSPECT  = tml.COD_PROSPECT (+)
                ORDER BY 3, 1, 2
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
