        }
        behavior {
            target: {
                page: 643
                items: {
                    P643_DATAINICIO: &P643_DATAINICIO.
                    P643_DATAFIM: &P643_DATAFIM.
                    P643_TIPORELATORIO: &P643_TIPORELATORIO.
