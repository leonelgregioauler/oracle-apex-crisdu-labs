    region ligações-consolidadas (
        name: Ligações Consolidadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select trunc(l.data_ligacao)                   as data                         --> Deve indicar o dia que o registro telefonico aconteceu
                     , r.regiao                                as regiao                       --> Indica para qual região foi feita a ligação
                     , p.coluna_20                             as tipo_de_tarefa               --> Indica o tipo de tarefa para qual a ligação foi feita
                     , count(*)                                as quantidade_de_ligacoes       --> Quantidade total de ligações realizadas no dia 
                     , count( distinct p.coluna_19)            as quantidade_de_tarefas        --> Indica quantas tarefa foram atendidas para as ligações realizadas
                     , sum(c.efetivo)                          as quantidade_ligacoes_efetiva  --> Indica quantas das ligações foram efetivas
                     , sum(c.conversao_pre+conversao_auditada) as Promessas                    --> Indica a quantidade de promessas
                  from beecobranca.log_prospects_fones     l
                     , beecobranca.prospects_original      p
                     , beedialer.controle_status_sistemas  c
                     , (select ddd, min(regiao_geografica) regiao from beedialer.ddds_estados group by ddd) r
                 where r.ddd(+)           = l.ddd
                   and p.cod_campanha     = l.cod_campanha
                   and p.codigo           = l.cod_prospect
                   and c.codigo           = l.cod_status
                   and l.data_ligacao     between to_date(:P643_datainicio||' 00:00:00','DD/MM/RRRR HH24:MI:SS') and to_date(:P643_datafim||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                 group by trunc(l.data_ligacao)
                        , r.regiao
                        , p.coluna_20
                 order by trunc(l.data_ligacao)
                        , r.regiao
                
                
                
                /*
                    Maicon Aimi - 9144009 26/09/2024
                    Essa era query usanda anteriormente no relatório, deixado temporariamente para servir como historico, 
                
                
                SELECT 
                    l.DATA_LIGACAO "DATA"
                    , hc.QTD "HC ATIVOS"
                    , l.REGIAO "REGIÃO"
                    , l.TIPO_TAREFA "TIPO DE TAREFA"
                    , l.TAREFAS
                    , l.LIGACOES "LIGAÇÕES"
                    , l.EFETIVO "CONTATOS EFETIVOS"
                    , CASE
                        WHEN l.EFETIVO > 0 THEN ROUND((l.EFETIVO / l.LIGACOES) * 100,2)
                        ELSE 0
                      END "% EFETIVO/LIGAÇÕES"
                    , l.CONVERSAO "PROMESSAS"
                    , CASE
                        WHEN l.CONVERSAO > 0 THEN ROUND((l.CONVERSAO / l.EFETIVO) * 100,2)
                        ELSE 0
                      END "% CONVERSÃO/EFETIVO"
                    , ROUND(tm.TICKET_MEDIO,2) "TICKET MÉDIO"
                FROM (SELECT x.DATA_LIGACAO
                            , COUNT(DISTINCT x.IDTAREFA) TAREFAS
                            , x.REGIAO
                            , x.TIPO_TAREFA
                            , COUNT(1) LIGACOES
                            , SUM(x.EFETIVO) EFETIVO
                            , SUM(x.CONVERSAO) CONVERSAO
                        FROM
                            (SELECT TRUNC(lpf.DATA_LIGACAO) DATA_LIGACAO
                                   , PO.COLUNA_19 IDTAREFA
                                   , de.REGIAO_GEOGRAFICA REGIAO
                                   , po.COLUNA_20 TIPO_TAREFA
                                   , 1 LIGACOES
                                   , CSS.EFETIVO 
                                   , CSS.CONVERSAO_PRE+CSS.CONVERSAO_AUDITADA CONVERSAO
                             FROM    BEECOBRANCA.LOG_PROSPECTS_FONES lpf
                                   , BEECOBRANCA.PROSPECTS_ORIGINAL  PO
                                   , BEEDIALER.CONTROLE_STATUS_SISTEMAS CSS
                                   , (SELECT de.DDD, MIN(REGIAO_GEOGRAFICA) REGIAO_GEOGRAFICA 
                                      FROM BEEDIALER.DDDS_ESTADOS de GROUP BY de.DDD) de
                             WHERE lpf.COD_CAMPANHA = po.COD_CAMPANHA 
                               AND lpf.COD_PROSPECT = po.CODIGO
                               AND lpf.COD_STATUS   = css.CODIGO
                               AND lpf.DDD          = de.DDD
                               AND lpf.DATA_LIGACAO BETWEEN TO_DATE(:P643_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') 
                                                        AND TO_DATE(:P643_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                            ) x
                        GROUP BY
                            x.DATA_LIGACAO
                            , x.REGIAO
                            , x.TIPO_TAREFA) l
                    ,(SELECT 
                            TRUNC(lpf.DATA_LIGACAO) DATA_LIGACAO
                            , po.COLUNA_20 TIPO_TAREFA
                            , de.REGIAO_GEOGRAFICA REGIAO
                            , COUNT(DISTINCT cda.DOCUMENTO) QTD
                        FROM BEECOBRANCA.LOG_PROSPECTS_FONES lpf
                           , BEECOBRANCA.PROSPECTS_ORIGINAL  po
                           , BEECOBRANCA.CLIENTES_DOCUMENTOS_ACERTO cda
                           , (SELECT de.DDD, MIN(REGIAO_GEOGRAFICA) REGIAO_GEOGRAFICA 
                                FROM BEEDIALER.DDDS_ESTADOS de GROUP BY de.DDD) de
                        WHERE lpf.COD_CAMPANHA = po.COD_CAMPANHA 
                          AND lpf.COD_PROSPECT = po.CODIGO
                          AND po.COD_CAMPANHA = cda.COD_CAMPANHA 
                          AND po.CODIGO       = cda.COD_PROSPECT
                          AND lpf.DDD         = de.DDD
                          AND lpf.DATA_LIGACAO BETWEEN TO_DATE(:P643_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') 
                                                   AND TO_DATE(:P643_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                        GROUP BY
                            TRUNC(lpf.DATA_LIGACAO)
                            , po.COLUNA_20
                            , de.REGIAO_GEOGRAFICA
                    ) hc 
                    ,( SELECT
                            x.DATA_LIGACAO
                            , COUNT(DISTINCT x.IDTAREFA) TAREFAS
                            , x.REGIAO
                            , x.TIPO_TAREFA
                            , AVG(VALOR) TICKET_MEDIO
                        FROM
                            (
                                SELECT
                                    TRUNC(p.DATA_ULTIMO_RESGATE) DATA_LIGACAO
                                    , PO.COLUNA_19 IDTAREFA
                                    , de.REGIAO_GEOGRAFICA REGIAO
                                    , po.COLUNA_20 TIPO_TAREFA
                                    , SUM(cp.VALOR) VALOR
                                FROM  BEECOBRANCA.PROSPECTS p
                                   ,  BEECOBRANCA.PROSPECTS_ORIGINAL po
                                   ,  BEECOBRANCA.CLIENTES_PRODUTOS cp
                                   ,  BEEDIALER.CONTROLE_STATUS_SISTEMAS CSS
                                   ,  (SELECT de.DDD, MIN(REGIAO_GEOGRAFICA) REGIAO_GEOGRAFICA 
                                         FROM BEEDIALER.DDDS_ESTADOS de GROUP BY de.DDD) de
                                WHERE po.COD_CAMPANHA = p.COD_CAMPANHA 
                                  AND po.CODIGO       = p.CODIGO
                                  AND cp.COD_CAMPANHA = po.COD_CAMPANHA 
                                  AND cp.COD_PROSPECT = po.CODIGO
                                  AND p.COD_STATUS    = css.CODIGO
                                  AND p.DDD_FINAL     = de.DDD
                                  AND css.CONVERSAO_PRE+css.CONVERSAO_AUDITADA > 0
                                  AND p.DATA_ULTIMO_RESGATE BETWEEN TO_DATE(:P643_DATAINICIO||' 00:00:00','DD/MM/RRRR HH24:MI:SS') 
                                                                AND TO_DATE(:P643_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                                GROUP BY 
                                    TRUNC(p.DATA_ULTIMO_RESGATE)
                                    , PO.COLUNA_19 
                                    , de.REGIAO_GEOGRAFICA
                                    , po.COLUNA_20
                            ) x
                        GROUP BY
                            x.DATA_LIGACAO
                            , x.REGIAO
                            , x.TIPO_TAREFA
                    ) tm 
                where hc.DATA_LIGACAO = l.DATA_LIGACAO 
                  and hc.TIPO_TAREFA  = l.TIPO_TAREFA 
                  AND hc.REGIAO       = l.REGIAO    
                  and tm.DATA_LIGACAO = l.DATA_LIGACAO 
                  and tm.TIPO_TAREFA  = l.TIPO_TAREFA 
                  AND tm.REGIAO       = l.REGIAO
                ORDER BY 1,3,4
                */
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <div style="font-family: Arial, sans-serif; font-size: 12px; color: #4a4a4a; text-align: left; padding: 5px; border: 1px solid #b3b3b3; background-color: #f2f2f2; margin-bottom: 30px;">
                  <ul style="list-style-type: disc; padding-left: 5px;">
                    <li style="line-height: 1.5;"><strong>Ligações:</strong> Total de ligações realizadas no dia, incluindo as que não foram atendidas.</li>
                    <li style="line-height: 1.5;"><strong>Tarefas:</strong> Total de tarefas relacionadas às ligações feitas no dia.</li>
                    <li style="line-height: 1.5;"><strong>Contatos Efetivos:</strong> Total de ligações atendidas pelo contato.</li>
                    <li style="line-height: 1.5;"><strong>Promessas:</strong> Total de ligações que resultaram em promessas de negociação.</li>
                  </ul>
                </div>
                
                ```
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P643_FILTRAR = 'S' and :P643_TIPORELATORIO = 'C'
        }
