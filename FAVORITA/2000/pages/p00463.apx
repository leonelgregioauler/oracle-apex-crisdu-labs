page 463 (
    name: Pedidos Pendentes para Integrar
    title: Pedidos Pendentes para Integrar
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region relação-de-pedidos (
        name: Relação de Pedidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpedido
                     , p.nomeusuario 
                     , p.representante
                     , p.vendedora
                     , p.dataemissao
                     , p.valortotal
                     , p.valortotalcomdesconto
                     , p.valorapagar
                from vw_pedidos_fav p
                where p.idfilialfavorita = :P463_IDFILIALFAVORITA
                  and p.idpedidovirtualage is null
                  and p.idsituacaoentrega >= 55000
                  and p.datacancelamento is null
                  and p.idtransacaovirtualage is null
                  and exists ( select 1
                               from filiaisfavorita ff
                               where ff.idfilialfavorita = p.idfilialfavorita
                                 and ff.tipofilial       = 'L' )
                  --and trunc(p.dataemissao) >= to_date('10/08/2020','DD/MM/RRRR')
                  and trunc(p.dataemissao) >= to_date('11/01/2024','DD/MM/RRRR') -- ajuste realizado pelo ticket 8601761 no dia 24/01/2024 --BRUNOB
                  and not exists ( select 1
                                   from classificacoespedidos cp
                                   where cp.idcaracteristicapedido = 43
                                     and cp.idpedido               = p.idpedido )
                  and not exists ( select 1
                                   from vendedoras v
                                      , pessoas pp
                                   where v.idvendedora = p.idvendedora
                                     and v.idpessoa    = pp.idpessoa
                                     and pp.idpais     = 1
                                     and pp.cpf        is null
                                     and pp.documentoestrangeiro is not null )
                  and not exists ( select 1
                                   from classificacoespedidos cp
                                   where cp.idcaracteristicapedido = 73
                                     and cp.idpedido               = p.idpedido )
                  and not exists ( select 1
                                   from classificacoespedidos cp
                                   where cp.idcaracteristicapedido = 8
                                     and cp.idvalorcaracteristica in (11,29)
                                     and cp.idpedido               = p.idpedido )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum pedido pendente para integrar!
        }
        advanced {
            savedReportMappingIdentifier: 67015826988041822
        }

        column DATAEMISSAO (
            type: plainText
            heading {
                heading: Data Emissão
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: E
            }
        )

        column IDPEDIDO (
            type: link
            heading {
                heading: Pedido
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 68
                    items: {
                        P68_IDPEDIDO: #IDPEDIDO#
                    }
                    action: resetPagination
                }
                linkText: #IDPEDIDO#
                linkAttributes: target="_blank"
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column NOMEUSUARIO (
            type: plainText
            heading {
                heading: Feito por
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column REPRESENTANTE (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column VALORAPAGAR (
            type: plainText
            heading {
                heading: A Pagar
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column VALORTOTAL (
            type: plainText
            heading {
                heading: Valor Total
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column VALORTOTALCOMDESCONTO (
            type: plainText
            heading {
                heading: Total Desconto
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column VENDEDORA (
            type: plainText
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 47358707 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAEMISSAO (
                sequence: 5
            )

            displayColumn IDPEDIDO (
                sequence: 1
            )

            displayColumn NOMEUSUARIO (
                sequence: 2
            )

            displayColumn REPRESENTANTE (
                sequence: 3
            )

            displayColumn VALORAPAGAR (
                sequence: 8
            )

            displayColumn VALORTOTAL (
                sequence: 6
            )

            displayColumn VALORTOTALCOMDESCONTO (
                sequence: 7
            )

            displayColumn VENDEDORA (
                sequence: 4
            )

        )

    )

    pageItem P463_IDFECHAMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @relação-de-pedidos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P463_IDFILIALFAVORITA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @relação-de-pedidos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

