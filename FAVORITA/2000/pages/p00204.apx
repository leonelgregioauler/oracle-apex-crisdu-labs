    pageItem P204_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(idrepresentante) display_value
                     , idrepresentante return_value
                from representantes r
                where r.idgerente = ( select idgerente
                                      from usuarios u
                                      where u.idusuario = :P0_IDUSUARIO )
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Todos -
        }
        cascadingLov {
            parentItems: P0_IDUSUARIO
            itemsToSubmit: P0_IDUSUARIO
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
