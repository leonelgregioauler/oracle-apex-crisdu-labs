    region promissórias-recebidas (
        name: Promissórias Recebidas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.numeropedido
                     , p.representante
                     , p.vendedora
                     , p.dataemissao
                     , p.dataentrega
                     , ( select trunc(cp.dataclassificado)
                         from classificacoespedidos cp
                         where cp.idpedido = p.idpedido
                         and cp.idcaracteristicapedido = 15 ) datarecebimentopromissoria
                     , ( select ct.numero||'- NF: '||ct.notafiscal remessa
                         from pedidosremessasct pr
                            , comprastransferencias ct
                         where pr.idcompratransferencia = ct.idcompratransferencia 
                         and pr.idpedido = p.idpedido ) remessa
                     , p.valortotal
                     , nvl(p.valorapagar,0) valorapagar
                     , case 
                         when ( select 1
                                from classificacoespedidos cp
                                where cp.idpedido = p.idpedido 
                                and cp.idcaracteristicapedido = 15) = 1 then
                           ( select c.dataclassificado||' por '||c.usuario
                             from vw_classificacoespedidos_fav c
                             where c.ididioma = :P0_IDIDIOMA
                               and c.idpedido = p.idpedido
                               and c.idcaracteristicapedido = 15 )
                         else
                           ' Promissória não recebida! '
                       end recebimento
                     , case
                         when ( select 1
                                from classificacoespedidos cp
                                where cp.idpedido = p.idpedido 
                                and cp.idcaracteristicapedido = 70) = 1 then
                           ( select c.dataclassificado||' por '||c.usuario
                             from vw_classificacoespedidos_fav c
                             where c.ididioma = :P0_IDIDIOMA
                               and c.idpedido = p.idpedido
                               and c.idcaracteristicapedido = 70 )
                         else
                           ' Não '
                       end promissoriacobranca
                     , case
                         when ( select 1
                                from classificacoespedidos cp
                                where cp.idpedido = p.idpedido 
                                and cp.idcaracteristicapedido = 71 ) = 1 then
                           ( select c.dataclassificado||' por '||c.usuario
                             from vw_classificacoespedidos_fav c
                             where c.ididioma = :P0_IDIDIOMA
                               and c.idpedido = p.idpedido
                               and c.idcaracteristicapedido = 71 )
                         else
                           ' Não '
                       end recebimentocobranca
                from vw_pedidos_fav p
                where p.ididioma        = :P0_IDIDIOMA
                  and p.idsituacaoentrega > 40000
                  and p.idfilialromance = roman.pck_romance.fnc_filialusuario(v('APP_USER'))
                  and :P204_RECEBIDA is not null
                  and not exists ( select 1
                                   from favorita.classificacoespedidos cp
                                   where cp.idpedido = p.idpedido
                                     and cp.idcaracteristicapedido = 25)
                  and ( ( :P204_RECEBIDA = 'S' 
                         and p.datarecebimentopromissoria is not null
                         and trunc(p.datarecebimentopromissoria) between to_date(:P204_DATARECEBIMENTOINICIAL,'DD/MM/RRRR') and to_date(:P204_DATARECEBIMENTOFINAL,'DD/MM/RRRR') )
                    or ( :P204_RECEBIDA = 'N' 
                         and p.datarecebimentopromissoria is null
                         and trunc(p.dataentrega) between to_date(:P204_DATAENTREGAINICIAL,'DD/MM/RRRR') and to_date(:P204_DATAENTREGAFINAL,'DD/MM/RRRR') ) ) 
                  and ( ( :P204_ENVIADOCOBRANCA = 'A' )
                        or ( :P204_ENVIADOCOBRANCA = 'N' and not exists ( select 1
                                                                          from classificacoespedidos c
                                                                          where c.idcaracteristicapedido = 70
                                                                            and c.idpedido               = p.idpedido ) )
                        or ( :P204_ENVIADOCOBRANCA = 'S' and exists ( select 1
                                                                      from classificacoespedidos c
                                                                      where c.idcaracteristicapedido = 70
                                                                        and c.idpedido               = p.idpedido ) ) )
                  and ( :P204_IDREPRESENTANTE is null or p.idrepresentante = :P204_IDREPRESENTANTE )
                  and ( :P204_IDVENDEDORA is null or p.idvendedora = :P204_IDVENDEDORA )
                  and ( :P204_IDPEDIDO is null or p.idpedido = :P204_IDPEDIDO )
                  and ( :P204_REMESSA  is null or exists ( select 1
                                                           from pedidosremessasct pr
                                                              , comprastransferencias ct
                                                           where pr.idcompratransferencia = ct.idcompratransferencia 
                                                             and pr.idpedido = p.idpedido
                                                             and ct.idcompratransferencia = :P204_REMESSA ))
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
