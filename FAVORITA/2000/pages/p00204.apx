    )

    pageItem P204_IDVENDEDORA (
        type: popupLov
        label {
            label: Vendedora
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) ||' - '||
                         case
                            when p.cpf is not null then
                                'CPF: '||p.cpf
                            else
                              'Doc. Estr.'||p.documentoestrangeiro
                            end
                                ||' - '||p.documentoestrangeiro||'  ID: '||v.idvendedora      display_value
                     , v.idvendedora return_value
                from catal.vendedoras v
                   , catal.pessoas    p
                where v.idpessoa = p.idpessoa
                  and ( :P204_IDREPRESENTANTE is null or v.idrepresentante = :P204_IDREPRESENTANTE )
                order by 1
                
                ```
            displayExtraValues: false
            nullDisplayValue: - Todos -
        }
        cascadingLov {
            parentItems: P204_IDREPRESENTANTE
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P204_RECEBIDA (
        type: radioGroup
