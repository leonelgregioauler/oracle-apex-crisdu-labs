    dynamicAction exibir-filtro-de-datas-para-promissórias-recebidas (
        name: Exibir Filtro de Datas para Promissórias Recebidas
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P204_RECEBIDA
        }
        clientSideCondition {
            type: item=value
            item: P204_RECEBIDA
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P204_DATAENTREGAINICIAL
                    P204_DATAENTREGAFINAL
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P204_DATARECEBIMENTOINICIAL
                    P204_DATARECEBIMENTOFINAL
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction ocultar-filtro-datas-promissória-não-recebidas (
        name: Ocultar Filtro Datas Promissória não Recebidas
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P204_RECEBIDA
        }
        clientSideCondition {
            type: item=value
            item: P204_RECEBIDA
            value: N
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P204_DATARECEBIMENTOINICIAL
                    P204_DATARECEBIMENTOFINAL
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P204_DATAENTREGAINICIAL
                    P204_DATAENTREGAFINAL
                ]
            }
            execution {
                sequence: 20
            }
        )

    )

    validation data-entrega-final (
        name: Data Entrega Final
        execution {
            sequence: 60
        }
        validation {
            type: itemIsNotNull
            item: P204_DATAENTREGAFINAL
        }
        error {
            errorMessage: Filtro de Data Obrigatório!
            associatedItem: @P204_DATAENTREGAFINAL
        }
        serverSideCondition {
            type: item=value
            item: P204_RECEBIDA
            value: N
        }
    )

    validation data-entrega-inicial (
        name: Data Entrega Inicial
        execution {
            sequence: 50
        }
        validation {
            type: itemIsNotNull
            item: P204_DATAENTREGAINICIAL
        }
        error {
            errorMessage: Filtro de Data Obrigatório!
            associatedItem: @P204_DATAENTREGAINICIAL
        }
        serverSideCondition {
            type: item=value
            item: P204_RECEBIDA
            value: N
        }
    )

    validation data-recebimento-final (
        name: Data Recebimento Final
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P204_DATARECEBIMENTOFINAL
        }
        error {
            errorMessage: Filtro de Data Obrigatório!
            associatedItem: @P204_DATARECEBIMENTOFINAL
        }
        serverSideCondition {
            type: item=value
            item: P204_RECEBIDA
            value: S
        }
    )

    validation data-recebimento-inicial (
        name: Data Recebimento Inicial
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P204_DATARECEBIMENTOINICIAL
        }
        error {
            errorMessage: Filtro de Data Obrigatório!
            associatedItem: @P204_DATARECEBIMENTOINICIAL
        }
        serverSideCondition {
            type: item=value
            item: P204_RECEBIDA
            value: S
        }
    )

    validation filtro-obrigatorio-de-nao-recebidas (
        name: Filtro Obrigatorio de Nao recebidas
        execution {
            sequence: 40
        }
        validation {
            type: itemIsNotNull
            item: P204_IDREPRESENTANTE
        }
        error {
            errorMessage: Filtro obrigatório para buscar promissórias que não foram recebidas!
            associatedItem: @P204_IDREPRESENTANTE
        }
        serverSideCondition {
            type: item=value
            item: P204_RECEBIDA
            value: N
        }
    )

    branch (
        name: Go To Page 204
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 204
                items: {
                    P204_IDREPRESENTANTE: &P204_IDREPRESENTANTE.
                    P204_IDVENDEDORA: &P204_IDVENDEDORA.
                    P204_IDPEDIDO: &P204_IDPEDIDO.
                    P204_RECEBIDA: &P204_RECEBIDA.
                    P204_REMESSA: &P204_REMESSA.
                    P204_DATARECEBIMENTOINICIAL: &P204_DATARECEBIMENTOINICIAL.
                    P204_DATARECEBIMENTOFINAL: &P204_DATARECEBIMENTOFINAL.
                    P204_DATAENTREGAINICIAL: &P204_DATAENTREGAINICIAL.
                    P204_DATAENTREGAFINAL: &P204_DATAENTREGAFINAL.
                    P204_ENVIADOCOBRANCA: &P204_ENVIADOCOBRANCA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar-promissorias
        }
    )

)

