    pageItem P204_REMESSA (
        type: popupLov
        label {
            label: Remessa
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.desctipo||' '||c.numero||' - NF: '||c.notafiscal||' - Situação: '||c.situacao display_value
                     , c.idcompratransferencia return_value
                from vw_comprastransferencias_fav c
                where c.ididioma = 1
                  and ( c.idtipocomptransrem in (0,1) and c.idsituacao in ( 20,30 )
                     or c.idtipocomptransrem in (2,3) and c.idsituacao in ( 20,30,40 ) )
                  and ( c.idfilialfavoritadestino = pck_util_fav.fnc_retornaidfilialfavusuario(:P0_IDUSUARIO)
                       or c.idfilialromancedestino = ( select idfilial
                                                       from gerentes
                                                       where idgerente = ( select idgerente
                                                                           from usuarios
                                                                           where idusuario = :P0_IDUSUARIO ) )
                  and exists ( select 1
                               from pedidosremessasct pr
                                  , pedidos p
                               where pr.idpedido = p.idpedido
                               and pr.idcompratransferencia = c.idcompratransferencia
                               and p.idrepresentante = :P204_IDREPRESENTANTE )
                       or v('APP_USER') = 'GUILHERME'
                       or v('APP_USER') = 'LEONELG'
                       or v('APP_USER') = 'LUIZV'
                       or v('APP_USER') = 'EVERTON'
                       or v('APP_USER') = 'RICIERYS' )
                order by c.idcompratransferencia desc
                ```
        }
        cascadingLov {
            parentItems: [
                P204_IDREPRESENTANTE
                P0_IDUSUARIO
            ]
            itemsToSubmit: [
                P204_IDREPRESENTANTE
                P0_IDUSUARIO
            ]
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

