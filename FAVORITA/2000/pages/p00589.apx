    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @detalhes-da-remessa
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 588
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 20
            region: @detalhes-da-remessa
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: definedByDynamicAction
            executeValidations: false
            databaseAction: delete
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1 
                  FROM REMESSAS
                 WHERE IDREMESSA = :P589_IDREMESSA
                   AND DATAFECHAMENTO IS  NULL
                ```
        }
    )

    button finalizar (
        buttonName: FINALIZAR
        label: Fechar Remessa
        layout {
            sequence: 50
            region: @detalhes-da-remessa
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
            databaseAction: insert
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1 
                  FROM REMESSAS
                 WHERE IDREMESSA = :P589_IDREMESSA
                   AND DATAFECHAMENTO IS NULL
                ```
        }
    )

    button incluir (
        buttonName: INCLUIR
        label: Incluir
        layout {
            sequence: 40
            region: @detalhes-da-remessa
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P589_IDREMESSA
        }
    )

    button salvar (
        buttonName: SALVAR
        label: Salvar
        layout {
            sequence: 30
            region: @detalhes-da-remessa
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1 
                  FROM REMESSAS
                 WHERE IDREMESSA = :P589_IDREMESSA
                   AND DATAFECHAMENTO IS NULL
                ```
        }
    )

    dynamicAction confirma (
        name: Confirma
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @excluir
        }

        action native-confirm (
            action: confirm
            settings {
                message: Confirma exclusão da remessa?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: EXCLUIR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @finalizar
        }

        action native-confirm (
            action: confirm
            settings {
                message: Confirma Fechamento da Remessa?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FINALIZAR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    process dml-remessas (
        name: DML Remessas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                vmd5 varchar2(4000);
                vdtfechamento timestamp;
                vdtabertura   timestamp;
                vdata date;
                vidusuariofecha number;
                vidusuarioabert number;
                begin 
                
                  if v('REQUEST') = 'INCLUIR' then
                 -- raise_application_error(-20001,'xxxxxxxxxxx');
                     vidusuarioabert := :P0_IDUSUARIO;
                     vdtabertura     := sysdate;
                     pck_cadastros_fav.prc_remessas 
                                      ( :P589_idremessa 
                                      , :P589_descricao
                                      , vidusuarioabert
                                      , vdtabertura
                                      , vdtfechamento
                                      , :P589_idfilialfavorita
                                      , :P589_tiporemessa
                                      , vidusuariofecha
                                      , vmd5
                                      , 'I' ) ;
                  end if;
                  --
                  if v('REQUEST') = 'SALVAR' then
                     vdata := to_date(:P589_DATAABERTURA,'dd/mm/rrrr hh24:mi:ss');
                     pck_cadastros_fav.prc_remessas 
                                      ( :P589_idremessa 
                                      , :P589_descricao
                                      , :P589_IDUSUARIOABERTURA
                                      , vdata
                                      , :P589_DATAFECHAMENTO
                                      , :P589_idfilialfavorita
                                      , :P589_tiporemessa
                                      , :P589_IDUSUARIOFECHAMENTO
                                      , vmd5
                                      , 'U' ) ;
                  end if;
                  --
                  if v('REQUEST') = 'FINALIZAR' then
                     vdtfechamento := sysdate;
                     :P589_IDUSUARIOFECHAMENTO := :P0_IDUSUARIO;
                     pck_cadastros_fav.prc_remessas 
                                      ( :P589_idremessa 
                                      , :P589_descricao
                                      , :P589_IDUSUARIOABERTURA
                                      , vdata
                                      , vdtfechamento
                                      , :P589_idfilialfavorita
                                      , :P589_tiporemessa
                                      , :P589_IDUSUARIOFECHAMENTO
                                      , vmd5
                                      , 'U' ) ;
                  end if;
                  --
                  if v('REQUEST') = 'EXCLUIR' then
                     pck_cadastros_fav.prc_remessas 
                                      ( :P589_idremessa 
                                      , :P589_descricao
                                      , vidusuarioabert
                                      , vdtabertura
                                      , :P589_DATAFECHAMENTO
                                      , :P589_idfilialfavorita
                                      , :P589_tiporemessa
                                      , vidusuariofecha
                                      , vmd5
                                      , 'D' ) ;
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Ação executada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 565609550927316165
        }
    )

    process populatela (
        name: PopulaTela
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                vdataabert timestamp;
                vdatafecha timestamp;
                begin
                  pck_cadastros_fav.prc_remessas(pidremessa           => :P589_idremessa,
                                                 pdescricao           => :P589_descricao,
                                                 pidusuario           => :P589_idusuario,
                                                 pdataabertura        => vdataabert,
                                                 pdatafechamento      => vdatafecha,
                                                 pidfilialfavorita    => :P589_idfilialfavorita,
                                                 ptiporemessa         => :P589_tiporemessa,
                                                 pidusuariofechamento => :P589_idusuariofechamento,
                                                 pmd5                 => :P589_md5,
                                                 poperacao_dml        => 'S');
                
                :P589_dataabertura   := to_char(vdataabert,'dd/mm/rrrr hh24:mi:ss');
                :P589_datafechamento := to_char(vdatafecha,'dd/mm/rrrr hh24:mi:ss');
                
                end;
                
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 563685547221947129
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 588
            }
        }
    )

)

