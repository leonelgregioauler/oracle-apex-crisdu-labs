page 362 (
    name: Importar Arquivo
    title: Importar Arquivo
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region importar-arquivo (
        name: Importar Arquivo
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            customAttributes: style="width:100%;max-width:none;"
        }
        settings {
            outputAs: text
        }
    )

    region progresso-dos-cadastros (
        name: Progresso dos Cadastros
        type: list
        source {
            list: @data-load-wizard-progress-importar-arquivo-loja
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            excludeTitleFromTranslation: true
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

    pageItem P362_APP_DATE_FORMAT (
        type: radioGroup
        label {
            label: Date / Number Formats to use
            alignment: rightTop
        }
        lov {
            type: sharedComponent
            lov: @date-format-opt
            displayNullValue: false
        }
        layout {
            sequence: 150
            region: @importar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: Y
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Choose whether to provide custom or to use standard format masks
        }
    )

    pageItem P362_CHAR_SET (
        type: selectList
        label {
            label: File Character Set
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        lov {
            type: sharedComponent
            lov: @data-load-charset
            displayNullValue: false
        }
        layout {
            sequence: 140
            region: @importar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: UTF-8
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: DATA_LOAD.CHAR_SET_ITEM_HELP
        }
    )

    pageItem P362_COPY_PASTE (
        type: textarea
        label {
            label: Copie e Cole o conteúdo
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 15
            region: @importar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 80
            height: 10
        }
        advanced {
            customAttributes: spellcheck="false"
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P362_CURRENCY (
        type: textField
        label {
            label: Currency Symbol
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 130
            region: @importar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 2
        }
        validation {
            maxLength: 2
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select value
                  from nls_session_parameters
                 where parameter = 'NLS_CURRENCY'
                ```
        }
        default {
            type: static
            staticValue: $
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: If your data contains international currency symbol, enter it here. For example, if your data has "&euro;1,234.56" or "&yen;1,234.56", enter "&euro;" or "&yen;".  Otherwise the data will not load correctly.
        }
    )

    pageItem P362_DECIMAL_CHARACTER (
        type: textField
        label {
            label: Decimal Character
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 110
            region: @importar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 2
        }
        validation {
            maxLength: 2
        }
        source {
            type: expression
            plsqlExpression: apex_application.get_nls_decimal_separator
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText:
                ```html
                <p>The decimal character separates the integer and decimal parts of a number.</p>
                <p> Any character can be the decimal character. The character specified must be single-byte, and the decimal character must be different from group separator. The character can be a space, but cannot be any numeric character or any of the following characters:</p>
                <ul class="noIndent">
                <li>plus (+)</li>
                <li>hyphen (-)</li> 
                <li>less than sign (<)</li>
                <li>greater than sign (>)</li> 
                </ul>
                ```
        }
    )

    pageItem P362_ENCLOSED_BY (
        type: textField
        label {
            label: Fechado por
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @importar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 2
        }
        validation {
            maxLength: 2
        }
        default {
            type: static
            staticValue: "
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Enter a delimiter character. You can use this character to delineate the starting and ending boundary of a data value. If you specify a delimiter character, Data Workshop ignores whitespace occurring before the starting and ending boundary of a data value. You can also use this option to enclose a data value with the specified delimiter character.
        }
    )

    pageItem P362_FILE_NAME (
        type: fileUpload
        label {
            label: Nome do Arquivo
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
        }
        storage {
            type: appTempFiles
            purgeFileAt: endOfRequest
        }
        layout {
            sequence: 20
            region: @importar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Name of the file to upload
        }
    )

    pageItem P362_FIRST_ROW (
        type: checkboxGroup
        label {
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Primeira Linha são as Colunas;Y
        }
        layout {
            sequence: 50
            region: @importar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: Y
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Select this box if your data contains column names in the first row.
        }
    )

    pageItem P362_GROUP_SEPARATOR (
        type: textField
        label {
            label: Group Separator
            alignment: right
            tableCellAttributes: nowrap="nowrap"
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 120
            region: @importar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 2
        }
        validation {
            maxLength: 2
        }
        source {
            type: expression
            plsqlExpression: apex_application.get_nls_group_separator
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText:
                ```html
                <p>A group separator is a character that separates integer groups, for example to show thousands and millions.</p>
                <p>Any character can be the group separator. The character specified must be single-byte, and the group separator must be different from any other decimal character. The character can be a space, but cannot be a numeric character or any of the following:</p>
                <ul class="noIndent">
                <li>plus (+)</li>
                <li>hyphen (-)</li> 
                <li>less than sign (<)</li>
                <li>greater than sign (>)</li> 
                </ul>
                ```
        }
    )

    pageItem P362_IMPORT_FROM (
        type: radioGroup
        label {
            label: Importar
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @data-load-option
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @importar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: UPLOAD
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P362_SEPARATOR (
        type: textField
        label {
            label: Separador
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @importar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 2
        }
        validation {
            valueRequired: true
            maxLength: 2
        }
        default {
            type: static
            staticValue: ,
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Identify a column separator character. Use <code>\t</code> for tab separators.
        }
    )

    pageItem P362_SHOW_ADV_SETTINGS (
        type: checkboxGroup
        label {
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Usar opções avançadas;Y
        }
        layout {
            sequence: 55
            region: @importar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText:
                ```html
                Display advanced settings for data loading: Currency Symbol, Decimal Characters, File Encoding or Date Formats
                
                ```
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @importar-arquivo
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 123
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button next (
        buttonName: NEXT
        label: Próximo
        layout {
            sequence: 20
            region: @importar-arquivo
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.widget.textareaClob.uploadNonEmpty('P362_COPY_PASTE', 'NEXT');
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction import-from-copy-and-paste (
        name: Import From Copy and Paste
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P362_IMPORT_FROM
        }
        clientSideCondition {
            type: item=value
            item: P362_IMPORT_FROM
            value: PASTE
        }

        action native-hide (
            action: hide
            settings {
                hidePageItemsOnSameLine: true
            }
            affectedElements {
                selectionType: items
                items: P362_COPY_PASTE
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                value: \t
            }
            affectedElements {
                selectionType: items
                items: P362_SEPARATOR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-show (
            action: show
            settings {
                showAllOnSameLine: true
            }
            affectedElements {
                selectionType: items
                items: P362_COPY_PASTE
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction import-from-file (
        name: Import from File
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P362_IMPORT_FROM
        }
        clientSideCondition {
            type: item=value
            item: P362_IMPORT_FROM
            value: UPLOAD
        }

        action native-hide (
            action: hide
            settings {
                hidePageItemsOnSameLine: true
            }
            affectedElements {
                selectionType: items
                items: P362_FILE_NAME
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                value: ,
            }
            affectedElements {
                selectionType: items
                items: P362_SEPARATOR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-show (
            action: show
            settings {
                showAllOnSameLine: true
            }
            affectedElements {
                selectionType: items
                items: P362_FILE_NAME
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction show-hide-advanced-settings (
        name: Show/Hide Advanced Settings
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P362_SHOW_ADV_SETTINGS
        }
        clientSideCondition {
            type: item=value
            item: P362_SHOW_ADV_SETTINGS
            value: Y
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P362_CURRENCY
                    P362_GROUP_SEPARATOR
                    P362_DECIMAL_CHARACTER
                    P362_APP_DATE_FORMAT
                    P362_CHAR_SET
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P362_CURRENCY
                    P362_GROUP_SEPARATOR
                    P362_DECIMAL_CHARACTER
                    P362_APP_DATE_FORMAT
                    P362_CHAR_SET
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    validation filename-is-not-null (
        name: Filename is not null
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P362_FILE_NAME
        }
        error {
            errorMessage: #LABEL# must have some value.
            associatedItem: @P362_FILE_NAME
        }
        serverSideCondition {
            whenButtonPressed: @next
            type: item=value
            item: P362_IMPORT_FROM
            value: UPLOAD
        }
    )

    validation uploaded-data-is-not-null (
        name: Uploaded data is not null
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P362_COPY_PASTE
        }
        error {
            errorMessage: #LABEL# must have some value.
            associatedItem: @P362_COPY_PASTE
        }
        serverSideCondition {
            whenButtonPressed: @next
            type: item=value
            item: P362_IMPORT_FROM
            value: PASTE
        }
    )

    process parse-uploaded-data (
        name: Parse Uploaded Data
        type: parseUploadedData
        dataLoading {
            dataLoadDefinition: @importar-arquivo-loja
        }
        sourceData {
            importFromItem: P362_IMPORT_FROM
            fileNameItem: P362_FILE_NAME
            copyAndPasteItem: P362_COPY_PASTE
            charSetItem: P362_CHAR_SET
            dateFormatItem: P362_APP_DATE_FORMAT
        }
        parsingOptions {
            separatorItem: P362_SEPARATOR
            enclosedByItem: P362_ENCLOSED_BY
            firstRowItem: P362_FIRST_ROW
            currencySymbolItem: P362_CURRENCY
            groupSeparatorItem: P362_GROUP_SEPARATOR
            decimalCharItem: P362_DECIMAL_CHARACTER
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1511314411165773017
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 363
            }
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

)

