page 491 (
    name: Cadastro de operação Fiscal
    title: Cadastro de operação Fiscal
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG_24"';
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region cadastro-de-operação-fiscal (
        name: Cadastro de operação Fiscal
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P491_CODIGO (
        type: numberField
        label {
            label: Código
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 20
            region: @cadastro-de-operação-fiscal
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: CODIGO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P491_CODIGOOPERACAOFATURAMENTO (
        type: numberField
        label {
            label: Código Operação Faturamento
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 30
            region: @cadastro-de-operação-fiscal
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: databaseColumn
            databaseColumn: CODOPERACAOFATURAMENTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P491_DESCRICAO (
        type: textarea
        label {
            label: Descrição
            alignment: left
        }
        layout {
            sequence: 50
            region: @cadastro-de-operação-fiscal
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            width: 80
            height: 6
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            type: databaseColumn
            databaseColumn: DESCRICAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P491_IDOPERCAOFISCAL (
        type: hidden
        layout {
            sequence: 10
            region: @cadastro-de-operação-fiscal
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDOPERCAOFISCAL
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P491_IDTIPO (
        type: selectList
        label {
            label: Tipo
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.nome d,
                       t.idtipooperacaofiscal r
                from tiposoperacoesfiscais t
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 40
            region: @cadastro-de-operação-fiscal
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDTIPO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Salvar
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P491_IDOPERCAOFISCAL
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Você gostaria de executar esta ação de exclusão?','DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P491_IDOPERCAOFISCAL
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar Alterações
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P491_IDOPERCAOFISCAL
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation valida-deletar (
        name: Valida deletar
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from operacoespadroes op
                where op.codigooperacao = :P491_CODIGO
                ```
        }
        error {
            errorMessage: Registro não pode ser deletado, existe operação padrão configurada com essa operação.
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 103010209640292613
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process fetch-row-from-operacoesfiscais (
        name: Fetch Row from OPERACOESFISCAIS
        type: autoRowFetch
        source {
            tableName: OPERACOESFISCAIS
            pkColumn: IDOPERCAOFISCAL
            pkItem: P491_IDOPERCAOFISCAL
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 103008625514292612
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P491_IDOPERCAOFISCAL is null then
                        select "#OWNER#"."SEQ_IDOPERACAOFISCAL".nextval
                          into :P491_IDOPERCAOFISCAL
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 103009052988292612
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-operacoesfiscais (
        name: Process Row of OPERACOESFISCAIS
        type: autoRowProcessing
        target {
            tableName: OPERACOESFISCAIS
            pkColumn: IDOPERCAOFISCAL
            pkItem: P491_IDOPERCAOFISCAL
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 103009441423292612
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 103009865228292612
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

)

