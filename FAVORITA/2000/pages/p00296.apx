page 296 (
    name: Busca Vendedora
    title: Busca Vendedora
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P296_CPF (
        type: textField
        label {
            label: Cpf
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P296_DOCESTRANGEIRO (
        type: textField
        label {
            label: Doc. Estrangeiro
            alignment: left
        }
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P296_IDPESSOA (
        type: hidden
        layout {
            sequence: 50
            region: @filtro
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P296_IDPESSOA_ENTRADA (
        type: textField
        label {
            label: ID Pessoa
            alignment: left
        }
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P296_TIPO (
        type: radioGroup
        label {
            label: Tipo
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:CPF;C,Doc. Estrangeiro;D,ID Pessoa;I
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: C
        }
        security {
            encryptSessionState: false
        }
    )

    button buscar (
        buttonName: BUSCAR
        label: Buscar
        layout {
            sequence: 10
            region: @filtro
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--simple
                t-Button--iconLeft
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction tipo (
        name: tipo
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P296_TIPO
        }
        clientSideCondition {
            type: itemIsInList
            item: P296_TIPO
            list: C
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P296_DOCESTRANGEIRO
                    P296_IDPESSOA_ENTRADA
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-hide-2 (
            action: hide
            settings {
                hidePageItemsOnSameLine: true
            }
            affectedElements {
                selectionType: items
                items: P296_CPF
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P296_CPF
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P296_DOCESTRANGEIRO
                    P296_CPF
                ]
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

    )

    dynamicAction tipo-d (
        name: tipo_d
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P296_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P296_TIPO
            value: D
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P296_CPF
                    P296_IDPESSOA_ENTRADA
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P296_DOCESTRANGEIRO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo-i (
        name: tipo_I
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P296_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P296_TIPO
            value: I
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P296_CPF
                    P296_DOCESTRANGEIRO
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P296_IDPESSOA_ENTRADA
            }
            execution {
                sequence: 10
            }
        )

    )

    validation p296-cpf (
        name: P296_CPF
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( 
                                select idpessoa
                                from pessoas
                                where replace(replace(cpf,'.',''),'-','') = replace(replace(:P296_CPF,'.',''),'-','') )
                  or exists (
                                select idpessoa
                                from pessoas
                                where replace(replace(documentoestrangeiro,'.',''),'-','') = replace(replace(:P296_DOCESTRANGEIRO,'.',''),'-','') )
                  or exists (
                                select idpessoa
                                from pessoas
                                where replace(replace(idpessoa,'.',''),'-','') = replace(replace(:P296_IDPESSOA_ENTRADA,'.',''),'-','') )
                ```
        }
        error {
            errorMessage: Cadastro não encontrado!
            associatedItem: @P296_CPF
        }
    )

    process busca-cliente (
        name: Busca Cliente
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P296_TIPO = 'I' then
                    select idpessoa
                    into :P296_IDPESSOA
                    from pessoas
                    where idpessoa = replace(replace(:P296_IDPESSOA_ENTRADA,'.',''),'-','');
                  elsif :P296_TIPO = 'C' then
                    select idpessoa
                    into :P296_IDPESSOA
                    from pessoas
                    where replace(replace(cpf,'.',''),'-','') = replace(replace(:P296_CPF,'.',''),'-','');
                  else
                    select idpessoa
                    into :P296_IDPESSOA
                    from pessoas
                    where replace(replace(DOCUMENTOESTRANGEIRO,'.',''),'-','') = replace(replace(:P296_DOCESTRANGEIRO,'.',''),'-','');
                  end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Cadastro encontrado
        }
        error {
            errorMessage: Cadastro não encontrado
        }
        advanced {
            executionMappingIdentifier: 1375300659073259620
        }
    )

    branch (
        name: Go to Page 85
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 85
                items: {
                    P85_IDPESSOA: &P296_IDPESSOA.
                }
                action: resetPagination
            }
        }
    )

)

