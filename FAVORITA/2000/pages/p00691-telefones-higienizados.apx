page 691 (
    name: Telefones Higienizados
    alias: TELEFONES-HIGIENIZADOS
    title: Telefones Higienizados
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }

    region telefones-higienizados (
        name: Telefones Higienizados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select substr(telefonelimpo,1,2) ||'-'|| substr(telefonelimpo,3,10) as "Telefone"
                     , nvl(score,0) "Score"
                     , prioridade "Prioridade"
                     , case when nvl(score,0) > 0 then 'Higienizado'
                            else 'Não Higienizado'
                       end "Hig.Fone" 
                     , decode(enviosms,1,'Sim','Não') "SMS"
                     , decode(whatsapp,1,'Sim','Não') "WHATSAPP"
                  from telefonespessoas
                 where idpessoa = :P691_IDPESSOA
                 order by nvl(score,0) desc, prioridade
                 
                ```
            pageItemsToSubmit: P691_IDPESSOA
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--inline
                t-Report--hideNoPagination
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: no data found
        }

        column Hig.Fone (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Hig.fone
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column Prioridade (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Prioridade
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column SMS (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Sms
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column Score (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Score
                alignment: end
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column Telefone (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Telefone
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column WHATSAPP (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Whatsapp
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P691_IDPESSOA (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
    )

)

