page 107 (
    name: Confirmar Despacho de Pedidos
    title: Confirmar Despacho de Pedidos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function  confirmapedido(event)
            { 
            var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
             
            if (tecla==13) {
            	if (document.getElementById('P107_NUMEROPEDIDO').value != '')
                     {
                       apex.submit('CONFEREPEDIDO');
                     }
              }  
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region despachar-pedidos (
        name: Despachar Pedidos
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P107_IDCOMPRATRANSFERENCIA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @despachar-pedidos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P107_NUMEROPEDIDO (
        type: textField
        label {
            label: Pedido
            alignment: left
        }
        layout {
            sequence: 10
            region: @despachar-pedidos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            customAttributes: "onKeyUp=\"javascript: confirmapedido(event)\"; "
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P107_QTDFALTANTES (
        type: numberField
        label {
            label: Pedidos que Faltam Bipar
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 50
            region: @despachar-pedidos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select count(1) qtd
                from pedidosremessasct
                where idcompratransferencia = :P107_IDCOMPRATRANSFERENCIA
                  and nvl(conferido,'N') = 'N'
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P107_TAMANHOCAIXA (
        type: radioGroup
        label {
            label: Tamanho da Embalagem
            alignment: left
        }
        settings {
            noOfCols: 4
        }
        lov {
            type: staticValues
            staticValues: STATIC2:P;P,M;M,G;G
        }
        layout {
            sequence: 20
            region: @despachar-pedidos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: expression
            plsqlExpression: null
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from comprastransferencias c
                where c.idcompratransferencia = :P107_IDCOMPRATRANSFERENCIA
                  and c.idtipocomptransrem = 4
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P107_VOLUME (
        type: textField
        label {
            label: Volume
            alignment: left
        }
        layout {
            sequence: 30
            region: @despachar-pedidos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 5
        }
        validation {
            valueRequired: true
        }
        advanced {
            customAttributes: "onKeyUp=\"javascript: confirmapedido(event)\"; "
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Atualizar e Fechar
        layout {
            sequence: 10
            region: @despachar-pedidos
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 74
                items: {
                    P74_IDCOMPRATRANSFERENCIA: &P107_IDCOMPRATRANSFERENCIA.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button confirmar (
        buttonName: CONFIRMAR
        label: Confirmar
        layout {
            sequence: 20
            region: @despachar-pedidos
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction set-focus (
        name: set focus
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P107_NUMEROPEDIDO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction submeter (
        name: Submeter
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @confirmar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: CONFEREPEDIDO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process conferepedido (
        name: CONFEREPEDIDO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                --  raise_application_error(-20001,'xxxxx');
                  pck_comprastransf_fav.prc_conferepedidoremessa( pidcompratransferencia => :P107_IDCOMPRATRANSFERENCIA
                                                                , pnumeropedido          => :P107_NUMEROPEDIDO
                                                                , pvolume                => :P107_VOLUME 
                                                                , ptamanhocaixa          => :P107_TAMANHOCAIXA
                                                                , pidusuario             => :P0_IDUSUARIO);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Pedido Preparado!
        }
        advanced {
            executionMappingIdentifier: 14482283787440731
        }
        serverSideCondition {
            type: request=Value
            value: CONFEREPEDIDO
        }
    )

    branch (
        name: 107
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 107
                items: {
                    P107_NUMEROPEDIDO:
                    P107_IDCOMPRATRANSFERENCIA: &P107_IDCOMPRATRANSFERENCIA.
                    P107_TAMANHOCAIXA:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: CONFEREPEDIDO
        }
    )

)

