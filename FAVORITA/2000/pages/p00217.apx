page 217 (
    name: Parâmetros Distribuidora Parceira
    title: Parâmetros Distribuidora Parceira
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG_24"';
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 25
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region gerar-parâmetros (
        name: Gerar parâmetros
        type: staticContent
        layout {
            sequence: 25
            parentRegion: @filtro
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region parâmetros-distribuidora-parceira (
        name: Parâmetros Distribuidora Parceira
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "ROWID",
                "IDFILIALROMANCE",
                "IDFILIALFAVORITA",
                  case 
                    when "NOME" = 'VALORMINIMO' then 'Valor Mínimo'
                    when "NOME" = 'VALORMAXIMOEMABERTO' then 'Valor Máximo em Aberto'
                    when "NOME" = 'PRAZOAUTOMATICO' then 'Prazo Automático'
                    when "NOME" = 'QTDDIASVENCIMENTOBOLETO' then 'Quantidade Dias Vencimento Boleto'
                  else
                    "NOME"
                  end "NOME",
                "VALOR",
                "OBSERVACAO"
                from "#OWNER#"."PARAMETROS"
                where idfilialromance = :P217_IDFILIALROMANCEORIGEM
                
                ```
        }
        layout {
            sequence: 15
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from parametros
                where idfilialromance = :P217_IDFILIALROMANCEORIGEM
                ```
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Não encontrou informações.
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 7
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column IDFILIALFAVORITA (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 4
            }
        )

        column IDFILIALROMANCE (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 3
            }
        )

        column NOME (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 5
            }
        )

        column OBSERVACAO (
            reportColumnQueryId: 6
            derivedColumn: N
            type: textArea
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 7
                columnAlignment: center
            }
            appearance {
                width: 130
                height: 1
            }
        )

        column ROWID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
            security {
                escapeSpecialChars: false
            }
        )

        column VALOR (
            reportColumnQueryId: 5
            derivedColumn: N
            type: textField
            heading {
                heading: Valor
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: center
            }
            appearance {
                width: 16
            }
        )

    )

    pageItem P217_CONTADOR (
        type: hidden
        layout {
            sequence: 10
            region: @parâmetros-distribuidora-parceira
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P217_IDFILIALROMANCEDESTINO (
        type: selectList
        label {
            label: Distribuidora Parceira Destino
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-distribuidorasparceiras
            nullDisplayValue: - Selecione a Distribuidora Parceira -
        }
        layout {
            sequence: 10
            region: @gerar-parâmetros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P217_IDFILIALROMANCEORIGEM (
        type: selectList
        label {
            label: Distribuidora Parceira
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-distribuidorasparceiras
            nullDisplayValue: - Selecione a Distribuidora Parceira -
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button gerarparametros (
        buttonName: GERARPARAMETROS
        label: Gerar Parâmetros
        layout {
            sequence: 20
            region: @gerar-parâmetros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction atualiza-página-ao-selecionar (
        name: Atualiza página ao Selecionar
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P217_IDFILIALROMANCEORIGEM
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation filialromancedestino-obrigatório (
        name: FILIALROMANCEDESTINO obrigatório
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P217_IDFILIALROMANCEDESTINO
        }
        error {
            errorMessage: Filial Romance Destino deve ser informada.
        }
        serverSideCondition {
            whenButtonPressed: @gerarparametros
        }
    )

    validation filialromanceorigem-obrigatório (
        name: FILIALROMANCEORIGEM obrigatório
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P217_IDFILIALROMANCEORIGEM
        }
        error {
            errorMessage: Filial Romance Origem deve ser informada.
        }
        serverSideCondition {
            whenButtonPressed: @gerarparametros
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @parâmetros-distribuidora-parceira
        target {
            tableName: PARAMETROS
            pkColumn: ROWID
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# registros(s) atualizados, #MRI_COUNT# registros(s) inseridos.
        }
        advanced {
            executionMappingIdentifier: 573498804724170318
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

    process gerar-parâmetros (
        name: Gerar Parâmetros
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vcontador number := 0;
                begin
                  for i in ( select po.nome
                                  , po.valor
                                  , po.observacao 
                             from parametros po
                             where po.idfilialromance = :P217_IDFILIALROMANCEORIGEM
                             and not exists ( select 1
                                              from parametros pd
                                              where pd.nome = po.nome 
                                              and pd.idfilialromance = :P217_IDFILIALROMANCEDESTINO )) 
                  loop
                  --
                  vcontador := vcontador + 1;
                  --
                  insert into parametros ( idfilialromance
                                         , nome
                                         , valor
                                         , observacao )
                  values ( :P217_IDFILIALROMANCEDESTINO
                         , i.nome
                         , i.valor
                         , i.observacao );
                  --
                  commit;
                  --
                  end loop;
                  --
                  :P217_CONTADOR := vcontador;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Foram gerados &P217_CONTADOR. parâmetros para a distribuidora selecionada.
        }
        advanced {
            executionMappingIdentifier: 573585749383423174
        }
        serverSideCondition {
            whenButtonPressed: @gerarparametros
        }
    )

    branch (
        name: Go To Page 217
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 217
                items: {
                    P217_IDFILIALROMANCEORIGEM: &P217_IDFILIALROMANCEORIGEM.
                    P217_IDFILIALROMANCEDESTINO: &P217_IDFILIALROMANCEDESTINO.
                }
                clearCache: 217
            }
        }
    )

)

