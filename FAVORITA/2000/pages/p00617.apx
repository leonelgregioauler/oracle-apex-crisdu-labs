    process entregarpedido (
        name: EntregarPedido
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vid_pedido  number;
                  vid_usuario number := pck_util_fav.fnc_retornaidusuario(:APP_USER);
                  vexiste     number;
                  vqtd        number;
                  vid_subrem  number;
                  vdata       timestamp := sysdate;
                  
                begin
                  --
                  if APEX_APPLICATION.G_F01.COUNT > 0 then
                    --
                    FOR I in 1..APEX_APPLICATION.G_F01.COUNT LOOP
                      vid_pedido := to_number(APEX_APPLICATION.G_F01(i));
                      pck_movimentarpedidos_fav.prc_confirmaentregapedido(pidpedido  => vid_pedido,
                                                                          pidusuario => vid_usuario);
                      commit;
                    END LOOP;
                    --
                    -- valida se todos os pedidos da subremessa foram entregues, então pode fechar a subremessa
                    begin
                      select idsubremessa
                        into vid_subrem  
                        from pedidos p
                       where p.idpedido = vid_pedido;
                      --
                      if vid_subrem is not null then
                        begin
                        select max(1)
                          into vexiste
                          from pedidos p
                         where idsubremessa = vid_subrem
                           and p.idsituacaoentrega in (30000, 55000) ;
                        exception
                          when no_data_found then
                            vexiste := 0;
                        end;
                      end if;
                      --
                      if nvl(vexiste,0) > 0 then  -- enquanto o select acima retornar registros, sinal que ainda não foram todos recebidos.
                        null;
                      else
                        --
                        UPDATE subremessas
                           SET datafechamento      = vdata
                             , idusuariofechamento = vid_usuario
                         WHERE idsubremessa        = vid_subrem;
                        --
                      end if;
                    end; 
                
                  --
                  else
                    apex_error.add_error ( p_message => 'Selecione ao menos um pedido para efetuar a entrega!',
                                           p_display_location => apex_error.c_inline_in_notification );  
                  end if;
                  
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Ação Processada!
        }
        advanced {
            executionMappingIdentifier: 1978547459288513113
        }
        serverSideCondition {
            type: request=Value
            value: ENTREGAR
        }
    )

    process gerarsubremessa (
        name: GerarSubRemessa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                l_query         varchar2(4000);
                vidusuarioabert number;
                vdtabertura     timestamp ;
                vdtfechamento   timestamp;
                vidusuariofecha number;
                vmd5            varchar2(1000);
                
                begin
                
                  --
                  if APEX_APPLICATION.G_F02.COUNT > 0 then
                    --
                    if v('REQUEST') = 'INCLUIRSR' and 
                       :P617_IDSUBREMESSA is null then
                      --
                      vidusuarioabert := :P0_IDUSUARIO;
                      vdtabertura     := sysdate;
                      pck_cadastros_fav.prc_subremessas 
                                       ( :P617_IDSUBREMESSA
                                       , :P617_IDREMESSA
                                       , :P617_NOMESR
                                       , vidusuarioabert
                                       , vdtabertura
                                       , vdtfechamento
                                       , :P617_IDFILIALFAVORITA
                                       , :P617_TIPOSR
                                       , vidusuariofecha
                                       , vmd5
                                       , 'I' ) ;
                    end if;
                  else
                    apex_error.add_error ( p_message => 'Para gerar uma sub-remessa, tem que selecionar ao menos um item na coluna "Gerar SR"',
                                           p_display_location => apex_error.c_inline_in_notification );  
                  end if;
                  --
                  FOR I in 1..APEX_APPLICATION.G_F02.COUNT LOOP
                    --
                    update pedidos
                       set idsubremessa = :P617_IDSUBREMESSA
                     where idpedido = to_number(APEX_APPLICATION.G_F02(i));
                    --
                  END LOOP;
                
                end;
                
