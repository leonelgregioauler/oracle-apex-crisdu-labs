    dynamicAction buscasr (
        name: BuscaSR
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P617_IDSUBREMESSA
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    
                    --raise_application_error(-20001,'xxxx'||:P617_IDSUBREMESSA);
                    
                    SELECT IDREMESSA,
                           DESCRICAO,
                           IDFILIALFAVORITA,
                           TIPOSUBREMESSA
                      INTO :P617_IDREMESSA,
                           :P617_NOMESR,
                           :P617_IDFILIALFAVORITA,
                           :P617_TIPOSR
                      FROM subremessas
                     WHERE idsubremessa = :P617_IDSUBREMESSA;
                    
                     exception
                       when no_data_found then 
                        :P617_IDREMESSA        := null ;
                        :P617_NOMESR           := null ;
                        :P617_IDFILIALFAVORITA := 2 ;
                        :P617_TIPOSR           := 'I' ;
                        
                    end;
                    ```
                itemsToSubmit: P617_IDSUBREMESSA
                itemsToReturn: [
                    P617_IDREMESSA
                    P617_NOMESR
                    P617_IDFILIALFAVORITA
                    P617_TIPOSR
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

