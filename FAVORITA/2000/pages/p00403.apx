page 403 (
    name: Cadastro de Ciclos
    title: Cadastro de Ciclos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 60%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-de-ciclo (
        name: Cadastro de Ciclo
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P403_DATAFIM (
        type: datePickerJquery
        label {
            label: Data Fim
            alignment: left
        }
        layout {
            sequence: 40
            region: @cadastro-de-ciclo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P403_DATAINICIO (
        type: datePickerJquery
        label {
            label: Data Inicio
            alignment: left
        }
        layout {
            sequence: 30
            region: @cadastro-de-ciclo
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P403_IDCICLOEDICAO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @cadastro-de-ciclo
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P403_IDEDICAOREVISTA (
        type: selectList
        label {
            label: Edição Revista
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.numeroedicao ||'-'|| e.nome showvalue
                     , e.idedicaorevista returnvalue
                from favorita.edicoesrevistas e
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 20
            region: @cadastro-de-ciclo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        readOnly {
            type: itemIsNotNull
            item: P403_IDCICLOEDICAO
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P403_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @cadastro-de-ciclo
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P403_NUMEROCICLO (
        type: selectList
        label {
            label: Numero Ciclo
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:1;1,2;2,3;3
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @cadastro-de-ciclo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        readOnly {
            type: itemIsNotNull
            item: P403_IDCICLOEDICAO
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 40
            region: @cadastro-de-ciclo
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P403_IDCICLOEDICAO
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 30
            region: @cadastro-de-ciclo
            slot: bottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P403_IDCICLOEDICAO
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 50
            region: @cadastro-de-ciclo
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P403_IDCICLOEDICAO
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @cadastro-de-ciclo
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P403_IDCICLOEDICAO
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 20
            region: @cadastro-de-ciclo
            slot: bottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-reply
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 22
                items: {
                    P22_IDEDICAOREVISTA: &P403_IDEDICAOREVISTA.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process consulta-ciclos (
        name: Consulta Ciclos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml    varchar2(1) := 'S';
                  videdicaorevista number := :P403_IDEDICAOREVISTA;
                begin
                  --
                  PCK_CADASTROS_FAV.prc_ciclosedicoes ( pidcicloedicao   => :P403_IDCICLOEDICAO
                                                      , pnumerociclo     => :P403_NUMEROCICLO
                                                      , pidedicaorevista => :P403_IDEDICAOREVISTA
                                                      , pdatainicio      => :P403_DATAINICIO
                                                      , pdatafim         => :P403_DATAFIM
                                                      , pmd5             => :P403_MD5
                                                      , poperacao_dml    => voperacao_dml);
                  --
                  if :P403_IDEDICAOREVISTA is null then
                    --
                    :P403_IDEDICAOREVISTA := videdicaorevista;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1585567147712779029
        }
    )

    process operacao-dml (
        name: OPERACAO DML
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                  videdicao     number;
                begin
                  --
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                    videdicao := :P403_IDEDICAOREVISTA;
                  end if;
                  --
                  PCK_CADASTROS_FAV.prc_ciclosedicoes ( pidcicloedicao   => :P403_IDCICLOEDICAO
                                                      , pnumerociclo     => :P403_NUMEROCICLO
                                                      , pidedicaorevista => :P403_IDEDICAOREVISTA
                                                      , pdatainicio      => :P403_DATAINICIO
                                                      , pdatafim         => :P403_DATAFIM
                                                      , pmd5             => :P403_MD5
                                                      , poperacao_dml    => voperacao_dml);
                  --
                  if v('REQUEST') = 'EXCLUIR' then
                    :P403_IDEDICAOREVISTA := videdicao;
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1585566953127779027
        }
    )

    branch (
        name: Go To Page 403
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 403
                items: {
                    P403_IDCICLOEDICAO:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression: v('REQUEST') = 'NOVO'
        }
    )

    branch (
        name: Go To Page 22
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 22
                items: {
                    P22_IDEDICAOREVISTA: &P403_IDEDICAOREVISTA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression: v('REQUEST') = 'EXCLUIR'
        }
    )

)

