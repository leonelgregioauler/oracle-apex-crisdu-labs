    pageItem P235_IDPESSOA (
        type: popupLov
        label {
            label: Consultora
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' ('||p.cpf||') ['||/*Translate(To_Char(*/cpf/*/100 ,'000,000,000.00') ,',.' ,'.-')*/||']' display_value
                     , p.idpessoa return_value
                from pessoas p
                
                ```
            nullDisplayValue: - Selecione a Pessoa -
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 235
                items: {
                    P235_IDPESSOA: &P235_IDPESSOA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

