page 235 (
    name: Log de Pessoas
    title: Log de Pessoas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region log-de-pessoas (
        name: Log de Pessoas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select l.idlog
                     , l.dataalteracao
                     , l.usuarioalteracao
                     , decode(l.tipoalteracao, 'INSERT', 'Inserido'
                                             , 'UPDATE', 'Atualizado'
                                             , 'DELETE', 'Deletado') tipoalteracao
                     , l.idpessoa
                     , l.nomepessoa
                     , l.enderecoprincipal
                     , l.enderecosecundario
                     , (select c.nomecidade
                          from roman.cidades c
                         where c.idcidade = l.idcidade) cidade
                     , l.email
                     , l.cpf
                     , l.cnpj
                     , l.apelido
                     , decode(l.tipopessoa, 'F', 'Física'
                                          , 'J', 'Jurídica') tipopessoa
                     , l.referencia
                     , l.ativo
                     , l.numero
                     , l.complemento
                     , l.bairro
                     , l.cep
                     , l.usuariocadastrou
                     , l.ultimaatualizacao
                     , l.nroconsultaspc
                     , l.datanascimento
                     , l.limitecredito
                from logcatal.log_pessoas l
                where idpessoa = :P235_IDPESSOA
                order by 1 desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado!
        }
        advanced {
            savedReportMappingIdentifier: 1690349786027206713
        }

