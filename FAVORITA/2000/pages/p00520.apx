page 520 (
    name: Cadastro de Promoções Datas Vencimentos
    title: Cadastro de Promoções Datas Vencimentos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 60%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-de-promoções-datas-vencimentos (
        name: Cadastro de Promoções Datas Vencimentos
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region mensagem (
        name: Mensagem
        type: staticContent
        layout {
            sequence: 10
            slot: dialogHeader
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P520_MENSAGEM
        }
    )

    region new (
        name: New
        type: staticContent
        layout {
            sequence: 10
            slot: REGION_POSITION_07
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P520_DATAFINAL (
        type: datePickerJquery
        label {
            label: Data Final
            alignment: left
        }
        layout {
            sequence: 60
            region: @cadastro-de-promoções-datas-vencimentos
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P520_DATAINICIAL (
        type: datePickerJquery
        label {
            label: Data Inicial
            alignment: left
        }
        layout {
            sequence: 50
            region: @cadastro-de-promoções-datas-vencimentos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 30
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P520_IDFILIAISFAVORITA (
        type: plugin/select
        label {
            label: Filiais Favorita
            alignment: left
        }
        settings {
            selectListType: multiValueSelectList
        }
        lov {
            type: sharedComponent
            lov: @lov-filiaisfavorita
        }
        layout {
            sequence: 40
            region: @cadastro-de-promoções-datas-vencimentos
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P520_IDFILIAISROMANCE (
        type: plugin/select
        label {
            label: Filiais Romance
            alignment: left
        }
        settings {
            selectListType: multiValueSelectList
        }
        lov {
            type: sharedComponent
            lov: @lov-filiaisromance
        }
        layout {
            sequence: 30
            region: @cadastro-de-promoções-datas-vencimentos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P520_IDFORMAPAGAMENTO (
        type: selectList
        label {
            label: Pagamentos
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ff.descricao
                     , ff.idformapagamento
                from favorita.formaspagamentos ff
                where ff.idtipoformapagamento = 1;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 90
            region: @cadastro-de-promoções-datas-vencimentos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P520_IDPAIS (
        type: selectList
        label {
            label: Pais
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pa.nome
                     , pa.idpais
                from catal.paises pa
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @cadastro-de-promoções-datas-vencimentos
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P520_IDPROMOCAODATASPARCELAM (
        type: hidden
        layout {
            sequence: 10
            region: @new
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P520_MENSAGEM (
        type: textField
        label {
            label: Mensagem
            alignment: left
        }
        layout {
            sequence: 10
            region: @mensagem
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P520_NOME (
        type: textField
        label {
            label: Nome
            alignment: left
        }
        layout {
            sequence: 10
            region: @cadastro-de-promoções-datas-vencimentos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

