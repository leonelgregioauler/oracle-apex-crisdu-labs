        type: textField
        label {
            label: Numero de Parcelas
            alignment: left
        }
        layout {
            sequence: 110
            region: @cadastro-de-promoções-datas-vencimentos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P520_PRAZOVENCIMENTO (
        type: textField
        label {
            label: Prazo Vencimento
            alignment: left
        }
        layout {
            sequence: 100
            region: @cadastro-de-promoções-datas-vencimentos
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P520_VALORFINAL (
        type: textField
        label {
            label: Valor Final
            alignment: left
        }
        layout {
            sequence: 80
            region: @cadastro-de-promoções-datas-vencimentos
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P520_VALORINICIAL (
        type: textField
        label {
            label: Valor Inicial
            alignment: left
        }
        layout {
            sequence: 70
            region: @cadastro-de-promoções-datas-vencimentos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 30
            region: @cadastro-de-promoções-datas-vencimentos
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P520_IDPROMOCAODATASPARCELAM
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 40
            region: @cadastro-de-promoções-datas-vencimentos
            slot: help
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P520_IDPROMOCAODATASPARCELAM
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 20
            region: @cadastro-de-promoções-datas-vencimentos
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P520_IDPROMOCAODATASPARCELAM
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @cadastro-de-promoções-datas-vencimentos
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 519
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process processo-dml (
        name: Processo DML
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vmd5 varchar2(4000);
                  
                  --
                Begin
                  --
                  favorita.pck_cadastros_fav.prc_promocoesdatasparcelamento ( pidpromocaodatasparcelamento => :P520_IDPROMOCAODATASPARCELAM
                                                                            , pnome                        => :P520_NOME
                                                                            , pidfiliaisromance            => :P520_IDFILIAISROMANCE
                                                                            , pidfiliaisfavorita           => :P520_IDFILIAISFAVORITA
                                                                            , pdatainicial                 => :P520_DATAINICIAL
                                                                            , pdatafinal                   => :P520_DATAFINAL
                                                                            , pvalorinicial                => :P520_VALORINICIAL
                                                                            , pvalorfinal                  => :P520_VALORFINAL
                                                                            , pidformapagamento            => :P520_IDFORMAPAGAMENTO
                                                                            , pprazovencimento             => :P520_PRAZOVENCIMENTO
                                                                            , pnumeroparcelas              => :P520_NUMEROPARCELAS
                                                                            , pidpais                      => :P520_IDPAIS
                                                                            , pmensagem                    => :P520_MENSAGEM
                                                                            , pmd5                         => vmd5
                                                                            , poperacao_dml                => 'S');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 7514819064243915
        }
    )

    process processo-dml-iad (
        name: Processo DML IAD
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vmd5 varchar2(4000);
                  voperacao_dml varchar2(1);
                  --
                Begin
                  --
                  if :REQUEST = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif :REQUEST = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif :REQUEST = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  favorita.pck_cadastros_fav.prc_promocoesdatasparcelamento ( pidpromocaodatasparcelamento => :P520_IDPROMOCAODATASPARCELAM
                                                                            , pnome                        => :P520_NOME
                                                                            , pidfiliaisromance            => :P520_IDFILIAISROMANCE
                                                                            , pidfiliaisfavorita           => :P520_IDFILIAISFAVORITA
                                                                            , pdatainicial                 => :P520_DATAINICIAL
                                                                            , pdatafinal                   => :P520_DATAFINAL
                                                                            , pvalorinicial                => :P520_VALORINICIAL
                                                                            , pvalorfinal                  => :P520_VALORFINAL
                                                                            , pidformapagamento            => :P520_IDFORMAPAGAMENTO
                                                                            , pprazovencimento             => :P520_PRAZOVENCIMENTO
                                                                            , pnumeroparcelas              => :P520_NUMEROPARCELAS
                                                                            , pidpais                      => :P520_IDPAIS
                                                                            , pmensagem                    => :P520_MENSAGEM
                                                                            , pmd5                         => vmd5
                                                                            , poperacao_dml                => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 7515472100243921
        }
    )

)

