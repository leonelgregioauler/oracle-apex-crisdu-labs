page 49 (
    name: Cadastro de Brindes
    title: Brindes
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        height: 600
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region brindes (
        name: Brindes
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P49_DATAFINAL (
        type: datePickerJquery
        label {
            label: Data Final
            alignment: left
        }
        layout {
            sequence: 20
            region: @brindes
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P49_DATAINICIAL (
        type: datePickerJquery
        label {
            label: Data Inicial
            alignment: left
        }
        layout {
            sequence: 10
            region: @brindes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P49_IDBRINDE (
        type: hidden
        layout {
            sequence: 40
            region: @brindes
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P49_IDEDICAOREVISTA (
        type: selectList
        label {
            label: Edição da Revista
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-edicoesrevistas
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 60
            region: @brindes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P49_IDFILIALFAVORITAORIGEM (
        type: selectList
        label {
            label: Fil Fav. Origem
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-filiaisfavorita
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 30
            region: @brindes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P49_IDFILIALROMANCE (
        type: selectList
        label {
            label: Filial Romance
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-filiaisromance
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 50
            region: @brindes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P49_IDPRODUTODETALHADO (
        type: popupLov
        label {
            label: Produto Detalhado
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sharedComponent
            lov: @lov-produtosdetalhados
        }
        layout {
            sequence: 100
            region: @brindes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 65
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P49_QTDPEDIDOSCONSULTORA (
        type: numberField
        label {
            label: Quantidade de Pedidos Consultora
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 70
            region: @brindes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 5
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P49_QUANTIDADE (
        type: numberField
        label {
            label: Quantidade
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 110
            region: @brindes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P49_VALORPEDIDO (
        type: textField
        label {
            label: Valor do Pedido
            alignment: left
        }
        layout {
            sequence: 90
            region: @brindes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            customAttributes: "onkeyup=\"formataMoeda(this);\" "
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P49_VALORUTILIZAR (
        type: selectList
        label {
            label: Valor Utilizar
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Valor Catalogo;VC,Valor a Pagar;VP
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @brindes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 50
            region: @brindes
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P49_IDBRINDE
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 40
            region: @brindes
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P49_IDBRINDE
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 30
            region: @brindes
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 48
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 20
            region: @brindes
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P49_IDBRINDE
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @brindes
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P49_IDBRINDE
        }
    )

    validation datafinal-válida (
        name: DATAFINAL válida
        execution {
            sequence: 60
        }
        validation {
            type: itemIsAValidDate
            item: P49_DATAFINAL
        }
        error {
            errorMessage: Data final deve ser uma data válida.
            associatedItem: @P49_DATAFINAL
        }
    )

    validation datainicial-válida (
        name: DATAINICIAL válida
        execution {
            sequence: 50
        }
        validation {
            type: itemIsAValidDate
            item: P49_DATAINICIAL
        }
        error {
            errorMessage: Data inicial deve ser uma data válida.
            associatedItem: @P49_DATAINICIAL
        }
    )

    validation idprodutodetalhado-obrigatório (
        name: IDPRODUTODETALHADO obrigatório
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P49_IDPRODUTODETALHADO
        }
        error {
            errorMessage: Produto Detalhado deve ser informado.
            associatedItem: @P49_IDPRODUTODETALHADO
        }
    )

    validation qtdpedidosconsultora-inteiro (
        name: QTDPEDIDOSCONSULTORA inteiro
        execution {
            sequence: 70
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  verro varchar2(1000);
                begin
                  if instr(:P49_QTDPEDIDOSCONSULTORA, ',') > 0 or
                     instr(:P49_QTDPEDIDOSCONSULTORA,'.') > 0 then
                    --
                    return 'Quantidade de pedidos consultora deve ser um número inteiro';
                    --
                  else
                    null;
                  end if;
                end;
                ```
        }
        error {
            associatedItem: @P49_QTDPEDIDOSCONSULTORA
        }
    )

    validation qtdpedidosconsultora-maior-que (
        name: QTDPEDIDOSCONSULTORA maior que 0
        execution {
            sequence: 80
        }
        validation {
            plsqlExpression: :P49_QTDPEDIDOSCONSULTORA > 0
        }
        error {
            errorMessage: "Quantidade deve ser maior que zero (0) "
            associatedItem: @P49_QTDPEDIDOSCONSULTORA
        }
        serverSideCondition {
            type: expression
            plsqlExpression: instr(:P49_QTDPEDIDOSCONSULTORA, '.') = 0
        }
    )

    validation quantidade-inteiro (
        name: QUANTIDADE inteiro
        execution {
            sequence: 90
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  verro varchar2(1000);
                begin
                  if instr(:P49_QUANTIDADE, ',') > 0 or
                     instr(:P49_QUANTIDADE,'.') > 0 then
                    --
                    return 'Quantidade deve ser um número inteiro';
                    --
                  else
                    null;
                  end if;
                end;
                ```
        }
        error {
            associatedItem: @P49_QUANTIDADE
        }
    )

    validation quantidade-maior-que (
        name: QUANTIDADE maior que 0
        execution {
            sequence: 100
        }
        validation {
            plsqlExpression: :P49_QUANTIDADE > 0
        }
        error {
            errorMessage: Quantidade deve ser maior que zero (0)
            associatedItem: @P49_QUANTIDADE
        }
        serverSideCondition {
            type: expression
            plsqlExpression: instr(:P49_QUANTIDADE , '.') = 0
        }
    )

    process consulta-brindes (
        name: Consulta Brindes
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vvalorpedido    number(15,2);
                begin
                  #OWNER#.PCK_COMERCIAL_FAV.PRC_BRINDES (
                    PIDBRINDE => :P49_IDBRINDE,
                    PIDPRODUTODETALHADO => :P49_IDPRODUTODETALHADO,
                    PIDFILIALROMANCE => :P49_IDFILIALROMANCE,
                    PQUANTIDADE => :P49_QUANTIDADE,
                    PIDFILIALFAVORITAORIGEM => :P49_IDFILIALFAVORITAORIGEM,
                    PQTDPEDIDOSCONSULTORA => :P49_QTDPEDIDOSCONSULTORA,
                    PVALORPEDIDO => vvalorpedido,
                    PIDEDICAOREVISTA => :P49_IDEDICAOREVISTA,
                    PDATAINICIAL => :P49_DATAINICIAL,
                    PDATAFINAL => :P49_DATAFINAL,
                    PMD5 => :P3_MD5,
                    POPERACAO_DML => 'S',
                    PVALORUTILIZAR => :P49_VALORUTILIZAR);
                  --
                  :P49_VALORPEDIDO     := Trim(to_char(vvalorpedido    ,'999G999G999G990D00'));
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 3015330503146449
        }
    )

    process limpar-campos-ao-sair (
        name: Limpar Campos ao Sair
        type: clearSessionState
        execution {
            sequence: 10
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 3136816940224910
        }
    )

    process limpar-campos-para-adicionar (
        name: Limpar Campos para Adicionar
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 3136968204224911
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    process operação-dml-em-brindes (
        name: Operação DML em Brindes
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                  --
                  vvalorpedido  number;
                  --
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  vvalorpedido             := to_number(:P49_VALORPEDIDO        ,'999G999G999G990D00'); 
                  --
                  #OWNER#.PCK_COMERCIAL_FAV.PRC_BRINDES (
                    PIDBRINDE => :P49_IDBRINDE,
                    PIDPRODUTODETALHADO => :P49_IDPRODUTODETALHADO,
                    PIDFILIALROMANCE => :P49_IDFILIALROMANCE,
                    PQUANTIDADE => :P49_QUANTIDADE,
                    PIDFILIALFAVORITAORIGEM => :P49_IDFILIALFAVORITAORIGEM,
                    PQTDPEDIDOSCONSULTORA => :P49_QTDPEDIDOSCONSULTORA,
                    PVALORPEDIDO => vvalorpedido,
                    PIDEDICAOREVISTA => :P49_IDEDICAOREVISTA,
                    PDATAINICIAL => :P49_DATAINICIAL,
                    PDATAFINAL => :P49_DATAFINAL,
                    PMD5 => :P3_MD5,
                    POPERACAO_DML => voperacao_dml,
                    PVALORUTILIZAR => :P49_VALORUTILIZAR);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro inserido/atualizado.
        }
        advanced {
            executionMappingIdentifier: 3134631968166793
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 49
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

)

