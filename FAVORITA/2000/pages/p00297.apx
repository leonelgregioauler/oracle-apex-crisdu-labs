page 297 (
    name: Relatório de Kits que não estão na revista
    title: Relatório de Kits que não estão na revista
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG_22"';
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region relatório-de-kits-que-não-estão-na-revista (
        name: Relatório de Kits que não estão na revista
        type: tabform
        source {
            sqlQuery:
                ```sql
                select distinct idkitvenda
                     , kv.referencia
                     , kv.ativo
                     , kv.descricao
                     , nvl(( select count(1) -sum(( select count(it.idkitvenda)
                                                     from favorita.itenskitsvendas it
                                                     where it.idkitvenda     = ik.idkitvenda))  b
                             from favorita.itenskitsvendas ik
                             where ik.idkitvenda     = kv.idkitvenda
                               and not exists ( select distinct 1
                                                from favorita.produtosdetedrevistas pr
                                                where pr.idprodutodetalhado = ik.idprodutodetalhado
                                                  and pr.idedicaorevista = :P297_IDEDICAOREVISTA)),0)*-1 QtdItens
                from favorita.vw_kitsvendas_fav kv
                where exists( select 1
                              from favorita.itenskitsvendas ik
                              where ik.idkitvenda = kv.idkitvenda
                                and not exists( select 1
                                                from favorita.precositenskitsvendas pk
                                                where pk.iditemkitvenda = ik.iditemkitvenda
                                                  and pk.idedicaorevista = :P297_IDEDICAOREVISTA))
                  and kv.ididioma = :P0_IDIDIOMA
                ```
        }
        layout {
            sequence: 15
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column ATIVO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Ativo
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
        )

        column DERIVED$01 (
            reportColumnQueryId: 6
            derivedColumn: Y
            type: simpleCheckbox
            heading {
                heading: Selecionar
                alignment: center
            }
            lov {
                checkboxValues: S
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column DESCRICAO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column IDKITVENDA (
            reportColumnQueryId: 1
            derivedColumn: N
            type: plainTextSavesState
            heading {
                heading: Cod. kitvenda
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
        )

        column QTDITENS (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Itens Fora da Revista
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: center
            }
        )

        column REFERENCIA (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Referência
                alignment: center
            }
            layout {
                sequence: 2
            }
        )

    )

    pageItem P297_IDEDICAOREVISTA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @relatório-de-kits-que-não-estão-na-revista
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P297_TIPOVENDA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @relatório-de-kits-que-não-estão-na-revista
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button copiar-kits (
        buttonName: COPIAR_KITS
        label: Copiar kits
        layout {
            sequence: 10
            region: @relatório-de-kits-que-não-estão-na-revista
            slot: bottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--primary
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process copiar-kits (
        name: Copiar_Kits
        type: executeCode
        editableRegion: @relatório-de-kits-que-não-estão-na-revista
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  vidkitvenda number;
                  --
                  vnumber  number := 0;
                  vnumber2 number := 0;
                  --
                begin
                    --
                      for ritkit in ( select *
                                      from favorita.itenskitsvendas ik
                                      where ik.idkitvenda     = :IDKITVENDA)
                
                      loop
                          --
                          vnumber2 :=1;
                          --
                        /*  begin
                            --
                            select distinct 1
                            into vnumber
                            from favorita.produtosdetedrevistas pr
                            where pr.idprodutodetalhado = ritkit.idprodutodetalhado
                              and pr.idedicaorevista = :P297_IDEDICAOREVISTA;
                            --
                          exception
                            when no_data_found then 
                              raise_application_error(-20001,'Produto'||favorita.pck_util_fav.fnc_nomeprodutodetalhado(ritkit.idprodutodetalhado,:P0_IDIDIOMA) ||' nao cadastrado na revista') ;
                          end;
                          --
                            --
                            select distinct 1
                            into vnumber
                            from favorita.precosprodutos pe
                            where pe.idprodutodetalhado = ritkit.idprodutodetalhado
                              and pe.idedicaorevista = :P297_IDEDICAOREVISTA;
                            --
                          if vnumber = 0 then
                               raise_application_error(-20001,'Produto sem preço para a revista');
                          end if;*/
                
                      PCK_CADASTROS_FAV.prc_precositenskitsvendas ( piditemkitvenda  => ritkit.iditemkitvenda
                                                                  , pidedicaorevista => :P297_IDEDICAOREVISTA
                                                                  , pidkitvenda      => :IDKITVENDA
                                                                  , poperacao_dml    => 'I');
                      end loop; 
                      --
                      if vnumber2 = 0 then
                        --
                         raise_application_error(-20001,'Produto detalhado nao encontrado');
                        --
                      end if;
                      --
                
                
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Cadastrado com sucesso
        }
        advanced {
            executionMappingIdentifier: 1396361343137955538
        }
        serverSideCondition {
            whenButtonPressed: @copiar-kits
        }
    )

    branch (
        name: Go To Page 297
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 297
            }
        }
    )

)

