    pageItem P329_IDCONTABANCARIA (
        type: selectList
        label {
            label: Conta para Depósito
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(cb.beneficiario,p.apelido)||'('||b.nomebanco)||' - '||cb.agencia ||', '||cb.conta||') - Fornecedor: '||roman.pck_romance.fnc_nomefornecedor(f.idfornecedor) display_value
                     , cb.idcontabanc    return_value
                from roman.contasbancarias cb
                   , roman.bancos b
                   , pessoas p
                   , fornecedores f
                   , comprastransferencias c
                where cb.idbanco      = b.idbanco
                  and cb.idfornecedor = f.idfornecedor
                  and f.idpessoa      = p.idpessoa
                  and cb.idfornecedor = c.idfornecedor
                  and cb.ativo        = 'S'
                  and c.idcompratransferencia = :P329_IDCOMPRATRANSFERENCIA
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 100
            region: @gerar-vencimentos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P329_IDCONTAFINANCEIRA (
