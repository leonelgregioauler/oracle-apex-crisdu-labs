page 329 (
    name: Vencimentos de Compras
    title: Vencimentos de Compras
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 80%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region gerar-vencimentos (
        name: Gerar Vencimentos
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region vencimentos-gerados (
        name: Vencimentos Gerados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pg.dias
                     , v.datavencimento
                     , v.valorpagar
                     , v.saldo
                     , pg.formapagamento
                     , pg.situacaopagamento
                     , pg.contabancaria
                     , pg.contafinanceira
                     , pg.subcontafinanceira
                     , pg.descidentificado
                     , pg.moeda
                     , v.idvencimentocompratransf
                     , pg.idpagamentocompratransf
                from vw_vencimentoscompratransf_fav v
                   , vw_pagamentoscomprastransf_fav pg
                where pg.idvencimentocompratransf = v.idvencimentocompratransf
                  and pg.ididioma                 = 1
                  and v.idcompratransferencia     = :P329_IDCOMPRATRANSFERENCIA
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 329
                items: {
                    P329_IDVENCIMENTOCOMPRATRANSF: #IDVENCIMENTOCOMPRATRANSF#
                    P329_IDPAGAMENTOCOMPRATRANSF: #IDPAGAMENTOCOMPRATRANSF#
                    P329_IDCOMPRATRANSFERENCIA: &P329_IDCOMPRATRANSFERENCIA.
                }
                action: resetPagination
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 1414488702111235820
        }

