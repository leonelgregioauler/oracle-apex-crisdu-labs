    pageItem P329_VALORCOMPRA (
        type: numberField
        label {
            label: Valor Pendente
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 90
            region: @gerar-vencimentos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select TO_CHAR(c.valortotalcompra 
                             +(select sum(o.valororcamento)
                               from orcamentosfretecomprastransf o
                               where o.idcompratransferencia = c.idcompratransferencia
                                 and o.somarvencimento       = 'S')
                             - nvl(( select sum(v.valorvencimento)
                                     from vencimentoscomprastransf v
                                     where v.idcompratransferencia = c.idcompratransferencia
                                       and v.situacaovencimento = 'V' ),0),'999G999G999G999G999G990D00') valor
                from comprastransferencias c
                where c.idcompratransferencia = :P329_IDCOMPRATRANSFERENCIA
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

