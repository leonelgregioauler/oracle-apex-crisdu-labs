    dynamicAction tipo-boleto (
        name: Tipo Boleto
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P329_IDFORMAPAGAMENTO
        }
        clientSideCondition {
            type: itemIsInList
            item: P329_IDFORMAPAGAMENTO
            list: [
                1
                2
            ]
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P329_IDCONTABANCARIA
            }
            execution {
                sequence: 10
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P329_IDCONTABANCARIA
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    validation valida-moeda (
        name: Valida Moeda
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P329_IDMOEDA
        }
        error {
            errorMessage: Informe a Moeda que será utilizada.
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('APP_USER') in ('SALVAR','GERAR_VENCIMENTO')
                ```
        }
    )

    process consulta-de-gerar-vencimento (
        name: Consulta de Gerar Vencimento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vvalorvencimento number(15,2);
                  vdatavencimento  date;
                  --
                begin
                  --
                  pck_comprastransfparc_fav.prc_geravencimentocompra(pidcompratransferencia => :P329_IDCOMPRATRANSFERENCIA,
                                                                     pidvencimentocompra => :P329_IDVENCIMENTOCOMPRATRANSF,
                                                                     pidpagamentocompra => :P329_IDPAGAMENTOCOMPRATRANSF,
                                                                     pidformapagamento => :P329_IDFORMAPAGAMENTO,
                                                                     pdatavencimento => vdatavencimento,
                                                                     pvalorvencimento => vvalorvencimento,
                                                                     pidcontafinanceira => :P329_IDCONTAFINANCEIRA,
                                                                     pidsubcontafinanceira => :P329_IDSUBCONTAFINANCEIRA,
                                                                     pidcontabancaria => :P329_IDCONTABANCARIA,
                                                                     pidentificado => :P329_IDENTIFICADO,
                                                                     pidmoeda => :P329_IDMOEDA,
                                                                     pidusuario => :P0_IDUSUARIO,
                                                                     poperacao_dml => 'S');
                  --
                  :P329_DATAVENCIMENTO  := to_date(vdatavencimento,'DD/MM/RRRR');
                  :P329_VALORVENCIMENTO := to_char(vvalorvencimento,'999G999G999G990D00');
                  --
                end;
                
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 1414488452708235817
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P329_IDPAGAMENTOCOMPRATRANSF is not null
                  and :P329_IDVENCIMENTOCOMPRATRANSF is not null
                ```
        }
    )

    process processo-dml-para-gerar-vencimento-da-compra (
        name: Processo DML para Gerar Vencimento da Compra
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  voperacao_dml varchar2(1);
                  vvalorvencimento number(15,2);
                  vdatavencimento  date := to_date(:P329_DATAVENCIMENTO,'DD/MM/RRRR');
                  --
                begin
                  --
                  if v('REQUEST') = 'GERAR_VENCIMENTO' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'DELETAR' then
                    voperacao_dml := 'D';
                  elsif v('REQUEST') = 'SALVAR' then
                    voperacao_dml := 'U';
                  end if;
                  --
                  vvalorvencimento := to_number(:P329_VALORVENCIMENTO,'999G999G999G990D00');
                  --
                  pck_comprastransfparc_fav.prc_geravencimentocompra(pidcompratransferencia => :P329_IDCOMPRATRANSFERENCIA,
                                                                     pidvencimentocompra => :P329_IDVENCIMENTOCOMPRATRANSF,
                                                                     pidpagamentocompra => :P329_IDPAGAMENTOCOMPRATRANSF,
                                                                     pidformapagamento => :P329_IDFORMAPAGAMENTO,
                                                                     pdatavencimento => vdatavencimento,
                                                                     pvalorvencimento => vvalorvencimento,
                                                                     pidcontafinanceira => :P329_IDCONTAFINANCEIRA,
                                                                     pidsubcontafinanceira => :P329_IDSUBCONTAFINANCEIRA,
                                                                     pidcontabancaria => :P329_IDCONTABANCARIA,
                                                                     pidentificado => :P329_IDENTIFICADO,
                                                                     pidmoeda => :P329_IDMOEDA,
                                                                     pidusuario => :P0_IDUSUARIO,
                                                                     poperacao_dml => voperacao_dml);
                  --
                  
                  --
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo Realizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1414488268924235815
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
