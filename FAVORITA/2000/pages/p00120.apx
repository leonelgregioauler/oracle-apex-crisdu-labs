page 120 (
    name: Relatório de Telefones Bloqueados
    title: Relatório de Telefones Bloqueados
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region relatório-de-telefones-bloqueados (
        name: Relatório de Telefones Bloqueados
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idtelefonebloqueado
                     , idoperadoratel
                     , telefone
                     , descricao
                     , codigo
                     , nome
                  from vw_telefonesbloqueados_fav;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 15481033142240949
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDTELEFONEBLOQUEADO
                layout {
                    width: 96
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDOPERADORATEL
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @TELEFONE
                layout {
                    width: 192
                    sequence: 3
                }
            )

            displayColumn (
                column: @DESCRICAO
                layout {
                    width: 369
                    sequence: 4
                }
            )

            displayColumn (
                column: @CODIGO
                layout {
                    width: 94
                    sequence: 5
                }
            )

            displayColumn (
                column: @NOME
                layout {
                    width: 174
                    sequence: 6
                }
            )

        )

        column CODIGO (
            type: textField
            heading {
                heading: Código Operadora
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                databaseColumn: CODIGO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column DESCRICAO (
            type: textarea
            heading {
                heading: Descrição
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: DESCRICAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column IDOPERADORATEL (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDOPERADORATEL
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDTELEFONEBLOQUEADO (
            type: link
            heading {
                heading: Editar
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            link {
                target: {
                    page: 121
                    items: {
                        P121_IDTELEFONEBLOQUEADO: &IDTELEFONEBLOQUEADO.
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                databaseColumn: IDTELEFONEBLOQUEADO
                dataType: number
            }
        )

        column NOME (
            type: textarea
            heading {
                heading: Operadora
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: NOME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column TELEFONE (
            type: textField
            heading {
                heading: Telefone
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: TELEFONE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 121
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

