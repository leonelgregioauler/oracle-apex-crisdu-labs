    dynamicAction atualiza-custo-unico (
        name: Atualiza Custo Unico
        execution {
            sequence: 12
        }
        when {
            selectionType: items
            items: P96_CUSTOVIRTUALUNICO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: null;
                itemsToSubmit: P96_CUSTOVIRTUALUNICO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction calcula-valor-comissão-atendente (
        name: Calcula valor Comissão Atendente
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P96_PERCCOMISSAOATENDENTE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    :P96_VALORCOMISSAOATENDENTE := to_char( ( to_number(:P96_VALORVENDA,            '999G999G999G990D00') * 
                                                            ( to_number(:P96_PERCCOMISSAOATENDENTE, '999G999G999G990D00') / 100)), '999G999G999G990D00');
                    ```
                itemsToSubmit: [
                    P96_PERCCOMISSAOATENDENTE
                    P96_VALORVENDA
                ]
                itemsToReturn: P96_VALORCOMISSAOATENDENTE
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction custo-unico (
        name: Custo Unico
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P96_CUSTOVIRTUALUNICO
        }
        clientSideCondition {
            type: item=value
            item: P96_CUSTOVIRTUALUNICO
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P96_CUSTO_FISCAL_BELEM
                    P96_CUSTO_FISCAL_CAMPO_GRANDE
                    P96_CUSTO_FISCAL_MANAUS
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P96_CUSTO_FISCAL_BELEM
