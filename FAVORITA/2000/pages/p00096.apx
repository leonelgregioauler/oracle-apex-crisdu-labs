    process gerar-novo-arquivo-produto (
        name: Gerar Novo Arquivo Produto
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  for rprod in ( select pd.idprodutodetalhado
                                 from favorita.produtosdetalhados pd
                                 where pd.idproduto = :P96_IDPRODUTO)
                  loop
                    --
                    PCK_ARQUIVOSINTVIRTUALAGE_FAV.prc_arquivoprodutosdet(pidprodutodetalhado => rprod.idprodutodetalhado);
                    --
                  end loop;
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 15809625038175802
        }
        serverSideCondition {
            type: request=Value
            value: GERARARQPRODESPECIFICOS
        }
    )

    process operação-dml-em-preços-produtos (
        name: Operação DML em Preços Produtos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                  --
                  vvalorcusto             number;
                  vvalorvenda             number;
                  vvalor                  number;
                  vvalorcomissaoatendente number;
                  --
                  vcustofiscaligrejinha   number;
                  vcustofiscalbelem       number;
                  vcustofiscalcampogrande number;
                  vcustofiscalmanaus      number;
                  --
                  vfiliais APEX_APPLICATION_GLOBAL.VC_ARR2;
                  --
                begin  --
                  --transforma o string do shutle em tabela
                  --
                  vfiliais  := APEX_UTIL.STRING_TO_TABLE(:P96_IDFILIALROMANCE);
                  --
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  if :P96_CUSTOVIRTUALUNICO = 'S' then
                    --
                    vcustofiscaligrejinha   := :P96_CUSTO_FISCAL_IGREJINHA;
                    vcustofiscalbelem       := :P96_CUSTO_FISCAL_IGREJINHA;
                    vcustofiscalcampogrande := :P96_CUSTO_FISCAL_IGREJINHA;
                    vcustofiscalmanaus      := :P96_CUSTO_FISCAL_IGREJINHA;
                    --
                  elsif :P96_CUSTOVIRTUALUNICO = 'N' then
                    --
                    vcustofiscaligrejinha   := :P96_CUSTO_FISCAL_IGREJINHA;
                    vcustofiscalbelem       := :P96_CUSTO_FISCAL_BELEM;
                    vcustofiscalcampogrande := :P96_CUSTO_FISCAL_CAMPO_GRANDE;
                    vcustofiscalmanaus      := :P96_CUSTO_FISCAL_MANAUS;
                    --
                  end if;
                  --
                  --insere na tabela associativa
                  vvalorcusto                := to_number(:P96_VALORCUSTO                ,'999G999G999G990D00');
                  vvalorvenda                := to_number(:P96_VALORVENDA                ,'999G999G999G990D00'); 
                  vvalorcomissaoatendente    := to_number(:P96_VALORCOMISSAOATENDENTE    ,'999G999G999G990D00'); 
                  vvalor                     := to_number(:P96_VALORVENDA                ,'999G999G999G990D00');
                  --
                  --
                  for rfil in 1.. vfiliais.count 
                  loop
                    #OWNER#.PCK_CADASTROS_FAV.PRC_PRECOSPRODUTOS ( PIDPRECOPRODUTO           => :P96_IDPRECOPRODUTO
                                                                 , PIDEDICAOREVISTA          => :P96_IDEDICAOREVISTA
                                                                 , PIDPRODUTO                => :P96_IDPRODUTO
                                                                 , PIDPRODUTODETALHADO       => :P96_IDPRODUTODETALHADO
                                                                 , PIDFILIALROMANCE          => vfiliais(rfil)
                                                                 , PVALORCUSTO               => vvalorcusto
                                                                 , PVALORVENDA               => vvalor
                                                                 , PPERCCOMISSAOGERENTE      => :P96_PERCCOMISSAOGERENTE
                                                                 , PPERCCOMISSAODISTRIBUIDOR => :P96_PERCCOMISSAODISTRIBUIDOR
                                                                 , PPERCCOMISSAOCONSULTORA   => :P96_PERCCOMISSAOCONSULTORA
                                                                 , PVALORCOMISSAOATENDENTE   => vvalorcomissaoatendente
                                                                 , pcustofiscaligrejinha     => vcustofiscaligrejinha
                                                                 , pcustofiscalcampogrande   => vcustofiscalcampogrande
                                                                 , pcustofiscalbelem         => vcustofiscalbelem
                                                                 , pcustofiscalmanaus        => vcustofiscalmanaus
                                                                 , PMD5                      => :P96_MD5
                                                                 , POPERACAO_DML             => voperacao_dml);
                  end loop;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Preços foram inseridos ou atualizados com sucesso.
        }
        advanced {
            executionMappingIdentifier: 477460639962547028
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: INSERIR,ATUALIZAR,EXCLUIR
        }
    )

