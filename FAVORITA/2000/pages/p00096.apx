    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 50
            region: @preços-produtos
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from produtosdetalhados
                where idproduto = :P96_IDPRODUTO;
                ```
        }
    )

    button consultarprecos (
        buttonName: CONSULTARPRECOS
        label: Consultar Preços
        layout {
            sequence: 30
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--primary
                t-Button--iconLeft
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:visualizaPrecosProduto();
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from produtosdetalhados
                where idproduto = :P96_IDPRODUTO;
                ```
        }
    )

    button estoques (
        buttonName: ESTOQUES
        label: Gerar Estoques
        layout {
