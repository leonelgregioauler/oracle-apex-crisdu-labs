    pageItem P96_SESSION_PARAMETROS (
        type: hidden
        layout {
            sequence: 220
            region: @preços-produtos
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_url varchar2(2000);
                    l_app number := 2000;
                    l_session number := v('APP_SESSION');
                BEGIN
                    l_url := APEX_UTIL.PREPARE_URL(
                        p_url => 'f?p=' || l_app || ':52:'||l_session||'::NO::P52_IDPRODUTO,P52_IDEDICAOREVISTA:'||:P96_IDPRODUTO||','||:P96_IDEDICAOREVISTA,
                        p_checksum_type => 'SESSION');
                    
                    return l_url;
                END;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

