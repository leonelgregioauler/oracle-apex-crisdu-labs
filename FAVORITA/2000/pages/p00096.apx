page 96 (
    name: Cadastro de Preços de Produtos
    title: Cadastro de Preços de Produtos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            
            function visualizaPrecosProduto () 
              {
                  vidproduto       = document.getElementById("P96_IDPRODUTO").value;
                  videdicaorevista = document.getElementById("P96_IDEDICAOREVISTA").value;
                  
                  pjanela = window.open('f?p=&APP_ID.:52:&SESSION.::NO::P52_IDPRODUTO,P52_IDEDICAOREVISTA:'+vidproduto+','+videdicaorevista,'_blank','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1280,height=1024,','_blank');
                  pjanela.focus();
              }
            
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region integração-virtual-age (
        name: Integração Virtual Age
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @opções
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region novo-produto (
        name: Novo Produto
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region preços-produtos (
        name: Preços Produtos
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P96_CUSTOVIRTUALUNICO (
        type: radioGroup
        label {
            label: Custo Virtual Unico
            alignment: left
        }
        settings {
            noOfCols: 2
