            type: staticValues
            staticValues: STATIC:Sim;S,Não;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 170
            region: @preços-produtos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: S
        }
        security {
            encryptSessionState: false
        }
    )

