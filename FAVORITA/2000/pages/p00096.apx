    pageItem P96_FILIAIS (
        type: checkboxGroup
        label {
            label: Filiais
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select listagg(roman.pck_romance.fnc_nomefilial(idfilialromance),',') within group (order by 1) as d
                , NULL as r
                from precosprodutos p
                where p.idprodutodetalhado = :P96_IDPRODUTODETALHADO
                  and p.idedicaorevista = :P96_IDEDICAOREVISTA
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P96_IDPRODUTODETALHADO
        }
        layout {
            sequence: 70
            region: @preços-produtos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P96_GRUPOSFILIAIS (
        type: radioGroup
        label {
            label: "Grupo "
            alignment: left
        }
        settings {
            noOfCols: 9
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.nome showvalue
                     , i.ididioma returnvalue
                from favorita.idiomas i
                where exists (select 1
                              from roman.vw_filiais v
                              where i.ididioma = v.ididioma)
                union
                select 'Parceiras' showvalue
                     , 0 returnvalue
                from dual
                union
                select 'Todas' showvalue
                     , -1 returnvalue
                from dual
                order by 1 desc
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @preços-produtos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P96_IDEDICAOREVISTA (
        type: selectList
