        }
    )

    pageItem P96_IDFILIALROMANCE (
        type: shuttle
        label {
            label: Filial Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome as d,
                       idfilial as r
                from roman.vw_filiais v
                where tipofilial in ('C', 'D','T','L')
                  and ativo = 'S'
                  and (:P96_GRUPOSFILIAIS = -1
                       or (v.ididioma = :P96_GRUPOSFILIAIS))
                union
                select nome as d,
                       idfilial as r
                from roman.vw_filiais v
                where tipofilial in ('P')
                  and ativo = 'S'
                  and (:P96_GRUPOSFILIAIS = -1
                       or (:P96_GRUPOSFILIAIS = 0))
                 order by 1
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P96_GRUPOSFILIAIS
        }
        layout {
            sequence: 90
            region: @preços-produtos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 5
        }
        security {
            encryptSessionState: false
        }
    )

