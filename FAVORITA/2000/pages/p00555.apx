page 555 (
    name: Relatorio de Metas de Lojas
    title: Relatorio de Metas de Lojas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region copiar-metas (
        name: Copiar Metas
        type: staticContent
        layout {
            sequence: 20
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-size600x400
            ]
        }
        advanced {
            htmlDomId: COPIARMETAS
            regionDisplaySelector: true
        }
    )

    region metas (
        name: Metas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDMETACOBRANCA
                ,VALORMETA
                ,IDUSUARIO
                ,DATAINICIO
                ,DATAFIM
                ,IDGRUPOATENDIMENTO
                ,IDFILIALFAVORITA
                , pck_util_fav.fnc_nomefilialfavorita( idfilialfavorita ) nomeFilial
                , (select descricao from roman.gruposatendimento where idgrupoatendimento = M.IDGRUPOATENDIMENTO) grupoatendimento
                from METASCOBRANCAS M
                where exists ( select 1
                                 from usuariosfiliaisfavorita uf
                                where uf.idusuario = :P0_IDUSUARIO
                                  and uf.idfilialfavorita = m.idfilialfavorita )
                  
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 556
                items: {
                    P556_IDMETACOBRANCA: #IDMETACOBRANCA#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: "Nenhuma meta encontrada. "
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 53987811119255189
        }

        column DATAFIM (
            type: plainText
            heading {
                heading: Data Fim
                alignment: center
            }
            layout {
                sequence: 75
                columnAlignment: center
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: L
            }
        )

        column DATAINICIO (
            type: plainText
            heading {
                heading: Data de Início
                alignment: center
            }
            layout {
                sequence: 65
                columnAlignment: center
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: K
            }
        )

        column GRUPOATENDIMENTO (
            type: plainText
            heading {
                heading: Grupo de atendimento
            }
            layout {
                sequence: 115
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: P
            }
        )

        column IDFILIALFAVORITA (
            type: hidden
            heading {
                heading: Idfilialfavorita
            }
            layout {
                sequence: 95
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: N
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDGRUPOATENDIMENTO (
            type: plainText
            heading {
                heading: Idgrupoatendimento
                alignment: center
            }
            layout {
                sequence: 85
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: M
            }
        )

        column IDMETACOBRANCA (
            type: hidden
            heading {
                heading: Idmetacobranca
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDUSUARIO (
            type: plainTextBasedOnLov
            heading {
                heading: Usuário
            }
            lov {
                lov: @lov-usuarios
            }
            layout {
                sequence: 3
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        column NOMEFILIAL (
            type: plainText
            heading {
                heading: Filial Favorita
            }
            layout {
                sequence: 105
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: O
            }
        )

        column VALORMETA (
            type: plainText
            heading {
                heading: Valor Meta
                alignment: end
            }
            layout {
                sequence: 15
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 207171 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAFIM (
                sequence: 4
            )

            displayColumn DATAINICIO (
                sequence: 3
            )

            displayColumn GRUPOATENDIMENTO (
                sequence: 6
            )

            displayColumn IDUSUARIO (
                sequence: 1
            )

            displayColumn NOMEFILIAL (
                sequence: 5
            )

            displayColumn VALORMETA (
                sequence: 2
            )

            sort (
                column: IDFILIALFAVORITA
                sort {
                    sequence: 1
                }
            )

            sort (
                column: DATAINICIO
                sort {
                    direction: desc
                    sequence: 2
                }
            )

            sort (
                column: IDUSUARIO
                sort {
                    sequence: 3
                }
            )

        )

    )

    pageItem P555_DATAFIM (
        type: datePickerJquery
        label {
            label: Data de Fim
            alignment: left
        }
        layout {
            sequence: 30
            region: @copiar-metas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P555_DATAINICIO (
        type: datePickerJquery
        label {
            label: Data de Início
            alignment: left
        }
        layout {
            sequence: 20
            region: @copiar-metas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    button copiar (
        buttonName: COPIAR
        label: Copiar Metas
        layout {
            sequence: 40
            region: @metas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Nova Meta
        layout {
            sequence: 30
            region: @metas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 556
                clearCache: 556
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button incluir (
        buttonName: INCLUIR
        label: Incluir
        layout {
            sequence: 10
            region: @copiar-metas
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @copiar
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    javascript:openModal('COPIARMETAS');
                    //javascript:$s('P1_EMPID','#EMPNO#');openModal('YesFlag');
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation new (
        name: New
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                 from dual
                 where TO_DATE(:P555_DATAINICIO) < TO_DATE(:P555_DATAFIM)
                ```
            alwaysExecute: true
        }
        error {
            errorMessage: Data Invalida
            associatedItem: @P555_DATAFIM
        }
    )

    process copiarmetas (
        name: CopiarMetas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                 
                  FOR c1 in ( 
                              SELECT distinct u.idusuario idusuario, m.idgrupoatendimento
                                FROM metascobrancas m
                                ,    usuarios       u
                              WHERE m.idfilialfavorita = :P0_IDFILIALFAVORITA
                                AND u.idusuario = m.idusuario
                                AND u.ativo = 'S' ) LOOP
                  
                  INSERT INTO metascobrancas (idmetacobranca, 
                                              valormeta, 
                                              idusuario, 
                                              datainicio, 
                                              datafim, 
                                              idgrupoatendimento, 
                                              idfilialfavorita)
                       VALUES (seq_idmetacobranca.nextval, 
                               0, 
                               c1.idusuario, 
                               :P555_DATAINICIO, 
                               :P555_DATAFIM, 
                               c1.idgrupoatendimento, 
                               :P0_IDFILIALFAVORITA )  ;
                
                  END LOOP;
                  
                  exception
                    when others then
                      raise_application_error(-20001,'Erro no processo de cópia '||SQLERRM);
                
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Metas copiadas com sucesso!!
        }
        advanced {
            executionMappingIdentifier: 15366374245119146
        }
        serverSideCondition {
            whenButtonPressed: @incluir
        }
    )

)

