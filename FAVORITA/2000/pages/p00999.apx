    dynamicAction desabilitar-conta (
        name: Desabilitar Conta
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P999_FORMAPAGAMENTO
        }
        clientSideCondition {
            type: item!=value
            item: P999_FORMAPAGAMENTO
            value: 3
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P999_OPERADORACARTAO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction habilitar-conta (
        name: Habilitar Conta
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P999_FORMAPAGAMENTO
        }
        clientSideCondition {
            type: item=value
            item: P999_FORMAPAGAMENTO
            value: 3
        }

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P999_OPERADORACARTAO
            }
            execution {
                sequence: 10
            }
        )

    )

    process confirmar-baixa (
        name: Confirmar Baixa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                update pagamentospedidos
                set confirmabaixavirtualage = 'S'
                where idpagamentopedido = :P999_IDPAGAMENTOPEDIDO;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 691555340371189077
        }
    )

    branch (
        name: Go To Page 187
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 999
                items: {
                    P999_TIPODATA: &P999_TIPODATA.
                    P999_DATAINICIO: &P999_DATAINICIO.
                    P999_DATAFIM: &P999_DATAFIM.
                    P999_IDFILIALROMANCE: &P999_IDFILIALROMANCE.
                    P999_FORMAPAGAMENTO: &P999_FORMAPAGAMENTO.
                    P999_NUMEROBOLETO: &P999_NUMEROBOLETO.
                    P999_IDFILIALFAVORITA: &P999_IDFILIALFAVORITA.
                    P999_ORIGEM: &P999_ORIGEM.
                    P999_DISTRIBUIDOR: &P999_DISTRIBUIDOR.
                    P999_CONSULTORA: &P999_CONSULTORA.
                    P999_IDUSUARIO: &P999_IDUSUARIO.
                    P999_NRCOMPROVANTE: &P999_NRCOMPROVANTE.
                    P999_IDPEDIDO: &P999_IDPEDIDO.
                    P999_ORIGEMPEDIDO: &P999_ORIGEMPEDIDO.
                    P999_FILTRAR: S
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

