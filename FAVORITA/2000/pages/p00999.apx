    pageItem P999_DISTRIBUIDOR (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROMAN.pck_romance.fnc_nomerepresentante(idrepresentante) DISPLAY_VALUE
                     , idrepresentante RETURN_VALUE
                from representantes
                where (:P999_IDFILIALROMANCE is null or
                    ( :P999_IDFILIALROMANCE is not null and idgerente in ( select idgerente from gerentes where idfilial = :P999_IDFILIALROMANCE) ))
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P999_IDFILIALROMANCE
        }
        layout {
            sequence: 90
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util_fav.fnc_verificaacesso(58005,:P0_IDUSUARIO) = 'S'
                ```
        }
        security {
            encryptSessionState: false
        }
    )

