page 490 (
    name: Cadastro de Empresa
    title: Cadastro de Empresa
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG_24"';
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region form-on-empresasvirtualage (
        name: Form on EMPRESASVIRTUALAGE
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P490_CNPJ (
        type: textField
        label {
            label: Cnpj
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @form-on-empresasvirtualage
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 14
        }
        source {
            type: databaseColumn
            databaseColumn: CNPJ
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P490_IDCONSUMIDORFINALBRASIL (
        type: numberField
        label {
            label: Consumidor Final
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 70
            region: @form-on-empresasvirtualage
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: databaseColumn
            databaseColumn: IDCONSUMIDORFINALBRASIL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P490_IDEMPRESAVIRTUALAGE (
        type: numberField
        label {
            label: Id Empresa
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 10
            region: @form-on-empresasvirtualage
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: databaseColumn
            databaseColumn: IDEMPRESAVIRTUALAGE
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P490_IDFILIALFAVORITA (
        type: popupLov
        label {
            label: Filial Fav
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.idfilialfavorita||'-'||f.nomefilialfavorita d,
                       f.idfilialfavorita r
                from filiaisfavorita f
                order by f.idfilialfavorita
                ```
            nullDisplayValue: "- Nenhuma - "
        }
        layout {
            sequence: 50
            region: @form-on-empresasvirtualage
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIALFAVORITA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P490_ID_PESSOA_ESTRANGEIRA (
        type: numberField
        label {
            label: Id Pessoa Estrangeira
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 60
            region: @form-on-empresasvirtualage
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: ID_PESSOA_ESTRANGEIRA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P490_LIGADO_ST (
        type: radioGroup
        label {
            label: Processo ST Ligado
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Sim;S,Não;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 90
            region: @form-on-empresasvirtualage
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: STLIGADO
            used: always
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P490_LIMITE_REGUA (
        type: numberField
        label {
            label: Limite Régua
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 80
            region: @form-on-empresasvirtualage
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: databaseColumn
            databaseColumn: LIMITEREGUA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P490_NEW (
        type: plugin/select
        label {
            label: Operações Liberado P/ Integração
            alignment: left
        }
        settings {
            selectListType: multiValueSelectList
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.descricaooperacao
                     , t.idtipooperacaointvirtual
                from favorita.TIPOOPERACAOINTVIRTUAL t;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 100
            region: @form-on-empresasvirtualage
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: OPERACOESINTEGRACAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P490_NOME (
        type: textField
        label {
            label: Nome
            alignment: left
        }
        layout {
            sequence: 20
            region: @form-on-empresasvirtualage
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            type: databaseColumn
            databaseColumn: NOME
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P490_TIPO (
        type: selectList
        label {
            label: Tipo
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct e.tipo d,
                       e.tipo r
                from empresasvirtualage e
                where e.tipo is not null
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 40
            region: @form-on-empresasvirtualage
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: TIPO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P490_VERSAOINTEGRACAO (
        type: selectList
        label {
            label: Versão de Integração
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Versão 1;1,Versão 2;2
        }
        layout {
            sequence: 110
            region: @form-on-empresasvirtualage
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: VERSAOINTEGRACAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Salvar
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P490_IDEMPRESAVIRTUALAGE
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Deseja deletar a empresa?','DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P490_IDEMPRESAVIRTUALAGE
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar Alterações
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P490_IDEMPRESAVIRTUALAGE
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 96968643619318681
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process fetch-row-from-empresasvirtualage (
        name: Fetch Row from EMPRESASVIRTUALAGE
        type: autoRowFetch
        source {
            tableName: EMPRESASVIRTUALAGE
            pkColumn: IDEMPRESAVIRTUALAGE
            pkItem: P490_IDEMPRESAVIRTUALAGE
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 96967425774318678
        }
    )

    process process-row-of-empresasvirtualage (
        name: Process Row of EMPRESASVIRTUALAGE
        type: autoRowProcessing
        target {
            tableName: EMPRESASVIRTUALAGE
            pkColumn: IDEMPRESAVIRTUALAGE
            pkItem: P490_IDEMPRESAVIRTUALAGE
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 96967840398318681
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 96968228254318681
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

)

