page 524 (
    name: Recompras de Clientes
    title: Recompras de Clientes
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region recompra-de-clientes (
        name: Recompra de Clientes
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region recompras-de-clientes (
        name: Recompras de Clientes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                
                select filialfavorita "Filial Favorita"
                     , cpf
                     , vendedora Vendedora
                     , representante Representante
                     , sum(valorapagar) "Valor Total"
                     , count(*) "QTD Pedidos"
                     , ( sum(valorapagar) / count(*) ) "Ticket Medio"
                from ( select pe.idpedido
                            , pe.filialfavorita 
                            , pe.cpf
                            , pe.vendedora 
                            , pe.representante 
                            , pe.valorapagar 
                            , pe.idvendedora
                        from favorita.vw_pedidos_fav pe
                       where pe.idfilialfavorita = :P524_IDFILIALFAVORITA    
                         and pe.ididioma = 1
                         and pe.valorapagar > 0
                         and pe.dataemissao between (select max(trunc(datanota)) 
                                                       from roman.notasvendas n
                                                      where n.idsituacaonotavenda = 4
                                                        and n.idvendedora = pe.idvendedora)
                                                and (select max(trunc(datanota)) 
                                                       from roman.notasvendas n
                                                      where n.idsituacaonotavenda = 3
                                                        and n.idvendedora = pe.idvendedora)
                         and pe.datacancelamento is null
                         and pe.tipopedido = 'P'
                         and ( :P524_DATAEMISSAOINICIAL is null or trunc(pe.dataemissao) between :P524_DATAEMISSAOINICIAL and :P524_DATAEMISSAOFINAL) ) pp
                where pp.idpedido not in ( select min(p.idpedido)
                                            from favorita.pedidos p
                                           where p.idfilialfavorita = 82 
                                             and pp.idvendedora = p.idvendedora
                                             and p.dataemissao between (select max(trunc(datanota)) 
                                                                           from roman.notasvendas n
                                                                          where n.idsituacaonotavenda = 4
                                                                            and n.idvendedora = p.idvendedora)
                                                                    and (select max(trunc(datanota)) 
                                                                           from roman.notasvendas n
                                                                          where n.idsituacaonotavenda = 3
                                                                            and n.idvendedora = p.idvendedora)
                                             and p.datacancelamento is null
                                             and p.tipopedido = 'P'
                                             and ( '1' is null or trunc(p.dataemissao) between TO_DATE('01/01/22','DD/MM/RR') and TO_DATE('31/01/22','DD/MM/RR')))
                group by filialfavorita, cpf, vendedora, representante
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhum registro localizado!
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 8178308826869757
        }

        column CPF (
            type: plainText
            heading {
                heading: CPF
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column "Filial Favorita" (
            type: plainText
            heading {
                heading: Filial Favorita
            }
            layout {
                sequence: 13
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column "QTD Pedidos" (
            type: plainText
            heading {
                heading: Qtd Pedidos
                alignment: end
            }
            layout {
                sequence: 33
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column REPRESENTANTE (
            type: plainText
            heading {
                heading: Representante
            }
            layout {
                sequence: 43
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        column "Ticket Medio" (
            type: plainText
            heading {
                heading: Ticket Medio
                alignment: end
            }
            layout {
                sequence: 53
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: J
            }
        )

        column VENDEDORA (
            type: plainText
            heading {
                heading: Vendedora
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column "Valor Total" (
            type: plainText
            heading {
                heading: Valor Total
                alignment: end
            }
            layout {
                sequence: 23
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 81875 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CPF (
                sequence: 1
            )

            displayColumn "Filial Favorita" (
                sequence: 4
            )

            displayColumn "QTD Pedidos" (
                sequence: 6
            )

            displayColumn REPRESENTANTE (
                sequence: 3
            )

            displayColumn "Ticket Medio" (
                sequence: 7
            )

            displayColumn VENDEDORA (
                sequence: 2
            )

            displayColumn "Valor Total" (
                sequence: 5
            )

            sort (
                column: VENDEDORA
                sort {
                    sequence: 1
                }
            )

        )

    )

    pageItem P524_DATAEMISSAOFINAL (
        type: datePickerJquery
        label {
            label: Data Emissão Final
            alignment: left
        }
        layout {
            sequence: 30
            region: @recompra-de-clientes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P524_DATAEMISSAOINICIAL (
        type: datePickerJquery
        label {
            label: Data Emissão Inicial
            alignment: left
        }
        layout {
            sequence: 20
            region: @recompra-de-clientes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P524_IDFILIALFAVORITA (
        type: selectList
        label {
            label: "Filial Favorita "
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) as d,
                       idfilialfavorita as r
                  from filiaisfavorita f
                where exists ( select 1
                               from usuariosfiliaisfavorita u
                               where u.idfilialfavorita = f.idfilialfavorita
                                 and u.consultar        = 'S' 
                                 and u.idusuario        = :P0_IDUSUARIO )
                 order by 1
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 10
            region: @recompra-de-clientes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util_fav.fnc_verificaacesso(58005,:P0_IDUSUARIO) = 'S'
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: Filtrar
        label: Filtrar
        layout {
            sequence: 40
            region: @recompra-de-clientes
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Vai para 524
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 524
                action: resetPagination
            }
        }
    )

)

