page 314 (
    name: Controle de Estoque
    title: Controle de Estoque
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 70%
        height: 50%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region controle (
        name: Controle
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.idcontroleestoque
                     , v.idestoque
                     , v.quantidadefisico qtdfisico
                     , '|' antesmovimentacao
                     , v.quantidadereservado qtdreservado
                     , v.quantidadedisponivel qtddisponivel
                     , '|' aposmovimentacao
                     , '->' separador
                     , v.quantidade qtdmovimentada
                     , v.quantidadereservado + v.quantidade qtdreservadopos
                     , case
                         when v.quantidade >= 1 then 
                           v.quantidadedisponivel - v.quantidade
                         when v.quantidade < 0 then
                           v.quantidadedisponivel + (v.quantidade*-1)
                         when v.quantidade = 0 then
                           v.quantidadedisponivel
                       end qtddisponivelpos
                     , v.idusuario
                     , v.nomeusuario
                     , v.datamovimentacao
                     , v.idpedido nrpedido
                     , case
                         when v.idcompratransferencia is not null then
                           v.tipocompratransferencia||' - Nr. '||v.idcompratransferencia
                         else
                           ' '
                       end compratransferencia
                     , v.observacao
                from vw_controleestoques_fav v
                where v.idestoque = :P314_IDESTOQUE
                  and v.quantidade != 0
                order by v.datamovimentacao desc
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum controle registrado
        }
        searchBar {
            rowsPerPageSelector: true
        }
        advanced {
            savedReportMappingIdentifier: 1403142436833262635
        }

