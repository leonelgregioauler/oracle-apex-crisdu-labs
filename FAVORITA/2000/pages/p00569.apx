    region pedidos-atendentes (
        name: Pedidos Atendentes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpedido                                                       as "Pedido"
                     , initcap( ff.nomefilialfavorita )                                 as "Loja Favorita"
                     , fr.nome                                                          as "Filial Romance"
                     , favorita.pck_util_fav.fnc_nomeusuario( p.idusuario )             as "Atendente"
                     , favorita.pck_util_fav.fnc_nomerepresentante( p.idrepresentante ) as "Distribuidor"
                     , favorita.pck_util_fav.fnc_nomevendedora( p.idvendedora )         as "Vendedora"
                     , p.dataemissao                                                    as "Data Emissão"
                     , p.dataentrega                                                    as "Data Entrega"
                     , p.valortotal                                                     as "R$ Total Pedido"
                     , p.valorapagar                                                    as "R$ Pagar Pedido"
                     , round( p.valorapagar * (pv.perccomissao / 100),2)                as "R$ Comissão Pedido"
                     , pv.perccomissao                                                  as "% Comissão"
                  from favorita.pedidos            p
                     , favorita.filiaisfavorita    ff
                     , roman.vw_filiais            fr
                     , favorita.perfisatendimentos pa
                     , favorita.perfisvendas       pv
                 where -- joins
                       ff.idfilialfavorita = p.idfilialfavorita
                   and fr.idfilial = p.idfilialromance
                   and pa.idperfilatendimento(+) = p.idperfilatendimento
                   and pv.idperfilvenda(+) = pa.idperfilvenda
                   -- Filtros fixos    
                   and p.tipopedido in ('P','R')
                   and p.idsituacaoentrega >= 20000
                   and p.datacancelamento is null 
                   and favorita.pck_util_fav.fnc_verificagrupoatendimento(4, p.idusuario) = 'S'
                   -- Período inicial e final
                   and p.dataemissao between to_date(:P569_DATAINI||' 00:00:00','DD/MM/RRRR HH24:MI:SS') 
                                         and to_date(:P569_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                   -- Perfil
                   and (:P569_IDPERFIL is null or p.idperfilatendimento = :P569_IDPERFIL)
                   -- Perfil Venda
                   and (:P569_IDPERFILVENDA is null or exists (select 1
                                                                 from favorita.perfisvendas pf
                                                                where pf.idperfil = p.idperfilatendimento
                                                                  and pf.idperfilvenda = :P569_IDPERFILVENDA))
                   -- País
                   and (:P569_IDPAIS is null or p.idpais = :P569_IDPAIS)
                   -- Atendente
                   and (:P569_ATENDENTE is null or p.idusuario = :P569_ATENDENTE)
                   -- Filtrar loja favorita
                   and (    ( :P569_FILTRARFAVORITA is null or :P569_FILTRARFAVORITA = 'T' )
                         or ( :P569_FILTRARFAVORITA = 'C' and p.idfilialfavorita in ( select ff.idfilialfavorita
                                                                                        from favorita.filiaisfavorita ff
                                                                                       where ff.ativo = 'S'
                                                                                         and ff.tipofilial = 'C' ) )
                         or ( :P569_FILTRARFAVORITA = 'S' and p.idfilialfavorita in ( select idfilialfavorita
                                                                                        from favorita.filtrosfiliais ff
                                                                                       where idusuario = :P0_IDUSUARIO) ) )
                   -- Filtrar por filial Romance
                   and (:P569_FILTRARROMANCE = 'T' or p.idfilialromance in ( select fr.idfilialromance
                                                                               from favorita.filtrosempresasromance fr
                                                                              where fr.idusuario = :P0_IDUSUARIO)  )
                   -- Filtro pontos
                   and (    ( :P569_PEDIDOS_PONTOS = 'T' )
                         or ( :P569_PEDIDOS_PONTOS = 'S' and exists ( select 1
                                                                        from favorita.classificacoespedidos c
                                                                       where c.idcaracteristicapedido = 8
                                                                         and c.idvalorcaracteristica  = 16
                                                                         and c.idpedido               = p.idpedido ) ) 
                         or ( :P569_PEDIDOS_PONTOS = 'N' and not exists ( select 1
                                                                            from favorita.classificacoespedidos c
                                                                           where c.idcaracteristicapedido = 8
                                                                             and c.idvalorcaracteristica  = 16
                                                                             and c.idpedido               = p.idpedido ) ) )
                   -- Distribuidor emitiu
                   and (    ( :P569_DIST_EMITIU = 'T' )
                         or ( :P569_DIST_EMITIU = 'S' and exists ( select 1
                                                                     from favorita.classificacoespedidos c
                                                                    where c.idpedido    = p.idpedido
                                                                      and c.idcaracteristicapedido = 2 ) ) 
                         or ( :P569_DIST_EMITIU = 'N' and not exists ( select 1
                                                                         from favorita.classificacoespedidos c
                                                                        where c.idpedido    = p.idpedido
                                                                          and c.idcaracteristicapedido = 2 ) ) )
                   -- Campanha
                   and (    ( :P569_CAMPANHA = 'T' ) 
                         or ( :P569_CAMPANHA = 'P' and exists ( select 1
                                                                  from favorita.classificacoespedidos c
                                                                 where c.idpedido    = p.idpedido
                                                                   and c.idcaracteristicapedido = 74 ) )
                         or ( :P569_CAMPANHA = 'V' and exists ( select 1
                                                                  from favorita.classificacoespedidos c
                                                                 where c.idpedido    = p.idpedido
                                                                   and c.idcaracteristicapedido = 78 ) ) 
                         or ( :P569_CAMPANHA = 'W' and exists ( select 1
                                                                  from favorita.classificacoespedidos c
                                                                 where c.idpedido    = p.idpedido
                                                                   and c.idcaracteristicapedido = 94 ) )
                         or ( :P569_CAMPANHA = 'B' and exists ( select 1
                                                                  from favorita.classificacoespedidos c
                                                                 where c.idpedido    = p.idpedido
                                                                   and c.idcaracteristicapedido = 96 ) )
                         or ( :P569_CAMPANHA = 'A' and exists ( select 1
                                                                  from favorita.classificacoespedidos c
                                                                 where c.idpedido    = p.idpedido
                                                                   and c.idcaracteristicapedido = 97 )))
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
