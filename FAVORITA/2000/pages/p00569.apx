    dynamicAction new (
        name: New
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P569_META
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select to_char(datainicio,'dd/mm/rrrr') , 
                           to_char(datafim,'dd/mm/rrrr') 
                      from metascobrancas 
                     where idmetacobranca = :P569_META;
                    ```
                itemsToSubmit: P569_META
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: [
                    P569_DATAINI
                    P569_DATAFIM
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction selecionarfav (
        name: SelecionarFav
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P569_FILTRARFAVORITA
        }
        clientSideCondition {
            type: item=value
            item: P569_FILTRARFAVORITA
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: button
                button: @filiaisfavorita
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: button
                button: @filiaisfavorita
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction selecionarrom (
        name: SelecionarRom
