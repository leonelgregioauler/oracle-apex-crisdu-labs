    pageItem P569_ATENDENTE (
        type: selectList
        label {
            label: <b>Atendente:</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeusuario(u.idusuario) display_value
                     , u.idusuario return_value
                from usuarios u
                where u.ativo = 'S'
                  and exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.usuario = u.usuario 
                                 and ug.idgrupoatendimento = 4 )
                  and exists ( select 1
                               from pedidos p
                               where p.idusuario = u.idusuario )
                order by 1
                ```
            nullDisplayValue: " - Todos -"
        }
        layout {
            sequence: 80
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P569_CAMPANHA (
        type: selectList
        label {
            label: <b>Campanha:</b>
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Prospecção;P,Venda Ativa;V,WhastApp;W,Belém Pronta Entrega;B,- Todas -;T,Ativa WhatsApp;A
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 150
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        default {
            type: static
            staticValue: T
        }
        security {
            encryptSessionState: false
        }
    )

