page 569 (
    name: Relatorio de Comissões Call Center
    title: Comissões Call Center
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region comissões-por-atendente-detalhado (
        name: Comissões Por Atendente - Detalhado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomeusuario(pp.idusuario) Atendente 
                     , (select sum(valormeta)  
                          from favorita.metascobrancas
                         where idusuario = pp.idusuario
                           and datainicio = :P569_DATAINI
                           and datafim    = :P569_DATAFIM ) valorMeta
                     , (select sigla
                          from catal.paises
                         where idpais = pp.idpais) pais
                     , wf.nome    "Filial"
                     , pf.descricao       "Canal Venda"
                     , pv.descricao       "Perfil Venda"
                     , round(nvl(sum(pp.valorapagar* nvl(pp.fatorconversao,1)),0),2)    "Realizado"
                     , round(( nvl((select sum(valormeta)  
                                from favorita.metascobrancas
                               where idusuario = pp.idusuario
                                 and datainicio = :P569_DATAINI 
                                 and datafim    = :P569_DATAFIM ) ,0)
                         - sum(valorapagar*pp.fatorconversao) ),2) "Diferença"
                     --
                     , round(sum((pp.valorapagar*nvl(pp.fatorconversao,1)) * (pv.perccomissao / 100) ),2) "Comissão"
                     , count( distinct pp.idpedido) qtd_pedidos
                     , pf.idperfil
                     , pv.idperfilvenda
                     , pp.idfilialromance
                     , pp.idpais
                     , pp.idusuario idusuario_atendente
                     , pp.idpedido
                from (
                      select distinct p.* 
                        from favorita.classificacoespedidos cp
                           , favorita.vw_pedidos_fav_new p
                        where cp.idpedido = p.idpedido(+)
                          and p.dataemissao BETWEEN to_date(nvl(:P569_DATAINI,trunc(sysdate)) || ' 000001','dd/mm/rrrr hh24miss')
                                                     AND to_date(nvl(:P569_DATAFIM,trunc(sysdate)) || ' 235959','dd/mm/rrrr hh24miss')
                --          and p.idusuario = 6767
                          and p.tipopedido          in ('P','R')
                          and p.idsituacaoentrega >= 20000
                          and p.datacancelamento is null
                          and p.valorapagar > 0  
                          and favorita.pck_util_fav.fnc_verificagrupoatendimento(4, p.idusuario) = 'S') pp
                     ,favorita.perfis             pf
                     ,favorita.perfisvendas       pv
                     ,favorita.perfisatendimentos pa
                     ,roman.vw_filiais            wf
                where pp.idperfilatendimento = pa.idperfilatendimento(+)
                  AND pa.idperfilvenda       = pv.idperfilvenda(+)
                  AND pv.idperfil            = pf.idperfil(+)
                  AND wf.idfilial            = pp.idfilialromance
                  --and pp.ididioma = :P0_IDIDIOMA
                  AND (:P569_IDPERFIL      IS NULL OR pf.idperfil        = :P569_IDPERFIL )
                  AND (:P569_IDPERFILVENDA IS NULL OR pv.idperfilvenda   = :P569_IDPERFILVENDA )
                  and ( :P569_PEDIDOS_PONTOS = 'T' or
                        ( :P569_PEDIDOS_PONTOS = 'S' and exists ( select 1
                                                                    from classificacoespedidos c
                                                                   where c.idcaracteristicapedido = 8
                                                                     and c.idvalorcaracteristica  = 16
                                                                     and c.idpedido               = pp.idpedido ) ) or
                        ( :P569_PEDIDOS_PONTOS = 'N' and not exists ( select 1
                                                                        from classificacoespedidos c
                                                                       where c.idcaracteristicapedido = 8
                                                                         and c.idvalorcaracteristica  = 16
                                                                         and c.idpedido               = pp.idpedido ) ) ) 
                  --
                  and ( :P569_DIST_EMITIU = 'T' or
                        ( :P569_DIST_EMITIU = 'S' and exists ( select 1
                                                               from classificacoespedidos c
                                                               where c.idpedido    = pp.idpedido
                                                                 and c.idcaracteristicapedido = 2 ) ) or
                        ( :P569_DIST_EMITIU = 'N' and not exists ( select 1
                                                                   from classificacoespedidos c
                                                                   where c.idpedido    = pp.idpedido
                                                                     and c.idcaracteristicapedido = 2 ) ) )
                  --
                  and (:P569_CAMPANHA = 'T' or ( :P569_CAMPANHA = 'P' and exists ( select 1
                                                                                     from classificacoespedidos c
                                                                                    where c.idpedido    = pp.idpedido
                                                                                      and c.idcaracteristicapedido = 74 ) )
                                            or ( :P569_CAMPANHA = 'V' and exists ( select 1
                                                                                     from classificacoespedidos c
                                                                                    where c.idpedido    = pp.idpedido
                                                                                      and c.idcaracteristicapedido = 78 ) ) 
                                          or ( :P569_CAMPANHA = 'W' and exists ( select 1
                                                                                   from classificacoespedidos c
                                                                                  where c.idpedido    = pp.idpedido
                                                                                    and c.idcaracteristicapedido = 94 ) )
                                          or ( :P569_CAMPANHA = 'B' and exists ( select 1
                                                                                   from classificacoespedidos c
                                                                                  where c.idpedido    = pp.idpedido
                                                                                    and c.idcaracteristicapedido = 96 ) )
                                          or ( :P569_CAMPANHA = 'A' and exists ( select 1
                                                                                   from classificacoespedidos c
                                                                                  where c.idpedido    = pp.idpedido
                                                                                    and c.idcaracteristicapedido = 97 )))       
                --
                and (:P569_IDPAIS is null or pp.idpais   = :P569_IDPAIS)
                and ( :P569_FILTRARFAVORITA is null
                    or ( :P569_FILTRARFAVORITA = 'C' and pp.idfilialfavorita in ( select ff.idfilialfavorita
                                                                                    from filiaisfavorita ff
                                                                                   where ff.ativo = 'S'
                                                                                     and ff.tipofilial = 'C' ) )
                    or ( :P569_FILTRARFAVORITA = 'T' )
                    or ( :P569_FILTRARFAVORITA = 'S' and pp.idfilialfavorita in ( select IDFILIALFAVORITA
                                                                                    from FILTROSFILIAIS
                                                                                   where idusuario = :P0_IDUSUARIO) ) )
                and (:P569_FILTRARROMANCE = 'T' or pp.idfilialromance in ( select idfilialromance
                                                                             from FILTROSEMPRESASROMANCE
                                                                            where idusuario = :P0_IDUSUARIO)  ) 
                and (:P569_ATENDENTE is null or pp.idusuario = :P569_ATENDENTE)
                having sum(pp.valorapagar* nvl(pp.fatorconversao,1)) > 0
                group by pp.idusuario
                       , pp.idpais
                       , wf.nome
                       , pf.descricao
                       , pv.descricao
                       , pf.idperfil
                       , pv.idperfilvenda
                       , pp.idfilialromance
                       , pp.idpais
                       , pp.idusuario
                       , pp.idpedido
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P569_TIPORELATORIO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 3073480517983240702
        }

