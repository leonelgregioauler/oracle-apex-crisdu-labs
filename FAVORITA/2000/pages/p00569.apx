            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select descricao d, idperfilvenda r
                  from perfisvendas
                 where idperfil = nvl(:P569_IDPERFIL,0)
                order by 1
                ```
            nullDisplayValue: - Todos -
        }
        cascadingLov {
            parentItems: P569_IDPERFIL
