    branch (
        name: buscar pedidos
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 569
                items: {
                    P569_IDPERFIL: &P569_IDPERFIL.
                    P569_IDPERFILVENDA: &P569_IDPERFILVENDA.
                    P569_IDPAIS: &P569_IDPAIS.
                    P569_ATENDENTE: &P569_ATENDENTE.
                    P569_FILTRARFAVORITA: &P569_FILTRARFAVORITA.
                    P569_FILTRARROMANCE: &P569_FILTRARROMANCE.
                    P569_PEDIDOS_PONTOS: &P569_PEDIDOS_PONTOS.
                    P569_CAMPANHA: &P569_CAMPANHA.
                    P569_DIST_EMITIU: &P569_DIST_EMITIU.
                }
                action: resetPagination
            }
        }
    )

)

