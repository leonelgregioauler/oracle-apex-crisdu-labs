    pageItem P569_IDPERFIL (
        type: selectList
        label {
            label: <b>Perfil:</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.descricao as display_value
                     , p.idperfil  as returns_value
                  from favorita.perfis p
                 where p.ativo = 'S'
                 order by 1;
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 40
            region: @opções
            slot: regionBody
            alignment: left
