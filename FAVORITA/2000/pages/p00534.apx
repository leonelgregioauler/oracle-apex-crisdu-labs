page 534 (
    name: Grupos Pretransferencia
    title: Grupos Pretransferencia
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region report (
        name: Report 1
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select "IDGRUPOSPRETRANSF", 
                "DESCRICAOGRUPO",
                "OBSERVACAO"
                from "#OWNER#"."GRUPOSPRETRANSFERENCIA" 
                  
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 536
                items: {
                    P536_IDGRUPOSPRETRANSF: #IDGRUPOSPRETRANSF#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 23047380994251117
        }

        column DESCRICAOGRUPO (
            type: plainText
            heading {
                heading: Descrição
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column IDGRUPOSPRETRANSF (
            type: hidden
            heading {
                heading: Idgrupospretransf
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column OBSERVACAO (
            type: plainText
            heading {
                heading: Observação
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 230503 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DESCRICAOGRUPO (
                sequence: 2
            )

            displayColumn IDGRUPOSPRETRANSF (
                sequence: 1
            )

            displayColumn OBSERVACAO (
                sequence: 3
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Novo Grupo
        layout {
            sequence: 30
            region: @report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 536
                clearCache: 536
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

