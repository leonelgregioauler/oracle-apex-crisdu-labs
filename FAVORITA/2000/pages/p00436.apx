page 436 (
    name: Detalhamento Integrações WideCommerce
    title: Detalhamento Integrações WideCommerce
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 95%
        height: 85%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_integrarpessoa (idpessoa) {
                
               apex.confirm( 'Deseja integrar este cadastro ?', {
                 request:"INTEGRAR",
                 set:{"P436_IDPESSOA":idpessoa}});
            }
            
            
            
            function fnc_atualizarcep (idpessoa) {
                
               apex.submit({
                 request:"ATUALIZARCEP",
                 set:{"P436_IDPESSOA":idpessoa}});
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region detalhamento-integrações-widecommerce (
        name: Detalhamento Integrações WideCommerce
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pessoas (
        name: Pessoas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                 select '<a href=javascript:fnc_integrarpessoa('||p.idpessoa||');><img src="#APP_IMAGES#ok.png"  border="0"></a>' idpessoa,
                        p.nomepessoa,
                        p.email,
                        p.datanascimento,
                        p.cpf,
                        p.sexo,
                        p.tipopessoa,
                        p.enderecoprincipal,
                        p.numero,
                        p.complemento,
                        p.bairro,
                        p.idcidade,
                        p.cep,
                        '<a href=javascript:fnc_atualizarcep('||p.idpessoa||');><img src="#APP_IMAGES#ok.png"  border="0"></a>' atualizarcep,
                        p.mensagemintegracao, 
                        p.dataintegracao
                from pessoas p
                where trunc(nvl(p.dataintegracao, sysdate)) >= trunc(sysdate) - 3
                and p.situacaointegracao = :P436_SITUACAOINTEGRACAO
                and p.idpais = 1
                ```
            pageItemsToSubmit: P436_SITUACAOINTEGRACAO
        }
        layout {
            sequence: 10
            parentRegion: @detalhamento-integrações-widecommerce
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
            cssClasses: pessoas
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 23859740694885712
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 0
                }
            )

            displayColumn (
                column: @MENSAGEMINTEGRACAO
                layout {
                    width: 227
                    sequence: 15
                }
            )

            displayColumn (
                column: @DATAINTEGRACAO
                layout {
                    width: 100
                    sequence: 16
