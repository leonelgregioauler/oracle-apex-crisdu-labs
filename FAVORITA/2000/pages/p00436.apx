    pageItem P436_IDPESSOA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @pessoas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P436_SITUACAOINTEGRACAO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @pessoas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button cep (
        buttonName: CEP
        label: Cep
        layout {
            sequence: 30
            region: @pessoas
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: focusin
            selectionType: columns
            interactiveGrid: @pessoas
            columns: CEP
        }
        clientSideCondition {
            type: itemColumnIsNotNull
            column: CEP
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $(this).css("color", "red");
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process atualizar-cep (
        name: Atualizar CEP
        type: executeCode
        source {
            plsqlCode: prc_consultacependereco(:P436_IDPESSOA);
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Cep atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 23924427536588814
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'ATUALIZARCEP'
        }
    )

    process integrar-cadastro-de-pessoa (
        name: Integrar Cadastro de Pessoa
        type: executeCode
        source {
            plsqlCode: pck_integracao_fav_widecomm.prc_pessoas(:P436_IDPESSOA);
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Cadastro integrado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 23923514972588805
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'INTEGRAR'
        }
    )

    process pessoas-save-interactive-grid-data (
        name: Pessoas - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @pessoas
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 23863339146885748
        }
    )

)

