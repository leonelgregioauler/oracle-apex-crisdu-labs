    region itens-vendidos-da-loja-2 (
        name: Itens Vendidos da Loja
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomeprodutodetalhado nome--pck_util_fav.fnc_nomeprodutodetalhado(i.idprodutodetalhado,1) nome 
                     , sum(i.quantidade) quantidade
                     , sum(i.quantidade * i.valorvenda) valor
                     , ( select pck_util_fav.fnc_nomecategoria(pidcategoria => p.idcategoria,pididioma => 1 ) 
                         from produtos p
                         where p.idproduto = i.idproduto ) categoria
                     , ( select pck_util_fav.fnc_nomecategoriasite(pidcategoriasite =>  c.idcategoriasite,pididioma => 1 ) 
                         from produtos p
                            , categorias c
                         where p.idproduto = i.idproduto 
                           and p.idcategoria = c.idcategoria ) categoriasite
                         
                     /*, ( select pck_estoque_fav.fnc_estoquedisponivel(e.idestoque)
                         from estoques e
                         where e.idfilialfavorita = ( select a.idfilialfavoritaorigem
                                                      from atendimentosestoques a
                                                      where a.idfilialfavoritadestino = :P0_IDFILIALFAVORITA )
                           and e.idprodutodetalhado = i.idprodutodetalhado ) qtdestoquemanaus*/
                     , ( select pck_estoque_fav.fnc_estoquedisponivel(e.idestoque)
                         from estoques e
                         where e.idfilialfavorita = :P0_IDFILIALFAVORITA
                           and e.idprodutodetalhado = i.idprodutodetalhado ) qtdestoqueloja
                     , ( select sum(ic.quantidadecomprada)
                         from itenscomprastransferencias ic
                         where ic.idprodutodetalhado = i.idprodutodetalhado
                           and exists ( select 1
                                        from comprastransferencias c
                                        where c.idcompratransferencia = ic.idcompratransferencia
                                          and c.idfilialfavoritadestino = :P151_IDFILIALFAVORITA
                                          and c.idtipocomptransrem = 1
                                          and c.idsituacao in (0,3,5) )
                         group by ic.idprodutodetalhado ) qtdjasolicitada     
                     , case 
                          when pf.idvendedora = 2363887 then 
                                 'S'
                           else 
                                 'N'
                           end consumidorfinal
                     , case when MAX(pf.idfilialfavorita) = 109 then
                         sum(i.valorapagar * 1)
                       else 
                         sum(i.valorapagar * pf.fatorconversao)
                       end valorpagarconvertido
                from vw_itenspedidos_fav i
                   , favorita.vw_pedidos_fav_new pf
                where pf.idpedido = i.idpedido
                  and i.ididioma = 1
                  and i.idfilialfavorita = :P0_IDFILIALFAVORITA
                  and ( :P151_TIPO is null or 
                        exists (select 1
                                 from pedidos p
                                where p.idpedido = i.idpedido
                                  and p.tipopedido = :P151_TIPO) )
                  and ( :P151_DATAINICIO is null 
                   or ( :P151_DATAINICIO is not null 
                    and exists ( select 1
                                 from pedidos pf
                                 where pf.idpedido = i.idpedido
                                   and pf.idfilialfavorita = :P0_IDFILIALFAVORITA
                                   and pf.dataemissao between to_date(:P151_DATAINICIO||' 00:00:00','DD/MM/RRRR hh24:mi:ss') and to_date(:P151_DATAFIM||' 23:59:59','DD/MM/RRRR hh24:mi:ss') 
                                   and pf.datacancelamento is null
                                   and ( :P151_VALOR = 2
                                     or ( :P151_VALOR = 1 and pf.valorapagar > 0 ) 
                                     or ( :P151_VALOR = 0 and pf.valorapagar = 0 ) ) ) ) )
                  and ( :P151_ATENDENTE is null
                   or (:P151_ATENDENTE is not null
                      and  exists ( select 1
                                    from pedidos p
                                    where p.idpedido = i.idpedido
                                      and p.idusuario = :P151_ATENDENTE 
                                      and p.datacancelamento is null  )  ))
                  and not exists ( select 1
                                   from classificacoespedidos c
                                   where c.idpedido = i.idpedido
                                     and c.idcaracteristicapedido = 25 )
                  and :P151_DATAINICIO is not null
                  
                group by i.idprodutodetalhado, nomeprodutodetalhado, i.idproduto, pf.idvendedora 
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util_fav.fnc_verificaacesso(40811,:P0_IDUSUARIO) = 'N'
                and :P151_DATAINICIO is not null
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Verifique os Filtros Informados!
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            savePublicReport: true
        }
