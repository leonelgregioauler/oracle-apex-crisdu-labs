    pageItem P151_ATENDENTE (
        type: selectList
        label {
            label: Atendente
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeusuario(idusuario) display_value
                     , u.idusuario return_value
                from usuarios u
                where exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.usuario = u.usuario
                                 and exists ( select 1
                                              from roman.usuariosgruposatendimento ugg 
                                              where ugg.idgrupoatendimento = ug.idgrupoatendimento
                                                and ugg.usuario            = v('APP_USER')) )
                  and pck_util_fav.fnc_verificaacesso(40811,:P0_IDUSUARIO) = 'N'
                union
                select pck_util_fav.fnc_nomeusuario(idusuario) display_value
                     , u.idusuario return_value
                from usuarios u
                where pck_util_fav.fnc_verificaacesso(40811,:P0_IDUSUARIO) = 'S'
                  --and (instr(:P151_IDFILIALFAVORITA,u.idfilialfavorita) > 0 or :P151_IDFILIALFAVORITA is null)
                  and (:P151_IDFILIALFAVORITA is null and exists ( select 1
                                                                   from filiaisfavorita f
                                                                   where f.idfilialfavorita = u.idfilialfavorita
                                                                     and f.tipofilial       = 'L'
                                                                     and f.ativo            = 'S' ) 
                          OR ( u.idfilialfavorita in (select regexp_substr(:P151_IDFILIALFAVORITA, '[^:]+', 1, level) 
                                                        from dual
                                                      connect by level <= regexp_count(:P151_IDFILIALFAVORITA, ':') + 1)  )
                          and exists ( select 1
                                                                                                        from filiaisfavorita f
                                                                                                       where f.idfilialfavorita = u.idfilialfavorita
                                                                                                         and f.tipofilial       = 'L'
                                                                                                         and f.ativo            = 'S' ) )
                  and exists (select 1
                                from favorita.filiaisfavorita ff
                               where ff.idfilialfavorita  = u.idfilialfavorita
                                 and ff.tipofilial = 'L')
                order by 1
                ```
            nullDisplayValue: "- Todas - "
        }
        cascadingLov {
            parentItems: P151_IDFILIALFAVORITA
            itemsToSubmit: P151_ATENDENTE
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

