    region itens-vendidos-lojas (
        name: Itens Vendidos Lojas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(p.idfilialfavorita) empresafavorita
                     , pck_util_fav.fnc_nomeusuario( p.idusuario ) atendente
                     , pck_util_fav.fnc_nomeprodutodetalhado(i.idprodutodetalhado, :P0_IDIDIOMA) nome 
                     , pck_util_fav.fnc_nomecategoria(c.idcategoria, :P0_IDIDIOMA)   categoria
                     , pck_util_fav.fnc_nomecategoriasite(c.idcategoriasite, :P0_IDIDIOMA)  categoriasite
                     , sum(i.quantidade) quantidade
                     , sum(i.quantidade * i.valorvenda) valor
                     , sum(i.valorapagar) valorpagar
                     , case 
                          when p.idvendedora = 2363887 then 
                                 'S'
                           else 
                                 'N'
                           end consumidorfinal
                     , case when MAX(p.idfilialfavorita) = 109 then
                         sum(i.valorapagar * 1)
                       else 
                         sum(i.valorapagar * p.fatorconversao)
                       end valorpagarconvertido
                  from itenspedidos i
                     , pedidos p
                     , produtos prod
                     , categorias c 
                where i.idpedido = p.idpedido
                  and i.idproduto = prod.idproduto
                  and prod.idcategoria = c.idcategoria
                  and ( :P151_TIPO ='X' or p.tipopedido = :P151_TIPO)
                  and (:P151_IDFILIALFAVORITA is null and exists ( select 1
                                                                   from filiaisfavorita f
                                                                   where f.idfilialfavorita = p.idfilialfavorita
                                                                     and f.tipofilial       = 'L'
                                                                     and f.ativo            = 'S' ) 
                          OR ( p.idfilialfavorita in (select regexp_substr(:P151_IDFILIALFAVORITA, '[^:]+', 1, level) 
                                                        from dual
                                                      connect by level <= regexp_count(:P151_IDFILIALFAVORITA, ':') + 1)  )
                          and exists ( select 1
                                                                                                        from filiaisfavorita f
                                                                                                       where f.idfilialfavorita = p.idfilialfavorita
                                                                                                         and f.tipofilial       = 'L'
                                                                                                         and f.ativo            = 'S' ) )
                      /*and ( :P151_IDFILIALFAVORITA is null
                     or ( :P151_IDFILIALFAVORITA = -1 and exists ( select 1
                                                                   from filiaisfavorita f
                                                                   where f.idfilialfavorita = p.idfilialfavorita
                                                                     and f.tipofilial       = 'L'
                                                                     and f.ativo            = 'S' ) )
                    or ( :P151_IDFILIALFAVORITA > 0 and p.idfilialfavorita = :P151_IDFILIALFAVORITA ) )*/
                  and dataemissao between to_date(:P151_DATAINICIO||' 00:00:00','DD/MM/RRRR hh24:mi:ss') 
                                      and to_date(:P151_DATAFIM||' 23:59:59','DD/MM/RRRR hh24:mi:ss')  
                  and (:P151_ATENDENTE  is null  or p.idusuario = :P151_ATENDENTE ) 
                  and p.datacancelamento is null
                  and :P151_DATAINICIO is not null
                  and ( :P151_VALOR = 2
                     or ( :P151_VALOR = 1 and p.valorapagar > 0 ) 
                     or ( :P151_VALOR = 0 and p.valorapagar = 0 ) )
                     
                     
                group by  pck_util_fav.fnc_nomefilialfavorita(p.idfilialfavorita)
                        , pck_util_fav.fnc_nomeusuario( p.idusuario )
                        , pck_util_fav.fnc_nomeprodutodetalhado(i.idprodutodetalhado, :P0_IDIDIOMA)  
                        , pck_util_fav.fnc_nomecategoria( c.idcategoria, :P0_IDIDIOMA)  
                        , pck_util_fav.fnc_nomecategoriasite(c.idcategoriasite, :P0_IDIDIOMA)
                        , p.idvendedora 
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util_fav.fnc_verificaacesso(40811,:P0_IDUSUARIO) = 'S'
                and :P151_DATAINICIO is not null
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
