            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000000
        }
        messages {
            whenNoDataFound: Verifique os Filtros Informados!
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 3393080858874955223
        }
