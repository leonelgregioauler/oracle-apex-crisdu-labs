    pageItem P151_IDFILIALFAVORITA (
        type: plugin/select
        label {
            label: Loja
            alignment: left
        }
        settings {
            selectListType: multiValueSelectList
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nomefilialfavorita
                     , f.idfilialfavorita
                from filiaisfavorita f
                where f.tipofilial = 'L'
                  and f.ativo      = 'S'
                order by 1
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        default {
            type: expression
            plsqlExpression: null
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util_fav.fnc_verificaacesso(40811,:P0_IDUSUARIO) = 'S'
                ```
        }
        security {
            encryptSessionState: false
        }
    )

