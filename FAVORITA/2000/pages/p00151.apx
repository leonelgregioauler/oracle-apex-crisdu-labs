    button solicitar-transferencia (
        buttonName: SOLICITAR_TRANSFERENCIA
        label: Solicitar Pré Transferência
        layout {
            sequence: 10
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: openModal('PREPARAR');
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction mostra-filtro-franquia (
        name: mostra filtro franquia
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P151_TIPOFILIAL
        }
        clientSideCondition {
            type: item=value
            item: P151_TIPOFILIAL
            value: F
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P151_IDFILIALFAVORITA
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P151_IDFILIALFAVORITA
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction set-value-filial-favorita (
        name: set value filial favorita
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P151_IDFILIALFAVORITA
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select regexp_substr(:P151_IDFILIALFAVORITA, '[^:]+', 1, level) 
                                                            from dual
                                                          connect by level <= regexp_count(:P151_IDFILIALFAVORITA, ':') + 1
                    ```
                itemsToSubmit: P151_IDFILIALFAVORITA
            }
            affectedElements {
                selectionType: items
                items: P151_SELFILIAIS
            }
            execution {
                sequence: 10
            }
        )

    )

    process inicia-a-transferencia (
        name: Inicia a transferencia
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  --raise_application_error(-20001,'idpretransferencia='||nvl(:P151_IDPRETRANSFERENCIA,0)||' - '||:P151_IDFILIALFAVORITA);
                  :P151_IDPRETRANSFERENCIA := null;
                  pck_comprastransf_fav.prc_transferencialoja(pidusuario          => :P0_IDUSUARIO,
                                                              pdatainicio         => :P151_DT_INI,
                                                              pdatafim            => :P151_DT_FIM,
                                                              patendente          => :P151_ATENDENTE,
                                                              pidpretransferencia => :P151_IDPRETRANSFERENCIA,
                                                              pidfilialfavorita   => :P151_IDFILIALFAVORITA,
                                                              ptempo_reposicao    => :P151_TEMPO_REPOSICAO,
                                                              poperacao_dml       => 'I');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Pré Transferência solicitada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 84697537090946788
        }
        serverSideCondition {
            type: request=Value
            value: INICIAR_PROCESSO
        }
    )

    branch (
        name: Go To Page 151
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 151
                items: {
                    P151_DATAINICIO: &P151_DATAINICIO.
                    P151_DATAFIM: &P151_DATAFIM.
                    P151_ATENDENTE: &P151_ATENDENTE.
                    P151_IDPRETRANSFERENCIA:
                    P151_DT_INI: &P151_DATAINICIO.
                    P151_DT_FIM: &P151_DATAFIM.
                    P151_VALOR: &P151_VALOR.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

    branch (
        name: Go To Page 377
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 377
                items: {
                    P377_IDPRETRANSFERENCIA: &P151_IDPRETRANSFERENCIA.
                    P377_VOLTAR: 0
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @iniciar-processo
        }
    )

)

