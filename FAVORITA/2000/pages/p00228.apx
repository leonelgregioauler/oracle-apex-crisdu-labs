page 228 (
    name: Pagamentos Compras Transferências
    title: Pagamentos Compras Transferências
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pagamentos-compras-transferências (
        name: Pagamentos Compras Transferências
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pc.idpagamentocompratransf
                     , pc.idvencimentocompratransf
                     , ct.numero numeroremessa
                     , pc.idformapagamento
                     , pc.formapagamento
                     , vc.datavencimento
                     , pc.datapagamento
                     , pc.valorpago
                     , pc.origempagamento
                     , pc.descorigempagamento
                     , pc.numeroboleto
                     , pc.idsituacao
                     , pc.situacaopagamento
                     , pc.taxa
                     , pc.acrescimo
                     , pc.desconto
                     , pc.valorliquido
                     , pc.numerocomprovante
                     , pc.idcontabancaria
                     , pc.observacao
                     , pc.idsemanapago
                     , pc.idusuariopagamento
                     , pc.nomeusuario
                from comprastransferencias ct
                   , vw_vencimentoscompratransf_fav vc
                   , vw_pagamentoscomprastransf_fav pc
                where vc.idvencimentocompratransf = pc.idvencimentocompratransf 
                  and ct.idcompratransferencia = vc.idcompratransferencia
                  and ( :P228_IDFILIALROMANCE is null or vc.idfilialromancedestino = :P228_IDFILIALROMANCE
                     or vc.idfilialromancedestino = roman.pck_romance.fnc_filialusuario(v('APP_USER')) )
                  and ( :P228_TIPODATA = 'N' or ( :P228_TIPODATA = 'B' and trunc(pc.datapagamento) between to_date(:P228_DATAINICIO,'dd/mm/rrrr') and to_date(:P228_DATAFIM,'dd/mm/rrrr') ) )
                  and ( :P228_NUMEROBOLETO is null or pc.numeroboleto like '%'||:P228_NUMEROBOLETO||'%' )
                  and ( :P228_FORMAPAGAMENTO is null or pc.idformapagamento = :P228_FORMAPAGAMENTO )
                  and ( :P228_IDUSUARIO is null or pc.idusuariopagamento = :P228_IDUSUARIO )
                  and ( :P228_NRCOMPROVANTE is null or pc.numerocomprovante like '%'||:P228_NRCOMPROVANTE||'%' )
                  and ( :P228_ORIGEM = 'N' or pc.origempagamento = :P228_ORIGEM )
                  and pc.ididioma = 1;
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
