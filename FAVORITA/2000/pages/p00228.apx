    pageItem P228_FORMAPAGAMENTO (
        type: selectList
        label {
            label: Forma de Pagamento
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select descricao as d,
                       idformapagamento as r
                  from formaspagamentos
                  where idformapagamento in (4, 5, 6)
                 order by 1
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 90
            region: @opções
            slot: regionBody
            alignment: left
