    branch (
        name: Go To Page 228
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 228
                items: {
                    P228_TIPODATA: &P228_TIPODATA.
                    P228_DATAINICIO: &P228_DATAINICIO.
                    P228_DATAFIM: &P228_DATAFIM.
                    P228_IDFILIALROMANCE: &P228_IDFILIALROMANCE.
