    process atualiza-depara-de-produtos (
        name: Atualiza depara de produtos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Created on 24/06/2020 by MAX.BERKEUER 
                declare 
                  --
                  vid_prod_det number := :P6_IDPRODUTODETALHADO;
                  vsku_virtual_age number := :P6_SKU_VIRTUALAGE;
                  vexiste number;
                  --
                begin
                  --
                  if vsku_virtual_age is not null then
                    --
                    select count(1)
                    into vexiste
                    from deparaprodfavoritavirtualage d
                    where d.idprodutodetalhado = vid_prod_det;
                    --
                    if vexiste > 0 then
                      --
                      update deparaprodfavoritavirtualage dp
                      set dp.skuvirtualage = vsku_virtual_age
                      where dp.idprodutodetalhado = vid_prod_det;
                      --
                    else
                      --
                      insert into deparaprodfavoritavirtualage(idprodutodetalhado, skuvirtualage)
                      values(vid_prod_det,vsku_virtual_age);
                      --
                    end if;
                    --
                  else
                    --
                    select count(1)
                    into vexiste
                    from deparaprodfavoritavirtualage d
                    where d.idprodutodetalhado = vid_prod_det;
                    --
                    if vexiste > 0 then
                      --
                      delete deparaprodfavoritavirtualage df
                      where df.idprodutodetalhado = vid_prod_det;
                      --
                    end if;    
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 52179961355020812
        }
        serverSideCondition {
            type: request=Value
            value: ATUALIZAR
        }
    )

    process atualiza-países (
        name: Atualiza países
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Created on 02/07/2020 by MAX.BERKEUER 
                declare 
                  --
                  vid_produto_detalhado number := :P6_IDPRODUTODETALHADO;
                  v_array varchar2(200) := :P6_PAISES_HABILITADOS;
                  vexist number;
                  --
                begin
                  --
                  /*Inativa os países que não estejam na lista*/
                  update produtosdetalhadospaises pd
                  set pd.descontinuado = 'S'
                  where pd.idprodutodetalhado = vid_produto_detalhado
                  and pck_util_fav.fnc_exists_in_array_ret_int(pd.idpais,v_array) = 0;
                  --
                  for c in (select column_value as id_pais
                           from table(pck_util_fav.fnc_array_to_table(v_array)))
                  loop
                    --
                    update produtosdetalhadospaises p
                    set p.descontinuado = 'N'
                    where p.idprodutodetalhado = vid_produto_detalhado
                    and p.idpais = c.id_pais;
                    --
                    if  sql%rowcount = 0 then
                      --
                      insert into produtosdetalhadospaises(idprodutodetalhadopais,
                                                           idpais,
                                                           idprodutodetalhado,
                                                           descontinuado)
                      values(seq_idproddetalhado_pais.nextval,
                                                           c.id_pais,
                                                           vid_produto_detalhado,
                                                           'N');
                      --
                    end if;
                    --
                  end loop;
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 62641157480605950
        }
        serverSideCondition {
            type: request=Value
            value: ATUALIZAR
        }
    )

    process atualiza-tags (
        name: Atualiza tags
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vid_produtodetalhado number := :P6_IDPRODUTODETALHADO;
                  vstring_tags varchar2(500) := :P6_TAGS;
                  vtags APEX_APPLICATION_GLOBAL.VC_ARR2;
                  vexist_tag number;
                  --
                begin
                  --
                  vtags := APEX_UTIL.STRING_TO_TABLE(vstring_tags);
                  --
                  for dd in 1.. vtags.count loop
                    --
                    begin/*Faz o tratamento para ionclusão de novas tags*/
                      --
                      select c.idtagproduto
                      into vexist_tag
                      from classificacoesprodutos c
                      where c.idprodutodetalhado = vid_produtodetalhado 
                      and c.idtagproduto = vtags(dd);
                      --
                    exception
                      when no_data_found then
                        --
                        insert into classificacoesprodutos(idclassificacaoproduto
                                                          ,idprodutodetalhado
                                                          ,idtagproduto)
                        values(seq_idclassificacaoproduto.nextval,
                                                          vid_produtodetalhado,
                                                          vtags(dd));    
                        --
                        if vtags(dd) = 123 then
                          --
                          update produtosdetalhados pd
                            set pd.dataintegracao = sysdate
                              , pd.situacaointegracao = 'I'
                              , pd.mensagemintegracao = 'PRODUTO NAO INTEGRADO - TAG SINALIZADA PARA NAO INTEGRAR'
                            where pd.idprodutodetalhado = vid_produtodetalhado;
                          --
                        end if;
                        --
                    end;
                    --
                  end loop;
                
                
                  --
                  begin /*Remove as tags que não forem passadas no parâmetro*/
                    --
                    for d in (select c.idclassificacaoproduto
                                    ,c.idtagproduto
                             from classificacoesprodutos c
                             where c.idprodutodetalhado = vid_produtodetalhado)
                    loop
                      --
                      if pck_util_fav.fnc_exists_in_array(pvalor => d.idtagproduto, parray => vstring_tags) = false then
                        --
                        delete classificacoesprodutos cf
                        where cf.idclassificacaoproduto = d.idclassificacaoproduto;
                        --
                      end if;
                      --
                    end loop;
                    --
                  end;
                  --
                  commit;
                  --
                end prc_atualiza_rotas;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 36114529372240108
        }
        serverSideCondition {
            type: request=Value
            value: ATUALIZAR
        }
    )

    process consulta-produtos-detalhados-código-ean (
        name: Consulta Produtos Detalhados / Código EAN
        type: executeCode
