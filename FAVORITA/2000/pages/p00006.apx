    process operação-dml-em-produtos-detalhados (
        name: Operação DML em Produtos Detalhados
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  if voperacao_dml = 'D' then
                    #OWNER#.PCK_CADASTROS_FAV.PRC_GERACODIGOBARRA (
                      PIDPRODUTODETALHADO => :P6_IDPRODUTODETALHADO,
                      PIDCODIGOBARRA => :P6_IDCODIGOBARRA,
                      PCODIGOEAN => :P6_CODIGOEAN, 
                      POPERACAO_DML => 'D' );
                  end if;
                  --
                  favorita.pck_cadastros_fav.prc_produtosdetalhados ( pidprodutodetalhado    => :P6_IDPRODUTODETALHADO
                                                                    , pidproduto             => :P6_IDPRODUTO
                                                                    , pidcaracteristica      => :P6_IDCARACTERISTICA
                                                                    , pidcor                 => :P6_IDCOR
                                                                    , pidgrade               => :P6_IDGRADE
                                                                    , pidcodigobarra         => :P6_IDCODIGOBARRA
                                                                    , pativo                 => :P6_ATIVO
                                                                    , pdescontinuado         => :P6_DESCONTINUADO
                                                                    , pidncm                 => :P6_IDNCM
                                                                    , pidespecie             => :P6_IDESPECIE
                                                                    , pidcstorigem           => :P6_IDCSTORIGEM    
                                                                    , pidcest                => :P6_IDCEST
                                                                    , pidtipodeitemsped      => :P6_IDTIPODEITEMSPED
                                                                    , pmd5                   => :P6_MD5
                                                                    , poperacao_dml          => voperacao_dml );  
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 3065239390426769
        }
    )

    process popula-campo-de-paises (
        name: Popula campo de paises
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  l_vc_arr2 apex_application_global.vc_arr2; 
                  vpaises varchar2(32000); 
                  -- 
                begin 
                  --
                  select pd.idpais
                  bulk collect 
                  into l_vc_arr2 
                  from produtosdetalhadospaises pd 
                  where pd.idprodutodetalhado = :P6_IDPRODUTODETALHADO
                  and pd.descontinuado = 'N'
                  order by pd.idprodutodetalhadopais; 
                  --
                  vpaises := apex_util.table_to_string (p_table => l_vc_arr2,p_string => ':');
                  --
                  apex_util.set_session_state(p_name => 'P6_PAISES_HABILITADOS',p_value => vpaises);
                  --    
                  --dbms_output.put_line(vpaises);
                  --
                end;
                ```
        }
        execution {
            sequence: 40
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 67062179064883701
        }
    )

    process popula-campo-de-sku-virtual-age (
        name: Popula campo de SKU virtual age
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Created on 24/06/2020 by MAX.BERKEUER 
                declare 
                  --
                  vsku_virtualage number;
                  --
                begin
                  --
                  select d.skuvirtualage
                  into vsku_virtualage
                  from deparaprodfavoritavirtualage d
                  where d.idprodutodetalhado = :P6_IDPRODUTODETALHADO;  
                  --
                  :P6_SKU_VIRTUALAGE := vsku_virtualage;
                  --
                exception
                  when no_data_found then
                    null;
                end;
                ```
        }
        execution {
            sequence: 30
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 52180194595020814
        }
    )

    process popula-campo-de-tags (
        name: Popula campo de tags
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Created on 13/05/2020 by MAX.BERKEUER 
                declare 
                  --
                  vvalor varchar(500);
                  --
                begin
                  --
                  for c in (select c.idtagproduto
                           from classificacoesprodutos c
                           where c.idprodutodetalhado = :P6_IDPRODUTODETALHADO)
                  loop
                    --
                    vvalor := vvalor||':'||c.idtagproduto;
                    --
                  end loop;
                  --
                  vvalor := trim(':' from vvalor);
                  --
                  :P6_TAGS := vvalor;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 36114439448240107
        }
    )

