page 576 (
    name: Ordens de Compra
    title: Ordens de Compra
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"Confirma exclusão da Ordem de Compra?"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region itens-da-ordem-de-compra (
        name: Itens da Ordem de Compra
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.idordemcompra
                     , i.idprodutodetalhado
                     , i.qtdesolicitada
                     , i.valorunitario
                     , i.idproduto
                     , sum(i.qtdecomprada) qtdecomprada
                /*     , pck_util_fav.fnc_nomefilialfavorita( 
                          (select distinct idfilialdestino 
                            from tmp_ordenscomprasprop 
                           where idordemcompra = i.idordemcompra
                             and idprodutodetalhado = i.idprodutodetalhado)) "Filial Destino" */
                     --, (select idsubcategoria from produtos where idproduto = i.idproduto) subcat
                  from itensordenscompras i
                 where i.idordemcompra = :P576_IDORDEMCOMPRA
                 group by i.idordemcompra
                     , i.idprodutodetalhado
                     , i.qtdesolicitada
                     , i.valorunitario
                     , i.idproduto
                ```
            pageItemsToSubmit: P576_IDORDEMCOMPRA
        }
        layout {
            sequence: 10
            parentRegion: @ordens-de-compra
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        headerAndFooter {
            headerText:
                ```html
                <table><tr>
                <td style="width:48%"><hr/></td>
                <td style="vertical-align:middle; text-align: center; color:red">Itens de Compra</td>
                <td style="width:48%"><hr/></td>
                </tr></table>
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from ordenscompras
                 where idordemcompra = :P576_IDORDEMCOMPRA
                   and idsituacaooc >= 3
                   and exists ( select 1 
                                  from itensordenscompras i
                                 where i.idordemcompra = :P576_IDORDEMCOMPRA )
                ```
        }
        readOnly {
            type: itemIsNotNull
            item: P576_DATAFECHAMENTO
        }
        edit {
            enabled: true
            allowedOperations: delete
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 788909393511740021
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDORDEMCOMPRA
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDPRODUTODETALHADO
                layout {
                    width: 455
