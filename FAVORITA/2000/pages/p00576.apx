        }
    )

    pageItem P576_IDEDICAOORIGEM (
        type: selectList
        label {
            label: Revistas de Históricos
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select * from (
                select numeroedicao || ' - ' || nome display_value
                     , idedicaorevista         return_value
                --     , e.datainicial, e.datafinal
                  from edicoesrevistas e
                 where e.idpais = (select idpais from edicoesrevistas where idedicaorevista = :P576_IDEDICAOREVISTA)
                  -- and (trunc(sysdate) between datainicial
                  --                        and datafinal
                  --      or trunc(sysdate) > datafinal)
                    
                order by idedicaorevista desc)
                where rownum < 10;
                ```
        }
        cascadingLov {
            parentItems: P576_IDEDICAOREVISTA
            itemsToSubmit: [
                P576_IDPAIS
                P576_IDEDICAOREVISTA
            ]
        }
        multipleValues {
            type: delimitedList
        }
        layout {
            sequence: 80
            region: @ordens-de-compra
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 5
        }
        serverSideCondition {
            type: itemIsNull
            item: P576_IDORDEMCOMPRA
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from itensordenscompras
                 where idordemcompra = :P576_IDORDEMCOMPRA
                    or exists (select 1
                                 from ordenscompras
                                where idordemcompra = :P576_IDORDEMCOMPRA
                                  and datafechamento is not null)
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P576_IDEDICAOREVISTA (
        type: selectList
        label {
            label: Revista a Abastecer
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select numeroedicao || ' - ' || nome display_value
                     , idedicaorevista         return_value
                    -- , e.datainicial, e.datafinal, idpais
                  from edicoesrevistas e
                 where trunc(sysdate) < datainicial
                order by nvl(idpais,1), idedicaorevista
                ```
        }
        layout {
            sequence: 70
            region: @ordens-de-compra
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from itensordenscompras
                 where idordemcompra = :P576_IDORDEMCOMPRA
                    or exists (select 1
                                 from ordenscompras
                                where idordemcompra = :P576_IDORDEMCOMPRA
                                  and datafechamento is not null)
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P576_IDFORNECEDOR (
        type: popupLov
        label {
            label: Fornecedor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select upper(p.nomepessoa), f.idfornecedor
                  from fornecedores f, pessoas p
                 where f.idpessoa = p.idpessoa
                   and f.idfornecedor in (select idfornecedor 
                                            from fornecedoresprodutos fp, produtosdetalhados pd, produtos pro
                                           where fp.idproduto = pro.idproduto
                                             and pro.idproduto = pd.idproduto
                                             and pd.descontinuado = 'N')
                 order by 1
                ```
        }
        layout {
            sequence: 40
            region: @ordens-de-compra
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        readOnly {
            type: itemIsNotNull
            item: P576_DATAFECHAMENTO
        }
        security {
            encryptSessionState: false
        }
    )

