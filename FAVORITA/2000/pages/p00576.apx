    process fecharoc (
        name: FecharOC
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  viditemordemcompra number;
                  vmd5 varchar2(4000);
                begin
                  -- Grava itens com base na tabela temporaria 
                  for c1 in (
                          select idproduto
                               , idprodutodetalhado
                               , qtdcomprar
                               , qtdsugerida
                               , valorcusto
                            from tmp_ordenscomprasprop
                           where idordemcompra = :P576_IDORDEMCOMPRA 
                             and qtdcomprar > 0     )
                  loop
                    --
                    viditemordemcompra := null;
                    pck_cadastros_fav.prc_itensordenscompras(piditemordemcompra  => viditemordemcompra,
                                                             pidordemcompra      => :P576_IDORDEMCOMPRA,
                                                             pidproduto          => c1.idproduto,
                                                             pidprodutodetalhado => c1.idprodutodetalhado,
                                                             pqtdesolicitada     => c1.qtdsugerida,
                                                             pqtdecomprada       => c1.qtdcomprar,
                                                             pvalorunitario      => c1.valorcusto,
                                                             pmd5                => vmd5,
                                                             poperacao_dml       => 'I'); 
                  end loop; 
                
                
                  update ordenscompras
                     set datafechamento = localtimestamp
                       , idsituacaooc   = 3 -- Pedido
                   where idordemcompra = :P576_IDORDEMCOMPRA;
                exception
                  when others then
                    raise_application_error(-20001,'Erro ao fechar ordem de compra. Informe a T.I.');
                end;
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 102071952364575820
        }
        serverSideCondition {
            whenButtonPressed: @fecharoc
        }
    )

    process fetch-row-from-ordenscompras (
        name: Fetch Row from ORDENSCOMPRAS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                vDataEmissao timestamp;
                vDataFechamento timestamp;
                vqtdciclos number;
                vperc  number;
                vidOC  number := :P576_IDORDEMCOMPRA;
                vnumnull number;
                BEGIN
                  pck_cadastros_fav.prc_ordenscompras(pidordemcompra    => vidOC,
                                                      pdataemissao      => vDataEmissao,
                                                      ptipooc           => :P576_TIPOOC,
                                                      pidfornecedor     => :P576_IDFORNECEDOR,
                                                      pidusuarioemissao => :P576_IDUSUARIOEMISSAO,
                                                      pidsituacao       => :P576_IDSITUACAOOC,
                                                      pidedicaorevista  => :P576_IDEDICAOREVISTA,
                                                      pidedicaoorigem   => vnumnull, --:P576_IDEDICAOORIGEM,
                                                      pqtdciclos        => vqtdciclos,
                                                      ppercrecebido     => vperc,
                                                      pdatafechamento   => vDataFechamento,
                                                      previstashist     => :P576_REVISTASHIST,
                                                      pmd5              => :P576_MD5,
                                                      poperacao_dml     => 'S');
                
                --RAISE_APPLICATION_ERROR(-20001,' IDORDEM = '||:P576_IDORDEMCOMPRA);
                  :P576_PERCRECEBIDO := to_char(vperc,'990D00');
                  :P576_QTDCICLOS := to_char(vqtdciclos,'990D00');
                  :P576_DATAEMISSAO := to_char(vDataEmissao,'DD/MM/RRRR HH24:MI:SS');
                  :P576_DATAFECHAMENTO := to_char(vDataFechamento,'DD/MM/RRRR HH24:MI:SS');
                END;
                
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 102056112246327780
        }
    )

    process gerarpedidos (
        name: GerarPedidos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vtotalcompra    number;
                  vMD5            varchar2(4000);
                  vdatainicial    date;
                  vdatafinal      date;
                  vidnotafiscal   number;
                  vidorigem       number;
                  vidcompratransf number;
                  vNumNull        number;
                  vnumeroCT       number;
                  vidSituacao     number;
                  vNotaFiscal     number;
                  vDataEmiss      date := localtimestamp;
                  vDatNull        date;
                  vDataPrev       date;
                  vObs            varchar2(1000);
                  vTipo           number;
                  vCharNull       varchar2(100);
                  vIdentificacao  varchar2(1);
                  viditemcompratransf number;
                  vqtdzero        number := 0;
                  vidfilialorigem number :=:P0_IDFILIALFAVORITA;
                  
                begin
                  --
                  for c1 in (select distinct t.idfilialdestino, t.idfilialorigem
                               from tmp_ordenscomprasprop t
                              where t.idordemcompra = :P576_IDORDEMCOMPRA  )
                  loop
                    -- 
                    begin
                      select tempoentrega + sysdate
                         into vDataPrev
                        from favorita.fornecedorestemposentrega ft
                       where ft.idfilialfavorita = c1.idfilialdestino
                         and ft.idfornecedor     = :P576_IDFORNECEDOR ;
                    exception
                      when others then null;
                    end;
                    --
                    -- verifica se tem quantidades para transferir, caso tenha, gera pedido de transferencia também.
                    for c_tp in (
                            select distinct tipo
                              from ( 
                                    select 'C' tipo 
                                      from tmp_ordenscomprasprop
                                     where idordemcompra = :P576_IDORDEMCOMPRA 
                                       and qtdcomprar > 0
                                    --
                                    UNION ALL
                                    --
                                    select 'T' tipo 
                                      from tmp_ordenscomprasprop
                                     where idordemcompra = :P576_IDORDEMCOMPRA 
                                       and qtdtransferir > 0 )
                    ) loop
                    
                      if c_tp.tipo = 'C' then  -- C=Compra
                        vtipo := 0;
                        vObs := 'Pedido gerado automaticamente pela Ordem de Compra ' ||:P576_IDORDEMCOMPRA ;
                        vidfilialorigem := null; -- Foi solicitado pelo setor de compras (Pablo e Patricia) que nas compras nao deve ter idfilialfavoritaorigem
                        vnumeroCT := null;
                        pck_comprastransf_fav.prc_comprastransferencias( pidcompratransferencia       => vidcompratransf, 
                                                                         pidfornecedor                => :P576_IDFORNECEDOR, -- Informado na OC 
                                                                         pidfilialfavoritaorigem      => vidfilialorigem,  
                                                                         pidfilialfavoritadestino     => c1.idfilialdestino, -- FAZER LOOP E INFORMAR O CURSOR C1.idfilialdestino
                                                                         pidfilialromancedestino      => vNumNull,  
                                                                         pidpostoavancadodestino      => vNumNull, 
                                                                         pnumero                      => vnumeroCT, 
                                                                         pidsituacao                  => vidsituacao, -- retorno 
                                                                         pnotafiscal                  => vNotaFiscal, 
                                                                         pdataemissao                 => vDataEmiss, -- sysdate
                                                                         pdatarecebimento             => vDatNull,   
                                                                         pdataembarque                => vDatNull,   
                                                                         pdataprevisaoentrega         => vDataPrev,  -- calcular de acordo com a previsao dos fornecedores.
                                                                         pvalortotalcompra            => vNumNull,   
                                                                         pcubagem                     => vNumNull,   
                                                                         pvolume                      => vNumNull,   
                                                                         ppeso                        => vNumNull,   
                                                                         pobservacao                  => vObs,       
                                                                         pidtipo                      => vTipo,      -- 0 = Compra
                                                                         poperacao_dml                => 'I', 
                                                                         pmd5                         => vMD5,       
                                                                         pidusuario                   => :P576_IDUSUARIOEMISSAO, 
                                                                         pidsemanaentrega             => vNumNull,       
                                                                         panaliseconcluida            => vCharNull,      
                                                                         pidentificacaointerna        => vIdentificacao, -- 'N'
                                                                         pdataemissaoinicial          => vdatainicial,   
                                                                         pdataemissaofinal            => vdatafinal,     
                                                                         pidnotafiscal                => vidnotafiscal,  
                                                                         pidcompratransferenciaorigem => vidOrigem,
                                                                         pidordemcompra               => :P576_IDORDEMCOMPRA ); 
                        -- grava itens 
                        for c2 in (select idprodutodetalhado, qtdcomprar, valorcusto, qtdtransferir
                                     from tmp_ordenscomprasprop
                                    where idordemcompra = :P576_IDORDEMCOMPRA
                                      and idfilialdestino = c1.idfilialdestino
                                      and qtdcomprar > 0 )
                        loop
                          --
                          vObs := 'Item gerado pelo processo de compra COM ordem de compra vinculada ('||:P576_IDORDEMCOMPRA||')';
                          viditemcompratransf := null;
                          PCK_COMPRASTRANSF_FAV.prc_itenscomprastransferencias(piditemcompratransferencia   => viditemcompratransf,
                                                                               pidcompratransferencia       => vidcompratransf,
                                                                               pidprodutodetalhado          => c2.idprodutodetalhado,
                                                                               pquantidadecomprada          => c2.qtdcomprar,
                                                                               pquantidaderecebida          => vNumNull,
                                                                               pquantidadeavariada          => vNumNull,
                                                                               pquantidaderecebidaadicional => vNumNull,
                                                                               pobservacao                  => vObs,
                                                                               pobservacaoavaria            => vCharNull,
                                                                               pmd5                         => vCharNull,
                                                                               poperacao_dml                => 'I',
                                                                               pidestoquefilorigem          => vNumNull,
                                                                               pidestoquefildestino         => vNumNull,
                                                                               pvalorcusto                  => c2.valorcusto ) ;
                        end loop; 
                        --
                        
                      end if;
                      --
                      if c_tp.tipo = 'T' then -- T=Transferencia
                        vtipo := 1;
                        vObs := 'Pedido gerado automaticamente pela Ordem de Compra ' ||:P576_IDORDEMCOMPRA ;
                        vidcompratransf := null;
                        vidsituacao     := null;
                        vNotaFiscal     := null;
                        vDataPrev       := null;
                        vdatainicial    := null;
                        vdatafinal      := null;
                        vIdentificacao  := null;
                        vnumeroCT       := null;
                        
                        begin
                        pck_comprastransf_fav.prc_comprastransferencias( pidcompratransferencia       => vidcompratransf, 
                                                                         pidfornecedor                => vNumNull, -- CD que vai transferir mercadoria
                                                                         pidfilialfavoritaorigem      => c1.idfilialorigem,  -- FILIAL QUE ATENDE O CD DESTINATARIO
                                                                         pidfilialfavoritadestino     => c1.idfilialdestino, -- FAZER LOOP E INFORMAR O CURSOR C1.idfilialdestino
                                                                         pidfilialromancedestino      => vNumNull,  
                                                                         pidpostoavancadodestino      => vNumNull, 
                                                                         pnumero                      => vnumeroCT, 
                                                                         pidsituacao                  => vidsituacao, -- retorno 
                                                                         pnotafiscal                  => vNotaFiscal, 
                                                                         pdataemissao                 => vDataEmiss, -- sysdate
                                                                         pdatarecebimento             => vDatNull,   -- null
                                                                         pdataembarque                => vDatNull,   -- null
                                                                         pdataprevisaoentrega         => vDataPrev,  -- calcular de acordo com a previsao dos fornecedores.
                                                                         pvalortotalcompra            => vNumNull,   -- null 
                                                                         pcubagem                     => vNumNull,   -- null 
                                                                         pvolume                      => vNumNull,   -- null 
                                                                         ppeso                        => vNumNull,   -- null 
                                                                         pobservacao                  => vObs,       -- ver com Guilherme qual obs colocar
                                                                         pidtipo                      => vTipo,      -- 1 = Transferencia
                                                                         poperacao_dml                => 'I', 
                                                                         pmd5                         => vMD5,        -- null 
                                                                         pidusuario                   => :P576_IDUSUARIOEMISSAO, -- usuario
                                                                         pidsemanaentrega             => vNumNull,       -- null
                                                                         panaliseconcluida            => vCharNull,      -- null
                                                                         pidentificacaointerna        => vIdentificacao, -- 'N'
                                                                         pdataemissaoinicial          => vdatainicial,   -- NULL
                                                                         pdataemissaofinal            => vdatafinal,     --NULL
                                                                         pidnotafiscal                => vidnotafiscal,  -- NULL
                                                                         pidcompratransferenciaorigem => vidOrigem,
                                                                         pidordemcompra               => :P576_IDORDEMCOMPRA ); -- NULL
                        exception
                          when others then raise_application_error(-20001,'Erro ao incluir capa da compra/transferencia!');
                        end;
                        --
                        for c2 in (select idprodutodetalhado, qtdcomprar, valorcusto, qtdtransferir
                                     from tmp_ordenscomprasprop
                                    where idordemcompra = :P576_IDORDEMCOMPRA
                                      and idfilialdestino = c1.idfilialdestino
                                      and qtdtransferir > 0 )
                        loop
                      
                          vObs := 'Item gerado pelo processo de compra SEM ordem de compra vinculada pois havia estoque suficiente para transferir de outro CD';
                          viditemcompratransf := null;
                          vqtdzero := 0;
                          begin
                          PCK_COMPRASTRANSF_FAV.prc_itenscomprastransferencias(piditemcompratransferencia   => viditemcompratransf,
                                                                               pidcompratransferencia       => vidcompratransf,
                                                                               pidprodutodetalhado          => c2.idprodutodetalhado,
                                                                               pquantidadecomprada          => c2.qtdtransferir,
                                                                               pquantidaderecebida          => vqtdzero,
                                                                               pquantidadeavariada          => vqtdzero,
                                                                               pquantidaderecebidaadicional => vNumNull,
                                                                               pobservacao                  => vObs,
                                                                               pobservacaoavaria            => vCharNull,
                                                                               pmd5                         => vCharNull,
                                                                               poperacao_dml                => 'I',
                                                                               pidestoquefilorigem          => vNumNull,
                                                                               pidestoquefildestino         => vNumNull,
                                                                               pvalorcusto                  => c2.valorcusto,
                                                                               pprocautoloja                => 'x') ;  -- passado para nao dar erro na chamada.
                        exception
                          when others then raise_application_error(-20001,'Erro ao incluir itens da compra/transferencia!');
                        end;
                      
                        end loop;
                      
                      end if;
                    
                    end loop; 
                    
                  end loop;
                  --
                  -- Atualiza status da OC. para 'O.C com pedido gerado'
                  update ordenscompras
                     set idsituacaooc = 4
                   where idordemcompra = :P576_IDORDEMCOMPRA;
                  --
                  commit;
                  
                  exception
                    when others then 
                      raise_application_error(-20001,'Nenhum item localizado para gerar pedido!');
                  
                end;
                
                ```
        }
        execution {
            sequence: 80
        }
        successMessage {
            successMessage: Pedido(s) gerado(s) com sucesso!!
        }
        advanced {
            executionMappingIdentifier: 102072857629575829
        }
        serverSideCondition {
            whenButtonPressed: @gerarpedidos
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P576_IDORDEMCOMPRA is null then
                        select "#OWNER#"."SEQ_IDORDEMCOMPRA".nextval
                          into :P576_IDORDEMCOMPRA
                          from sys.dual;
                    end if;
                    
                    :P576_IDSITUACAOOC := 1;
                    :P576_DATAEMISSAO  := to_char(localtimestamp,'dd/mm/rrrr hh24:mi:ss');
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 102056501988327780
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

