    button analise (
        buttonName: ANALISE
        label: Incluir Produtos Reposição
        layout {
            sequence: 90
            region: @ordens-de-compra
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 578
                items: {
                    P578_IDORDEMCOMPRA: &P576_IDORDEMCOMPRA.
                    P578_IDFORNECEDOR: &P576_IDFORNECEDOR.
                    P578_QTDCICLOS: &P576_QTDCICLOS_NUM.
                    P578_IDEDICAOREVISTA: &P576_IDEDICAOREVISTA.
                    P578_IDPAIS: &P576_IDPAIS.
                }
                clearCache: 578
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                  from ordenscompras
                 where tipooc = 'R'
                   and idordemcompra = :P576_IDORDEMCOMPRA
                   and ( idsituacaooc = 1 OR (idsituacaooc=2 and not exists (select 1
                                                                             from itensordenscompras
                                                                            where idordemcompra = :P576_IDORDEMCOMPRA) )  )
                ```
        }
    )

