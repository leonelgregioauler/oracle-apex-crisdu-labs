    process process-row-of-ordenscompras (
        name: Process Row of ORDENSCOMPRAS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                vDML  varchar2(1);
                vidOC number;
                vnumnull number;
                begin
                
                  case when v('REQUEST') = 'CREATE' then
                         vDML := 'I';
                       when v('REQUEST') = 'SAVE' then
                         vDML := 'U';
                       when v('REQUEST') = 'DELETE' then
                         vDML := 'D';
                  else
                     vDML :='X';
                  end case;
                  
                  vidOC := :P576_IDORDEMCOMPRA;
                  
                  pck_cadastros_fav.prc_ordenscompras(pidordemcompra    => vidOC,
                                                      pdataemissao      => :P576_DATAEMISSAO,
                                                      ptipooc           => :P576_TIPOOC,
                                                      pidfornecedor     => :P576_IDFORNECEDOR,
                                                      pidusuarioemissao => :P576_IDUSUARIOEMISSAO,
                                                      pidsituacao       => :P576_IDSITUACAOOC,
                                                      pidedicaorevista  => :P576_IDEDICAOREVISTA,
                                                      pidedicaoorigem   => vnumnull, --:P576_IDEDICAOORIGEM, -- usuário vai poder selecionar mais de uma revista de histórico
                                                                                                             -- então foi criado o campo REVISTASHIST
                                                      pqtdciclos        => :P576_QTDCICLOS,
                                                      ppercrecebido     => :P576_PERCRECEBIDO,
                                                      pdatafechamento   => :P576_DATAFECHAMENTO,
                                                      previstashist     => :P576_REVISTASHIST,
                                                      pmd5              => :P576_MD5,
                                                      poperacao_dml     => vDML);
                  if v('REQUEST') = 'CREATE' then
                    :P576_IDORDEMCOMPRA := vidOC;
                  end if;
                  
                end;
                
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação executada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 102056952069327781
        }
    )

