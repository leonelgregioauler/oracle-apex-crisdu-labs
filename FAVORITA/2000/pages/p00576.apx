    dynamicAction alterasituacao (
        name: AlteraSituacao
        execution {
            sequence: 95
        }
        when {
            event: click
            selectionType: button
            button: @alterasituacao
        }

        action native-confirm (
            action: confirm
            settings {
                message: Confirma alterar situação da Ordem de Compra?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: ALTERASITUACAO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction confirmagp (
        name: ConfirmaGP
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @gerarpedidos
        }

        action native-confirm (
            action: confirm
            settings {
                message: Confirma GERAR PEDIDOS para esta ordem de compra?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: GERARPEDIDOS
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction confirmar (
        name: Confirmar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @fecharoc
        }

        action native-confirm (
            action: confirm
            settings {
                message: Confirma fechamento da Ordem de Compra? (não poderá mais ser alterada)
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FECHAROC
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P576_QTDCICLOS
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P576_QTDCICLOS_NUM
            }
            execution {
                sequence: 20
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: TRANSLATE(:P576_QTDCICLOS,',','.')
                itemsToSubmit: P576_QTDCICLOS
            }
            affectedElements {
                selectionType: items
                items: P576_QTDCICLOS_NUM
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new-2 (
        name: New_1
        execution {
            sequence: 85
        }
        when {
            selectionType: items
            items: P576_TIPOOC
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                     if :P576_TIPOOC = 'L' then
                        :P576_QTDCICLOS := '0';
                     else
                        :P576_QTDCICLOS := '4,5';
                     end if;
                    end;
                    ```
                itemsToSubmit: P576_TIPOOC
                itemsToReturn: P576_QTDCICLOS
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new-3 (
        name: New_2
        execution {
            sequence: 80
        }
        when {
            selectionType: items
            items: P576_TIPOOC
        }
        clientSideCondition {
            type: item=value
            item: P576_TIPOOC
            value: L
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P576_IDEDICAOREVISTA
                    P576_IDEDICAOORIGEM
                ]
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P576_IDEDICAOREVISTA
                    P576_IDEDICAOORIGEM
                ]
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction new-4 (
        name: New_3
        execution {
            sequence: 105
        }
        when {
            selectionType: items
            items: P576_IDEDICAOORIGEM
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    
                        select listagg(numeroedicao,';')
                          into :P576_REVISTASHIST
                          from edicoesrevistas
                         where idedicaorevista in ( select regexp_substr(:P576_IDEDICAOORIGEM, '[^:]+', 1, level) ID
                                                      from dual
                                                      connect by level <= regexp_count(:P576_IDEDICAOORIGEM, ':') + 1 ) 
                           order by numeroedicao;
                        
                    end;
                    ```
                itemsToSubmit: P576_IDEDICAOORIGEM
                itemsToReturn: P576_REVISTASHIST
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P576_REVISTASHIST
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction pais (
        name: pais
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P576_IDEDICAOREVISTA
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                        begin
                          select idpais
                            into :P576_IDPAIS
                            from edicoesrevistas
                           where idedicaorevista = :P576_IDEDICAOREVISTA;
                        exception
                          when others then null;
                        end;
                    
                    ```
                itemsToSubmit: P576_IDEDICAOREVISTA
                itemsToReturn: P576_IDPAIS
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

    validation validatipol (
        name: ValidaTipoL
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                Select 1 from dual 
                 where :P576_IDORDEMCOMPRA is null 
                   and :P576_IDEDICAOREVISTA is null
                   and :P576_TIPOOC = 'L'
                ```
        }
        error {
            errorMessage: Obrigatório informar Edição de Revista para Ordens de Compra Lançamento
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    validation validatipor (
        name: ValidaTipoR
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                Select 1 from dual 
                 where :P576_IDORDEMCOMPRA is null 
                   and NVL(:P576_QTDCICLOS,0) = 0
                   and :P576_TIPOOC = 'R'
                ```
        }
        error {
            errorMessage: Obrigatório informar Qtd Ciclos para Ordens de Compra Reposição
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

