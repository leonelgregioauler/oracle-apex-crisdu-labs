    region itens-da-tabela-temporaria (
        name: Itens da tabela temporaria
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.idtmpordenscomprasprop
                     , i.idprodutodetalhado
                     , i.qtdcomprar
                     , i.qtdsugerida
                     , i.valorcusto valorunitario
                     , i.idproduto
                     , i.idfilialdestino
                     , i.qtdtransferir
                     , i.qtdciclossugerida
                     , i.qtdcicloscomprar
                     , i.qtdciclostransferir
                     , i.vendaconsiderada
                  from tmp_ordenscomprasprop i
                 where i.idordemcompra = :P576_IDORDEMCOMPRA
                ```
            pageItemsToSubmit: P576_IDORDEMCOMPRA
        }
        layout {
            sequence: 20
            parentRegion: @ordens-de-compra
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        headerAndFooter {
            headerText: <hr style="width:100%;text-align:left;margin-left:0;color:blue">
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from ordenscompras
                 where idordemcompra = :P576_IDORDEMCOMPRA
                   and idsituacaooc < 3
                ```
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
