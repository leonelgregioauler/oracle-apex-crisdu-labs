    region itens-de-transferencia (
        name: Itens de Transferencia
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.idtmpordenscomprasprop
                     , i.idprodutodetalhado
                --     , i.qtdcomprar
                --     , i.qtdsugerida
                     , i.valorcusto valorunitario
                     , i.idproduto
                     , i.idfilialdestino
                     , i.qtdtransferir
                --     , i.qtdciclossugerida
                --     , i.qtdcicloscomprar
                     , i.qtdciclostransferir
                     , i.vendaconsiderada
                  from tmp_ordenscomprasprop i
                 where i.idordemcompra = :P576_IDORDEMCOMPRA
                   and nvl(i.qtdtransferir,0) > 0
                ```
            pageItemsToSubmit: P576_IDORDEMCOMPRA
        }
        layout {
            sequence: 30
            parentRegion: @ordens-de-compra
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        headerAndFooter {
            headerText:
                ```html
                <table><tr>
                <td style="width:47%"><hr/></td>
                <td style="vertical-align:middle; text-align: center; color:red">Itens de Transferencia</td>
                <td style="width:47%"><hr/></td>
                </tr></table>
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from ordenscompras
                 where idordemcompra = :P576_IDORDEMCOMPRA
                   and idsituacaooc >= 3
                   and tipooc = 'R'
                ```
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from ordenscompras
                 where idordemcompra = :P576_IDORDEMCOMPRA
                   and idsituacaooc >= 4
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 501555761893517545
        }

