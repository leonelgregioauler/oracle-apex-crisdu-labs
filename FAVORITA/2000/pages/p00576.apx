                layout {
                    width: 410
                    sequence: 3
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    show: false
                    width: 61
                    sequence: 2
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            settings {
                showSelectAll: false
            }
            layout {
                sequence: 10
            }
        )

        column IDORDEMCOMPRA (
            type: hidden
            layout {
                sequence: 110
            }
            source {
                databaseColumn: IDORDEMCOMPRA
                dataType: number
                queryOnly: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDPRODUTO (
            type: selectList
            heading {
                heading: Produto
            }
            lov {
                type: sharedComponent
                lov: @lov-produtos
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IDPRODUTO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column IDPRODUTODETALHADO (
            type: popupLov
            heading {
                heading: Produto Detalhado
            }
            settings {
                displayAs: modalDialog
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_util_fav.fnc_nomeprodutodetalhado(idprodutodetalhado, :P0_IDIDIOMA) as d
                         , idprodutodetalhado as r
                       from produtosdetalhados
                     where idproduto = :IDPRODUTO
                     order by 1
                    ```
            }
            cascadingLov {
                parentColumns: IDPRODUTO
                itemsToSubmit: IDPRODUTO
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: IDPRODUTODETALHADO
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column QTDECOMPRADA (
            type: numberField
            heading {
