    region situação-dos-produtos (
        name: Situação dos produtos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select vw.produto||' '||vw.caracteristica ||' '||vw.cor||' '||vw.grade Produto
                     , (select fp.valorvenda 
                        from favorita.precosprodutos fp
                        where vw.idprodutodetalhado = fp.idprodutodetalhado
                          and fp.idedicaorevista= :P225_IDREVISTA
                          and fp.idfilialromance = :P225_IDFILIAL) Preco
                     , nvl( ( select 'Sim' 
                              from favorita.produtosdetedrevistas pe
                              where vw.idprodutodetalhado = pe.idprodutodetalhado
                                and pe.idedicaorevista= :P225_IDREVISTA ),'Não') ProdRevista
                from vw_produtosdetalhados_fav vw
                where vw.ativo = 'Sim'
                  and  exists ( select 1
                                   from vw_listaestoquefavorita w
                                   where w.idprodutodetalhado = vw.idprodutodetalhado
                                     and ididioma           = 1
                                     and idedicaorevista    = :P225_IDREVISTA
                                     and w.idfilialromance  = :P225_IDFILIAL ) 
                  and :P225_IDREVISTA is  not null
                  and :P225_IDFILIAL  is  not null
                /*  and ( not exists ( select idprodutodetalhado 
                                     from favorita.precosprodutos fp
                                     where vw.idprodutodetalhado = fp.idprodutodetalhado
                                       and fp.idedicaorevista= :P225_IDREVISTA
                                       and fp.idfilialromance = :P225_IDFILIAL) 
                     or not exists ( select idprodutodetalhado 
                                     from favorita.produtosdetedrevistas pe
                                     where vw.idprodutodetalhado = pe.idprodutodetalhado
                                       and pe.idedicaorevista= :P225_IDREVISTA) )*/
                group by idprodutodetalhado
                       , vw.produto||' '||vw.caracteristica ||' '||vw.cor||' '||vw.grade
                ```
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 540597948637329203
        }

