            displayColumn PRODUTO (
                sequence: 1
            )

        )

    )

    pageItem P225_IDFILIAL (
        type: selectList
        label {
            label: Cliente
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome showvalue
                     , idfilial     returnvalue
                from roman.vw_filiais c
                where c.tipofilial in ('D','P','C')
                  and c.ativo = 'S'
                
                ```
        }
        layout {
            sequence: 10
            region: @conferência-de-produtos-na-revista
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P225_IDREVISTA (
        type: selectList
        label {
            label: Edição Revista
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ve.nome||' - '||ve.numeroedicao showvalue
                     , ve.idedicaorevista returnvalue 
                from favorita.vw_edicoesrevistas ve
                   , favorita.filiaisedicoesrevistas vf
                where ve.idedicaorevista = VF.IDEDICAOREVISTA
                  and vf.idfilial = :P225_IDFILIAL
                order by numeroedicao
                ```
        }
        cascadingLov {
            parentItems: P225_IDFILIAL
        }
        layout {
            sequence: 20
            region: @conferência-de-produtos-na-revista
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 10
            region: @conferência-de-produtos-na-revista
            slot: bottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-filter
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction submit (
        name: Submit
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

