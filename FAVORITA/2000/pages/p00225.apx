page 225 (
    name: Conferência de Produtos na revista
    title: Conferencia de Produtos na revista
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region conferência-de-produtos-na-revista (
        name: Conferência de Produtos na revista
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region produtos-fora-da-revista (
        name: Produtos Fora da Revista
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select produto
                     , listagg(grade||' '||caracteristica||' '||cor) within group (order by 1) as Detalhado
                from vw_produtosdetalhados_fav vw
                where vw.ativo = 'Sim'
                  and not exists ( select 1
                                   from vw_listaestoquefavorita w
                                   where w.idprodutodetalhado = vw.idprodutodetalhado
                                     and ididioma           = 1
                                     and idedicaorevista    = :P225_IDREVISTA
                                     and w.idfilialromance = :P225_IDFILIAL ) 
                  and :P225_IDREVISTA is not null
                  and :P225_IDFILIAL is not null
                group by produto ;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 540574251987143808
        }

        column DETALHADO (
            type: plainText
            heading {
                heading: Detalhado
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column PRODUTO (
            type: plainText
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 5405829 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DETALHADO (
                sequence: 2
            )

            displayColumn PRODUTO (
                sequence: 1
            )

        )

    )

    region produtos-que-estão-na-revista (
        name: Produtos que estão na Revista
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- produtos que estão revista
                select produto
                     , listagg(grade||' '||caracteristica||' '||cor) within group (order by 1) as Detalhado
                     , w.referencia
                from vw_listaestoquefavorita w
                where ididioma = 1
                  and idedicaorevista = :P225_IDREVISTA
                  and w.idfilialromance = :P225_IDFILIAL
                group by produto, w.referencia  ;
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
