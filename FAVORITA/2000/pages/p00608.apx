page 608 (
    name: Relatorio Campanhas Adimplencia
    title: Relatorio Campanhas Adimplencia
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region report (
        name: Report 1
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select "IDCAMPANHAADIMPLENCIA", 
                "IDFILIAL",
                "DATAINICIO",
                "DATAFIM",
                "DESCONTO",
                "DESCONTOREP"
                from "#OWNER#"."CAMPANHASADIMPLENCIA" 
                  
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 609
                items: {
                    P609_IDCAMPANHAADIMPLENCIA: #IDCAMPANHAADIMPLENCIA#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 1501377403957777884
        }

        column DATAFIM (
            type: plainText
            heading {
                heading: Data Fim
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        column DATAINICIO (
            type: plainText
            heading {
                heading: Data Inicio
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column DESCONTO (
            type: plainText
            heading {
                heading: % Desconto
                alignment: center
            }
            layout {
                sequence: 14
                columnAlignment: center
            }
            appearance {
                formatMask: 90D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column DESCONTOREP (
            type: plainText
            heading {
                heading: % Desconto Repr
                alignment: center
            }
            layout {
                sequence: 24
                columnAlignment: center
            }
            appearance {
                formatMask: 90D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column IDCAMPANHAADIMPLENCIA (
            type: hidden
            heading {
                heading: Idcampanhaadimplencia
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDFILIAL (
            type: plainTextBasedOnLov
            heading {
                heading: Franquia
            }
            lov {
                lov: @lov-filiaisromance
            }
            layout {
                sequence: 2
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 15013797 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAFIM (
                sequence: 4
            )

            displayColumn DATAINICIO (
                sequence: 3
            )

            displayColumn DESCONTO (
                sequence: 5
            )

            displayColumn DESCONTOREP (
                sequence: 6
            )

            displayColumn IDCAMPANHAADIMPLENCIA (
                sequence: 1
            )

            displayColumn IDFILIAL (
                sequence: 2
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Novo Registro
        layout {
            sequence: 30
            region: @report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 609
                clearCache: 609
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

