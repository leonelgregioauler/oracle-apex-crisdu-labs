page 2 (
    name: Relatório de Corredores Estoques
    title: Corredores Estoques
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        browserCache: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region corredores-estoques (
        name: Corredores Estoques
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idcorredorestoque
                     , idfilialfavorita
                     , pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) filialfavorita
                     , ordem
                     , descricao
                     , null prateleiras
                from vw_corredoresestoques_fav
                where idfilialfavorita = :P2_IDFILIALFAVORITA
                ```
            pageItemsToSubmit: P2_IDFILIALFAVORITA
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 13161478733082915
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDCORREDORESTOQUE
                layout {
                    width: 100
                    sequence: 1
                }
            )

            displayColumn (
                column: @ORDEM
                layout {
                    width: 86
                    sequence: 2
                }
            )

            displayColumn (
                column: @DESCRICAO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @PRATELEIRAS
                layout {
                    width: 211
                    sequence: 4
                }
            )

            displayColumn (
                column: @FILIALFAVORITA
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @IDFILIALFAVORITA
                layout {
                    sequence: 6
                }
            )

        )

        column DESCRICAO (
            type: textarea
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 200
            }
            source {
                databaseColumn: DESCRICAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column FILIALFAVORITA (
            type: textarea
            heading {
                heading: Filial Favorita
                alignment: center
            }
            layout {
                sequence: 30
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: FILIALFAVORITA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column IDCORREDORESTOQUE (
            type: link
            heading {
                heading: Editar
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 3
                    items: {
                        P3_IDCORREDORESTOQUE: &IDCORREDORESTOQUE.
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                databaseColumn: IDCORREDORESTOQUE
                dataType: number
            }
        )

        column IDFILIALFAVORITA (
            type: numberField
            heading {
                heading: Idfilialfavorita
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDFILIALFAVORITA
                dataType: number
            }
        )

        column ORDEM (
            type: numberField
            heading {
                heading: Ordem
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ORDEM
                dataType: number
            }
        )

        column PRATELEIRAS (
            type: link
            heading {
                heading: Prateleiras
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            link {
                target: {
                    page: 4
                    items: {
                        P4_IDCORREDORESTOQUE: &IDCORREDORESTOQUE.
                    }
                    action: resetPagination
                }
                linkText: <b>Adicionar Prateleiras</b>
                linkAttributes: class="t-Button t-Button--sucess"
            }
            source {
                databaseColumn: PRATELEIRAS
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

    )

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P2_IDFILIALFAVORITA (
        type: plugin/select
        label {
            label: Filial Favorita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) display_value
                     , idfilialfavorita   return_value
                from filiaisfavorita f
                where  exists ( select 1
                               from usuariosfiliaisfavorita u
                               where u.idfilialfavorita = f.idfilialfavorita
                                 and u.consultar = 'S'
                                 and u.idusuario = :P0_IDUSUARIO )
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    button novo (
        buttonName: Novo
        label: Novo
        layout {
            sequence: 10
            region: @corredores-estoques
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 3
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button novo-2 (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 40
            region: @opções
            slot: top
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 3
                items: {
                    P3_IDCORREDORESTOQUE:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction recarregar (
        name: Recarregar
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P2_IDFILIALFAVORITA
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @corredores-estoques
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

