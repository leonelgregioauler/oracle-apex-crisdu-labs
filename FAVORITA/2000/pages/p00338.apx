    button confirmarselecionados (
        buttonName: CONFIRMARSELECIONADOS
        label: Confirmar Selecionados
        layout {
            sequence: 10
            region: @seleção-de-pedidos-para-impressão
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button imprimir (
        buttonName: IMPRIMIR
        label: Imprimir Selecionados
        layout {
            sequence: 20
            region: @seleção-de-pedidos-para-impressão
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-print
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction atualiza-lista-de-pedidos (
        name: Atualiza lista de pedidos
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P338_SITUACAOPEDIDO
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction imprimir-etiquetas-selecionadas (
        name: Imprimir Etiquetas Selecionadas
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @imprimir
        }
        clientSideCondition {
            type: itemIsInList
            item: P338_PEDIDOETIQUETA
            list: [
                E
                T
            ]
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      vtipoetiqueta    varchar2(10)   := 'T';
                      vquantidade      number         := 1;
                    begin
                      --
                      for i in ( select * 
                                 from prereimpressoespedidos
                                 where idusuario = :P0_IDUSUARIO )
                      loop
                        --
                        delete classificacoespedidos c
                        where c.idpedido = i.idpedido
                        and c.idcaracteristicapedido = 10;
                        --
                        delete etiquetasfavorita e
                        where e.idpedido = i.idpedido;
                        --
                        pck_etiquetas.prc_imprimeetiquetaspedido(pidpedido     => i.idpedido,
                                                                 pididioma     => :P0_IDIDIOMA,
                                                                 pidusuario    => :P0_IDUSUARIO,
                                                                 ptipoetiqueta => vtipoetiqueta,
                                                                 pquantidade   => vquantidade,
                                                                 pdestino      => :P338_DESTINO);
                        --
                      end loop;
                      --
                    end;
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    dynamicAction imprimir-pedidos-selecionados (
        name: Imprimir Pedidos Selecionados
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @imprimir
        }
        clientSideCondition {
            type: itemIsInList
            item: P338_PEDIDOETIQUETA
            list: [
                P
                T
            ]
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: javascript: imprime();
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @pedidos-reimpressos
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

    )

    dynamicAction setapromissoria (
        name: SetaPromissoria
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P338_IDCOMPRATRANSFERENCIA
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select 1
                      from comprastransferencias c
                         , filiaisfavorita       f
                     where c.idcompratransferencia = :P338_IDCOMPRATRANSFERENCIA
                       and c.idfilialfavoritaorigem = f.idfilialfavorita
                       and f.idpais = 4;
                    ```
                itemsToSubmit: P338_IDCOMPRATRANSFERENCIA
            }
            affectedElements {
                selectionType: items
                items: P338_PROMISSORIA
            }
            execution {
                sequence: 10
            }
        )

    )

    process deleta-registros-da-tabela-temporária (
        name: Deleta registros da tabela temporária
        type: executeCode
        source {
            plsqlCode: delete from favorita.prereimpressoespedidos;
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1514323979107933202
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'CONFIRMARSELECIONADOS'
        }
    )

    process insere-os-pedidos-selecionados-na-tabela-temporária (
        name: Insere os pedidos selecionados na tabela temporária
        type: executeCode
        editableRegion: @seleção-de-pedidos-para-impressão
        source {
            plsqlCode:
                ```plsql
                insert into favorita.prereimpressoespedidos
                values ( :IDPEDIDO
                       , :P0_IDUSUARIO
                       , :P338_PROMISSORIA
                       , :P338_BOLETO
                       , trunc(sysdate)
                       , 'E'
                       , :P338_ORDENACAO
                       , v('APP_SESSION') );
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 1507361466925321343
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'CONFIRMARSELECIONADOS'
        }
    )

    branch (
        name: Go To Page 338
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 338
                items: {
                    P338_ORDENACAO: &P338_ORDENACAO.
                }
            }
        }
    )

)

