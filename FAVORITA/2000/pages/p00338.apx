page 338 (
    name: Seleção de Pedidos para Impressão
    title: Seleção de Pedidos para Impressão
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        height: 85%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function imprime()
            {
               var idcomp         = document.getElementById("P338_IDCOMPRATRANSFERENCIA").value;
               var iddistribuidor = document.getElementById("P338_IDDISTRIBUIDOR").value;
               var quantidade     = document.getElementById("P338_QUANTIDADE").value;
               var promissoria    = $v("P338_PROMISSORIA");
               var boleto         = $v("P338_BOLETO");
               var ordenacao      = $v("P338_ORDENACAO");
               var tipo           = document.getElementById("P338_TIPO").value;
               var idusuario      = document.getElementById("P0_IDUSUARIO").value;
                
                pjanela = window.open('f?p=&APP_ID.:128:&SESSION.::NO::P128_IDCOMPRATRANSFERENCIA,P128_IDDISTRIBUIDOR,P128_QUANTIDADE,P128_PROMISSORIA,P128_BOLETO,P128_ORDENACAO,P128_TIPO,P128_IDUSUARIO:'+idcomp+','+iddistribuidor+','+quantidade+','+promissoria+','+boleto+','+ordenacao+','+tipo+','+idusuario,'page','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1280,height=1024,left=20,top=10','_blank');
                pjanela.focus();                          
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region pedidos-reimpressos (
        name: Pedidos Reimpressos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idpedido from prereimpressoespedidos
                where session_id = v('APP_SESSION');
                ```
        }
        layout {
            sequence: 10
            parentRegion: @situações-pedidos
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--accent1
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from prereimpressoespedidos;
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 1507859877466946944
        }

        column IDPEDIDO (
            type: plainText
            heading {
                heading: Pedidos
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            enableUsersTo {
                hide: false
                sort: false
                filter: false
                highlight: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
                pivot: false
            }
        )

        savedReport 15079249 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn IDPEDIDO (
                sequence: 1
            )

        )

    )

    region seleção-de-pedidos-para-impressão (
        name: Seleção de Pedidos para Impressão
        type: tabform
        source {
            sqlQuery:
                ```sql
                select p.idpedido
                     , pck_util_fav.fnc_nomevendedora (p.idvendedora) nomevendedora
                from pedidos p                                          
                   , pedidosremessasct pr                               
                where pr.idpedido              = p.idpedido
                  and pr.idcompratransferencia = :P338_IDCOMPRATRANSFERENCIA
                  and ( (:P338_SITUACAOPEDIDO = 'N' and p.idsituacaoentrega < 32000 )
                     or (:P338_SITUACAOPEDIDO = 'T') ) 
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
                t-Form--stretchInputs
            ]
        }
        reportLayout {
            numberOfRows: 650
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            type: showAll
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Não encontrou informações
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 3
            derivedColumn: Y
            type: rowSelector
            heading {
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
        )

        column IDPEDIDO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: plainTextSavesState
            heading {
                heading: Pedido
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
        )

        column NOMEVENDEDORA (
            reportColumnQueryId: 2
            derivedColumn: N
            type: plainTextSavesState
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 3
            }
        )

    )

