page 611 (
    name: Comp/Transf da Ordem de Compra
    title: Comp/Transf da Ordem de Compra
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region report (
        name: Report 1
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idordemcompra "Ordem Compra"
                     , c.idcompratransferencia
                     , pck_util_fav.fnc_nomefornecedor(c.idfornecedor) Fornecedor
                     , pck_util_fav.fnc_nomefilialfavorita(c.idfilialfavoritadestino) Destino
                     , ( select descricao 
                           from situacoescomprastransferencias 
                          where idsituacaocompratransf = c.idsituacao) Situacao
                     , c.dataprevisaoentrega
                  from comprastransferencias c
                 where c.idordemcompra = :P611_IDORDEMCOMPRA
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: no data found
        }
        download {
            csvExportEnabled: true
        }

        column DATAPREVISAOENTREGA (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Previsão Entrega
            }
            layout {
                sequence: 6
            }
            appearance {
                formatMask: dd/mm/rrrr hh24:mi:ss
            }
        )

        column DESTINO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Destino
            }
            layout {
                sequence: 4
            }
        )

        column FORNECEDOR (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Fornecedor
            }
            layout {
                sequence: 3
            }
        )

        column IDCOMPRATRANSFERENCIA (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: ID CT
            }
            layout {
                sequence: 2
            }
            sorting {
                defaultSequence: 1
            }
        )

        column "Ordem Compra" (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Ordem Compra
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column SITUACAO (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Situacao
            }
            layout {
                sequence: 5
            }
        )

    )

    pageItem P611_IDORDEMCOMPRA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @report
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

