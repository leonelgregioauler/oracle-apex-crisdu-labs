    region relatório-apontamento-de-divergências-de-transferência (
        name: Relatório Apontamento de Divergências de Transferência
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select fo.nomefilialfavorita origem
                     , fd.nomefilialfavorita destino
                     , d.iddivergenciacomprastransferencias
                     , d.idcompratransferencia          
                     , d.iditemcompratransferencia
                     , i.idprodutodetalhado
                     , favorita.pck_util_fav.fnc_nomeprodutodetalhado(i.idprodutodetalhado,nvl(:P0_IDIDIOMA,1)) produto
                     , i.quantidadecomprada
                     , i.quantidaderecebida
                     , (i.quantidadecomprada - i.quantidaderecebida) Divergência
                     , case
                           when d.situacaodivergencia = 'E' then 
                               apex_item.CHECKBOX2(1,d.iddivergenciacomprastransferencias, null)
                           else 
                               null
                       end Aceitar
                     , case
                           when d.situacaodivergencia = 'E' then 
                               apex_item.CHECKBOX2(2,d.iddivergenciacomprastransferencias, null)
                           else 
                               null
                       end Recusar
                     , decode(d.situacaodivergencia, 'A','Aceita','R','Recusada','Em Análise') as "Divergência Aceita?"
                     , usuarioaceite usuarioaceite
                     , c.dataemissao as "Data Inclusão"
                     , c.numero as "Número Transferência"
                     , d.dataaceite
                     , (select lo.dataalteracao
                       from logfavorita.log_divergenciascomprastransferencias lo
                       where lo.iddivergenciacomprastransferencias = d.iddivergenciacomprastransferencias
                         and lo.tipoalteracao = 'INSERT') data_divergencia_enviada
                  from favorita.divergenciascomprastransferencias d
                     , favorita.itenscomprastransferencias        i
                     , favorita.comprastransferencias             c
                     , favorita.filiaisfavorita                   fd
                     , favorita.filiaisfavorita                   fo
                 where i.iditemcompratransferencia = d.iditemcompratransferencia
                   and c.idcompratransferencia = i.idcompratransferencia
                   and fd.idfilialfavorita = c.idfilialfavoritadestino
                   and fo.idfilialfavorita = c.idfilialfavoritaorigem
                   /*Adiciona opção em tela para listar ou não recebidos 40
                    Trazer somente transferência que ainda não foram recebidas*/
                   and (:P650_LISTARRECEBIDOS = 'S' OR (:P650_LISTARRECEBIDOS = 'N' AND c.idsituacao < 40))
                   /* Filtra por período*/
                   and c.dataemissao >= to_date(:P650_DATA_INICIAL, 'DD/MM/YYYY')
                   and c.dataemissao <  to_date(:P650_DATA_FINAL, 'DD/MM/YYYY') + 1
                   /* Filtra for filial favorita destino*/
                   and (    ( :P650_IDFILIALFAVORITAORIGEM = -1) 
                         or ( c.idfilialfavoritaorigem = :P650_IDFILIALFAVORITAORIGEM))
                   /* Filtrar por Transferência ou todas*/
                   and (    ( :P650_TRANSFERENCIA is null)
                         or ( d.idcompratransferencia = :P650_TRANSFERENCIA))
                   -- Traz somente divergencia que tenham ao menos uma divirgencia com aceite = NÃO!
                   /*and exists (select 1
                                 from favorita.divergenciascomprastransferencias div
                                where d.idcompratransferencia = div.idcompratransferencia
                                  and div.situacaodivergencia = 'E')*/
                   and (:P650_SITUACAO = -1 
                    or (:P650_SITUACAO = 1 and d.situacaodivergencia = 'E') -- Em Analise
                    or (:P650_SITUACAO = 2 and d.situacaodivergencia in ('A','R')) ) -- Aceita / Recusar
                   -- Ordena pelo ID da Divergência               
                 order by d.iddivergenciacomprastransferencias;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
