    process aceitar-recusar-divergência (
        name: Aceitar Recusar Divergência
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    -- Escopo para declaração de variáveis
                    v_chk_aceitar_marcado          varchar2(1);
                    v_id_compra_transferencia      number;
                    v_id_item_compra_transferencia number;
                    v_id_produto_detalhado         number;
                    v_qtd_recebida                 number;
                    v_qtd_comprada                 number;
                
                begin
                
                    -- Loop na coluna (ACEITAR) verificando todos que estiverem marcado
                    for i in 1 .. APEX_APPLICATION.G_F01.COUNT loop
                        
                        -- Efetiva os produtos marcados como aceitar divergencia
                        update favorita.divergenciascomprastransferencias d
                           set d.usuarioaceite       = v('APP_USER')
                             , d.situacaodivergencia = 'A'
                             , d.dataaceite          = sysdate
                         where d.iddivergenciacomprastransferencias = APEX_APPLICATION.G_F01(i);
                
                        -- Busca dados para gravar a Classificação 
                        select d.idcompratransferencia
                             , d.iditemcompratransferencia
                             , i.idprodutodetalhado
                             , i.quantidaderecebida
                             , i.quantidadecomprada
                          into v_id_compra_transferencia
                             , v_id_item_compra_transferencia
                             , v_id_produto_detalhado
                             , v_qtd_recebida
                             , v_qtd_comprada
                          from favorita.divergenciascomprastransferencias d
                             , favorita.itenscomprastransferencias i
                         where i.iditemcompratransferencia = d.iditemcompratransferencia
                           and d.iddivergenciacomprastransferencias = APEX_APPLICATION.G_F01(i);
                
                        -- Grava a Classificação para a classificação da divergência
                        insert into favorita.classificacoescomprastransf ( idclassificacaocompratransf,
                                                                           idcompratransferencia,
                                                                           dataclassificado,
                                                                           idusuario,
                                                                           idcaracteristicacomptransf,
                                                                           idvalorcaracteristica,
                                                                           observacao)
                                                                  values ( favorita.seq_idclassificacaocomptransf.nextval,
                                                                           v_id_compra_transferencia,
                                                                           sysdate,
                                                                           favorita.pck_util_fav.fnc_idusuario(v('APP_USER')),
                                                                           29,
                                                                           v_id_item_compra_transferencia,
                                                                           'Ocorreu uma divergência entre qtd. envida e recebida! Estoque enviou qtd ('|| v_qtd_recebida ||
                                                                           ') loja deveria ter recebido ('|| v_qtd_comprada ||
                                                                           ').  <'|| favorita.pck_util_fav.fnc_nomeprodutodetalhadosref(v_id_produto_detalhado, nvl(:P0_IDIDIOMA,1)) || '>.');
                    end loop;
                
                    -- Loop na coluna (RECUSAR) verificando todos que estiverem marcado
                    for i in 1 .. APEX_APPLICATION.G_F02.COUNT loop
                        
                        -- verifica se a coluna (ACEITAR) tabém está marcada
                        begin
                            select 'S'
                              into v_chk_aceitar_marcado
                              from favorita.divergenciascomprastransferencias d
                             where d.iddivergenciacomprastransferencias = APEX_APPLICATION.G_F02(i)
                               and d.situacaodivergencia = 'A';
                        exception
                            when others then
                                v_chk_aceitar_marcado := 'N';
                        end;
                
                        -- Bloqueia produtos com (Aceitar) e (Recusar) marcados, deve ser selecionado um ou outro.
                        if v_chk_aceitar_marcado = 'S' then
                            apex_error.add_error( p_message => 'Atenção! Não é permitido marcar Aceitar e Recusar para o mesmo produto!'
                    		                    , p_display_location => apex_error.c_inline_in_notification);
                            rollback;
                            return;
                        end if;
                
                        -- Efetiva os produtos marcados como recusar divergencia
                        update favorita.divergenciascomprastransferencias d
                           set d.usuarioaceite       = v('APP_USER')
                             , d.situacaodivergencia = 'R'
                             , d.dataaceite          = sysdate
                         where d.iddivergenciacomprastransferencias = APEX_APPLICATION.G_F02(i);
                
                    end loop;
                
                    -- Efetiva as alterações no banco de dados
                    commit;
                
                    -- Tratamento de erro da rotina
                exception
                    when others then
                        apex_error.add_error( p_message => 'Ops! Ocorreu um erro na rotina (Aceitar Recusar Divergência). Entre em contato com o suporte.' || SQLERRM
                		                    , p_display_location => apex_error.c_inline_in_notification);
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 372453729943190601
        }
        serverSideCondition {
            whenButtonPressed: @salvar
        }
    )

    process inicializa-data-inicial-e-final (
        name: Inicializa data inicial e final
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    
                    /* Carrega data inicial*/
                    if :P650_DATA_INICIAL is null then
                        :P650_DATA_INICIAL := to_char(sysdate-30, 'DD/MM/YYYY');
                    end if;
                
                    /* Carrega data final*/
                    if :P650_DATA_FINAL is null then
                        :P650_DATA_FINAL := to_char(sysdate, 'DD/MM/YYYY');
                    end if;
                
                    -- Limpa o id Divergência
                    :P650_IDDIVERGENCIACOMPRASTRANSFERENCIAS := null;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 371784102265840930
        }
    )

    process po-atualizar-status-transferencia (
        name: PO_ATUALIZAR_STATUS_TRANSFERENCIA
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_idtipocomptransrem        number;
                    l_iditemcompratransferencia number;
                    l_sucesso                   varchar2(1);
                    l_idsituacao                number;
                    l_idguiaconqlevou           number;
                begin
                
                    for i in 1 .. APEX_APPLICATION.G_F01.COUNT loop
                
                        for l_aceite in ( select *
                                          from divergenciascomprastransferencias d
                                          where d.iddivergenciacomprastransferencias = APEX_APPLICATION.G_F01(i)
                                          and not exists ( select 1
                                                           from divergenciascomprastransferencias dc
                                                           where dc.idcompratransferencia = d.idcompratransferencia 
                                                           and situacaodivergencia in ('E', 'R') ) )
                        loop
                
                            select idtipocomptransrem
                            into l_idtipocomptransrem
                            from comprastransferencias
                            where idcompratransferencia = l_aceite.idcompratransferencia;
                            --
                            if l_idtipocomptransrem = 1 then
                                --
                               /* update itenscomprastransferencias
                                set quantidadecomprada = quantidaderecebida
                                where iditemcompratransferencia = l_aceite.iditemcompratransferencia; T11878223 */ 
                                --
                                pck_comprastransf_fav.prc_confirmarecebimento( pidcompratransferencia => l_aceite.idcompratransferencia
                                                                             , pidusuario             => :P0_IDUSUARIO
                                                                             , psucesso               => l_sucesso );
                                --
                            elsif l_idtipocomptransrem = 12 then
                                --
                                -- CLEBER - 30/10/2026 - Conquistou Levou (12 = Transferencia Brinde): com todas as divergencias
                                -- aceitas, confirma o recebimento e atualiza a guia de brindes, como a pagina 87 faz no Confirmar.
                                -- Uma vez por remessa: se ja esta recebida (40), nao repete.
                                select idsituacao
                                into l_idsituacao
                                from comprastransferencias
                                where idcompratransferencia = l_aceite.idcompratransferencia;
                                --
                                if l_idsituacao <> 40 then
                                    --
                                    pck_comprastransf_fav.prc_confirmarecebimento( pidcompratransferencia => l_aceite.idcompratransferencia
                                                                                 , pidusuario             => :P0_IDUSUARIO
                                                                                 , psucesso               => l_sucesso );
                                    --
                                    begin
                                        select geb.idguiaentregabrinde
                                        into l_idguiaconqlevou
                                        from roman.guiasentregasbrindes geb
                                        where geb.idremessafavorita = l_aceite.idcompratransferencia;
                                        --
                                        roman.pck_conquistoulevou.pr_receber_automatico(p_idguiaentregabrinde => l_idguiaconqlevou);
                                    exception
                                        when no_data_found then
                                            null; -- remessa nao vinculada a guia de brindes Conquistou Levou
                                        when others then
                                            apex_error.add_error( p_message => 'Divergencia aceita, mas houve erro ao atualizar a guia de brindes do Conquistou Levou. Contate o suporte. ' || SQLERRM
                                                                , p_display_location => apex_error.c_inline_in_notification );
                                    end;
                                    --
                                end if;
                                --
                            end if;
                            --
                        end loop;
                        --
                    end loop;
                    --
                end;
                ```
        }
        execution {
            sequence: 30
        }
