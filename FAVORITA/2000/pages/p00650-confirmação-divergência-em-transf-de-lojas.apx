    pageItem P650_IDFILIALFAVORITAORIGEM (
        type: selectList
        label {
            label: <b>Filial Origem (Estoque)</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ff.nomefilialfavorita as display_value
                     , ff.idfilialfavorita   as return_value
                  from favorita.filiaisfavorita ff
                 where tipofilial = 'E'
                   and (    ( exists (select 1
                                        from roman.usuariosgruposatendimento u
                                       where u.usuario            = v('APP_USER')
                                         and u.idgrupoatendimento = 0))
                         or ( ff.idfilialfavorita = (select u.idfilialfavorita
                                                       from catal.usuarios u
                                                      where u.usuario = v('APP_USER')))
                         or ( roman.pck_util.fnc_verificaacesso(pidaplicacao => 34002, pusuario => v('APP_USER')) = 'S'))
                
                union
                
                select '- Todas -' as display_value
                     , -1          as return_value
                  from dual
                 where exists (select 1
                                 from roman.usuariosgruposatendimento u
                                where u.usuario            = v('APP_USER')
                                  and u.idgrupoatendimento = 0)
                    or roman.pck_util.fnc_verificaacesso(pidaplicacao => 34002, pusuario => v('APP_USER')) = 'S'
                  
                 order by 1;
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
    )

