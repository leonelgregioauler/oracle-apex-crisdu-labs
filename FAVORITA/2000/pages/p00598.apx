    dynamicAction buscasr (
        name: BuscaSR
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P598_IDSUBREMESSA
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    
                    --raise_application_error(-20001,'xxxx'||:P598_IDSUBREMESSA);
                    
                    SELECT IDREMESSA,
                           DESCRICAO,
                           IDFILIALFAVORITA,
                           TIPOSUBREMESSA
                      INTO :P598_IDREMESSA,
                           :P598_NOMESR,
                           :P598_IDFILIALFAVORITA,
                           :P598_TIPOSR
                      FROM subremessas
                     WHERE idsubremessa = :P598_IDSUBREMESSA;
                    
                     exception
                       when no_data_found then 
                        :P598_IDREMESSA        := null ;
                        :P598_NOMESR           := null ;
                        :P598_IDFILIALFAVORITA := 2 ;
                        :P598_TIPOSR           := 'I' ;
                        
                    end;
                    ```
                itemsToSubmit: P598_IDSUBREMESSA
                itemsToReturn: [
                    P598_IDREMESSA
                    P598_NOMESR
                    P598_IDFILIALFAVORITA
                    P598_TIPOSR
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction marcaimprimir (
        name: MarcaImprimir
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P598_IDPEDIDO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                      --
                      -- busca o id atraves do pedido para então atualizar a collection
                      for c1 in ( 
                        select seq_id, 
                               C001 ,
                               C002 ,
                               C003 , 
                               C004 ,
                               C005 ,
                               C006 ,
                               C008 ,
                               C009 ,
                               C010 
                          from apex_collections c
                         where c.collection_name = 'COL_PAG598_2000_'||v('APP_USER') 
                           and C001 = substr(:P598_IDPEDIDO,9,7) )
                      loop
                        
                        APEX_COLLECTION.UPDATE_MEMBER (
                            p_collection_name => 'COL_PAG598_2000_'||v('APP_USER'),
                            p_seq  => c1.seq_id,
                            p_C001 => c1.C001,
                            p_C002 => c1.C002,
                            p_C003 => c1.C003,
                            p_C004 => c1.C004,
                            p_C005 => c1.C005,
                            p_C006 => c1.C006,
                            p_c007 => 'S',
                            p_C008 => c1.C008,
                            p_C009 => c1.C009,
                            p_C010 => c1.C010    );
                            
                      end loop;
                    end;
                    
                    ```
                itemsToSubmit: P598_IDPEDIDO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                     apex.region("LISTAPEDIDOS").refresh();
                     document.getElementById("P598_IDPEDIDO").value = '';
                     document.getElementById("P598_IDPEDIDO").focus();
                    ```
            }
            execution {
                sequence: 40
            }
        )

    )

