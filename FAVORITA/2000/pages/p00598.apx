    region lista-de-pedidos (
        name: Lista de Pedidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select seq_id, 
                       C001 IDPEDIDO,
                       C002 "Vendedora",
                       C003 "Distribuidor", 
                       C004 "Dt Emissão",
                       C005 "Sit Entrega",
                       C006 "Sit Financeiro",
                       case 
                         when C007 = 'S' then
                           APEX_ITEM.CHECKBOX2(1, C001 , 'CHECKED' )
                         else
                           APEX_ITEM.CHECKBOX2(1, C001 , NULL )
                       end "Imprimir",
                       C008 idsubremessa,
                       C009 "Sub-Remessa",
                     --  C010 "Entregue"
                       C010 "Filial"
                  from apex_collections c
                 where c.collection_name = 'COL_PAG598_2000_'||v('APP_USER')
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: LISTAPEDIDOS
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
