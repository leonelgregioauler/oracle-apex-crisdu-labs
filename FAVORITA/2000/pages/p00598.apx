            action: submitPage
            settings {
                requestButtonName: RECEBERPEDIDO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    process populacollection (
        name: PopulaCollection
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                 l_query varchar2(32000);
                    
                    
                BEGIN
                
                  l_query := 'select p.idpedido,
                       pck_util_fav.fnc_nomevendedora(p.idvendedora) Vendedora,
                       pck_util_fav.fnc_nomerepresentante(p.idrepresentante) Distribuidor,
                       to_char(p.dataemissao,''dd/mm/rrrr hh24:mi:ss'') dataemissao, --"Dt Emissão",
                       se.descricaosistema sitentrega, --as "Sit Entrega",
                       sf.descricaosistema sitfinanceiro, --as "Sit Financeiro",
                       --
                       APEX_ITEM.CHECKBOX2(1, p.idpedido , NULL )  imprimir, --as "Imprimir",
                       --
                       p.idsubremessa,
                       --
                       case
                         when p.idsubremessa is not null then
                           sr.descricao
                       end as subremessa, --"Sub-Remessa"
                       --
                       pck_util_fav.fnc_nomefilialfavorita(p.idfilialfavorita) Filial --as "Filial"
                from pedidos p,
                     subremessas sr,
                     situacoesentrega se,
                     situacoesfinanceiro sf
                where p.idsituacaoentrega = se.idsituacaoentrega
                and p.idsituacaofinanceiro = sf.idsituacaofinanceiro
                and p.idsubremessa = sr.idsubremessa
                and p.datacancelamento is null
                and p.idsituacaoentrega in (60000) -- 31000=Pedido impresso
                and exists (select 1
                           from classificacoespedidos c
                           where c.idcaracteristicapedido = 13
                           and c.idvalorcaracteristica in (6,7)
                           and c.idpedido = p.idpedido) 
                and not exists (select 1
                                 from classificacoespedidos
                                where idcaracteristicapedido = 102
                                  and idvalorcaracteristica = 1
                                  and idpedido = p.idpedido) ' ; 
                
                
                  if apex_collection.collection_exists('COL_PAG598_2000_'||v('APP_USER') ) then
                    APEX_COLLECTION.DELETE_COLLECTION ( p_collection_name => 'COL_PAG598_2000_'||v('APP_USER'));
                  end if;
                
                  APEX_COLLECTION.CREATE_COLLECTION_FROM_QUERY (
                        p_collection_name => 'COL_PAG598_2000_'||v('APP_USER'), 
                        p_query => l_query,
                        p_generate_md5 => 'NO');
                
                END;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 3614391235251876091
        }
    )

    process receberpedidos (
        name: ReceberPedidos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vid_pedido  number;
                  vid_subremessa number;
                  v_existe number;
                  v_char varchar2(1000);
                  v_data timestamp;
                  v_idusuario number := :P0_IDUSUARIO;
                  v_idcaract  number := 102;
                  v_idvalor   number := 1;
                  v_obs       varchar2(100) := 'Pedido recebido pela loja' ;
                  v_md5       varchar2(2000);
                  vidclassificacaopedido number;
                  --
                begin
                  --
                  if not apex_collection.collection_exists('COL_RECEBEPED_'||v('APP_USER')) then 
                    apex_collection.create_collection('COL_RECEBEPED_'||v('APP_USER'));
                  else
                    apex_collection.truncate_collection('COL_RECEBEPED_'||v('APP_USER'));
                  end if;
                  --
                  if v_idusuario is null then
                    select idusuario 
                      into v_idusuario
                      from usuarios
                     where usuario = v('APP_USER');
                  end if;
                  --
                  if APEX_APPLICATION.G_F01.COUNT > 0 then
                    --
                    FOR I in 1..APEX_APPLICATION.G_F01.COUNT 
                    LOOP
                      --
                      vid_pedido := to_number(APEX_APPLICATION.G_F01(i));
                      apex_collection.add_member(
                                      p_collection_name => 'COL_RECEBEPED_'||v('APP_USER'),
                                      p_c001 => vid_pedido );
                      
                      begin
                        select idsubremessa
                          into vid_subremessa
                          from pedidos
                         where idpedido = vid_pedido;
                      exception
                        when others then null;
                      end;
                      --
                      v_data := sysdate;
                
                      pck_pedidos_fav.prc_classificacoespedidos( pidclassificacaopedido  => vidclassificacaopedido
                                                               , pidpedido               => vid_pedido
                                                               , pdataclassificado       => v_data
                                                               , pidusuario              => v_idusuario
                                                               , pidcaracteristicapedido => v_idcaract
                                                               , pidvalorcaracteristica  => v_idvalor
                                                               , pobservacao             => v_obs
                                                               , pmd5                    => v_md5
                                                               , poperacao_dml           => 'I' );
                      --
                      -- valida se todos os pedidos da subremessa foram entregues, então pode fechar a subremessa
                /*      begin
                        select count(*) into v_existe
                          from pedidos p
                         where p.idsubremessa = vid_subremessa
                           and not exists (select 1
                                            from classificacoespedidos c
                                           where c.idpedido = p.idpedido
                                             and c.idcaracteristicapedido = 102
                                             and c.idvalorcaracteristica = 1);
                         if nvl(v_existe,0) > 0 then -- caract. 102 representa pedido recebido pelo distribuidor.
                                                    -- enquanto o select acima retornar registros, sinal que ainda não foram todos recebidos.
                           null;
                         else
                           --
                           v_data := sysdate;
                           UPDATE subremessas
                              SET datafechamento      = v_data
                                , idusuariofechamento = v_idusuario
                            WHERE idsubremessa        = vid_subremessa;
                           --
                         end if;
                      end;*/
                      
                    END LOOP;
                  else
                    raise_application_error(-20001,'Selecione ao menos um pedido para conferir!');
                  end if;  
                
                commit;
                
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 3614391636403876091
        }
        serverSideCondition {
            type: request=Value
            value: RECEBERPEDIDO
        }
    )

    branch (
        name: ChamaPagImprime
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 595
                clearCache: 595
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: IMPRIMIR
        }
    )

)

