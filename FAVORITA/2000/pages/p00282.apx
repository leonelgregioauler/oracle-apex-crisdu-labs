page 282 (
    name: Anexos Despesas
    title: Anexos Despesas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 70%
        height: 70%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function fnc_verimg(pid)
            {
              window.open('http://anexos.romancemoda.com.br/'+pid);
              void(0);
            }
            
            function fnc_removeanexo(pidanexo,pnomeanexo)
            {
                apex.confirm("Deseja realmente remover o anexo "+pnomeanexo+"?", {
              request:"DELETAR",
              set:{"P282_IDANEXODELETAR":pidanexo}
              });
            }
            ```
    }

    region anexos-despesas (
        name: Anexos Despesas
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    region arquivos-anexados (
        name: Arquivos Anexados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomearquivo
                  --   , '<a href="javascript: fnc_verimg('''||iddespesa||idanexodespesa||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10)||''');">Ver arquivo</a>' link
                    -- , iddespesa||idanexodespesa||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10) id
                     , url_bucket link
                     , dataanexo
                     , ( select roman.pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario ) usuario 
                     , '<a href="javascript: fnc_removeanexo('||idanexodespesa||','''||t.nomearquivo||''');">Remover</a>' remover
                     , APEX_ITEM.CHECKBOX2(1, t.idanexodespesa , NULL ) visto
                from roman.anexosdespesas t
                where iddespesa = :P282_IDDESPESA
                order by t.dataanexo
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 779198971172526821
        }

        column DATAANEXO (
            type: plainText
            heading {
                heading: Data Anexo
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column LINK (
            type: link
            heading {
                heading: Link
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            link {
                target: {
                    type: url
                    url: #LINK#
                }
                linkText: Ver Arquivo
                linkAttributes: target="_blank"
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column NOMEARQUIVO (
            type: plainText
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column REMOVER (
            type: plainText
            heading {
                heading: Remover
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
            security {
                escapeSpecialChars: false
            }
        )

        column USUARIO (
            type: plainText
            heading {
                heading: Usuário
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column VISTO (
            type: plainText
            heading {
                heading: Visto
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
            security {
                escapeSpecialChars: false
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 7795255 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAANEXO (
                sequence: 2
            )

            displayColumn LINK (
                sequence: 6
            )

            displayColumn NOMEARQUIVO (
                sequence: 1
            )

            displayColumn REMOVER (
                sequence: 5
            )

            displayColumn USUARIO (
                sequence: 4
            )

            displayColumn VISTO (
                sequence: 3
            )

        )

    )

    pageItem P282_ARQUIVOTEMP (
        type: fileUpload
        label {
            label: Arquivo
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
            displayDownloadLink: false
        }
        storage {
            filenameColumn: NOMEARQUIVO
        }
        layout {
            sequence: 40
            region: @anexos-despesas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: ARQUIVOTEMP
            used: always
        }
    )

    pageItem P282_DATAANEXO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @anexos-despesas
            slot: regionBody
        }
        appearance {
            formatMask: DD/MM/RRRR HH24:MI:SS
        }
        source {
            type: databaseColumn
            databaseColumn: DATAANEXO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  return sysdate;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P282_IDANEXODELETAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @anexos-despesas
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P282_IDANEXODESPESA (
        type: hidden
        layout {
            sequence: 10
            region: @anexos-despesas
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDANEXODESPESA
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P282_IDDESPESA (
        type: numberField
        label {
            label: ID Despesa
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 20
            region: @anexos-despesas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: IDDESPESA
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P282_IDUSUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @anexos-despesas
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDUSUARIO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidusuario number;
                begin
                  --
                  vidusuario := :P0_IDUSUARIO;
                  --
                  return vidusuario;
                  --
                end;
                  
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P282_NOMEARQUIVO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @anexos-despesas
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: NOMEARQUIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P282_PAGINA (
        type: hidden
        layout {
            sequence: 110
            region: @anexos-despesas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Anexar este arquivo!
        layout {
            sequence: 100
            region: @anexos-despesas
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P282_IDANEXODESPESA
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: "Voltar                    "
        layout {
            sequence: 50
            region: @anexos-despesas
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                t-Button--warning
                t-Button--iconRight
            ]
            icon: fa-filter
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 278
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item!=value
            item: P282_PAGINA
            value: 438
        }
    )

    validation p282-arquivotemp (
        name: P282_ARQUIVOTEMP
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P282_ARQUIVOTEMP
        }
        error {
            errorMessage: Escolha um arquivo!
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('CREATE','UPDATE')
        }
    )

    validation valida-fechamento (
        name: valida fechamento
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.fechamentossemanais f
                where f.idfechamento = :P0_IDFECHAMENTO
                  and f.concluido = 'S'
                ```
        }
        error {
            errorMessage: Não é possivel anexar/remover com a semana de fechamento encerrada!
        }
    )

    process anexar (
        name: Anexar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  commit;
                  -- Call the procedure
                  roman.pck_anexos.blob_to_file_despesas(piddespesa => :P282_IDDESPESA
                                                        ,pidanexo => :P282_IDANEXODESPESA);
                  commit;
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 779198586036526817
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process deletar (
        name: Deletar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  :P282_IDANEXODESPESA := null;
                  roman.pck_anexos.prc_apagaanexo(pidanexodespesa => :P282_IDANEXODELETAR);
                end;
                
                ```
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Anexo deletado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 779198660591526818
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    process fetch-row-from-anexosdespesas (
        name: Fetch Row from ANEXOSDESPESAS
        type: autoRowFetch
        source {
            tableOwner: ROMAN
            tableName: ANEXOSDESPESAS
            pkColumn: IDANEXODESPESA
            pkItem: P282_IDANEXODESPESA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 779513394193587174
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P282_IDANEXODESPESA is null then
                        select "ROMAN"."SEQ_IDANEXODESPESA".nextval
                          into :P282_IDANEXODESPESA
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 779513750787587174
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-anexosdespesas (
        name: Process Row of ANEXOSDESPESAS
        type: autoRowProcessing
        target {
            tableOwner: ROMAN
            tableName: ANEXOSDESPESAS
            pkColumn: IDANEXODESPESA
            pkItem: P282_IDANEXODESPESA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Arquivo Anexado
        }
        advanced {
            executionMappingIdentifier: 779514144820587175
        }
    )

    branch (
        name: Go To Page 282
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 282
                items: {
                    P282_IDANEXODESPESA:
                    P282_IDDESPESA: &P282_IDDESPESA.
                }
                action: resetPagination
            }
        }
    )

)

