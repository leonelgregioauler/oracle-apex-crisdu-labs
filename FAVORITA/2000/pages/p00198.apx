            sequence: 20
        }
        validation {
            editableRegion: @alíquotas-ncm-estado
            type: columnIsNotNull
            column: IDCLASSIFICACAOFISCAL
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ter um valor.
            associatedColumn: IDCLASSIFICACAOFISCAL
        }
    )

    validation idestado-obrigatório (
        name: IDESTADO obrigatório
        execution {
            sequence: 50
        }
        validation {
            editableRegion: @alíquotas-ncm-estado
            type: columnIsNotNull
            column: IDESTADO
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ter um valor.
            associatedColumn: IDESTADO
        }
    )

    process alíquotas-ncm-estado-save-interactive-grid-data (
        name: Alíquotas / NCM / Estado - Save Interactive Grid Data
