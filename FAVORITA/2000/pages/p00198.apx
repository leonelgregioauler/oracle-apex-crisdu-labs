page 198 (
    name: Classificações Fiscais - NCM
    title: Classificações Fiscais - NCM
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region alíquotas-ncm-estado (
        name: Alíquotas / NCM / Estado
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idaliquotancmestado
                     , idclassificacaofiscal
                     , idestado
                     , aliquota
                from aliquotasncmestados
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 241325279512791650
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDALIQUOTANCMESTADO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDCLASSIFICACAOFISCAL
                layout {
                    width: 400
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDESTADO
                layout {
                    width: 150
                    sequence: 4
                }
            )

            displayColumn (
                column: @ALIQUOTA
                layout {
                    width: 200
                    sequence: 3
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 0
                }
            )

            controlBreak (
                column: @IDESTADO
                sort {
                    nulls: last
                }
                layout {
                    sequence: 5
                }
            )

        )

        column ALIQUOTA (
            type: numberField
            heading {
                heading: Aliquota (%)
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: 99D99
            }
            source {
                databaseColumn: ALIQUOTA
                dataType: number
            }
            columnFilter {
                lovType: none
            }
            advanced {
                customAttributes: onkeyup="formataMoeda(this);"
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column IDALIQUOTANCMESTADO (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IDALIQUOTANCMESTADO
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: SEQ_IDALIQUOTANCMESTADO
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDCLASSIFICACAOFISCAL (
            type: selectList
            heading {
                heading: Classificação Fiscal - NCM
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @lov-ncm
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: IDCLASSIFICACAOFISCAL
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDESTADO (
            type: selectList
            heading {
                heading: Estado
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @lov-estados
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: IDESTADO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

    )

    region classificações-fiscais-ncm (
        name: Classificações Fiscais - NCM
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idclassificacaofiscal
                     , classificacaofiscal
                     , descricao
                  from classificacoesfiscais
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 252964459158014244
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 0
                }
            )

            displayColumn (
                column: @DESCRICAO
                layout {
                    width: 500
                    sequence: 3
                }
            )

            displayColumn (
                column: @CLASSIFICACAOFISCAL
                layout {
                    width: 300
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDCLASSIFICACAOFISCAL
                layout {
                    show: false
                    sequence: 1
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column CLASSIFICACAOFISCAL (
            type: numberField
            heading {
                heading: Classificação Fiscal - NCM
                alignment: center
            }
            settings {
                virtualKeyboard: text
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: CLASSIFICACAOFISCAL
                dataType: number
            }
        )

        column DESCRICAO (
            type: textarea
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
                maxLength: 500
            }
            source {
                databaseColumn: DESCRICAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                exactMatch: false
            }
            enableUsersTo {
                sort: false
            }
        )

        column IDCLASSIFICACAOFISCAL (
            type: numberField
            heading {
                heading: Idclassificacaofiscal
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                databaseColumn: IDCLASSIFICACAOFISCAL
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: SEQ_IDCLASSIFICACAOFISCAL
            }
            columnFilter {
                lovType: none
            }
        )

    )

    region opções (
        name: Opções
        type: regionDisplaySelector
        layout {
            sequence: 30
            slot: breadcrumbBar
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            excludeTitleFromTranslation: true
        }
        settings {
            includeShowAll: false
            rememberSelection: bySession
        }
    )

    validation aliquota-obrigatório (
        name: ALIQUOTA obrigatório
        execution {
            sequence: 40
        }
        validation {
            editableRegion: @alíquotas-ncm-estado
            type: columnIsNotNull
            column: ALIQUOTA
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ter um valor.
            associatedColumn: ALIQUOTA
        }
    )

    validation classificacaofiscal-obrigatório (
        name: CLASSIFICACAOFISCAL obrigatório
        execution {
            sequence: 80
        }
        validation {
            editableRegion: @classificações-fiscais-ncm
            type: columnIsNotNull
            column: CLASSIFICACAOFISCAL
        }
        error {
            errorMessage: #COLUMN_HEADER# must have a value.
            associatedColumn: CLASSIFICACAOFISCAL
        }
    )

    validation descricao-obrigatório (
        name: DESCRICAO obrigatório
        execution {
            sequence: 70
        }
        validation {
            editableRegion: @classificações-fiscais-ncm
            type: columnIsNotNull
