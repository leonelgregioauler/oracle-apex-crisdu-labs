page 367 (
    name: Controle de Produtividade
    title: Controle de Produtividade
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region acompanhamento-das-análises (
        name: Acompanhamento das Análises
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct(pck_util_fav.fnc_nomeusuario(c.idusuario)) usuario
                     , cc.descricao
                     , nvl(count(1),0) quantidade
                from roman.classificacoessac c
                   , roman.caracteristicassac cc
                where c.idcaracteristicasac != 17
                  and cc.idcaracteristicasac = c.idcaracteristicasac
                  and ( :P367_DATAINICIO is null or trunc(c.dataclassificado) between  to_date(:P367_DATAINICIO) and to_date(:P367_DATAFIM) )
                  and ( :P367_IDUSUARIO is null or c.idusuario = :P367_IDUSUARIO )
                  and exists ( select 1
                               from roman.usuariosgruposatendimento ug
                                  , usuarios u
                               where u.idusuario = c.idusuario
                                 and ug.usuario  = u.usuario
                                 and ug.idgrupoatendimento in (9,22) )
                group by cc.descricao , c.idusuario
                order by 2 desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: 0
        }
        pagination {
            type: rowRangesXToY
        }
        advanced {
            savedReportMappingIdentifier: 1514214224229934930
        }

        column DESCRICAO (
            type: plainText
            heading {
                heading: Classificação
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column QUANTIDADE (
            type: plainText
            heading {
                heading: Quantidade
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        column USUARIO (
            type: plainText
            heading {
                heading: Usuário
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 15142446 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DESCRICAO (
                sequence: 2
            )

            displayColumn QUANTIDADE (
                sequence: 3
            )

            displayColumn USUARIO (
                sequence: 1
            )

        )

    )

    region analisados-últimos-15-dias (
        name: Analisados Últimos 15 dias
        type: chart
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        animation {
            onDataChange: none
        }
        legend {
            hideAndShowBehavior: none
        }

        series analisados (
            name: Analisados
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select to_char(c.dataclassificado,'dd/mm') data
                         , count(distinct c.idcontrolecontatossite) qtd
                    from roman.classificacoessac c
                    where c.idcaracteristicasac != 17
                      and trunc(c.dataclassificado) >= trunc(sysdate)-15
                      and ( :P367_IDUSUARIO is null or c.idusuario = :P367_IDUSUARIO )
                      and exists ( select 1
                                   from roman.usuariosgruposatendimento ug
                                      , usuarios u
                                   where u.idusuario = c.idusuario
                                     and ug.usuario  = u.usuario
                                     and ug.idgrupoatendimento in (9,22) )
                    group by to_char(c.dataclassificado,'dd/mm') 
                    order by 1 
                    ```
            }
            columnMapping {
                label: DATA
                value: QTD
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            minorTicks {
                show: false
            }
        )

    )

    region cadastros-analisados (
        name: Cadastros Analisados
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select distinct(pck_util_fav.fnc_nomeusuario(c.idusuario)) usuario
                     , count(distinct c.idcontrolecontatossite) quantidade
                from roman.classificacoessac c
                where c.idcaracteristicasac != 17
                  and ( :P367_DATAINICIO is null or trunc(c.dataclassificado) between  to_date(:P367_DATAINICIO) and to_date(:P367_DATAFIM) )
                  and ( :P367_IDUSUARIO is null or c.idusuario = :P367_IDUSUARIO )
                  and exists ( select 1
                               from roman.usuariosgruposatendimento ug
                                  , usuarios u
                               where u.idusuario = c.idusuario
                                 and ug.usuario  = u.usuario
                                 and ug.idgrupoatendimento in (9,22) )
                group by c.idusuario
                order by 2 desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: USUARIO
            valueColumn: QUANTIDADE
            colorScheme: modern2
            maximumRows: 20
        }
    )

    region classificações-analisadas (
        name: Classificações Analisadas
        type: chart
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chartAppearance {
            orientation: horizontal
        }
        chartLayout {
            maxWidth: 600
            height: 400
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        animation {
            onDataChange: none
        }
        legend {
            hideAndShowBehavior: none
        }

        series classificações (
            name: Classificações
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select cc.descricao classificacao
                         , count(1) quantidade
                    from roman.classificacoessac c
                       , roman.caracteristicassac cc
                    where c.idcaracteristicasac != 17
                      and c.idcaracteristicasac = cc.idcaracteristicasac
                      and ( :P367_DATAINICIO is null or trunc(c.dataclassificado) between  to_date(:P367_DATAINICIO) and to_date(:P367_DATAFIM) )
                      and ( :P367_IDUSUARIO is null or c.idusuario = :P367_IDUSUARIO )
                      and exists ( select 1
                                   from roman.usuariosgruposatendimento ug
                                      , usuarios u
                                   where u.idusuario = c.idusuario
                                     and ug.usuario  = u.usuario
                                     and ug.idgrupoatendimento in (9,22) )
                    group by cc.descricao 
                    order by 2 desc
                    ```
            }
            columnMapping {
                label: CLASSIFICACAO
                value: QUANTIDADE
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            minorTicks {
                show: false
            }
        )

    )

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P367_DATAFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            formatMask: DD/MM/RRRR
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P367_DATAINICIO (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            formatMask: DD/MM/RRRR
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P367_IDUSUARIO (
        type: selectList
        label {
            label: Usuários
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomeusuario(u.usuario) display_value
                     , u.idusuario
                from usuarios u
                where exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.usuario = u.usuario
                                 and ug.idgrupoatendimento in (9,22) )
                  and u.ativo = 'S'
                order by 1
                ```
            nullDisplayValue: - Selecione -
        }
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: FITLRAR
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 367
                items: {
                    P367_DATAINICIO: &P367_DATAINICIO.
                    P367_DATAFIM: &P367_DATAFIM.
                    P367_IDUSUARIO: &P367_IDUSUARIO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

