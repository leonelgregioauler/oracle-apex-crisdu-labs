            sequence: 10
            region: @filtro
            slot: top
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 51
                items: {
                    P51_ORIGEM:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
