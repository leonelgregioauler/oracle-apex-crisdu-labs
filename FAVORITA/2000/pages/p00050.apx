page 50 (
    name: Relatório de Promoções Divulgações
    title: Promoções Divulgações
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region promoções-divulgações (
        name: Promoções Divulgações
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idpromocaodivulgacao
                     , idprodutodetalhado
                     , nome
                     , datainicial
                     , datafinal
                     , roman.pck_romance.fnc_nomefilial(idfilialromance) filialromance
                     , pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) filialfavorita
                     , valororiginal
                     , valorvenda
                     , perccomissaogerente
                     , perccomissaodistribuidor
                     , perccomissaoconsultora
                     , valorcomissaoatendente
                  from promocoesdivulgacoes
                 where (
                        ( :p50_datainicial between trunc(datainicial) and trunc(datafinal))
                     or (:p50_datafinal between trunc(datainicial) and trunc(datafinal))
                     or(trunc(datainicial) between nvl(:p50_datainicial, to_date('01/01/00')) and nvl(:p50_datafinal, to_date('31/12/25')) )
                     or (trunc(datafinal)  between nvl(:p50_datainicial, to_date('01/01/00')) and nvl(:p50_datafinal, to_date('31/12/25')) ) 
                     or (:p50_datainicial is null and :p50_datafinal is null) 
                       )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
            filename: promocoes
        }
        advanced {
            savedReportMappingIdentifier: 12827609527685416
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @FILIALFAVORITA
                layout {
                    width: 222
                    sequence: 11
                }
            )

            displayColumn (
                column: @IDPROMOCAODIVULGACAO
                layout {
                    width: 59
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDPRODUTODETALHADO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @NOME
                layout {
                    width: 156
                    sequence: 2
                }
            )

            displayColumn (
                column: @DATAINICIAL
                layout {
                    width: 87
                    sequence: 3
                }
            )

            displayColumn (
                column: @DATAFINAL
                layout {
                    width: 88
                    sequence: 4
                }
            )

            displayColumn (
                column: @VALORVENDA
                layout {
                    width: 110
                    sequence: 6
                }
            )

            displayColumn (
                column: @PERCCOMISSAOGERENTE
                layout {
                    width: 81
                    sequence: 7
                }
            )

            displayColumn (
                column: @PERCCOMISSAODISTRIBUIDOR
                layout {
                    width: 104
                    sequence: 8
                }
            )

            displayColumn (
                column: @PERCCOMISSAOCONSULTORA
                layout {
                    width: 95
                    sequence: 9
                }
            )

            displayColumn (
                column: @VALORCOMISSAOATENDENTE
                layout {
                    width: 105
                    sequence: 10
                }
            )

            displayColumn (
                column: @FILIALROMANCE
                layout {
                    width: 221
                    sequence: 12
                }
            )

            displayColumn (
                column: @VALORORIGINAL
                layout {
                    width: 121
                    sequence: 5
                }
            )

            sort (
                column: @DATAINICIAL
                sort {
                    direction: desc
                    nulls: first
                    sequence: 1
                }
            )

        )

        column DATAFINAL (
            type: datePickerJquery
            heading {
                heading: Data Final
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: DATAFINAL
                dataType: date
            }
        )

        column DATAINICIAL (
