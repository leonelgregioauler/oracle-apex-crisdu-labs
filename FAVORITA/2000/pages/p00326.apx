    region baixa-de-boletos-totalizadores (
        name: Baixa de Boletos - Totalizadores
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Baixa' situacaobanco
                     , ( select count(1)
                         from vw_integracaobxboletos_fav_ws
                         where dataprocessado is not null ) boletosprocessados 
                     , ( select count(1)
                         from vw_integracaobxboletos_fav_ws
                         where dataprocessado is null ) boletospendentes
                from favorita.vw_arquivosbaixasboletos_fav
                group by 1
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
