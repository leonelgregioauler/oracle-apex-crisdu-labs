            layout {
                sequence: 20
                columnAlignment: center
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: NUMEROBOLETO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

    )

    region baixa-de-boletos-processados (
        name: Baixa de Boletos Processados
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idpagamentopedido
                     , numeroboleto
                     , dataemissao
                     , datainclusaoboleto
                     , dataprocessado
                from vw_integracaobxboletos_fav_ws t
                where dataprocessado is not null 
                and ( :P326_NUMEROBOLETO is null or t.numeroboleto = :P326_NUMEROBOLETO )
                and ( trunc(dataprocessado) between to_date(:P326_DATAINICIAL, 'dd/mm/rrrr') and to_date(:P326_DATAFINAL, 'dd/mm/rrrr') );
                ```
        }
        layout {
            sequence: 70
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: page
        }
        toolbar {
            show: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 1504188184759623512
        }

