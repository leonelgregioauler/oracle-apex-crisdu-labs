    region registro-de-boletos-totalizadores (
        name: Registro de Boletos - Totalizadores
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Registro' situacaobanco
                     , ( select count(1)
                         from vw_integracaoregboletos_fav_ws
                         where dataprocessado is not null
                         and codsituacaovencimento = 'V' ) boletosprocessados 
                     , ( select count(1)
                         from vw_integracaoregboletos_fav_ws
                         where dataprocessado is null
                         and codsituacaovencimento = 'V' 
                         and trunc(datavencimento) >= trunc(sysdate) ) boletospendentes
                from vw_registraboletos_fav_ws t
                group by 1;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
