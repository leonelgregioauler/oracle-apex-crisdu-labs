page 326 (
    name: Relatório Monitoramento Integração Banco do Brasil
    title: Relatório Monitoramento Integração Banco do Brasil
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    htmlHeader {
        htmlHeader:
            ```html
            <style>
            
              .contadores {
                color: black;
                font-weight: bold;  
              }
                
                .t-BadgeList-label {
                    color: cadetblue !important;
                    font-weight: bold !important; 
                }
                
                .t-BadgeList--circular .t-BadgeList-value {
                    background-color: cadetblue !important;
                }
            
            </style>
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region baixa-de-boletos (
        name: Baixa de Boletos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idpagamentopedido
                     , numeroboleto
                     , dataemissao
                     , datainclusaoboleto
                from favorita.vw_arquivosbaixasboletos_fav t
                where ( :P326_NUMEROBOLETO is null or t.numeroboleto = :P326_NUMEROBOLETO );
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: page
        }
        toolbar {
            show: false
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 1500627284191999748
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @NUMEROBOLETO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @DATAEMISSAO
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDPAGAMENTOPEDIDO
                layout {
                    show: false
                    sequence: 0
                }
            )

            displayColumn (
                column: @DATAINCLUSAOBOLETO
                layout {
                    sequence: 3
                }
            )

        )

        column DATAEMISSAO (
            type: datePickerJquery
            heading {
                heading: Data Emissão
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                databaseColumn: DATAEMISSAO
                dataType: date
            }
        )

        column DATAINCLUSAOBOLETO (
