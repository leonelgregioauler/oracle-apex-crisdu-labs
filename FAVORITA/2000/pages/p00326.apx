    region registro-de-boletos-processados (
        name: Registro de Boletos Processados
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idpagamentopedido
                     , numeroboleto
                     , situacaovencimento
                     , dataemissao
                     , dataprocessado
                     , datainclusaoboleto
                from vw_integracaoregboletos_fav_ws t
                where dataprocessado is not null 
                  and ( :P326_NUMEROBOLETO is null or t.numeroboleto = :P326_NUMEROBOLETO )
                  AND ( :P326_DATAINICIAL is null or dataprocessado between to_date(to_date(:P326_DATAINICIAL, 'DD/MM/RRRR')-1||' 22:40:00', 'DD/MM/RRRR HH24:MI:SS') and to_date(to_date(:P326_DATAFINAL, 'DD/MM/RRRR')||' 22:39:59', 'DD/MM/RRRR HH24:MI:SS') )
                  and :P326_DATAINICIAL is not null ;
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
