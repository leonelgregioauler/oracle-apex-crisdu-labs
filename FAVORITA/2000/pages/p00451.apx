page 451 (
    name: Impressão Notas Fiscais
    title: Impressão Notas Fiscais
    appearance {
        pageTemplate: @imprimir
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region pdf-danfes (
        name: PDF - Danfes
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                pck_imprime_fav.prc_imprimedanferemessa (:P451_IDCOMPRATRANSFERENCIA
                                                       , :P451_IDREPRESENTANTE );
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P451_IDCOMPRATRANSFERENCIA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @pdf-danfes
            slot: regionBody
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P451_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @pdf-danfes
            slot: regionBody
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    branch (
        name: Go To Page 451
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 451
                items: {
                    P451_IDREPRESENTANTE: &P451_IDREPRESENTANTE.
                    P451_IDCOMPRATRANSFERENCIA: &P451_IDCOMPRATRANSFERENCIA.
                }
                action: resetPagination
            }
        }
    )

)

