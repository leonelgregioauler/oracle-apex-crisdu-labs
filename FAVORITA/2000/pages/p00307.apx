page 307 (
    name: Cadastro de Prêmios
    title: Cadastro de Prêmios
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG_24"';
    }

    region cadastro-de-prêmios (
        name: Cadastro de Prêmios
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P307_ATIVO (
        type: radioGroup
        label {
            label: Ativo
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @cadastro-de-prêmios
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P307_CUSTOPONTOS (
        type: numberField
        label {
            label: Custo de Pontos
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 50
            region: @cadastro-de-prêmios
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G999G999G990
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P307_IDPREMIOCLUBE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @cadastro-de-prêmios
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P307_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @cadastro-de-prêmios
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P307_NOME (
        type: textField
        label {
            label: Nome
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @cadastro-de-prêmios
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P307_URLIMAGEM (
        type: textField
        label {
            label: Url Imagem
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 60
            region: @cadastro-de-prêmios
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P307_VALOR (
        type: numberField
        label {
            label: Valor
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 30
            region: @cadastro-de-prêmios
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 5
        }
        advanced {
            customAttributes: onkeyup="formataMoeda(this);"
        }
        security {
            encryptSessionState: false
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 40
            region: @cadastro-de-prêmios
            slot: belowBox
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P307_IDPREMIOCLUBE
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 10
            region: @cadastro-de-prêmios
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P307_IDPREMIOCLUBE
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Cadastrar
        layout {
            sequence: 20
            region: @cadastro-de-prêmios
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P307_IDPREMIOCLUBE
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 30
            region: @cadastro-de-prêmios
            slot: belowBox
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 306
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process consulta (
        name: Consulta
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vvalor number;
                begin
                  --
                  PCK_CLUBEPONTOS_FAV.PRC_PREMIOSCLUBE ( PIDPREMIOCLUBE => :P307_IDPREMIOCLUBE,
                                                         PNOME => :P307_NOME,
                                                         PVALOR => vvalor,
                                                         PATIVO => :P307_ATIVO,
                                                         PCUSTOPONTOS => :P307_CUSTOPONTOS,
                                                         PURLIMAGEM => :P307_URLIMAGEM,
                                                         PMD5 => :P307_MD5,
                                                         POPERACAO_DML => 'S' );
                  --
                  :P307_VALOR := to_char(vvalor,'999G999G999G999G990D00');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 1401981820421047330
        }
    )

    process processo-dml-em-premios (
        name: Processo DML em Premios
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                  vvalor number;
                begin
                  --
                  if v('REQUEST') = 'SUBMIT' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'SAVE' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'DELETE' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  vvalor := to_number(:P307_VALOR,'999G999G999G999G990D00');
                  --
                  PCK_CLUBEPONTOS_FAV.PRC_PREMIOSCLUBE ( PIDPREMIOCLUBE => :P307_IDPREMIOCLUBE,
                                                         PNOME => :P307_NOME,
                                                         PVALOR => vvalor,
                                                         PATIVO => :P307_ATIVO,
                                                         PCUSTOPONTOS => :P307_CUSTOPONTOS,
                                                         PURLIMAGEM => :P307_URLIMAGEM,
                                                         PMD5 => :P307_MD5,
                                                         POPERACAO_DML => voperacao_dml );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo executado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1402220974907911511
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 306
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 307
                items: {
                    P307_IDPREMIOCLUBE:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        execution {
            sequence: 30
        }
        behavior {
            target: {
                page: 307
                items: {
                    P307_IDPREMIOCLUBE: &P307_IDPREMIOCLUBE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)

