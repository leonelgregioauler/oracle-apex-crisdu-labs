page 648 (
    name: Verificar Acessos
    alias: VERIFICAR-ACESSOS
    title: Verificar Acessos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region acessos-encontrados (
        name: Acessos Encontrados
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select aa.idacesso
                     , aa.usuario
                     , aa.idaplicacao
                from roman.acessos aa
                where exists ( select 1
                               from roman.aplicacoes a
                               where a.idaplicacao = aa.idaplicacao
                                 and a.idsistema   = 2000
                                 and ( :P648_TIPOACESSO is null
                                    or ( :P648_TIPOACESSO = 'P' and a.pagina = :P648_PAGINA )
                                    or ( :P648_TIPOACESSO = 'M' and a.idaplicacao = :P648_MENU ) ) )
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: delete
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado, verifique os filtros!
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 50427972562161920
        }

        savedReport 504463 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDACESSO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @USUARIO
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDAPLICACAO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column IDACESSO (
            type: numberField
            heading {
                heading: ID ACESSO
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDACESSO
                dataType: number
                queryOnly: true
                primaryKey: true
            }
            columnFilter {
                lovType: none
            }
        )

        column IDAPLICACAO (
            type: numberField
            heading {
                heading: Idaplicacao
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                databaseColumn: IDAPLICACAO
                dataType: number
                queryOnly: true
            }
            columnFilter {
                lovType: none
            }
        )

        column USUARIO (
            type: selectList
            heading {
                heading: Usuário
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(p.nomepessoa) display_value
                         , u.usuario
                    from usuarios u
                       , pessoas p 
                    where p.idpessoa = u.idpessoa
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: USUARIO
                dataType: varchar2
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P648_MENU (
        type: selectOne
        label {
            label: Menu
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.nome||'(ID - '||a.idaplicacao||')' display_value
                     , a.idaplicacao return_value
                from roman.aplicacoes a
                where a.idsistema = 2000
                  and a.aparecer = 'S'
                order by a.idaplicacao;
                ```
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
    )

    pageItem P648_PAGINA (
        type: numberField
        label {
            label: Página
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
    )

    pageItem P648_TIPOACESSO (
        type: radioGroup
        label {
            label: Pesquisar Por
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Página;P,Menu de Acesso;M
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: P
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction escolha-menu (
        name: Escolha Menu
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P648_TIPOACESSO
        }
        clientSideCondition {
            type: item=value
            item: P648_TIPOACESSO
            value: M
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P648_MENU
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P648_MENU
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction escolha-pagina (
        name: Escolha Pagina
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P648_TIPOACESSO
        }
        clientSideCondition {
            type: item=value
            item: P648_TIPOACESSO
            value: P
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P648_PAGINA
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P648_PAGINA
            }
            execution {
                sequence: 10
            }
        )

    )

    process acessos-encontrados-save-interactive-grid-data (
        name: Acessos Encontrados - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @acessos-encontrados
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 50428504718161926
        }
    )

)

