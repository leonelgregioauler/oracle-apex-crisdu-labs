    region comissões (
        name: Comissões
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.unidade             as unidade
                     , initcap(p.nomepessoa) as nomeusuario
                     , c.matricula           as matricula
                     , c.valorcomissao       as comissao
                     , c.valorbonificacao    as bonificacao
                  from favorita.comissaobonificacaolojasfav c
                     , catal.usuarios u
                     , catal.pessoas p
                 where u.idusuario = c.idusuario
                   and p.idpessoa = u.idpessoa
                   and c.mesano = (select to_char(m.datafim,'mm/yyyy')
                                     from favorita.metascobrancas m
                                    where m.idmetacobranca = :P596_META)
                   and (nvl(c.valorcomissao,0) > 0 or nvl(c.valorbonificacao,0) > 0)
                   -- filtro por regional: pela unidade gravada ou, se a unidade estiver nula, pela loja do usuario
                   and ( nvl(:P596_IDREGIONALFAVORITA, -1) = -1
                         or exists ( select 1
                                       from favorita.filiaisfavorita f
                                      where f.idregionalfavorita = :P596_IDREGIONALFAVORITA
                                        and (    lpad(to_char(f.idempresametadados),4,'0') = c.unidade
                                              or (c.unidade is null and f.idfilialfavorita = u.idfilialfavorita) ) ) )
                 order by 2
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
