    button buscar (
        buttonName: BUSCAR
        label: Buscar
        layout {
            sequence: 30
            region: @b-filtros-b
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button gerar (
        buttonName: GERAR
        label: Gerar
        layout {
            sequence: 30
            region: @componentes
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button gerarcomissaobonificacao (
        buttonName: GERARCOMISSAOBONIFICACAO
        label: Gerar Comissão Bonificação
        layout {
            sequence: 40
            region: @b-filtros-b
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from favorita.metascobrancas m
                 where m.idfilialfavorita is not null
                   and m.datafim < trunc(sysdate)
                   and m.datafim >= add_months(trunc(sysdate,'mm'), -6)
                   and not exists ( select 1
                                      from favorita.comissaobonificacaolojasfav c
                                     where c.mesano = to_char(m.datafim,'mm/yyyy') )
                ```
        }
    )

    dynamicAction chamacomissaobonificacao (
        name: ChamaComissaoBonificacao
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @gerarcomissaobonificacao
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    openModal("COMISSAOBONIFICACAO");
                    apex.region('COMISSAOBONIFICACAO').refresh();
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @gerar
        }

        action native-confirm (
            action: confirm
            settings {
                message: Deseja realmente gerar a comissão e bonificação para o período selecionado?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: GERARCOMISSAOBONIFICACAO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    validation p596-gerarmeta-obrigatorio (
        name: P596_GERARMETA obrigatorio
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P596_GERARMETA
        }
        error {
            errorMessage: Selecione o período da meta para gerar.
            displayLocation: inlineInNotification
            associatedItem: @P596_GERARMETA
        }
        serverSideCondition {
            whenButtonPressed: @gerarcomissaobonificacao
        }
    )

    validation periodo-congelado (
        name: Periodo congelado
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                  from favorita.metascobrancas m
                 where m.idmetacobranca = :P596_GERARMETA
                   and (    m.datafim >= trunc(sysdate)
                         or exists ( select 1
                                       from favorita.comissaobonificacaolojasfav c
                                      where c.mesano = to_char(m.datafim,'mm/yyyy') ) )
                ```
        }
        error {
            errorMessage: A comissão e bonificação deste período já foi gerada e está congelada, ou o período ainda não foi encerrado. Ajustes devem ser feitos pelo RH diretamente na folha.
            displayLocation: inlineInNotification
            associatedItem: @P596_GERARMETA
        }
        serverSideCondition {
            whenButtonPressed: @gerarcomissaobonificacao
        }
    )

    process gerar-comissao-bonificacao (
        name: GERAR_COMISSAO_BONIFICACAO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  favorita.prc_gera_dados_tab_comissaobonificacaolojasfav(:P596_GERARMETA);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Comissão e Bonificação gerado com sucesso.
        }
        error {
            errorMessage: Ocorreu um erro! Comissão e bonificação não foram gerados.
        }
        advanced {
            executionMappingIdentifier: 3629305114328290247
        }
        serverSideCondition {
            whenButtonPressed: @gerarcomissaobonificacao
        }
    )

)

