    pageItem P596_GERARMETA (
        type: selectList
        label {
            label: Meta
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(m.datainicio,'dd/mm/rrrr') || ' a ' || to_char(m.datafim,'dd/mm/rrrr') d
                     , max(m.idmetacobranca)  r
                  from favorita.metascobrancas m
                 where m.idfilialfavorita is not null
                   and m.datafim < trunc(sysdate)
                   and m.datafim >= add_months(trunc(sysdate,'mm'), -6)
                   and not exists ( select 1
                                      from favorita.comissaobonificacaolojasfav c
                                     where c.mesano = to_char(m.datafim,'mm/yyyy') )
                 group by m.datainicio, m.datafim
                 order by m.datainicio desc
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @componentes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P596_IDREGIONALFAVORITA (
        type: selectList
        label {
            label: <b>Regional Favorita</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select rf.descricaoregionalfavorita as display_value
                     , rf.idregionalfavorita        as return_value
                  from favorita.regionaislojasfavorita rf
                 order by 2
                ```
            displayExtraValues: false
            nullDisplayValue: - Todas -
            nullReturnValue: -1
        }
        layout {
            sequence: 25
            region: @b-filtros-b
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        default {
            type: static
            staticValue: -1
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from dual
                 where roman.pck_util.fnc_verificaacesso(40812, v('APP_USER')) = 'S';
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P596_META (
        type: selectList
        label {
            label: <b>Metas</b>
            alignment: left
