    region bonificações (
        name: Bonificações
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.unidade             as unidade
                     , initcap(p.nomepessoa) as nomeusuario
                     , c.matricula           as matricula
                     , c.valorbonificacao    as bonificacao
                  from favorita.comissaobonificacaolojasfav c
                     , catal.usuarios u
                     , catal.pessoas p
                 where u.idusuario = c.idusuario
                   and p.idpessoa = u.idpessoa
                   and c.mesano = (select to_char(m.datafim,'mm/yyyy')
                                     from favorita.metascobrancas m
                                    where m.idmetacobranca = :P596_META)
                   and c.valorbonificacao > 0
                   -- filtro por regional: pela unidade gravada ou, se a unidade estiver nula, pela loja do usuario
                   and ( nvl(:P596_IDREGIONALFAVORITA, -1) = -1
                         or exists ( select 1
                                       from favorita.filiaisfavorita f
                                      where f.idregionalfavorita = :P596_IDREGIONALFAVORITA
                                        and (    lpad(to_char(f.idempresametadados),4,'0') = c.unidade
                                              or (c.unidade is null and f.idfilialfavorita = u.idfilialfavorita) ) ) )
                 order by 2
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P596_TIPORELATORIO
            value: B
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 3629302947771290225
        }

        column BONIFICACAO (
            type: plainText
            heading {
                heading: Bonificação
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

