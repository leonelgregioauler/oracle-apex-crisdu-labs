page 144 (
    name: Cadastro de Limites Consultoras por Quantidade de Pedidos
    title: Cadastro de Limites Consultoras por Quantidade de Pedidos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-de-limites-consultoras-por-quantidade-de-pedidos (
        name: Cadastro de Limites Consultoras por Quantidade de Pedidos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idlimiteconsultoraqtd
                       , idfilialromance
                       , quantidadepedidos
                       , limiteficticio
                       , limitereal
                       , tipopedido
                      -- , decode(tipopedido,'R','Romance Casa','Tradicional') "Tipo Pedido"
                  from limitesconsultorasporqtd
                where (:P144_FILIALROMANCE is null or idfilialromance = :P144_FILIALROMANCE)
                  and (:P144_TIPOPEDIDO is null or tipopedido = :P144_TIPOPEDIDO)
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 29620564905404528
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDLIMITECONSULTORAQTD
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDFILIALROMANCE
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @QUANTIDADEPEDIDOS
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @LIMITEFICTICIO
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @LIMITEREAL
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @TIPOPEDIDO
                layout {
                    sequence: 7
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column IDFILIALROMANCE (
            type: selectList
            heading {
                heading: Filial Romance
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @lov-filiaisromance
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDFILIALROMANCE
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDLIMITECONSULTORAQTD (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDLIMITECONSULTORAQTD
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: SEQ_IDLIMITECONSULTORAQTD
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column LIMITEFICTICIO (
            type: numberField
            heading {
                heading: Limite Fictítcio
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: LIMITEFICTICIO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
            advanced {
                customAttributes: onkeyup="formataMoeda(this);"
            }
        )

        column LIMITEREAL (
            type: numberField
            heading {
                heading: Limite Real
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: LIMITEREAL
                dataType: number
            }
            columnFilter {
                lovType: none
            }
            advanced {
                customAttributes: onkeyup="formataMoeda(this);"
            }
        )

        column QUANTIDADEPEDIDOS (
            type: numberField
            heading {
                heading: Quantidade de Pedidos
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: QUANTIDADEPEDIDOS
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column TIPOPEDIDO (
            type: selectList
            heading {
                heading: Tipo Pedido
            }
            lov {
                type: staticValues
                staticValues: STATIC:Tradicional;P,Romance Casa;R
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: TIPOPEDIDO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

    )

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P144_FILIALROMANCE (
        type: selectList
        label {
            label: Filial Romance
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-filiaisromance
            nullDisplayValue: - Selecione uma Filial Romance -
        }
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P144_TIPOPEDIDO (
        type: selectList
        label {
            label: Tipo Pedido
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Tradicional;P,Romance Casa;R
        }
        layout {
            sequence: 20
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 30
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-filter
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation idfilialromance-obrigatório (
        name: IDFILIALROMANCE obrigatório
        execution {
            sequence: 50
        }
        validation {
            editableRegion: @cadastro-de-limites-consultoras-por-quantidade-de-pedidos
            type: columnIsNotNull
            column: IDFILIALROMANCE
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ter um valor.
            associatedColumn: IDFILIALROMANCE
        }
    )

    validation limiteficticio-obrigatório (
        name: LIMITEFICTICIO obrigatório
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @cadastro-de-limites-consultoras-por-quantidade-de-pedidos
            type: columnIsNotNull
            column: LIMITEFICTICIO
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ter um valor.
            associatedColumn: LIMITEFICTICIO
        }
    )

    validation limitereal-obrigatório (
        name: LIMITEREAL obrigatório
        execution {
            sequence: 40
        }
        validation {
            editableRegion: @cadastro-de-limites-consultoras-por-quantidade-de-pedidos
            type: columnIsNotNull
            column: LIMITEREAL
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ter um valor.
            associatedColumn: LIMITEREAL
        }
    )

    validation quantidadepedidos-obrigatório (
        name: QUANTIDADEPEDIDOS obrigatório
        execution {
            sequence: 20
        }
        validation {
            editableRegion: @cadastro-de-limites-consultoras-por-quantidade-de-pedidos
            type: columnIsNotNull
            column: QUANTIDADEPEDIDOS
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ter um valor.
            associatedColumn: QUANTIDADEPEDIDOS
        }
    )

    validation quantidadeporfilial-unique (
        name: QUANTIDADEPORFILIAL unique
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @cadastro-de-limites-consultoras-por-quantidade-de-pedidos
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidfilialromance number;
                begin
                  select idfilialromance
                  into vidfilialromance
                  from limitesconsultorasporqtd
                  where idfilialromance = :IDFILIALROMANCE
                  and quantidadepedidos = :QUANTIDADEPEDIDOS
                  and tipopedido = :tipopedido;
                  --
                  if vidfilialromance is not null then
                    return 'Existe um cadastro no sistema com estas informações. Não são permitidas informações repetidas para este cadastro.';
                  end if;
                  --
                exception
                  when no_data_found then
                    return '';
                end;
                ```
        }
        error {
            associatedColumn: QUANTIDADEPEDIDOS
        }
    )

    process save-interactive-grid-data (
        name: " - Save Interactive Grid Data"
        type: interactiveGridAutoRowProcessing
        editableRegion: @cadastro-de-limites-consultoras-por-quantidade-de-pedidos
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 29625379689404534
        }
    )

)

