    region cupons-conquistou-levou-loja (
        name: Cupons Conquistou Levou Loja
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct clc.idconquistoulevoucupom cupom 
                     , clc.idconquistoulevoucupom idcp
                     , p.nomepessoa empreendedora 
                     , roman.pck_romance.fnc_nomerepresentante(v.idrepresentante) Distribuidor
                     , nvl(p.cpf,p.documentoestrangeiro) documento
                     , clc.dataresgate 
                     , clc.dataenviofilial
                     , clc.datarecebfilial 
                     , clc.dataretirada
                     , clc.idvendedora
                     , clc.retiradopor
                     , (select p.nomepessoa
                        from catal.pessoas p 
                           , catal.usuarios u 
                        where p.idpessoa = u.idpessoa
                          and u.idusuario = clc.idusuarioentrega) usuarioentrega
                from roman.conquistoulevoucupons clc 
                   , roman.itensconqlevcupons itc 
                   , catal.vendedoras v 
                   , catal.pessoas p 
                where clc.idconquistoulevoucupom = itc.idconquistoulevoucupom
                  and clc.idvendedora = v.idvendedora
                  and v.idpessoa = p.idpessoa 
                  and clc.dataguia is not null
                  and clc.datarecebfilial is not null
                  and :P671_LOJA is null
                  and (:P671_IDCUPOM is null or clc.idconquistoulevoucupom = :P671_IDCUPOM )
                  and (:P671_IDREPRESENTANTE is null or v.idrepresentante = :P671_IDREPRESENTANTE)
                  and (:P671_RECEBIDOLOJA  = 'T' or (:P671_RECEBIDOLOJA = 'S' and clc.datarecebfilial is not null) or (:P671_RECEBIDOLOJA = 'N' and clc.datarecebfilial is null))
                  and clc.idfilialretira in (select idfilialfavorita from catal.usuarios u  where u.usuario = v('APP_USER'))
                  and (:P671_RETIRADO  = 'T' or (:P671_RETIRADO = 'S' and clc.dataretirada is not null) or (:P671_RETIRADO = 'N' and clc.dataretirada is null))
                  and (:P671_DOCUMENTO is null or (p.cpf = :P671_DOCUMENTO and p.idpais = 1)
                                               or (p.documentoestrangeiro = :P671_DOCUMENTO and p.idpais != 1))
                union 
                select distinct clc.idconquistoulevoucupom cupom 
                     , clc.idconquistoulevoucupom idcp
                     , p.nomepessoa empreendedora 
                     , roman.pck_romance.fnc_nomerepresentante(v.idrepresentante) Distribuidor
                     , nvl(p.cpf,p.documentoestrangeiro) documento
                     , clc.dataresgate 
                     , clc.dataenviofilial
                     , clc.datarecebfilial 
                     , clc.dataretirada
                     , clc.idvendedora
                     , clc.retiradopor
                     , (select p.nomepessoa
                        from catal.pessoas p 
                           , catal.usuarios u 
                        where p.idpessoa = u.idpessoa
                          and u.idusuario = clc.idusuarioentrega) usuarioentrega
                from roman.conquistoulevoucupons clc 
                   , roman.itensconqlevcupons itc 
                   , catal.vendedoras v 
                   , catal.pessoas p 
                where clc.idconquistoulevoucupom = itc.idconquistoulevoucupom
                  and clc.idvendedora = v.idvendedora
                  and v.idpessoa = p.idpessoa 
                  and clc.dataguia is not null
                  and clc.datarecebfilial is not null
                  and clc.idfilialretira = :P671_LOJA 
                  and (:P671_IDCUPOM is null or clc.idconquistoulevoucupom = :P671_IDCUPOM )
                  and (:P671_IDREPRESENTANTE is null or v.idrepresentante = :P671_IDREPRESENTANTE)
                  and (:P671_RECEBIDOLOJA  = 'T' or (:P671_RECEBIDOLOJA = 'S' and clc.datarecebfilial is not null) or (:P671_RECEBIDOLOJA = 'N' and clc.datarecebfilial is null))
                  ---and clc.idfilialretira in (select idfilialfavorita from catal.usuarios u  where u.usuario = v('APP_USER'))
                  and (:P671_RETIRADO  = 'T' or (:P671_RETIRADO = 'S' and clc.dataretirada is not null) or (:P671_RETIRADO = 'N' and clc.dataretirada is null))
                  and (:P671_DOCUMENTO is null or (p.cpf = :P671_DOCUMENTO and p.idpais = 1)
                                               or (p.documentoestrangeiro = :P671_DOCUMENTO and p.idpais != 1));
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1804735915493363119
        }

