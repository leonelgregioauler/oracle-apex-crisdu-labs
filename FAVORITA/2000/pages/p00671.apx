    pageItem P671_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(r.idrepresentante) Distribuidor
                     , r.idrepresentante
                from catal.representantes r 
                where exists ( select 1
                               from roman.conquistoulevoucupons clc 
                                  , roman.itensconqlevcupons itc 
                                  , catal.vendedoras v 
                                  , catal.pessoas p 
                               where clc.idconquistoulevoucupom = itc.idconquistoulevoucupom
                                 and clc.idvendedora = v.idvendedora
                                 and v.idpessoa = p.idpessoa 
                                 and clc.dataguia is not null
                                 and v.idrepresentante = r.idrepresentante
                                 and clc.idfilialretira in (select idfilialfavorita from catal.usuarios u  where u.usuario = v('APP_USER')))  
                ```
        }
        layout {
            sequence: 40
            region: @ações
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P671_LOJA (
        type: selectList
        label {
            label: Loja
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'LF - '||favorita.pck_util_fav.fnc_nomefilialfavorita(af.idfilialfavoritaorigem) 
                     , af.idfilialfavoritaorigem
                from   favorita.atendimentosfiliaisrmc af
                where af.principal = 'S'
                  and exists (select 1
                              from  favorita.filiaisfavorita ff
                              where ff.idfilialfavorita = af.idfilialfavoritaorigem
                                and ff.tipofilial = 'L'
                                and ff.ativo      = 'S')
                                
                union 
                select 'LB - '||f.nome
                     , f.idfilial
                from roman.vw_filiais f 
                where f.idfilial in (1217,1246,1275) 
                order by 1 
                ```
        }
        layout {
            sequence: 10
            region: @grupo-ti
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.usuariosgruposatendimento ug
                where ug.usuario = v('APP_USER')
                and ug.idgrupoatendimento = 0 -- Grupo TI
                union
                select 1
                from roman.usuariosgruposatendimento ug
                where ug.usuario = 'JULIANASEVERO'
                ```
        }
    )

