    region grupo-ti (
        name: Grupo TI
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.usuariosgruposatendimento ug
                where ug.usuario = v('APP_USER')
                and ug.idgrupoatendimento = 0 -- Grupo TI
                union
                select 1
                from roman.usuariosgruposatendimento ug
                where ug.usuario = 'JULIANASEVERO'
                ```
        }
        comments {
            comments: Região destinada somente a usuários do TI, como a consulta se baseia no usuário logado foi criado o campo de pesquisa por loja com visão somente para o Grupo TI
        }
    )

