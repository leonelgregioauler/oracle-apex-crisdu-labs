                              1  as CODIGOFAIXA
                       from dual
                       union
                       select '24 a 29' as FAIXAIDADE,
                              2  as CODIGOFAIXA
                       from dual
                       union
                       select '30 a 35' as FAIXAIDADE,
                              3  as CODIGOFAIXA
                       from dual
                       union
                       select '36 a 41' as FAIXAIDADE,
                              4  as CODIGOFAIXA
                       from dual
                       union
                       select '42 a 47' as FAIXAIDADE,
                              5  as CODIGOFAIXA
                       from dual
                       union
                       select '48 a 53' as FAIXAIDADE,
                              6  as CODIGOFAIXA
                       from dual
                       union
                       select '54 a 59' as FAIXAIDADE,
                              7  as CODIGOFAIXA
                       from dual
                       union
                       select '60 a 99' as FAIXAIDADE,
                              8  as CODIGOFAIXA
                       from dual)
                ```
