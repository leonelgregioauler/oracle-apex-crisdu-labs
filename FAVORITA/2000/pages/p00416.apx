page 416 (
    name: Gerar Tarefas de Cobrança Call Center
    title: Gerar Tarefas de Cobrança Call Center
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pedidos-vencidos (
        name: Pedidos Vencidos
        type: tabform
        source {
            sqlQuery:
                ```sql
                select p.idpedido
                     , p.representante
                     , p.vendedora
                     , p.cpf
                     , p.dataemissao
                     , p.datavencimentomenor
                     , p.valortotal
                     , p.valorapagar
                     , p.valorpago
                     , p.saldodevedor
                     , p.idvendedora
                     , p.idpessoa
                     , p.numeropedido
                from vw_pedidos_fav p
                   , catal.pessoas pp
                where pp.idpessoa = p.idpessoa
                  and trunc(p.datavencimentomenor) between to_date(:P416_DATAINICIO) and to_date(:P416_DATAFIM) 
                  and p.idfilialromance = :P416_IDFILIALROMANCE
                  and ( :P416_IDREPRESENTANTE is null or p.idrepresentante = :P416_IDREPRESENTANTE )
                  and ( :P416_SEXO is null or :P416_SEXO = upper(pp.sexo))
                  and ( :P416_FAIXAVALOR is null
                      or (:P416_FAIXAVALOR = 1 and p.valorapagar between 0.01 and 129.99) 
                      or (:P416_FAIXAVALOR = 2 and p.valorapagar between 130.00 and 299.99) 
                      or (:P416_FAIXAVALOR = 3 and p.valorapagar between 300.00 and 599.99) 
                      or (:P416_FAIXAVALOR = 4 and p.valorapagar between 600.00 and 799.99) 
                      or (:P416_FAIXAVALOR = 5 and p.valorapagar between 800.00 and 99999.99))  
                  and ( :P416_FAIXAIDADE is null
                      or (:P416_FAIXAIDADE = 1 and pp.idade between 18 and 23) 
                      or (:P416_FAIXAIDADE = 2 and pp.idade between 24 and 29) 
                      or (:P416_FAIXAIDADE = 3 and pp.idade between 30 and 35) 
                      or (:P416_FAIXAIDADE = 4 and pp.idade between 36 and 41) 
                      or (:P416_FAIXAIDADE = 5 and pp.idade between 42 and 47) 
                      or (:P416_FAIXAIDADE = 6 and pp.idade between 48 and 53) 
                      or (:P416_FAIXAIDADE = 7 and pp.idade between 54 and 59) 
                      or (:P416_FAIXAIDADE = 8 and pp.idade between 60 and 160) )
                  and ( :P416_PEDIDOANTERIOREMDIA is null
                      or (:P416_PEDIDOANTERIOREMDIA = 'S' and ( select sum(vp.valorpagar - ( select sum(pg.valorpago)
                                                                                         from favorita.pagamentospedidos pg
                                                                                         where pg.idvencimentopedido = vp.idvencimentopedido
                                                                                           and pg.idsituacao = 20
                                                                                           and pg.datapagamento <= vp.datavencimento) )
                                                                from favorita.vencimentospedidos vp
                                                                where vp.idpedido = ( select max(pe.idpedido)
                                                                                                from favorita.pedidos pe
                                                                                                where pe.idpedido < p.idpedido
                                                                                                  and pe.idvendedora = p.idvendedora
                                                                                                  and pe.datacancelamento is null)) <= 0 )
                      or (:P416_PEDIDOANTERIOREMDIA = 'N' and ( select sum(vp.valorpagar - ( select sum(pg.valorpago)
                                                                                         from favorita.pagamentospedidos pg
                                                                                         where pg.idvencimentopedido = vp.idvencimentopedido
                                                                                           and pg.idsituacao = 20
                                                                                           and pg.datapagamento <= vp.datavencimento) )
                                                                from favorita.vencimentospedidos vp
                                                                where vp.idpedido = ( select max(pe.idpedido)
                                                                                                from favorita.pedidos pe
                                                                                                where pe.idpedido < p.idpedido
                                                                                                  and pe.idvendedora = p.idvendedora
                                                                                                  and pe.datacancelamento is null)) > 0 ))
                  and ( :P416_PEDIDOANTERIORSPC is null
                      or (:P416_PEDIDOANTERIORSPC = 'S' and ( select spp.spc_quantidade
                                                              from roman.consultaspc spp    
                                                              where spp.idconsultaspc = ( select max(sp.idconsultaspc)
                                                                                          from roman.consultaspc sp,
                                                                                               catal.vendedoras v,
                                                                                               catal.pessoas p
                                                                                          where sp.cpf = p.cpf
                                                                                            and p.idpessoa = v.idpessoa
                                                                                            and v.idvendedora = v.idvendedora)) >=1 )
                      or (:P416_PEDIDOANTERIORSPC = 'N' and ( select spp.spc_quantidade
                                                              from roman.consultaspc spp    
                                                              where spp.idconsultaspc = ( select max(sp.idconsultaspc)
                                                                                          from roman.consultaspc sp,
                                                                                               catal.vendedoras v,
                                                                                               catal.pessoas p
                                                                                          where sp.cpf = p.cpf
                                                                                            and p.idpessoa = v.idpessoa
                                                                                            and v.idvendedora = p.idvendedora)) <=0 ))
                  and p.saldodevedor > 0 
                  and not exists ( select 1
                                     from tarefas t
                                     where ( t.idtipotarefa = 4
                                          or t.idtipotarefa = 53 )
                                       and t.idpessoa     = p.idpessoa
                                       and t.idsituacao   in (0,10,20,30) )
                order by p.datavencimentomenor desc;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        messages {
            whenNoDataFound: Nenhum pedido encontrado, verifique os filtros!
        }

