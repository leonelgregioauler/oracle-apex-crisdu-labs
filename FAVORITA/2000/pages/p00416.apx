    process gera-tarefa-de-pedidos-vencidos (
        name: Gera Tarefa de Pedidos Vencidos
        type: executeCode
        editableRegion: @pedidos-vencidos
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidusuario  number := :P416_IDUSUARIO; 
                  vidpessoa   number;
                  vtelefone   varchar2(30) := null;
                  vcodigoarea number;
                  vexiste     varchar(1) := 'N';
                  vididioma   number;
                  --
                  vidtipotarefa number;
                  --
                begin
                  --
                  select f.ididioma
                  into vididioma 
                  from roman.vw_filiais f
                  where f.idfilial = :P416_IDFILIALROMANCE;
                  --
                  vidpessoa := :IDPESSOA;
                  --
                  if vididioma = 1 then
                    vidtipotarefa := 4;
                  else
                    vidtipotarefa := 53;
                  end if;
                  --
                  begin
                    select 'S'
                    into vexiste
                    from tarefas t
                    where t.idpessoa = vidpessoa
                      and t.idtipotarefa = vidtipotarefa
                      and t.idsituacao in (0,10,20,30);
                  exception
                    when others then
                      vexiste := 'N';
                  end;
                  --
                  begin
                    --
                    select translate(t.telefone,'0123456789AaBbCcDdEeFfGgHhIiJjKkLlMmNnOoPpQqRrSsTtUuVvXxYyWwZz_-,.  Ññ~ !@#$%?&*()/??','0123456789') telefone
                    into vtelefone
                    from tarefas t
                       , pedidos p
                    where p.idpedido = :IDPEDIDO
                      and p.idtarefa = t.idtarefa
                      -- só utiliza o telefone se o idpessoa da tarefa for o mesmo do pedido
                      and t.idpessoa = vidpessoa
                      -- -------------------------------------------------------------------
                      ;
                    --
                  exception
                    when others then
                      --
                      for i in ( select translate(t.telefone,'0123456789AaBbCcDdEeFfGgHhIiJjKkLlMmNnOoPpQqRrSsTtUuVvXxYyWwZz_-,.  Ññ~ !@#$%?&*()/??','0123456789') telefone
                                 from ROMAN.telefonespessoas t
                                 where t.idpessoa = vidpessoa
                                 order by t.idtelefonepessoa desc )
                      loop
                        --
                        vtelefone := i.telefone;
                        exit;
                        --
                      end loop;
                    --
                  end;
                  --
                  if vtelefone is not null and vexiste = 'N' then
                    --
                    insert into favorita.tarefas ( idtarefa            , datainclusao    , idsituacao
                                                 , observacao          , idtipotarefa    , idpessoa
                                                 , idgrupoatendimento  , telefone        , idusuario 
                                                 , idpais              , idpedido )
                    values ( favorita.seq_idtarefa.nextval,   sysdate,  0
                           , roman.pck_romance.fnc_retornatelefones(:IDVENDEDORA) , vidtipotarefa  , vidpessoa
                           , 4 , vtelefone , vidusuario
                           , vididioma     , :IDPEDIDO ); 
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Tarefas geradas com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1596477756713415927
        }
        serverSideCondition {
            type: request=Value
            value: GERAR_TAREFAS
        }
    )

    branch (
        name: Go To Page 416
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 416
                items: {
                    P416_IDFILIALROMANCE: &P416_IDFILIALROMANCE.
                    P416_IDREPRESENTANTE: &P416_IDREPRESENTANTE.
                    P416_IDUSUARIO: &P416_IDUSUARIO.
                    P416_DATAINICIO: &P416_DATAINICIO.
                    P416_DATAFIM: &P416_DATAFIM.
                    P416_FAIXAIDADE: &P416_FAIXAIDADE.
                    P416_FAIXAVALOR: &P416_FAIXAVALOR.
                    P416_PEDIDOANTERIOREMDIA: &P416_PEDIDOANTERIOREMDIA.
                    P416_PEDIDOANTERIORSPC: &P416_PEDIDOANTERIORSPC.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: BUSCAR
        }
    )

)

