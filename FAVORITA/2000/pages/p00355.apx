page 355 (
    name: Log de SAC
    title: Log de SAC
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region alterações-de-cadastro (
        name: Alterações de Cadastro
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select lc.idlog
                     , lc.usuarioalteracao
                     , lc.desctipoalteracao
                     , lc.dataalteracao
                     , lc.protocolo
                     , lc.nomecompleto
                     , lc.cpf
                     , lc.datanascimento
                     , lc.rua
                     , lc.nr
                     , lc.complemento
                     , lc.bairro
                     , lc.fone
                     , lc.fone2
                     , lc.email
                     , lc.mensagem
                     , lc.observacao
                     , lc.situacao
                     , lc.datacadastro
                     , lc.filial
                     , lc.representante
                     , lc.dataliberadofilial
                     , lc.datapassadorepres
                     , lc.observacaofilial
                     , lc.origemdesc
                     , lc.tipodesc
                     , lc.nroconsultaspc
                     , lc.usuariocadastrou
                     , lc.datacadastrorepresentante
                     , lc.observacaorepresentante
                from vw_logcontrolecontatossite_fav lc
                where lc.protocolo = :P355_IDSAC
                order by 1 desc
                ```
            pageItemsToSubmit: P355_IDSAC
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Cadastro Não Encontrado!
        }
        advanced {
            savedReportMappingIdentifier: 2139122877203213605
        }

