    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P355_IDSAC (
        type: textField
        label {
            label: Protocolo
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P355_IDSAC
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P355_IDSAC
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @alterações-de-cadastro
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

