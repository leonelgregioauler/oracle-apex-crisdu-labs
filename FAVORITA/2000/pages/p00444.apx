page 444 (
    name: Produtos/Códigos de Barras
    title: Produtos/Códigos de Barras
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region produtos-códigos-de-barras (
        name: Produtos/Códigos de Barras
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idprodutodetalhado
                       ,p.idproduto
                       ,p.produto as "Produto"
                       ,p.produtosemref as "Produto S/ Ref"
                       ,p.idcaracteristica
                       ,p.caracteristica as "Característica"
                       ,p.idcor
                       ,p.cor as "Cor"
                       ,p.idgrade
                       ,p.grade as "Grade"
                       ,p.idcodigobarra
                       ,nvl(to_char(p.codbarra),'Não Informado') as "Código de Barra"
                       ,p.ididioma
                       ,p.ativo as "Ativo"
                from vw_produtosdetalhados_fav p
                where p.ididioma = 1
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 40604475763140910
        }

        column Ativo (
            type: plainText
            heading {
                heading: Ativo
            }
            layout {
                sequence: 84
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: V
            }
        )

        column Característica (
            type: plainText
            heading {
                heading: Característica
            }
            layout {
                sequence: 54
            }
            source {
                dataType: varchar2
            }
            advanced {
