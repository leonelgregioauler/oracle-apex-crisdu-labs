    pageItem P644_A_PAGAR (
        type: textField
        label {
            label: Valor a Pagar
            alignment: left
        }
        layout {
            sequence: 30
            region: @vencimentos-a-prorrogar
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                /*select sum(nvl(vp.valorpagar,0)) - round((pe.valortotal * ca.desconto / 100) ,2)  
                              from favorita.pedidos              pe
                                 , favorita.vencimentospedidos   vp
                                 , favorita.campanhasadimplencia ca
                             where pe.idpedido           = vp.idpedido
                               and pe.idfilialromance    = ca.idfilial
                               and pe.idpedido           = :P644_IDPEDIDO
                               and trunc(pe.dataemissao) between ca.datainicio and ca.datafim
                               group by pe.valortotal
                                      , ca.desconto*/
                
                select sum(vp.valorpagar)
                from favorita.vencimentospedidos vp
                where vp.idpedido = :P644_IDPEDIDO
                  and vp.situacaovencimento = 'V'
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

