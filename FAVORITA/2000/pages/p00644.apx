                    sequence: 2
                }
            )

            displayColumn (
                column: @VALOR
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @DATAVENCIMENTO
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDPARCELASPRORROGAR
                layout {
                    sequence: 6
                }
            )

            displayColumn (
