    )

    validation data-zerada (
        name: Data Zerada
        execution {
            sequence: 40
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from parcelasprorrogar p
                where p.idusuario = favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))
                  and p.idprotocolo = :P644_IDPROTOCOLOATENDIMENTO
                  and  p.datavencimento is null;
                ```
        }
        error {
            errorMessage: Todos as DATAS precisam ser informadas, favor colocar a data e clicar em SALVAR antes de Gerar o financeiro.
        }
        serverSideCondition {
            type: request=Value
            value: GERARVENCIMENTO
        }
    )

    validation parcelas-menores-de (
        name: Parcelas Menores de 10
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from parcelasprorrogar p
                where p.idusuario = favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))
                  and p.idprotocolo = :P644_IDPROTOCOLOATENDIMENTO
                  and  p.valor < 10;
                ```
        }
        error {
            errorMessage: Parcelas não podem ser menores que R$10,00
        }
        serverSideCondition {
            type: request=Value
            value: GERARVENCIMENTO
        }
    )

    validation total-a-pagar (
        name: Total a Pagar
        execution {
            sequence: 10
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  vtotal number;
                  --
                begin
                  --
                  select sum(p.valor)
                    into vtotal
                  from parcelasprorrogar p
                  where p.idusuario = favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))
                    and p.idprotocolo = :P644_IDPROTOCOLOATENDIMENTO;
                  --
                  if :P644_A_PAGAR = vtotal then
                    --
                    return true;
                    --
                  else 
                    --
                    return false;
                    --
                  end if;
                  --
                end;
                ```
        }
        error {
            errorMessage: Valor total das parcelas não corresponde ao valor a pagar
        }
        serverSideCondition {
            type: request=Value
            value: GERARVENCIMENTO
        }
    )

    validation valor-zerado (
        name: Valor Zerado
        execution {
            sequence: 30
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from parcelasprorrogar p
                where p.idusuario = favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))
                  and p.idprotocolo = :P644_IDPROTOCOLOATENDIMENTO
                  and  p.valor is null;
                ```
        }
        error {
            errorMessage: Todos os VALORES precisam ser informados, favor colocar o valor e clicar em SALVAR antes de Gerar o financeiro.
        }
        serverSideCondition {
            type: request=Value
            value: GERARVENCIMENTO
        }
    )

    process gerar-o-vencimento (
        name: Gerar o Vencimento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vresult clob;
                  vpedido number;
                  verro  number ;
                  vmensagemerro varchar2(4000);
                  l_json        CLOB;
                  --
                begin
                  --
                  select pa.idpedido
                    into vpedido
                  from favorita.protocolosatendimentos pa
                  where pa.idprotocoloatendimento = :P644_IDPROTOCOLOATENDIMENTO;
                  --
                  vresult := pck_protocolosatendimentos_fav.prc_parcelasprorrogar_venc(pidprotocolo => :P644_IDPROTOCOLOATENDIMENTO);
                  --
                  favorita.pck_pedidos_fav.prc_gerafinaceiropedidojson( pidpedido     => vpedido
                                                                      , pidusuario    => :P0_IDUSUARIO
                                                                      , pjson         => vresult
                                                                      , verro         => verro
                                                                      , pmensagemerro => vmensagemerro);
                  --
                  --raise_application_error(-20010,'Errou - '||vmensagemerro);
                --registra novos boletos  
                    FOR r IN (
                        SELECT 
                            t.idpagamentopedido
                        FROM vw_vencimentospedidos_fav v
                        JOIN vw_pagamentospedidos_fav t
                          ON v.idvencimentopedido = t.idvencimentopedido
                        JOIN pedidos p on v.idpedido = p.idpedido
                        WHERE v.idpedido           = vpedido
                          AND t.ididioma           = :P0_IDIDIOMA
                          AND p.idpais = 1
                          and t.IDFORMAPAGAMENTO in (1,5,12,17,18,20,26,27,34,36,37,43,44,46,47,48,66) --boleto
                          and v.CODSITUACAOVENCIMENTO = 'V'
                    )
                    LOOP
                
                        BEGIN
                
                            pck_integracao_bb_v2.prc_registra_boleto(
                                p_idpagamentopedido => r.idpagamentopedido,
                                r_json              => l_json
                            );
                
                        EXCEPTION
                            WHEN OTHERS THEN
                
                                DBMS_OUTPUT.PUT_LINE(
                                    'Erro ao reprocessar boleto ' ||
                                    r.idpagamentopedido || ' - ' || SQLERRM
                                );
                
                        END;
                
                    END LOOP;
                  --
                exception 
                  when others then
                    --
                     raise_application_error(-20010,'Favor Abrir um ticket com a mensagem - '||DBMS_UTILITY.FORMAT_ERROR_BACKTRACE||' - sqlerrm - '||sqlerrm||' - vresult -'||vresult);
                    --
                end;    
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Gerado o Vencimento com sucesso
        }
        error {
            errorMessage: Erro ao gerar o Vencimento
        }
        advanced {
            executionMappingIdentifier: 3075359699811310760
        }
        serverSideCondition {
            type: request=Value
            value: GERARVENCIMENTO
        }
    )

    process vencimentos-a-prorrogar-save-interactive-grid-data (
        name: Vencimentos a Prorrogar - Save Interactive Grid Data
        type: executeCode
        editableRegion: @vencimentos-a-prorrogar-2
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vexist number;
                  vuser  number := favorita.pck_util_fav.fnc_idusuario(v('APP_USER'));
                  --
                  vmd5              varchar2(4000);
                  vmensagem         varchar2(4000);
                  --
                begin  
                     case :APEX$ROW_STATUS  
                     when 'C' then
                       --
                       favorita.PCK_CADASTROS_FAV.prc_parcelasprorrogar ( pidparcelasprorrogar => :idparcelasprorrogar
                                                                        , pidprotocolo         => :P644_IDPROTOCOLOATENDIMENTO
                                                                        , pidusuario           => vuser
                                                                        , pparcela             => :parcela
                                                                        , pvalor               => :valor
                                                                        , pdatavencimento      => :datavencimento
                                                                        , pmd5                 => vmd5
                                                                        , poperacao_dml        => 'I');
                       --
                     when 'U' then  
                       --
                       favorita.PCK_CADASTROS_FAV.prc_parcelasprorrogar ( pidparcelasprorrogar => :idparcelasprorrogar
                                                                        , pidprotocolo         => :P644_IDPROTOCOLOATENDIMENTO
                                                                        , pidusuario           => vuser
                                                                        , pparcela             => :parcela
                                                                        , pvalor               => :valor
                                                                        , pdatavencimento      => :datavencimento
                                                                        , pmd5                 => vmd5
                                                                        , poperacao_dml        => 'U');
                       --
                     when 'D' then  
                       --
                       favorita.PCK_CADASTROS_FAV.prc_parcelasprorrogar ( pidparcelasprorrogar => :idparcelasprorrogar
                                                                        , pidprotocolo         => :P644_IDPROTOCOLOATENDIMENTO
                                                                        , pidusuario           => vuser
                                                                        , pparcela             => :parcela
                                                                        , pvalor               => :valor
                                                                        , pdatavencimento      => :datavencimento
                                                                        , pmd5                 => vmd5
                                                                        , poperacao_dml        => 'D');
                       --
                     end case;  
                exception
                  when others then
                    --
                    null;
                    --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 3075357602030310771
        }
    )

)

