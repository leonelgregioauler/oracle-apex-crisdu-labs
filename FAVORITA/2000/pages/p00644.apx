page 644 (
    name: Prorrogar/Alterar Vencimento Especial
    title: Prorrogar/Alterar Vencimento Especial
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 60%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region vencimentos-a-prorrogar (
        name: Vencimentos a Prorrogar
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region vencimentos-a-prorrogar-2 (
        name: Vencimentos a Prorrogar
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idparcelasprorrogar
                     , p.idprotocolo
                     , p.idusuario
                     , p.valor
                     , p.datavencimento
                from parcelasprorrogar p
                where p.idusuario = favorita.pck_util_fav.fnc_idusuario(v('APP_USER'))
                  and p.idprotocolo = :P644_IDPROTOCOLOATENDIMENTO;
                ```
        }
        layout {
            sequence: 10
            parentRegion: @vencimentos-a-prorrogar
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 3083047212091291255
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDUSUARIO
