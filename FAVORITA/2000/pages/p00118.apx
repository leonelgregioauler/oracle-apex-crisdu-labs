page 118 (
    name: Impressão de Pedidos Remessas
    title: Impressão de Pedidos Remessas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function imprime()
            {
               var idcomp         = document.getElementById("P118_IDCOMPRATRANSFERENCIA").value;
               var iddistribuidor = document.getElementById("P118_IDDISTRIBUIDOR").value;
               var quantidade     = document.getElementById("P118_QUANTIDADE").value;
               var promissoria    = $v("P118_PROMISSORIA");
               var boleto         = $v("P118_BOLETO");
               var ordenacao      = $v("P118_ORDENACAO");
               var tipo           = document.getElementById("P118_TIPO").value;
               var idusuario      = document.getElementById("P0_IDUSUARIO").value;
               
               $(".imprimirpedidos").hide();
                
               setInterval(function() {
                 $(".imprimirpedidos").show();
               }, 8000);
               
               apex.message.confirm('Confirma a impressão dos pedidos?', function(simnao) {
                 if (simnao) {
                   pjanela = window.open('f?p=&APP_ID.:128:&SESSION.::NO::P128_IDCOMPRATRANSFERENCIA,P128_IDDISTRIBUIDOR,P128_QUANTIDADE,P128_PROMISSORIA,P128_BOLETO,P128_ORDENACAO,P128_TIPO,P128_IDUSUARIO:'+idcomp+','+iddistribuidor+','+quantidade+','+promissoria+','+boleto+','+ordenacao+','+tipo+','+idusuario,'page','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1280,height=1024,left=20,top=10','_blank');
                   pjanela.focus(); 
                 } 
                 else {
                    $(".imprimirpedidos").show();
                 }
                 
               });
                                       
            }
            
            function retornaSelecionado_old(nome) {
             var resultado;
             document.getElementsByName(nome).forEach(function(item){if (item.checked) resultado = item.value}); 
             return resultado;
            }
            
            function retornaSelecionado(nome) {
            var e = document.getElementById(nome);
            var resultado = e.options[e.selectedIndex].value;
                
             return resultado;
            }
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P118_BOLETO (
        type: radioGroup
        label {
            label: Boleto
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC:Sim;1,Não;2
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 100
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: 2
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P118_IDCOMPRATRANSFERENCIA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P118_IDDISTRIBUIDOR (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(idrepresentante) display_value
                 , idrepresentante return_value
                from representantes
                where idgerente = ( select idgerente 
                                    from gerentes 
                                    where idfilial = ( select idfilialromancedestino
                                                       from comprastransferencias
                                                       where idcompratransferencia = :P118_IDCOMPRATRANSFERENCIA) )
                  and ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P118_NR_PAGE_BRANCH (
        type: hidden
        layout {
            sequence: 150
            region: @filtros
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P118_ORDENACAO (
        type: radioGroup
        label {
            label: Ordenação
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Consultora;28,Distribuidor;27,Valor;20
            displayExtraValues: false
            nullDisplayValue: Nenhum
            nullReturnValue: 99
        }
        layout {
            sequence: 120
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: 99
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P118_PAGINA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
        }
        default {
            type: static
            staticValue: 118
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P118_PROMISSORIA (
        type: radioGroup
        label {
            label: Promissoria
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC:Sim;1,Não;2
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: 2
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P118_QUANTIDADE (
        type: selectList
        label {
            label: Qtd Impressão
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:10;10,20;20,30;30
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 110
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P118_SESSION_IMPRIME (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_url varchar2(2000);
                    l_app number := 2000;
                    l_session number := v('APP_SESSION');
                BEGIN
                    l_url := APEX_UTIL.PREPARE_URL(
                        p_url => 'f?p=' || l_app || ':128:'||l_session||'::NO::P128_IDCOMPRATRANSFERENCIA,P128_IDDISTRIBUIDOR,P128_QUANTIDADE,P128_ETIQUETAGERADA,P128_ORDENACAO,P128_TIPO:'||:P118_IDCOMPRATRANSFERENCIA||','||:P118_IDDISTRIBUIDOR||','||:P118_QUANTIDADE||','||:P118_ETIQUETAGERADA||','||:P118_ORDENACAO||','||:P118_TIPO,
                        p_checksum_type => 'SESSION');
                    
                    return l_url;
                END;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P118_TIPO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 140
            region: @filtros
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button imprimirpedidos (
        buttonName: IMPRIMIRPEDIDOS
        label: Imprimir Pedidos
        layout {
            sequence: 20
            region: @filtros
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            cssClasses: imprimirpedidos
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: imprime();
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P118_TIPO = 'I'
        }
    )

    button reimprimirpedidos (
        buttonName: REIMPRIMIRPEDIDOS
        label: Reimprimir Pedidos
        layout {
            sequence: 30
            region: @filtros
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 338
                items: {
                    P338_IDCOMPRATRANSFERENCIA: &P118_IDCOMPRATRANSFERENCIA.
                    P338_IDDISTRIBUIDOR: &P118_IDDISTRIBUIDOR.
                    P338_QUANTIDADE: &P118_QUANTIDADE.
                    P338_PROMISSORIA: &P118_PROMISSORIA.
                    P338_BOLETO: &P118_BOLETO.
                    P338_TIPO: &P118_TIPO.
                    P338_ORDENACAO: &P118_ORDENACAO.
                }
                clearCache: 338
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P118_TIPO = 'R'
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 40
            region: @filtros
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction seta-promissoria (
        name: Seta_Promissoria
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P118_IDCOMPRATRANSFERENCIA
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select 1
                      from comprastransferencias c
                         , filiaisfavorita       f
                     where c.idcompratransferencia = :P118_IDCOMPRATRANSFERENCIA
                       and c.idfilialfavoritaorigem = f.idfilialfavorita
                       and f.idpais in (2,4) ;
                    ```
                itemsToSubmit: P118_IDCOMPRATRANSFERENCIA
            }
            affectedElements {
                selectionType: items
                items: P118_PROMISSORIA
            }
            execution {
                sequence: 10
            }
        )

    )

    validation quantidade-inteiro (
        name: QUANTIDADE inteiro
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  verro varchar2(1000);
                begin
                  if instr(:P118_QUANTIDADE, ',') > 0 or
                     instr(:P118_QUANTIDADE,'.') > 0 then
                    --
                    return 'Quantidade deve ser um número inteiro';
                    --
                  else
                    null;
                  end if;
                end;
                ```
        }
        error {
            associatedItem: @P118_QUANTIDADE
        }
    )

    validation quantidade-maior-que (
        name: QUANTIDADE maior que 0
        execution {
            sequence: 20
        }
        validation {
            plsqlExpression: :P118_QUANTIDADE > 0
        }
        error {
            errorMessage: Quantidade deve ser maior que zero (0)
            associatedItem: @P118_QUANTIDADE
        }
        serverSideCondition {
            type: expression
            plsqlExpression: instr(:P118_QUANTIDADE, '.') = 0
        }
    )

    branch (
        name: Branch Voltar
        execution {
            sequence: 10
        }
        behavior {
            type: functionReturningUrl
            plsqlFunctionBody:
                ```plsql
                -- Created on 10/09/2020 by MAX.BERKEUER 
                declare 
                  --
                  vurl varchar2(3000);
                  vpagina number := :P118_NR_PAGE_BRANCH;
                  --
                begin
                  --
                  if vpagina = 464 then
                    --
                    vurl := apex_util.prepare_url('f?p=&APP_ID.:'||vpagina||':&SESSION.::NO::P464_IDCOMPRATRANSFERENCIA:'||:P118_IDCOMPRATRANSFERENCIA);
                    --
                  elsif vpagina = 74 then
                    --
                    vurl := apex_util.prepare_url('f?p=&APP_ID.:'||vpagina||':&SESSION.::NO::P74_IDCOMPRATRANSFERENCIA:'||:P118_IDCOMPRATRANSFERENCIA);
                    --
                  end if;
                  --
                  return vurl;
                  --
                end;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @voltar
        }
    )

)

