    pageItem P646_FILIAL (
        type: popupLov
        label {
            label: <b>Filial Favorita</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct(pck_util_fav.fnc_nomefilialfavorita(f.idfilialfavorita)) as display_value
                     , f.idfilialfavorita                                                as return_value
                  from favorita.filiaisfavorita f
                 where f.tipofilial = 'L'
                   and (   pck_util.fnc_verificaacesso(58312,v('APP_USER')) = 'S' /* Se tiver acesso liberado consulta todas as lojas favorita.*/
                        or f.idfilialfavorita = (select u.Idfilialfavorita from catal.usuarios u where u.usuario = v('APP_USER'))); 
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P646_PRODUTO (
        type: popupLov
        label {
            label: <b>Produto</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nomeproduto as displayValue
                     , p.idproduto   as RetornValue
                from favorita.produtos p
                order by p.nomeproduto
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

