    region ciclos-de-venda (
        name: Ciclos de venda
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select aux.loja
                     , aux.produto
                     , sum(aux.disponivel) disponivel
                     , sum(aux.quantidadevendida) quantidadevendida
                     , round(roman.pck_romance.FNC_DIVISOR_ZERO( sum(aux.disponivel), sum(aux.quantidadevendida)),2) cobertura
                    -- , round(sum(aux.disponivel) / sum(aux.quantidadevendida),2) cobertura
                     , sum(aux.disp_cd_abastecedor) disp_cd_abastecedor
                     , (select cc.nomecategoria
                        from favorita.produtos p
                            , favorita.vw_categoriassite_fav cc
                            , favorita.vw_categorias_fav c
                        where p.idproduto = aux.idproduto
                          and c.idcategoriasite = cc.idcategoriasite (+)
                          and c.idcategoria = p.idcategoria
                        and rownum=1) as "Categoria Site" --T10905630
                  from ( select x.idproduto
                              , (select initcap(p.nomeproduto) from favorita.produtos p where p.idproduto = x.idproduto) as produto
                              , x.disponivel
                              , x.quantidadevendida
                              , round((x.disponivel / x.quantidadevendida),2) cobertura
                              , favorita.pck_util_fav.fnc_nomefilialfavorita(x.filial) loja
                              , disp_cd_abastecedor
                              , favorita.pck_util_fav.fnc_nomeprodutodetalhado(x.idprodutodetalhado,1) as "Produto Detalhado"
                           from ( select p.idproduto
                                       , favorita.pck_util_fav.fnc_nomeproduto(p.idproduto,1,'S') nomeproduto
                                       , sum(favorita.pck_estoque_fav.fnc_estoquedisponivel(pidestoque => e.idestoque))  disponivel 
                                       , nvl(sum( venda.quantidadevendida ),0) quantidadevendida
                                       , venda.idfilialfavorita_est filial
                                       , p.idprodutodetalhado
                                       , ( select favorita.pck_estoque_fav.fnc_estoquedisponivel(pidestoque => et.idestoque)
                                             from atendimentosestoques ae
                                                , filiaisfavorita fav
                                                , estoques et
                                            where ae.idfilialfavoritadestino = venda.idfilialfavorita_est 
                                              and fav.idfilialfavorita = ae.idfilialfavoritaorigem
                                              and et.idfilialfavorita = ae.idfilialfavoritaorigem
                                              and et.idprodutodetalhado = p.idprodutodetalhado
                                              and fav.tipofilial = 'E' ) disp_cd_abastecedor
                                    from ( select w.idproduto filial
                                                , w.idprodutodetalhado       
                                                , w.idestoque idestoque
                                                , sum( w.quantidadevendida ) quantidadevendida
                                                , w.idfilialfavorita_est
                                             from favorita.mv_itensvendidos_fav w
                                            where (:P646_PRODUTO is null or w.idproduto = :P646_PRODUTO) 
                                              and (     ( w.idfilialfavorita_est = :P646_FILIAL and pck_util.fnc_verificaacesso(58312,v('APP_USER')) = 'S')
                                                    or  ( w.idfilialfavorita_est = :P646_FILIAL and w.idfilialfavorita_est = ( select f.idfilialfavorita
                                                                                                                                 from favorita.filiaisfavorita f
                                                                                                                                 where f.tipofilial = 'L' 
                                                                                                                                   and f.idfilialfavorita = ( select u.Idfilialfavorita
                                                                                                                                                                from catal.usuarios u 
                                                                                                                                                               where u.usuario = v('APP_USER')))))
                                              and w.dataemissao between :P646_DATA_INICIO and :P646_DATA_FIM
                                            group by w.idproduto
                                                   , w.idprodutodetalhado
                                                   , w.idestoque
                                                   ,w.idfilialfavorita_est ) venda
                              , favorita.estoques e
                              , favorita.produtosdetalhados p
                          where e.idestoque  = venda.idestoque
                            and e.idprodutodetalhado  = p.idprodutodetalhado
                            and (:P646_PRODUTO is null or p.idproduto = :P646_PRODUTO)
                            and (    e.idfilialfavorita = :P646_FILIAL and pck_util.fnc_verificaacesso(58312,v('APP_USER')) = 'S' 
                                  or e.idfilialfavorita = :P646_FILIAL and e.idfilialfavorita = ( select f.idfilialfavorita
                                                                                                    from favorita.filiaisfavorita f
                                                                                                   where f.tipofilial = 'L' 
                                                                                                     and f.idfilialfavorita = ( select u.Idfilialfavorita
                                                                                                                                  from  catal.usuarios u 
                                                                                                                                 where u.usuario = v('APP_USER') ))) 
                          group by p.idproduto
                                 , p.idprodutodetalhado
                                 , venda.idfilialfavorita_est ) x 
                     ) aux
                 group by aux.loja
                        , aux.idproduto
                        , aux.produto
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 45692094078105939
        }

