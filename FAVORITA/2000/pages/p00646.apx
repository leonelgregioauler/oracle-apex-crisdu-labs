    validation valida-campo-filial (
        name: Valida Campo Filial
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P646_FILIAL
        }
        error {
            errorMessage: A loja precisa ser selecionada!
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

    process inicializa-campos (
        name: inicializa campos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                    -- data inicial
                    select to_char(x.dt_ini,'DD/MM/YYYY')
                      into :P646_DATA_INICIO
                      from roman.semana_dias x 
                     where x.idsemana = ( select s.idsemana - 5
                                            from roman.semana_dias s
                                           where trunc(sysdate) between s.dt_ini and s.dt_fim );
                
                    -- data final
                    select to_char(x.dt_fim,'DD/MM/YYYY')
                      into :P646_DATA_FIM
                      from roman.semana_dias x 
                     where x.idsemana = ( select s.idsemana 
                                            from roman.semana_dias s
                                           where trunc(sysdate) between s.dt_ini and s.dt_fim );
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 45691534708105934
        }
    )

)

