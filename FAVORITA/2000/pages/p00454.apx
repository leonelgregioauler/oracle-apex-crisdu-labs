    pageItem P454_DATA_FIM (
        type: datePickerJquery
        label {
            label: Data Final
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            formatMask: DD/MM/YYYY
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P454_DATA_INI (
        type: datePickerJquery
