        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation valida-campos-de-data (
        name: Valida campos de data
        execution {
            sequence: 10
        }
        validation {
            language: sql
            sqlExpression: to_date(:P454_DATA_INI,'dd/mm/rrrr') <= to_date(:P454_DATA_FIM,'dd/mm/rrrr')
        }
        error {
            errorMessage: Data inicial precisa ser menor ou igual a data final!
        }
    )

    validation valida-tempo-de-filtro-d (
        name: Valida tempo de filtro d
        execution {
            sequence: 20
        }
        validation {
            language: sql
            sqlExpression: (to_date(:P454_DATA_FIM) - to_date(:P454_DATA_INI)) <= 90
        }
        error {
            errorMessage: O intervalo entre as data não pode ser maior que noventa dias!
        }
        serverSideCondition {
            type: never
        }
    )

)

