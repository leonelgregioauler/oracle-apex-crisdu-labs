page 454 (
    name: Itens Vendidos Favorita Paris
    title: Itens Vendidos Favorita Paris
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @opções
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region itens-vendidos-favorita-paris (
        name: Itens Vendidos Favorita Paris
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.iditempedido,
                       p.idpedido as "Nr Pedido",
                       se.descricaosistema as "Situaçao Entrega",
                       sf.descricaosistema as "Situação Financeiro",
                       pck_util_fav.fnc_nomerepresentante(p.idrepresentante) as "Representante",
                       pck_util_fav.fnc_nomevendedora(p.idvendedora) as "Cliente",
                       p.dataemissao as "Dt Emissão",
                       i.idprodutodetalhado as "Cod Prod Det",
                       pck_util_fav.fnc_nomeprodutodetalhado(i.idprodutodetalhado,1) as "Produto Det",
                       i.quantidade as "Quantidade",
                       i.valorvenda as "Vlr Venda",
                       i.valordesconto as "Desconto",
                       i.valorapagar as "Vlr Pagar",
                       pck_util_fav.fnc_nomefilialfavorita(p.idfilialfavorita) as "Filial Favorita"
                from itenspedidos i,
                     pedidos p,
                     situacoesentrega se,
                     situacoesfinanceiro sf
                where i.idpedido = p.idpedido
                  and p.idsituacaoentrega = se.idsituacaoentrega
                  and p.idsituacaofinanceiro = sf.idsituacaofinanceiro
                  and exists ( select 1
                               from favorita.classificacoesprodutos cp
                               where cp.idtagproduto = 24
                                 and cp.idprodutodetalhado = i.idprodutodetalhado)
                  and not exists (select 1  /*Remove pedidos cancelados*/
                                  from classificacoespedidos cf
                                  where cf.idpedido = p.idpedido
                                    and cf.idcaracteristicapedido = 25)
                  and p.dataemissao between to_date(:P454_DATA_INI||' 00:00:00','DD/MM/YYYY HH24:MI:SS') and to_date(:P454_DATA_FIM||' 23:59:59','DD/MM/YYYY HH24:MI:SS')
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P454_DATA_INI is not null and :P454_DATA_FIM is not null
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 119804132893766197
        }

