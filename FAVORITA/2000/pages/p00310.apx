    region indicações-pendentes-resumida (
        name: Indicações Pendentes Resumida
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(ind.idfilial) empresa
                     , roman.pck_romance.fnc_nomerepresentante(ind.idrepresentante) distribuidor
                     , count(1) quantidade
                     , case
                         when exists ( select 1
                                       from roman.notificacoesdistribuidores nd
                                       where nd.titulo = 'Indicacoes Pendentes'
                                         and trunc(nd.datainclusao) between trunc(sysdate)-7 and trunc(sysdate)
                                         and nd.idpessoa = ( select idpessoa
                                                             from representantes r
                                                             where r.idrepresentante = ind.idrepresentante ) ) then
                           'Notificação enviada nos últimos 7 dias'
                         else
                           '<a href="javascript:apex.confirm(''Confirma o envio da Notificação? '', 
                             { request:''NOTIFICACAO'', set:{''P310_IDNOTIFICACAO'':'||idrepresentante||' }} )";><img src="#APP_IMAGES#ok.png"  border="0"></a>'  
                       end enviarnotificacao
                from roman.vw_indicacoes_tablet ind
                where ( :P310_IDFILIAL is null or ind.idfilial = :P310_IDFILIAL )
                  and ( :P310_IDREPRESENTANTE is null or ind.idrepresentante = :P310_IDREPRESENTANTE )
                  and :P310_TIPO = 'R' 
                group by ind.idfilial , ind.idrepresentante
                order by 1 , 2
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P310_TIPO
            value: R
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1497776054961920543
        }

