    region indicações-pendentes-detalhadas (
        name: Indicações Pendentes Detalhadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(ind.idfilial) empresa
                     , roman.pck_romance.fnc_nomerepresentante(ind.idrepresentante) distribuidor
                     , ind.idcontrolecontatossite protocolo
                     , ind.nomecompleto
                     , ind.cpf
                     , ind.datanascimento
                     , ind.rua||' Nr '||ind.nr
                     , ind.bairro
                     , roman.pck_romance.fnc_nomecidade(ind.idcidade) cidade
                     , ind.cep
                     , ind.fone
                     , ind.email
                     , ind.descricaosituacao situacao
                     , ind.datapassadorepres
                     , ind.origemdesc origem
                     , ind.tiposolicitacaosac tipo
                     , ind.datacadastro
                from roman.vw_indicacoes_tablet ind
                where ind.idfilial = :P310_IDFILIAL 
                  and ( :P310_IDREPRESENTANTE is null or ind.idrepresentante = :P310_IDREPRESENTANTE )
                  and :P310_TIPO = 'D' 
                order by 3 desc
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P310_TIPO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1500149758162599103
