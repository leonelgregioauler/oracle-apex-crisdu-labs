            warnOnUnsavedChanges: doNotCheck
        }
    )

    process envia-notificação (
        name: Envia Notificação
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidnotificacao       number := null;
                  vidpessoarepres      number;
                  vidpedido            number := null;
                  vtiponotificacao     varchar(1) := 'A';
                  vtitulo              varchar2(100);
                  vmensagem            varchar2(1000);
                  vtiposomnotificacao  number := 1;
                  vdata                date := sysdate;
                  vquantidade          number;
                  --
                begin
                  --
                  select idpessoa
                  into vidpessoarepres
                  from representantes r
                  where r.idrepresentante = :P310_IDNOTIFICACAO;
                  --
                  begin
                    --
                    select count(1)
                    into vquantidade
                    from roman.vw_indicacoes_tablet it
                    where it.idrepresentante = :P310_IDNOTIFICACAO;
                    --
                  exception
                    when others then
                      vquantidade := 0;
                  end;
                  --
                  vtitulo := 'Indicacoes Pendentes';
                  vmensagem := 'Você possui '||vquantidade||' de indicações aguardando o cadastro!';
                  --
                  if vquantidade > 0 then
                    --
                    roman.pck_integracao_mob.prc_notificacoesdistribuidores(pidnotificacao      => vidnotificacao,
                                                                            pidpessoa           => vidpessoarepres,
                                                                            pidpedido           => vidpedido,
                                                                            ptiponotificacao    => vtiponotificacao,
                                                                            ptitulo             => vtitulo,
                                                                            pmensagem           => vmensagem,
                                                                            ptiposomnotificacao => vtiposomnotificacao,
                                                                            pidfilial           => null,
                                                                            pdatainclusao       => vdata,
                                                                            pdataenvio          => null,
                                                                            pdatarecebimento    => null,
                                                                            pdataleitura        => null,
                                                                            poperacao_dml       => 'I');
                    --
                    commit;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Notificação Enviada com Sucesso!
        }
        advanced {
            executionMappingIdentifier: 1497776712686920550
        }
        serverSideCondition {
            type: request=Value
            value: NOTIFICACAO
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 310
                items: {
                    P310_IDFILIAL: &P310_IDFILIAL.
                    P310_IDREPRESENTANTE: &P310_IDREPRESENTANTE.
                    P310_TIPO: &P310_TIPO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: FILTRAR
        }
    )

)

