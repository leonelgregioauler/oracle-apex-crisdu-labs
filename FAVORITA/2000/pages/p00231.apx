page 231 (
    name: Log de Pedidos
    title: Log de Pedidos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region logs-de-pedido (
        name: Logs de Pedido
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select vw.idlog
                     , vw.numeropedido
                     , vw.usuarioalteracao
                     , vw.desctipoalteracao
                     , vw.dataalteracao
                     , vw.edicaorevista
                     , vw.filialfavorita
                     , vw.filialromance
                     , vw.representante
                     , vw.vendedora
                     , vw.nomeusuario
                     , vw.situacaoentrega
                     , vw.situacaofinanceiro
                     , vw.situacaocobranca
                     , vw.dataemissao
                     , vw.dataentrega
                     , vw.datadespacho
                     , vw.datacancelamento
                     , vw.valortotalcusto
                     , vw.valortotal
                     , vw.valorpontoutilizado
                     , vw.valordesconto
                     , vw.valortotalcomdesconto
                     , vw.valorfrete
                     , vw.valorapagar
                     , vw.numeroposicaoatendimento
                from vw_logpedidos_fav vw
                where vw.ididioma = 1
                  and vw.idpedido = :P231_IDPEDIDO
                order by 4 desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1623720734501219635
        }

