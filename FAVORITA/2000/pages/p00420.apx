page 420 (
    name: SAC V2
    title: SAC V2
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region sac-v (
        name: SAC V2
        type: list
        source {
            list: @sac-v
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            listTemplate: @/cards
            templateOptions: [
                t-Cards--featured force-fa-lg
                t-Cards--displayIcons
                t-Cards--5cols
                u-colors
                t-Cards--animColorFill
            ]
        }
    )

)

