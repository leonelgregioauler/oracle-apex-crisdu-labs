page 55 (
    name: Cadastro de Atendimentos Estoques
    title: Atendimentos Estoques
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region atendimentos-estoques (
        name: Atendimentos Estoques
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                  select idatendimentoestoque
                       , idfilialfavoritaorigem
                       , idfilialfavoritadestino
                  from atendimentosestoques
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        messages {
            whenNoDataFound: Não encontrou informações.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 3313383325096028
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDATENDIMENTOESTOQUE
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDFILIALFAVORITAORIGEM
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDFILIALFAVORITADESTINO
                layout {
                    sequence: 3
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column IDATENDIMENTOESTOQUE (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDATENDIMENTOESTOQUE
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: seq_idatendimentoestoque
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDFILIALFAVORITADESTINO (
            type: selectList
            heading {
                heading: Filiais Favorita Destino
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) as d,
                           idfilialfavorita as r
                      from filiaisfavorita f
                     where f.ativo = 'S'
                     order by 1
                    ```
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: IDFILIALFAVORITADESTINO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDFILIALFAVORITAORIGEM (
            type: selectList
            heading {
                heading: Filiais Favorita Origem
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) as d,
                           idfilialfavorita as r
                      from filiaisfavorita f
                    where f.ativo = 'S'
                     order by 1
                    ```
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IDFILIALFAVORITAORIGEM
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

    )

    validation filialorigemdestino-unique (
        name: FILIALORIGEMDESTINO unique
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @atendimentos-estoques
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidfilialfavoritaorigem number;
                  vidfilialfavoritadestino number;
                begin
                  select idfilialfavoritaorigem
                       , idfilialfavoritadestino
                  into vidfilialfavoritaorigem
                     , vidfilialfavoritadestino
                  from atendimentosestoques
                  where idfilialfavoritaorigem = :IDFILIALFAVORITAORIGEM
                  and idfilialfavoritadestino = :IDFILIALFAVORITADESTINO;
                  --
                  if vidfilialfavoritaorigem is not null and vidfilialfavoritadestino is not null then
                    return 'Existe um cadastro no sistema com estas informações. Não são permitidas informações repetidas para este cadastro.';
                  end if;
                  --
                exception
                  when no_data_found then
                    return '';
                end;
                ```
        }
        error {
            associatedColumn: IDFILIALFAVORITADESTINO
        }
    )

    validation idfilialfavoritadestino-obrigatório (
        name: IDFILIALFAVORITADESTINO obrigatório
        execution {
            sequence: 20
        }
        validation {
            editableRegion: @atendimentos-estoques
            type: columnIsNotNull
            column: IDFILIALFAVORITADESTINO
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ter um valor.
            associatedColumn: IDFILIALFAVORITADESTINO
        }
    )

    validation idfilialfavoritaorigem-obrigatório (
        name: IDFILIALFAVORITAORIGEM obrigatório
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @atendimentos-estoques
            type: columnIsNotNull
            column: IDFILIALFAVORITAORIGEM
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ter um valor.
            associatedColumn: IDFILIALFAVORITAORIGEM
        }
    )

    process save-interactive-grid-data (
        name: " - Save Interactive Grid Data"
        type: interactiveGridAutoRowProcessing
        editableRegion: @atendimentos-estoques
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 3316916791096030
        }
    )

)

