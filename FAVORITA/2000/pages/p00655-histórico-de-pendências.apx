page 655 (
    name: HIstórico de Pendências
    alias: HISTÓRICO-DE-PENDÊNCIAS
    title: HIstórico de Pendências
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region histórico-de-pendências (
        name: Histórico de Pendências
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rs.nomeassociado
                     , TRIM(SUBSTR(rs.estado, 1, INSTR(rs.estado, ' /') - 1)) AS cidade
                     , TRIM(SUBSTR(rs.estado, INSTR(rs.estado, ' /') + 2)) AS estado
                     , rs.datavencimento
                     , rs.datainclusao
                     , rs.tipo
                     , rs.valor
                from roman.restricoesconsultaspc rs
                where rs.idconsultaspc = :P655_IDCONSULTASPC
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 375204049957518234
        }

        column CIDADE (
            type: plainText
            heading {
                heading: Cidade
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column DATAINCLUSAO (
            type: plainText
            heading {
                heading: Data de Inclusão
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        column DATAVENCIMENTO (
            type: plainText
            heading {
                heading: Data de Vencimento
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: Estado
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column NOMEASSOCIADO (
            type: plainText
            heading {
                heading: Origem
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column TIPO (
            type: plainText
            heading {
                heading: Tipo Vinculo
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column VALOR (
            type: plainText
            heading {
                heading: Valor Total
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 3752634 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CIDADE (
                sequence: 2
            )

            displayColumn DATAINCLUSAO (
                sequence: 5
            )

            displayColumn DATAVENCIMENTO (
                sequence: 4
            )

            displayColumn ESTADO (
                sequence: 3
            )

            displayColumn NOMEASSOCIADO (
                sequence: 1
            )

            displayColumn TIPO (
                sequence: 6
            )

            displayColumn VALOR (
                sequence: 7
            )

        )

    )

    pageItem P655_IDCONSULTASPC (
        type: hidden
        layout {
            sequence: 30
            slot: body
        }
    )

)

