page 294 (
    name: Lista de Pagamentos da Semana
    title: Lista de Pagamentos da Semana
    appearance {
        pageTemplate: @/minimal-no-navigation
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region entradas-diversas (
        name: Entradas Diversas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.semanaf semana
                     , e.data
                     , e.valortotal
                     , e.tipoentrada
                     , e.DESCRICAOORIGEM
                from roman.vw_entradas_distribuidoras e
                where e.idfechamento = :P294_IDFECHAMENTO
                order by e.data desc
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 2917127423438287402
        }

