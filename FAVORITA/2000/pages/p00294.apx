    region pagamentos-da-semana (
        name: Pagamentos da Semana
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.idpedido
                     , v.codpagamento
                     , v.datapagamento
                     , v.formapagamento
                     , v.situacaopagamento
                     , v.origempagamento
                     , v.valorrecebido valorpago
                     , case
                         when v.idformapagamento = 23 then
                           'Sim'
                         when exists ( select 1 
                                       from favorita.pedidos p
                                       where p.idpedido = v.idpedido 
                                         and p.idpedidovirtualage is not null ) then
                           'Sim'
                         when not exists ( select 1 
                                           from favorita.pedidos p
                                           where p.idpedido = v.idpedido 
                                             and p.idpedidovirtualage is not null ) then
                           'Não'
                       end virtualage
                from favorita.vw_pagamentosfechamentos_fav v
                where v.idfechamento = :P294_IDFECHAMENTO
                  and v.ididioma = 1
                  and v.idsituacao = 20
                  and v.valorpago > 0
                  and not exists (select 1
                                  from favorita.pedidos pp
                                  where pp.idpedido = v.idpedido 
                                    and pp.idvendedora = 2363887)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1384664161068232228
        }

