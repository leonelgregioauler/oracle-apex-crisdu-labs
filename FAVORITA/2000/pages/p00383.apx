page 383 (
    name: Cadastro de Cidades Atendidas
    title: Cadastro de Cidades Atendidas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-de-cidades-atendidas (
        name: Cadastro de Cidades Atendidas
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P383_IDCIDADE (
        type: popupLov
        label {
            label: Cidade
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(c.nomecidade)||'/'||e.sigla d
                     , c.idcidade r
                from roman.cidades c
                   , roman.estados e
                where c.idestado = e.idestado
                          
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione a Cidade -
        }
        layout {
            sequence: 30
            region: @cadastro-de-cidades-atendidas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P383_IDCIDADEATENDIDA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @cadastro-de-cidades-atendidas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P383_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from roman.vw_filiais f
                where f.tipofilial in ('D','A')
                  and f.ativo = 'S'
                  and exists ( select 1
                               from roman.notasvendas nv
                               where nv.idfilial = f.idfilial )
                ```
            displayExtraValues: false
            nullDisplayValue: - Selecione a Empresa -
        }
        layout {
            sequence: 20
            region: @cadastro-de-cidades-atendidas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P383_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @cadastro-de-cidades-atendidas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 40
            region: @cadastro-de-cidades-atendidas
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P383_IDCIDADEATENDIDA
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @cadastro-de-cidades-atendidas
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: "javascript:apex.confirm('Deseja realmente deletar?', { request:'DELETE'})"
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P383_IDCIDADEATENDIDA
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @cadastro-de-cidades-atendidas
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P383_IDCIDADEATENDIDA
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @cadastro-de-cidades-atendidas
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 382
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process conulsta-em-cidades-atendidas (
        name: Conulsta em Cidades Atendidas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  roman.PCK_CADASTROS_RMC.PRC_CIDADESATENDIDAS( PIDCIDADEATENDIDA => :P383_IDCIDADEATENDIDA,
                                                                PIDFILIAL => :P383_IDFILIAL,
                                                                PIDCIDADE => :P383_IDCIDADE,
                                                                PMD5 => :P383_MD5,
                                                                POPERACAO_DML => 'S');
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1541741866295207623
        }
    )

    process processo-dml-em-cidades-atendidas (
        name: Processo DML em Cidades Atendidas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  --
                  if v('REQUEST') = 'CREATE' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'SAVE' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'DELETE' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  roman.PCK_CADASTROS_RMC.PRC_CIDADESATENDIDAS( PIDCIDADEATENDIDA => :P383_IDCIDADEATENDIDA,
                                                                PIDFILIAL => :P383_IDFILIAL,
                                                                PIDCIDADE => :P383_IDCIDADE,
                                                                PMD5 => :P383_MD5,
                                                                POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo executado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1541879764674471491
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('SAVE','DELETE','CREATE')
                ```
        }
    )

)

