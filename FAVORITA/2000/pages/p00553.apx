page 553 (
    name: Relatório de Comissões/Metas
    title: Relatório de Comissões/Metas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region acompanhamento-de-meta-gerentes (
        name: Acompanhamento de Meta Gerentes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select x.tipo
                     , x.filialfavorita
                     , x.gerente
                     , x.valormeta
                     , x.valortotal
                     , x.clientefinal as "Cliente Final"
                     , x.sistfav as "Sistema Favorita"
                     , x.atingido "% Atingido"
                     , case
                         when exists ( select 1
                                         from catal.funcionarios fu
                                        where fu.idpessoa = x.idpessoa
                                          and (fu.afastamento is null or fu.afastamento = 'N' ))  then
                           x.comi1
                         else
                           0
                       end "Comissão Meta Não Atingida 0,1%"
                     , case   
                         when exists ( select 1
                                         from catal.funcionarios fu
                                        where fu.idpessoa = x.idpessoa
                                          and (fu.afastamento is null or fu.afastamento = 'N' )) then          
                           x.comi3     
                         else
                           0
                       end "Comissão Meta Atingida 0,3%"
                     , case
                         when exists ( select 1
                                         from catal.funcionarios fu
                                        where fu.idpessoa = x.idpessoa
                                          and (fu.afastamento is null or fu.afastamento = 'N' )) then          
                           x.comi5
                         else
                           0
                       end "Comissão Super Meta 0,5%"
                     , x.matricula
                     , x.unidade
                    from ( select  tipo
                                 , filialfavorita
                                 , gerente
                                 , valormeta
                                 , valortotal
                                 , clientefinal 
                                 , sistfav 
                                 , round((valortotal / valormeta) * 100,2) atingido
                                 -- maicon aimi - 8571197 - 29/01/2024
                                 --não atigiu a meta
                                 , case
                                     when valortotal < valormeta  then
                                        case when (select ff.tipoloja from favorita.filiaisfavorita ff where ff.idfilialfavorita = b.idfilialfavorita ) = 'T' then
                                               valortotal * ( select to_number(replace(pa.valor,',','.'),'99999.999') from favorita.parametros pa where pa.nome = 'COMISSAO_META_NAT_LOJA_TRAD_GERENTE' and ( pa.idfilialfavorita is null or pa.idfilialfavorita = b.idfilialfavorita ) )
                                             when (select ff.tipoloja from favorita.filiaisfavorita ff where ff.idfilialfavorita = b.idfilialfavorita ) = 'U' then
                                               valortotal * ( select to_number(replace(pa.valor,',','.'),'99999.999') from favorita.parametros pa where pa.nome = 'COMISSAO_META_NAT_LOJA_UPGRADE_GERENTE' and ( pa.idfilialfavorita is null or pa.idfilialfavorita = b.idfilialfavorita ) )
                                        end
                                     else
                                       0
                                   end comi1
                
                                 -- maicon aimi - 8571197 - 29/01/2024
                                 -- atingiu a meta
                                 , case
                                     when valortotal >= valormeta and round((valortotal / valormeta) * 100,2) < 110 then          
                                        case when (select ff.tipoloja from favorita.filiaisfavorita ff where ff.idfilialfavorita = b.idfilialfavorita ) = 'T' then
                                               valortotal * ( select to_number(replace(pa.valor,',','.'),'99999.999') from favorita.parametros pa where pa.nome = 'COMISSAO_META_AT_LOJA_TRAD_GERENTE' and ( pa.idfilialfavorita is null or pa.idfilialfavorita = b.idfilialfavorita ) )
                                             when (select ff.tipoloja from favorita.filiaisfavorita ff where ff.idfilialfavorita = b.idfilialfavorita ) = 'U' then
                                               valortotal * ( select to_number(replace(pa.valor,',','.'),'99999.999') from favorita.parametros pa where pa.nome = 'COMISSAO_META_AT_LOJA_UPGRADE_GERENTE' and ( pa.idfilialfavorita is null or pa.idfilialfavorita = b.idfilialfavorita ) )
                                        end     
                                     else
                                       0
                                   end comi3
                
                                 -- maicon aimi - 8571197 - 29/01/2024
                                 -- superou a meta
                                 , case
                                     when valortotal >= valormeta and round((valortotal / valormeta) * 100,2) >= 110 then          
                                        case when (select ff.tipoloja from favorita.filiaisfavorita ff where ff.idfilialfavorita = b.idfilialfavorita ) = 'T' then
                                               valortotal * ( select to_number(replace(pa.valor,',','.'),'99999.999') from favorita.parametros pa where pa.nome = 'COMISSAO_META_EXED_LOJA_TRAD_GERENTE' and ( pa.idfilialfavorita is null or pa.idfilialfavorita = b.idfilialfavorita ) )
                                             when (select ff.tipoloja from favorita.filiaisfavorita ff where ff.idfilialfavorita = b.idfilialfavorita ) = 'U' then
                                               valortotal * ( select to_number(replace(pa.valor,',','.'),'99999.999') from favorita.parametros pa where pa.nome = 'COMISSAO_META_EXED_LOJA_UPGRADE_GERENTE' and ( pa.idfilialfavorita is null or pa.idfilialfavorita = b.idfilialfavorita ) )
                                        end 
                                     else
                                       0
                                   end comi5
                                 , matricula
                                 , unidade
                                 , idpessoa
                            from ( 
                                  select tipo
                                       , filialfavorita
                                       , idfilialfavorita
                                       , gerente
                                       , valormeta
                                       , sum(valortotal)   valortotal 
                                       , sum(clientefinal) clientefinal
                                       , sum(sistFav)      sistfav
                                       , matricula
                                       , unidade
                                       , idpessoa
                                    from (
                                          select 2 tipo
                                               , p.filialfavorita
                                               , p.idfilialfavorita
                                               , initcap(pp.nomepessoa) gerente
                                               , pp.matricula
                                               , ( select n.nome||' - ID: '||n.idunidadedenegocio
                                                     from roman.unidadesdenegocios n
                                                    where n.idunidadedenegocio = pp.unidade) unidade
                                               --
                                               , (select sum(valormeta)  
                                                    from favorita.metascobrancas
                                                   where idfilialfavorita = p.idfilialfavorita
                                                     and datainicio = (select datainicio from favorita.metascobrancas where idmetacobranca = :P553_META) 
                                                     and datafim    = (select datafim    from favorita.metascobrancas where idmetacobranca = :P553_META) ) valorMeta
                                               --
                                               , sum(p.valorapagar) valortotal
                                               , sum(case when p.idvendedora=2363887 then p.valorapagar else 0 end) clientefinal
                                               , sum(case when p.idvendedora=2363887 then 0 else p.valorapagar end) sistFav 
                                               --
                                               , g.idpessoa
                                            from favorita.vw_pedidos_fav p
                                               , catal.gerentes g
                                               , favorita.filiaisfavorita f
                                               , catal.pessoas pp
                                           where trunc(p.dataemissao) between (select datainicio from favorita.metascobrancas where idmetacobranca = :P553_META) 
                                                                          and (select datafim    from favorita.metascobrancas where idmetacobranca = :P553_META) 
                                             and f.idfilialfavorita = p.idfilialfavorita
                                             and g.idgerente = f.idgerente
                                             and pp.idpessoa = g.idpessoa
                                             and p.ididioma = 1
                                             and p.tipopedido in ('P','R') -- adicionado tipo pedido 'R' (T9699876)
                                             and p.datacancelamento is null
                                             and p.idsituacaoentrega > 20000 -- Ticket 14391627
                                             and exists ( select 1
                                                          from favorita.filiaisfavorita ff
                                                          where ff.idfilialfavorita = f.idfilialfavorita
                                                            and ff.ativo = 'S'
                                                            and ff.tipoloja in ('T','U','E') 
                                                            and ff.tipofilial = 'L' 
                                                            and p.tipopedido <> 'R'
                                                          union
                                                          select 1
                                                          from favorita.filiaisfavorita ff
                                                          where ff.idfilialfavorita = nvl(p.idfilialfavoritaorig, f.idfilialfavorita)
                                                            and ff.ativo = 'S'
                                                            and ff.tipoloja in ('T','U','E')
                                                            and ff.tipofilial = 'L' 
                                                            and p.tipopedido = 'R')  
                                             --
                                             and ( :P553_IDFILIALFAVORITA is null
                                                  or ( :P553_IDFILIALFAVORITA < 0 and exists ( select 1
                                                                                                 from favorita.filiaisfavorita ff
                                                                                                where ff.idfilialfavorita = p.idfilialfavorita
                                                                                                  and ff.ativo = 'S'
                                                                                                  and ff.tipofilial = 'L' 
                                                                                                  and p.tipopedido <> 'R'
                                                                                               union 
                                                                                               select 1
                                                                                                 from favorita.filiaisfavorita ff
                                                                                                where ff.idfilialfavorita = nvl(p.idfilialfavoritaorig, p.idfilialfavorita)
                                                                                                  and ff.ativo = 'S'
                                                                                                  and ff.tipofilial = 'L' 
                                                                                                  and p.tipopedido = 'R') 
                                                                                  and exists ( select 1
                                                                                                 from favorita.usuariosfiliaisfavorita uf
                                                                                                where uf.idusuario = :P0_IDUSUARIO
                                                                                                  and uf.idfilialfavorita = p.idfilialfavorita ) )
                                                  or ( p.tipopedido <> 'R' and :P553_IDFILIALFAVORITA > 0 and p.idfilialfavorita = :P553_IDFILIALFAVORITA )
                                                  or ( p.tipopedido = 'R' and :P553_IDFILIALFAVORITA > 0 and nvl(p.idfilialfavoritaorig, p.idfilialfavorita) = :P553_IDFILIALFAVORITA ) )
                                             --
                                             and not exists ( select 1
                                                            from favorita.classificacoespedidos c
                                                            where c.idpedido = p.idpedido
                                                              and c.idcaracteristicapedido = 8
                                                              and c.idvalorcaracteristica in (25,16) ) 
                                             and :P553_META is not null
                                          group by p.filialfavorita
                                                 , p.idfilialfavorita
                                                 , pp.nomepessoa
                                                 , pp.matricula
                                                 , pp.unidade
                                                 , g.idpessoa
                                         union all
                                         -- Cleber e Maicon - 31/01/2025 - Pegar pedidos Express
                                         select 2 tipo
                                             , favorita.pck_util_fav.fnc_nomefilialfavorita(f.idfilialfavorita) nomefilialfavorita
                                             , p.idfilialfavorita
                                             , initcap(pp.nomepessoa) gerente
                                             , pp.matricula
                                             , ( select n.nome||' - ID: '||n.idunidadedenegocio
                                                   from roman.unidadesdenegocios n
                                                  where n.idunidadedenegocio = pp.unidade) unidade
                                             , (select sum(valormeta)  
                                                  from favorita.metascobrancas
                                                 where idfilialfavorita = f.idfilialfavorita
                                                   and datainicio = (select datainicio from favorita.metascobrancas where idmetacobranca = :P553_META) 
                                                   and datafim    = (select datafim    from favorita.metascobrancas where idmetacobranca = :P553_META) ) valorMeta
                                             , p.valorapagar valorapagar
                                             , case when p.idvendedora=2363887 then p.valorapagar else 0 end clientefinal
                                             , case when p.idvendedora=2363887 then 0 else p.valorapagar end sistFav 
                                             --
                                             , g.idpessoa
                                        from favorita.pedidos p
                                           , catal.usuarios u
                                           , catal.gerentes g
                                           , favorita.filiaisfavorita f
                                           , catal.pessoas pp
                                           , ( select sum(v.valorpagar - v.valorpago) saldo
                                                    , sum(v.valorpagar) valorapagar
                                                    , v.idpedido
                                               from favorita.vencimentospedidos v
                                               where v.situacaovencimento = 'V'
                                                 and v.valorpago         <= v.valorpagar
                                               group by idpedido ) sd
                                        where p.idpedido = sd.idpedido(+)
                                          and u.idusuario = p.idusuario
                                          and f.idfilialfavorita = u.idfilialfavorita
                                          and p.idfilialfavorita != u.idfilialfavorita
                                          and g.idgerente = f.idgerente
                                          and pp.idpessoa = g.idpessoa
                                              
                                          and ( :P553_IDFILIALFAVORITA is null
                                                or :P553_IDFILIALFAVORITA = u.idfilialfavorita )
                                          and trunc(p.dataemissao) between (select datainicio from favorita.metascobrancas where idmetacobranca = :P553_META) 
                                                                            and (select datafim    from favorita.metascobrancas where idmetacobranca = :P553_META) 
                
                                          and nvl(p.valortotal,0) > 0
                                          and exists ( select 1
                                                       from favorita.classificacoespedidos cp
                                                          , usuarios u
                                                       where cp.idcaracteristicapedido = 81 -- usuario digitou o pedido
                                                         and u.idusuario = cp.idusuario
                                                         and u.usuario like '%DELIVERY%'
                                                         and cp.idpedido               = p.idpedido )
                                          and p.datacancelamento is null
                                          and p.idsituacaoentrega > 20000
                                          and sd.valorapagar != 0
                                         --
                                         union all
                                         select 2 tipo
                                               , f.nomefilialfavorita
                                               , f.idfilialfavorita
                                               , initcap(pp.nomepessoa) gerente
                                               , pp.matricula
                                               , ( select n.nome||' - ID: '||n.idunidadedenegocio
                                                     from roman.unidadesdenegocios n
                                                    where n.idunidadedenegocio = pp.unidade) unidade
                                               --
                                               , (select sum(valormeta)  
                                                    from favorita.metascobrancas
                                                   where idfilialfavorita = f.idfilialfavorita
                                                     and datainicio = (select datainicio from favorita.metascobrancas where idmetacobranca = :P553_META) 
                                                     and datafim    = (select datafim    from favorita.metascobrancas where idmetacobranca = :P553_META) ) valorMeta
                                               --
                                               , sum(p.valorapagar) valortotal
                                               , sum(case when p.idvendedora=2363887 then p.valorapagar else 0 end) clientefinal
                                               , sum(case when p.idvendedora=2363887 then 0 else p.valorapagar end) sistFav 
                                               --
                                               , g.idpessoa
                                            from favorita.vw_pedidos_fav p
                                               , catal.usuarios u
                                               , catal.gerentes g
                                               , favorita.filiaisfavorita f
                                               , catal.pessoas pp
                                           where trunc(p.dataemissao) between (select datainicio from favorita.metascobrancas where idmetacobranca = :P553_META) 
                                                                          and (select datafim    from favorita.metascobrancas where idmetacobranca = :P553_META) 
                                             and f.idfilialfavorita = u.idfilialfavorita
                                             and u.idusuario = p.idusuario
                                             and p.idfilialfavorita != u.idfilialfavorita
                                             and g.idgerente = f.idgerente
                                             and pp.idpessoa = g.idpessoa
                                             and p.ididioma = 1
                                             and p.tipopedido in ('P','R') -- adicionado tipo pedido 'R' (T9699876)
                                             and p.datacancelamento is null
                                            and p.idsituacaoentrega > 20000 -- Ticket 14391627
                                             and exists ( select 1
                                                          from favorita.filiaisfavorita ff
                                                          where ff.idfilialfavorita = f.idfilialfavorita
                                                            and ff.ativo = 'S'
                                                            and ff.tipoloja in ('T','U','E')
                                                            and ff.tipofilial = 'L' 
                                                            and p.tipopedido <> 'R'
                                                          union
                                                          select 1
                                                          from favorita.filiaisfavorita ff
                                                          where ff.idfilialfavorita = nvl(p.idfilialfavoritaorig, f.idfilialfavorita)
                                                            and ff.ativo = 'S'
                                                            and ff.tipoloja in ('T','U','E')
                                                            and ff.tipofilial = 'L' 
                                                            and p.tipopedido = 'R') 
                                             and ( :P553_IDFILIALFAVORITA is null
                                                  or ( :P553_IDFILIALFAVORITA < 0 and exists ( select 1
                                                                                                 from favorita.filiaisfavorita ff
                                                                                                where ff.idfilialfavorita = p.idfilialfavorita
                                                                                                  and ff.ativo = 'S'
                                                                                                  and ff.tipofilial = 'L' 
                                                                                                  and p.tipopedido <> 'R'
                                                                                               union select 1
                                                                                                 from favorita.filiaisfavorita ff
                                                                                                where ff.idfilialfavorita = nvl(p.idfilialfavoritaorig, p.idfilialfavorita)
                                                                                                  and ff.ativo = 'S'
                                                                                                  and ff.tipofilial = 'L' 
                                                                                                  and p.tipopedido = 'R' ) 
                                                                                  and exists ( select 1
                                                                                                 from favorita.usuariosfiliaisfavorita uf
                                                                                                where uf.idusuario = :P0_IDUSUARIO
                                                                                                  and uf.idfilialfavorita = f.idfilialfavorita ) )
                                                  or ( p.tipopedido <> 'R' and :P553_IDFILIALFAVORITA > 0 and p.idfilialfavorita = :P553_IDFILIALFAVORITA )
                                                  or ( p.tipopedido = 'R' and :P553_IDFILIALFAVORITA > 0 and nvl(p.idfilialfavoritaorig, p.idfilialfavorita) = :P553_IDFILIALFAVORITA ) )
                                             and not exists ( select 1
                                                            from favorita.classificacoespedidos c
                                                            where c.idpedido = p.idpedido
                                                              and c.idcaracteristicapedido = 8
                                                              and c.idvalorcaracteristica in (25,16) ) 
                                             and :P553_META is not null
                                          group by f.nomefilialfavorita
                                                 , f.idfilialfavorita
                                                 , pp.nomepessoa
                                                 , pp.matricula
                                                 , pp.unidade
                                                 , g.idpessoa
                                         )
                                   group by tipo
                                          , filialfavorita
                                          , idfilialfavorita
                                          , valormeta    
                                          , gerente
                                          , matricula
                                          , unidade
                                          , idpessoa ) b
                            order by 2,1,7) x
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
