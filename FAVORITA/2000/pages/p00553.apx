    region meta-individual-atingido-colaborador (
        name: Meta individual Atingido Colaborador
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with vencimentos_agrupados as (
                  select ven.idpedido,
                         sum(case when ped.idvendedora = 2363887 then ven.valorpagar else 0 end) as valor_cliente_final,
                         sum(case when ped.idvendedora != 2363887 then ven.valorpagar else 0 end) as valor_sistema_favorita,
                         sum(ven.valorpagar) as valor_total
                    from favorita.vencimentospedidos ven
                    join favorita.pedidos ped on ped.idpedido = ven.idpedido
                   where ven.situacaovencimento = 'V'
                   group by ven.idpedido
                )
                select fil.nomefilialfavorita                      as "Loja"
                     , initcap(pes.nomepessoa)                     as "Colaborador"
                     , initcap(car.nome)                           as "Cargo"
                     , met.valormeta                               as "Valor Meta"
                     , sum(nvl(venagg.valor_cliente_final, 0))     as "Cliente Final"
                     , sum(nvl(venagg.valor_sistema_favorita, 0))  as "Sistema Favorita"
                     , sum(nvl(venagg.valor_total, 0))             as "Valor Atingido"
                     , case
                         when nvl(met.valormeta, 0) > 0 then
                           round((sum(nvl(venagg.valor_total, 0)) * 100) / met.valormeta, 2)
                         else
                           0
                       end                                         as "% Atingido"
                     , count(distinct ped.idpedido)                as "Qtd. Pedidos"
                     , ( case
                           when fil.tipoloja = 'T' and sum(nvl(venagg.valor_total, 0)) >= nvl(met.valormeta,0) then
                             sum(nvl(venagg.valor_total,0)) * ( select to_number(replace(pa.valor,',','.'),'99999.999')
                                                                   from favorita.parametros pa
                                                                  where pa.nome = 'COMISSAO_META_AT_LOJA'
                                                                    and ( pa.idfilialfavorita is null or pa.idfilialfavorita = fil.idfilialfavorita ) )
                           when fil.tipoloja = 'U'
                            and trunc(favorita.pck_util_fav.fnc_divisor_zero(sum(nvl(venagg.valor_total,0)), nvl(met.valormeta,0)),2)*100 >= 100
                            and trunc(favorita.pck_util_fav.fnc_divisor_zero(sum(nvl(venagg.valor_total,0)), nvl(met.valormeta,0)),2)*100 < 110 then
                             sum(nvl(venagg.valor_total,0)) * ( select to_number(replace(pa.valor,',','.'),'99999.999')
                                                                   from favorita.parametros pa
                                                                  where pa.nome = 'COMISSAO_META_AT_LOJA_UPGRADE'
                                                                    and ( pa.idfilialfavorita is null or pa.idfilialfavorita = fil.idfilialfavorita ) )
                           when fil.tipoloja = 'U'
                            and trunc(favorita.pck_util_fav.fnc_divisor_zero(sum(nvl(venagg.valor_total,0)), nvl(met.valormeta,0)),2)*100 >= 110 then
                             sum(nvl(venagg.valor_total,0)) * ( select to_number(replace(pa.valor,',','.'),'99999.999')
                                                                   from favorita.parametros pa
                                                                  where pa.nome = 'COMISSAO_META_EXED_LOJA_UPGRADE'
                                                                    and ( pa.idfilialfavorita is null or pa.idfilialfavorita = fil.idfilialfavorita ) )
                           else 0
                         end
                       )                                            as "Comissão Paga"
                from favorita.pedidos ped
                join catal.usuarios usu           on usu.idusuario = ped.idusuario
                join catal.pessoas pes            on pes.idpessoa = usu.idpessoa
                join favorita.metascobrancas met  on met.idusuario = usu.idusuario
                join favorita.filiaisfavorita fil on fil.idfilialfavorita = ped.idfilialfavorita
                join catal.funcionarios fun       on fun.idpessoa = pes.idpessoa
                join roman.cargos car             on car.idcargo = fun.idcargo
                left join vencimentos_agrupados venagg on venagg.idpedido = ped.idpedido
                where met.datainicio = (select datainicio from favorita.metascobrancas where idmetacobranca = :P553_META)
                  and met.datafim    = (select datafim    from favorita.metascobrancas where idmetacobranca = :P553_META)
                  --and ped.dataemissao between :P553_DATA_INICIAL and :P553_DATA_FINAL
                  and ped.dataemissao >= to_date(:P553_DATA_INICIAL, 'DD/MM/YYYY')
                  and ped.dataemissao <  to_date(:P553_DATA_FINAL,   'DD/MM/YYYY') + 1
                  and (:P553_IDFILIALFAVORITA = -1 or fil.idfilialfavorita = :P553_IDFILIALFAVORITA)
                  and fil.tipofilial = 'L'
                  and ped.datacancelamento is null
                  and ped.tipopedido in ('P','R')
                  and not exists (
                      select 1
                        from favorita.classificacoespedidos c
                       where c.idpedido = ped.idpedido
                         and c.idcaracteristicapedido = 8
                         and c.idvalorcaracteristica = 25
                  )
                  and (:P553_IDREGIONALFAVORITA = -1 or fil.idregionalfavorita = :P553_IDREGIONALFAVORITA)
                group by fil.nomefilialfavorita
                       , fil.idfilialfavorita
                       , fil.tipoloja
                       , initcap(pes.nomepessoa)
                       , initcap(car.nome)
                       , met.valormeta
                order by 1,2;
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 374555107939543215
        }

