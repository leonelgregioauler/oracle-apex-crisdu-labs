            )

            displayColumn "Cliente Final" (
                sequence: 5
            )

            displayColumn "Colaborador" (
                sequence: 2
            )

            displayColumn "Loja" (
                sequence: 1
            )

            displayColumn "Qtd. Pedidos" (
                sequence: 8
            )

            displayColumn "Sistema Favorita" (
                sequence: 6
            )

            displayColumn "Valor Atingido" (
                sequence: 7
            )

            displayColumn "Valor Meta" (
                sequence: 4
            )

            computation APXWS_CC_001 (
                identifier: C01
                source {
                    expression: ( E + F ) /  I
                    dataType: number
                }
                label {
                    column: Ticket Médio
                }
                appearance {
                    formatMask: 999G999G999G999G990D00
                }
            )

        )

    )

    region opções (
        name: "Opções "
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P553_DATA_FINAL (
        type: datePicker
        label {
            label: Data Final
            alignment: left
        }
        layout {
            sequence: 20
            region: @meta-individual-atingido-colaborador
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/YYYY
            width: 30
        }
    )

    pageItem P553_DATA_INICIAL (
        type: datePicker
        label {
            label: Data Inicial
            alignment: left
        }
        layout {
            sequence: 10
            region: @meta-individual-atingido-colaborador
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/YYYY
            width: 30
        }
    )

    pageItem P553_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Filial Favorita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct favorita.pck_util_fav.fnc_nomefilialfavorita(u.idfilialfavorita) showvalue
                     , u.idfilialfavorita returnvalue
                  from favorita.usuariosfiliaisfavorita u
                 where (     u.idfilialfavorita = :P0_idfilialfavorita 
                         or :P0_idusuario = u.idusuario)
                   and exists ( select 1
                                  from favorita.filiaisfavorita f
                                 where f.idfilialfavorita = u.idfilialfavorita
                                   and f.tipofilial = 'L')
                 
                union
                 
                select ' - Todas Lojas -' 
                     , -1
                  from dual
                 where roman.pck_util.fnc_verificaacesso(3545, v('APP_USER')) = 'S'
                 
                union
                 
                -- traz as lojas pro time da TI -- adicionado por Maicon Aimi em 20/05/2025
                select distinct favorita.pck_util_fav.fnc_nomefilialfavorita(u.idfilialfavorita) showvalue
                     , u.idfilialfavorita returnvalue
                  from favorita.usuariosfiliaisfavorita u
                 where exists ( select 1
                                  from roman.usuariosgruposatendimento g
                                 where g.idgrupoatendimento = 0
                                   and g.usuario = v('APP_USER'))
                   and exists ( select 1
                                  from favorita.filiaisfavorita f
                                 where f.idfilialfavorita = u.idfilialfavorita
                                   and f.tipofilial = 'L')
                 
                 order by 1
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 40
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P553_IDREGIONALFAVORITA (
        type: selectList
        label {
            label: Regional Favorita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select rf.descricaoregionalfavorita as display_value
                     , rf.idregionalfavorita        as return_value
                  from favorita.regionaislojasfavorita rf
                 order by 2
                ```
            nullDisplayValue: - Todas -
            nullReturnValue: -1
        }
        layout {
            sequence: 50
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        default {
            type: static
            staticValue: -1
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from dual
                 where roman.pck_util.fnc_verificaacesso(40812, v('APP_USER')) = 'S';
                ```
        }
    )

    pageItem P553_META (
        type: selectList
        label {
            label: Meta
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(datainicio,'dd/mm/rrrr') || ' a ' || to_char(datafim,'dd/mm/rrrr') d
                     , max(idmetacobranca)  r
                 from metascobrancas 
                 where idfilialfavorita is not null
                 group by datainicio, datafim
                 order by datainicio desc
                 
                ```
        }
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    button buscar (
        buttonName: BUSCAR
        label: Buscar
        layout {
            sequence: 60
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction tipo-bairro (
        name: Tipo Bairro
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P553_PESQUISAR_POR
        }
        clientSideCondition {
            type: item=value
            item: P553_PESQUISAR_POR
            value: B
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P553_BAIRRO
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P553_BAIRRO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo-cidade (
        name: Tipo Cidade
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P553_PESQUISAR_POR
        }
        clientSideCondition {
            type: item=value
            item: P553_PESQUISAR_POR
            value: C
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P553_IDCIDADE
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P553_IDCIDADE
            }
            execution {
                sequence: 10
            }
        )

    )

    validation valida-data-final (
        name: Valida Data Final
        execution {
            sequence: 20
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                -- Data Final pode ser Null
                select 1
                  from dual
                 where :P553_DATA_FINAL is null
                
                union
                
                -- Se a Data Final não for Null, ela deve estar dentro do periodo da meta.
                select 1
                  from favorita.metascobrancas m
                 where m.idmetacobranca = :P553_META
                   and :P553_DATA_FINAL between m.datainicio and m.datafim;
                ```
        }
        error {
            errorMessage: Atenção! A data final deve estar dentro do período da meta.
            associatedItem: @P553_DATA_FINAL
        }
    )

    validation valida-data-inicial (
        name: Valida Data Inicial
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                -- Data Inicial pode ser Null
                select 1
                  from dual
                 where :P553_DATA_INICIAL is null
                
                union
                
                -- Se a Data Inicial não for Null, ela deve estar dentro do periodo da meta.
                select 1
                  from favorita.metascobrancas m
                 where m.idmetacobranca = :P553_META
                   and :P553_DATA_INICIAL between m.datainicio and m.datafim;
                ```
        }
        error {
            errorMessage: Atenção! A data inicial deve estar dentro do período da meta.
            associatedItem: @P553_DATA_INICIAL
        }
    )

    branch (
        name: buscar pedidos
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 553
                items: {
                    P553_IDFILIALFAVORITA: &P553_IDFILIALFAVORITA.
                    P553_META: &P553_META.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

)

