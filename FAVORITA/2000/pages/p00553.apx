        savedReport 1443659 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn "% Atingido" (
                sequence: 7
            )

            displayColumn "Cliente Final" (
                sequence: 5
            )

            displayColumn "Comissão Meta Atingida 0,3%" (
                sequence: 9
            )

            displayColumn "Comissão Meta Não Atingida 0,1%" (
                sequence: 8
            )

            displayColumn "Comissão Super Meta 0,5%" (
                sequence: 10
            )

            displayColumn FILIALFAVORITA (
                sequence: 1
            )

            displayColumn GERENTE (
                sequence: 2
            )

            displayColumn MATRICULA (
                sequence: 11
            )

            displayColumn "Sistema Favorita" (
                sequence: 4
            )

            displayColumn UNIDADE (
                sequence: 12
            )

            displayColumn VALORMETA (
                sequence: 3
            )

            displayColumn VALORTOTAL (
                sequence: 6
            )

        )

    )

    region emissão-resumido-por-atendente (
        name: Emissão Resumido Por Atendente
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select xy.idfilialfavorita 
                     , favorita.pck_util_fav.fnc_nomefilialfavorita(xy.idfilialfavorita) nomefilialfavorita
                     , favorita.pck_util_fav.fnc_nomeusuario(xy.idusuario) nomeusuario
                     , xy.valormeta
                     , xy.sistfav
                     , case when (select ff.idcargo
                                    from catal.funcionarios ff
                                       , catal.usuarios u
                                   where u.idusuario = xy.idusuario
                                     and ff.idpessoa = u.idpessoa
                                     and ff.idcargo = 10
                                     and (ff.afastamento is null or ff.afastamento = 'N' )) = 10 
                            then
                               trunc(favorita.pck_util_fav.FNC_DIVISOR_ZERO(nvl(xy.valortotal,0),nvl(xy.valormeta,0)),2)*100
                            else
                               trunc(favorita.pck_util_fav.FNC_DIVISOR_ZERO(nvl(xy.valoremp,0),nvl(xy.metaemp,0)),2)*100 
                       end perc_fat
                     , xy.clientefinal
                     , xy.valortotal
                     , xy.matricula 
                     , xy.unidade 
                     , xy.cargo
                     -- Meta Atingida
                     , case 
                         when ( select tipoloja from favorita.filiaisfavorita where idfilialfavorita = :P553_IDFILIALFAVORITA ) = 'T' and xy.valortotal >= xy.valormeta 
                           then ( xy.valortotal * ( select to_number(replace(pa.valor,',','.'),'99999.99') 
                                                      from favorita.parametros pa
                                                     where pa.nome = 'COMISSAO_META_AT_LOJA' 
                                                       and ( pa.idfilialfavorita is null or pa.idfilialfavorita = :P553_IDFILIALFAVORITA ) ) )
                         when ( select distinct(fv.tipoloja)
                                  from catal.funcionarios ff
                                     , catal.usuarios uu
                                     , favorita.filiaisfavorita fv
                                 where uu.idpessoa = ff.idpessoa
                                   and uu.idfilialfavorita = fv.idfilialfavorita
                                   and uu.idusuario = xy.idusuario
                                   and ff.ativo = 'S'
                                   and uu.ativo = 'S'
                                   and fv.idfilialfavorita = :P553_IDFILIALFAVORITA
                                   and ff.idcargo in (12,8)) = 'E' and xy.valoremp >= xy.metaemp
                           then ( xy.valoremp * ( select to_number(replace(valor,',','.'),'99999.99')
                                                    from favorita.parametros 
                                                   where nome = 'COMISSAO_META_AT_LOJA' 
                                                     and (idfilialfavorita is null or idfilialfavorita = :P553_IDFILIALFAVORITA) )  ) / 
                                                     ( select count(uu.idusuario)
                                                        from catal.funcionarios ff
                                                            , catal.usuarios uu
                                                            , favorita.filiaisfavorita fv
                                                        where uu.idpessoa = ff.idpessoa
                                                          and uu.idfilialfavorita = fv.idfilialfavorita
                                                          and ff.ativo = 'S'
                                                          and uu.ativo = 'S'
                                                          and fv.idfilialfavorita = :P553_IDFILIALFAVORITA
                                                          and ff.idcargo in (12,8) )
                         when ( select tipoloja from favorita.filiaisfavorita where idfilialfavorita = :P553_IDFILIALFAVORITA ) = 'U' 
                           and trunc(favorita.pck_util_fav.FNC_DIVISOR_ZERO(nvl(xy.valortotal,0),nvl(xy.valormeta,0)),2)*100  >= 100
                           and trunc(favorita.pck_util_fav.FNC_DIVISOR_ZERO(nvl(xy.valortotal,0),nvl(xy.valormeta,0)),2)*100  < 110
                           then ( xy.valortotal * ( select to_number(replace(pa.valor,',','.'),'99999.999') 
                                                      from favorita.parametros pa
                                                     where pa.nome = 'COMISSAO_META_AT_LOJA_UPGRADE' 
                                                       and ( pa.idfilialfavorita is null or pa.idfilialfavorita = :P553_IDFILIALFAVORITA ) ) )
                                                          
                       end integral
                     -- Meta Atingida
                
                     -- Meta Não Atendida
                     , case
                         when (select tipoloja from favorita.filiaisfavorita where idfilialfavorita = :P553_IDFILIALFAVORITA ) = 'T' 
                                 and ( xy.valortotal < xy.valormeta or (nvl(xy.valormeta,0) = 0
                                 and exists ( select 1
                                              from catal.funcionarios ff
                                                 , catal.usuarios u
                                             where u.idusuario = xy.idusuario
                                               and ff.idpessoa = u.idpessoa
                                               and ff.idcargo = 9)))
                           then ( xy.valortotal * ( select to_number(replace(valor,',','.'),'99999.999') 
                                                      from favorita.parametros pa
                                                     where pa.nome = 'COMISSAO_META_NAT_LOJA' 
                                                       and ( pa.idfilialfavorita is null or pa.idfilialfavorita = :P553_IDFILIALFAVORITA ) ) )
                  
                         when ( select distinct(fv.tipoloja)
                                  from catal.funcionarios ff
                                     , catal.usuarios uu
                                     , favorita.filiaisfavorita fv
                                 where uu.idpessoa = ff.idpessoa
                                   and uu.idfilialfavorita = fv.idfilialfavorita
                                   and uu.idusuario = xy.idusuario
                                   and ff.ativo = 'S'
                                   and uu.ativo = 'S'
                                   and fv.idfilialfavorita = :P553_IDFILIALFAVORITA
                                   and ff.idcargo in (12,8) ) = 'E' and xy.valoremp < xy.metaemp
                           then ( xy.valoremp * ( select to_number(replace(valor,',','.'),'99999.999')
                                                    from favorita.parametros 
                                                   where nome = 'COMISSAO_META_NAT_LOJA' 
                                                     and (idfilialfavorita is null or idfilialfavorita = :P553_IDFILIALFAVORITA) )  ) / 
                                                     ( select count(uu.idusuario)
                                                        from catal.funcionarios ff
                                                            , catal.usuarios uu
                                                            , favorita.filiaisfavorita fv
                                                        where uu.idpessoa = ff.idpessoa
                                                          and uu.idfilialfavorita = fv.idfilialfavorita
                                                          and ff.ativo = 'S'
                                                          and uu.ativo = 'S'
                                                          and fv.idfilialfavorita = :P553_IDFILIALFAVORITA
                                                          and ff.idcargo in (12,8) )
                         when ( select tipoloja from favorita.filiaisfavorita where idfilialfavorita = :P553_IDFILIALFAVORITA ) = 'U' 
                           and trunc(favorita.pck_util_fav.FNC_DIVISOR_ZERO(nvl(xy.valortotal,0),nvl(xy.valormeta,0)),2)*100  < 100
                           then ( xy.valortotal * ( select to_number(replace(pa.valor,',','.'),'99999.999') 
                                                      from favorita.parametros pa
                                                     where pa.nome = 'COMISSAO_META_NAT_LOJA_UPGRADE' 
                                                       and ( pa.idfilialfavorita is null or pa.idfilialfavorita = :P553_IDFILIALFAVORITA ) ) )
                       end parcial
                     -- Meta Não Atendida
                
                     -- Bonificação de loja Tradicional
                     , case when (select tipoloja from favorita.filiaisfavorita where idfilialfavorita = :P553_IDFILIALFAVORITA ) in ('T','U')
                             and (trunc(favorita.pck_util_fav.FNC_DIVISOR_ZERO(nvl(xy.valoremp,0),nvl(xy.metaemp,0)),2) >= 1.1)
                              then (select 150.00
                                    from catal.funcionarios ff
                                       , catal.usuarios u
                                    where u.idusuario = xy.idusuario
                                      and ff.idpessoa = u.idpessoa
                                      and ff.idcargo in (9)
                                      and (ff.afastamento is null or ff.afastamento = 'N' ))
                            when (select tipoloja from favorita.filiaisfavorita where idfilialfavorita = :P553_IDFILIALFAVORITA ) in ('T','U')
                             and (trunc(favorita.pck_util_fav.FNC_DIVISOR_ZERO(nvl(xy.valoremp,0),nvl(xy.metaemp,0)),2) >= 1)   
                              then (select 100.00
                                    from catal.funcionarios ff
                                       , catal.usuarios u
                                    where u.idusuario = xy.idusuario
                                      and ff.idpessoa = u.idpessoa
                                      and ff.idcargo in (9)
                                      and (ff.afastamento is null or ff.afastamento = 'N' ))
                            -- Bonificação Loja Express
                            when (select tipoloja from favorita.filiaisfavorita where idfilialfavorita = :P553_IDFILIALFAVORITA ) = 'E'
                             and (trunc(favorita.pck_util_fav.FNC_DIVISOR_ZERO(nvl(xy.valoremp,0),nvl(xy.metaemp,0)),2) >= 1.1)
                              then (select 150.00
                                    from catal.funcionarios ff
                                       , catal.usuarios u
                                    where u.idusuario = xy.idusuario
                                      and ff.idpessoa = u.idpessoa
                                      and ff.idcargo = 9 
                                      and (ff.afastamento is null or ff.afastamento = 'N' ))
                            when (select tipoloja from favorita.filiaisfavorita where idfilialfavorita = :P553_IDFILIALFAVORITA ) = 'E'
                             and (trunc(favorita.pck_util_fav.FNC_DIVISOR_ZERO(nvl(xy.valoremp,0),nvl(xy.metaemp,0)),2) >= 1)   
                              then (select 100.00
                                    from catal.funcionarios ff
                                       , catal.usuarios u
                                    where u.idusuario = xy.idusuario
                                      and ff.idpessoa = u.idpessoa
                                      and ff.idcargo = 9
                                      and (ff.afastamento is null or ff.afastamento = 'N' ))
                       else 0
                       end bonificacao 
                      -- maicon aimi - 8571197 - 29/01/2024
                      -- Coluna Meta Exced.
                     , case 
                         when ( select tipoloja from favorita.filiaisfavorita where idfilialfavorita = :P553_IDFILIALFAVORITA ) = 'U' 
                           and trunc(favorita.pck_util_fav.FNC_DIVISOR_ZERO(nvl(xy.valortotal,0),nvl(xy.valormeta,0)),2)*100  >= 110 
                           then ( xy.valortotal * ( select to_number(replace(pa.valor,',','.'),'99999.999') 
                                                      from favorita.parametros pa
                                                     where pa.nome = 'COMISSAO_META_EXED_LOJA_UPGRADE' 
                                                       and ( pa.idfilialfavorita is null or pa.idfilialfavorita = :P553_IDFILIALFAVORITA ) ) )
                       end meta_exced
                      -- Coluna Meta Exced.
                from ( select xx.idusuario
                            , xx.idfilialfavorita
                            , xx.nomeusuario
                            , x.valormeta
                            , xx.valortotal
                            , xx.unidade
                            , xx.matricula
                            , xx.cargo
                            , xx.clientefinal
                            , xx.sistfav
                            , xx.metaemp
                            , xx.valoremp
                         from ( select *
                                  from favorita.metascobrancas m
                                 where m.idfilialfavorita = :P553_IDFILIALFAVORITA
                                   and m.datainicio = ( select datainicio from favorita.metascobrancas where idmetacobranca = :P553_META ) 
                                   and m.datafim = ( select datafim    from favorita.metascobrancas where idmetacobranca = :P553_META ) ) x
                
                            , ( select sum(v.valortotal) valortotal
                                     , p.idusuario 
                                     , favorita.pck_util_fav.fnc_nomeusuario(p.idusuario) nomeusuario
                                     , u.idfilialfavorita idfilialfavorita
                                     , favorita.pck_util_fav.fnc_nomefilialfavorita(u.idfilialfavorita) nomefilialfavorita
                                     ---
                                     , ( select ud.nomefilialfavorita||' - ID: '||pp.unidade
                                           from catal.usuarios u
                                              , catal.pessoas  pp
                                              , favorita.filiaisfavorita ud
                                          where to_number(ud.idempresametadados) = pp.unidade --devido a tabela de pessoas for varchar2
                                            and u.idpessoa  = pp.idpessoa
                                            and u.idusuario = p.idusuario ) unidade
                                     ---
                                     , ( select pp.matricula
                                           from catal.usuarios u
                                              , catal.pessoas  pp
                                          where u.idpessoa  = pp.idpessoa
                                            and u.idusuario = p.idusuario ) matricula
                                     ---
                                     , ( select cc.nome
                                           from catal.usuarios u
                                              , catal.funcionarios  ff
                                              , roman.cargos cc
                                          where u.idpessoa  = ff.idpessoa
                                            and ff.idcargo = cc.idcargo
                                            and u.idusuario = p.idusuario ) cargo
                                     ---
                                     , sum(case when p.idvendedora=2363887 then v.valortotal else 0 end) clientefinal
                                     , sum(case when p.idvendedora=2363887 then 0 else v.valortotal end) sistfav
                                     ---
                                     , ( select sum(m.valormeta) 
                                           from favorita.metascobrancas m
                                          where idfilialfavorita = :P553_IDFILIALFAVORITA
                                            and datainicio = (select datainicio from favorita.metascobrancas where idmetacobranca = :P553_META) 
                                            and datafim    = (select datafim    from favorita.metascobrancas where idmetacobranca = :P553_META) )metaemp
                                     ---
                                     , ( select  sum(p.valorapagar) valortotal 
                                           from favorita.vw_pedidos_fav p
                                              , usuarios u
                                          where trunc(p.dataemissao) between (select datainicio from favorita.metascobrancas where idmetacobranca = :P553_META) 
                                                                         and (select datafim     from favorita.metascobrancas where idmetacobranca = :P553_META) 
                                            and p.ididioma = 1
                                            and u.idusuario = p.idusuario
                                            and p.tipopedido in ( 'P', 'R')
                                            and p.datacancelamento is null
                                            and ( p.tipopedido <> 'R' and p.idfilialfavorita = :P553_IDFILIALFAVORITA
                                               or p.tipopedido <> 'R' and u.idfilialfavorita = :P553_IDFILIALFAVORITA 
                                               or p.tipopedido = 'R' and nvl(p.idfilialfavoritaorig, p.idfilialfavorita) = :P553_IDFILIALFAVORITA )
                                            and not exists ( select 1
                                                               from favorita.classificacoespedidos c
                                                               where c.idpedido = p.idpedido
                                                                 and c.idcaracteristicapedido = 8
                                                                 and c.idvalorcaracteristica in (25,16) ) ) valoremp
                                      ---
                                  from favorita.pedidos p
                                     , usuarios u
                                     , ( select v.valorpagar valortotal
                                              , v.idpedido
                                           from favorita.vw_vencimentospedidos_fav v
                                          where v.codsituacaovencimento = 'V' ) v --valido
                                 where p.idpedido = v.idpedido
                                   and u.idusuario = p.idusuario
                                   and trunc(p.dataemissao) between (select datainicio from favorita.metascobrancas where idmetacobranca = :P553_META) 
                                                                and (select datafim    from favorita.metascobrancas where idmetacobranca = :P553_META) 
                                   and p.idpais = 1
                                   and p.tipopedido in ( 'P', 'R')
                                   and p.datacancelamento is null
                                   and u.idfilialfavorita = :P553_IDFILIALFAVORITA
                                   and not exists ( select 1 from favorita.classificacoespedidos c where c.idpedido = p.idpedido and c.idcaracteristicapedido = 8 and c.idvalorcaracteristica in (25,16) ) 
                                group by p.idusuario
                                       , u.idfilialfavorita ) xx
                        where x.idusuario = xx.idusuario (+) --query baseado em pedidos que o usuário tem meta
                        union
                        select uu.idusuario
                             , fv.idfilialfavorita 
                             , favorita.pck_util_fav.fnc_nomeusuario(uu.idusuario) nomeusuario
                             , null meta
                             , sum(v.valortotal) valortotal
                             ---
                             , ( select ud.nomefilialfavorita||' - ID: '||pp.unidade
                                   from catal.usuarios u
                                      , catal.pessoas  pp
                                      , favorita.filiaisfavorita ud
                                  where to_number(ud.idempresametadados) = pp.unidade --devido a tabela de pessoas for varchar2
                                    and u.idpessoa  = pp.idpessoa
                                    and u.idusuario = uu.idusuario ) unidade
                             ---
                             , ( select pp.matricula
                                   from catal.usuarios u
                                      , catal.pessoas  pp
                                  where u.idpessoa  = pp.idpessoa
                                    and u.idusuario = uu.idusuario ) matricula
                             ---
                             , ( select cc.nome
                                   from catal.usuarios u
                                      , catal.funcionarios  ff
                                      , roman.cargos cc
                                  where u.idpessoa  = ff.idpessoa
                                    and ff.idcargo = cc.idcargo
                                    and u.idusuario = uu.idusuario ) cargo
                             ---
                             , sum(case when p.idvendedora=2363887 then v.valortotal else 0 end) clientefinal
                             , sum(case when p.idvendedora=2363887 then 0 else v.valortotal end) sistfav
                             ---
                             , ( select sum(m.valormeta) 
                                   from favorita.metascobrancas m
                                  where idfilialfavorita = :P553_IDFILIALFAVORITA
                                    and datainicio = (select datainicio from favorita.metascobrancas where idmetacobranca = :P553_META) 
                                    and datafim    = (select datafim    from favorita.metascobrancas where idmetacobranca = :P553_META) )metaemp
                             ---
                             , ( select  sum(p.valorapagar) valortotal 
                                   from favorita.vw_pedidos_fav p
                                      , usuarios u
                                  where trunc(p.dataemissao) between (select datainicio from favorita.metascobrancas where idmetacobranca = :P553_META) 
                                                                 and (select datafim     from favorita.metascobrancas where idmetacobranca = :P553_META) 
                                    and p.ididioma = 1
                                    and u.idusuario = p.idusuario
                                    and p.tipopedido in ( 'P', 'R')
                                    and p.datacancelamento is null
                                    and ( p.tipopedido <> 'R' and p.idfilialfavorita = :P553_IDFILIALFAVORITA
                                       or p.tipopedido <> 'R' and u.idfilialfavorita = :P553_IDFILIALFAVORITA 
                                       or p.tipopedido = 'R' and nvl(p.idfilialfavoritaorig, p.idfilialfavorita) = :P553_IDFILIALFAVORITA )
                                    and not exists ( select 1
                                                       from favorita.classificacoespedidos c
                                                       where c.idpedido = p.idpedido
                                                         and c.idcaracteristicapedido = 8
                                                         and c.idvalorcaracteristica in (25,16) ) ) valoremp
                            ---
                            from catal.funcionarios ff
                                , catal.usuarios uu
                                , favorita.filiaisfavorita fv
                                , favorita.pedidos p
                                , ( select v.valorpagar valortotal
                                         , v.idpedido
                                      from favorita.vw_vencimentospedidos_fav v
                                     where v.codsituacaovencimento = 'V' ) v --valido
                            where p.idpedido = v.idpedido
                              and uu.idpessoa = ff.idpessoa
                              --and uu.idfilialfavorita = fv.idfilialfavorita -- comentado no T9915497
                              and p.idfilialfavorita = fv.idfilialfavorita
                              and uu.idusuario = p.idusuario
                              and trunc(p.dataemissao) between (select datainicio from favorita.metascobrancas where idmetacobranca = :P553_META) 
                                                           and (select datafim    from favorita.metascobrancas where idmetacobranca = :P553_META) 
                              and ff.ativo = 'S'
                              and uu.ativo = 'S'
                              and p.idpais = 1
                              and p.tipopedido in ( 'P', 'R')
                              and p.datacancelamento is null
                              and ( p.tipopedido <> 'R' and uu.idfilialfavorita = :P553_IDFILIALFAVORITA
                                 or p.tipopedido = 'R' and nvl(p.idfilialfavoritaorig, p.idfilialfavorita) = :P553_IDFILIALFAVORITA )
                              and not exists ( select 1 from favorita.classificacoespedidos c where c.idpedido = p.idpedido and c.idcaracteristicapedido = 8 and c.idvalorcaracteristica in (25,16) )
                              and not exists ( select 1
                                                 from favorita.metascobrancas m
                                                where m.idfilialfavorita = :P553_IDFILIALFAVORITA
                                                  and m.idusuario = uu.idusuario
                                                  and m.datainicio = (select datainicio from favorita.metascobrancas where idmetacobranca = :P553_META) 
                                                  and m.datafim = (select datafim    from favorita.metascobrancas where idmetacobranca = :P553_META) ) 
                        group by uu.idusuario
                               , fv.idfilialfavorita --usuários que pertencem a loja e que tem pedidos, mas não tem meta cadastrada
                        union
                        select p.idusuario 
                             , decode(p.tipopedido,'R',nvl(p.idfilialfavoritaorig, p.idfilialfavorita), p.idfilialfavorita) idfilialfavorita
                             , favorita.pck_util_fav.fnc_nomeusuario(p.idusuario) nomeusuario
                             , null meta
                             , sum(v.valortotal) valortotal
                             ---
                             , ( select ud.nomefilialfavorita||' - ID: '||pp.unidade
                                   from catal.usuarios u
                                      , catal.pessoas  pp
                                      , favorita.filiaisfavorita ud
                                  where to_number(ud.idempresametadados) = pp.unidade --devido a tabela de pessoas for varchar2
                                    and u.idpessoa  = pp.idpessoa
                                    and u.idusuario = p.idusuario ) unidade
                             ---
                             , ( select pp.matricula
                                   from catal.usuarios u
                                      , catal.pessoas  pp
                                  where u.idpessoa  = pp.idpessoa
                                    and u.idusuario = p.idusuario ) matricula
                             ---
                             , ( select cc.nome
                                   from catal.usuarios u
                                      , catal.funcionarios  ff
                                      , roman.cargos cc
                                  where u.idpessoa  = ff.idpessoa
                                    and ff.idcargo = cc.idcargo
                                    and u.idusuario = p.idusuario ) cargo
                             ---
                             , sum(case when p.idvendedora=2363887 then v.valortotal else 0 end) clientefinal
                             , sum(case when p.idvendedora=2363887 then 0 else v.valortotal end) sistfav
                             ---
                             , ( select sum(m.valormeta) 
                                   from favorita.metascobrancas m
                                  where idfilialfavorita = :P553_IDFILIALFAVORITA
                                    and datainicio = (select datainicio from favorita.metascobrancas where idmetacobranca = :P553_META) 
                                    and datafim    = (select datafim    from favorita.metascobrancas where idmetacobranca = :P553_META) )metaemp
                             ---
                             , ( select  sum(p.valorapagar) valortotal 
                                   from favorita.vw_pedidos_fav_new p
                                      , usuarios u
                                  where trunc(p.dataemissao) between (select datainicio from favorita.metascobrancas where idmetacobranca = :P553_META) 
                                                                 and (select datafim     from favorita.metascobrancas where idmetacobranca = :P553_META) 
                                    and u.idusuario = p.idusuario
                                    and p.tipopedido in ( 'P', 'R')
                                    and p.datacancelamento is null
                                    and ( p.tipopedido <> 'R' and p.idfilialfavorita = :P553_IDFILIALFAVORITA
                                       or p.tipopedido <> 'R' and u.idfilialfavorita = :P553_IDFILIALFAVORITA 
                                       or p.tipopedido = 'R' and nvl(p.idfilialfavoritaorig, p.idfilialfavorita) = :P553_IDFILIALFAVORITA )
                                    and not exists ( select 1
                                                       from favorita.classificacoespedidos c
                                                       where c.idpedido = p.idpedido
                                                         and c.idcaracteristicapedido = 8
                                                         and c.idvalorcaracteristica in (25,16) ) ) valoremp
                            ---
                         from favorita.pedidos p 
                            , usuarios u 
                            , ( select v.valorpagar valortotal
                                     , v.idpedido
                                  from favorita.vw_vencimentospedidos_fav v
                                 where v.codsituacaovencimento = 'V' ) v --valido
                        where p.idpedido = v.idpedido
                          and p.idusuario = u.idusuario
                          and trunc(p.dataemissao) between (select datainicio from favorita.metascobrancas where idmetacobranca = :P553_META) 
                                                       and (select datafim    from favorita.metascobrancas where idmetacobranca = :P553_META) 
                          and p.idpais = 1
                          and p.tipopedido in ( 'P', 'R')
                          and p.datacancelamento is null
                          and ( p.tipopedido <> 'R' and p.idfilialfavorita = :P553_IDFILIALFAVORITA
                             or p.tipopedido = 'R' and nvl(p.idfilialfavoritaorig, p.idfilialfavorita) = :P553_IDFILIALFAVORITA )
                          and not exists ( select 1 from favorita.classificacoespedidos c where c.idpedido = p.idpedido and c.idcaracteristicapedido = 8 and c.idvalorcaracteristica in (25,16) ) 
                          and not exists ( select 1
                                             from favorita.metascobrancas m
                                            where m.idfilialfavorita = :P553_IDFILIALFAVORITA
                                              and m.idusuario = p.idusuario
                                              and m.datainicio = (select datainicio from favorita.metascobrancas where idmetacobranca = :P553_META) 
                                              and m.datafim = (select datafim    from favorita.metascobrancas where idmetacobranca = :P553_META) )
                          and not exists ( select 1
                                             from catal.funcionarios ff
                                                , catal.usuarios uu
                                                , favorita.filiaisfavorita fv
                                            where uu.idpessoa = ff.idpessoa
                                              and uu.idfilialfavorita = fv.idfilialfavorita
                                              and uu.idusuario = p.idusuario
                                              and ff.ativo = 'S'
                                              and uu.ativo = 'S'
                                              and fv.idfilialfavorita = :P553_IDFILIALFAVORITA  ) 
                
                        group by p.idusuario
                               , p.idfilialfavorita --usuários que não pertencem a loja ou estão inativos e tem pedidos lançados
                               , p.idfilialfavoritaorig
                               , p.tipopedido
                        union all
                        select uu.idusuario
                             , fv.idfilialfavorita 
                             , favorita.pck_util_fav.fnc_nomeusuario(uu.idusuario) nomeusuario
                             , null meta
                             , null
                             ---
                             , ( select ud.nomefilialfavorita||' - ID: '||pp.unidade
                                   from catal.usuarios u
                                      , catal.pessoas  pp
                                      , favorita.filiaisfavorita ud
                                  where to_number(ud.idempresametadados) = pp.unidade --devido a tabela de pessoas for varchar2
                                    and u.idpessoa  = pp.idpessoa
                                    and u.idusuario = uu.idusuario ) unidade
                             --
                             , ( select pp.matricula
                                   from catal.usuarios u
                                      , catal.pessoas  pp
                                  where u.idpessoa  = pp.idpessoa
                                    and u.idusuario = uu.idusuario ) matricula
                             ---
                             , ( select cc.nome
                                   from catal.usuarios u
                                      , catal.funcionarios  ff
                                      , roman.cargos cc
                                  where u.idpessoa  = ff.idpessoa
                                    and ff.idcargo = cc.idcargo
                                    and u.idusuario = uu.idusuario ) cargo
                             ---
                             , null
                             , null
                             ---
                             , ( select sum(m.valormeta) 
                                   from favorita.metascobrancas m
                                  where idfilialfavorita = :P553_IDFILIALFAVORITA
                                    and datainicio = (select datainicio from favorita.metascobrancas where idmetacobranca = :P553_META) 
                                    and datafim    = (select datafim    from favorita.metascobrancas where idmetacobranca = :P553_META) )metaemp
                             ---
                             , ( select  sum(p.valorapagar) valortotal 
                                   from favorita.vw_pedidos_fav p
                                      , usuarios u
                                  where trunc(p.dataemissao) between (select datainicio from favorita.metascobrancas where idmetacobranca = :P553_META) 
                                                                 and (select datafim     from favorita.metascobrancas where idmetacobranca = :P553_META) 
                                    and p.ididioma = 1
                                    and u.idusuario = p.idusuario
                                    and p.tipopedido in ( 'P', 'R')
                                    and p.datacancelamento is null
                                    and ( p.tipopedido <> 'R' and p.idfilialfavorita = :P553_IDFILIALFAVORITA
                                       or p.tipopedido <> 'R' and u.idfilialfavorita = :P553_IDFILIALFAVORITA 
                                       or p.tipopedido = 'R' and nvl(p.idfilialfavoritaorig, p.idfilialfavorita) = :P553_IDFILIALFAVORITA )
                                    and not exists ( select 1
                                                       from favorita.classificacoespedidos c
                                                       where c.idpedido = p.idpedido
                                                         and c.idcaracteristicapedido = 8
                                                         and c.idvalorcaracteristica in (25,16) ) ) valoremp
                            ---
                            from catal.funcionarios ff
                                , catal.usuarios uu
                                , favorita.filiaisfavorita fv
                            where uu.idpessoa = ff.idpessoa
                              and uu.idfilialfavorita = fv.idfilialfavorita
                              and ff.ativo = 'S'
                              and uu.ativo = 'S'
                              and fv.idfilialfavorita = :P553_IDFILIALFAVORITA
                              and ff.idcargo != 11
                              and not exists ( select 1
                                                 from favorita.metascobrancas m
                                                where m.idfilialfavorita = :P553_IDFILIALFAVORITA
                                                  and m.idusuario = uu.idusuario
                                                  and m.datainicio = (select datainicio from favorita.metascobrancas where idmetacobranca = :P553_META) 
                                                  and m.datafim = (select datafim    from favorita.metascobrancas where idmetacobranca = :P553_META) ) 
                              and not exists ( select 1
                                                 from favorita.vw_pedidos_fav_new ped
                                                where ped.idusuario = uu.idusuario
                                                  and ped.idfilialfavorita = :P553_IDFILIALFAVORITA
                                                  and trunc(ped.dataemissao) between (select datainicio from favorita.metascobrancas where idmetacobranca = :P553_META) 
                                                                                 and (select datafim    from favorita.metascobrancas where idmetacobranca = :P553_META) 
                                                  and ped.tipopedido in ( 'P', 'R')
                                                  and ped.datacancelamento is null
                                                  and not exists ( select 1
                                                                    from favorita.classificacoespedidos c
                                                                    where c.idpedido = ped.idpedido
                                                                      and c.idcaracteristicapedido = 8
                                                                      and c.idvalorcaracteristica in (25,16) )
                                                  and exists ( select 1 from favorita.vencimentospedidos vc where vc.idpedido = ped.idpedido))         
                        group by uu.idusuario
                               , fv.idfilialfavorita --usuários que pertencem a loja, porém não tem pedidos 
                      ) xy
                order by 3
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
