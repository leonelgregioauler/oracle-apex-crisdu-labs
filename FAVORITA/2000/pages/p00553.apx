        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado. Verifique os filtros
        }
        advanced {
            savedReportMappingIdentifier: 763198933799446045
        }

