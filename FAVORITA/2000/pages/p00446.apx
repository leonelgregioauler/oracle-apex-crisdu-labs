    region produtos-com-o-código-informado (
        name: Produtos com o código informado
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idprodutodetalhado
                       ,p.produto as "Produto"
                       ,p.produtosemref as "Produto S/ Ref"
                       ,p.caracteristica as "Característica"
                       ,p.cor as "Cor"
                       ,p.grade as "Grade"
                       ,p.codbarra as "Código de Barra"
                       ,p.ativo as "Ativo"
                from vw_produtosdetalhados_fav p
                where p.ididioma = 1
                and p.codbarra = :P446_COD_BARRAS
                and p.idprodutodetalhado != :P446_IDPRODUTODETALHADO
                order by p.idprodutodetalhado
                ```
        }
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--horizontalBorders
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

