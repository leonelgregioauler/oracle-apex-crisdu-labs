    dynamicAction atualiza-códigos (
        name: Atualiza códigos
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @salvar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: UPDATE_COD
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction cancel-dialog (
        name: Cancel dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @voltar
        }

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-no-relatório (
        name: Refresh no relatório
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P446_COD_BARRAS
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: return;
                itemsToSubmit: [
                    P446_COD_BARRAS
                    P446_IDPRODUTODETALHADO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @produtos-com-o-código-informado
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction seta-foco-no-campo (
        name: Seta foco no campo
        execution {
            sequence: 40
        }
        when {
            event: ready
        }

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P446_COD_BARRAS
            }
            execution {
                sequence: 10
            }
        )

    )

    process atualiza-o-código-de-barras (
        name: Atualiza o código de barras
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Created on 22/05/2020 by MAX.BERKEUER 
                declare 
                  --
                  vid_prod_detalhado number := :P446_IDPRODUTODETALHADO;
                  vid_cod_barra number;
                  vcod_ean number := :P446_COD_BARRAS;
                  --
                begin
                  --
                  begin
                    --
                    select c.idcodigobarra
                    into vid_cod_barra
                    from codigosbarras c
                    where c.idcodigobarra = (select min(cf.idcodigobarra)
                                            from codigosbarras cf
                                            where cf.codean = vcod_ean);
                    --
                  exception
                    when no_data_found then
                      --
                      insert into codigosbarras(idcodigobarra,
                                                codean,
                                                idproduto,
                                                utiliza)
                      values(seq_idcodigodebarra.nextval,
                                                vcod_ean,
                                                vid_prod_detalhado,
                                                'FAVORITA')
                    returning idcodigobarra into vid_cod_barra;
                    --
                  end;
                  --
                  update produtosdetalhados p
                  set p.idcodigobarra = vid_cod_barra
                  where p.idprodutodetalhado = vid_prod_detalhado;
                  --
                  update codigosbarras cb
                  set cb.utiliza = 'FAVORITA'
                  where cb.idcodigobarra = vid_cod_barra;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Ação processada!
        }
        error {
            errorMessage: Erro ao atualizar o código de barras, entre em contato com o administrador do sistema.
        }
        advanced {
            executionMappingIdentifier: 38373584770885728
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 38374021054885733
        }
    )

    process popula-formulário (
        name: Popula formulário
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Created on 22/05/2020 by MAX.BERKEUER 
                declare 
                  --
                  --
                begin
                  --
                  for c in (select p.idprodutodetalhado
                                   ,p.idproduto
                                   ,p.caracteristica
                                   ,p.cor
                                   ,p.grade
                                   ,p.idcodigobarra
                                   , p.codbarra
                                   ,p.ativo
                            from vw_produtosdetalhados_fav p
                            where p.ididioma = 1
                            and p.idprodutodetalhado = :P446_IDPRODUTODETALHADO)
                  loop
                    --
                    :P446_CARACTERISTICA := c.caracteristica;
                    :P446_COD_BARRAS := c.codbarra;
                    :P446_COR := c.cor;
                    :P446_GRADE := c.grade;
                    --
                  end loop;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 38372887240885721
        }
    )

)

