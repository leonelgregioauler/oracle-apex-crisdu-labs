        }
    )

    process atualiza-remessa (
        name: Atualiza Remessa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_comprastransf_fav.prc_atualizapesovolume(pidcompratransferencia => :P143_IDCOMPRATRANSFERENCIA);
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 29534750483026515
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('ATUALIZAR','INSERIR')
                ```
        }
    )

    process consulta-volume (
        name: Consulta Volume
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P143_IDVOLUMEPEDIDOSREMESSAS is not null then
                    --
                    #OWNER#.PCK_COMPRASTRANSF_FAV.PRC_VOLUMESPEDIDOSREMESSAS( PIDVOLUMEPEDIDOSREMESSAS => :P143_IDVOLUMEPEDIDOSREMESSAS,
                                                                                PIDCOMPRATRANSFERENCIA => :P143_IDCOMPRATRANSFERENCIA,
                                                                                PVOLUME => :P143_VOLUME,
                                                                                PPESO => :P143_PESO,
                                                                                PMD5 => :P143_MD5,
                                                                                POPERACAO_DML => 'S',
                                                                                PRECEBIDO => :P143_RECEBIDO);
                    --
                  end if;
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 29535056083026518
        }
    )

    process limpa-campos (
        name: Limpa campos
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 29533982153026507
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    process operação-dml-em-volumes-pedidos-remessas (
        name: Operação DML em Volumes Pedidos Remessas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  --
                  if v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  #OWNER#.PCK_COMPRASTRANSF_FAV.PRC_VOLUMESPEDIDOSREMESSAS( PIDVOLUMEPEDIDOSREMESSAS => :P143_IDVOLUMEPEDIDOSREMESSAS,
                                                                            PIDCOMPRATRANSFERENCIA => :P143_IDCOMPRATRANSFERENCIA,
                                                                            PVOLUME => :P143_VOLUME,
                                                                            PPESO => :P143_PESO,
                                                                            PMD5 => :P143_MD5,
                                                                            POPERACAO_DML => voperacao_dml,
                                                                            PRECEBIDO => :P143_RECEBIDO);
                  --
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo atualizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 29614670027184672
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 74
                items: {
                    P74_IDCOMPRATRANSFERENCIA: &P143_IDCOMPRATRANSFERENCIA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @cancel
        }
    )

    branch (
        name: go to page 143
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 143
                items: {
                    P143_IDVOLUMEPEDIDOSREMESSAS:
                    P143_IDCOMPRATRANSFERENCIA: &P143_IDCOMPRATRANSFERENCIA.
                    P143_PESO:
                    P143_VOLUME:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @inserir
        }
    )

    branch (
        execution {
            sequence: 30
        }
        behavior {
            target: {
                page: 143
                items: {
                    P143_IDCOMPRATRANSFERENCIA: &P143_IDCOMPRATRANSFERENCIA.
                }
                action: resetPagination
            }
        }
    )

)

