page 143 (
    name: Volumes Remessa Itens
    title: Volumes Remessa Itens
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region volumes (
        name: Volumes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idvolumepedidoremessa 
                 , volume
                 , peso
                 , decode(v.recebido,'S','Sim','Não') recebido
                 , (select substr(e.parametro4,16,30)
                    from etiquetasfavorita e
                    where e.idvolumepedidoremessa = v.idvolumepedidoremessa) etiqueta
                from volumespedidosremessas v
                where v.idcompratransferencia = :P143_IDCOMPRATRANSFERENCIA
                order by 1 
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from volumespedidosremessas v
                where v.idcompratransferencia = :P143_IDCOMPRATRANSFERENCIA
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 29534256213026510
        }

        column ETIQUETA (
            type: plainText
            heading {
                heading: Etiqueta
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column IDVOLUMEPEDIDOREMESSA (
            type: link
            heading {
                heading: Ver/Editar
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 143
                    items: {
                        P143_IDVOLUMEPEDIDOSREMESSAS: #IDVOLUMEPEDIDOREMESSA#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column PESO (
            type: plainText
            heading {
                heading: Peso
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        column RECEBIDO (
            type: plainText
            heading {
                heading: Recebido
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column VOLUME (
            type: plainText
            heading {
                heading: Volume
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        savedReport 296545 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ETIQUETA (
                sequence: 5
            )

            displayColumn IDVOLUMEPEDIDOREMESSA (
                sequence: 1
            )

            displayColumn PESO (
                sequence: 3
            )

            displayColumn RECEBIDO (
                sequence: 4
            )

            displayColumn VOLUME (
                sequence: 2
            )

        )

    )

