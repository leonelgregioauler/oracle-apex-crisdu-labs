        behavior {
            action: redirectThisApp
            target: {
                page: 74
                items: {
                    P74_IDCOMPRATRANSFERENCIA: &P143_IDCOMPRATRANSFERENCIA.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 10
