    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 30
            region: @volumes-itens-remessas
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P143_IDVOLUMEPEDIDOSREMESSAS
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Atualizar e Fechar
        layout {
            sequence: 40
            region: @volumes-itens-remessas
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
