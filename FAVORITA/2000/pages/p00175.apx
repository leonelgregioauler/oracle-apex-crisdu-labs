    region relatório-de-histórico-de-tarefas-sistema-antigo (
        name: Relatório de Histórico de Tarefas - Sistema Antigo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idtarefa
                     , t.telefone
                     , t.datainclusao
                     , decode(t.situacao,'A','Aberto','F','Fechado','P','Pendente') "Situação Tarefa"
                     , t.observacao "Observação Tarefa"
                     , t.usuario
                     , ( select initcap(tt.descricao)   
                         from  tipostarefas tt
                         where tt.idtipotarefa  = t.idtipotarefa ) "Tipo Tarefa"
                     , ht.datainicio  "Data Inicio"
                     , ht.datafim  "Data Fim"
                     , ht.observacao "Observação Histórico"
                     , decode(ht.situacao,'A','Aberto','P','Pendente','F','Fechado') "Situação Histórico"
                     , ht.usuario "Usuário"
                     , ( select initcap(tt.descricao)   
                         from  tipostarefas tt
                         where tt.idtipotarefa  = ht.idtipotarefa ) "Tipo Tarefa Hist."
                     , trunc(ht.datainicio) "Dt Ini Filtro"
                     , ht.numeropa "PA"
                     , (select initcap(p.nomepessoa)||'('||cpf||')'
                        from pessoas p
                        where p.idpessoa = t.idpessoa) Cliente
                from catal.tarefas          t
                   , catal.historicotarefas ht
                where t.idtarefa = ht.idtarefa
                  and (:P175_TELEFONE is null or replace(replace(replace(replace(t.telefone,'(',''),')',''),'.',''),'-','') like '%'||:P175_TELEFONE)  
                  and (:P175_USUARIO is null or :P175_USUARIO = t.usuario)
                  and (:P175_DATAINICIO is null or (trunc(ht.datainicio) between to_date(:P175_DATAINICIO,'DD/MM/RRRR') and to_date(:P175_DATAFIM,'DD/MM/RRRR')))
                  and :P175_BUSCAR = 'S'
                  and (:P175_TELEFONE is not null 
                       or :P175_USUARIO is not null
                       or :P175_DATAINICIO is not null)
                order by 1,10
                ```
        }
        layout {
            sequence: 30
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
