    region relatório-de-histórico-de-tarefas-sistema-atual (
        name: Relatório de Histórico de Tarefas - Sistema Atual
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ht.idhistoricotarefa
                     , ht.idtarefa
                     , vwt.telefone
                     , vwt.datainclusao
                     , ( select st.descricao
                         from situacoestarefas st
                         where st.idsituacaotarefa = vwt.idsituacao ) "Situação Tarefa"
                     , vwt.observacao "Observação Tarefa"
                     , ( select us.usuario
                         from usuarios us
                         where us.idusuario = vwt.idusuario ) "Usuário Tarefa"
                     , ( select initcap(tt.descricao)   
                         from  tipostarefas tt
                         where tt.idtipotarefa  = vwt.idtipotarefa ) "Tipo Tarefa"
                     , ht.datainicio "Data Inicio"
                     , ht.datafim "Data Fim"
                     , ht.observacao "Observação Histórico"
                     , ( select descricao
                         from situacoestarefas st
                         where st.idsituacaotarefa = ht.idsituacao ) "Situação Histórico"
                     , ( select us.usuario
                         from usuarios us
                         where us.idusuario = ht.idusuario ) "Usuário Histórico"
                     , trunc(ht.datainicio) "Dt Ini Filtro"
                     , ht.numeroposicaoatendimento
                     , (select initcap(p.nomepessoa)||'('||p.cpf||')'
                        from pessoas p
                        where p.idpessoa = vwt.idpessoa) Cliente
                     , vwt.pedidosfeitos
                from usuarios u
                   , vw_tarefas_fav vwt
                   , vw_historicostarefas_fav ht
                where vwt.idtarefa = ht.idtarefa
                and u.idusuario = vwt.idusuario 
                and vwt.ididioma = 1
                and :P175_BUSCAR = 'S'
                and (:P175_USUARIO is null or u.usuario = :P175_USUARIO)
                and (:P175_IDTAREFA is null or vwt.idtarefa = :P175_IDTAREFA)
                and (:P175_TELEFONE is null or replace(replace(replace(replace(replace(vwt.telefone,'(',''),')',''),'.',''),'-',''),' ','') like '%'||replace(replace(replace(replace(replace(:P175_TELEFONE,'(',''),')',''),'.',''),'-',''),' ','')||'%')  
                and (:P175_DATAINICIO is null or (trunc(ht.datainicio) between to_date(:P175_DATAINICIO,'DD/MM/RRRR') and to_date(:P175_DATAFIM,'DD/MM/RRRR')))
                and (:P175_TELEFONE is not null or :P175_USUARIO is not null or :P175_DATAINICIO is not null or :P175_IDTAREFA is not null or :P175_IDVENDEDORA is not null )
                and (:P175_IDVENDEDORA is null or vwt.idpessoa in ( select v.idpessoa
                                                                    from vendedoras v
                                                                    where v.idvendedora = :P175_IDVENDEDORA
                                                                    and v.idpessoa = vwt.idpessoa ))
                order by 2, 11;
                ```
        }
        layout {
            sequence: 20
            slot: body-3
        }
