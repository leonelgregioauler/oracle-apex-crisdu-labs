    region relatório-de-pessoas (
        name: Relatório de Pessoas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct p.idpessoa
                     , p.nomepessoa
                     , p.cpf
                     , p.cnpj
                     , roman.pck_romance.fnc_nomecidade( p.IDcidade ) cidade
                     , ( select  listagg(o.nome||' - '||t.telefone,'<br>') within group (order by 1)
                        from catal.telefonespessoas t
                           , catal.operadorastelefonia  o
                        where t.idpessoa = p.idpessoa 
                          and t.idoperadoratel = o.idoperadoratel(+) ) telefones
                  from pessoas p 
                  where exists ( select idpessoa 
                                 from telefonespessoas  t
                                 where t.idpessoa = p.idpessoa
                                   and replace(replace(replace(replace(replace(t.telefone,'(',''),')',''),'.',''),'-',''),' ','') like '%'||replace(replace(replace(replace(replace(:P175_TELEFONE,'(',''),')',''),'.',''),'-',''),' ','')||'%'
                                   and :P175_TELEFONE is not null)
                                   
                                   
                ```
        }
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Informe um telefone para consulta.
        }
        advanced {
            savedReportMappingIdentifier: 30389614371433931
        }

